{
  "browser": {
    "mode": "connect",
    "cdp_endpoint": "http://127.0.0.1:9222",
    "target_id": "indus-renderer"
  },
  "start_url": {
    "url": "http://127.0.0.1:24000/",
    "query": []
  },
  "environment": {
    "viewport": {
      "width": 1280,
      "height": 720,
      "device_scale_factor": 1
    },
    "locale": "en-US",
    "timezone": "UTC",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "block"
  },
  "capture": {
    "after_each_step": ["url", "accessibility", "screenshot"],
    "at_end": ["url", "dom"],
    "events": ["console", "page-errors", "network"]
  },
  "actions": [
    {
      "step_id": "wait-onboarding",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-dialog\"]"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "choose-custom-endpoint",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-custom-option\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "fill-base-url",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-endpoint-url\"]"
      },
      "value": {
        "source": "literal",
        "value": "http://127.0.0.1:24001/v1"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "test-endpoint",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-test-continue\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wait-model-choice",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-model-select\"]"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "start-chatting",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "[data-ui=\"onboarding-start-chatting\"]"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "wait-composer",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"composer\"]"
      },
      "state": "visible",
      "timeout_ms": 30000
    },
    {
      "step_id": "wait-model-picker",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "[data-testid=\"model-picker\"]"
      },
      "state": "visible",
      "timeout_ms": 15000
    }
  ]
}
