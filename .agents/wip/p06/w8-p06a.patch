+++ b/src/indus/cli/chat.py
@@ -0,0 +1,354 @@
+"""``indus chat`` (also bare ``indus``): pick the interface and the session, then run it.
+
+Interface (R04.19): ``--cli`` → classic; ``--tui`` → not built yet (P12), exit 2; stdin or stdout
+not a terminal → classic, whatever the settings say; ``INDUS_TUI=1`` or ``display.interface: tui``
+→ a one-line note and classic until P12.
+
+Then: ``--in DIR`` is entered, the session is selected (``session_select``), a resumed session's
+launch record is checked against the flags given now (a different value exits 2) and its folder
+and switches are restored (``resume``), the route is resolved, and one of three paths runs:
+
+- finite query (``-q``/``--query-file`` with ``--oneshot``, ``-Q`` or no terminal): one turn,
+  the reply on stdout, exit codes of ``oneshot.finite_exit_code``;
+- seeded REPL (``-q`` on a terminal): the REPL opens and submits the text literally first;
+- the REPL.
+
+The REPL runs on an ``InProcessHost``; after it returns, the sessions are closed, the terminal
+runtime is shut down on the host's loop and the store handle is released.
+"""
+
+from __future__ import annotations
+
+import importlib
+import logging
+import sys
+from dataclasses import replace
+from pathlib import Path
+from typing import Any
+
+import click
+
+from indus.cli.app import globals_from, with_global_options
+from indus.cli.args import ChatArgs, CliState, GlobalArgs
+from indus.cli.handoff import REPL_ENTRY, ReplEntry, ReplLaunch
+
+__all__ = [
+    "TUI_PENDING",
+    "chat_command",
+    "choose_interface",
+    "load_repl",
+    "read_query",
+    "run_chat",
+]
+
+log = logging.getLogger(__name__)
+
+TUI_PENDING = (
+    "The full-screen interface is not part of this build yet; it arrives in a later release. "
+    "Run `indus --cli` (or plain `indus`) for the classic prompt."
+)
+_TUI_NOTE = "The full-screen interface is not available yet; using the classic prompt."
+
+
+def _err(*lines: str) -> None:
+    for line in lines:
+        click.echo(line, err=True)
+
+
+def load_repl() -> ReplEntry:
+    """The classic REPL's entry (``handoff.REPL_ENTRY``)."""
+    module_name, _, attr = REPL_ENTRY.partition(":")
+    entry: ReplEntry = getattr(importlib.import_module(module_name), attr)
+    return entry
+
+
+def choose_interface(state: CliState, args: GlobalArgs) -> tuple[str, str | None]:
+    """``("classic", note)`` or ``("tui", None)`` (see the module notes)."""
+    if args.interface == "cli":
+        return "classic", None
+    if args.interface == "tui":
+        return "tui", None
+    if not (state.stdin_isatty() and state.stdout_isatty()):
+        return "classic", None
+    wanted = state.scope.env.get("INDUS_TUI", "").strip() == "1"
+    if not wanted and state.scope.config is not None:
+        try:
+            wanted = str(state.scope.config.get("display.interface") or "").lower() == "tui"
+        except Exception:
+            wanted = False
+    return "classic", (_TUI_NOTE if wanted else None)
+
+
+def read_query(chat: ChatArgs) -> str | None:
+    """The query text: ``-q`` as typed, or the file's text (``-`` reads stdin), unchanged."""
+    if chat.query_file is None:
+        return chat.query
+    if chat.query_file == "-":
+        return sys.stdin.read()
+    return Path(chat.query_file).expanduser().read_text(encoding="utf-8")
+
+
+@click.command(
+    "chat",
+    help="Chat with the agent (the default when `indus` is run with no command).",
+    context_settings={"help_option_names": ["-h", "--help"], "max_content_width": 100},
+)
+@click.option(
+    "-q",
+    "--query",
+    default=None,
+    help="A first message. On a terminal it opens the chat with this message sent as typed; "
+    "with --oneshot, -Q or without a terminal the answer is printed and the command exits.",
+)
+@click.option(
+    "--query-file",
+    metavar="PATH",
+    default=None,
+    help="Read the message from PATH ('-' reads stdin); nothing in it is interpreted.",
+)
+@click.option(
+    "--oneshot",
+    "oneshot_exit",
+    is_flag=True,
+    default=False,
+    help="With -q: answer and exit instead of opening the chat.",
+)
+@click.option("-Q", "--quiet", is_flag=True, default=False, help="Print only the reply.")
+@click.option("--max-turns", type=int, default=None, metavar="N", help="Tool-call cap per turn.")
+@click.option(
+    "--source",
+    default=None,
+    help="Tag stored with the session (default: cli; 'tool' hides it from session lists).",
+)
+@with_global_options(repeated=True)
+@click.pass_context
+def chat_command(
+    ctx: click.Context,
+    query: str | None,
+    query_file: str | None,
+    oneshot_exit: bool,
+    quiet: bool,
+    max_turns: int | None,
+    source: str | None,
+    **values: Any,
+) -> int:
+    state = ctx.find_object(CliState)
+    if state is None:
+        raise click.UsageError("chat was started without its process state")
+    args = state.globals.merged(globals_from(values))
+    chat = ChatArgs(
+        query=query,
+        query_file=query_file,
+        oneshot=oneshot_exit,
+        quiet=quiet,
+        max_turns=max_turns,
+        source=source,
+    )
+    return run_chat(state, args, chat)
+
+
+def _usage_problem(args: GlobalArgs, chat: ChatArgs) -> str | None:
+    from indus.cli.runtime import reasoning_problem
+
+    if chat.query is not None and chat.query_file is not None:
+        return "use either -q/--query or --query-file, not both"
+    if chat.max_turns is not None and chat.max_turns < 0:
+        return "--max-turns must be 0 or more"
+    return reasoning_problem(args.reasoning)
+
+
+def run_chat(state: CliState, args: GlobalArgs, chat: ChatArgs) -> int:
+    """Run ``chat`` with the merged global flags; returns the exit code."""
+    problem = _usage_problem(args, chat)
+    if problem is not None:
+        _err(f"indus chat: {problem}")
+        return 2
+    interface, note = choose_interface(state, args)
+    if interface == "tui":
+        _err(TUI_PENDING)
+        return 2
+    try:
+        query = read_query(chat)
+    except OSError as exc:
+        _err(f"indus chat: cannot read {chat.query_file}: {exc.strerror or exc}")
+        return 1
+    terminal = state.stdin_isatty() and state.stdout_isatty()
+    finite = query is not None and (chat.oneshot or chat.quiet or not terminal)
+    return _ChatRun(state, args, chat, query=query, finite=finite, note=note).run()
+
+
+class _ChatRun:
+    """One chat invocation from session selection to shutdown."""
+
+    def __init__(
+        self,
+        state: CliState,
+        args: GlobalArgs,
+        chat: ChatArgs,
+        *,
+        query: str | None,
+        finite: bool,
+        note: str | None,
+    ) -> None:
+        self.state = state
+        self.args = args
+        self.chat = chat
+        self.query = query
+        self.finite = finite
+        self.notices: list[str] = [note] if note else []
+
+    def run(self) -> int:
+        from indus.cli.session_select import SelectionError, enter_in_dir
+        from indus.state import registry
+
+        if self.args.in_dir is not None:
+            try:
+                enter_in_dir(self.args.in_dir)
+            except SelectionError as exc:
+                _err(*exc.lines())
+                return exc.code
+        try:
+            store = registry.acquire(self.state.scope)
+        except Exception as exc:
+            _err(f"indus: the session store could not be opened: {exc}")
+            return 1
+        try:
+            return self._with_store(store)
+        finally:
+            registry.release(store)
+
+    def _with_store(self, store: Any) -> int:
+        from indus.cli import resume, session_select
+        from indus.cli.runtime import (
+            SOURCE_CLI,
+            ServiceSpec,
+            resolve_route,
+            scope_for,
+        )
+        from indus.foundation.errors import IndusError
+        from indus.state import sessions
+
+        scope = self.state.scope
+        args = self.args
+        cwd = Path.cwd()
+        latest_form = (args.resume or "").strip().lower() == session_select.LATEST or (
+            args.resume is None and args.continue_ == session_select.BARE_CONTINUE
+        )
+        crumb = resume.read_breadcrumb(scope) if latest_form else None
+        try:
+            session_id = session_select.select_session(store, args, cwd=cwd, breadcrumb=crumb)
+        except session_select.SelectionError as exc:
+            _err(*exc.lines())
+            return exc.code
+
+        policy, given = session_select.launch_from_args(args, self.chat, cwd=cwd)
+        row = sessions.get(store, session_id) if session_id is not None else None
+        if session_id is not None:
+            stored = session_select.stored_launch(row)
+            if stored is not None:
+                switched = resume.stored_reasoning(row)
+                if switched is not None:
+                    stored = replace(stored, reasoning=switched)
+                conflicts = session_select.check_frozen(stored, given)
+                if conflicts:
+                    _err(
+                        "indus: this session was started with different settings for "
+                        f"{', '.join(conflicts)}; a resumed session keeps its own.",
+                        "Drop those flags, or start a new session to change them.",
+                    )
+                    return 2
+            restored = resume.resume_session(
+                scope,
+                session_id,
+                store=store,
+                restore=not (args.no_restore_cwd or args.in_dir is not None),
+                breadcrumb=False,
+            )
+            self.notices.extend(restored.notices)
+            policy = restored.policy or session_select.replace_cwd(policy, Path.cwd())
+
+        run_scope = scope_for(scope, policy)
+        try:
+            route = resolve_route(run_scope, policy, self.state.overrides)
+        except IndusError as exc:
+            _err(f"indus: {exc.message}", *([exc.hint] if exc.hint else []))
+            return 1
+        spec = ServiceSpec(
+            scope=run_scope,
+            route=route,
+            policy=policy,
+            store=store,
+            source=self.chat.source or SOURCE_CLI,
+            run_context="single_query" if self.finite else "interactive",
+            overrides=self.state.overrides,
+            new_session=session_id is None,
+        )
+        if self.finite:
+            from indus.cli.oneshot import run_finite
+
+            _err(*self.notices)
+
+            assert self.query is not None
+            return run_finite(spec, self.query, session_id, quiet=self.chat.quiet)
+        return self._interactive(spec, session_id, row)
+
+    def _interactive(self, spec: Any, session_id: str | None, row: Any) -> int:
+        from indus.cli import resume
+        from indus.cli.runtime import make_host, shutdown_terminal
+        from indus.protocol.methods import ProtocolError, SessionCreateParams
+
+        try:
+            entry = load_repl()
+        except (ImportError, AttributeError) as exc:
+            _err(f"indus: the chat prompt is not available in this build ({exc}).")
+            return 1
+        host = make_host(spec)
+        try:
+            host.start()
+        except Exception as exc:
+            _err(f"indus: the agent could not start: {exc}")
+            return 1
+        try:
+            cwd = Path(spec.policy.cwd) if spec.policy.cwd else Path.cwd()
+            try:
+                if session_id is None:
+                    created = host.create(SessionCreateParams(cwd=str(cwd)))
+                    session_id = created.session_id
+                    history: list[Any] = []
+                else:
+                    host.resume(session_id)
+                    history = list(host.call(host.service.store.load(session_id)))
+            except ProtocolError as exc:
+                _err(f"indus: {exc.message}")
+                return 1
+            resume.write_breadcrumb(spec.scope, session_id, cwd)
+            launch = ReplLaunch(
+                scope=spec.scope,
+                host=host,
+                session_id=session_id,
+                policy=spec.policy,
+                model=spec.route.model,
+                provider=spec.route.provider,
+                cwd=cwd,
+                resumed=row is not None,
+                title=(row or {}).get("title"),
+                history=history,
+                seed=self.query,
+                notices=tuple(self.notices),
+            )
+            return entry(launch)
+        finally:
+            _stop_host(host, shutdown_terminal)
+
+
+def _stop_host(host: Any, shutdown_terminal: Any) -> None:
+    """Close the sessions, shut the terminal runtime down on the host loop, stop the loop."""
+    try:
+        host.call(host.service.aclose(), timeout=30.0)
+    except Exception:
+        log.warning("closing the sessions failed", exc_info=True)
+    try:
+        host.call(shutdown_terminal(), timeout=30.0)
+    except Exception:
+        log.warning("terminal shutdown failed", exc_info=True)
+    host.stop()
diff --git a/src/indus/cli/entry.py b/src/indus/cli/entry.py
new file mode 100644
index 0000000..7c39be3
--- /dev/null
+++ b/src/indus/cli/entry.py
@@ -0,0 +1,219 @@
+"""``indus``: prepare the process in a fixed order, then run the click app.
+
+Order (R04.2, R04.13, R04.14), each step before anything that depends on it:
+
+0. a bare ``-V``/``--version`` (profile flags aside) prints the version block from stdlib-only
+   code and returns; nothing else is imported;
+1. the session flags are normalised (``app.rewrite_session_flags``) and the value-taking flag set
+   is read from the live app (hand-kept fallback in ``args``);
+2. provider key names are registered as managed ``.env`` names, so a key removed from the
+   profile's ``.env`` is cleared from the view;
+3. ``--yolo`` (found by a scan that skips flag values and stops at ``--``) is written as
+   ``INDUS_YOLO_MODE=1`` into the environment the scope is built from — before any tool or
+   approval module is imported;
+4. ``bootstrap.run``: profile pre-parse and argv stripping, ``.env`` (the home's file wins over the
+   shell), the ``security.redact_secrets`` bridge, then logging in ``cli`` mode (``gui`` for the
+   dashboard/desktop commands);
+5. the scope's env view is published to the process env (one profile per CLI process), ``--yolo``
+   is laid over the view again so a ``.env`` line cannot cancel it, and the provider key names are
+   declared blocked for child processes;
+6. the click app runs; an int result is the exit code. A one-shot run then leaves through
+   ``os._exit`` after flushing and shutting logging down.
+
+A named profile that does not exist (or a saved one that was deleted) prints one line and exits 1;
+any other failure inside profile selection is a warning and the default profile is used.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import sys
+from collections.abc import Collection, MutableMapping, Sequence
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from indus.cli.args import HostOverrides
+
+__all__ = ["GUI_COMMANDS", "RECOVERY_COMMANDS", "find_flag", "main"]
+
+GUI_COMMANDS = frozenset({"dashboard", "serve", "gui", "desktop"})
+RECOVERY_COMMANDS = frozenset({"profile", "doctor", "config"})
+_VERSION_FLAGS = ("-V", "--version")
+_PROFILE_FLAGS = ("-p", "--profile")
+_YOLO_ENV = "INDUS_YOLO_MODE"
+
+
+def _without_profile(argv: Sequence[str]) -> list[str]:
+    out: list[str] = []
+    i = 0
+    while i < len(argv):
+        token = argv[i]
+        if token in _PROFILE_FLAGS:
+            i += 2
+            continue
+        if token.startswith("--profile="):
+            i += 1
+            continue
+        out.append(token)
+        i += 1
+    return out
+
+
+def _fast_version(argv: Sequence[str]) -> bool:
+    rest = _without_profile(argv)
+    if len(rest) != 1 or rest[0] not in _VERSION_FLAGS:
+        return False
+    from indus.cli.version import version_lines
+
+    sys.stdout.write("\n".join(version_lines()) + "\n")
+    sys.stdout.flush()
+    return True
+
+
+def find_flag(argv: Sequence[str], flag: str, value_flags: Collection[str]) -> bool:
+    """Is ``flag`` itself in ``argv`` (not as another flag's value, not after ``--``)?"""
+    i = 0
+    while i < len(argv):
+        token = argv[i]
+        if token == "--":
+            return False
+        if token == flag:
+            return True
+        i += 2 if token in value_flags else 1
+    return False
+
+
+def _first_command(argv: Sequence[str], value_flags: Collection[str]) -> str | None:
+    i = 0
+    while i < len(argv):
+        token = argv[i]
+        if token == "--":
+            return None
+        if not token.startswith("-"):
+            return token
+        i += 2 if token in value_flags else 1
+    return None
+
+
+def _value_flags() -> frozenset[str]:
+    from indus.cli.args import CHAT_VALUE_FLAGS, FALLBACK_VALUE_FLAGS
+
+    try:
+        from indus.cli.app import value_flag_sets
+
+        required, _optional = value_flag_sets()
+        return required | CHAT_VALUE_FLAGS | frozenset(_PROFILE_FLAGS)
+    except Exception:
+        return FALLBACK_VALUE_FLAGS | CHAT_VALUE_FLAGS
+
+
+class _EarlyRecords:
+    """Holds log records made before logging is set up (the keychain fallback note, a profile
+    warning) and hands them to the real handlers afterwards. Without it Python prints them on
+    stderr, which a one-shot run must keep clean."""
+
+    def __init__(self) -> None:
+        import logging
+
+        self._logging = logging
+        self.records: list[logging.LogRecord] = []
+        self.handler = logging.Handler()
+        self.handler.emit = self.records.append  # type: ignore[method-assign]
+
+    def __enter__(self) -> _EarlyRecords:
+        self._logging.getLogger().addHandler(self.handler)
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self._logging.getLogger().removeHandler(self.handler)
+
+    def replay(self) -> None:
+        for record in self.records:
+            self._logging.getLogger(record.name).handle(record)
+        self.records.clear()
+
+
+def _hard_exit(code: int) -> None:
+    from indus.foundation import log as logsetup
+
+    for stream in (sys.stdout, sys.stderr):
+        with contextlib.suppress(OSError, ValueError):
+            stream.flush()
+    with contextlib.suppress(Exception):  # logging is already gone; nothing left to tell
+        logsetup.shutdown()
+    os._exit(code)
+
+
+def main(
+    argv: Sequence[str] | None = None,
+    *,
+    env: MutableMapping[str, str] | None = None,
+    overrides: HostOverrides | None = None,
+) -> int:
+    """Run ``indus`` with ``argv`` (default ``sys.argv[1:]``) and return the exit code.
+
+    ``env`` defaults to the process environment; tests pass a dict so nothing leaks. The real
+    process is the call with neither (the console script): only then is the env view published
+    to ``os.environ`` and a one-shot run hard-exits.
+    """
+    process = argv is None and env is None
+    args = list(sys.argv[1:] if argv is None else argv)
+    if _fast_version(args):
+        return 0
+    target: MutableMapping[str, str] = os.environ if env is None else env
+
+    from indus.cli.app import rewrite_session_flags
+
+    args = rewrite_session_flags(args)
+    value_flags = _value_flags()
+
+    from indus.providers import bundled
+
+    bundled.register_managed_env_names()
+    yolo = find_flag(args, "--yolo", value_flags)
+    if yolo:
+        target[_YOLO_ENV] = "1"
+
+    from indus.foundation import bootstrap
+    from indus.foundation.errors import IndusError
+
+    command = _first_command(_without_profile(args), value_flags)
+    mode = "gui" if command in GUI_COMMANDS else "cli"
+    early = _EarlyRecords()
+    try:
+        with early:
+            scope, args = bootstrap.run(
+                args,
+                target,
+                mode=mode,
+                value_flags=value_flags,
+                recovery_commands=RECOVERY_COMMANDS,
+            )
+    except IndusError as exc:
+        hint = f" ({exc.hint})" if exc.hint else ""
+        sys.stderr.write(f"indus: {exc.message}{hint}\n")
+        return 1
+    early.replay()
+
+    from indus.foundation.envload import publish_to_process
+
+    if target is os.environ:
+        publish_to_process(scope.env)
+    else:
+        publish_to_process(scope.env, target)
+    if yolo:
+        scope = scope.with_env(scope.env.with_overlay({_YOLO_ENV: "1"}))
+
+    from indus.safety.child_env import register_blocked_names
+
+    register_blocked_names("providers", bundled.env_var_names())
+
+    from indus.cli.app import dispatch
+    from indus.cli.args import CliState
+
+    state = CliState(scope=scope, env=target, process=process, overrides=overrides)
+    code = dispatch(args, state)
+    if state.hard_exit and process:
+        _hard_exit(code)
+    return code
