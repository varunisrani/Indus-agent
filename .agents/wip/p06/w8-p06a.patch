--- /dev/null
+++ b/src/indus/cli/resume.py
@@ -0,0 +1,336 @@
+"""What resuming a session puts back, and the per-terminal breadcrumb.
+
+On resume the CLI moves into the session's recorded directory (unless ``--no-restore-cwd`` or
+``--in``; a directory that is gone gives a warning and the CLI stays put) and re-arms the
+session's own switches: auto-approve from the row's ``yolo`` flag; toolsets from the launch record
+(``session_select``); reasoning from ``model_config["reasoning_effort"]`` (``/reasoning``), else
+the launch record. ``resume_session`` does all of it in one call for ``indus -c`` and for the
+REPL's ``/resume`` and ``/branch``.
+
+Breadcrumb: every new or resumed session is written to ``<home>/terminal-sessions/<terminal>``
+(JSON: session id, cwd, time), so a bare ``indus -c`` in the same terminal continues the same
+conversation while another terminal continues its own. The terminal is ``INDUS_TERMINAL_ID`` when
+set, else the TTY device of stdin or stdout, else a terminal multiplexer's pane variable; with
+none of them nothing is written or read. ``session.terminal_continue: false`` turns the feature
+off. Breadcrumbs older than ``STALE_AFTER_S`` are ignored and pruned. Nothing here raises.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+import sys
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from indus.foundation import fsio
+from indus.foundation.home import secure_dir
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "BREADCRUMB_DIR",
+    "STALE_AFTER_S",
+    "TERMINAL_ENV",
+    "REASONING_KEY",
+    "CwdOutcome",
+    "Resumed",
+    "breadcrumbs_enabled",
+    "read_breadcrumb",
+    "rearm_auto_approve",
+    "restore_cwd",
+    "resume_session",
+    "stored_reasoning",
+    "terminal_id",
+    "write_breadcrumb",
+]
+
+log = logging.getLogger(__name__)
+
+BREADCRUMB_DIR = "terminal-sessions"
+TERMINAL_ENV = "INDUS_TERMINAL_ID"
+STALE_AFTER_S = 30 * 24 * 3600.0
+_PANE_VARS = (
+    "TMUX_PANE",
+    "ZELLIJ_PANE_ID",
+    "KITTY_WINDOW_ID",
+    "WEZTERM_PANE",
+    "TERM_SESSION_ID",
+    "WT_SESSION",
+)
+_UNSAFE = re.compile(r"[^A-Za-z0-9._-]+")
+
+type TtyName = Callable[[int], str]
+
+
+def _clean(raw: str) -> str:
+    return _UNSAFE.sub("-", raw.strip().strip("/"))[:120].strip("-")
+
+
+def _tty_of(fd_source: object, ttyname: TtyName) -> str | None:
+    fileno = getattr(fd_source, "fileno", None)
+    if not callable(fileno):
+        return None
+    try:
+        fd = fileno()
+        if not isinstance(fd, int) or not os.isatty(fd):
+            return None
+        return ttyname(fd)
+    except (OSError, ValueError, AttributeError):
+        return None
+
+
+def terminal_id(env: Mapping[str, str], *, ttyname: TtyName | None = None) -> str | None:
+    """This terminal's identity (see the module notes), safe as a file name."""
+    pinned = env.get(TERMINAL_ENV, "").strip()
+    if pinned:
+        word = _clean(pinned)
+        return f"id-{word}" if word else None
+    namer: TtyName = ttyname if ttyname is not None else os.ttyname
+    for stream in (sys.stdin, sys.stdout):
+        name = _tty_of(stream, namer)
+        if name:
+            word = _clean(name)
+            if word:
+                return f"tty-{word}"
+    for var in _PANE_VARS:
+        value = env.get(var, "").strip()
+        if value:
+            word = _clean(value)
+            if word:
+                return f"{var.lower()}-{word}"
+    return None
+
+
+def breadcrumbs_enabled(scope: Scope) -> bool:
+    config = scope.config
+    if config is None:
+        return True
+    try:
+        value = config.get("session.terminal_continue")
+    except Exception:
+        return True
+    return value is not False
+
+
+def _dir(scope: Scope) -> Path:
+    return scope.home / BREADCRUMB_DIR
+
+
+def _now(scope: Scope) -> float:
+    return scope.clock.now().timestamp()
+
+
+def write_breadcrumb(
+    scope: Scope, session_id: str, cwd: Path | str | None = None, *, ttyname: TtyName | None = None
+) -> Path | None:
+    """Record ``session_id`` as this terminal's session; returns the file, or None if skipped."""
+    try:
+        if not session_id or not breadcrumbs_enabled(scope):
+            return None
+        ident = terminal_id(scope.env, ttyname=ttyname)
+        if ident is None:
+            return None
+        folder = secure_dir(_dir(scope), home=scope.home, env=scope.env)
+        now = _now(scope)
+        where = str(cwd) if cwd is not None else os.getcwd()
+        path = fsio.atomic_write_json(
+            folder / ident, {"session_id": session_id, "cwd": where, "at": now}, mode=0o600
+        )
+        _prune(folder, now)
+        return path
+    except Exception:
+        log.debug("could not write the terminal breadcrumb", exc_info=True)
+        return None
+
+
+def _prune(folder: Path, now: float) -> None:
+    try:
+        entries = list(folder.iterdir())
+    except OSError:
+        return
+    for entry in entries:
+        try:
+            if entry.is_file() and now - entry.stat().st_mtime > STALE_AFTER_S:
+                entry.unlink()
+        except OSError:
+            continue
+
+
+def read_breadcrumb(scope: Scope, *, ttyname: TtyName | None = None) -> str | None:
+    """This terminal's recorded session id, or None (off, no terminal, missing, broken, stale)."""
+    try:
+        if not breadcrumbs_enabled(scope):
+            return None
+        ident = terminal_id(scope.env, ttyname=ttyname)
+        if ident is None:
+            return None
+        data: Any = json.loads((_dir(scope) / ident).read_text(encoding="utf-8"))
+        if not isinstance(data, dict):
+            return None
+        record: dict[str, Any] = data  # pyright: ignore[reportUnknownVariableType]
+        session_id = record.get("session_id")
+        if not isinstance(session_id, str) or not session_id.strip():
+            return None
+        at = record.get("at")
+        if isinstance(at, int | float) and _now(scope) - float(at) > STALE_AFTER_S:
+            return None
+        return session_id.strip()
+    except (OSError, ValueError):
+        return None
+    except Exception:
+        log.debug("could not read the terminal breadcrumb", exc_info=True)
+        return None
+
+
+@dataclass(frozen=True)
+class CwdOutcome:
+    """What ``restore_cwd`` did: ``moved`` into ``path``, ``stayed`` (gone or failed, with a
+    ``message``), or ``kept`` (nothing to do)."""
+
+    action: str
+    path: str | None = None
+    message: str | None = None
+
+
+def restore_cwd(recorded: str | None, *, skip: bool) -> CwdOutcome:
+    """Move into a resumed session's recorded directory (see the module notes)."""
+    if skip or not recorded:
+        return CwdOutcome("kept")
+    target = os.path.expanduser(recorded)
+    try:
+        current = os.getcwd()
+    except OSError:
+        current = None
+    if current is not None and os.path.realpath(target) == os.path.realpath(current):
+        return CwdOutcome("kept", target)
+    if not os.path.isdir(target):
+        return CwdOutcome(
+            "stayed",
+            target,
+            f"The session's folder {target} is gone; staying in {current or '.'}.",
+        )
+    try:
+        os.chdir(target)
+    except OSError as exc:
+        return CwdOutcome(
+            "stayed", target, f"Could not enter the session's folder {target}: {exc.strerror}."
+        )
+    return CwdOutcome("moved", target, f"Back in the session's folder: {target}")
+
+
+def rearm_auto_approve(scope: Scope, session_id: str, row: Mapping[str, Any] | None) -> bool:
+    """Re-arm the session's stored auto-approve switch; True when this call turned it on."""
+    from indus.safety.approvals.decision import APPROVALS, session_key
+    from indus.state import sessions
+
+    return APPROVALS.restore_auto_approve(
+        session_key(scope, session_id), sessions.yolo_enabled(row)
+    )
+
+
+# -- one call for every resume path ----------------------------------------------------------------
+
+REASONING_KEY = "reasoning_effort"
+"""``model_config`` key ``/reasoning`` writes; it beats the launch record's reasoning."""
+
+
+@dataclass(frozen=True)
+class Resumed:
+    """What ``resume_session`` restored. ``policy`` is the session's launch record with the later
+    in-session switches applied (``reasoning``); ``history`` is the stored transcript when a host
+    was given (for the recap); ``notices`` are lines for the user."""
+
+    session_id: str
+    row: Mapping[str, Any] | None
+    policy: Any
+    reasoning: str | None
+    toolsets: tuple[str, ...] | None
+    auto_approve: bool
+    cwd: CwdOutcome
+    history: list[Any]
+    notices: tuple[str, ...]
+
+
+def stored_reasoning(row: Mapping[str, Any] | None) -> str | None:
+    """The session's reasoning switch from ``model_config`` (``/reasoning``), if any."""
+    if row is None:
+        return None
+    from indus.state import sessions
+
+    value = sessions.parse_model_config(row.get("model_config")).get(REASONING_KEY)
+    return value.strip().lower() if isinstance(value, str) and value.strip() else None
+
+
+def _handle_of(store: Any, host: Any) -> Any:
+    if store is not None:
+        return store
+    service_store = host.service.store
+    handle = getattr(service_store, "handle", None)
+    if handle is None:
+        raise ValueError("the host's session store has no state store handle")
+    return handle
+
+
+def resume_session(
+    scope: Scope,
+    session_id: str,
+    *,
+    store: Any = None,
+    host: Any = None,
+    restore: bool = True,
+    breadcrumb: bool = True,
+) -> Resumed:
+    """Everything a resume puts back, for ``indus -c`` and the REPL's ``/resume`` alike.
+
+    Give the store handle (``store``) or the in-process host (``host``; its service's state
+    store is used, and the transcript is loaded through it for the recap). ``restore`` False
+    skips the folder change (``--no-restore-cwd``, ``--in``). Re-arms the stored auto-approve
+    switch, reads the launch record and the later ``/reasoning`` switch, writes this terminal's
+    breadcrumb. Never raises for a missing record or folder; an unknown session gives
+    ``row=None``.
+    """
+    from indus.cli.session_select import replace_cwd, stored_launch
+    from indus.state import sessions
+
+    handle = _handle_of(store, host)
+    row = sessions.get(handle, session_id)
+    policy = stored_launch(row)
+    reasoning = stored_reasoning(row) or (policy.reasoning if policy is not None else None)
+    if policy is not None and reasoning != policy.reasoning:
+        from dataclasses import replace
+
+        policy = replace(policy, reasoning=reasoning)
+    recorded = policy.cwd if policy is not None and policy.cwd else (row or {}).get("cwd")
+    outcome = restore_cwd(recorded if isinstance(recorded, str) else None, skip=not restore)
+    here = Path.cwd()
+    if policy is not None:
+        policy = replace_cwd(policy, here)
+    armed = rearm_auto_approve(scope, session_id, row)
+    history: list[Any] = []
+    if host is not None:
+        try:
+            history = list(host.call(host.service.store.load(session_id)))
+        except Exception:
+            log.warning("could not load the history of %s for the recap", session_id, exc_info=True)
+    if breadcrumb:
+        write_breadcrumb(scope, session_id, here)
+    notices: list[str] = []
+    if outcome.message:
+        notices.append(outcome.message)
+    if armed:
+        notices.append("Auto-approve is on for this session again.")
+    return Resumed(
+        session_id=session_id,
+        row=row,
+        policy=policy,
+        reasoning=reasoning,
+        toolsets=policy.toolsets if policy is not None else None,
+        auto_approve=sessions.yolo_enabled(row),
+        cwd=outcome,
+        history=history,
+        notices=tuple(notices),
+    )
diff --git a/src/indus/cli/runtime.py b/src/indus/cli/runtime.py
new file mode 100644
index 0000000..301b120
--- /dev/null
+++ b/src/indus/cli/runtime.py
@@ -0,0 +1,200 @@
+"""Host wiring for the classic CLI: the route, the session service, the agent seams, shutdown.
+
+The agent runs in this process (decision P1, inventory I55) behind ``SessionService``; the
+interactive REPL drives it through ``InProcessHost``, finite runs await it directly. Seams wired
+here (P05 wave 2 notes):
+
+- every agent's ``SessionRuntime.environments`` is the process terminal runtime's registry, so
+  the terminal, file and search tools share one set of backends and one cwd record;
+- ``SessionRuntime.run_context`` tells the approval pipeline who is watching: ``interactive`` for
+  the REPL, ``single_query`` for ``-z`` and finite ``chat -q`` runs;
+- at exit the terminal runtime is shut down (background jobs, then every environment, which is
+  the ``EnvironmentRegistry`` shutdown) on the loop that used it.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass, replace
+from pathlib import Path
+from typing import Any
+
+from indus.cli.args import HostOverrides
+from indus.cli.session_select import LAUNCH_KEY, LaunchPolicy, workspace_key
+from indus.core.agent import Agent, AgentOptions
+from indus.core.events import EventSink
+from indus.core.persist import StateStore
+from indus.core.turn_state import LoopOptions
+from indus.foundation.config import schema
+from indus.foundation.config.loader import ConfigView, config_path
+from indus.foundation.scope import Scope
+from indus.providers.profile import REASONING_LEVELS
+from indus.providers.route import RuntimeRoute, resolve
+from indus.service.broker import ServerRequestBroker
+from indus.service.host_inprocess import InProcessHost
+from indus.service.session_service import AgentFactory, SessionService
+from indus.state.registry import StoreHandle
+from indus.tools.builtin import terminal
+
+__all__ = [
+    "DEFAULT_TOOLSETS",
+    "SOURCE_CLI",
+    "SOURCE_ONESHOT",
+    "ServiceSpec",
+    "agent_factory",
+    "build_service",
+    "defaults_only",
+    "make_host",
+    "reasoning_problem",
+    "resolve_route",
+    "scope_for",
+    "shutdown_terminal",
+    "toolset_selection",
+]
+
+log = logging.getLogger(__name__)
+
+DEFAULT_TOOLSETS: tuple[str, ...] = ("indus-cli",)
+"""The classic CLI's platform bundle, used when no ``-t`` was given."""
+SOURCE_CLI = "cli"
+SOURCE_ONESHOT = "oneshot"
+_YOLO_ENV = "INDUS_YOLO_MODE"
+
+
+def reasoning_problem(level: str | None) -> str | None:
+    """A usage message when ``level`` is not on the ladder (None when fine)."""
+    if level is None or level.strip().lower() in REASONING_LEVELS:
+        return None
+    return f"unknown reasoning level {level!r}; use one of: {', '.join(REASONING_LEVELS)}"
+
+
+def defaults_only(scope: Scope) -> Scope:
+    """``scope`` reading the built-in settings instead of the user's file (``--ignore-user-config``,
+    ``--safe-mode``); ``.env`` and secrets stay."""
+    view = ConfigView(config_path(scope), schema.defaults_tree(), {}, set())
+    return scope.with_config(view)
+
+
+def scope_for(scope: Scope, policy: LaunchPolicy, *, auto_approve: bool = False) -> Scope:
+    """The scope a session runs under: built-in settings when the policy ignores the user's,
+    and ``INDUS_YOLO_MODE`` laid over the env view when the run auto-approves."""
+    out = scope
+    if policy.ignore_user_config or policy.safe_mode:
+        out = defaults_only(out)
+    if auto_approve or policy.yolo:
+        out = out.with_env(out.env.with_overlay({_YOLO_ENV: "1"}))
+    return out
+
+
+def resolve_route(
+    scope: Scope, policy: LaunchPolicy, overrides: HostOverrides | None = None
+) -> RuntimeRoute:
+    """The route for the policy's model and provider (or the test override's route)."""
+    if overrides is not None and overrides.route is not None:
+        route: RuntimeRoute = overrides.route
+        return replace(route, model=policy.model) if policy.model else route
+    return resolve(scope, model=policy.model, provider=policy.provider)
+
+
+def toolset_selection(policy: LaunchPolicy) -> list[str]:
+    return list(policy.toolsets) if policy.toolsets else list(DEFAULT_TOOLSETS)
+
+
+def agent_factory(scope: Scope, route: RuntimeRoute, *, run_context: str) -> AgentFactory:
+    """Builds each session's agent and wires the host seams (see the module notes)."""
+
+    async def build(
+        session_id: str,
+        sink: EventSink,
+        broker: ServerRequestBroker,
+        options: AgentOptions,
+        selection: Sequence[str] | None,
+    ) -> Agent:
+        chosen = route
+        model = options.session_fields.get("model")
+        if isinstance(model, str) and model and model != route.model:
+            chosen = replace(route, model=model)
+        full = replace(options, session_id=session_id, broker=broker)
+        agent = await Agent.start(scope, chosen, selection, full, sink)
+        agent.runtime.environments = terminal.runtime().environments
+        agent.runtime.run_context = run_context
+        return agent
+
+    return build
+
+
+@dataclass(frozen=True)
+class ServiceSpec:
+    """Everything ``build_service`` needs for one CLI run."""
+
+    scope: Scope
+    route: RuntimeRoute
+    policy: LaunchPolicy
+    store: StoreHandle
+    source: str = SOURCE_CLI
+    run_context: str = "interactive"
+    answerable_kinds: Iterable[str] = ()
+    overrides: HostOverrides | None = None
+    new_session: bool = True
+
+
+def _session_fields(spec: ServiceSpec, cwd: Path) -> dict[str, Any]:
+    fields: dict[str, Any] = {"cwd": str(cwd), "model": spec.route.model}
+    root = workspace_key(cwd)
+    if root != cwd or (root / ".git").exists():
+        fields["git_root"] = str(root)
+    if spec.new_session:
+        record = replace(spec.policy, model=spec.route.model, provider=spec.route.provider)
+        fields["model_config"] = {LAUNCH_KEY: record.record()}
+    return fields
+
+
+def _loop_options(spec: ServiceSpec) -> LoopOptions:
+    values: dict[str, Any] = {"platform": "cli"}
+    if spec.policy.max_turns is not None:
+        values["max_iterations"] = max(0, spec.policy.max_turns)
+    if spec.policy.reasoning:
+        values["reasoning_effort"] = spec.policy.reasoning.strip().lower()
+    return LoopOptions.from_scope(spec.scope, **values)
+
+
+def build_service(spec: ServiceSpec) -> SessionService:
+    """The session service for one CLI run (call it on the loop that will run it)."""
+    cwd = Path(spec.policy.cwd) if spec.policy.cwd else Path.cwd()
+    overrides = spec.overrides
+    options = AgentOptions(
+        platform="cli",
+        source=spec.source,
+        cwd=cwd,
+        loop=_loop_options(spec),
+        session_fields=_session_fields(spec, cwd),
+        client_factory=overrides.client_factory if overrides is not None else None,
+        list_models=overrides.list_models if overrides is not None else None,
+    )
+    store = StateStore(spec.store)
+    return SessionService(
+        spec.scope,
+        spec.route,
+        toolsets=toolset_selection(spec.policy),
+        options=replace(options, store=store),
+        store=store,
+        answerable_kinds=spec.answerable_kinds,
+        owner=spec.source,
+        agent_factory=agent_factory(spec.scope, spec.route, run_context=spec.run_context),
+    )
+
+
+def make_host(spec: ServiceSpec, *, call_timeout: float | None = None) -> InProcessHost:
+    """An in-process host (not started) whose service is built from ``spec`` on its loop."""
+    return InProcessHost(
+        lambda: build_service(spec), scope=spec.scope, name="indus-cli", call_timeout=call_timeout
+    )
+
+
+async def shutdown_terminal() -> None:
+    """Stop background jobs and clean every terminal environment (process exit)."""
+    try:
+        await terminal.runtime().shutdown()
+    except Exception:
+        log.warning("terminal shutdown failed", exc_info=True)
diff --git a/src/indus/cli/session_select.py b/src/indus/cli/session_select.py
new file mode 100644
index 0000000..fc4bc11
--- /dev/null
+++ b/src/indus/cli/session_select.py
@@ -0,0 +1,326 @@
+"""Which session a chat opens, and the launch policy frozen into a session when it is created.
+
+Selection (research 04 §3.4.3):
+
+- ``--in DIR``: ``~`` expanded; the directory must exist (else exit 1); the process moves there
+  and the recorded-cwd restore is skipped.
+- ``-r VALUE`` / ``-c NAME``: an exact id, else a unique id prefix, else a title (the newest
+  ``NAME #n`` before the bare ``NAME``); the hit is followed along its compression chain to the
+  live tip. A miss is "No session found matching 'NAME'." on stderr and exit 1.
+- bare ``-c`` / ``--resume latest``: this terminal's breadcrumb when it names a session that still
+  exists (``session.terminal_continue``), else the newest CLI session of this workspace (git root,
+  else cwd), else exit 1. ``--resume latest`` is checked before any title is looked up; a
+  conversation whose title is literally "latest" is opened with ``-c latest`` or by its id.
+
+Launch policy (R04.1, kept in-process): the working directory, route, reasoning, toolsets, turn
+cap, skills and the safety switches are stored in the new session's ``model_config["launch"]``.
+A resume may repeat a stored value; a flag given with a different value is refused (exit 2).
+Flags not given on resume take the stored values.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+from collections.abc import Mapping, Sequence
+from dataclasses import asdict, dataclass, replace
+from pathlib import Path
+from typing import Any
+
+from indus.cli.args import BARE_CONTINUE, LATEST, ChatArgs, GlobalArgs, split_csv
+from indus.foundation.errors import StoreError
+from indus.state import lineage, listing, sessions, titles
+from indus.state.registry import StoreHandle
+
+__all__ = [
+    "BARE_CONTINUE",
+    "CLI_SOURCES",
+    "LATEST",
+    "LAUNCH_KEY",
+    "LaunchPolicy",
+    "SelectionError",
+    "check_frozen",
+    "enter_in_dir",
+    "find_named",
+    "latest_for_workspace",
+    "launch_from_args",
+    "replace_cwd",
+    "select_session",
+    "stored_launch",
+    "workspace_key",
+]
+
+log = logging.getLogger(__name__)
+
+LAUNCH_KEY = "launch"
+CLI_SOURCES: tuple[str, ...] = ("cli", "oneshot")
+"""Sources counted as this surface's history for ``-c`` and ``--resume latest``."""
+
+_LIST_HINT = "Run `indus sessions list` to see your sessions, or start a new one with `indus`."
+
+
+class SelectionError(Exception):
+    """A selection problem the user must fix: printed as is, then ``code`` is the exit code."""
+
+    def __init__(self, message: str, *, code: int = 1, hint: str | None = None) -> None:
+        super().__init__(message)
+        self.message = message
+        self.code = code
+        self.hint = hint
+
+    def lines(self) -> list[str]:
+        return [self.message, *([self.hint] if self.hint else [])]
+
+
+# -- launch policy ---------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class LaunchPolicy:
+    """What a session was started with. ``None`` / empty means "the configured default"."""
+
+    cwd: str | None = None
+    model: str | None = None
+    provider: str | None = None
+    reasoning: str | None = None
+    toolsets: tuple[str, ...] | None = None
+    max_turns: int | None = None
+    skills: tuple[str, ...] = ()
+    yolo: bool = False
+    pass_session_id: bool = False
+    ignore_rules: bool = False
+    ignore_user_config: bool = False
+    safe_mode: bool = False
+
+    def record(self) -> dict[str, Any]:
+        out = asdict(self)
+        out["toolsets"] = list(self.toolsets) if self.toolsets is not None else None
+        out["skills"] = list(self.skills)
+        return out
+
+    @classmethod
+    def from_record(cls, data: Mapping[str, Any]) -> LaunchPolicy:
+        def text(name: str) -> str | None:
+            value = data.get(name)
+            return value if isinstance(value, str) and value else None
+
+        toolsets = data.get("toolsets")
+        skills = data.get("skills")
+        turns = data.get("max_turns")
+        return cls(
+            cwd=text("cwd"),
+            model=text("model"),
+            provider=text("provider"),
+            reasoning=text("reasoning"),
+            toolsets=tuple(str(t) for t in toolsets) if isinstance(toolsets, list) else None,
+            max_turns=turns if isinstance(turns, int) and not isinstance(turns, bool) else None,
+            skills=tuple(str(s) for s in skills) if isinstance(skills, list) else (),
+            yolo=data.get("yolo") is True,
+            pass_session_id=data.get("pass_session_id") is True,
+            ignore_rules=data.get("ignore_rules") is True,
+            ignore_user_config=data.get("ignore_user_config") is True,
+            safe_mode=data.get("safe_mode") is True,
+        )
+
+
+def launch_from_args(
+    args: GlobalArgs, chat: ChatArgs, *, cwd: Path
+) -> tuple[LaunchPolicy, Mapping[str, Any]]:
+    """The policy for a new session from this run's flags, and the flags given explicitly."""
+    toolsets = split_csv(args.toolsets)
+    skills = split_csv(list(args.skills)) or []
+    policy = LaunchPolicy(
+        cwd=str(cwd),
+        model=args.model,
+        provider=args.provider,
+        reasoning=args.reasoning,
+        toolsets=tuple(toolsets) if toolsets is not None else None,
+        max_turns=chat.max_turns,
+        skills=tuple(skills),
+        yolo=args.yolo,
+        pass_session_id=args.pass_session_id,
+        ignore_rules=args.ignore_rules,
+        ignore_user_config=args.ignore_user_config,
+        safe_mode=args.safe_mode,
+    )
+    given: dict[str, Any] = {}
+    if args.in_dir is not None:
+        given["cwd"] = str(cwd)
+    for name in ("model", "provider", "reasoning"):
+        value = getattr(args, name)
+        if value is not None:
+            given[name] = value
+    if toolsets is not None:
+        given["toolsets"] = tuple(toolsets)
+    if chat.max_turns is not None:
+        given["max_turns"] = chat.max_turns
+    if skills:
+        given["skills"] = tuple(skills)
+    for name in ("yolo", "pass_session_id", "ignore_rules", "ignore_user_config", "safe_mode"):
+        if getattr(args, name):
+            given[name] = True
+    return policy, given
+
+
+_FLAG_NAMES = {
+    "cwd": "--in",
+    "model": "--model",
+    "provider": "--provider",
+    "reasoning": "--reasoning",
+    "toolsets": "--toolsets",
+    "max_turns": "--max-turns",
+    "skills": "--skills",
+    "yolo": "--yolo",
+    "pass_session_id": "--pass-session-id",
+    "ignore_rules": "--ignore-rules",
+    "ignore_user_config": "--ignore-user-config",
+    "safe_mode": "--safe-mode",
+}
+
+
+def _same(name: str, given: Any, stored: Any) -> bool:
+    if name == "cwd":
+        if not stored:
+            return True
+        try:
+            return os.path.realpath(str(given)) == os.path.realpath(str(stored))
+        except (OSError, ValueError):
+            return str(given) == str(stored)
+    if name in ("toolsets", "skills"):
+        return sorted(given or ()) == sorted(stored or ())
+    return given == stored
+
+
+def check_frozen(stored: LaunchPolicy, given: Mapping[str, Any]) -> list[str]:
+    """Flags given on resume whose value differs from the session's stored one."""
+    conflicts: list[str] = []
+    for name, value in given.items():
+        if not _same(name, value, getattr(stored, name)):
+            conflicts.append(_FLAG_NAMES.get(name, name))
+    return conflicts
+
+
+def replace_cwd(policy: LaunchPolicy, cwd: Path) -> LaunchPolicy:
+    """``policy`` working in ``cwd`` (where the CLI actually is after restore or ``--in``)."""
+    return replace(policy, cwd=str(cwd))
+
+
+def stored_launch(row: Mapping[str, Any] | None) -> LaunchPolicy | None:
+    """The launch record of a session row, or None when it has none (another surface made it)."""
+    if row is None:
+        return None
+    config = sessions.parse_model_config(row.get("model_config"))
+    data = config.get(LAUNCH_KEY)
+    if not isinstance(data, Mapping):
+        return None
+    policy = LaunchPolicy.from_record(data)  # pyright: ignore[reportUnknownArgumentType]
+    if policy.cwd is None and isinstance(row.get("cwd"), str):
+        policy = replace(policy, cwd=row["cwd"])
+    return policy
+
+
+# -- workspace and lookups -------------------------------------------------------------------------
+
+
+def workspace_key(cwd: Path) -> Path:
+    """The git work tree holding ``cwd`` (a ``.git`` dir or file), else ``cwd`` itself."""
+    here = cwd
+    for candidate in (here, *here.parents):
+        if (candidate / ".git").exists():
+            return candidate
+    return here
+
+
+def enter_in_dir(raw: str) -> Path:
+    """``--in DIR``: expand ``~``, check it exists, change into it. Raises ``SelectionError``."""
+    target = Path(os.path.expanduser(raw))
+    with contextlib.suppress(OSError):
+        target = target.resolve()
+    if not target.is_dir():
+        raise SelectionError(f"--in: no such directory: {raw}")
+    try:
+        os.chdir(target)
+    except OSError as exc:
+        raise SelectionError(f"--in: cannot enter {raw}: {exc.strerror or exc}") from exc
+    return target
+
+
+def _tip(store: StoreHandle, session_id: str) -> str:
+    try:
+        with store.read() as conn:
+            return lineage.tip_in(conn, session_id)
+    except StoreError as exc:
+        log.warning("could not follow session %s to its newest part: %s", session_id, exc)
+        return session_id
+
+
+def find_named(store: StoreHandle, text: str) -> str | None:
+    """An exact id, a unique id prefix, then a title; followed to the compression tip."""
+    wanted = text.strip()
+    if not wanted:
+        return None
+    found: str | None = None
+    try:
+        found = sessions.resolve_id(store, wanted)
+    except sessions.AmbiguousSessionId:
+        found = None
+    except sessions.SessionNotFound:
+        found = None
+    if found is None:
+        found = titles.resolve_title(store, wanted)
+    return _tip(store, found) if found is not None else None
+
+
+def latest_for_workspace(
+    store: StoreHandle, workspace: Path, sources: Sequence[str] = CLI_SOURCES
+) -> str | None:
+    """The most recently used session of ``workspace`` from this surface's sources."""
+    filters = listing.ListFilters(sources=list(sources), workspace=str(workspace))
+    rows = listing.list_sessions(store, filters, limit=50)
+    if not rows:
+        return None
+    best = max(rows, key=lambda r: (r.last_active or r.started_at, r.started_at))
+    return _tip(store, best.lineage_ids[-1] if best.lineage_ids else best.id)
+
+
+def _exists(store: StoreHandle, session_id: str) -> bool:
+    try:
+        return sessions.get(store, session_id) is not None
+    except StoreError:
+        return False
+
+
+def select_session(
+    store: StoreHandle,
+    args: GlobalArgs,
+    *,
+    cwd: Path,
+    breadcrumb: str | None = None,
+) -> str | None:
+    """The session id to resume for ``args``, or None for a new session.
+
+    ``breadcrumb`` is this terminal's recorded session (``resume.read_breadcrumb``), consulted
+    only for the "latest" forms. Raises ``SelectionError`` on a miss.
+    """
+    if args.resume is not None:
+        wanted = args.resume
+        latest = wanted.strip().lower() == LATEST
+    elif args.continue_ is not None:
+        wanted = args.continue_
+        latest = wanted == BARE_CONTINUE
+    else:
+        return None
+    if latest:
+        if breadcrumb and _exists(store, breadcrumb):
+            return _tip(store, breadcrumb)
+        found = latest_for_workspace(store, workspace_key(cwd))
+        if found is None:
+            raise SelectionError(
+                "No earlier session to continue in this workspace.", hint=_LIST_HINT
+            )
+        return found
+    found = find_named(store, wanted)
+    if found is None:
+        raise SelectionError(f"No session found matching '{wanted}'.", hint=_LIST_HINT)
+    return found
