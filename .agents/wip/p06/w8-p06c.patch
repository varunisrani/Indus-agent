+"""Slash commands of the classic CLI (P06-09/10): ``dispatch`` runs them, ``context`` holds the
+types the REPL builds (``SlashContext``) and gets back (``SlashResult``), ``port`` adapts the
+in-process host, ``session_cmds`` and ``control_cmds`` hold the handlers. The command table itself
+is ``indus.service.commands.registry``."""
diff --git a/src/indus/cli/slash/context.py b/src/indus/cli/slash/context.py
new file mode 100644
index 0000000..ff21829
--- /dev/null
+++ b/src/indus/cli/slash/context.py
@@ -0,0 +1,213 @@
+"""What a slash handler works with, and what it hands back to the REPL (P06-09).
+
+The REPL (``indus.cli.repl``) builds one ``SlashContext`` per chat and passes it to every
+``dispatch`` call. Handlers never touch the terminal or the agent directly:
+
+- they print through ``ctx.out`` (one call per line of plain text);
+- they reach the session service through ``ctx.port`` (a ``SessionPort``; ``port.HostPort`` adapts
+  the in-process host) and the store through ``ctx.store``;
+- they answer with a ``SlashResult`` saying what the REPL must do next — leave, switch to another
+  session, clear the screen, send a message as a turn, or put text back in the composer.
+
+``ReplState`` is the part of the REPL's state that commands read or change: the queued messages,
+the armed ``/resume`` list, the reasoning display switch, the session's toolset selection and the
+row changes that wait for the session row to exist (a fresh session has no row until its first turn
+is stored).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from typing import Any, Protocol
+
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.protocol.methods import SessionCreateParams
+from indus.protocol.server_requests import ApprovalAnswer, ApprovalRequest
+from indus.providers.route import RuntimeRoute
+from indus.state.registry import StoreHandle
+
+__all__ = [
+    "Extensions",
+    "ExtensionHandler",
+    "Handler",
+    "Observer",
+    "Output",
+    "ReplState",
+    "RouteInfo",
+    "SessionPort",
+    "SlashContext",
+    "SlashResult",
+]
+
+type Output = Callable[[str], None]
+"""Prints one line (or several joined by newlines) of plain text."""
+
+
+@dataclass(frozen=True)
+class SlashResult:
+    """What the REPL does after a command.
+
+    ``switch_to``: the session the REPL is on from now (``ctx.session_id`` is already updated);
+    ``resumed``: that session has history (show the recap). ``submit``: send this text as a turn.
+    ``prefill``: put this text back in the composer. ``clear_screen``: clear before going on.
+    ``exit``: leave the REPL.
+    """
+
+    exit: bool = False
+    switch_to: str | None = None
+    resumed: bool = False
+    clear_screen: bool = False
+    submit: str | None = None
+    prefill: str | None = None
+
+
+@dataclass(frozen=True)
+class RouteInfo:
+    """The route a session is bound to, as commands show and change it."""
+
+    route: RuntimeRoute
+    context_length: int
+    reasoning_effort: str | None
+    requested_effort: str | None
+
+    @property
+    def provider(self) -> str:
+        return self.route.provider
+
+    @property
+    def model(self) -> str:
+        return self.route.model
+
+    @property
+    def base_url(self) -> str:
+        return self.route.base_url
+
+
+class SessionPort(Protocol):
+    """What commands may ask of the session service (blocking calls)."""
+
+    def create(self, params: SessionCreateParams) -> str:
+        """Create and attach a session; its id."""
+        ...
+
+    def resume(self, session_id: str) -> None:
+        """Attach a stored session."""
+        ...
+
+    def close(self, session_id: str) -> None:
+        """Detach a session (unknown ids are ignored)."""
+        ...
+
+    def interrupt(self, session_id: str) -> bool:
+        """Stop the running turn; False when none runs."""
+        ...
+
+    def wait_idle(self, session_id: str, timeout: float) -> bool:
+        """Wait up to ``timeout`` s for the running turn to end; True when nothing runs now."""
+        ...
+
+    def steer(self, session_id: str, text: str) -> bool:
+        """Hand guidance to the running turn; False when none runs."""
+        ...
+
+    def route(self, session_id: str) -> RouteInfo:
+        """The session's current route."""
+        ...
+
+    def switch_route(
+        self, session_id: str, route: RuntimeRoute, *, effort: str | None = None, keep_effort: bool
+    ) -> RouteInfo:
+        """Rebind the session to ``route`` all or nothing (raises and stays put on failure).
+        ``keep_effort`` keeps the requested reasoning effort, else ``effort`` replaces it."""
+        ...
+
+    def tool_names(self, session_id: str) -> list[str]:
+        """The tools the session's agent offers the model."""
+        ...
+
+    def stop_processes(self, session_id: str, *, all_jobs: bool) -> int:
+        """Stop the session's background processes (``all_jobs`` False keeps the ones marked to
+        outlive the session); how many were stopped."""
+        ...
+
+
+type Handler = Callable[["SlashContext", str], SlashResult]
+"""A built-in command handler: ``(ctx, arguments)``; arguments keep their case."""
+
+type ExtensionHandler = Callable[[str, "SlashContext"], SlashResult | None]
+"""A plugin or skill command: ``(arguments, ctx)``; None means "done, nothing more"."""
+
+type Observer = Callable[[str, str, "SlashContext"], object]
+"""Called with ``(command, arguments, ctx)`` before built-ins run; its result is ignored."""
+
+
+@dataclass
+class Extensions:
+    """Seams for commands that do not come from the registry (filled by P09 and P13)."""
+
+    plugin_commands: Mapping[str, ExtensionHandler] = field(
+        default_factory=dict[str, ExtensionHandler]
+    )
+    skill_commands: Mapping[str, ExtensionHandler] = field(
+        default_factory=dict[str, ExtensionHandler]
+    )
+    observers: list[Observer] = field(default_factory=list[Observer])
+
+
+@dataclass
+class ReplState:
+    """REPL state commands read and change (see the module notes)."""
+
+    queue: list[str] = field(default_factory=list[str])
+    resume_choices: list[str] | None = None
+    show_reasoning: bool = False
+    toolsets: list[str] | None = None
+    pending_title: str | None = None
+    pending_config: dict[str, Any] = field(default_factory=dict[str, Any])
+
+    def forget_session(self) -> None:
+        """Called when the REPL moves to another session."""
+        self.queue.clear()
+        self.resume_choices = None
+        self.pending_title = None
+        self.pending_config.clear()
+
+
+def _no(_question: str) -> bool:
+    return False
+
+
+def _idle() -> bool:
+    return False
+
+
+@dataclass
+class SlashContext:
+    """Everything a slash handler may use (see the module notes)."""
+
+    scope: Scope
+    port: SessionPort
+    session_id: str
+    out: Output
+    store: StoreHandle | None = None
+    state: ReplState = field(default_factory=ReplState)
+    create_params: SessionCreateParams = field(default_factory=SessionCreateParams)
+    is_busy: Callable[[], bool] = _idle
+    confirm: Callable[[str], bool] = _no
+    ask_approval: Callable[[ApprovalRequest], ApprovalAnswer | None] | None = None
+    session_cwd: Callable[[], str | None] | None = None
+    clock: Clock | None = None
+    interactive: bool = True
+    extensions: Extensions = field(default_factory=Extensions)
+    catalogue: Mapping[str, str] | None = None
+    busy_wait_s: float = 30.0
+
+    @property
+    def time(self) -> Clock:
+        return self.clock if self.clock is not None else self.scope.clock
+
+    def say(self, *lines: str) -> None:
+        for line in lines:
+            self.out(line)
diff --git a/src/indus/cli/slash/control_cmds.py b/src/indus/cli/slash/control_cmds.py
new file mode 100644
index 0000000..d24d4cf
--- /dev/null
+++ b/src/indus/cli/slash/control_cmds.py
@@ -0,0 +1,528 @@
+"""Control and info commands of the classic CLI (P06-10).
+
+``/model`` and ``/reasoning`` change the session's route through its ``RouteBinding``, all or
+nothing (a refused or half-applied switch leaves the old route in place). With ``--global`` the
+choice is also saved through the config writer; leaving a custom endpoint clears the saved base
+URL and wire mode so the new key is never posted to the old host (R04.9).
+
+``/yolo`` flips the session's auto-approve switch and stores it on the session row (so a resume
+keeps it). ``/approvals`` saves ``approvals.mode`` for the profile and reads it back; the approval
+pipeline reads the setting on every check, so nothing has to be rebuilt. ``/tools enable|disable``
+starts a fresh session with the changed toolsets, because the system prompt depends on the tools.
+
+Every setting write is reported, never raised: a managed install or an unreadable config file
+prints its message and the REPL goes on.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Iterable
+from typing import Any
+
+from indus import __version__
+from indus.cli import quick_commands
+from indus.cli.slash import session_cmds
+from indus.cli.slash.context import Handler, SlashContext, SlashResult
+from indus.foundation import yamlio
+from indus.foundation.config import loader, writer
+from indus.foundation.config.errors import ConfigError
+from indus.foundation.errors import IndusError
+from indus.providers import route as routes
+from indus.providers.registry import Registry
+from indus.providers.types import EFFORT_LADDER, normalize_effort
+from indus.safety.approvals import APPROVALS, session_key
+from indus.safety.approvals.decision import approval_mode
+from indus.safety.redaction import redact_output
+from indus.service.commands.registry import CATEGORY_TITLES, REGISTRY, CommandDef
+from indus.state import sessions, usage
+from indus.tools import toolsets as toolset_table
+
+__all__ = ["HANDLERS", "help_lines"]
+
+log = logging.getLogger(__name__)
+
+APPROVAL_MODES = ("manual", "smart", "off")
+REASONING_LEVELS = ("none", *EFFORT_LADDER)
+DISPLAY_WORDS = {"show": True, "hide": False}
+
+
+def _flags(args: str, *names: str) -> tuple[list[str], set[str]]:
+    """``(other words, flags present)`` for the boolean ``names`` (case-insensitive)."""
+    words: list[str] = []
+    found: set[str] = set()
+    for word in args.split():
+        if word.lower() in names:
+            found.add(word.lower())
+        else:
+            words.append(word)
+    return words, found
+
+
+def _save_config(ctx: SlashContext, patch: dict[str, Any], what: str) -> bool:
+    try:
+        writer.save(ctx.scope, patch)
+    except ConfigError as exc:
+        hint = f" ({exc.hint})" if exc.hint else ""
+        ctx.say(f"{what} was not saved: {exc.message}{hint}")
+        return False
+    except OSError as exc:
+        ctx.say(f"{what} was not saved: {exc}")
+        return False
+    return True
+
+
+def _fresh(ctx: SlashContext, key: str, default: Any = None) -> Any:
+    try:
+        view = loader.load(ctx.scope)
+    except Exception:
+        log.warning("config could not be read", exc_info=True)
+        return default
+    return view.get(key, default)
+
+
+# -- /model ---------------------------------------------------------------------------------------
+
+
+def _split_model(word: str, registry: Registry) -> tuple[str | None, str]:
+    """``provider:model`` when the part before the colon names a provider, else the model."""
+    if ":" in word:
+        head, _, tail = word.partition(":")
+        if tail and registry.lookup(head) is not None:
+            return head, tail
+    return None, word
+
+
+def cmd_model(ctx: SlashContext, args: str) -> SlashResult:
+    words = args.split()
+    provider: str | None = None
+    keep_global = False
+    rest: list[str] = []
+    index = 0
+    while index < len(words):
+        word = words[index]
+        if word == "--provider" and index + 1 < len(words):
+            provider = words[index + 1]
+            index += 2
+            continue
+        if word.startswith("--provider="):
+            provider = word.partition("=")[2]
+        elif word == "--global":
+            keep_global = True
+        elif word == "--session":
+            pass
+        else:
+            rest.append(word)
+        index += 1
+    before = ctx.port.route(ctx.session_id)
+    if not rest and provider is None:
+        ctx.say(
+            f"Model: {before.model} (provider {before.provider}, "
+            f"context window {before.context_length:,} tokens)",
+            "Switch with /model NAME, /model PROVIDER:NAME or --provider NAME; "
+            "--global also saves it.",
+        )
+        return SlashResult()
+    if len(rest) > 1:
+        ctx.say("Usage: /model [provider:model] [--provider name] [--global]")
+        return SlashResult()
+    registry = Registry(ctx.scope)
+    named_provider, model = _split_model(rest[0], registry) if rest else (None, before.model)
+    provider = provider or named_provider or before.provider
+    try:
+        target = routes.resolve(ctx.scope, model=model, provider=provider, registry=registry)
+    except IndusError as exc:
+        hint = f" ({exc.hint})" if exc.hint else ""
+        ctx.say(f"Cannot switch to {model}: {exc.message}{hint}")
+        return SlashResult()
+    try:
+        after = ctx.port.switch_route(ctx.session_id, target, keep_effort=True)
+    except Exception as exc:
+        message = exc.message if isinstance(exc, IndusError) else str(exc)
+        log.info("model switch refused: %s", exc)
+        ctx.say(
+            f"Could not switch to {target.model} ({target.provider}): {message}",
+            f"Still on {before.model} ({before.provider}).",
+        )
+        return SlashResult()
+    ctx.say(
+        f"Switched to {after.model} ({after.provider}), "
+        f"context window {after.context_length:,} tokens."
+    )
+    if keep_global and _save_global_model(ctx, after.route):
+        ctx.say("Saved as the default model.")
+    return SlashResult()
+
+
+def _save_global_model(ctx: SlashContext, target: routes.RuntimeRoute) -> bool:
+    """Save the route as the profile default; never leave a custom endpoint's URL behind."""
+    model: dict[str, Any] = {"default": target.model, "provider": target.provider}
+    custom = target.profile is not None and target.profile.is_custom
+    if custom:
+        model["base_url"] = target.base_url
+        if target.api_mode:
+            model["api_mode"] = target.api_mode
+    else:
+        saved_url = str(_fresh(ctx, "model.base_url") or "")
+        saved_mode = str(_fresh(ctx, "model.api_mode") or "")
+        if saved_url:
+            model["base_url"] = ""
+        if saved_mode:
+            model["api_mode"] = ""
+    return _save_config(ctx, {"model": model}, "The model")
+
+
+# -- /reasoning -----------------------------------------------------------------------------------
+
+
+def cmd_reasoning(ctx: SlashContext, args: str) -> SlashResult:
+    words, flags = _flags(args, "--global", "--session")
+    if not words:
+        info = ctx.port.route(ctx.session_id)
+        level = info.reasoning_effort or "off"
+        shown = "shown" if ctx.state.show_reasoning else "hidden"
+        ctx.say(
+            f"Reasoning effort: {level}; reasoning text is {shown}.",
+            "Set with /reasoning " + "|".join(REASONING_LEVELS) + " [--global], or show/hide.",
+        )
+        return SlashResult()
+    word = words[0].lower()
+    if word in DISPLAY_WORDS and len(words) == 1:
+        ctx.state.show_reasoning = DISPLAY_WORDS[word]
+        ctx.say("Reasoning text will be " + ("shown." if ctx.state.show_reasoning else "hidden."))
+        return SlashResult()
+    if word not in REASONING_LEVELS and word != "off":
+        ctx.say(
+            f"Unknown reasoning setting '{words[0]}'.", "Levels: " + ", ".join(REASONING_LEVELS)
+        )
+        return SlashResult()
+    effort = normalize_effort(word)
+    info = ctx.port.route(ctx.session_id)
+    try:
+        after = ctx.port.switch_route(ctx.session_id, info.route, effort=effort, keep_effort=False)
+    except Exception as exc:
+        message = exc.message if isinstance(exc, IndusError) else str(exc)
+        ctx.say(f"Reasoning effort was not changed: {message}")
+        return SlashResult()
+    session_cmds.remember_config(ctx, {"reasoning_effort": effort or "none"})
+    applied = after.reasoning_effort or "off"
+    note = "" if applied == (effort or "off") else f" (this model uses {applied})"
+    scope_note = "this session"
+    if "--global" in flags and _save_config(
+        ctx, {"agent": {"reasoning_effort": effort or "none"}}, "The reasoning effort"
+    ):
+        scope_note = "this session and saved as the default"
+    ctx.say(f"Reasoning effort {effort or 'off'} for {scope_note}{note}.")
+    return SlashResult()
+
+
+# -- /yolo, /approvals ----------------------------------------------------------------------------
+
+
+def cmd_yolo(ctx: SlashContext, args: str) -> SlashResult:
+    key = session_key(ctx.scope, ctx.session_id)
+    enabled = not APPROVALS.auto_approve(key)
+
+    def persist(value: bool) -> object:
+        return session_cmds.remember_config(ctx, {sessions.YOLO_KEY: bool(value)})
+
+    APPROVALS.set_auto_approve(key, enabled, persist=persist)
+    if enabled:
+        ctx.say(
+            "Auto-approve is ON for this session: risky commands run without asking.",
+            "Commands that are never allowed are still blocked. /yolo again turns it off.",
+        )
+    else:
+        ctx.say("Auto-approve is off: risky commands ask first again.")
+    return SlashResult()
+
+
+def cmd_approvals(ctx: SlashContext, args: str) -> SlashResult:
+    current = approval_mode(ctx.scope)
+    wanted = args.strip().lower()
+    if not wanted:
+        ctx.say(f"Approval mode: {current} (saved for this profile).")
+        return SlashResult()
+    if wanted not in APPROVAL_MODES:
+        ctx.say("Usage: /approvals [manual|smart|off]")
+        return SlashResult()
+    if not _save_config(ctx, {"approvals": {"mode": wanted}}, "The approval mode"):
+        return SlashResult()
+    loader.invalidate(loader.config_path(ctx.scope))
+    effective = approval_mode(ctx.scope)
+    if effective != wanted:
+        ctx.say(f"Approval mode is still {effective}; the saved value did not take effect.")
+        return SlashResult()
+    ctx.say(f"Approval mode: {effective} (saved for this profile).")
+    return SlashResult()
+
+
+# -- /tools ---------------------------------------------------------------------------------------
+
+
+def _named_sets_of(tools: Iterable[str]) -> list[str]:
+    """The plain named toolsets whose tools the session has (an "everything" selection, spelled
+    out); a set wholly inside another chosen one is left out, so disabling the larger one takes
+    its tools away."""
+    have = set(tools)
+    found: dict[str, frozenset[str]] = {}
+    for name in toolset_table.toolset_names():
+        entry = toolset_table.TOOLSETS.get(name)
+        if name.startswith(toolset_table.BUNDLE_PREFIX) or entry is None:
+            continue
+        if entry.includes or entry.posture or not entry.tools:
+            continue
+        members = frozenset(entry.tools)
+        if members <= have:
+            found[name] = members
+    return [
+        name
+        for name, members in found.items()
+        if not any(members < other for other in found.values())
+    ]
+
+
+def cmd_tools(ctx: SlashContext, args: str) -> SlashResult:
+    words = args.split()
+    action = words[0].lower() if words else "list"
+    names = list(words[1:])
+    tools = sorted(ctx.port.tool_names(ctx.session_id))
+    if action == "list":
+        ctx.say(f"Tools in this session ({len(tools)}): " + (", ".join(tools) or "none"))
+        current = ctx.state.toolsets
+        ctx.say("Toolsets: " + (", ".join(current) if current is not None else "the default set"))
+        return SlashResult()
+    if action not in ("enable", "disable") or not names:
+        ctx.say("Usage: /tools [list|enable|disable] [toolset...]")
+        return SlashResult()
+    unknown = [n for n in names if not toolset_table.is_known(n)]
+    if unknown:
+        ctx.say("Unknown toolset: " + ", ".join(unknown) + ".")
+        ctx.say("Known: " + ", ".join(toolset_table.toolset_names()))
+        return SlashResult()
+    selection = ctx.state.toolsets
+    if selection is None:
+        selection = _named_sets_of(tools)
+    if action == "enable":
+        chosen = [*selection, *(n for n in names if n not in selection)]
+    else:
+        chosen = [n for n in selection if n not in names]
+    if chosen == selection and ctx.state.toolsets is not None:
+        ctx.say("Nothing to change.")
+        return SlashResult()
+    ctx.say("The tools change the system prompt, so a fresh session starts now.")
+    return session_cmds.start_new_session(ctx, toolsets=chosen)
+
+
+# -- info -----------------------------------------------------------------------------------------
+
+
+def cmd_config(ctx: SlashContext, args: str) -> SlashResult:
+    try:
+        view = loader.load(ctx.scope)
+    except Exception as exc:
+        ctx.say(f"The config could not be read: {exc}")
+        return SlashResult()
+    text = yamlio.dump_plain(view.as_dict())
+    ctx.say(f"Effective settings ({loader.config_path(ctx.scope)}):")
+    ctx.say(redact_output(text, force=True, scope=ctx.scope).rstrip())
+    return SlashResult()
+
+
+def _status_lines(ctx: SlashContext) -> list[str]:
+    info = ctx.port.route(ctx.session_id)
+    row = sessions.get(ctx.store, ctx.session_id) if ctx.store is not None else None
+    title = (row or {}).get("title") or ctx.state.pending_title or "untitled"
+    count = int((row or {}).get("message_count") or 0)
+    auto = APPROVALS.auto_approve(session_key(ctx.scope, ctx.session_id))
+    return [
+        f"Session: {ctx.session_id} ({title}), {count} messages"
+        + (", reply running" if ctx.is_busy() else ""),
+        f"Model: {info.model} (provider {info.provider}), "
+        f"reasoning {info.reasoning_effort or 'off'}",
+        f"Approvals: {approval_mode(ctx.scope)}" + (", auto-approve ON" if auto else ""),
+        f"Profile: {ctx.scope.profile_id} at {ctx.scope.home}",
+    ]
+
+
+def cmd_status(ctx: SlashContext, args: str) -> SlashResult:
+    ctx.say(*_status_lines(ctx))
+    if ctx.state.queue:
+        ctx.say(f"Queued messages: {len(ctx.state.queue)}")
+    return SlashResult()
+
+
+def cmd_context(ctx: SlashContext, args: str) -> SlashResult:
+    info = ctx.port.route(ctx.session_id)
+    used = 0
+    if ctx.store is not None:
+        totals = usage.totals(ctx.store, ctx.session_id)
+        used = totals.input_tokens
+    ctx.say(f"Context window: {info.context_length:,} tokens ({info.model}).")
+    if used:
+        ctx.say(
+            f"Input tokens sent so far in this session: {used:,}. A per-request gauge arrives "
+            "with P08."
+        )
+    else:
+        ctx.say("No requests yet in this session.")
+    return SlashResult()
+
+
+def cmd_usage(ctx: SlashContext, args: str) -> SlashResult:
+    if ctx.store is None:
+        ctx.say("Usage is not recorded in this run.")
+        return SlashResult()
+    totals = usage.totals(ctx.store, ctx.session_id)
+    ctx.say(
+        f"Requests: {totals.api_calls}",
+        f"Tokens in: {totals.input_tokens:,}, out: {totals.output_tokens:,}, "
+        f"cache read: {totals.cache_read_tokens:,}, cache write: {totals.cache_write_tokens:,}, "
+        f"reasoning: {totals.reasoning_tokens:,}",
+        "Cost: n/a (prices arrive with P08)",
+    )
+    return SlashResult()
+
+
+def cmd_whoami(ctx: SlashContext, args: str) -> SlashResult:
+    ctx.say(
+        f"Profile: {ctx.scope.profile_id}",
+        f"Home: {ctx.scope.home}",
+        f"Session: {ctx.session_id}",
+    )
+    return SlashResult()
+
+
+def cmd_version(ctx: SlashContext, args: str) -> SlashResult:
+    ctx.say(f"Indus Agent {__version__}")
+    return SlashResult()
+
+
+def help_lines(ctx: SlashContext, needle: str = "") -> list[str]:
+    """``/help`` text: runnable commands grouped by category, then quick commands."""
+    from indus.cli.slash.dispatch import HANDLERS
+
+    wanted = needle.strip().lstrip("/").lower()
+
+    def matches(cmd: CommandDef) -> bool:
+        if not wanted:
+            return True
+        text = " ".join((*cmd.keys, REGISTRY.describe(cmd, ctx.catalogue))).lower()
+        return wanted in text
+
+    runnable = [c for c in REGISTRY.commands("cli") if c.name in HANDLERS and matches(c)]
+    lines: list[str] = []
+    for category, members in REGISTRY.by_category(runnable).items():
+        lines.append(f"{CATEGORY_TITLES[category]}:")
+        for cmd in members:
+            aliases = ", ".join(f"/{a}" for a in cmd.aliases)
+            alias_note = f" (also {aliases})" if aliases else ""
+            lines.append(f"  {cmd.usage():<34} {REGISTRY.describe(cmd, ctx.catalogue)}{alias_note}")
+    quick = [n for n in quick_commands.names(ctx.scope) if not wanted or wanted in n]
+    if quick:
+        lines.append("Quick commands:")
+        lines.extend(f"  /{name}" for name in quick)
+    if not lines:
+        lines.append(f"No command matches '{needle.strip()}'.")
+    else:
+        lines.append("Also: !COMMAND runs a shell command here without asking the model.")
+    return lines
+
+
+def cmd_help(ctx: SlashContext, args: str) -> SlashResult:
+    ctx.say(*help_lines(ctx, args))
+    return SlashResult()
+
+
+# -- running work ---------------------------------------------------------------------------------
+
+
+def cmd_stop(ctx: SlashContext, args: str) -> SlashResult:
+    stopped_turn = ctx.port.interrupt(ctx.session_id)
+    jobs = ctx.port.stop_processes(ctx.session_id, all_jobs=True)
+    parts: list[str] = []
+    if stopped_turn:
+        parts.append("stopped the reply")
+    if jobs:
+        parts.append(f"stopped {jobs} background process" + ("es" if jobs != 1 else ""))
+    ctx.say(("Done: " + " and ".join(parts) + ".") if parts else "Nothing was running.")
+    return SlashResult()
+
+
+def cmd_steer(ctx: SlashContext, args: str) -> SlashResult:
+    text = args.strip()
+    if not text:
+        ctx.say("Usage: /steer TEXT")
+        return SlashResult()
+    if not ctx.is_busy() or not ctx.port.steer(ctx.session_id, text):
+        ctx.say("Nothing is running to steer; send it as a normal message instead.")
+        return SlashResult()
+    ctx.say("Guidance noted; the agent sees it after its next tool call.")
+    return SlashResult()
+
+
+def cmd_queue(ctx: SlashContext, args: str) -> SlashResult:
+    words = args.split()
+    queue = ctx.state.queue
+    action = words[0].lower() if words else "list"
+    if action == "list" and len(words) <= 1:
+        if not queue:
+            ctx.say("No queued messages.")
+        else:
+            ctx.say("Queued messages:")
+            ctx.say(*(f"  {n}. {text}" for n, text in enumerate(queue, start=1)))
+        return SlashResult()
+    if action == "clear" and len(words) == 1:
+        dropped = len(queue)
+        queue.clear()
+        ctx.say(f"Cleared {dropped} queued message" + ("s." if dropped != 1 else "."))
+        return SlashResult()
+    if action == "rm" and len(words) == 2 and words[1].isdigit():
+        index = int(words[1])
+        if not 1 <= index <= len(queue):
+            ctx.say(f"There is no queued message number {index}.")
+            return SlashResult()
+        removed = queue.pop(index - 1)
+        ctx.say(f"Removed: {removed}")
+        return SlashResult()
+    text = args.strip()
+    if action == "add":
+        text = text[len(words[0]) :].strip()
+        if not text:
+            ctx.say("Usage: /queue add TEXT")
+            return SlashResult()
+    if not ctx.is_busy():
+        return SlashResult(submit=text)
+    queue.append(text)
+    ctx.say(f"Queued ({len(queue)} waiting); it is sent when the current reply ends.")
+    return SlashResult()
+
+
+def cmd_compress(ctx: SlashContext, args: str) -> SlashResult:
+    ctx.say("Compressing the conversation arrives with P08.")
+    return SlashResult()
+
+
+def cmd_quit(ctx: SlashContext, args: str) -> SlashResult:
+    return SlashResult(exit=True)
+
+
+HANDLERS: dict[str, Handler] = {
+    "model": cmd_model,
+    "reasoning": cmd_reasoning,
+    "yolo": cmd_yolo,
+    "approvals": cmd_approvals,
+    "tools": cmd_tools,
+    "config": cmd_config,
+    "status": cmd_status,
+    "context": cmd_context,
+    "usage": cmd_usage,
+    "whoami": cmd_whoami,
+    "help": cmd_help,
+    "version": cmd_version,
+    "stop": cmd_stop,
+    "steer": cmd_steer,
+    "queue": cmd_queue,
+    "compress": cmd_compress,
+    "quit": cmd_quit,
+}
diff --git a/src/indus/cli/slash/dispatch.py b/src/indus/cli/slash/dispatch.py
new file mode 100644
index 0000000..fae44b7
--- /dev/null
+++ b/src/indus/cli/slash/dispatch.py
@@ -0,0 +1,212 @@
+"""Slash dispatch for the classic REPL (P06-09).
+
+``dispatch(line, ctx)`` runs one ``/…`` line:
+
+1. The first word is lowercased for matching only (arguments keep their case); a registry alias
+   resolves to its canonical command.
+2. Any command other than ``/resume`` and ``/sessions`` disarms an armed resume list.
+3. Observers (a plugin seam) see the command first; whatever they do or raise, dispatch goes on.
+4. A built-in with a CLI handler runs, under its busy policy while a turn is running: ``reject``
+   prints a short line, ``interrupt_then_dispatch`` stops the turn and waits for it to settle,
+   ``dispatch`` runs at once.
+5. Otherwise, in order: the user's quick commands, plugin commands, skill commands. A registry
+   command implemented by a later phase, or offered only on another surface, says so. Anything else
+   is expanded when it is the unique prefix of a runnable name; several matches are listed; no
+   match prints "not a command" with the nearest names.
+
+A handler that raises is logged and reported in one line; the REPL keeps running. When a result
+switches sessions, ``ctx.session_id`` is updated before ``dispatch`` returns.
+"""
+
+from __future__ import annotations
+
+import difflib
+import logging
+from collections.abc import Mapping
+
+from indus.cli import quick_commands
+from indus.cli.slash import control_cmds, session_cmds
+from indus.cli.slash.context import ExtensionHandler, Handler, SlashContext, SlashResult
+from indus.foundation.errors import IndusError
+from indus.protocol.methods import ProtocolError
+from indus.service.commands.registry import REGISTRY, CommandDef, command_word, looks_like_command
+
+__all__ = [
+    "HANDLERS",
+    "MAX_REDISPATCH",
+    "after_turn",
+    "dispatch",
+    "is_slash",
+    "runnable_names",
+    "take_resume_pick",
+]
+
+log = logging.getLogger(__name__)
+
+MAX_REDISPATCH = 4
+"""How many times one line may be re-dispatched (prefix expansion, quick aliases)."""
+
+HANDLERS: dict[str, Handler] = {**session_cmds.HANDLERS, **control_cmds.HANDLERS}
+"""Canonical command name → the classic CLI's handler."""
+
+_KEEPS_PICKER = frozenset({"resume", "sessions"})
+
+
+def is_slash(text: str) -> bool:
+    """Is this REPL input a slash command (not a path such as ``/usr/bin/env``)?"""
+    return looks_like_command(text)
+
+
+def runnable_names(ctx: SlashContext) -> dict[str, str]:
+    """Every name the CLI can run now, with a short note: built-ins with a handler (and their
+    aliases), quick, plugin and skill commands."""
+    names: dict[str, str] = {}
+    for cmd in REGISTRY.commands("cli"):
+        if cmd.name in HANDLERS:
+            for key in cmd.keys:
+                names[key] = cmd.description if key == cmd.name else f"same as /{cmd.name}"
+    for name in quick_commands.names(ctx.scope):
+        names.setdefault(name, "quick command")
+    for name in ctx.extensions.plugin_commands:
+        names.setdefault(name.lower(), "plugin command")
+    for name in ctx.extensions.skill_commands:
+        names.setdefault(name.lower(), "skill")
+    return names
+
+
+def dispatch(line: str, ctx: SlashContext, *, depth: int = 0) -> SlashResult:
+    """Run one slash line (see the module notes)."""
+    word, args = command_word(line)
+    if not word:
+        ctx.say("Type a command after the slash, for example /help.")
+        return SlashResult()
+    cmd = REGISTRY.resolve(word)
+    canonical = cmd.name if cmd is not None else word
+    if canonical not in _KEEPS_PICKER:
+        ctx.state.resume_choices = None
+    if depth == 0:
+        _observe(ctx, canonical, args)
+
+    if cmd is not None and cmd.offered_on("cli") and cmd.name in HANDLERS:
+        return _run_builtin(cmd, HANDLERS[cmd.name], args, ctx)
+
+    quick = quick_commands.lookup(ctx.scope, word)
+    if quick is not None:
+        return quick_commands.run_quick(word, quick, args, ctx, depth=depth)
+    for table in (ctx.extensions.plugin_commands, ctx.extensions.skill_commands):
+        handler = _find(table, word)
+        if handler is not None:
+            return _run_extension(word, handler, args, ctx)
+
+    if cmd is not None:
+        _not_here(cmd, ctx)
+        return SlashResult()
+    return _expand(word, args, ctx, depth)
+
+
+def _find(table: Mapping[str, ExtensionHandler], word: str) -> ExtensionHandler | None:
+    for name, handler in table.items():
+        if name.lower() == word:
+            return handler
+    return None
+
+
+def _observe(ctx: SlashContext, command: str, args: str) -> None:
+    for observer in list(ctx.extensions.observers):
+        try:
+            observer(command, args, ctx)
+        except Exception:
+            log.warning("a slash command observer failed on /%s", command, exc_info=True)
+
+
+def _run_builtin(cmd: CommandDef, handler: Handler, args: str, ctx: SlashContext) -> SlashResult:
+    if ctx.is_busy():
+        if cmd.busy_policy == "reject":
+            ctx.say(
+                f"/{cmd.name} has to wait until the reply finishes (or press Ctrl+C to stop it)."
+            )
+            return SlashResult()
+        if cmd.busy_policy == "interrupt_then_dispatch":
+            ctx.port.interrupt(ctx.session_id)
+            if not ctx.port.wait_idle(ctx.session_id, ctx.busy_wait_s):
+                ctx.say(f"The reply did not stop in time, so /{cmd.name} did not run.")
+                return SlashResult()
+    try:
+        result = handler(ctx, args)
+    except (IndusError, ProtocolError) as exc:
+        log.info("/%s failed: %s", cmd.name, exc)
+        hint = getattr(exc, "hint", None)
+        ctx.say(f"/{cmd.name} failed: {exc}" + (f" ({hint})" if hint else ""))
+        return SlashResult()
+    except Exception as exc:
+        log.error("/%s failed", cmd.name, exc_info=True)
+        ctx.say(f"/{cmd.name} failed: {type(exc).__name__}: {exc}")
+        return SlashResult()
+    return _settle(result, ctx)
+
+
+def _run_extension(
+    word: str, handler: ExtensionHandler, args: str, ctx: SlashContext
+) -> SlashResult:
+    try:
+        result = handler(args, ctx)
+    except Exception as exc:
+        log.error("/%s failed", word, exc_info=True)
+        ctx.say(f"/{word} failed: {type(exc).__name__}: {exc}")
+        return SlashResult()
+    return _settle(result if isinstance(result, SlashResult) else SlashResult(), ctx)
+
+
+def _settle(result: SlashResult, ctx: SlashContext) -> SlashResult:
+    if result.switch_to is not None and result.switch_to != ctx.session_id:
+        ctx.session_id = result.switch_to
+    return result
+
+
+def _not_here(cmd: CommandDef, ctx: SlashContext) -> None:
+    if not cmd.offered_on("cli"):
+        where = " and ".join(sorted(cmd.surfaces))
+        ctx.say(f"/{cmd.name} is not available here; it works in: {where}.")
+    else:
+        ctx.say(f"/{cmd.name} is not built yet; it arrives with {cmd.owner}.")
+
+
+def _expand(word: str, args: str, ctx: SlashContext, depth: int) -> SlashResult:
+    names = runnable_names(ctx)
+    match = REGISTRY.prefix_matches(word, names)
+    if match.kind == "unique" and depth < MAX_REDISPATCH:
+        full = f"/{match.names[0]} {args}".rstrip()
+        return dispatch(full, ctx, depth=depth + 1)
+    if match.kind == "ambiguous":
+        listed = ", ".join(f"/{name}" for name in match.names)
+        ctx.say(f"/{word} could be several commands: {listed}.", "Type more of the name.")
+        return SlashResult()
+    close = difflib.get_close_matches(word, list(names), n=3, cutoff=0.6)
+    ctx.say(f"/{word} is not a command.")
+    if close:
+        ctx.say("Did you mean " + ", ".join(f"/{name}" for name in close) + "? /help lists all.")
+    else:
+        ctx.say("Type /help to see the commands.")
+    return SlashResult()
+
+
+def take_resume_pick(text: str, ctx: SlashContext) -> SlashResult | None:
+    """Plain input while a ``/resume`` list is armed: a bare number picks from it (as
+    ``/resume N``); anything else disarms the list and returns None (send it as usual)."""
+    choices = ctx.state.resume_choices
+    if choices is None:
+        return None
+    stripped = text.strip()
+    if not stripped.isdigit():
+        ctx.state.resume_choices = None
+        return None
+    return dispatch(f"/resume {stripped}", ctx)
+
+
+def after_turn(ctx: SlashContext) -> str | None:
+    """Call when a turn ends: writes changes that waited for the session row, and returns the next
+    queued message to send (None when the queue is empty)."""
+    session_cmds.flush_pending(ctx)
+    if ctx.state.queue:
+        return ctx.state.queue.pop(0)
+    return None
diff --git a/src/indus/cli/slash/port.py b/src/indus/cli/slash/port.py
new file mode 100644
index 0000000..31c76a7
--- /dev/null
+++ b/src/indus/cli/slash/port.py
@@ -0,0 +1,107 @@
+"""``HostPort``: the ``SessionPort`` slash commands use, over the in-process host (P06-09).
+
+Every call is a blocking call into ``InProcessHost``: plain service methods go through the host's
+own wrappers; anything that touches the agent (its route binding, its tools) runs on the host's
+loop thread with ``host.call`` / ``host.run``, never from the REPL thread.
+"""
+
+from __future__ import annotations
+
+import logging
+
+from indus.cli.slash.context import RouteInfo
+from indus.core.route import KEEP, RouteState
+from indus.foundation.scope import Scope
+from indus.protocol.methods import ProtocolError, SessionCreateParams
+from indus.providers.route import RuntimeRoute
+from indus.service.host_inprocess import InProcessHost
+from indus.tools.builtin import terminal
+
+__all__ = ["HostPort", "route_info"]
+
+log = logging.getLogger(__name__)
+
+
+def route_info(state: RouteState) -> RouteInfo:
+    return RouteInfo(
+        route=state.route,
+        context_length=state.context_length,
+        reasoning_effort=state.reasoning_effort,
+        requested_effort=state.requested_effort,
+    )
+
+
+class HostPort:
+    """``SessionPort`` over an ``InProcessHost`` (see the module notes)."""
+
+    def __init__(self, host: InProcessHost, scope: Scope) -> None:
+        self.host = host
+        self.scope = scope
+
+    def create(self, params: SessionCreateParams) -> str:
+        return self.host.create(params).session_id
+
+    def resume(self, session_id: str) -> None:
+        self.host.resume(session_id)
+
+    def close(self, session_id: str) -> None:
+        self.host.close_session(session_id)
+
+    def interrupt(self, session_id: str) -> bool:
+        try:
+            return self.host.interrupt(session_id).interrupted
+        except ProtocolError:
+            return False
+
+    def wait_idle(self, session_id: str, timeout: float) -> bool:
+        try:
+            self.host.wait(session_id, timeout=timeout)
+        except TimeoutError:
+            return False
+        except ProtocolError:
+            return True  # no turn to wait for
+        return True
+
+    def steer(self, session_id: str, text: str) -> bool:
+        return self.host.steer(session_id, text).queued
+
+    def route(self, session_id: str) -> RouteInfo:
+        service = self.host.service
+        return self.host.run(lambda: route_info(service.agent(session_id).binding.state))
+
+    def switch_route(
+        self,
+        session_id: str,
+        route: RuntimeRoute,
+        *,
+        effort: str | None = None,
+        keep_effort: bool,
+    ) -> RouteInfo:
+        service = self.host.service
+
+        async def apply() -> RouteInfo:
+            binding = service.agent(session_id).binding
+            state = await binding.apply(route, requested_effort=KEEP if keep_effort else effort)
+            return route_info(state)
+
+        return self.host.call(apply())
+
+    def tool_names(self, session_id: str) -> list[str]:
+        service = self.host.service
+        return self.host.run(lambda: service.agent(session_id).tool_names)
+
+    def stop_processes(self, session_id: str, *, all_jobs: bool) -> int:
+        processes = terminal.runtime().processes
+        home = str(self.scope.home)
+
+        async def stop() -> int:
+            if not all_jobs:
+                return await processes.release(home, session_id)
+            stopped = 0
+            for record in processes.list(home, session_id):
+                if not record.exited:
+                    await processes.kill(record, source="/stop")
+                    stopped += 1
+            return stopped
+
+        return self.host.call(stop())
diff --git a/src/indus/cli/slash/session_cmds.py b/src/indus/cli/slash/session_cmds.py
new file mode 100644
index 0000000..d025cd6
--- /dev/null
+++ b/src/indus/cli/slash/session_cmds.py
@@ -0,0 +1,488 @@
+"""Session commands of the classic CLI (P06-09): new, clear, history, title, resume, sessions,
+retry, undo, save, branch.
+
+The store side is P02's: titles (``state.titles``), listings (``state.listing``), rewind and
+branch (``state.rewind``) and export (``state.portability``). A fresh session has no row until
+its first turn is stored, so a title or a per-session setting given before that waits in
+``ctx.state`` and ``flush_pending`` writes it once the row exists (the REPL calls
+``dispatch.after_turn`` when a turn ends).
+"""
+
+from __future__ import annotations
+
+import html
+import json
+import logging
+import os
+from collections.abc import Mapping
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from indus.cli.slash.context import Handler, SlashContext, SlashResult
+from indus.foundation import fsio
+from indus.foundation.clock import safe_strftime
+from indus.safety.approvals import APPROVALS, session_key
+from indus.state import listing, messages, portability, rewind, sessions, titles
+from indus.state.registry import StoreHandle
+
+__all__ = [
+    "HANDLERS",
+    "flush_pending",
+    "remember_config",
+    "start_new_session",
+]
+
+log = logging.getLogger(__name__)
+
+PICKER_SIZE = 10
+_SKIP_CONFIRM = frozenset({"now", "-y", "--yes"})
+_FORMATS = {"json": "jsonl", "md": "md", "html": "html"}
+
+
+# -- helpers --------------------------------------------------------------------------------------
+
+
+def _store(ctx: SlashContext) -> StoreHandle | None:
+    if ctx.store is None:
+        ctx.say("Sessions are not being saved in this run, so this command cannot work here.")
+    return ctx.store
+
+
+def _row(ctx: SlashContext, session_id: str | None = None) -> dict[str, Any] | None:
+    if ctx.store is None:
+        return None
+    return sessions.get(ctx.store, session_id or ctx.session_id)
+
+
+def _when(ctx: SlashContext, stamp: float | None) -> str:
+    if stamp is None:
+        return "never"
+    zone = ctx.time.now().tzinfo
+    return safe_strftime(datetime.fromtimestamp(stamp, tz=zone), "%Y-%m-%d %H:%M")
+
+
+def _text(value: object) -> str:
+    return rewind.content_text(value)
+
+
+def flush_pending(ctx: SlashContext) -> None:
+    """Write the title and settings that waited for the session row (no-op until it exists)."""
+    state = ctx.state
+    if ctx.store is None or (state.pending_title is None and not state.pending_config):
+        return
+    if _row(ctx) is None:
+        return
+    if state.pending_config:
+        patch = dict(state.pending_config)
+        state.pending_config.clear()
+        sessions.patch_model_config(ctx.store, ctx.session_id, patch)
+    if state.pending_title is not None:
+        title, state.pending_title = state.pending_title, None
+        try:
+            titles.set_title(ctx.store, ctx.session_id, title)
+        except titles.TitleTaken as exc:
+            ctx.say(f"The title could not be set: {exc}.")
+
+
+def remember_config(ctx: SlashContext, patch: Mapping[str, Any]) -> bool:
+    """Store per-session settings on the session row now, or once it exists. True when written."""
+    if ctx.store is None:
+        return False
+    if sessions.patch_model_config(ctx.store, ctx.session_id, patch):
+        return True
+    ctx.state.pending_config.update(patch)
+    return False
+
+
+def start_new_session(
+    ctx: SlashContext,
+    *,
+    title: str | None = None,
+    toolsets: list[str] | None = None,
+    clear: bool = False,
+) -> SlashResult:
+    """Create a session with the chat's creation flags, close the current one and switch."""
+    update: dict[str, Any] = {"title": title, "idempotency_key": None}
+    if toolsets is not None:
+        update["toolsets"] = list(toolsets)
+    params = ctx.create_params.model_copy(update=update)
+    new_id = ctx.port.create(params)
+    old = ctx.session_id
+    try:
+        ctx.port.stop_processes(old, all_jobs=False)
+    except Exception:
+        log.warning("could not release the background processes of %s", old, exc_info=True)
+    ctx.port.close(old)
+    APPROVALS.clear_session(session_key(ctx.scope, old))
+    ctx.state.forget_session()
+    if toolsets is not None:
+        ctx.state.toolsets = list(toolsets)
+    if title:
+        ctx.state.pending_title = title
+    ctx.say(f"Started a new session ({new_id}).")
+    return SlashResult(switch_to=new_id, clear_screen=clear)
+
+
+def _has_history(ctx: SlashContext) -> bool:
+    row = _row(ctx)
+    if ctx.store is None:
+        return True
+    return row is not None and int(row.get("message_count") or 0) > 0
+
+
+# -- /new, /clear ---------------------------------------------------------------------------------
+
+
+def cmd_new(ctx: SlashContext, args: str) -> SlashResult:
+    words = args.split()
+    skip = any(word.lower() in _SKIP_CONFIRM for word in words)
+    name = " ".join(word for word in words if word.lower() not in _SKIP_CONFIRM)
+    if not skip and _has_history(ctx):
+        question = "Start a new session? The current one stays saved and can be resumed."
+        if not ctx.confirm(question):
+            ctx.say("Kept the current session.")
+            return SlashResult()
+    return start_new_session(ctx, title=name or None)
+
+
+def cmd_clear(ctx: SlashContext, args: str) -> SlashResult:
+    return start_new_session(ctx, clear=True)
+
+
+# -- /history -------------------------------------------------------------------------------------
+
+
+def cmd_history(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    rows = messages.get(store, ctx.session_id)
+    if not rows:
+        ctx.say("No messages in this session yet.")
+        return SlashResult()
+    for row in rows:
+        role = row.get("role")
+        text = _text(row.get("content")).strip()
+        if role == "user":
+            ctx.say(f"You: {text}")
+        elif role == "assistant":
+            calls = row.get("tool_calls") or []
+            if text:
+                ctx.say(f"Agent: {text}")
+            names = [_call_name(call) for call in calls] if isinstance(calls, list) else []
+            if names:
+                ctx.say("  (used " + ", ".join(names) + ")")
+        elif role == "tool":
+            name = row.get("tool_name") or "tool"
+            ctx.say(f"  [{name}: {len(text)} characters of output]")
+    return SlashResult()
+
+
+def _call_name(call: object) -> str:
+    if isinstance(call, Mapping):
+        function = call.get("function")  # pyright: ignore[reportUnknownMemberType]
+        if isinstance(function, Mapping):
+            name = function.get("name")  # pyright: ignore[reportUnknownMemberType]
+            if isinstance(name, str):
+                return name
+        name = call.get("name")  # pyright: ignore[reportUnknownMemberType]
+        if isinstance(name, str):
+            return name
+    return "a tool"
+
+
+# -- /title ---------------------------------------------------------------------------------------
+
+
+def cmd_title(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    wanted = args.strip()
+    if not wanted:
+        current = titles.get_title(store, ctx.session_id) or ctx.state.pending_title
+        ctx.say(f"Title: {current}" if current else "This session has no title yet.")
+        return SlashResult()
+    clean = titles.sanitize(wanted)
+    if clean is None:
+        ctx.say("That title is empty once control characters are removed.")
+        return SlashResult()
+    try:
+        written = titles.set_title(store, ctx.session_id, clean)
+    except titles.TitleTaken as exc:
+        ctx.say(f"The title could not be set: {exc}.")
+        return SlashResult()
+    if written:
+        ctx.say(f"Title set: {clean}")
+    else:
+        ctx.state.pending_title = clean
+        ctx.say(f"Title set: {clean} (saved with the first reply).")
+    return SlashResult()
+
+
+# -- /resume, /sessions ---------------------------------------------------------------------------
+
+
+def _recent(store: StoreHandle) -> list[listing.SessionSummary]:
+    return listing.list_sessions(store, listing.ListFilters(), limit=PICKER_SIZE)
+
+
+def _show_picker(ctx: SlashContext, store: StoreHandle) -> SlashResult:
+    found = _recent(store)
+    if not found:
+        ctx.say("There are no saved sessions yet.")
+        ctx.state.resume_choices = None
+        return SlashResult()
+    ctx.say("Recent sessions:")
+    for number, item in enumerate(found, start=1):
+        label = item.title or item.preview or "(no messages)"
+        here = "  <- this one" if item.id == ctx.session_id else ""
+        ctx.say(
+            f"  {number:>2}. {label}  [{item.id}, {item.message_count} messages, "
+            f"{_when(ctx, item.last_active)}]{here}"
+        )
+    ctx.say("Type a number to resume that session, or /resume NAME.")
+    ctx.state.resume_choices = [item.id for item in found]
+    return SlashResult()
+
+
+def _strip_brackets(text: str) -> str:
+    value = text.strip()
+    if len(value) >= 2 and value[0] + value[-1] in ("<>", "[]", '""', "''"):
+        value = value[1:-1].strip()
+    return value
+
+
+def _resolve_target(ctx: SlashContext, store: StoreHandle, target: str) -> str | None:
+    if target.isdigit():
+        choices = ctx.state.resume_choices or [item.id for item in _recent(store)]
+        index = int(target)
+        if not 1 <= index <= len(choices):
+            ctx.say(f"There is no session number {index} in the list.")
+            return None
+        return choices[index - 1]
+    by_title = titles.resolve_title(store, target)
+    if by_title is not None:
+        return by_title
+    try:
+        return sessions.resolve_id(store, target)
+    except sessions.AmbiguousSessionId as exc:
+        ctx.say(f"{exc}. Give more of the id.")
+    except sessions.SessionNotFound:
+        ctx.say(f"No session found matching '{target}'.", "Type /sessions to see recent ones.")
+    return None
+
+
+def cmd_resume(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    target = _strip_brackets(args)
+    if not target:
+        return _show_picker(ctx, store)
+    session_id = _resolve_target(ctx, store, target)
+    ctx.state.resume_choices = None
+    if session_id is None:
+        return SlashResult()
+    if session_id == ctx.session_id:
+        ctx.say("You are already in that session.")
+        return SlashResult()
+    ctx.port.resume(session_id)
+    old = ctx.session_id
+    ctx.port.close(old)
+    ctx.state.forget_session()
+    row = sessions.get(store, session_id) or {}
+    title = row.get("title")
+    ctx.say(f"Resumed {session_id}" + (f" ({title})." if title else "."))
+    return SlashResult(switch_to=session_id, resumed=True)
+
+
+def cmd_sessions(ctx: SlashContext, args: str) -> SlashResult:
+    target = args.strip()
+    if target and target.lower() not in ("list", "ls"):
+        return cmd_resume(ctx, target)
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    return _show_picker(ctx, store)
+
+
+# -- /retry, /undo --------------------------------------------------------------------------------
+
+
+def cmd_retry(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    try:
+        taken = rewind.rewind(store, ctx.session_id, -1, None)
+    except rewind.RewindUnavailable:
+        ctx.say("There is no message to send again yet.")
+        return SlashResult()
+    if not taken.target_text.strip():
+        ctx.say("The last message had no text to send again.")
+        return SlashResult()
+    ctx.say("Sending your last message again.")
+    return SlashResult(submit=taken.target_text)
+
+
+def cmd_undo(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    raw = args.strip() or "1"
+    if not raw.isdigit() or int(raw) < 1:
+        ctx.say("Usage: /undo [N]  (N is how many of your messages to take back, default 1)")
+        return SlashResult()
+    count = int(raw)
+    have = len(rewind.recent_user_messages(store, ctx.session_id, count))
+    if have == 0:
+        ctx.say("There is nothing to undo yet.")
+        return SlashResult()
+    try:
+        taken = rewind.rewind(store, ctx.session_id, -count, None)
+    except rewind.RewindUnavailable:
+        ctx.say("There is nothing to undo yet.")
+        return SlashResult()
+    noun = "message" if have == 1 else "messages"
+    ctx.say(f"Took back your last {have} {noun} and the replies to them.")
+    return SlashResult(prefill=taken.target_text or None)
+
+
+# -- /save ----------------------------------------------------------------------------------------
+
+
+def _save_usage(ctx: SlashContext) -> SlashResult:
+    ctx.say("Usage: /save json|md|html [file]")
+    return SlashResult()
+
+
+def cmd_save(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    words = args.split(maxsplit=1)
+    if not words or words[0].lower() not in _FORMATS:
+        return _save_usage(ctx)
+    kind = words[0].lower()
+    row = _row(ctx)
+    if row is None:
+        ctx.say("There is nothing to save yet.")
+        return SlashResult()
+    name = (
+        words[1].strip() if len(words) > 1 else f"indus-session-{ctx.session_id}.{_FORMATS[kind]}"
+    )
+    path = Path(os.path.expanduser(name))
+    if not path.is_absolute():
+        path = Path.cwd() / path
+    if path.exists():
+        ctx.say(f"{path} already exists; give another file name.")
+        return SlashResult()
+    if kind == "json":
+        objects = list(portability.export_session(store, ctx.session_id))
+        text = "".join(portability.dump_line(obj) + "\n" for obj in objects)
+        count = sum(1 for obj in objects if obj.get("kind") == "message")
+    else:
+        rows = messages.get(store, ctx.session_id)
+        count = len(rows)
+        title = str(row.get("title") or f"Session {ctx.session_id}")
+        render = _markdown if kind == "md" else _html
+        text = render(title, ctx.session_id, rows)
+    fsio.atomic_write_text(path, text)
+    ctx.say(f"Saved {count} messages to {path}")
+    return SlashResult()
+
+
+_SPEAKERS = {"user": "You", "assistant": "Indus Agent", "system": "System"}
+
+
+def _markdown(title: str, session_id: str, rows: list[dict[str, Any]]) -> str:
+    parts = [f"# {title}", "", f"Session `{session_id}`", ""]
+    for row in rows:
+        role = str(row.get("role"))
+        text = _text(row.get("content")).rstrip()
+        if role == "tool":
+            parts += [f"**{row.get('tool_name') or 'tool'} output**", "", "```", text, "```", ""]
+            continue
+        parts += [f"## {_SPEAKERS.get(role, role)}", "", text, ""]
+        calls = row.get("tool_calls")
+        if isinstance(calls, list) and calls:
+            for call in calls:  # pyright: ignore[reportUnknownVariableType]
+                parts += [f"- used `{_call_name(call)}`: `{json.dumps(_args_of(call))}`"]
+            parts.append("")
+    return "\n".join(parts).rstrip() + "\n"
+
+
+def _args_of(call: object) -> object:
+    if isinstance(call, Mapping):
+        function = call.get("function")  # pyright: ignore[reportUnknownMemberType]
+        if isinstance(function, Mapping):
+            return function.get("arguments")  # pyright: ignore[reportUnknownMemberType]
+    return None
+
+
+def _html(title: str, session_id: str, rows: list[dict[str, Any]]) -> str:
+    body: list[str] = []
+    for row in rows:
+        role = str(row.get("role"))
+        text = html.escape(_text(row.get("content")))
+        if role == "tool":
+            label = html.escape(str(row.get("tool_name") or "tool"))
+            body.append(f'<section class="tool"><h3>{label} output</h3><pre>{text}</pre></section>')
+            continue
+        speaker = html.escape(_SPEAKERS.get(role, role))
+        body.append(f'<section class="{html.escape(role)}"><h2>{speaker}</h2><pre>{text}</pre>')
+        calls = row.get("tool_calls")
+        if isinstance(calls, list) and calls:
+            used = ", ".join(html.escape(_call_name(c)) for c in calls)  # pyright: ignore[reportUnknownVariableType]
+            body.append(f"<p>Used: {used}</p>")
+        body.append("</section>")
+    head = (
+        '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n'
+        f"<title>{html.escape(title)}</title>\n"
+        "<style>body{font-family:sans-serif;max-width:52rem;margin:2rem auto;padding:0 1rem}"
+        "pre{white-space:pre-wrap;word-wrap:break-word}.tool pre{background:#f4f4f4}</style>\n"
+        "</head>\n<body>\n"
+        f"<h1>{html.escape(title)}</h1>\n<p>Session <code>{html.escape(session_id)}</code></p>\n"
+    )
+    return head + "\n".join(body) + "\n</body>\n</html>\n"
+
+
+# -- /branch --------------------------------------------------------------------------------------
+
+
+def cmd_branch(ctx: SlashContext, args: str) -> SlashResult:
+    store = _store(ctx)
+    if store is None:
+        return SlashResult()
+    if not _has_history(ctx):
+        ctx.say("There is nothing to branch yet; send a message first.")
+        return SlashResult()
+    name = args.strip() or None
+    try:
+        child = rewind.branch(store, ctx.session_id, title=name)
+    except titles.TitleTaken as exc:
+        ctx.say(f"The branch could not take that title: {exc}.")
+        return SlashResult()
+    ctx.port.resume(child)
+    old = ctx.session_id
+    ctx.port.close(old)
+    ctx.state.forget_session()
+    title = titles.get_title(store, child) or child
+    ctx.say(f"Branched into '{title}' ({child}).", f"The original session is unchanged: {old}")
+    return SlashResult(switch_to=child, resumed=True)
+
+
+HANDLERS: dict[str, Handler] = {
+    "new": cmd_new,
+    "clear": cmd_clear,
+    "history": cmd_history,
+    "title": cmd_title,
+    "resume": cmd_resume,
+    "sessions": cmd_sessions,
+    "retry": cmd_retry,
+    "undo": cmd_undo,
+    "save": cmd_save,
+    "branch": cmd_branch,
+}
