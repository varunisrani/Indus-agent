@@ -0,0 +1,142 @@
+"""The REPL's side of slice C's slash dispatch, bang shell, /queue and completion (P06-04)."""
+
+from __future__ import annotations
+
+import importlib
+from collections.abc import Callable
+from typing import Any
+
+import pytest
+from prompt_toolkit.completion import CompleteEvent
+from prompt_toolkit.document import Document
+
+from tests.unit.cli.repl import _stubs_slice_c
+
+_stubs_slice_c.install()
+
+from indus.cli.repl.app import Repl  # noqa: E402
+from indus.cli.repl.slash_bridge import SlashCompleter, wire_slash  # noqa: E402
+from tests.fakes.service import SESSION  # noqa: E402
+from tests.unit.cli.repl.conftest import Rig  # noqa: E402
+
+ENTER = "\r"
+SlashContext: Any = importlib.import_module("indus.cli.slash.context").SlashContext
+
+
+@pytest.fixture
+def ctx() -> Any:
+    return SlashContext(session_id=SESSION)
+
+
+@pytest.fixture
+def resumed() -> list[str]:
+    return []
+
+
+@pytest.fixture
+def slash_rig(make_rig: Callable[..., Rig], ctx: Any, resumed: list[str]) -> Rig:
+    def setup(repl: Repl) -> None:
+        wire_slash(repl, ctx, on_resume=resumed.append)
+
+    return make_rig(setup=setup)
+
+
+def submitted(rig: Rig) -> list[str]:
+    return [call.args[1] for call in rig.host.named("submit")]
+
+
+def test_quit_leaves(slash_rig: Rig, ctx: Any) -> None:
+    slash_rig.keys("/quit" + ENTER)
+    assert slash_rig.wait_exit() == 0
+    assert ctx.log == ["/quit"]
+
+
+def test_new_switches_the_feed_without_resume(slash_rig: Rig, resumed: list[str]) -> None:
+    slash_rig.keys("/new" + ENTER)
+    slash_rig.host.wait_for("feed", 2)
+    slash_rig.settle()
+    assert slash_rig.repl.session_id == "20260101_090000_new001"
+    assert resumed == []
+
+
+def test_resume_by_name_runs_the_resume_follow_up(slash_rig: Rig, resumed: list[str]) -> None:
+    slash_rig.keys("/resume 20260101_090000_old009" + ENTER)
+    slash_rig.host.wait_for("feed", 2)
+    slash_rig.settle()
+    assert resumed == ["20260101_090000_old009"]
+    assert slash_rig.host.named("feed")[-1].args == ("20260101_090000_old009",)
+
+
+def test_a_number_after_resume_picks_a_row_and_plain_text_still_reaches_the_model(
+    slash_rig: Rig, resumed: list[str]
+) -> None:
+    slash_rig.keys("/resume" + ENTER + "2" + ENTER)
+    slash_rig.host.wait_for("feed", 2)
+    slash_rig.settle()
+    assert resumed == ["20260101_090000_old002"]
+    slash_rig.keys("hello" + ENTER)
+    slash_rig.host.wait_for("submit")
+    assert submitted(slash_rig) == ["hello"]
+
+
+def test_retry_submits_and_undo_prefills(slash_rig: Rig) -> None:
+    slash_rig.keys("/retry" + ENTER)
+    slash_rig.host.wait_for("submit")
+    assert submitted(slash_rig) == ["the last message again"]
+    slash_rig.feed(slash_rig.host.started("t1", 1), slash_rig.host.done("t1"))
+    slash_rig.keys("/undo" + ENTER)
+    slash_rig.settle()
+    assert slash_rig.buffer_text() == "the undone message"
+
+
+def test_clear_empties_the_ring_and_switches(slash_rig: Rig) -> None:
+    slash_rig.call(lambda: slash_rig.repl.print("old line"))
+    slash_rig.keys("/clear" + ENTER)
+    slash_rig.host.wait_for("feed", 2)
+    slash_rig.settle()
+    assert list(slash_rig.repl.renderer.ring) == []
+    assert slash_rig.repl.session_id == "20260101_090000_new002"
+
+
+def test_bang_lines_go_to_the_bang_shell_and_double_bang_to_the_model(
+    slash_rig: Rig, ctx: Any
+) -> None:
+    slash_rig.keys("!ls -la" + ENTER)
+    slash_rig.settle()
+    slash_rig.settle()
+    assert ("bang", "!ls -la") in ctx.log
+    slash_rig.keys("!!literal" + ENTER)
+    slash_rig.host.wait_for("submit")
+    assert submitted(slash_rig) == ["!!literal"]
+
+
+def test_queued_text_goes_out_at_turn_end(slash_rig: Rig) -> None:
+    slash_rig.keys("first" + ENTER)
+    slash_rig.host.wait_for("submit")
+    slash_rig.feed(slash_rig.host.started("t1", 1))
+    slash_rig.keys("/queue then this" + ENTER)
+    slash_rig.settle()
+    assert submitted(slash_rig) == ["first"]
+    slash_rig.feed(slash_rig.host.done("t1"))
+    assert submitted(slash_rig) == ["first", "then this"]
+
+
+def test_completer_offers_command_names_once() -> None:
+    completer = SlashCompleter(lambda text: ["/queue", "/quit", "/queue"])
+    found = list(completer.get_completions(Document("/qu"), CompleteEvent()))
+    assert [(c.text, c.start_position) for c in found] == [("/queue", -3), ("/quit", -3)]
+    assert list(completer.get_completions(Document("plain"), CompleteEvent())) == []
+
+
+def test_completer_replaces_only_the_last_word_for_subcommands() -> None:
+    completer = SlashCompleter(lambda text: ["show", "hide"])
+    found = list(completer.get_completions(Document("/reasoning sh"), CompleteEvent()))
+    assert [(c.text, c.start_position) for c in found] == [("show", -2), ("hide", -2)]
+
+
+def test_wire_slash_sets_a_completer_from_the_registry(ctx: Any, rig: Rig) -> None:
+    repl = rig.repl
+    wire_slash(repl, ctx)
+    assert repl.completer is not None
+    found = list(repl.completer.get_completions(Document("/h"), CompleteEvent()))
+    assert [c.text for c in found] == ["/help", "/history"]
diff --git a/tests/unit/cli/repl/test_status.py b/tests/unit/cli/repl/test_status.py
new file mode 100644
index 0000000..6494308
--- /dev/null
+++ b/tests/unit/cli/repl/test_status.py
@@ -0,0 +1,258 @@
+"""Banner, recap and status bar (P06-06)."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+from prompt_toolkit.utils import get_cwidth
+
+from indus.cli.repl.banner import (
+    BannerInfo,
+    RecapSettings,
+    banner,
+    collect_recap,
+    recap,
+    recap_panel,
+)
+from indus.cli.repl.status import (
+    StatusSnapshot,
+    compact_tokens,
+    context_level,
+    context_percent,
+    fill_bar,
+    format_duration,
+    short_model,
+    status_fragments,
+    status_text,
+    tier_for,
+)
+from indus.core.transcript import TranscriptRow
+from tests.unit.cli.repl.conftest import recording_console
+
+TYPICAL = StatusSnapshot(
+    model="vendor/big-model-2",
+    context_used=50_000,
+    context_max=200_000,
+    context_estimated=True,
+    compressions=1,
+    turn_seconds=42,
+    turn_live=True,
+    title="Demo run",
+)
+CROWDED = StatusSnapshot(
+    model="router/vendor/some-really-long-model-name-v2",
+    context_used=123_400,
+    context_max=200_000,
+    context_estimated=True,
+    compressions=2,
+    background_jobs=1,
+    turn_seconds=75,
+    turn_live=True,
+    title="Fix the build",
+    auto_approve=True,
+)
+
+
+# -- width tiers ----------------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    ("snapshot", "width", "expected"),
+    [
+        (TYPICAL, 40, " big-model-2 · ⏱ 42s"),
+        (TYPICAL, 60, " big-model-2 · ~25% · cost n/a · ⇣1 · ⏱ 42s · Demo run"),
+        (
+            TYPICAL,
+            100,
+            " big-model-2 │ ~50K/200K │ ▰▰▱▱▱▱▱▱▱▱ ~25% │ cost n/a │ ⇣1 │ ⏱ 42s │ Demo run",
+        ),
+        (CROWDED, 40, " some-really-long-mode… · ⚠ auto-approve"),
+        (CROWDED, 60, " some-really-long-model-na… · ~62% · ⚠ auto-approve"),
+        (
+            CROWDED,
+            100,
+            " some-really-long-model-na… │ ▰▰▰▰▰▰▱▱▱▱ ~62% │ cost n/a │ ⇣2 │ ⚙1 │ ⏱ 1m 15s │ "
+            "⚠ auto-approve",
+        ),
+        (StatusSnapshot(model="m"), 100, " m │ context ? │ ▱▱▱▱▱▱▱▱▱▱ -- │ cost n/a"),
+        (StatusSnapshot(model="m", turn_seconds=3), 40, " m · ✓ 3s"),
+    ],
+)
+def test_width_tier_goldens(snapshot: StatusSnapshot, width: int, expected: str) -> None:
+    assert status_text(snapshot, width) == expected
+
+
+@pytest.mark.parametrize("width", [20, 30, 40, 51, 52, 60, 75, 76, 100, 160])
+def test_the_bar_never_wraps(width: int) -> None:
+    for snapshot in (TYPICAL, CROWDED):
+        assert get_cwidth(status_text(snapshot, width)) <= width
+
+
+def test_tier_boundaries() -> None:
+    assert [tier_for(w) for w in (51, 52, 75, 76)] == ["minimal", "compact", "compact", "full"]
+
+
+@pytest.mark.parametrize(
+    ("percent", "level"),
+    [
+        (None, "unknown"),
+        (0, "ok"),
+        (49, "ok"),
+        (50, "warm"),
+        (80, "warm"),
+        (81, "hot"),
+        (94, "hot"),
+        (95, "full"),
+        (100, "full"),
+    ],
+)
+def test_context_colour_thresholds(percent: int | None, level: str) -> None:
+    assert context_level(percent) == level
+
+
+def test_context_style_reaches_the_fragments() -> None:
+    hot = StatusSnapshot(model="m", context_used=90, context_max=100)
+    styles = {style for style, _text, *_ in status_fragments(hot, 100)}
+    assert "class:status.ctx-hot" in styles
+
+
+def test_context_percent_edges() -> None:
+    assert context_percent(StatusSnapshot(context_used=10, context_max=0)) is None
+    assert context_percent(StatusSnapshot(context_used=None, context_max=100)) is None
+    assert context_percent(StatusSnapshot(context_used=500, context_max=100)) == 100
+
+
+@pytest.mark.parametrize(
+    ("name", "shown"),
+    [
+        ("", "no model"),
+        ("vendor/short", "short"),
+        ("a" * 26, "a" * 26),
+        ("a" * 27, "a" * 25 + "…"),
+    ],
+)
+def test_model_truncated_past_26(name: str, shown: str) -> None:
+    assert short_model(name) == shown
+
+
+def test_small_formatters() -> None:
+    assert [
+        compact_tokens(n) for n in (950, 1000, 1500, 12_000, 200_000, 1_000_000, 1_250_000)
+    ] == [
+        "950",
+        "1K",
+        "1.5K",
+        "12K",
+        "200K",
+        "1M",
+        "1.2M",
+    ]
+    assert fill_bar(0) == "▱" * 10 and fill_bar(100) == "▰" * 10 and fill_bar(None) == "▱" * 10
+    assert [format_duration(s) for s in (0, 42, 185, 3720)] == ["0s", "42s", "3m 05s", "1h 02m"]
+
+
+# -- banner ---------------------------------------------------------------------------------------
+
+
+def test_banner_names_model_backend_folder_and_counts(tmp_path: Path) -> None:
+    console = recording_console(100)
+    info = BannerInfo(
+        version="0.0.1",
+        model="big-model-2",
+        provider="fakehost",
+        backend="local",
+        cwd=tmp_path / "proj",
+        tool_count=12,
+        skill_count=1,
+    )
+    console.print(banner(info, user_home=tmp_path))
+    text = console.export_text()
+    for part in (
+        "Indus Agent 0.0.1",
+        "big-model-2 (fakehost)",
+        "run on the local backend",
+        "~/proj",
+        "12 tools · 1 skill",
+        "/help lists commands",
+        "ready",
+    ):
+        assert part in text
+
+
+# -- recap ----------------------------------------------------------------------------------------
+
+
+def rows_for(pairs: list[tuple[str, str]]) -> list[dict[str, str]]:
+    return [{"role": role, "content": content} for role, content in pairs]
+
+
+def test_recap_truncation_table() -> None:
+    long_user = "u" * 400
+    many_lines = "\n".join(f"line {n}" for n in range(6))
+    long_answer = "a" * 500
+    rows = rows_for(
+        [
+            ("user", long_user),
+            ("assistant", many_lines),
+            ("user", "short"),
+            ("assistant", long_answer),
+            ("user", "last question"),
+            ("assistant", "final\nanswer\nwith\nmany\nlines"),
+        ]
+    )
+    view = collect_recap(rows, RecapSettings())
+    texts = [(e.role, e.text) for e in view.entries]
+    assert texts[0] == ("user", "u" * 299 + "…")
+    assert texts[1] == ("assistant", "line 0\nline 1\nline 2 …")
+    assert texts[3] == ("assistant", "a" * 199 + "…")
+    assert texts[5] == ("assistant_last", "final\nanswer\nwith\nmany\nlines")
+    assert view.hidden == 0
+
+
+def test_recap_keeps_the_last_exchanges_and_counts_the_rest() -> None:
+    rows = rows_for([(r, f"{r} {n}") for n in range(15) for r in ("user", "assistant")])
+    view = collect_recap(rows, RecapSettings(exchanges=10))
+    assert view.hidden == 10
+    assert view.entries[0].text == "user 5"
+    assert view.entries[-1] == view.entries[-1].__class__("assistant_last", "assistant 14")
+
+
+def test_recap_skips_tool_rows_hidden_rows_and_cleans_escapes() -> None:
+    rows: list[object] = [
+        TranscriptRow(role="system", content="prompt"),
+        TranscriptRow(role="user", content="run \x1b[2Jit"),
+        TranscriptRow(role="assistant", content=None, tool_calls=[{"id": "c"}]),
+        TranscriptRow(role="tool", content="output", tool_call_id="c"),
+        TranscriptRow(role="user", content="scaffold", scaffold=True),
+        {"role": "user", "content": "hidden", "display_kind": "hidden"},
+        {"role": "assistant", "content": [{"type": "text", "text": "done"}]},
+    ]
+    view = collect_recap(rows)
+    assert [(e.role, e.text) for e in view.entries] == [
+        ("user", "run it"),
+        ("assistant_last", "done"),
+    ]
+
+
+def test_recap_panel_renders_and_empty_history_renders_nothing() -> None:
+    console = recording_console(80)
+    console.print(recap(rows_for([("user", "hi"), ("assistant", "hello there")])))
+    text = console.export_text()
+    assert "earlier in this conversation" in text
+    assert "you   hi" in text and "indus hello there" in text
+    assert recap_panel(collect_recap([])) is None
+
+
+def test_recap_settings_from_config_values() -> None:
+    values = {"display.resume_exchanges": "4", "display.resume_max_user_chars": -1}
+    settings = RecapSettings.from_config(lambda key, default: values.get(key, default))
+    assert settings.exchanges == 4
+    assert settings.max_user_chars == 300
+    assert settings.max_assistant_lines == 3
+
+
+@pytest.mark.parametrize(("count", "style"), [(1, "dim"), (5, "ctx-warm"), (10, "ctx-hot")])
+def test_compression_count_colour(count: int, style: str) -> None:
+    fragments = status_fragments(StatusSnapshot(model="m", compressions=count), 100)
+    assert (f"class:status.{style}", f"⇣{count}") in [(f[0], f[1]) for f in fragments]
