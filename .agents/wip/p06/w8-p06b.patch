@@ -0,0 +1,128 @@
+# pyright: reportMissingImports=false, reportAttributeAccessIssue=false, reportUnknownVariableType=false, reportUnknownMemberType=false
+# (slice C's modules are not in this worktree; drop the line above once they land.)
+"""The REPL's side of slash commands, the bang shell, ``/queue`` and Tab completion (P06-04).
+
+Slice C (P06-08..11) owns the commands: ``indus.cli.slash.dispatch`` runs them against a
+``SlashContext`` and answers with a ``SlashResult``; ``indus.cli.bang`` runs ``!command`` lines;
+``indus.service.commands.registry.REGISTRY`` completes names. This module only turns those
+answers into what the REPL does:
+
+- ``exit`` → leave; ``clear_screen`` → clear; ``switch_to`` → follow the new session's events
+  (the context already names it) and, when ``resumed``, run ``on_resume`` (cwd restore, recap,
+  rehydrated switches — ``indus.cli.resume``); ``submit`` → send that text as a prompt;
+  ``prefill`` → put that text in the draft.
+- Plain lines first go to ``take_resume_pick`` so a number typed after ``/resume`` picks a row.
+- At each turn end the REPL asks ``after_turn`` for the next queued text.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Callable, Iterable
+from typing import Any
+
+from prompt_toolkit.application import run_in_terminal
+from prompt_toolkit.completion import CompleteEvent, Completer, Completion
+from prompt_toolkit.document import Document
+
+from indus.cli import bang
+from indus.cli.repl.app import CommandHook, Repl
+from indus.cli.slash.dispatch import (
+    after_turn,
+    dispatch,
+    is_slash,
+    runnable_names,
+    take_resume_pick,
+)
+from indus.service.commands.registry import REGISTRY
+
+__all__ = ["SlashCompleter", "apply_result", "slash_hook", "wire_slash"]
+
+log = logging.getLogger(__name__)
+
+type OnResume = Callable[[str], None]
+
+
+class SlashCompleter(Completer):
+    """Tab completion of command names (and subcommands) for a line that starts with ``/``."""
+
+    def __init__(self, complete: Callable[[str], Iterable[str]]) -> None:
+        self.complete = complete
+
+    def get_completions(
+        self, document: Document, complete_event: CompleteEvent
+    ) -> Iterable[Completion]:
+        text = document.text_before_cursor
+        if not text.startswith("/") or "\n" in text:
+            return
+        word = text.rsplit(" ", 1)[-1]
+        seen: set[str] = set()
+        for item in self.complete(text):
+            if not isinstance(item, str) or not item or item in seen:
+                continue
+            seen.add(item)
+            if item.startswith("/") and " " not in text:
+                yield Completion(item, start_position=-len(text))
+            else:  # a subcommand or argument: replaces the word being typed
+                yield Completion(item, start_position=-len(word))
+
+
+def apply_result(repl: Repl, result: Any, on_resume: OnResume | None = None) -> None:
+    """Carry out a ``SlashResult`` on ``repl``."""
+    if result is None:
+        return
+    if getattr(result, "clear_screen", False):
+        repl.clear_screen()
+    switch_to = getattr(result, "switch_to", None)
+    if switch_to:
+        repl.attach(str(switch_to))
+        if getattr(result, "resumed", False) and on_resume is not None:
+            try:
+                on_resume(str(switch_to))
+            except Exception as exc:
+                log.exception("resume follow-up failed")
+                repl.error(f"could not finish resuming: {type(exc).__name__}: {exc}")
+    submit = getattr(result, "submit", None)
+    if submit:
+        repl.send(str(submit))
+    prefill = getattr(result, "prefill", None)
+    if prefill:
+        repl.prefill(str(prefill))
+    if getattr(result, "exit", False):
+        repl.request_exit()
+
+
+def _run_bang(repl: Repl, line: str, ctx: Any) -> None:
+    """Run ``!command`` with the prompt put away, so its output and Ctrl+C belong to it."""
+    app = repl.app
+    if app is not None and app.is_running:
+        run_in_terminal(lambda: bang.run_bang(line, ctx))
+    else:
+        bang.run_bang(line, ctx)
+
+
+def slash_hook(ctx: Any, *, on_resume: OnResume | None = None) -> CommandHook:
+    """The REPL command hook for slice C's dispatch (see the module notes)."""
+
+    def hook(repl: Repl, line: str) -> bool:
+        if bang.is_bang(line):
+            _run_bang(repl, line, ctx)
+            return True
+        if is_slash(line):
+            apply_result(repl, dispatch(line, ctx), on_resume)
+            return True
+        picked = take_resume_pick(line, ctx)
+        if picked is None or picked is False:
+            return False
+        if picked is not True:
+            apply_result(repl, picked, on_resume)
+        return True
+
+    return hook
+
+
+def wire_slash(repl: Repl, ctx: Any, *, on_resume: OnResume | None = None) -> None:
+    """Plug slice C's commands into ``repl`` (call before ``repl.run()``)."""
+    repl.commands = slash_hook(ctx, on_resume=on_resume)
+    repl.after_turn = lambda: after_turn(ctx)
+    repl.completer = SlashCompleter(lambda text: REGISTRY.complete(text, runnable_names(ctx)))
