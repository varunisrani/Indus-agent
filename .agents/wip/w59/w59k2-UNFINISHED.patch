index 0000000..b944471
--- /dev/null
+++ b/apps/tui/src/components/banner.test.ts
@@ -0,0 +1,151 @@
+import { describe, expect, it } from "vitest";
+import { cellWidth, lineText } from "../render/styled.tsx";
+import { testTheme } from "../render/testTheme.ts";
+import {
+  BIG_ART_COLS,
+  BIG_ART_WIDTH,
+  BOX_COLS,
+  bannerFacts,
+  bannerLines,
+  bigWord,
+  SMALL_ART_COLS,
+  TWO_COLUMN_COLS,
+  toolNameLines,
+} from "./banner.ts";
+
+const theme = testTheme({ accent: "cyan" });
+
+const TOOLS = [
+  "clarify",
+  "delegate_task",
+  "execute_code",
+  "memory",
+  "patch",
+  "read_file",
+  "search_files",
+  "skill_view",
+  "skills_list",
+  "terminal",
+  "todo",
+  "web_extract",
+  "web_search",
+  "write_file",
+  "vision_analyze",
+  "session_search",
+];
+
+const INFO = {
+  model: "m-large",
+  provider: "acme",
+  cwd: "/work/project",
+  tools: TOOLS,
+  skills: 7,
+};
+
+function draw(width: number, info: Record<string, unknown> = INFO, sid = "s-123"): string[] {
+  return bannerLines(info, "", width, theme, sid).map(lineText);
+}
+
+describe("banner art", () => {
+  it("spells INDUS and AGENT in five even rows of our own letters", () => {
+    for (const word of ["indus", "agent"]) {
+      const rows = bigWord(word);
+      expect(rows).toHaveLength(5);
+      expect(new Set(rows.map((row) => cellWidth(row))).size).toBe(1);
+    }
+    expect(BIG_ART_WIDTH).toBeLessThanOrEqual(BIG_ART_COLS);
+  });
+
+  it("draws the big banner when it fits, the small wordmark below that, then plain text", () => {
+    const wide = draw(120);
+    expect(cellWidth(wide[0] ?? "")).toBe(BIG_ART_WIDTH);
+    expect(wide.slice(0, 5).every((row) => cellWidth(row) <= BIG_ART_WIDTH)).toBe(true);
+    expect(wide[0]).toContain("═╦═");
+    const mid = draw(BIG_ART_COLS - 1);
+    expect(mid[1]).toContain("indus agent");
+    expect(mid[0]).toContain("╷ ┌╮╷");
+    const narrow = draw(SMALL_ART_COLS - 1);
+    expect(narrow[0]).toBe("indus agent");
+  });
+
+  it("never draws a line wider than the terminal", () => {
+    for (const width of [20, 31, 32, 43, 44, 59, 60, 80, 89, 90, 100, 120, 200]) {
+      for (const line of draw(width)) expect(cellWidth(line)).toBeLessThanOrEqual(width);
+    }
+  });
+});
+
+describe("session box", () => {
+  it("puts the facts beside the tools and skills summary on a wide terminal", () => {
+    const out = draw(TWO_COLUMN_COLS + 10).join("\n");
+    expect(out).toMatch(/╭─+╮/);
+    expect(out).toMatch(/╰─+╯/);
+    const modelRow = draw(TWO_COLUMN_COLS + 10).find((line) => line.includes("m-large · acme"));
+    expect(modelRow).toContain(`Tools (${TOOLS.length})`);
+    expect(out).toContain("Skills (7)");
+    expect(out).toContain(`${TOOLS.length} tools · 7 skills · /help for commands`);
+    expect(out).toContain("s-123");
+    expect(out).toContain("/work/project");
+  });
+
+  it("stacks the facts over the summary inside the box below the two-column width", () => {
+    const lines = draw(80);
+    const model = lines.findIndex((line) => line.includes("m-large · acme"));
+    const tools = lines.findIndex((line) => line.includes(`Tools (${TOOLS.length})`));
+    expect(model).toBeGreaterThan(0);
+    expect(tools).toBeGreaterThan(model);
+    expect(lines.every((line) => !line.startsWith("│") || cellWidth(line) === 80)).toBe(true);
+  });
+
+  it("falls back to the plain fact list below the box width", () => {
+    const out = draw(BOX_COLS - 1).join("\n");
+    expect(out).not.toMatch(/╭─+╮/);
+    expect(out).toContain(`tools    ${TOOLS.length} available`);
+    expect(out).toContain("session  s-123");
+  });
+
+  it("leaves the skills out until the catalogue has loaded", () => {
+    const out = draw(100, { ...INFO, skills: undefined }).join("\n");
+    expect(out).not.toContain("Skills");
+    expect(out).toContain(`${TOOLS.length} tools · /help for commands`);
+  });
+
+  it("says when the session offers no tools", () => {
+    const out = draw(100, { model: "m", provider: "p", tools: [] }).join("\n");
+    expect(out).toContain("Tools (0)");
+    expect(out).toContain("none offered to this session");
+  });
+});
+
+describe("bannerFacts", () => {
+  it("reads only well-formed fields", () => {
+    expect(bannerFacts({ model: 3, tools: ["a", 2, ""], skills: -1 })).toEqual({
+      model: "",
+      provider: "",
+      cwd: "",
+      title: "",
+      tools: ["a"],
+      skills: null,
+    });
+    expect(bannerFacts(null).tools).toEqual([]);
+  });
+});
+
+describe("toolNameLines", () => {
+  it("keeps every name when they fit", () => {
+    expect(toolNameLines(["a", "b", "c"], 40, 3)).toEqual(["a, b, c"]);
+  });
+
+  it("wraps at commas and counts what it leaves out", () => {
+    const lines = toolNameLines(TOOLS, 30, 2);
+    expect(lines).toHaveLength(2);
+    for (const line of lines) expect(line.length).toBeLessThanOrEqual(30);
+    const shown = lines
+      .join(" ")
+      .split(/,\s*/)
+      .filter((name) => TOOLS.includes(name.trim()));
+    const more = /… and (\d+) more$/.exec(lines[1] ?? "");
+    expect(more).not.toBeNull();
+    expect(shown.length + Number(more?.[1])).toBe(TOOLS.length);
+  });
+});
