@@ -0,0 +1,274 @@
+/**
+ * The transcript's first row: the INDUS AGENT banner and the session box.
+ *
+ * Width tiers, widest first:
+ * - `BIG_ART_COLS` and up: "INDUS AGENT" in five rows of double-line strokes;
+ * - `SMALL_ART_COLS` and up: the three-row "INDUS" wordmark with the name beside it;
+ * - narrower: the name as plain text.
+ *
+ * Under the art, from `BOX_COLS` up, a rounded box holds the session facts (model, folder,
+ * session, title) and a summary of what the agent can use: the tool names `session.info` sends
+ * (a few lines, then "… and N more"), the count of skills the command catalogue offers (once it
+ * has loaded) and a pointer to `/help`. From `TWO_COLUMN_COLS` up the facts and the summary sit
+ * side by side. Below `BOX_COLS` the facts are a plain label/value list.
+ */
+import { padLine, type StyledLine, truncateLine, wrapSpans } from "../render/styled.tsx";
+import { colour } from "../render/tones.ts";
+import type { Theme } from "../theme/theme.ts";
+
+export const BIG_ART_COLS = 60;
+export const SMALL_ART_COLS = 32;
+export const BOX_COLS = 44;
+export const TWO_COLUMN_COLS = 90;
+/** Tool-name lines in the box before "… and N more". */
+export const TOOL_LINES_WIDE = 4;
+export const TOOL_LINES_NARROW = 3;
+
+// Five-row letters of our own, drawn with double-line box strokes. Every row of a letter has
+// the same width.
+const BIG_LETTERS: Record<string, readonly string[]> = {
+  I: ["═╦═", " ║ ", " ║ ", " ║ ", "═╩═"],
+  N: ["╦╗  ╦", "║╚╗ ║", "║ ╚╗║", "║  ╚╣", "╩   ╩"],
+  D: ["╦══╗ ", "║  ╚╗", "║   ║", "║  ╔╝", "╩══╝ "],
+  U: ["╦   ╦", "║   ║", "║   ║", "║   ║", "╚═══╝"],
+  S: ["╔═══╗", "║    ", "╚═══╗", "    ║", "╚═══╝"],
+  A: ["╔═══╗", "║   ║", "╠═══╣", "║   ║", "╩   ╩"],
+  G: ["╔═══╗", "║    ", "║ ══╗", "║   ║", "╚═══╝"],
+  E: ["╔════", "║    ", "╠═══ ", "║    ", "╚════"],
+  T: ["══╦══", "  ║  ", "  ║  ", "  ║  ", "  ╩  "],
+};
+
+/** One word in the big letters: five rows, letters one cell apart. */
+export function bigWord(word: string): string[] {
+  return [0, 1, 2, 3, 4].map((row) =>
+    [...word.toUpperCase()].map((ch) => BIG_LETTERS[ch]?.[row] ?? "").join(" "),
+  );
+}
+
+const BIG_FIRST = bigWord("indus");
+const BIG_SECOND = bigWord("agent");
+const BIG_GAP = "   ";
+/** Cells the one-line big banner needs. */
+export const BIG_ART_WIDTH =
+  (BIG_FIRST[0]?.length ?? 0) + BIG_GAP.length + (BIG_SECOND[0]?.length ?? 0);
+
+// "INDUS" in three rows of light box strokes (the narrow wordmark).
+const SMALL_LETTERS = [
+  ["╷", "│", "╵"],
+  ["┌╮╷", "│││", "╵╰┘"],
+  ["┌─╮", "│ │", "└─╯"],
+  ["╷ ╷", "│ │", "╰─╯"],
+  ["╭─╴", "╰─╮", "╶─╯"],
+];
+const WORDMARK = [0, 1, 2].map((row) => SMALL_LETTERS.map((letter) => letter[row]).join(" "));
+
+/** What the banner shows, read from the `session.info` payload (plus the catalogue's skills). */
+export interface BannerFacts {
+  model: string;
+  provider: string;
+  cwd: string;
+  title: string;
+  tools: string[];
+  /** Skills the command catalogue offers; null until it has loaded. */
+  skills: number | null;
+}
+
+export function bannerFacts(
+  info: Readonly<Record<string, unknown>> | null | undefined,
+): BannerFacts {
+  const source = info ?? {};
+  const text = (key: string): string => {
+    const value = source[key];
+    return typeof value === "string" ? value : "";
+  };
+  const tools = Array.isArray(source.tools)
+    ? source.tools.filter((name): name is string => typeof name === "string" && name !== "")
+    : [];
+  const skills = source.skills;
+  return {
+    model: text("model"),
+    provider: text("provider"),
+    cwd: text("cwd"),
+    title: text("title"),
+    tools,
+    skills: typeof skills === "number" && Number.isFinite(skills) && skills >= 0 ? skills : null,
+  };
+}
+
+function artLines(width: number, theme: Theme): StyledLine[] {
+  if (width >= BIG_ART_COLS && width >= BIG_ART_WIDTH) {
+    return BIG_FIRST.map((first, row) => [
+      { ...colour(theme, "accent"), bold: true, text: first },
+      { text: BIG_GAP },
+      { ...colour(theme, "text"), text: (BIG_SECOND[row] ?? "").trimEnd() },
+    ]);
+  }
+  if (width >= SMALL_ART_COLS) {
+    const out: StyledLine[] = WORDMARK.map((row) => [{ ...colour(theme, "accent"), text: row }]);
+    out[1]?.push({ ...colour(theme, "text"), bold: true, text: "  indus agent" });
+    return out;
+  }
+  return [[{ ...colour(theme, "accent"), bold: true, text: "indus agent" }]];
+}
+
+function factRows(facts: BannerFacts, sid: string | null | undefined): [string, string][] {
+  const rows: [string, string][] = [];
+  if (facts.model) {
+    rows.push(["model", facts.provider ? `${facts.model} · ${facts.provider}` : facts.model]);
+  }
+  if (facts.cwd) rows.push(["folder", facts.cwd]);
+  if (facts.title) rows.push(["title", facts.title]);
+  if (sid) rows.push(["session", sid]);
+  return rows;
+}
+
+const LABEL_COLS = 9;
+
+function factLines(rows: [string, string][], width: number, theme: Theme): StyledLine[] {
+  return rows.flatMap(([label, value]) =>
+    wrapSpans([{ ...colour(theme, "text"), text: value }], width, {
+      first: [{ ...colour(theme, "muted"), text: label.padEnd(LABEL_COLS, " ") }],
+      rest: [{ text: " ".repeat(LABEL_COLS) }],
+      mode: "char",
+    }),
+  );
+}
+
+/**
+ * The tool names as comma-separated lines of at most `width` cells, cut to `maxLines`; when
+ * names are left out the last line ends with "… and N more" (N counts every name not shown).
+ */
+export function toolNameLines(names: readonly string[], width: number, maxLines: number): string[] {
+  const room = Math.max(1, width);
+  const lines: string[] = [];
+  let current: string[] = [];
+  let shown = 0;
+  for (const name of names) {
+    const next = [...current, name].join(", ");
+    if (current.length > 0 && next.length + 1 > room) {
+      if (lines.length + 1 >= maxLines) break;
+      lines.push(`${current.join(", ")},`);
+      current = [name];
+    } else {
+      current.push(name);
+    }
+    shown += 1;
+  }
+  let left = names.length - shown;
+  if (left > 0) {
+    const tail = (): string => `… and ${left} more`;
+    while (current.length > 0 && [...current, tail()].join(", ").length > room) {
+      current.pop();
+      left += 1;
+    }
+    current.push(tail());
+  }
+  if (current.length > 0 && lines.length < maxLines) lines.push(current.join(", "));
+  return lines;
+}
+
+function summaryLine(facts: BannerFacts): string {
+  const parts = [`${facts.tools.length} ${facts.tools.length === 1 ? "tool" : "tools"}`];
+  if (facts.skills !== null)
+    parts.push(`${facts.skills} ${facts.skills === 1 ? "skill" : "skills"}`);
+  parts.push("/help for commands");
+  return parts.join(" · ");
+}
+
+function capsLines(
+  facts: BannerFacts,
+  width: number,
+  maxLines: number,
+  theme: Theme,
+): StyledLine[] {
+  const out: StyledLine[] = [];
+  out.push([
+    { ...colour(theme, "accent"), bold: true, text: "Tools" },
+    { ...colour(theme, "muted"), text: ` (${facts.tools.length})` },
+  ]);
+  if (facts.tools.length === 0) {
+    out.push([{ ...colour(theme, "muted"), text: "none offered to this session" }]);
+  } else {
+    for (const line of toolNameLines(facts.tools, width, maxLines)) {
+      out.push([{ ...colour(theme, "text"), text: line }]);
+    }
+  }
+  if (facts.skills !== null) {
+    out.push([]);
+    out.push([
+      { ...colour(theme, "accent"), bold: true, text: "Skills" },
+      { ...colour(theme, "muted"), text: ` (${facts.skills})` },
+    ]);
+  }
+  out.push(...wrapSpans([{ ...colour(theme, "muted"), text: summaryLine(facts) }], width));
+  return out.map((line) => truncateLine(line, width));
+}
+
+function boxed(body: StyledLine[], width: number, theme: Theme): StyledLine[] {
+  const inner = width - 4;
+  const edge = colour(theme, "border");
+  const out: StyledLine[] = [[{ ...edge, text: `╭${"─".repeat(width - 2)}╮` }]];
+  for (const line of body) {
+    out.push([
+      { ...edge, text: "│ " },
+      ...padLine(truncateLine(line, inner), inner),
+      { ...edge, text: " │" },
+    ]);
+  }
+  out.push([{ ...edge, text: `╰${"─".repeat(width - 2)}╯` }]);
+  return out;
+}
+
+function sideBySide(
+  left: StyledLine[],
+  right: StyledLine[],
+  leftWidth: number,
+  gap: number,
+): StyledLine[] {
+  const rows = Math.max(left.length, right.length);
+  const out: StyledLine[] = [];
+  for (let i = 0; i < rows; i += 1) {
+    const l = padLine(left[i] ?? [], leftWidth);
+    out.push([...l, { text: " ".repeat(gap) }, ...(right[i] ?? [])]);
+  }
+  return out;
+}
+
+/** The banner row's lines at `width` cells (no gutter). */
+export function bannerLines(
+  info: Readonly<Record<string, unknown>> | null | undefined,
+  note: string,
+  width: number,
+  theme: Theme,
+  sid: string | null | undefined,
+): StyledLine[] {
+  const facts = bannerFacts(info);
+  const rows = factRows(facts, sid);
+  const out: StyledLine[] = artLines(width, theme);
+  out.push([]);
+  if (width >= TWO_COLUMN_COLS) {
+    const inner = width - 4;
+    const leftWidth = Math.min(48, Math.floor(inner * 0.45));
+    const gap = 3;
+    const left = factLines(rows, leftWidth, theme);
+    const right = capsLines(facts, inner - leftWidth - gap, TOOL_LINES_WIDE, theme);
+    out.push(...boxed(sideBySide(left, right, leftWidth, gap), width, theme));
+  } else if (width >= BOX_COLS) {
+    const inner = width - 4;
+    const body = factLines(rows, inner, theme);
+    if (body.length > 0) body.push([]);
+    body.push(...capsLines(facts, inner, TOOL_LINES_NARROW, theme));
+    out.push(...boxed(body, width, theme));
+  } else {
+    // Narrow: the plain list, with the tool count after the folder.
+    const list = rows.filter(([label]) => label === "model" || label === "folder");
+    list.push(["tools", `${facts.tools.length} available`]);
+    list.push(...rows.filter(([label]) => label === "title" || label === "session"));
+    out.push(...factLines(list, width, theme));
+  }
+  if (note.trim()) {
+    out.push([]);
+    out.push(...wrapSpans([{ ...colour(theme, "muted"), dim: true, text: note }], width));
+  }
+  return out.map((line) => truncateLine(line, width));
+}
