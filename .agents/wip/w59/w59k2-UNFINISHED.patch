+/**
+ * The banner box's tool names (from the "Tools (N)" heading's column down to the first blank
+ * cell there) become one fixed token: the list grows whenever a tool is added.
+ */
+function maskToolNames(lines: string[]): string[] {
+  let column = -1;
+  return lines.map((line) => {
+    const heading = line.indexOf("Tools (");
+    if (heading >= 0) {
+      column = heading;
+      return line;
+    }
+    if (column < 0) return line;
+    const end = line.lastIndexOf("│");
+    const cell = line.slice(column, end > column ? end : undefined);
+    if (cell.trim() === "") {
+      column = -1;
+      return line;
+    }
+    return `${line.slice(0, column)}<tool names>${end > column ? ` ${line.slice(end)}` : ""}`;
+  });
+}
+
 /** The screen with what differs between machines and runs replaced by fixed tokens. */
 function masked(tui: Tui, home: Home): string {
-  const text = tui
-    .lines()
