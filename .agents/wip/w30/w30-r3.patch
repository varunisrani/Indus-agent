index 0000000..03a67f0
--- /dev/null
+++ b/src/indus/web/routes/models.py
@@ -0,0 +1,414 @@
+"""``/api/model`` and ``/api/providers/login``: the Models page (P18-16).
+
+- ``GET /api/model/info`` (on the shared public list): the configured model id, provider and
+  context window (the configured one, and the family table's when the config sets none). Names
+  and numbers only: no URL, key or account.
+- ``GET /api/model/options``: the provider catalogue (built-in, local, config and plugin
+  providers) with ``configured`` (a key in the pool, the secret store or the environment, or a
+  sign-in) and the current main choice.
+- ``POST /api/model/set {scope: main|auxiliary, task?, provider, model, base_url?}``: through the
+  config writer; a side task must be one the schema knows.
+- ``GET /api/model/auxiliary``: each side task's provider, model and base URL, and the main model.
+- Provider sign-in by device code (documented flows only, D-16.11): ``POST
+  /api/providers/login/start {provider}`` asks the provider for a code and answers ``{session_id,
+  user_code, verification_url, expires_in, interval}``; a dashboard thread then polls the token
+  endpoint (RFC 8628 pacing from ``providers.auth.device_code``). ``GET
+  /api/providers/login/{session_id}`` answers ``{status, message}`` with status ``pending``,
+  ``approved``, ``denied``, ``expired``, ``failed`` or ``cancelled``; ``DELETE`` cancels. Approved
+  tokens join the provider's credential pool the way ``indus auth add --type oauth`` stores them
+  (secret store + ``auth.json`` metadata); no answer ever carries a token. A provider without a
+  documented device flow is 400 ``no_device_flow`` (none has one today). Sessions live 15 minutes
+  past their end and are bound to the profile that started them.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import secrets
+import threading
+import time
+from collections.abc import Callable
+from concurrent.futures import Future
+from dataclasses import dataclass, field
+from typing import Annotated, Any, Final, NoReturn, cast
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from pydantic import BaseModel, Field
+
+from indus.foundation import config as config_module
+from indus.foundation.config.schema import AuxiliarySection
+from indus.foundation.errors import ConfigError, IndusError
+from indus.foundation.scope import Scope
+from indus.providers.auth import device_code
+from indus.providers.auth.flows import flows_for
+from indus.providers.auth.pool_model import PoolEntry, env_entries, load_pool, new_entry_id
+from indus.providers.auth.store import AuthStore
+from indus.providers.context_length import family_length
+from indus.providers.registry import Registry
+from indus.web.routes.system import add_pool_secret, provider_profile
+from indus.web.scope import read_scope, write_scope
+from indus.web.state import dashboard_state
+
+__all__ = ["AUX_TASKS", "ROUTE_LIST", "LoginSession", "LoginSessions", "router"]
+
+router = APIRouter()
+
+ROUTE_LIST: Final[tuple[tuple[str, str, bool], ...]] = (
+    ("GET", "/api/model/info", True),
+    ("GET", "/api/model/options", True),
+    ("POST", "/api/model/set", True),
+    ("GET", "/api/model/auxiliary", True),
+    ("POST", "/api/providers/login/start", True),
+    ("GET", "/api/providers/login/{session_id}", True),
+    ("DELETE", "/api/providers/login/{session_id}", True),
+)
+"""``(method, path, scoped)`` of every route here."""
+
+AUX_TASKS: Final[tuple[str, ...]] = tuple(AuxiliarySection.model_fields)
+SESSION_KEEP_S: Final = 15 * 60.0
+START_TIMEOUT_S: Final = 30.0
+_SESSIONS_KEY: Final = "providers.login_sessions"
+_FLOW_KEY: Final = "providers.device_flows"
+
+ReadScope = Annotated[Scope, Depends(read_scope)]
+WriteScope = Annotated[Scope, Depends(write_scope)]
+
+
+def _fail(status: int, code: str, message: str) -> NoReturn:
+    raise HTTPException(status_code=status, detail={"code": code, "message": message})
+
+
+def _section(scope: Scope, key: str) -> dict[str, Any]:
+    raw = config_module.load(scope).get(key)
+    return dict(cast(dict[str, Any], raw)) if isinstance(raw, dict) else {}
+
+
+# -- info, options, set ---------------------------------------------------------------------------
+
+
+@router.get("/api/model/info")
+def model_info(scope: ReadScope) -> dict[str, Any]:
+    model = _section(scope, "model")
+    name = str(model.get("default") or "")
+    configured = model.get("context_length")
+    config_ctx = configured if isinstance(configured, int) and configured > 0 else None
+    family = family_length(name) if name else None
+    return {
+        "model": name or None,
+        "provider": str(model.get("provider") or "") or None,
+        "config_context_length": config_ctx,
+        "family_context_length": family,
+        "effective_context_length": config_ctx or family,
+    }
+
+
+def _configured(scope: Scope, store: AuthStore, name: str, env_vars: tuple[str, ...]) -> bool:
+    try:
+        rows, _inherited = store.pool_rows(name)
+    except IndusError:
+        rows = []
+    if rows:
+        return True
+    for var in env_vars:
+        try:
+            if scope.secrets is not None and scope.secrets.get(var):
+                return True
+        except Exception:
+            pass
+        if (scope.env.get(var) or "").strip():
+            return True
+    return False
+
+
+@router.get("/api/model/options")
+def model_options(scope: ReadScope) -> dict[str, Any]:
+    store = AuthStore(scope.home, env=scope.env)
+    rows: list[dict[str, Any]] = []
+    for profile in Registry(scope).list_providers():
+        flows = flows_for(profile.name)
+        rows.append(
+            {
+                "name": profile.name,
+                "label": profile.display_name or profile.name,
+                "description": profile.description,
+                "family": profile.family,
+                "auth_type": profile.auth_type,
+                "configured": _configured(scope, store, profile.name, profile.env_vars),
+                "device_login": flows.device is not None,
+                "supports_model_listing": profile.supports_model_listing,
+            }
+        )
+    model = _section(scope, "model")
+    return {
+        "providers": rows,
+        "current": {
+            "provider": str(model.get("provider") or "") or None,
+            "model": str(model.get("default") or "") or None,
+        },
+    }
+
+
+class ModelAssignment(BaseModel):
+    scope: str = Field(default="main")
+    task: str | None = None
+    provider: str = Field(default="", max_length=200)
+    model: str = Field(default="", max_length=400)
+    base_url: str | None = Field(default=None, max_length=2000)
+
+
+@router.post("/api/model/set")
+def set_model(body: ModelAssignment, scope: WriteScope) -> dict[str, Any]:
+    kind = body.scope.strip().lower()
+    provider, model = body.provider.strip(), body.model.strip()
+    if kind == "main":
+        if not model:
+            _fail(400, "model_required", "Name the model.")
+        section: dict[str, Any] = {"default": model}
+        if provider:
+            if provider != "custom" and Registry(scope).lookup(provider) is None:
+                _fail(400, "unknown_provider", "No such provider.")
+            section["provider"] = provider
+        if body.base_url is not None:
+            section["base_url"] = body.base_url.strip()
+        change: dict[str, Any] = {"model": section}
+    elif kind == "auxiliary":
+        task = (body.task or "").strip().lower()
+        if task not in AUX_TASKS:
+            _fail(400, "unknown_task", f"Unknown side task; one of {', '.join(AUX_TASKS)}.")
+        slot: dict[str, Any] = {"provider": provider or "auto", "model": model}
+        if body.base_url is not None:
+            slot["base_url"] = body.base_url.strip()
+        change = {"auxiliary": {task: slot}}
+    else:
+        _fail(400, "bad_scope", "scope must be main or auxiliary.")
+    try:
+        config_module.save(scope, change)
+    except ConfigError as exc:
+        _fail(500, "config_unwritable", f"{exc.message}. Nothing was changed.")
+    return {"ok": True, "scope": kind, "provider": provider or None, "model": model or None}
+
+
+@router.get("/api/model/auxiliary")
+def auxiliary(scope: ReadScope) -> dict[str, Any]:
+    aux = _section(scope, "auxiliary")
+    tasks: list[dict[str, Any]] = []
+    for task in AUX_TASKS:
+        raw = aux.get(task)
+        slot = cast(dict[str, Any], raw) if isinstance(raw, dict) else {}
+        tasks.append(
+            {
+                "task": task,
+                "provider": str(slot.get("provider") or "auto"),
+                "model": str(slot.get("model") or ""),
+                "base_url": str(slot.get("base_url") or ""),
+                "description": AuxiliarySection.model_fields[task].description or "",
+            }
+        )
+    model = _section(scope, "model")
+    return {
+        "tasks": tasks,
+        "main": {
+            "provider": str(model.get("provider") or ""),
+            "model": str(model.get("default") or ""),
+        },
+    }
+
+
+# -- device-code sign-in --------------------------------------------------------------------------
+
+
+@dataclass
+class LoginSession:
+    id: str
+    provider: str
+    home: str
+    status: str = "pending"
+    message: str = ""
+    finished_at: float | None = None
+    cancel: threading.Event = field(default_factory=threading.Event)
+
+    def answer(self) -> dict[str, Any]:
+        return {
+            "session_id": self.id,
+            "provider": self.provider,
+            "status": self.status,
+            "message": self.message,
+        }
+
+
+class LoginSessions:
+    """The live sign-in sessions of one app."""
+
+    def __init__(self, now: Callable[[], float] = time.monotonic) -> None:
+        self._now = now
+        self._items: dict[str, LoginSession] = {}
+        self._lock = threading.Lock()
+
+    def add(self, provider: str, home: str) -> LoginSession:
+        session = LoginSession(secrets.token_urlsafe(18), provider, home)
+        with self._lock:
+            self._sweep()
+            self._items[session.id] = session
+        return session
+
+    def get(self, session_id: str, home: str) -> LoginSession | None:
+        with self._lock:
+            self._sweep()
+            found = self._items.get(session_id)
+        return found if found is not None and found.home == home else None
+
+    def finish(self, session: LoginSession, status: str, message: str) -> None:
+        with self._lock:
+            if session.status == "pending":
+                session.status = status
+                session.message = message
+                session.finished_at = self._now()
+
+    def _sweep(self) -> None:
+        now = self._now()
+        for key, item in list(self._items.items()):
+            if item.finished_at is not None and now - item.finished_at > SESSION_KEEP_S:
+                del self._items[key]
+
+
+def _sessions(request: Request) -> LoginSessions:
+    extras = dashboard_state(request.app).extras
+    found = extras.get(_SESSIONS_KEY)
+    if isinstance(found, LoginSessions):
+        return found
+    return cast(LoginSessions, extras.setdefault(_SESSIONS_KEY, LoginSessions()))
+
+
+def _device_spec(request: Request, provider: str) -> device_code.DeviceFlowSpec | None:
+    """The provider's documented device endpoints (tests add their own under extras)."""
+    extra = dashboard_state(request.app).extras.get(_FLOW_KEY)
+    if isinstance(extra, dict) and provider in extra:
+        return cast(device_code.DeviceFlowSpec, cast(dict[str, Any], extra)[provider])
+    return flows_for(provider).device
+
+
+def _client_factory(request: Request) -> Callable[[], Any]:
+    found = dashboard_state(request.app).extras.get("providers.http_client")
+    return cast(Callable[[], Any], found) if callable(found) else device_code.make_client
+
+
+class LoginStart(BaseModel):
+    provider: str = Field(min_length=1, max_length=100)
+    label: str | None = Field(default=None, max_length=100)
+
+
+def _store_tokens(scope: Scope, provider: str, tokens: device_code.TokenSet, label: str) -> None:
+    profile = provider_profile(scope, provider)
+    store = AuthStore(scope.home, env=scope.env)
+    pool, _inherited = load_pool(store, profile.name, env_entries(profile, None, scope.env))
+    entry = PoolEntry(
+        id=new_entry_id(pool.ids()),
+        label=label or f"sign-in-{len(pool) + 1}",
+        auth_type="oauth",
+        source="device_code",
+        expires_at=tokens.expires_at.isoformat() if tokens.expires_at else None,
+    )
+    add_pool_secret(scope, profile, tokens.to_secret(), entry)
+    with store.transaction() as doc:
+        providers = cast(dict[str, Any], doc.setdefault("providers", {}))
+        providers[profile.name] = {
+            "signed_in_at": scope.clock.now().isoformat(),
+            "flow": "device_code",
+        }
+
+
+@router.post("/api/providers/login/start")
+def login_start(body: LoginStart, request: Request, scope: WriteScope) -> dict[str, Any]:
+    provider = body.provider.strip().lower()
+    provider_profile(scope, provider)
+    spec = _device_spec(request, provider)
+    if spec is None:
+        _fail(
+            400,
+            "no_device_flow",
+            "This provider documents no device sign-in; add an API key instead.",
+        )
+    make_client = _client_factory(request)
+    sessions = _sessions(request)
+    session = sessions.add(provider, str(scope.home))
+    label = (body.label or "").strip()
+    started: Future[device_code.DeviceAuthorization] = Future()
+
+    async def flow() -> None:
+        async with make_client() as client:
+            try:
+                grant = await device_code.request_device_authorization(client, spec)
+            except device_code.DeviceFlowError as exc:
+                started.set_exception(exc)
+                return
+            started.set_result(grant)
+            try:
+                tokens = await device_code.poll_for_token(client, spec, grant, clock=scope.clock)
+            except device_code.AccessDenied:
+                sessions.finish(session, "denied", "The sign-in was refused.")
+                return
+            except device_code.DeviceCodeExpired:
+                sessions.finish(session, "expired", "The code expired before it was approved.")
+                return
+            except device_code.DeviceFlowError as exc:
+                sessions.finish(session, "failed", exc.message)
+                return
+        if session.cancel.is_set():
+            return
+        try:
+            await asyncio.to_thread(_store_tokens, scope, provider, tokens, label)
+        except (IndusError, HTTPException, OSError):
+            sessions.finish(session, "failed", "Signed in, but the credential could not be saved.")
+            return
+        sessions.finish(session, "approved", "Signed in; the credential was added.")
+
+    def run() -> None:
+        loop = asyncio.new_event_loop()
+        try:
+            task = loop.create_task(flow())
+            while not task.done():
+                loop.run_until_complete(asyncio.wait([task], timeout=0.25))
+                if session.cancel.is_set() and not task.done():
+                    task.cancel()
+                    loop.run_until_complete(asyncio.wait([task]))
+            if not task.cancelled() and task.exception() is not None and not started.done():
+                started.set_exception(task.exception() or RuntimeError("sign-in failed"))
+        finally:
+            loop.close()
+
+    threading.Thread(target=run, name=f"indus-login-{provider}", daemon=True).start()
+    try:
+        grant = started.result(timeout=START_TIMEOUT_S)
+    except device_code.DeviceFlowError as exc:
+        sessions.finish(session, "failed", exc.message)
+        _fail(502, "sign_in_unavailable", exc.message)
+    except Exception:
+        session.cancel.set()
+        sessions.finish(session, "failed", "The provider's sign-in service did not answer.")
+        _fail(502, "sign_in_unavailable", "The provider's sign-in service did not answer.")
+    return {
+        **session.answer(),
+        "user_code": grant.user_code,
+        "verification_url": grant.url_to_show,
+        "expires_in": grant.expires_in,
+        "interval": grant.interval,
+    }
+
+
+@router.get("/api/providers/login/{session_id}")
+def login_status(session_id: str, request: Request, scope: ReadScope) -> dict[str, Any]:
+    found = _sessions(request).get(session_id, str(scope.home))
+    if found is None:
+        _fail(404, "no_such_session", "No such sign-in session.")
+    return found.answer()
+
+
+@router.delete("/api/providers/login/{session_id}")
+def login_cancel(session_id: str, request: Request, scope: WriteScope) -> dict[str, Any]:
+    sessions = _sessions(request)
+    found = sessions.get(session_id, str(scope.home))
+    if found is None:
+        _fail(404, "no_such_session", "No such sign-in session.")
+    found.cancel.set()
+    sessions.finish(found, "cancelled", "The sign-in was cancelled.")
+    return found.answer()
diff --git a/src/indus/web/routes/profiles.py b/src/indus/web/routes/profiles.py
new file mode 100644
index 0000000..01a076b
--- /dev/null
+++ b/src/indus/web/routes/profiles.py
@@ -0,0 +1,517 @@
+"""``/api/profiles``: the dashboard's Profiles page and profile builder (P18-16, R04.25).
+
+Machine-level: the profile a route acts on is named in the path, never by ``?profile=``. Every
+name is checked against the live profiles under the backend's root first, so a deleted
+(tombstoned) or unknown profile is 404 for reads and writes alike, and no route ever creates the
+folder of a profile that does not exist.
+
+- ``GET /api/profiles``: each live profile with its model, description, whether it has a persona,
+  plus the sticky profile (``active``) and the one this backend serves (``current``).
+- ``POST /api/profiles {name, clone_from?, clone_all?, description?, no_skills?, alias?}``,
+  ``PATCH /api/profiles/{name} {new_name}`` and ``DELETE /api/profiles/{name}`` run the real
+  ``indus profile create|rename|delete`` in a child process (``web`` may not import ``cli``; the
+  command owns the staging folder, the secret moves, the tombstone and the alias). A refusal is
+  400 with the command's own message, masked.
+- ``GET``/``POST /api/profiles/active``: the sticky profile new CLI runs pick up.
+- ``GET``/``PUT /api/profiles/{name}/persona`` (``PERSONA.md``), ``PUT …/description``
+  (``profile.yaml``), ``PUT …/model {provider, model}`` (that profile's ``config.yaml`` through the
+  config writer).
+- ``POST /api/profiles/{name}/export`` (a background action writing a zip of the profile's
+  settings, no history, runtime state or secrets, into its ``backups/`` folder) and
+  ``POST /api/profiles/import {archive, name?}`` (a new profile from such a zip; members are
+  checked for absolute paths, ``..``, links and size before anything is written).
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import stat
+import subprocess
+import sys
+import zipfile
+from collections.abc import Callable, Mapping, Sequence
+from datetime import UTC, datetime
+from pathlib import Path, PurePosixPath
+from typing import Annotated, Any, Final, NoReturn, cast
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from pydantic import BaseModel, Field
+
+from indus.foundation import config as config_module
+from indus.foundation import fsio, yamlio
+from indus.foundation.config import loader
+from indus.foundation.errors import ConfigError, IndusError, InvalidProfileId, ProfileNotFound
+from indus.foundation.profiles import (
+    DEFAULT_PROFILE,
+    IDENTITY_MARKERS,
+    clear_tombstone,
+    is_live,
+    list_profiles,
+    normalize_id,
+    profile_home,
+    profiles_dir,
+    read_active,
+    write_active,
+)
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.web.actions import ActionBusy, Say, actions_of, child_env
+from indus.web.scope import ProfileScopes, ProfileUnknown, scopes_of
+from indus.web.state import dashboard_state
+
+__all__ = ["EXPORT_SKIP", "PERSONA_FILE", "ROUTE_LIST", "router"]
+
+router = APIRouter()
+
+ROUTE_LIST: Final[tuple[tuple[str, str, bool], ...]] = (
+    ("GET", "/api/profiles", False),
+    ("POST", "/api/profiles", False),
+    ("GET", "/api/profiles/active", False),
+    ("POST", "/api/profiles/active", False),
+    ("POST", "/api/profiles/import", False),
+    ("PATCH", "/api/profiles/{name}", False),
+    ("DELETE", "/api/profiles/{name}", False),
+    ("GET", "/api/profiles/{name}/persona", False),
+    ("PUT", "/api/profiles/{name}/persona", False),
+    ("PUT", "/api/profiles/{name}/description", False),
+    ("PUT", "/api/profiles/{name}/model", False),
+    ("POST", "/api/profiles/{name}/export", False),
+)
+"""``(method, path, scoped)``; machine-level (the profile is in the path)."""
+
+PERSONA_FILE: Final = "PERSONA.md"
+META_FILE: Final = "profile.yaml"
+PERSONA_MAX_CHARS: Final = 200_000
+COMMAND_TIMEOUT_S: Final = 120.0
+EXPORT_MANIFEST: Final = "indus-profile.json"
+EXPORT_MAX_BYTES: Final = 512 * 1024 * 1024
+EXPORT_SKIP: Final = frozenset(
+    {
+        "profiles",
+        "state.db",
+        "state.db-wal",
+        "state.db-shm",
+        "state.db-journal",
+        "sessions",
+        "backups",
+        "state-snapshots",
+        "checkpoints",
+        "logs",
+        "cache",
+        "cron",
+        "active_profile",
+        "secrets.json",
+        "secrets.index.json",
+        "auth.json",
+        "auth.json.lock",
+        "pairing",
+        "platforms",
+        "gateway",
+    }
+)
+"""Top-level names an export leaves out: history, runtime state, secrets and channel state."""
+_SKIP_SUFFIXES: Final = (".lock", ".pid", ".sock", ".path")
+
+type Runner = Callable[[Sequence[str], Mapping[str, str]], tuple[int, str]]
+
+
+def _fail(status: int, code: str, message: str) -> NoReturn:
+    raise HTTPException(status_code=status, detail={"code": code, "message": message})
+
+
+def run_cli(args: Sequence[str], env: Mapping[str, str]) -> tuple[int, str]:
+    """``python -m indus <args>`` once; ``(exit code, combined output)``."""
+    try:
+        done = subprocess.run(  # noqa: S603 - our own CLI with a fixed argv
+            [sys.executable, "-m", "indus", *args],
+            env=dict(env),
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            text=True,
+            timeout=COMMAND_TIMEOUT_S,
+            check=False,
+        )
+    except subprocess.TimeoutExpired:
+        return 124, "the profile command did not finish in time"
+    except OSError as exc:
+        return 127, f"the profile command could not start: {exc}"
+    return done.returncode, (done.stdout or "") + (done.stderr or "")
+
+
+def _scopes(request: Request) -> ProfileScopes:
+    return scopes_of(request)
+
+
+Scopes = Annotated[ProfileScopes, Depends(_scopes)]
+
+
+def _runner(request: Request) -> Runner:
+    found = dashboard_state(request.app).extras.get("profiles.run")
+    return cast(Runner, found) if callable(found) else run_cli
+
+
+def _live(scopes: ProfileScopes, name: str) -> tuple[str, Path]:
+    try:
+        pid = normalize_id(name)
+    except InvalidProfileId:
+        _fail(400, "bad_name", "That is not a valid profile name.")
+    root = scopes.base.root
+    try:
+        live = is_live(root, pid)
+    except (InvalidProfileId, OSError):
+        live = False
+    if not live:
+        _fail(404, "profile_not_found", "No such profile.")
+    return pid, profile_home(root, pid)
+
+
+def _scope_for(scopes: ProfileScopes, name: str) -> Scope:
+    try:
+        return scopes.resolve(name)
+    except ProfileUnknown:
+        _fail(404, "profile_not_found", "No such profile.")
+
+
+def _settings_of(home: Path) -> dict[str, Any]:
+    try:
+        return loader.canonicalise(loader.read_user_tree((home / loader.CONFIG_FILE).read_bytes()))
+    except (OSError, yamlio.YamlError):
+        return {}
+
+
+def _model_of(home: Path) -> tuple[str, str]:
+    model = _settings_of(home).get("model")
+    if not isinstance(model, dict):
+        return "", ""
+    section = cast(dict[str, Any], model)
+    return str(section.get("default") or ""), str(section.get("provider") or "")
+
+
+def _read_meta(home: Path) -> dict[str, Any]:
+    try:
+        loaded = yamlio.load_safe((home / META_FILE).read_bytes())
+    except (OSError, yamlio.YamlError):
+        return {}
+    return cast(dict[str, Any], loaded) if isinstance(loaded, dict) else {}
+
+
+def _write_meta(home: Path, changes: Mapping[str, Any]) -> None:
+    data = {**_read_meta(home), **changes}
+    text = yamlio.dump_plain(data) if data else ""
+    fsio.atomic_write_text(home / META_FILE, text, mode=0o600, preserve_mode=False)
+
+
+def _row(scopes: ProfileScopes, pid: str, sticky: str) -> dict[str, Any]:
+    home = profile_home(scopes.base.root, pid)
+    model, provider = _model_of(home)
+    return {
+        "name": pid,
+        "is_default": pid == DEFAULT_PROFILE,
+        "is_sticky": pid == sticky,
+        "is_current": pid == scopes.base.profile_id,
+        "model": model or None,
+        "provider": provider or None,
+        "description": str(_read_meta(home).get("description") or "") or None,
+        "has_persona": (home / PERSONA_FILE).is_file(),
+    }
+
+
+def _masked(output: str) -> str:
+    lines = [line.strip() for line in output.splitlines() if line.strip()]
+    return redact_text("\n".join(lines[-6:]))[:2000]
+
+
+def _run(request: Request, scopes: ProfileScopes, args: Sequence[str]) -> str:
+    code, output = _runner(request)(args, child_env(scopes.base))
+    if code != 0:
+        _fail(400, "profile_command_failed", _masked(output) or "The profile was not changed.")
+    return _masked(output)
+
+
+# -- list and sticky ------------------------------------------------------------------------------
+
+
+@router.get("/api/profiles")
+def list_all(scopes: Scopes) -> dict[str, Any]:
+    root = scopes.base.root
+    sticky = read_active(root)
+    rows = [_row(scopes, pid, sticky) for pid in list_profiles(root)]
+    return {"profiles": rows, "active": sticky, "current": scopes.base.profile_id}
+
+
+@router.get("/api/profiles/active")
+def get_active(scopes: Scopes) -> dict[str, str]:
+    return {"active": read_active(scopes.base.root), "current": scopes.base.profile_id}
+
+
+class ActiveBody(BaseModel):
+    name: str
+
+
+@router.post("/api/profiles/active")
+def set_active(body: ActiveBody, scopes: Scopes) -> dict[str, Any]:
+    pid, _home = _live(scopes, body.name)
+    try:
+        write_active(scopes.base.root, pid)
+    except ProfileNotFound:
+        _fail(404, "profile_not_found", "No such profile.")
+    return {"ok": True, "active": pid}
+
+
+# -- create / rename / delete ---------------------------------------------------------------------
+
+
+class CreateBody(BaseModel):
+    name: str
+    clone_from: str | None = None
+    clone_all: bool = False
+    description: str | None = Field(default=None, max_length=2000)
+    no_skills: bool = False
+    alias: bool = False
+
+
+@router.post("/api/profiles", status_code=201)
+def create(body: CreateBody, request: Request, scopes: Scopes) -> dict[str, Any]:
+    try:
+        pid = normalize_id(body.name)
+    except InvalidProfileId:
+        _fail(400, "bad_name", "Use 1-64 lowercase letters, digits, '-' or '_'.")
+    if pid == DEFAULT_PROFILE:
+        _fail(400, "bad_name", "'default' is the built-in profile; pick another name.")
+    if is_live(scopes.base.root, pid):
+        _fail(409, "profile_exists", "A profile with that name already exists.")
+    args = ["profile", "create", pid]
+    if body.clone_from:
+        source, _home = _live(scopes, body.clone_from)
+        args += ["--clone-from", source]
+        if body.clone_all:
+            args.append("--clone-all")
+    elif body.clone_all:
+        args.append("--clone-all")
+    if body.description:
+        args += ["--description", body.description]
+    if body.no_skills:
+        args.append("--no-skills")
+    if not body.alias:
+        args.append("--no-alias")
+    said = _run(request, scopes, args)
+    if not is_live(scopes.base.root, pid):
+        _fail(500, "profile_command_failed", said or "The profile was not created.")
+    return {"ok": True, "name": pid, "message": said}
+
+
+class RenameBody(BaseModel):
+    new_name: str
+
+
+@router.patch("/api/profiles/{name}")
+def rename(name: str, body: RenameBody, request: Request, scopes: Scopes) -> dict[str, Any]:
+    old, _home = _live(scopes, name)
+    if old == DEFAULT_PROFILE:
+        _fail(400, "default_profile", "The default profile cannot be renamed.")
+    try:
+        new = normalize_id(body.new_name)
+    except InvalidProfileId:
+        _fail(400, "bad_name", "Use 1-64 lowercase letters, digits, '-' or '_'.")
+    if new == old:
+        return {"ok": True, "name": new, "message": ""}
+    if old == scopes.base.profile_id:
+        _fail(409, "profile_in_use", "This dashboard serves that profile; rename it elsewhere.")
+    said = _run(request, scopes, ["profile", "rename", old, new])
+    return {"ok": True, "name": new, "message": said}
+
+
+@router.delete("/api/profiles/{name}")
+def delete(name: str, request: Request, scopes: Scopes) -> dict[str, Any]:
+    pid, _home = _live(scopes, name)
+    if pid == DEFAULT_PROFILE:
+        _fail(400, "default_profile", "The default profile cannot be deleted.")
+    if pid == scopes.base.profile_id:
+        _fail(409, "profile_in_use", "This dashboard serves that profile; it cannot delete it.")
+    said = _run(request, scopes, ["profile", "delete", pid, "--yes"])
+    return {"ok": True, "name": pid, "message": said}
+
+
+# -- persona, description, model ------------------------------------------------------------------
+
+
+@router.get("/api/profiles/{name}/persona")
+def get_persona(name: str, scopes: Scopes) -> dict[str, Any]:
+    _pid, home = _live(scopes, name)
+    path = home / PERSONA_FILE
+    try:
+        return {"content": path.read_text(encoding="utf-8-sig"), "exists": True}
+    except FileNotFoundError:
+        return {"content": "", "exists": False}
+    except (OSError, UnicodeDecodeError):
+        _fail(500, "persona_unreadable", f"{PERSONA_FILE} could not be read.")
+
+
+class PersonaBody(BaseModel):
+    content: str = Field(max_length=PERSONA_MAX_CHARS)
+
+
+@router.put("/api/profiles/{name}/persona")
+def put_persona(name: str, body: PersonaBody, scopes: Scopes) -> dict[str, Any]:
+    _pid, home = _live(scopes, name)
+    try:
+        fsio.atomic_write_text(home / PERSONA_FILE, body.content, mode=0o644)
+    except OSError:
+        _fail(500, "persona_unwritable", f"{PERSONA_FILE} could not be written.")
+    return {"ok": True}
+
+
+class DescriptionBody(BaseModel):
+    description: str = Field(default="", max_length=2000)
+
+
+@router.put("/api/profiles/{name}/description")
+def put_description(name: str, body: DescriptionBody, scopes: Scopes) -> dict[str, Any]:
+    _pid, home = _live(scopes, name)
+    text = body.description.strip()
+    try:
+        _write_meta(home, {"description": text})
+    except OSError:
+        _fail(500, "meta_unwritable", f"{META_FILE} could not be written.")
+    return {"ok": True, "description": text}
+
+
+class ModelBody(BaseModel):
+    provider: str = Field(min_length=1, max_length=200)
+    model: str = Field(min_length=1, max_length=400)
+
+
+@router.put("/api/profiles/{name}/model")
+def put_model(name: str, body: ModelBody, scopes: Scopes) -> dict[str, Any]:
+    pid, _home = _live(scopes, name)
+    scope = _scope_for(scopes, pid)
+    provider, model = body.provider.strip(), body.model.strip()
+    try:
+        config_module.save(scope, {"model": {"provider": provider, "default": model}})
+    except ConfigError as exc:
+        _fail(500, "config_unwritable", f"{exc.message}. Nothing was changed.")
+    return {"ok": True, "provider": provider, "model": model}
+
+
+# -- export / import ------------------------------------------------------------------------------
+
+
+def _skipped(rel: PurePosixPath) -> bool:
+    if not rel.parts:
+        return True
+    if rel.parts[0] in EXPORT_SKIP or rel.name.endswith(_SKIP_SUFFIXES):
+        return True
+    name = rel.name.lower()
+    return name == ".env" or name.startswith(".env.")
+
+
+def export_profile(home: Path, pid: str, archive: Path, say: Say) -> int:
+    """Zip ``home``'s settings into ``archive`` (see the module notes); 0 when written."""
+    partial = archive.with_name(f".{archive.name}.partial")
+    count = 0
+    with zipfile.ZipFile(partial, "w", compression=zipfile.ZIP_DEFLATED) as out:
+        out.writestr(EXPORT_MANIFEST, json.dumps({"format": 1, "profile": pid}))
+        for path in sorted(home.rglob("*")):
+            rel = PurePosixPath(path.relative_to(home).as_posix())
+            if _skipped(rel) or path.is_symlink() or not path.is_file():
+                continue
+            out.write(path, rel.as_posix())
+            count += 1
+    os.replace(partial, archive)
+    os.chmod(archive, 0o600)
+    say(f"exported {count} file(s) of profile {pid} to {archive}")
+    return 0
+
+
+@router.post("/api/profiles/{name}/export", status_code=202)
+def export(name: str, request: Request, scopes: Scopes) -> dict[str, Any]:
+    pid, home = _live(scopes, name)
+    folder = home / "backups"
+    stamp = datetime.now(UTC).strftime("%Y%m%d-%H%M%S")
+    archive = folder / f"profile-{pid}-{stamp}.zip"
+
+    def job(say: Say) -> int:
+        folder.mkdir(mode=0o700, exist_ok=True)
+        return export_profile(home, pid, archive, say)
+
+    actions = actions_of(dashboard_state(request.app).extras)
+    try:
+        actions.start_job(_scope_for(scopes, pid), "profile-export", job)
+    except ActionBusy:
+        _fail(409, "action_running", "An export of this profile is already running.")
+    return {"ok": True, "action": "profile-export", "profile": pid, "archive": str(archive)}
+
+
+class ImportBody(BaseModel):
+    archive: str = Field(min_length=1)
+    name: str | None = None
+
+
+def _members(archive: zipfile.ZipFile) -> list[zipfile.ZipInfo]:
+    total = 0
+    members: list[zipfile.ZipInfo] = []
+    for info in archive.infolist():
+        rel = PurePosixPath(info.filename)
+        if info.filename.startswith(("/", "\\")) or rel.is_absolute() or ".." in rel.parts:
+            raise ValueError(f"unsafe member {info.filename!r}")
+        if stat.S_ISLNK(info.external_attr >> 16):
+            raise ValueError(f"link member {info.filename!r}")
+        total += info.file_size
+        if total > EXPORT_MAX_BYTES:
+            raise ValueError("the archive is too large")
+        if not info.is_dir():
+            members.append(info)
+    return members
+
+
+@router.post("/api/profiles/import", status_code=201)
+def import_profile(body: ImportBody, scopes: Scopes) -> dict[str, Any]:
+    source = Path(body.archive)
+    if not source.is_absolute() or not source.is_file():
+        _fail(404, "archive_not_found", "There is no archive at that path.")
+    root = scopes.base.root
+    try:
+        with zipfile.ZipFile(source) as archive:
+            members = _members(archive)
+            try:
+                manifest = json.loads(archive.read(EXPORT_MANIFEST))
+            except (KeyError, ValueError):
+                manifest = {}
+            wanted = body.name or str(cast(dict[str, Any], manifest).get("profile") or "")
+            try:
+                pid = normalize_id(wanted)
+            except InvalidProfileId:
+                _fail(400, "bad_name", "Name the new profile (1-64 lowercase letters, digits).")
+            if pid == DEFAULT_PROFILE or is_live(root, pid):
+                _fail(409, "profile_exists", "A profile with that name already exists.")
+            target = profiles_dir(root) / pid
+            if target.exists() or target.is_symlink():
+                _fail(409, "folder_exists", "A folder with that name is in the way.")
+            staging = profiles_dir(root) / f".{pid}.import-{os.getpid()}"
+            shutil.rmtree(staging, ignore_errors=True)
+            try:
+                staging.mkdir(parents=True, mode=0o700)
+                for info in members:
+                    rel = PurePosixPath(info.filename)
+                    if rel.as_posix() == EXPORT_MANIFEST or _skipped(rel):
+                        continue
+                    dest = staging.joinpath(*rel.parts)
+                    dest.parent.mkdir(parents=True, exist_ok=True)
+                    with archive.open(info) as src, dest.open("wb") as out:
+                        shutil.copyfileobj(src, out)
+                if not any((staging / marker).is_file() for marker in IDENTITY_MARKERS):
+                    (staging / META_FILE).touch(mode=0o600)
+                clear_tombstone(root, pid)
+                os.rename(staging, target)
+            except BaseException:
+                shutil.rmtree(staging, ignore_errors=True)
+                raise
+    except (zipfile.BadZipFile, ValueError) as exc:
+        _fail(400, "bad_archive", f"That archive cannot be imported: {exc}")
+    except IndusError as exc:
+        _fail(400, "import_failed", exc.message)
+    except OSError:
+        _fail(500, "import_failed", "The profile could not be written.")
+    return {"ok": True, "name": pid, "path": str(target)}
diff --git a/src/indus/web/routes/system.py b/src/indus/web/routes/system.py
new file mode 100644
index 0000000..fc4a745
--- /dev/null
+++ b/src/indus/web/routes/system.py
@@ -0,0 +1,814 @@
+"""The System page's routes (P18-16): host stats, updates, memory provider, credential pool,
+operations, action status and shell hooks. Everything is per profile (``read_scope`` /
+``write_scope``).
+
+- ``GET /api/system/stats``: CPU count and load, memory and disk of the profile's home (``psutil``
+  when installed, else ``/proc`` and ``os``); coarse numbers only.
+- ``GET /api/system/update?force=``: install method, version and, for a git checkout, how many
+  commits it is behind its upstream; the answer is cached 24 h in ``<home>/cache/update_check.json``
+  and ``force=1`` checks again. ``POST /api/system/update`` pulls (``git pull --ff-only``) as a
+  background action for git installs only; any other install answers 409 with what to run instead.
+- ``GET /api/memory`` / ``PUT /api/memory/provider {provider}``: the external memory provider
+  (``""`` = built-in only), written through the config writer; an uninstalled name is refused.
+- ``/api/credentials/pool``: list every provider's credentials with a masked preview, never a value;
+  add ``{provider, api_key, label?}`` (kept in the secret store, metadata in ``auth.json``);
+  ``DELETE …/{provider}/{index}`` (1-based, as listed). An env-held key is hidden from the pool
+  rather than deleted, as ``indus auth remove`` does.
+- Operations, each a background action (``web.actions``): doctor, backup (+ download of an
+  archive it wrote, confined to ``<home>/backups``), import of an archive path or an uploaded zip,
+  checkpoint prune (+ a size listing). ``GET /api/actions/{name}/status?lines=`` tails one.
+- ``/api/ops/hooks``: configured shell hooks with their approval; create needs ``consent: true``
+  (it also records the approval, so the hook runs) and remove drops the entry and its approval.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import importlib
+import importlib.util
+import json
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+import time
+import zipfile
+from collections.abc import Callable
+from datetime import UTC, datetime
+from pathlib import Path
