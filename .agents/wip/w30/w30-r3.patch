@@ -0,0 +1,116 @@
+"""A stand-in daemon control socket for the dashboard's daemon routes (P18-15).
+
+It speaks the control wire of ``service.gateway_control`` (one JSON line in, one out, then close)
+on a real Unix socket. The socket lives in a short private temp folder and the profile home gets
+the owner-only pointer file a real daemon writes when its home path is too long, so the client
+code under test runs unchanged.
+
+``verbs`` maps a verb to a handler ``params -> result`` (raise ``Refuse(code)`` to answer an
+error). ``stop`` is answered by default: it records the call and, after answering, closes the
+socket so the daemon reads as gone. ``calls`` lists ``(verb, params)`` in order.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import shutil
+import socket
+import tempfile
+import threading
+from collections.abc import Callable
+from pathlib import Path
+from typing import Any
+
+from indus.service.gateway_control import POINTER_FILE
+
+type Handler = Callable[[dict[str, Any]], dict[str, Any]]
+
+
+class Refuse(Exception):
+    def __init__(self, code: str) -> None:
+        super().__init__(code)
+        self.code = code
+
+
+class FakeControl:
+    def __init__(self, home: Path, *, supports_stop: bool = True) -> None:
+        self.home = home
+        self.calls: list[tuple[str, dict[str, Any]]] = []
+        self.folder = Path(tempfile.mkdtemp(prefix="ixc"))
+        self.path = self.folder / "s"
+        self.alive = True
+        self.verbs: dict[str, Handler] = {
+            "identify": lambda _p: {"pid": os.getpid(), "profile": "work", "code_version": "t"},
+            "status": lambda _p: {"state": "running", "platforms": {}},
+            "drain": lambda p: {"draining": bool(p.get("on", True)), "active_turns": 0},
+        }
+        if supports_stop:
+            self.verbs["stop"] = lambda _p: {"stopping": True}
+        self._sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self._sock.bind(str(self.path))
+        self._sock.listen(8)
+        self._sock.settimeout(0.2)
+        pointer = home / POINTER_FILE
+        pointer.write_text(str(self.path), encoding="utf-8")
+        pointer.chmod(0o600)
+        self._thread = threading.Thread(target=self._serve, daemon=True)
+        self._thread.start()
+
+    def _answer(self, line: bytes) -> tuple[bytes, bool]:
+        message = json.loads(line)
+        verb = str(message.get("verb"))
+        params = dict(message.get("params") or {})
+        self.calls.append((verb, params))
+        handler = self.verbs.get(verb)
+        if handler is None:
+            body = {"ok": False, "protocol": 1, "id": message.get("id"), "error": "unknown_verb"}
+            return json.dumps(body).encode() + b"\n", False
+        try:
+            result = handler(params)
+        except Refuse as exc:
+            body = {"ok": False, "protocol": 1, "id": message.get("id"), "error": exc.code}
+            return json.dumps(body).encode() + b"\n", False
+        body = {"ok": True, "protocol": 1, "id": message.get("id"), "result": result}
+        return json.dumps(body).encode() + b"\n", verb == "stop"
+
+    def _serve(self) -> None:
+        while self.alive:
+            try:
+                conn, _ = self._sock.accept()
+            except TimeoutError:
+                continue
+            except OSError:
+                return
+            with conn:
+                conn.settimeout(2.0)
+                data = b""
+                with contextlib.suppress(OSError):
+                    while b"\n" not in data:
+                        chunk = conn.recv(65536)
+                        if not chunk:
+                            break
+                        data += chunk
+                if not data:
+                    continue
+                reply, stop = self._answer(data.partition(b"\n")[0])
+                with contextlib.suppress(OSError):
+                    conn.sendall(reply)
+            if stop:
+                self.close()
+
+    def verbs_called(self) -> list[str]:
+        return [verb for verb, _ in self.calls]
+
+    def close(self) -> None:
+        self.alive = False
+        with contextlib.suppress(OSError):
+            self._sock.close()
+        with contextlib.suppress(OSError):
+            self.path.unlink()
+
+    def remove(self) -> None:
+        self.close()
+        (self.home / POINTER_FILE).unlink(missing_ok=True)
+        shutil.rmtree(self.folder, ignore_errors=True)
diff --git a/tests/contract/web/_rest_app_r3.py b/tests/contract/web/_rest_app_r3.py
new file mode 100644
index 0000000..b8a9827
--- /dev/null
+++ b/tests/contract/web/_rest_app_r3.py
@@ -0,0 +1,123 @@
+"""A dashboard app for the P18-15 / P18-16 REST route tests.
+
+Builds the real app (``create_app`` in headless serve mode: no SPA bundle needed) for a profile
+scope, installs the per-request profile resolver (P18-10) the way the app factory will once it is
+wired, puts test seams into ``DashboardState.extras`` and returns a ``TestClient`` that sends the
+loopback session token on every call (``anonymous()`` gives one that sends nothing).
+
+Same approach as the P18-11..14 builders, kept as its own copy so the slices land independently.
+"""
+
+from __future__ import annotations
+
+import threading
+from collections.abc import Iterable, Iterator, Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+from fastapi import APIRouter, FastAPI
+from fastapi.routing import APIRoute
+from starlette.routing import BaseRoute
+from starlette.testclient import TestClient
+
+from indus.foundation.scope import Scope
+from indus.web.app import AppOptions, create_app
+from indus.web.scope import ProfileScopes, install, read_scope, write_scope
+from indus.web.state import DashboardState
+
+SESSION_HEADER = "X-Indus-Session-Token"
+_TICK = threading.Event()  # never set: a wall-clock pause between polls
+
+
+def pause(seconds: float) -> None:
+    """Wait ``seconds`` of wall-clock time (background actions run on real time)."""
+    _TICK.wait(seconds)
+
+
+BASE_URL = "http://127.0.0.1:9119"
+
+
+@dataclass
+class RestApp:
+    app: FastAPI
+    client: TestClient
+    state: DashboardState
+    _extra_clients: list[TestClient] = field(default_factory=list[TestClient])
+
+    def anonymous(self) -> TestClient:
+        """A client that carries no credential at all."""
+        client = TestClient(self.app, base_url=BASE_URL, follow_redirects=False)
+        self._extra_clients.append(client)
+        return client
+
+    def close(self) -> None:
+        for client in [self.client, *self._extra_clients]:
+            client.close()
+
+
+def build_rest_app(
+    scope: Scope,
+    *,
+    extras: Mapping[str, Any] | None = None,
+    options: AppOptions | None = None,
+) -> RestApp:
+    app = create_app(scope, "serve", options=options or AppOptions(config={}))
+    install(app, ProfileScopes(scope))
+    state: DashboardState = app.state.indus
+    state.extras.update(extras or {})
+    client = TestClient(app, base_url=BASE_URL, follow_redirects=False)
+    client.headers[SESSION_HEADER] = state.auth.token.value
+    return RestApp(app, client, state)
+
+
+def _depends_on(dependant: Any, target: object, seen: set[int]) -> bool:
+    if id(dependant) in seen:
+        return False
+    seen.add(id(dependant))
+    if getattr(dependant, "call", None) is target:
+        return True
+    return any(_depends_on(c, target, seen) for c in getattr(dependant, "dependencies", ()) or ())
+
+
+def api_routes(routes: Iterable[BaseRoute]) -> Iterator[APIRoute]:
+    """Every ``APIRoute``, including those of included routers (FastAPI keeps those wrapped, so
+    ``app.routes`` alone does not list them)."""
+    for route in routes:
+        if isinstance(route, APIRoute):
+            yield route
+            continue
+        inner: object = getattr(route, "original_router", None)
+        if isinstance(inner, APIRouter):
+            yield from api_routes(inner.routes)
+
+
+def _under(path: str, prefixes: tuple[str, ...]) -> bool:
+    return any(path == p or path.startswith(p.rstrip("/") + "/") for p in prefixes)
+
+
+def route_table(app: FastAPI, prefixes: tuple[str, ...]) -> set[tuple[str, str, bool]]:
+    """``(method, path, scoped)`` of the app's routes under ``prefixes`` (whole segments);
+    ``scoped`` = the route resolves a profile scope (``read_scope`` or ``write_scope``)."""
+    found: set[tuple[str, str, bool]] = set()
+    for route in api_routes(app.routes):
+        if not _under(route.path, prefixes):
+            continue
+        scoped = _depends_on(route.dependant, read_scope, set()) or _depends_on(
+            route.dependant, write_scope, set()
+        )
+        for method in route.methods or ():
+            if method != "HEAD":
+                found.add((method, route.path, scoped))
+    return found
+
+
+def unscoped_writes(app: FastAPI, prefixes: tuple[str, ...]) -> list[str]:
+    """Write routes under ``prefixes`` that do not depend on ``write_scope`` (R09.20)."""
+    missing: list[str] = []
+    for route in api_routes(app.routes):
+        writes = sorted({"POST", "PUT", "PATCH", "DELETE"} & set(route.methods or ()))
+        if not _under(route.path, prefixes) or not writes:
+            continue
+        if not _depends_on(route.dependant, write_scope, set()):
+            missing.extend(f"{method} {route.path}" for method in writes)
+    return missing
