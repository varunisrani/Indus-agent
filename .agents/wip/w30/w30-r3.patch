+    copy = scope.root / "profiles" / "copy"
+    assert (copy / "PERSONA.md").read_text(encoding="utf-8") == "Persona text"
+    clash = rest.client.post("/api/profiles/import", json={"archive": str(archive), "name": "copy"})
+    assert clash.status_code == 409
