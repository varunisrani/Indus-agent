+++ b/src/indus/web/routes/plugins.py
@@ -0,0 +1,202 @@
+"""``/api/plugins``: the Plugins page's backend (P18-14, over P13's plugin library).
+
+- ``GET /api/plugins``: every plugin the profile can see (bundled, user, entry points; project
+  plugins are a session matter) with its state, version, description, where it came from and the
+  commit it is pinned to.
+- ``POST /api/plugins/install {url, sha}``: a git install (``owner/repo[/sub]`` or a git URL;
+  never a local folder or ``file://``) pinned to a full 40-character commit SHA, checked before any
+  git command runs. The P13-20 scan decides: a block (``dangerous`` always, ``caution`` unless
+  ``force``) is 409 ``scan_blocked`` with the verdict. An install never enables the plugin.
+- ``POST /api/plugins/{name}/enable|disable``: through ``plugins.discovery.set_enabled`` and the
+  config writer. An enable that needs Python packages or a memory provider (those need a terminal
+  to consent or are chosen elsewhere) is refused with a code; capabilities the plugin declares and
+  the person has not granted stay ungranted and are listed as ``capabilities_waiting``.
+
+Seam for tests (``DashboardState.extras``): ``plugins.installer`` (``Scope -> Installer``-like:
+``install(identifier, ref=, force=, confirm=)`` and ``records()``).
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Annotated, Any, Final, NoReturn
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from pydantic import BaseModel, ConfigDict, Field
+
+from indus.foundation import config as config_module
+from indus.foundation.errors import ConfigError
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.plugins import consent
+from indus.plugins.discovery import PluginRecord, discover, set_enabled
+from indus.plugins.install import InstallBlocked, Installer, InstallError
+from indus.web.scope import read_scope, write_scope
+from indus.web.state import dashboard_state
+
+__all__ = ["ROUTE_LIST", "router"]
+
+router = APIRouter()
+
+ROUTE_LIST: Final[tuple[tuple[str, str, bool], ...]] = (
+    ("GET", "/api/plugins", True),
+    ("POST", "/api/plugins/install", True),
+    ("POST", "/api/plugins/{name}/enable", True),
+    ("POST", "/api/plugins/{name}/disable", True),
+)
+"""``(method, path, scoped)`` of every route here."""
+
+ReadScope = Annotated[Scope, Depends(read_scope)]
+WriteScope = Annotated[Scope, Depends(write_scope)]
+
+_FULL_SHA: Final = re.compile(r"^[0-9a-fA-F]{40}$")
+_GIT_URL: Final = re.compile(r"^(?:https?|ssh|git)://[^\s]+$")
+_SCP_LIKE: Final = re.compile(r"^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+:[^\s]+$")
+_OWNER_REPO: Final = re.compile(r"^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]+(?:/[^/\s]+)*/?$")
+
+
+def _fail(status: int, code: str, message: str, **extra: Any) -> NoReturn:
+    raise HTTPException(status_code=status, detail={"code": code, "message": message, **extra})
+
+
+def _configured(scope: Scope) -> Scope:
+    view = config_module.load(scope)
+    if view.error is not None:
+        _fail(500, "config_unreadable", "config.yaml cannot be read right now; fix it first.")
+    return scope.with_config(view)
+
+
+def _installer(request: Request, scope: Scope) -> Any:
+    factory: object = dashboard_state(request.app).extras.get("plugins.installer")
+    if callable(factory):
+        return factory(scope)
+    return Installer(scope)
+
+
+def _records(scope: Scope) -> list[PluginRecord]:
+    found = discover(scope, project_root=scope.home / ".no-project")
+    return [record for _key, record in sorted(found.records.items())]
+
+
+@router.get("/api/plugins")
+def list_plugins(request: Request, scope: ReadScope) -> dict[str, Any]:
+    live = _configured(scope)
+    try:
+        installed: dict[str, dict[str, Any]] = _installer(request, live).records()
+    except InstallError:
+        installed = {}
+    rows: list[dict[str, Any]] = []
+    for record in _records(live):
+        manifest = record.manifest
+        meta = installed.get(record.name, {})
+        revision = str(meta.get("revision") or "") or None
+        rows.append(
+            {
+                "name": record.name,
+                "key": record.key,
+                "version": (manifest.version or None) if manifest is not None else None,
+                "description": manifest.description if manifest is not None else "",
+                "enabled": record.state == "enabled",
+                "state": record.state,
+                "kind": record.kind,
+                "source": redact_text(str(meta.get("source") or "")) or record.source,
+                "sha": revision,
+                "pinned": meta.get("pinned") is True,
+            }
+        )
+    return {"plugins": rows}
+
+
+class PluginInstall(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    url: str = Field(min_length=1, max_length=2048)
+    sha: str = Field(min_length=1, max_length=64)
+    force: bool = False
+
+
+def _git_source(text: str) -> str:
+    value = text.strip()
+    if _GIT_URL.match(value) or _SCP_LIKE.match(value) or _OWNER_REPO.match(value):
+        return value
+    _fail(
+        400,
+        "invalid_source",
+        "Give owner/repo or a git URL (https://, ssh://, git@host:path); local folders are "
+        "installed from a terminal.",
+    )
+
+
+@router.post("/api/plugins/install")
+def install_plugin(request: Request, body: PluginInstall, scope: WriteScope) -> dict[str, Any]:
+    if not _FULL_SHA.match(body.sha.strip()):
+        _fail(422, "invalid_sha", "A full 40-character commit SHA is required.")
+    source = _git_source(body.url)
+    live = _configured(scope)
+    try:
+        result = _installer(request, live).install(
+            source, ref=body.sha.strip().lower(), force=body.force, confirm=None
+        )
+    except InstallBlocked as exc:
+        verdict = exc.report.verdict if exc.report is not None else None
+        _fail(409, "scan_blocked", redact_text(str(exc)), verdict=verdict)
+    except InstallError as exc:
+        hint = f" ({exc.hint})" if exc.hint else ""
+        _fail(400, "install_failed", redact_text(f"{exc}{hint}"))
+    return {
+        "ok": True,
+        "name": result.name,
+        "sha": str(result.record.get("revision") or "") or None,
+        "verdict": result.report.verdict,
+        "enabled": False,
+    }
+
+
+def _find(scope: Scope, name: str) -> PluginRecord:
+    for record in _records(scope):
+        if name in (record.key, record.name):
+            return record
+    _fail(404, "plugin_not_found", "No plugin has this name.")
+
+
+def _save(scope: Scope, raw: dict[str, Any]) -> None:
+    try:
+        config_module.save(scope, raw, replace=True)
+    except ConfigError as exc:
+        _fail(500, "config_unwritable", f"{exc.message}. Nothing was changed.")
+
+
+@router.post("/api/plugins/{name}/enable")
+def enable_plugin(name: str, scope: WriteScope) -> dict[str, Any]:
+    live = _configured(scope)
+    record = _find(live, name)
+    manifest = record.manifest
+    if manifest is None:
+        _fail(409, "plugin_broken", "The plugin's manifest is missing or broken.")
+    if record.handler == "memory":
+        _fail(409, "memory_provider", "This is a memory provider; choose it as memory.provider.")
+    if manifest.python_dependencies:
+        _fail(
+            409,
+            "dependencies_required",
+            "This plugin needs Python packages; enable it with `indus plugins enable` on a "
+            "terminal, which asks before installing them.",
+        )
+    raw = config_module.load(live).user_raw()
+    set_enabled(raw, record.key, True)
+    waiting = consent.consent_capabilities(raw, manifest, ask=None).waiting
+    _save(live, raw)
+    return {"ok": True, "name": record.name, "enabled": True, "capabilities_waiting": waiting}
+
+
+@router.post("/api/plugins/{name}/disable")
+def disable_plugin(name: str, scope: WriteScope) -> dict[str, Any]:
+    live = _configured(scope)
+    record = _find(live, name)
+    raw = config_module.load(live).user_raw()
+    set_enabled(raw, record.key, False)
+    memory: object = raw.get("memory")
+    if isinstance(memory, dict) and memory.get("provider") == record.name:  # pyright: ignore[reportUnknownMemberType]
+        memory["provider"] = ""
+    _save(live, raw)
+    return {"ok": True, "name": record.name, "enabled": False}
diff --git a/src/indus/web/routes/skills.py b/src/indus/web/routes/skills.py
new file mode 100644
index 0000000..e1e5d9a
--- /dev/null
+++ b/src/indus/web/routes/skills.py
@@ -0,0 +1,323 @@
+"""``/api/skills`` and ``/api/tools/toolsets``: the Skills page's backend (P18-14).
+
+- ``GET /api/skills``: every loadable skill of the profile (plugin skills left out) with its
+  category, source (``local``, ``bundled``, ``hub``, ``external``…) and whether it is enabled.
+- ``POST /api/skills/toggle {name, enabled}``: writes ``skills.disabled`` through the config
+  writer (P01); an unknown name is 404.
+- ``GET /api/tools/toolsets``: the plain toolsets (no bundles, postures or ``core``) with their
+  tools, and whether the CLI's tool selection (``platform_toolsets.cli``, else its bundle) offers
+  every one of them.
+- Hub (P13-26/27): ``GET /api/skills/hub/search?q=`` (catalogue and taps, then the live fallbacks;
+  a search downloads nothing, so ``verdict`` is null), ``GET /api/skills/hub/inspect?identifier=``
+  (fetch into quarantine, scan, report, discard), ``POST /api/skills/hub/install
+  {identifier, force?}``, ``POST /api/skills/hub/uninstall {name}``, ``POST /api/skills/hub/update
+  {name?}``. An install the policy blocks is 409 ``scan_blocked`` with the verdict: ``dangerous``
+  is never installed, ``force`` lifts ``caution`` only. Network trouble is 502 ``hub_unavailable``.
+
+Hub work runs on its own event loop in the worker thread FastAPI gives a sync route. Seam for
+tests (``DashboardState.extras``): ``skills.hub_sources`` (``Scope -> SourceSet``).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Callable, Coroutine, Mapping
+from typing import Annotated, Any, Final, NoReturn
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from pydantic import BaseModel, ConfigDict, Field
+
+from indus.foundation import config as config_module
+from indus.foundation.errors import ConfigError
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.learning.skills import bundled_sync
+from indus.learning.skills.hub import install as hub
+from indus.learning.skills.hub.lock import HubLock
+from indus.learning.skills.hub.sources import HubError, SourceSet
+from indus.learning.skills.resolver import TIER_LOCAL, SkillRecord, load_catalog
+from indus.learning.skills.usage import hub_names
+from indus.tools import toolsets
+from indus.web.scope import read_scope, write_scope
+from indus.web.state import DashboardState, dashboard_state
+
+__all__ = ["ROUTE_LIST", "router"]
+
+router = APIRouter()
+
+ROUTE_LIST: Final[tuple[tuple[str, str, bool], ...]] = (
+    ("GET", "/api/skills", True),
+    ("POST", "/api/skills/toggle", True),
+    ("GET", "/api/tools/toolsets", True),
+    ("GET", "/api/skills/hub/search", True),
+    ("GET", "/api/skills/hub/inspect", True),
+    ("POST", "/api/skills/hub/install", True),
+    ("POST", "/api/skills/hub/uninstall", True),
+    ("POST", "/api/skills/hub/update", True),
+)
+"""``(method, path, scoped)`` of every route here."""
+
+ReadScope = Annotated[Scope, Depends(read_scope)]
+WriteScope = Annotated[Scope, Depends(write_scope)]
+
+SEARCH_LIMIT: Final = 50
+TOOLSET_PLATFORM: Final = "cli"
+
+
+def _fail(status: int, code: str, message: str, **extra: Any) -> NoReturn:
+    raise HTTPException(status_code=status, detail={"code": code, "message": message, **extra})
+
+
+def _configured(scope: Scope) -> Scope:
+    """``scope`` carrying the settings as they are on disk now."""
+    view = config_module.load(scope)
+    if view.error is not None:
+        _fail(500, "config_unreadable", "config.yaml cannot be read right now; fix it first.")
+    return scope.with_config(view)
+
+
+# -- installed skills ------------------------------------------------------------------------------
+
+
+def _source(record: SkillRecord, shipped: set[str], from_hub: set[str]) -> str:
+    if record.tier == TIER_LOCAL and record.name in from_hub:
+        return "hub"
+    if record.tier == TIER_LOCAL and record.name in shipped:
+        return "bundled"
+    return record.tier_name
+
+
+def _skills(scope: Scope) -> list[SkillRecord]:
+    return [r for r in load_catalog(scope).loadable() if r.plugin is None]
+
+
+@router.get("/api/skills")
+def list_skills(scope: ReadScope) -> dict[str, Any]:
+    live = _configured(scope)
+    shipped = set(bundled_sync.read_manifest(live.home))
+    from_hub = hub_names(hub.skills_root(live))
+    rows = [
+        {
+            "name": record.load_name or record.name,
+            "description": record.description,
+            "category": record.category or "",
+            "enabled": not record.disabled,
+            "source": _source(record, shipped, from_hub),
+        }
+        for record in _skills(live)
+    ]
+    return {"skills": rows}
+
+
+class SkillToggle(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    name: str = Field(min_length=1, max_length=200)
+    enabled: bool
+
+
+def _disabled_list(scope: Scope) -> list[str]:
+    raw: object = config_module.load(scope).get("skills.disabled", [])
+    if not isinstance(raw, list):
+        return []
+    return [str(item) for item in raw]  # pyright: ignore[reportUnknownVariableType]
+
+
+@router.post("/api/skills/toggle")
+def toggle_skill(body: SkillToggle, scope: WriteScope) -> dict[str, Any]:
+    live = _configured(scope)
+    names = {r.load_name or r.name for r in _skills(live)} | {r.name for r in _skills(live)}
+    if body.name not in names:
+        _fail(404, "skill_not_found", "No skill has this name.")
+    current = _disabled_list(live)
+    wanted = [n for n in current if n != body.name]
+    if not body.enabled:
+        wanted.append(body.name)
+    if wanted != current:
+        try:
+            config_module.save(live, {"skills": {"disabled": wanted}})
+        except ConfigError as exc:
+            _fail(500, "config_unwritable", f"{exc.message}. Nothing was changed.")
+    return {"ok": True, "name": body.name, "enabled": body.enabled}
+
+
+# -- toolsets --------------------------------------------------------------------------------------
+
+
+def _plain_toolsets() -> list[str]:
+    rows: list[str] = []
+    for name, entry in sorted(toolsets.TOOLSETS.items()):
+        if entry.includes or entry.posture or name == toolsets.CORE:
+            continue
+        if name.startswith(toolsets.BUNDLE_PREFIX):
+            continue
+        rows.append(name)
+    return rows
+
+
+def _cli_selection(scope: Scope) -> list[str]:
+    saved: object = config_module.load(scope).user_raw().get("platform_toolsets")
+    if isinstance(saved, Mapping):
+        chosen: object = saved.get(TOOLSET_PLATFORM)  # pyright: ignore[reportUnknownMemberType]
+        if isinstance(chosen, list):
+            return [str(n) for n in chosen]  # pyright: ignore[reportUnknownVariableType]
+    return [f"{toolsets.BUNDLE_PREFIX}{TOOLSET_PLATFORM}"]
+
+
+@router.get("/api/tools/toolsets")
+def list_toolsets(scope: ReadScope) -> dict[str, Any]:
+    offered = toolsets.select(_cli_selection(scope), scope=scope, platform=TOOLSET_PLATFORM).tools
+    rows: list[dict[str, Any]] = []
+    for name in _plain_toolsets():
+        entry = toolsets.TOOLSETS[name]
+        tools = sorted(toolsets.resolve(name, None, scope))
+        rows.append(
+            {
+                "name": name,
+                "label": name.replace("_", " ").replace("-", " ").title(),
+                "description": entry.description,
+                "enabled": bool(tools) and set(tools) <= offered,
+                "tools": tools,
+            }
+        )
+    return {"toolsets": rows}
+
+
+# -- hub -------------------------------------------------------------------------------------------
+
+
+def _hub[T](
+    state: DashboardState, scope: Scope, work: Callable[[SourceSet], Coroutine[Any, Any, T]]
+) -> T:
+    """Run ``work`` with fresh hub sources on its own loop (this is a worker thread)."""
+    factory: object = state.extras.get("skills.hub_sources")
+
+    async def main() -> T:
+        if callable(factory):
+            sources: SourceSet = factory(scope)  # pyright: ignore[reportAssignmentType]
+        else:
+            from indus.learning.skills.hub.sources import build_sources
+
+            sources = build_sources(scope)
+        try:
+            return await work(sources)
+        finally:
+            await sources.aclose()
+
+    try:
+        return asyncio.run(main())
+    except HubError as exc:
+        _fail(502, "hub_unavailable", redact_text(str(exc)))
+
+
+def _installed(scope: Scope) -> tuple[set[str], set[str]]:
+    entries = HubLock(hub.skills_root(scope)).installed()
+    identifiers = {str(e.get("identifier", "")) for e in entries.values()}
+    return set(entries), identifiers
+
+
+@router.get("/api/skills/hub/search")
+def hub_search(request: Request, scope: ReadScope, q: str = "") -> dict[str, Any]:
+    query = q.strip()
+    if not query:
+        return {"results": []}
+    from indus.learning.skills.hub.sources import search_sources
+
+    live = _configured(scope)
+    state = dashboard_state(request.app)
+    outcome = _hub(state, live, lambda s: search_sources(s, query, limit=SEARCH_LIMIT))
+    names, identifiers = _installed(live)
+    results = [
+        {
+            "identifier": row.identifier,
+            "name": row.name,
+            "description": row.description,
+            "source": row.source,
+            "trust": row.trust,
+            "verdict": None,
+            "installed": row.identifier in identifiers or row.name in names,
+            "update_available": False,
+        }
+        for row in outcome.rows
+    ]
+    return {"results": results, "timed_out": list(outcome.timed_out)}
+
+
+@router.get("/api/skills/hub/inspect")
+def hub_inspect(request: Request, scope: ReadScope, identifier: str) -> dict[str, Any]:
+    live = _configured(scope)
+    state = dashboard_state(request.app)
+    preview = _hub(state, live, lambda s: hub.inspect(live, s, identifier))
+    return {
+        "identifier": preview.bundle.identifier,
+        "name": preview.name,
+        "source": preview.bundle.source,
+        "trust": preview.bundle.trust,
+        "verdict": preview.report.verdict,
+        "findings": len(preview.report.findings),
+        "categories": list(preview.report.categories),
+        "allowed": preview.allowed,
+        "reason": preview.reason,
+    }
+
+
+class HubInstall(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    identifier: str = Field(min_length=1, max_length=2048)
+    force: bool = False
+
+
+@router.post("/api/skills/hub/install")
+def hub_install(request: Request, body: HubInstall, scope: WriteScope) -> dict[str, Any]:
+    live = _configured(scope)
+    state = dashboard_state(request.app)
+    options = hub.InstallOptions(force=body.force)
+    result = _hub(state, live, lambda s: hub.install(live, s, body.identifier, options))
+    verdict = result.preview.report.verdict if result.preview is not None else None
+    message = redact_text(result.message)
+    if result.status == "blocked":
+        _fail(409, "scan_blocked", message, verdict=verdict)
+    if result.status == "exists":
+        _fail(409, "already_installed", message, verdict=verdict)
+    if not result.ok:
+        _fail(400, "install_failed", message or "The skill could not be installed.")
+    return {"ok": True, "name": result.name, "verdict": verdict}
+
+
+class HubName(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    name: str = Field(min_length=1, max_length=200)
+
+
+@router.post("/api/skills/hub/uninstall")
+def hub_uninstall(body: HubName, scope: WriteScope) -> dict[str, Any]:
+    live = _configured(scope)
+    try:
+        message = hub.uninstall(live, body.name)
+    except HubError as exc:
+        _fail(404, "not_a_hub_skill", redact_text(str(exc)))
+    return {"ok": True, "message": message}
+
+
+class HubUpdate(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+    name: str | None = Field(default=None, min_length=1, max_length=200)
+
+
+@router.post("/api/skills/hub/update")
+def hub_update(
+    request: Request, scope: WriteScope, body: HubUpdate | None = None
+) -> dict[str, Any]:
+    live = _configured(scope)
+    state = dashboard_state(request.app)
+    name = body.name if body is not None else None
+    report = _hub(state, live, lambda s: hub.update(live, s, name))
+    return {
+        "ok": not report.failed,
+        "updated": report.updated,
+        "kept_local": report.kept_local,
+        "failed": [{"name": n, "message": redact_text(m)} for n, m in report.failed],
+    }
diff --git a/src/indus/web/routes/status.py b/src/indus/web/routes/status.py
new file mode 100644
index 0000000..ac1e734
--- /dev/null
+++ b/src/indus/web/routes/status.py
@@ -0,0 +1,400 @@
+"""``GET /api/status``: the public status probe of the dashboard (P18-13).
+
+The path is on the shared public list (``auth.public_paths``), so whoever can reach the port reads
+it. It therefore carries only counts, enums and coarse numbers: never a path, pid, host name,
+session id, title or error text.
+
+What it reports:
+
+- ``version`` and ``daemon {state, heartbeat_age_s}``: the daemon's own word from its runtime record
+  (``state.gateway_runtime``); ``stopped`` when there is no record or the process it names is gone;
+  ``unknown`` when the heartbeat is older than ``HEARTBEAT_LIMIT_S``, dated in the future, or the
+  record cannot be read;
+- ``platforms``: ``[{name, state}]`` as the daemon reports them (only while it runs);
+- ``active_sessions`` / ``recent_sessions``: of the ``RECENT_WINDOW`` most recently active sessions,
+  how many are open and were active in the last ``ACTIVE_WINDOW_S``, and how many the window held
+  (store opened read-only; a missing store is never created);
+- ``auth_required`` / ``auth_providers`` (``auth.gate.describe_mode``);
+- ``components {store, daemon, platforms}`` and ``overall``;
+- ``memory`` / ``disk``: pressure (``ok`` / ``elevated`` / ``critical``), one coarse number each.
+
+Every collector is fail-safe: an error makes its block ``unknown`` and the rest is still answered.
+Tests replace collectors through ``DashboardState.extras`` (``status.memory``, ``status.disk``,
+``status.now``).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import shutil
+import sqlite3
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Annotated, Any, Final, Literal
+
+from fastapi import APIRouter, Depends, Request
+from fastapi.responses import JSONResponse
+
+import indus
+from indus.foundation.errors import StoreUnavailable
+from indus.foundation.scope import Scope
+from indus.state import browse
+from indus.state import gateway_runtime as runtime
+from indus.state.errors import Bucket, classify, is_lock_error
+from indus.web.auth.gate import describe_mode
+from indus.web.scope import read_scope
+from indus.web.state import dashboard_state
+
+__all__ = [
+    "ACTIVE_WINDOW_S",
+    "HEARTBEAT_LIMIT_S",
+    "RECENT_WINDOW",
+    "ROUTE_LIST",
+    "Pressure",
+    "daemon_view",
+    "disk_pressure",
+    "memory_pressure",
+    "router",
+]
+
+log = logging.getLogger(__name__)
+
+router = APIRouter()
+
+ROUTE_LIST: Final[tuple[tuple[str, str, bool], ...]] = (("GET", "/api/status", True),)
+"""``(method, path, scoped)`` of every route here (the SPA's generated route list)."""
+
+ReadScope = Annotated[Scope, Depends(read_scope)]
+
+type Pressure = Literal["ok", "elevated", "critical", "unknown"]
+
+MIB: Final = 1024 * 1024
+GIB: Final = 1024 * MIB
+HEARTBEAT_LIMIT_S: Final = 150.0
+ACTIVE_WINDOW_S: Final = 300.0
+RECENT_WINDOW: Final = 20
+
+MEMORY_CRITICAL: Final = (64 * MIB, 5.0)
+"""(bytes available, percent available) under either of which memory is critical."""
+MEMORY_ELEVATED: Final = (128 * MIB, 15.0)
+DISK_CRITICAL: Final = (256 * MIB, 95.0, 1 * GIB)
+"""(free bytes floor, used percent, headroom): critical below the floor, or at/over the percent
+with less than the headroom left."""
+DISK_ELEVATED: Final = (512 * MIB, 85.0, 4 * GIB)
+
+_LIVE_DAEMON: Final = frozenset({"starting", "running", "draining", "stopping", "degraded"})
+_DOWN_DAEMON: Final = frozenset({"stopped", "startup_failed"})
+_HEALTHY_PLATFORM: Final = "connected"
+_PAUSED_PLATFORM: Final = "paused"
+"""Paused on purpose: shown, but never a degraded verdict."""
+_SERVING_DAEMON: Final = frozenset({"running", "draining"})
+
+
+# -- pressure --------------------------------------------------------------------------------------
+
+
+def memory_pressure(available: int, total: int) -> Pressure:
+    """Pressure for ``available`` of ``total`` bytes of memory."""
+    if total <= 0 or available < 0:
+        return "unknown"
+    percent = available * 100.0 / total
+    if available < MEMORY_CRITICAL[0] or percent < MEMORY_CRITICAL[1]:
+        return "critical"
+    if available < MEMORY_ELEVATED[0] or percent < MEMORY_ELEVATED[1]:
+        return "elevated"
+    return "ok"
+
+
+def disk_pressure(free: int, total: int) -> Pressure:
+    """Pressure for ``free`` of ``total`` bytes on the home's file system."""
+    if total <= 0 or free < 0:
+        return "unknown"
+    used = (total - free) * 100.0 / total
+
+    def under(rule: tuple[int, float, int]) -> bool:
+        floor, percent, headroom = rule
+        return free < floor or (used >= percent and free < headroom)
+
+    if under(DISK_CRITICAL):
+        return "critical"
+    if under(DISK_ELEVATED):
+        return "elevated"
+    return "ok"
+
+
+@dataclass(frozen=True)
+class Amount:
+    """``available``/``free`` and ``total`` bytes from a collector."""
+
+    left: int
+    total: int
+
+
+def _meminfo() -> Amount:
+    fields: dict[str, int] = {}
+    with open("/proc/meminfo", encoding="ascii") as handle:
+        for line in handle:
+            name, _, rest = line.partition(":")
+            parts = rest.split()
+            if parts and parts[0].isdigit():
+                fields[name.strip()] = int(parts[0]) * 1024
+    return Amount(fields["MemAvailable"], fields["MemTotal"])
+
+
+def read_memory() -> Amount:
+    """Available and total memory: ``/proc/meminfo``, else psutil when installed."""
+    try:
+        return _meminfo()
+    except (OSError, KeyError, ValueError):
+        pass
+    import psutil  # pyright: ignore[reportMissingImports, reportMissingModuleSource]
+
+    found: Any = psutil.virtual_memory()  # pyright: ignore[reportUnknownMemberType]
+    return Amount(int(found.available), int(found.total))
+
+
+def disk_reader(home: Path) -> Callable[[], Amount]:
+    def read() -> Amount:
+        usage = shutil.disk_usage(home)
+        return Amount(int(usage.free), int(usage.total))
+
+    return read
+
+
+def _memory_block(read: Callable[[], Amount]) -> dict[str, Any]:
+    try:
+        amount = read()
+        pressure = memory_pressure(amount.left, amount.total)
+        if pressure == "unknown":
+            return {"pressure": "unknown"}
+        return {"pressure": pressure, "available_percent": int(amount.left * 100 / amount.total)}
+    except Exception as exc:
+        log.debug("memory pressure unavailable: %s", type(exc).__name__)
+        return {"pressure": "unknown"}
+
+
+def _disk_block(read: Callable[[], Amount]) -> dict[str, Any]:
+    try:
+        amount = read()
+        pressure = disk_pressure(amount.left, amount.total)
+        if pressure == "unknown":
+            return {"pressure": "unknown"}
+        used = (amount.total - amount.left) * 100 / amount.total
+        return {
+            "pressure": pressure,
+            "used_percent": int(used),
+            "free_gb": int(amount.left // GIB),
+        }
+    except Exception as exc:
+        log.debug("disk pressure unavailable: %s", type(exc).__name__)
+        return {"pressure": "unknown"}
+
+
+# -- daemon ----------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class DaemonView:
+    state: str
+    heartbeat_age_s: int | None = None
+    platforms: tuple[tuple[str, str], ...] = ()
+
+
+def _when(value: object) -> datetime | None:
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int | float):
+        return datetime.fromtimestamp(float(value)).astimezone()
+    if not isinstance(value, str) or not value:
+        return None
+    try:
+        parsed = datetime.fromisoformat(value)
+    except ValueError:
+        return None
+    return parsed if parsed.tzinfo is not None else parsed.astimezone()
+
+
+def _platform_rows(data: Mapping[str, Any]) -> tuple[tuple[str, str], ...]:
+    raw: object = data.get("platforms")
+    if not isinstance(raw, dict):
+        return ()
+    rows: list[tuple[str, str]] = []
+    for name, row in raw.items():  # pyright: ignore[reportUnknownVariableType]
+        parsed = runtime.PlatformStatus.from_json(row)
+        if parsed is not None and isinstance(name, str):
+            rows.append((name, parsed.state))
+    return tuple(sorted(rows))
+
+
+def daemon_view(
+    home: Path,
+    now: datetime,
+    *,
+    alive: Callable[[runtime.ProcessIdentity], bool] | None = None,
+) -> DaemonView:
+    """The daemon's state for the public probe (see the module notes)."""
+    path = runtime.status_path(home)
+    try:
+        text = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return DaemonView("stopped")
+    except OSError:
+        return DaemonView("unknown")
+    try:
+        data: object = json.loads(text)
+    except ValueError:
+        return DaemonView("unknown")
+    if not isinstance(data, dict):
+        return DaemonView("unknown")
+    record: dict[str, Any] = {str(k): v for k, v in data.items()}  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+    status = runtime.RuntimeStatus.from_json(record)
+    if status is None:
+        return DaemonView("unknown")
+    if status.state in _DOWN_DAEMON:
+        return DaemonView(status.state)
+    stamped = _when(record.get("updated_at"))
+    if stamped is None:
+        return DaemonView("unknown")
+    age = (now - stamped).total_seconds()
+    if age < 0 or age > HEARTBEAT_LIMIT_S:
+        return DaemonView("unknown")
+    check = alive if alive is not None else _process_alive
+    if not check(status.process):
+        return DaemonView("stopped")
+    state = status.state if status.state in _LIVE_DAEMON else "unknown"
+    return DaemonView(state, int(age), _platform_rows(record))
+
+
+def _process_alive(identity: runtime.ProcessIdentity) -> bool:
+    return identity.is_alive()
+
+
+def _daemon_component(view: DaemonView) -> str:
+    if view.state in _SERVING_DAEMON:
+        return "ok"
+    if view.state == "unknown":
+        return "unknown"
+    if view.state in _DOWN_DAEMON:
+        return "down"
+    return "degraded"
+
+
+# -- sessions --------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class SessionCounts:
+    store: str
+    active: int = 0
+    recent: int = 0
+
+
+_RECENT_SQL: Final = (
+    "SELECT ended_at, COALESCE(last_activity_at, started_at) AS seen FROM sessions "
+    "WHERE hidden = 0 ORDER BY seen DESC LIMIT ?"
+)
+
+
+def _store_problem(exc: BaseException) -> str:
+    if is_lock_error(exc):
+        return "busy"
+    return "corrupt" if classify(exc) is Bucket.CORRUPT else "unavailable"
+
+
+def session_counts(scope: Scope, now: float) -> SessionCounts:
+    """Active and recent counts from the read-only store (never created)."""
+    try:
+        store = browse.open_readonly(scope)
+    except StoreUnavailable as exc:
+        return SessionCounts("missing" if exc.kind == "missing" else "unavailable")
+    except (sqlite3.Error, OSError) as exc:
+        return SessionCounts(_store_problem(exc))
+    try:
+        with store.read() as conn:
+            rows = conn.execute(_RECENT_SQL, (RECENT_WINDOW,)).fetchall()
+    except sqlite3.Error as exc:
+        return SessionCounts(_store_problem(exc))
+    finally:
+        store.close()
+    active = sum(
+        1
+        for row in rows
+        if row["ended_at"] is None
+        and row["seen"] is not None
+        and now - row["seen"] < ACTIVE_WINDOW_S
+    )
+    return SessionCounts("ok", active, len(rows))
+
+
+# -- the route -------------------------------------------------------------------------------------
+
+
+def _now(request: Request, scope: Scope) -> datetime:
+    override: object = dashboard_state(request.app).extras.get("status.now")
+    if callable(override):
+        found: object = override()
+        if isinstance(found, datetime):
+            return found
+    return scope.clock.now()
+
+
+def _collector(request: Request, key: str, default: Callable[[], Amount]) -> Callable[[], Amount]:
+    override: object = dashboard_state(request.app).extras.get(key)
+    if callable(override):
+        return override  # pyright: ignore[reportReturnType]
+    return default
+
+
+def build_status(request: Request, scope: Scope) -> dict[str, Any]:
+    state = dashboard_state(request.app)
+    now = _now(request, scope)
+    try:
+        daemon = daemon_view(scope.home, now)
+    except Exception as exc:
+        log.debug("daemon state unavailable: %s", type(exc).__name__)
+        daemon = DaemonView("unknown")
+    try:
+        sessions = session_counts(scope, now.timestamp())
+    except Exception as exc:
+        log.debug("session counts unavailable: %s", type(exc).__name__)
+        sessions = SessionCounts("unknown")
+    counted = [row for _name, row in daemon.platforms if row != _PAUSED_PLATFORM]
+    connected = sum(1 for row in counted if row == _HEALTHY_PLATFORM)
+    platform_status = "ok" if connected == len(counted) else "degraded"
+    components: dict[str, dict[str, Any]] = {
+        "store": {"status": "ok" if sessions.store in ("ok", "missing") else sessions.store},
+        "daemon": {"status": _daemon_component(daemon), "state": daemon.state},
+        "platforms": {
+            "status": platform_status,
+            "configured": len(counted),
+            "connected": connected,
+        },
+    }
+    overall = "ok" if all(c["status"] == "ok" for c in components.values()) else "degraded"
+    memory = _memory_block(_collector(request, "status.memory", read_memory))
+    disk = _disk_block(_collector(request, "status.disk", disk_reader(scope.home)))
+    return {
+        "version": indus.__version__,
+        "daemon": {"state": daemon.state, "heartbeat_age_s": daemon.heartbeat_age_s},
+        "platforms": [{"name": name, "state": row} for name, row in daemon.platforms],
+        "active_sessions": sessions.active,
+        "recent_sessions": sessions.recent,
+        **describe_mode(state.auth),
+        "components": components,
+        "overall": overall,
+        "memory": memory,
+        "disk": disk,
+    }
+
+
+@router.get("/api/status")
+def get_status(request: Request, scope: ReadScope) -> JSONResponse:
+    try:
+        body = build_status(request, scope)
+    except Exception as exc:  # the probe answers even when something above is broken
+        log.warning("the status probe failed: %s", type(exc).__name__)
+        body = {"version": indus.__version__, "daemon": {"state": "unknown"}, "overall": "unknown"}
+    return JSONResponse(body, headers={"cache-control": "no-store"})
