+def test_unreadable_daemon_record_reads_unknown(scope: Scope, content: str) -> None:
+    runtime.status_path(scope.home).write_text(content, encoding="utf-8")
+    assert daemon_view(scope.home, scope.clock.now()).state == "unknown"
+
