+SPEC: dict[str, Any] = {
+    "name": "docs",
+    "command": "/usr/bin/docs-server",
+    "args": ["--stdio"],
+    "env": [{"name": "DOCS_TOKEN", "value": "tok" + "en-one"}],
+}
