+++ b/src/indus/mcp_serve/event_bridge.py
@@ -0,0 +1,321 @@
+"""The event bridge of ``indus mcp serve`` (P19-15): new chat messages as a queue a client polls.
+
+``EventBridge(reader, clock)`` runs as a task on the server's loop:
+
+- **start.** The baseline: every routed conversation's newest message id, and the store's newest
+  id overall (a conversation that only appears later starts after it). History is never replayed
+  as events. A store that does not exist yet has an empty baseline: everything it holds once it
+  appears arrived after the start.
+- **tick, every 200 ms on the injected clock.** Read the store's change counter (``PRAGMA
+  data_version`` on the reader's connection); when it has not moved, stop there. When it moved,
+  reload the routing index and read, per conversation, the live user and assistant rows after its
+  last seen id, in id order (R03.14, never timestamps). Rows copied by a compaction (same message
+  uid as an older row of the session or its parent) and compression handoff rows are not news.
+  Each new text becomes one ``message`` event (content cut to 500 characters).
+- **queue.** At most 1,000 events; the oldest go first. Cursors are integers that only grow, so
+  a caller whose cursor fell behind the oldest kept event learns how many it missed (``dropped``).
+- **poll / wait.** ``poll(after, key, limit)`` answers at once; ``wait(after, key, timeout_ms)``
+  answers as soon as a matching event is queued, re-checking at least every 200 ms, or with
+  nothing at its deadline.
+
+Other parts of the server add events with ``publish`` (the approval watcher, P19-17). Store reads
+run on the blocking pool; everything else runs on the loop, so no locks are needed for the queue.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import sqlite3
+from collections import deque
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field
+from typing import Any, Final
+
+from indus.foundation.blocking import run_blocking
+from indus.foundation.clock import Clock
+from indus.foundation.errors import StoreUnavailable
+from indus.mcp_serve.read_tools import TEXT_ROLES, conversations_in, iso_time, message_text
+from indus.mcp_serve.store import StoreReader
+from indus.state.handoff import not_handoff_sql
+from indus.state.messages import decode_content
+
+__all__ = [
+    "EVENT_CHARS",
+    "POLL_SECONDS",
+    "QUEUE_LIMIT",
+    "EventBridge",
+    "QueueEvent",
+]
+
+log = logging.getLogger(__name__)
+
+POLL_SECONDS: Final = 0.2
+QUEUE_LIMIT: Final = 1000
+EVENT_CHARS: Final = 500
+
+type Offload = Callable[[Callable[[], Any]], Awaitable[Any]]
+
+_NEWEST: Final = "SELECT COALESCE(MAX(id), 0) FROM messages"
+_NEW_ROWS: Final = f"""
+SELECT m.id, m.role, m.content, m.timestamp FROM messages AS m
+WHERE m.session_id = ? AND m.id > ? AND m.active = 1 AND m.role IN ('user', 'assistant')
+  AND {not_handoff_sql("m.")}
+  AND (m.message_uid IS NULL OR NOT EXISTS (
+    SELECT 1 FROM messages AS o
+    WHERE o.message_uid = m.message_uid AND o.id < m.id
+      AND o.session_id IN (
+        m.session_id,
+        COALESCE((SELECT s.parent_session_id FROM sessions AS s WHERE s.id = m.session_id), '')
+      )
+  ))
+ORDER BY m.id
+"""
+
+
+@dataclass
+class QueueEvent:
+    cursor: int
+    type: str
+    session_key: str = ""
+    data: dict[str, Any] = field(default_factory=dict[str, Any])
+
+    def as_json(self) -> dict[str, Any]:
+        head = {"cursor": self.cursor, "type": self.type, "session_key": self.session_key}
+        return {**head, **self.data}
+
+
+@dataclass(frozen=True)
+class _Found:
+    row_id: int
+    session_key: str
+    role: str
+    text: str
+    timestamp: object
+
+
+async def _on_pool(fn: Callable[[], Any]) -> Any:
+    return await run_blocking(fn, label="mcp serve store read")
+
+
+class EventBridge:
+    """See the module notes."""
+
+    def __init__(
+        self,
+        reader: StoreReader,
+        clock: Clock,
+        *,
+        poll_seconds: float = POLL_SECONDS,
+        queue_limit: int = QUEUE_LIMIT,
+        offload: Offload | None = None,
+    ) -> None:
+        self.reader = reader
+        self.clock = clock
+        self.poll_seconds = poll_seconds
+        self.queue_limit = queue_limit
+        self._offload: Offload = offload or _on_pool
+        self._queue: deque[QueueEvent] = deque()
+        self._cursor = 0
+        self._changed = asyncio.Event()
+        self._task: asyncio.Task[None] | None = None
+        self._version: int | None = None
+        self._seen: dict[str, int] = {}
+        self._floor = 0
+        self._based = False
+        self.index_loads = 0
+        """How many times the routing index was reloaded (a change of the store was seen)."""
+        self._listeners: list[Callable[[], Awaitable[None]]] = []
+
+    # -- lifecycle --------------------------------------------------------------------------------
+
+    async def baseline(self) -> None:
+        """Record where history ends (see the module notes); ``start`` does it first."""
+        await self._offload(self._baseline)
+
+    async def start(self) -> None:
+        """Take the baseline, then watch in the background."""
+        await self.baseline()
+        if self._task is None:
+            self._task = asyncio.create_task(self._run(), name="mcp serve event bridge")
+
+    async def aclose(self) -> None:
+        task, self._task = self._task, None
+        if task is not None:
+            task.cancel()
+            with contextlib.suppress(asyncio.CancelledError, Exception):
+                await task
+        self._wake()
+
+    def on_tick(self, listener: Callable[[], Awaitable[None]]) -> None:
+        """Run ``listener`` after every tick (the approval watcher)."""
+        self._listeners.append(listener)
+
+    async def _run(self) -> None:
+        while True:
+            try:
+                await self.tick()
+            except asyncio.CancelledError:
+                raise
+            except Exception:
+                log.debug("event bridge tick failed", exc_info=True)
+            for listener in list(self._listeners):
+                try:
+                    await listener()
+                except asyncio.CancelledError:
+                    raise
+                except Exception:
+                    log.debug("event bridge listener failed", exc_info=True)
+            await self.clock.sleep(self.poll_seconds)
+
+    # -- the store side (blocking: runs on the pool) ----------------------------------------------
+
+    def _baseline(self) -> None:
+        try:
+            self._version = self.reader.data_version()
+
+            # Row ids only grow and one writer commits at a time, so "after the newest id now" is
+            # "after the start" for every conversation, those the index names later included.
+            self._floor = self.reader.read(lambda conn: int(conn.execute(_NEWEST).fetchone()[0]))
+            self._seen = {}
+            self._based = True
+        except StoreUnavailable:
+            self._version = None
+            self._based = True  # nothing yet: everything that appears later is new
+        except sqlite3.Error:
+            self._version = None
+            log.debug("event bridge baseline failed; retrying on the next tick", exc_info=True)
+
+    def scan(self) -> list[_Found]:
+        """One look at the store (see the module notes); the rows that are news, in id order."""
+        if not self._based:
+            self._baseline()
+            if not self._based:
+                return []
+        try:
+            version = self.reader.data_version()
+        except (StoreUnavailable, sqlite3.Error):
+            self._version = None
+            return []
+        if self._version is not None and version == self._version:
+            return []
+        self._version = version
+        self.index_loads += 1
+
+        def read(conn: sqlite3.Connection) -> list[_Found]:
+            found: list[_Found] = []
+            for conv in conversations_in(conn):
+                if not conv.session_id:
+                    continue
+                since = self._seen.get(conv.session_key, self._floor)
+                for row in conn.execute(_NEW_ROWS, (conv.session_id, since)).fetchall():
+                    text = message_text(decode_content(row[2]))
+                    if text and str(row[1]) in TEXT_ROLES:
+                        found.append(
+                            _Found(int(row[0]), conv.session_key, str(row[1]), text, row[3])
+                        )
+                newest = conn.execute(
+                    "SELECT COALESCE(MAX(id), 0) FROM messages WHERE session_id = ? AND id > ?",
+                    (conv.session_id, since),
+                ).fetchone()[0]
+                self._seen[conv.session_key] = max(since, int(newest))
+            found.sort(key=lambda f: f.row_id)
+            return found
+
+        try:
+            return self.reader.read(read)
+        except (StoreUnavailable, sqlite3.Error):
+            self._version = None  # read again in full on the next tick
+            return []
+
+    # -- the loop side ----------------------------------------------------------------------------
+
+    async def tick(self) -> int:
+        """One poll of the store; how many events it queued."""
+        found: list[_Found] = await self._offload(self.scan)
+        for item in found:
+            self.publish(
+                "message",
+                item.session_key,
+                {
+                    "role": item.role,
+                    "content": item.text[:EVENT_CHARS],
+                    "timestamp": iso_time(item.timestamp),
+                    "message_id": str(item.row_id),
+                },
+            )
+        return len(found)
+
+    def publish(self, kind: str, session_key: str, data: Mapping[str, Any]) -> QueueEvent:
+        """Queue one event and wake the waiters."""
+        self._cursor += 1
+        event = QueueEvent(self._cursor, kind, session_key, dict(data))
+        self._queue.append(event)
+        while len(self._queue) > self.queue_limit:
+            self._queue.popleft()
+        self._wake()
+        return event
+
+    def _wake(self) -> None:
+        changed, self._changed = self._changed, asyncio.Event()
+        changed.set()
+
+    @property
+    def cursor(self) -> int:
+        return self._cursor
+
+    def _dropped(self, after: int) -> int:
+        if self._queue:
+            return max(0, self._queue[0].cursor - 1 - after)
+        return max(0, self._cursor - after)
+
+    def _matching(self, after: int, session_key: str | None, limit: int) -> list[QueueEvent]:
+        out: list[QueueEvent] = []
+        for event in self._queue:
+            if event.cursor <= after or (session_key and event.session_key != session_key):
+                continue
+            out.append(event)
+            if len(out) >= limit:
+                break
+        return out
+
+    def poll(self, after: int, session_key: str | None, limit: int) -> dict[str, Any]:
+        events = self._matching(after, session_key, limit)
+        answer: dict[str, Any] = {
+            "events": [e.as_json() for e in events],
+            "next_cursor": events[-1].cursor if events else after,
+        }
+        dropped = self._dropped(after)
+        if dropped:
+            answer["dropped"] = dropped
+        return answer
+
+    async def wait(self, after: int, session_key: str | None, timeout_ms: int) -> dict[str, Any]:
+        deadline = self.clock.monotonic() + timeout_ms / 1000.0
+        while True:
+            changed = self._changed
+            found = self._matching(after, session_key, 1)
+            if found:
+                answer: dict[str, Any] = {"event": found[0].as_json()}
+                dropped = self._dropped(after)
+                if dropped:
+                    answer["dropped"] = dropped
+                return answer
+            remaining = deadline - self.clock.monotonic()
+            if remaining <= 0:
+                return {"event": None, "reason": "timeout"}
+            await self._pause(changed, min(remaining, self.poll_seconds))
+
+    async def _pause(self, changed: asyncio.Event, seconds: float) -> None:
+        sleeper = asyncio.ensure_future(self.clock.sleep(seconds))
+        woken = asyncio.ensure_future(changed.wait())
+        try:
+            await asyncio.wait({sleeper, woken}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            for task in (sleeper, woken):
+                if not task.done():
+                    task.cancel()
+            for task in (sleeper, woken):
+                with contextlib.suppress(asyncio.CancelledError, Exception):
+                    await task
diff --git a/src/indus/mcp_serve/read_tools.py b/src/indus/mcp_serve/read_tools.py
new file mode 100644
index 0000000..65fba85
--- /dev/null
+++ b/src/indus/mcp_serve/read_tools.py
@@ -0,0 +1,489 @@
+"""The read tools of ``indus mcp serve`` (P19-14): conversations, messages, attachments, channels.
+
+Everything here reads the store through the server's one read-only connection (``StoreReader``)
+and works without a running gateway. A conversation is a row of the gateway routing index
+(``gateway_routes``: session key → current session, origin, display name); its messages are the
+live transcript rows of that session in row-id order (R03.14). Each public method returns the
+JSON-ready answer of one tool; problems come back as ``{"error": ...}`` (the server wraps every
+call so nothing raises past it).
+
+``MEDIA:`` paths written in a message are reported only when the media path policy (R06.22) would
+let the gateway send that file; the others are listed under ``refused`` with the reason.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import math
+import sqlite3
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any, Final, cast
+
+from indus.foundation.scope import Scope
+from indus.mcp_serve.store import StoreReader
+from indus.safety.media_policy import MediaPolicy, extract_media
+from indus.state import messages as message_rows
+from indus.state.handoff import is_handoff
+
+__all__ = [
+    "CONTENT_CHARS",
+    "DEFAULT_LIMIT",
+    "MAX_LIMIT",
+    "Channel",
+    "Conversation",
+    "ReadTools",
+    "attachments_of",
+    "coerce_int",
+    "directory_path",
+    "iso_time",
+    "load_directory",
+    "message_text",
+]
+
+DEFAULT_LIMIT: Final = 50
+MAX_LIMIT: Final = 200
+CONTENT_CHARS: Final = 2000
+TEXT_ROLES: Final = frozenset({"user", "assistant"})
+
+_ROUTE_COLUMNS: Final = (
+    "session_key, session_id, platform, chat_type, origin_json, display_name, "
+    "created_at, updated_at"
+)
+
+
+def coerce_int(value: object, *, default: int, low: int, high: int) -> int:
+    """``value`` as an integer clamped to ``[low, high]``; anything that is not a number (a
+    boolean, a word, null) gives ``default``."""
+    number: int = default
+    if isinstance(value, bool) or value is None:
+        pass
+    elif isinstance(value, int):
+        number = value
+    elif isinstance(value, float):
+        number = _whole(value, default)
+    elif isinstance(value, str):
+        try:
+            number = int(value.strip())
+        except ValueError:
+            with contextlib.suppress(ValueError):
+                number = _whole(float(value.strip()), default)
+    return max(low, min(number, high))
+
+
+def _whole(value: float, default: int) -> int:
+    return int(value) if math.isfinite(value) else default
+
+
+def iso_time(value: object) -> str:
+    """A stored epoch time as ISO-8601 UTC, or ``""``."""
+    if isinstance(value, bool) or not isinstance(value, int | float) or value <= 0:
+        return ""
+    try:
+        return datetime.fromtimestamp(float(value), UTC).isoformat()
+    except (OverflowError, OSError, ValueError):
+        return ""
+
+
+def _text_of(value: object) -> str:
+    return value if isinstance(value, str) else ""
+
+
+def message_text(content: object) -> str:
+    """The text of a decoded message content: the string, or the ``text`` parts joined."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts: list[str] = []
+        for part in cast(list[object], content):
+            if isinstance(part, Mapping):
+                item = cast(Mapping[str, Any], part)
+                if item.get("type") == "text":
+                    parts.append(_text_of(item.get("text")))
+        return "\n".join(p for p in parts if p)
+    return ""
+
+
+# -- the routing index --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Conversation:
+    session_key: str
+    session_id: str
+    platform: str
+    chat_type: str
+    origin: dict[str, Any]
+    display_name: str
+    created_at: float
+    updated_at: float
+
+    @property
+    def chat_name(self) -> str:
+        return str(self.origin.get("chat_name") or "")
+
+    @property
+    def user_name(self) -> str:
+        return str(self.origin.get("user_name") or "")
+
+    @property
+    def chat_id(self) -> str:
+        return str(self.origin.get("chat_id") or "")
+
+    @property
+    def thread_id(self) -> str | None:
+        thread = self.origin.get("thread_id")
+        return str(thread) if thread not in (None, "") else None
+
+    def summary(self) -> dict[str, Any]:
+        return {
+            "session_key": self.session_key,
+            "session_id": self.session_id,
+            "platform": self.platform,
+            "chat_type": self.chat_type,
+            "display_name": self.display_name,
+            "chat_name": self.chat_name,
+            "user_name": self.user_name,
+            "updated_at": iso_time(self.updated_at),
+        }
+
+
+def _origin(raw: object) -> dict[str, Any]:
+    if not isinstance(raw, str) or not raw:
+        return {}
+    try:
+        value = json.loads(raw)
+    except ValueError:
+        return {}
+    if not isinstance(value, dict):
+        return {}
+    return {str(k): v for k, v in cast(dict[object, Any], value).items()}
+
+
+def _conversation(row: Sequence[Any]) -> Conversation:
+    origin = _origin(row[4])
+    platform = str(row[2] or origin.get("platform") or "")
+    chat_type = str(row[3] or origin.get("chat_type") or "")
+    display = str(row[5] or origin.get("chat_name") or origin.get("user_name") or "")
+    return Conversation(
+        session_key=str(row[0]),
+        session_id=str(row[1] or ""),
+        platform=platform,
+        chat_type=chat_type,
+        origin=origin,
+        display_name=display,
+        created_at=float(row[6] or 0.0),
+        updated_at=float(row[7] or 0.0),
+    )
+
+
+def conversations_in(conn: sqlite3.Connection) -> list[Conversation]:
+    rows = conn.execute(f"SELECT {_ROUTE_COLUMNS} FROM gateway_routes ORDER BY session_key")
+    return [_conversation(tuple(row)) for row in rows.fetchall()]
+
+
+def conversation_in(conn: sqlite3.Connection, session_key: str) -> Conversation | None:
+    row = conn.execute(
+        f"SELECT {_ROUTE_COLUMNS} FROM gateway_routes WHERE session_key = ?", (session_key,)
+    ).fetchone()
+    return None if row is None else _conversation(tuple(row))
+
+
+# -- the channel directory ----------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Channel:
+    platform: str
+    chat_id: str
+    name: str
+    chat_type: str
+    guild: str = ""
+    thread_id: str | None = None
+
+    @property
+    def target(self) -> str:
+        base = f"{self.platform}:{self.chat_id}"
+        return base if self.thread_id is None else f"{base}:{self.thread_id}"
+
+    def as_json(self) -> dict[str, Any]:
+        return {
+            "target": self.target,
+            "platform": self.platform,
+            "name": self.name,
+            "chat_type": self.chat_type,
+        }
+
+
+def directory_path(scope: Scope) -> Path:
+    """Where the gateway saves its channel directory (P15-20)."""
+    return scope.home / "gateway" / "channel_directory.json"
+
+
+def load_directory(scope: Scope) -> dict[str, list[Channel]]:
+    """The saved channel directory by platform; missing or unreadable → empty."""
+    try:
+        raw: object = json.loads(directory_path(scope).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    if not isinstance(raw, Mapping):
+        return {}
+    listed = cast(Mapping[str, Any], raw).get("platforms")
+    if not isinstance(listed, Mapping):
+        return {}
+    out: dict[str, list[Channel]] = {}
+    for name, items in cast(Mapping[str, Any], listed).items():
+        if not isinstance(items, list):
+            continue
+        platform = str(name).strip().lower()
+        found: list[Channel] = []
+        for item in cast(list[object], items):
+            if not isinstance(item, Mapping):
+                continue
+            entry = cast(Mapping[str, Any], item)
+            chat_id = str(entry.get("id") or "").strip()
+            if not chat_id:
+                continue
+            thread = entry.get("thread_id")
+            found.append(
+                Channel(
+                    platform=platform,
+                    chat_id=chat_id,
+                    name=str(entry.get("name") or chat_id),
+                    chat_type=str(entry.get("type") or "channel"),
+                    guild=str(entry.get("guild") or ""),
+                    thread_id=str(thread) if thread else None,
+                )
+            )
+        if found:
+            out[platform] = found
+    return out
+
+
+def channels_from(conversations: Sequence[Conversation]) -> list[Channel]:
+    """Send targets the routing index has seen: one per chat (and thread)."""
+    seen: set[tuple[str, str, str | None]] = set()
+    out: list[Channel] = []
+    for conv in conversations:
+        chat_id = conv.chat_id
+        if not conv.platform or not chat_id:
+            continue
+        key = (conv.platform, chat_id, conv.thread_id)
+        if key in seen:
+            continue
+        seen.add(key)
+        out.append(
+            Channel(
+                platform=conv.platform,
+                chat_id=chat_id,
+                name=conv.display_name or conv.chat_name or conv.user_name or chat_id,
+                chat_type=conv.chat_type or "dm",
+                thread_id=conv.thread_id,
+            )
+        )
+    return out
+
+
+# -- attachments --------------------------------------------------------------------------------
+
+
+def _image_part(item: Mapping[str, Any]) -> str:
+    if item.get("type") == "image_url":
+        inner = item.get("image_url")
+        if isinstance(inner, Mapping):
+            return _text_of(cast(Mapping[str, Any], inner).get("url"))
+        return _text_of(inner)
+    url = _text_of(item.get("url"))
+    if url:
+        return url
+    source = item.get("source")
+    if isinstance(source, Mapping):
+        return _text_of(cast(Mapping[str, Any], source).get("url"))
+    return ""
+
+
+def _image(url: str) -> dict[str, Any]:
+    if url.startswith("data:"):
+        head = url[5:].split(",", 1)[0]
+        return {
+            "type": "image",
+            "inline": True,
+            "media_type": head.split(";", 1)[0] or "application/octet-stream",
+            "bytes": len(url),
+        }
+    return {"type": "image", "url": url}
+
+
+def attachments_of(
+    content: object, policy: MediaPolicy
+) -> tuple[list[dict[str, Any]], list[dict[str, str]]]:
+    """``(attachments, refused)`` of one decoded message content (see the module notes)."""
+    found: list[dict[str, Any]] = []
+    refused: list[dict[str, str]] = []
+    if isinstance(content, list):
+        for part in cast(list[object], content):
+            if not isinstance(part, Mapping):
+                continue
+            item = cast(Mapping[str, Any], part)
+            kind = str(item.get("type") or "")
+            if kind in ("image_url", "image"):
+                url = _image_part(item)
+                if url:
+                    found.append(_image(url))
+            elif kind and kind != "text":
+                found.append({"type": kind, "data": dict(item)})
+    _rest, refs = extract_media(message_text(content))
+    for ref in refs:
+        if ref.is_url:
+            found.append({"type": "image", "url": ref.raw})
+            continue
+        verdict = policy.check(ref.raw)
+        if verdict.path is not None:
+            found.append({"type": "media", "path": verdict.path, "kind": ref.kind})
+        else:
+            refused.append({"path": ref.raw, "reason": verdict.reason})
+    return found, refused
+
+
+# -- the tools ----------------------------------------------------------------------------------
+
+
+def _not_found(session_key: str) -> dict[str, Any]:
+    return {"error": f"conversation not found: {session_key}"}
+
+
+class ReadTools:
+    """The read tools over one ``StoreReader`` (see the module notes)."""
+
+    def __init__(self, scope: Scope, reader: StoreReader) -> None:
+        self.scope = scope
+        self.reader = reader
+
+    def conversations(self) -> list[Conversation]:
+        return self.reader.read(conversations_in)
+
+    def conversation(self, session_key: str) -> Conversation | None:
+        return self.reader.read(lambda conn: conversation_in(conn, session_key))
+
+    def conversations_list(
+        self, platform: str | None = None, limit: object = DEFAULT_LIMIT, search: str | None = None
+    ) -> dict[str, Any]:
+        count = coerce_int(limit, default=DEFAULT_LIMIT, low=1, high=MAX_LIMIT)
+        wanted = (platform or "").strip().lower()
+        needle = (search or "").strip().lower()
+        rows: list[Conversation] = []
+        for conv in self.conversations():
+            if wanted and conv.platform.lower() != wanted:
+                continue
+            if needle and not any(
+                needle in text.lower()
+                for text in (conv.display_name, conv.chat_name, conv.session_key)
+            ):
+                continue
+            rows.append(conv)
+        rows.sort(key=lambda c: (c.updated_at, c.session_key), reverse=True)
+        picked = [conv.summary() for conv in rows[:count]]
+        return {"count": len(picked), "conversations": picked}
+
+    def conversation_get(self, session_key: str) -> dict[str, Any]:
+        def read(conn: sqlite3.Connection) -> dict[str, Any]:
+            conv = conversation_in(conn, session_key)
+            if conv is None:
+                return _not_found(session_key)
+            row = conn.execute(
+                "SELECT input_tokens, output_tokens FROM sessions WHERE id = ?",
+                (conv.session_id,),
+            ).fetchone()
+            tokens_in = int(row[0] or 0) if row is not None else 0
+            tokens_out = int(row[1] or 0) if row is not None else 0
+            return {
+                **conv.summary(),
+                "chat_id": conv.chat_id,
+                "thread_id": conv.thread_id,
+                "created_at": iso_time(conv.created_at),
+                "input_tokens": tokens_in,
+                "output_tokens": tokens_out,
+                "total_tokens": tokens_in + tokens_out,
+            }
+
+        return self.reader.read(read)
+
+    def _transcript(
+        self, session_key: str
+    ) -> tuple[Conversation, list[dict[str, Any]]] | dict[str, Any]:
+        def read(
+            conn: sqlite3.Connection,
+        ) -> tuple[Conversation, list[dict[str, Any]]] | dict[str, Any]:
+            conv = conversation_in(conn, session_key)
+            if conv is None:
+                return _not_found(session_key)
+            if not conv.session_id:
+                return {"error": f"conversation {session_key} has no session yet"}
+            return conv, message_rows.get_in(conn, conv.session_id)
+
+        return self.reader.read(read)
+
+    def messages_read(self, session_key: str, limit: object = DEFAULT_LIMIT) -> dict[str, Any]:
+        count = coerce_int(limit, default=DEFAULT_LIMIT, low=1, high=MAX_LIMIT)
+        found = self._transcript(session_key)
+        if isinstance(found, dict):
+            return found
+        _conv, rows = found
+        shown: list[dict[str, Any]] = []
+        for row in rows:
+            role = str(row.get("role") or "")
+            if role not in TEXT_ROLES or is_handoff(row):
+                continue
+            text = message_text(row.get("content"))
+            if not text:
+                continue
+            shown.append(
+                {
+                    "id": str(row.get("id")),
+                    "role": role,
+                    "content": text[:CONTENT_CHARS],
+                    "timestamp": iso_time(row.get("timestamp")),
+                }
+            )
+        last = shown[-count:]
+        return {
+            "session_key": session_key,
+            "count": len(last),
+            "total_in_session": len(shown),
+            "messages": last,
+        }
+
+    def attachments_fetch(self, session_key: str, message_id: str) -> dict[str, Any]:
+        found = self._transcript(session_key)
+        if isinstance(found, dict):
+            return found
+        _conv, rows = found
+        wanted = str(message_id).strip()
+        row = next((r for r in rows if str(r.get("id")) == wanted), None)
+        if row is None:
+            return {"error": f"message not found: {message_id}"}
+        attachments, refused = attachments_of(row.get("content"), MediaPolicy.for_scope(self.scope))
+        answer: dict[str, Any] = {
+            "message_id": wanted,
+            "count": len(attachments),
+            "attachments": attachments,
+        }
+        if refused:
+            answer["refused"] = refused
+        return answer
+
+    def channels(self, platform: str | None = None) -> list[Channel]:
+        wanted = (platform or "").strip().lower()
+        directory = load_directory(self.scope)
+        if directory:
+            listed = [c for name, items in sorted(directory.items()) for c in items]
+        else:
+            listed = channels_from(self.conversations())
+        return [c for c in listed if not wanted or c.platform == wanted]
+
+    def channels_list(self, platform: str | None = None) -> dict[str, Any]:
+        rows = [c.as_json() for c in self.channels(platform)]
+        return {"count": len(rows), "channels": rows}
diff --git a/src/indus/mcp_serve/send.py b/src/indus/mcp_serve/send.py
new file mode 100644
index 0000000..57b2370
--- /dev/null
+++ b/src/indus/mcp_serve/send.py
@@ -0,0 +1,123 @@
+"""``messages_send`` of ``indus mcp serve`` (P19-16): one text to one chat, through the daemon.
+
+The MCP server holds no platform connection. ``Sender.send(target, message)`` works out where the
+text goes and asks the profile's running daemon (control socket, owner-only ``deliver-message``
+verb, ``indus.service.messaging_bridge``); the daemon sends it through its delivery router and the
+platform's outbound sender, which records the delivery-ledger row before the platform call. It is
+a library for the bridge, never a tool offered to the model (D-16.37).
+
+Targets: ``platform:chat_id`` (``:thread_id`` optional, in the platform's own address grammar) or
+``platform:<friendly name>``. A friendly name is looked up in the gateway's saved channel
+directory: an exact chat id, then the name without ``#`` and case, then ``guild/name``, then a name
+only one chat starts with. Several chats matching is an error that lists them; no match sends the
+text after the platform as written, and the daemon decides (an unknown ``#name`` is its
+``unknown_channel``). A bare platform (home channel), ``all`` and ``origin`` are refused: the bridge
+sends to one named chat.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Callable
+from typing import Any, Final
+
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.mcp_serve.read_tools import Channel, load_directory
+from indus.service import messaging_bridge as bridge
+from indus.service.gateway_control import ControlReply
+
+__all__ = ["NO_DAEMON", "Sender", "resolve_name"]
+
+log = logging.getLogger(__name__)
+
+NO_DAEMON: Final = "daemon not running"
+_RESERVED: Final = frozenset({"all", "origin", "local"})
+_LOCAL_ERRORS: Final = frozenset({"no_socket", "unreachable", "timeout"})
+
+type Deliver = Callable[..., ControlReply]
+
+
+def _norm(name: str) -> str:
+    return name.strip().lstrip("#").strip().lower()
+
+
+def resolve_name(entries: list[Channel], query: str) -> list[Channel]:
+    """The directory chats ``query`` names: one, several (ambiguous) or none (see the notes)."""
+    raw = query.strip()
+    if not raw:
+        return []
+    exact = [e for e in entries if e.chat_id == raw]
+    if exact:
+        return exact[:1]
+    wanted = _norm(raw)
+    named = [e for e in entries if _norm(e.name) == wanted]
+    if named:
+        return named
+    if "/" in wanted:
+        guild, _, name = wanted.rpartition("/")
+        in_guild = [
+            e for e in entries if e.guild.strip().lower() == guild and _norm(e.name) == name
+        ]
+        if in_guild:
+            return in_guild
+    return [e for e in entries if wanted and _norm(e.name).startswith(wanted)]
+
+
+def daemon_error(reply: ControlReply) -> dict[str, Any]:
+    """The ``error`` answer for a control reply that did not go through."""
+    if reply.error in _LOCAL_ERRORS:
+        return {"error": NO_DAEMON}
+    if reply.error == "unsafe_home":
+        return {"error": "the profile folder is writable by others; the daemon is not asked"}
+    if reply.error in ("unknown_verb", "unsupported"):
+        return {"error": "the running daemon does not offer this (update and restart it)"}
+    detail = redact_text(reply.detail) if reply.detail else ""
+    return {"error": f"{reply.error}: {detail}" if detail else str(reply.error)}
+
+
+class Sender:
+    """See the module notes."""
+
+    def __init__(self, scope: Scope, *, deliver: Deliver = bridge.deliver) -> None:
+        self.scope = scope
+        self._deliver = deliver
+
+    def send(self, target: object, message: object) -> dict[str, Any]:
+        """Blocking (a socket exchange): call it off the loop."""
+        text = message if isinstance(message, str) else ""
+        where = target.strip() if isinstance(target, str) else ""
+        if not where or not text.strip():
+            return {"error": "both target and message are required"}
+        if len(text) > bridge.MAX_MESSAGE_CHARS:
+            return {"error": f"the message is longer than {bridge.MAX_MESSAGE_CHARS} characters"}
+        platform, sep, rest = where.partition(":")
+        platform = platform.strip().lower()
+        if not platform or platform in _RESERVED or not sep or not rest.strip():
+            return {
+                "error": "the target must name one chat: platform:chat_id or platform:<chat name>"
+            }
+        entries = load_directory(self.scope).get(platform, [])
+        matches = resolve_name(entries, rest)
+        if len(matches) > 1:
+            return {
+                "error": f"{rest.strip()!r} matches more than one {platform} chat; use one target",
+                "candidates": [f"{c.target} ({c.name})" for c in matches],
+            }
+        if matches:
+            chat = matches[0]
+            reply = self._deliver(
+                self.scope.home,
+                text,
+                platform=chat.platform,
+                chat_id=chat.chat_id,
+                thread_id=chat.thread_id,
+            )
+        else:
+            reply = self._deliver(self.scope.home, text, target=f"{platform}:{rest.strip()}")
+        if not reply.ok or reply.result is None:
+            return daemon_error(reply)
+        result = dict(reply.result)
+        if not result.get("sent"):
+            return {**result, "error": str(result.get("error") or "the message was not sent")}
+        return {"target": where, **result}
diff --git a/src/indus/mcp_serve/server.py b/src/indus/mcp_serve/server.py
