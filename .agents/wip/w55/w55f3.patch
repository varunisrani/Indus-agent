+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { ThemeProvider } from "../app/theme.tsx";
+import { ChatView } from "../chat/ChatView.tsx";
+import type { ToolPart } from "../chat/messageStream.ts";
