+    "publish_record",
+    "read_record",
+    "record_alive",
+]
+
+log = logging.getLogger(__name__)
+
+HOST_PROTOCOL: Final = 1
+LOCK_FILE: Final = "gateway-host.lock"
+RECORD_FILE: Final = "gateway-host.json"
+ATTACH_WAIT_S: Final = 5.0
+"""How long a second run waits for the owner's ``identify`` after seeing its record."""
+VERB_BUDGET_S: Final = 5.0
+"""The serve/unserve/rescan answer bound; the work goes on past it (``pending``)."""
+SERVE_TIMEOUT_S: Final = 8.0
+"""Client timeout for the serve verbs: the budget plus room for the answer."""
+EXIT_REFUSED_SHELL: Final = 1
+PROFILE_VERBS: Final = ("serve-profile", "unserve-profile", "rescan-profiles")
+_POLL_S = 0.25
+_SYSTEM = SystemClock()
+
+
+class HostStateError(OSError):
+    """The host state directory cannot be used (not ours, not a directory)."""
+
+
+# -- the state directory --------------------------------------------------------------------------
+
+
+def host_state_dir(env: Mapping[str, str]) -> Path:
+    """``$XDG_STATE_HOME/indus`` when that is an absolute path, else ``$HOME/.local/state/indus``
+    (read from the launch profile's env view, never the process env)."""
+    state = env.get("XDG_STATE_HOME", "").strip()
+    if state and os.path.isabs(state):
+        return Path(state) / "indus"
+    user_home = env.get("HOME", "").strip()
+    base = Path(user_home) if user_home and os.path.isabs(user_home) else Path.home()
+    return base / ".local" / "state" / "indus"
+
+
+def ensure_state_dir(directory: Path) -> Path:
+    """Create ``directory`` owner-only, tighten it when wider, refuse one we do not own."""
+    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
+    info = directory.lstat()
+    if not stat.S_ISDIR(info.st_mode):
+        raise HostStateError(f"{directory} is not a directory")
+    if info.st_uid != os.getuid():
+        raise HostStateError(f"{directory} belongs to another user")
+    if stat.S_IMODE(info.st_mode) & 0o077:
+        os.chmod(directory, 0o700)
+    return directory
+
+
+# -- the lock -------------------------------------------------------------------------------------
+
+
+class HostLock:
+    """The per-user host ``flock`` (see the module notes). Not inherited by children."""
+
+    def __init__(self, directory: Path) -> None:
+        self.directory = directory
+        self.path = directory / LOCK_FILE
+        self._fd: int | None = None
+
+    @property
+    def held(self) -> bool:
+        return self._fd is not None
+
+    def try_acquire(self) -> bool:
+        """Take the lock without waiting; True when it is ours."""
+        if self._fd is not None:
+            return True
+        ensure_state_dir(self.directory)
+        fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            os.close(fd)
+            return False
+        self._fd = fd
+        return True
+
+    def release(self) -> None:
+        fd, self._fd = self._fd, None
+        if fd is None:
+            return
+        with contextlib.suppress(OSError):
+            fcntl.flock(fd, fcntl.LOCK_UN)
+        with contextlib.suppress(OSError):
+            os.close(fd)
+
+    def observed_free(self) -> bool | None:
+        """Does nobody hold the lock? None when it cannot be probed. Never keeps the lock and
+        never creates the file (a missing lock file means nobody holds it)."""
+        if self._fd is not None:
+            return False
+        try:
+            fd = os.open(self.path, os.O_RDWR)
+        except FileNotFoundError:
+            return True
+        except OSError:
+            return None
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError as exc:
+            return False if exc.errno in (errno.EWOULDBLOCK, errno.EAGAIN, errno.EACCES) else None
+        else:
+            with contextlib.suppress(OSError):
+                fcntl.flock(fd, fcntl.LOCK_UN)
+            return True
+        finally:
+            with contextlib.suppress(OSError):
+                os.close(fd)
+
+
+# -- the record -----------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class HostRecord:
+    """The published owner. ``served_profiles`` is what it serves, launch profile first."""
+
+    pid: int
+    start_time: int | None
+    root: str
+    home: str
+    served_profiles: tuple[str, ...] = ()
+    updated_at: str = ""
+    protocol: int = HOST_PROTOCOL
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "protocol": self.protocol,
+            "pid": self.pid,
+            "start_time": self.start_time,
+            "root": self.root,
+            "home": self.home,
+            "served_profiles": list(self.served_profiles),
+            "updated_at": self.updated_at,
+        }
+
+    @classmethod
+    def from_json(cls, data: object) -> HostRecord | None:
+        if not isinstance(data, dict):
+            return None
+        raw = cast(dict[str, Any], data)
+        pid, start, protocol = raw.get("pid"), raw.get("start_time"), raw.get("protocol")
+        if not isinstance(pid, int) or isinstance(pid, bool) or pid < 1:
+            return None
+        if not isinstance(protocol, int) or isinstance(protocol, bool):
+            return None
+        if start is not None and (not isinstance(start, int) or isinstance(start, bool)):
+            return None
+        root, home = raw.get("root"), raw.get("home")
+        if not isinstance(root, str) or not root or not isinstance(home, str) or not home:
+            return None
+        served_raw: object = raw.get("served_profiles")
+        served: tuple[str, ...] = ()
+        if isinstance(served_raw, list):
+            items = cast(list[object], served_raw)
+            served = tuple(p for p in items if isinstance(p, str) and p)
+        updated = raw.get("updated_at")
+        return cls(
+            pid=pid,
+            start_time=start,
+            root=root,
+            home=home,
+            served_profiles=served,
+            updated_at=updated if isinstance(updated, str) else "",
+            protocol=protocol,
+        )
+
+
+def _record_path(directory: Path) -> Path:
+    return directory / RECORD_FILE
+
+
+def publish_record(directory: Path, record: HostRecord) -> None:
+    """Write ``record`` atomically, 0600, into the (owner-only) state directory."""
+    ensure_state_dir(directory)
+    text = json.dumps(record.to_json(), sort_keys=True)
+    atomic_write_text(_record_path(directory), text + "\n", mode=0o600)
+
+
+def _ours(path: Path) -> bool:
+    """The file and its directory belong to this user, and the file is a plain file."""
+    try:
+        info = path.lstat()
+        parent = path.parent.lstat()
+    except OSError:
+        return False
+    uid = os.getuid()
+    if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or parent.st_uid != uid:
+        if stat.S_ISREG(info.st_mode):
+            log.warning("ignoring the host record %s: it is not owned by this user", path)
+        return False
+    return True
+
+
+def read_record(directory: Path) -> HostRecord | None:
+    """The published record; None when absent, foreign, unreadable or malformed."""
+    path = _record_path(directory)
+    if not _ours(path):
+        return None
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, ValueError):
+        return None
+    return HostRecord.from_json(data)
+
+
+def clear_record(directory: Path, pid: int | None = None) -> bool:
+    """Remove the record when it names ``pid`` (default: this process); never another owner's."""
+    record = read_record(directory)
+    if record is None or record.pid != (os.getpid() if pid is None else pid):
+        return False
+    with contextlib.suppress(OSError):
+        _record_path(directory).unlink()
+    return True
+
+
+def record_alive(
+    record: HostRecord,
+    lock: HostLock,
+    *,
+    probes: Mapping[str, Any] | None = None,
+) -> bool | None:
+    """Does ``record`` name a live owner? False when stale; None when it cannot be proven either
+    way (no start time recorded) while the lock is held."""
+    if record.protocol != HOST_PROTOCOL:
+        return False
+    if lock.observed_free() is True:
+        return False
+    alive = ProcessIdentity(record.pid, record.start_time).is_alive(**dict(probes or {}))
+    if not alive:
+        return False
+    return True if record.start_time is not None else None
+
+
+# -- the second run -------------------------------------------------------------------------------
+
+
+type Outcome = Literal["start", "attach", "refuse"]
+
+
+@dataclass(frozen=True)
+class RunVerdict:
+    """What a ``gateway run`` does about an existing host. ``exit_code`` None = start."""
+
+    outcome: Outcome
+    exit_code: int | None = None
+    message: str = ""
+    transient: bool = False
+    owner_pid: int | None = None
+
+
+type Identify = Callable[[Path, float], Mapping[str, Any] | None]
+type Serve = Callable[[Path, str, float], wire.ControlReply]
+
+
+def _identify(home: Path, timeout: float) -> Mapping[str, Any] | None:
+    return wire.identify(home, timeout=timeout)
+
+
+def _serve(home: Path, profile: str, timeout: float) -> wire.ControlReply:
+    return wire.query(home, "serve-profile", {"name": profile}, timeout=timeout)
+
+
+def _is_owner(answer: Mapping[str, Any], record: HostRecord) -> bool:
+    """The answer comes from the record's process: same pid and, when it names one, the same
+    launch home (a record naming some other home must not make us trust whoever answers there)."""
+    if answer.get("pid") != record.pid:
+        return False
+    home = answer.get("home")
+    if not isinstance(home, str) or not home:
+        return True
+    try:
+        return Path(home).resolve(strict=False) == Path(record.home).resolve(strict=False)
+    except OSError:
+        return home == record.home
+
+
+def _served_from(answer: Mapping[str, Any]) -> list[str]:
+    raw: object = answer.get("served_profiles")
+    if isinstance(raw, list):
+        return [p for p in cast(list[object], raw) if isinstance(p, str)]
+    profile = answer.get("profile")
+    return [profile] if isinstance(profile, str) and profile else []
+
+
+def decide_second_run(
+    profile: str,
+    *,
+    root: Path,
+    record_dir: Path,
+    env: Mapping[str, str],
+    identify: Identify = _identify,
+    serve: Serve = _serve,
+    wait: float = ATTACH_WAIT_S,
+    sleep: Callable[[float], None] = _SYSTEM.sleep_sync,
+    monotonic: Callable[[], float] = _SYSTEM.monotonic,
+    probes: Mapping[str, Any] | None = None,
+) -> RunVerdict:
+    """Attach, start or refuse (see the module notes). Never raises."""
+    try:
+        wanted = normalize_id(profile)
+    except InvalidProfileId:
+        wanted = profile
+    supervised_run = supervised(env)
+    attach_code = EXIT_RESTART if supervised_run else EXIT_OK
+    refuse_code = EXIT_CONFIG if supervised_run else EXIT_REFUSED_SHELL
+    lock = HostLock(record_dir)
+    try:
+        record = read_record(record_dir)
+        held = lock.observed_free() is False
+        if record is None:
+            if held:
+                return RunVerdict(
+                    "refuse",
+                    EXIT_RESTART,
+                    "a gateway holds this user's host lock but has not published its record "
+                    "yet; nothing was started (a supervisor retries)",
+                    transient=True,
+                )
+            return RunVerdict("start")
+        if record_alive(record, lock, probes=probes) is False:
+            log.info("the host record names pid %d, which is gone; starting", record.pid)
+            return RunVerdict("start")
+        if Path(record.root) != root:
+            return RunVerdict(
+                "refuse",
+                refuse_code,
+                f"a gateway for another Indus root ({record.root}) owns this user's host lock "
+                f"(pid {record.pid}); it cannot serve profile '{wanted}' of this root",
+                owner_pid=record.pid,
+            )
+        owner_home = Path(record.home)
+        answer: Mapping[str, Any] | None = None
+        deadline = monotonic() + max(0.0, wait)
+        while True:
+            found = identify(owner_home, wire.DEFAULT_TIMEOUT_S)
+            if found is not None and _is_owner(found, record):
+                answer = found
+                break
+            if monotonic() >= deadline:
+                break
+            sleep(_POLL_S)
+        if answer is None:
+            return RunVerdict(
+                "refuse",
+                EXIT_RESTART,
+                f"a gateway (pid {record.pid}) owns this user's host but its control socket did "
+                f"not answer; whether it serves profile '{wanted}' is unknown, so nothing was "
+                "started (a supervisor retries)",
+                transient=True,
+                owner_pid=record.pid,
+            )
+        if wanted in _served_from(answer):
+            return _attached(record.pid, wanted, attach_code)
+        reply = serve(owner_home, wanted, SERVE_TIMEOUT_S)
+        if reply.ok and reply.result is not None and wanted in _served_from(reply.result):
+            return _attached(record.pid, wanted, attach_code)
+        if (reply.ok and reply.result is not None and reply.result.get("pending")) or (
+            not reply.answered
+        ):
+            return RunVerdict(
+                "refuse",
+                EXIT_RESTART,
+                f"the host gateway (pid {record.pid}) is still taking on profile '{wanted}'; "
+                "nothing was started (a supervisor retries)",
+                transient=True,
+                owner_pid=record.pid,
+            )
+        why = reply.detail or reply.error or "refused"
+        return RunVerdict(
+            "refuse",
+            refuse_code,
+            f"the host gateway (pid {record.pid}) will not serve profile '{wanted}': {why}",
+            owner_pid=record.pid,
+        )
+    except Exception as exc:
+        log.warning("the host gateway check failed (%s); starting", type(exc).__name__)
+        return RunVerdict("start")
+
+
+def _attached(pid: int, profile: str, code: int) -> RunVerdict:
+    return RunVerdict(
+        "attach",
+        code,
+        f"the host gateway (pid {pid}) already serves profile '{profile}'; nothing to start",
+        transient=True,
+        owner_pid=pid,
+    )
+
+
+# -- serving --------------------------------------------------------------------------------------
+
+
+class ServeRefused(Exception):
+    """A serve/unserve request that cannot be applied; ``code`` goes on the control wire."""
+
+    def __init__(self, code: str, detail: str = "") -> None:
+        super().__init__(detail or code)
+        self.code = code
+        self.detail = detail
+
+
+type ProfileHook = Callable[[str, Path], Awaitable[object]]
+type VerbHandler = Callable[[dict[str, Any]], Awaitable[Mapping[str, Any]]]
+"""A profile verb handler (always async); it fits ``control_socket.Handler``."""
+
+
+async def _no_hook(_name: str, _home: Path) -> None:
+    return None
+
+
+@dataclass
+class _Work:
+    tasks: set[asyncio.Task[Any]] = field(default_factory=set[asyncio.Task[Any]])
+
+
+class MultiplexHost:
+    """The served-profile set of the one host gateway (see the module notes)."""
+
+    def __init__(
+        self,
+        launch: Scope,
+        *,
+        record_dir: Path | None = None,
+        clock: Clock | None = None,
+        on_serve: ProfileHook = _no_hook,
+        on_unserve: ProfileHook = _no_hook,
+        budget: float = VERB_BUDGET_S,
+    ) -> None:
+        self.launch = launch
+        self.root = launch.root
+        self.launch_profile = launch.profile_id
+        self.record_dir = record_dir if record_dir is not None else host_state_dir(launch.env)
+        self.clock: Clock = clock if clock is not None else launch.clock
+        self.on_serve = on_serve
+        self.on_unserve = on_unserve
+        self.budget = budget
+        self.lock = HostLock(self.record_dir)
+        self._served: dict[str, Path] = {self.launch_profile: launch.home}
+        self._mutex: asyncio.Lock | None = None
+        self._work = _Work()
+        self._start_time = process_start_time(os.getpid())
+
+    # -- claim and record ---------------------------------------------------------------------
+
+    def claim(self) -> bool:
+        """Take the host lock and publish the record; False when another process holds it."""
+        if not self.lock.try_acquire():
+            return False
+        self.publish()
+        return True
+
+    def record(self) -> HostRecord:
+        return HostRecord(
+            pid=os.getpid(),
+            start_time=self._start_time,
+            root=str(self.root),
+            home=str(self.launch.home),
+            served_profiles=tuple(self.served_profiles()),
+            updated_at=datetime.now(UTC).isoformat(timespec="seconds"),
+        )
+
+    def publish(self) -> None:
+        if not self.lock.held:
+            return
+        try:
+            publish_record(self.record_dir, self.record())
+        except OSError as exc:
+            log.warning("the host record could not be written: %s", exc)
+
+    def close(self) -> None:
+        """Remove our record and drop the lock (process exit)."""
+        if self.lock.held:
+            clear_record(self.record_dir)
+        self.lock.release()
+
+    # -- the served set -----------------------------------------------------------------------
+
+    def served_profiles(self) -> list[str]:
+        """Served profile ids, the launch profile first."""
+        others = sorted(name for name in self._served if name != self.launch_profile)
+        return [self.launch_profile, *others]
+
+    def serves(self, profile: str) -> bool:
+        return profile in self._served
+
+    def home_of(self, profile: str) -> Path | None:
+        return self._served.get(profile)
+
+    def served_ticket_ids(self) -> frozenset[str]:
+        """The served set as ticket profile ids (``ws_auth.stable_profile_id`` of each home)."""
+        return frozenset(stable_profile_id(home) for home in list(self._served.values()))
+
+    def identify_fields(self) -> dict[str, Any]:
+        """What the owner adds to its ``identify`` answer."""
+        return {
+            "multiplex": True,
+            "root": str(self.root),
+            "served_profiles": self.served_profiles(),
+        }
+
+    def _lock_for_changes(self) -> asyncio.Lock:
+        if self._mutex is None:
+            self._mutex = asyncio.Lock()
+        return self._mutex
+
+    def _answer(self, **fields: Any) -> dict[str, Any]:
+        return {**fields, "served_profiles": self.served_profiles()}
+
+    def _checked(self, name: object) -> str:
+        if not isinstance(name, str) or not name.strip():
+            raise ServeRefused("bad_request", "name the profile")
+        try:
+            return normalize_id(name)
+        except InvalidProfileId:
+            raise ServeRefused("invalid_profile", "not a profile id") from None
+
+    async def serve(self, name: object) -> dict[str, Any]:
+        profile = self._checked(name)
+        async with self._lock_for_changes():
+            if profile in self._served:
+                return self._answer(served=profile, already=True)
+            if not self._live(profile):
+                raise ServeRefused("unknown_profile", f"no live profile '{profile}' in this root")
+            await self._start(profile)
+            self.publish()
+            return self._answer(served=profile)
+
+    async def unserve(self, name: object) -> dict[str, Any]:
+        profile = self._checked(name)
+        if profile == self.launch_profile:
+            raise ServeRefused("launch_profile", "the launch profile is always served")
+        async with self._lock_for_changes():
+            if profile not in self._served:
+                raise ServeRefused("not_served", f"profile '{profile}' is not served")
+            await self._stop(profile)
+            self.publish()
+            return self._answer(unserved=profile)
+
+    async def rescan(self) -> dict[str, Any]:
+        """Serve every live profile not served yet; unserve served ones that are gone."""
+        async with self._lock_for_changes():
+            live = set(await asyncio.to_thread(self._live_profiles))
+            added: list[str] = []
+            failed: list[str] = []
+            removed: list[str] = []
+            for profile in sorted(name for name in self._served if name not in live):
+                if profile == self.launch_profile:
+                    continue
+                await self._stop(profile)
+                removed.append(profile)
+            for profile in sorted(live - set(self._served)):
+                try:
+                    await self._start(profile)
+                except ServeRefused:
+                    failed.append(profile)
+                    continue
+                added.append(profile)
+            if added or removed:
+                self.publish()
+            return self._answer(added=added, removed=removed, failed=failed)
+
+    def _live(self, profile: str) -> bool:
+        if profile == DEFAULT_PROFILE:
+            return True
+        try:
+            return is_live(self.root, profile)
+        except (InvalidProfileId, OSError):
+            return False
+
+    def _live_profiles(self) -> list[str]:
+        return [p for p in list_profiles(self.root) if self._live(p)]
+
+    async def _start(self, profile: str) -> None:
+        home = profile_home(self.root, profile)
+        other = await asyncio.to_thread(live_gateway, home)
+        if other is not None and other.pid != os.getpid():
+            log.warning(
+                "profile %s still runs its own gateway (pid %d); stop it before the host serves it",
+                profile,
+                other.pid,
+            )
+            raise ServeRefused("own_gateway", f"profile '{profile}' runs its own gateway")
+        try:
+            await self.on_serve(profile, home)
+        except Exception as exc:
+            log.error("profile %s could not be served: %s", profile, type(exc).__name__)
+            raise ServeRefused("serve_failed", type(exc).__name__) from exc
+        self._served[profile] = home
+        log.info("now serving profile %s", profile)
+
+    async def _stop(self, profile: str) -> None:
+        home = self._served.pop(profile)
+        try:
+            await self.on_unserve(profile, home)
+        except Exception as exc:
+            log.error("profile %s did not stop cleanly: %s", profile, type(exc).__name__)
+        log.info("stopped serving profile %s", profile)
+
+    # -- control verbs ------------------------------------------------------------------------
+
+    def control_verbs(self) -> dict[str, tuple[VerbHandler, float]]:
+        """``{verb: (handler, socket timeout)}`` for ``ControlServer.register`` (owner-only)."""
+        timeout = self.budget + 3.0
+
+        async def serve_verb(params: dict[str, Any]) -> Mapping[str, Any]:
+            return await self._bounded(lambda: self.serve(params.get("name")))
+
+        async def unserve_verb(params: dict[str, Any]) -> Mapping[str, Any]:
+            return await self._bounded(lambda: self.unserve(params.get("name")))
+
+        async def rescan_verb(params: dict[str, Any]) -> Mapping[str, Any]:
+            return await self._bounded(self.rescan)
+
+        return {
+            "serve-profile": (serve_verb, timeout),
+            "unserve-profile": (unserve_verb, timeout),
+            "rescan-profiles": (rescan_verb, timeout),
+        }
+
+    async def _bounded(self, work: Callable[[], Awaitable[dict[str, Any]]]) -> dict[str, Any]:
+        """Run ``work``; answer it within the budget, else ``pending`` while it goes on."""
+        task: asyncio.Task[dict[str, Any]] = asyncio.ensure_future(work())
+        self._work.tasks.add(task)
+        task.add_done_callback(self._finished)
+        timer: asyncio.Task[None] = asyncio.ensure_future(self.clock.sleep(self.budget))
+        try:
+            await asyncio.wait({task, timer}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            timer.cancel()
+        if not task.done():
+            return self._answer(pending=True)
+        try:
+            return task.result()
+        except ServeRefused as refused:
+            raise VerbRefused(refused.code, refused.detail) from None
+
+    def _finished(self, task: asyncio.Task[Any]) -> None:
+        self._work.tasks.discard(task)
+        if task.cancelled():
+            return
+        exc = task.exception()
+        if exc is not None and not isinstance(exc, ServeRefused):
+            log.warning("a profile change failed: %s", type(exc).__name__)
+
+    async def aclose(self) -> None:
+        """Wait for profile changes still running past their answer, then ``close``."""
+        for task in list(self._work.tasks):
+            with contextlib.suppress(Exception, asyncio.CancelledError):
+                await task
+        self.close()
+
+
+def mint_routed_ticket(
+    book: TicketBook, host: MultiplexHost, profile: str, purpose: str
+) -> MintedTicket:
+    """A ticket bound to ``profile``'s home; ``wrong_profile`` when the host does not serve it."""
+    home = host.home_of(profile)
+    if home is None:
+        raise TicketRefused("wrong_profile", "this gateway does not serve that profile")
+    return book.mint(purpose, profile_id=stable_profile_id(home))
diff --git a/src/indus/gateway/multiplex/ingress.py b/src/indus/gateway/multiplex/ingress.py
new file mode 100644
index 0000000..db3f883
--- /dev/null
+++ b/src/indus/gateway/multiplex/ingress.py
@@ -0,0 +1,157 @@
+"""Shared ingress: secondary profiles' HTTP apps on the default profile's listener (P24-04).
+
+Under multiplexing the default profile owns each HTTP listener (API server, webhook receiver,
+callback adapters). A secondary profile's port-binding app does not bind a port of its own: it is
+mounted on the default listener with ``SharedIngress.mount`` and reached at ``/p/<profile>/<path>``.
+
+A request, in order:
+
+- a path outside ``/p/`` goes to the default profile's app, untouched;
+- ``/p/<profile>/<tail>``: ``<profile>`` must be a profile id in canonical form and not
+  ``default`` (the default profile is served un-prefixed), and one of that profile's mounts must
+  claim ``<tail>`` (a mount claims exact paths, or prefixes written with a trailing ``/``);
+  otherwise the answer is 404 (a WebSocket is closed) — never the default profile's handler;
+- the claiming app gets the request with the prefix taken off ``path`` / ``raw_path`` and added to
+  ``root_path``, the query string kept, and runs inside the mounted profile's ``Scope``.
+
+Each mounted app is built from its own profile's scope, so it checks the request with that
+profile's own API keys or webhook secrets: a request signed for profile B is accepted at
+``/p/b/…`` and refused (by the default profile's own check) at the un-prefixed path.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Final
+
+from indus.foundation.profiles import DEFAULT_PROFILE, ID_PATTERN, RESERVED_IDS
+from indus.foundation.scope import Scope, use_scope
+from indus.gateway.http.serving import Asgi, Receive, Scope_, Send, send_json
+
+__all__ = ["PREFIX", "IngressMount", "SharedIngress", "profile_url"]
+
+log = logging.getLogger(__name__)
+
+PREFIX: Final = "/p/"
+_NOT_FOUND = {"error": "not_found", "detail": "no such profile endpoint"}
+_WS_NOT_FOUND = 4404
+
+
+@dataclass(frozen=True)
+class IngressMount:
+    """One profile app on the shared listener and the paths it claims."""
+
+    profile: str
+    name: str
+    app: Asgi
+    paths: tuple[str, ...]
+    scope: Scope | None = None
+
+    def claims(self, tail: str) -> bool:
+        for path in self.paths:
+            if path.endswith("/"):
+                if tail.startswith(path) or tail == path.rstrip("/"):
+                    return True
+            elif tail == path:
+                return True
+        return False
+
+
+def _profile_segment(segment: str) -> str | None:
+    """The segment when it is a servable secondary profile id, written canonically."""
+    if segment == DEFAULT_PROFILE or segment in RESERVED_IDS:
+        return None
+    return segment if ID_PATTERN.fullmatch(segment) else None
+
+
+def profile_url(base: str, profile: str, path: str = "/") -> str:
+    """Where ``profile``'s ``path`` is reached on the shared listener at ``base``."""
+    return f"{base.rstrip('/')}{PREFIX}{profile}/{path.lstrip('/')}"
+
+
+class SharedIngress:
+    """The ASGI front of one default-profile listener (see the module notes)."""
+
+    def __init__(self, default_app: Asgi) -> None:
+        self.default_app = default_app
+        self._mounts: dict[str, dict[str, IngressMount]] = {}
+
+    def mount(
+        self,
+        profile: str,
+        name: str,
+        app: Asgi,
+        *,
+        paths: Iterable[str],
+        scope: Scope | None = None,
+    ) -> IngressMount:
+        """Serve ``app`` for ``profile`` at ``/p/<profile>/<path>`` for each claimed path."""
+        if _profile_segment(profile) is None:
+            raise ValueError(f"{profile!r} cannot be mounted (default, reserved or not an id)")
+        claimed = tuple(p if p.startswith("/") else f"/{p}" for p in paths)
+        if not claimed:
+            raise ValueError("a mount needs at least one path")
+        found = IngressMount(profile, name, app, claimed, scope)
+        self._mounts.setdefault(profile, {})[name] = found
+        log.info("profile %s: %s mounted at %s%s/", profile, name, PREFIX, profile)
+        return found
+
+    def unmount(self, profile: str, name: str | None = None) -> None:
+        """Remove one app of ``profile`` (``name``) or all of them; new requests get 404."""
+        if name is None:
+            self._mounts.pop(profile, None)
+            return
+        apps = self._mounts.get(profile)
+        if apps is not None:
+            apps.pop(name, None)
+            if not apps:
+                self._mounts.pop(profile, None)
+
+    def mounted(self, profile: str) -> list[str]:
+        return sorted(self._mounts.get(profile, {}))
+
+    def _find(self, profile: str, tail: str) -> IngressMount | None:
+        for found in list(self._mounts.get(profile, {}).values()):
+            if found.claims(tail):
+                return found
+        return None
+
+    async def __call__(self, scope: Scope_, receive: Receive, send: Send) -> None:
+        kind = scope.get("type")
+        path = scope.get("path", "")
+        if kind not in ("http", "websocket") or not isinstance(path, str):
+            await self.default_app(scope, receive, send)
+            return
+        if not (path == PREFIX.rstrip("/") or path.startswith(PREFIX)):
+            await self.default_app(scope, receive, send)
+            return
+        segment, _, rest = path[len(PREFIX) :].partition("/")
+        profile = _profile_segment(segment)
+        tail = "/" + rest
+        found = self._find(profile, tail) if profile is not None else None
+        if found is None:
+            await _not_found(kind, send)
+            return
+        prefix = f"{PREFIX}{segment}"
+        child = dict(scope)
+        child["path"] = tail
+        raw = scope.get("raw_path")
+        if isinstance(raw, bytes) and raw.startswith(prefix.encode()):
+            child["raw_path"] = raw[len(prefix) :] or b"/"
+        elif raw is not None:
+            child["raw_path"] = tail.encode()
+        child["root_path"] = f"{scope.get('root_path', '')}{prefix}"
+        if found.scope is None:
+            await found.app(child, receive, send)
+            return
+        with use_scope(found.scope):
+            await found.app(child, receive, send)
+
+
+async def _not_found(kind: object, send: Send) -> None:
+    if kind == "websocket":
+        await send({"type": "websocket.close", "code": _WS_NOT_FOUND})
+        return
+    await send_json(send, 404, _NOT_FOUND)
diff --git a/src/indus/gateway/multiplex/routes.py b/src/indus/gateway/multiplex/routes.py
new file mode 100644
index 0000000..3e9c873
--- /dev/null
+++ b/src/indus/gateway/multiplex/routes.py
@@ -0,0 +1,521 @@
+"""Profile routes and delivery identity under multiplexing (P24-03).
+
+**Routes** (``gateway.profile_routes``): ``{name, platform, profile, bot?, guild?, chat?, thread?,
+user?, enabled}``. A route matches when every discriminator it names matches (AND). The most
+specific match wins by additive weights — user 16, thread 8, chat 4, guild 2, none 0 — and equal
+weights keep config order. Each route is tied to one receiving bot, named by profile in ``bot``
+(unset or ``default``: the default profile's bot) and is skipped for anything that arrived through
+another bot, so a chat-id route written for the shared bot can never re-home a DM with a
+secondary's own bot. A ``chat`` route also matches threads
+under that chat (the thread's parent id). With no match the receiving bot's own profile runs the
+message.
+
+**Identity first.** ``ProfileRouter.identify`` settles, once and before any session key is built,
+which bot received the message (``transport_profile``: the profile whose adapter registered in the
+``AdapterTable`` delivered it) and which profile runs it (``runtime_profile``). A message from an
+adapter nobody registered, or routed to a profile this gateway does not serve, is ``Unresolved``:
+``drop_unresolved`` logs one warning per target and, when the platform has already acknowledged
+the update, sends that target one "please resend" notice.
+
+**Exactly two resolvers.** ``intake_adapter`` — the bot that received it; live provenance only.
+``delivery_adapter`` — who answers: the receiving bot when known and connected; a known receiving
+bot that is offline answers nothing (never another bot); with no receiving bot known (a restored
+source whose sidecar row is gone) the unique owner of (platform, runtime profile) answers — that
+profile's own bot, else the one live bot whose routes target it — and two or none means no
+delivery, logged once per target. A profile with a bot of its own (on any platform, connected or
+not) never borrows another bot; a profile with no bot and no route never borrows the default bot.
+
+**Persistence.** ``ReceivingBots`` keeps the receiving bot next to each route key in a small JSON
+sidecar (``<launch home>/gateway/receiving_bots.json``, 0600, at most ``MAX_BOT_ROWS`` rows, oldest
+dropped), so delivery after a restart goes through the same bot. Session keys use the runtime
+profile's namespace (``core.session_keys``, format unchanged).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import threading
+from collections.abc import Callable, Collection, Iterable, Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Final, cast
+
+from indus.foundation.errors import InvalidProfileId
+from indus.foundation.fsio import atomic_write_text
+from indus.foundation.profiles import DEFAULT_PROFILE, normalize_id
+from indus.gateway.core._shapes import SourceLike, text_of
+from indus.gateway.core.session_keys import build_session_key, profile_of_key
+
+__all__ = [
+    "MAX_BOT_ROWS",
+    "RESEND_TEXT",
+    "WEIGHTS",
+    "AdapterTable",
+    "ProfileRoute",
+    "ProfileRouter",
+    "ReceivingBots",
+    "RouteQuery",
+    "RoutingIdentity",
+    "Unresolved",
+    "match_route",
+    "parse_routes",
+    "routes_from_config",
+]
+
+log = logging.getLogger(__name__)
+
+WEIGHTS: Final = {"user": 16, "thread": 8, "chat": 4, "guild": 2}
+MAX_BOT_ROWS: Final = 20_000
+BOTS_FILE: Final = "receiving_bots.json"
+RESEND_TEXT: Final = (
+    "This message could not be handed to the right profile, so it was not answered. "
+    "Please send it again in a moment."
+)
+_ID_FIELDS: Final = ("guild", "chat", "thread", "user")
+
+
+def _bot_key(name: object) -> str:
+    """The receiving bot's profile: ``default`` for unset."""
+    text = str(name).strip() if isinstance(name, str) else ""
+    return text or DEFAULT_PROFILE
+
+
+# -- routes ---------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RouteQuery:
+    """What a route is matched against: the platform, the receiving bot and the ids."""
+
+    platform: str
+    bot: str = DEFAULT_PROFILE
+    guild: str | None = None
+    chat: str | None = None
+    thread: str | None = None
+    parent_chat: str | None = None
+    user: str | None = None
+
+    @classmethod
+    def from_source(cls, source: SourceLike, *, bot: str) -> RouteQuery:
+        def opt(value: object) -> str | None:
+            return text_of(value) or None
+
+        return cls(
+            platform=text_of(source.platform).lower(),
+            bot=_bot_key(bot),
+            guild=opt(getattr(source, "guild_id", None)),
+            chat=opt(source.chat_id),
+            thread=opt(source.thread_id),
+            parent_chat=opt(source.parent_chat_id),
+            user=opt(source.user_id),
+        )
+
+
+@dataclass(frozen=True)
+class ProfileRoute:
+    """One routing rule (see the module notes)."""
+
+    name: str
+    platform: str
+    profile: str
+    bot: str = DEFAULT_PROFILE
+    guild: str | None = None
+    chat: str | None = None
+    thread: str | None = None
+    user: str | None = None
+    enabled: bool = True
+
+    @property
+    def specificity(self) -> int:
+        return sum(weight for key, weight in WEIGHTS.items() if getattr(self, key))
+
+    def matches(self, query: RouteQuery) -> bool:
+        if not self.enabled or self.platform != query.platform or self.bot != query.bot:
+            return False
+        if self.user is not None and self.user != query.user:
+            return False
+        if self.thread is not None and self.thread != query.thread:
+            return False
+        if self.chat is not None and self.chat not in (query.chat, query.parent_chat):
+            return False
+        return self.guild is None or self.guild == query.guild
+
+
+def _route_id(value: object, field: str, name: str, problems: list[str]) -> tuple[bool, str | None]:
+    """``(ok, id)``: strings as given, integers as text; anything else is a problem."""
+    if value is None:
+        return True, None
+    if isinstance(value, bool) or not isinstance(value, str | int):
+        problems.append(
+            f"route {name!r}: {field} must be text or a whole number (quote it in the YAML)"
+        )
+        return False, None
+    text = str(value).strip()
+    if not text:
+        problems.append(f"route {name!r}: {field} is empty")
+        return False, None
+    return True, text
+
+
+def parse_routes(raw: object) -> tuple[list[ProfileRoute], list[str]]:
+    """Routes from config, most specific first (ties keep config order), and the problems found.
+    A row with a problem is skipped whole (a half-read route could match too much)."""
+    problems: list[str] = []
+    routes: list[ProfileRoute] = []
+    if raw is None:
+        return routes, problems
+    if not isinstance(raw, list):
+        return routes, ["profile_routes must be a list"]
+    for index, item in enumerate(cast(list[object], raw)):
+        if not isinstance(item, Mapping):
+            problems.append(f"route #{index + 1} is not a mapping")
+            continue
+        entry = cast(Mapping[str, object], item)
+        name = str(entry.get("name") or f"#{index + 1}")
+        platform = str(entry.get("platform") or "").strip().lower()
+        if not platform or not entry.get("profile"):
+            problems.append(f"route {name!r}: platform and profile are required")
+            continue
+        try:
+            profile = normalize_id(entry.get("profile"))
+            bot_raw = entry.get("bot")
+            bot = DEFAULT_PROFILE if bot_raw in (None, "") else normalize_id(bot_raw)
+        except InvalidProfileId:
+            problems.append(f"route {name!r}: not a valid profile id")
+            continue
+        ids: dict[str, str | None] = {}
+        ok = True
+        for field in _ID_FIELDS:
+            good, value = _route_id(entry.get(field), field, name, problems)
+            ok = ok and good
+            ids[field] = value
+        if not ok:
+            continue
+        enabled = entry.get("enabled", True)
+        routes.append(
+            ProfileRoute(
+                name=name,
+                platform=platform,
+                profile=profile,
+                bot=bot,
+                guild=ids["guild"],
+                chat=ids["chat"],
+                thread=ids["thread"],
+                user=ids["user"],
+                enabled=enabled is not False,
+            )
+        )
+    routes.sort(key=lambda r: r.specificity, reverse=True)
+    for problem in problems:
+        log.warning("gateway.profile_routes: %s", problem)
+    return routes, problems
+
+
+def match_route(routes: Sequence[ProfileRoute], query: RouteQuery) -> ProfileRoute | None:
+    """The first (most specific) route that matches ``query``."""
+    return next((route for route in routes if route.matches(query)), None)
+
+
+# -- adapters -------------------------------------------------------------------------------------
+
+
+class AdapterTable:
+    """The live adapters: one per (profile, platform). Thread-safe.
+
+    A profile that ever registered a bot of its own *claims* that platform until it is released
+    (unserved): its bot going offline does not make it a bot-less profile that could borrow
+    another profile's bot."""
+
+    def __init__(self) -> None:
+        self._by_profile: dict[str, dict[str, object]] = {}
+        self._claims: dict[str, set[str]] = {}
+        self._lock = threading.Lock()
+
+    def register(self, profile: str, platform: str, adapter: object) -> None:
+        with self._lock:
+            self._by_profile.setdefault(profile, {})[platform.lower()] = adapter
+            self._claims.setdefault(profile, set()).add(platform.lower())
+
+    def unregister(
+        self, profile: str, platform: str | None = None, *, release: bool = False
+    ) -> None:
+        """The adapter went away (``platform`` None: all of the profile's). ``release`` also drops
+        the claims (the profile is no longer served)."""
+        with self._lock:
+            if platform is None:
+                self._by_profile.pop(profile, None)
+                if release:
+                    self._claims.pop(profile, None)
+                return
+            adapters = self._by_profile.get(profile)
+            if adapters is not None:
+                adapters.pop(platform.lower(), None)
+            if release:
+                self._claims.get(profile, set()).discard(platform.lower())
+
+    def claims(self, profile: str) -> set[str]:
+        """Platforms ``profile`` has a bot of its own on (connected or not)."""
+        with self._lock:
+            return set(self._claims.get(profile, set()))
+
+    def adapter(self, profile: str, platform: str) -> object | None:
+        with self._lock:
+            return self._by_profile.get(profile, {}).get(platform.lower())
+
+    def for_profile(self, profile: str) -> dict[str, object]:
+        """The profile's own adapters (empty for a profile with none: never another's)."""
+        with self._lock:
+            return dict(self._by_profile.get(profile, {}))
+
+    def owner_of(self, adapter: object, platform: str) -> str | None:
+        """The profile whose registered adapter for ``platform`` is ``adapter``."""
+        with self._lock:
+            for profile, adapters in self._by_profile.items():
+                if adapters.get(platform.lower()) is adapter:
+                    return profile
+        return None
+
+
+# -- identity -------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RoutingIdentity:
+    """Which bot received a message (None: unknown) and which profile runs it."""
+
+    platform: str
+    runtime_profile: str
+    transport_profile: str | None
+    live: bool = True
+    route: str | None = None
+
+
+@dataclass(frozen=True)
+class Unresolved:
+    """A message whose identity could not be settled; it is dropped."""
+
+    reason: str
+    profile: str | None = None
+
+
+class ReceivingBots:
+    """Session key → receiving bot, persisted beside the routing index (see the module notes)."""
+
+    def __init__(self, home: Path, *, limit: int = MAX_BOT_ROWS) -> None:
+        self.path = home / "gateway" / BOTS_FILE
+        self.limit = limit
+        self._rows: dict[str, str] | None = None
+        self._lock = threading.Lock()
+
+    def _load(self) -> dict[str, str]:
+        if self._rows is not None:
+            return self._rows
+        rows: dict[str, str] = {}
+        try:
+            data: object = json.loads(self.path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            data = None
+        if isinstance(data, dict):
+            for key, value in cast(dict[object, object], data).items():
+                if isinstance(key, str) and isinstance(value, str):
+                    try:
+                        rows[key] = normalize_id(value)
+                    except InvalidProfileId:
+                        continue
+        self._rows = rows
+        return rows
+
+    def _save(self, rows: Mapping[str, str]) -> None:
+        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+        atomic_write_text(self.path, json.dumps(dict(rows)), mode=0o600)
+
+    def get(self, session_key: str) -> str | None:
+        with self._lock:
+            return self._load().get(session_key)
+
+    def remember(self, session_key: str, bot: str) -> None:
+        with self._lock:
+            rows = self._load()
+            if rows.get(session_key) == bot:
+                return
+            rows.pop(session_key, None)
+            rows[session_key] = bot
+            while len(rows) > self.limit:
+                rows.pop(next(iter(rows)))
+            try:
+                self._save(rows)
+            except OSError as exc:
+                log.warning("the receiving bot could not be saved: %s", exc.strerror)
+
+    def forget(self, session_key: str) -> None:
+        with self._lock:
+            rows = self._load()
+            if rows.pop(session_key, None) is not None:
+                try:
+                    self._save(rows)
+                except OSError as exc:
+                    log.warning("the receiving bot could not be saved: %s", exc.strerror)
+
+
+type Notify = Callable[[SourceLike, str], object]
+
+
+class ProfileRouter:
+    """Identity, the two adapter resolvers and the drop rule (see the module notes)."""
+
+    def __init__(
+        self,
+        routes: Iterable[ProfileRoute],
+        adapters: AdapterTable,
+        *,
+        served: Callable[[], Collection[str]],
+        bots: ReceivingBots | None = None,
+    ) -> None:
+        self.routes = sorted(routes, key=lambda r: r.specificity, reverse=True)
+        self.adapters = adapters
+        self.served = served
+        self.bots = bots
+        self._warned: set[tuple[str, ...]] = set()
+        self._resend_sent: set[tuple[str, ...]] = set()
+        self._lock = threading.Lock()
+
+    # -- identity -------------------------------------------------------------------------------
+
+    def identify(self, source: SourceLike, adapter: object) -> RoutingIdentity | Unresolved:
+        """Who received ``source`` (through ``adapter``) and which profile runs it."""
+        platform = text_of(source.platform).lower()
+        transport = self.adapters.owner_of(adapter, platform)
+        if transport is None:
+            return Unresolved("unknown_bot")
+        route = match_route(self.routes, RouteQuery.from_source(source, bot=transport))
+        runtime = route.profile if route is not None else transport
+        try:
+            served = runtime in self.served()
+        except Exception:
+            served = False
+        if not served:
+            return Unresolved("unserved_profile", runtime)
+        with self._lock:
+            self._warned.discard(_target(source))
+            self._resend_sent.discard(_target(source))
+        return RoutingIdentity(
+            platform=platform,
+            runtime_profile=runtime,
+            transport_profile=transport,
+            live=True,
+            route=route.name if route is not None else None,
+        )
+
+    def restored_identity(self, session_key: str, platform: str) -> RoutingIdentity:
+        """The identity of a session revived from durable state (no live provenance)."""
+        bot = self.bots.get(session_key) if self.bots is not None else None
+        return RoutingIdentity(
+            platform=platform.lower(),
+            runtime_profile=profile_of_key(session_key),
+            transport_profile=bot,
+            live=False,
+        )
+
+    def remember(self, session_key: str, identity: RoutingIdentity) -> None:
+        """Persist the receiving bot beside the route key."""
+        if self.bots is not None and identity.transport_profile is not None:
+            self.bots.remember(session_key, identity.transport_profile)
+
+    def session_key(self, source: SourceLike, identity: RoutingIdentity, **options: bool) -> str:
+        """The session key in the runtime profile's namespace."""
+        return build_session_key(source, profile=identity.runtime_profile, **options)
+
+    # -- the two resolvers ----------------------------------------------------------------------
+
+    def intake_adapter(self, identity: RoutingIdentity) -> object | None:
+        """The adapter that received the message; None without live provenance."""
+        if not identity.live or identity.transport_profile is None:
+            return None
+        return self.adapters.adapter(identity.transport_profile, identity.platform)
+
+    def delivery_adapter(self, identity: RoutingIdentity) -> object | None:
+        """The adapter that answers (see the module notes); None = deliver nowhere."""
+        received_by = identity.transport_profile
+        if received_by is not None:
+            # A known receiving bot answers, or nobody does: never another bot by guess.
+            return self.adapters.adapter(received_by, identity.platform)
+        owners = self.owners(identity.platform, identity.runtime_profile)
+        if len(owners) == 1:
+            return self.adapters.adapter(owners[0], identity.platform)
+        key = ("delivery", identity.platform, identity.runtime_profile)
+        with self._lock:
+            first = key not in self._warned
+            self._warned.add(key)
+        if first:
+            log.warning(
+                "no single bot can answer profile %s on %s (%d candidates); not delivered",
+                identity.runtime_profile,
+                identity.platform,
+                len(owners),
+            )
+        return None
+
+    def owners(self, platform: str, profile: str) -> list[str]:
+        """Bots that may deliver for ``profile`` on ``platform``: its own; none when it has a bot
+        of its own anywhere (offline or on another platform: its own credential boundary); else
+        the live bots whose routes target it."""
+        platform = platform.lower()
+        if self.adapters.adapter(profile, platform) is not None:
+            return [profile]
+        if self.adapters.claims(profile):
+            return []
+        bots = {
+            route.bot
+            for route in self.routes
+            if route.enabled and route.platform == platform and route.profile == profile
+        }
+        return sorted(b for b in bots if self.adapters.adapter(b, platform) is not None)
+
+    # -- dropping -------------------------------------------------------------------------------
+
+    def drop_unresolved(
+        self,
+        source: SourceLike,
+        unresolved: Unresolved,
+        *,
+        acknowledged: bool,
+        notify: Notify | None = None,
+    ) -> bool:
+        """Drop the message: one warning per target, and one "please resend" notice when the
+        platform already acknowledged it. True when the notice was sent."""
+        target = _target(source)
+        with self._lock:
+            first = target not in self._warned
+            self._warned.add(target)
+            resend = acknowledged and notify is not None and target not in self._resend_sent
+            if resend:
+                self._resend_sent.add(target)
+        if first:
+            log.warning(
+                "dropped a %s message: %s%s",
+                target[0],
+                unresolved.reason,
+                f" ({unresolved.profile})" if unresolved.profile else "",
+            )
+        if resend and notify is not None:
+            try:
+                notify(source, RESEND_TEXT)
+            except Exception as exc:
+                log.warning("the resend notice could not be sent: %s", type(exc).__name__)
+                return False
+            return True
+        return False
+
+
+def _target(source: SourceLike) -> tuple[str, ...]:
+    return (
+        text_of(source.platform).lower(),
+        text_of(source.chat_id),
+        text_of(source.thread_id),
+    )
+
+
+def routes_from_config(raw: Any) -> list[ProfileRoute]:
+    """``parse_routes`` without the problem list (logged there)."""
+    return parse_routes(raw)[0]
