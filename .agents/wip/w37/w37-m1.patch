+# -- the second run --------------------------------------------------------------------------------
+
+
+@pytest.fixture
+def owner(root: Path, state: Path) -> Any:
+    lock = HostLock(state)
+    assert lock.try_acquire()
+    publish_record(state, live_record(root, served=("default", "b")))
+    yield lock
+    lock.release()
+
