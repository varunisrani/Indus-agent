@@ -0,0 +1,270 @@
+"""Verified, resumable downloads for pm (P24-23).
+
+``Fetcher.fetch(url, sha256)`` returns ``<downloads>/<sha256>``, a file whose bytes hash to the
+pinned value. Origins are tried in this order and every one is verified the same way:
+
+1. the blob already in the download cache;
+2. each local folder given (a ``bundle`` output: ``<folder>/blobs/<sha256>``), for offline
+   installs;
+3. the pinned URL;
+4. the content-addressed mirror, ``<mirror>/sha256/<sha256>``, when one is configured.
+
+A failure at one origin (HTTP error, network error after the retries, wrong hash) is recorded and
+the next one is tried; when all fail, ``FetchFailed`` lists each origin with its reason. A hash
+mismatch at the primary therefore falls back to the mirror, whose bytes must still verify.
+
+Downloads land in ``<sha256>.part`` and resume: a later attempt asks for ``Range: bytes=N-`` and
+appends when the answer is ``206`` starting at N, starts over on ``200``, and checks the part as
+complete on ``416``. A resumed download whose hash is wrong is retried once from zero at the same
+origin before moving on. Every request carries the configured timeout. Only ``https`` URLs are
+fetched, redirects included (followed by hand, at most five hops).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import shutil
+from collections.abc import Iterator, Sequence
+from contextlib import contextmanager
+from pathlib import Path
+from urllib.parse import urljoin, urlsplit
+
+import httpx
+
+from indus.pm.lock import PmError, valid_sha256
+from indus.pm.store import file_sha256
+
+__all__ = ["FetchFailed", "Fetcher", "HashMismatch", "mirror_url"]
+
+USER_AGENT = "indus-pm/1"
+MAX_REDIRECTS = 5
+ATTEMPTS = 3
+_RANGE = re.compile(r"bytes (\d+)-(\d+)/(\d+|\*)")
+
+
+class FetchFailed(PmError):
+    """No origin produced the pinned bytes."""
+
+
+class HashMismatch(PmError):
+    """The bytes of one origin did not hash to the pinned value."""
+
+
+class _Status(PmError):
+    def __init__(self, code: int, url: str) -> None:
+        super().__init__(f"HTTP {code}")
+        self.code = code
+        self.url = url
+
+
+class _Transport(PmError):
+    """A network failure that a later attempt may resume past."""
+
+
+def mirror_url(base: str, sha256: str) -> str:
+    """The mirror's address for a blob: ``<base>/sha256/<hex>``."""
+    if not valid_sha256(sha256):
+        raise PmError("a mirror lookup needs a full lowercase sha256")
+    return f"{base.rstrip('/')}/sha256/{sha256}"
+
+
+def _https(url: str) -> bool:
+    return urlsplit(url).scheme == "https"
+
+
+class Fetcher:
+    def __init__(
+        self,
+        downloads: Path,
+        *,
+        mirror: str = "",
+        local_dirs: Sequence[Path] = (),
+        timeout: float = 60.0,
+        transport: httpx.BaseTransport | None = None,
+        attempts: int = ATTEMPTS,
+    ) -> None:
+        self.downloads = downloads
+        self.mirror = mirror.strip()
+        self.local_dirs = tuple(local_dirs)
+        self.timeout = timeout
+        self.attempts = max(1, attempts)
+        self._transport = transport
+        self._client: httpx.Client | None = None
+
+    # -- plumbing ---------------------------------------------------------------------------------
+
+    def client(self) -> httpx.Client:
+        if self._client is None:
+            self._client = httpx.Client(
+                transport=self._transport,
+                timeout=httpx.Timeout(self.timeout),
+                follow_redirects=False,
+                headers={"User-Agent": USER_AGENT, "Accept-Encoding": "identity"},
+            )
+        return self._client
+
+    def close(self) -> None:
+        if self._client is not None:
+            self._client.close()
+            self._client = None
+
+    @contextmanager
+    def _open(self, url: str, headers: dict[str, str]) -> Iterator[httpx.Response]:
+        """A streamed response for ``url`` after following https-only redirects."""
+        current = url
+        for _ in range(MAX_REDIRECTS + 1):
+            if not _https(current):
+                raise PmError(f"refusing non-https URL {current}")
+            try:
+                response = self.client().send(
+                    self.client().build_request("GET", current, headers=headers), stream=True
+                )
+            except httpx.HTTPError as exc:
+                raise _Transport(f"{type(exc).__name__}: {exc}") from exc
+            if response.is_redirect:
+                location = response.headers.get("location", "")
+                response.close()
+                current = urljoin(current, location)
+                continue
+            try:
+                yield response
+            finally:
+                response.close()
+            return
+        raise PmError(f"too many redirects from {url}")
+
+    # -- one origin -------------------------------------------------------------------------------
+
+    def _download(self, url: str, part: Path) -> None:
+        """Fill ``part`` from ``url``, resuming what is there (``_Status`` / ``_Transport``)."""
+        last: Exception | None = None
+        for _ in range(self.attempts):
+            have = part.stat().st_size if part.exists() else 0
+            headers = {"Range": f"bytes={have}-"} if have else {}
+            try:
+                with self._open(url, headers) as response:
+                    code = response.status_code
+                    if code == 416 and have:
+                        return
+                    if code == 206 and have:
+                        match = _RANGE.fullmatch(response.headers.get("content-range", ""))
+                        if match is None or int(match.group(1)) != have:
+                            part.unlink(missing_ok=True)
+                            raise _Transport("the server answered a different byte range")
+                        mode = "ab"
+                    elif code == 200:
+                        mode = "wb"
+                    elif code in (408, 429) or code >= 500:
+                        raise _Transport(f"HTTP {code}")
+                    else:
+                        raise _Status(code, url)
+                    declared = response.headers.get("content-length")
+                    written = 0
+                    with part.open(mode) as out:
+                        for chunk in response.iter_raw():
+                            out.write(chunk)
+                            written += len(chunk)
+                    if declared is not None and declared.isdecimal() and written < int(declared):
+                        raise _Transport(f"the connection ended after {written}/{declared} bytes")
+                    return
+            except httpx.HTTPError as exc:
+                last = _Transport(f"{type(exc).__name__}: {exc}")
+            except _Transport as exc:
+                last = exc
+        assert last is not None
+        raise last
+
+    def _from_url(self, url: str, sha256: str, blob: Path) -> None:
+        part = blob.with_name(blob.name + ".part")
+        resumed = part.exists() and part.stat().st_size > 0
+        self._download(url, part)
+        actual = file_sha256(part)
+        if actual != sha256 and resumed:
+            # The kept part may be what is wrong: one more try from zero at this origin.
+            part.unlink(missing_ok=True)
+            self._download(url, part)
+            actual = file_sha256(part)
+        if actual != sha256:
+            part.unlink(missing_ok=True)
+            raise HashMismatch(f"sha256 mismatch: pinned {sha256}, got {actual}")
+        os.replace(part, blob)
+
+    def _from_dir(self, folder: Path, sha256: str, blob: Path) -> None:
+        source = folder / "blobs" / sha256
+        if not source.is_file():
+            raise PmError("not in this bundle")
+        part = blob.with_name(blob.name + ".part")
+        shutil.copyfile(source, part)
+        actual = file_sha256(part)
+        if actual != sha256:
+            part.unlink(missing_ok=True)
+            raise HashMismatch(f"sha256 mismatch: pinned {sha256}, got {actual}")
+        os.replace(part, blob)
+
+    # -- public -----------------------------------------------------------------------------------
+
+    def blob_path(self, sha256: str) -> Path:
+        return self.downloads / sha256
+
+    def fetch(self, url: str, sha256: str) -> Path:
+        """The verified blob for ``sha256`` (see the module notes for the origin order)."""
+        if not valid_sha256(sha256):
+            raise PmError(f"the pin for {url} has no full sha256", hint="run `indus pm lock`")
+        self.downloads.mkdir(parents=True, exist_ok=True)
+        blob = self.blob_path(sha256)
+        if blob.is_file():
+            if file_sha256(blob) == sha256:
+                return blob
+            blob.unlink(missing_ok=True)
+        failures: list[str] = []
+        for folder in self.local_dirs:
+            try:
+                self._from_dir(folder, sha256, blob)
+                return blob
+            except (PmError, OSError) as exc:
+                failures.append(f"bundle {folder}: {exc}")
+        origins = [("primary", url)]
+        if self.mirror:
+            origins.append(("mirror", mirror_url(self.mirror, sha256)))
+        for label, candidate in origins:
+            try:
+                self._from_url(candidate, sha256, blob)
+                return blob
+            except PmError as exc:
+                failures.append(f"{label} {candidate}: {exc}")
+        raise FetchFailed(
+            "could not fetch a verified copy:\n  " + "\n  ".join(failures),
+            hint="check the network, or set pm.mirror_url to a mirror",
+        )
+
+    def hash_url(self, url: str) -> str:
+        """Download ``url`` (no expected hash), keep it as a cached blob and return its sha256."""
+        self.downloads.mkdir(parents=True, exist_ok=True)
+        key = hashlib.sha256(url.encode("utf-8")).hexdigest()
+        part = self.downloads / f".url-{key}.part"
+        try:
+            self._download(url, part)
+        except _Status as exc:
+            raise PmError(f"{url}: HTTP {exc.code}") from exc
+        except _Transport as exc:
+            raise PmError(f"{url}: {exc}") from exc
+        sha = file_sha256(part)
+        os.replace(part, self.blob_path(sha))
+        return sha
+
+    def get_json(self, url: str) -> object:
+        """A small JSON document (release listings for ``indus pm update``)."""
+        try:
+            with self._open(url, {"Accept": "application/json"}) as response:
+                if response.status_code != 200:
+                    raise PmError(f"{url}: HTTP {response.status_code}")
+                body = response.read()
+        except _Transport as exc:
+            raise PmError(f"{url}: {exc}") from exc
+        try:
+            return json.loads(body)
+        except ValueError as exc:
+            raise PmError(f"{url}: not JSON") from exc
diff --git a/src/indus/pm/lock.py b/src/indus/pm/lock.py
new file mode 100644
index 0000000..32c52d9
--- /dev/null
+++ b/src/indus/pm/lock.py
@@ -0,0 +1,342 @@
+"""The pm lock and facts files (P24-23).
+
+``lock.json`` (machine-written by ``indus pm lock`` / ``update``) pins every package::
+
+    {"schema": 1, "packages": {name: {"version": "...",
+                                      "artifacts": {target: {"url": "...", "sha256": "..."}}}}}
+
+A package's ``any`` row serves every target without a row of its own.
+
+``facts.json`` records what this install actually holds::
+
+    {"schema": 1, "declined": [...],
+     "packages": {name: {"version", "target", "url", "sha256", "entry", "digest", "exe",
+                         "path", "installed_at"}}}
+
+``entry`` is the store folder name, ``digest`` the content digest of that folder when it was
+published, ``exe`` and ``path`` are relative to the entry (so a store copied to another root still
+works). A facts file that cannot be read is treated as empty and its bytes are kept beside it as
+``facts.json.corrupt`` before anything overwrites it; a lock that cannot be read is an error.
+
+``StatCache`` keeps a parsed file until its stat signature changes, so a satisfied ``ensure``
+costs a ``stat`` per file and no read.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import re
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation.fsio import atomic_write_json
+
+__all__ = [
+    "ANY",
+    "SCHEMA",
+    "TARGETS",
+    "Artifact",
+    "Fact",
+    "Facts",
+    "Lock",
+    "LockInvalid",
+    "Pin",
+    "PmError",
+    "StatCache",
+    "valid_sha256",
+]
+
+SCHEMA = 1
+ANY = "any"
+TARGETS: tuple[str, ...] = (
+    ANY,
+    "darwin-arm64",
+    "darwin-x64",
+    "linux-arm64",
+    "linux-arm64-bionic",
+    "linux-arm64-musl",
+    "linux-x64",
+    "linux-x64-musl",
+    "win32-arm64",
+    "win32-x64",
+)
+_SHA256 = re.compile(r"[0-9a-f]{64}")
+
+
+class PmError(Exception):
+    """A pm operation that cannot go on; ``hint`` says what to run next."""
+
+    def __init__(self, message: str, *, hint: str = "") -> None:
+        super().__init__(message)
+        self.message = message
+        self.hint = hint
+
+    def __str__(self) -> str:
+        return f"{self.message} ({self.hint})" if self.hint else self.message
+
+
+class LockInvalid(PmError):
+    """The lock file exists but is not a lock this build understands."""
+
+
+def valid_sha256(value: object) -> bool:
+    return isinstance(value, str) and _SHA256.fullmatch(value) is not None
+
+
+# -- lock ------------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Artifact:
+    url: str
+    sha256: str
+
+    def to_json(self) -> dict[str, str]:
+        return {"url": self.url, "sha256": self.sha256}
+
+
+@dataclass(frozen=True)
+class Pin:
+    version: str
+    artifacts: Mapping[str, Artifact]
+
+    def artifact(self, target: str) -> Artifact | None:
+        """This target's artifact, else the package's ``any`` artifact, else None."""
+        found = self.artifacts.get(target)
+        return found if found is not None else self.artifacts.get(ANY)
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "version": self.version,
+            "artifacts": {t: a.to_json() for t, a in sorted(self.artifacts.items())},
+        }
+
+
+def _pin_from(name: str, raw: object, where: Path) -> Pin:
+    def bad(why: str) -> LockInvalid:
+        return LockInvalid(
+            f"{where}: package {name!r} {why}", hint="run `indus pm lock` to write it again"
+        )
+
+    if not isinstance(raw, Mapping):
+        raise bad("is not an object")
+    row = cast(Mapping[str, object], raw)
+    version = row.get("version")
+    artifacts = row.get("artifacts")
+    if not isinstance(version, str) or not version:
+        raise bad("has no version")
+    if not isinstance(artifacts, Mapping):
+        raise bad("has no artifacts")
+    pins: dict[str, Artifact] = {}
+    for target, value in cast(Mapping[object, object], artifacts).items():
+        if target not in TARGETS:
+            raise bad(f"names an unknown target {target!r}")
+        if not isinstance(value, Mapping):
+            raise bad(f"has a broken {target} artifact")
+        art = cast(Mapping[str, object], value)
+        url, sha = art.get("url"), art.get("sha256")
+        if not isinstance(url, str) or not url or not valid_sha256(sha):
+            raise bad(f"has a broken {target} artifact (url and a full sha256 are needed)")
+        pins[str(target)] = Artifact(url, cast(str, sha))
+    return Pin(version, pins)
+
+
+@dataclass
+class Lock:
+    packages: dict[str, Pin] = field(default_factory=dict[str, Pin])
+
+    @classmethod
+    def from_json(cls, data: object, where: Path) -> Lock:
+        if not isinstance(data, Mapping):
+            raise LockInvalid(f"{where} is not a pm lock", hint="run `indus pm lock`")
+        top = cast(Mapping[str, object], data)
+        if top.get("schema") != SCHEMA:
+            raise LockInvalid(
+                f"{where} has lock schema {top.get('schema')!r}; this build reads {SCHEMA}",
+                hint="run `indus pm lock`",
+            )
+        packages = top.get("packages")
+        if not isinstance(packages, Mapping):
+            raise LockInvalid(f"{where} has no packages table", hint="run `indus pm lock`")
+        rows = cast(Mapping[object, object], packages)
+        return cls({str(n): _pin_from(str(n), raw, where) for n, raw in rows.items()})
+
+    @classmethod
+    def read(cls, path: Path) -> Lock:
+        """The lock at ``path``; an empty lock when the file does not exist."""
+        try:
+            text = path.read_text(encoding="utf-8")
+        except FileNotFoundError:
+            return cls()
+        except OSError as exc:
+            raise LockInvalid(f"{path} cannot be read: {exc.strerror or exc}") from exc
+        try:
+            data = json.loads(text)
+        except ValueError as exc:
+            raise LockInvalid(f"{path} is not valid JSON", hint="run `indus pm lock`") from exc
+        return cls.from_json(data, path)
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "schema": SCHEMA,
+            "packages": {n: p.to_json() for n, p in sorted(self.packages.items())},
+        }
+
+    def write(self, path: Path) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        atomic_write_json(path, self.to_json(), sort_keys=True, mode=0o644)
+
+
+# -- facts -----------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Fact:
+    version: str
+    target: str
+    url: str
+    sha256: str
+    entry: str
+    digest: str
+    exe: str | None
+    path: tuple[str, ...]
+    installed_at: str = ""
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "version": self.version,
+            "target": self.target,
+            "url": self.url,
+            "sha256": self.sha256,
+            "entry": self.entry,
+            "digest": self.digest,
+            "exe": self.exe,
+            "path": list(self.path),
+            "installed_at": self.installed_at,
+        }
+
+    @classmethod
+    def from_json(cls, raw: object) -> Fact | None:
+        if not isinstance(raw, Mapping):
+            return None
+        row = cast(Mapping[str, object], raw)
+        texts = {k: row.get(k) for k in ("version", "target", "url", "sha256", "entry", "digest")}
+        if not all(isinstance(v, str) and v for v in texts.values()):
+            return None
+        entry = cast(str, texts["entry"])
+        if entry in (".", "..") or "/" in entry or "\\" in entry:
+            return None
+        exe = row.get("exe")
+        path = row.get("path")
+        dirs = cast(list[object], path) if isinstance(path, list) else []
+        stamp = row.get("installed_at")
+        return cls(
+            version=cast(str, texts["version"]),
+            target=cast(str, texts["target"]),
+            url=cast(str, texts["url"]),
+            sha256=cast(str, texts["sha256"]),
+            entry=entry,
+            digest=cast(str, texts["digest"]),
+            exe=exe if isinstance(exe, str) and exe else None,
+            path=tuple(str(d) for d in dirs if isinstance(d, str)),
+            installed_at=stamp if isinstance(stamp, str) else "",
+        )
+
+
+@dataclass
+class Facts:
+    packages: dict[str, Fact] = field(default_factory=dict[str, Fact])
+    declined: list[str] = field(default_factory=list[str])
+
+    @classmethod
+    def read(cls, path: Path) -> Facts:
+        """The facts at ``path``. Missing → empty. Unreadable → empty, and the bytes are kept as
+        ``<name>.corrupt`` so the next write does not lose the evidence."""
+        try:
+            data = path.read_bytes()
+        except FileNotFoundError:
+            return cls()
+        except OSError:
+            return cls()
+        try:
+            top = json.loads(data.decode("utf-8"))
+            if not isinstance(top, Mapping):
+                raise ValueError("not an object")
+            fields = cast(Mapping[str, object], top)
+            if fields.get("schema") != SCHEMA or not isinstance(fields.get("packages"), Mapping):
+                raise ValueError("wrong schema")
+        except ValueError:
+            if data.strip():
+                with contextlib.suppress(OSError):
+                    path.with_name(path.name + ".corrupt").write_bytes(data)
+            return cls()
+        rows = cast(Mapping[object, object], fields["packages"])
+        packages: dict[str, Fact] = {}
+        for name, raw in rows.items():
+            fact = Fact.from_json(raw)
+            if fact is not None:
+                packages[str(name)] = fact
+        declined_raw = fields.get("declined")
+        declined = (
+            [str(d) for d in cast(list[object], declined_raw) if isinstance(d, str)]
+            if isinstance(declined_raw, list)
+            else []
+        )
+        return cls(packages, declined)
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "schema": SCHEMA,
+            "declined": sorted(set(self.declined)),
+            "packages": {n: f.to_json() for n, f in sorted(self.packages.items())},
+        }
+
+    def write(self, path: Path) -> None:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        atomic_write_json(path, self.to_json(), sort_keys=True, mode=0o644)
+
+    def entries_in_use(self) -> set[str]:
+        return {f.entry for f in self.packages.values()}
+
+    def blobs_in_use(self) -> set[str]:
+        return {f.sha256 for f in self.packages.values()}
+
+
+# -- stat-keyed cache ------------------------------------------------------------------------------
+
+
+class StatCache[T]:
+    """Keeps ``load(path)`` until the file's (inode, size, mtime) changes; a missing file is a
+    signature of its own. Only ``os.stat`` runs while the file stays the same."""
+
+    def __init__(self, load: Callable[[Path], T]) -> None:
+        self._load = load
+        self._seen: dict[Path, tuple[tuple[int, int, int] | None, T]] = {}
+
+    @staticmethod
+    def _signature(path: Path) -> tuple[int, int, int] | None:
+        try:
+            st = os.stat(path)
+        except FileNotFoundError:
+            return None
+        return (st.st_ino, st.st_size, st.st_mtime_ns)
+
+    def get(self, path: Path) -> T:
+        signature = self._signature(path)
+        held = self._seen.get(path)
+        if held is not None and held[0] == signature:
+            return held[1]
+        value = self._load(path)
+        self._seen[path] = (signature, value)
+        return value
+
+    def put(self, path: Path, value: T) -> None:
+        """Remember ``value`` as what ``path`` holds now (right after writing it)."""
+        self._seen[path] = (self._signature(path), value)
+
+    def forget(self, path: Path) -> None:
+        self._seen.pop(path, None)
diff --git a/src/indus/pm/packages.toml b/src/indus/pm/packages.toml
