index 0000000..859fccd
--- /dev/null
+++ b/src/indus/pm/packages.toml
@@ -0,0 +1,164 @@
+# Helper programs `indus pm` can install (P24-23, S9). Our own list and pins (D-16.52).
+#
+# A package says what it is; `indus pm lock` turns each target's URL into a pinned
+# {url, sha256} in <root>/pm/lock.json, and `indus pm update` moves a pin to the newest upstream
+# release that is at least 14 days old.
+#
+# Keys:
+#   summary    one line for `indus pm doctor` and `indus pm install`
+#   kind       required (always installed), default (installed unless declined), optional (on
+#              request only)
+#   version    the pinned upstream version (the lock may carry a newer one after `update`)
+#   url        URL template; {version} and every key of the target's table are filled in
+#   format     tar.gz, tar.xz, zip or file (a single executable); a target may override it
+#   strip      leading folders dropped from every archive member (default 0)
+#   exe        executable inside the unpacked folder ({version} and target keys filled in;
+#              ".exe" is added on Windows targets); empty for a package without one
+#   path       folders inside the unpacked folder that go first on PATH (default: the
+#              executable's folder)
+#   depends    packages installed first
+#   releases   where newer versions come from: "github:<owner>/<repo>", "node", or "pinned"
+#              (moves only with the product, e.g. Chromium follows the browser library)
+#   tag_prefix text before the version in a release tag (default "")
+#   targets    the targets the package ships for, each a table of template values
+
+[packages.ripgrep]
+summary = "fast text search (search_files)"
+kind = "required"
+version = "14.1.1"
+url = "https://github.com/BurntSushi/ripgrep/releases/download/{version}/ripgrep-{version}-{triple}.{ext}"
+format = "tar.gz"
+strip = 1
+exe = "rg"
+releases = "github:BurntSushi/ripgrep"
+
+[packages.ripgrep.targets]
+linux-x64 = { triple = "x86_64-unknown-linux-musl", ext = "tar.gz" }
+linux-x64-musl = { triple = "x86_64-unknown-linux-musl", ext = "tar.gz" }
+linux-arm64 = { triple = "aarch64-unknown-linux-gnu", ext = "tar.gz" }
+darwin-x64 = { triple = "x86_64-apple-darwin", ext = "tar.gz" }
+darwin-arm64 = { triple = "aarch64-apple-darwin", ext = "tar.gz" }
+win32-x64 = { triple = "x86_64-pc-windows-msvc", ext = "zip", format = "zip" }
+win32-arm64 = { triple = "aarch64-pc-windows-msvc", ext = "zip", format = "zip" }
+
+[packages.uv]
+summary = "Python package runner for skills and MCP servers started with uvx"
+kind = "required"
+version = "0.5.11"
+url = "https://github.com/astral-sh/uv/releases/download/{version}/uv-{triple}.{ext}"
+format = "tar.gz"
+strip = 1
+exe = "uv"
+releases = "github:astral-sh/uv"
+
+[packages.uv.targets]
+linux-x64 = { triple = "x86_64-unknown-linux-gnu", ext = "tar.gz" }
+linux-x64-musl = { triple = "x86_64-unknown-linux-musl", ext = "tar.gz" }
+linux-arm64 = { triple = "aarch64-unknown-linux-gnu", ext = "tar.gz" }
+linux-arm64-musl = { triple = "aarch64-unknown-linux-musl", ext = "tar.gz" }
+darwin-x64 = { triple = "x86_64-apple-darwin", ext = "tar.gz" }
+darwin-arm64 = { triple = "aarch64-apple-darwin", ext = "tar.gz" }
+win32-x64 = { triple = "x86_64-pc-windows-msvc", ext = "zip", format = "zip", strip = 0 }
+win32-arm64 = { triple = "aarch64-pc-windows-msvc", ext = "zip", format = "zip", strip = 0 }
+
+[packages.node]
+summary = "JavaScript runtime for MCP servers started with npx"
