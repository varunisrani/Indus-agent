+def test_importing_the_facade_loads_no_internals() -> None:
+    probe = (
+        "import sys, indus.pm\n"
+        "print(sorted(m for m in sys.modules if m.startswith('indus.pm.') or m == 'httpx'))\n"
+    )
+    done = subprocess.run(
