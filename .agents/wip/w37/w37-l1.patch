+        "Zig (zls)",
+    ),
+    ServerSpec(
+        "gleam",
+        (".gleam",),
+        ("gleam",),
+        ("lsp",),
+        ("gleam.toml",),
+        "install gleam (the language server is built in)",
+        "Gleam (gleam lsp)",
+    ),
+    ServerSpec(
+        "elixir-ls",
+        (".ex", ".exs"),
+        ("elixir-ls", "language_server.sh"),
+        (),
+        ("mix.exs",),
+        "install elixir-ls from its releases",
+        "Elixir (elixir-ls)",
+    ),
+    ServerSpec(
+        "kotlin-language-server",
