+    tool = bin_dir / "fake-ls"
+    tool.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
+    tool.chmod(0o755)
+
+    def factory(extra: Mapping[str, str]) -> dict[str, str]:
+        return {"PATH": str(bin_dir), **extra}
+
+    return factory
