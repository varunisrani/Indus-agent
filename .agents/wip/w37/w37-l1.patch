diff --git a/src/indus/cli/commands/lsp.py b/src/indus/cli/commands/lsp.py
new file mode 100644
index 0000000..7174f0b
--- /dev/null
+++ b/src/indus/cli/commands/lsp.py
@@ -0,0 +1,164 @@
+"""``indus lsp``: the language servers that check edits (P24-15).
+
+- ``status [--json]`` (also bare): whether LSP is on, the settings, the servers running in this
+  process (when it hosts any), the ones that failed or were skipped as untrusted, and the
+  catalogue with which binaries are installed on the PATH children get;
+- ``install-hint SERVER``: how to install a server (nothing is ever installed for you);
+- ``restart``: stop this process's servers and forget their failures (the next edit starts them
+  again).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+from typing import Any
+
+import click
+
+from indus.cli.cmdkit import cli_state, config_of, err, group
+from indus.foundation.scope import Scope
+from indus.safety.child_env import child_env
+
+__all__ = ["hint_lines", "lsp_group", "restart_lines", "status_lines", "status_payload"]
+
+_MARK = {True: "+", False: "-"}
+
+
+def _scoped(scope: Scope) -> Scope:
+    return scope if scope.config is not None else scope.with_config(config_of(scope))
+
+
+def _active_manager() -> Any:
+    """This process's manager, when a host installed the LSP tier (never imported otherwise)."""
+    if "indus.tools.lsp.diagnostics" not in sys.modules:
+        return None
+    from indus.tools.lsp import diagnostics
+
+    checker = diagnostics.active()
+    return checker.manager if checker is not None else None
+
+
+def status_payload(scope: Scope) -> dict[str, Any]:
+    from indus.tools.lsp.manager import LspSettings, describe_servers
+
+    scoped = _scoped(scope)
+    settings = LspSettings.from_scope(scoped)
+    search_path = child_env(scoped).get("PATH")
+    manager = _active_manager()
+    running = manager.status().as_dict() if manager is not None else None
+    return {
+        "enabled": settings.enabled,
+        "wait_timeout": settings.wait_timeout,
+        "idle_timeout": settings.idle_timeout,
+        "trusted_workspaces": list(settings.trusted_workspaces),
+        "process": running,
+        "servers": describe_servers(settings.servers, search_path),
+    }
+
+
+def status_lines(payload: dict[str, Any]) -> list[str]:
+    lines = [
+        f"Language servers: {'on' if payload['enabled'] else 'off'}",
+        f"  wait for a verdict: {payload['wait_timeout']:g} s; idle servers stop after "
+        + (f"{payload['idle_timeout']:g} s" if payload["idle_timeout"] else "never"),
+    ]
+    if payload["trusted_workspaces"]:
+        lines.append("  trusted workspaces: " + ", ".join(payload["trusted_workspaces"]))
+    running = payload["process"]
+    if running is None:
+        lines.append("  no language servers run in this process")
+    else:
+        clients = running["clients"]
+        lines.append(f"  running here: {len(clients) or 'none'}")
+        lines += [f"    {c['server']:<26} {c['state']:<8} {c['root']}" for c in clients]
+        for item in running["broken"]:
+            lines.append(f"  unavailable: {item['server']} for {item['root']}: {item['reason']}")
+        for item in running["untrusted"]:
+            lines.append(
+                f"  skipped (untrusted): {item['server']} for {item['root']} "
+                "(add the folder to lsp.trusted_workspaces)"
+            )
+    lines += ["", "Servers (+ installed, - missing):"]
+    for row in payload["servers"]:
+        mark = "x" if row["disabled"] else _MARK[bool(row["installed"])]
+        note = " [disabled]" if row["disabled"] else ""
+        if row["trusted_only"]:
+            note += " [trusted workspaces only]"
+        handles = ", ".join(row["handles"][:6]) + (" ..." if len(row["handles"]) > 6 else "")
+        lines.append(f"  {mark} {row['server']:<26} {handles}{note}")
+    lines.append("")
+    lines.append("`indus lsp install-hint SERVER` shows how to install one.")
+    return lines
+
+
+def hint_lines(scope: Scope, server: str) -> tuple[int, list[str]]:
+    from indus.tools.lsp.manager import LspSettings
+
+    settings = LspSettings.from_scope(_scoped(scope))
+    spec = next((s for s in settings.servers if s.server_id == server), None)
+    if spec is None:
+        known = ", ".join(s.server_id for s in settings.servers)
+        return 1, [f"Unknown language server {server!r}. Known: {known}"]
+    lines = [f"{spec.label or spec.server_id}:", f"  {spec.install_hint or 'no hint known'}"]
+    if spec.binaries:
+        lines.append("  looked for on the PATH: " + ", ".join(spec.binaries))
+    lines.append("Indus Agent never installs language servers itself.")
+    return 0, lines
+
+
+def restart_lines() -> list[str]:
+    manager = _active_manager()
+    if manager is None:
+        return [
+            "No language servers run in this process. A running session starts its own and "
+            "stops them when it ends or after the idle timeout."
+        ]
+    count = asyncio.run(manager.restart())
+    return [f"Stopped {count} language server(s); the next edit starts them again."]
+
+
+@group(
+    "lsp",
+    "Language servers that check edits: status, install hints, restart.",
+    short_help="Language servers that check edits.",
+    invoke_without_command=True,
+)
+@click.pass_context
+def lsp_group(ctx: click.Context) -> int:
+    if ctx.invoked_subcommand is None:
+        for line in status_lines(status_payload(cli_state().scope)):
+            click.echo(line)
+    return 0
+
+
+@lsp_group.command("status")
+@click.option("--json", "as_json", is_flag=True, help="Print JSON.")
+def status_command(as_json: bool) -> int:
+    """Settings, running servers and the catalogue."""
+    payload = status_payload(cli_state().scope)
+    if as_json:
+        click.echo(json.dumps(payload, indent=2, sort_keys=True))
+        return 0
+    for line in status_lines(payload):
+        click.echo(line)
+    return 0
+
+
+@lsp_group.command("install-hint")
+@click.argument("server")
+def install_hint_command(server: str) -> int:
+    """How to install a language server."""
+    code, lines = hint_lines(cli_state().scope, server)
+    for line in lines:
+        (err if code else click.echo)(line)
+    return code
+
+
+@lsp_group.command("restart")
+def restart_command() -> int:
+    """Stop this process's language servers and forget their failures."""
+    for line in restart_lines():
+        click.echo(line)
+    return 0
diff --git a/src/indus/cli/commands/verify.py b/src/indus/cli/commands/verify.py
new file mode 100644
index 0000000..60ee4c0
--- /dev/null
+++ b/src/indus/cli/commands/verify.py
@@ -0,0 +1,208 @@
+"""``indus verify [PATH]``: find how to check a workspace and run it (P24-17).
+
+The recipe comes from the workspace's files (``tools.verify.recipes``). Phases ``bootstrap``,
+``build`` and ``test`` run in that order on the local terminal backend (its environment builder,
+``terminal.*`` settings) and through the approval rules with nobody to ask, so a command that
+would need a person's approval is refused rather than run. Then, unless ``--skip-start``, the
+recipe's start command is booted and polled on 127.0.0.1 for up to ``verify.ready_timeout``.
+
+``--phase`` (repeatable) picks phases (``bootstrap``, ``build``, ``test``, ``start``);
+``--detect-only`` prints the recipe; ``--json`` prints one JSON object. Exit 0 when everything
+passed, 1 on a failure or when no recipe was found, 2 when PATH is not a folder.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+from typing import Any
+
+import click
+
+from indus.cli.cmdkit import cli_state, config_of, err
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+__all__ = ["report_lines", "run_for", "verify_command"]
+
+PHASE_CHOICES = ("bootstrap", "build", "test", "start")
+
+
+def _setting(scope: Scope, key: str) -> Any:
+    value = config_of(scope).get(key)
+    return default_for(key) if value is None else value
+
+
+def _gate(scope: Scope) -> Any:
+    from indus.safety import approvals
+
+    async def gate(command: str, cwd: str) -> str | None:
+        context = approvals.ApprovalContext(
+            scope=scope, run_context="interactive", broker=None, isolated=False, cwd=cwd
+        )
+        try:
+            decision = await approvals.decide(command, context)
+        except Exception as exc:  # fail closed: nothing runs unchecked
+            return f"the approval check failed ({type(exc).__name__})"
+        if decision.approved:
+            return None
+        return decision.user_summary or decision.description or "the approval rules refused it"
+
+    return gate
+
+
+async def run_for(
+    scope: Scope,
+    root: Path,
+    *,
+    phases: tuple[str, ...],
+    skip_start: bool,
+    port: int | None,
+    phase_timeout: float,
+    ready_timeout: float,
+) -> tuple[Any, Any]:
+    """``(recipe, result)`` for ``root`` (``result`` None when no recipe was found)."""
+    from indus.backends.local import open_local
+    from indus.safety.child_env import child_env
+    from indus.tools.verify.recipes import detect_recipe
+    from indus.tools.verify.runner import LocalStarter, run_verify
+
+    recipe = detect_recipe(root)
+    if recipe is None:
+        return None, None
+    host = await open_local(scope, cwd=str(root), timeout=phase_timeout)
+    try:
+        selected = phases or None
+        wants_start = not skip_start and (not phases or "start" in phases)
+        starter = LocalStarter(child_env(scope), clock=scope.clock) if wants_start else None
+        result = await run_verify(
+            host,
+            str(root),
+            recipe,
+            phases=selected,
+            phase_timeout=phase_timeout,
+            ready_timeout=ready_timeout,
+            clock=scope.clock,
+            gate=_gate(scope),
+            starter=starter,
+            port=port,
+        )
+    finally:
+        await host.cleanup()
+    return recipe, result
+
+
+def report_lines(recipe: Any, result: Any) -> list[str]:
+    lines = [f"Recipe: {recipe.name} ({recipe.kind})", ""]
+    if result.refused:
+        lines += [f"Refused: {result.refused}", "", "Result: FAILED"]
+        return lines
+    width = max([len(p.phase) for p in result.phases] + [5])
+    for phase in result.phases:
+        state = (
+            "PASS"
+            if phase.ok
+            else "TIMEOUT"
+            if phase.timed_out
+            else "REFUSED"
+            if (phase.refused)
+            else "FAIL"
+        )
+        lines.append(
+            f"  {phase.phase:<{width}}  {state:<7} {phase.duration:7.1f}s  {phase.command}"
+        )
+    if not result.phases:
+        lines.append("  (no phase ran)")
+    readiness = result.readiness
+    if readiness is not None:
+        state = "PASS" if readiness.ready else "FAIL"
+        lines.append(f"  {'start':<{width}}  {state:<7} {readiness.duration:7.1f}s  {recipe.start}")
+        answer = f"HTTP {readiness.status}" if readiness.ready else readiness.error or "no answer"
+        lines.append(f"  ready check: {readiness.url} -> {answer}")
+    lines += ["", f"Result: {'OK' if result.ok else 'FAILED'}"]
+    for phase in result.phases:
+        if phase.ok:
+            continue
+        if phase.refused:
+            lines += ["", f"--- {phase.phase}: {phase.command} was not run: {phase.refused}"]
+        elif phase.tail.strip():
+            lines += [
+                "",
+                f"--- output (end) of {phase.phase}: {phase.command}",
+                phase.tail.rstrip(),
+            ]
+    if readiness is not None and not readiness.ready and readiness.tail.strip():
+        lines += ["", "--- output (end) of start", readiness.tail.rstrip()]
+    return lines
+
+
+@click.command("verify", short_help="Build and test this workspace.")
+@click.argument("path", required=False, type=click.Path(file_okay=True, dir_okay=True))
+@click.option(
+    "--phase",
+    "phases",
+    multiple=True,
+    type=click.Choice(PHASE_CHOICES),
+    help="Run only this phase (repeatable).",
+)
+@click.option("--json", "as_json", is_flag=True, help="Print one JSON object.")
+@click.option("--detect-only", is_flag=True, help="Only print the detected recipe.")
+@click.option("--skip-start", is_flag=True, help="Do not boot the start command.")
+@click.option("--port", type=int, default=None, help="Port the start command serves on.")
+@click.option("--timeout", "phase_timeout", type=float, default=None, help="Seconds per command.")
+@click.option("--ready-timeout", type=float, default=None, help="Seconds to wait for the service.")
+def verify_command(
+    path: str | None,
+    phases: tuple[str, ...],
+    as_json: bool,
+    detect_only: bool,
+    skip_start: bool,
+    port: int | None,
+    phase_timeout: float | None,
+    ready_timeout: float | None,
+) -> int:
+    """Find how to check a workspace (lockfiles, scripts, Makefile, compose) and run its
+    bootstrap, build and test commands, then boot and poll its start command."""
+    from indus.tools.verify.recipes import detect_recipe
+
+    scope = cli_state().scope
+    scope = scope if scope.config is not None else scope.with_config(config_of(scope))
+    root = Path(path or ".").expanduser().resolve()
+    if not root.is_dir():
+        err(f"Not a folder: {root}")
+        return 2
+    if detect_only:
+        recipe = detect_recipe(root)
+        payload: dict[str, Any] = {
+            "root": str(root),
+            "recipe": recipe.as_dict() if recipe else None,
+        }
+        click.echo(json.dumps(payload, indent=None if as_json else 2))
+        return 0 if recipe is not None else 1
+    recipe, result = asyncio.run(
+        run_for(
+            scope,
+            root,
+            phases=phases,
+            skip_start=skip_start,
+            port=port,
+            phase_timeout=float(phase_timeout or _setting(scope, "verify.phase_timeout")),
+            ready_timeout=float(ready_timeout or _setting(scope, "verify.ready_timeout")),
+        )
+    )
+    if recipe is None:
+        if as_json:
+            click.echo(json.dumps({"ok": False, "error": "no_recipe", "root": str(root)}))
+        else:
+            err(
+                f"Nothing here says how to build or test {root}: no package.json, pyproject.toml, "
+                "go.mod, Cargo.toml, pom.xml, Gradle build, Makefile or compose file."
+            )
+        return 1
+    if as_json:
+        click.echo(json.dumps({**result.as_dict(), "root": str(root), "kind": recipe.kind}))
+    else:
+        for line in report_lines(recipe, result):
+            click.echo(line)
+    return 0 if result.ok else 1
diff --git a/src/indus/core/stop_gates.py b/src/indus/core/stop_gates.py
new file mode 100644
index 0000000..c8f21bd
--- /dev/null
+++ b/src/indus/core/stop_gates.py
@@ -0,0 +1,312 @@
+# pyright: strict
+"""Stop gates (A28): checks that may send the agent back to work before a text answer is final.
+
+When the model answers with text and no tool calls, the loop asks ``StopGates.run``. Gates run in
+registration order (the LSP gate first, then verify-on-stop, then the ``pre_verify`` plugin hook);
+the first one that returns a message wins and the turn goes on: ``continuation_rows`` gives the
+candidate answer as an interim assistant row (``finish_reason`` ``verification_required``) and the
+message as a user row after it, so roles keep alternating. A gate whose message must survive a
+later replay (the LSP gate) is ``durable``; the others' rows are scaffold, dropped when the turn's
+final answer is stored. Each gate fires at most ``limit`` times per turn; the candidate answer is
+the fallback if the budget then runs out (the loop keeps it). A gate that raises is skipped.
+
+Gates here (P24-17): ``VerifyOnStopGate`` (``verify.on_stop``, off by default) runs the
+workspace's ``build`` and ``test`` phases when the turn edited code files and, on failure, hands
+the failing command's output back (at most 2 times per turn); ``PreVerifyGate`` asks the
+``pre_verify`` plugin hook after code edits (at most 3 times per turn). The LSP gate lives in
+``core.stop_gates_lsp`` (P24-16).
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from collections import OrderedDict
+from collections.abc import Awaitable, Callable, Iterable, Sequence
+from dataclasses import dataclass
+from pathlib import PurePath
+from typing import Protocol
+
+from indus.core.transcript import TranscriptRow
+from indus.tools.builtin.exec_host import ExecHost
+from indus.tools.lsp.servers import find_git_root
+from indus.tools.verify.recipes import Recipe, detect_recipe
+from indus.tools.verify.runner import VerifyResult, run_verify
+
+__all__ = [
+    "FINISH_REASON",
+    "MAX_HOOK_NUDGES",
+    "MAX_VERIFY_NUDGES",
+    "PreVerifyGate",
+    "StopContext",
+    "StopDecision",
+    "StopGate",
+    "StopGates",
+    "VerifyOnStopGate",
+    "code_paths",
+    "continuation_rows",
+    "is_prose",
+]
+
+log = logging.getLogger(__name__)
+
+FINISH_REASON = "verification_required"
+MAX_VERIFY_NUDGES = 2
+MAX_HOOK_NUDGES = 3
+MAX_TRACKED_TURNS = 256
+MAX_PATHS_SHOWN = 8
+ON_STOP_PHASES = ("build", "test")
+
+# Files with nothing to run: a turn that touched only these never triggers a verify gate.
+PROSE_SUFFIXES = frozenset(
+    {".md", ".markdown", ".mdx", ".rst", ".txt", ".text", ".adoc", ".org", ".log", ".csv", ".tsv"}
+)
+PROSE_NAMES = frozenset(
+    {"license", "licence", "notice", "authors", "contributors", "changelog", "codeowners"}
+)
+
+
+def is_prose(path: str) -> bool:
+    name = PurePath(path).name
+    suffix = PurePath(name).suffix.lower()
+    return suffix in PROSE_SUFFIXES or (not suffix and name.lower() in PROSE_NAMES)
+
+
+def code_paths(paths: Iterable[str]) -> list[str]:
+    return sorted({p for p in paths if p and not is_prose(p)})
+
+
+@dataclass(frozen=True, slots=True)
+class StopContext:
+    """What a gate sees: who answers, the candidate answer and the files this turn edited."""
+
+    session_id: str | None
+    turn_id: str | None
+    answer: str
+    edited: tuple[str, ...] = ()
+    task_id: str | None = None
+    platform: str = ""
+    model: str = ""
+
+    @property
+    def owner(self) -> str | None:
+        return self.session_id or self.task_id
+
+
+class StopGate(Protocol):
+    @property
+    def name(self) -> str: ...
+
+    @property
+    def limit(self) -> int: ...
+
+    @property
+    def durable(self) -> bool: ...
+
+    async def check(self, ctx: StopContext, attempt: int) -> str | None:
+        """The message that sends the agent back to work, or None to let the answer stand."""
+        ...
+
+
+@dataclass(frozen=True, slots=True)
+class StopDecision:
+    gate: str
+    nudge: str
+    durable: bool
+    attempt: int
+
+
+class StopGates:
+    """The registry the loop asks before accepting a text answer (see the module notes)."""
+
+    def __init__(self, gates: Iterable[StopGate] = ()) -> None:
+        self._gates: list[StopGate] = list(gates)
+        self._counts: OrderedDict[tuple[str, str], dict[str, int]] = OrderedDict()
+
+    def register(self, gate: StopGate) -> None:
+        if any(g.name == gate.name for g in self._gates):
+            raise ValueError(f"stop gate {gate.name!r} is registered already")
+        self._gates.append(gate)
+
+    @property
+    def names(self) -> list[str]:
+        return [g.name for g in self._gates]
+
+    def fired(self, ctx: StopContext) -> dict[str, int]:
+        return dict(self._counts.get(self._key(ctx), {}))
+
+    @staticmethod
+    def _key(ctx: StopContext) -> tuple[str, str]:
+        return (ctx.owner or "", ctx.turn_id or "")
+
+    async def run(self, ctx: StopContext) -> StopDecision | None:
+        key = self._key(ctx)
+        counts = self._counts.pop(key, None) or {}
+        self._counts[key] = counts
+        while len(self._counts) > MAX_TRACKED_TURNS:
+            self._counts.popitem(last=False)
+        for gate in self._gates:
+            done = counts.get(gate.name, 0)
+            if done >= gate.limit:
+                continue
+            try:
+                nudge = await gate.check(ctx, done)
+            except Exception as exc:
+                log.warning("stop gate %s failed: %s: %s", gate.name, type(exc).__name__, exc)
+                continue
+            if nudge and nudge.strip():
+                counts[gate.name] = done + 1
+                log.debug("stop gate %s sends the agent back (attempt %d)", gate.name, done + 1)
+                return StopDecision(gate.name, nudge.strip(), gate.durable, done + 1)
+        return None
+
+    def end_turn(self, ctx: StopContext) -> None:
+        self._counts.pop(self._key(ctx), None)
+
+
+def continuation_rows(
+    decision: StopDecision, answer: str, *, reasoning: str | None = None
+) -> tuple[TranscriptRow, TranscriptRow]:
+    """The interim answer row and the gate's message row, in that order."""
+    interim = TranscriptRow(
+        role="assistant",
+        content=answer,
+        reasoning=reasoning,
+        finish_reason=FINISH_REASON,
+        extra={"stop_gate": decision.gate},
+    )
+    nudge = TranscriptRow(
+        role="user",
+        content=decision.nudge,
+        scaffold=not decision.durable,
+        extra={"stop_gate": decision.gate},
+    )
+    return interim, nudge
+
+
+# -- verify-on-stop (P24-17) ----------------------------------------------------------------------
+
+type HostFor = Callable[[StopContext], Awaitable[ExecHost | None]]
+type VerifyRun = Callable[[ExecHost, str, Recipe], Awaitable[VerifyResult]]
+
+
+def workspace_of(path: str) -> str:
+    """The folder verify runs in for an edited file: its git work tree, else its folder."""
+    return find_git_root(path) or os.path.dirname(os.path.abspath(path))
+
+
+def _paths_block(paths: Sequence[str]) -> str:
+    lines = [f"- {p}" for p in paths[:MAX_PATHS_SHOWN]]
+    if len(paths) > MAX_PATHS_SHOWN:
+        lines.append(f"- … and {len(paths) - MAX_PATHS_SHOWN} more")
+    return "\n".join(lines)
+
+
+class VerifyOnStopGate:
+    """Runs the workspace's build and test phases after code edits; a failure sends the agent
+    back with the output (see the module notes)."""
+
+    name = "verify_on_stop"
+    durable = False
+
+    def __init__(
+        self,
+        host_for: HostFor,
+        *,
+        enabled: bool | Callable[[], bool] = False,
+        limit: int = MAX_VERIFY_NUDGES,
+        phases: Sequence[str] = ON_STOP_PHASES,
+        phase_timeout: float | None = None,
+        runner: VerifyRun | None = None,
+    ) -> None:
+        self._host_for = host_for
+        self._enabled = enabled
+        self.limit = limit
+        self.phases = tuple(phases)
+        self.phase_timeout = phase_timeout
+        self._runner = runner
+
+    def enabled(self) -> bool:
+        return self._enabled() if callable(self._enabled) else bool(self._enabled)
+
+    async def _run(self, host: ExecHost, root: str, recipe: Recipe) -> VerifyResult:
+        if self._runner is not None:
+            return await self._runner(host, root, recipe)
+        if self.phase_timeout is not None:
+            return await run_verify(
+                host, root, recipe, phases=self.phases, phase_timeout=self.phase_timeout
+            )
+        return await run_verify(host, root, recipe, phases=self.phases)
+
+    async def check(self, ctx: StopContext, attempt: int) -> str | None:
+        if not self.enabled():
+            return None
+        changed = code_paths(ctx.edited)
+        if not changed:
+            return None
+        roots = list(dict.fromkeys(workspace_of(p) for p in changed))
+        host: ExecHost | None = None
+        for root in roots:
+            recipe = detect_recipe(root)
+            if recipe is None or not any(getattr(recipe, phase) for phase in self.phases):
+                continue
+            host = host or await self._host_for(ctx)
+            if host is None:
+                return None
+            result = await self._run(host, root, recipe)
+            if result.ok:
+                continue
+            return self._nudge(root, recipe, result, changed)
+        return None
+
+    @staticmethod
+    def _nudge(root: str, recipe: Recipe, result: VerifyResult, changed: Sequence[str]) -> str:
+        failed = next((p for p in result.phases if not p.ok), None)
+        lines = [
+            "[System note: you edited code this turn and the workspace's checks fail "
+            f"({recipe.name} in {root}). Read the failure, fix the code, then give your final "
+            "answer. If it cannot be fixed, say what blocks it instead of calling the work done.]",
+            "",
+            "Changed files:",
+            _paths_block(changed),
+        ]
+        if result.refused:
+            lines += ["", f"Verification could not run: {result.refused}"]
+        elif failed is not None:
+            state = "timed out" if failed.timed_out else f"exit code {failed.exit_code}"
+            if failed.refused:
+                state = f"refused: {failed.refused}"
+            lines += ["", f"Failed: [{failed.phase}] {failed.command} ({state})"]
+            if failed.tail.strip():
+                lines += ["Output (end):", failed.tail.rstrip()]
+        return "\n".join(lines)
+
+
+# -- the pre_verify plugin hook (P24-17) ----------------------------------------------------------
+
+type PreVerifyHook = Callable[..., Awaitable[str | None]]
+
+
+class PreVerifyGate:
+    """After code edits, a ``pre_verify`` plugin hook answering ``{action: continue, message}``
+    sends the agent back with that message (at most ``limit`` times per turn)."""
+
+    name = "pre_verify"
+    durable = False
+
+    def __init__(self, hook: PreVerifyHook, *, limit: int = MAX_HOOK_NUDGES) -> None:
+        self._hook = hook
+        self.limit = max(0, limit)
+
+    async def check(self, ctx: StopContext, attempt: int) -> str | None:
+        changed = code_paths(ctx.edited)
+        if not changed:
+            return None
+        return await self._hook(
+            session_id=ctx.session_id or "",
+            platform=ctx.platform,
+            model=ctx.model,
+            attempt=attempt,
+            final_response=ctx.answer,
+            changed_paths=changed,
+        )
