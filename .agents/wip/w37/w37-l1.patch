+++ b/src/indus/tools/verify/recipes.py
@@ -0,0 +1,322 @@
+# pyright: strict
+"""How to check a workspace (P24-17): a recipe of commands found from the files in it.
+
+The first lockfile present decides the package manager: ``pnpm-lock.yaml`` (pnpm), ``bun.lock`` /
+``bun.lockb`` (bun), ``yarn.lock`` (yarn), ``package-lock.json`` (npm), ``uv.lock`` (uv),
+``poetry.lock`` (poetry), ``Pipfile.lock`` (pipenv).
+
+Detectors, first match wins: a readable ``package.json`` (Node: the framework comes from the
+dependencies, phases from the scripts), then Python (Django, FastAPI/Uvicorn, Flask, or plain),
+Go, Rust, Maven, Gradle, a ``Makefile`` (its targets) and a compose file. Each recipe lists
+``bootstrap``, ``build`` and ``test`` commands (run in that order), an optional ``start`` command
+with the port it serves on and the path that answers when it is ready. Servers started by a
+recipe bind 127.0.0.1.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Mapping, Sequence
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from typing import Any, cast
+
+__all__ = [
+    "LOCKFILES",
+    "Recipe",
+    "detect_recipe",
+    "make_targets",
+    "package_manager",
+]
+
+_LOCKS_BY_MANAGER: dict[str, tuple[str, ...]] = {
+    "pnpm": ("pnpm-lock.yaml",),
+    "bun": ("bun.lock", "bun.lockb"),
+    "yarn": ("yarn.lock",),
+    "npm": ("package-lock.json",),
+    "uv": ("uv.lock",),
+    "poetry": ("poetry.lock",),
+    "pipenv": ("Pipfile.lock",),
+}
+LOCKFILES: tuple[tuple[str, str], ...] = tuple(
+    (lock, manager) for manager, locks in _LOCKS_BY_MANAGER.items() for lock in locks
+)
+"""``(lockfile, manager)`` in the order they are looked for."""
+
+COMPOSE_FILES = ("docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml")
+
+
+@dataclass(slots=True)
+class Recipe:
+    name: str
+    kind: str
+    bootstrap: list[str] = field(default_factory=lambda: list[str]())
+    build: list[str] = field(default_factory=lambda: list[str]())
+    test: list[str] = field(default_factory=lambda: list[str]())
+    start: str | None = None
+    port: int | None = None
+    ready_path: str = "/"
+    evidence: list[str] = field(default_factory=lambda: list[str]())
+
+    def commands(self, phase: str) -> list[str]:
+        return list(getattr(self, phase)) if phase in ("bootstrap", "build", "test") else []
+
+    def as_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def _text(root: Path, name: str) -> str | None:
+    try:
+        return (root / name).read_text(encoding="utf-8-sig")
+    except (OSError, UnicodeDecodeError):
+        return None
+
+
+def _exists(root: Path, *names: str) -> str | None:
+    return next((n for n in names if (root / n).exists()), None)
+
+
+def package_manager(root: Path | str) -> str | None:
+    folder = Path(root)
+    return next((manager for name, manager in LOCKFILES if (folder / name).exists()), None)
+
+
+# -- Node ----------------------------------------------------------------------------------------
+
+_FRAMEWORKS: tuple[tuple[tuple[str, ...], str, str, int], ...] = (
+    (("next",), "nextjs", "Next.js app", 3000),
+    (("@sveltejs/kit",), "sveltekit", "SvelteKit app", 5173),
+    (("astro",), "astro", "Astro site", 4321),
+    (("@remix-run/dev", "@remix-run/react"), "remix", "Remix app", 3000),
+    (("react-scripts",), "cra", "Create React App", 3000),
+    (("vite",), "vite", "Vite app", 5173),
+)
+_RUN = {"pnpm": "pnpm {}", "bun": "bun run {}", "yarn": "yarn {}"}
+_INSTALL = {"pnpm": "pnpm install", "bun": "bun install", "yarn": "yarn install"}
+_PORT = (re.compile(r"(?:--port|-p)[ =](\d{2,5})\b"), re.compile(r"\bPORT=(\d{2,5})\b"))
+
+
+def _port_in(command: str) -> int | None:
+    for pattern in _PORT:
+        found = pattern.search(command)
+        if found is not None:
+            value = int(found.group(1))
+            if 0 < value < 65536:
+                return value
+    return None
+
+
+def _package_json(root: Path) -> dict[str, Any] | None:
+    raw = _text(root, "package.json")
+    if raw is None:
+        return None
+    try:
+        parsed: object = json.loads(raw)
+    except ValueError:
+        return None
+    return cast(dict[str, Any], parsed) if isinstance(parsed, dict) else None
+
+
+def _mapping(value: object) -> Mapping[str, Any]:
+    return cast(Mapping[str, Any], value) if isinstance(value, Mapping) else {}
+
+
+def _node(root: Path, package: Mapping[str, Any]) -> Recipe:
+    scripts = {
+        k: v for k, v in _mapping(package.get("scripts")).items() if isinstance(v, str) and v
+    }
+    deps = {**_mapping(package.get("dependencies")), **_mapping(package.get("devDependencies"))}
+    manager = package_manager(root)
+    kind, label, port = "node", "Node.js project", None
+    for names, fw_kind, fw_label, fw_port in _FRAMEWORKS:
+        if any(n in deps for n in names):
+            kind, label, port = fw_kind, fw_label, fw_port
+            break
+    runner = _RUN.get(manager or "", "npm run {}")
+
+    def run(*names: str) -> list[str]:
+        return [runner.format(n) for n in names if n in scripts]
+
+    start_script = next((s for s in ("dev", "start") if s in scripts), None)
+    evidence = ["package.json"]
+    if manager:
+        evidence.append(f"package manager: {manager}")
+    evidence.append("scripts: " + (", ".join(scripts) or "(none)"))
+    return Recipe(
+        name=label,
+        kind=kind,
+        bootstrap=[_INSTALL.get(manager or "", "npm install")],
+        build=run("build", "typecheck"),
+        test=run("test", "check", "lint"),
+        start=runner.format(start_script) if start_script else None,
+        port=(_port_in(scripts[start_script]) or port) if start_script else None,
+        evidence=evidence,
+    )
+
+
+# -- Python ---------------------------------------------------------------------------------------
+
+_PY_INSTALL = {"uv": "uv sync", "poetry": "poetry install", "pipenv": "pipenv install"}
+
+
+def _python(root: Path) -> Recipe | None:
+    pyproject = _text(root, "pyproject.toml")
+    requirements = _text(root, "requirements.txt")
+    manage = (root / "manage.py").exists()
+    setup = (root / "setup.py").exists()
+    if pyproject is None and requirements is None and not manage and not setup:
+        return None
+    words = f"{pyproject or ''}\n{requirements or ''}".lower()
+    install = _PY_INSTALL.get(package_manager(root) or "")
+    if install is None:
+        install = (
+            "pip install -r requirements.txt" if requirements is not None else "pip install -e ."
+        )
+    pytest = ["pytest"] if (root / "tests").is_dir() else []
+    seen = [n for n in ("pyproject.toml", "requirements.txt", "setup.py") if (root / n).exists()]
+    if manage or "django" in words:
+        return Recipe(
+            "Django app",
+            "django",
+            bootstrap=[install],
+            test=["python manage.py test"],
+            start="python manage.py runserver 127.0.0.1:8000",
+            port=8000,
+            evidence=["manage.py" if manage else "Django dependency", *seen],
+        )
+    if "fastapi" in words or "uvicorn" in words:
+        module = (_exists(root, "main.py", "app.py") or "main.py").removesuffix(".py")
+        return Recipe(
+            "FastAPI app",
+            "fastapi",
+            bootstrap=[install],
+            test=pytest,
+            start=f"uvicorn {module}:app --host 127.0.0.1 --port 8000",
+            port=8000,
+            evidence=["FastAPI/Uvicorn dependency", *seen],
+        )
+    if "flask" in words:
+        app = _exists(root, "app.py", "main.py") or "app.py"
+        return Recipe(
+            "Flask app",
+            "flask",
+            bootstrap=[install],
+            test=pytest,
+            start=f"flask --app {app} run --host 127.0.0.1 --port 5000",
+            port=5000,
+            evidence=["Flask dependency", *seen],
+        )
+    return Recipe(
+        "Python project",
+        "python",
+        bootstrap=[install],
+        test=pytest or ["python -m unittest discover"],
+        evidence=seen or ["manage.py"],
+    )
+
+
+# -- compiled toolchains -------------------------------------------------------------------------
+
+
+def _toolchain(root: Path) -> Recipe | None:
+    if (root / "go.mod").exists():
+        return Recipe(
+            "Go module",
+            "go",
+            build=["go build ./..."],
+            test=["go test ./..."],
+            start="go run ." if (root / "main.go").exists() else None,
+            evidence=["go.mod"],
+        )
+    if (root / "Cargo.toml").exists():
+        return Recipe(
+            "Rust crate",
+            "rust",
+            build=["cargo build"],
+            test=["cargo test"],
+            start="cargo run" if (root / "src" / "main.rs").exists() else None,
+            evidence=["Cargo.toml"],
+        )
+    if (root / "pom.xml").exists():
+        return Recipe(
+            "Maven project", "maven", build=["mvn package"], test=["mvn test"], evidence=["pom.xml"]
+        )
+    gradle_file = _exists(root, "build.gradle", "build.gradle.kts")
+    if gradle_file is not None:
+        gradle = "./gradlew" if (root / "gradlew").exists() else "gradle"
+        return Recipe(
+            "Gradle project",
+            "gradle",
+            build=[f"{gradle} build"],
+            test=[f"{gradle} test"],
+            evidence=[gradle_file],
+        )
+    return None
+
+
+# -- make and compose -----------------------------------------------------------------------------
+
+_TARGET = re.compile(r"^([A-Za-z0-9_.-]+)\s*:(?![=:])")
+_MAKE_PHASES: dict[str, tuple[str, ...]] = {
+    "bootstrap": ("install", "setup", "bootstrap"),
+    "build": ("build", "compile"),
+    "test": ("test", "check"),
+    "start": ("run", "start", "serve", "dev"),
+}
+
+
+def make_targets(text: str) -> list[str]:
+    """Target names defined at the start of a line (variable assignments are not targets)."""
+    found: list[str] = []
+    for line in text.splitlines():
+        match = _TARGET.match(line)
+        if match is not None and not match.group(1).startswith(".") and match.group(1) not in found:
+            found.append(match.group(1))
+    return found
+
+
+def _first(targets: Sequence[str], names: Sequence[str]) -> list[str]:
+    hit = next((n for n in names if n in targets), None)
+    return [f"make {hit}"] if hit else []
+
+
+def _make(root: Path) -> Recipe | None:
+    text = _text(root, "Makefile")
+    if text is None:
+        return None
+    targets = make_targets(text)
+    start = _first(targets, _MAKE_PHASES["start"])
+    return Recipe(
+        "Makefile project",
+        "make",
+        bootstrap=_first(targets, _MAKE_PHASES["bootstrap"]),
+        build=_first(targets, _MAKE_PHASES["build"]),
+        test=_first(targets, _MAKE_PHASES["test"]),
+        start=start[0] if start else None,
+        evidence=["Makefile", "targets: " + (", ".join(targets) or "(none)")],
+    )
+
+
+def _compose(root: Path) -> Recipe | None:
+    found = _exists(root, *COMPOSE_FILES)
+    if found is None:
+        return None
+    return Recipe(
+        "Compose project",
+        "compose",
+        build=["docker compose build"],
+        start="docker compose up",
+        evidence=[found],
+    )
+
+
+def detect_recipe(root: Path | str) -> Recipe | None:
+    """The recipe for the workspace at ``root``, or None when nothing is recognised."""
+    folder = Path(root)
+    if not folder.is_dir():
+        return None
+    package = _package_json(folder)
+    if package is not None:
+        return _node(folder, package)
+    return _python(folder) or _toolchain(folder) or _make(folder) or _compose(folder)
diff --git a/src/indus/tools/verify/runner.py b/src/indus/tools/verify/runner.py
new file mode 100644
index 0000000..b35a53a
--- /dev/null
+++ b/src/indus/tools/verify/runner.py
@@ -0,0 +1,383 @@
+# pyright: strict
+"""Running a recipe (P24-17): ``bootstrap`` → ``build`` → ``test``, then optionally boot and poll.
+
+Every command runs through an ``ExecHost`` (the session's terminal backend: its environment
+builder, its sandbox) in the workspace folder, with ``PHASE_TIMEOUT_S`` (600 s) each, and through
+an optional approval ``gate`` first: a refused command is a failed phase whose text says why, and
+nothing ran. The first failure stops the run (unless ``stop_on_failure`` is off). Each result keeps
+the last ``TAIL_CHARS`` (2,000) characters of the command's output.
+
+After the phases pass, a recipe's ``start`` command may be booted (only when a ``ServiceStarter``
+is given, as the CLI does) and ``http://127.0.0.1:<port><ready_path>`` polled every second for up
+to ``READY_TIMEOUT_S`` (60 s); any HTTP answer counts as ready. The service is stopped either way.
+
+A compose recipe refuses to build or start while that compose project has running containers
+(``docker compose ps``): rebuilding would replace them and lose what lives inside. When docker
+itself is missing the run goes on (the build then fails on its own); when the probe fails or
+hangs the run is refused, since running containers cannot be ruled out.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import os
+import signal
+from collections.abc import Awaitable, Callable, Mapping, Sequence
+from dataclasses import dataclass, field
+from typing import Any, Protocol
+
+from indus.foundation.clock import Clock, SystemClock
+from indus.tools.builtin.exec_host import ExecHost
+from indus.tools.verify.recipes import Recipe
+
+__all__ = [
+    "PHASES",
+    "PHASE_TIMEOUT_S",
+    "READY_TIMEOUT_S",
+    "TAIL_CHARS",
+    "CommandGate",
+    "LocalStarter",
+    "PhaseResult",
+    "Readiness",
+    "ServiceStarter",
+    "VerifyResult",
+    "http_probe",
+    "run_verify",
+    "tail",
+]
+
+log = logging.getLogger(__name__)
+
+PHASES = ("bootstrap", "build", "test")
+PHASE_TIMEOUT_S = 600.0
+READY_TIMEOUT_S = 60.0
+READY_POLL_S = 1.0
+PROBE_TIMEOUT_S = 5.0
+TAIL_CHARS = 2000
+COMPOSE_PROBE_S = 15.0
+STOP_GRACE_S = 10.0
+MISSING_RC = 127
+
+type CommandGate = Callable[[str, str], Awaitable[str | None]]
+"""``(command, cwd)`` → why it may not run, or None to let it run."""
+type Probe = Callable[[str], Awaitable[int | None]]
+"""``url`` → the HTTP status it answered with, or None when nothing answered."""
+
+
+def tail(text: str, limit: int = TAIL_CHARS) -> str:
+    return text[-limit:] if len(text) > limit else text
+
+
+@dataclass(slots=True)
+class PhaseResult:
+    phase: str
+    command: str
+    exit_code: int | None
+    duration: float
+    tail: str
+    timed_out: bool = False
+    refused: str | None = None
+
+    @property
+    def ok(self) -> bool:
+        return self.exit_code == 0 and not self.timed_out and self.refused is None
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "phase": self.phase,
+            "command": self.command,
+            "exit_code": self.exit_code,
+            "duration": round(self.duration, 3),
+            "ok": self.ok,
+            "timed_out": self.timed_out,
+            "refused": self.refused,
+            "tail": self.tail,
+        }
+
+
+@dataclass(slots=True)
+class Readiness:
+    url: str
+    ready: bool
+    status: int | None
+    duration: float
+    error: str | None = None
+    tail: str = ""
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "url": self.url,
+            "ready": self.ready,
+            "status": self.status,
+            "duration": round(self.duration, 3),
+            "error": self.error,
+            "tail": self.tail,
+        }
+
+
+@dataclass(slots=True)
+class VerifyResult:
+    recipe: str
+    phases: list[PhaseResult] = field(default_factory=lambda: list[PhaseResult]())
+    readiness: Readiness | None = None
+    refused: str | None = None
+
+    @property
+    def ok(self) -> bool:
+        return (
+            self.refused is None
+            and all(p.ok for p in self.phases)
+            and (self.readiness is None or self.readiness.ready)
+        )
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "recipe": self.recipe,
+            "ok": self.ok,
+            "refused": self.refused,
+            "phases": [p.as_dict() for p in self.phases],
+            "readiness": self.readiness.as_dict() if self.readiness else None,
+        }
+
+
+class ServiceStarter(Protocol):
+    """Boots a recipe's start command in the background and stops it again."""
+
+    async def start(self, command: str, cwd: str) -> object: ...
+
+    async def stop(self, handle: object) -> str:
+        """Stop it; the output it produced."""
+        ...
+
+
+# -- phases ---------------------------------------------------------------------------------------
+
+
+async def _run_command(
+    host: ExecHost,
+    phase: str,
+    command: str,
+    root: str,
+    *,
+    timeout: float,
+    clock: Clock,
+    gate: CommandGate | None,
+    cancel: object,
+) -> PhaseResult:
+    if gate is not None:
+        refusal = await gate(command, root)
+        if refusal:
+            return PhaseResult(phase, command, None, 0.0, "", refused=refusal)
+    started = clock.monotonic()
+    try:
+        result = await host.execute(
+            command, timeout=timeout, cwd=root, bounded=False, cancel=cancel
+        )
+    except Exception as exc:  # the backend could not run it at all
+        return PhaseResult(
+            phase,
+            command,
+            None,
+            clock.monotonic() - started,
+            f"{type(exc).__name__}: {exc}",
+            refused=f"the terminal backend could not run it ({type(exc).__name__})",
+        )
+    duration = clock.monotonic() - started
+    if result.timed_out:
+        return PhaseResult(phase, command, None, duration, tail(result.output), timed_out=True)
+    return PhaseResult(phase, command, result.returncode, duration, tail(result.output))
+
+
+async def _compose_refusal(host: ExecHost, root: str) -> str | None:
+    probe = "docker compose ps --status running --format '{{.Name}}'"
+    try:
+        result = await host.execute(probe, timeout=COMPOSE_PROBE_S, cwd=root, bounded=False)
+    except Exception as exc:
+        return f"the docker compose probe could not run ({type(exc).__name__})"
+    if result.timed_out:
+        return f"docker compose ps did not answer within {COMPOSE_PROBE_S:g} s"
+    if result.returncode == MISSING_RC:
+        return None
+    if result.returncode != 0:
+        last = [line for line in result.output.splitlines() if line.strip()]
+        return f"docker compose ps failed (exit {result.returncode}): {last[-1] if last else ''}"
+    names = [line.strip() for line in result.output.splitlines() if line.strip()]
+    if names:
+        return "this compose project already has running containers: " + ", ".join(names)
+    return None
+
+
+async def run_verify(
+    host: ExecHost,
+    root: str,
+    recipe: Recipe,
+    *,
+    phases: Sequence[str] | None = None,
+    phase_timeout: float = PHASE_TIMEOUT_S,
+    ready_timeout: float = READY_TIMEOUT_S,
+    clock: Clock | None = None,
+    gate: CommandGate | None = None,
+    starter: ServiceStarter | None = None,
+    probe: Probe | None = None,
+    port: int | None = None,
+    stop_on_failure: bool = True,
+    cancel: object = None,
+) -> VerifyResult:
+    """Run ``phases`` (default: bootstrap, build, test and start) of ``recipe`` in ``root``."""
+    clock = clock or SystemClock()
+    selected = tuple(phases) if phases else (*PHASES, "start")
+    result = VerifyResult(recipe.name)
+    boots = "start" in selected and recipe.start is not None and starter is not None
+    if recipe.kind == "compose" and ("build" in selected or boots):
+        refusal = await _compose_refusal(host, root)
+        if refusal:
+            result.refused = (
+                f"{refusal}. Rebuilding would replace those containers and lose what lives "
+                "inside them; run `docker compose build` / `up` yourself if that is intended."
+            )
+            return result
+    for phase in PHASES:
+        if phase not in selected:
+            continue
+        for command in recipe.commands(phase):
+            outcome = await _run_command(
+                host,
+                phase,
+                command,
+                root,
+                timeout=phase_timeout,
+                clock=clock,
+                gate=gate,
+                cancel=cancel,
+            )
+            result.phases.append(outcome)
+            if not outcome.ok and stop_on_failure:
+                return result
+    if boots and all(p.ok for p in result.phases):
+        assert recipe.start is not None and starter is not None
+        if gate is not None:
+            refusal = await gate(recipe.start, root)
+            if refusal:
+                result.phases.append(
+                    PhaseResult("start", recipe.start, None, 0.0, "", refused=refusal)
+                )
+                return result
+        result.readiness = await _boot(
+            starter, recipe, root, port or recipe.port or 8000, ready_timeout, clock, probe
+        )
+    return result
+
+
+async def _boot(
+    starter: ServiceStarter,
+    recipe: Recipe,
+    root: str,
+    port: int,
+    ready_timeout: float,
+    clock: Clock,
+    probe: Probe | None,
+) -> Readiness:
+    assert recipe.start is not None
+    url = f"http://127.0.0.1:{port}{recipe.ready_path}"
+    ask = probe or http_probe
+    started = clock.monotonic()
+    handle = await starter.start(recipe.start, root)
+    ready, status, error = False, None, "no answer"
+    output = ""
+    try:
+        deadline = started + ready_timeout
+        while True:
+            try:
+                status = await ask(url)
+            except Exception as exc:
+                status, error = None, f"{type(exc).__name__}: {exc}"
+            if status is not None:
+                ready, error = True, None
+                break
+            if clock.monotonic() + READY_POLL_S > deadline:
+                break
+            await clock.sleep(READY_POLL_S)
+    finally:
+        output = await starter.stop(handle)
+    return Readiness(url, ready, status, clock.monotonic() - started, error, tail(output))
+
+
+# -- local boot and probe (the CLI) ---------------------------------------------------------------
+
+
+async def http_probe(url: str) -> int | None:
+    """The status line of a plain GET to a loopback URL, or None when nothing answered."""
+    rest = url.removeprefix("http://")
+    hostport, _, path = rest.partition("/")
+    host, _, port_text = hostport.partition(":")
+    if host not in ("127.0.0.1", "localhost"):
+        raise ValueError("readiness is only probed on the loopback interface")
+    try:
+        reader, writer = await asyncio.wait_for(
+            asyncio.open_connection(host, int(port_text or "80")), PROBE_TIMEOUT_S
+        )
+    except (OSError, TimeoutError):
+        return None
+    try:
+        request = f"GET /{path} HTTP/1.0\r\nHost: {hostport}\r\nConnection: close\r\n\r\n"
+        writer.write(request.encode("ascii", errors="replace"))
+        await writer.drain()
+        line = await asyncio.wait_for(reader.readline(), PROBE_TIMEOUT_S)
+    except (OSError, TimeoutError):
+        return None
+    finally:
+        writer.close()
+        with contextlib.suppress(OSError):
+            await writer.wait_closed()
+    parts = line.decode("latin-1").split()
+    if len(parts) >= 2 and parts[0].startswith("HTTP/") and parts[1].isdigit():
+        return int(parts[1])
+    return None
+
+
+class LocalStarter:
+    """Boots a start command with bash on this machine in its own process group; stopping sends
+    SIGTERM to the group, then SIGKILL after ``STOP_GRACE_S``."""
+
+    def __init__(self, env: Mapping[str, str], *, clock: Clock | None = None) -> None:
+        self.env = dict(env)
+        self.clock: Clock = clock or SystemClock()
+
+    async def start(self, command: str, cwd: str) -> object:
+        return await asyncio.create_subprocess_exec(
+            "bash",
+            "-c",
+            command,
+            cwd=cwd,
+            env=self.env,
+            stdin=asyncio.subprocess.DEVNULL,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.STDOUT,
+            start_new_session=True,
+        )
+
+    async def stop(self, handle: object) -> str:
+        if not isinstance(handle, asyncio.subprocess.Process):
+            return ""
+        proc = handle
+        reading = asyncio.ensure_future(proc.stdout.read()) if proc.stdout is not None else None
+        for sig in (signal.SIGTERM, signal.SIGKILL):
+            if proc.returncode is not None:
+                break
+            with contextlib.suppress(ProcessLookupError, PermissionError):
+                os.killpg(proc.pid, sig)
+            waiter = asyncio.ensure_future(proc.wait())
+            timer = asyncio.ensure_future(self.clock.sleep(STOP_GRACE_S))
+            await asyncio.wait({waiter, timer}, return_when=asyncio.FIRST_COMPLETED)
+            timer.cancel()
+            if not waiter.done():
+                waiter.cancel()
+        if reading is None:
+            return ""
+        try:
+            data = await asyncio.wait_for(reading, 2.0)
+        except TimeoutError:
+            return ""
+        return data.decode("utf-8", errors="replace")
