index 0000000..6e316ec
--- /dev/null
+++ b/src/indus/gateway/rooms/peers.py
@@ -0,0 +1,404 @@
+"""Bot-to-bot messaging in the gateway: receiving routes, local delivery, `self-chat` (P24-07).
+
+Three pieces, all around each profile's canonical chat (``indus.state.bot_chat``):
+
+- ``bots_router(ctx)``: routes for the API server (P15-30), so another gateway (a *peer*, see
+  ``indus.service.peers``) can reach this profile's bot. ``POST /v1/bots/chat`` resolves or creates
+  the canonical chat and answers its session id; ``POST /v1/bots/dm {message, author?}`` runs one
+  unattended turn there and answers its reply (empty when the bot chose silence). A relayed turn
+  gets ``RELAY_CAP_S`` (10 minutes); past that the answer is 504 ``delivery_timeout`` with
+  ``accepted: true`` (the turn goes on in the chat; the sender must not resend). Failures carry a
+  typed ``reason`` in the error body. The API server's bearer gate guards these routes like every
+  other.
+- ``LocalBotTransport``: how ``message_agent`` delivers. A bare name that is a live local profile
+  (other than the sender) is local: the target's canonical chat is resolved in its own store and
+  one turn runs there through a one-shot ``indus -p <profile> -z`` child (attached to that
+  profile's daemon by default, so a running turn queues it), with the environment from the one
+  child-env builder (R02.22) and the same 10-minute cap (the child is killed past it). Otherwise a
+  registered peer of that name, or ``peer/profile``, goes through ``PeerClient.dm``.
+- ``deliver_self_chat``: the ``self-chat`` cron delivery target (H11): the job's output is added
+  to the job's own profile's canonical chat as an incoming (user-role) message; no turn runs.
+  ``install_self_chat`` registers it in cron's deliverer table (the delivery router does this when
+  it is built).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import logging
+import os
+import secrets
+import signal
+import sys
+import threading
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import TYPE_CHECKING, Any, Final, cast
+
+from fastapi import APIRouter
+from starlette.requests import Request
+from starlette.responses import JSONResponse, Response
+
+from indus.cron import delivery as cron_delivery
+from indus.cron.delivery import DeliveryReceipt, DeliveryRequest
+from indus.foundation.blocking import run_blocking
+from indus.foundation.profiles import is_live, is_valid_id, mkdir_in_profile, profile_home
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope, make_scope
+from indus.gateway.http.serving import BadRequest, read_json
+from indus.gateway.outbound.filters import is_silence
+from indus.safety.child_env import child_env
+from indus.service.peers import RELAY_CAP_S, PeerBook, PeerClient, PeerError, PeerTarget
+from indus.state import registry
+from indus.state.bot_chat import CanonicalChat, FailureReason, classify_failure
+from indus.state.bot_chat import ensure_canonical as _ensure_canonical
+from indus.state.bot_chat import inject_incoming as _inject_incoming
+from indus.tools.builtin.message_agent import BotDelivery, DeliveryOutcome
+
+if TYPE_CHECKING:
+    from indus.gateway.http.api_server import ApiContext
+
+__all__ = [
+    "CHAT_PATH",
+    "DM_PATH",
+    "MAX_DM_BYTES",
+    "SELF_CHAT",
+    "LocalBotTransport",
+    "OneShotResult",
+    "bots_router",
+    "deliver_self_chat",
+    "install_self_chat",
+    "run_oneshot",
+]
+
+log = logging.getLogger(__name__)
+
+CHAT_PATH: Final = "/v1/bots/chat"
+DM_PATH: Final = "/v1/bots/dm"
+MAX_DM_BYTES: Final = 256 * 1024
+SELF_CHAT: Final = "self-chat"
+
+
+# -- receiving side: the API server routes ---------------------------------------------------------
+
+
+def _failure(
+    status: int, reason: FailureReason, message: str, *, accepted: bool = False
+) -> JSONResponse:
+    body: dict[str, Any] = {
+        "message": redact_text(message)[:1_000],
+        "type": "invalid_request_error" if status < 500 else "server_error",
+        "code": reason,
+        "reason": reason,
+    }
+    if accepted:
+        body["accepted"] = True
+    return JSONResponse({"error": body}, status_code=status)
+
+
+def _reason_of(exc: BadRequest) -> FailureReason:
+    if exc.status in (409, 423, 429):
+        return "target_busy"
+    if exc.status == 404:
+        return "missing_config"
+    return classify_failure(exc.message)
+
+
+def bots_router(ctx: ApiContext) -> APIRouter:
+    """The ``/v1/bots/*`` routes (mounted by ``build_api_app`` beside the runs routes)."""
+    from indus.gateway.http.api_server import failure_text, next_or_tick, open_turn
+
+    api = APIRouter()
+
+    def store() -> Any:
+        if ctx.store is None:
+            raise BadRequest(
+                "the session store is not available", status=503, code="store_unavailable"
+            )
+        return ctx.store
+
+    async def canonical() -> CanonicalChat:
+        return await run_blocking(_ensure_canonical, store(), label="bot chat")
+
+    async def chat(request: Request) -> Response:
+        found = await canonical()
+        return JSONResponse(
+            {"object": "indus.bot_chat", "session_id": found.session_id, "created": found.created}
+        )
+
+    async def dm(request: Request) -> Response:
+        body = await read_json(request, MAX_DM_BYTES)
+        if not isinstance(body, dict):
+            raise BadRequest("the body must be a JSON object", code="invalid_body")
+        fields = cast(dict[str, Any], body)
+        unknown = set(fields) - {"message", "author"}
+        if unknown:
+            raise BadRequest(f"unknown fields: {', '.join(sorted(unknown))}", code="invalid_body")
+        message = fields.get("message")
+        if not isinstance(message, str) or not message.strip():
+            raise BadRequest("message must be non-empty text", code="invalid_body", param="message")
+        author = fields.get("author")
+        if author is not None and (not isinstance(author, str) or len(author) > 128):
+            raise BadRequest("author must be a short name", code="invalid_body", param="author")
+        found = await canonical()
+        if not ctx.gate.enter():
+            return _failure(429, "target_busy", "too many turns are running here; try later")
+        try:
+            turn = await open_turn(ctx, found.session_id, message, run_context="unattended")
+        except BadRequest as exc:
+            ctx.gate.leave()
+            return _failure(exc.status, _reason_of(exc), exc.message)
+        except BaseException:
+            ctx.gate.leave()
+            raise
+        pending = asyncio.ensure_future(turn.outcome())
+        done, outcome = await next_or_tick(pending, ctx.clock, RELAY_CAP_S)
+        if not done:
+            pending.add_done_callback(lambda _f: ctx.gate.leave())
+            return _failure(
+                504,
+                "delivery_timeout",
+                f"the turn is still running after {int(RELAY_CAP_S)} s; the message is in the "
+                "bot's chat and will be answered there: do not resend",
+                accepted=True,
+            )
+        ctx.gate.leave()
+        problem = failure_text(outcome)
+        text = outcome.text or ""
+        if problem and not text.strip():
+            return _failure(502, classify_failure(problem), problem)
+        return JSONResponse(
+            {
+                "object": "indus.bot_dm",
+                "session_id": outcome.session_id,
+                "reply": "" if is_silence(text) else text,
+            }
+        )
+
+    api.add_api_route(CHAT_PATH, chat, methods=["POST"])
+    api.add_api_route(DM_PATH, dm, methods=["POST"])
+    return api
+
+
+# -- sending side: local delivery ---------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class OneShotResult:
+    """A finished one-shot child: its exit code (None: stopped at the cap), stdout and its
+    ``--usage-file`` report."""
+
+    code: int | None
+    stdout: str
+    report: Mapping[str, Any] = field(default_factory=lambda: dict[str, Any]())
+
+
+type OneShotRunner = Callable[[list[str], dict[str, str], Path, float], Awaitable[OneShotResult]]
+
+
+async def _kill_group(proc: asyncio.subprocess.Process) -> None:
+    with contextlib.suppress(ProcessLookupError, PermissionError):
+        os.killpg(proc.pid, signal.SIGKILL)  # the group of the child we started, by its own pid
+    with contextlib.suppress(Exception):
+        await proc.wait()
+
+
+def _read_report(path: Path) -> dict[str, Any]:
+    try:
+        data: object = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    return cast(dict[str, Any], data) if isinstance(data, dict) else {}
+
+
+def _cap_runner(scope: Scope) -> OneShotRunner:
+    async def run(argv: list[str], env: dict[str, str], report: Path, cap: float) -> OneShotResult:
+        return await run_oneshot(argv, env, report, cap, sleep=scope.clock.sleep)
+
+    return run
+
+
+async def run_oneshot(
+    argv: list[str],
+    env: dict[str, str],
+    report: Path,
+    cap: float,
+    *,
+    sleep: Callable[[float], Awaitable[None]],
+) -> OneShotResult:
+    """Start ``argv`` in its own process group; stop the whole group past ``cap`` seconds."""
+    proc = await asyncio.create_subprocess_exec(
+        *argv,
+        env=env,
+        stdin=asyncio.subprocess.DEVNULL,
+        stdout=asyncio.subprocess.PIPE,
+        stderr=asyncio.subprocess.DEVNULL,
+        start_new_session=True,
+    )
+    talk = asyncio.ensure_future(proc.communicate())
+    tick = asyncio.ensure_future(sleep(cap))
+    try:
+        await asyncio.wait({talk, tick}, return_when=asyncio.FIRST_COMPLETED)
+    except BaseException:
+        talk.cancel()
+        await _kill_group(proc)
+        raise
+    finally:
+        tick.cancel()
+    if not talk.done():
+        talk.cancel()
+        await _kill_group(proc)
+        return OneShotResult(None, "", _read_report(report))
+    out, _ = talk.result()
+    return OneShotResult(
+        proc.returncode, (out or b"").decode("utf-8", "replace"), _read_report(report)
+    )
+
+
+def _outcome_of(result: OneShotResult, session_id: str) -> DeliveryOutcome:
+    failure = result.report.get("failure")
+    said = failure if isinstance(failure, str) and failure.strip() else None
+    if result.code is None:
+        return DeliveryOutcome.failed(
+            "delivery_timeout",
+            f"the bot's turn did not finish within {int(RELAY_CAP_S)} s and was stopped",
+        )
+    if result.code == 0:
+        reply = result.stdout.strip()
+        return DeliveryOutcome.delivered("" if is_silence(reply) else reply, session_id)
+    if result.code == 1 and result.report.get("completed"):
+        return DeliveryOutcome.delivered("", session_id)  # the bot answered without text
+    if result.code == 3:
+        return DeliveryOutcome.failed(
+            "target_busy", "the bot's chat is waiting behind a turn its daemon lost"
+        )
+    if result.code == 130:
+        return DeliveryOutcome.failed("unknown", "the bot's turn was interrupted")
+    if result.code == 1 and said is None:
+        return DeliveryOutcome.failed("runtime_offline", "the bot's runtime could not start")
+    text = redact_text(said or f"the bot's turn failed (exit {result.code})")[:500]
+    return DeliveryOutcome.failed(classify_failure(said), text)
+
+
+class LocalBotTransport:
+    """``message_agent``'s delivery path for one sending profile (see the module notes)."""
+
+    def __init__(
+        self,
+        scope: Scope,
+        *,
+        peers: PeerClient | None = None,
+        runner: OneShotRunner | None = None,
+        python: str | None = None,
+    ) -> None:
+        self.scope = scope
+        self.peers = peers if peers is not None else PeerClient(scope)
+        self.runner = runner if runner is not None else _cap_runner(scope)
+        self.python = python or sys.executable
+
+    async def deliver(self, delivery: BotDelivery) -> DeliveryOutcome:
+        target = delivery.target
+        if target.profile is not None:
+            return await self._peer(PeerTarget(target.name, target.profile), delivery)
+        name = target.name
+        if name == self.scope.profile_id:
+            return DeliveryOutcome.failed("missing_config", "a bot cannot message itself")
+        if is_valid_id(name) and is_live(self.scope.root, name):
+            return await self._local(name, delivery)
+        if PeerBook(self.scope).get(name) is not None:
+            return await self._peer(PeerTarget(name), delivery)
+        return DeliveryOutcome.failed(
+            "missing_config", f"no local profile and no registered peer is named {name!r}"
+        )
+
+    async def _peer(self, target: PeerTarget, delivery: BotDelivery) -> DeliveryOutcome:
+        try:
+            got = await self.peers.dm(target, delivery.message, author=delivery.sender)
+        except PeerError as exc:
+            return DeliveryOutcome.failed(exc.reason, exc.message)
+        return DeliveryOutcome.delivered("" if is_silence(got.reply) else got.reply, got.session_id)
+
+    def _target_scope(self, name: str) -> Scope:
+        home = profile_home(self.scope.root, name)
+        return make_scope(home, env=self.scope.env, clock=self.scope.clock)
+
+    @staticmethod
+    def _ensure_in(target: Scope) -> CanonicalChat:
+        with registry.shared(target) as store:
+            return _ensure_canonical(store)
+
+    async def _local(self, name: str, delivery: BotDelivery) -> DeliveryOutcome:
+        target = self._target_scope(name)
+        chat = await run_blocking(self._ensure_in, target, label="bot chat")
+        folder = mkdir_in_profile(self.scope.home, Path("cache") / "bots")
+        report = folder / f"delivery-{secrets.token_hex(8)}.json"
+        argv = [
+            self.python,
+            "-m",
+            "indus",
+            "-p",
+            name,
+            "-z",
+            delivery.message,
+            "--resume",
+            chat.session_id,
+            "--usage-file",
+            str(report),
+        ]
+        try:
+            result = await self.runner(argv, child_env(target), report, RELAY_CAP_S)
+        finally:
+            with contextlib.suppress(OSError):
+                report.unlink()
+        return _outcome_of(result, chat.session_id)
+
+
+# -- the self-chat cron target ------------------------------------------------------------------
+
+
+async def deliver_self_chat(request: DeliveryRequest) -> DeliveryReceipt:
+    """Add the job's output to its own profile's canonical chat as an incoming message."""
+    scope = request.scope
+    chat = request.target.chat_id
+    if chat not in (None, "", scope.profile_id):
+        return DeliveryReceipt(False, error="self-chat reaches only this profile's own chat")
+
+    def inject() -> tuple[str, int]:
+        with registry.shared(scope) as store:
+            return _inject_incoming(store, request.text)
+
+    session_id, row = await run_blocking(inject, label="self-chat")
+    return DeliveryReceipt(True, message_id=f"{session_id}:{row}")
+
+
+_self_chat_lock = threading.Lock()
+_self_chat_users = 0
+_self_chat_undo: Callable[[], None] | None = None
+
+
+def install_self_chat() -> Callable[[], None]:
+    """Register the ``self-chat`` deliverer in cron's table while at least one caller holds it
+    (one per delivery router; several may live in one process); returns this caller's undo."""
+    global _self_chat_users, _self_chat_undo
+    with _self_chat_lock:
+        _self_chat_users += 1
+        if _self_chat_undo is None:
+            _self_chat_undo = cron_delivery.register_deliverer(SELF_CHAT, deliver_self_chat)
+    released = False
+
+    def undo() -> None:
+        global _self_chat_users, _self_chat_undo
+        nonlocal released
+        with _self_chat_lock:
+            if released:
+                return
+            released = True
+            _self_chat_users -= 1
+            if _self_chat_users == 0 and _self_chat_undo is not None:
+                _self_chat_undo()
+                _self_chat_undo = None
+
+    return undo
diff --git a/src/indus/gateway/rooms/rpc.py b/src/indus/gateway/rooms/rpc.py
new file mode 100644
index 0000000..9de608e
--- /dev/null
+++ b/src/indus/gateway/rooms/rpc.py
@@ -0,0 +1,390 @@
+"""The ``groups.*`` methods the desktop and TUI room views call (P24-06).
+
+``GroupsRpc(store, driver, process_generation=)`` answers each method with plain JSON: params are
+checked against a strict model (an unknown key is refused), results are dictionaries. The table is
+transport-free; the daemon's dispatcher mounts ``handlers()`` once the names are declared in the
+protocol (wiring for the lead).
+
+Methods: ``groups.capabilities``, ``groups.list``, ``groups.create``, ``groups.state``,
+``groups.log``, ``groups.send``, ``groups.rename``, ``groups.disband``, ``groups.stop``,
+``groups.retry``, ``groups.status``, ``groups.promote``, ``groups.demote``.
+
+``groups.send`` stores the person's message under an id derived from the client's retry key (a
+retried send is a no-op) and, unless ``detect_stop`` is false, holds every member a stop directive
+names (``member.held`` event, its queued turns cancelled). ``groups.stop`` logs
+``room.stop_requested``, cancels queued turns and asks running ones to stop (two-phase).
+
+Authority transfer is an **operator recovery procedure, not an atomic hand-over**:
+
+1. fence the old authority yourself (stop its gateway and keep it from restarting): nothing here
+   can reach another host, and a stop request or a lost connection is no proof it stopped;
+2. ``groups.promote {room_id, confirm: true}`` on the replacement claims the room at the next
+   epoch (without ``confirm: true`` it is refused with ``rooms.confirm_required``);
+3. ``groups.demote {room_id, observed_gateway_id, observed_epoch}`` on the old host, before it
+   writes again, adopts that newer lineage; it refuses anything that is not strictly newer.
+
+Promoting while the old host can still write lets two stores take messages and diverge; neither
+call merges histories.
+"""
+
+from __future__ import annotations
+
+import hashlib
+from collections import Counter
+from collections.abc import Callable, Mapping
+from typing import Any, Final
+
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
+
+from indus.gateway.rooms.driver import (
+    BadTransition,
+    DriverError,
+    RoomDriver,
+    StaleTask,
+    Task,
+    stop_directives,
+)
+from indus.state.rooms import (
+    PROTOCOL_VERSION,
+    RoomAuthorityConflict,
+    RoomError,
+    RoomStore,
+    user_event_id,
+)
+
+__all__ = ["METHODS", "ConfirmRequired", "GroupsRpc", "GroupsRpcError"]
+
+RETRY_LEASE_S: Final = 60.0
+_LIVE: Final = ("queued", "running", "stopping")
+_RETRYABLE: Final = ("indeterminate", "deferred")
+
+
+class GroupsRpcError(RoomError):
+    """Bad params or an unknown method."""
+
+
+class ConfirmRequired(RoomError):
+    """Promotion needs the operator's ``confirm: true``."""
+
+    default_code = "rooms.confirm_required"
+
+
+class _Params(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+
+
+class _Room(_Params):
+    room_id: str
+
+
+class _List(_Params):
+    limit: int = 100
+    offset: int = 0
+    include_disbanded: bool = False
+
+
+class _Create(_Room):
+    name: str
+    members: list[dict[str, Any]]
+
+
+class _State(_Room):
+    include_disbanded: bool = False
+
+
+class _Log(_Room):
+    since_seq: int = 0
+    limit: int = 100
+    include_disbanded: bool = False
+
+
+class _Send(_Room):
+    client_event_id: str
+    text: str = Field(min_length=1)
+    thread_id: str | None = None
+    author: str = "person"
+    detect_stop: bool = True
+
+
+class _Rename(_Room):
+    event_id: str
+    name: str
+
+
+class _Stop(_Room):
+    cancel_id: str
+
+
+class _Retry(_Room):
+    task_id: str
+
+
+class _Promote(_Room):
+    confirm: bool = False
+    reason: str = "authority-unreachable"
+
+
+class _Demote(_Room):
+    observed_gateway_id: str
+    observed_epoch: int
+
+
+def _handle(member: Mapping[str, Any]) -> str | None:
+    for key in ("handle", "profile", "id"):
+        value = member.get(key)
+        if isinstance(value, str) and value.strip():
+            return value.strip()
+    return None
+
+
+def _short(*parts: str) -> str:
+    return hashlib.sha256("\n".join(parts).encode("utf-8")).hexdigest()[:32]
+
+
+class GroupsRpc:
+    """The ``groups.*`` handler table over one room store and its driver."""
+
+    def __init__(self, store: RoomStore, driver: RoomDriver, *, process_generation: str) -> None:
+        self.store = store
+        self.driver = driver
+        self.process_generation = process_generation
+        self._table: dict[str, tuple[type[_Params], Callable[[Any], dict[str, Any]]]] = {
+            "groups.capabilities": (_Params, self._capabilities),
+            "groups.list": (_List, self._list),
+            "groups.create": (_Create, self._create),
+            "groups.state": (_State, self._state),
+            "groups.log": (_Log, self._log),
+            "groups.send": (_Send, self._send),
+            "groups.rename": (_Rename, self._rename),
+            "groups.disband": (_Room, self._disband),
+            "groups.stop": (_Stop, self._stop),
+            "groups.retry": (_Retry, self._retry),
+            "groups.status": (_Room, self._status),
+            "groups.promote": (_Promote, self._promote),
+            "groups.demote": (_Demote, self._demote),
+        }
+
+    # -- dispatch --------------------------------------------------------------------------------
+
+    def handlers(self) -> dict[str, Callable[[Mapping[str, Any]], dict[str, Any]]]:
+        return {name: (lambda params, n=name: self.call(n, params)) for name in self._table}
+
+    def call(self, method: str, params: Mapping[str, Any] | None = None) -> dict[str, Any]:
+        entry = self._table.get(method)
+        if entry is None:
+            raise GroupsRpcError(f"unknown method {method!r}")
+        model, handler = entry
+        try:
+            parsed = model.model_validate(dict(params or {}))
+        except ValidationError as exc:
+            first = exc.errors()[0]
+            where = ".".join(str(p) for p in first.get("loc", ())) or "params"
+            raise GroupsRpcError(f"bad params at {where}: {first.get('msg', 'invalid')}") from None
+        return handler(parsed)
+
+    # -- helpers ---------------------------------------------------------------------------------
+
+    def _authority(self, room_id: str) -> tuple[str, int]:
+        room = self.store.get_room(room_id)
+        return room.authority, room.epoch
+
+    def _own_authority(self, room_id: str) -> tuple[str, int]:
+        authority, epoch = self._authority(room_id)
+        if authority != self.store.gateway_id:
+            raise RoomAuthorityConflict("this gateway is not the room's authority; ask that one")
+        return authority, epoch
+
+    # -- methods ---------------------------------------------------------------------------------
+
+    def _capabilities(self, _: _Params) -> dict[str, Any]:
+        return {
+            "protocol": PROTOCOL_VERSION,
+            "driver": True,
+            "gateway_id": self.store.gateway_id,
+            "methods": sorted(self._table),
+            "authority_transfer": "operator recovery; not atomic",
+        }
+
+    def _list(self, p: _List) -> dict[str, Any]:
+        rooms = self.store.list_rooms(
+            limit=p.limit, offset=p.offset, include_disbanded=p.include_disbanded
+        )
+        return {"rooms": [r.to_dict() for r in rooms]}
+
+    def _create(self, p: _Create) -> dict[str, Any]:
+        room = self.store.create_room(p.room_id, p.name, p.members)
+        return {"room": room.to_dict(), "idempotent": room.idempotent}
+
+    def _state(self, p: _State) -> dict[str, Any]:
+        room = self.store.get_room(p.room_id, include_disbanded=p.include_disbanded)
+        out: dict[str, Any] = {"room": room.to_dict()}
+        claim = self.store.authority_claim(p.room_id, include_disbanded=p.include_disbanded)
+        if claim is not None:
+            out["authority_claim"] = claim.to_dict()
+        return out
+
+    def _log(self, p: _Log) -> dict[str, Any]:
+        page = self.store.read_events(
+            p.room_id, since_seq=p.since_seq, limit=p.limit, include_disbanded=p.include_disbanded
+        )
+        return page.to_dict()
+
+    def _send(self, p: _Send) -> dict[str, Any]:
+        authority, epoch = self._own_authority(p.room_id)
+        room = self.store.get_room(p.room_id)
+        payload: dict[str, Any] = {"text": p.text}
+        if p.thread_id is not None:
+            payload["thread_id"] = p.thread_id
+        event = self.store.append_event(
+            p.room_id,
+            user_event_id(p.client_event_id),
+            "message.user",
+            {"kind": "user", "id": p.author},
+            payload,
+            authority=authority,
+            epoch=epoch,
+        )
+        handles = [h for h in (_handle(m) for m in room.members) if h]
+        held = sorted(stop_directives(p.text, handles, enabled=p.detect_stop))
+        cancelled: list[str] = []
+        for handle in held:
+            self.store.append_event(
+                p.room_id,
+                f"held:{_short(event.event_id, handle)}",
+                "member.held",
+                {"kind": "gateway", "id": authority},
+                {"member": handle, "source_seq": event.seq},
+                authority=authority,
+                epoch=epoch,
+            )
+            cancelled += self._cancel_queued(p.room_id, f"hold:{event.seq}", target=handle)
+        return {"event": event.to_dict(), "held": held, "cancelled": cancelled}
+
+    def _cancel_queued(self, room_id: str, cancel_id: str, *, target: str | None) -> list[str]:
+        done: list[str] = []
+        for task in self.driver.list_tasks(room_id, status="queued"):
+            if target is not None and task.payload.get("target") != target:
+                continue
+            try:
+                self.driver.cancel_queued(
+                    task.key, cancel_id=cancel_id, expected_cancel_gen=task.cancel_gen
+                )
+            except (StaleTask, BadTransition):
+                continue  # it moved on meanwhile; the next pass sees its new state
+            done.append(task.key.task_id)
+        return done
+
+    def _rename(self, p: _Rename) -> dict[str, Any]:
+        authority, epoch = self._own_authority(p.room_id)
+        room = self.store.rename_room(
+            p.room_id, p.event_id, p.name, authority=authority, epoch=epoch
+        )
+        return {"room": room.to_dict(), "idempotent": room.idempotent}
+
+    def _disband(self, p: _Room) -> dict[str, Any]:
+        authority, epoch = self._own_authority(p.room_id)
+        done = self.store.disband_room(p.room_id, authority=authority, epoch=epoch)
+        return {
+            "room_id": done.room_id,
+            "disbanded_at": done.disbanded_at,
+            "idempotent": done.idempotent,
+        }
+
+    def _stop(self, p: _Stop) -> dict[str, Any]:
+        authority, epoch = self._own_authority(p.room_id)
+        event = self.store.request_stop(p.room_id, p.cancel_id, authority=authority, epoch=epoch)
+        cancelled = self._cancel_queued(p.room_id, p.cancel_id, target=None)
+        stopping: list[str] = []
+        for task in self.driver.list_tasks(p.room_id, status="running"):
+            try:
+                self.driver.begin_stop(
+                    task.key, cancel_id=p.cancel_id, expected_cancel_gen=task.cancel_gen
+                )
+            except (StaleTask, BadTransition):
+                continue
+            stopping.append(task.key.task_id)
+        return {"event": event.to_dict(), "cancelled": cancelled, "stopping": stopping}
+
+    def _find(self, room_id: str, task_id: str) -> Task:
+        for task in self.driver.list_tasks(room_id):
+            if task.key.task_id == task_id:
+                return task
+        raise DriverError("no task has this id in this room")
+
+    def _retry(self, p: _Retry) -> dict[str, Any]:
+        """An operator's explicit retry of a deferred or indeterminate turn (it may run twice)."""
+        self._own_authority(p.room_id)
+        task = self._find(p.room_id, p.task_id)
+        if task.status not in _RETRYABLE:
+            raise BadTransition(f"a {task.status} task is not waiting for a retry")
+        lease = self.driver.acquire_lease(
+            p.room_id, process_generation=self.process_generation, ttl_seconds=RETRY_LEASE_S
+        )
+        move = (
+            self.driver.requeue_deferred
+            if task.status == "deferred"
+            else self.driver.requeue_indeterminate
+        )
+        done = move(
+            task.key, lease, expected_exec_gen=task.exec_gen, expected_cancel_gen=task.cancel_gen
+        )
+        return {"task": done.to_dict()}
+
+    def _status(self, p: _Room) -> dict[str, Any]:
+        tasks = self.driver.list_tasks(p.room_id)
+        counts = Counter(t.status for t in tasks)
+        return {
+            "working": any(counts.get(s) for s in _LIVE),
+            "blocked": bool(counts.get("indeterminate") or counts.get("stopping")),
+            "counts": dict(counts),
+            "pending_actions": [
+                {"kind": "retry", "task_id": t.key.task_id} for t in tasks if t.status in _RETRYABLE
+            ],
+        }
+
+    def _promote(self, p: _Promote) -> dict[str, Any]:
+        if p.confirm is not True:
+            raise ConfirmRequired(
+                "promotion is an operator recovery step: fence the old authority first, then "
+                "send confirm: true"
+            )
+        authority, epoch = self._authority(p.room_id)
+        me = self.store.gateway_id
+        if authority == me:
+            return {"authority": me, "epoch": epoch, "idempotent": True, "reason": p.reason}
+        room = self.store.claim_authority(
+            p.room_id,
+            expected=authority,
+            expected_epoch=epoch,
+            new=me,
+            event_id=f"promote-{epoch + 1}-{_short(me)}",
+        )
+        return {
+            "authority": room.authority,
+            "epoch": room.epoch,
+            "idempotent": room.idempotent,
+            "reason": p.reason,
+        }
+
+    def _demote(self, p: _Demote) -> dict[str, Any]:
+        room = self.store.record_authority_lost(
+            p.room_id, observed=p.observed_gateway_id, observed_epoch=p.observed_epoch
+        )
+        return {"authority": room.authority, "epoch": room.epoch, "idempotent": room.idempotent}
+
+
+METHODS: Final = (
+    "groups.capabilities",
+    "groups.list",
+    "groups.create",
+    "groups.state",
+    "groups.log",
+    "groups.send",
+    "groups.rename",
+    "groups.disband",
+    "groups.stop",
+    "groups.retry",
+    "groups.status",
+    "groups.promote",
+    "groups.demote",
+)
