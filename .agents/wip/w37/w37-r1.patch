+class Runner:
+    def __init__(self, result: OneShotResult) -> None:
+        self.result = result
+        self.calls: list[tuple[list[str], dict[str, str], float]] = []
+
+    async def __call__(
+        self, argv: list[str], env: dict[str, str], report: Path, cap: float
+    ) -> OneShotResult:
+        self.calls.append((argv, env, cap))
+        return self.result
+
