+        socket.push({"type": "result", "id": sent["id"], "result": {"ok": True, "message_id": "9"}})
+        await rig.idle()
+        assert pending.result() == {"ok": True, "message_id": "9"}
+        await rig.settle(stopping)
+        assert rig.transport.state == "closed"
+
+    run(main)
