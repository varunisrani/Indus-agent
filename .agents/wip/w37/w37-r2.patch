index 0000000..8f4ed37
--- /dev/null
+++ b/src/indus/gateway/adapters/a2a/protocol.py
@@ -0,0 +1,386 @@
+# pyright: strict
+"""A2A (Agent2Agent) protocol v1.0 shapes and the per-peer task store (P24-10).
+
+Pinned to the A2A specification tag 1.0.x: JSON-RPC 2.0 over HTTP, the agent card at
+``/.well-known/agent-card.json``, PascalCase methods (the 0.3 slash names are accepted as
+aliases), task states and roles in SCREAMING_SNAKE_CASE, parts told apart by which member they
+carry (``text``, ``url``, ``raw``, ``data``). Error codes: the JSON-RPC ones plus the A2A block
+(−32001 task not found, −32002 not cancelable, −32003 push notifications not supported, −32004
+unsupported operation); in the implementation range, −32050 answers a call without valid
+credentials and −32051 one over the per-peer rate.
+
+Everything here is plain data: the adapter (``adapter.py``) serves it and the ``a2a_call`` tool
+(``tools.py``) speaks it to other agents.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import uuid
+from collections import OrderedDict
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, replace
+from datetime import UTC, datetime
+from typing import Any, Final, cast
+
+__all__ = [
+    "CARD_PATH",
+    "LEGACY_CARD_PATH",
+    "METHODS",
+    "PROTOCOL_VERSION",
+    "A2AError",
+    "SendRequest",
+    "TaskRecord",
+    "TaskStore",
+    "agent_card",
+    "artifact_update",
+    "make_message",
+    "message_text",
+    "read_send_params",
+    "rpc_error",
+    "rpc_result",
+    "sse_frame",
+    "status_update",
+    "task_view",
+    "text_part",
+]
+
+PROTOCOL_VERSION: Final = "1.0"
+CARD_PATH: Final = "/.well-known/agent-card.json"
+LEGACY_CARD_PATH: Final = "/.well-known/agent.json"
+
+SUBMITTED: Final = "TASK_STATE_SUBMITTED"
+WORKING: Final = "TASK_STATE_WORKING"
+INPUT_REQUIRED: Final = "TASK_STATE_INPUT_REQUIRED"
+COMPLETED: Final = "TASK_STATE_COMPLETED"
+FAILED: Final = "TASK_STATE_FAILED"
+CANCELED: Final = "TASK_STATE_CANCELED"
+REJECTED: Final = "TASK_STATE_REJECTED"
+STATES: Final = frozenset(
+    {SUBMITTED, WORKING, INPUT_REQUIRED, COMPLETED, FAILED, CANCELED, REJECTED}
+)
+# A task in one of these is finished for this request (input-required ends the call too: the peer
+# answers with a new message in the same context).
+TERMINAL: Final = frozenset({INPUT_REQUIRED, COMPLETED, FAILED, CANCELED, REJECTED})
+
+ROLE_USER: Final = "ROLE_USER"
+ROLE_AGENT: Final = "ROLE_AGENT"
+
+PARSE_ERROR: Final = -32700
+INVALID_REQUEST: Final = -32600
+METHOD_NOT_FOUND: Final = -32601
+INVALID_PARAMS: Final = -32602
+INTERNAL_ERROR: Final = -32603
+TASK_NOT_FOUND: Final = -32001
+TASK_NOT_CANCELABLE: Final = -32002
+PUSH_NOT_SUPPORTED: Final = -32003
+UNSUPPORTED_OPERATION: Final = -32004
+UNAUTHORIZED: Final = -32050
+RATE_LIMITED: Final = -32051
+
+# JSON-RPC method → what it does here.
+METHODS: Final[Mapping[str, str]] = {
+    "SendMessage": "send",
+    "message/send": "send",
+    "SendStreamingMessage": "stream",
+    "message/stream": "stream",
+    "GetTask": "get",
+    "tasks/get": "get",
+    "CancelTask": "cancel",
+    "tasks/cancel": "cancel",
+    "ListTasks": "list",
+    "tasks/list": "list",
+    "SubscribeToTask": "unsupported",
+    "tasks/resubscribe": "unsupported",
+    "GetExtendedAgentCard": "unsupported",
+    "CreateTaskPushNotificationConfig": "push",
+    "GetTaskPushNotificationConfig": "push",
+    "ListTaskPushNotificationConfigs": "push",
+    "DeleteTaskPushNotificationConfig": "push",
+    "tasks/pushNotificationConfig/set": "push",
+    "tasks/pushNotificationConfig/get": "push",
+    "tasks/pushNotificationConfig/list": "push",
+    "tasks/pushNotificationConfig/delete": "push",
+}
+# The 1.0 method names answer ``{"task": ...}`` for a send; the 0.3 aliases a bare task.
+WRAPPED_SEND: Final = frozenset({"SendMessage", "SendStreamingMessage"})
+
+CONTEXT_ID: Final = re.compile(r"^[A-Za-z0-9_.:-]{1,128}$")
+MAX_TEXT: Final = 256 * 1024
+TERMINAL_KEPT: Final = 500
+PAGE_MAX: Final = 100
+
+
+class A2AError(Exception):
+    """A JSON-RPC error to answer with."""
+
+    def __init__(self, code: int, message: str) -> None:
+        super().__init__(message)
+        self.code = code
+        self.message = message
+
+
+# -- JSON-RPC ------------------------------------------------------------------------------------
+
+
+def rpc_result(request_id: object, result: object) -> dict[str, Any]:
+    return {"jsonrpc": "2.0", "id": request_id, "result": result}
+
+
+def rpc_error(request_id: object, code: int, message: str) -> dict[str, Any]:
+    return {"jsonrpc": "2.0", "id": request_id, "error": {"code": code, "message": message}}
+
+
+def sse_frame(request_id: object, payload: Mapping[str, Any]) -> str:
+    """One stream response as a server-sent event (a full JSON-RPC envelope per event)."""
+    return f"data: {json.dumps(rpc_result(request_id, dict(payload)), ensure_ascii=False)}\n\n"
+
+
+# -- messages and parts --------------------------------------------------------------------------
+
+
+def text_part(text: str) -> dict[str, Any]:
+    return {"text": text}
+
+
+def make_message(
+    role: str,
+    text: str,
+    *,
+    context_id: str | None = None,
+    task_id: str | None = None,
+    message_id: str | None = None,
+) -> dict[str, Any]:
+    message: dict[str, Any] = {
+        "messageId": message_id or uuid.uuid4().hex,
+        "role": role,
+        "parts": [text_part(text)],
+    }
+    if context_id:
+        message["contextId"] = context_id
+    if task_id:
+        message["taskId"] = task_id
+    return message
+
+
+def _part_text(part: Mapping[str, Any]) -> str | None:
+    text = part.get("text")
+    if isinstance(text, str):
+        return text
+    name = part.get("filename") or part.get("name") or ""
+    url = part.get("url")
+    if isinstance(url, str) and url:
+        return f"[file {name}: {url}]" if name else f"[file: {url}]"
+    raw = part.get("raw")
+    if isinstance(raw, str):
+        return (
+            f"[file {name}: {len(raw)} base64 characters, not opened]"
+            if name
+            else (f"[file: {len(raw)} base64 characters, not opened]")
+        )
+    if "data" in part:
+        try:
+            return "[data]\n" + json.dumps(part.get("data"), ensure_ascii=False, sort_keys=True)
+        except (TypeError, ValueError):
+            return "[data]"
+    return None
+
+
+def message_text(message: object) -> str:
+    """The readable text of a message (or of anything with ``parts``)."""
+    if not isinstance(message, Mapping):
+        return ""
+    parts = cast(Mapping[str, Any], message).get("parts")
+    if not isinstance(parts, list):
+        return ""
+    chunks: list[str] = []
+    for part in cast(list[object], parts):
+        if isinstance(part, Mapping):
+            found = _part_text(cast(Mapping[str, Any], part))
+            if found:
+                chunks.append(found)
+    return "\n".join(chunks).strip()
+
+
+@dataclass(frozen=True)
+class SendRequest:
+    text: str
+    context_id: str | None
+    message_id: str | None
+
+
+def read_send_params(params: object) -> SendRequest:
+    """The message of a ``SendMessage`` call (``A2AError`` −32602 when it cannot be read)."""
+    if not isinstance(params, Mapping):
+        raise A2AError(INVALID_PARAMS, "params must be an object")
+    message = cast(Mapping[str, Any], params).get("message")
+    if not isinstance(message, Mapping):
+        raise A2AError(INVALID_PARAMS, "params.message must be an object")
+    body = cast(Mapping[str, Any], message)
+    if not isinstance(body.get("parts"), list):
+        raise A2AError(INVALID_PARAMS, "params.message.parts must be a list")
+    role = body.get("role")
+    if role is not None and role not in (ROLE_USER, "user"):
+        raise A2AError(INVALID_PARAMS, "params.message.role must be ROLE_USER")
+    context = body.get("contextId")
+    if context is not None and (not isinstance(context, str) or not CONTEXT_ID.match(context)):
+        raise A2AError(INVALID_PARAMS, "contextId must be 1-128 characters of [A-Za-z0-9_.:-]")
+    message_id = body.get("messageId")
+    text = message_text(body)
+    if len(text) > MAX_TEXT:
+        raise A2AError(INVALID_PARAMS, f"the message is longer than {MAX_TEXT} characters")
+    return SendRequest(
+        text=text,
+        context_id=context if isinstance(context, str) else None,
+        message_id=message_id if isinstance(message_id, str) and message_id else None,
+    )
+
+
+# -- the card ------------------------------------------------------------------------------------
+
+
+def agent_card(
+    *,
+    name: str,
+    description: str,
+    url: str,
+    skills: Iterable[Mapping[str, Any]] = (),
+    version: str = "1.0.0",
+) -> dict[str, Any]:
+    """Our agent card: one JSON-RPC interface, bearer auth, streaming, no push notifications."""
+    listed = [dict(s) for s in skills] or [
+        {
+            "id": "general",
+            "name": "General assistance",
+            "description": "Answers requests and does tasks with its tools.",
+            "tags": ["general"],
+        }
+    ]
+    return {
+        "name": name,
+        "description": description,
+        "version": version,
+        "supportedInterfaces": [
+            {"url": url, "protocolBinding": "JSONRPC", "protocolVersion": PROTOCOL_VERSION}
+        ],
+        "capabilities": {"streaming": True, "pushNotifications": False},
+        "securitySchemes": {"bearer": {"httpAuthSecurityScheme": {"scheme": "Bearer"}}},
+        "securityRequirements": [{"schemes": {"bearer": {"list": []}}}],
+        "defaultInputModes": ["text/plain"],
+        "defaultOutputModes": ["text/plain"],
+        "skills": listed,
+    }
+
+
+# -- tasks ---------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class TaskRecord:
+    task_id: str
+    context_id: str
+    peer: str
+    state: str
+    reply: str = ""
+    updated: str = ""
+
+
+def _stamp(now: datetime) -> str:
+    return now.astimezone(UTC).isoformat(timespec="milliseconds").replace("+00:00", "Z")
+
+
+def task_view(record: TaskRecord) -> dict[str, Any]:
+    """A stored task as the A2A ``Task`` object."""
+    status: dict[str, Any] = {"state": record.state}
+    if record.updated:
+        status["timestamp"] = record.updated
+    view: dict[str, Any] = {"id": record.task_id, "contextId": record.context_id, "status": status}
+    if record.reply and record.state == COMPLETED:
+        view["artifacts"] = [
+            {"artifactId": f"{record.task_id}-reply", "parts": [text_part(record.reply)]}
+        ]
+    elif record.reply:
+        status["message"] = make_message(
+            ROLE_AGENT,
+            record.reply,
+            context_id=record.context_id,
+            task_id=record.task_id,
+            message_id=f"{record.task_id}-status",
+        )
+    return view
+
+
+def status_update(record: TaskRecord, *, with_message: bool) -> dict[str, Any]:
+    status: dict[str, Any] = {"state": record.state}
+    if record.updated:
+        status["timestamp"] = record.updated
+    if with_message and record.reply:
+        status["message"] = make_message(
+            ROLE_AGENT, record.reply, context_id=record.context_id, task_id=record.task_id
+        )
+    return {
+        "statusUpdate": {"taskId": record.task_id, "contextId": record.context_id, "status": status}
+    }
+
+
+def artifact_update(record: TaskRecord) -> dict[str, Any]:
+    artifact = {"artifactId": f"{record.task_id}-reply", "parts": [text_part(record.reply)]}
+    return {
+        "artifactUpdate": {
+            "taskId": record.task_id,
+            "contextId": record.context_id,
+            "artifact": artifact,
+        }
+    }
+
+
+class TaskStore:
+    """In-memory tasks, each owned by the peer that sent it; another peer never sees it."""
+
+    def __init__(self, *, kept: int = TERMINAL_KEPT) -> None:
+        self._tasks: OrderedDict[str, TaskRecord] = OrderedDict()
+        self._kept = kept
+
+    def create(self, peer: str, context_id: str, now: datetime) -> TaskRecord:
+        record = TaskRecord(
+            f"task-{uuid.uuid4().hex[:20]}", context_id, peer, SUBMITTED, "", _stamp(now)
+        )
+        self._tasks[record.task_id] = record
+        return record
+
+    def get(self, peer: str, task_id: str) -> TaskRecord | None:
+        record = self._tasks.get(task_id)
+        return record if record is not None and record.peer == peer else None
+
+    def move(self, task_id: str, state: str, now: datetime, reply: str = "") -> TaskRecord | None:
+        """Set a task's state; a finished task never changes again (None)."""
+        record = self._tasks.get(task_id)
+        if record is None or record.state in TERMINAL:
+            return None
+        moved = replace(record, state=state, reply=reply, updated=_stamp(now))
+        self._tasks[task_id] = moved
+        if state in TERMINAL:
+            self._trim()
+        return moved
+
+    def list(
+        self, peer: str, *, context_id: str = "", state: str = "", size: int = 50, offset: int = 0
+    ) -> tuple[list[TaskRecord], int, int]:
+        """The peer's tasks, newest first: ``(page, next offset or 0, total)``."""
+        size = max(1, min(size, PAGE_MAX))
+        found = [
+            r
+            for r in reversed(self._tasks.values())
+            if r.peer == peer
+            and (not context_id or r.context_id == context_id)
+            and (not state or r.state == state)
+        ]
+        page = found[offset : offset + size]
+        following = offset + size if offset + size < len(found) else 0
+        return page, following, len(found)
+
+    def _trim(self) -> None:
+        finished = [k for k, r in self._tasks.items() if r.state in TERMINAL]
+        for key in finished[: max(0, len(finished) - self._kept)]:
+            del self._tasks[key]
diff --git a/src/indus/gateway/adapters/a2a/tools.py b/src/indus/gateway/adapters/a2a/tools.py
new file mode 100644
index 0000000..372a183
--- /dev/null
+++ b/src/indus/gateway/adapters/a2a/tools.py
@@ -0,0 +1,281 @@
+# pyright: strict
+"""``a2a_call``: send a message to a configured A2A peer agent and return its answer (P24-10).
+
+Peers are configured per profile under ``a2a.peers.<name>``: ``url`` (the peer's JSON-RPC
+endpoint), ``trusted`` (default false) and ``timeout_seconds`` (default 120). A peer's key, when it
+needs one, lives in the secret store as ``INDUS_A2A_PEER_<NAME>_KEY`` and goes out as a bearer
+token; it never appears in the tool's arguments, result or errors.
+
+Before anything leaves: the message is masked for credential shapes and the profile's own secret
+values, and a privacy note is put in front of it (the receiving agent is told the content comes
+from an agent acting for its user and is confidential). The URL passes the shared SSRF policy
+(``indus.safety.url_policy``) and the connect-time transport that re-checks it, so link-local,
+loopback and private addresses are refused unless the peer is marked ``trusted: true``. Redirects
+are not followed.
+
+The result names the peer, the context id (pass it back as ``context_id`` to continue the
+conversation) and the task state; an ``input-required`` answer says so and how to reply.
+The tool is offered only when the profile has at least one peer configured.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import uuid
+from collections.abc import Callable, Mapping, Sequence
+from typing import Any, Final, cast
+
+import httpx
+
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.gateway.adapters.a2a import protocol as p
+from indus.safety.safe_transport import ConnectBlocked, safe_client
+from indus.safety.url_policy import Blocked, check_url_async
+from indus.tools.calls import ToolResult
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+__all__ = [
+    "A2A_CALL_SCHEMA",
+    "PRIVACY_NOTE",
+    "TOOL_NAME",
+    "TOOLSET",
+    "a2a_call",
+    "call_peer",
+    "peer_key_env",
+    "register_tools",
+]
+
+log = logging.getLogger(__name__)
+
+TOOL_NAME: Final = "a2a_call"
+TOOLSET: Final = "a2a"
+DEFAULT_TIMEOUT: Final = 120.0
+MAX_REPLY: Final = 64 * 1024
+PRIVACY_NOTE: Final = (
+    "[Sent by an Indus agent on behalf of its user. The content below may include that user's "
+    "private information: use it only to answer this request, keep it confidential and do not "
+    "pass it on.]\n\n"
+)
+
+type Resolver = Callable[[str, int | None], Sequence[str]]
+
+
+def peer_key_env(name: str) -> str:
+    return "INDUS_A2A_PEER_" + re.sub(r"[^A-Z0-9]", "_", name.upper()) + "_KEY"
+
+
+def _peers(scope: Scope) -> Mapping[str, Any]:
+    if scope.config is None:
+        return {}
+    try:
+        found = scope.config.get("a2a.peers")
+    except Exception:
+        return {}
+    return cast(Mapping[str, Any], found) if isinstance(found, Mapping) else {}
+
+
+def _known_secrets(scope: Scope) -> list[str]:
+    if scope.secrets is None:
+        return []
+    try:
+        return list(scope.secrets.known_values())
+    except Exception:
+        return []
+
+
+def _fixed(
+    transport: httpx.AsyncBaseTransport,
+) -> Callable[[str | None], httpx.AsyncBaseTransport]:
+    def factory(proxy: str | None) -> httpx.AsyncBaseTransport:
+        return transport
+
+    return factory
+
+
+def _error(text: str) -> str:
+    return ToolResult.error(text).text
+
+
+def _reply_of(result: object) -> tuple[str, str, str]:
+    """``(text, state, context)`` from a ``SendMessage`` result (task or message, 1.0 or 0.3)."""
+    if not isinstance(result, Mapping):
+        return "", "", ""
+    body = cast(Mapping[str, Any], result)
+    inner = body.get("task") or body.get("message") or body
+    if not isinstance(inner, Mapping):
+        return "", "", ""
+    item = cast(Mapping[str, Any], inner)
+    context = item.get("contextId")
+    status = item.get("status")
+    state = ""
+    text = ""
+    artifacts = item.get("artifacts")
+    for artifact in cast(list[object], artifacts) if isinstance(artifacts, list) else []:
+        text = p.message_text(artifact)
+        if text:
+            break
+    if isinstance(status, Mapping):
+        found = cast(Mapping[str, Any], status)
+        state = str(found.get("state") or "")
+        if not text:
+            text = p.message_text(found.get("message"))
+    if not text and "parts" in item:
+        text = p.message_text(item)
+    return text, state, context if isinstance(context, str) else ""
+
+
+async def call_peer(
+    scope: Scope,
+    name: str,
+    message: str,
+    *,
+    context_id: str | None = None,
+    inner_transport: httpx.AsyncBaseTransport | None = None,
+    resolver: Resolver | None = None,
+) -> str:
+    """Send ``message`` to the configured peer ``name``; the text the model sees."""
+    raw = _peers(scope).get(name)
+    if not isinstance(raw, Mapping):
+        known = ", ".join(sorted(_peers(scope))) or "none"
+        return _error(f"unknown A2A peer {name!r} (configured: {known}); add it under a2a.peers")
+    peer = cast(Mapping[str, Any], raw)
+    url = peer.get("url")
+    if not isinstance(url, str) or not url.strip():
+        return _error(f"A2A peer {name!r} has no url")
+    url = url.strip()
+    if context_id is not None and not p.CONTEXT_ID.match(context_id):
+        return _error("context_id must be 1-128 characters of [A-Za-z0-9_.:-]")
+    trusted = peer.get("trusted") is True
+    timeout = peer.get("timeout_seconds")
+    seconds = (
+        float(timeout)
+        if isinstance(timeout, int | float) and not isinstance(timeout, bool) and timeout > 0
+        else DEFAULT_TIMEOUT
+    )
+    from indus.gateway.config import read_secret
+
+    key = read_secret(scope, peer_key_env(name))
+    secrets = [*_known_secrets(scope), *([key] if key else [])]
+    text = PRIVACY_NOTE + redact_text(message.strip(), secrets)
+    request_id = uuid.uuid4().hex
+    body = {
+        "jsonrpc": "2.0",
+        "id": request_id,
+        "method": "SendMessage",
+        "params": {"message": p.make_message(p.ROLE_USER, text, context_id=context_id)},
+    }
+    headers = {"content-type": "application/json", "a2a-version": p.PROTOCOL_VERSION}
+    if key:
+        headers["authorization"] = f"Bearer {key}"
+
+    verdict = await check_url_async(url, scope, resolver=resolver)
+    # Trust opens private, loopback and link-local addresses (and names our resolver cannot
+    # see); never a bad scheme, a credential in the URL, the blocklist or cloud metadata.
+    if isinstance(verdict, Blocked) and not (trusted and verdict.kind in ("private", "dns")):
+        hint = " (mark the peer trusted: true to allow a private address)" if not trusted else ""
+        return _error(f"A2A peer {name!r} refused by the URL policy: {verdict.reason}{hint}")
+    if trusted:
+        client = httpx.AsyncClient(
+            transport=inner_transport, trust_env=False, follow_redirects=False, timeout=seconds
+        )
+    else:
+        factory = _fixed(inner_transport) if inner_transport is not None else None
+        client = safe_client(
+            scope, resolver=resolver, inner_factory=factory, follow_redirects=False, timeout=seconds
+        )
+    try:
+        async with client:
+            response = await client.post(url, json=body, headers=headers)
+    except ConnectBlocked as exc:
+        return _error(f"A2A peer {name!r} refused by the URL policy: {exc.verdict.reason}")
+    except httpx.TimeoutException:
+        return _error(f"A2A peer {name!r} did not answer within {seconds:g} seconds")
+    except httpx.HTTPError as exc:
+        return _error(f"could not reach A2A peer {name!r}: {type(exc).__name__}")
+    if response.status_code in (401, 403):
+        return _error(f"A2A peer {name!r} refused our credentials (HTTP {response.status_code})")
+    if response.status_code == 429:
+        return _error(f"A2A peer {name!r} is rate limiting us (HTTP 429); try later")
+    if response.status_code >= 400:
+        return _error(f"A2A peer {name!r} answered HTTP {response.status_code}")
+    try:
+        answer: object = response.json()
+    except (json.JSONDecodeError, UnicodeDecodeError, ValueError):
+        return _error(f"A2A peer {name!r} did not answer JSON")
+    if not isinstance(answer, Mapping):
+        return _error(f"A2A peer {name!r} sent an answer that is not a JSON-RPC response")
+    reply = cast(Mapping[str, Any], answer)
+    problem = reply.get("error")
+    if isinstance(problem, Mapping):
+        detail = str(cast(Mapping[str, Any], problem).get("message") or "error")[:300]
+        return _error(f"A2A peer {name!r} returned an error: {redact_text(detail, secrets)}")
+    reply_text, state, context = _reply_of(reply.get("result"))
+    if len(reply_text) > MAX_REPLY:
+        reply_text = reply_text[:MAX_REPLY] + "\n[… the peer's answer was cut here]"
+    short = state.removeprefix("TASK_STATE_").replace("_", "-").lower()
+    head = (
+        f"[{name} · context {context or context_id or '?'}" + (f" · {short}" if short else "") + "]"
+    )
+    out = f"{head}\n{reply_text or '(no text in the answer)'}"
+    if state == p.INPUT_REQUIRED:
+        out += (
+            f"\n\n(The peer needs more input: call {TOOL_NAME} again with context_id "
+            f"{context or context_id!r} and your answer.)"
+        )
+    return out
+
+
+async def a2a_call(args: Mapping[str, Any], *, scope: Scope | None = None) -> str:
+    """The ``a2a_call`` handler."""
+    if scope is None:
+        return _error("a2a_call needs a profile (no scope here)")
+    agent = str(args.get("agent") or "").strip()
+    message = str(args.get("message") or "").strip()
+    if not agent or not message:
+        return _error("both agent and message are required")
+    context = args.get("context_id")
+    return await call_peer(
+        scope, agent, message, context_id=str(context).strip() if context else None
+    )
+
+
+def _available(scope: Scope) -> bool:
+    return bool(_peers(scope))
+
+
+A2A_CALL_SCHEMA: dict[str, Any] = {
+    "name": TOOL_NAME,
+    "description": (
+        "Send a message to another AI agent (an A2A peer configured by the user) and get its "
+        "answer. The peer is a separate agent, not a subagent you control; what you send leaves "
+        "this machine, so send only what the request needs. Pass context_id from an earlier "
+        "answer to continue that conversation; an answer marked input-required is a question "
+        "back to you."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["agent", "message"],
+        "properties": {
+            "agent": {"type": "string", "description": "The peer's configured name."},
+            "message": {"type": "string", "description": "What to ask or tell the peer."},
+            "context_id": {
+                "type": "string",
+                "description": "The context id of an earlier answer, to continue it.",
+            },
+        },
+    },
+}
+
+
+def register_tools(registry: ToolRegistry) -> None:
+    registry.register(
+        TOOL_NAME,
+        TOOLSET,
+        A2A_CALL_SCHEMA,
+        a2a_call,
+        probe=_available,
+        traits=ToolTraits(mutating=True),
+    )
