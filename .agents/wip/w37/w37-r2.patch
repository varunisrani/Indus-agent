+        "result": {
+          "oneOf": [
+            {"type": "object", "required": ["task"], "properties": {"task": {"$ref": "#/$defs/Task"}}},
+            {"type": "object", "required": ["message"], "properties": {"message": {"$ref": "#/$defs/Message"}}}
