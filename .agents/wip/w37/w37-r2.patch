+def run(main: Callable[[Rig], Awaitable[None]], **kw: Any) -> None:
+    async def outer() -> None:
+        rig = Rig(**kw)
+        try:
+            await rig.settle(rig.adapter.connect())
+            await main(rig)
+        finally:
+            await rig.adapter.disconnect()
+
+    asyncio.run(outer())
