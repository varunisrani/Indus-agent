+# -- the pipe reader (every OS) -------------------------------------------------------------------
+
+
+class FakePipe:
+    """A real pipe with a byte count standing in for ``PeekNamedPipe``."""
+
+    def __init__(self) -> None:
+        self.read_fd, self.write_fd = os.pipe()
+        self.pending = 0
+        self.closed = False
+
+    def put(self, data: bytes) -> None:
+        os.write(self.write_fd, data)
+        self.pending += len(data)
+
+    def close_writer(self) -> None:
+        os.close(self.write_fd)
+        self.closed = True
+
+    def available(self) -> int | None:
+        waiting, self.pending = self.pending, 0  # the reader takes all of it
+        if waiting == 0 and self.closed:
+            return None
+        return waiting
+
+    def done(self) -> None:
+        os.close(self.read_fd)
+        if not self.closed:
+            os.close(self.write_fd)
+
+
+def test_drain_decodes_split_utf8_until_the_pipe_closes() -> None:
+    pipe = FakePipe()
+    text = "été ✓"
+    raw = text.encode()
+    pipe.put(raw[:2])
+    pipe.put(raw[2:])
+    pipe.put(b"\xff!")
+    pipe.close_writer()
+    out: list[str] = []
+    try:
+        drain_pipe(
+            pipe.read_fd,
+            available=pipe.available,
+            exited=lambda: False,
+            sink=out.append,
+            stop=threading.Event(),
+            poll_s=0.001,
+        )
+    finally:
+        pipe.done()
+    assert "".join(out) == text + "\ufffd!"
+
+
+def test_drain_stops_after_the_leader_exits_while_the_pipe_stays_open() -> None:
+    pipe = FakePipe()
+    pipe.put(b"tail")
+    out: list[str] = []
+    rounds: list[int] = []
+
+    def exited() -> bool:
+        rounds.append(1)
+        return True
+
+    try:
+        drain_pipe(
+            pipe.read_fd,
+            available=pipe.available,
+            exited=exited,
+            sink=out.append,
+            stop=threading.Event(),
+            poll_s=0.001,
+            idle_rounds=3,
+        )
+    finally:
+        pipe.done()
+    assert "".join(out) == "tail" and len(rounds) == 3
+
+
+def test_drain_honours_stop() -> None:
+    pipe = FakePipe()
+    stop = threading.Event()
+    stop.set()
+    out: list[str] = []
+    try:
+        drain_pipe(
+            pipe.read_fd, available=pipe.available, exited=lambda: False, sink=out.append, stop=stop
+        )
+    finally:
+        pipe.done()
+    assert out == []
