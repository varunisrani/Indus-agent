--- /dev/null
+++ b/tests/e2e/upgrade/test_smoke_steps.py
@@ -0,0 +1,76 @@
+"""P25-23: the smoke script's own steps pass on a source install of a locally built release.
+
+The post-release smoke scripts work from public downloads, so CI cannot run them whole before a
+release exists. This test runs every step that follows their install step — the very functions,
+sourced from the script — on a stable release built and installed the way ``world.py`` does it,
+in the installers' default layout under an isolated HOME (the layout the scripts expect). The
+desktop steps need the release's packages and are skipped (``--desktop skip``). A step that would
+fail on the owner's machine for a reason in our code fails here first.
+
+Release lane only (``release`` marker, ``INDUS_RELEASE_LANE=1``).
+"""
+
+from __future__ import annotations
+
+import os
+import signal
+import sys
+
+from scripts.release.versioning import next_stable
+from tests.e2e.upgrade.world import RELEASE_LANE_MARKS, ROOT, Rehearsal
+
+SMOKE = ROOT / "scripts" / "release" / "smoke"
+SCRIPT = SMOKE / ("macos.sh" if sys.platform == "darwin" else "linux.sh")
+STEPS = (
+    "version", "setup", "turn", "approval", "resume", "doctor", "dashboard-gate",
+    "dashboard-login", "licences", "uninstall",
+)  # fmt: skip
+# Sources the script (it runs nothing when sourced), then runs the steps after the install.
+DRIVER = r"""
+set -u
+source "$1"
+smoke_parse --tag "$2" --desktop skip
+SMOKE_WORK="$3"
+SMOKE_LOGS="$3/logs"
+smoke_isolate
+trap smoke_cleanup EXIT
+shift 3
+for step in "$@"; do
+    "step_${step//-/_}"
+done
+smoke_cleanup
+trap - EXIT
+printf '%s' "$SMOKE_RESULTS" >"$SMOKE_WORK/results.txt"
+"""
+
+pytestmark = RELEASE_LANE_MARKS
+
+
+def test_the_smoke_steps_pass_on_a_local_source_install(smoke_world: Rehearsal) -> None:
+    world = smoke_world
+    version = next_stable(None)
+    world.release(str(version))
+    world.install("stable")
+    done = world.run(
+        ["bash", "-c", DRIVER, "smoke", str(SCRIPT), f"v{version}", str(world.base), *STEPS],
+        timeout=1800,
+    )
+    leftover = world.gateway_pid()
+    if leftover is not None:
+        os.kill(leftover, signal.SIGTERM)
+    assert leftover is None, "the smoke left a gateway daemon running"
+    results: dict[str, tuple[str, str]] = {}
+    for line in (world.base / "results.txt").read_text(encoding="utf-8").splitlines():
+        step, status, *detail = line.split(maxsplit=2)
+        results[step] = (status, detail[0] if detail else "")
+    assert list(results) == list(STEPS), done.stdout + done.stderr
+    # A release built here has no apps/ folder, so the dashboard has no pages to build: the API
+    # gate still works, the page with the loopback token does not (a real release checkout builds
+    # its pages with pnpm on first launch, when pnpm and Node are there).
+    status, detail = results.pop("dashboard-login")
+    assert status == "PASS" or "without a session token" in detail, detail
+    failed = {step: row for step, row in results.items() if row[0] != "PASS"}
+    assert not failed, f"{failed}\n{done.stdout}{done.stderr}"
+    assert done.returncode == 0, done.stdout + done.stderr
+    assert not world.checkout.exists() and not world.launcher.exists()
+    assert (world.home / "state.db").is_file()
diff --git a/tests/e2e/upgrade/world.py b/tests/e2e/upgrade/world.py
new file mode 100644
index 0000000..1a0cd56
--- /dev/null
+++ b/tests/e2e/upgrade/world.py
@@ -0,0 +1,278 @@
+"""The temp world the release-lane end-to-end tests share (P25-22, P25-23).
+
+``Rehearsal`` holds a bare repository that plays ``origin``, releases built from this checkout's
+own source tree, the user's HOME, the Indus home and a source install made with the real
+``install.sh`` stages. Only the dependencies step is done here: the installer's own runtime and
+dependencies stages download a pinned uv and sync the standard extras, so the test runs the same
+``uv sync --frozen --no-dev`` offline from the uv cache the lane's own ``uv sync`` filled. Every
+child gets ``UV_OFFLINE=1`` and the running interpreter as ``UV_PYTHON``: nothing reaches the
+network.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+from collections.abc import Iterator, Mapping, Sequence
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from pathlib import Path
+
+import pytest
+
+from tests.fixtures.update.make_repo import Upstream
+
+ROOT = Path(__file__).resolve().parents[3]
+INSTALL_SH = ROOT / "scripts" / "install.sh"
+MODEL_SERVER = ROOT / "scripts" / "parity" / "scripted_model_server.py"
+# Read at import: the root conftest drops every INDUS_* variable before each test runs.
+IN_RELEASE_LANE = os.environ.get("INDUS_RELEASE_LANE") == "1"
+UV = shutil.which("uv")
+STEP_TIMEOUT_S = 300.0
+TURN_TIMEOUT_S = 120.0
+
+# What a source install needs from the repository (the build backend reads the readme, licence,
+# skills, locales and the build hook; the update reads the lock and the store schema; the smoke
+# checks the notices).
+RELEASE_PATHS = (
+    ".gitignore",
+    ".python-version",
+    "LICENSE",
+    "README.md",
+    "THIRD_PARTY_NOTICES.md",
+    "locales",
+    "pyproject.toml",
+    "scripts/build_hooks",
+    "scripts/parity/scripted_model_server.py",
+    "skills",
+    "src",
+    "uv.lock",
+)
+
+RELEASE_LANE_MARKS = [
+    pytest.mark.release,
+    pytest.mark.slow,
+    pytest.mark.platforms("posix"),
+    pytest.mark.skipif(not IN_RELEASE_LANE, reason="release lane only (INDUS_RELEASE_LANE=1)"),
+    pytest.mark.skipif(UV is None, reason="needs uv on PATH"),
+]
+
+
+def source_files() -> list[str]:
+    """Tracked (and new, not ignored) files of this checkout that a release carries."""
+    done = subprocess.run(
+        [
+            "git",
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+            "--",
+            *RELEASE_PATHS,
+        ],
+        cwd=ROOT,
+        capture_output=True,
+        check=True,
+        timeout=60,
+    )
+    return sorted({name for name in done.stdout.decode("utf-8").split("\0") if name})
+
+
+def uv_cache_dir() -> str:
+    """The cache the lane's own ``uv sync`` filled (the children get another HOME)."""
+    configured = os.environ.get("UV_CACHE_DIR")
+    if configured:
+        return configured
+    assert UV is not None
+    done = subprocess.run([UV, "cache", "dir"], capture_output=True, text=True, timeout=60)
+    return done.stdout.strip()
+
+
+def base_python() -> str:
+    """The interpreter behind the running one (a venv's ``python`` names its base)."""
+    return str(getattr(sys, "_base_executable", "") or sys.executable)
+
+
+@dataclass
+class Rehearsal:
+    """One temp world: ``origin``, the user's HOME, the Indus home and the install.
+
+    The default layout keeps HOME, the Indus home and the checkout side by side; ``smoke=True``
+    uses the installers' default layout under HOME (``~/.indus``, ``~/.indus/indus-agent``), the
+    one the smoke scripts expect."""
+
+    base: Path
+    files: Sequence[str]
+    smoke: bool = False
+    transcript: list[str] = field(default_factory=list[str])
+
+    def __post_init__(self) -> None:
+        self.upstream = Upstream(self.base)
+        if self.smoke:
+            self.user = self.base / "home"
+            self.home = self.user / ".indus"
+            self.checkout = self.home / "indus-agent"
+        else:
+            self.user = self.base / "user"
+            self.home = self.base / "indus-home"
+            self.checkout = self.base / "indus-agent"
+        self.work = self.base / "work"
+        for folder in (self.user, self.home, self.work):
+            folder.mkdir(parents=True, exist_ok=True)
+        self.launcher = self.user / ".local" / "bin" / "indus"
+        self.cache = uv_cache_dir()
+
+    # -- the releases ------------------------------------------------------------------------------
+
+    def release(self, version: str) -> str:
+        """Commit this checkout's source tree as ``version`` and tag it ``v<version>``."""
+        work = self.upstream.work
+        for name in self.files:
+            source = ROOT / name
+            if not source.is_file():
+                continue  # deleted in the working tree
+            target = work / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source, target)
+        (work / "RELEASE.txt").write_text(
+            f"Indus Agent {version} (built locally for the release rehearsal)\n", encoding="utf-8"
+        )
+        sha = self.upstream.commit(f"release {version}")
+        self.upstream.tag(f"v{version}")
+        return sha
+
+    # -- children ----------------------------------------------------------------------------------
+
+    def env(self) -> dict[str, str]:
+        return {
+            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+            "HOME": str(self.user),
+            "INDUS_HOME": str(self.home),
+            "INDUS_TERMINAL_ID": "release-rehearsal",
+            "LANG": "C.UTF-8",
+            "TZ": "UTC",
+            "TERM": "dumb",
+            "NO_COLOR": "1",
+            "PYTHON_KEYRING_BACKEND": "keyring.backends.null.Keyring",
+            "GIT_CONFIG_NOSYSTEM": "1",
+            "GIT_CONFIG_GLOBAL": os.devnull,
+            "GIT_TERMINAL_PROMPT": "0",
+            "UV_CACHE_DIR": self.cache,
+            "UV_OFFLINE": "1",
+            "UV_NO_CONFIG": "1",
+            "UV_PYTHON": base_python(),
+            "UV_PYTHON_DOWNLOADS": "never",
+        }
+
+    def run(
+        self,
+        argv: Sequence[str],
+        *,
+        env: Mapping[str, str] | None = None,
+        timeout: float = STEP_TIMEOUT_S,
+    ) -> subprocess.CompletedProcess[str]:
+        done = subprocess.run(
+            [str(a) for a in argv],
+            cwd=self.work,
+            env={**self.env(), **(env or {})},
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            text=True,
+            timeout=timeout,
+            check=False,
+        )
+        command = " ".join(str(a) for a in argv)
+        self.transcript.append(f"$ {command}\n[exit {done.returncode}]\n{done.stdout}{done.stderr}")
+        return done
+
+    def ok(self, argv: Sequence[str], *, env: Mapping[str, str] | None = None) -> str:
+        done = self.run(argv, env=env)
+        assert done.returncode == 0, self.story()
+        return done.stdout
+
+    def indus(
+        self, *args: str, timeout: float = STEP_TIMEOUT_S
+    ) -> subprocess.CompletedProcess[str]:
+        """The installed ``indus`` through the launcher the installer wrote."""
+        return self.run([str(self.launcher), *args], timeout=timeout)
+
+    def story(self) -> str:
+        return "\n".join(self.transcript[-12:])
+
+    # -- the install -------------------------------------------------------------------------------
+
+    def stage(self, name: str, channel: str) -> None:
+        self.ok(
+            [
+                "bash", str(INSTALL_SH), "--stage", name, "--channel", channel,
+                "--dir", str(self.checkout), "--indus-home", str(self.home),
+                "--non-interactive", "--skip-browser", "--skip-computer-use",
+            ],
+            env={"INDUS_INSTALL_REPO_URL": str(self.upstream.origin)},
+        )  # fmt: skip
+
+    def install(self, channel: str) -> str:
+        """The installer's stages, the dependencies step done offline; returns the install id."""
+        self.stage("prerequisites", channel)
+        self.stage("repository", channel)
+        assert UV is not None
+        self.ok([UV, "sync", "--directory", str(self.checkout), "--frozen", "--no-dev", "--quiet"])
+        for name in ("config", "products", "complete"):
+            self.stage(name, channel)
+        iid = self.ok([str(self.launcher), "update", "--install-id"]).split()[0]
+        # The cache holds the base packages only: keep later syncs to that set.
+        self.ok(
+            [str(self.launcher), "config", "set", "--force", f"updates.installs.{iid}.extras", "[]"]
+        )
+        return iid
+
+    def gateway_pid(self) -> int | None:
+        """The pid a gateway daemon of this home recorded, when that process still runs."""
+        try:
+            pid = int(json.loads((self.home / "gateway.pid").read_text(encoding="utf-8"))["pid"])
+        except (OSError, ValueError, KeyError, TypeError):
+            return None
+        try:
+            os.kill(pid, 0)
+        except OSError:
+            return None
+        return pid
+
+
+@dataclass
+class ModelServer:
+    """The scripted model server (P25-06), our own child; stopped by closing its stdin."""
+
+    process: subprocess.Popen[str]
+    port: int
+
+    @property
+    def base_url(self) -> str:
+        return f"http://127.0.0.1:{self.port}/v1"
+
+
+@contextmanager
+def running_model_server() -> Iterator[ModelServer]:
+    process = subprocess.Popen(
+        [sys.executable, str(MODEL_SERVER), "--port", "0", "--default-script", "echo"],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.DEVNULL,
+        text=True,
+    )
+    try:
+        assert process.stdout is not None
+        port = int(json.loads(process.stdout.readline())["port"])
+        yield ModelServer(process, port)
+    finally:
+        if process.stdin is not None:
+            process.stdin.close()
+        try:
+            process.wait(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait(timeout=10)
diff --git a/tests/unit/release/test_smoke_scripts.py b/tests/unit/release/test_smoke_scripts.py
new file mode 100644
index 0000000..3e62336
--- /dev/null
+++ b/tests/unit/release/test_smoke_scripts.py
@@ -0,0 +1,232 @@
+"""P25-23: the post-release smoke scripts and the rollback sheet, checked without any network.
+
+What the scripts do against a real install is pinned by the release lane
+(``tests/e2e/upgrade/test_smoke_steps.py``); here: syntax, shellcheck and PowerShell parsing when
+those tools are installed, the release base they default to, the dry-run plan (which must not
+fetch or install anything), argument errors, and that the rollback sheet names every alias the
+publish controller moves.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from indus.foundation.versions import RELEASE_IMAGE, RELEASE_REPOSITORY, SANDBOX_IMAGE
+from scripts.release.claims import ALIASES, IMAGES
+
+ROOT = Path(__file__).resolve().parents[3]
+SMOKE = ROOT / "scripts" / "release" / "smoke"
+SHELL_SCRIPTS = ("linux.sh", "macos.sh")
+WINDOWS = SMOKE / "windows.ps1"
+ROLLBACK = ROOT / "docs" / "internals" / "rollback.md"
+BASH = shutil.which("bash")
+SHARED_STEPS = [
+    "install", "version", "setup", "turn", "approval", "resume", "doctor", "dashboard-gate",
+    "dashboard-login", "desktop-download", "licences",
+]  # fmt: skip
+STEPS = {
+    "linux.sh": [*SHARED_STEPS, "desktop-launch", "uninstall"],
+    "macos.sh": [*SHARED_STEPS, "signature", "desktop-launch", "uninstall"],
+    "windows.ps1": [*SHARED_STEPS, "signature", "desktop-launch", "uninstall"],
+}
+needs_bash = pytest.mark.skipif(BASH is None, reason="needs bash")
+
+
+def _tripwires(folder: Path) -> Path:
+    """A PATH folder whose curl, git, hdiutil and python3 only record that they were called."""
+    log = folder / "called.txt"
+    folder.mkdir(parents=True, exist_ok=True)
+    for name in ("curl", "git", "hdiutil", "python3", "uv"):
+        tool = folder / name
+        tool.write_text(f'#!/bin/sh\necho {name} "$@" >>"{log}"\nexit 99\n', encoding="utf-8")
+        tool.chmod(0o755)
+    return log
+
+
+def run_smoke(script: str, tmp_path: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    assert BASH is not None
+    bin_dir = tmp_path / "bin"
+    _tripwires(bin_dir)
+    env = {
+        "PATH": f"{bin_dir}{os.pathsep}{os.environ.get('PATH', '/usr/bin:/bin')}",
+        "HOME": str(tmp_path / "user"),
+        "LANG": "C.UTF-8",
+    }
+    argv = [BASH, str(SMOKE / script), *args]
+    # No stdin: a script that waited for a person would hang the test instead of failing it.
+    return subprocess.run(
+        argv,
+        input="",
+        capture_output=True,
+        text=True,
+        env=env,
+        cwd=tmp_path,
+        timeout=60,
+        check=False,
+    )
+
+
+@needs_bash
+@pytest.mark.parametrize("script", SHELL_SCRIPTS)
+def test_shell_scripts_parse(script: str) -> None:
+    assert BASH is not None
+    done = subprocess.run([BASH, "-n", str(SMOKE / script)], capture_output=True, text=True)
+    assert done.returncode == 0, done.stderr
+
+
+@pytest.mark.skipif(shutil.which("shellcheck") is None, reason="shellcheck is not installed")
+@pytest.mark.parametrize("script", SHELL_SCRIPTS)
+def test_shell_scripts_pass_shellcheck(script: str) -> None:
+    done = subprocess.run(
+        ["shellcheck", "--shell=bash", "--severity=style", str(SMOKE / script)],
+        capture_output=True,
+        text=True,
+    )
+    assert done.returncode == 0, done.stdout
+
+
+@pytest.mark.skipif(shutil.which("pwsh") is None, reason="pwsh is not installed")
+def test_windows_script_parses() -> None:
+    parser = "[System.Management.Automation.Language.Parser]"
+    command = (
+        "$errors = $null; "
+        f"{parser}::ParseFile('{WINDOWS}', [ref]$null, [ref]$errors) | Out-Null; "
+        "if ($errors.Count -gt 0) { $errors | ForEach-Object { $_.ToString() }; exit 1 }"
+    )
+    done = subprocess.run(
+        ["pwsh", "-NoProfile", "-NonInteractive", "-Command", command],
+        capture_output=True,
+        text=True,
+    )
+    assert done.returncode == 0, done.stdout + done.stderr
+
+
+def test_windows_script_is_ascii_for_windows_powershell() -> None:
+    # Windows PowerShell 5.1 reads a file without a BOM in the ANSI code page.
+    WINDOWS.read_text(encoding="ascii")
+
+
+@pytest.mark.parametrize("script", [*SHELL_SCRIPTS, "windows.ps1"])
+def test_every_script_defaults_to_the_release_base(script: str) -> None:
+    text = (SMOKE / script).read_text(encoding="utf-8")
+    found = re.findall(
+        r"^(?:SMOKE_DEFAULT_REPOSITORY=|\$SmokeDefaultRepository = )'([^']+)'$", text, re.MULTILINE
+    )
+    assert found == [RELEASE_REPOSITORY]
+
+
+@pytest.mark.parametrize("script", [*SHELL_SCRIPTS, "windows.ps1"])
+def test_scripts_fetch_only_release_downloads(script: str) -> None:
+    text = (SMOKE / script).read_text(encoding="utf-8")
+    urls = re.findall(r"https?://[^\s'\"`)]+", text)
+    assert urls, "no URL at all"
+    loopback = ("http://127.0.0.1", "http://127\\.0\\.0\\.1")  # also as a sed/regex pattern
+    for url in urls:
+        assert url.startswith(("https://github.com/$", *loopback)), url
+
+
+@pytest.mark.parametrize("script", [*SHELL_SCRIPTS, "windows.ps1"])
+def test_the_step_lists_match(script: str) -> None:
+    text = (SMOKE / script).read_text(encoding="utf-8")
+    if script.endswith(".sh"):
+        block = re.search(r"^SMOKE_STEPS=\(([^)]*)\)", text, re.MULTILINE)
+        assert block is not None
+        steps = block.group(1).split()
+    else:
+        block = re.search(r"^\$SmokeSteps = @\(([^)]*)\)", text, re.MULTILINE)
+        assert block is not None
+        steps = re.findall(r"'([a-z-]+)'", block.group(1))
+    assert steps == STEPS[script]
+
+
+@needs_bash
+@pytest.mark.parametrize("script", SHELL_SCRIPTS)
+def test_dry_run_prints_the_plan_and_fetches_nothing(script: str, tmp_path: Path) -> None:
+    done = run_smoke(script, tmp_path, "--dry-run", "--tag", "v1.2.3")
+    assert done.returncode == 0, done.stderr
+    assert not (tmp_path / "bin" / "called.txt").exists()
+    assert not (tmp_path / "user").exists()
+    base = f"https://github.com/{RELEASE_REPOSITORY}/releases/download/v1.2.3"
+    assert f"installer:  {base}/install.sh" in done.stdout
+    assert f"{base}/Indus-1.2.3-" in done.stdout
+    assert "(stable channel)" in done.stdout
+    listed = re.findall(r"^\s+\d+\. (\S+)", done.stdout, re.MULTILINE)
+    assert listed == STEPS[script]
+    assert "Dry run: nothing was fetched or installed." in done.stdout
+
+
+@needs_bash
+def test_a_canary_tag_follows_the_canary_channel(tmp_path: Path) -> None:
+    tag = "v1.2.4-canary.20261020T120000Z"
+    done = run_smoke(
+        "linux.sh", tmp_path, "--dry-run", "--tag", tag, "--repository", "me/indus-fork"
+    )
+    assert done.returncode == 0, done.stderr
+    assert f"{tag} (canary channel) of me/indus-fork" in done.stdout
+    assert f"https://github.com/me/indus-fork/releases/download/{tag}/install.sh" in done.stdout
+
+
+@needs_bash
+@pytest.mark.parametrize(
+    "args",
+    [
+        (),
+        ("--tag", "1.2.3"),
+        ("--tag", "v1.2"),
+        ("--tag", "v1.2.3-rc.1"),
+        ("--tag", "v1.2.3", "--repository", "no-slash"),
+        ("--tag", "v1.2.3", "--channel", "main"),
+        ("--tag", "v1.2.3", "--bogus"),
+        ("--tag",),
+    ],
+    ids=["no-tag", "no-v", "short", "rc", "repository", "channel", "unknown", "no-value"],
+)
+def test_usage_errors_exit_2_before_anything_runs(args: tuple[str, ...], tmp_path: Path) -> None:
+    done = run_smoke("linux.sh", tmp_path, *args)
+    assert done.returncode == 2, done.stdout + done.stderr
+    assert not (tmp_path / "bin" / "called.txt").exists()
+
+
+@needs_bash
+def test_a_workdir_that_holds_files_is_refused(tmp_path: Path) -> None:
+    work = tmp_path / "work"
+    work.mkdir()
+    (work / "keep.txt").write_text("mine\n", encoding="utf-8")
+    bin_dir = tmp_path / "bin"
+    log = _tripwires(bin_dir)
+    # Only the tool check may look for curl/git: let them answer.
+    for name in ("curl", "git"):
+        (bin_dir / name).write_text(
+            f'#!/bin/sh\necho {name} "$@" >>"{log}"\nexit 0\n', encoding="utf-8"
+        )
+    done = run_smoke("linux.sh", tmp_path, "--tag", "v1.2.3", "--workdir", str(work))
+    assert done.returncode == 2, done.stdout + done.stderr
+    assert "--workdir must be a new or empty folder" in done.stderr
+    assert (work / "keep.txt").read_text(encoding="utf-8") == "mine\n"
+    assert not log.exists()
+
