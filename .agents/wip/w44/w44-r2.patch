diff --git a/scripts/release/smoke/linux.sh b/scripts/release/smoke/linux.sh
new file mode 100755
index 0000000..241b73a
--- /dev/null
+++ b/scripts/release/smoke/linux.sh
@@ -0,0 +1,624 @@
+#!/usr/bin/env bash
+# Post-release smoke test for Linux (P25-23).
+#
+#   bash linux.sh --tag vX.Y.Z [--repository OWNER/NAME] [--channel stable|canary]
+#                 [--workdir DIR] [--desktop auto|skip|FILE] [--interactive] [--keep] [--dry-run]
+#
+# Run it on a clean machine or VM right after a release, and on the canary rehearsal artefacts.
+# It uses only what the release published: install.sh from the release's downloads, the desktop
+# AppImage from the same release, and the release's own checkout that install.sh puts on disk
+# (its scripted model server is the fake-model endpoint, so no real model or key is needed).
+# Everything runs inside one throwaway folder with its own HOME, so the person's own setup, keys
+# and PATH are never touched.
+#
+# Each step prints one line, `<step> PASS|FAIL|SKIP <detail>`, and the run ends with a summary.
+# Exit 0 when no step failed, 1 otherwise, 2 for a usage error. --dry-run prints the plan and the
+# URLs and fetches nothing. The steps and what they prove are listed in docs/internals/rollback.md
+# (smoke section) and the results go into docs/internals/rehearsal-log.md.
+
+set -u
+
+SMOKE_OS=linux
+# The release base (RELEASE_REPOSITORY in src/indus/foundation/versions.py, D-16.690); a unit test
+# holds this default equal to it.
+SMOKE_DEFAULT_REPOSITORY='indusagi/indus-agent'
+SMOKE_STEPS=(install version setup turn approval resume doctor dashboard-gate dashboard-login
+    desktop-download licences desktop-launch uninstall)
+SMOKE_INSTALL_WAIT=1800
+SMOKE_TURN_WAIT=180
+SMOKE_DASHBOARD_WAIT=600
+SMOKE_DESKTOP_WAIT=20
+
+smoke_usage() {
+    cat <<'EOF'
+Usage: linux.sh --tag vX.Y.Z [options]
+
+  --tag TAG                 the release to check (vX.Y.Z or vX.Y.Z-canary.<stamp>)
+  --repository OWNER/NAME   where the release lives (default: the release base)
+  --channel stable|canary   the installer channel (default: from the tag)
+  --workdir DIR             the throwaway folder (default: a new temp folder)
+  --desktop auto|skip|FILE  the AppImage: auto (download it), skip, or a local file
+  --interactive             ask a person to confirm what a script cannot see
+  --keep                    keep the work folder even when every step passed
+  --dry-run                 print the plan and the URLs; fetch nothing
+  -h, --help                this help
+EOF
+}
+
+smoke_describe() {
+    case "$1" in
+        install) printf 'download install.sh from the release and install the %s channel' "$SMOKE_CHANNEL" ;;
+        version) printf 'indus --version; indus update --check reports this release' ;;
+        setup) printf 'indus setup --non-interactive; point the model at the fake endpoint' ;;
+        turn) printf 'one turn through the gateway daemon (indus -z)' ;;
+        approval) printf 'a risky command without a person to approve it does not run' ;;
+        resume) printf 'resume the first session by id (indus -r ID -z)' ;;
+        doctor) printf 'indus doctor passes' ;;
+        dashboard-gate) printf 'dashboard on loopback: status public, settings refuse a request without the token' ;;
+        dashboard-login) printf 'dashboard page carries the loopback session token and the API accepts it' ;;
+        desktop-download) printf 'download the AppImage from the release and unpack it' ;;
+        licences) printf 'THIRD_PARTY_NOTICES.md in the checkout and inside the desktop package' ;;
+        desktop-launch) printf 'start the desktop app and reach the chat (a person confirms)' ;;
+        uninstall) printf 'indus uninstall -y removes code and launcher and keeps the data' ;;
+        *) printf '?' ;;
+    esac
+}
+
+# -- arguments ------------------------------------------------------------------------------------
+
+smoke_parse() {
+    SMOKE_TAG=""
+    SMOKE_REPOSITORY="$SMOKE_DEFAULT_REPOSITORY"
+    SMOKE_CHANNEL=""
+    SMOKE_WORK=""
+    SMOKE_DESKTOP=auto
+    SMOKE_INTERACTIVE=false
+    SMOKE_KEEP=false
+    SMOKE_DRY_RUN=false
+    while [ $# -gt 0 ]; do
+        case "$1" in
+            --tag | --repository | --channel | --workdir | --desktop)
+                [ $# -ge 2 ] || { printf '%s needs a value\n' "$1" >&2; exit 2; }
+                case "$1" in
+                    --tag) SMOKE_TAG="$2" ;;
+                    --repository) SMOKE_REPOSITORY="$2" ;;
+                    --channel) SMOKE_CHANNEL="$2" ;;
+                    --workdir) SMOKE_WORK="$2" ;;
+                    --desktop) SMOKE_DESKTOP="$2" ;;
+                esac
+                shift 2
+                ;;
+            --interactive) SMOKE_INTERACTIVE=true; shift ;;
+            --keep) SMOKE_KEEP=true; shift ;;
+            --dry-run) SMOKE_DRY_RUN=true; shift ;;
+            -h | --help) smoke_usage; exit 0 ;;
+            *) printf 'unknown option: %s\n' "$1" >&2; smoke_usage >&2; exit 2 ;;
+        esac
+    done
+    if ! printf '%s\n' "$SMOKE_TAG" | grep -Eq '^v[0-9]{1,3}\.[0-9]+\.[0-9]+(-canary\.[0-9]{8}T[0-9]{6}Z)?$'; then
+        printf 'a release tag is required: --tag vX.Y.Z or vX.Y.Z-canary.<YYYYMMDDTHHMMSSZ>\n' >&2
+        exit 2
+    fi
+    if ! printf '%s\n' "$SMOKE_REPOSITORY" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; then
+        printf -- '--repository must be OWNER/NAME\n' >&2
+        exit 2
+    fi
+    SMOKE_VERSION="${SMOKE_TAG#v}"
+    if [ -z "$SMOKE_CHANNEL" ]; then
+        case "$SMOKE_VERSION" in *-canary.*) SMOKE_CHANNEL=canary ;; *) SMOKE_CHANNEL=stable ;; esac
+    fi
+    case "$SMOKE_CHANNEL" in stable | canary) ;; *) printf -- '--channel must be stable or canary\n' >&2; exit 2 ;; esac
+    SMOKE_RELEASE_URL="https://github.com/$SMOKE_REPOSITORY/releases/download/$SMOKE_TAG"
+}
+
+# The AppImage names electron-builder writes for this machine (artifactName
+# Indus-<version>-linux-<arch>.AppImage; the arch word differs between targets, so both spellings).
+smoke_appimage_names() {
+    case "$(uname -m)" in
+        x86_64 | amd64) printf 'Indus-%s-linux-x86_64.AppImage\nIndus-%s-linux-x64.AppImage\n' "$SMOKE_VERSION" "$SMOKE_VERSION" ;;
+        aarch64 | arm64) printf 'Indus-%s-linux-arm64.AppImage\nIndus-%s-linux-aarch64.AppImage\n' "$SMOKE_VERSION" "$SMOKE_VERSION" ;;
+        *) return 1 ;;
+    esac
+}
+
+smoke_plan() {
+    local step number=0 name
+    printf 'Indus Agent post-release smoke (%s)\n' "$SMOKE_OS"
+    printf '  release:    %s (%s channel) of %s\n' "$SMOKE_TAG" "$SMOKE_CHANNEL" "$SMOKE_REPOSITORY"
+    printf '  installer:  %s/install.sh\n' "$SMOKE_RELEASE_URL"
+    if [ "$SMOKE_DESKTOP" = auto ]; then
+        while IFS= read -r name; do printf '  desktop:    %s/%s\n' "$SMOKE_RELEASE_URL" "$name"; done < <(smoke_appimage_names)
+    else
+        printf '  desktop:    %s\n' "$SMOKE_DESKTOP"
+    fi
+    printf '  fake model: scripts/parity/scripted_model_server.py from the installed checkout\n'
+    for step in "${SMOKE_STEPS[@]}"; do
+        number=$((number + 1))
+        printf '  %2d. %-17s %s\n' "$number" "$step" "$(smoke_describe "$step")"
+    done
+}
+
+# -- results and children -------------------------------------------------------------------------
+
+SMOKE_FAILED=0
+SMOKE_RESULTS=""
+
+smoke_result() { # STEP STATUS DETAIL
+    printf '%-17s %s %s\n' "$1" "$2" "$3"
+    SMOKE_RESULTS="${SMOKE_RESULTS}$(printf '%-17s %s %s' "$1" "$2" "$3")
+"
+    if [ "$2" = FAIL ]; then SMOKE_FAILED=$((SMOKE_FAILED + 1)); fi
+}
+
+# bounded SECONDS CMD...: run CMD (stdin from /dev/null) and stop it, with what it started, by
+# its own pid after SECONDS. Returns CMD's status, or 124 when it was stopped.
+bounded() {
+    local limit=$(($1 * 5)) pid ticks=0
+    shift
+    "$@" </dev/null &
+    pid=$!
+    while kill -0 "$pid" 2>/dev/null; do
+        if [ "$ticks" -ge "$limit" ]; then
+            stop_tree "$pid"
+            wait "$pid" 2>/dev/null
+            return 124
+        fi
+        sleep 0.2
+        ticks=$((ticks + 1))
+    done
+    wait "$pid"
+}
+
+# stop_tree PID: TERM a child we started and everything it started (by parent pid, never by name).
+stop_tree() {
+    local pid="$1" child
+    [ -n "$pid" ] || return 0
+    for child in $(pgrep -P "$pid" 2>/dev/null); do stop_tree "$child"; done
+    kill -TERM "$pid" 2>/dev/null || :
+}
+
+# stop_child PID: stop_tree, then reap the child itself.
+stop_child() {
+    [ -n "$1" ] || return 0
+    stop_tree "$1"
+    wait "$1" 2>/dev/null || :
+}
+
+last_line() { grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 1 | cut -c1-160; }
+
+# -- the steps ------------------------------------------------------------------------------------
+
+smoke_isolate() {
+    local name
+    for name in $(compgen -e); do
+        case "$name" in INDUS_*) unset "$name" ;; esac
+    done
+    export HOME="$SMOKE_WORK/home"
+    export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
+    export XDG_CACHE_HOME="$HOME/.cache" XDG_STATE_HOME="$HOME/.local/state"
+    export INDUS_TERMINAL_ID=smoke NO_COLOR=1 LANG=C.UTF-8 TZ=UTC
+    unset VIRTUAL_ENV UV_PROJECT_ENVIRONMENT
+    mkdir -p "$HOME" "$SMOKE_LOGS" "$SMOKE_WORK/project" || exit 1
+    SMOKE_INDUS="$HOME/.local/bin/indus"
+    SMOKE_CHECKOUT="$HOME/.indus/indus-agent"
+    SMOKE_DATA="$HOME/.indus"
+}
+
+step_install() {
+    local installed
+    if ! bounded 300 curl -fsSL --proto '=https' --tlsv1.2 -o "$SMOKE_WORK/install.sh" \
+        "$SMOKE_RELEASE_URL/install.sh" 2>"$SMOKE_LOGS/install-download.log"; then
+        smoke_result install FAIL "could not download $SMOKE_RELEASE_URL/install.sh (is the installer attached to the release?)"
+        return 1
+    fi
+    if ! bounded "$SMOKE_INSTALL_WAIT" bash "$SMOKE_WORK/install.sh" --channel "$SMOKE_CHANNEL" \
+        --non-interactive --skip-browser >"$SMOKE_LOGS/install.log" 2>&1; then
+        smoke_result install FAIL "install.sh failed: $(last_line "$SMOKE_LOGS/install.log")"
+        return 1
+    fi
+    if [ ! -x "$SMOKE_INDUS" ]; then
+        smoke_result install FAIL "no launcher at $SMOKE_INDUS after the install"
+        return 1
+    fi
+    installed="$(git -C "$SMOKE_CHECKOUT" describe --tags --exact-match HEAD 2>/dev/null)"
+    if [ "$installed" != "$SMOKE_TAG" ]; then
+        smoke_result install FAIL "installed ${installed:-an untagged commit}, expected $SMOKE_TAG (a newer $SMOKE_CHANNEL release?)"
+        return 1
+    fi
+    smoke_result install PASS "$SMOKE_TAG in $SMOKE_CHECKOUT"
+}
+
+step_version() {
+    local out
+    if ! bounded 60 "$SMOKE_INDUS" --version >"$SMOKE_LOGS/version.log" 2>&1 ||
+        ! grep -q '^Indus Agent ' "$SMOKE_LOGS/version.log" ||
+        ! grep -q '^Install method: git' "$SMOKE_LOGS/version.log"; then
+        smoke_result version FAIL "indus --version: $(last_line "$SMOKE_LOGS/version.log")"
+        return 1
+    fi
+    bounded 120 "$SMOKE_INDUS" update --check >"$SMOKE_LOGS/update-check.log" 2>&1
+    out="$(last_line "$SMOKE_LOGS/update-check.log")"
+    case "$out" in
+        *"already on $SMOKE_VERSION"*) smoke_result version PASS "$(head -n 1 "$SMOKE_LOGS/version.log"); $out" ;;
+        *) smoke_result version FAIL "indus update --check: $out"; return 1 ;;
+    esac
+}
+
+SMOKE_MODEL_PID=""
+
+step_setup() {
+    local python server port="" tries=0 key value
+    if ! bounded 120 "$SMOKE_INDUS" setup --non-interactive >"$SMOKE_LOGS/setup.log" 2>&1; then
+        smoke_result setup FAIL "indus setup --non-interactive: $(last_line "$SMOKE_LOGS/setup.log")"
+        return 1
+    fi
+    python="$SMOKE_CHECKOUT/.venv/bin/python"
+    server="$SMOKE_CHECKOUT/scripts/parity/scripted_model_server.py"
+    if [ ! -f "$server" ]; then
+        smoke_result setup FAIL "the release checkout has no $server"
+        return 1
+    fi
+    # The server serves until its stdin closes: a FIFO held open by this shell keeps it up.
+    mkfifo "$SMOKE_WORK/model.in" && exec 7<>"$SMOKE_WORK/model.in"
+    "$python" "$server" --port 0 --default-script echo <"$SMOKE_WORK/model.in" \
+        >"$SMOKE_WORK/model.out" 2>"$SMOKE_LOGS/model.log" &
+    SMOKE_MODEL_PID=$!
+    while [ -z "$port" ] && [ "$tries" -lt 50 ]; do
+        port="$(sed -n 's/.*"port": *\([0-9][0-9]*\).*/\1/p' "$SMOKE_WORK/model.out" 2>/dev/null)"
+        [ -n "$port" ] || { sleep 0.2; tries=$((tries + 1)); }
+    done
+    if [ -z "$port" ]; then
+        smoke_result setup FAIL "the fake model did not start: $(last_line "$SMOKE_LOGS/model.log")"
+        return 1
+    fi
+    for key in model.provider model.base_url model.default; do
+        case "$key" in
+            model.provider) value=custom ;;
+            model.base_url) value="http://127.0.0.1:$port/v1" ;;
+            model.default) value=echo ;;
+        esac
+        if ! bounded 60 "$SMOKE_INDUS" config set "$key" "$value" >>"$SMOKE_LOGS/setup.log" 2>&1; then
+            smoke_result setup FAIL "indus config set $key: $(last_line "$SMOKE_LOGS/setup.log")"
+            return 1
+        fi
+    done
+    # Secrets stay in the throwaway home, never in this machine's keychain.
+    if ! bounded 60 "$SMOKE_INDUS" config set security.secret_store file >>"$SMOKE_LOGS/setup.log" 2>&1; then
+        smoke_result setup FAIL "indus config set security.secret_store: $(last_line "$SMOKE_LOGS/setup.log")"
+        return 1
+    fi
+    smoke_result setup PASS "fake model on 127.0.0.1:$port"
+}
+
+step_turn() {
+    (cd "$SMOKE_WORK/project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -z "remember the blue kite") \
+        >"$SMOKE_LOGS/turn.log" 2>&1
+    if grep -q 'You said: remember the blue kite' "$SMOKE_LOGS/turn.log"; then
+        smoke_result turn PASS "the reply came back through the gateway daemon"
+    else
+        smoke_result turn FAIL "$(last_line "$SMOKE_LOGS/turn.log")"
+        return 1
+    fi
+}
+
+step_approval() {
+    local project="$SMOKE_WORK/project/repo" answer how session
+    mkdir -p "$project" && (
+        cd "$project" &&
+            git init -q &&
+            printf 'kept\n' >note.txt &&
+            git add note.txt &&
+            git -c user.name=smoke -c user.email=smoke@example.invalid commit -qm seed &&
+            printf 'local change\n' >>note.txt
+    ) >"$SMOKE_LOGS/approval.log" 2>&1 || {
+        smoke_result approval FAIL "could not prepare a git folder: $(last_line "$SMOKE_LOGS/approval.log")"
+        return 1
+    }
+    # The scripted model asks to run `git reset --hard HEAD` (flagged as destructive). A finite
+    # `chat -q` without a terminal has nobody to ask: the run refuses it (single_query_mode) or,
+    # through the gateway daemon, leaves the approval waiting for a terminal. Either way nothing
+    # may run before a person says yes.
+    (cd "$project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -m approve_or_decline chat -q "please tidy the tree") \
+        >>"$SMOKE_LOGS/approval.log" 2>&1
+    if ! grep -q 'local change' "$project/note.txt"; then
+        smoke_result approval FAIL "the risky command ran without an approval"
+        return 1
+    fi
+    if grep -q 'declined' "$SMOKE_LOGS/approval.log"; then
+        how="refused in an unattended run"
+    elif grep -q 'waiting for an answer' "$SMOKE_LOGS/approval.log"; then
+        how="left waiting for an approval"
+    else
+        smoke_result approval FAIL "no refusal and no waiting approval: $(last_line "$SMOKE_LOGS/approval.log")"
+        return 1
+    fi
+    if [ "$SMOKE_INTERACTIVE" = true ] && [ -t 0 ]; then
+        printf '\nNow approve it by hand: Indus opens the chat; answer the approval with yes, then type /quit.\n'
+        session="$(sed -n 's/.*`indus -r \([^`]*\)`.*/\1/p' "$SMOKE_LOGS/approval.log" | head -n 1)"
+        if [ -n "$session" ]; then
+            (cd "$project" && "$SMOKE_INDUS" -r "$session")
+        else
+            (cd "$project" && "$SMOKE_INDUS" -m approve_or_decline chat -q "please tidy the tree")
+        fi
+        printf 'Did Indus ask before running git reset --hard HEAD, and run it after you approved? [y/N] '
+        read -r answer
+        case "$answer" in
+            y | Y | yes) smoke_result approval PASS "$how; asked and ran when a person approved" ;;
+            *) smoke_result approval FAIL "the person did not see the approval work"; return 1 ;;
+        esac
+        return 0
+    fi
+    smoke_result approval PASS "$how, nothing ran (interactive approval: --interactive)"
+}
+
+step_resume() {
+    local id
+    # Through the daemon the session is a cli one; a --local one-shot is listed under oneshot.
+    bounded 60 "$SMOKE_INDUS" sessions list --limit 50 >"$SMOKE_LOGS/sessions.log" 2>&1
+    bounded 60 "$SMOKE_INDUS" sessions list --limit 50 --source oneshot >>"$SMOKE_LOGS/sessions.log" 2>&1
+    id="$(awk '/remember the blue kite/ { print $1; exit }' "$SMOKE_LOGS/sessions.log")"
+    if [ -z "$id" ]; then
+        smoke_result resume FAIL "the first session is not listed: $(last_line "$SMOKE_LOGS/sessions.log")"
+        return 1
+    fi
+    (cd "$SMOKE_WORK/project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -r "$id" -z "what did I ask") \
+        >"$SMOKE_LOGS/resume.log" 2>&1
+    if grep -q 'You said: what did I ask' "$SMOKE_LOGS/resume.log"; then
+        smoke_result resume PASS "session $id resumed"
+    else
+        smoke_result resume FAIL "$(last_line "$SMOKE_LOGS/resume.log")"
+        return 1
+    fi
+}
+
+step_doctor() {
+    if bounded 180 "$SMOKE_INDUS" doctor >"$SMOKE_LOGS/doctor.log" 2>&1; then
+        smoke_result doctor PASS "$(last_line "$SMOKE_LOGS/doctor.log")"
+    else
+        smoke_result doctor FAIL "$(last_line "$SMOKE_LOGS/doctor.log")"
+        return 1
+    fi
+}
+
+SMOKE_DASH_PID=""
+SMOKE_DASH_URL=""
+
+smoke_http() { # URL [HEADER]: print the HTTP status (000 when nothing answered)
+    if [ $# -ge 2 ]; then
+        curl -s -o "$SMOKE_WORK/http.body" -w '%{http_code}' --max-time 20 -H "$2" "$1" 2>/dev/null || :
+    else
+        curl -s -o "$SMOKE_WORK/http.body" -w '%{http_code}' --max-time 20 "$1" 2>/dev/null || :
+    fi
+}
+
+step_dashboard_gate() {
+    local waited=0 status
+    "$SMOKE_INDUS" dashboard --port 0 --no-open </dev/null >"$SMOKE_LOGS/dashboard.log" 2>&1 &
+    SMOKE_DASH_PID=$!
+    while [ "$waited" -lt "$SMOKE_DASHBOARD_WAIT" ]; do
+        SMOKE_DASH_URL="$(sed -n 's#^Dashboard on \(http://127\.0\.0\.1:[0-9]*\)/.*#\1#p' "$SMOKE_LOGS/dashboard.log" | head -n 1)"
+        [ -z "$SMOKE_DASH_URL" ] || break
+        kill -0 "$SMOKE_DASH_PID" 2>/dev/null || break
+        sleep 1
+        waited=$((waited + 1))
+    done
+    if [ -z "$SMOKE_DASH_URL" ]; then
+        smoke_result dashboard-gate FAIL "the dashboard did not start: $(last_line "$SMOKE_LOGS/dashboard.log")"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/status")"
+    if [ "$status" != 200 ]; then
+        smoke_result dashboard-gate FAIL "GET /api/status answered $status"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/config")"
+    if [ "$status" != 401 ]; then
+        smoke_result dashboard-gate FAIL "GET /api/config without the token answered $status, not 401"
+        return 1
+    fi
+    smoke_result dashboard-gate PASS "$SMOKE_DASH_URL: status 200, settings 401 without the token"
+}
+
+step_dashboard_login() {
+    local status token
+    if [ -z "$SMOKE_DASH_URL" ]; then
+        smoke_result dashboard-login SKIP "the dashboard did not start"
+        return 0
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/")"
+    token="$(sed -n 's/.*__INDUS_SESSION_TOKEN__=["]\([^"]*\)["].*/\1/p' "$SMOKE_WORK/http.body" | head -n 1)"
+    if [ "$status" != 200 ] || [ -z "$token" ]; then
+        smoke_result dashboard-login FAIL "the page answered $status without a session token ($(grep -m 1 -i 'not built\|build failed' "$SMOKE_LOGS/dashboard.log" || printf 'see dashboard.log'))"
+        stop_child "$SMOKE_DASH_PID"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/config" "X-Indus-Session-Token: $token")"
+    stop_child "$SMOKE_DASH_PID"
+    SMOKE_DASH_PID=""
+    if [ "$status" != 200 ]; then
+        smoke_result dashboard-login FAIL "the page's token was refused ($status)"
+        return 1
+    fi
+    smoke_result dashboard-login PASS "the page's token opens the API"
+}
+
+SMOKE_APPIMAGE=""
+SMOKE_APPDIR=""
+
+step_desktop_download() {
+    local name
+    if [ "$SMOKE_DESKTOP" = skip ]; then
+        smoke_result desktop-download SKIP "--desktop skip"
+        return 0
+    fi
+    if [ "$SMOKE_DESKTOP" != auto ]; then
+        SMOKE_APPIMAGE="$SMOKE_DESKTOP"
+    else
+        while IFS= read -r name; do
+            if bounded 900 curl -fsSL --proto '=https' --tlsv1.2 -o "$SMOKE_WORK/$name" \
+                "$SMOKE_RELEASE_URL/$name" 2>>"$SMOKE_LOGS/desktop-download.log"; then
+                SMOKE_APPIMAGE="$SMOKE_WORK/$name"
+                break
+            fi
+        done < <(smoke_appimage_names)
+    fi
+    if [ -z "$SMOKE_APPIMAGE" ] || [ ! -f "$SMOKE_APPIMAGE" ]; then
+        smoke_result desktop-download FAIL "no AppImage for $(uname -m) on $SMOKE_RELEASE_URL"
+        return 1
+    fi
+    chmod +x "$SMOKE_APPIMAGE"
+    mkdir -p "$SMOKE_WORK/desktop"
+    # Unpacked, it runs without FUSE and its files can be read.
+    if ! (cd "$SMOKE_WORK/desktop" && bounded 300 "$SMOKE_APPIMAGE" --appimage-extract) >"$SMOKE_LOGS/desktop-extract.log" 2>&1; then
+        smoke_result desktop-download FAIL "the AppImage did not unpack: $(last_line "$SMOKE_LOGS/desktop-extract.log")"
+        return 1
+    fi
+    SMOKE_APPDIR="$SMOKE_WORK/desktop/squashfs-root"
+    smoke_result desktop-download PASS "$(basename "$SMOKE_APPIMAGE")"
+}
+
+step_licences() {
+    local missing=""
+    head -n 5 "$SMOKE_CHECKOUT/THIRD_PARTY_NOTICES.md" 2>/dev/null | grep -q '^# Third-party notices' ||
+        missing="checkout"
+    if [ -n "$SMOKE_APPDIR" ]; then
+        head -n 5 "$SMOKE_APPDIR/resources/THIRD_PARTY_NOTICES.md" 2>/dev/null | grep -q '^# Third-party notices' ||
+            missing="${missing:+$missing, }desktop package"
+    fi
+    if [ -n "$missing" ]; then
+        smoke_result licences FAIL "THIRD_PARTY_NOTICES.md missing in: $missing"
+        return 1
+    fi
+    # The desktop app has no licences screen of its own yet (follow-up in the rehearsal log).
+    smoke_result licences PASS "notices in the checkout${SMOKE_APPDIR:+ and the desktop package} (no in-app licences screen yet)"
+}
+
+SMOKE_DESKTOP_PID=""
+
+step_desktop_launch() {
+    local answer
+    if [ -z "$SMOKE_APPDIR" ]; then
+        smoke_result desktop-launch SKIP "no desktop package"
+        return 0
+    fi
+    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
+        smoke_result desktop-launch SKIP "no display (manual: start the AppImage and reach the chat)"
+        return 0
+    fi
+    PATH="$HOME/.local/bin:$PATH" "$SMOKE_APPDIR/AppRun" </dev/null >"$SMOKE_LOGS/desktop.log" 2>&1 &
+    SMOKE_DESKTOP_PID=$!
+    sleep "$SMOKE_DESKTOP_WAIT"
+    if ! kill -0 "$SMOKE_DESKTOP_PID" 2>/dev/null; then
+        smoke_result desktop-launch FAIL "the app exited: $(last_line "$SMOKE_LOGS/desktop.log")"
+        SMOKE_DESKTOP_PID=""
+        return 1
+    fi
+    if [ "$SMOKE_INTERACTIVE" = true ] && [ -t 0 ]; then
+        printf 'Did the desktop window open and reach the chat? [y/N] '
+        read -r answer
+        stop_child "$SMOKE_DESKTOP_PID"
+        SMOKE_DESKTOP_PID=""
+        case "$answer" in
+            y | Y | yes) smoke_result desktop-launch PASS "a person saw the chat" ;;
+            *) smoke_result desktop-launch FAIL "the person did not reach the chat"; return 1 ;;
+        esac
+        return 0
+    fi
+    stop_child "$SMOKE_DESKTOP_PID"
+    SMOKE_DESKTOP_PID=""
+    smoke_result desktop-launch SKIP "running after ${SMOKE_DESKTOP_WAIT}s; chat not confirmed (use --interactive)"
+}
+
+step_uninstall() {
+    if ! bounded 300 "$SMOKE_INDUS" uninstall -y >"$SMOKE_LOGS/uninstall.log" 2>&1; then
+        smoke_result uninstall FAIL "$(last_line "$SMOKE_LOGS/uninstall.log")"
+        return 1
+    fi
+    if [ -e "$SMOKE_CHECKOUT" ] || [ -e "$SMOKE_INDUS" ]; then
+        smoke_result uninstall FAIL "the code or the launcher is still there"
+        return 1
+    fi
+    if [ ! -f "$SMOKE_DATA/state.db" ] || [ ! -f "$SMOKE_DATA/config.yaml" ]; then
+        smoke_result uninstall FAIL "the data was not kept in $SMOKE_DATA"
+        return 1
+    fi
+    smoke_result uninstall PASS "code and launcher removed, sessions and settings kept"
+}
+
+# -- the run --------------------------------------------------------------------------------------
+
+smoke_cleanup() {
+    stop_child "$SMOKE_DESKTOP_PID"
+    stop_child "$SMOKE_DASH_PID"
+    SMOKE_DESKTOP_PID=""
+    SMOKE_DASH_PID=""
+    if [ -n "$SMOKE_MODEL_PID" ]; then
+        kill -TERM "$SMOKE_MODEL_PID" 2>/dev/null || :
+        wait "$SMOKE_MODEL_PID" 2>/dev/null || :
+        exec 7>&- 2>/dev/null || :
+        SMOKE_MODEL_PID=""
+    fi
+    if [ -x "$SMOKE_INDUS" ]; then bounded 60 "$SMOKE_INDUS" gateway stop >/dev/null 2>&1 || :; fi
+}
+
+smoke_main() {
+    local step tool needs_install=true
+    smoke_parse "$@"
+    if [ "$SMOKE_DRY_RUN" = true ]; then
+        smoke_plan
+        printf 'Dry run: nothing was fetched or installed.\n'
+        exit 0
+    fi
+    for tool in curl git bash; do
+        command -v "$tool" >/dev/null 2>&1 || { printf '%s is required\n' "$tool" >&2; exit 1; }
+    done
+    if [ -z "$SMOKE_WORK" ]; then
+        SMOKE_WORK="$(mktemp -d "${TMPDIR:-/tmp}/indus-smoke.XXXXXX")" || exit 1
+    elif [ -e "$SMOKE_WORK" ] && [ -n "$(ls -A "$SMOKE_WORK" 2>/dev/null)" ]; then
+        # The folder is removed at the end: never one that already holds something.
+        printf -- '--workdir must be a new or empty folder: %s\n' "$SMOKE_WORK" >&2
+        exit 2
+    fi
+    mkdir -p "$SMOKE_WORK" || exit 1
+    SMOKE_WORK="$(cd "$SMOKE_WORK" && pwd -P)"
+    SMOKE_LOGS="$SMOKE_WORK/logs"
+    smoke_plan
+    smoke_isolate
+    trap smoke_cleanup EXIT
+    for step in "${SMOKE_STEPS[@]}"; do
+        if [ "$needs_install" = false ] && [ "$step" != desktop-download ] && [ "$step" != desktop-launch ]; then
+            smoke_result "$step" SKIP "the install failed"
+            continue
+        fi
+        case "$step" in
+            install) step_install || needs_install=false ;;
+            version) step_version ;;
+            setup) step_setup ;;
+            turn) step_turn ;;
+            approval) step_approval ;;
+            resume) step_resume ;;
+            doctor) step_doctor ;;
+            dashboard-gate) step_dashboard_gate ;;
+            dashboard-login) step_dashboard_login ;;
+            desktop-download) step_desktop_download ;;
+            licences) step_licences ;;
+            desktop-launch) step_desktop_launch ;;
+            uninstall) step_uninstall ;;
+        esac
+    done
+    smoke_cleanup
+    trap - EXIT
+    printf '\nSummary (%s, %s): %s failed\n%s' "$SMOKE_OS" "$SMOKE_TAG" "$SMOKE_FAILED" "$SMOKE_RESULTS"
+    if [ "$SMOKE_FAILED" -eq 0 ] && [ "$SMOKE_KEEP" = false ]; then
+        rm -rf "$SMOKE_WORK"
+        printf 'Every step passed or was skipped; the work folder was removed.\n'
+        exit 0
+    fi
+    printf 'Logs: %s\n' "$SMOKE_LOGS"
+    [ "$SMOKE_FAILED" -eq 0 ] || exit 1
+    exit 0
+}
+
+if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
+    smoke_main "$@"
+fi
diff --git a/scripts/release/smoke/macos.sh b/scripts/release/smoke/macos.sh
new file mode 100755
index 0000000..b2a271e
--- /dev/null
+++ b/scripts/release/smoke/macos.sh
@@ -0,0 +1,654 @@
+#!/usr/bin/env bash
+# Post-release smoke test for macOS (P25-23).
+#
+#   bash macos.sh --tag vX.Y.Z [--repository OWNER/NAME] [--channel stable|canary]
+#                 [--workdir DIR] [--desktop auto|skip|FILE] [--interactive] [--keep] [--dry-run]
+#
+# Run it on a clean machine or VM right after a release, and on the canary rehearsal artefacts.
+# It uses only what the release published: install.sh from the release's downloads, the desktop
+# DMG from the same release, and the release's own checkout that install.sh puts on disk
+# (its scripted model server is the fake-model endpoint, so no real model or key is needed).
+# Everything runs inside one throwaway folder with its own HOME, so the person's own setup, keys
+# and PATH are never touched.
+#
+# Each step prints one line, `<step> PASS|FAIL|SKIP <detail>`, and the run ends with a summary.
+# Exit 0 when no step failed, 1 otherwise, 2 for a usage error. --dry-run prints the plan and the
+# URLs and fetches nothing. The steps and what they prove are listed in docs/internals/rollback.md
+# (smoke section) and the results go into docs/internals/rehearsal-log.md.
+
+set -u
+
+SMOKE_OS=macos
+# The release base (RELEASE_REPOSITORY in src/indus/foundation/versions.py, D-16.690); a unit test
+# holds this default equal to it.
+SMOKE_DEFAULT_REPOSITORY='indusagi/indus-agent'
+SMOKE_STEPS=(install version setup turn approval resume doctor dashboard-gate dashboard-login
+    desktop-download licences signature desktop-launch uninstall)
+SMOKE_INSTALL_WAIT=1800
+SMOKE_TURN_WAIT=180
+SMOKE_DASHBOARD_WAIT=600
+SMOKE_DESKTOP_WAIT=20
+
+smoke_usage() {
+    cat <<'EOF'
+Usage: macos.sh --tag vX.Y.Z [options]
+
+  --tag TAG                 the release to check (vX.Y.Z or vX.Y.Z-canary.<stamp>)
+  --repository OWNER/NAME   where the release lives (default: the release base)
+  --channel stable|canary   the installer channel (default: from the tag)
+  --workdir DIR             the throwaway folder (default: a new temp folder)
+  --desktop auto|skip|FILE  the DMG: auto (download it), skip, or a local file
+  --interactive             ask a person to confirm what a script cannot see
+  --keep                    keep the work folder even when every step passed
+  --dry-run                 print the plan and the URLs; fetch nothing
+  -h, --help                this help
+EOF
+}
+
+smoke_describe() {
+    case "$1" in
+        install) printf 'download install.sh from the release and install the %s channel' "$SMOKE_CHANNEL" ;;
+        version) printf 'indus --version; indus update --check reports this release' ;;
+        setup) printf 'indus setup --non-interactive; point the model at the fake endpoint' ;;
+        turn) printf 'one turn through the gateway daemon (indus -z)' ;;
+        approval) printf 'a risky command without a person to approve it does not run' ;;
+        resume) printf 'resume the first session by id (indus -r ID -z)' ;;
+        doctor) printf 'indus doctor passes' ;;
+        dashboard-gate) printf 'dashboard on loopback: status public, settings refuse a request without the token' ;;
+        dashboard-login) printf 'dashboard page carries the loopback session token and the API accepts it' ;;
+        desktop-download) printf 'download the DMG from the release and mount it read-only' ;;
+        signature) printf 'the app is signed and notarised (codesign, spctl)' ;;
+        licences) printf 'THIRD_PARTY_NOTICES.md in the checkout and inside the desktop package' ;;
+        desktop-launch) printf 'start the desktop app and reach the chat (a person confirms)' ;;
+        uninstall) printf 'indus uninstall -y removes code and launcher and keeps the data' ;;
+        *) printf '?' ;;
+    esac
+}
+
+# -- arguments ------------------------------------------------------------------------------------
+
+smoke_parse() {
+    SMOKE_TAG=""
+    SMOKE_REPOSITORY="$SMOKE_DEFAULT_REPOSITORY"
+    SMOKE_CHANNEL=""
+    SMOKE_WORK=""
+    SMOKE_DESKTOP=auto
+    SMOKE_INTERACTIVE=false
+    SMOKE_KEEP=false
+    SMOKE_DRY_RUN=false
+    while [ $# -gt 0 ]; do
+        case "$1" in
+            --tag | --repository | --channel | --workdir | --desktop)
+                [ $# -ge 2 ] || { printf '%s needs a value\n' "$1" >&2; exit 2; }
+                case "$1" in
+                    --tag) SMOKE_TAG="$2" ;;
+                    --repository) SMOKE_REPOSITORY="$2" ;;
+                    --channel) SMOKE_CHANNEL="$2" ;;
+                    --workdir) SMOKE_WORK="$2" ;;
+                    --desktop) SMOKE_DESKTOP="$2" ;;
+                esac
+                shift 2
+                ;;
+            --interactive) SMOKE_INTERACTIVE=true; shift ;;
+            --keep) SMOKE_KEEP=true; shift ;;
+            --dry-run) SMOKE_DRY_RUN=true; shift ;;
+            -h | --help) smoke_usage; exit 0 ;;
+            *) printf 'unknown option: %s\n' "$1" >&2; smoke_usage >&2; exit 2 ;;
+        esac
+    done
+    if ! printf '%s\n' "$SMOKE_TAG" | grep -Eq '^v[0-9]{1,3}\.[0-9]+\.[0-9]+(-canary\.[0-9]{8}T[0-9]{6}Z)?$'; then
+        printf 'a release tag is required: --tag vX.Y.Z or vX.Y.Z-canary.<YYYYMMDDTHHMMSSZ>\n' >&2
+        exit 2
+    fi
+    if ! printf '%s\n' "$SMOKE_REPOSITORY" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; then
+        printf -- '--repository must be OWNER/NAME\n' >&2
+        exit 2
+    fi
+    SMOKE_VERSION="${SMOKE_TAG#v}"
+    if [ -z "$SMOKE_CHANNEL" ]; then
+        case "$SMOKE_VERSION" in *-canary.*) SMOKE_CHANNEL=canary ;; *) SMOKE_CHANNEL=stable ;; esac
+    fi
+    case "$SMOKE_CHANNEL" in stable | canary) ;; *) printf -- '--channel must be stable or canary\n' >&2; exit 2 ;; esac
+    SMOKE_RELEASE_URL="https://github.com/$SMOKE_REPOSITORY/releases/download/$SMOKE_TAG"
+}
+
+# The DMG names electron-builder writes for this machine (artifactName
+# Indus-<version>-mac-<arch>.dmg).
+smoke_dmg_names() {
+    case "$(uname -m)" in
+        arm64) printf 'Indus-%s-mac-arm64.dmg\n' "$SMOKE_VERSION" ;;
+        x86_64) printf 'Indus-%s-mac-x64.dmg\n' "$SMOKE_VERSION" ;;
+        *) return 1 ;;
+    esac
+}
+
+smoke_plan() {
+    local step number=0 name
+    printf 'Indus Agent post-release smoke (%s)\n' "$SMOKE_OS"
+    printf '  release:    %s (%s channel) of %s\n' "$SMOKE_TAG" "$SMOKE_CHANNEL" "$SMOKE_REPOSITORY"
+    printf '  installer:  %s/install.sh\n' "$SMOKE_RELEASE_URL"
+    if [ "$SMOKE_DESKTOP" = auto ]; then
+        while IFS= read -r name; do printf '  desktop:    %s/%s\n' "$SMOKE_RELEASE_URL" "$name"; done < <(smoke_dmg_names)
+    else
+        printf '  desktop:    %s\n' "$SMOKE_DESKTOP"
+    fi
+    printf '  fake model: scripts/parity/scripted_model_server.py from the installed checkout\n'
+    for step in "${SMOKE_STEPS[@]}"; do
+        number=$((number + 1))
+        printf '  %2d. %-17s %s\n' "$number" "$step" "$(smoke_describe "$step")"
+    done
+}
+
+# -- results and children -------------------------------------------------------------------------
+
+SMOKE_FAILED=0
+SMOKE_RESULTS=""
+
+smoke_result() { # STEP STATUS DETAIL
+    printf '%-17s %s %s\n' "$1" "$2" "$3"
+    SMOKE_RESULTS="${SMOKE_RESULTS}$(printf '%-17s %s %s' "$1" "$2" "$3")
+"
+    if [ "$2" = FAIL ]; then SMOKE_FAILED=$((SMOKE_FAILED + 1)); fi
+}
+
+# bounded SECONDS CMD...: run CMD (stdin from /dev/null) and stop it, with what it started, by
+# its own pid after SECONDS. Returns CMD's status, or 124 when it was stopped.
+bounded() {
+    local limit=$(($1 * 5)) pid ticks=0
+    shift
+    "$@" </dev/null &
+    pid=$!
+    while kill -0 "$pid" 2>/dev/null; do
+        if [ "$ticks" -ge "$limit" ]; then
+            stop_tree "$pid"
+            wait "$pid" 2>/dev/null
+            return 124
+        fi
+        sleep 0.2
+        ticks=$((ticks + 1))
+    done
+    wait "$pid"
+}
+
+# stop_tree PID: TERM a child we started and everything it started (by parent pid, never by name).
+stop_tree() {
+    local pid="$1" child
+    [ -n "$pid" ] || return 0
+    for child in $(pgrep -P "$pid" 2>/dev/null); do stop_tree "$child"; done
+    kill -TERM "$pid" 2>/dev/null || :
+}
+
+# stop_child PID: stop_tree, then reap the child itself.
+stop_child() {
+    [ -n "$1" ] || return 0
+    stop_tree "$1"
+    wait "$1" 2>/dev/null || :
+}
+
+last_line() { grep -v '^[[:space:]]*$' "$1" 2>/dev/null | tail -n 1 | cut -c1-160; }
+
+# -- the steps ------------------------------------------------------------------------------------
+
+smoke_isolate() {
+    local name
+    for name in $(compgen -e); do
+        case "$name" in INDUS_*) unset "$name" ;; esac
+    done
+    export HOME="$SMOKE_WORK/home"
+    export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
+    export XDG_CACHE_HOME="$HOME/.cache" XDG_STATE_HOME="$HOME/.local/state"
+    export INDUS_TERMINAL_ID=smoke NO_COLOR=1 LANG=C.UTF-8 TZ=UTC
+    unset VIRTUAL_ENV UV_PROJECT_ENVIRONMENT
+    mkdir -p "$HOME" "$SMOKE_LOGS" "$SMOKE_WORK/project" || exit 1
+    SMOKE_INDUS="$HOME/.local/bin/indus"
+    SMOKE_CHECKOUT="$HOME/.indus/indus-agent"
+    SMOKE_DATA="$HOME/.indus"
+}
+
+step_install() {
+    local installed
+    if ! bounded 300 curl -fsSL --proto '=https' --tlsv1.2 -o "$SMOKE_WORK/install.sh" \
+        "$SMOKE_RELEASE_URL/install.sh" 2>"$SMOKE_LOGS/install-download.log"; then
+        smoke_result install FAIL "could not download $SMOKE_RELEASE_URL/install.sh (is the installer attached to the release?)"
+        return 1
+    fi
+    if ! bounded "$SMOKE_INSTALL_WAIT" bash "$SMOKE_WORK/install.sh" --channel "$SMOKE_CHANNEL" \
+        --non-interactive --skip-browser >"$SMOKE_LOGS/install.log" 2>&1; then
+        smoke_result install FAIL "install.sh failed: $(last_line "$SMOKE_LOGS/install.log")"
+        return 1
+    fi
+    if [ ! -x "$SMOKE_INDUS" ]; then
+        smoke_result install FAIL "no launcher at $SMOKE_INDUS after the install"
+        return 1
+    fi
+    installed="$(git -C "$SMOKE_CHECKOUT" describe --tags --exact-match HEAD 2>/dev/null)"
+    if [ "$installed" != "$SMOKE_TAG" ]; then
+        smoke_result install FAIL "installed ${installed:-an untagged commit}, expected $SMOKE_TAG (a newer $SMOKE_CHANNEL release?)"
+        return 1
+    fi
+    smoke_result install PASS "$SMOKE_TAG in $SMOKE_CHECKOUT"
+}
+
+step_version() {
+    local out
+    if ! bounded 60 "$SMOKE_INDUS" --version >"$SMOKE_LOGS/version.log" 2>&1 ||
+        ! grep -q '^Indus Agent ' "$SMOKE_LOGS/version.log" ||
+        ! grep -q '^Install method: git' "$SMOKE_LOGS/version.log"; then
+        smoke_result version FAIL "indus --version: $(last_line "$SMOKE_LOGS/version.log")"
+        return 1
+    fi
+    bounded 120 "$SMOKE_INDUS" update --check >"$SMOKE_LOGS/update-check.log" 2>&1
+    out="$(last_line "$SMOKE_LOGS/update-check.log")"
+    case "$out" in
+        *"already on $SMOKE_VERSION"*) smoke_result version PASS "$(head -n 1 "$SMOKE_LOGS/version.log"); $out" ;;
+        *) smoke_result version FAIL "indus update --check: $out"; return 1 ;;
+    esac
+}
+
+SMOKE_MODEL_PID=""
+
+step_setup() {
+    local python server port="" tries=0 key value
+    if ! bounded 120 "$SMOKE_INDUS" setup --non-interactive >"$SMOKE_LOGS/setup.log" 2>&1; then
+        smoke_result setup FAIL "indus setup --non-interactive: $(last_line "$SMOKE_LOGS/setup.log")"
+        return 1
+    fi
+    python="$SMOKE_CHECKOUT/.venv/bin/python"
+    server="$SMOKE_CHECKOUT/scripts/parity/scripted_model_server.py"
+    if [ ! -f "$server" ]; then
+        smoke_result setup FAIL "the release checkout has no $server"
+        return 1
+    fi
+    # The server serves until its stdin closes: a FIFO held open by this shell keeps it up.
+    mkfifo "$SMOKE_WORK/model.in" && exec 7<>"$SMOKE_WORK/model.in"
+    "$python" "$server" --port 0 --default-script echo <"$SMOKE_WORK/model.in" \
+        >"$SMOKE_WORK/model.out" 2>"$SMOKE_LOGS/model.log" &
+    SMOKE_MODEL_PID=$!
+    while [ -z "$port" ] && [ "$tries" -lt 50 ]; do
+        port="$(sed -n 's/.*"port": *\([0-9][0-9]*\).*/\1/p' "$SMOKE_WORK/model.out" 2>/dev/null)"
+        [ -n "$port" ] || { sleep 0.2; tries=$((tries + 1)); }
+    done
+    if [ -z "$port" ]; then
+        smoke_result setup FAIL "the fake model did not start: $(last_line "$SMOKE_LOGS/model.log")"
+        return 1
+    fi
+    for key in model.provider model.base_url model.default; do
+        case "$key" in
+            model.provider) value=custom ;;
+            model.base_url) value="http://127.0.0.1:$port/v1" ;;
+            model.default) value=echo ;;
+        esac
+        if ! bounded 60 "$SMOKE_INDUS" config set "$key" "$value" >>"$SMOKE_LOGS/setup.log" 2>&1; then
+            smoke_result setup FAIL "indus config set $key: $(last_line "$SMOKE_LOGS/setup.log")"
+            return 1
+        fi
+    done
+    # Secrets stay in the throwaway home, never in this machine's keychain.
+    if ! bounded 60 "$SMOKE_INDUS" config set security.secret_store file >>"$SMOKE_LOGS/setup.log" 2>&1; then
+        smoke_result setup FAIL "indus config set security.secret_store: $(last_line "$SMOKE_LOGS/setup.log")"
+        return 1
+    fi
+    smoke_result setup PASS "fake model on 127.0.0.1:$port"
+}
+
+step_turn() {
+    (cd "$SMOKE_WORK/project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -z "remember the blue kite") \
+        >"$SMOKE_LOGS/turn.log" 2>&1
+    if grep -q 'You said: remember the blue kite' "$SMOKE_LOGS/turn.log"; then
+        smoke_result turn PASS "the reply came back through the gateway daemon"
+    else
+        smoke_result turn FAIL "$(last_line "$SMOKE_LOGS/turn.log")"
+        return 1
+    fi
+}
+
+step_approval() {
+    local project="$SMOKE_WORK/project/repo" answer how session
+    mkdir -p "$project" && (
+        cd "$project" &&
+            git init -q &&
+            printf 'kept\n' >note.txt &&
+            git add note.txt &&
+            git -c user.name=smoke -c user.email=smoke@example.invalid commit -qm seed &&
+            printf 'local change\n' >>note.txt
+    ) >"$SMOKE_LOGS/approval.log" 2>&1 || {
+        smoke_result approval FAIL "could not prepare a git folder: $(last_line "$SMOKE_LOGS/approval.log")"
+        return 1
+    }
+    # The scripted model asks to run `git reset --hard HEAD` (flagged as destructive). A finite
+    # `chat -q` without a terminal has nobody to ask: the run refuses it (single_query_mode) or,
+    # through the gateway daemon, leaves the approval waiting for a terminal. Either way nothing
+    # may run before a person says yes.
+    (cd "$project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -m approve_or_decline chat -q "please tidy the tree") \
+        >>"$SMOKE_LOGS/approval.log" 2>&1
+    if ! grep -q 'local change' "$project/note.txt"; then
+        smoke_result approval FAIL "the risky command ran without an approval"
+        return 1
+    fi
+    if grep -q 'declined' "$SMOKE_LOGS/approval.log"; then
+        how="refused in an unattended run"
+    elif grep -q 'waiting for an answer' "$SMOKE_LOGS/approval.log"; then
+        how="left waiting for an approval"
+    else
+        smoke_result approval FAIL "no refusal and no waiting approval: $(last_line "$SMOKE_LOGS/approval.log")"
+        return 1
+    fi
+    if [ "$SMOKE_INTERACTIVE" = true ] && [ -t 0 ]; then
+        printf '\nNow approve it by hand: Indus opens the chat; answer the approval with yes, then type /quit.\n'
+        session="$(sed -n 's/.*`indus -r \([^`]*\)`.*/\1/p' "$SMOKE_LOGS/approval.log" | head -n 1)"
+        if [ -n "$session" ]; then
+            (cd "$project" && "$SMOKE_INDUS" -r "$session")
+        else
+            (cd "$project" && "$SMOKE_INDUS" -m approve_or_decline chat -q "please tidy the tree")
+        fi
+        printf 'Did Indus ask before running git reset --hard HEAD, and run it after you approved? [y/N] '
+        read -r answer
+        case "$answer" in
+            y | Y | yes) smoke_result approval PASS "$how; asked and ran when a person approved" ;;
+            *) smoke_result approval FAIL "the person did not see the approval work"; return 1 ;;
+        esac
+        return 0
+    fi
+    smoke_result approval PASS "$how, nothing ran (interactive approval: --interactive)"
+}
+
+step_resume() {
+    local id
+    # Through the daemon the session is a cli one; a --local one-shot is listed under oneshot.
+    bounded 60 "$SMOKE_INDUS" sessions list --limit 50 >"$SMOKE_LOGS/sessions.log" 2>&1
+    bounded 60 "$SMOKE_INDUS" sessions list --limit 50 --source oneshot >>"$SMOKE_LOGS/sessions.log" 2>&1
+    id="$(awk '/remember the blue kite/ { print $1; exit }' "$SMOKE_LOGS/sessions.log")"
+    if [ -z "$id" ]; then
+        smoke_result resume FAIL "the first session is not listed: $(last_line "$SMOKE_LOGS/sessions.log")"
+        return 1
+    fi
+    (cd "$SMOKE_WORK/project" && bounded "$SMOKE_TURN_WAIT" "$SMOKE_INDUS" -r "$id" -z "what did I ask") \
+        >"$SMOKE_LOGS/resume.log" 2>&1
+    if grep -q 'You said: what did I ask' "$SMOKE_LOGS/resume.log"; then
+        smoke_result resume PASS "session $id resumed"
+    else
+        smoke_result resume FAIL "$(last_line "$SMOKE_LOGS/resume.log")"
+        return 1
+    fi
+}
+
+step_doctor() {
+    if bounded 180 "$SMOKE_INDUS" doctor >"$SMOKE_LOGS/doctor.log" 2>&1; then
+        smoke_result doctor PASS "$(last_line "$SMOKE_LOGS/doctor.log")"
+    else
+        smoke_result doctor FAIL "$(last_line "$SMOKE_LOGS/doctor.log")"
+        return 1
+    fi
+}
+
+SMOKE_DASH_PID=""
+SMOKE_DASH_URL=""
+
+smoke_http() { # URL [HEADER]: print the HTTP status (000 when nothing answered)
+    if [ $# -ge 2 ]; then
+        curl -s -o "$SMOKE_WORK/http.body" -w '%{http_code}' --max-time 20 -H "$2" "$1" 2>/dev/null || :
+    else
+        curl -s -o "$SMOKE_WORK/http.body" -w '%{http_code}' --max-time 20 "$1" 2>/dev/null || :
+    fi
+}
+
+step_dashboard_gate() {
+    local waited=0 status
+    "$SMOKE_INDUS" dashboard --port 0 --no-open </dev/null >"$SMOKE_LOGS/dashboard.log" 2>&1 &
+    SMOKE_DASH_PID=$!
+    while [ "$waited" -lt "$SMOKE_DASHBOARD_WAIT" ]; do
+        SMOKE_DASH_URL="$(sed -n 's#^Dashboard on \(http://127\.0\.0\.1:[0-9]*\)/.*#\1#p' "$SMOKE_LOGS/dashboard.log" | head -n 1)"
+        [ -z "$SMOKE_DASH_URL" ] || break
+        kill -0 "$SMOKE_DASH_PID" 2>/dev/null || break
+        sleep 1
+        waited=$((waited + 1))
+    done
+    if [ -z "$SMOKE_DASH_URL" ]; then
+        smoke_result dashboard-gate FAIL "the dashboard did not start: $(last_line "$SMOKE_LOGS/dashboard.log")"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/status")"
+    if [ "$status" != 200 ]; then
+        smoke_result dashboard-gate FAIL "GET /api/status answered $status"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/config")"
+    if [ "$status" != 401 ]; then
+        smoke_result dashboard-gate FAIL "GET /api/config without the token answered $status, not 401"
+        return 1
+    fi
+    smoke_result dashboard-gate PASS "$SMOKE_DASH_URL: status 200, settings 401 without the token"
+}
+
+step_dashboard_login() {
+    local status token
+    if [ -z "$SMOKE_DASH_URL" ]; then
+        smoke_result dashboard-login SKIP "the dashboard did not start"
+        return 0
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/")"
+    token="$(sed -n 's/.*__INDUS_SESSION_TOKEN__=["]\([^"]*\)["].*/\1/p' "$SMOKE_WORK/http.body" | head -n 1)"
+    if [ "$status" != 200 ] || [ -z "$token" ]; then
+        smoke_result dashboard-login FAIL "the page answered $status without a session token ($(grep -m 1 -i 'not built\|build failed' "$SMOKE_LOGS/dashboard.log" || printf 'see dashboard.log'))"
+        stop_child "$SMOKE_DASH_PID"
+        return 1
+    fi
+    status="$(smoke_http "$SMOKE_DASH_URL/api/config" "X-Indus-Session-Token: $token")"
+    stop_child "$SMOKE_DASH_PID"
+    SMOKE_DASH_PID=""
+    if [ "$status" != 200 ]; then
+        smoke_result dashboard-login FAIL "the page's token was refused ($status)"
+        return 1
+    fi
+    smoke_result dashboard-login PASS "the page's token opens the API"
+}
+
+SMOKE_DMG=""
+SMOKE_MOUNT=""
+SMOKE_APP=""
+
+step_desktop_download() {
+    local name
+    if [ "$SMOKE_DESKTOP" = skip ]; then
+        smoke_result desktop-download SKIP "--desktop skip"
+        return 0
+    fi
+    if [ "$SMOKE_DESKTOP" != auto ]; then
+        SMOKE_DMG="$SMOKE_DESKTOP"
+    else
+        while IFS= read -r name; do
+            if bounded 900 curl -fsSL --proto '=https' --tlsv1.2 -o "$SMOKE_WORK/$name" \
+                "$SMOKE_RELEASE_URL/$name" 2>>"$SMOKE_LOGS/desktop-download.log"; then
+                SMOKE_DMG="$SMOKE_WORK/$name"
+                break
+            fi
+        done < <(smoke_dmg_names)
+    fi
+    if [ -z "$SMOKE_DMG" ] || [ ! -f "$SMOKE_DMG" ]; then
+        smoke_result desktop-download FAIL "no DMG for $(uname -m) on $SMOKE_RELEASE_URL"
+        return 1
+    fi
+    mkdir -p "$SMOKE_WORK/dmg"
+    if ! bounded 300 hdiutil attach -nobrowse -readonly -mountpoint "$SMOKE_WORK/dmg" "$SMOKE_DMG" \
+        >"$SMOKE_LOGS/desktop-mount.log" 2>&1; then
+        smoke_result desktop-download FAIL "the DMG did not mount: $(last_line "$SMOKE_LOGS/desktop-mount.log")"
+        return 1
+    fi
+    SMOKE_MOUNT="$SMOKE_WORK/dmg"
+    # A copy outside the image, so the app runs the way a person installs it.
+    mkdir -p "$SMOKE_WORK/Applications"
+    if ! ditto "$SMOKE_MOUNT/Indus.app" "$SMOKE_WORK/Applications/Indus.app" 2>"$SMOKE_LOGS/desktop-copy.log"; then
+        smoke_result desktop-download FAIL "Indus.app is not in the DMG: $(last_line "$SMOKE_LOGS/desktop-copy.log")"
+        return 1
+    fi
+    SMOKE_APP="$SMOKE_WORK/Applications/Indus.app"
+    smoke_result desktop-download PASS "$(basename "$SMOKE_DMG")"
+}
+
+step_licences() {
+    local missing=""
+    head -n 5 "$SMOKE_CHECKOUT/THIRD_PARTY_NOTICES.md" 2>/dev/null | grep -q '^# Third-party notices' ||
+        missing="checkout"
+    if [ -n "$SMOKE_APP" ]; then
+        head -n 5 "$SMOKE_APP/Contents/Resources/THIRD_PARTY_NOTICES.md" 2>/dev/null | grep -q '^# Third-party notices' ||
+            missing="${missing:+$missing, }desktop package"
+    fi
+    if [ -n "$missing" ]; then
+        smoke_result licences FAIL "THIRD_PARTY_NOTICES.md missing in: $missing"
+        return 1
+    fi
+    # The desktop app has no licences screen of its own yet (follow-up in the rehearsal log).
+    smoke_result licences PASS "notices in the checkout${SMOKE_APP:+ and the app bundle} (no in-app licences screen yet)"
+}
+
+step_signature() {
+    if [ -z "$SMOKE_APP" ]; then
+        smoke_result signature SKIP "no desktop package"
+        return 0
+    fi
+    if ! codesign --verify --deep --strict "$SMOKE_APP" >"$SMOKE_LOGS/signature.log" 2>&1; then
+        smoke_result signature FAIL "codesign: $(last_line "$SMOKE_LOGS/signature.log") (unsigned until P23-15)"
+        return 1
+    fi
+    if ! spctl --assess --type execute -vv "$SMOKE_APP" >>"$SMOKE_LOGS/signature.log" 2>&1; then
+        smoke_result signature FAIL "Gatekeeper: $(last_line "$SMOKE_LOGS/signature.log")"
+        return 1
+    fi
+    smoke_result signature PASS "$(grep -m 1 'source=' "$SMOKE_LOGS/signature.log" || printf 'accepted')"
+}
+
+SMOKE_DESKTOP_PID=""
+
+step_desktop_launch() {
+    local answer
+    if [ -z "$SMOKE_APP" ]; then
+        smoke_result desktop-launch SKIP "no desktop package"
+        return 0
+    fi
+    if [ -n "${SSH_CONNECTION:-}" ]; then
+        smoke_result desktop-launch SKIP "an SSH session has no screen (manual: open Indus.app and reach the chat)"
+        return 0
+    fi
+    PATH="$HOME/.local/bin:$PATH" "$SMOKE_APP/Contents/MacOS/Indus" </dev/null >"$SMOKE_LOGS/desktop.log" 2>&1 &
+    SMOKE_DESKTOP_PID=$!
+    sleep "$SMOKE_DESKTOP_WAIT"
+    if ! kill -0 "$SMOKE_DESKTOP_PID" 2>/dev/null; then
+        smoke_result desktop-launch FAIL "the app exited: $(last_line "$SMOKE_LOGS/desktop.log")"
+        SMOKE_DESKTOP_PID=""
+        return 1
+    fi
+    if [ "$SMOKE_INTERACTIVE" = true ] && [ -t 0 ]; then
+        printf 'Did the desktop window open and reach the chat? [y/N] '
+        read -r answer
+        stop_child "$SMOKE_DESKTOP_PID"
+        SMOKE_DESKTOP_PID=""
+        case "$answer" in
+            y | Y | yes) smoke_result desktop-launch PASS "a person saw the chat" ;;
+            *) smoke_result desktop-launch FAIL "the person did not reach the chat"; return 1 ;;
+        esac
+        return 0
+    fi
+    stop_child "$SMOKE_DESKTOP_PID"
+    SMOKE_DESKTOP_PID=""
+    smoke_result desktop-launch SKIP "running after ${SMOKE_DESKTOP_WAIT}s; chat not confirmed (use --interactive)"
+}
+
+step_uninstall() {
+    if ! bounded 300 "$SMOKE_INDUS" uninstall -y >"$SMOKE_LOGS/uninstall.log" 2>&1; then
+        smoke_result uninstall FAIL "$(last_line "$SMOKE_LOGS/uninstall.log")"
+        return 1
+    fi
+    if [ -e "$SMOKE_CHECKOUT" ] || [ -e "$SMOKE_INDUS" ]; then
+        smoke_result uninstall FAIL "the code or the launcher is still there"
+        return 1
+    fi
+    if [ ! -f "$SMOKE_DATA/state.db" ] || [ ! -f "$SMOKE_DATA/config.yaml" ]; then
+        smoke_result uninstall FAIL "the data was not kept in $SMOKE_DATA"
+        return 1
+    fi
+    smoke_result uninstall PASS "code and launcher removed, sessions and settings kept"
+}
+
+# -- the run --------------------------------------------------------------------------------------
+
+smoke_cleanup() {
+    stop_child "$SMOKE_DESKTOP_PID"
+    stop_child "$SMOKE_DASH_PID"
+    SMOKE_DESKTOP_PID=""
+    SMOKE_DASH_PID=""
+    if [ -n "$SMOKE_MODEL_PID" ]; then
+        kill -TERM "$SMOKE_MODEL_PID" 2>/dev/null || :
+        wait "$SMOKE_MODEL_PID" 2>/dev/null || :
+        exec 7>&- 2>/dev/null || :
+        SMOKE_MODEL_PID=""
+    fi
+    if [ -x "$SMOKE_INDUS" ]; then bounded 60 "$SMOKE_INDUS" gateway stop >/dev/null 2>&1 || :; fi
+    if [ -n "$SMOKE_MOUNT" ]; then
+        hdiutil detach -quiet "$SMOKE_MOUNT" >/dev/null 2>&1 || :
+        SMOKE_MOUNT=""
+    fi
+}
+
+smoke_main() {
+    local step tool needs_install=true
+    smoke_parse "$@"
+    if [ "$SMOKE_DRY_RUN" = true ]; then
+        smoke_plan
+        printf 'Dry run: nothing was fetched or installed.\n'
+        exit 0
+    fi
+    for tool in curl git bash hdiutil ditto; do
+        command -v "$tool" >/dev/null 2>&1 || { printf '%s is required\n' "$tool" >&2; exit 1; }
+    done
+    if [ -z "$SMOKE_WORK" ]; then
+        SMOKE_WORK="$(mktemp -d "${TMPDIR:-/tmp}/indus-smoke.XXXXXX")" || exit 1
+    elif [ -e "$SMOKE_WORK" ] && [ -n "$(ls -A "$SMOKE_WORK" 2>/dev/null)" ]; then
+        # The folder is removed at the end: never one that already holds something.
+        printf -- '--workdir must be a new or empty folder: %s\n' "$SMOKE_WORK" >&2
+        exit 2
+    fi
+    mkdir -p "$SMOKE_WORK" || exit 1
+    SMOKE_WORK="$(cd "$SMOKE_WORK" && pwd -P)"
+    SMOKE_LOGS="$SMOKE_WORK/logs"
+    smoke_plan
+    smoke_isolate
+    trap smoke_cleanup EXIT
+    for step in "${SMOKE_STEPS[@]}"; do
+        if [ "$needs_install" = false ] && [ "$step" != desktop-download ] && [ "$step" != signature ] &&
+            [ "$step" != desktop-launch ]; then
+            smoke_result "$step" SKIP "the install failed"
+            continue
+        fi
+        case "$step" in
+            install) step_install || needs_install=false ;;
+            version) step_version ;;
+            setup) step_setup ;;
+            turn) step_turn ;;
+            approval) step_approval ;;
+            resume) step_resume ;;
+            doctor) step_doctor ;;
+            dashboard-gate) step_dashboard_gate ;;
+            dashboard-login) step_dashboard_login ;;
+            desktop-download) step_desktop_download ;;
+            licences) step_licences ;;
+            signature) step_signature ;;
+            desktop-launch) step_desktop_launch ;;
+            uninstall) step_uninstall ;;
+        esac
+    done
+    smoke_cleanup
+    trap - EXIT
+    printf '\nSummary (%s, %s): %s failed\n%s' "$SMOKE_OS" "$SMOKE_TAG" "$SMOKE_FAILED" "$SMOKE_RESULTS"
+    if [ "$SMOKE_FAILED" -eq 0 ] && [ "$SMOKE_KEEP" = false ]; then
+        rm -rf "$SMOKE_WORK"
+        printf 'Every step passed or was skipped; the work folder was removed.\n'
+        exit 0
+    fi
+    printf 'Logs: %s\n' "$SMOKE_LOGS"
+    [ "$SMOKE_FAILED" -eq 0 ] || exit 1
+    exit 0
+}
+
+if [ "${BASH_SOURCE[0]:-$0}" = "$0" ]; then
+    smoke_main "$@"
+fi
diff --git a/scripts/release/smoke/windows.ps1 b/scripts/release/smoke/windows.ps1
new file mode 100644
index 0000000..e097218
--- /dev/null
+++ b/scripts/release/smoke/windows.ps1
@@ -0,0 +1,684 @@
+<#
+.SYNOPSIS
+Post-release smoke test for Windows (P25-23).
+
+.DESCRIPTION
+    powershell -ExecutionPolicy Bypass -File windows.ps1 -Tag vX.Y.Z [-Repository OWNER/NAME]
+        [-Channel stable|canary] [-WorkDir DIR] [-Desktop auto|skip|FILE] [-Interactive] [-Keep]
+        [-DryRun]
+
+Run it on a clean Windows machine or VM right after a release, and on the canary rehearsal
+artefacts. It uses only what the release published: install.ps1 from the release's downloads, the
+desktop installer from the same release, and the release's own checkout that install.ps1 puts on
+disk (its scripted model server is the fake-model endpoint, so no real model or key is needed).
+The Indus home and the code go into one throwaway folder. Windows has no per-run HOME, so the
+install adds its bin folder to this user's PATH and the desktop installer installs per user; the
+uninstall steps take both away again.
+
+Each step prints one line, "<step> PASS|FAIL|SKIP <detail>", and the run ends with a summary.
+Exit 0 when no step failed, 1 otherwise, 2 for a usage error. -DryRun prints the plan and the URLs
+and fetches nothing. Results go into docs/internals/rehearsal-log.md.
+#>
+[CmdletBinding()]
+param(
+    [string]$Tag = "",
+    [string]$Repository = "",
+    [string]$Channel = "",
+    [string]$WorkDir = "",
+    [string]$Desktop = "auto",
+    [switch]$Interactive,
+    [switch]$Keep,
+    [switch]$DryRun
+)
+
+Set-StrictMode -Version 2.0
+$ErrorActionPreference = 'Continue'
+
+$SmokeOs = 'windows'
+# The release base (RELEASE_REPOSITORY in src/indus/foundation/versions.py, D-16.690); a unit test
+# holds this default equal to it.
+$SmokeDefaultRepository = 'indusagi/indus-agent'
+$SmokeSteps = @(
+    'install', 'version', 'setup', 'turn', 'approval', 'resume', 'doctor', 'dashboard-gate',
+    'dashboard-login', 'desktop-download', 'licences', 'signature', 'desktop-launch', 'uninstall'
+)
+$SmokeInstallWait = 1800
+$SmokeTurnWait = 180
+$SmokeDashboardWait = 600
+$SmokeDesktopWait = 20
+
+function Get-SmokeDescription([string]$Step) {
+    switch ($Step) {
+        'install' { return "download install.ps1 from the release and install the $script:Channel channel" }
+        'version' { return 'indus --version; indus update --check reports this release' }
+        'setup' { return 'indus setup --non-interactive; point the model at the fake endpoint' }
+        'turn' { return 'one turn through the gateway daemon (indus -z)' }
+        'approval' { return 'a risky command without a person to approve it does not run' }
+        'resume' { return 'resume the first session by id (indus -r ID -z)' }
+        'doctor' { return 'indus doctor passes' }
+        'dashboard-gate' { return 'dashboard on loopback: status public, settings refuse a request without the token' }
+        'dashboard-login' { return "dashboard page carries the loopback session token and the API accepts it" }
+        'desktop-download' { return 'download the desktop installer from the release and install it for this user' }
+        'signature' { return 'the installer and the app are signed (Authenticode)' }
+        'licences' { return 'THIRD_PARTY_NOTICES.md in the checkout and inside the installed app' }
+        'desktop-launch' { return 'start the desktop app and reach the chat (a person confirms)' }
+        'uninstall' { return 'indus uninstall -y removes code, launcher and PATH entry and keeps the data' }
+        default { return '?' }
+    }
+}
+
+# -- arguments ------------------------------------------------------------------------------------
+
+if ($Repository -eq '') { $Repository = $SmokeDefaultRepository }
+if ($Tag -notmatch '^v[0-9]{1,3}\.[0-9]+\.[0-9]+(-canary\.[0-9]{8}T[0-9]{6}Z)?$') {
+    [Console]::Error.WriteLine('a release tag is required: -Tag vX.Y.Z or vX.Y.Z-canary.<YYYYMMDDTHHMMSSZ>')
+    exit 2
+}
+if ($Repository -notmatch '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$') {
+    [Console]::Error.WriteLine('-Repository must be OWNER/NAME')
+    exit 2
+}
+$Version = $Tag.Substring(1)
+if ($Channel -eq '') {
+    if ($Version -like '*-canary.*') { $Channel = 'canary' } else { $Channel = 'stable' }
+}
+if ($Channel -ne 'stable' -and $Channel -ne 'canary') {
+    [Console]::Error.WriteLine('-Channel must be stable or canary')
+    exit 2
+}
+$ReleaseUrl = "https://github.com/$Repository/releases/download/$Tag"
+
+# The installer names electron-builder writes (nsis artifactName Indus-Setup-<version>-<arch>.exe).
+function Get-SmokeSetupNames {
+    if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64') { return @("Indus-Setup-$Version-arm64.exe") }
+    return @("Indus-Setup-$Version-x64.exe")
+}
+
+function Show-SmokePlan {
+    Write-Host "Indus Agent post-release smoke ($SmokeOs)"
+    Write-Host "  release:    $Tag ($Channel channel) of $Repository"
+    Write-Host "  installer:  $ReleaseUrl/install.ps1"
+    if ($Desktop -eq 'auto') {
+        foreach ($name in Get-SmokeSetupNames) { Write-Host "  desktop:    $ReleaseUrl/$name" }
+    } else {
+        Write-Host "  desktop:    $Desktop"
+    }
+    Write-Host '  fake model: scripts\parity\scripted_model_server.py from the installed checkout'
+    $number = 0
+    foreach ($step in $SmokeSteps) {
+        $number += 1
+        Write-Host ('  {0,2}. {1,-17} {2}' -f $number, $step, (Get-SmokeDescription $step))
+    }
+}
+
+if ($DryRun) {
+    Show-SmokePlan
+    Write-Host 'Dry run: nothing was fetched or installed.'
+    exit 0
+}
+
+# -- results and children -------------------------------------------------------------------------
+
+$script:Failed = 0
+$script:Results = New-Object System.Collections.Generic.List[string]
+
+function Add-SmokeResult([string]$Step, [string]$Status, [string]$Detail) {
+    $line = '{0,-17} {1} {2}' -f $Step, $Status, $Detail
+    Write-Host $line
+    $script:Results.Add($line)
+    if ($Status -eq 'FAIL') { $script:Failed += 1 }
+}
+
+function Stop-SmokeTree([int]$ProcessId) {
+    if ($ProcessId -le 0) { return }
+    $children = @(Get-CimInstance Win32_Process -Filter "ParentProcessId=$ProcessId" -ErrorAction SilentlyContinue)
+    foreach ($child in $children) { Stop-SmokeTree ([int]$child.ProcessId) }
+    Stop-Process -Id $ProcessId -Force -ErrorAction SilentlyContinue
+}
+
+function ConvertTo-SmokeArgument([string]$Value) {
+    if ($Value -eq '') { return '""' }
+    if ($Value -notmatch '[\s"]') { return $Value }
+    return '"' + ($Value -replace '(\\*)"', '$1$1\"' -replace '(\\+)$', '$1$1') + '"'
+}
+
+# Invoke-Bounded SECONDS LOG FILE ARGS...: run FILE with ARGS, stdin empty, stdout and stderr into
+# LOG; stop it (and what it started) by its own pid after SECONDS. Returns the exit code, or 124.
+function Invoke-Bounded([int]$Seconds, [string]$Log, [string]$FilePath, [string[]]$Arguments = @(), [string]$WorkingDirectory = '') {
+    if ($WorkingDirectory -eq '') { $WorkingDirectory = $script:Work }
+    $joined = ($Arguments | ForEach-Object { ConvertTo-SmokeArgument $_ }) -join ' '
+    $start = @{
+        FilePath               = $FilePath
+        WorkingDirectory       = $WorkingDirectory
+        RedirectStandardInput  = $script:Empty
+        RedirectStandardOutput = "$Log.out"
+        RedirectStandardError  = "$Log.err"
+        NoNewWindow            = $true
+        PassThru               = $true
+    }
+    if ($joined -ne '') { $start.ArgumentList = $joined }
+    try {
+        $process = Start-Process @start
+    } catch {
+        Set-Content -Path $Log -Value "could not start ${FilePath}: $($_.Exception.Message)"
+        return 127
+    }
+    $null = $process.Handle  # keeps the exit code readable after the process ends
+    if (-not $process.WaitForExit($Seconds * 1000)) {
+        Stop-SmokeTree $process.Id
+        $code = 124
+    } else {
+        $process.WaitForExit()
+        $code = $process.ExitCode
+    }
+    $text = @()
+    foreach ($part in @("$Log.out", "$Log.err")) {
+        if (Test-Path $part) { $text += Get-Content -Path $part -ErrorAction SilentlyContinue; Remove-Item $part -Force }
+    }
+    Set-Content -Path $Log -Value $text
+    return $code
+}
+
+function Get-LastLine([string]$Path) {
+    if (-not (Test-Path $Path)) { return '' }
+    $lines = @(Get-Content -Path $Path | Where-Object { $_.Trim() -ne '' })
+    if ($lines.Count -eq 0) { return '' }
+    $last = [string]$lines[$lines.Count - 1]
+    if ($last.Length -gt 160) { $last = $last.Substring(0, 160) }
+    return $last
+}
+
+function Test-LogContains([string]$Path, [string]$Text) {
+    if (-not (Test-Path $Path)) { return $false }
+    return [bool](Select-String -Path $Path -SimpleMatch -Pattern $Text -Quiet)
+}
+
+function Invoke-Indus([int]$Seconds, [string]$Log, [string[]]$Arguments, [string]$WorkingDirectory = '') {
+    return Invoke-Bounded $Seconds $Log $script:Indus $Arguments $WorkingDirectory
+}
+
+function Get-SmokeHttp([string]$Url, [hashtable]$Headers = @{}) {
+    try {
+        $response = Invoke-WebRequest -Uri $Url -Headers $Headers -UseBasicParsing -TimeoutSec 20
+        $script:HttpBody = [string]$response.Content
+        return [int]$response.StatusCode
+    } catch {
+        $script:HttpBody = ''
+        $failed = $_.Exception.Response
+        if ($null -ne $failed) { return [int]$failed.StatusCode }
+        return 0
+    }
+}
+
+# -- the steps ------------------------------------------------------------------------------------
+
+function Step-Install {
+    $script:InstallerFile = Join-Path $script:Work 'install.ps1'
+    try {
+        Invoke-WebRequest -Uri "$ReleaseUrl/install.ps1" -OutFile $script:InstallerFile -UseBasicParsing -TimeoutSec 300
+    } catch {
+        Add-SmokeResult 'install' 'FAIL' "could not download $ReleaseUrl/install.ps1 (is the installer attached to the release?)"
+        return $false
+    }
+    $shell = (Get-Process -Id $PID).Path
+    $log = Join-Path $script:Logs 'install.log'
+    $code = Invoke-Bounded $SmokeInstallWait $log $shell @(
+        '-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', $script:InstallerFile,
+        '-Channel', $Channel, '-IndusHome', $script:IndusHome, '-InstallDir', $script:Checkout,
+        '-NonInteractive', '-SkipBrowser'
+    )
+    if ($code -ne 0) {
+        Add-SmokeResult 'install' 'FAIL' "install.ps1 failed ($code): $(Get-LastLine $log)"
+        return $false
+    }
+    if (-not (Test-Path $script:Indus)) {
+        Add-SmokeResult 'install' 'FAIL' "no launcher at $($script:Indus) after the install"
+        return $false
+    }
+    $git = Get-SmokeGit
+    $installed = ''
+    if ($git) { $installed = (& $git -C $script:Checkout describe --tags --exact-match HEAD 2>$null) }
+    if ([string]$installed -ne $Tag) {
+        Add-SmokeResult 'install' 'FAIL' "installed $installed, expected $Tag (a newer $Channel release?)"
+        return $false
+    }
+    Add-SmokeResult 'install' 'PASS' "$Tag in $($script:Checkout)"
+    return $true
+}
+
+function Get-SmokeGit {
+    $found = Get-Command git -ErrorAction SilentlyContinue
+    if ($found) { return $found.Source }
+    $portable = Get-ChildItem -Path (Join-Path $script:IndusHome 'tools') -Filter git.exe -Recurse -ErrorAction SilentlyContinue |
+        Where-Object { $_.DirectoryName -like '*\cmd' } | Select-Object -First 1
+    if ($portable) { return $portable.FullName }
+    return $null
+}
+
+function Step-Version {
+    $log = Join-Path $script:Logs 'version.log'
+    $code = Invoke-Indus 60 $log @('--version')
+    if ($code -ne 0 -or -not (Test-LogContains $log 'Indus Agent ') -or -not (Test-LogContains $log 'Install method: git')) {
+        Add-SmokeResult 'version' 'FAIL' "indus --version: $(Get-LastLine $log)"
+        return
+    }
+    $check = Join-Path $script:Logs 'update-check.log'
+    $null = Invoke-Indus 120 $check @('update', '--check')
+    $line = Get-LastLine $check
+    if ($line -like "*already on $Version*") {
+        Add-SmokeResult 'version' 'PASS' "$((Get-Content $log | Select-Object -First 1)); $line"
+    } else {
+        Add-SmokeResult 'version' 'FAIL' "indus update --check: $line"
+    }
+}
+
+$script:Model = $null
+
+function Step-Setup {
+    $log = Join-Path $script:Logs 'setup.log'
+    if ((Invoke-Indus 120 $log @('setup', '--non-interactive')) -ne 0) {
+        Add-SmokeResult 'setup' 'FAIL' "indus setup --non-interactive: $(Get-LastLine $log)"
+        return
+    }
+    $python = Join-Path $script:Checkout '.venv\Scripts\python.exe'
+    $server = Join-Path $script:Checkout 'scripts\parity\scripted_model_server.py'
+    if (-not (Test-Path $server)) {
+        Add-SmokeResult 'setup' 'FAIL' "the release checkout has no $server"
+        return
+    }
+    # The server serves until its stdin closes: this script holds the pipe open.
+    $info = New-Object System.Diagnostics.ProcessStartInfo
+    $info.FileName = $python
+    $info.Arguments = (@($server, '--port', '0', '--default-script', 'echo') | ForEach-Object { ConvertTo-SmokeArgument $_ }) -join ' '
+    $info.UseShellExecute = $false
+    $info.RedirectStandardInput = $true
+    $info.RedirectStandardOutput = $true
+    $info.CreateNoWindow = $true
+    try {
+        $script:Model = [System.Diagnostics.Process]::Start($info)
+    } catch {
+        Add-SmokeResult 'setup' 'FAIL' "the fake model did not start: $($_.Exception.Message)"
+        return
+    }
+    $first = $script:Model.StandardOutput.ReadLineAsync()
+    $port = ''
+    if ($first.Wait(10000) -and ([string]$first.Result -match '"port":\s*([0-9]+)')) { $port = $Matches[1] }
+    if ($port -eq '') {
+        Add-SmokeResult 'setup' 'FAIL' 'the fake model did not report its port'
+        return
+    }
+    $settings = [ordered]@{
+        'model.provider'        = 'custom'
+        'model.base_url'        = "http://127.0.0.1:$port/v1"
+        'model.default'         = 'echo'
+        # Secrets stay in the throwaway home, never in this user's Credential Manager.
+        'security.secret_store' = 'file'
+    }
+    foreach ($key in $settings.Keys) {
+        $one = Join-Path $script:Logs "setup-$key.log"
+        if ((Invoke-Indus 60 $one @('config', 'set', $key, $settings[$key])) -ne 0) {
+            Add-SmokeResult 'setup' 'FAIL' "indus config set ${key}: $(Get-LastLine $one)"
+            return
+        }
+    }
+    Add-SmokeResult 'setup' 'PASS' "fake model on 127.0.0.1:$port"
+}
+
+function Step-Turn {
+    $log = Join-Path $script:Logs 'turn.log'
+    $null = Invoke-Indus $SmokeTurnWait $log @('-z', 'remember the blue kite') $script:Project
+    if (Test-LogContains $log 'You said: remember the blue kite') {
+        Add-SmokeResult 'turn' 'PASS' 'the reply came back through the gateway daemon'
+    } else {
+        Add-SmokeResult 'turn' 'FAIL' (Get-LastLine $log)
+    }
+}
+
+function Step-Approval {
+    $log = Join-Path $script:Logs 'approval.log'
+    $git = Get-SmokeGit
+    if (-not $git) {
+        Add-SmokeResult 'approval' 'FAIL' 'git was not found (on PATH or under the Indus tools folder)'
+        return
+    }
+    $repo = Join-Path $script:Project 'repo'
+    New-Item -ItemType Directory -Force -Path $repo | Out-Null
+    $note = Join-Path $repo 'note.txt'
+    Set-Content -Path $note -Value 'kept'
+    & $git -C $repo init -q *> $null
+    & $git -C $repo add note.txt *> $null
+    & $git -C $repo -c user.name=smoke -c user.email=smoke@example.invalid commit -qm seed *> $null
+    Add-Content -Path $note -Value 'local change'
+    # The scripted model asks to run `git reset --hard HEAD` (flagged as destructive). A finite
+    # `chat -q` without a terminal has nobody to ask: the run refuses it (single_query_mode) or,
+    # through the gateway daemon, leaves the approval waiting for a terminal. Either way nothing
+    # may run before a person says yes.
+    $null = Invoke-Indus $SmokeTurnWait $log @('-m', 'approve_or_decline', 'chat', '-q', 'please tidy the tree') $repo
+    if (-not (Test-LogContains $note 'local change')) {
+        Add-SmokeResult 'approval' 'FAIL' 'the risky command ran without an approval'
+        return
+    }
+    if (Test-LogContains $log 'declined') {
+        $how = 'refused in an unattended run'
+    } elseif (Test-LogContains $log 'waiting for an answer') {
+        $how = 'left waiting for an approval'
+    } else {
+        Add-SmokeResult 'approval' 'FAIL' "no refusal and no waiting approval: $(Get-LastLine $log)"
+        return
+    }
+    if ($Interactive) {
+        Write-Host ''
+        Write-Host 'Now approve it by hand: Indus opens the chat; answer the approval with yes, then type /quit.'
+        $session = ''
+        $waiting = Select-String -Path $log -Pattern 'indus -r ([^`]+)`' | Select-Object -First 1
+        if ($waiting) { $session = $waiting.Matches[0].Groups[1].Value }
+        Push-Location $repo
+        if ($session -ne '') {
+            & $script:Indus -r $session
+        } else {
+            & $script:Indus -m approve_or_decline chat -q 'please tidy the tree'
+        }
+        Pop-Location
+        $answer = Read-Host 'Did Indus ask before running git reset --hard HEAD, and run it after you approved? [y/N]'
+        if ($answer -match '^(y|yes)$') {
+            Add-SmokeResult 'approval' 'PASS' "$how; asked and ran when a person approved"
+        } else {
+            Add-SmokeResult 'approval' 'FAIL' 'the person did not see the approval work'
+        }
+        return
+    }
+    Add-SmokeResult 'approval' 'PASS' "$how, nothing ran (interactive approval: -Interactive)"
+}
+
+function Step-Resume {
+    # Through the daemon the session is a cli one; a --local one-shot is listed under oneshot.
+    $list = Join-Path $script:Logs 'sessions.log'
+    $oneshot = Join-Path $script:Logs 'sessions-oneshot.log'
+    $null = Invoke-Indus 60 $list @('sessions', 'list', '--limit', '50')
+    $null = Invoke-Indus 60 $oneshot @('sessions', 'list', '--limit', '50', '--source', 'oneshot')
+    $row = @(Get-Content $list, $oneshot -ErrorAction SilentlyContinue) | Where-Object { $_ -like '*remember the blue kite*' } | Select-Object -First 1
+    if (-not $row) {
+        Add-SmokeResult 'resume' 'FAIL' "the first session is not listed: $(Get-LastLine $list)"
+        return
+    }
+    $id = ([string]$row).Trim().Split(' ')[0]
+    $log = Join-Path $script:Logs 'resume.log'
+    $null = Invoke-Indus $SmokeTurnWait $log @('-r', $id, '-z', 'what did I ask') $script:Project
+    if (Test-LogContains $log 'You said: what did I ask') {
+        Add-SmokeResult 'resume' 'PASS' "session $id resumed"
+    } else {
+        Add-SmokeResult 'resume' 'FAIL' (Get-LastLine $log)
+    }
+}
+
+function Step-Doctor {
+    $log = Join-Path $script:Logs 'doctor.log'
+    if ((Invoke-Indus 180 $log @('doctor')) -eq 0) {
+        Add-SmokeResult 'doctor' 'PASS' (Get-LastLine $log)
+    } else {
+        Add-SmokeResult 'doctor' 'FAIL' (Get-LastLine $log)
+    }
+}
+
+$script:Dashboard = $null
+$script:DashboardUrl = ''
+
+function Step-DashboardGate {
+    $out = Join-Path $script:Logs 'dashboard.log'
+    $script:Dashboard = Start-Process -FilePath $script:Indus -ArgumentList 'dashboard --port 0 --no-open' `
+        -RedirectStandardInput $script:Empty -RedirectStandardOutput $out -RedirectStandardError "$out.err" `
+        -WorkingDirectory $script:Work -NoNewWindow -PassThru
+    $waited = 0
+    while ($waited -lt $SmokeDashboardWait) {
+        $line = Get-Content $out -ErrorAction SilentlyContinue | Where-Object { $_ -match '^Dashboard on (http://127\.0\.0\.1:[0-9]+)/' } | Select-Object -First 1
+        if ($line -and ($line -match '^Dashboard on (http://127\.0\.0\.1:[0-9]+)/')) { $script:DashboardUrl = $Matches[1]; break }
+        if ($script:Dashboard.HasExited) { break }
+        Start-Sleep -Seconds 1
+        $waited += 1
+    }
+    if ($script:DashboardUrl -eq '') {
+        Add-SmokeResult 'dashboard-gate' 'FAIL' "the dashboard did not start: $(Get-LastLine $out)"
+        return
+    }
+    $status = Get-SmokeHttp "$($script:DashboardUrl)/api/status"
+    if ($status -ne 200) {
+        Add-SmokeResult 'dashboard-gate' 'FAIL' "GET /api/status answered $status"
+        return
+    }
+    $status = Get-SmokeHttp "$($script:DashboardUrl)/api/config"
+    if ($status -ne 401) {
+        Add-SmokeResult 'dashboard-gate' 'FAIL' "GET /api/config without the token answered $status, not 401"
+        return
+    }
+    Add-SmokeResult 'dashboard-gate' 'PASS' "$($script:DashboardUrl): status 200, settings 401 without the token"
+}
+
+function Step-DashboardLogin {
+    if ($script:DashboardUrl -eq '') {
+        Add-SmokeResult 'dashboard-login' 'SKIP' 'the dashboard did not start'
+        return
+    }
+    $status = Get-SmokeHttp "$($script:DashboardUrl)/"
+    $token = ''
+    if ($script:HttpBody -match '__INDUS_SESSION_TOKEN__="([^"]*)"') { $token = $Matches[1] }
+    if ($status -ne 200 -or $token -eq '') {
+        Add-SmokeResult 'dashboard-login' 'FAIL' "the page answered $status without a session token (see dashboard.log)"
+        Stop-SmokeTree $script:Dashboard.Id
+        $script:Dashboard = $null
+        return
+    }
+    $status = Get-SmokeHttp "$($script:DashboardUrl)/api/config" @{ 'X-Indus-Session-Token' = $token }
+    Stop-SmokeTree $script:Dashboard.Id
+    $script:Dashboard = $null
+    if ($status -ne 200) {
+        Add-SmokeResult 'dashboard-login' 'FAIL' "the page's token was refused ($status)"
+        return
+    }
+    Add-SmokeResult 'dashboard-login' 'PASS' "the page's token opens the API"
+}
+
+$script:SetupFile = ''
+$script:AppDir = ''
+$script:DesktopInstalled = $false
+
+function Step-DesktopDownload {
+    if ($Desktop -eq 'skip') {
+        Add-SmokeResult 'desktop-download' 'SKIP' '-Desktop skip'
+        return
+    }
+    if ($Desktop -ne 'auto') {
+        $script:SetupFile = $Desktop
+    } else {
+        foreach ($name in Get-SmokeSetupNames) {
+            $target = Join-Path $script:Work $name
+            try {
+                Invoke-WebRequest -Uri "$ReleaseUrl/$name" -OutFile $target -UseBasicParsing -TimeoutSec 900
+                $script:SetupFile = $target
+                break
+            } catch { continue }
+        }
+    }
+    if ($script:SetupFile -eq '' -or -not (Test-Path $script:SetupFile)) {
+        Add-SmokeResult 'desktop-download' 'FAIL' "no desktop installer for $($env:PROCESSOR_ARCHITECTURE) on $ReleaseUrl"
+        return
+    }
+    $log = Join-Path $script:Logs 'desktop-install.log'
+    $code = Invoke-Bounded 600 $log $script:SetupFile @('/S')
+    $script:AppDir = Join-Path $env:LOCALAPPDATA 'Programs\Indus'
+    if ($code -ne 0 -or -not (Test-Path (Join-Path $script:AppDir 'Indus.exe'))) {
+        Add-SmokeResult 'desktop-download' 'FAIL' "the per-user install did not finish ($code)"
+        $script:AppDir = ''
+        return
+    }
+    $script:DesktopInstalled = $true
+    Add-SmokeResult 'desktop-download' 'PASS' "$(Split-Path $script:SetupFile -Leaf) installed into $($script:AppDir)"
+}
+
+function Step-Signature {
+    if ($script:SetupFile -eq '' -or $script:AppDir -eq '') {
+        Add-SmokeResult 'signature' 'SKIP' 'no desktop package'
+        return
+    }
+    $bad = @()
+    foreach ($file in @($script:SetupFile, (Join-Path $script:AppDir 'Indus.exe'))) {
+        $signature = Get-AuthenticodeSignature -FilePath $file
+        if ($signature.Status -ne 'Valid') { $bad += "$(Split-Path $file -Leaf): $($signature.Status)" }
+    }
+    if ($bad.Count -gt 0) {
+        Add-SmokeResult 'signature' 'FAIL' "$($bad -join '; ') (unsigned until P23-16)"
+        return
+    }
+    $signer = (Get-AuthenticodeSignature -FilePath $script:SetupFile).SignerCertificate.Subject
+    Add-SmokeResult 'signature' 'PASS' "signed by $signer"
+}
+
+function Step-Licences {
+    $missing = @()
+    $notices = Join-Path $script:Checkout 'THIRD_PARTY_NOTICES.md'
+    if (-not (Test-Path $notices) -or -not (Get-Content $notices -TotalCount 5 | Where-Object { $_ -eq '# Third-party notices' })) {
+        $missing += 'checkout'
+    }
+    if ($script:AppDir -ne '') {
+        $inside = Join-Path $script:AppDir 'resources\THIRD_PARTY_NOTICES.md'
+        if (-not (Test-Path $inside) -or -not (Get-Content $inside -TotalCount 5 | Where-Object { $_ -eq '# Third-party notices' })) {
+            $missing += 'desktop package'
+        }
+    }
+    if ($missing.Count -gt 0) {
+        Add-SmokeResult 'licences' 'FAIL' "THIRD_PARTY_NOTICES.md missing in: $($missing -join ', ')"
+        return
+    }
+    # The desktop app has no licences screen of its own yet (follow-up in the rehearsal log).
+    $where = 'the checkout'
+    if ($script:AppDir -ne '') { $where = 'the checkout and the installed app' }
+    Add-SmokeResult 'licences' 'PASS' "notices in $where (no in-app licences screen yet)"
+}
+
+function Step-DesktopLaunch {
+    if ($script:AppDir -eq '') {
+        Add-SmokeResult 'desktop-launch' 'SKIP' 'no desktop package'
+        return
+    }
+    $app = Start-Process -FilePath (Join-Path $script:AppDir 'Indus.exe') -PassThru
+    Start-Sleep -Seconds $SmokeDesktopWait
+    if ($app.HasExited) {
+        Add-SmokeResult 'desktop-launch' 'FAIL' "the app exited ($($app.ExitCode))"
+        return
+    }
+    if ($Interactive) {
+        $answer = Read-Host 'Did the desktop window open and reach the chat? [y/N]'
+        Stop-SmokeTree $app.Id
+        if ($answer -match '^(y|yes)$') {
+            Add-SmokeResult 'desktop-launch' 'PASS' 'a person saw the chat'
+        } else {
+            Add-SmokeResult 'desktop-launch' 'FAIL' 'the person did not reach the chat'
+        }
+        return
+    }
+    Stop-SmokeTree $app.Id
+    Add-SmokeResult 'desktop-launch' 'SKIP' "running after ${SmokeDesktopWait}s; chat not confirmed (use -Interactive)"
+}
+
+function Step-Uninstall {
+    $log = Join-Path $script:Logs 'uninstall.log'
+    if ((Invoke-Indus 300 $log @('uninstall', '-y')) -ne 0) {
+        Add-SmokeResult 'uninstall' 'FAIL' (Get-LastLine $log)
+        return
+    }
+    if ((Test-Path $script:Checkout) -or (Test-Path $script:Indus)) {
+        Add-SmokeResult 'uninstall' 'FAIL' 'the code or the launcher is still there'
+        return
+    }
+    $userPath = [string][Environment]::GetEnvironmentVariable('Path', 'User')
+    if ($userPath -like "*$(Join-Path $script:IndusHome 'bin')*") {
+        Add-SmokeResult 'uninstall' 'FAIL' "this user's PATH still names $(Join-Path $script:IndusHome 'bin')"
+        return
+    }
+    if (-not (Test-Path (Join-Path $script:IndusHome 'state.db')) -or -not (Test-Path (Join-Path $script:IndusHome 'config.yaml'))) {
+        Add-SmokeResult 'uninstall' 'FAIL' "the data was not kept in $($script:IndusHome)"
+        return
+    }
+    Add-SmokeResult 'uninstall' 'PASS' 'code, launcher and PATH entry removed, sessions and settings kept'
+}
+
+function Stop-SmokeChildren {
+    if ($null -ne $script:Dashboard) { Stop-SmokeTree $script:Dashboard.Id; $script:Dashboard = $null }
+    if ($null -ne $script:Model) {
+        try { $script:Model.StandardInput.Close() } catch { }
+        if (-not $script:Model.WaitForExit(5000)) { Stop-SmokeTree $script:Model.Id }
+        $script:Model = $null
+    }
+    if (Test-Path $script:Indus) { $null = Invoke-Indus 60 (Join-Path $script:Logs 'gateway-stop.log') @('gateway', 'stop') }
+    if ($script:DesktopInstalled) {
+        $uninstaller = Join-Path $script:AppDir 'Uninstall Indus.exe'
+        if (Test-Path $uninstaller) { $null = Invoke-Bounded 300 (Join-Path $script:Logs 'desktop-uninstall.log') $uninstaller @('/S') }
+        $script:DesktopInstalled = $false
+    }
+}
+
+# -- the run --------------------------------------------------------------------------------------
+
+if ($WorkDir -eq '') {
+    $WorkDir = Join-Path ([System.IO.Path]::GetTempPath()) ('indus-smoke-' + [guid]::NewGuid().ToString('N').Substring(0, 8))
+} elseif ((Test-Path $WorkDir) -and @(Get-ChildItem -Force $WorkDir).Count -gt 0) {
+    # The folder is removed at the end: never one that already holds something.
+    [Console]::Error.WriteLine("-WorkDir must be a new or empty folder: $WorkDir")
+    exit 2
+}
+New-Item -ItemType Directory -Force -Path $WorkDir | Out-Null
+$script:Work = (Resolve-Path $WorkDir).Path
+$script:Logs = Join-Path $script:Work 'logs'
+$script:Project = Join-Path $script:Work 'project'
+$script:IndusHome = Join-Path $script:Work 'indus-home'
+$script:Checkout = Join-Path $script:IndusHome 'indus-agent'
+$script:Indus = Join-Path $script:IndusHome 'bin\indus.cmd'
+$script:Empty = Join-Path $script:Work 'empty.txt'
+New-Item -ItemType Directory -Force -Path $script:Logs, $script:Project | Out-Null
+[System.IO.File]::WriteAllText($script:Empty, '')
+foreach ($name in @(Get-ChildItem Env: | Where-Object { $_.Name -like 'INDUS_*' } | ForEach-Object { $_.Name })) {
+    Remove-Item "Env:$name"
+}
+$env:INDUS_HOME = $script:IndusHome
+$env:INDUS_TERMINAL_ID = 'smoke'
+$env:NO_COLOR = '1'
+
+Show-SmokePlan
+$installed = $true
+try {
+    foreach ($step in $SmokeSteps) {
+        if (-not $installed -and @('desktop-download', 'signature', 'desktop-launch') -notcontains $step) {
+            Add-SmokeResult $step 'SKIP' 'the install failed'
+            continue
+        }
+        switch ($step) {
+            'install' { $installed = [bool](Step-Install) }
+            'version' { Step-Version }
+            'setup' { Step-Setup }
+            'turn' { Step-Turn }
+            'approval' { Step-Approval }
+            'resume' { Step-Resume }
+            'doctor' { Step-Doctor }
+            'dashboard-gate' { Step-DashboardGate }
+            'dashboard-login' { Step-DashboardLogin }
+            'desktop-download' { Step-DesktopDownload }
+            'signature' { Step-Signature }
+            'licences' { Step-Licences }
+            'desktop-launch' { Step-DesktopLaunch }
+            'uninstall' { Step-Uninstall }
+        }
+    }
+} finally {
+    Stop-SmokeChildren
+}
+
+Write-Host ''
+Write-Host "Summary ($SmokeOs, $Tag): $($script:Failed) failed"
+foreach ($line in $script:Results) { Write-Host $line }
+if ($script:Failed -eq 0 -and -not $Keep) {
+    Remove-Item -Recurse -Force $script:Work -ErrorAction SilentlyContinue
+    Write-Host 'Every step passed or was skipped; the work folder was removed.'
+    exit 0
+}
+Write-Host "Logs: $($script:Logs)"
+if ($script:Failed -gt 0) { exit 1 }
+exit 0
