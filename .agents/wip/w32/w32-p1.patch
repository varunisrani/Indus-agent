+import { renderApp, renderPage } from "../testing/render.tsx";
+import { parseEvents, WebhooksPage } from "./WebhooksPage.tsx";
+
+let mock: MockApi;
+let restore: () => void;
+
+function route(name: string, extra: Partial<WebhookRoute> = {}): WebhookRoute {
+  return {
+    name,
+    source: "subscribed",
+    url: `http://127.0.0.1:8644/webhooks/${name}`,
+    auth: "auto",
+    events: [],
+    prompt: "",
+    deliver: null,
+    deliver_only: false,
