+    );
+
+    const config = within(screen.getByTestId("webhook-from-config"));
+    expect(
+      (config.getByRole("switch", { name: "Enable from-config" }) as HTMLButtonElement).disabled,
+    ).toBe(true);
+    expect(config.queryByRole("button", { name: "Delete" })).toBeNull();
