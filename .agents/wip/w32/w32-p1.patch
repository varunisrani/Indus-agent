+import { ChannelsPage, changedValues, DAEMON_POLL_MS, readRestartMark } from "./ChannelsPage.tsx";
+
+let mock: MockApi;
+let restore: () => void;
+
+function telegram(): MessagingPlatform {
+  return {
+    id: "telegram",
+    name: "Telegram",
+    description: "A bot in Telegram chats",
+    installed: true,
+    install_hint: null,
+    enabled: true,
+    explicitly_disabled: false,
+    configured: true,
+    state: "connected",
+    reason: null,
+    daemon_running: true,
+    fields: [
+      {
+        key: "TELEGRAM_BOT_TOKEN",
+        kind: "credential",
+        required: true,
+        is_set: true,
+        is_secret: true,
+        preview: "1234…ab",
+        value: null,
+      },
+      {
+        key: "TELEGRAM_ALLOWED_USERS",
+        kind: "policy",
+        required: false,
+        is_set: true,
+        is_secret: false,
+        preview: null,
+        value: "42",
+      },
+      {
+        key: "TELEGRAM_HOME_CHANNEL",
+        kind: "policy",
+        required: false,
+        is_set: false,
+        is_secret: false,
+        preview: null,
+        value: null,
+      },
