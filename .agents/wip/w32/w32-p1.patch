+    fireEvent.change(form.getByLabelText("Pairing code"), { target: { value: "LOCKED" } });
+    fireEvent.click(form.getByRole("button", { name: "Approve" }));
+    await waitFor(() => expect(form.getByRole("alert").textContent).toContain("Too many"));
