+    expect(mock.callsTo("POST", "/api/pairing/approve").at(-1)?.body).toEqual({
+      platform: "telegram",
+      code: "ABCD-1234",
+    });
+    expect((form.getByLabelText("Pairing code") as HTMLInputElement).value).toBe("");
