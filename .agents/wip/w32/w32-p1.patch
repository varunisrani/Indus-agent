new file mode 100644
index 0000000..4364f59
--- /dev/null
+++ b/apps/web/src/pages/system/CredentialSections.tsx
@@ -0,0 +1,257 @@
+// System page: the external memory provider and the provider credential pool. Pool keys go in
+// once and are never shown again: the list carries masked previews only, and the key input is
+// emptied as soon as the server has it.
+
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { type FormEvent, useId, useState } from "react";
+import { api } from "../../lib/api.ts";
+import type { PoolEntryRow } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { Badge, Button, Card, Field, inputClass, Notice, QueryState } from "../../ui/controls.tsx";
+import { ConfirmDialog } from "../../ui/Dialog.tsx";
+
+export function MemorySection() {
+  const toast = useToast();
+  const client = useQueryClient();
+  const ids = useId();
+  const memory = useQuery({ queryKey: ["system", "memory"], queryFn: () => api.system.memory() });
+  const [choice, setChoice] = useState<string | null>(null);
+  const save = useMutation({
+    mutationFn: (provider: string) => api.system.setMemoryProvider(provider),
+    onSuccess: (reply) => {
+      setChoice(null);
+      toast.show(
+        reply.active ? `Memory provider ${reply.active} selected.` : "Built-in memory only.",
+        "success",
+      );
+      void client.invalidateQueries({ queryKey: ["system", "memory"] });
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+  const data = memory.data;
+  const shown = choice ?? data?.active ?? "";
+  return (
+    <Card className="flex flex-col gap-2">
+      <h2 className="text-sm font-semibold">Memory</h2>
+      <QueryState loading={memory.isPending} error={memory.error}>
+        {data ? (
+          <>
+            <p className="text-xs text-muted">
+              Built-in notes:{" "}
+              {Object.entries(data.builtin_files)
+                .map(([file, size]) => `${file} ${size} B`)
+                .join(", ")}
+              . An external provider adds its own recall on top.
+            </p>
+            <div className="flex flex-wrap items-end gap-2">
+              <Field label="Memory provider" htmlFor={`${ids}-provider`}>
+                <select
+                  id={`${ids}-provider`}
+                  className={inputClass}
+                  value={shown}
+                  onChange={(e) => setChoice(e.currentTarget.value)}
+                >
+                  <option value="">Built-in only</option>
+                  {data.providers.map((name) => (
+                    <option key={name} value={name}>
+                      {name}
+                    </option>
+                  ))}
+                </select>
+              </Field>
+              <Button
+                tone="primary"
+                onClick={() => save.mutate(shown)}
+                disabled={save.isPending || shown === data.active}
+              >
+                Save
+              </Button>
+              <Button
+                onClick={() => save.mutate("")}
+                disabled={save.isPending || data.active === ""}
+              >
+                Reset to built-in
+              </Button>
+            </div>
+          </>
+        ) : null}
+      </QueryState>
+    </Card>
+  );
+}
+
+function AddKey({ providers }: { providers: string[] }) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const ids = useId();
+  const [provider, setProvider] = useState("");
+  const [key, setKey] = useState("");
+  const [label, setLabel] = useState("");
+  const [problem, setProblem] = useState("");
+  const add = useMutation({
+    mutationFn: () =>
+      api.system.addToPool({
+        provider: provider.trim(),
+        api_key: key.trim(),
+        ...(label.trim() ? { label: label.trim() } : {}),
+      }),
+    onSuccess: (reply) => {
+      setKey("");
+      setLabel("");
+      setProblem("");
+      toast.show(`Key added to ${reply.provider} as entry ${reply.index}.`, "success");
+      void client.invalidateQueries({ queryKey: ["system", "pool"] });
+    },
+    onError: (error) => {
+      // A refused key is not kept in the field either.
+      setKey("");
+      setProblem(errorText(error));
+    },
+  });
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    if (!provider.trim() || !key.trim()) {
+      setProblem("Pick the provider and paste the key.");
+      return;
+    }
+    add.mutate();
+  };
+  return (
+    <form className="flex flex-wrap items-end gap-2" onSubmit={submit} noValidate>
+      <Field label="Provider" htmlFor={`${ids}-provider`}>
+        <input
+          id={`${ids}-provider`}
+          className={inputClass}
+          list={`${ids}-providers`}
+          value={provider}
+          onChange={(e) => setProvider(e.currentTarget.value)}
+        />
+      </Field>
+      <datalist id={`${ids}-providers`}>
+        {providers.map((name) => (
+          <option key={name} value={name} />
+        ))}
+      </datalist>
+      <Field label="API key" htmlFor={`${ids}-key`}>
+        <input
+          id={`${ids}-key`}
+          type="password"
+          autoComplete="new-password"
+          className={`${inputClass} font-mono`}
+          value={key}
+          onChange={(e) => setKey(e.currentTarget.value)}
+        />
+      </Field>
+      <Field label="Label (optional)" htmlFor={`${ids}-label`}>
+        <input
+          id={`${ids}-label`}
+          className={inputClass}
+          value={label}
+          onChange={(e) => setLabel(e.currentTarget.value)}
+        />
+      </Field>
+      <Button type="submit" tone="primary" disabled={add.isPending}>
+        Add key
+      </Button>
+      {problem ? (
+        <div className="w-full">
+          <Notice tone="danger">{problem}</Notice>
+        </div>
+      ) : null}
+    </form>
+  );
+}
+
+interface Removal {
+  provider: string;
+  entry: PoolEntryRow;
+}
+
+export function PoolSection() {
+  const toast = useToast();
+  const client = useQueryClient();
+  const [removing, setRemoving] = useState<Removal | null>(null);
+  const pool = useQuery({ queryKey: ["system", "pool"], queryFn: () => api.system.pool() });
+  const options = useQuery({
+    queryKey: ["system", "providers"],
+    queryFn: () => api.model.options(),
+  });
+  const remove = useMutation({
+    mutationFn: (r: Removal) => api.system.removeFromPool(r.provider, r.entry.index),
+    onSuccess: (_reply, r) => {
+      setRemoving(null);
+      toast.show(`${r.entry.label} removed from ${r.provider}.`, "success");
+      void client.invalidateQueries({ queryKey: ["system", "pool"] });
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+  const groups = pool.data?.providers ?? [];
+  return (
+    <Card className="flex flex-col gap-3">
+      <h2 className="text-sm font-semibold">Credential pool</h2>
+      <p className="text-xs text-muted">
+        Several keys per provider are used in turn; a key that hits its limit rests while the next
+        one works.
+      </p>
+      <QueryState
+        loading={pool.isPending}
+        error={pool.error}
+        empty={groups.length === 0}
+        emptyText="No pooled credentials yet."
+      >
+        <ul aria-label="Credential pool" className="flex flex-col gap-3">
+          {groups.map((group) => (
+            <li key={group.provider} className="flex flex-col gap-1">
+              <p className="text-sm font-medium">
+                {group.label}
+                {group.inherited ? (
+                  <span className="text-xs text-muted"> (from the default profile)</span>
+                ) : null}
+              </p>
+              <ul className="flex flex-col gap-1">
+                {group.entries.map((entry) => (
+                  <li
+                    key={entry.id}
+                    data-testid={`pool-${group.provider}-${entry.index}`}
+                    className="flex flex-wrap items-center gap-2 text-sm"
+                  >
+                    <span className="w-6 text-muted">{entry.index}.</span>
+                    <span className="flex-1">{entry.label}</span>
+                    <code className="font-mono text-xs">{entry.preview}</code>
+                    <Badge tone={entry.status === "ok" ? "ok" : "warn"}>{entry.status}</Badge>
+                    <Badge>{entry.source}</Badge>
+                    <Button
+                      tone="danger"
+                      onClick={() => setRemoving({ provider: group.provider, entry })}
+                      disabled={group.inherited}
+                      aria-label={`Remove ${entry.label}`}
+                    >
+                      Remove
+                    </Button>
+                  </li>
+                ))}
+              </ul>
+            </li>
+          ))}
+        </ul>
+      </QueryState>
+      <AddKey providers={(options.data?.providers ?? []).map((p) => p.name)} />
+      <ConfirmDialog
+        open={removing !== null}
+        title={`Remove ${removing?.entry.label ?? ""}?`}
+        description={
+          removing?.entry.source === "env"
+            ? "The key stays in its environment variable; it is only left out of the pool."
+            : "The key is deleted from this profile's secret store."
+        }
+        confirmLabel="Remove"
+        danger
+        busy={remove.isPending}
+        onConfirm={() => {
+          if (removing) remove.mutate(removing);
+        }}
+        onCancel={() => setRemoving(null)}
+      />
+    </Card>
+  );
+}
diff --git a/apps/web/src/pages/system/MachineSections.tsx b/apps/web/src/pages/system/MachineSections.tsx
new file mode 100644
index 0000000..297e410
--- /dev/null
+++ b/apps/web/src/pages/system/MachineSections.tsx
@@ -0,0 +1,207 @@
+// System page: host numbers, the update check, and the daemon's start / stop / restart.
+
+import { useQuery, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { api } from "../../lib/api.ts";
+import { formatBytes } from "../../lib/format.ts";
+import type { HostStats, UpdateInfo } from "../../lib/restTypes.ts";
+import { ActionLog, useActionStarter } from "../../ui/ActionLog.tsx";
+import { Badge, Button, Card, Notice, QueryState } from "../../ui/controls.tsx";
+import { ConfirmDialog } from "../../ui/Dialog.tsx";
+
+function percent(part: number | null, whole: number): string {
+  if (part === null || whole <= 0) return "";
+  return ` (${Math.round((part * 100) / whole)} %)`;
+}
+
+function StatsList({ stats }: { stats: HostStats }) {
+  return (
+    <dl className="grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1 text-sm">
+      <dt className="text-muted">CPUs</dt>
+      <dd>
+        {stats.cpu_count ?? "unknown"}
+        {stats.cpu_percent !== undefined ? ` · ${Math.round(stats.cpu_percent)} % busy` : ""}
+      </dd>
+      <dt className="text-muted">Load</dt>
+      <dd>{stats.load ? stats.load.join(" / ") : "unknown"}</dd>
+      <dt className="text-muted">Memory free</dt>
+      <dd>
+        {stats.memory
+          ? `${formatBytes(stats.memory.available)} of ${formatBytes(stats.memory.total)}${percent(
+              stats.memory.available,
+              stats.memory.total,
+            )}`
+          : "unknown"}
+      </dd>
+      <dt className="text-muted">Disk free</dt>
+      <dd>
+        {stats.disk
+          ? `${formatBytes(stats.disk.free)} of ${formatBytes(stats.disk.total)}${percent(
+              stats.disk.free,
+              stats.disk.total,
+            )}`
+          : "unknown"}
+      </dd>
+    </dl>
+  );
+}
+
+export function HostSection() {
+  const stats = useQuery({ queryKey: ["system", "stats"], queryFn: () => api.system.stats() });
+  return (
+    <Card className="flex flex-col gap-2">
+      <h2 className="text-sm font-semibold">This machine</h2>
+      <QueryState loading={stats.isPending} error={stats.error}>
+        {stats.data ? <StatsList stats={stats.data} /> : null}
+      </QueryState>
+    </Card>
+  );
+}
+
+/** The badge text for an update answer. */
+export function updateBadge(info: UpdateInfo): string {
+  if (info.update_available && info.behind) {
+    return `${info.behind} commit${info.behind === 1 ? "" : "s"} behind`;
+  }
+  if (info.behind === 0) return "Up to date";
+  return info.install_method === "git" ? "Not checked" : info.install_method;
+}
+
+export function UpdateSection() {
+  const client = useQueryClient();
+  const [force, setForce] = useState(0);
+  const [asking, setAsking] = useState(false);
+  const info = useQuery({
+    queryKey: ["system", "update", force],
+    queryFn: () => api.system.update(force > 0),
+  });
+  const apply = useActionStarter(() => api.system.applyUpdate());
+  const data = info.data;
+  return (
+    <Card className="flex flex-col gap-2">
+      <div className="flex flex-wrap items-center gap-2">
+        <h2 className="flex-1 text-sm font-semibold">Updates</h2>
+        {data ? (
+          <Badge tone={data.update_available ? "warn" : "neutral"}>{updateBadge(data)}</Badge>
+        ) : null}
+      </div>
+      <QueryState loading={info.isPending} error={info.error}>
+        {data ? (
+          <>
+            <p className="text-sm">
+              Version {data.current_version} · installed as {data.install_method}
+            </p>
+            {data.message ? <p className="text-xs text-muted">{data.message}</p> : null}
+            <div className="flex gap-2">
+              <Button onClick={() => setForce((n) => n + 1)} disabled={info.isFetching}>
+                Check again
+              </Button>
+              {data.can_apply && data.update_available ? (
+                <Button tone="primary" onClick={() => setAsking(true)} disabled={apply.pending}>
+                  Update
+                </Button>
+              ) : null}
+            </div>
+          </>
+        ) : null}
+      </QueryState>
+      {apply.run > 0 ? (
+        <ActionLog
+          name="update"
+          run={apply.run}
+          title="Update"
+          onFinished={() => void client.invalidateQueries({ queryKey: ["system", "update"] })}
+        />
+      ) : null}
+      <ConfirmDialog
+        open={asking}
+        title="Update Indus Agent?"
+        description="This pulls the new commits into the git checkout (fast-forward only). Restart the dashboard and the daemon afterwards to run the new version."
+        confirmLabel="Update"
+        onConfirm={() => {
+          setAsking(false);
+          apply.start();
+        }}
+        onCancel={() => setAsking(false)}
+      />
+    </Card>
+  );
+}
+
+type DaemonVerb = "start" | "stop" | "restart";
+
+export function DaemonSection() {
+  const client = useQueryClient();
+  const [verb, setVerb] = useState<DaemonVerb>("start");
+  const [stopping, setStopping] = useState(false);
+  const daemon = useQuery({ queryKey: ["system", "daemon"], queryFn: () => api.daemon.get() });
+  const action = useActionStarter((next: DaemonVerb) => api.daemon[next]());
+  const run = (next: DaemonVerb) => {
+    setVerb(next);
+    action.start(next);
+  };
+  const data = daemon.data;
+  return (
+    <Card className="flex flex-col gap-2">
+      <div className="flex flex-wrap items-center gap-2">
+        <h2 className="flex-1 text-sm font-semibold">Daemon</h2>
+        {data ? (
+          <Badge tone={data.running ? "ok" : "neutral"}>
+            {data.running ? data.state : "stopped"}
+          </Badge>
+        ) : null}
+      </div>
+      <QueryState loading={daemon.isPending} error={daemon.error}>
+        {data?.running ? (
+          <p className="text-xs text-muted">
+            Process {data.pid}
+            {data.code_version ? ` · code ${data.code_version}` : ""}
+            {data.draining ? " · draining (finishing current turns)" : ""}
+          </p>
+        ) : (
+          <p className="text-xs text-muted">
+            The daemon runs channels, cron and shared sessions for this profile.
+          </p>
+        )}
+      </QueryState>
+      <div className="flex gap-2">
+        <Button onClick={() => run("start")} disabled={action.pending || data?.running === true}>
+          Start
+        </Button>
+        <Button
+          tone="danger"
+          onClick={() => setStopping(true)}
+          disabled={action.pending || data?.running === false}
+        >
+          Stop
+        </Button>
+        <Button onClick={() => run("restart")} disabled={action.pending}>
+          Restart
+        </Button>
+      </div>
+      {action.run > 0 ? (
+        <ActionLog
+          name={`daemon-${verb}`}
+          run={action.run}
+          title={`Daemon ${verb}`}
+          onFinished={() => void client.invalidateQueries({ queryKey: ["system", "daemon"] })}
+        />
+      ) : null}
+      <ConfirmDialog
+        open={stopping}
+        title="Stop the daemon?"
+        description="Channels disconnect and cron jobs pause until it starts again. Turns already running finish first."
+        confirmLabel="Stop"
+        danger
+        onConfirm={() => {
+          setStopping(false);
+          run("stop");
+        }}
+        onCancel={() => setStopping(false)}
+      />
+      {data && !data.running && data.state !== "stopped" ? (
+        <Notice tone="warn">The daemon reports {data.state}.</Notice>
+      ) : null}
+    </Card>
+  );
+}
diff --git a/apps/web/src/pages/system/OperationSections.tsx b/apps/web/src/pages/system/OperationSections.tsx
new file mode 100644
index 0000000..043fa5b
--- /dev/null
+++ b/apps/web/src/pages/system/OperationSections.tsx
@@ -0,0 +1,376 @@
+// System page: maintenance operations (doctor, backup, import, checkpoints) and shell hooks. Every
+// long operation is a background action on the server; its output is tailed below its buttons.
+
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { type FormEvent, useId, useState } from "react";
+import { api } from "../../lib/api.ts";
+import { formatBytes, relativeTime } from "../../lib/format.ts";
+import type { ActionStarted, ShellHook, ShellHookCreate } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { ActionLog, useActionStarter } from "../../ui/ActionLog.tsx";
+import { Badge, Button, Card, Field, inputClass, Notice, QueryState } from "../../ui/controls.tsx";
+import { ConfirmDialog } from "../../ui/Dialog.tsx";
+
+type Operation = "doctor" | "backup" | "import";
+
+interface ImportArgs {
+  archive: string;
+  file: File | null;
+  force: boolean;
+}
+
+export function OperationsSection() {
+  const toast = useToast();
+  const ids = useId();
+  const [current, setCurrent] = useState<Operation>("doctor");
+  const [backupReady, setBackupReady] = useState<string | null>(null);
+  const [archive, setArchive] = useState("");
+  const [file, setFile] = useState<File | null>(null);
+  const [force, setForce] = useState(false);
+  const [problem, setProblem] = useState("");
+
+  const action = useActionStarter(
+    (args: { op: Operation; input?: ImportArgs }): Promise<ActionStarted> => {
+      if (args.op === "doctor") return api.system.doctor();
+      if (args.op === "backup") return api.system.backup();
+      const input = args.input as ImportArgs;
+      return input.file
+        ? api.system.importUpload(input.file, input.force)
+        : api.system.importArchive(input.archive, input.force);
+    },
+  );
+  const start = (op: Operation, input?: ImportArgs) => {
+    setCurrent(op);
+    setBackupReady(null);
+    action.start(input ? { op, input } : { op });
+  };
+
+  const submitImport = (event: FormEvent) => {
+    event.preventDefault();
+    if (!file && !archive.trim().startsWith("/")) {
+      setProblem("Choose a zip file, or give an archive's full path on this machine.");
+      return;
+    }
+    setProblem("");
+    start("import", { archive: archive.trim(), file, force });
+  };
+
+  const download = useMutation({
+    mutationFn: (path: string) => api.system.downloadBackup(path),
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+
+  return (
+    <Card className="flex flex-col gap-3">
+      <h2 className="text-sm font-semibold">Operations</h2>
+      <div className="flex flex-wrap gap-2">
+        <Button onClick={() => start("doctor")} disabled={action.pending}>
+          Run doctor
+        </Button>
+        <Button onClick={() => start("backup")} disabled={action.pending}>
+          Back up this profile
+        </Button>
+      </div>
+      <form className="flex flex-wrap items-end gap-2" onSubmit={submitImport} noValidate>
+        <Field label="Import archive path" htmlFor={`${ids}-archive`}>
+          <input
+            id={`${ids}-archive`}
+            className={`${inputClass} font-mono`}
+            value={archive}
+            onChange={(e) => setArchive(e.currentTarget.value)}
+          />
+        </Field>
+        <Field label="…or upload a zip" htmlFor={`${ids}-file`}>
+          <input
+            id={`${ids}-file`}
+            type="file"
+            accept=".zip,application/zip"
+            className="text-sm"
+            onChange={(e) => setFile(e.currentTarget.files?.[0] ?? null)}
+          />
+        </Field>
+        <label className="flex items-center gap-2 text-sm">
+          <input
+            type="checkbox"
+            checked={force}
+            onChange={(e) => setForce(e.currentTarget.checked)}
+          />
+          Overwrite existing files
+        </label>
+        <Button type="submit" disabled={action.pending}>
+          Import
+        </Button>
+      </form>
+      {problem ? <Notice tone="danger">{problem}</Notice> : null}
+      {action.run > 0 ? (
+        <ActionLog
+          name={current}
+          run={action.run}
+          title={current === "doctor" ? "Doctor" : current === "backup" ? "Backup" : "Import"}
+          onFinished={(status) => {
+            if (current === "backup" && status.state === "done" && action.started?.archive) {
+              setBackupReady(action.started.archive);
+            }
+          }}
+        />
+      ) : null}
+      {backupReady ? (
+        <div className="flex flex-wrap items-center gap-2 text-sm">
+          <span className="flex-1">
+            Backup written: <code className="font-mono text-xs">{backupReady}</code>
+          </span>
+          <Button onClick={() => download.mutate(backupReady)} disabled={download.isPending}>
+            Download
+          </Button>
+        </div>
+      ) : null}
+    </Card>
+  );
+}
+
+export function CheckpointsSection() {
+  const client = useQueryClient();
+  const ids = useId();
+  const [days, setDays] = useState("7");
+  const [size, setSize] = useState("500");
+  const checkpoints = useQuery({
+    queryKey: ["system", "checkpoints"],
+    queryFn: () => api.system.checkpoints(),
+  });
+  const prune = useActionStarter((rules: { days: number; size: number }) =>
+    api.system.pruneCheckpoints(rules.days, rules.size),
+  );
+  const daysValue = Number(days);
+  const sizeValue = Number(size);
+  const valid =
+    Number.isInteger(daysValue) && daysValue >= 0 && Number.isInteger(sizeValue) && sizeValue >= 0;
+  const projects = checkpoints.data?.projects ?? [];
+  return (
+    <Card className="flex flex-col gap-3">
+      <div className="flex flex-wrap items-center gap-2">
+        <h2 className="flex-1 text-sm font-semibold">Checkpoints</h2>
+        {checkpoints.data ? (
+          <Badge>{formatBytes(checkpoints.data.total_bytes) || "0 B"}</Badge>
+        ) : null}
+      </div>
+      <QueryState
+        loading={checkpoints.isPending}
+        error={checkpoints.error}
+        empty={projects.length === 0}
+        emptyText="No file checkpoints kept."
+      >
+        <ul aria-label="Checkpoint projects" className="flex flex-col gap-1 text-sm">
+          {projects.map((p) => (
+            <li key={p.key} className="flex flex-wrap gap-2">
+              <code className="flex-1 font-mono text-xs break-all">{p.workdir}</code>
+              <span className="text-xs text-muted">
+                {p.commits} snapshot{p.commits === 1 ? "" : "s"} · {formatBytes(p.bytes)} ·{" "}
+                {relativeTime(p.last_touch)}
+                {p.exists ? "" : " · folder gone"}
+              </span>
+            </li>
+          ))}
+        </ul>
+      </QueryState>
+      <div className="flex flex-wrap items-end gap-2">
+        <Field label="Keep days" htmlFor={`${ids}-days`}>
+          <input
+            id={`${ids}-days`}
+            className={inputClass}
+            inputMode="numeric"
+            value={days}
+            onChange={(e) => setDays(e.currentTarget.value)}
+          />
+        </Field>
+        <Field label="Size cap (MB)" htmlFor={`${ids}-size`}>
+          <input
+            id={`${ids}-size`}
+            className={inputClass}
+            inputMode="numeric"
+            value={size}
+            onChange={(e) => setSize(e.currentTarget.value)}
+          />
+        </Field>
+        <Button
+          onClick={() => prune.start({ days: daysValue, size: sizeValue })}
+          disabled={!valid || prune.pending}
+        >
+          Prune checkpoints
+        </Button>
+      </div>
+      {prune.run > 0 ? (
+        <ActionLog
+          name="checkpoints-prune"
+          run={prune.run}
+          title="Checkpoint prune"
+          onFinished={() => void client.invalidateQueries({ queryKey: ["system", "checkpoints"] })}
+        />
+      ) : null}
+    </Card>
+  );
+}
+
+function AddHook({ events }: { events: string[] }) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const ids = useId();
+  const [event, setEvent] = useState(events[0] ?? "");
+  const [command, setCommand] = useState("");
+  const [matcher, setMatcher] = useState("");
+  const [timeout, setTimeoutValue] = useState("");
+  const [consent, setConsent] = useState(false);
+  const [problem, setProblem] = useState("");
+  const add = useMutation({
+    mutationFn: (body: ShellHookCreate) => api.system.addHook(body),
+    onSuccess: () => {
+      setCommand("");
+      setMatcher("");
+      setTimeoutValue("");
+      setConsent(false);
+      setProblem("");
+      toast.show("Hook added and approved.", "success");
+      void client.invalidateQueries({ queryKey: ["system", "hooks"] });
+    },
+    onError: (error) => setProblem(errorText(error)),
+  });
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    if (!consent) return;
+    if (!command.trim()) {
+      setProblem("Name the command to run.");
+      return;
+    }
+    const body: ShellHookCreate = { event, command: command.trim(), consent: true };
+    if (matcher.trim()) body.matcher = matcher.trim();
+    const seconds = Number(timeout);
+    if (timeout.trim() && Number.isFinite(seconds) && seconds > 0) body.timeout = seconds;
+    add.mutate(body);
+  };
+  return (
+    <form className="flex flex-col gap-2" onSubmit={submit} noValidate>
+      <div className="flex flex-wrap items-end gap-2">
+        <Field label="Event" htmlFor={`${ids}-event`}>
+          <select
+            id={`${ids}-event`}
+            className={inputClass}
+            value={event}
+            onChange={(e) => setEvent(e.currentTarget.value)}
+          >
+            {events.map((name) => (
+              <option key={name} value={name}>
+                {name}
+              </option>
+            ))}
+          </select>
+        </Field>
+        <Field label="Command" htmlFor={`${ids}-command`}>
+          <input
+            id={`${ids}-command`}
+            className={`${inputClass} font-mono`}
+            value={command}
+            onChange={(e) => setCommand(e.currentTarget.value)}
+          />
+        </Field>
+        <Field label="Tool matcher (optional)" htmlFor={`${ids}-matcher`}>
+          <input
+            id={`${ids}-matcher`}
+            className={inputClass}
+            value={matcher}
+            onChange={(e) => setMatcher(e.currentTarget.value)}
+          />
+        </Field>
+        <Field label="Timeout s (optional)" htmlFor={`${ids}-timeout`}>
+          <input
+            id={`${ids}-timeout`}
+            className={inputClass}
+            inputMode="decimal"
+            value={timeout}
+            onChange={(e) => setTimeoutValue(e.currentTarget.value)}
+          />
+        </Field>
+      </div>
+      <Notice tone="warn">
+        A shell hook runs this command on your machine, as you, every time the event happens, with
+        the event's details as input. Only add commands you wrote or trust.
+      </Notice>
+      <label className="flex items-center gap-2 text-sm">
+        <input
+          type="checkbox"
+          checked={consent}
+          onChange={(e) => setConsent(e.currentTarget.checked)}
+        />
+        I understand and want this command to run on agent events
+      </label>
+      {problem ? <Notice tone="danger">{problem}</Notice> : null}
+      <div>
+        <Button type="submit" tone="primary" disabled={!consent || add.isPending}>
+          Add hook
+        </Button>
+      </div>
+    </form>
+  );
+}
+
+export function HooksSection() {
+  const toast = useToast();
+  const client = useQueryClient();
+  const [removing, setRemoving] = useState<ShellHook | null>(null);
+  const hooks = useQuery({ queryKey: ["system", "hooks"], queryFn: () => api.system.hooks() });
+  const remove = useMutation({
+    mutationFn: (hook: ShellHook) => api.system.removeHook(hook.event, hook.command),
+    onSuccess: () => {
+      setRemoving(null);
+      toast.show("Hook removed.", "success");
+      void client.invalidateQueries({ queryKey: ["system", "hooks"] });
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+  const list = hooks.data?.hooks ?? [];
+  return (
+    <Card className="flex flex-col gap-3">
+      <h2 className="text-sm font-semibold">Shell hooks</h2>
+      <QueryState loading={hooks.isPending} error={hooks.error}>
+        {hooks.data?.warnings.length ? (
+          <Notice tone="warn">{hooks.data.warnings.join(" ")}</Notice>
+        ) : null}
+        {list.length === 0 ? (
+          <p className="text-sm text-muted">No shell hooks.</p>
+        ) : (
+          <ul aria-label="Shell hooks" className="flex flex-col gap-1">
+            {list.map((hook) => (
+              <li
+                key={`${hook.event}-${hook.command}`}
+                data-testid={`hook-${hook.grant_id}`}
+                className="flex flex-wrap items-center gap-2 text-sm"
+              >
+                <Badge>{hook.event}</Badge>
+                <code className="flex-1 font-mono text-xs break-all">{hook.command}</code>
+                {hook.matcher ? <span className="text-xs text-muted">{hook.matcher}</span> : null}
+                <Badge tone={hook.approved ? "ok" : "warn"}>
+                  {hook.approved ? "approved" : "not approved"}
+                </Badge>
+                {hook.executable ? null : <Badge tone="warn">not executable</Badge>}
+                <Button tone="danger" onClick={() => setRemoving(hook)}>
+                  Remove
+                </Button>
+              </li>
+            ))}
+          </ul>
+        )}
+        <AddHook events={hooks.data?.events ?? []} />
+      </QueryState>
+      <ConfirmDialog
+        open={removing !== null}
+        title="Remove this hook?"
+        description="The command no longer runs on agent events, and its approval is dropped."
+        confirmLabel="Remove"
+        danger
+        busy={remove.isPending}
+        onConfirm={() => {
+          if (removing) remove.mutate(removing);
+        }}
+        onCancel={() => setRemoving(null)}
+      />
+    </Card>
+  );
+}
diff --git a/apps/web/src/shell/PressureBanner.test.tsx b/apps/web/src/shell/PressureBanner.test.tsx
