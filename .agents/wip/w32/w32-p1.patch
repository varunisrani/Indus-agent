+
+  it("revokes an approved user after confirming", async () => {
+    renderPage(<PairingPage />, "/pairing");
+    const row = within(await screen.findByTestId("approved-telegram-303"));
+    fireEvent.click(row.getByRole("button", { name: "Revoke" }));
