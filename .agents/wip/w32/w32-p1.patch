+  mock.state.pairing = {
+    pending: [
+      {
+        platform: "telegram",
+        request_id: "r1",
+        user_id: "101",
+        user_name: "Asha",
+        age_seconds: 120,
+      },
+      { platform: "signal", request_id: "r2", user_id: "202", user_name: null, age_seconds: 5 },
