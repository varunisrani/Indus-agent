index 0000000..dc43d38
--- /dev/null
+++ b/apps/web/src/shell/PressureBanner.test.tsx
@@ -0,0 +1,175 @@
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Pressure, StatusResponse } from "../lib/restTypes.ts";
+import { createMockApi, type MockApi } from "../testing/mockApi.ts";
+import { renderApp } from "../testing/render.tsx";
+import {
+  DISMISSED_KEY,
+  forgetRecovered,
+  PressureBannerView,
+  pickBanner,
+  type Trigger,
+} from "./PressureBanner.tsx";
+import { STATUS_REFRESH_MS } from "./shellStatus.ts";
+
+function status(memory: Pressure, disk: Pressure): StatusResponse {
+  return {
+    version: "0.1.0",
+    daemon: { state: "running" },
+    overall: "ok",
+    memory: { pressure: memory, available_percent: 7 },
+    disk: { pressure: disk, used_percent: 90, free_gb: 1 },
+  };
+}
+
+function shown(): string | null {
+  return screen.queryByTestId("pressure-banner")?.getAttribute("data-trigger") ?? null;
+}
+
+describe("banner choice", () => {
+  it("picks one banner by priority", () => {
+    const table: Array<[Pressure, Pressure, boolean, Trigger | null]> = [
+      ["ok", "ok", false, null],
+      ["unknown", "unknown", false, null],
+      ["unknown", "unknown", true, "oom-restart"],
+      ["elevated", "ok", false, "memory-elevated"],
+      ["ok", "elevated", false, "disk-elevated"],
+      ["elevated", "elevated", false, "disk-elevated"],
+      ["elevated", "elevated", true, "oom-restart"],
+      ["critical", "elevated", true, "memory-critical"],
+      ["critical", "critical", true, "disk-critical"],
+      ["ok", "critical", false, "disk-critical"],
+    ];
+    for (const [memory, disk, oomSuspected, expected] of table) {
+      expect(pickBanner({ memory, disk, oomSuspected }, "pid-1", [])).toBe(expected);
+    }
+  });
+
+  it("skips a dismissed notice of this boot only, and shows the next one", () => {
+    const input = {
+      memory: "critical" as Pressure,
+      disk: "elevated" as Pressure,
+      oomSuspected: false,
+    };
+    expect(pickBanner(input, "pid-1", ["memory-critical:pid-1"])).toBe("disk-elevated");
+    expect(pickBanner(input, "pid-2", ["memory-critical:pid-1"])).toBe("memory-critical");
+  });
+
+  it("forgets a domain's dismissals once it is ok, not when unknown", () => {
+    const keys = ["memory-elevated:pid-1", "disk-elevated:pid-1", "oom-restart:pid-1"];
+    expect(forgetRecovered(keys, { memory: "ok", disk: "unknown" })).toEqual([
+      "disk-elevated:pid-1",
+      "oom-restart:pid-1",
+    ]);
+    expect(forgetRecovered(keys, { memory: "unknown", disk: "unknown" })).toEqual(keys);
+  });
+});
+
+describe("banner view", () => {
+  it("shows nothing for unknown readings", () => {
+    render(
+      <PressureBannerView
+        status={status("unknown", "unknown")}
+        boot="pid-1"
+        oomSuspected={false}
+      />,
+    );
+    expect(shown()).toBeNull();
+  });
+
+  it("reopens a dismissed elevated banner when it turns critical", () => {
+    const view = render(
+      <PressureBannerView status={status("elevated", "ok")} boot="pid-1" oomSuspected={false} />,
+    );
+    expect(shown()).toBe("memory-elevated");
+    expect(screen.getByRole("status").textContent).toContain("Memory is getting low (7 % free)");
+    fireEvent.click(screen.getByRole("button", { name: "Dismiss" }));
+    expect(shown()).toBeNull();
+    expect(JSON.parse(window.sessionStorage.getItem(DISMISSED_KEY) ?? "[]")).toEqual([
+      "memory-elevated:pid-1",
+    ]);
+    view.rerender(
+      <PressureBannerView status={status("critical", "ok")} boot="pid-1" oomSuspected={false} />,
+    );
+    expect(shown()).toBe("memory-critical");
+    expect(screen.getByRole("alert").textContent).toContain("almost exhausted");
+  });
+
+  it("shows a dismissed banner again after the daemon restarts", () => {
+    const view = render(
+      <PressureBannerView status={status("ok", "critical")} boot="pid-1" oomSuspected={false} />,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Dismiss" }));
+    expect(shown()).toBeNull();
+    // Still dismissed after a remount in the same boot (kept in storage).
+    view.unmount();
+    const again = render(
+      <PressureBannerView status={status("ok", "critical")} boot="pid-1" oomSuspected={false} />,
+    );
+    expect(shown()).toBeNull();
+    again.rerender(
+      <PressureBannerView status={status("ok", "critical")} boot="pid-2" oomSuspected={false} />,
+    );
+    expect(shown()).toBe("disk-critical");
+    expect(screen.getByRole("alert").textContent).toContain("1 GB free");
+  });
+
+  it("shows the next episode after a recovery", () => {
+    const view = render(
+      <PressureBannerView status={status("ok", "elevated")} boot="pid-1" oomSuspected={false} />,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Dismiss" }));
+    view.rerender(
+      <PressureBannerView status={status("ok", "ok")} boot="pid-1" oomSuspected={false} />,
+    );
+    view.rerender(
+      <PressureBannerView status={status("ok", "elevated")} boot="pid-1" oomSuspected={false} />,
+    );
+    expect(shown()).toBe("disk-elevated");
+  });
+});
+
+describe("banner in the shell", () => {
+  let mock: MockApi;
+  let restore: () => void;
+
+  beforeEach(() => {
+    mock = createMockApi();
+    restore = mock.install();
+    vi.spyOn(console, "warn").mockImplementation(() => {});
+  });
+
+  afterEach(() => {
+    restore();
+    vi.useRealTimers();
+  });
+
+  it("suspects an out-of-memory restart when the daemon changes under critical memory", async () => {
+    vi.useFakeTimers({ toFake: ["setInterval", "clearInterval"] });
+    mock.state.status = status("critical", "ok");
+    renderApp("/sessions");
+    await waitFor(() => expect(shown()).toBe("memory-critical"));
+    await waitFor(() => expect(mock.callsTo("GET", "/api/daemon").length).toBeGreaterThan(0));
+
+    // The daemon comes back as a new process and memory has recovered.
+    mock.state.status = status("ok", "ok");
+    mock.state.daemon = { ...mock.state.daemon, pid: 9001 };
+    act(() => {
+      vi.advanceTimersByTime(STATUS_REFRESH_MS);
+    });
+    await waitFor(() => expect(shown()).toBe("oom-restart"));
+    expect(screen.getByRole("alert").textContent).toContain("may have stopped it");
+  });
+
+  it("does not suspect anything for a restart under normal memory", async () => {
+    vi.useFakeTimers({ toFake: ["setInterval", "clearInterval"] });
+    renderApp("/sessions");
+    await waitFor(() => expect(mock.callsTo("GET", "/api/daemon").length).toBeGreaterThan(0));
+    mock.state.daemon = { ...mock.state.daemon, pid: 9001 };
+    act(() => {
+      vi.advanceTimersByTime(STATUS_REFRESH_MS);
+    });
+    await waitFor(() => expect(mock.callsTo("GET", "/api/daemon").length).toBeGreaterThan(1));
+    expect(shown()).toBeNull();
+  });
+});
diff --git a/apps/web/src/shell/PressureBanner.tsx b/apps/web/src/shell/PressureBanner.tsx
new file mode 100644
index 0000000..5503870
--- /dev/null
+++ b/apps/web/src/shell/PressureBanner.tsx
@@ -0,0 +1,165 @@
+// The resource banner (P18-25): at most one notice about the machine, the most urgent first —
+// disk critical, memory critical, a suspected out-of-memory restart, disk elevated, memory
+// elevated. `ok` and `unknown` show nothing. A dismissal (kept for this tab's session) holds for
+// that notice during one daemon boot only; a worse notice (elevated → critical) is a different one
+// and shows; a domain that is back to `ok` forgets its dismissals so its next episode shows again.
+
+import { useEffect, useState } from "react";
+import type { Pressure, StatusResponse } from "../lib/restTypes.ts";
+import { useBootWatch, useShellDaemon, useShellStatus } from "./shellStatus.ts";
+
+export type Trigger =
+  | "disk-critical"
+  | "memory-critical"
+  | "oom-restart"
+  | "disk-elevated"
+  | "memory-elevated";
+
+/** Most urgent first. */
+export const PRIORITY: readonly Trigger[] = [
+  "disk-critical",
+  "memory-critical",
+  "oom-restart",
+  "disk-elevated",
+  "memory-elevated",
+];
+
+export const DISMISSED_KEY = "indus.pressure.dismissed";
+
+export interface PressureInput {
+  memory: Pressure | undefined;
+  disk: Pressure | undefined;
+  oomSuspected: boolean;
+}
+
+/** Every notice the readings call for, most urgent first. */
+export function activeTriggers({ memory, disk, oomSuspected }: PressureInput): Trigger[] {
+  const on = new Set<Trigger>();
+  if (disk === "critical") on.add("disk-critical");
+  if (disk === "elevated") on.add("disk-elevated");
+  if (memory === "critical") on.add("memory-critical");
+  if (memory === "elevated") on.add("memory-elevated");
+  if (oomSuspected) on.add("oom-restart");
+  return PRIORITY.filter((t) => on.has(t));
+}
+
+export function dismissalKey(trigger: Trigger, boot: string | null): string {
+  return `${trigger}:${boot ?? "unknown"}`;
+}
+
+/** The one notice to show, or null. */
+export function pickBanner(
+  input: PressureInput,
+  boot: string | null,
+  dismissed: readonly string[],
+): Trigger | null {
+  return (
+    activeTriggers(input).find((trigger) => !dismissed.includes(dismissalKey(trigger, boot))) ??
+    null
+  );
+}
+
+/** Drop the dismissals of a domain that is back to `ok` (an `unknown` reading proves nothing). */
+export function forgetRecovered(
+  dismissed: readonly string[],
+  input: Pick<PressureInput, "memory" | "disk">,
+): string[] {
+  return dismissed.filter((key) => {
+    if (input.memory === "ok" && key.startsWith("memory-")) return false;
+    if (input.disk === "ok" && key.startsWith("disk-")) return false;
+    return true;
+  });
+}
+
+function readDismissed(): string[] {
+  try {
+    const raw = window.sessionStorage.getItem(DISMISSED_KEY);
+    const parsed: unknown = raw ? JSON.parse(raw) : [];
+    return Array.isArray(parsed) ? parsed.filter((v): v is string => typeof v === "string") : [];
+  } catch {
+    return [];
+  }
+}
+
+function writeDismissed(keys: readonly string[]): void {
+  try {
+    window.sessionStorage.setItem(DISMISSED_KEY, JSON.stringify(keys.slice(-50)));
+  } catch {
+    // storage unavailable: dismissals last for this page view
+  }
+}
+
+export function bannerText(trigger: Trigger, status: StatusResponse | undefined): string {
+  const freeGb = status?.disk?.free_gb;
+  const used = status?.disk?.used_percent;
+  const available = status?.memory?.available_percent;
+  switch (trigger) {
+    case "disk-critical":
+      return `The disk is almost full${freeGb !== undefined ? ` (${freeGb} GB free)` : ""}. Sessions and logs may fail to save; free some space now.`;
+    case "memory-critical":
+      return `Memory is almost exhausted${available !== undefined ? ` (${available} % free)` : ""}. The system may stop the daemon to recover memory.`;
+    case "oom-restart":
+      return "The daemon restarted while memory was almost exhausted; the system may have stopped it for lack of memory.";
+    case "disk-elevated":
+      return `Disk space is getting low${used !== undefined ? ` (${used} % used)` : ""}.`;
+    case "memory-elevated":
+      return `Memory is getting low${available !== undefined ? ` (${available} % free)` : ""}.`;
+  }
+}
+
+export interface PressureBannerViewProps {
+  status: StatusResponse | undefined;
+  boot: string | null;
+  oomSuspected: boolean;
+}
+
+/** The banner for given readings (the shell wires the live ones in `PressureBanner`). */
+export function PressureBannerView({ status, boot, oomSuspected }: PressureBannerViewProps) {
+  const [dismissed, setDismissed] = useState<string[]>(readDismissed);
+  const memory = status?.memory?.pressure;
+  const disk = status?.disk?.pressure;
+
+  useEffect(() => {
+    setDismissed((was) => {
+      const next = forgetRecovered(was, { memory, disk });
+      if (next.length === was.length) return was;
+      writeDismissed(next);
+      return next;
+    });
+  }, [memory, disk]);
+
+  const input = { memory, disk, oomSuspected };
+  const trigger = pickBanner(input, boot, dismissed);
+  if (!trigger) return null;
+  const critical = trigger.endsWith("critical") || trigger === "oom-restart";
+  const dismiss = () => {
+    setDismissed((was) => {
+      const key = dismissalKey(trigger, boot);
+      const next = was.includes(key) ? was : [...was, key];
+      writeDismissed(next);
+      return next;
+    });
+  };
+  return (
+    <div
+      role={critical ? "alert" : "status"}
+      data-testid="pressure-banner"
+      data-trigger={trigger}
+      className={`flex items-start gap-3 border-b bg-raised px-4 py-2 text-sm ${
+        critical ? "border-danger text-danger" : "border-warn text-warn"
+      }`}
+    >
+      <span className="flex-1">{bannerText(trigger, status)}</span>
+      <button type="button" className="text-muted" aria-label="Dismiss" onClick={dismiss}>
+        ×
+      </button>
+    </div>
+  );
+}
+
+export function PressureBanner() {
+  const status = useShellStatus();
+  const daemon = useShellDaemon();
+  const { boot, oomSuspected } = useBootWatch(daemon.data, status.data?.memory?.pressure);
+  return <PressureBannerView status={status.data} boot={boot} oomSuspected={oomSuspected} />;
+}
