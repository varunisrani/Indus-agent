+  }, [profile, liveCwd]);
+
+  const pick = (path: string) => {
+    chooseWorkspace(profile, path);
+    setSelected(path);
+    setOptions(workspaceOptions(profile, liveCwd));
+  };
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    const path = draft.trim();
+    if (!isAbsolutePath(path)) {
+      setError("Enter a full path, starting at the root of the disk.");
+      return;
+    }
+    setError(null);
+    setTyping(false);
+    setDraft("");
+    pick(path);
+  };
+
+  return (
+    <section className="flex flex-col gap-1">
+      <label htmlFor={id} className="text-xs font-semibold uppercase text-muted">
+        Workspace for new chats
+      </label>
+      <select
+        id={id}
+        className={inputClass}
+        value={typing ? OTHER : selected}
+        onChange={(event) => {
+          const value = event.target.value;
+          if (value === OTHER) {
+            setTyping(true);
+            return;
+          }
+          setTyping(false);
+          pick(value);
+        }}
+      >
+        <option value="">Default folder</option>
+        {options.map((path) => (
+          <option key={path} value={path}>
+            {path}
+          </option>
+        ))}
+        <option value={OTHER}>Other path…</option>
+      </select>
+      {typing ? (
+        <form className="flex gap-1" onSubmit={submit}>
+          <input
+            aria-label="Workspace path"
+            className={`${inputClass} min-w-0 flex-1`}
+            placeholder="/path/to/project"
+            value={draft}
+            onChange={(event) => setDraft(event.target.value)}
+          />
+          <Button type="submit" className="px-2 py-1 text-xs">
+            Use
+          </Button>
+        </form>
+      ) : null}
+      {error ? <p className="text-xs text-danger">{error}</p> : null}
+      <p className="text-xs text-muted">Used when you start a new chat.</p>
+    </section>
+  );
+}
+
+function ReasoningPicker({
+  current,
+  onPick,
+}: {
+  current: string | null | undefined;
+  onPick(value: string): void;
+}) {
+  const id = useId();
+  const [chosen, setChosen] = useState(current ?? "");
+  useEffect(() => setChosen(current ?? ""), [current]);
+  return (
+    <section className="flex flex-col gap-1">
+      <label htmlFor={id} className="text-xs font-semibold uppercase text-muted">
+        Reasoning effort
+      </label>
+      <select
+        id={id}
+        className={inputClass}
+        value={chosen}
+        onChange={(event) => {
+          const value = event.target.value;
+          if (!value) return;
+          setChosen(value);
+          onPick(value);
+        }}
+      >
+        <option value="">{current ? "Current" : "Session default"}</option>
+        {EFFORTS.map((effort) => (
+          <option key={effort.value} value={effort.value}>
+            {effort.label}
+          </option>
+        ))}
+      </select>
+    </section>
+  );
+}
+
+export function ChatRail({
+  channel,
+  profile,
+  connected,
+  resumeId,
+  onResume,
+  onNewChat,
+  typeIntoChat,
+  feedDeps,
+}: ChatRailProps) {
+  const feed = useEventsFeed(channel, feedDeps ?? browserFeedDeps);
+  const [message, setMessage] = useState<{ tone: "neutral" | "warn"; text: string } | null>(null);
+  const [dragging, setDragging] = useState(false);
+
+  const say = (text: string, tone: "neutral" | "warn" = "neutral") => setMessage({ text, tone });
+
+  const copyLast = async () => {
+    if (!feed.lastAnswer) return;
+    try {
+      await navigator.clipboard.writeText(feed.lastAnswer);
+      say("Last answer copied.");
+    } catch {
+      say("The browser did not allow copying.", "warn");
+    }
+  };
+
+  const upload = async (file: File | null) => {
+    if (!file) {
+      say("Drop or paste an image file.", "warn");
+      return;
+    }
+    say(`Uploading ${file.name}…`);
+    try {
+      await attachImage(file, typeIntoChat);
+      say(`${file.name} goes with your next message.`);
+    } catch (error) {
+      say(error instanceof Error ? error.message : "The image could not be attached.", "warn");
+    }
+  };
+
+  const current = feed.live?.sessionId ?? resumeId;
+
+  return (
+    <section
+      aria-label="Chat tools"
+      data-testid="chat-rail"
+      className={`flex h-full min-h-0 flex-col gap-4 overflow-auto p-3 text-sm ${
+        dragging ? "outline outline-2 outline-accent" : ""
+      }`}
+      onDragOver={(event) => {
+        if (Array.from(event.dataTransfer.types).includes("Files")) {
+          event.preventDefault();
+          setDragging(true);
+        }
+      }}
+      onDragLeave={() => setDragging(false)}
+      onDrop={(event) => {
+        event.preventDefault();
+        setDragging(false);
+        void upload(firstImage(event.dataTransfer.files));
+      }}
+    >
+      <section aria-label="Model" className="flex flex-col gap-1">
+        <h2 className="text-xs font-semibold uppercase text-muted">Model</h2>
+        <ModelBadge live={feed.live} />
+      </section>
+
+      {feed.status.notice ? (
+        <div className="flex flex-col gap-1" data-testid="chat-feed-notice">
+          <Notice tone="warn">{feed.status.notice}</Notice>
+          {feed.status.phase === "stopped" ? (
+            feed.status.reload ? (
+              <Button className="self-start text-xs" onClick={() => window.location.reload()}>
+                Reload page
+              </Button>
+            ) : (
+              <Button className="self-start text-xs" onClick={feed.reconnect}>
+                Reconnect
+              </Button>
+            )
+          ) : null}
+        </div>
+      ) : null}
+
+      <SessionSwitcher
+        profile={profile}
+        current={current}
+        onResume={onResume}
+        onNewChat={onNewChat}
+      />
+
+      <WorkspacePicker profile={profile} liveCwd={feed.live?.cwd ?? null} />
+
+      <ReasoningPicker
+        current={feed.live?.reasoning}
+        onPick={(value) => {
+          if (!typeIntoChat(`/reasoning ${value}\r`)) {
+            say("The chat is not connected; the reasoning effort was not changed.", "warn");
+          }
+        }}
+      />
+
+      <section className="flex flex-col gap-2">
+        <Button
+          disabled={!feed.lastAnswer}
+          onClick={() => void copyLast()}
+          title={feed.lastAnswer ? undefined : "No answer in this chat yet"}
+        >
+          Copy last answer
+        </Button>
+        <label className="flex cursor-pointer flex-col gap-1 rounded-md border border-dashed border-line p-2 text-xs text-muted">
+          <span>Drop or paste an image to attach it to your next message, or pick one.</span>
+          <input
+            type="file"
+            accept="image/*"
+            className="text-xs"
+            disabled={!connected}
+            onChange={(event) => {
+              void upload(firstImage(event.target.files));
+              event.target.value = "";
+            }}
+          />
+        </label>
+      </section>
+
+      {message ? (
+        <p
+          role="status"
+          className={`text-xs ${message.tone === "warn" ? "text-warn" : "text-muted"}`}
+        >
+          {message.text}
+        </p>
+      ) : null}
+    </section>
+  );
+}
diff --git a/apps/web/src/chat/attachToken.test.ts b/apps/web/src/chat/attachToken.test.ts
new file mode 100644
index 0000000..eb89078
--- /dev/null
+++ b/apps/web/src/chat/attachToken.test.ts
@@ -0,0 +1,139 @@
+import { describe, expect, it } from "vitest";
+import {
+  ATTACH_LOCK_PREFIX,
+  ATTACH_TOKEN_KEY,
+  type AttachTokenDeps,
+  AttachTokenKeeper,
+  type LockSource,
+  mintToken,
+} from "./attachToken.ts";
+
+/** A Web Locks stand-in shared by several "documents"; `ifAvailable` only. */
+class FakeLocks implements LockSource {
+  readonly held = new Set<string>();
+
+  request(
+    name: string,
+    _options: { ifAvailable: true },
+    callback: (lock: unknown) => Promise<unknown>,
+  ): Promise<unknown> {
+    if (this.held.has(name)) return callback(null);
+    this.held.add(name);
+    const hold = callback({ name });
+    return hold.finally(() => this.held.delete(name));
+  }
+}
+
+function memoryStorage(): Storage {
+  const map = new Map<string, string>();
+  return {
+    get length() {
+      return map.size;
+    },
+    clear: () => map.clear(),
+    getItem: (key) => map.get(key) ?? null,
+    key: (index) => [...map.keys()][index] ?? null,
+    removeItem: (key) => {
+      map.delete(key);
+    },
+    setItem: (key, value) => {
+      map.set(key, value);
+    },
+  };
+}
+
+function counter(): () => string {
+  let n = 0;
+  return () => {
+    n += 1;
+    return `minted-${n}`;
+  };
+}
+
+function deps(storage: Storage | null, locks: LockSource | undefined, mint = counter()) {
+  return { storage: () => storage, locks: () => locks, mint } satisfies AttachTokenDeps;
+}
+
+const flush = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe("AttachTokenKeeper", () => {
+  it("mints, stores the token in session storage and holds its lock", async () => {
+    const storage = memoryStorage();
+    const locks = new FakeLocks();
+    const keeper = new AttachTokenKeeper(deps(storage, locks));
+    const token = await keeper.current();
+    expect(token).toBe("minted-1");
+    expect(storage.getItem(ATTACH_TOKEN_KEY)).toBe(token);
+    expect(locks.held.has(`${ATTACH_LOCK_PREFIX}${token}`)).toBe(true);
+    expect(await keeper.current()).toBe(token);
+  });
+
+  it("a reloaded tab gets its stored token back", async () => {
+    const storage = memoryStorage();
+    storage.setItem(ATTACH_TOKEN_KEY, "kept-from-before");
+    const keeper = new AttachTokenKeeper(deps(storage, new FakeLocks()));
+    expect(await keeper.current()).toBe("kept-from-before");
+  });
+
+  it("a duplicated tab (same storage copy, lock held by the first) mints its own", async () => {
+    const locks = new FakeLocks();
+    const first = new AttachTokenKeeper(deps(memoryStorage(), locks, () => "first-token"));
+    const shared = await first.current();
+    // "Duplicate tab" copies session storage into the new document.
+    const copy = memoryStorage();
+    copy.setItem(ATTACH_TOKEN_KEY, shared);
+    const second = new AttachTokenKeeper(deps(copy, locks, () => "second-token"));
+    expect(await second.current()).toBe("second-token");
+    expect(copy.getItem(ATTACH_TOKEN_KEY)).toBe("second-token");
+    expect(await first.current()).toBe("first-token");
+  });
+
+  it("rotate mints a new token and lets the old lock go", async () => {
+    const storage = memoryStorage();
+    const locks = new FakeLocks();
+    const keeper = new AttachTokenKeeper(deps(storage, locks));
+    const old = await keeper.current();
+    const fresh = await keeper.rotate();
+    await flush();
+    expect(fresh).not.toBe(old);
+    expect(storage.getItem(ATTACH_TOKEN_KEY)).toBe(fresh);
+    expect(locks.held.has(`${ATTACH_LOCK_PREFIX}${old}`)).toBe(false);
+    expect(locks.held.has(`${ATTACH_LOCK_PREFIX}${fresh}`)).toBe(true);
+    expect(await keeper.current()).toBe(fresh);
+  });
+
+  it("overlapping calls agree on one token", async () => {
+    const keeper = new AttachTokenKeeper(deps(memoryStorage(), new FakeLocks()));
+    const [a, b] = await Promise.all([keeper.current(), keeper.current()]);
+    expect(a).toBe(b);
+  });
+
+  it("without Web Locks, session storage alone decides", async () => {
+    const storage = memoryStorage();
+    storage.setItem(ATTACH_TOKEN_KEY, "stored");
+    const keeper = new AttachTokenKeeper(deps(storage, undefined));
+    expect(await keeper.current()).toBe("stored");
+  });
+
+  it("blocked storage still yields a token for this document", async () => {
+    const throwing = {
+      getItem: () => {
+        throw new Error("blocked");
+      },
+      setItem: () => {
+        throw new Error("blocked");
+      },
+    } as unknown as Storage;
+    const keeper = new AttachTokenKeeper(deps(throwing, new FakeLocks()));
+    expect(await keeper.current()).toBe("minted-1");
+    expect(await keeper.current()).toBe("minted-1");
+    const none = new AttachTokenKeeper(deps(null, undefined));
+    expect(await none.current()).toBe("minted-1");
+  });
+
+  it("mintToken makes 128-bit hex values", () => {
+    const a = mintToken();
+    expect(a).toMatch(/^[0-9a-f]{32}$/);
+    expect(mintToken()).not.toBe(a);
+  });
+});
diff --git a/apps/web/src/chat/attachToken.ts b/apps/web/src/chat/attachToken.ts
new file mode 100644
index 0000000..21de429
--- /dev/null
+++ b/apps/web/src/chat/attachToken.ts
@@ -0,0 +1,166 @@
+// This tab's keep-alive identity for the chat PTY (P18-26, R09.6), sent as `?attach=`.
+//
+// The server keeps one PTY per attach token (plus profile and resume target) and closes an older
+// socket of the same key 4409 when a new one attaches. A token shared by two tabs would make them
+// steal the terminal from each other, so the token must be per tab:
+// - it lives in session storage (`indus.pty.token.chat`), which survives a reload of this tab but
+//   not a new tab;
+// - "Duplicate tab" copies session storage, so the token is also claimed with a Web Lock
+//   (`indus.pty.attach.<token>`) held for the document's lifetime. A document that finds the lock
+//   taken knows another live tab owns that token and mints its own. A reload frees the lock (the
+//   old document is gone), so the reloaded tab gets its token, and its PTY, back.
+// - "Start new session" rotates the token so the old keep-alive PTY is not reattached; the lock of
+//   the old token is released.
+// Without Web Locks the session storage alone decides; with storage blocked every document mints.
+
+export const ATTACH_TOKEN_KEY = "indus.pty.token.chat";
+export const ATTACH_LOCK_PREFIX = "indus.pty.attach.";
+
+/** The slice of `LockManager` the keeper needs. */
+export interface LockSource {
+  request(
+    name: string,
+    options: { ifAvailable: true },
+    callback: (lock: unknown) => Promise<unknown>,
+  ): Promise<unknown>;
+}
+
+export interface AttachTokenDeps {
+  storage(): Storage | null;
+  locks(): LockSource | undefined;
+  mint(): string;
+}
+
+function browserStorage(): Storage | null {
+  try {
+    return typeof window === "undefined" ? null : window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+function browserLocks(): LockSource | undefined {
+  if (typeof navigator === "undefined") return undefined;
+  const locks = (navigator as Navigator & { locks?: LockSource }).locks;
+  return locks ?? undefined;
+}
+
+/** 128 random bits as hex. */
+export function mintToken(): string {
+  const bytes = new Uint8Array(16);
+  globalThis.crypto.getRandomValues(bytes);
+  let out = "";
+  for (const byte of bytes) out += byte.toString(16).padStart(2, "0");
+  return out;
+}
+
+export const browserTokenDeps: AttachTokenDeps = {
+  storage: browserStorage,
+  locks: browserLocks,
+  mint: mintToken,
+};
+
+interface Held {
+  token: string;
+  release: () => void;
+}
+
+export class AttachTokenKeeper {
+  #held: Held | null = null;
+  /** Serialises claims: two overlapping calls must not both mint. */
+  #queue: Promise<unknown> = Promise.resolve();
+  readonly #deps: AttachTokenDeps;
+
+  constructor(deps: AttachTokenDeps = browserTokenDeps) {
+    this.#deps = deps;
+  }
+
+  /** The token this document holds right now, if any. */
+  get held(): string | null {
+    return this.#held?.token ?? null;
+  }
+
+  /** This tab's token: the one held, else the stored one if no live tab claims it, else a new one. */
+  current(): Promise<string> {
+    return this.#serial(async () => {
+      if (this.#held) return this.#held.token;
+      const stored = this.#read();
+      if (stored) {
+        const release = await this.#claim(stored);
+        if (release) {
+          this.#held = { token: stored, release };
+          return stored;
+        }
+      }
+      return this.#adopt(this.#deps.mint());
+    });
+  }
+
+  /** A new token for a fresh session; the old one's lock is let go. */
+  rotate(): Promise<string> {
+    return this.#serial(async () => {
+      const previous = this.#held;
+      this.#held = null;
+      previous?.release();
+      return this.#adopt(this.#deps.mint());
+    });
+  }
+
+  #serial<T>(work: () => Promise<T>): Promise<T> {
+    const next = this.#queue.then(work, work);
+    this.#queue = next.catch(() => undefined);
+    return next;
+  }
+
+  async #adopt(token: string): Promise<string> {
+    this.#write(token);
+    // A freshly minted token cannot be held elsewhere; no lock support still counts as held.
+    const release = (await this.#claim(token)) ?? (() => {});
+    this.#held = { token, release };
+    return token;
+  }
+
+  /** Take the token's lock: a release function, or null when another document holds it. */
+  async #claim(token: string): Promise<(() => void) | null> {
+    const locks = this.#deps.locks();
+    if (!locks) return () => {};
+    return new Promise<(() => void) | null>((settle) => {
+      let answered = false;
+      const answer = (value: (() => void) | null) => {
+        if (!answered) {
+          answered = true;
+          settle(value);
+        }
+      };
+      locks
+        .request(`${ATTACH_LOCK_PREFIX}${token}`, { ifAvailable: true }, (lock) => {
+          if (lock === null) {
+            answer(null);
+            return Promise.resolve();
+          }
+          // Keep the lock until released: the callback's promise is the hold.
+          return new Promise<void>((letGo) => answer(() => letGo()));
+        })
+        .catch(() => answer(() => {}));
+    });
+  }
+
+  #read(): string {
+    try {
+      return this.#deps.storage()?.getItem(ATTACH_TOKEN_KEY) ?? "";
+    } catch {
+      return "";
+    }
+  }
+
+  #write(token: string): void {
+    try {
+      this.#deps.storage()?.setItem(ATTACH_TOKEN_KEY, token);
+    } catch {
+      // storage blocked: the token lasts for this document only
+    }
+  }
+}
+
+/** The keeper every chat host in this document shares. */
+export const attachTokens = new AttachTokenKeeper();
