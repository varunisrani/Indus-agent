@@ -0,0 +1,565 @@
+// The chat terminal's socket to `/api/pty` (P18-26), without React or xterm.
+//
+// `PtyConnection` dials, keeps and redials one PTY socket and reports to its owner through
+// `PtyListener`: terminal text to write, the phase to show, an announced resume id, notices.
+//
+// One dial: `channel`, `attach`, `resume`, `profile`, `cwd` (only without a resume), `fresh=1`
+// (only on the first dial after "new chat") go in the query; the credential goes only in the
+// subprotocol list (`lib/wsUrl.ts`). From the start of the dial — a gated ticket fetch included —
+// the socket has 8 s to open; past that the attempt is abandoned as failed. Once open, the in-band
+// resize escape is sent at once (the TUI needs a size for its first paint), again after two
+// animation frames (layout settled) and when fonts have loaded (cell size changed), and after any
+// 20 s without a frame in either direction (a keep-alive the server consumes).
+//
+// Text frames are terminal text, except the server's `{"type":"resume","id":…}` announcement of
+// an implicit resume. Binary frames are UTF-8 decoded as a stream. While a resume replays
+// (explicit or announced) the text goes through the `ResumeSanitizer` for 30 s.
+//
+// After a close the verdict (`reconnect.ts`) decides: reload once, show copy, show an overlay, stay
+// quiet, or climb the ladder. Redials never run while the page is hidden or the chat is not the
+// current page: the connection parks and dials once when both are true again, at most once per
+// second. Redials repeat the first dial's query without `fresh`, so the server's keep-alive key is
+// the same and it reattaches the same PTY (ring replay, then a redraw).
+
+import { TOKEN_RELOAD_KEY } from "../lib/api.ts";
+import { authRequired } from "../lib/bootstrap.ts";
+import { type WsTarget, wsTarget } from "../lib/wsUrl.ts";
+import {
+  CLOSE,
+  type CloseVerdict,
+  COPY,
+  judgeClose,
+  KEEPALIVE_MS,
+  OPEN_DEADLINE_MS,
+  RESUME_THROTTLE_MS,
+  ReconnectLadder,
+} from "./reconnect.ts";
+import { ResumeSanitizer } from "./resumeSanitizer.ts";
+
+export const PTY_PATH = "/api/pty";
+export const PTY_PURPOSE = "web-pty";
+
+const SOCKET_CONNECTING = 0;
+const SOCKET_OPEN = 1;
+
+/** What the server needs to pick (or start) the PTY. */
+export interface PtyRequest {
+  channel: string;
+  attach: string;
+  resume?: string;
+  profile?: string;
+  /** Folder for a fresh chat; ignored (not sent) with a resume. */
+  cwd?: string;
+  /** Start a new conversation in this channel (drops its remembered session). */
+  fresh?: boolean;
+}
+
+/** The query of one dial; `first` is false for redials. */
+export function ptyParams(request: PtyRequest, first: boolean): Record<string, string> {
+  const params: Record<string, string> = { channel: request.channel, attach: request.attach };
+  if (request.resume) params.resume = request.resume;
+  if (request.profile) params.profile = request.profile;
+  if (!request.resume && request.cwd) params.cwd = request.cwd;
+  if (first && request.fresh && !request.resume) params.fresh = "1";
+  return params;
+}
+
+/** The exact frame the server consumes as a size change (never written to the child). */
+export function resizeFrame(cols: number, rows: number): string {
+  return `\x1b[RESIZE:${Math.max(1, Math.floor(cols))};${Math.max(1, Math.floor(rows))}]`;
+}
+
+/** The id of a `{"type":"resume","id":…}` control frame, else null. */
+export function resumeAnnouncement(text: string): string | null {
+  if (!text.startsWith("{")) return null;
+  try {
+    const value: unknown = JSON.parse(text);
+    if (typeof value !== "object" || value === null) return null;
+    const record = value as { type?: unknown; id?: unknown };
+    return record.type === "resume" && typeof record.id === "string" && record.id
+      ? record.id
+      : null;
+  } catch {
+    return null;
+  }
+}
+
+export type PtyPhase =
+  /** Dialling (first time or after a manual reconnect). */
+  | "connecting"
+  | "open"
+  /** Waiting for the next automatic attempt. */
+  | "reconnecting"
+  /** Dropped while hidden or on another page; dials when the chat is visible again. */
+  | "paused"
+  /** Not dialling any more: refused, superseded, or the ladder ran out (see `PtyStatus.stop`). */
+  | "stopped"
+  /** The TUI process ended or could not start; a new session is needed. */
+  | "ended";
+
+export type PtyStop =
+  | { kind: "gave-up" }
+  | { kind: "superseded" }
+  | { kind: "rejected"; message: string; reload: boolean }
+  | { kind: "exited" }
+  | { kind: "start-failed" };
+
+export interface PtyStatus {
+  phase: PtyPhase;
+  /** Why it stopped or ended. */
+  stop?: PtyStop;
+}
+
+export interface PtyListener {
+  output(text: string): void;
+  status(status: PtyStatus): void;
+  /** The server reopened the channel's last session on its own (implicit resume). */
+  resumed?(id: string): void;
+  /** One-line notices (input refused while not connected). */
+  notice?(text: string): void;
+}
+
+/** The minimum of `WebSocket` the connection uses (the fake server implements it too). */
+export interface PtySocket {
+  readonly readyState: number;
+  binaryType: BinaryType;
+  onopen: ((event: Event) => void) | null;
+  onmessage: ((event: MessageEvent) => void) | null;
+  onclose: ((event: CloseEvent) => void) | null;
+  onerror: ((event: Event) => void) | null;
+  send(data: string): void;
+  close(code?: number, reason?: string): void;
+}
+
+export interface PtyDeps {
+  target(path: string, purpose: string, params: Record<string, string>): Promise<WsTarget>;
+  socket(url: string, protocols: string[]): PtySocket;
+  /** Run `callback` on the next animation frame. */
+  frame(callback: () => void): void;
+  /** Settles when the page's fonts have loaded. */
+  fontsReady(): Promise<unknown>;
+  /** Reload the page if the one allowed loopback reload has not happened; false otherwise. */
+  reloadOnce(): boolean;
+  /** Whether the one reload is still available (read before deciding). */
+  mayReload(): boolean;
+  gated(): boolean;
+  hidden(): boolean;
+  now(): number;
+}
+
+function storage(): Storage | null {
+  try {
+    return window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+export const browserPtyDeps: PtyDeps = {
+  target: (path, purpose, params) => wsTarget(path, purpose, params),
+  socket: (url, protocols) => new WebSocket(url, protocols),
+  frame: (callback) => {
+    if (typeof requestAnimationFrame === "function") requestAnimationFrame(() => callback());
+    else setTimeout(callback, 16);
+  },
+  fontsReady: () => document.fonts?.ready ?? Promise.resolve(),
+  mayReload: () => {
+    const store = storage();
+    if (!store) return false;
+    try {
+      return store.getItem(TOKEN_RELOAD_KEY) === null;
+    } catch {
+      return false;
+    }
+  },
+  reloadOnce: () => {
+    const store = storage();
+    try {
+      if (!store || store.getItem(TOKEN_RELOAD_KEY) !== null) return false;
+      store.setItem(TOKEN_RELOAD_KEY, String(Date.now()));
+    } catch {
+      return false;
+    }
+    window.location.reload();
+    return true;
+  },
+  gated: authRequired,
+  hidden: () => typeof document !== "undefined" && document.visibilityState === "hidden",
+  now: () => Date.now(),
+};
+
+type Timer = ReturnType<typeof setTimeout>;
+
+export class PtyConnection {
+  readonly #deps: PtyDeps;
+  readonly #listener: PtyListener;
+  readonly #size: () => { cols: number; rows: number };
+  readonly #ladder = new ReconnectLadder();
+  readonly #sanitizer: ResumeSanitizer;
+
+  #request: PtyRequest | null = null;
+  #socket: PtySocket | null = null;
+  /** Bumped by every dial and by dispose; a stale socket's or ticket's callbacks see a mismatch. */
+  #generation = 0;
+  #status: PtyStatus = { phase: "stopped" };
+  #first = true;
+  #active = true;
+  #disposed = false;
+  #lastResumeAt = Number.NEGATIVE_INFINITY;
+  #noticeShown = false;
+  #decoder = new TextDecoder();
+
+  #deadline: Timer | null = null;
+  #retry: Timer | null = null;
+  #keepalive: Timer | null = null;
+  #window: Timer | null = null;
+
+  constructor(
+    listener: PtyListener,
+    size: () => { cols: number; rows: number },
+    deps: PtyDeps = browserPtyDeps,
+  ) {
+    this.#listener = listener;
+    this.#size = size;
+    this.#deps = deps;
+    this.#sanitizer = new ResumeSanitizer(() => deps.now());
+  }
+
+  get status(): PtyStatus {
+    return this.#status;
+  }
+
+  get request(): PtyRequest | null {
+    return this.#request;
+  }
+
+  /** Start a new connection for `request` (drops the current socket without reacting to it). */
+  connect(request: PtyRequest): void {
+    if (this.#disposed) return;
+    this.#request = { ...request };
+    this.#first = true;
+    this.#ladder.reset();
+    this.#dropSocket();
+    this.#clear("retry");
+    this.#setStatus({ phase: "connecting" });
+    void this.#dial();
+  }
+
+  /** Manual reconnect (after the ladder stopped, or "try again"): same request, fresh ladder. */
+  reconnect(): void {
+    if (this.#disposed || !this.#request) return;
+    this.#ladder.reset();
+    this.#dropSocket();
+    this.#clear("retry");
+    this.#setStatus({ phase: "connecting" });
+    void this.#dial();
+  }
+
+  /** Whether the chat is the page on screen; leaving parks a pending redial. */
+  setActive(active: boolean): void {
+    this.#active = active;
+    if (active) this.pageResumed();
+    else if (this.#status.phase === "reconnecting" && this.#retry !== null) this.#park();
+  }
+
+  /**
+   * The page came back (visible, focus, online) or the chat became the current page: a parked
+   * connection dials again, at most once per `RESUME_THROTTLE_MS` (a burst of such events makes one
+   * dial; one inside the throttle is deferred to its end, not dropped).
+   */
+  pageResumed(): void {
+    if (this.#disposed || !this.#request || !this.#mayDial()) return;
+    if (this.#status.phase !== "paused" || this.#retry !== null) return;
+    const wait = this.#lastResumeAt + RESUME_THROTTLE_MS - this.#deps.now();
+    if (wait > 0) {
+      this.#retry = setTimeout(() => {
+        this.#retry = null;
+        this.#resumeDial();
+      }, wait);
+      return;
+    }
+    this.#resumeDial();
+  }
+
+  #resumeDial(): void {
+    if (!this.#mayDial()) {
+      this.#park();
+      return;
+    }
+    this.#lastResumeAt = this.#deps.now();
+    this.#setStatus({ phase: "reconnecting" });
+    void this.#dial();
+  }
+
+  /** Send keystrokes; false (with one notice per outage) when not connected. */
+  send(data: string): boolean {
+    const socket = this.#socket;
+    if (this.#status.phase !== "open" || !socket || socket.readyState !== SOCKET_OPEN) {
+      if (!this.#noticeShown) {
+        this.#noticeShown = true;
+        this.#listener.notice?.(COPY.inputRefused);
+      }
+      return false;
+    }
+    socket.send(data);
+    this.#touch();
+    return true;
+  }
+
+  /** Tell the server the terminal's current size (no-op while not open). */
+  sendSize(): void {
+    const socket = this.#socket;
+    if (!socket || socket.readyState !== SOCKET_OPEN) return;
+    const { cols, rows } = this.#size();
+    socket.send(resizeFrame(cols, rows));
+    this.#touch();
+  }
+
+  dispose(): void {
+    this.#disposed = true;
+    this.#generation += 1;
+    this.#dropSocket();
+    for (const name of ["deadline", "retry", "keepalive", "window"] as const) this.#clear(name);
+  }
+
+  // -- dialling ---------------------------------------------------------------------------------
+
+  #mayDial(): boolean {
+    return this.#active && !this.#deps.hidden();
+  }
+
+  async #dial(): Promise<void> {
+    const request = this.#request;
+    if (!request) return;
+    this.#dropSocket();
+    const generation = ++this.#generation;
+    const params = ptyParams(request, this.#first);
+    this.#clear("deadline");
+    this.#deadline = setTimeout(() => this.#onDeadline(generation), OPEN_DEADLINE_MS);
+
+    let target: WsTarget;
+    try {
+      target = await this.#deps.target(PTY_PATH, PTY_PURPOSE, params);
+    } catch (error) {
+      if (generation !== this.#generation) return;
+      // biome-ignore lint/suspicious/noConsole: diagnosis without server access; no credential in it
+      console.warn("[indus chat] could not prepare the chat connection", error);
+      this.#clear("deadline");
+      this.#afterFailure();
+      return;
+    }
+    if (generation !== this.#generation || this.#disposed) return;
+
+    const socket = this.#deps.socket(target.url, target.protocols);
+    socket.binaryType = "arraybuffer";
+    this.#socket = socket;
+    this.#decoder = new TextDecoder();
+    socket.onopen = () => {
+      if (generation === this.#generation) this.#onOpen(socket, request);
+    };
+    socket.onmessage = (event) => {
+      if (generation === this.#generation) this.#onMessage(event.data);
+    };
+    socket.onclose = (event) => {
+      if (generation === this.#generation) this.#onClose(event.code, event.wasClean, event.reason);
+    };
+    socket.onerror = () => {
+      // The close event that follows carries the code; nothing to do here.
+    };
+  }
+
+  #onDeadline(generation: number): void {
+    this.#deadline = null;
+    if (generation !== this.#generation) return;
+    const socket = this.#socket;
+    if (socket && socket.readyState === SOCKET_CONNECTING) {
+      // Stuck handshake: abandon it; its own close (if it ever comes) is ignored.
+      this.#dropSocket();
+      this.#afterFailure();
+    } else if (!socket) {
+      // The ticket never came: this attempt is over, a late ticket must not open a socket.
+      this.#generation += 1;
+      this.#afterFailure();
+    }
+  }
+
+  #onOpen(socket: PtySocket, request: PtyRequest): void {
+    this.#clear("deadline");
+    this.#ladder.reset();
+    this.#first = false;
+    this.#noticeShown = false;
+    this.#setStatus({ phase: "open" });
+    this.sendSize();
+    this.#deps.frame(() => this.#deps.frame(() => this.#sizeIfCurrent(socket)));
+    void this.#deps.fontsReady().then(
+      () => this.#sizeIfCurrent(socket),
+      () => undefined,
+    );
+    if (request.resume) this.#beginReplay();
+  }
+
+  #sizeIfCurrent(socket: PtySocket): void {
+    if (this.#socket === socket) this.sendSize();
+  }
+
+  #onMessage(data: unknown): void {
+    this.#touch();
+    let text: string;
+    if (typeof data === "string") {
+      const announced = resumeAnnouncement(data);
+      if (announced !== null) {
+        this.#beginReplay();
+        this.#listener.resumed?.(announced);
+        return;
+      }
+      text = data;
+    } else if (data instanceof ArrayBuffer) {
+      text = this.#decoder.decode(new Uint8Array(data), { stream: true });
+    } else if (ArrayBuffer.isView(data)) {
+      text = this.#decoder.decode(data, { stream: true });
+    } else {
+      return;
+    }
+    const out = this.#sanitizer.active ? this.#sanitizer.feed(text) : text;
+    if (out) this.#listener.output(out);
+  }
+
+  #beginReplay(): void {
+    this.#sanitizer.begin();
+    this.#clear("window");
+    this.#window = setTimeout(() => {
+      this.#window = null;
+      const released = this.#sanitizer.settle();
+      if (released) this.#listener.output(released);
+    }, this.#sanitizer.remainingMs);
+  }
+
+  #onClose(code: number, clean: boolean, reason: string): void {
+    this.#socket = null;
+    this.#clear("deadline");
+    this.#clear("keepalive");
+    this.#clear("window");
+    const tail = this.#sanitizer.end();
+    if (tail) this.#listener.output(tail);
+    // biome-ignore lint/suspicious/noConsole: close codes go to the console, never into the copy
+    console.warn(`[indus chat] terminal socket closed: code=${code}${reason ? ` ${reason}` : ""}`);
+
+    const verdict: CloseVerdict = judgeClose(code, clean, {
+      gated: this.#deps.gated(),
+      mayReload: this.#deps.mayReload(),
+    });
+    switch (verdict.kind) {
+      case "reload":
+        if (this.#deps.reloadOnce()) {
+          this.#setStatus({ phase: "stopped" });
+          return;
+        }
+        this.#setStatus({
+          phase: "stopped",
+          stop: { kind: "rejected", message: COPY.loginExpired, reload: true },
+        });
+        return;
+      case "rejected":
+        this.#setStatus({ phase: "stopped", stop: verdict });
+        return;
+      case "superseded":
+        this.#setStatus({ phase: "stopped", stop: { kind: "superseded" } });
+        return;
+      case "start-failed":
+        this.#setStatus({ phase: "ended", stop: { kind: "start-failed" } });
+        return;
+      case "exited":
+        if (code === CLOSE.exited || code === CLOSE.normal) {
+          this.#listener.output(`\r\n\x1b[2m${COPY.endedLine}\x1b[0m\r\n`);
+        }
+        this.#setStatus({ phase: "ended", stop: { kind: "exited" } });
+        return;
+      case "retry":
+        this.#afterFailure();
+        return;
+    }
+  }
+
+  /** A transient failure: park, climb or stop. */
+  #afterFailure(): void {
+    if (this.#disposed) return;
+    if (!this.#mayDial()) {
+      this.#park();
+      return;
+    }
+    const delay = this.#ladder.climb();
+    if (delay === null) {
+      this.#setStatus({ phase: "stopped", stop: { kind: "gave-up" } });
+      return;
+    }
+    this.#setStatus({ phase: "reconnecting" });
+    this.#clear("retry");
+    this.#retry = setTimeout(() => {
+      this.#retry = null;
+      if (!this.#mayDial()) {
+        this.#park();
+        return;
+      }
+      void this.#dial();
+    }, delay);
+  }
+
+  #park(): void {
+    this.#clear("retry");
+    this.#setStatus({ phase: "paused" });
+  }
+
+  // -- keep-alive and housekeeping --------------------------------------------------------------
+
+  /** Some frame went either way: the keep-alive waits another full period of silence. */
+  #touch(): void {
+    this.#clear("keepalive");
+    if (!this.#socket || this.#socket.readyState !== SOCKET_OPEN) return;
+    this.#keepalive = setTimeout(() => {
+      this.#keepalive = null;
+      this.sendSize();
+    }, KEEPALIVE_MS);
+  }
+
+  #dropSocket(): void {
+    const socket = this.#socket;
+    this.#socket = null;
+    this.#clear("keepalive");
+    if (!socket) return;
+    socket.onopen = null;
+    socket.onmessage = null;
+    socket.onclose = null;
+    socket.onerror = null;
+    try {
+      socket.close(1000, "client closed");
+    } catch {
+      // already closing
+    }
+  }
+
+  #clear(name: "deadline" | "retry" | "keepalive" | "window"): void {
+    switch (name) {
+      case "deadline":
+        if (this.#deadline !== null) clearTimeout(this.#deadline);
+        this.#deadline = null;
+        return;
+      case "retry":
+        if (this.#retry !== null) clearTimeout(this.#retry);
+        this.#retry = null;
+        return;
+      case "keepalive":
+        if (this.#keepalive !== null) clearTimeout(this.#keepalive);
+        this.#keepalive = null;
+        return;
+      case "window":
+        if (this.#window !== null) clearTimeout(this.#window);
+        this.#window = null;
+        return;
+    }
+  }
+
+  #setStatus(status: PtyStatus): void {
+    this.#status = status;
+    if (!this.#disposed) this.#listener.status(status);
+  }
+}
diff --git a/apps/web/src/chat/reconnect.ts b/apps/web/src/chat/reconnect.ts
new file mode 100644
index 0000000..78e802e
--- /dev/null
+++ b/apps/web/src/chat/reconnect.ts
@@ -0,0 +1,137 @@
+// What the chat terminal does after its socket closes (P18-26): the timing constants, the
+// reconnect ladder and the verdict for each close code, with the words the person sees. Pure: no
+// socket, no DOM, so every rule is testable on its own. Close codes never appear in the copy; the
+// connection logs them to the console instead.
+
+/** First reconnect delay; each later one doubles up to the cap. */
+export const RECONNECT_BASE_MS = 250;
+export const RECONNECT_CAP_MS = 3_000;
+/** Automatic attempts before the ladder stops and only a manual reconnect is offered. */
+export const RECONNECT_ATTEMPTS = 5;
+/** Page-return events (visible, focus, online) start at most one attempt per this period. */
+export const RESUME_THROTTLE_MS = 1_000;
+/** From the start of a dial (ticket fetch included) until the socket must be open. */
+export const OPEN_DEADLINE_MS = 8_000;
+/** Silence after which a resize frame is sent to keep idle-closing proxies off the socket. */
+export const KEEPALIVE_MS = 20_000;
+/** How long after a resume the output is sanitised (R09.8). */
+export const SANITIZE_WINDOW_MS = 30_000;
+
+/** Delay before automatic attempt `attempt` (1-based): 250, 500, 1000, 2000, 3000 ms. */
+export function reconnectDelay(attempt: number): number {
+  const step = Math.max(0, Math.floor(attempt) - 1);
+  return Math.min(RECONNECT_CAP_MS, RECONNECT_BASE_MS * 2 ** step);
+}
+
+/** Counts automatic attempts in one outage. */
+export class ReconnectLadder {
+  #used = 0;
+  readonly limit: number;
+
+  constructor(limit: number = RECONNECT_ATTEMPTS) {
+    this.limit = limit;
+  }
+
+  /** Attempts used since the last successful open. */
+  get used(): number {
+    return this.#used;
+  }
+
+  get exhausted(): boolean {
+    return this.#used >= this.limit;
+  }
+
+  /** Claim the next attempt: its delay, or null when the ladder is used up. */
+  climb(): number | null {
+    if (this.exhausted) return null;
+    this.#used += 1;
+    return reconnectDelay(this.#used);
+  }
+
+  reset(): void {
+    this.#used = 0;
+  }
+}
+
+export const CLOSE = {
+  normal: 1000,
+  goingAway: 1001,
+  abnormal: 1006,
+  startFailed: 1011,
+  restarting: 1012,
+  tryAgain: 1013,
+  credential: 4401,
+  origin: 4403,
+  disabled: 4404,
+  peer: 4408,
+  superseded: 4409,
+  exited: 4410,
+} as const;
+
+export const COPY = {
+  reconnecting: "The chat connection dropped. Reconnecting…",
+  gaveUp:
+    "The chat lost its connection to the dashboard server. If you stopped indus dashboard, start it again; otherwise reconnect.",
+  inputRefused: "The chat is not connected right now, so this input was not sent.",
+  exited:
+    "This chat session has ended. If you did not end it, open Logs to see what happened, or start a new session.",
+  startFailed: "The chat could not start. The terminal above says why.",
+  superseded: "This chat terminal moved to another tab or window.",
+  loginExpired: "Your dashboard login expired (the server may have restarted). Reload the page.",
+  origin:
+    "The dashboard refused this chat because the page address does not match the server. Open the address indus dashboard printed.",
+  disabled: "This dashboard server does not offer the chat terminal.",
+  peer: "This dashboard only takes chat connections from the machine it runs on.",
+  endedLine: "[chat session ended]",
+} as const;
+
+export type CloseVerdict =
+  /** 4401 in loopback mode, first time: the token rotated; reload the page once. */
+  | { kind: "reload" }
+  /** Refused before any PTY existed; retrying cannot help. */
+  | { kind: "rejected"; message: string; reload: boolean }
+  /** 1011: the server could not start the chat and printed why in the terminal. */
+  | { kind: "start-failed" }
+  /** 4410 or a clean 1000: the TUI process ended. */
+  | { kind: "exited" }
+  /** 4409: another socket took this PTY over; stay quiet. */
+  | { kind: "superseded" }
+  /** Anything transient: climb the ladder. */
+  | { kind: "retry" };
+
+export interface CloseContext {
+  /** Gated mode (a login provider guards the dashboard). */
+  gated: boolean;
+  /** False when the one allowed reload already happened (or storage cannot remember it). */
+  mayReload: boolean;
+}
+
+/** What to do after a close with `code` (`clean` is the event's `wasClean`). */
+export function judgeClose(code: number, clean: boolean, context: CloseContext): CloseVerdict {
+  switch (code) {
+    case CLOSE.credential:
+      if (!context.gated && context.mayReload) return { kind: "reload" };
+      return { kind: "rejected", message: COPY.loginExpired, reload: true };
+    case CLOSE.origin:
+      return { kind: "rejected", message: COPY.origin, reload: false };
+    case CLOSE.disabled:
+      return { kind: "rejected", message: COPY.disabled, reload: true };
+    case CLOSE.peer:
+      return { kind: "rejected", message: COPY.peer, reload: false };
+    case CLOSE.startFailed:
+      return { kind: "start-failed" };
+    case CLOSE.exited:
+      return { kind: "exited" };
+    case CLOSE.superseded:
+      return { kind: "superseded" };
+    case CLOSE.goingAway:
+    case CLOSE.abnormal:
+    case CLOSE.restarting:
+    case CLOSE.tryAgain:
+      return { kind: "retry" };
+    case CLOSE.normal:
+      return clean ? { kind: "exited" } : { kind: "retry" };
+    default:
+      return clean ? { kind: "exited" } : { kind: "retry" };
+  }
+}
diff --git a/apps/web/src/chat/resumeSanitizer.test.ts b/apps/web/src/chat/resumeSanitizer.test.ts
new file mode 100644
index 0000000..62255f9
--- /dev/null
+++ b/apps/web/src/chat/resumeSanitizer.test.ts
@@ -0,0 +1,126 @@
+import { describe, expect, it } from "vitest";
+import { FLOOD_BREAKS, ResumeSanitizer, scrub, splitTail } from "./resumeSanitizer.ts";
+
+function clock() {
+  const state = { now: 1_000 };
+  return { state, now: () => state.now };
+}
+
+const crlf = (n: number) => "\r\n".repeat(n);
+
+describe("ResumeSanitizer", () => {
+  it("folds 80 blank lines into one inside the 30 s window and not after", () => {
+    const c = clock();
+    const s = new ResumeSanitizer(c.now);
+    s.begin();
+    expect(s.feed(`head${crlf(81)}tail`)).toBe("head\r\n\r\ntail");
+
+    c.state.now += 29_999;
+    expect(s.active).toBe(true);
+    expect(s.feed(`a${crlf(81)}b`)).toBe("a\r\n\r\nb");
+
+    c.state.now += 1;
+    expect(s.active).toBe(false);
+    expect(s.feed(`a${crlf(81)}b`)).toBe(`a${crlf(81)}b`);
+  });
+
+  it("drops erase sequences inside the window and keeps them after", () => {
+    const c = clock();
+    const s = new ResumeSanitizer(c.now);
+    s.begin();
+    expect(s.feed("one\x1b[Ktwo\x1b[2Xthree\x1b[0K.")).toBe("onetwothree.");
+    c.state.now += 30_000;
+    expect(s.feed("spin\x1b[K.")).toBe("spin\x1b[K.");
+  });
+
+  it("passes everything through before any resume", () => {
+    const s = new ResumeSanitizer(clock().now);
+    const text = `x\x1b[K${crlf(70)}y`;
+    expect(s.active).toBe(false);
+    expect(s.feed(text)).toBe(text);
+  });
+
+  it("keeps runs below the threshold", () => {
+    const s = new ResumeSanitizer(clock().now);
+    s.begin();
+    const text = `a${crlf(FLOOD_BREAKS - 1)}b`;
+    expect(s.feed(text)).toBe(text);
+  });
+
+  it("recognises an erase sequence split across frames", () => {
+    const s = new ResumeSanitizer(clock().now);
+    s.begin();
+    expect(s.feed("left\x1b")).toBe("left");
+    expect(s.feed("[")).toBe("");
+    expect(s.feed("2")).toBe("");
+    expect(s.feed("Kright")).toBe("right");
+    // An escape that turns out to be something else is passed on whole.
+    expect(s.feed("x\x1b[")).toBe("x");
+    expect(s.feed("31mred")).toBe("\x1b[31mred");
+  });
+
+  it("collects a flood split across frames, CR and LF split too", () => {
+    const s = new ResumeSanitizer(clock().now);
+    s.begin();
+    let out = s.feed(`start${crlf(30)}\r`);
+    out += s.feed(`\n${crlf(20)}`);
+    out += s.feed(`${crlf(30)}end`);
+    expect(out).toBe("start\r\n\r\nend");
+  });
+
+  it("collects a flood interrupted by erase codes", () => {
+    const s = new ResumeSanitizer(clock().now);
+    s.begin();
+    let out = s.feed(`a${crlf(30)}\x1b[`);
+    out += s.feed(`K${crlf(30)}b`);
+    out += s.feed(`${crlf(25)}\x1b[K${crlf(25)}c`);
+    expect(out).toBe("a\r\n\r\nb\r\n\r\nc");
+  });
+
+  it("settle releases held breaks when the window ends; a held escape completes with the next frame", () => {
+    const c = clock();
+    const s = new ResumeSanitizer(c.now);
+    s.begin();
+    expect(s.feed(`line${crlf(3)}`)).toBe("line");
+    c.state.now += 30_000;
+    expect(s.settle()).toBe(crlf(3));
+
+    s.begin();
+    expect(s.feed("x\x1b[1")).toBe("x");
+    c.state.now += 30_000;
+    expect(s.settle()).toBe("");
+    expect(s.feed("mbold")).toBe("\x1b[1mbold");
+  });
+
+  it("end drops a held partial escape and closes the window", () => {
+    const s = new ResumeSanitizer(clock().now);
+    s.begin();
+    expect(s.feed(`a${crlf(2)}\x1b[`)).toBe("a");
+    expect(s.end()).toBe(crlf(2));
+    expect(s.active).toBe(false);
+    expect(s.feed("K")).toBe("K");
+  });
+
+  it("begin while active extends the window, never shortens it", () => {
+    const c = clock();
+    const s = new ResumeSanitizer(c.now);
+    s.begin();
+    c.state.now += 20_000;
+    s.begin();
+    expect(s.remainingMs).toBe(30_000);
+  });
+});
+
+describe("helpers", () => {
+  it("splitTail holds a partial escape, the breaks before it, or trailing breaks", () => {
+    expect(splitTail("abc")).toEqual(["abc", ""]);
+    expect(splitTail("abc\r\n\r\n")).toEqual(["abc", "\r\n\r\n"]);
+    expect(splitTail("abc\r")).toEqual(["abc", "\r"]);
+    expect(splitTail("abc\r\n\x1b[12")).toEqual(["abc", "\r\n\x1b[12"]);
+    expect(splitTail("abc\x1b[12m")).toEqual(["abc\x1b[12m", ""]);
+  });
+
+  it("scrub removes erase codes before measuring floods", () => {
+    expect(scrub(`${crlf(25)}\x1b[K${crlf(25)}`)).toBe("\r\n\r\n");
+  });
+});
diff --git a/apps/web/src/chat/resumeSanitizer.ts b/apps/web/src/chat/resumeSanitizer.ts
new file mode 100644
index 0000000..b9d65a3
--- /dev/null
+++ b/apps/web/src/chat/resumeSanitizer.ts
@@ -0,0 +1,117 @@
+// Output clean-up while a resumed chat replays its history (P18-26, R09.8).
+//
+// When the TUI reopens a long session it redraws the whole transcript, and on the way it emits
+// floods of blank lines and erase sequences (`ESC [ n K`, `ESC [ n X`) that leave xterm's viewport
+// blank. For a bounded window after a resume (explicit `resume=`, or the server's announced
+// implicit one) this filter drops those erase sequences and folds any run of 50 or more line breaks
+// into a single blank line. Outside the window the stream passes through untouched: erase codes are
+// how spinners and status lines repaint in place.
+//
+// The PTY runs in cooked mode, so line breaks arrive as CR LF; frames are cut wherever a read
+// ended, so an escape sequence, a CR/LF pair or a long run can span frames. The filter therefore
+// holds back the end of a frame that might continue: a partial escape (`ESC`, `ESC [`,
+// `ESC [ digits`), the newline run just before it, or a trailing newline run (a lone trailing CR
+// included). Erase codes are removed before runs are measured, so erase codes sprinkled through a
+// flood do not break it into short runs that slip past.
+
+import { SANITIZE_WINDOW_MS } from "./reconnect.ts";
+
+/** Line breaks in a row that count as a flood. */
+export const FLOOD_BREAKS = 50;
+
+// biome-ignore lint/suspicious/noControlCharactersInRegex: terminal streams are escape sequences
+const ERASE = /\x1b\[\d*[KX]/g;
+const FLOOD = new RegExp(`(?:\\r?\\n){${FLOOD_BREAKS},}`, "g");
+// biome-ignore lint/suspicious/noControlCharactersInRegex: terminal streams are escape sequences
+const PARTIAL_ESCAPE = /\x1b(?:\[\d*)?$/;
+/** What a flood becomes: end the line, then one blank line. */
+const FOLDED = "\r\n\r\n";
+
+/** Drop erase sequences, then fold floods of line breaks. */
+export function scrub(text: string): string {
+  return text.replace(ERASE, "").replace(FLOOD, FOLDED);
+}
+
+/** Index where a trailing run of line breaks (and a lone CR after it) starts in `text[0, end)`. */
+function breaksStart(text: string, end: number): number {
+  let at = end;
+  if (at > 0 && text[at - 1] === "\r") at -= 1;
+  while (at > 0 && text[at - 1] === "\n") {
+    at -= 1;
+    if (at > 0 && text[at - 1] === "\r") at -= 1;
+  }
+  return at;
+}
+
+/** Split `text` into what can be filtered now and a tail that may continue in the next frame. */
+export function splitTail(text: string): [ready: string, tail: string] {
+  const partial = PARTIAL_ESCAPE.exec(text);
+  const end = partial ? partial.index : text.length;
+  const cut = breaksStart(text, end);
+  return [text.slice(0, cut), text.slice(cut)];
+}
+
+export class ResumeSanitizer {
+  #until = Number.NEGATIVE_INFINITY;
+  #held = "";
+  readonly #now: () => number;
+  readonly #windowMs: number;
+
+  constructor(now: () => number = Date.now, windowMs: number = SANITIZE_WINDOW_MS) {
+    this.#now = now;
+    this.#windowMs = windowMs;
+  }
+
+  /** Open (or extend) the window: a resume replay starts now. */
+  begin(): void {
+    this.#until = Math.max(this.#until, this.#now() + this.#windowMs);
+  }
+
+  /** True while output is being filtered. */
+  get active(): boolean {
+    return this.#now() < this.#until;
+  }
+
+  /** How long the window still runs (0 when closed). */
+  get remainingMs(): number {
+    return Math.max(0, this.#until - this.#now());
+  }
+
+  /** Filter one decoded frame; returns what to write now. */
+  feed(chunk: string): string {
+    if (!this.active) {
+      // Window over: whatever was still held goes first (a held escape completes with `chunk`).
+      const released = this.settle();
+      const out = released + this.#held + chunk;
+      this.#held = "";
+      return out;
+    }
+    const combined = this.#held + chunk;
+    const [ready, tail] = splitTail(combined);
+    this.#held = tail;
+    return scrub(ready);
+  }
+
+  /**
+   * The window ended: release held line breaks (folded if they already make a flood). A held
+   * partial escape stays held and goes out in front of the next frame, where it completes.
+   */
+  settle(): string {
+    const partial = PARTIAL_ESCAPE.exec(this.#held);
+    const keep = partial ? this.#held.slice(partial.index) : "";
+    const release = partial ? this.#held.slice(0, partial.index) : this.#held;
+    this.#held = keep;
+    return release.replace(FLOOD, FOLDED);
+  }
+
+  /**
+   * The stream closed: release held line breaks, drop a held partial escape (written into the
+   * next stream it would swallow that stream's first bytes) and close the window.
+   */
+  end(): string {
+    const out = this.settle();
+    this.#held = "";
+    this.#until = Number.NEGATIVE_INFINITY;
+    return out;
+  }
+}
diff --git a/apps/web/src/chat/terminal.ts b/apps/web/src/chat/terminal.ts
new file mode 100644
index 0000000..ae48828
--- /dev/null
+++ b/apps/web/src/chat/terminal.ts
@@ -0,0 +1,301 @@
+// The chat's terminal view (P18-26): xterm.js with the fit, Unicode 11, web-links and WebGL addons,
+// behind the small `ChatTerminal` surface the host needs (tests give the host a fake).
+//
+// WebGL is the fast renderer but not everywhere: software rasterisers (llvmpipe, SwiftShader,
+// softpipe, anything reporting "software") advertise WebGL and then fail or crawl, so the DOM
+// renderer is kept there; a context loss also falls back to it. Browsers cap live GL contexts, so
+// the WebGL addon is disposed while the terminal is hidden (another dashboard tab, or the browser
+// tab in the background) and loaded again on return.
+//
+// Colours come from the @indus/ui tokens of the active theme (CSS variables plus the 16-colour ANSI
+// map), re-read when `data-theme` on <html> changes.
+
+import { ansi, type ThemeName } from "@indus/ui";
+
+export interface TermSize {
+  cols: number;
+  rows: number;
+}
+
+export interface ChatTerminal {
+  open(parent: HTMLElement): void;
+  write(text: string): void;
+  onData(listener: (data: string) => void): () => void;
+  onResize(listener: (size: TermSize) => void): () => void;
+  size(): TermSize;
+  /** Resize to the parent's box (no-op while the parent is hidden). */
+  fit(): void;
+  focus(): void;
+  scrollLines(lines: number): void;
+  /** Pixel height of one row, for touch scrolling. */
+  rowHeight(): number;
+  /** Load or release the GPU renderer (when supported). */
+  setRendererVisible(visible: boolean): void;
+  /** The hidden input xterm types into (composition events come from it). */
+  input(): HTMLTextAreaElement | undefined;
+  dispose(): void;
+}
+
+export type TerminalFactory = () => Promise<ChatTerminal>;
+
+const SOFTWARE_RENDERER = /llvmpipe|swiftshader|softpipe|software/i;
+
+/** True for a GL renderer string that names a software rasteriser. */
+export function isSoftwareRenderer(renderer: string): boolean {
+  return SOFTWARE_RENDERER.test(renderer);
+}
+
+/** Whether the GPU renderer should be used on this page (probes one context, then frees it). */
+export function webglUsable(doc: Document = document): boolean {
+  let gl: WebGLRenderingContext | WebGL2RenderingContext | null = null;
+  try {
+    const canvas = doc.createElement("canvas");
+    gl = canvas.getContext("webgl2") ?? canvas.getContext("webgl");
+  } catch {
+    return false;
+  }
+  if (!gl) return false;
+  let software = false;
+  try {
+    const info = gl.getExtension("WEBGL_debug_renderer_info");
+    if (info) software = isSoftwareRenderer(String(gl.getParameter(info.UNMASKED_RENDERER_WEBGL)));
+  } catch {
+    // renderer name hidden: trust the context we got
+  }
+  try {
+    gl.getExtension("WEBGL_lose_context")?.loseContext();
+  } catch {
+    // already gone
+  }
+  return !software;
+}
+
+function themeName(): ThemeName {
+  const set = document.documentElement.dataset.theme;
+  if (set === "indus-dark" || set === "indus-light") return set;
+  const dark =
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-color-scheme: dark)").matches;
+  return dark ? "indus-dark" : "indus-light";
+}
+
+function cssVar(name: string, fallback: string): string {
+  const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
+  return value || fallback;
+}
+
+/** xterm colours for the active theme. */
+export function terminalColours(): Record<string, string> {
+  const name = themeName();
+  const map = ansi[name];
+  const dark = name === "indus-dark";
+  return {
+    background: cssVar("--indus-color-code-bg", dark ? "#16181d" : "#f6f5f2"),
+    foreground: cssVar("--indus-color-fg", dark ? "#e8e6e1" : "#1f1f1c"),
+    cursor: cssVar("--indus-color-accent", dark ? "#8ab4f8" : "#2557c7"),
+    selectionBackground: cssVar("--indus-color-selection", dark ? "#33415c" : "#cdd9f2"),
+    black: map.black,
+    red: map.red,
+    green: map.green,
+    yellow: map.yellow,
+    blue: map.blue,
+    magenta: map.magenta,
+    cyan: map.cyan,
+    white: map.white,
+    brightBlack: map.brightBlack,
+    brightRed: map.brightRed,
+    brightGreen: map.brightGreen,
+    brightYellow: map.brightYellow,
+    brightBlue: map.brightBlue,
+    brightMagenta: map.brightMagenta,
+    brightCyan: map.brightCyan,
+    brightWhite: map.brightWhite,
+  };
+}
+
+/** The real terminal (xterm and its addons load with the chat chunk). */
+export const createXtermTerminal: TerminalFactory = async () => {
+  const [{ Terminal }, { FitAddon }, { Unicode11Addon }, { WebLinksAddon }, { WebglAddon }] =
+    await Promise.all([
+      import("@xterm/xterm"),
+      import("@xterm/addon-fit"),
+      import("@xterm/addon-unicode11"),
+      import("@xterm/addon-web-links"),
+      import("@xterm/addon-webgl"),
+      import("@xterm/xterm/css/xterm.css"),
+    ]);
+
+  const term = new Terminal({
+    allowProposedApi: true, // the Unicode 11 width table is a proposed API
+    cursorBlink: true,
+    fontFamily: cssVar("--indus-font-mono", "ui-monospace, SFMono-Regular, Menlo, monospace"),
+    fontSize: 14,
+    scrollback: 5_000,
+    theme: terminalColours(),
+  });
+  const fit = new FitAddon();
+  term.loadAddon(fit);
+  term.loadAddon(new Unicode11Addon());
+  term.unicode.activeVersion = "11";
+  term.loadAddon(
+    new WebLinksAddon((_event, uri) => {
+      window.open(uri, "_blank", "noopener,noreferrer");
+    }),
+  );
+
+  const gpuAllowed = webglUsable();
+  let gpu: InstanceType<typeof WebglAddon> | null = null;
+  let opened = false;
+  const releaseGpu = () => {
+    const addon = gpu;
+    gpu = null;
+    try {
+      addon?.dispose();
+    } catch {
+      // already released
+    }
+  };
+  const loadGpu = () => {
+    if (!gpuAllowed || gpu || !opened) return;
+    try {
+      const addon = new WebglAddon();
+      addon.onContextLoss(() => releaseGpu());
+      term.loadAddon(addon);
+      gpu = addon;
+    } catch {
+      gpu = null; // the DOM renderer stays
+    }
+  };
+
+  const themeWatch = new MutationObserver(() => {
+    term.options.theme = terminalColours();
+  });
+  themeWatch.observe(document.documentElement, {
+    attributes: true,
+    attributeFilter: ["data-theme"],
+  });
+
+  return {
+    open(parent) {
+      term.open(parent);
+      opened = true;
+      loadGpu();
+    },
+    write: (text) => term.write(text),
+    onData(listener) {
+      const sub = term.onData(listener);
+      return () => sub.dispose();
+    },
+    onResize(listener) {
+      const sub = term.onResize(listener);
+      return () => sub.dispose();
+    },
+    size: () => ({ cols: term.cols, rows: term.rows }),
+    fit() {
+      const element = term.element;
+      if (!element || element.offsetParent === null) return; // hidden: nothing to measure
+      try {
+        fit.fit();
+      } catch {
+        // not measurable yet
+      }
+    },
+    focus: () => term.focus(),
+    scrollLines: (lines) => term.scrollLines(lines),
+    rowHeight() {
+      const height = term.element?.clientHeight ?? 0;
+      return term.rows > 0 && height > 0 ? height / term.rows : 17;
+    },
+    setRendererVisible(visible) {
+      if (visible) loadGpu();
+      else releaseGpu();
+    },
+    input: () => term.textarea,
+    dispose() {
+      themeWatch.disconnect();
+      releaseGpu();
+      term.dispose();
+    },
+  };
+};
+
+/** SGR mouse reports (`ESC [ < b ; x ; y M|m`); never forwarded to the PTY. */
+// biome-ignore lint/suspicious/noControlCharactersInRegex: terminal streams are escape sequences
+const MOUSE_REPORT = /^(?:\x1b\[<\d+;\d+;\d+[Mm])+$/;
+
+export function isMouseReport(data: string): boolean {
+  return MOUSE_REPORT.test(data);
+}
+
+/** How long a composition commit waits for xterm to deliver it, and how long echoes count. */
+export const COMMIT_WAIT_MS = 20;
+export const ECHO_MS = 80;
+
+/**
+ * IME composition safety net. xterm normally turns a composition commit into `onData`; some
+ * browsers and soft keyboards do not, and some deliver it twice (a repeated `compositionend`, or
+ * `onData` after the commit). `commit(text)` forwards `text` after a short wait unless xterm's data
+ * already carried it; `filter(data)` strips an echo of a commit this guard forwarded.
+ */
+export class CompositionGuard {
+  readonly #send: (data: string) => void;
+  readonly #now: () => number;
+  #pending: string | null = null;
+  #timer: ReturnType<typeof setTimeout> | null = null;
+  #forwarded: { text: string; at: number } | null = null;
+  #typed: { text: string; at: number } | null = null;
+
+  constructor(send: (data: string) => void, now: () => number = Date.now) {
+    this.#send = send;
+    this.#now = now;
+  }
+
+  #recent(entry: { text: string; at: number } | null): entry is { text: string; at: number } {
+    return entry !== null && this.#now() - entry.at <= ECHO_MS;
+  }
+
+  /** A `compositionend` with its committed text. */
+  commit(text: string): void {
+    if (!text) return;
+    if (this.#recent(this.#typed) && this.#typed.text.endsWith(text)) return; // xterm had it
+    if (this.#recent(this.#forwarded) && this.#forwarded.text === text) return; // fired twice
+    this.#release();
+    this.#pending = text;
+    this.#timer = setTimeout(() => this.#release(), COMMIT_WAIT_MS);
+  }
+
+  /** xterm's `onData`; returns what is still worth sending. */
+  filter(data: string): string {
+    let out = data;
+    if (!data.startsWith("\x1b") && this.#recent(this.#forwarded)) {
+      const sent = this.#forwarded.text;
+      if (data === sent) out = "";
+      else if (data.startsWith(sent)) out = data.slice(sent.length);
+    }
+    if (out && !out.startsWith("\x1b")) {
+      const carried = this.#recent(this.#typed) ? this.#typed.text : "";
+      this.#typed = { text: (carried + out).slice(-256), at: this.#now() };
+      if (this.#pending !== null && this.#typed.text.endsWith(this.#pending)) this.#cancel();
+    }
+    return out;
+  }
+
+  dispose(): void {
+    this.#cancel();
+  }
+
+  #release(): void {
+    const text = this.#pending;
+    this.#cancel();
+    if (text) {
+      this.#forwarded = { text, at: this.#now() };
+      this.#send(text);
+    }
+  }
+
+  #cancel(): void {
+    if (this.#timer !== null) clearTimeout(this.#timer);
+    this.#timer = null;
+    this.#pending = null;
+  }
+}
