+}
+
+.msg-assistant .md-table th {
+  height: 36px;
+  padding: 0 10px;
+  background: transparent;
+}
+
+.msg-assistant .md-table td {
+  height: 31px;
+  padding: 0 10px;
+}
+
+/* -- timeline rail -------------------------------------------------------------------------- */
+
+.timeline {
+  display: flex;
+  align-items: center;
+}
+
+.timeline-marker {
+  width: 8px;
+  background: var(--desk-stroke-strong);
+}
