+
+/* -- composer notice strip ------------------------------------------------------------------- */
+
+.notice-strip {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  height: 26px;
+  margin: 0 3px -1px;
+  padding: 0 10px;
+  border: 1px solid color-mix(in srgb, var(--desk-stroke-1) 60%, var(--desk-stroke-strong));
+  border-bottom: 0;
+  border-radius: 5px 5px 0 0;
+  background: var(--desk-bg-input);
+  font-size: var(--desk-text-small);
+  white-space: nowrap;
+}
+
+.notice-strip-icon {
+  display: inline-flex;
+  color: var(--desk-fg-3);
+}
+
+.notice-strip-text {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.notice-strip-lead {
+  color: color-mix(in srgb, var(--desk-fg-1) 92%, transparent);
+  font-weight: 500;
+}
+
+.notice-strip-hint {
+  margin-left: 6px;
+  color: var(--desk-fg-3);
+}
+
+.notice-strip-action {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  cursor: pointer;
+}
+
+.notice-strip-action[data-quiet] {
+  color: var(--desk-fg-3);
+}
+
+.notice-strip-action:hover {
+  text-decoration: underline;
+}
+
+/* -- placement in the column (after the blocks so these win) ------------------------------- */
+
+.msg-assistant,
+.turn > .error-card,
+.turn > .msg-notice,
+.turn > .msg-async {
+  margin-left: var(--tx-indent);
+}
+
+.msg-text + .msg-text,
+.msg-text + .tool-row,
+.tool-row + .msg-text {
+  margin-top: 12px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .turn-dither,
+  .card-activity,
+  .tool-spin {
+    animation: none;
+  }
+}
