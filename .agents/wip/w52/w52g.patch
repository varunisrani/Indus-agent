 const EXIT_ONE = /(?:exit(?:ed)?(?: with)?(?: code| status)?\s*[:=]?\s*|"exit_code"\s*:\s*)1\b/i;
 
-/** The row's colour state once the tool finished. */
+const BLOCKED = /"status"\s*:\s*"blocked"/;
+
+/** The row's colour state once the tool finished. A refused call (`status: "blocked"`) is red. */
 export function toolOutcome(ok: boolean, result: string): "ok" | "failed" | "neutral" {
+  if (BLOCKED.test(result)) return "failed";
   if (ok) return "ok";
   // Empty error fields of a structured result say nothing.
   const said = result.replace(/"(error|stderr|exception)"\s*:\s*(null|""|\[\])/gi, "");
@@ -69,3 +72,32 @@ export function toolImages(result: string | null): string[] {
   );
   return found === null ? [] : [...new Set(found)].slice(0, 8);
 }
+
+/** What a terminal tool's structured result says (W52-g): the parts the expanded row shows. */
+export interface TerminalResult {
+  readonly output: string;
+  readonly exitCode: number | null;
+  readonly error: string;
+  readonly blocked: boolean;
+}
+
+/** Read a terminal result safely: JSON with `output` / `exit_code`, else null (show it raw). */
+export function terminalResult(result: string | null): TerminalResult | null {
+  if (result === null || result.trim() === "") return null;
+  let data: unknown;
+  try {
+    data = JSON.parse(result);
+  } catch {
+    return null;
+  }
+  if (typeof data !== "object" || data === null || Array.isArray(data)) return null;
+  const record = data as Record<string, unknown>;
+  if (!("output" in record) && !("exit_code" in record)) return null;
+  const text = (value: unknown) => (typeof value === "string" ? value : "");
+  return {
+    output: text(record.output),
+    exitCode: typeof record.exit_code === "number" ? record.exit_code : null,
+    error: text(record.error),
+    blocked: record.status === "blocked",
+  };
+}
diff --git a/apps/desktop/src/chat/transcript.css b/apps/desktop/src/chat/transcript.css
new file mode 100644
index 0000000..7a4b690
--- /dev/null
+++ b/apps/desktop/src/chat/transcript.css
@@ -0,0 +1,788 @@
+/* The transcript column (W52-g): prompt box, indented reply, markdown blocks, tool rows, the turn
+   activity line, the approval card stack, the error card and the composer's notice strip.
+   Desk tokens only; the few in-between shades are mixed from them so presets follow. */
+
+:root {
+  /* faint step text: tool rows, the activity line, "Running …" */
+  --tx-scaffold: color-mix(in srgb, var(--desk-fg-3) 45%, var(--desk-fg-4));
+  /* inset boxes inside an open tool row */
+  --tx-inset: color-mix(in srgb, var(--desk-stroke-2) 35%, var(--desk-bg-canvas));
+  /* quiet chip and secondary button fill */
+  --tx-chip: color-mix(in srgb, var(--desk-stroke-2) 55%, var(--desk-bg-canvas));
+  /* the reply's indent under its prompt */
+  --tx-indent: 12px;
+  --tx-rejected: color-mix(in srgb, var(--desk-danger) 65%, var(--desk-bg-canvas));
+}
+
+/* -- layout --------------------------------------------------------------------------------- */
+
+.transcript-scroll {
+  padding: 9px 24px 24px;
+  line-height: 1.4;
+}
+
+.turn > .msg-user {
+  margin: 0;
+  padding: 0;
+}
+
+.msg {
+  margin: 6px 0;
+}
+
+.msg-user .msg-bubble {
+  padding: 8px 12px;
+  border-color: var(--desk-stroke-2);
+  border-radius: 3px;
+  line-height: 20px;
+  max-height: calc(4 * 20px + 16px);
+  overflow: hidden;
+}
+
+/* the time a prompt was sent here, on hover only */
+.msg-user-meta {
+  position: absolute;
+  top: 50%;
+  right: 12px;
+  transform: translateY(-50%);
+  padding-left: 12px;
+  background: var(--desk-bg-bubble);
+  color: var(--desk-fg-4);
+  font-size: var(--desk-text-micro);
+  font-variant-numeric: tabular-nums;
+  opacity: 0;
+  transition: opacity var(--indus-duration-fast, 120ms);
+}
+
+.msg-user:hover .msg-user-meta,
+.msg-user:focus-within .msg-user-meta {
+  opacity: 1;
+}
+
+.msg-text > .md > :first-child {
+  margin-top: 0;
+}
+
+.msg-text > .md > :last-child {
+  margin-bottom: 0;
+}
+
+/* -- markdown blocks ------------------------------------------------------------------------ */
+
+.msg-assistant .md h1,
+.msg-assistant .md h2,
+.msg-assistant .md h3,
+.msg-assistant .md h4,
+.msg-assistant .md h5,
+.msg-assistant .md h6 {
+  color: var(--desk-fg-1);
+  font-size: 16.5px;
+  font-weight: 600;
+  line-height: 1.3;
+  margin: 12px 0 6px;
+}
+
+.msg-assistant .md li {
+  margin: 4px 0;
+}
+
+.md-code-wrap {
+  position: relative;
+  margin: 12px 0;
+}
+
+.md-code-wrap > .md-code {
+  margin: 0;
+  padding: 10px 12px;
+  border-radius: 6px;
+  background: color-mix(in srgb, var(--desk-bg-code) 55%, var(--desk-bg-canvas));
