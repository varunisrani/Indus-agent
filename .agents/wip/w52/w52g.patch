+.error-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 9px;
+  border: 1px solid color-mix(in srgb, var(--desk-danger) 30%, var(--desk-bg-canvas));
+  border-radius: 999px;
