+// The "Add MCP server" panel (W52-c): name, transport, then either a URL with a sign-in mode or a
+// command line with arguments and environment. Problems are shown inline before anything is sent.
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { type FormEvent, useId, useState } from "react";
+import { api } from "../../lib/api.ts";
+import type { McpAuth, McpServerCreate, McpTransport } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { Button, Field, Input, Notice, Select, Textarea } from "../../ui/controls.tsx";
+import { DialogActions, Modal } from "../../ui/Dialog.tsx";
+
+/** `KEY=value` lines → an env object; null when a line is malformed. */
+export function parseEnvLines(text: string): Record<string, string> | null {
+  const env: Record<string, string> = {};
+  for (const raw of text.split("\n")) {
+    const line = raw.trim();
+    if (!line) continue;
+    const at = line.indexOf("=");
+    if (at <= 0) return null;
+    const key = line.slice(0, at).trim();
+    if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) return null;
+    env[key] = line.slice(at + 1);
+  }
+  return env;
+}
+
+/** Split an argument line on whitespace, keeping "quoted parts" together. */
+export function splitArgs(text: string): string[] {
+  const out: string[] = [];
+  for (const match of text.matchAll(/"([^"]*)"|'([^']*)'|(\S+)/g))
+    out.push(match[1] ?? match[2] ?? match[3] ?? "");
+  return out;
+}
+
+const AUTH_HINT: Partial<Record<McpAuth, string>> = {
+  header: "Store the token on the Keys page; the server entry only names it.",
+  oauth: "You sign in from this page once the server is added.",
+};
+
+export function AddServerModal({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const ids = useId();
+  const [name, setName] = useState("");
+  const [transport, setTransport] = useState<McpTransport>("http");
+  const [command, setCommand] = useState("");
+  const [args, setArgs] = useState("");
+  const [envText, setEnvText] = useState("");
+  const [url, setUrl] = useState("");
+  const [auth, setAuth] = useState<McpAuth>("none");
+  const [problem, setProblem] = useState("");
+
+  const reset = () => {
+    setName("");
+    setCommand("");
+    setArgs("");
+    setEnvText("");
+    setUrl("");
+    setAuth("none");
+    setProblem("");
+  };
+
+  const add = useMutation({
+    mutationFn: (body: McpServerCreate) => api.mcp.add(body),
+    onSuccess: (_reply, body) => {
+      toast.show(`${body.name} added.`, "success");
+      reset();
+      void client.invalidateQueries({ queryKey: ["mcp"] });
+      onClose();
+    },
+    onError: (error) => setProblem(errorText(error)),
+  });
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    if (!/^[A-Za-z0-9._-]{1,64}$/.test(name.trim()))
+      return setProblem("Name the server with letters, digits, dots, dashes or underscores.");
+    let body: McpServerCreate;
+    if (transport === "stdio") {
+      if (!command.trim()) return setProblem("Give the command that starts the server.");
+      const env = parseEnvLines(envText);
+      if (env === null)
+        return setProblem("Write environment variables as KEY=value, one per line.");
+      body = { name: name.trim(), command: command.trim(), args: splitArgs(args), env };
+    } else {
+      if (!/^https?:\/\/\S+$/.test(url.trim())) return setProblem("Give the server's http(s) URL.");
+      body = { name: name.trim(), url: url.trim(), auth };
+    }
+    setProblem("");
+    add.mutate(body);
+  };
+
+  const switchTransport = (next: McpTransport) => {
+    setTransport(next);
+    if (next === "stdio") {
+      setUrl("");
+      setAuth("none");
+    } else {
+      setCommand("");
+      setArgs("");
+      setEnvText("");
+    }
+  };
+
+  return (
+    <Modal
+      open={open}
+      size="narrow"
+      onOpenChange={(next) => (next ? undefined : onClose())}
+      title="Add MCP server"
+    >
+      <form className="flex flex-col gap-4 py-1" onSubmit={submit} noValidate>
+        <Field label="Name" htmlFor={`${ids}-name`}>
+          <Input
+            id={`${ids}-name`}
+            autoFocus
+            placeholder="my-server"
+            value={name}
+            onChange={(e) => setName(e.currentTarget.value)}
+          />
+        </Field>
+        <Field label="Transport" htmlFor={`${ids}-transport`}>
+          <Select
+            id={`${ids}-transport`}
+            value={transport}
+            onChange={(e) => switchTransport(e.currentTarget.value as McpTransport)}
+          >
+            <option value="http">HTTP/SSE</option>
+            <option value="stdio">stdio</option>
+          </Select>
+        </Field>
+        {transport === "stdio" ? (
+          <>
+            <Field label="Command" htmlFor={`${ids}-command`}>
+              <Input
+                id={`${ids}-command`}
+                placeholder="npx"
+                value={command}
+                onChange={(e) => setCommand(e.currentTarget.value)}
+              />
+            </Field>
+            <Field label="Arguments" htmlFor={`${ids}-args`}>
+              <Input
+                id={`${ids}-args`}
+                placeholder="-y my-mcp-server --flag"
+                value={args}
+                onChange={(e) => setArgs(e.currentTarget.value)}
+              />
+            </Field>
+            <Field label="Environment (KEY=value per line)" htmlFor={`${ids}-env`}>
+              <Textarea
+                id={`${ids}-env`}
+                className="min-h-20"
+                rows={3}
+                value={envText}
+                onChange={(e) => setEnvText(e.currentTarget.value)}
+              />
+            </Field>
+          </>
+        ) : (
+          <>
+            <Field label="URL" htmlFor={`${ids}-url`}>
+              <Input
+                id={`${ids}-url`}
+                placeholder="https://example.com/mcp"
+                value={url}
+                onChange={(e) => setUrl(e.currentTarget.value)}
+              />
+            </Field>
+            <Field
+              label="Authentication"
+              htmlFor={`${ids}-auth`}
+              {...(AUTH_HINT[auth] ? { hint: AUTH_HINT[auth] } : {})}
+            >
+              <Select
+                id={`${ids}-auth`}
+                value={auth}
+                onChange={(e) => setAuth(e.currentTarget.value as McpAuth)}
+              >
+                <option value="none">None</option>
+                <option value="header">Bearer token</option>
+                <option value="oauth">OAuth</option>
+              </Select>
+            </Field>
+          </>
+        )}
+        {problem ? <Notice tone="danger">{problem}</Notice> : null}
+        <DialogActions>
+          <Button
+            type="submit"
+            tone="primary"
+            size="sm"
+            className="uppercase"
+            disabled={add.isPending}
+          >
+            {add.isPending ? "Adding…" : "Add"}
+          </Button>
+        </DialogActions>
+      </form>
+    </Modal>
+  );
+}
diff --git a/apps/web/src/pages/skills/HubView.tsx b/apps/web/src/pages/skills/HubView.tsx
new file mode 100644
index 0000000..d4269ae
--- /dev/null
+++ b/apps/web/src/pages/skills/HubView.tsx
@@ -0,0 +1,171 @@
+// Browse hub (P18-22, look W52-c): search the skills hub; every result carries the safety
+// scanner's verdict and a `dangerous` skill cannot be installed.
+
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { Search } from "lucide-react";
+import { useState } from "react";
+import { ApiError, api } from "../../lib/api.ts";
+import type { HubResult, ScanVerdict } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import {
+  Badge,
+  type BadgeTone,
+  Button,
+  Card,
+  CardHeader,
+  Input,
+  Notice,
+  QueryState,
+} from "../../ui/controls.tsx";
+
+const VERDICT_TONE: Record<ScanVerdict, BadgeTone> = {
+  safe: "ok",
+  caution: "warn",
+  dangerous: "danger",
+};
+
+function HubRow({ hit }: { hit: HubResult }) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const [problem, setProblem] = useState("");
+  const done = (message: string) => {
+    setProblem("");
+    toast.show(message, "success");
+    void client.invalidateQueries({ queryKey: ["skills"] });
+  };
+  const fail = (error: unknown) => {
+    if (error instanceof ApiError && error.status === 409) {
+      setProblem(`${error.message} The install was refused.`);
+    } else {
+      setProblem(errorText(error));
+    }
+  };
+  const install = useMutation({
+    mutationFn: () => api.skills.hubInstall(hit.identifier),
+    onSuccess: () => done(`${hit.name} installed.`),
+    onError: fail,
+  });
+  const update = useMutation({
+    mutationFn: () => api.skills.hubUpdate(hit.name),
+    onSuccess: () => done(`${hit.name} updated.`),
+    onError: fail,
+  });
+  const uninstall = useMutation({
+    mutationFn: () => api.skills.hubUninstall(hit.name),
+    onSuccess: () => done(`${hit.name} removed.`),
+    onError: fail,
+  });
+  const blocked = hit.verdict === "dangerous";
+  return (
+    <li
+      className="flex flex-col gap-2 border border-line px-4 py-3"
+      data-testid={`hub-${hit.identifier}`}
+    >
+      <div className="flex items-start gap-3">
+        <div className="flex min-w-0 flex-1 flex-col gap-1">
+          <div className="flex flex-wrap items-center gap-2">
+            <span className="type-data text-[0.875rem] text-ink">{hit.name}</span>
+            {hit.verdict === null ? (
+              <Badge>scanned on install</Badge>
+            ) : (
+              <Badge tone={VERDICT_TONE[hit.verdict]}>scan: {hit.verdict}</Badge>
+            )}
+            <Badge tone="secondary">{hit.source}</Badge>
+            {hit.installed ? <Badge tone="ok">installed</Badge> : null}
+          </div>
+          <p className="m-0 text-[0.75rem] text-ink-muted">{hit.description}</p>
+        </div>
+        <div className="flex shrink-0 items-center gap-1">
+          {hit.installed ? (
+            <>
+              {hit.update_available ? (
+                <Button size="sm" onClick={() => update.mutate()} disabled={update.isPending}>
+                  Update
+                </Button>
+              ) : null}
+              <Button
+                tone="ghost"
+                size="sm"
+                className="text-danger"
+                onClick={() => uninstall.mutate()}
+                disabled={uninstall.isPending}
+              >
+                Uninstall
+              </Button>
+            </>
+          ) : (
+            <Button
+              tone="primary"
+              size="sm"
+              onClick={() => install.mutate()}
+              disabled={blocked || install.isPending}
+            >
+              {blocked ? "Blocked by the scanner" : "Install"}
+            </Button>
+          )}
+        </div>
+      </div>
+      {problem ? <Notice tone="danger">{problem}</Notice> : null}
+    </li>
+  );
+}
+
+export function HubView() {
+  const [draft, setDraft] = useState("");
+  const [query, setQuery] = useState("");
+  const results = useQuery({
+    queryKey: ["skills", "hub", query],
+    queryFn: () => api.skills.hubSearch(query),
+    enabled: query.length > 0,
+  });
+  const list = results.data?.results ?? [];
+  return (
+    <Card padded={false}>
+      <CardHeader
+        icon={Search}
+        title="Browse hub"
+        aside={query && results.data ? <Badge tone="secondary">{list.length} results</Badge> : null}
+      />
+      <div className="flex flex-col gap-3 p-4">
+        <search>
+          <form
+            className="flex gap-2"
+            onSubmit={(event) => {
+              event.preventDefault();
+              setQuery(draft.trim());
+            }}
+          >
+            <Input
+              aria-label="Search the skills hub"
+              className="flex-1"
+              placeholder="Search the hub..."
+              value={draft}
+              onChange={(e) => setDraft(e.currentTarget.value)}
+            />
+            <Button type="submit" icon={<Search />}>
+              Search
+            </Button>
+          </form>
+        </search>
+        {query ? (
+          <QueryState
+            loading={results.isPending}
+            error={results.error}
+            empty={list.length === 0}
+            emptyText="Nothing in the hub matches."
+          >
+            <ul className="m-0 flex list-none flex-col gap-3 p-0" aria-label="Hub results">
+              {list.map((hit) => (
+                <HubRow key={hit.identifier} hit={hit} />
+              ))}
+            </ul>
+          </QueryState>
+        ) : (
+          <p className="m-0 text-[0.8125rem] text-ink-muted">
+            Search the hub for skills to install. Every result shows the safety scanner's verdict.
+          </p>
+        )}
+      </div>
+    </Card>
+  );
+}
diff --git a/apps/web/src/pages/skills/SkillDialogs.tsx b/apps/web/src/pages/skills/SkillDialogs.tsx
new file mode 100644
index 0000000..321fef5
--- /dev/null
+++ b/apps/web/src/pages/skills/SkillDialogs.tsx
@@ -0,0 +1,170 @@
+// The New skill editor and the Learn a skill dialog (W52-c). Our backend has no route that writes a
+// skill or starts a chat with a prompt yet, so the editor composes SKILL.md and copies it for the
+// person to save, and the learn dialog explains where to ask instead (decisions W52-c-7).
+
+import { useId, useState } from "react";
+import { useToast } from "../../shell/Toasts.tsx";
+import { Button, Field, Input, Notice, Textarea } from "../../ui/controls.tsx";
+import { DialogActions, Modal } from "../../ui/Dialog.tsx";
+
+/** Starter text for a new SKILL.md (front matter, a heading and one line of guidance). */
+export function skillTemplate(name: string): string {
+  const slug = name.trim() || "my-skill";
+  return [
+    "---",
+    `name: ${slug}`,
+    "description: One line on what this skill does and when to reach for it.",
+    "---",
+    "",
+    `# ${slug}`,
+    "",
+    "Write the steps the agent should follow, in the order it should take them.",
+    "",
+  ].join("\n");
+}
+
+/** Where a skill's file lives under the Indus home. */
+export function skillPath(name: string, category: string): string {
+  const parts = ["~/.indus/skills", category.trim(), name.trim() || "<name>", "SKILL.md"];
+  return parts.filter(Boolean).join("/");
+}
+
+const NAME = /^[a-z0-9][a-z0-9._-]{0,63}$/;
+
+export function SkillEditorDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const toast = useToast();
+  const ids = useId();
+  const [name, setName] = useState("");
+  const [category, setCategory] = useState("");
+  const [body, setBody] = useState(() => skillTemplate(""));
+  const [problem, setProblem] = useState("");
+
+  const create = async () => {
+    if (!NAME.test(name.trim()))
+      return setProblem(
+        "Name the skill in lower case: letters, digits, dots, dashes or underscores.",
+      );
+    if (!body.trim()) return setProblem("Write the skill's SKILL.md.");
+    setProblem("");
+    try {
+      await navigator.clipboard.writeText(body);
+      toast.show(`Copied. Save it as ${skillPath(name, category)}.`, "success");
+      onClose();
+    } catch {
+      setProblem("The browser refused the clipboard; copy the text by hand.");
+    }
+  };
+
+  return (
+    <Modal
+      open={open}
+      size="lg"
+      onOpenChange={(next) => (next ? undefined : onClose())}
+      title="New skill"
+      description="Front matter plus markdown. Saved in your skills folder, it is ready for the agent and for cron jobs."
+    >
+      <div className="flex flex-col gap-4 py-1">
+        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+          <Field label="Name" htmlFor={`${ids}-name`}>
+            <Input
+              id={`${ids}-name`}
+              autoFocus
+              placeholder="my-skill"
+              value={name}
+              onChange={(e) => setName(e.currentTarget.value)}
+            />
+          </Field>
+          <Field label="Category (optional)" htmlFor={`${ids}-category`}>
+            <Input
+              id={`${ids}-category`}
+              placeholder="devops"
+              value={category}
+              onChange={(e) => setCategory(e.currentTarget.value)}
+            />
+          </Field>
+        </div>
+        <Field label="SKILL.md" htmlFor={`${ids}-body`}>
+          <Textarea
+            id={`${ids}-body`}
+            spellCheck={false}
+            className="min-h-80 max-h-[55vh] resize-y text-[0.75rem] leading-relaxed"
+            value={body}
+            onChange={(e) => setBody(e.currentTarget.value)}
+          />
+        </Field>
+        <p className="type-serif m-0 text-[0.75rem] text-ink-soft">
+          Saving from the dashboard is not available yet: Create skill copies the file so you can
+          save it as <code className="type-data text-[0.75rem]">{skillPath(name, category)}</code>.
+        </p>
+        {problem ? <Notice tone="danger">{problem}</Notice> : null}
+        <DialogActions>
+          <Button tone="ghost" size="sm" onClick={onClose}>
+            Cancel
+          </Button>
+          <Button tone="primary" size="sm" className="uppercase" onClick={() => void create()}>
+            Create skill
+          </Button>
+        </DialogActions>
+      </div>
+    </Modal>
+  );
+}
+
+export function LearnSkillDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const ids = useId();
+  const [task, setTask] = useState("");
+  const [name, setName] = useState("");
+  const [source, setSource] = useState("");
+  return (
+    <Modal
+      open={open}
+      size="lg"
+      onOpenChange={(next) => (next ? undefined : onClose())}
+      title="Learn a skill"
+      description="Describe a task; the agent works out the steps and writes them up as a skill."
+    >
+      <div className="flex flex-col gap-4 py-1">
+        <Field label="What should it learn?" htmlFor={`${ids}-task`}>
+          <Textarea
+            id={`${ids}-task`}
+            autoFocus
+            className="min-h-24"
+            placeholder="e.g. how we cut a release of the docs site"
+            value={task}
+            onChange={(e) => setTask(e.currentTarget.value)}
+          />
+        </Field>
+        <div className="grid grid-cols-1 gap-3 sm:grid-cols-2">
+          <Field label="Name (optional)" htmlFor={`${ids}-name`}>
+            <Input
+              id={`${ids}-name`}
+              placeholder="release-docs"
+              value={name}
+              onChange={(e) => setName(e.currentTarget.value)}
+            />
+          </Field>
+          <Field label="Source (optional)" htmlFor={`${ids}-source`}>
+            <Input
+              id={`${ids}-source`}
+              placeholder="a URL or a folder"
+              value={source}
+              onChange={(e) => setSource(e.currentTarget.value)}
+            />
+          </Field>
+        </div>
+        <p className="type-serif m-0 text-[0.75rem] text-ink-soft">
+          Starting this from the dashboard is not available yet. Ask the agent in a chat to learn it
+          as a skill instead.
+        </p>
+        <DialogActions>
+          <Button tone="ghost" size="sm" onClick={onClose}>
+            Cancel
+          </Button>
+          <Button tone="primary" size="sm" className="uppercase" disabled>
+            Start learning
+          </Button>
+        </DialogActions>
+      </div>
+    </Modal>
+  );
+}
