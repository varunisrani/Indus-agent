+          id={`${ids}-mode`}
+          value={draft.mode}
+          onChange={(e) => onChange({ mode: e.currentTarget.value as ScheduleMode })}
+        >
+          {SCHEDULE_MODES.map((mode) => (
+            <option key={mode.value} value={mode.value}>
+              {mode.label}
+            </option>
+          ))}
+        </Select>
+      </Field>
