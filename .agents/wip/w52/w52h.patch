+  /** Focus the first row on open (off when a search field takes focus). */
+  autoFocus?: boolean;
+  /** Elements whose clicks do not count as "away" (the trigger). */
+  keepOpenFor?: React.RefObject<HTMLElement | null>;
+  id?: string;
