+// The sidebar row's menu (W52-h): right-click a session row, or Shift+F10 / the context-menu key on
+// a focused one. Only actions Indus really has: open in a floating window, rename, pin, unread,
+// copy the id, archive, delete (W52-h-4 lists what the reference has that we leave out).
+
+import {
+  Archive,
+  ArchiveRestore,
+  Copy,
+  ExternalLink,
+  Mail,
+  MailOpen,
+  Pencil,
+  Pin,
+  PinOff,
+  Trash2,
+} from "lucide-react";
+import { useT } from "../i18n/index.tsx";
+import { ContextMenuAt, MenuRow, MenuSeparator } from "../ui/components.tsx";
+
+export interface RowMenuActions {
+  popOut?: (() => void) | undefined;
+  rename: () => void;
+  togglePin: () => void;
+  toggleUnread: () => void;
+  copyId: () => void;
+  toggleArchive: () => void;
+  remove: () => void;
+}
+
+export function SessionRowMenu(props: {
+  x: number;
+  y: number;
+  title: string;
+  pinned: boolean;
+  unread: boolean;
+  archived: boolean;
+  actions: RowMenuActions;
+  onClose: () => void;
+}) {
+  const t = useT();
+  const run = (action: () => void) => () => {
+    props.onClose();
+    action();
+  };
+  const a = props.actions;
+  return (
+    <ContextMenuAt
+      label={t("sidebar.menu.label", { title: props.title })}
+      x={props.x}
+      y={props.y}
+      onClose={props.onClose}
+    >
+      {a.popOut !== undefined && (
+        <>
+          <MenuRow
+            icon={<ExternalLink aria-hidden="true" />}
+            label={t("sidebar.menu.popOut")}
+            onSelect={run(a.popOut)}
+          />
+          <MenuSeparator />
+        </>
+      )}
