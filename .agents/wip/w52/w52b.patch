+// Switch model dialog (W52-b-5), shared by the Models page and (later) the chat page: a filter box,
+// the providers on the left (name, id, key state, the one in use marked), and the model on the
+// right. Our API cannot list a provider's models, so the right side offers the model in use (when
+// that provider is picked) and a model id field. The caller decides what applying means.
+
+import { useQuery } from "@tanstack/react-query";
+import { Check, RefreshCw, Search } from "lucide-react";
+import { type FormEvent, useId, useMemo, useState } from "react";
+import { api } from "../lib/api.ts";
+import type { ProviderOption } from "../lib/restTypes.ts";
+import { Button, inputClass, Loading } from "./controls.tsx";
+import { cx } from "./cx.ts";
+import { Modal } from "./Dialog.tsx";
+
+export interface ModelChoice {
+  provider: string;
+  model: string;
+}
+
+function matches(provider: ProviderOption, filter: string): boolean {
+  const needle = filter.trim().toLowerCase();
+  if (!needle) return true;
+  return `${provider.label} ${provider.name}`.toLowerCase().includes(needle);
+}
+
+function ProviderRow({
+  provider,
+  selected,
+  current,
+  onPick,
+}: {
+  provider: ProviderOption;
+  selected: boolean;
+  current: boolean;
+  onPick: () => void;
+}) {
+  return (
+    <li>
+      <button
+        type="button"
+        aria-pressed={selected}
+        onClick={onPick}
+        className={cx(
+          "flex w-full flex-col items-start gap-0.5 border-l-2 px-3 py-1.5 text-left font-mono text-[0.75rem] transition-colors",
+          selected
+            ? "border-ink bg-selected text-ink"
+            : "border-transparent text-ink-muted hover:bg-hover",
+        )}
+      >
+        <span className="flex w-full min-w-0 items-center gap-2">
+          <span className="truncate font-medium">{provider.label}</span>
+          {current ? <span className="shrink-0 text-ink uppercase">current</span> : null}
+        </span>
+        <span className="truncate text-ink-soft">
+          {provider.name} · {provider.configured ? "configured" : "no key"}
+        </span>
+      </button>
+    </li>
+  );
+}
+
+function PickerBody({
+  onApply,
+  onCancel,
+  busy,
+  note,
+}: {
+  onApply: (choice: ModelChoice) => void;
+  onCancel: () => void;
+  busy: boolean;
+  note: string;
+}) {
+  const ids = useId();
+  const options = useQuery({ queryKey: ["models", "options"], queryFn: () => api.model.options() });
+  const current = options.data?.current ?? { provider: null, model: null };
+  const providers = options.data?.providers ?? [];
+  const [filter, setFilter] = useState("");
+  const [picked, setPicked] = useState<string | null>(null);
+  const [draft, setDraft] = useState<string | null>(null);
+  const provider = picked ?? current.provider ?? providers[0]?.name ?? "";
+  const model = draft ?? current.model ?? "";
+  const shown = useMemo(() => providers.filter((p) => matches(p, filter)), [providers, filter]);
+  const unchanged = provider === (current.provider ?? "") && model.trim() === (current.model ?? "");
+  const ready = provider !== "" && model.trim() !== "" && !unchanged && !busy;
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    if (ready) onApply({ provider, model: model.trim() });
+  };
+
+  return (
+    <form onSubmit={submit} noValidate className="-mx-4 -my-3 flex flex-col">
+      <div className="border-b border-line px-4 py-3">
+        <span className="relative flex">
+          <Search
+            aria-hidden="true"
+            className="pointer-events-none absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-ink-soft"
+          />
+          <input
+            aria-label="Filter providers"
+            placeholder="Filter providers…"
+            className={cx(inputClass, "w-full pl-8")}
+            value={filter}
+            onChange={(e) => setFilter(e.currentTarget.value)}
+          />
+        </span>
+      </div>
+      <div className="grid h-[min(24rem,52vh)] grid-cols-[12.5rem_1fr]">
+        <div className="min-h-0 overflow-y-auto border-r border-line">
+          {options.isPending ? (
+            <div className="p-3">
+              <Loading />
+            </div>
+          ) : options.error ? (
+            <p role="alert" className="m-0 p-3 text-[0.75rem] text-danger">
+              {options.error instanceof Error ? options.error.message : "Providers unavailable."}
+            </p>
+          ) : shown.length === 0 ? (
+            <p className="m-0 p-3 text-[0.75rem] text-ink-soft italic">
+              {providers.length === 0 ? "No providers are known to this install." : "No match."}
+            </p>
+          ) : (
+            <ul aria-label="Providers" className="m-0 list-none p-0">
+              {shown.map((p) => (
+                <ProviderRow
+                  key={p.name}
+                  provider={p}
+                  selected={p.name === provider}
+                  current={p.name === current.provider}
+                  onPick={() => setPicked(p.name)}
+                />
+              ))}
+            </ul>
+          )}
+        </div>
+        <div className="flex min-h-0 flex-col gap-3 overflow-y-auto p-3">
+          {provider === current.provider && current.model ? (
+            <button
+              type="button"
+              onClick={() => setDraft(current.model)}
+              className="flex items-center gap-2 px-1 py-1 text-left font-mono text-[0.75rem] text-ink-muted hover:bg-hover"
+            >
+              <Check
+                aria-hidden="true"
+                className={cx("size-3", model === current.model ? "text-ink" : "invisible")}
+              />
+              <span className="min-w-0 flex-1 truncate">{current.model}</span>
+              <span className="text-ink uppercase">current</span>
+            </button>
+          ) : null}
+          <div className="flex flex-col gap-1.5">
+            <label htmlFor={`${ids}-model`} className="type-label text-ink-muted">
+              Model id
+            </label>
+            <input
+              id={`${ids}-model`}
+              className={inputClass}
+              value={model}
+              placeholder="e.g. the id your provider lists"
+              onChange={(e) => setDraft(e.currentTarget.value)}
+            />
+            <p className="type-serif m-0 text-[0.75rem] text-ink-soft">
+              Type the model id as the provider names it; this install cannot list them.
+            </p>
+          </div>
+        </div>
+      </div>
+      <div className="flex flex-wrap items-center gap-2 border-t border-line px-4 py-3">
+        <p className="type-serif m-0 min-w-0 flex-1 text-[0.6875rem] text-ink-soft">{note}</p>
+        <Button
+          size="lg"
+          icon={<RefreshCw aria-hidden="true" />}
+          onClick={() => void options.refetch()}
+          disabled={options.isFetching}
+        >
+          Refresh models
+        </Button>
+        <Button size="lg" onClick={onCancel}>
+          Cancel
+        </Button>
+        <Button size="lg" tone="primary" type="submit" disabled={!ready}>
+          Switch
+        </Button>
+      </div>
+    </form>
+  );
+}
+
+export function ModelPickerDialog({
+  open,
+  onOpenChange,
+  onApply,
+  busy = false,
+  note = "Saved to the config; new sessions use it.",
+}: {
+  open: boolean;
+  onOpenChange: (open: boolean) => void;
+  onApply: (choice: ModelChoice) => void;
+  busy?: boolean;
+  note?: string;
+}) {
+  const options = useQuery({
+    queryKey: ["models", "options"],
+    queryFn: () => api.model.options(),
+    enabled: open,
+  });
+  const current = options.data?.current;
+  const currentLine = current?.model
+    ? `current: ${current.model}${current.provider ? ` · ${current.provider}` : ""}`
+    : "current: (unset)";
+  return (
+    <Modal
+      open={open}
+      onOpenChange={onOpenChange}
+      size="lg"
+      title="Switch model"
+      description={currentLine}
+    >
+      <PickerBody onApply={onApply} onCancel={() => onOpenChange(false)} busy={busy} note={note} />
+    </Modal>
+  );
+}
