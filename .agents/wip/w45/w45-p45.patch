+
+async def release_servers(scope: Scope, folder: str | Path) -> int:
+    """Stop ``scope``'s tier's servers rooted at or below ``folder`` (call before removing it);
+    how many stopped. Never raises."""
+    manager = _manager_for(scope)
+    if manager is None:
+        return 0
+    try:
