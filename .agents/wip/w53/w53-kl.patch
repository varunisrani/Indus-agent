+/* Webhooks overlay (W52-l, spec 3.11). */
+
+.wh-pad {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 20px;
+}
+
+.wh-detail {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.wh-section {
+  margin-top: 16px;
+}
+
+.wh-text {
+  margin: 0;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+}
+
+.wh-copy-row {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.wh-copy-label {
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-micro);
+}
+
+.wh-copy-box {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 4px 4px 8px;
+  border-radius: var(--desk-radius-control);
+  background: color-mix(in srgb, var(--desk-fg-1) 5%, transparent);
+}
+
+.wh-copy-box code {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  color: var(--desk-fg-1);
+  font-family: var(--indus-font-mono);
+  font-size: var(--desk-text-micro);
