-                            {t("manage.cron.resume")}
-                          </button>
-                        ) : (
-                          <button
-                            type="button"
-                            className="button button-secondary"
-                            onClick={() => void act(job, "pause")}
-                          >
-                            {t("manage.cron.pause")}
-                          </button>
-                        )}
-                        <button
-                          type="button"
-                          className="button button-secondary"
+          </>
+        }
+        search={{
+          label: t("cron.search"),
+          placeholder: t("cron.searchPlaceholder"),
+          value: query,
+          onChange: setQuery,
+        }}
+        listTop={
+          <label className="cron-all">
+            <input type="checkbox" checked={all} onChange={(e) => setAll(e.target.checked)} />
+            {t("manage.cron.allProfiles")}
+          </label>
+        }
+        add={{ label: t("cron.new"), onAdd: () => setDialog({ kind: "new" }) }}
+        listLabel={t("nav.cron")}
+        listEmpty={
+          data.jobs.length === 0 ? <p className="cron-list-empty">{t("cron.none")}</p> : undefined
+        }
+        list={shown.map((j) => (
+          <PanelRow
+            key={keyOf(j)}
+            title={j.name || j.id}
+            dot={j.state === "paused" || !j.enabled ? "off" : "on"}
+            selected={keyOf(j) === picked}
+            onSelect={() => setPicked(keyOf(j))}
+            data={{ "data-job": j.id }}
+            {...(all ? { meta: j.profile } : {})}
+            menu={{
+              label: t("cron.rowMenu", { name: j.name || j.id }),
+              items: [
+                {
+                  id: "edit",
+                  label: t("manage.cron.edit"),
+                  run: () => setDialog({ kind: "edit", job: j }),
+                },
+                {
+                  id: "delete",
+                  label: t("manage.delete"),
+                  tone: "danger",
+                  run: () => void act(j, "delete"),
+                },
+              ],
+            }}
+          />
+        ))}
+        listFooter={
+          plans.length > 0 ? (
+            <section className="cron-plans">
+              <h3 className="cron-plans-label">{t("cron.blueprints")}</h3>
+              <ul>
+                {plans.map((plan) => (
+                  <li key={plan.skill}>
+                    <button
+                      type="button"
+                      className="cron-plan"
+                      title={plan.description}
+                      onClick={() => setDialog({ kind: "new", blueprint: plan })}
+                    >
+                      <Rocket aria-hidden="true" size={12} />
+                      <span>{plan.skill}</span>
+                    </button>
+                  </li>
+                ))}
+              </ul>
+            </section>
+          ) : undefined
+        }
+        {...(job === null
+          ? {}
+          : {
+              detail: (
+                <div className="cron-detail">
+                  <DetailHead
+                    title={job.name || job.id}
+                    pills={<PanelPill tone={stateTone(job)}>{job.state}</PanelPill>}
+                    actions={
+                      <>
+                        <Button
+                          variant="ghost"
+                          size="sm"
+                          icon={
+                            paused ? (
+                              <Play aria-hidden="true" size={13} />
+                            ) : (
+                              <Pause aria-hidden="true" size={13} />
+                            )
+                          }
+                          onClick={() => void act(job, paused ? "resume" : "pause")}
+                        >
+                          {paused ? t("manage.cron.resume") : t("manage.cron.pause")}
+                        </Button>
+                        <Button
+                          variant="ghost"
+                          size="sm"
+                          icon={<Zap aria-hidden="true" size={13} />}
                           onClick={() => void act(job, "trigger")}
                         >
                           {t("manage.cron.runNow")}
-                        </button>
-                        <button
-                          type="button"
-                          className="button button-secondary"
-                          onClick={() => setEditing(job)}
+                        </Button>
+                        <Button
+                          variant="ghost"
+                          size="sm"
+                          icon={<Pencil aria-hidden="true" size={13} />}
+                          onClick={() => setDialog({ kind: "edit", job })}
                         >
                           {t("manage.cron.edit")}
-                        </button>
-                        <button
-                          type="button"
-                          className="button button-secondary"
-                          onClick={() => void act(job, "delete")}
-                        >
-                          {t("manage.delete")}
-                        </button>
-                      </span>
-                    </td>
-                  </tr>
-                ))}
-              </tbody>
-            </table>
-            {data.jobs.length === 0 && <p className="manage-muted">{t("manage.cron.none")}</p>}
-          </>
-        )}
-      </LoadState>
-    </ManageOverlay>
+                        </Button>
+                      </>
+                    }
+                  />
+                  <MetaGrid
+                    rows={[
+                      [t("cron.frequency"), job.schedule_display || job.schedule],
+                      [t("cron.nextRun"), when(job.next_run_at)],
+                      [t("manage.cron.lastRun"), when(job.last_run_at)],
+                      [t("manage.cron.deliver"), job.deliver || "—"],
+                      ...(all ? [[t("manage.cron.profile"), job.profile] as const] : []),
+                      ...(job.skills.length > 0
+                        ? [[t("cron.skills"), job.skills.join(", ")] as const]
+                        : []),
+                    ]}
+                  />
+                  <section className="cron-section">
+                    <CapsLabel>{t("manage.cron.prompt")}</CapsLabel>
+                    <PanelBlock>{job.prompt}</PanelBlock>
+                  </section>
+                  <section className="cron-section">
+                    <CapsLabel>{t("cron.runs")}</CapsLabel>
+                    {job.last_run_at === null ? (
+                      <p className="cron-note">{t("cron.noRuns")}</p>
+                    ) : (
+                      <div className="cron-run">
+                        <span>{when(job.last_run_at)}</span>
+                        {job.last_status !== null && (
+                          <PanelPill tone={job.last_error === null ? "good" : "bad"}>
+                            {job.last_status}
+                          </PanelPill>
+                        )}
+                        {job.last_error !== null && (
+                          <span className="cron-run-error">{job.last_error}</span>
+                        )}
+                      </div>
+                    )}
+                  </section>
+                </div>
+              ),
+            })}
+        empty={{
+          icon: <Watch aria-hidden="true" />,
+          title: t("cron.none"),
+          description: t("cron.emptyBody"),
+          action: newButton,
+        }}
+      />
+    );
+  }
+
+  return (
+    <OverlayCard
+      id="cron"
+      title={t("nav.cron")}
+      closeLabel={t("common.close")}
+      onClose={props.onClose}
+    >
+      {body}
+      {dialog !== null && (
+        <CronDialog
+          api={api}
+          profile={own}
+          {...(dialog.kind === "edit" ? { job: dialog.job } : {})}
+          {...(dialog.kind === "new" && dialog.blueprint !== undefined
+            ? { blueprint: dialog.blueprint }
+            : {})}
+          blueprints={plans}
+          targets={targets.state === "ok" ? targets.data.targets : []}
+          onDone={() => {
+            setDialog(null);
+            jobs.reload();
+          }}
+          onClose={() => setDialog(null)}
+        />
+      )}
+    </OverlayCard>
   );
 }
diff --git a/apps/desktop/src/app/cron/cron.css b/apps/desktop/src/app/cron/cron.css
new file mode 100644
index 0000000..78c95c1
--- /dev/null
+++ b/apps/desktop/src/app/cron/cron.css
@@ -0,0 +1,162 @@
+/* Scheduled jobs overlay and its dialog (W52-l, spec 3.6 / 3.7). */
+
+.cron-pad {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 20px;
+}
+
+.cron-all {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 24px;
+  padding: 0 8px;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-micro);
+}
+
+.cron-list-empty {
+  margin: 0;
+  padding: 10px 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+  text-align: center;
+}
+
+.cron-note {
+  margin: 0 0 8px;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.cron-plans {
+  margin-top: 12px;
+}
+
+.cron-plans-label {
+  margin: 0 0 4px;
+  padding: 0 8px;
+  color: var(--desk-fg-4);
+  font-size: 9.6px;
+  font-weight: 500;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.cron-plans ul {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.cron-plan {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  min-height: 28px;
+  padding: 0 8px;
+  border: 0;
+  border-radius: var(--desk-radius-card);
+  background: transparent;
+  color: var(--desk-fg-2);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+  text-align: left;
+  cursor: pointer;
+}
+
+.cron-plan > svg {
+  flex: none;
+  color: var(--desk-fg-4);
+}
+
+.cron-plan > span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.cron-plan:hover {
+  background: var(--desk-row-hover);
+}
+
+.cron-detail {
+  display: flex;
+  flex-direction: column;
+}
+
+.cron-section {
+  margin-top: 12px;
+}
+
+.cron-run {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+}
+
+.cron-run-error {
+  color: var(--desk-danger);
+}
+
+.cron-targets {
+  min-width: 0;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+.cron-target-box {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 8px 10px;
+  border: 1px solid var(--desk-stroke-field);
+  border-radius: var(--desk-radius-card);
+}
+
+.cron-target {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-ui);
+}
+
+.cron-target input {
+  width: 16px;
+  height: 16px;
+  accent-color: var(--desk-accent);
+}
+
+.cron-target[data-off="true"] {
+  color: var(--desk-fg-4);
+}
+
+.cron-summary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 8px 12px;
+  border-radius: var(--desk-radius-card);
+  background: var(--kit-summary);
+  font-size: var(--desk-text-small);
+}
+
+.cron-summary > span {
+  color: var(--desk-fg-1);
+  font-weight: 500;
+}
+
+.cron-summary > code {
+  color: var(--desk-fg-3);
+  font-family: var(--indus-font-mono);
+}
diff --git a/apps/desktop/src/app/kit.css b/apps/desktop/src/app/kit.css
new file mode 100644
index 0000000..8d9defe
--- /dev/null
+++ b/apps/desktop/src/app/kit.css
@@ -0,0 +1,675 @@
+/* The quiet controls of the pages (W52-k) and overlay panels (W52-l), one copy each (W53 merge).
+   Quiet: text actions, hairlines and soft fills. */
+
+:root {
+  --kit-ok: #00bc7d;
+  --kit-ok-soft: #d8f4eb;
+  --kit-ok-text: #00a676;
+  --kit-warn-rule: #c08532;
+  --kit-well-bg: #f0f2f8;
+  --kit-well-stroke: #ced9ef;
+  --kit-banner-bg: #f1f4fc;
+  --kit-banner-stroke: #a8c3fc;
+  --kit-track: #dfe6f4;
+  --kit-summary: #edeff5;
+  --kit-dialog-bg: #fbfbfb;
+  --kit-dialog-stroke: #d3ddf2;
+  --kit-elevated: #fdfdfd;
+}
+
+:root[data-theme="indus-dark"] {
+  --kit-ok-soft: #0b2a25;
+  --kit-ok-text: #00d492;
+  --kit-well-bg: #151a22;
+  --kit-well-stroke: #232d40;
+  --kit-banner-bg: #10141c;
+  --kit-banner-stroke: #213560;
+  --kit-track: #1b2331;
+  --kit-summary: #1c2029;
+  --kit-dialog-bg: #15171c;
+  --kit-dialog-stroke: #232d40;
+  --kit-elevated: #16181d;
+}
+
+/* -- text actions --------------------------------------------------------------------------- */
+
+.kit-text-action {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: var(--desk-text-micro);
+  font-weight: 500;
+  text-decoration: none;
+  text-underline-offset: 4px;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.kit-text-action:hover:not(:disabled) {
+  color: var(--desk-fg-1);
+  text-decoration: underline;
+}
+
+.kit-text-action[data-strong="true"] {
+  color: var(--desk-fg-1);
+  font-weight: 600;
+  text-decoration: underline;
+  text-decoration-color: color-mix(in srgb, var(--desk-fg-3) 30%, transparent);
+}
+
+.kit-text-action[data-tone="danger"] {
+  color: var(--desk-danger);
+}
+
+.kit-text-action:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
+/* -- captions and tabs ---------------------------------------------------------------------- */
+
+.kit-caps-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-height: 24px;
+  margin-bottom: 6px;
+}
+
+.kit-caps {
+  flex: 1;
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.kit-caps-aside {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+.kit-text-tabs {
+  display: inline-flex;
+  align-items: center;
+  gap: 10px;
+}
+
+.kit-text-tab {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 4px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: var(--desk-text-small);
+  font-weight: 500;
+  line-height: 28px;
+  cursor: pointer;
+}
+
+.kit-text-tab:hover {
+  color: var(--desk-fg-1);
+}
+
+.kit-text-tab[aria-selected="true"] {
+  color: var(--desk-fg-1);
+}
+
+/* the underline spans the label only, never the count */
+.kit-text-tab[aria-selected="true"] .kit-tab-label {
+  text-decoration: underline;
+  text-decoration-color: color-mix(in srgb, currentColor 25%, transparent);
+  text-underline-offset: 4px;
+}
+
+/* page look: the 13px tab row centred in a page header, 1px solid underline */
+.kit-text-tabs[data-look="page"] {
+  gap: 16px;
+}
+
+.kit-text-tabs[data-look="page"] .kit-text-tab {
+  align-items: flex-start;
+  gap: 2px;
+  height: auto;
+  padding: 2px 0 4px;
+  font-size: 13px;
+  font-weight: 400;
+  line-height: normal;
+}
+
+.kit-text-tabs[data-look="page"] .kit-text-tab[aria-selected="true"] .kit-tab-label {
+  text-decoration-color: currentColor;
+  text-decoration-thickness: 1px;
+  text-underline-offset: 5px;
+}
+
+.kit-tab-count {
+  position: relative;
+  top: -2px;
+  color: var(--desk-fg-4);
+  font-size: 9px;
+  font-variant-numeric: tabular-nums;
+  line-height: 1;
+  vertical-align: baseline;
+}
+
+.kit-tab-count-loading {
+  display: inline-block;
+  width: 10px;
+  height: 5px;
+  border-radius: 2px;
+  background: var(--desk-bg-pill);
+}
+
+.kit-quiet-search {
+  min-height: 28px;
+  padding: 0;
+}
+
+.kit-quiet-search[data-fill="true"] {
+  width: 100%;
+}
+
+.kit-quiet-search input::placeholder {
+  color: color-mix(in srgb, var(--desk-fg-4) 60%, transparent);
+}
+
+/* -- stat tile ------------------------------------------------------------------------------ */
+
+.kit-stat {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.kit-stat-label {
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.kit-stat-value {
+  color: var(--desk-fg-1);
+  font-size: 16px;
+  font-weight: 600;
+  line-height: 1.1;
+  font-variant-numeric: tabular-nums;
+}
+
+.kit-stat-hint {
+  color: var(--desk-fg-3);
+  font-size: 10px;
+}
+
+/* -- log well ------------------------------------------------------------------------------- */
+
+.kit-log {
+  position: relative;
+  display: flex;
+  flex: 1;
+  min-height: 0;
+  border: 1px solid var(--kit-well-stroke);
+  border-radius: 8px;
+  background: var(--kit-well-bg);
+}
+
+.kit-log-scroll {
+  flex: 1;
+  min-height: 0;
+  overflow: auto;
+  padding: 10px 12px 10px 14px;
+}
+
+.kit-log[data-compact="true"] {
+  flex: none;
+  max-height: 192px;
+}
+
+.kit-log-lines,
+.kit-log-empty {
+  margin: 0;
+  color: var(--desk-fg-1);
+  font-family: var(--indus-font-mono, ui-monospace, monospace);
+  font-size: 11.2px;
+  line-height: 18px;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+
+.kit-log[data-compact="true"] .kit-log-lines {
+  font-size: 10.4px;
+}
+
+.kit-log-empty {
+  color: var(--desk-fg-3);
+}
+
+.kit-log-line {
+  position: relative;
+}
+
+.kit-log-line[data-level]::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: -6px;
+  width: 2px;
+  background: var(--kit-warn-rule);
+}
+
+.kit-log-line[data-level="error"]::before {
+  background: var(--desk-danger);
+}
+
+.kit-log-tools {
+  position: absolute;
+  top: 6px;
+  right: 6px;
+  display: flex;
+  gap: 2px;
+  opacity: 0;
+  transition: opacity var(--indus-duration-quick) var(--indus-easing-standard);
+}
+
+.kit-log:hover .kit-log-tools,
+.kit-log:focus-within .kit-log-tools {
+  opacity: 1;
+}
+
+/* -- list rows ------------------------------------------------------------------------------ */
+
+.kit-row {
+  position: relative;
+  display: flex;
+  align-items: center;
+  border-radius: var(--desk-radius-card);
+}
+
+.kit-row:hover {
+  background: var(--desk-row-hover);
+}
+
+.kit-row[data-selected="true"] {
+  background: var(--desk-row-active);
+}
+
+.kit-row-main {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  flex: 1;
+  min-width: 0;
+  min-height: 28px;
+  padding: 0 8px;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-2);
+  font: inherit;
+  font-size: 12.5px;
+  font-weight: 500;
+  text-align: left;
+  cursor: pointer;
+}
+
+.kit-row[data-selected="true"] .kit-row-main {
+  color: var(--desk-fg-1);
+}
+
+.kit-row-icon {
+  display: inline-flex;
+  flex: none;
+  color: var(--desk-fg-4);
+}
+
+.kit-row-icon > svg {
+  width: 14px;
+  height: 14px;
+}
+
+.kit-row-title {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.kit-row-meta {
+  flex: none;
+  color: var(--desk-fg-4);
+  font-size: 10px;
+  font-weight: 400;
+}
+
+.kit-row-menu {
+  display: inline-flex;
+  margin-right: 4px;
+  opacity: 0;
+}
+
+.kit-row:hover .kit-row-menu,
+.kit-row:focus-within .kit-row-menu {
+  opacity: 1;
+}
+
+.kit-row-menu .desk-icon-btn {
+  width: 20px;
+  height: 20px;
+}
+
+.kit-dot {
+  flex: none;
+  width: 6px;
+  height: 6px;
+  border-radius: 50%;
+  background: var(--desk-fg-4);
+}
+
+.kit-dot[data-state="on"] {
+  background: var(--kit-ok);
+}
+
+/* -- pills, meta, block, detail head ------------------------------------------------------- */
+
+.kit-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 2px 6px;
+  border-radius: 999px;
+  background: var(--desk-bg-pill);
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  font-weight: 500;
+  line-height: 12px;
+  white-space: nowrap;
+}
+
+.kit-pill[data-tone="category"] {
+  background: color-mix(in srgb, var(--desk-fg-3) 16%, var(--desk-bg-canvas));
+}
+
+.kit-pill[data-tone="accent"] {
+  background: color-mix(in srgb, var(--desk-accent) 20%, var(--desk-bg-canvas));
+  color: var(--desk-accent);
+}
+
+.kit-pill[data-tone="info"] {
+  background: var(--desk-accent-soft);
+  color: var(--desk-accent);
+}
+
+.kit-pill[data-tone="good"] {
+  background: var(--kit-ok-soft);
+  color: var(--kit-ok-text);
+}
+
+.kit-pill-dot {
+  width: 5px;
+  height: 5px;
+  border-radius: 50%;
+  background: currentcolor;
+}
+
+.kit-pill[data-tone="warn"] {
+  background: color-mix(in srgb, var(--desk-warning) 10%, transparent);
+  color: var(--desk-warning);
+}
+
+.kit-pill[data-tone="bad"] {
+  background: color-mix(in srgb, var(--desk-danger) 10%, transparent);
+  color: var(--desk-danger);
+}
+
+.kit-meta {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0 0 16px;
+  font-size: var(--desk-text-micro);
+}
+
+.kit-meta-row {
+  display: grid;
+  grid-template-columns: 80px minmax(0, 1fr);
+  gap: 8px;
+}
+
+.kit-meta-row dt {
+  color: var(--desk-fg-4);
+}
+
+.kit-meta-row dd {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  margin: 0;
+  color: var(--desk-fg-2);
+  overflow-wrap: anywhere;
+}
+
+/* framed: the inset box of a detail column (skill and connector facts) */
+.kit-meta[data-framed="true"] {
+  gap: 2px;
+  margin: 0;
+  padding: 12px;
+  border: 1px solid var(--kit-well-stroke);
+  border-radius: 8px;
+  background: var(--kit-well-bg);
+  font-size: 11px;
+  line-height: 16px;
+}
+
+.kit-meta[data-framed="true"] .kit-meta-row {
+  grid-template-columns: 96px minmax(0, 1fr);
+}
+
+.kit-meta[data-framed="true"] .kit-meta-row dt {
+  color: var(--desk-fg-3);
+  font-weight: 500;
+}
+
+.kit-block {
+  max-height: 192px;
+  overflow: auto;
+  padding: 10px;
+  border-radius: var(--desk-radius-control);
+  background: color-mix(in srgb, var(--desk-fg-1) 5%, transparent);
+  color: color-mix(in srgb, var(--desk-fg-1) 80%, transparent);
+  font-size: var(--desk-text-micro);
+  line-height: 1.5;
+  white-space: pre-wrap;
+}
+
+.kit-detail-head {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  margin-bottom: 14px;
+}
+
+.kit-detail-leading {
+  display: inline-flex;
+  flex: none;
+  margin-top: -2px;
+}
+
+.kit-detail-titles {
+  flex: 1;
+  min-width: 0;
+}
+
+.kit-detail-title {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+  color: var(--desk-fg-1);
+  font-size: 15px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+}
+
+.kit-detail-description {
+  margin: 4px 0 0;
+  color: var(--desk-fg-3);
+  font-size: 12px;
+  line-height: 1.45;
+}
+
+.kit-detail-actions {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+/* -- banner, error, fields ----------------------------------------------------------------- */
+
+.kit-banner {
+  display: flex;
+  gap: 12px;
+  margin-bottom: 16px;
+  padding: 16px;
+  border: 1px solid var(--kit-banner-stroke);
+  border-radius: var(--desk-radius-control);
+  background: var(--kit-banner-bg);
+}
+
+.kit-banner-icon {
+  display: inline-flex;
+  color: var(--desk-accent);
+}
+
+.kit-banner-icon > svg {
+  width: 16px;
+  height: 16px;
+}
+
+.kit-banner-body {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  min-width: 0;
+}
+
+.kit-banner-title {
+  margin: 0;
+  color: var(--desk-fg-1);
+  font-size: 14px;
+  font-weight: 500;
+}
+
+.kit-banner-text {
+  color: var(--desk-fg-3);
+  font-size: 14px;
+  line-height: 1.45;
+}
+
+.kit-banner-text p {
+  margin: 0;
+}
+
+.kit-banner-action {
+  margin-top: 8px;
+}
+
+.kit-error {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+  padding: 6px 8px;
+  border-radius: var(--desk-radius-control);
+  background: color-mix(in srgb, var(--desk-danger) 10%, transparent);
+  color: var(--desk-danger);
+  font-size: var(--desk-text-small);
+}
+
+.kit-error > svg {
+  flex: none;
+}
+
+.kit-field {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-width: 0;
+}
+
+.kit-field-label {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-ui);
+  font-weight: 500;
+}
+
+.kit-field-hint {
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-micro);
+  font-weight: 400;
+}
+
+.kit-field-help {
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.kit-field input:not([type="checkbox"]),
+.kit-field select,
+.kit-field textarea {
+  min-height: 36px;
+  padding: 6px 10px;
+  border: 1px solid var(--desk-stroke-field);
+  border-radius: var(--desk-radius-card);
+  background: var(--desk-bg-canvas);
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+}
+
+.kit-field textarea {
+  min-height: 96px;
+  resize: vertical;
+}
+
+.kit-field input:focus-visible,
+.kit-field select:focus-visible,
+.kit-field textarea:focus-visible {
+  outline: none;
+  border-color: var(--desk-accent);
+}
+
+.kit-field .kit-mono,
+.kit-field textarea.kit-mono::placeholder {
+  font-family: var(--indus-font-mono, ui-monospace, monospace);
+  font-size: 12.5px;
+}
+
+.kit-two-cols {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 16px;
+}
+
+/* the 512px form dialogs sit on the dialog surface */
+.desk-dialog[data-size="wide"] {
+  border-color: var(--kit-dialog-stroke);
+  border-radius: 8px;
+  background: var(--kit-dialog-bg);
+}
diff --git a/apps/desktop/src/app/kit.tsx b/apps/desktop/src/app/kit.tsx
new file mode 100644
index 0000000..07a0de1
--- /dev/null
+++ b/apps/desktop/src/app/kit.tsx
@@ -0,0 +1,366 @@
+// The quiet controls shared by the app's pages (W52-k list-and-detail frame) and its overlay
+// panels (W52-l): text actions, text tabs, the borderless search, uppercase captions, stat tiles,
+// a log well that keeps to the bottom, list rows with a hover menu, definition rows, pills, a
+// prompt block, a detail title row, a banner and dialog fields. One copy of each (W53 merge).
+// Styles in kit.css on the `--desk-*` tokens.
+
+import { AlertCircle, ArrowDownToLine, ArrowUpToLine, Copy, Ellipsis, Search } from "lucide-react";
+import { type ReactNode, useLayoutEffect, useRef } from "react";
+import { IconButton, Menu, type MenuItem } from "../ui/components.tsx";
+import "./kit.css";
+
+/** A quiet text action: 11px, underlined on hover; `strong` is semibold and always underlined. */
+export function TextAction(props: {
+  children: ReactNode;
+  onClick: () => void;
+  strong?: boolean;
+  tone?: "danger";
+  disabled?: boolean;
+  /** Tooltip (e.g. why it is disabled). */
+  title?: string;
+}) {
+  return (
+    <button
+      type="button"
+      className="kit-text-action"
+      data-strong={props.strong ? "true" : undefined}
+      data-tone={props.tone}
+      disabled={props.disabled}
+      title={props.title}
+      onClick={props.onClick}
+    >
+      {props.children}
+    </button>
+  );
+}
+
+/** An uppercase caption over a section ("RECENT LOGS", "DIAGNOSTICS"). */
+export function CapsLabel(props: { children: ReactNode; aside?: ReactNode; id?: string }) {
+  return (
+    <div className="kit-caps-row">
+      <h3 className="kit-caps" id={props.id}>
+        {props.children}
+      </h3>
+      {props.aside !== undefined && <div className="kit-caps-aside">{props.aside}</div>}
+    </div>
+  );
+}
+
+export interface TextTabOption<T extends string> {
+  readonly value: T;
+  readonly label: string;
+  /** A small raised count after the label; null = still loading (a tiny bar). */
+  readonly count?: number | null | undefined;
+}
+
+/**
+ * Plain text tabs with an underline on the current one and an optional raised count. `page`: the
+ * 13px row centred in a page header (Capabilities, Artifacts); the default is the 12px panel row.
+ */
+export function TextTabs<T extends string>(props: {
+  label: string;
+  value: T;
+  options: ReadonlyArray<TextTabOption<T>>;
+  onChange: (value: T) => void;
+  look?: "page";
+}) {
+  return (
+    <div className="kit-text-tabs" data-look={props.look} role="tablist" aria-label={props.label}>
+      {props.options.map((option) => (
+        <button
+          key={option.value}
+          type="button"
+          role="tab"
+          aria-selected={option.value === props.value}
+          className="kit-text-tab"
+          onClick={() => props.onChange(option.value)}
+        >
+          <span className="kit-tab-label">{option.label}</span>
+          {option.count === null ? (
+            <span className="kit-tab-count kit-tab-count-loading" aria-hidden="true" />
+          ) : option.count !== undefined ? (
+            <sup className="kit-tab-count">{option.count}</sup>
+          ) : null}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+/** The borderless search field with a magnifier (page header, list column, log filter). `fill`
+ * stretches it over its cell; `width` fixes it. */
+export function QuietSearch(props: {
+  label: string;
+  placeholder?: string;
+  value: string;
+  onChange: (value: string) => void;
+  width?: number;
+  fill?: boolean;
+  className?: string;
+}) {
+  return (
+    <label
+      className={`desk-search kit-quiet-search${props.className === undefined ? "" : ` ${props.className}`}`}
+      data-fill={props.fill ? "true" : undefined}
+      style={props.width === undefined ? undefined : { width: props.width }}
+    >
+      <Search aria-hidden="true" size={14} />
+      <input
+        type="search"
+        aria-label={props.label}
+        placeholder={props.placeholder ?? props.label}
+        value={props.value}
+        onChange={(event) => props.onChange(event.currentTarget.value)}
+      />
+    </label>
+  );
+}
+
+/** A label over a big number, with an optional hint line. */
+export function StatTile(props: { label: string; value: ReactNode; hint?: ReactNode }) {
+  return (
+    <div className="kit-stat">
+      <span className="kit-stat-label">{props.label}</span>
+      <span className="kit-stat-value">{props.value}</span>
+      {props.hint !== undefined && <span className="kit-stat-hint">{props.hint}</span>}
+    </div>
+  );
+}
+
+function levelOf(line: string): "warn" | "error" | undefined {
+  if (/\b(ERROR|CRITICAL)\b/.test(line)) return "error";
+  if (/\b(WARNING|WARN)\b/.test(line)) return "warn";
+  return undefined;
+}
+
+/** A tinted mono well of log lines that stays at the bottom unless the reader scrolled up;
+ * warning and error lines carry a coloured rule in the gutter. */
+export function LogTail(props: {
+  lines: readonly string[];
+  emptyText: string;
+  labels: { top: string; bottom: string; copy: string };
+  onCopy?: (text: string) => void;
+  testId?: string;
+  compact?: boolean;
+}) {
+  const box = useRef<HTMLDivElement>(null);
+  const pinned = useRef(true);
+  // biome-ignore lint/correctness/useExhaustiveDependencies: scroll again when the lines change
+  useLayoutEffect(() => {
+    const el = box.current;
+    if (el !== null && pinned.current) el.scrollTop = el.scrollHeight;
+  }, [props.lines]);
+  const text = props.lines.join("\n");
+  return (
+    <div className="kit-log" data-compact={props.compact ? "true" : undefined}>
+      <div
+        className="kit-log-scroll"
+        ref={box}
+        onScroll={(event) => {
+          const el = event.currentTarget;
+          pinned.current = el.scrollHeight - el.scrollTop - el.clientHeight < 24;
+        }}
+      >
+        {props.lines.length === 0 ? (
+          <p className="kit-log-empty">{props.emptyText}</p>
+        ) : (
+          <pre className="kit-log-lines" data-testid={props.testId}>
+            {props.lines.map((line, index) => (
+              // biome-ignore lint/suspicious/noArrayIndexKey: log lines repeat; order is identity
+              <span key={index} className="kit-log-line" data-level={levelOf(line)}>
+                {line}
+                {index < props.lines.length - 1 ? "\n" : ""}
+              </span>
+            ))}
+          </pre>
+        )}
+      </div>
+      {props.lines.length > 0 && (
+        <div className="kit-log-tools">
+          <IconButton
+            label={props.labels.top}
+            icon={<ArrowUpToLine aria-hidden="true" size={14} />}
+            onClick={() => {
+              pinned.current = false;
+              box.current?.scrollTo({ top: 0 });
+            }}
+          />
+          <IconButton
+            label={props.labels.bottom}
+            icon={<ArrowDownToLine aria-hidden="true" size={14} />}
+            onClick={() => {
+              pinned.current = true;
+              const el = box.current;
+              if (el !== null) el.scrollTop = el.scrollHeight;
+            }}
+          />
+          {props.onCopy !== undefined && (
+            <IconButton
+              label={props.labels.copy}
+              icon={<Copy aria-hidden="true" size={14} />}
+              onClick={() => props.onCopy?.(text)}
+            />
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
+
+/** One row of a panel list: leading icon or status dot, title, quiet meta, hover "…" menu. */
+export function PanelRow(props: {
+  title: ReactNode;
+  icon?: ReactNode;
+  dot?: "on" | "off";
+  meta?: ReactNode;
+  selected?: boolean;
+  onSelect: () => void;
+  menu?: { label: string; items: readonly MenuItem[] };
+  /** Extra `data-*` for tests. */
+  data?: Readonly<Record<`data-${string}`, string>>;
+}) {
+  return (
+    <li className="kit-row" data-selected={props.selected ? "true" : undefined} {...props.data}>
+      <button
+        type="button"
+        className="kit-row-main"
+        aria-current={props.selected ? "true" : undefined}
+        onClick={props.onSelect}
+      >
+        {props.dot !== undefined && (
+          <span className="kit-dot" data-state={props.dot} aria-hidden="true" />
+        )}
+        {props.icon !== undefined && <span className="kit-row-icon">{props.icon}</span>}
+        <span className="kit-row-title">{props.title}</span>
+        {props.meta !== undefined && <span className="kit-row-meta">{props.meta}</span>}
+      </button>
+      {props.menu !== undefined && props.menu.items.length > 0 && (
+        <span className="kit-row-menu">
+          <Menu
+            label={props.menu.label}
+            trigger={<Ellipsis aria-hidden="true" size={14} />}
+            items={props.menu.items}
+            align="end"
+          />
+        </span>
+      )}
+    </li>
+  );
+}
+
+export type PillTone = "muted" | "category" | "accent" | "info" | "good" | "warn" | "bad";
+
+/**
+ * A small rounded tag. `muted` grey, `category` a deeper grey, `accent` the strong primary tint
+ * ("In use"), `info` the soft primary tint ("Default"), `good` green, `warn` amber, `bad` red;
+ * `dot` puts a status dot before the label.
+ */
+export function PanelPill(props: { children: ReactNode; tone?: PillTone; dot?: boolean }) {
+  return (
+    <span className="kit-pill" data-tone={props.tone ?? "muted"}>
+      {props.dot && <span className="kit-pill-dot" aria-hidden="true" />}
+      {props.children}
+    </span>
+  );
+}
+
+/** Two-column definition rows (80px label); `framed`: in an inset box (96px label). */
+export function MetaGrid(props: {
+  rows: ReadonlyArray<readonly [string, ReactNode]>;
+  framed?: boolean;
+}) {
+  return (
+    <dl className="kit-meta" data-framed={props.framed ? "true" : undefined}>
+      {props.rows.map(([label, value]) => (
+        <div key={label} className="kit-meta-row">
+          <dt>{label}</dt>
+          <dd>{value}</dd>
+        </div>
+      ))}
+    </dl>
+  );
+}
+
+/** A quiet pre-wrapped block (a prompt preview). */
+export function PanelBlock(props: { children: ReactNode }) {
+  return <div className="kit-block">{props.children}</div>;
+}
+
+/** The detail column's title row: optional leading tile, name, pills, actions on the right,
+ * then an optional one-line description and anything `below`. `level` 2 on a page with no title. */
+export function DetailHead(props: {
+  title: ReactNode;
+  pills?: ReactNode;
+  actions?: ReactNode;
+  below?: ReactNode;
+  leading?: ReactNode;
+  description?: ReactNode;
+  level?: 2 | 3;
+}) {
+  const Heading = props.level === 2 ? "h2" : "h3";
+  return (
+    <header className="kit-detail-head">
+      {props.leading !== undefined && <span className="kit-detail-leading">{props.leading}</span>}
+      <div className="kit-detail-titles">
+        <Heading className="kit-detail-title">
+          {props.title}
+          {props.pills}
+        </Heading>
+        {props.description !== undefined && props.description !== "" && (
+          <p className="kit-detail-description">{props.description}</p>
+        )}
+        {props.below}
+      </div>
+      {props.actions !== undefined && <div className="kit-detail-actions">{props.actions}</div>}
+    </header>
+  );
+}
+
+/** A tinted, bordered banner with an icon, a title, a body and an action. */
+export function Banner(props: {
+  icon: ReactNode;
+  title: ReactNode;
+  children?: ReactNode;
+  action?: ReactNode;
+}) {
+  return (
+    <section className="kit-banner" role="status">
+      <span className="kit-banner-icon">{props.icon}</span>
+      <div className="kit-banner-body">
+        <p className="kit-banner-title">{props.title}</p>
+        {props.children !== undefined && <div className="kit-banner-text">{props.children}</div>}
+        {props.action !== undefined && <div className="kit-banner-action">{props.action}</div>}
+      </div>
+    </section>
+  );
+}
+
+/** An inline error line (alert icon, danger text on a faint danger fill). */
+export function InlineError(props: { children: ReactNode }) {
+  return (
+    <p className="kit-error" role="alert">
+      <AlertCircle aria-hidden="true" size={14} />
+      <span>{props.children}</span>
+    </p>
+  );
+}
+
+/** A dialog field: label (+ an optional quiet hint), then the control. */
+export function Field(props: {
+  label: string;
+  hint?: string;
+  htmlFor?: string;
+  children: ReactNode;
+  help?: ReactNode;
+}) {
+  return (
+    <div className="kit-field">
+      <label className="kit-field-label" htmlFor={props.htmlFor}>
+        {props.label}
+        {props.hint !== undefined && <span className="kit-field-hint">{props.hint}</span>}
+      </label>
+      {props.children}
+      {props.help !== undefined && <p className="kit-field-help">{props.help}</p>}
+    </div>
+  );
+}
