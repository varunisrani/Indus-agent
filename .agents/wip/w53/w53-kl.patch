+.cc-card .desk-overlay-head {
+  min-height: 0;
+  padding: 22px clamp(20px, 4vw, 64px) 0;
+}
+
+.cc-card .desk-overlay-body {
+  display: flex;
+  flex-direction: column;
+  padding: 12px clamp(20px, 4vw, 64px) 0;
+}
+
+.cc-head {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  width: 100%;
+  min-height: 24px;
+}
+
+.cc-head .desk-breadcrumb {
+  flex: 1;
+  font-size: var(--desk-text-small);
+}
+
+.cc-head-aside {
+  display: flex;
+  justify-content: flex-end;
+  max-width: 40vw;
+}
+
+.cc-head-aside .kit-quiet-search {
+  width: 220px;
+}
+
+.cc-head .desk-segmented {
+  background: var(--kit-track);
+}
+
+.cc-head .desk-segment {
+  font-size: var(--desk-text-micro);
+  font-weight: 500;
+}
+
+.cc-center {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8px;
+  padding: 48px 0;
+}
+
+.cc-empty-line {
+  display: grid;
+  place-items: center;
+  min-height: 192px;
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.cc-empty-line.cc-left {
+  display: block;
+  min-height: 0;
+}
+
+/* -- sessions ------------------------------------------------------------------------------- */
+
+.cc-sessions {
+  padding-bottom: 24px;
+}
+
+.cc-session-list {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.cc-session {
+  position: relative;
+  display: flex;
+  align-items: center;
+  border-radius: var(--desk-radius-card);
+}
+
+.cc-session:hover {
+  background: var(--desk-row-hover);
+}
+
+.cc-session-main {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+  padding: 8px 8px 8px 0;
+  border: 0;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.cc-session:hover .cc-session-main {
+  padding-left: 8px;
+  margin-left: 0;
+}
+
+.cc-session-title {
+  overflow: hidden;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-ui);
+  font-weight: 500;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.cc-session-date {
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.cc-session-actions {
+  display: flex;
+  gap: 2px;
+  padding-right: 6px;
+  opacity: 0;
+  transition: opacity var(--indus-duration-quick) var(--indus-easing-standard);
+}
+
+.cc-session:hover .cc-session-actions,
+.cc-session:focus-within .cc-session-actions {
+  opacity: 1;
+}
+
+.cc-danger-icon:hover:not(:disabled) {
+  color: var(--desk-danger);
+}
+
+.cc-more {
+  display: flex;
+  justify-content: flex-end;
+  padding-top: 8px;
+}
+
+/* -- system --------------------------------------------------------------------------------- */
+
+.cc-system {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 28px;
+  min-height: 0;
+}
+
+.cc-status {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding-top: 11px;
+}
+
+.cc-status-line {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.cc-status-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--desk-warning);
+}
+
+.cc-status-dot[data-running="true"] {
+  background: var(--kit-ok);
+}
+
+.cc-status-label {
+  flex: 1;
+  color: var(--desk-fg-1);
