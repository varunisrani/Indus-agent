+                          })}
+                          checked={row.desktop.enabled}
+                          {...(props.onDesktopToggle === undefined
+                            ? { disabled: true, title: t("plugins.desktopReadOnly") }
+                            : {})}
+                          onChange={(on) => {
+                            if (row.desktop !== null) props.onDesktopToggle?.(row.desktop.id, on);
+                          }}
+                        />
+                      )}
+                    </td>
+                    <td className="cap-col">
+                      {row.agent === null ? (
+                        dash
