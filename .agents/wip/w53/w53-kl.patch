+/* The list-and-detail frame (W52-k), on the desk tokens. */
+
+.md-page {
+  display: flex;
+  flex-direction: column;
+  height: 100%;
+  min-height: 0;
+  background: var(--desk-bg-canvas);
+  color: var(--desk-fg-1);
+  font-family: var(--desk-font-ui);
+}
+
+/* -- header ---------------------------------------------------------------------------------- */
+
+.md-header {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  align-items: center;
+  gap: 12px;
+  min-height: 28px;
+  padding: 8px 12px;
+  flex: none;
+}
+
+.md-header-start {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  max-width: 45vw;
+}
+
+.md-header-centre {
+  display: flex;
+  justify-content: center;
+}
+
+.md-header-end {
+  display: flex;
+  justify-content: flex-end;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.md-scope {
+  max-width: 160px;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: 12px;
+}
+
+/* -- frame ----------------------------------------------------------------------------------- */
+
+.md-frame {
+  display: grid;
+  flex: 1;
+  min-height: 0;
+}
+
+.md-list {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  padding: 8px;
+  overflow-y: auto;
+  scrollbar-gutter: stable;
+}
+
+.md-list > ul {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.md-detail-wrap {
+  position: relative;
+  display: flex;
+  min-width: 0;
+  min-height: 0;
+}
+
+.md-sash {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: -2px;
+  z-index: 2;
+  width: 4px;
+  cursor: col-resize;
+}
+
+.md-sash:hover,
+.md-frame[data-dragging="true"] .md-sash {
+  background:
+    linear-gradient(var(--desk-stroke-card), var(--desk-stroke-card)) center / 1px 100% no-repeat;
