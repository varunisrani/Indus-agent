+++ b/apps/desktop/src/settings/pagesB/gateways.tsx
@@ -0,0 +1,290 @@
+// Settings › Gateways (W52-j): This window (connection mode cards, the remote form, the keychain
+// switch, diagnostics) and Remote updates (an empty state: a remote is updated where it runs).
+
+import { Check, FileText, Globe, Monitor, SquareTerminal } from "lucide-react";
+import { type ReactNode, useCallback, useEffect, useState } from "react";
+import type { IndusRemoteTestResult, IndusSecretsPolicyView } from "../../global.d.ts";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { useSwitcher } from "../../profiles/switcherReact.tsx";
+import { attempt, useSettings } from "../context.tsx";
+import {
+  OutlineButton,
+  PageBody,
+  PrimaryButton,
+  SettingRow,
+  SettingsEmpty,
+  Switch,
+  TextButton,
+} from "../primitives.tsx";
+import { Note, notAvailable, SecretInput } from "./kit.tsx";
+
+const LEG_KEYS: Readonly<Record<IndusRemoteTestResult["http"], MessageKey>> = {
+  ok: "settings.remote.leg.ok",
+  unauthorized: "settings.remote.leg.unauthorized",
+  unreachable: "settings.remote.leg.unreachable",
+  error: "settings.remote.leg.error",
+};
+
+type Mode = "local" | "remote";
+
+function ModeCard(props: {
+  icon: ReactNode;
+  title: string;
+  body: string;
+  selected: boolean;
+  onClick: () => void;
+}) {
+  return (
+    // biome-ignore lint/a11y/useSemanticElements: a card-sized radio, not a native radio
+    <button
+      type="button"
+      role="radio"
+      aria-checked={props.selected}
+      aria-label={props.title}
+      className="sb-mode"
+      data-selected={props.selected ? "true" : undefined}
+      onClick={props.onClick}
+    >
+      <span className="sb-mode-title">
+        {props.icon}
+        {props.title}
+      </span>
+      <span className="sb-mode-body">{props.body}</span>
+      {props.selected && <Check aria-hidden="true" size={14} className="sb-mode-check" />}
+    </button>
+  );
+}
+
+function StorageRow() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const secrets = bridge?.secrets;
+  const [policy, setPolicy] = useState<IndusSecretsPolicyView | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  useEffect(() => {
+    void attempt(secrets ? () => secrets.getPolicy() : null).then((answer) => {
+      if (answer.ok) setPolicy(answer.value);
+      else setError(answer.code);
+    });
+  }, [secrets]);
+  return (
+    <SettingRow
+      rowId="secure-storage"
+      highlighted={focusRow === "secure-storage"}
+      title={t("settings.storage.title")}
+      description={
+        <>
+          {t("settings.storage.body")}
+          {policy !== null && !policy.keychainUsable && (
+            <span className="sb-status" data-error="true">
+              {t("settings.storage.unusable", { reason: policy.reason })}
+            </span>
+          )}
+        </>
+      }
+      control={
+        <>
+          <Switch
+            label={t("settings.storage.title")}
+            checked={policy?.store === "keychain"}
+            disabled={policy === null || (!policy.keychainUsable && policy.store === "file")}
+            onChange={async (checked) => {
+              const answer = await attempt(
+                secrets ? () => secrets.setPolicy({ store: checked ? "keychain" : "file" }) : null,
+              );
+              if (answer.ok) setPolicy(answer.value);
+              else setError(answer.code);
+            }}
+          />
+          <Note text={notAvailable(t, error)} error />
+        </>
+      }
+    />
+  );
+}
+
+export function ThisWindowPage() {
+  const t = useT();
+  const { bridge, go, focusRow } = useSettings();
+  const connection = bridge?.connection;
+  const switcher = useSwitcher();
+  /** A saved or forgotten remote changes the connection: a soft re-home (P20-26, R08.6). */
+  const rehome = async <T,>(change: () => Promise<T>): Promise<T> => {
+    if (switcher === null) return change();
+    let result: { value: T } | null = null;
+    const outcome = await switcher.applyConnectionChange(async () => {
+      result = { value: await change() };
+    });
+    if (result === null) throw new Error(outcome.ok ? "no answer" : outcome.error);
+    return (result as { value: T }).value;
+  };
+  const [mode, setMode] = useState<Mode | null>(null);
+  const [chosen, setChosen] = useState<Mode | null>(null);
+  const [saved, setSaved] = useState<{ url: string | null; hasToken: boolean } | null>(null);
+  const [url, setUrl] = useState("");
+  const [token, setToken] = useState("");
+  const [result, setResult] = useState<IndusRemoteTestResult | null>(null);
+  const [note, setNote] = useState<{ text: string; error: boolean } | null>(null);
+  const load = useCallback(() => {
+    void attempt(connection ? () => connection.get() : null).then((answer) => {
+      if (answer.ok) setMode(answer.value.mode === "remote" ? "remote" : "local");
+    });
+    void attempt(connection ? () => connection.getRemote() : null).then((answer) => {
+      if (answer.ok) {
+        setSaved(answer.value);
+        setUrl(answer.value.url ?? "");
+      } else setNote({ text: notAvailable(t, answer.code) ?? "", error: true });
+    });
+  }, [connection, t]);
+  useEffect(load, [load]);
+  const selected = chosen ?? mode ?? "local";
+  const legText = (leg: IndusRemoteTestResult["http"]) => t(LEG_KEYS[leg]);
+  const logs = bridge?.logs;
+
+  const saveRemote = async () => {
+    const answer = await attempt(
+      connection ? () => rehome(() => connection.saveRemote({ url: url.trim(), token })) : null,
+    );
+    if (!answer.ok) {
+      setNote({ text: answer.message, error: true });
+      return;
+    }
+    setResult(answer.value);
+    if (answer.value.saved) {
+      setToken(""); // the token leaves the renderer
+      setNote({ text: t("settings.remote.saved"), error: false });
+      setChosen(null);
+      load();
+    } else setNote({ text: answer.value.message ?? t("settings.remote.notSaved"), error: true });
+  };
+  const forgetRemote = async () => {
+    const answer = await attempt(connection ? () => rehome(() => connection.forgetRemote()) : null);
+    if (answer.ok) {
+      setNote({ text: t("settings.remote.forgotten"), error: false });
+      setUrl("");
+      setChosen(null);
+      load();
+    } else setNote({ text: answer.message, error: true });
+  };
+  const canSave =
+    selected === "remote"
+      ? url.trim() !== "" && token !== ""
+      : saved?.url !== null && saved !== null;
+
+  return (
+    <PageBody>
+      <div
+        data-row="connection-mode"
+        data-highlighted={focusRow === "connection-mode" ? "true" : undefined}
+      >
+        <p className="sb-caption">{t("settings.gateway2.mode")}</p>
+        <div className="sb-modes" role="radiogroup" aria-label={t("settings.gateway2.mode")}>
+          <ModeCard
+            icon={<Monitor aria-hidden="true" size={14} />}
+            title={t("settings.gateway2.local")}
+            body={t("settings.gateway2.localBody")}
+            selected={selected === "local"}
+            onClick={() => setChosen("local")}
+          />
+          <ModeCard
+            icon={<Globe aria-hidden="true" size={14} />}
+            title={t("settings.gateway2.remote")}
+            body={t("settings.gateway2.remoteBody")}
+            selected={selected === "remote"}
+            onClick={() => setChosen("remote")}
+          />
+          <ModeCard
+            icon={<SquareTerminal aria-hidden="true" size={14} />}
+            title={t("settings.gateway2.ssh")}
+            body={t("settings.gateway2.sshBody")}
+            selected={false}
+            onClick={() => go?.({ view: "gateways", page: "connections" })}
+          />
+        </div>
+        {selected === "remote" && (
+          <div className="sb-remote">
+            <input
+              className="settings-input sb-full"
+              aria-label={t("settings.remote.url")}
+              placeholder="https://indus.example.com"
+              value={url}
+              spellCheck={false}
+              autoComplete="off"
+              onChange={(event) => setUrl(event.currentTarget.value)}
+            />
+            <SecretInput
+              label={t("settings.remote.token")}
+              placeholder={t(
+                saved?.hasToken ? "settings.remote.tokenStored" : "settings.remote.token",
+              )}
+              value={token}
+              onChange={setToken}
+            />
+            <span className="settings-inline">
+              <OutlineButton
+                disabled={url.trim() === "" || token === ""}
+                onClick={async () => {
+                  const answer = await attempt(
+                    connection ? () => connection.testRemote({ url: url.trim(), token }) : null,
+                  );
+                  if (answer.ok) setResult(answer.value);
+                  else setNote({ text: answer.message, error: true });
+                }}
+              >
+                {t("settings.remote.test")}
+              </OutlineButton>
+              {result !== null && (
+                <span className="settings-row-note" role="status">
+                  {t("settings.remote.legs", {
+                    http: legText(result.http),
+                    ws: legText(result.ws),
+                  })}
+                </span>
+              )}
+            </span>
+          </div>
+        )}
+        {selected === "local" && mode === "remote" && (
+          <p className="settings-row-note">{t("settings.gateway2.forgetNote")}</p>
+        )}
+        <div className="sb-form-actions sb-end">
+          <PrimaryButton
+            disabled={!canSave || (selected === mode && selected === "local")}
+            onClick={() => void (selected === "remote" ? saveRemote() : forgetRemote())}
+          >
+            {t("settings.gateway2.saveReconnect")}
+          </PrimaryButton>
+        </div>
+        <Note text={note?.text ?? null} error={note?.error ?? false} />
+      </div>
+      <StorageRow />
+      <SettingRow
+        rowId="gateway-logs"
+        highlighted={focusRow === "gateway-logs"}
+        title={t("settings.gatewayDiag.title")}
+        description={t("settings.gatewayDiag.body")}
+        control={
+          <TextButton
+            icon={<FileText aria-hidden="true" size={13} />}
+            disabled={logs === undefined}
+            onClick={() => void attempt(logs ? () => logs.reveal() : null)}
+          >
+            {t("settings.gatewayDiag.open")}
+          </TextButton>
+        }
+      />
+    </PageBody>
+  );
+}
+
+export function RemoteUpdatesPage() {
+  const t = useT();
+  return (
+    <PageBody>
+      <SettingsEmpty
+        title={t("settings.remoteUpdates.title")}
+        body={t("settings.remoteUpdates.body")}
+      />
+    </PageBody>
+  );
+}
diff --git a/apps/desktop/src/settings/pagesB/keyboard.tsx b/apps/desktop/src/settings/pagesB/keyboard.tsx
new file mode 100644
index 0000000..9443c0b
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/keyboard.tsx
@@ -0,0 +1,218 @@
+// Settings › Keyboard Shortcuts (W52-j): Key bindings (grouped in-app actions as key chips, search,
+// reset all, per-row reset) and Global shortcuts (quick entry and the HUD, with their live state).
+
+import { AlertTriangle, RotateCcw, Search } from "lucide-react";
+import { useState } from "react";
+import type { IndusShortcutAction } from "../../global.d.ts";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { usePrefs, useSettings } from "../context.tsx";
+import {
+  conflictsFor,
+  effectiveBindings,
+  GLOBAL_ACTIONS,
+  KEY_ACTIONS,
+  KEY_GROUPS,
+  type KeyGroup,
+  keyGroupOf,
+  normalizeAccelerator,
+} from "../keybindings.ts";
+import { PageBody, SettingRow, TextButton } from "../primitives.tsx";
+import { KeyCapture, Note, notAvailable, shortcutStatus, useShortcutsView } from "./kit.tsx";
+
+const GROUP_LABELS: Readonly<Record<KeyGroup, MessageKey>> = {
+  general: "settings.keys2.groupGeneral",
+  composer: "settings.keys2.groupComposer",
+  tabs: "settings.keys2.groupTabs",
+  conversation: "settings.keys2.groupConversation",
+};
+
+const GLOBAL_TO_ACTION: Readonly<Record<string, IndusShortcutAction>> = {
+  quickEntryShortcut: "quick-entry",
+  hudSnapShortcut: "hud-snap",
+  hudToggleShortcut: "hud-toggle",
+};
+
+/** Every binding (in-app and global) and a writer that checks validity and conflicts first. */
+function useBindings() {
+  const t = useT();
+  const { bridge } = useSettings();
+  const { prefs, error, update } = usePrefs(bridge);
+  const [problem, setProblem] = useState<{ id: string; text: string } | null>(null);
+  const bindings: Record<string, string> =
+    prefs === null
+      ? {}
+      : {
+          ...effectiveBindings(prefs.keybindings),
+          quickEntryShortcut: prefs.quickEntryShortcut,
+          hudSnapShortcut: prefs.hudSnapShortcut,
+          hudToggleShortcut: prefs.hudToggleShortcut,
+        };
+  const labelOf = (id: string): string => {
+    const action = KEY_ACTIONS.find((a) => a.id === id) ?? GLOBAL_ACTIONS.find((a) => a.id === id);
+    return action === undefined ? id : t(action.label);
+  };
+  const commit = async (id: string, accelerator: string): Promise<boolean> => {
+    if (prefs === null) return false;
+    if (accelerator !== "" && normalizeAccelerator(accelerator) === null) {
+      setProblem({ id, text: t("settings.key.invalid") });
+      return false;
+    }
+    const clash = accelerator === "" ? [] : conflictsFor(accelerator, id, bindings);
+    if (clash.length > 0) {
+      setProblem({
+        id,
+        text: t("settings.key.conflict", {
+          key: accelerator,
+          action: clash.map(labelOf).join(", "),
+        }),
+      });
+      return false;
+    }
+    setProblem(null);
+    if (GLOBAL_ACTIONS.some((g) => g.id === id)) return update({ [id]: accelerator });
+    const action = KEY_ACTIONS.find((a) => a.id === id);
+    const overrides = { ...prefs.keybindings };
+    if (action !== undefined && accelerator === action.defaultKey) delete overrides[id];
+    else overrides[id] = accelerator;
+    return update({ keybindings: overrides });
+  };
+  return { prefs, error, update, bindings, labelOf, commit, problem };
+}
+
+export function KeyBindingsPage() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const keys = useBindings();
+  const [needle, setNeedle] = useState("");
+  const platform = bridge?.facts?.platform ?? "linux";
+  if (keys.prefs === null) return <Note text={notAvailable(t, keys.error)} error />;
+  const q = needle.trim().toLowerCase();
+  const shown = KEY_ACTIONS.filter(
+    (action) => q === "" || t(action.label).toLowerCase().includes(q),
+  );
+  return (
+    <div
+      className="settings-page-body"
+      data-row="keybindings"
+      data-highlighted={focusRow === "keybindings" ? "true" : undefined}
+    >
+      <div className="sb-intro-line">
+        <p className="settings-intro">{t("settings.keyboard.body")}</p>
+        <TextButton
+          icon={<RotateCcw aria-hidden="true" size={12} />}
+          onClick={() => void keys.update({ keybindings: {} })}
+        >
+          {t("settings.keys2.resetAll")}
+        </TextButton>
+      </div>
+      {keys.problem !== null && (
+        <p className="settings-row-error" role="alert">
+          {keys.problem.text}
+        </p>
+      )}
+      <label className="sb-search">
+        <Search aria-hidden="true" size={13} />
+        <input
+          type="search"
+          aria-label={t("settings.keys2.searchShortcuts")}
+          placeholder={t("settings.keys2.searchShortcuts")}
+          value={needle}
+          onChange={(event) => setNeedle(event.currentTarget.value)}
+        />
+      </label>
+      {KEY_GROUPS.map((group) => {
+        const rows = shown.filter((action) => keyGroupOf(action.id) === group);
+        if (rows.length === 0) return null;
+        return (
+          <section key={group} className="sb-key-group" aria-label={t(GROUP_LABELS[group])}>
+            <h3 className="sb-caps">{t(GROUP_LABELS[group])}</h3>
+            {rows.map((action) => {
+              const value = keys.bindings[action.id] ?? "";
+              const clash = keys.problem?.id === action.id ? keys.problem.text : null;
+              return (
+                <div key={action.id} className="sb-bind">
+                  <span className="sb-bind-label">{t(action.label)}</span>
+                  {clash !== null && (
+                    <AlertTriangle aria-label={clash} size={14} className="sb-bind-warn" />
+                  )}
+                  <KeyCapture
+                    label={t(action.label)}
+                    platform={platform}
+                    value={value}
+                    onCommit={(accelerator) => void keys.commit(action.id, accelerator)}
+                  />
+                  <button
+                    type="button"
+                    className="sb-bind-reset"
+                    aria-label={t("settings.reset")}
+                    data-visible={value !== action.defaultKey ? "true" : undefined}
+                    onClick={() => void keys.commit(action.id, action.defaultKey)}
+                  >
+                    <RotateCcw aria-hidden="true" size={12} />
+                  </button>
+                </div>
+              );
+            })}
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+export function GlobalShortcutsPage() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const keys = useBindings();
+  const shortcuts = useShortcutsView(bridge);
+  const platform = bridge?.facts?.platform ?? "linux";
+  if (keys.prefs === null) return <Note text={notAvailable(t, keys.error)} error />;
+  const actionLabel = (action: IndusShortcutAction) => {
+    const id = Object.keys(GLOBAL_TO_ACTION).find((k) => GLOBAL_TO_ACTION[k] === action);
+    return id === undefined ? action : keys.labelOf(id);
+  };
+  return (
+    <PageBody intro={t("settings.globalKeys.intro")}>
+      <div
+        data-row="global-shortcuts"
+        data-highlighted={focusRow === "global-shortcuts" ? "true" : undefined}
+      >
+        {GLOBAL_ACTIONS.map((action) => {
+          const status = shortcutStatus(
+            t,
+            shortcuts.view,
+            GLOBAL_TO_ACTION[action.id] as IndusShortcutAction,
+            actionLabel,
+          );
+          const clash = keys.problem?.id === action.id ? keys.problem.text : null;
+          return (
+            <SettingRow
+              key={action.id}
+              title={t(action.label)}
+              description={
+                status === null && clash === null ? undefined : (
+                  <span
+                    className="sb-status"
+                    data-error={clash !== null || status?.error ? "true" : undefined}
+                  >
+                    {clash ?? status?.text}
+                  </span>
+                )
+              }
+              control={
+                <KeyCapture
+                  label={t(action.label)}
+                  platform={platform}
+                  value={keys.bindings[action.id] ?? ""}
+                  onCommit={async (accelerator) => {
+                    if (await keys.commit(action.id, accelerator)) shortcuts.reload();
+                  }}
+                />
+              }
+            />
+          );
+        })}
+      </div>
+    </PageBody>
+  );
+}
diff --git a/apps/desktop/src/settings/pagesB/keys.tsx b/apps/desktop/src/settings/pagesB/keys.tsx
new file mode 100644
index 0000000..48d5b6c
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/keys.tsx
@@ -0,0 +1,297 @@
+// Settings › Providers › API keys and Tools & Keys › Keys (W52-j): one quiet row per stored key
+// name (status dot, name, the masked value or "Paste key"); a click opens the row to paste,
+// save or remove. Keys go to the backend's secret store and leave the renderer at once.
+
+import { ChevronRight, ExternalLink, Search } from "lucide-react";
+import { useCallback, useEffect, useId, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { attempt, useSettings } from "../context.tsx";
+import {
+  PageBody,
+  PrimaryButton,
+  SettingRow,
+  SettingsEmpty,
+  TextButton,
+  TextField,
+} from "../primitives.tsx";
+import { rest } from "../settingsApi.ts";
+import { Note, SecretInput } from "./kit.tsx";
+
+export interface EnvRow {
+  readonly category: string;
+  readonly description: string;
+  readonly advanced: boolean;
+  readonly is_password: boolean;
+  readonly is_set: boolean;
+  readonly redacted_value: string | null;
+  readonly url?: string | null;
+}
+
+/** "API key for OpenRouter" → "OpenRouter"; anything else → the name with spaces. */
+export function keyTitle(name: string, row: EnvRow): string {
+  const match = /^API key for (.+)$/i.exec(row.description.trim());
+  if (match?.[1]) return match[1];
+  return name.replace(/_/g, " ");
+}
+
+function useEnv() {
+  const { api, profile } = useSettings();
+  const [rows, setRows] = useState<Readonly<Record<string, EnvRow>> | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const load = useCallback(() => {
+    void rest<Record<string, EnvRow>>(api, "GET", "/api/env", { profile }).then((answer) => {
+      if (answer.ok) setRows(answer.data);
+      else setError(answer.message);
+    });
+  }, [api, profile]);
+  useEffect(load, [load]);
+  const save = async (name: string, value: string) => {
+    const answer = await rest(api, "PUT", "/api/env", { body: { key: name, value }, profile });
+    if (answer.ok) load();
+    return answer.ok ? null : answer.message;
+  };
+  const clear = async (name: string) => {
+    const answer = await rest(api, "DELETE", "/api/env", { body: { key: name }, profile });
+    if (answer.ok) load();
+    return answer.ok ? null : answer.message;
+  };
+  return { rows, error, setError, save, clear };
+}
+
+function KeyLine(props: {
+  name: string;
+  title: string;
+  row: EnvRow;
+  open: boolean;
+  highlighted: boolean;
+  onToggle: () => void;
+  onSave: (name: string, value: string) => Promise<string | null>;
+  onClear: (name: string) => Promise<string | null>;
+}) {
+  const t = useT();
+  const { bridge } = useSettings();
+  const [value, setValue] = useState("");
+  const [note, setNote] = useState<{ text: string; error: boolean } | null>(null);
+  const bodyId = useId();
+  const external = bridge?.external;
+  return (
+    <div
+      className="sb-key"
+      data-open={props.open ? "true" : undefined}
+      data-row={`key-${props.name}`}
+      data-highlighted={props.highlighted ? "true" : undefined}
+    >
+      <button
+        type="button"
+        className="sb-key-head"
+        aria-expanded={props.open}
+        aria-controls={bodyId}
+        onClick={props.onToggle}
+      >
+        <span className="sb-dot" data-on={props.row.is_set ? "true" : undefined} />
+        <span className="sb-key-title">{props.title}</span>
+        <span className="sb-key-value" data-set={props.row.is_set ? "true" : undefined}>
+          {props.row.is_set ? props.row.redacted_value : t("settings.keys2.paste")}
+        </span>
+      </button>
+      {props.open && (
+        <div id={bodyId} className="sb-key-body">
+          <span className="sb-mono">{props.name}</span>
+          <span className="settings-inline">
+            <SecretInput
+              label={props.name}
+              value={value}
+              onChange={setValue}
+              placeholder={t(props.row.is_set ? "settings.keys.replace" : "settings.keys.paste")}
+            />
+            <PrimaryButton
+              disabled={value.trim() === ""}
+              onClick={async () => {
+                const failure = await props.onSave(props.name, value);
+                if (failure === null) setValue(""); // the key leaves the renderer
+                setNote(
+                  failure === null
+                    ? { text: t("settings.saved"), error: false }
+                    : { text: failure, error: true },
+                );
+              }}
+            >
+              {t("settings.save")}
+            </PrimaryButton>
+          </span>
+          <span className="settings-inline">
+            {props.row.is_set && (
+              <TextButton
+                onClick={async () => {
+                  const failure = await props.onClear(props.name);
+                  setNote(
+                    failure === null
+                      ? { text: t("settings.keys.cleared"), error: false }
+                      : { text: failure, error: true },
+                  );
+                }}
+              >
+                {t("settings.keys.clear")}
+              </TextButton>
+            )}
+            {typeof props.row.url === "string" && props.row.url !== "" && external && (
+              <TextButton
+                icon={<ExternalLink aria-hidden="true" size={13} />}
+                onClick={() => void attempt(() => external.open({ url: props.row.url as string }))}
+              >
+                {t("settings.keys2.getKey")}
+              </TextButton>
+            )}
+          </span>
+          <Note text={note?.text ?? null} error={note?.error ?? false} />
+        </div>
+      )}
+    </div>
+  );
+}
+
+function KeyList(props: {
+  entries: ReadonlyArray<readonly [string, EnvRow]>;
+  titleOf: (name: string, row: EnvRow) => string;
+  onSave: (name: string, value: string) => Promise<string | null>;
+  onClear: (name: string) => Promise<string | null>;
+}) {
+  const { focusRow } = useSettings();
+  const [open, setOpen] = useState<string | null>(
+    focusRow?.startsWith("key-") ? focusRow.slice(4) : null,
+  );
+  return (
+    <div className="sb-keys">
+      {props.entries.map(([name, row]) => (
+        <KeyLine
+          key={name}
+          name={name}
+          title={props.titleOf(name, row)}
+          row={row}
+          open={open === name}
+          highlighted={focusRow === `key-${name}`}
+          onToggle={() => setOpen((now) => (now === name ? null : name))}
+          onSave={props.onSave}
+          onClear={props.onClear}
+        />
+      ))}
+    </div>
+  );
+}
+
+export function ProviderKeysPage() {
+  const t = useT();
+  const { go, focusRow } = useSettings();
+  const env = useEnv();
+  const [needle, setNeedle] = useState("");
+  // one row per provider: names that share a title (GEMINI / GOOGLE) show the set one, else the first
+  const byTitle = new Map<string, readonly [string, EnvRow]>();
+  for (const entry of Object.entries(env.rows ?? {})) {
+    const [name, row] = entry;
+    if (!row.is_password || row.category !== "provider") continue;
+    const title = keyTitle(name, row);
+    const held = byTitle.get(title);
+    if (held === undefined || (!held[1].is_set && row.is_set)) byTitle.set(title, entry);
+  }
+  const entries = [...byTitle.values()].filter(([name, row]) => {
+    const q = needle.trim().toLowerCase();
+    return (
+      q === "" || name.toLowerCase().includes(q) || keyTitle(name, row).toLowerCase().includes(q)
+    );
+  });
+  return (
+    <PageBody>
+      <div data-row="api-keys" data-highlighted={focusRow === "api-keys" ? "true" : undefined}>
+        <button
+          type="button"
+          className="sb-link-row"
+          onClick={() => go?.({ view: "providers", page: "endpoints" })}
+        >
+          <span className="sb-link-row-text">
+            <span className="settings-row-label">{t("settings.keys2.endpointRow")}</span>
+            <span className="settings-row-desc">{t("settings.keys2.endpointRowBody")}</span>
+          </span>
+          <ChevronRight aria-hidden="true" size={14} />
+        </button>
+      </div>
+      <label className="sb-search">
+        <Search aria-hidden="true" size={13} />
+        <input
+          type="search"
+          aria-label={t("settings.keys2.search")}
+          placeholder={t("settings.keys2.search")}
+          value={needle}
+          onChange={(event) => setNeedle(event.currentTarget.value)}
+        />
+      </label>
+      <KeyList entries={entries} titleOf={keyTitle} onSave={env.save} onClear={env.clear} />
+      {env.rows !== null && entries.length === 0 && (
+        <SettingsEmpty title={t("settings.keys2.noMatch")} />
+      )}
+      <Note text={env.error} error />
+    </PageBody>
+  );
+}
+
+/** Tools & Keys › Keys: the keys a person added for tools and skills, plus the add form. */
+export function ToolKeysPage() {
+  const t = useT();
+  const { focusRow } = useSettings();
+  const env = useEnv();
+  const [newName, setNewName] = useState("");
+  const [newValue, setNewValue] = useState("");
+  const entries = Object.entries(env.rows ?? {}).filter(
+    ([, row]) => row.is_password && row.category !== "provider",
+  );
+  const nameId = useId();
+  return (
+    <PageBody intro={t("settings.toolKeys.intro")}>
+      <div data-row="tool-keys" data-highlighted={focusRow === "tool-keys" ? "true" : undefined}>
+        <KeyList
+          entries={entries}
+          titleOf={(name) => name.replace(/_/g, " ")}
+          onSave={env.save}
+          onClear={env.clear}
+        />
+      </div>
+      {env.rows !== null && entries.length === 0 && (
+        <SettingsEmpty title={t("settings.toolKeys.none")} body={t("settings.toolKeys.noneBody")} />
+      )}
+      <SettingRow
+        title={t("settings.keys.other")}
+        description={t("settings.keys.otherBody")}
+        htmlFor={nameId}
+        control={
+          <div className="sb-stack">
+            <TextField
+              id={nameId}
+              placeholder="EXAMPLE_API_KEY"
+              value={newName}
+              onChange={(event) => setNewName(event.currentTarget.value.toUpperCase())}
+            />
+            <span className="settings-inline">
+              <SecretInput
+                label={t("settings.keys.value")}
+                value={newValue}
+                onChange={setNewValue}
+              />
+              <PrimaryButton
+                disabled={!/^[A-Z][A-Z0-9_]*$/.test(newName) || newValue.trim() === ""}
+                onClick={async () => {
+                  const failure = await env.save(newName, newValue);
+                  if (failure === null) {
+                    setNewName("");
+                    setNewValue("");
+                  } else env.setError(failure);
+                }}
+              >
+                {t("settings.save")}
+              </PrimaryButton>
+            </span>
+          </div>
+        }
+      />
+      <Note text={env.error} error />
+    </PageBody>
+  );
+}
diff --git a/apps/desktop/src/settings/pagesB/kit.tsx b/apps/desktop/src/settings/pagesB/kit.tsx
new file mode 100644
index 0000000..0c41dce
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/kit.tsx
@@ -0,0 +1,233 @@
+// Small pieces the settings-b pages share (W52-j): status notes, key chips and the key-capture
+// control, the global shortcuts' live state, and the update status hook.
+
+import { Eye, EyeOff } from "lucide-react";
+import { useCallback, useEffect, useState } from "react";
+import type { IndusShortcutAction, IndusShortcutsView, IndusUpdateStatus } from "../../global.d.ts";
+import { type MessageKey, type Translate, useT } from "../../i18n/index.tsx";
+import { attempt, type SettingsBridge } from "../context.tsx";
+import { acceleratorFromEvent, acceleratorKeys } from "../keybindings.ts";
+import "./pagesB.css";
+
+/** A 12px line under a control: quiet, or red for a failure. Nothing when empty. */
+export function Note(props: { text: string | null; error?: boolean }) {
+  if (props.text === null || props.text === "") return null;
+  return (
+    <p className={props.error ? "settings-row-error" : "settings-row-note"} role="status">
+      {props.text}
+    </p>
+  );
+}
+
+/** A bridge refusal as words: "not in this build" or "could not be read". */
+export function notAvailable(t: Translate, code: string | null): string | null {
+  if (code === null) return null;
+  return code === "not-available" ? t("settings.notAvailable") : t("settings.loadFailed");
+}
+
+/** One chip per key; an unbound action shows a single faint "set" chip. */
+export function KeyChips(props: { accelerator: string; platform: string }) {
+  const t = useT();
+  const keys = acceleratorKeys(props.accelerator, props.platform);
+  if (keys.length === 0) {
+    return (
+      <span className="sb-chips">
+        <kbd className="sb-kbd" data-ghost="true">
+          {t("settings.keys2.set")}
+        </kbd>
+      </span>
+    );
+  }
+  return (
+    <span className="sb-chips">
+      {keys.map((key, index) => (
+        // biome-ignore lint/suspicious/noArrayIndexKey: keys repeat only in invalid accelerators
+        <kbd key={`${key}-${index}`} className="sb-kbd">
+          {key}
+        </kbd>
+      ))}
+    </span>
+  );
+}
+
+/**
+ * The chips as a button: a click starts capture ("Press keys…"), the next key press with a
+ * modifier commits; Escape keeps the old keys, Backspace clears them.
+ */
+export function KeyCapture(props: {
+  value: string;
+  label: string;
+  platform: string;
+  onCommit: (accelerator: string) => void;
+}) {
+  const t = useT();
+  const [recording, setRecording] = useState(false);
+  return (
+    <button
+      type="button"
+      className="sb-capture"
+      aria-label={props.label}
+      aria-pressed={recording}
+      onClick={() => setRecording(true)}
+      onBlur={() => setRecording(false)}
+      onKeyDown={(event) => {
+        if (!recording) return;
+        event.preventDefault();
+        event.stopPropagation();
+        if (event.key === "Escape") {
+          setRecording(false);
+          return;
+        }
+        if (event.key === "Backspace" && !event.ctrlKey && !event.metaKey && !event.altKey) {
+          setRecording(false);
+          props.onCommit("");
+          return;
+        }
+        const accelerator = acceleratorFromEvent(event);
+        if (accelerator !== "") {
+          setRecording(false);
+          props.onCommit(accelerator);
+        }
+      }}
+    >
+      {recording ? (
+        <span className="sb-chips">
+          <kbd className="sb-kbd" data-recording="true">
+            {t("settings.key.recording")}
+          </kbd>
+        </span>
+      ) : (
+        <KeyChips accelerator={props.value} platform={props.platform} />
+      )}
+    </button>
+  );
+}
+
+/** Main's view of the three global shortcuts (registered or why not), kept current. */
+export function useShortcutsView(bridge: SettingsBridge | null) {
+  const source = bridge?.shortcuts;
+  const [view, setView] = useState<IndusShortcutsView | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const reload = useCallback(() => {
+    void attempt(source ? () => source.get() : null).then((answer) => {
+      if (answer.ok) setView(answer.value);
+      else setError(answer.code);
+    });
+  }, [source]);
+  useEffect(reload, [reload]);
+  const set = async (payload: { action: IndusShortcutAction; enabled?: boolean }) => {
+    const answer = await attempt(source ? () => source.set(payload) : null);
+    if (answer.ok) setView(answer.value);
+    else setError(answer.code);
+  };
+  return { view, error, reload, set };
+}
+
+const SHORTCUT_ERRORS: Readonly<Record<string, MessageKey>> = {
+  taken: "settings.shortcut.taken",
+  invalid: "settings.shortcut.invalid",
+  failed: "settings.shortcut.failed",
+};
+
+/** "Shortcut is active." or why it is not, for one global action. */
+export function shortcutStatus(
+  t: Translate,
+  view: IndusShortcutsView | null,
+  action: IndusShortcutAction,
+  labelOf: (action: IndusShortcutAction) => string,
+): { text: string; error: boolean } | null {
+  const entry = view?.shortcuts.find((s) => s.action === action);
+  if (entry === undefined) return null;
+  if (!entry.enabled) return { text: t("settings.shortcut.off"), error: false };
+  if (entry.registered) return { text: t("settings.shortcut.active"), error: false };
+  if (entry.error === "conflict" && entry.conflictWith !== undefined) {
+    return {
+      text: t("settings.shortcut.conflict", { action: labelOf(entry.conflictWith) }),
+      error: true,
+    };
+  }
+  const key = entry.error === null ? undefined : SHORTCUT_ERRORS[entry.error];
+  return key === undefined ? null : { text: t(key), error: true };
+}
+
+/** The app's update status and its calls (About › Version & updates). */
+export function useUpdates(bridge: SettingsBridge | null) {
+  const source = bridge?.updates;
+  const [status, setStatus] = useState<IndusUpdateStatus | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  useEffect(() => {
+    void attempt(source ? () => source.status() : null).then((answer) => {
+      if (answer.ok) setStatus(answer.value);
+      else setError(answer.code);
+    });
+    return source?.onProgress((next) => setStatus(next));
+  }, [source]);
+  const run = useCallback(async (call: (() => Promise<IndusUpdateStatus>) | null) => {
+    const answer = await attempt(call);
+    if (answer.ok) setStatus(answer.value);
+    else setError(answer.code);
+  }, []);
+  return {
+    status,
+    error,
+    check: () => run(source ? () => source.check() : null),
+    setChannel: (channel: "stable" | "canary") =>
+      run(source ? () => source.setChannel({ channel }) : null),
+    apply: async () => {
+      const answer = await attempt(source ? () => source.apply() : null);
+      if (!answer.ok) setError(answer.code);
+    },
+  };
+}
+
+/** "3 min ago" style text for a past time (epoch ms or ISO; null when unreadable). */
+export function relativeTime(
+  t: Translate,
+  when: number | string | null | undefined,
+  now = Date.now(),
+) {
+  if (when === null || when === undefined) return null;
+  const then = typeof when === "number" ? when : Date.parse(when);
+  if (Number.isNaN(then)) return null;
+  const minutes = Math.max(0, Math.round((now - then) / 60_000));
+  if (minutes < 1) return t("settings.time.justNow");
+  if (minutes < 60) return t("settings.time.minutes", { count: minutes });
+  const hours = Math.round(minutes / 60);
+  if (hours < 24) return t("settings.time.hours", { count: hours });
+  return t("settings.time.days", { count: Math.round(hours / 24) });
+}
+
+/** A password field with a reveal toggle (shows only what the person typed). */
+export function SecretInput(props: {
+  id?: string;
+  value: string;
+  onChange: (value: string) => void;
+  label: string;
+  placeholder?: string;
+}) {
+  const t = useT();
+  const [revealed, setRevealed] = useState(false);
+  return (
+    <span className="settings-inline">
+      <input
+        id={props.id}
+        className="settings-input"
+        type={revealed ? "text" : "password"}
+        aria-label={props.label}
+        value={props.value}
+        placeholder={props.placeholder}
+        autoComplete="off"
+        spellCheck={false}
+        onChange={(event) => props.onChange(event.currentTarget.value)}
+      />
+      <button
+        type="button"
+        className="icon-button"
+        aria-label={t(revealed ? "settings.field.hide" : "settings.field.reveal")}
+        onClick={() => setRevealed((now) => !now)}
+      >
+        {revealed ? <EyeOff aria-hidden="true" size={14} /> : <Eye aria-hidden="true" size={14} />}
+      </button>
+    </span>
+  );
+}
