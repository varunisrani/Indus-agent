+    const { store } = setup();
+    fireEvent.click(screen.getByRole("button", { name: "Edit layout" }));
+    const card = screen.getByRole("dialog", { name: "Layouts" });
+    expect(document.querySelector(".pane-shell")?.getAttribute("data-layout-editing")).toBe("true");
