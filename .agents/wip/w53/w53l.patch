+/* Artifacts page (W52-l, spec 3.10). */
+
+.art-page {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+  background: var(--desk-bg-canvas);
+}
+
+.art-head {
+  display: grid;
+  grid-template-columns: 1fr auto 1fr;
+  align-items: center;
+  gap: 12px;
+  min-height: 36px;
+  padding: 8px 16px 4px;
+}
+
+.art-head-left {
+  min-width: 0;
+}
+
+.art-head-left .kit-quiet-search {
+  max-width: 220px;
+}
+
+.art-head-right {
+  display: flex;
+  justify-content: flex-end;
+}
+
+.art-spin svg {
+  animation: art-spin 1s linear infinite;
+}
+
+@keyframes art-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .art-spin svg {
+    animation: none;
+  }
+}
+
+.art-note {
+  margin: 0;
+  padding: 0 20px 6px;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.art-body {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 0 20px 24px;
+}
+
+.art-empty {
+  display: grid;
+  flex: 1;
+  place-items: center;
+}
+
+.art-pager {
+  position: sticky;
+  top: 0;
+  z-index: 1;
+  min-height: 28px;
+  margin: 0;
+  background: var(--desk-bg-canvas);
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  line-height: 28px;
+  text-align: right;
+}
+
+.art-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
+  gap: 8px;
+  margin-bottom: 16px;
+}
+
+.art-card {
+  overflow: hidden;
+  border: 1px solid var(--desk-stroke-2);
+  border-radius: 8px;
+  background: var(--desk-bg-bubble);
+}
+
+.art-thumb {
+  display: grid;
+  height: 160px;
+  place-items: center;
+  background: var(--desk-bg-band);
+  color: var(--desk-fg-4);
+  cursor: zoom-in;
+}
+
+.art-thumb img {
+  max-width: 100%;
+  max-height: 160px;
+  object-fit: contain;
+}
+
+.art-card-text {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  padding: 8px;
+}
+
+.art-kind {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.art-name {
+  overflow: hidden;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-small);
+  font-weight: 500;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.art-path,
+.art-time {
+  overflow: hidden;
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.art-actions {
+  display: flex;
+  gap: 10px;
+  margin-top: 4px;
+}
+
+.art-link {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: 10px;
+  white-space: nowrap;
+  cursor: pointer;
+}
+
+.art-link:hover {
+  color: var(--desk-fg-1);
+  text-decoration: underline;
+}
+
+.art-table {
+  width: 100%;
+  overflow: hidden;
+  border: 1px solid var(--desk-stroke-2);
+  border-radius: 8px;
+  border-collapse: separate;
+  border-spacing: 0;
+  table-layout: fixed;
+  font-size: var(--desk-text-small);
+}
+
+.art-table th {
+  padding: 6px 10px;
+  background: var(--desk-bg-table-head);
+  color: var(--desk-fg-3);
+  font-size: 10px;
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-align: left;
+  text-transform: uppercase;
+}
+
+.art-table th:nth-child(1) {
+  width: 35%;
+}
+
+.art-table th:nth-child(2) {
+  width: 41%;
+}
+
+.art-table td {
+  padding: 6px 10px;
+  border-top: 1px solid var(--desk-stroke-2);
+  color: var(--desk-fg-2);
+  vertical-align: middle;
+}
+
+.art-table tbody tr:hover {
+  background: var(--desk-row-hover);
+}
+
+.art-file,
+.art-location {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  min-width: 0;
+}
+
+.art-location .art-path {
+  flex: 1;
+  min-width: 0;
+}
+
+.art-tile {
+  display: inline-grid;
+  flex: none;
+  width: 24px;
+  height: 24px;
+  place-items: center;
+  border-radius: 6px;
+  background: var(--desk-bg-pill);
+  color: var(--desk-fg-3);
+}
+
+.art-session {
+  display: flex;
+  flex-direction: column;
+  max-width: 100%;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.art-session > span:first-child {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
