+  --kit-dialog-bg: #15171c;
+  --kit-dialog-stroke: #232d40;
+  --kit-elevated: #16181d;
+}
+
+/* -- text actions --------------------------------------------------------------------------- */
+
+.kit-text-action {
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: var(--desk-text-micro);
