+++ b/apps/desktop/src/app/session-import/sessionImport.css
@@ -0,0 +1,247 @@
+/* Session import overlay (W52-l, spec 3.5). */
+
+.imp-frame {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+
+.imp-head {
+  padding: 48px 32px 24px;
+  border-bottom: 1px solid var(--desk-stroke-2);
+}
+
+.imp-title {
+  margin: 0;
+  color: var(--desk-fg-1);
+  font-size: 30px;
+  font-weight: 600;
+  letter-spacing: -0.01em;
+  line-height: 1.15;
+}
+
+.imp-subtitle {
+  margin: 8px 0 0;
+  color: var(--desk-fg-2);
+  font-size: 14px;
+}
+
+.imp-meta {
+  display: flex;
+  gap: 20px;
+  margin: 20px 0 0;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+}
+
+.imp-meta > span {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.imp-body {
+  display: grid;
+  grid-template-columns: minmax(272px, 0.85fr) minmax(0, 1.6fr);
+  flex: 1;
+  min-height: 0;
+}
+
+.imp-list-col {
+  display: flex;
+  flex-direction: column;
+  min-height: 0;
+  border-bottom-left-radius: 11px;
+  background: var(--desk-bg-band);
+}
+
+.imp-list-tools {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 20px;
+  padding: 24px 24px 8px;
+}
+
+.imp-list-tools .desk-segmented {
+  background: var(--desk-row-active);
+}
+
+.imp-list-tools .desk-segment {
+  font-size: var(--desk-text-micro);
+  font-weight: 500;
+}
+
+.imp-list-tools .kit-quiet-search {
+  width: 100%;
+}
+
+.imp-list {
+  flex: 1;
+  min-height: 0;
+  overflow-y: auto;
+  padding: 0 12px 16px;
+}
+
+.imp-group ul {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.imp-day {
+  margin: 12px 12px 6px;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+  font-weight: 500;
+}
+
+.imp-row {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  width: 100%;
+  padding: 16px 12px;
+  border: 0;
+  border-radius: var(--desk-radius-card);
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.imp-row:hover,
+.imp-row[aria-current="true"] {
+  background: var(--desk-row-hover);
+}
+
+.imp-row-source {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+}
+
+.imp-row-title {
+  display: -webkit-box;
+  overflow: hidden;
+  color: var(--desk-fg-1);
+  font-size: 14px;
+  font-weight: 500;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+}
+
+.imp-row-cwd {
+  overflow: hidden;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.imp-center {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 48px 12px;
+  text-align: center;
+}
+
+.imp-fill {
+  height: 100%;
+}
+
+.imp-empty-title {
+  margin: 0;
+  color: var(--desk-fg-1);
+  font-size: 14px;
+  font-weight: 500;
+}
+
+.imp-caption {
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.imp-detail {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  min-height: 0;
+}
+
+.imp-detail-head {
+  padding: 24px 32px 20px;
+}
+
+.imp-detail-head h2 {
+  margin: 0 0 4px;
+  color: var(--desk-fg-1);
+  font-size: 20px;
+  font-weight: 500;
+  letter-spacing: -0.01em;
+}
+
+.imp-messages {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 28px;
+  min-height: 0;
+  max-width: 65ch;
+  overflow-y: auto;
+  padding: 0 32px 32px;
+}
+
+.imp-message {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.imp-speaker {
+  margin: 0;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+  font-weight: 600;
+}
+
+.imp-tool {
+  font-weight: 400;
+}
+
+.imp-text {
+  color: var(--desk-fg-1);
+  font-size: 14px;
+  line-height: 1.55;
+  white-space: pre-wrap;
+  overflow-wrap: anywhere;
+}
+
+.imp-footer {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+  padding: 20px 32px;
+  border-top: 1px solid var(--desk-stroke-2);
+}
+
+.imp-footer > .imp-caption {
+  flex: 1;
+}
+
+.imp-detail > .kit-error,
+.imp-detail > [role="status"] {
+  margin: 0 32px 16px;
+}
diff --git a/apps/desktop/src/app/webhooks/WebhooksOverlay.test.tsx b/apps/desktop/src/app/webhooks/WebhooksOverlay.test.tsx
new file mode 100644
index 0000000..54c6543
--- /dev/null
+++ b/apps/desktop/src/app/webhooks/WebhooksOverlay.test.tsx
@@ -0,0 +1,93 @@
+// @vitest-environment jsdom
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { fakeRest } from "../../settings/fakeRest.ts";
+import { WebhooksOverlay } from "./WebhooksPage.tsx";
+
+describe("WebhooksOverlay", () => {
+  it("offers to enable the receiver, then a restart; New subscription waits for it", async () => {
+    const api = fakeRest();
+    let enabled = false;
+    api.route("GET", "/api/webhooks", () => ({
+      status: 200,
+      body: { receiver_enabled: enabled, base_url: "http://h", routes: [] },
+    }));
+    api.route("PUT", "/api/webhooks/receiver", () => {
+      enabled = true;
+      return { status: 200, body: { ok: true, receiver_enabled: true, restart_needed: true } };
+    });
+    api.route("POST", "/api/daemon/restart", { ok: true, action: "daemon-restart" });
+    render(<WebhooksOverlay api={api} profile="work" />);
+    expect(await screen.findByText("Webhook receiver disabled")).toBeTruthy();
+    expect(
+      (screen.getByRole("button", { name: "New subscription" }) as HTMLButtonElement).disabled,
+    ).toBe(true);
+    fireEvent.click(screen.getByRole("button", { name: "Enable webhooks" }));
+    expect(await screen.findByText("Restart needed")).toBeTruthy();
+    await waitFor(() =>
+      expect(
+        (screen.getByRole("button", { name: "New subscription" }) as HTMLButtonElement).disabled,
+      ).toBe(false),
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Restart gateway" }));
+    await waitFor(() => expect(screen.queryByText("Restart needed")).toBeNull());
+    expect(api.calls.find((c) => c.method === "PUT")?.body).toEqual({ enabled: true });
+  });
+
+  it("shows the signing secret once, after the create", async () => {
+    const api = fakeRest();
+    const secret = ["whsec", "fake", String(Date.now())].join("-");
+    api.route("GET", "/api/webhooks", {
+      receiver_enabled: true,
+      base_url: "http://h",
+      routes: [],
+    });
+    api.route("POST", "/api/webhooks", {
+      name: "gh",
+      url: "http://h/webhooks/gh",
+      secret,
+    });
+    render(<WebhooksOverlay api={api} profile="work" />);
+    fireEvent.click(await screen.findByRole("button", { name: "New subscription" }));
+    fireEvent.change(await screen.findByLabelText("Name"), { target: { value: "gh" } });
+    fireEvent.change(screen.getByLabelText(/^Events/), { target: { value: "push, ping" } });
+    fireEvent.click(screen.getByRole("button", { name: "Create" }));
+    expect((await screen.findByTestId("webhook-secret")).textContent).toBe(secret);
+    expect(api.calls.find((c) => c.method === "POST")?.body).toMatchObject({
+      name: "gh",
+      events: ["push", "ping"],
+      auth: "auto",
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Done" }));
+    await waitFor(() => expect(screen.queryByTestId("webhook-secret")).toBeNull());
+  });
+
+  it("a config route is read-only; a subscribed route has a row menu", async () => {
+    const api = fakeRest();
+    const route = (name: string, source: string) => ({
+      name,
+      source,
+      url: `http://h/webhooks/${name}`,
+      auth: "github",
+      events: ["push"],
+      prompt: "Summarise",
+      deliver: null,
+      description: "",
+      created_at: null,
+      enabled: true,
+      secret_set: true,
+    });
+    api.route("GET", "/api/webhooks", {
+      receiver_enabled: true,
+      base_url: "http://h",
+      routes: [route("from-config", "config"), route("mine", "subscribed")],
+    });
+    render(<WebhooksOverlay api={api} profile="work" />);
+    expect(await screen.findByText("Subscriptions (2)")).toBeTruthy();
+    expect(screen.queryByLabelText("Actions for from-config")).toBeNull();
+    expect(screen.getByLabelText("Actions for mine")).toBeTruthy();
+    fireEvent.click(screen.getByText("from-config"));
+    expect(await screen.findByText("config")).toBeTruthy();
+    expect(screen.getByText("http://h/webhooks/from-config")).toBeTruthy();
+  });
+});
diff --git a/apps/desktop/src/app/webhooks/WebhooksPage.tsx b/apps/desktop/src/app/webhooks/WebhooksPage.tsx
index 81a4f57..374a792 100644
--- a/apps/desktop/src/app/webhooks/WebhooksPage.tsx
+++ b/apps/desktop/src/app/webhooks/WebhooksPage.tsx
@@ -1,12 +1,32 @@
-// The Webhooks page (P24-27): the routes the daemon's webhook receiver serves (P15-32) — list,
-// create, enable/disable, delete. Routes defined in config.yaml are shown read-only. The signing
-// secret exists in exactly one answer (the create) and lives only in this component's state until
-// the person closes the notice; it is never written to storage or a log.
+// Webhooks (P24-27; W52-l look): the routes the daemon's webhook receiver serves (P15-32) as an
+// overlay panel — list, create, enable/disable, delete. Routes defined in config.yaml are shown
+// read-only. While the receiver is off a banner offers to turn it on (it takes effect after a
+// gateway restart, which the next banner offers). The signing secret exists in exactly one answer
