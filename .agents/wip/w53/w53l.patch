+/* Small parts of the overlay panels (W52-l). Quiet: text actions, hairlines and soft fills. */
+
+:root {
+  --kit-ok: #00bc7d;
+  --kit-ok-soft: #d8f4eb;
+  --kit-ok-text: #00a676;
+  --kit-warn-rule: #c08532;
