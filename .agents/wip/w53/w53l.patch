+}
+
+.cc-logs .kit-log {
+  border-bottom: 0;
+  border-radius: 8px 8px 0 0;
+}
+
+.cc-log-error {
+  color: var(--desk-danger);
+  font-size: var(--desk-text-small);
+}
+
+/* -- usage ---------------------------------------------------------------------------------- */
+
+.cc-usage {
+  display: flex;
+  flex-direction: column;
+  gap: 36px;
+  padding: 22px 0 32px;
+}
+
+.cc-tiles {
