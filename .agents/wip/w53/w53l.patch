+.kit-text-action:hover:not(:disabled) {
+  color: var(--desk-fg-1);
+  text-decoration: underline;
+}
+
+.kit-text-action[data-strong="true"] {
+  color: var(--desk-fg-1);
+  font-weight: 600;
+  text-decoration: underline;
+  text-decoration-color: color-mix(in srgb, var(--desk-fg-3) 30%, transparent);
+}
+
+.kit-text-action[data-tone="danger"] {
+  color: var(--desk-danger);
+}
+
+.kit-text-action:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
+/* -- captions and tabs ---------------------------------------------------------------------- */
+
+.kit-caps-row {
+  display: flex;
