+  background: color-mix(in srgb, #00bc7d 70%, transparent);
+}
+
+.cc-chart {
+  display: flex;
+  align-items: flex-end;
+  gap: 1px;
+  height: 96px;
+}
+
+.cc-bar {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  justify-content: flex-end;
+  min-width: 1px;
+  height: 100%;
