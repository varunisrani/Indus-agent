+/* Scheduled jobs overlay and its dialog (W52-l, spec 3.6 / 3.7). */
+
+.cron-pad {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 8px;
+  padding: 20px;
+}
+
+.cron-all {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 24px;
+  padding: 0 8px;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-micro);
+}
+
+.cron-list-empty {
+  margin: 0;
+  padding: 10px 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+  text-align: center;
+}
+
+.cron-note {
+  margin: 0 0 8px;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.cron-plans {
+  margin-top: 12px;
+}
+
+.cron-plans-label {
+  margin: 0 0 4px;
+  padding: 0 8px;
+  color: var(--desk-fg-4);
+  font-size: 9.6px;
+  font-weight: 500;
+  letter-spacing: 0.05em;
+  text-transform: uppercase;
+}
+
+.cron-plans ul {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+}
+
+.cron-plan {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  min-height: 28px;
+  padding: 0 8px;
+  border: 0;
+  border-radius: var(--desk-radius-card);
+  background: transparent;
+  color: var(--desk-fg-2);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+  text-align: left;
+  cursor: pointer;
+}
+
+.cron-plan > svg {
+  flex: none;
+  color: var(--desk-fg-4);
+}
+
+.cron-plan > span {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.cron-plan:hover {
+  background: var(--desk-row-hover);
+}
+
+.cron-detail {
+  display: flex;
+  flex-direction: column;
+}
+
+.cron-section {
+  margin-top: 12px;
+}
+
+.cron-run {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+}
+
+.cron-run-error {
+  color: var(--desk-danger);
+}
+
+.cron-targets {
+  min-width: 0;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+
+.cron-target-box {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 8px 10px;
+  border: 1px solid var(--desk-stroke-field);
+  border-radius: var(--desk-radius-card);
+}
+
+.cron-target {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-ui);
+}
+
+.cron-target input {
+  width: 16px;
+  height: 16px;
+  accent-color: var(--desk-accent);
+}
+
+.cron-target[data-off="true"] {
+  color: var(--desk-fg-4);
+}
+
+.cron-summary {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 8px 12px;
+  border-radius: var(--desk-radius-card);
+  background: var(--kit-summary);
+  font-size: var(--desk-text-small);
+}
+
+.cron-summary > span {
+  color: var(--desk-fg-1);
+  font-weight: 500;
+}
+
+.cron-summary > code {
+  color: var(--desk-fg-3);
+  font-family: var(--indus-font-mono);
+}
