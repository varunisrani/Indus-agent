+  color: var(--desk-danger);
+}
+
+.cc-more {
+  display: flex;
+  justify-content: flex-end;
+  padding-top: 8px;
+}
+
+/* -- system --------------------------------------------------------------------------------- */
+
+.cc-system {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 28px;
+  min-height: 0;
+}
+
+.cc-status {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  padding-top: 11px;
+}
+
+.cc-status-line {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.cc-status-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--desk-warning);
+}
+
+.cc-status-dot[data-running="true"] {
+  background: var(--kit-ok);
+}
+
+.cc-status-label {
+  flex: 1;
+  color: var(--desk-fg-1);
+  font-size: var(--desk-text-ui);
