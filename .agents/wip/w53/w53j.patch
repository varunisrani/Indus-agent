+            <ChevronDown aria-hidden="true" size={13} />
+          </button>
+          {others && (
+            <div className="sb-others-list">
+              {rest_.map((row) => (
+                <ChoiceCard
+                  key={row.name}
+                  title={row.label}
+                  {...(row.description ? { body: row.description } : {})}
+                  {...(row.configured ? { pill: t("settings.accounts2.keySaved") } : {})}
+                  onClick={() => go?.({ view: "providers", page: "keys" })}
