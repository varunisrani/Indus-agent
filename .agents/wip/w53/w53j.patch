+// Settings › Notifications (W52-j): Desktop alerts (a master switch over the two kinds we can
+// detect, a test notification) and Sounds (our one completion chime, with a preview).
+
+import { Bell, Play } from "lucide-react";
+import { useState } from "react";
+import { playChime } from "../../ambient/sound.ts";
+import { useT } from "../../i18n/index.tsx";
+import { attempt, usePrefs, useSettings } from "../context.tsx";
+import { CompactSelect, OutlineButton, PageBody, SettingRow, Switch } from "../primitives.tsx";
+import { Note, notAvailable } from "./kit.tsx";
+
+export function AlertsPage() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const { prefs, error, update } = usePrefs(bridge);
+  const [tested, setTested] = useState<{ text: string; error: boolean } | null>(null);
+  const kinds = prefs?.notifications;
+  // the master switch is a view over both kinds (W52-B-10): on when both are on
+  const allOn = kinds === undefined ? true : kinds.turnComplete || kinds.approvals;
+  const rows = [
+    {
+      id: "approvals",
+      row: "notify-approvals",
+      label: "settings.notify.approvalNeeded",
+      body: "settings.notify.approvalNeededBody",
+    },
+    {
+      id: "turnComplete",
+      row: "notify-turn",
+      label: "settings.notify.replyReady",
+      body: "settings.notify.replyReadyBody",
+    },
+  ] as const;
+  const notifications = bridge?.notifications;
+  return (
+    <PageBody intro={t("settings.notify.intro")}>
+      <SettingRow
+        rowId="notify-all"
+        title={t("settings.notify.all")}
+        description={t("settings.notify.allBody")}
+        control={
+          <Switch
+            label={t("settings.notify.all")}
+            checked={allOn}
+            disabled={prefs === null}
+            onChange={(on) => void update({ notifications: { turnComplete: on, approvals: on } })}
+          />
+        }
+      />
+      {rows.map((row) => (
+        <SettingRow
+          key={row.id}
+          rowId={row.row}
+          highlighted={focusRow === row.row}
+          title={t(row.label)}
+          description={t(row.body)}
+          control={
+            <Switch
+              label={t(row.label)}
+              checked={kinds?.[row.id] ?? true}
+              disabled={prefs === null || !allOn}
+              onChange={(checked) => void update({ notifications: { [row.id]: checked } })}
+            />
+          }
+        />
+      ))}
+      <Note text={notAvailable(t, error)} error />
+      <div className="sb-after-rows" data-row="notify-test">
+        <OutlineButton
+          icon={<Bell aria-hidden="true" size={14} />}
+          disabled={notifications === undefined}
+          onClick={async () => {
+            const answer = await attempt(
+              notifications
+                ? () =>
+                    notifications.show({
+                      title: t("app.name"),
+                      body: t("settings.notify.testBody"),
+                    })
+                : null,
+            );
+            setTested(
+              answer.ok
+                ? {
+                    text: t(
+                      answer.value.shown ? "settings.notify.sent" : "settings.notify.notShown",
+                    ),
+                    error: !answer.value.shown,
+                  }
+                : { text: answer.message, error: true },
+            );
+          }}
+        >
+          {t("settings.notify.test")}
+        </OutlineButton>
+        <Note text={tested?.text ?? null} error={tested?.error ?? false} />
+        <p className="sb-footnote">{t("settings.notify.footnote")}</p>
+      </div>
+    </PageBody>
+  );
+}
+
+export function SoundsPage() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const { prefs, error, update } = usePrefs(bridge);
+  const on = prefs?.notifications.sounds ?? true;
+  return (
+    <PageBody>
+      <SettingRow
+        rowId="notify-sounds"
+        highlighted={focusRow === "notify-sounds"}
+        title={t("settings.sounds.title")}
+        description={t("settings.sounds.body")}
+        control={
+          <>
+            <CompactSelect
+              label={t("settings.sounds.title")}
+              value={on ? "chime" : "off"}
+              disabled={prefs === null}
+              options={[
+                { value: "off", label: t("settings.sounds.off") },
+                { value: "chime", label: t("settings.sounds.chime") },
+              ]}
+              onChange={(value) => void update({ notifications: { sounds: value === "chime" } })}
+            />
+            <OutlineButton
+              icon={<Play aria-hidden="true" size={13} />}
+              disabled={!on}
+              onClick={() => playChime()}
+            >
+              {t("settings.sounds.preview")}
+            </OutlineButton>
+            <Note text={notAvailable(t, error)} error />
+          </>
+        }
+      />
+    </PageBody>
+  );
+}
diff --git a/apps/desktop/src/settings/pagesB/pagesB.css b/apps/desktop/src/settings/pagesB/pagesB.css
new file mode 100644
index 0000000..7386d2c
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/pagesB.css
@@ -0,0 +1,835 @@
+/* Settings-b page bodies (W52-j): key chips and key rows, choice / mode cards, endpoint cards and
+   the form card, the update and facts cards, the About column. Tokens only (--desk-*). */
+
+.sb-status {
+  display: block;
+  margin-top: 2px;
+  color: var(--desk-fg-3);
+}
+
+.sb-status[data-error="true"] {
+  color: var(--desk-danger);
+}
+
+.sb-mono {
+  font-family: var(--indus-font-mono);
+  font-size: 12px;
+  color: var(--desk-fg-3);
+  overflow-wrap: anywhere;
+}
+
+.sb-mono-title {
+  overflow-wrap: anywhere;
+}
+
+.sb-faint {
+  color: var(--desk-fg-3);
+}
+
+.sb-full {
+  width: 100%;
+}
+
+.sb-stack {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-end;
+  gap: 6px;
+}
+
+.sb-end {
+  justify-content: flex-end;
+}
+
+.sb-caption {
+  margin: 4px 0 8px;
+  color: var(--desk-fg-2);
+  font-size: var(--desk-text-small);
+  font-weight: 500;
+}
+
+.sb-after-rows {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+  padding-top: 12px;
+}
+
+.sb-footnote {
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+.sb-intro-line {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.sb-intro-line > .settings-intro {
+  margin: 0;
+}
+
+/* borderless search (providers, shortcuts) */
+.sb-search {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  height: 32px;
+  margin: 6px 0;
+  color: var(--desk-fg-4);
+  border-bottom: 1px solid transparent;
+}
+
+.sb-search:focus-within {
+  border-bottom-color: var(--desk-stroke-1);
+  color: var(--desk-fg-3);
+}
+
+.sb-search input {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: 12.5px;
+}
+
+.sb-search input::placeholder {
+  color: var(--desk-fg-4);
+}
+
+.sb-search input:focus-visible {
+  outline: none;
+}
+
+/* key chips */
+.sb-chips {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.sb-kbd {
