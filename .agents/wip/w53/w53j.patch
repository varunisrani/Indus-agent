new file mode 100644
index 0000000..cd1a471
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/about.tsx
@@ -0,0 +1,185 @@
+// Settings › About (W52-j): Version & updates (name and version, the update card, the update
+// channel, a facts card, the desktop log behind a fold) and Uninstall (its own page).
+
+import { ExternalLink, FileText, RefreshCw } from "lucide-react";
+import { useEffect, useState } from "react";
+import { LogsViewer } from "../../app/LogsViewer.tsx";
+import type { IndusUninstallSummary, IndusUpdateStatus } from "../../global.d.ts";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { attempt, useSettings } from "../context.tsx";
+import {
+  CompactSelect,
+  PageBody,
+  PrimaryButton,
+  SectionHeading,
+  SettingRow,
+  TextButton,
+} from "../primitives.tsx";
+import { UninstallSection } from "../UninstallSection.tsx";
+import { Note, notAvailable, relativeTime, useUpdates } from "./kit.tsx";
+
+const TITLES: Readonly<Record<IndusUpdateStatus["state"], MessageKey>> = {
+  idle: "settings.about2.upToDate",
+  checking: "settings.updates.checking",
+  available: "settings.about2.available",
+  downloading: "settings.about2.available",
+  ready: "settings.updates.ready",
+  installing: "settings.updates.installing",
+  error: "settings.about2.failed",
+  manual: "settings.updates.manual",
+};
+
+function UpdateCard(props: { updates: ReturnType<typeof useUpdates> }) {
+  const t = useT();
+  const { bridge } = useSettings();
+  const status = props.updates.status;
+  const tone =
+    status?.state === "error"
+      ? "danger"
+      : status?.state === "available" ||
+          status?.state === "downloading" ||
+          status?.state === "ready"
+        ? "accent"
+        : "neutral";
+  const checked = relativeTime(t, status?.checkedAt);
+  const external = bridge?.external;
+  return (
+    <div className="sb-update" data-tone={tone}>
+      <p className="sb-update-title">
+        {status === null ? "—" : t(TITLES[status.state], { version: status.version ?? "" })}
+      </p>
+      {status?.state === "error" && status.error !== undefined && (
+        <p className="sb-update-body">{status.error}</p>
+      )}
+      {status?.progress !== undefined && status.state === "downloading" && (
+        <progress className="sb-progress" max={1} value={status.progress} />
+      )}
+      {status?.manualHint !== undefined && <code className="sb-mono">{status.manualHint}</code>}
+      {checked !== null && (
+        <p className="sb-update-body">{t("settings.about2.checked", { when: checked })}</p>
+      )}
+      <Note text={notAvailable(t, props.updates.error)} error />
+      <div className="sb-update-foot">
+        <TextButton
+          icon={<RefreshCw aria-hidden="true" size={13} />}
+          onClick={() => void props.updates.check()}
+        >
+          {t("settings.about2.checkNow")}
+        </TextButton>
+        {status?.state === "ready" && (
+          <PrimaryButton onClick={() => void props.updates.apply()}>
+            {t("settings.about2.restart")}
+          </PrimaryButton>
+        )}
+        {status?.downloadUrl !== undefined && external && (
+          <TextButton
+            icon={<ExternalLink aria-hidden="true" size={13} />}
+            onClick={() => void attempt(() => external.open({ url: status.downloadUrl as string }))}
+          >
+            {t("settings.about2.download")}
+          </TextButton>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export function AboutPage() {
+  const t = useT();
+  const { bridge, focusRow } = useSettings();
+  const updates = useUpdates(bridge);
+  const [backend, setBackend] = useState<string | null>(null);
+  const [summary, setSummary] = useState<IndusUninstallSummary | null>(null);
+  const [logsOpen, setLogsOpen] = useState(focusRow === "logs");
+  const connection = bridge?.connection;
+  const uninstall = bridge?.uninstall;
+  useEffect(() => {
+    void attempt(connection ? () => connection.get() : null).then((answer) => {
+      if (answer.ok) setBackend(answer.value.codeVersion);
+    });
+  }, [connection]);
+  useEffect(() => {
+    void attempt(uninstall ? () => uninstall.summary() : null).then((answer) => {
+      if (answer.ok) setSummary(answer.value);
+    });
+  }, [uninstall]);
+  const status = updates.status;
+  const version = bridge?.facts?.appVersion ?? "—";
+  const channel =
+    status === null
+      ? "—"
+      : t(status.channel === "canary" ? "settings.updates.canary" : "settings.updates.stable");
+  return (
+    <PageBody>
+      <div
+        className="sb-about"
+        data-row="version"
+        data-highlighted={focusRow === "version" ? "true" : undefined}
+      >
+        <div className="sb-hero">
+          <span className="sb-hero-mark">INDUS AGENT</span>
+          <span className="sb-hero-name">{t("settings.about2.name")}</span>
+          <span className="sb-hero-version">{t("settings.about2.version", { version })}</span>
+        </div>
+        <SectionHeading
+          icon={<RefreshCw aria-hidden="true" />}
+          title={t("settings.updates.title")}
+        />
+        <UpdateCard updates={updates} />
+        <SettingRow
+          rowId="update-channel"
+          highlighted={focusRow === "update-channel"}
+          title={t("settings.updates.channel")}
+          control={
+            <CompactSelect
+              label={t("settings.updates.channel")}
+              value={status?.channel ?? "stable"}
+              disabled={status === null}
+              options={[
+                { value: "stable", label: t("settings.updates.stable") },
+                { value: "canary", label: t("settings.updates.canary") },
+              ]}
+              onChange={(value) =>
+                void updates.setChannel(value === "canary" ? "canary" : "stable")
+              }
+            />
+          }
+        />
+        <dl className="sb-facts">
+          <dt>{t("settings.about2.appVersion")}</dt>
+          <dd>{version}</dd>
+          <dt>{t("settings.about.backend")}</dt>
+          <dd>{backend ?? "—"}</dd>
+          <dt>{t("settings.updates.channel")}</dt>
+          <dd>{channel}</dd>
+          <dt>{t("settings.about2.installType")}</dt>
+          <dd>{summary?.installKind ?? "—"}</dd>
+          <dt>{t("settings.about2.home")}</dt>
+          <dd className="sb-mono">{summary?.home ?? "—"}</dd>
+        </dl>
+        <div data-row="logs" data-highlighted={focusRow === "logs" ? "true" : undefined}>
+          <SectionHeading icon={<FileText aria-hidden="true" />} title={t("settings.logs.title")} />
+          <TextButton aria-expanded={logsOpen} onClick={() => setLogsOpen(!logsOpen)}>
+            {t(logsOpen ? "settings.about2.hideLines" : "settings.about2.showLines")}
+          </TextButton>
+          {logsOpen && <LogsViewer />}
+        </div>
+      </div>
+    </PageBody>
+  );
+}
+
+export function UninstallPage() {
+  const { bridge, focusRow } = useSettings();
+  return (
+    <PageBody>
+      <div
+        className="sb-about"
+        data-row="uninstall"
+        data-highlighted={focusRow === "uninstall" ? "true" : undefined}
+      >
+        <UninstallSection uninstall={bridge?.uninstall} />
+      </div>
+    </PageBody>
+  );
+}
diff --git a/apps/desktop/src/settings/pagesB/advanced.tsx b/apps/desktop/src/settings/pagesB/advanced.tsx
new file mode 100644
index 0000000..cba0f84
--- /dev/null
+++ b/apps/desktop/src/settings/pagesB/advanced.tsx
@@ -0,0 +1,222 @@
+// Settings › Advanced (W52-j): Desktop & startup (keep awake, quick entry and its shortcut, run
+// onboarding again) and Profiles (rename / delete through the window's switcher).
+
+import { useCallback, useEffect, useState } from "react";
+import type { IndusKeepAwakeMode } from "../../global.d.ts";
+import { useT } from "../../i18n/index.tsx";
+import { useSwitcher } from "../../profiles/switcherReact.tsx";
+import { usePrefs, useSettings } from "../context.tsx";
+import { normalizeAccelerator } from "../keybindings.ts";
+import {
+  OutlineButton,
+  PageBody,
+  Segmented,
+  SettingRow,
+  Switch,
+  TextField,
+} from "../primitives.tsx";
+import { rest } from "../settingsApi.ts";
+import { KeyCapture, Note, notAvailable, shortcutStatus, useShortcutsView } from "./kit.tsx";
+
+export function AdvancedDesktopPage() {
+  const t = useT();
+  const { bridge, focusRow, openOnboarding } = useSettings();
+  const { prefs, error, update } = usePrefs(bridge);
+  const shortcuts = useShortcutsView(bridge);
+  const [invalid, setInvalid] = useState(false);
+  const platform = bridge?.facts?.platform ?? "linux";
+  const quick = shortcuts.view?.shortcuts.find((s) => s.action === "quick-entry");
+  const status = shortcutStatus(t, shortcuts.view, "quick-entry", (action) =>
+    t(
+      action === "hud-toggle"
+        ? "settings.key.hudToggle"
+        : action === "hud-snap"
+          ? "settings.key.hudSnap"
+          : "settings.key.quickEntry",
+    ),
+  );
+  return (
+    <PageBody>
+      <SettingRow
+        rowId="keep-awake"
+        highlighted={focusRow === "keep-awake"}
+        title={t("settings.keepAwake.title")}
+        description={t("settings.keepAwake.body")}
+        control={
+          <>
+            <Segmented<IndusKeepAwakeMode>
+              label={t("settings.keepAwake.title")}
+              value={prefs?.keepAwake ?? "while-working"}
+              options={[
+                { value: "never", label: t("settings.keepAwake.never") },
+                { value: "while-working", label: t("settings.keepAwake.working") },
+                { value: "always", label: t("settings.keepAwake.always") },
+              ]}
+              onChange={(value) => void update({ keepAwake: value })}
+            />
+            <Note text={notAvailable(t, error)} error />
+          </>
+        }
+      />
+      <SettingRow
+        rowId="quick-entry-on"
+        title={t("settings.quickEntryOn.title")}
+        description={t("settings.quickEntryOn.body")}
+        control={
+          <>
+            <Switch
+              label={t("settings.quickEntryOn.title")}
+              checked={quick?.enabled ?? true}
+              disabled={shortcuts.view === null}
+              onChange={(enabled) => void shortcuts.set({ action: "quick-entry", enabled })}
+            />
+            <Note text={notAvailable(t, shortcuts.error)} error />
+          </>
+        }
+      />
+      <SettingRow
+        rowId="quick-entry"
+        highlighted={focusRow === "quick-entry"}
+        title={t("settings.quickEntry.title")}
+        description={
+          <>
+            {t("settings.quickEntry.body")}
+            {status !== null && (
+              <span className="sb-status" data-error={status.error ? "true" : undefined}>
+                {status.text}
+              </span>
+            )}
+          </>
+        }
+        control={
+          <>
+            <KeyCapture
+              label={t("settings.quickEntry.title")}
+              platform={platform}
+              value={prefs?.quickEntryShortcut ?? ""}
+              onCommit={async (accelerator) => {
+                if (accelerator !== "" && normalizeAccelerator(accelerator) === null) {
+                  setInvalid(true);
+                  return;
+                }
+                setInvalid(false);
+                await update({ quickEntryShortcut: accelerator });
+                shortcuts.reload();
+              }}
+            />
+            {invalid && <Note text={t("settings.key.invalid")} error />}
+          </>
+        }
+      />
+      <SettingRow
+        rowId="run-onboarding"
+        highlighted={focusRow === "run-onboarding"}
+        title={t("settings.onboardingAgain.title")}
+        description={t("settings.onboardingAgain.body")}
+        control={
+          <OutlineButton onClick={openOnboarding}>
+            {t("settings.onboardingAgain.run")}
+          </OutlineButton>
+        }
+      />
+    </PageBody>
+  );
+}
+
+/**
+ * Rename and delete through the window's switcher (P20-26): it leaves the profile and has main tear
+ * down that profile's connection first, runs the backend change, then migrates or drops every
+ * profile-keyed store (R08.7).
+ */
+export function ProfilesPage() {
+  const t = useT();
+  const { api } = useSettings();
+  const switcher = useSwitcher();
+  const [names, setNames] = useState<readonly string[] | null>(null);
+  const [drafts, setDrafts] = useState<Readonly<Record<string, string>>>({});
+  const [error, setError] = useState<string | null>(null);
+  const load = useCallback(() => {
+    void rest<{ profiles: Array<{ name: string }> }>(api, "GET", "/api/profiles").then((answer) => {
+      if (answer.ok) setNames(answer.data.profiles.map((row) => row.name));
+      else setError(answer.message);
+    });
+  }, [api]);
+  useEffect(load, [load]);
+  const run = async (change: () => Promise<{ ok: boolean; message: string }>) => {
+    const answer = await change();
+    if (!answer.ok) throw new Error(answer.message);
+  };
+  const rename = async (from: string) => {
+    const to = (drafts[from] ?? "").trim();
+    if (to === "" || to === from || switcher === null) return;
+    const result = await switcher.renameProfile(from, to, () =>
+      run(async () => {
+        const answer = await rest(api, "PATCH", `/api/profiles/${encodeURIComponent(from)}`, {
+          body: { new_name: to },
+        });
+        return { ok: answer.ok, message: answer.ok ? "" : answer.message };
+      }),
+    );
+    if (result.ok) {
+      setError(null);
+      load();
+    } else setError(result.error);
+  };
+  const remove = async (name: string) => {
+    if (switcher === null) return;
+    if (!window.confirm(t("settings.profiles.confirmDelete", { name }))) return;
+    const result = await switcher.deleteProfile(name, () =>
+      run(async () => {
+        const answer = await rest(api, "DELETE", `/api/profiles/${encodeURIComponent(name)}`);
+        return { ok: answer.ok, message: answer.ok ? "" : answer.message };
+      }),
+    );
+    if (result.ok) {
+      setError(null);
+      load();
+    } else setError(result.error);
+  };
+  return (
+    <PageBody intro={t("settings.profiles.body")}>
+      <div data-row="profiles">
+        {(names ?? []).map((name) =>
+          name === "default" ? (
+            <SettingRow key={name} title={name} description={t("settings.profiles.defaultFixed")} />
+          ) : (
+            <SettingRow
+              key={name}
+              title={name}
+              control={
+                <span className="settings-inline">
+                  <TextField
+                    aria-label={t("settings.profiles.newName", { name })}
+                    placeholder={t("settings.profiles.newNameHint")}
+                    value={drafts[name] ?? ""}
+                    onChange={(event) => {
+                      const value = event.currentTarget.value;
+                      setDrafts((current) => ({ ...current, [name]: value }));
+                    }}
+                  />
+                  <OutlineButton
+                    disabled={switcher === null || (drafts[name] ?? "").trim() === ""}
+                    onClick={() => void rename(name)}
+                  >
+                    {t("settings.profiles.rename")}
+                  </OutlineButton>
+                  <OutlineButton
+                    aria-label={t("settings.profiles.delete", { name })}
+                    disabled={switcher === null}
+                    onClick={() => void remove(name)}
+                  >
+                    {t("settings.profiles.deleteShort")}
+                  </OutlineButton>
+                </span>
+              }
+            />
+          ),
+        )}
+      </div>
+      <Note text={error} error />
+    </PageBody>
+  );
+}
