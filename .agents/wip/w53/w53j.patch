+// How a schema field reads on a settings page (W52-j, settings-b): a short label and an optional
+// one-line description in our words, plus how an open string is offered (a placeholder, a fixed
+// option list or suggestions). Fields without an entry fall back to the label derived from the key
+// and the backend's own description.
+
+export interface FieldCopy {
+  readonly label: string;
+  readonly description?: string;
+  /** Shown in an empty text field (default "Not set"). An empty description hides the schema's. */
+  readonly placeholder?: string;
+  /** A string field offered as a compact select (an unknown stored value stays selectable). */
+  readonly options?: readonly { readonly value: string; readonly label: string }[];
+  /** A string field offered as a free text box with suggestions. */
+  readonly suggestions?: readonly string[];
+}
+
+const opts = (...values: string[]) => values.map((value) => ({ value, label: value }));
+
