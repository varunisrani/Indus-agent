diff --git a/apps/web/src/console/consoleSession.ts b/apps/web/src/console/consoleSession.ts
new file mode 100644
index 0000000..8f1c564
--- /dev/null
+++ b/apps/web/src/console/consoleSession.ts
@@ -0,0 +1,234 @@
+// The admin console's line discipline (W52-f). The terminal is the input line: this class prints
+// the prompt, echoes what is typed, keeps a history, and turns Enter / Ctrl+C / the confirm answer
+// into frames for `/api/console`. Frames from the server are printed back. It knows nothing about
+// React or xterm: the modal gives it a `ConsoleTerminal` (a fake one in tests) and a `send`.
+
+export interface ConsoleTerminal {
+  open(parent: HTMLElement): void;
+  write(text: string): void;
+  onData(listener: (data: string) => void): () => void;
+  /** Resize to the parent's box. */
+  fit(): void;
+  focus(): void;
+  dispose(): void;
+}
+
+export type ConsolePhase = "connecting" | "ready" | "running" | "closed" | "error";
+
+export const HISTORY_LIMIT = 200;
+export const CONFIRM_PROMPT = "Confirm? [y/N] ";
+
+const RED = "\x1b[31m";
+const YELLOW = "\x1b[33m";
+const DIM = "\x1b[2m";
+const RESET = "\x1b[0m";
+const CLEAR_SCREEN = "\x1b[2J\x1b[3J\x1b[H";
+
+function textOf(value: unknown): string {
+  return typeof value === "string" ? value : "";
+}
+
+/** "\n" → "\r\n" so the terminal returns to column 0. */
+export function terminalText(text: string): string {
+  return text.replace(/\r?\n/g, "\r\n");
+}
+
+export class ConsoleSession {
+  phase: ConsolePhase = "connecting";
+  profile = "";
+  prompt = "indus> ";
+  private buffer = "";
+  private readonly history: string[] = [];
+  private cursor = 0;
+  private confirming: string | null = null;
+  private term: ConsoleTerminal | null = null;
+  private queued: string[] = [];
+  private atLineStart = true;
+
+  private readonly send: (frame: Record<string, unknown>) => void;
+  private readonly changed: () => void;
+  private readonly exit: () => void;
+
+  constructor(
+    send: (frame: Record<string, unknown>) => void,
+    changed: () => void,
+    exit: () => void,
+  ) {
+    this.send = send;
+    this.changed = changed;
+    this.exit = exit;
+  }
+
+  /** Give the session its screen; anything printed before is replayed. */
+  attach(term: ConsoleTerminal): void {
+    this.term = term;
+    for (const text of this.queued) term.write(text);
+    this.queued = [];
+  }
+
+  private out(text: string): void {
+    if (!text) return;
+    const normal = terminalText(text);
+    this.atLineStart = normal.endsWith("\n");
+    if (this.term) this.term.write(normal);
+    else this.queued.push(normal);
+  }
+
+  private newLine(): void {
+    if (!this.atLineStart) this.out("\n");
+  }
+
+  private setPhase(phase: ConsolePhase): void {
+    this.phase = phase;
+    this.changed();
+  }
+
+  private showPrompt(): void {
+    this.newLine();
+    this.out(this.confirming !== null ? CONFIRM_PROMPT : this.prompt);
+    this.atLineStart = false;
+  }
+
+  /** A red line (refusals, close reasons, connect failures). */
+  fail(message: string, phase: ConsolePhase = "closed"): void {
+    this.newLine();
+    this.out(`${RED}${message}${RESET}\n`);
+    this.confirming = null;
+    this.setPhase(phase);
+  }
+
+  /** Back to the start for a new connection. */
+  reset(): void {
+    this.buffer = "";
+    this.confirming = null;
+    this.setPhase("connecting");
+  }
+
+  frame(frame: Record<string, unknown>): void {
+    switch (frame.type) {
+      case "ready":
+        this.profile = textOf(frame.profile);
+        if (typeof frame.prompt === "string") this.prompt = frame.prompt;
+        this.setPhase("ready");
+        this.showPrompt();
+        return;
+      case "output": {
+        const data = textOf(frame.data);
+        this.out(frame.stream === "stderr" ? `${RED}${data}${RESET}` : data);
+        if (data.endsWith("\n")) this.atLineStart = true;
+        return;
+      }
+      case "error":
+        this.newLine();
+        this.out(`${RED}${textOf(frame.message)}${RESET}\n`);
+        return;
+      case "confirm_required":
+        this.confirming = textOf(frame.command);
+        this.newLine();
+        this.out(`${YELLOW}${textOf(frame.message)} ${textOf(frame.command)}${RESET}\n`);
+        this.buffer = "";
+        this.setPhase("ready");
+        this.showPrompt();
+        return;
+      case "clear":
+        this.out(CLEAR_SCREEN);
+        this.atLineStart = true;
+        return;
+      case "complete":
+        if (typeof frame.prompt === "string") this.prompt = frame.prompt;
+        if (frame.status === "exit") {
+          this.setPhase("closed");
+          this.exit();
+          return;
+        }
+        if (frame.status === "confirm_required") return; // already asking
+        if (frame.status === "cancelled") {
+          this.newLine();
+          this.out(`${DIM}Cancelled.${RESET}\n`);
+        }
+        this.confirming = null;
+        this.buffer = "";
+        this.setPhase("ready");
+        this.showPrompt();
+        return;
+      default:
+        return;
+    }
+  }
+
+  private replaceLine(next: string): void {
+    this.buffer = next;
+    this.out(`\r\x1b[K${this.confirming !== null ? CONFIRM_PROMPT : this.prompt}${next}`);
+    this.atLineStart = false;
+  }
+
+  private enter(): void {
+    const line = this.buffer.trim();
+    this.buffer = "";
+    this.out("\n");
+    if (this.confirming !== null) {
+      const command = this.confirming;
+      this.confirming = null;
+      const yes = line.toLowerCase() === "y" || line.toLowerCase() === "yes";
+      this.send(yes ? { type: "confirm", command } : { type: "cancel" });
+      this.setPhase("running");
+      return;
+    }
+    if (!line) {
+      this.showPrompt();
+      return;
+    }
+    if (this.history.at(-1) !== line) this.history.push(line);
+    if (this.history.length > HISTORY_LIMIT) this.history.shift();
+    this.cursor = this.history.length;
+    this.send({ type: "input", line });
+    this.setPhase("running");
+  }
+
+  private interrupt(): void {
+    this.out("^C\n");
+    this.buffer = "";
+    if (this.phase === "running" || this.confirming !== null) {
+      this.confirming = null;
+      this.send({ type: "cancel" });
+      return;
+    }
+    this.showPrompt();
+  }
+
+  /** Keys and pasted text from the terminal. */
+  input(data: string): void {
+    if (data === "\x03") {
+      if (this.phase === "ready" || this.phase === "running") this.interrupt();
+      return;
+    }
+    if (this.phase !== "ready") return;
+    if (data === "\x0c") {
+      this.out(CLEAR_SCREEN);
+      this.replaceLine(this.buffer);
+      return;
+    }
+    if (data === "\x1b[A" || data === "\x1b[B") {
+      if (this.confirming !== null || this.history.length === 0) return;
+      const step = data === "\x1b[A" ? -1 : 1;
+      this.cursor = Math.max(0, Math.min(this.history.length, this.cursor + step));
+      this.replaceLine(this.history[this.cursor] ?? "");
+      return;
+    }
+    if (data.startsWith("\x1b")) return; // other keys (arrows sideways, function keys)
+    for (const char of data) {
+      if (this.phase !== "ready") return;
+      if (char === "\r" || char === "\n") {
+        this.enter();
+      } else if (char === "\x7f" || char === "\b") {
+        if (this.buffer) {
+          this.buffer = this.buffer.slice(0, -1);
+          this.out("\b \b");
+        }
+      } else if (char >= " ") {
+        this.buffer += char;
+        this.out(char);
+      }
+    }
+  }
+}
diff --git a/apps/web/src/console/consoleTerminal.ts b/apps/web/src/console/consoleTerminal.ts
new file mode 100644
index 0000000..e59d4c9
--- /dev/null
+++ b/apps/web/src/console/consoleTerminal.ts
@@ -0,0 +1,81 @@
+// The real screen for the admin console: xterm.js with the fit and Unicode 11 addons (the chat's
+// packages; DOM renderer only, the console is small). Colours follow the active theme: black with
+// warm text on dark, a pale canvas with dark text on light.
+
+import { ansi } from "@indus/ui";
+import type { ConsoleTerminal } from "./consoleSession.ts";
+
+export type ConsoleTerminalFactory = () => Promise<ConsoleTerminal>;
+
+function dark(): boolean {
+  const set = document.documentElement.dataset.theme;
+  if (set === "indus-dark") return true;
+  if (set === "indus-light") return false;
+  return (
+    typeof window.matchMedia === "function" &&
+    window.matchMedia("(prefers-color-scheme: dark)").matches
+  );
+}
+
+/** xterm colours for the console in the active theme. */
+export function consoleColours(): Record<string, string> {
+  const isDark = dark();
+  const map = ansi[isDark ? "indus-dark" : "indus-light"];
+  const background = isDark ? "#000000" : "#f5f8fc";
+  const foreground = isDark ? "#f0e6d2" : "#170d02";
+  return {
+    ...map,
+    background,
+    foreground,
+    cursor: foreground,
+    cursorAccent: background,
+    selectionBackground: isDark ? "#3a3a3a" : "#c8d8f0",
+  };
+}
+
+export const createConsoleTerminal: ConsoleTerminalFactory = async () => {
+  const [{ Terminal }, { FitAddon }, { Unicode11Addon }] = await Promise.all([
+    import("@xterm/xterm"),
+    import("@xterm/addon-fit"),
+    import("@xterm/addon-unicode11"),
+    import("@xterm/xterm/css/xterm.css"),
+  ]);
+  const mono = getComputedStyle(document.documentElement).getPropertyValue("--font-mono").trim();
+  const term = new Terminal({
+    allowProposedApi: true, // the Unicode 11 width table is a proposed API
+    cursorBlink: true,
+    fontFamily: mono || "ui-monospace, SFMono-Regular, Menlo, monospace",
+    fontSize: 13,
+    lineHeight: 1.25,
+    scrollback: 3_000,
+    theme: consoleColours(),
+  });
+  const fit = new FitAddon();
+  term.loadAddon(fit);
+  term.loadAddon(new Unicode11Addon());
+  term.unicode.activeVersion = "11";
+  const restyle = new MutationObserver(() => {
+    term.options.theme = consoleColours();
+  });
+  restyle.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
+  return {
+    open: (parent) => term.open(parent),
+    write: (text) => term.write(text),
+    onData: (listener) => {
+      const sub = term.onData(listener);
+      return () => sub.dispose();
+    },
+    fit: () => {
+      try {
+        fit.fit();
+      } catch {
+        // parent not laid out yet
+      }
+    },
+    focus: () => term.focus(),
+    dispose: () => {
+      restyle.disconnect();
+      term.dispose();
+    },
+  };
+};
