+// The read-only YAML view (W52-pc-10): the settings the config file itself sets, from the
+// effective entries whose source is the file, nested by key and written as YAML. Values arrive
+// redacted. There is no raw-file endpoint yet, so nothing here writes.
+
+import { useQuery } from "@tanstack/react-query";
+import { FileText } from "lucide-react";
+import { api } from "../../lib/api.ts";
+import { nestEntries, toYaml } from "../../lib/yaml.ts";
+import { Card, CardHeader, Loading, QueryState } from "../../ui/controls.tsx";
+
+export const EMPTY_YAML = "# config.yaml has no settings yet\n";
+
+export function YamlView() {
+  const effective = useQuery({
+    queryKey: ["config", "effective"],
+    queryFn: () => api.config.effective(),
+  });
+  const fromFile = (effective.data?.entries ?? []).filter((entry) => entry.source === "file");
+  const text = toYaml(nestEntries(fromFile)) || EMPTY_YAML;
+  return (
+    <Card padded={false}>
+      <CardHeader icon={FileText} title="Raw YAML configuration" />
+      {effective.isPending ? (
+        <div className="flex justify-center py-12">
+          <Loading />
+        </div>
+      ) : (
+        <QueryState
+          loading={false}
+          error={effective.error}
+          onRetry={() => void effective.refetch()}
+        >
+          <textarea
+            aria-label="Raw YAML configuration"
+            readOnly
+            spellCheck={false}
+            value={text}
+            className="type-data block min-h-[600px] w-full resize-y border-0 bg-transparent px-4 py-3 text-[0.8125rem] leading-[21px] text-ink outline-none"
+          />
+        </QueryState>
+      )}
+    </Card>
+  );
+}
diff --git a/apps/web/src/pages/config/categories.ts b/apps/web/src/pages/config/categories.ts
new file mode 100644
index 0000000..345041e
--- /dev/null
+++ b/apps/web/src/pages/config/categories.ts
@@ -0,0 +1,123 @@
+// Config sections: their order, names, icons, and the field search (W52-e, Config page).
+
+import {
+  Bot,
+  Brain,
+  ClipboardList,
+  Clock,
+  Cpu,
+  Database,
+  Ear,
+  FileQuestionMark,
+  Globe,
+  KeyRound,
+  Layers,
+  ListChecks,
+  Lock,
+  MessageCircle,
+  MessageSquare,
+  Mic,
+  Monitor,
+  Package,
+  Palette,
+  Plug,
+  Radio,
+  Route,
+  Server,
+  Settings,
+  ShieldCheck,
+  Sparkles,
+  Users,
+  Volume2,
+  Webhook,
+  Wrench,
+} from "lucide-react";
+import type { ComponentType } from "react";
+import type { ConfigField, ConfigSchema } from "../../lib/restTypes.ts";
+
+type Icon = ComponentType<{ className?: string }>;
+
+/** Each icon with the sections drawn with it; a section not listed gets the question-mark file. */
+const ICON_GROUPS: ReadonlyArray<readonly [Icon, readonly string[]]> = [
+  [Cpu, ["model", "model_catalog"]],
+  [Server, ["providers"]],
+  [Route, ["fallback"]],
+  [Bot, ["agent"]],
+  [Settings, ["general"]],
+  [Monitor, ["terminal", "tui", "dashboard"]],
+  [Palette, ["display"]],
+  [Globe, ["browser", "web", "egress", "network"]],
+  [Lock, ["security"]],
+  [ShieldCheck, ["approvals"]],
+  [ListChecks, ["command_allowlist"]],
+  [Package, ["compression", "tool_output"]],
+  [Brain, ["memory", "learning"]],
+  [Users, ["delegation"]],
+  [Sparkles, ["skills", "curator"]],
+  [Layers, ["toolsets"]],
+  [Wrench, ["auxiliary", "tools"]],
+  [Plug, ["mcp", "plugins"]],
+  [Radio, ["gateway", "messaging", "platforms"]],
+  [MessageSquare, ["sessions", "session", "session_search"]],
+  [MessageCircle, ["prompt", "discord"]],
+  [Database, ["database"]],
+  [ClipboardList, ["logging"]],
+  [Clock, ["cron"]],
+  [Webhook, ["webhooks"]],
+  [KeyRound, ["secrets"]],
+  [Mic, ["voice"]],
+  [Volume2, ["tts"]],
+  [Ear, ["stt"]],
+];
+
+const ICONS: ReadonlyMap<string, Icon> = new Map(
+  ICON_GROUPS.flatMap(([icon, sections]) => sections.map((section) => [section, icon] as const)),
+);
+
+const NAMES: Record<string, string> = {
+  tts: "Text-to-speech",
+  stt: "Speech-to-text",
+  mcp: "MCP",
+};
+
+export function categoryIcon(category: string): Icon {
+  return ICONS.get(category) ?? FileQuestionMark;
+}
+
+/** "fallback_providers" → "Fallback providers". */
+export function categoryName(category: string): string {
+  const named = NAMES[category];
+  if (named) return named;
+  const words = category.replace(/_/g, " ");
+  return words.charAt(0).toUpperCase() + words.slice(1);
+}
+
+/** A field's label: its last key segment with `_` as spaces. */
+export function fieldLabel(key: string): string {
+  return (key.split(".").pop() ?? key).replace(/_/g, " ");
+}
+
+export function fieldCategory(field: ConfigField): string {
+  return field.category || "general";
+}
+
+/** Categories in the schema's order (unknown ones after it, alphabetically). */
+export function orderedCategories(schema: ConfigSchema): string[] {
+  const order = schema.category_order;
+  const present = [...new Set(Object.values(schema.fields).map(fieldCategory))];
+  const rank = (c: string) => {
+    const i = order.indexOf(c);
+    return i < 0 ? order.length : i;
+  };
+  return present.sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
+}
+
+/** True when the query matches the key, the label, the category or the description. */
+export function fieldMatches(key: string, field: ConfigField, query: string): boolean {
+  const q = query.trim().toLowerCase();
+  if (!q) return true;
+  const category = fieldCategory(field);
+  return [key, fieldLabel(key), category, categoryName(category), field.description].some((text) =>
+    text.toLowerCase().includes(q),
+  );
+}
