@@ -0,0 +1,91 @@
+// IMPORT (ours): make a profile from an exported archive on this machine.
+
+import { useMutation } from "@tanstack/react-query";
+import { type FormEvent, useId, useState } from "react";
+import { api } from "../../lib/api.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { Button, inputClass, Notice } from "../../ui/controls.tsx";
+import { cx } from "../../ui/cx.ts";
+import { Modal } from "../../ui/Dialog.tsx";
+import { labelClass } from "./ProfileEditorDialog.tsx";
+import { normaliseProfileName, profileNameProblem } from "./profileName.ts";
+import { useProfilesChanged } from "./useProfilesChanged.ts";
+
+export function ImportProfileDialog({
+  existing,
+  onClose,
+}: {
+  existing: readonly string[];
+  onClose: () => void;
+}) {
+  const toast = useToast();
+  const changed = useProfilesChanged();
+  const ids = useId();
+  const [archive, setArchive] = useState("");
+  const [name, setName] = useState("");
+  const [problem, setProblem] = useState("");
+  const run = useMutation({
+    mutationFn: () => api.profile.importArchive(archive.trim(), normaliseProfileName(name)),
+    onSuccess: (reply) => {
+      toast.show(`Profile ${reply.name} imported.`, "success");
+      changed();
+      onClose();
+    },
+    onError: (error) => setProblem(errorText(error)),
+  });
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    if (!archive.trim().startsWith("/")) {
+      setProblem("Give the archive's full path on this machine.");
+      return;
+    }
+    const nameProblem = name.trim() ? profileNameProblem(name, existing) : null;
+    if (nameProblem) {
+      setProblem(nameProblem);
+      return;
+    }
+    run.mutate();
+  };
+  return (
+    <Modal
+      open
+      onOpenChange={(open) => {
+        if (!open) onClose();
+      }}
+      title="Import a profile"
+      description="Settings only: an export carries no history, secrets or channel state."
+    >
+      <form className="flex flex-col gap-4 py-1" onSubmit={submit} noValidate>
+        <div className="flex flex-col gap-1.5">
+          <label htmlFor={`${ids}-archive`} className={labelClass}>
+            Archive path
+          </label>
+          <input
+            id={`${ids}-archive`}
+            className={cx(inputClass, "w-full font-mono")}
+            placeholder="/path/to/profile.zip"
+            value={archive}
+            onChange={(e) => setArchive(e.currentTarget.value)}
+          />
+        </div>
+        <div className="flex flex-col gap-1.5">
+          <label htmlFor={`${ids}-name`} className={labelClass}>
+            Name (optional)
+          </label>
+          <input
+            id={`${ids}-name`}
+            className={cx(inputClass, "w-full")}
+            value={name}
+            onChange={(e) => setName(e.currentTarget.value)}
+          />
+        </div>
+        {problem ? <Notice tone="danger">{problem}</Notice> : null}
+        <div className="flex justify-end">
+          <Button type="submit" tone="primary" size="sm" disabled={run.isPending}>
+            Import
+          </Button>
+        </div>
+      </form>
+    </Modal>
+  );
+}
diff --git a/apps/web/src/pages/profiles/ProfileActionsMenu.tsx b/apps/web/src/pages/profiles/ProfileActionsMenu.tsx
new file mode 100644
index 0000000..194edfa
--- /dev/null
+++ b/apps/web/src/pages/profiles/ProfileActionsMenu.tsx
@@ -0,0 +1,108 @@
+// A profile card's three-dot menu: set as active, the three editors, skills, the CLI command,
+// export, then rename and delete (never offered for the default profile; disabled for the profile
+// this dashboard serves).
+
+import {
+  Check,
+  Cpu,
+  Download,
+  Package,
+  Pencil,
+  SquareTerminal,
+  TextAlignStart,
+  Trash,
+} from "lucide-react";
+import type { ProfileSummary } from "../../lib/restTypes.ts";
+import { Menu, MenuDivider, MenuItem } from "../../ui/Menu.tsx";
+import type { EditorKind } from "./ProfileEditorDialog.tsx";
+
+export function lockedReason(profile: ProfileSummary): string | null {
+  if (profile.is_default) return "The default profile cannot be renamed or deleted.";
+  if (profile.is_current) return "This dashboard serves this profile; change it from elsewhere.";
+  return null;
+}
+
+/** The persona item's glyph: a bold letter in an icon-sized slot. */
+function PersonaGlyph() {
+  return (
+    <span
+      aria-hidden="true"
+      className="inline-flex size-4 shrink-0 items-center justify-center text-[0.8125rem] font-bold"
+    >
+      P
+    </span>
+  );
+}
+
+export function ProfileActionsMenu({
+  profile,
+  stickyPending,
+  onSticky,
+  onEdit,
+  onSkills,
+  onCopyCommand,
+  onExport,
+  onRename,
+  onDelete,
+}: {
+  profile: ProfileSummary;
+  stickyPending: boolean;
+  onSticky: () => void;
+  onEdit: (kind: EditorKind) => void;
+  onSkills: () => void;
+  onCopyCommand: () => void;
+  onExport: () => void;
+  onRename: () => void;
+  onDelete: () => void;
+}) {
+  const locked = lockedReason(profile);
+  return (
+    <Menu label="Actions" className="-mt-1 -mr-1 ml-auto">
+      {profile.is_sticky ? null : (
+        <MenuItem icon={<Check />} disabled={stickyPending} onSelect={onSticky}>
+          Set as active
+        </MenuItem>
+      )}
+      <MenuItem icon={<Cpu />} onSelect={() => onEdit("model")}>
+        Change model
+      </MenuItem>
+      <MenuItem icon={<TextAlignStart />} onSelect={() => onEdit("description")}>
+        Edit description
+      </MenuItem>
+      <MenuItem icon={<PersonaGlyph />} onSelect={() => onEdit("persona")}>
+        Edit persona
+      </MenuItem>
+      <MenuItem icon={<Package />} onSelect={onSkills}>
+        Manage skills &amp; tools
+      </MenuItem>
+      <MenuItem icon={<SquareTerminal />} onSelect={onCopyCommand}>
+        Copy CLI command
+      </MenuItem>
+      <MenuItem icon={<Download />} onSelect={onExport}>
+        Export
+      </MenuItem>
+      {profile.is_default ? null : (
+        <>
+          <MenuDivider />
+          <MenuItem
+            icon={<Pencil />}
+            disabled={locked !== null}
+            title={locked ?? undefined}
+            onSelect={onRename}
+          >
+            Rename
+          </MenuItem>
+          <MenuItem
+            icon={<Trash />}
+            danger
+            disabled={locked !== null}
+            title={locked ?? undefined}
+            onSelect={onDelete}
+          >
+            Delete
+          </MenuItem>
+        </>
+      )}
+    </Menu>
+  );
+}
diff --git a/apps/web/src/pages/profiles/ProfileCard.tsx b/apps/web/src/pages/profiles/ProfileCard.tsx
new file mode 100644
index 0000000..9043da2
--- /dev/null
+++ b/apps/web/src/pages/profiles/ProfileCard.tsx
@@ -0,0 +1,213 @@
+// One profile as a square card: name and state badges with the actions menu, the daemon line, the
+// description, and a meta block (model, enabled skills). Rename happens inline in the card.
+
+import { useMutation, useQuery } from "@tanstack/react-query";
+import { type FormEvent, useState } from "react";
+import { useNavigate } from "react-router";
+import { api } from "../../lib/api.ts";
+import type { ProfileSummary } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { ActionLog } from "../../ui/ActionLog.tsx";
+import { Badge, Button, inputClass } from "../../ui/controls.tsx";
+import { cx } from "../../ui/cx.ts";
+import { NAME_RULE } from "./CreateProfileDialog.tsx";
+import { ProfileActionsMenu } from "./ProfileActionsMenu.tsx";
+import type { EditorKind } from "./ProfileEditorDialog.tsx";
+import { normaliseProfileName, profileNameProblem } from "./profileName.ts";
+import { useProfilesChanged } from "./useProfilesChanged.ts";
+
+/** "Daemon running" in green, else "Daemon stopped"; hidden when the status cannot be read. */
+function DaemonLine({ name }: { name: string }) {
+  const status = useQuery({
+    queryKey: ["profiles", "status", name],
+    queryFn: () => api.statusOf(name),
+    staleTime: 15_000,
+  });
+  if (!status.data) return null;
+  const running = status.data.daemon.state === "running";
+  return (
+    <p
+      className={cx(
+        "m-0 flex items-center gap-2 text-[0.75rem]",
+        running ? "text-success" : "text-ink-muted",
+      )}
+    >
+      <span
+        aria-hidden="true"
+        className={cx("size-1.5 rounded-full", running ? "bg-success" : "bg-ink-faint")}
+      />
+      {running ? "Daemon running" : "Daemon stopped"}
+    </p>
+  );
+}
+
+/** "Skills: N" (enabled skills), hidden when the list cannot be read. */
+function SkillsLine({ name }: { name: string }) {
+  const skills = useQuery({
+    queryKey: ["profiles", "skills", name],
+    queryFn: () => api.skills.list(name),
+    staleTime: 30_000,
+  });
+  if (!skills.data) return null;
+  return <span>Skills: {skills.data.skills.filter((s) => s.enabled).length}</span>;
+}
+
+export function ProfileCard({
+  profile,
+  others,
+  onEdit,
+  onDelete,
+}: {
+  profile: ProfileSummary;
+  others: string[];
+  onEdit: (kind: EditorKind) => void;
+  onDelete: () => void;
+}) {
+  const toast = useToast();
+  const changed = useProfilesChanged();
+  const navigate = useNavigate();
+  const [renaming, setRenaming] = useState(false);
+  const [newName, setNewName] = useState(profile.name);
+  const [exportRun, setExportRun] = useState(0);
+  const [archive, setArchive] = useState("");
+  const renameProblem = renaming ? profileNameProblem(newName, others) : null;
+
+  const sticky = useMutation({
+    mutationFn: () => api.profile.setSticky(profile.name),
+    onSuccess: () => {
+      toast.show(`New CLI runs now use ${profile.name}.`, "success");
+      changed();
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+  const rename = useMutation({
+    mutationFn: () => api.profile.rename(profile.name, normaliseProfileName(newName)),
+    onSuccess: (reply) => {
+      setRenaming(false);
+      toast.show(`${profile.name} is now ${reply.name}.`, "success");
+      changed();
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+  const exporting = useMutation({
+    mutationFn: () => api.profile.exportArchive(profile.name),
+    onSuccess: (reply) => {
+      setArchive(reply.archive);
+      setExportRun((n) => n + 1);
+    },
+    onError: (error) => toast.show(errorText(error), "error"),
+  });
+
+  const copyCommand = async () => {
+    const command = `indus -p ${profile.name}`;
+    try {
+      await navigator.clipboard.writeText(command);
+      toast.show(`Command copied: ${command}`, "success");
+    } catch {
+      toast.show("Could not copy the command; the browser refused the clipboard.", "error");
+    }
+  };
+
+  const submitRename = (event: FormEvent) => {
+    event.preventDefault();
+    if (renameProblem === null && !rename.isPending) rename.mutate();
+  };
+
+  const modelLine = profile.model
+    ? `${profile.model}${profile.provider ? ` (${profile.provider})` : ""}`
+    : "inherited";
+
+  return (
+    <li data-testid={`profile-${profile.name}`} className="flex">
+      <article className="flex min-h-[165px] min-w-0 flex-1 flex-col gap-2 border border-line bg-canvas p-4">
+        <div className="flex min-w-0 items-center gap-1.5">
+          <h3 className="m-0 mr-1 truncate text-[0.8125rem] font-medium text-ink">
+            {profile.name}
+          </h3>
+          {profile.is_sticky ? <Badge tone="ok">active</Badge> : null}
+          {profile.is_default ? <Badge tone="secondary">default</Badge> : null}
+          {profile.is_current ? <Badge className="text-ink-muted">this dashboard</Badge> : null}
+          <ProfileActionsMenu
+            profile={profile}
+            stickyPending={sticky.isPending}
+            onSticky={() => sticky.mutate()}
+            onEdit={onEdit}
+            onSkills={() => void navigate(`/skills?profile=${encodeURIComponent(profile.name)}`)}
+            onCopyCommand={() => void copyCommand()}
+            onExport={() => exporting.mutate()}
+            onRename={() => {
+              setNewName(profile.name);
+              setRenaming(true);
+            }}
+            onDelete={onDelete}
+          />
+        </div>
+
+        {renaming ? (
+          <form className="flex flex-col gap-2" onSubmit={submitRename} noValidate>
+            <input
+              aria-label="New name"
+              // biome-ignore lint/a11y/noAutofocus: rename starts from the menu; typing follows
+              autoFocus
+              className={cx(inputClass, "w-full")}
+              aria-invalid={renameProblem !== null}
+              value={newName}
+              onChange={(e) => setNewName(e.currentTarget.value)}
+              onKeyDown={(e) => {
+                if (e.key === "Escape") setRenaming(false);
+              }}
+            />
+            <p
+              className={cx("m-0 text-[0.75rem]", renameProblem ? "text-danger" : "text-ink-soft")}
+            >
+              {renameProblem ?? NAME_RULE}
+            </p>
+            <div className="flex gap-2">
+              <Button
+                type="submit"
+                tone="primary"
+                size="sm"
+                disabled={renameProblem !== null || rename.isPending}
+              >
+                Save
+              </Button>
+              <Button tone="ghost" size="sm" onClick={() => setRenaming(false)}>
+                Cancel
+              </Button>
+            </div>
+          </form>
+        ) : (
+          <>
+            <DaemonLine name={profile.name} />
+            {profile.description ? (
+              <p className="m-0 line-clamp-2 text-[0.75rem] text-ink-muted">
+                {profile.description}
+              </p>
+            ) : (
+              <p className="m-0 text-[0.75rem] text-ink-faint italic">No description</p>
+            )}
+            <div className="mt-auto flex flex-col pt-2 text-[0.75rem] leading-[17px] text-ink-muted">
+              <span>Model: {modelLine}</span>
+              <SkillsLine name={profile.name} />
+            </div>
+          </>
+        )}
+
+        {exportRun > 0 ? (
+          <div className="flex flex-col gap-2 border-t border-line pt-2">
+            <ActionLog
+              name="profile-export"
+              run={exportRun}
+              profile={profile.name}
+              title={`Export of ${profile.name}`}
+            />
+            <p className="m-0 text-[0.75rem] text-ink-muted">
+              Archive: <code className="type-data break-all">{archive}</code> (settings only: no
+              history, secrets or channel state).
+            </p>
+          </div>
+        ) : null}
+      </article>
+    </li>
+  );
+}
diff --git a/apps/web/src/pages/profiles/ProfileEditorDialog.tsx b/apps/web/src/pages/profiles/ProfileEditorDialog.tsx
new file mode 100644
index 0000000..58f67bb
--- /dev/null
+++ b/apps/web/src/pages/profiles/ProfileEditorDialog.tsx
@@ -0,0 +1,193 @@
+// One editor dialog per profile action (W52-pc-2): the model, the description or the persona.
+
+import { useMutation, useQuery } from "@tanstack/react-query";
+import { type FormEvent, useEffect, useId, useState } from "react";
+import { api } from "../../lib/api.ts";
+import type { ProfileSummary } from "../../lib/restTypes.ts";
+import { errorText, useToast } from "../../shell/Toasts.tsx";
+import { Button, inputClass, Notice, Select } from "../../ui/controls.tsx";
+import { cx } from "../../ui/cx.ts";
+import { Modal } from "../../ui/Dialog.tsx";
+import { useProfilesChanged } from "./useProfilesChanged.ts";
+
+export type EditorKind = "model" | "description" | "persona";
+
+const TITLES: Record<EditorKind, string> = {
+  model: "Change model",
+  description: "Edit description",
+  persona: "Edit persona",
+};
+
+const DESCRIPTIONS: Record<EditorKind, string> = {
+  model: "New sessions in this profile start on this model.",
+  description: "A line about what this profile is for, shown on its card.",
+  persona: "How the agent behaves in this profile; added to every session's instructions.",
+};
+
+export const labelClass = "type-label text-[0.6875rem] tracking-[0.1em] text-ink";
+
+/** A provider select and a model name input on one row (no per-provider model list exists). */
+export function ModelFields({
+  provider,
+  model,
+  onProvider,
+  onModel,
+}: {
+  provider: string;
+  model: string;
+  onProvider: (next: string) => void;
+  onModel: (next: string) => void;
+}) {
+  const ids = useId();
+  const options = useQuery({
+    queryKey: ["profiles", "model-options"],
+    queryFn: () => api.model.options(),
+  });
+  const providers = options.data?.providers ?? [];
+  const known = providers.some((p) => p.name === provider);
+  return (
+    <div className="grid grid-cols-1 gap-2 sm:grid-cols-2">
+      <div className="flex flex-col gap-1.5">
+        <label htmlFor={`${ids}-provider`} className={labelClass}>
+          Provider
+        </label>
+        <Select
