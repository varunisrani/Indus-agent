diff --git a/apps/desktop/src/chat/composer/AttachMenu.tsx b/apps/desktop/src/chat/composer/AttachMenu.tsx
new file mode 100644
index 0000000..c5c9ea4
--- /dev/null
+++ b/apps/desktop/src/chat/composer/AttachMenu.tsx
@@ -0,0 +1,250 @@
+// The composer's `+` menu (W52-h): files, a folder reference, images, a URL reference and prompt
+// snippets. Files and images become attachments (the existing local / remote path rules apply);
+// a folder or URL is inserted as an `@folder:` / `@url:` reference the backend expands. Paste
+// image is shown disabled: the renderer cannot read clipboard images through our bridge (Ctrl+V
+// in the editor still attaches them).
+
+import {
+  ClipboardPaste,
+  File,
+  FolderOpen,
+  Image,
+  Link,
+  MessageSquareText,
+  Plus,
+  ScanSearch,
+  Wand,
+} from "lucide-react";
+import { type FormEvent, useCallback, useRef, useState } from "react";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import {
+  Button,
+  MenuLabel,
+  MenuPanel,
+  MenuRow,
+  MenuSeparator,
+  SmallDialog,
+} from "../../ui/components.tsx";
+
+export type PickMode = "files" | "folder" | "images";
+
+/** The `@folder:` reference for a picked folder: relative to the chat's folder when inside it. */
+export function folderReference(path: string, cwd: string | null): string {
+  let shown = path;
+  if (cwd !== null && cwd !== "") {
+    const base = cwd.endsWith("/") ? cwd : `${cwd}/`;
+    if (path === cwd) shown = ".";
+    else if (path.startsWith(base)) shown = path.slice(base.length);
+  }
+  return `@folder:${shown.includes(" ") ? `"${shown}"` : shown}`;
+}
+
+/** A URL a reference may carry (http or https only), or null. */
+export function cleanUrl(text: string): string | null {
+  try {
+    const url = new URL(text.trim());
+    return url.protocol === "http:" || url.protocol === "https:" ? url.toString() : null;
+  } catch {
+    return null;
+  }
+}
+
+export const SNIPPETS: ReadonlyArray<{
+  id: string;
+  icon: typeof File;
+  label: MessageKey;
+  hint: MessageKey;
+  text: MessageKey;
+}> = [
+  {
+    id: "review",
+    icon: ScanSearch,
+    label: "attach.snippet.review",
+    hint: "attach.snippet.reviewHint",
+    text: "attach.snippet.reviewText",
+  },
+  {
+    id: "plan",
+    icon: Wand,
+    label: "attach.snippet.plan",
+    hint: "attach.snippet.planHint",
+    text: "attach.snippet.planText",
+  },
+  {
+    id: "explain",
+    icon: MessageSquareText,
+    label: "attach.snippet.explain",
+    hint: "attach.snippet.explainHint",
+    text: "attach.snippet.explainText",
+  },
+];
+
+export function AttachMenu(props: {
+  /** Ask main for paths; resolves with the chosen ones (empty when cancelled). */
+  pick: ((mode: PickMode) => Promise<string[]>) | null;
+  /** Picked files / images become attachments. */
+  onFiles: (paths: string[]) => void;
+  /** Text inserted at the caret (references, snippets). */
+  onInsert: (text: string) => void;
+  cwd: string | null;
+}) {
+  const t = useT();
+  const [open, setOpen] = useState(false);
+  const [dialog, setDialog] = useState<"url" | "snippets" | null>(null);
+  const [url, setUrl] = useState("");
+  const [urlError, setUrlError] = useState(false);
+  const trigger = useRef<HTMLButtonElement>(null);
+  const close = useCallback(() => setOpen(false), []);
+  const choose = (run: () => void) => {
+    setOpen(false);
+    run();
+  };
+  const pickInto = async (mode: PickMode) => {
+    if (props.pick === null) return;
+    const paths = await props.pick(mode);
+    if (paths.length === 0) return;
+    if (mode === "folder") {
+      props.onInsert(paths.map((path) => folderReference(path, props.cwd)).join(" "));
+    } else props.onFiles(paths);
+  };
+  const submitUrl = (event: FormEvent) => {
+    event.preventDefault();
+    const clean = cleanUrl(url);
+    if (clean === null) {
+      setUrlError(true);
+      return;
+    }
+    props.onInsert(`@url:${clean}`);
+    setDialog(null);
+    setUrl("");
+    setUrlError(false);
+  };
+  const noPicker = props.pick === null;
+  return (
+    <div className="desk-menu-root composer-attach-root">
+      <button
+        ref={trigger}
+        type="button"
+        className="desk-icon-btn composer-attach"
+        aria-label={t("composer.attach")}
+        aria-haspopup="menu"
+        aria-expanded={open}
+        onClick={() => setOpen(!open)}
+      >
+        <Plus aria-hidden="true" />
+      </button>
+      {open && (
+        <MenuPanel
+          label={t("attach.menu")}
+          onClose={close}
+          keepOpenFor={trigger}
+          className="composer-attach-menu"
+        >
+          <MenuLabel>{t("attach.menu")}</MenuLabel>
+          <MenuRow
+            icon={<File aria-hidden="true" />}
+            label={t("attach.files")}
+            disabled={noPicker}
+            onSelect={() => choose(() => void pickInto("files"))}
+          />
+          <MenuRow
+            icon={<FolderOpen aria-hidden="true" />}
+            label={t("attach.folder")}
+            disabled={noPicker}
+            onSelect={() => choose(() => void pickInto("folder"))}
+          />
+          <MenuRow
+            icon={<Image aria-hidden="true" />}
+            label={t("attach.images")}
+            disabled={noPicker}
+            onSelect={() => choose(() => void pickInto("images"))}
+          />
+          <MenuRow
+            icon={<ClipboardPaste aria-hidden="true" />}
+            label={t("attach.paste")}
+            disabled
+            onSelect={() => undefined}
+          />
+          <MenuRow
+            icon={<Link aria-hidden="true" />}
+            label={t("attach.url")}
+            onSelect={() => choose(() => setDialog("url"))}
+          />
+          <MenuSeparator />
+          <MenuRow
+            icon={<MessageSquareText aria-hidden="true" />}
+            label={t("attach.snippets")}
+            onSelect={() => choose(() => setDialog("snippets"))}
+          />
+          <MenuSeparator />
+          <p className="composer-attach-tip">
+            {t("attach.tipBefore")} <kbd className="desk-kbd">@</kbd> {t("attach.tipAfter")}
+          </p>
+        </MenuPanel>
+      )}
+      {dialog === "url" && (
+        <SmallDialog
+          title={t("attach.urlTitle")}
+          description={t("attach.urlHint")}
+          onClose={() => setDialog(null)}
+        >
+          <form className="composer-url-form" onSubmit={submitUrl}>
+            <input
+              className="desk-input"
+              type="url"
+              aria-label={t("attach.urlField")}
+              placeholder="https://"
+              value={url}
+              aria-invalid={urlError}
+              onChange={(event) => {
+                setUrl(event.target.value);
+                setUrlError(false);
+              }}
+            />
+            {urlError && (
+              <p role="alert" className="composer-url-error">
+                {t("attach.urlInvalid")}
+              </p>
+            )}
+            <div className="desk-dialog-actions">
+              <Button variant="ghost" onClick={() => setDialog(null)}>
+                {t("attach.cancel")}
+              </Button>
+              <Button variant="primary" type="submit">
+                {t("attach.urlAdd")}
+              </Button>
+            </div>
+          </form>
+        </SmallDialog>
+      )}
+      {dialog === "snippets" && (
+        <SmallDialog
+          title={t("attach.snippetsTitle")}
+          description={t("attach.snippetsHint")}
+          onClose={() => setDialog(null)}
+        >
+          <ul className="composer-snippets">
+            {SNIPPETS.map((snippet) => (
+              <li key={snippet.id}>
+                <button
+                  type="button"
+                  className="composer-snippet"
+                  onClick={() => {
+                    props.onInsert(t(snippet.text));
+                    setDialog(null);
+                  }}
+                >
+                  <snippet.icon aria-hidden="true" size={16} />
+                  <span>
+                    <strong>{t(snippet.label)}</strong>
+                    <small>{t(snippet.hint)}</small>
+                  </span>
+                </button>
+              </li>
+            ))}
+          </ul>
+        </SmallDialog>
+      )}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/composer/CompletionDrawer.tsx b/apps/desktop/src/chat/composer/CompletionDrawer.tsx
new file mode 100644
index 0000000..6d383df
--- /dev/null
+++ b/apps/desktop/src/chat/composer/CompletionDrawer.tsx
@@ -0,0 +1,198 @@
+// The composer's completion drawer (W52-h): slash commands grouped by catalogue category, `@`
+// references with a glyph per kind, an empty and a "looking" state. Keys stay in the composer
+// (the textarea keeps focus; a mouse-down here never blurs it).
+
+import type { CompletionItem } from "@indus/protocol";
+import {
+  Columns2,
+  File,
+  Folder,
+  GitBranch,
+  Globe,
+  LoaderCircle,
+  Puzzle,
+  SquareTerminal,
+} from "lucide-react";
+import { Fragment, type ReactNode, useEffect, useRef } from "react";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { useHoverTip } from "../../ui/components.tsx";
+import { CATEGORY_ORDER, categoryOf } from "../slash.ts";
+import type { CompletionState } from "./completion.ts";
+
+export interface DrawerGroup {
+  /** Catalogue category, "other", a mention scope, or null for an unlabelled list. */
+  readonly key: string | null;
+  readonly items: ReadonlyArray<{ item: CompletionItem; index: number }>;
+}
+
+/**
+ * The rows in display groups. Slash items group by category in catalogue order (unknown names —
+ * plugins, skills — last as "other"). The source already sorted the flat list the same way
+ * (`orderByCategory`), so the arrow keys walk the rows in the order they are shown.
+ */
+export function groupItems(state: CompletionState): DrawerGroup[] {
+  const trigger = state.trigger;
+  if (trigger === null) return [];
+  const indexed = state.items.map((item, index) => ({ item, index }));
+  if (trigger.kind === "mention") {
+    const word = trigger.word.toLowerCase();
+    const scope = word.startsWith("@file:")
+      ? "file"
+      : word.startsWith("@folder:")
+        ? "folder"
+        : null;
+    return [{ key: scope, items: indexed }];
+  }
+  const groups = new Map<string, Array<{ item: CompletionItem; index: number }>>();
+  for (const entry of indexed) {
+    const key = categoryOf(entry.item.text) ?? "other";
+    const list = groups.get(key) ?? [];
+    list.push(entry);
+    groups.set(key, list);
+  }
+  const rank = (key: string) => {
+    const at = CATEGORY_ORDER.indexOf(key);
+    return at === -1 ? CATEGORY_ORDER.length : at;
+  };
+  return [...groups.entries()]
+    .sort((a, b) => rank(a[0]) - rank(b[0]))
+    .map(([key, items]) => ({ key, items }));
+}
+
+const GROUP_KEYS: Readonly<Record<string, MessageKey>> = {
+  session: "drawer.group.session",
+  config: "drawer.group.config",
+  tools: "drawer.group.tools",
+  info: "drawer.group.info",
+  exit: "drawer.group.exit",
+  other: "drawer.group.other",
+  file: "drawer.scope.file",
+  folder: "drawer.scope.folder",
+};
+
+/** The glyph and its tone for one row. */
+export function iconFor(
+  kind: "slash" | "mention",
+  item: CompletionItem,
+): {
+  icon: ReactNode;
+  tone: "accent" | "muted";
+} {
+  const size = { "aria-hidden": true as const };
+  if (kind === "slash") {
+    return categoryOf(item.text) === null
+      ? { icon: <Puzzle {...size} />, tone: "muted" }
+      : { icon: <SquareTerminal {...size} />, tone: "accent" };
+  }
+  const text = item.text.replace(/^@/, "").toLowerCase();
+  if (text.startsWith("diff")) return { icon: <Columns2 {...size} />, tone: "accent" };
+  if (text.startsWith("git:")) return { icon: <GitBranch {...size} />, tone: "accent" };
+  if (text.startsWith("url:")) return { icon: <Globe {...size} />, tone: "accent" };
+  if (text.startsWith("folder:") || text.endsWith("/"))
+    return { icon: <Folder {...size} />, tone: "muted" };
+  return { icon: <File {...size} />, tone: "muted" };
+}
+
+function Row(props: {
+  item: CompletionItem;
+  index: number;
+  kind: "slash" | "mention";
+  listId: string;
+  selected: boolean;
+  onPick: (item: CompletionItem) => void;
+}) {
+  const { icon, tone } = iconFor(props.kind, props.item);
+  const ref = useRef<HTMLDivElement>(null);
+  const hover = useHoverTip(props.item.meta ? props.item.meta : null);
+  useEffect(() => {
+    // keep the highlighted row in view inside the drawer only (never scroll the transcript)
+    const row = ref.current;
+    const box = row?.parentElement?.closest(".desk-popover");
+    if (!props.selected || row === null || !(box instanceof HTMLElement)) return;
+    const top = row.offsetTop;
+    if (top < box.scrollTop) box.scrollTop = top - 4;
+    else if (top + row.offsetHeight > box.scrollTop + box.clientHeight)
+      box.scrollTop = top + row.offsetHeight - box.clientHeight + 4;
+  }, [props.selected]);
+  return (
+    <div
+      ref={ref}
+      id={`${props.listId}-${props.index}`}
+      role="option"
+      tabIndex={-1}
+      aria-selected={props.selected}
+      className="desk-popover-row"
+      onMouseDown={(event) => {
+        event.preventDefault();
+        props.onPick(props.item);
+      }}
+      {...hover.bind}
+    >
+      <span className="desk-popover-icon" data-tone={tone}>
+        {icon}
+      </span>
+      <span className="desk-popover-name">{props.item.display}</span>
+      {props.item.meta ? <span className="desk-popover-meta">{props.item.meta}</span> : null}
+      {hover.tip}
+    </div>
+  );
+}
+
+export function CompletionDrawer(props: {
+  state: CompletionState;
+  listId: string;
+  onPick: (item: CompletionItem) => void;
+}) {
+  const t = useT();
+  const { state } = props;
+  const trigger = state.trigger;
+  if (trigger === null) return null;
+  const groups = groupItems(state);
+  const empty = state.items.length === 0;
+  return (
+    // biome-ignore lint/a11y/noStaticElementInteractions: keeps the editor's focus on a click
+    <div
+      className="desk-popover"
+      data-kind={trigger.kind}
+      onMouseDown={(event) => event.preventDefault()}
+    >
+      {empty ? (
+        state.loading ? (
+          <p className="desk-popover-empty" role="status">
+            <LoaderCircle aria-hidden="true" size={12} className="spin" /> {t("drawer.loading")}
+          </p>
+        ) : (
+          <p className="desk-popover-empty" role="status">
+            {t("drawer.empty")}
+            <span>
+              {t(trigger.kind === "mention" ? "drawer.emptyMention" : "drawer.emptySlash")}
+            </span>
+          </p>
+        )
+      ) : (
+        <div role="listbox" id={props.listId} aria-label={t("composer.completions")}>
+          {groups.map((group) => (
+            <Fragment key={group.key ?? "all"}>
+              {group.key !== null && GROUP_KEYS[group.key] !== undefined ? (
+                <div className="desk-popover-head" role="presentation">
+                  {t(GROUP_KEYS[group.key] as MessageKey)}
+                </div>
+              ) : null}
+              {group.items.map(({ item, index }) => (
+                <Row
+                  key={`${item.text}\u0000${item.display}`}
+                  item={item}
+                  index={index}
+                  kind={trigger.kind}
+                  listId={props.listId}
+                  selected={index === state.selected}
+                  onPick={props.onPick}
+                />
+              ))}
+            </Fragment>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
