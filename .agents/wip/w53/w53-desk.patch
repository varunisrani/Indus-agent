+  label: ReactNode;
+  icon?: ReactNode;
+  hint?: ReactNode;
+  kind?: "item" | "radio" | "check" | "switch";
+  checked?: boolean;
+  tone?: "danger";
+  disabled?: boolean;
+  chevron?: boolean;
+  ariaLabel?: string;
+  onSelect: () => void;
+  onMouseEnter?: () => void;
+}) {
+  const kind = props.kind ?? "item";
+  const role =
+    kind === "radio" ? "menuitemradio" : kind === "item" ? "menuitem" : "menuitemcheckbox";
