+            <p className="desk-dialog-text">{props.description}</p>
+          )}
+          {props.children}
+          {props.actions !== undefined && (
+            <div className="desk-dialog-actions">{props.actions}</div>
+          )}
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
