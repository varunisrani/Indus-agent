+ * outside the title band's drag region so clicks reach it.
+ */
+export function FloatingHud(props: {
+  label: string;
+  width: number;
+  onClose: () => void;
+  children: ReactNode;
+  className?: string;
+  onKeyDown?: (event: React.KeyboardEvent) => void;
