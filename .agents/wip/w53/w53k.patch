@@ -0,0 +1,294 @@
+// The Plugins tab (P24-26, W52-k): one table row per plugin name with its Desktop and Agent
+// halves, each with its own switch (an em dash when the plugin has no such half). "Install from
+// Git" opens a dialog that needs a full 40-character commit. We serve no uninstall route and no
+// catalog, so there is no trash icon and the catalog section starts collapsed with a note.
+
+import { Monitor, Package, RefreshCw } from "lucide-react";
+import { type FormEvent, useState } from "react";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { type RestLike, rest } from "../../settings/settingsApi.ts";
+import { Button, IconButton, SmallDialog } from "../../ui/components.tsx";
+import { BottomSection, EmptyPanel, RowSwitch } from "../masterDetail.tsx";
+import { notify } from "../Toasts.tsx";
+import {
+  type AgentPluginRow,
+  type DesktopPluginRow,
+  FULL_SHA,
+  field,
+  mergePlugins,
+  type PluginBadge,
+  useList,
+} from "./shared.ts";
+
+const BADGE_KEYS: Record<PluginBadge, MessageKey> = {
+  agent: "plugins.badge.agent",
+  desktop: "plugins.badge.desktop",
+  both: "plugins.badge.both",
+};
+
+export function PluginsTab(props: {
+  api: RestLike | null;
+  profile: string;
+  /** The desktop column (app-level, not reloaded on a profile switch). */
+  desktop: readonly DesktopPluginRow[];
+  /** Turn a desktop plugin on or off; absent: the Desktop switch is read-only. */
+  onDesktopToggle?: (id: string, on: boolean) => void;
+  /** Read both lists again. */
+  onRescan?: () => void;
+  /** The profile picker for the Agent column header (several profiles). */
+  scope?: React.ReactNode;
+}) {
+  const t = useT();
+  const { api, profile } = props;
+  const list = useList<AgentPluginRow>(api, "/api/plugins", profile, field("plugins"));
+  const [installing, setInstalling] = useState(false);
+  const [status, setStatus] = useState("");
+  const rows = mergePlugins(list.rows ?? [], props.desktop);
+
+  const toggle = async (name: string, on: boolean) => {
+    list.setRows((all) => all.map((row) => (row.name === name ? { ...row, enabled: on } : row)));
+    const answer = await rest(
+      api,
+      "POST",
+      `/api/plugins/${encodeURIComponent(name)}/${on ? "enable" : "disable"}`,
+      { profile },
+    );
+    if (!answer.ok) {
+      notify({
+        tone: "error",
+        title: t("capabilities.toggleFailed", { name }),
+        message: answer.message,
+      });
+    }
+    list.reload();
+  };
+
+  const dash = (
+    <span className="cap-dash" aria-hidden="true">
+      —
+    </span>
+  );
+
+  return (
+    <div className="cap-plugins" data-testid="tab-plugins">
+      <div className="cap-plugins-top">
+        <p className="cap-blurb">{t("plugins.blurb")}</p>
+        <span className="cap-toolbar">
+          <Button variant="secondary" size="md" onClick={() => setInstalling(true)}>
+            {t("plugins.installGit")}
+          </Button>
+          <IconButton
+            label={t("plugins.rescan")}
+            icon={<RefreshCw aria-hidden="true" size={14} />}
+            onClick={() => {
+              list.reload();
+              props.onRescan?.();
+            }}
+          />
+        </span>
+      </div>
+      {list.error !== null ? (
+        <EmptyPanel
+          role="alert"
+          title={t("capabilities.loadFailed")}
+          body={list.error}
+          action={
+            <Button variant="outline" size="sm" onClick={list.reload}>
+              {t("capabilities.refresh")}
+            </Button>
+          }
+        />
+      ) : (
+        <div className="cap-table-wrap">
+          <table className="cap-table">
+            <thead>
+              <tr>
+                <th />
+                <th className="cap-col">
+                  <span className="cap-col-head">
+                    <Monitor aria-hidden="true" size={12} />
+                    {t("plugins.desktop")}
+                  </span>
+                </th>
+                <th className="cap-col">
+                  <span className="cap-col-head">
+                    <Package aria-hidden="true" size={12} />
+                    {props.scope ?? (
+                      <span className="cap-col-text">{t("plugins.agentIn", { profile })}</span>
+                    )}
+                  </span>
+                </th>
+              </tr>
+            </thead>
+            <tbody>
+              {rows.map((row) => {
+                const version = row.agent?.version ?? row.desktop?.version ?? null;
+                return (
+                  <tr key={row.name} data-testid={`plugin-${row.name}`}>
+                    <td>
+                      <div className="cap-plugin-line">
+                        <span className="cap-plugin-name">{row.name}</span>
+                        {version !== null && (
+                          <span className="cap-plugin-version">{`v${version.replace(/^v/, "")}`}</span>
+                        )}
+                        <span className="cap-kind-badge" data-badge={row.badge}>
+                          {row.badge !== "agent" && <Monitor aria-hidden="true" size={10} />}
+                          {row.badge !== "desktop" && <Package aria-hidden="true" size={10} />}
+                          {t(BADGE_KEYS[row.badge])}
+                        </span>
+                        {row.agent?.source === "bundled" && (
+                          <span className="md-pill">{t("plugins.bundled")}</span>
+                        )}
+                      </div>
+                      {row.agent !== null && row.agent.description !== "" && (
+                        <p className="cap-plugin-desc">{row.agent.description}</p>
+                      )}
+                    </td>
+                    <td className="cap-col">
+                      {row.desktop === null ? (
+                        dash
+                      ) : (
+                        <RowSwitch
+                          label={t("plugins.enabled", {
+                            name: `${row.name} (${t("plugins.desktop")})`,
+                          })}
+                          checked={row.desktop.enabled}
+                          {...(props.onDesktopToggle === undefined
+                            ? { disabled: true, title: t("plugins.desktopReadOnly") }
+                            : {})}
+                          onChange={(on) => {
+                            if (row.desktop !== null) props.onDesktopToggle?.(row.desktop.id, on);
+                          }}
+                        />
+                      )}
+                    </td>
+                    <td className="cap-col">
+                      {row.agent === null ? (
+                        dash
+                      ) : (
+                        <RowSwitch
+                          label={t("plugins.enabled", { name: row.name })}
+                          checked={row.agent.enabled}
+                          onChange={(on) => void toggle(row.name, on)}
+                        />
+                      )}
+                    </td>
+                  </tr>
+                );
+              })}
+            </tbody>
+          </table>
+          {list.rows !== null && rows.length === 0 && (
+            <div className="cap-plugins-empty">
+              <p>{t("plugins.none")}</p>
+              <p>{t("plugins.noneHint")}</p>
+            </div>
+          )}
+        </div>
+      )}
+      <BottomSection
+        id="capabilities.pluginCatalog"
+        label={t("plugins.catalog")}
+        upper
+        hideLabel={t("plugins.catalog.hide")}
+        showLabel={t("plugins.catalog.show")}
+        hint={t("plugins.catalog.hint")}
+        defaultCollapsed
+        defaultHeight={200}
+      >
+        <p className="cap-hub-empty">{t("plugins.catalog.empty")}</p>
+      </BottomSection>
+      <p className="sr-only" role="status">
+        {status}
+      </p>
+      {installing && (
+        <InstallDialog
+          api={api}
+          profile={profile}
+          onClose={() => setInstalling(false)}
+          onInstalled={(name) => {
+            setInstalling(false);
+            setStatus(t("plugins.installed", { name }));
+            notify({ tone: "success", title: t("plugins.installed", { name }) });
+            list.reload();
+          }}
+        />
+      )}
+    </div>
+  );
+}
+
+function InstallDialog(props: {
+  api: RestLike | null;
+  profile: string;
+  onClose: () => void;
+  onInstalled: (name: string) => void;
+}) {
+  const t = useT();
+  const [source, setSource] = useState("");
+  const [sha, setSha] = useState("");
+  const [shaError, setShaError] = useState(false);
+  const [failure, setFailure] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const install = async (event: FormEvent) => {
+    event.preventDefault();
+    if (!FULL_SHA.test(sha.trim())) {
+      setShaError(true);
+      return;
+    }
+    setShaError(false);
+    setBusy(true);
+    const answer = await rest<{ name?: string }>(props.api, "POST", "/api/plugins/install", {
+      body: { url: source.trim(), sha: sha.trim().toLowerCase() },
+      profile: props.profile,
+      timeoutMs: 300_000,
+    });
+    setBusy(false);
+    if (answer.ok) props.onInstalled(answer.data.name ?? source.trim());
+    else setFailure(answer.message);
+  };
+
+  return (
+    <SmallDialog title={t("plugins.installGit")} onClose={props.onClose}>
+      <form className="cap-form" onSubmit={install}>
+        <label className="cap-form-field">
+          <span>{t("plugins.source")}</span>
+          <input
+            className="desk-input"
+            aria-label={t("plugins.source")}
+            value={source}
+            onChange={(event) => setSource(event.target.value)}
+          />
+        </label>
+        <label className="cap-form-field">
+          <span>{t("plugins.sha")}</span>
+          <input
+            className="desk-input cap-mono"
+            aria-label={t("plugins.sha")}
+            value={sha}
+            onChange={(event) => setSha(event.target.value)}
+          />
+        </label>
+        {shaError && (
+          <p role="alert" className="md-status" data-tone="bad">
+            {t("plugins.badSha")}
+          </p>
+        )}
+        {failure !== null && (
+          <p role="alert" className="md-status" data-tone="bad">
+            {failure}
+          </p>
+        )}
+        <div className="desk-dialog-actions">
+          <Button variant="ghost" size="sm" onClick={props.onClose}>
+            {t("capabilities.cancel")}
+          </Button>
+          <Button type="submit" variant="primary" size="sm" disabled={source.trim() === "" || busy}>
+            {t("plugins.installButton")}
+          </Button>
+        </div>
+      </form>
+    </SmallDialog>
+  );
+}
diff --git a/apps/desktop/src/app/capabilities/SkillsTab.tsx b/apps/desktop/src/app/capabilities/SkillsTab.tsx
new file mode 100644
index 0000000..d89b822
--- /dev/null
+++ b/apps/desktop/src/app/capabilities/SkillsTab.tsx
@@ -0,0 +1,513 @@
+// The Skills tab (P24-26, W52-k): the profile's skills as switch rows (usage count and "learned"
+// origin joined from the learning graph), the chosen skill's detail, and the Skills Hub section
+// under both (our own hub search; installs are confirmed first, deep links too).
+
+import { type FormEvent, useEffect, useMemo, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestLike, rest } from "../../settings/settingsApi.ts";
+import { Button, MenuRow, SmallDialog } from "../../ui/components.tsx";
+import {
+  BottomSection,
+  CapRow,
+  DetailColumn,
+  DetailHeader,
+  EmptyPanel,
+  ListStrip,
+  MasterDetail,
+  MdPill,
+  MetaBox,
+  RowSwitch,
+  TextAction,
+} from "../masterDetail.tsx";
+import { notify } from "../Toasts.tsx";
+import type { HubResult, SkillRow } from "./shared.ts";
+
+export interface SkillUsage {
+  readonly useCount: number;
+  readonly createdBy: "agent" | "user" | null;
+}
+
+export interface ListHandle<T> {
+  rows: T[] | null;
+  reload: () => void;
+  setRows: (update: (rows: T[]) => T[]) => void;
+}
+
+/** "productivity-tools" → "Productivity Tools"; empty → the fallback. */
+export function titleCase(value: string, fallback: string): string {
+  const words = value.trim().replace(/[-_]+/g, " ").split(/\s+/).filter(Boolean);
+  if (words.length === 0) return fallback;
+  return words.map((word) => word.charAt(0).toUpperCase() + word.slice(1)).join(" ");
+}
+
+/** Rows matching `query` (name, description, category), sorted by use (ties by name). */
+export function visibleSkills(
+  rows: readonly SkillRow[],
+  usage: ReadonlyMap<string, SkillUsage>,
+  query: string,
+  mostUsedFirst: boolean,
+): SkillRow[] {
+  const needle = query.trim().toLowerCase();
+  const uses = (row: SkillRow) => usage.get(row.name)?.useCount ?? 0;
+  return rows
+    .filter(
+      (row) =>
+        needle === "" ||
+        `${row.name} ${row.description} ${row.category}`.toLowerCase().includes(needle),
+    )
+    .sort((a, b) => {
+      const diff = mostUsedFirst ? uses(b) - uses(a) : uses(a) - uses(b);
+      return diff !== 0 ? diff : a.name.localeCompare(b.name);
+    });
+}
+
+/** Set every row's switch, one call at a time; answers how many changed. */
+export async function setMany(
+  names: readonly string[],
+  call: (name: string) => Promise<boolean>,
+): Promise<number> {
+  let done = 0;
+  for (const name of names) if (await call(name)) done += 1;
+  return done;
+}
+
+export function SkillsTab(props: {
+  api: RestLike | null;
+  profile: string;
+  list: ListHandle<SkillRow>;
+  query: string;
+  /** A hub identifier from an install deep link: confirmed before anything is called. */
+  pendingInstall?: string | null;
+  onPendingDone?: () => void;
+}) {
+  const t = useT();
+  const { api, profile, list } = props;
+  const [usage, setUsage] = useState<Map<string, SkillUsage>>(new Map());
+  const [mostUsed, setMostUsed] = useState(true);
+  const [chosen, setChosen] = useState<string | null>(null);
+  const [archiving, setArchiving] = useState<string | null>(null);
+
+  // usage and origin from the learning graph (absent on older daemons: everything counts 0)
+  useEffect(() => {
+    let live = true;
+    void rest<{ nodes?: Array<{ id: string } & Partial<SkillUsage>> }>(
+      api,
+      "GET",
+      "/api/learning/graph",
+      { profile },
+    ).then((answer) => {
+      if (!live || !answer.ok) return;
+      const next = new Map<string, SkillUsage>();
+      for (const node of answer.data.nodes ?? []) {
+        if (typeof node.id !== "string" || !node.id.startsWith("skill:")) continue;
+        next.set(node.id.slice("skill:".length), {
+          useCount: typeof node.useCount === "number" ? node.useCount : 0,
+          createdBy:
+            node.createdBy === "agent" || node.createdBy === "user" ? node.createdBy : null,
+        });
+      }
+      setUsage(next);
+    });
+    return () => {
+      live = false;
+    };
+  }, [api, profile]);
+
+  const rows = useMemo(
+    () => visibleSkills(list.rows ?? [], usage, props.query, mostUsed),
+    [list.rows, usage, props.query, mostUsed],
+  );
+  const selected = rows.find((row) => row.name === chosen) ?? rows[0] ?? null;
+
+  const write = async (name: string, enabled: boolean): Promise<boolean> => {
+    list.setRows((all) => all.map((row) => (row.name === name ? { ...row, enabled } : row)));
+    const answer = await rest(api, "POST", "/api/skills/toggle", {
+      body: { name, enabled },
+      profile,
+    });
+    if (!answer.ok) {
+      list.setRows((all) =>
+        all.map((row) => (row.name === name ? { ...row, enabled: !enabled } : row)),
+      );
+      notify({
+        tone: "error",
+        title: t("capabilities.toggleFailed", { name }),
+        message: answer.message,
+      });
+    }
+    return answer.ok;
+  };
+
+  const bulk = async (names: string[], enabled: boolean) => {
+    const count = await setMany(names, (name) => write(name, enabled));
+    notify({ tone: "success", title: t("capabilities.updated", { count }) });
+    list.reload();
+  };
+
+  const all = list.rows ?? [];
+  const allOn = all.length > 0 && all.every((row) => row.enabled);
+  const uses = (name: string) => usage.get(name)?.useCount ?? 0;
+
+  const archive = async () => {
+    if (archiving === null) return;
+    const name = archiving;
+    setArchiving(null);
+    const answer = await rest(
+      api,
+      "DELETE",
+      `/api/learning/nodes/${encodeURIComponent(`skill:${name}`)}`,
+      { profile },
+    );
+    notify(
+      answer.ok
+        ? { tone: "success", title: t("skills.archived", { name }) }
+        : { tone: "error", title: t("skills.archive"), message: answer.message },
+    );
+    list.reload();
+  };
+
+  const uninstall = async (name: string) => {
+    const answer = await rest(api, "POST", "/api/skills/hub/uninstall", {
+      body: { name },
+      profile,
+    });
+    if (!answer.ok)
+      notify({ tone: "error", title: t("skills.uninstall"), message: answer.message });
+    list.reload();
+  };
+
+  const listColumn = (
+    <>
+      <ListStrip
+        sortLabel={t(mostUsed ? "skills.mostUsed" : "skills.leastUsed")}
+        descending={mostUsed}
+        onSort={() => setMostUsed(!mostUsed)}
+        menuLabel={t("capabilities.listMenu")}
+        menu={(close) => (
+          <>
+            <MenuRow
+              kind="switch"
+              label={t("capabilities.all")}
+              checked={allOn}
+              onSelect={() => {
+                close();
+                void bulk(
+                  all.filter((row) => row.enabled === allOn).map((row) => row.name),
+                  !allOn,
+                );
+              }}
+            />
+            <MenuRow
+              label={t("skills.disableUnused")}
+              onSelect={() => {
+                close();
+                void bulk(
+                  all.filter((row) => row.enabled && uses(row.name) === 0).map((row) => row.name),
+                  false,
+                );
+              }}
+            />
+          </>
+        )}
+      />
+      <ul>
+        {rows.map((skill) => {
+          const used = uses(skill.name);
+          const learned = usage.get(skill.name)?.createdBy === "agent";
+          return (
+            <CapRow
+              key={skill.name}
+              title={skill.name}
+              subtitle={titleCase(skill.category, t("skills.general"))}
+              badge={
+                learned ? (
+                  <span className="md-row-badge" data-tone="good">
+                    {t("skills.badge.learned")}
+                  </span>
+                ) : skill.source === "hub" ? (
+                  <span className="md-row-badge">{t("skills.badge.hub")}</span>
+                ) : undefined
+              }
+              {...(used > 0 ? { meta: t("skills.uses", { count: used }) } : {})}
+              selected={selected?.name === skill.name}
+              dim={!skill.enabled}
+              onSelect={() => setChosen(skill.name)}
+              control={
+                <RowSwitch
+                  label={t("skills.enabled", { name: skill.name })}
+                  checked={skill.enabled}
+                  onChange={(on) => void write(skill.name, on)}
+                />
+              }
+            />
+          );
+        })}
+      </ul>
+    </>
+  );
+
+  const detail =
+    selected === null ? null : (
+      <DetailColumn footer={<p className="md-caption-end">{t("capabilities.changesApply")}</p>}>
+        <DetailHeader
+          title={selected.name}
+          pills={
+            <>
+              <MdPill tone="category">{titleCase(selected.category, t("skills.general"))}</MdPill>
+              {usage.get(selected.name)?.createdBy === "agent" ? (
+                <MdPill tone="good">{t("skills.badge.learned")}</MdPill>
+              ) : selected.source === "hub" ? (
+                <MdPill>{t("skills.badge.hub")}</MdPill>
+              ) : null}
+            </>
+          }
+          description={selected.description}
+          actions={
+            <>
+              {selected.source === "hub" && (
+                <TextAction onClick={() => void uninstall(selected.name)}>
+                  {t("skills.uninstall")}
+                </TextAction>
+              )}
+              {usage.get(selected.name)?.createdBy === "agent" && (
+                <TextAction tone="danger" onClick={() => setArchiving(selected.name)}>
+                  {t("skills.archive")}
+                </TextAction>
+              )}
+            </>
+          }
+        />
+        <MetaBox
+          rows={[
+            [t("skills.meta.name"), selected.name],
+            [t("skills.meta.category"), titleCase(selected.category, t("skills.general"))],
+            [t("skills.meta.source"), selected.source],
+            ...(usage.get(selected.name)?.createdBy
+              ? ([
+                  [
+                    t("skills.meta.createdBy"),
+                    t(
+                      usage.get(selected.name)?.createdBy === "agent"
+                        ? "skills.createdBy.agent"
+                        : "skills.createdBy.user",
+                    ),
+                  ],
+                ] as const)
+              : []),
+            [t("skills.meta.uses"), String(uses(selected.name))],
+          ]}
+        />
+      </DetailColumn>
+    );
+
+  return (
+    <div className="md-tab-body" data-testid="tab-skills">
+      {list.rows !== null && rows.length === 0 ? (
+        <EmptyPanel
+          title={t("skills.none")}
+          body={
+            props.query.trim() === ""
+              ? t("capabilities.noneYet")
+              : t("capabilities.nothingMatches", { query: props.query.trim() })
+          }
+        />
+      ) : (
+        <MasterDetail
+          id="capabilities.skills"
+          list={listColumn}
+          detail={detail}
+          listLabel={t("capabilities.tab.skills")}
+        />
+      )}
+      <HubSection
+        api={api}
+        profile={profile}
+        installed={() => list.reload()}
+        {...(props.pendingInstall === undefined ? {} : { pendingInstall: props.pendingInstall })}
+        {...(props.onPendingDone === undefined ? {} : { onPendingDone: props.onPendingDone })}
+      />
+      {archiving !== null && (
+        <SmallDialog
+          role="alertdialog"
+          title={t("skills.archive.title")}
+          description={t("skills.archive.body", { name: archiving })}
+          onClose={() => setArchiving(null)}
+          actions={
+            <>
+              <Button variant="ghost" size="sm" onClick={() => setArchiving(null)}>
+                {t("capabilities.cancel")}
+              </Button>
+              <Button variant="danger" size="sm" onClick={() => void archive()}>
+                {t("skills.archive")}
+              </Button>
+            </>
+          }
+        />
+      )}
+    </div>
+  );
+}
+
+/** The Skills Hub section: our hub search inside the framed box, "Update installed". */
+export function HubSection(props: {
+  api: RestLike | null;
+  profile: string;
+  installed: () => void;
+  pendingInstall?: string | null;
+  onPendingDone?: () => void;
+}) {
+  const t = useT();
+  const { api, profile } = props;
+  const [query, setQuery] = useState("");
+  const [results, setResults] = useState<HubResult[] | null>(null);
+  const [confirming, setConfirming] = useState<string | null>(props.pendingInstall ?? null);
+  const [busy, setBusy] = useState(false);
+  const [status, setStatus] = useState<{ text: string; bad: boolean } | null>(null);
+
+  useEffect(() => {
+    if (props.pendingInstall) setConfirming(props.pendingInstall);
+  }, [props.pendingInstall]);
+
+  const search = async (event: FormEvent) => {
+    event.preventDefault();
+    if (query.trim() === "") return;
+    const answer = await rest<{ results?: HubResult[] }>(
+      api,
+      "GET",
+      `/api/skills/hub/search?q=${encodeURIComponent(query.trim())}`,
+      { profile },
+    );
+    if (answer.ok) setResults(answer.data.results ?? []);
+    else setStatus({ text: answer.message, bad: true });
+  };
+
+  const install = async () => {
+    if (confirming === null || busy) return;
+    setBusy(true);
+    const identifier = confirming;
+    const answer = await rest<{ name?: string }>(api, "POST", "/api/skills/hub/install", {
+      body: { identifier },
+      profile,
+      timeoutMs: 120_000,
+    });
+    setBusy(false);
+    setConfirming(null);
+    props.onPendingDone?.();
+    const text = answer.ok
+      ? t("skills.done", { name: answer.data.name ?? identifier })
+      : answer.message;
+    setStatus({ text, bad: !answer.ok });
+    notify(
+      answer.ok
+        ? { tone: "success", title: text }
+        : { tone: "error", title: t("skills.install"), message: text },
+    );
+    if (answer.ok) {
+      setResults((current) =>
+        current === null
+          ? current
+          : current.map((hit) =>
+              hit.identifier === identifier ? { ...hit, installed: true } : hit,
+            ),
+      );
+    }
+    props.installed();
+  };
+
+  const update = async () => {
+    const answer = await rest<{ message?: string }>(api, "POST", "/api/skills/hub/update", {
+      body: {},
+      profile,
+      timeoutMs: 300_000,
+    });
+    notify(
+      answer.ok
+        ? { tone: "success", title: answer.data.message ?? t("skills.hub.updated") }
+        : { tone: "error", title: t("skills.hub.update"), message: answer.message },
+    );
+    if (answer.ok) props.installed();
+  };
+
+  return (
+    <>
+      <BottomSection
+        id="capabilities.skillsHub"
+        label={t("skills.hub")}
+        hideLabel={t("skills.hub.hide")}
+        showLabel={t("skills.hub.show")}
+        hint={t("skills.hub.hint")}
+        actions={<TextAction onClick={() => void update()}>{t("skills.hub.update")}</TextAction>}
+      >
+        <form className="cap-hub-search" onSubmit={search}>
+          <input
+            type="search"
+            aria-label={t("skills.search")}
+            placeholder={t("skills.search")}
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+          />
+          <Button type="submit" variant="outline" size="sm" disabled={query.trim() === ""}>
+            {t("skills.searchButton")}
+          </Button>
+        </form>
+        {status?.bad === true && (
+          <p className="md-status cap-hub-status" data-tone="bad">
+            {status.text}
+          </p>
+        )}
+        {results === null ? (
+          <p className="cap-hub-empty">{t("skills.hub.empty")}</p>
+        ) : (
+          <ul className="cap-hub-results">
+            {results.map((hit) => (
+              <li key={hit.identifier} className="cap-hub-row">
+                <span className="cap-hub-text">
+                  <span className="cap-hub-name">{hit.name}</span>
+                  <span className="cap-hub-desc">{hit.description}</span>
+                </span>
+                <span className="cap-hub-source">{hit.source}</span>
+                {hit.installed ? (
+                  <span className="cap-hub-installed">{t("skills.installed")}</span>
+                ) : (
+                  <Button variant="outline" size="sm" onClick={() => setConfirming(hit.identifier)}>
+                    {t("skills.install")}
+                  </Button>
+                )}
+              </li>
+            ))}
+          </ul>
+        )}
+      </BottomSection>
+      <p className="sr-only" role="status">
+        {status?.text ?? ""}
+      </p>
+      {confirming !== null && (
+        <SmallDialog
+          title={t("skills.confirm.title")}
+          description={t("skills.confirm.body", { identifier: confirming, profile })}
+          onClose={() => {
+            setConfirming(null);
+            props.onPendingDone?.();
+          }}
+          actions={
+            <>
+              <Button
+                variant="ghost"
+                size="sm"
+                onClick={() => {
+                  setConfirming(null);
+                  props.onPendingDone?.();
+                }}
+              >
+                {t("capabilities.cancel")}
+              </Button>
+              <Button variant="primary" size="sm" disabled={busy} onClick={() => void install()}>
+                {t("skills.confirm.install")}
+              </Button>
+            </>
+          }
+        />
+      )}
+    </>
+  );
+}
diff --git a/apps/desktop/src/app/capabilities/ToolsetsTab.tsx b/apps/desktop/src/app/capabilities/ToolsetsTab.tsx
new file mode 100644
index 0000000..5d08ca2
--- /dev/null
+++ b/apps/desktop/src/app/capabilities/ToolsetsTab.tsx
@@ -0,0 +1,230 @@
+// The Tools tab (P24-26, W52-k): the plain toolsets as rows with their tool counts, the chosen
+// one's tools as chips, and for the terminal toolset the execution backend cards. A toolset's
+// switch is read-only here (W52-k-1: there is no toolset write route; the selection lives in
+// Settings); the backend card writes `terminal.backend` through `PUT /api/config`.
+
+import { RefreshCw } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { patchFor, type RestLike, rest, valueAt } from "../../settings/settingsApi.ts";
+import { IconButton } from "../../ui/components.tsx";
+import {
+  CapRow,
+  DetailColumn,
+  DetailHeader,
+  EmptyPanel,
+  ListStrip,
+  MasterDetail,
+  MdPill,
+  RowSwitch,
+  ToolChip,
+} from "../masterDetail.tsx";
+import { notify } from "../Toasts.tsx";
+import type { ListHandle } from "./SkillsTab.tsx";
+import type { ToolsetRow } from "./shared.ts";
+
+/** Our execution backends (the config schema's `terminal.backend` values). */
+export const BACKENDS = [
+  "local",
+  "docker",
+  "ssh",
+  "singularity",
+  "modal",
+  "daytona",
+  "vercel_sandbox",
+] as const;
+
+const BACKEND_NAMES: Readonly<Record<(typeof BACKENDS)[number], string>> = {
+  local: "Local",
+  docker: "Docker",
+  ssh: "SSH",
+  singularity: "Singularity",
+  modal: "Modal",
+  daytona: "Daytona",
+  vercel_sandbox: "Vercel Sandbox",
+};
+
+export function visibleToolsets(
+  rows: readonly ToolsetRow[],
+  query: string,
+  ascending: boolean,
+): ToolsetRow[] {
+  const needle = query.trim().toLowerCase();
+  return rows
+    .filter(
+      (row) =>
+        needle === "" ||
+        `${row.label} ${row.name} ${row.description} ${row.tools.join(" ")}`
+          .toLowerCase()
+          .includes(needle),
+    )
+    .sort((a, b) => (ascending ? 1 : -1) * a.label.localeCompare(b.label));
+}
+
+export function ToolsetsTab(props: {
+  api: RestLike | null;
+  profile: string;
+  list: ListHandle<ToolsetRow>;
+  query: string;
+}) {
+  const t = useT();
+  const [ascending, setAscending] = useState(true);
+  const [chosen, setChosen] = useState<string | null>(null);
+  const rows = useMemo(
+    () => visibleToolsets(props.list.rows ?? [], props.query, ascending),
+    [props.list.rows, props.query, ascending],
+  );
+  const selected = rows.find((row) => row.name === chosen) ?? rows[0] ?? null;
+
+  if (props.list.rows !== null && rows.length === 0) {
+    return (
+      <div className="md-tab-body" data-testid="tab-toolsets">
+        <EmptyPanel
+          title={t("toolsets.none")}
+          body={
+            props.query.trim() === ""
+              ? t("capabilities.noneYet")
+              : t("capabilities.nothingMatches", { query: props.query.trim() })
+          }
+        />
+      </div>
+    );
+  }
+
+  const list = (
+    <>
+      <ListStrip
+        sortLabel={t(ascending ? "toolsets.az" : "toolsets.za")}
+        descending={ascending}
+        onSort={() => setAscending(!ascending)}
+      />
+      <ul>
+        {rows.map((set) => (
+          <CapRow
+            key={set.name}
+            title={set.label}
+            subtitle={set.description !== "" ? set.description : set.tools.join(", ")}
+            meta={t("toolsets.tools", { count: set.tools.length })}
+            selected={selected?.name === set.name}
+            dim={!set.enabled}
+            onSelect={() => setChosen(set.name)}
+            control={
+              <RowSwitch
+                label={t("skills.enabled", { name: set.label })}
+                checked={set.enabled}
+                disabled
+                title={t("toolsets.changeInSettings")}
+                onChange={() => undefined}
+              />
+            }
+          />
+        ))}
+      </ul>
+    </>
+  );
+
+  const detail =
+    selected === null ? null : (
+      <DetailColumn footer={<p className="md-caption-end">{t("capabilities.changesApply")}</p>}>
+        <DetailHeader title={selected.label} description={selected.description} />
+        <ul
+          className="md-tool-chips"
+          aria-label={t("toolsets.tools", { count: selected.tools.length })}
+        >
+          {selected.tools.map((tool) => (
+            <ToolChip key={tool}>{tool}</ToolChip>
+          ))}
+        </ul>
+        {selected.name === "terminal" && <BackendPanel api={props.api} profile={props.profile} />}
+      </DetailColumn>
+    );
+
+  return (
+    <div className="md-tab-body" data-testid="tab-toolsets">
+      <MasterDetail
+        id="capabilities.tools"
+        list={list}
+        detail={detail}
+        listLabel={t("capabilities.tab.toolsets")}
+      />
+    </div>
+  );
+}
+
+/** "Execution backend": one card per backend; the configured one is selected and "In use". */
+export function BackendPanel(props: { api: RestLike | null; profile: string }) {
+  const t = useT();
+  const [current, setCurrent] = useState<string | null>(null);
+  const [serial, setSerial] = useState(0);
+  const [busy, setBusy] = useState(false);
+
+  // biome-ignore lint/correctness/useExhaustiveDependencies: serial asks for a reload
+  useEffect(() => {
+    let live = true;
+    void rest<unknown>(props.api, "GET", "/api/config", { profile: props.profile }).then(
+      (answer) => {
+        if (!live || !answer.ok) return;
+        const tree = (answer.data as { config?: unknown }).config ?? answer.data;
+        const value = valueAt(tree, "terminal.backend");
+        setCurrent(typeof value === "string" && value !== "" ? value : "local");
+      },
+    );
+    return () => {
+      live = false;
+    };
+  }, [props.api, props.profile, serial]);
+
+  const choose = async (backend: string) => {
+    if (busy || backend === current) return;
+    const before = current;
+    setBusy(true);
+    setCurrent(backend);
+    const answer = await rest(props.api, "PUT", "/api/config", {
+      body: { config: patchFor("terminal.backend", backend) },
+      profile: props.profile,
+    });
+    setBusy(false);
+    if (!answer.ok) {
+      setCurrent(before);
+      notify({
+        tone: "error",
+        title: t("toolsets.backend.saveFailed", { message: answer.message }),
+      });
+    }
+  };
+
+  return (
+    <section className="cap-backend" aria-label={t("toolsets.backend")}>
+      <div className="cap-backend-head">
+        <span>{t("toolsets.backend")}</span>
+        <IconButton
+          label={t("toolsets.backend.refresh")}
+          icon={<RefreshCw aria-hidden="true" size={13} />}
+          size="sm"
+          onClick={() => setSerial((n) => n + 1)}
+        />
+      </div>
+      {BACKENDS.map((backend) => {
+        const inUse = backend === current;
+        return (
+          <button
+            key={backend}
+            type="button"
+            className="cap-backend-card"
+            aria-pressed={inUse}
+            disabled={busy}
+            onClick={() => void choose(backend)}
+          >
+            <span className="cap-backend-name">
+              {BACKEND_NAMES[backend]}
+              {inUse && <MdPill tone="accent">{`✓ ${t("toolsets.backend.inUse")}`}</MdPill>}
+            </span>
+            <span className="cap-backend-desc">
+              {t(`toolsets.backend.${backend}` as MessageKey)}
+            </span>
+          </button>
+        );
+      })}
+    </section>
+  );
+}
