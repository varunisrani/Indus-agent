-/** A list loaded for one profile; `reload` re-reads it. */
-function useList<T>(
-  api: RestLike | null,
-  path: string,
-  profile: string,
-  pick: (body: unknown) => T[],
-): { rows: T[] | null; error: string | null; reload: () => void } {
