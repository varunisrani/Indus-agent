@@ -0,0 +1,65 @@
+// @vitest-environment jsdom
+import { fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it } from "vitest";
+import { visibleSkills } from "./capabilities/SkillsTab.tsx";
+import { BottomSection, clamp, MasterDetail } from "./masterDetail.tsx";
+
+afterEach(() => window.localStorage.clear());
+
+describe("master-detail frame", () => {
+  it("clamps the seam between the list and detail minimums", () => {
+    expect(clamp(100, 180, 900)).toBe(180);
+    expect(clamp(1200, 180, 900)).toBe(900);
+    expect(clamp(400, 180, 900)).toBe(400);
+    expect(clamp(400, 180, 100)).toBe(180); // an empty range keeps the list minimum
+  });
+
+  it("uses a remembered list width and forgets it on double-click", () => {
+    window.localStorage.setItem("indus.masterDetail.t1", "300");
+    const view = render(<MasterDetail id="t1" list={<p>list</p>} detail={<p>detail</p>} />);
+    const frame = view.container.querySelector(".md-frame") as HTMLElement;
+    expect(frame.style.gridTemplateColumns).toBe("300px minmax(0, 1fr)");
+    fireEvent.doubleClick(view.container.querySelector(".md-sash") as HTMLElement);
+    expect(frame.style.gridTemplateColumns).toBe("minmax(0, 0.75fr) minmax(0, 1fr)");
+    expect(window.localStorage.getItem("indus.masterDetail.t1")).toBeNull();
+  });
+
+  it("the rail variant has a fixed list and no seam", () => {
+    const view = render(
+      <MasterDetail id="t2" variant="rail" list={<p>list</p>} detail={<p>detail</p>} />,
+    );
+    expect(view.container.querySelector(".md-sash")).toBeNull();
+    expect(
+      (view.container.querySelector(".md-frame") as HTMLElement).style.gridTemplateColumns,
+    ).toBe("224px minmax(0, 1fr)");
+  });
+
+  it("a bottom section collapses and remembers it", () => {
+    const section = () => (
+      <BottomSection id="hub" label="Hub" hideLabel="Hide it" showLabel="Show it">
+        <p>inside</p>
+      </BottomSection>
+    );
+    const first = render(section());
+    expect(screen.getByText("inside")).toBeTruthy();
+    fireEvent.click(screen.getByText("Hide it"));
+    expect(screen.queryByText("inside")).toBeNull();
+    first.unmount();
+    render(section());
+    expect(screen.queryByText("inside")).toBeNull();
+    expect(screen.getByText("Show it")).toBeTruthy();
+  });
+
+  it("skills sort by use, then name, and filter by name, description and category", () => {
+    const rows = [
+      { name: "b", description: "", category: "notes", enabled: true, source: "local" },
+      { name: "a", description: "brew", category: "", enabled: true, source: "local" },
+      { name: "c", description: "", category: "", enabled: false, source: "hub" },
+    ];
+    const usage = new Map([["c", { useCount: 5, createdBy: "agent" as const }]]);
+    expect(visibleSkills(rows, usage, "", true).map((r) => r.name)).toEqual(["c", "a", "b"]);
+    expect(visibleSkills(rows, usage, "", false).map((r) => r.name)).toEqual(["a", "b", "c"]);
+    expect(visibleSkills(rows, usage, "brew", true).map((r) => r.name)).toEqual(["a"]);
+    expect(visibleSkills(rows, usage, "NOTES", true).map((r) => r.name)).toEqual(["b"]);
+  });
+});
diff --git a/apps/desktop/src/app/masterDetail.tsx b/apps/desktop/src/app/masterDetail.tsx
new file mode 100644
index 0000000..db815d2
--- /dev/null
+++ b/apps/desktop/src/app/masterDetail.tsx
@@ -0,0 +1,522 @@
+// The list-and-detail frame of the Capabilities and Messaging pages (W52-k): a one-row page
+// header (search | centred text tabs | trailing slot), two columns split by a draggable seam whose
+// width is remembered per page, switch rows, a centred detail column with a pinned footer, and a
+// resizable bottom section (the Skills Hub). Styled by `masterDetail.css` on the `--desk-*` tokens.
+
+import { ArrowDown, ArrowUp, EllipsisVertical, Search } from "lucide-react";
+import {
+  type ReactNode,
+  type PointerEvent as ReactPointerEvent,
+  useCallback,
+  useEffect,
+  useRef,
+  useState,
+} from "react";
+import { Switch } from "../settings/primitives.tsx";
+import { IconButton, MenuPanel } from "../ui/components.tsx";
+import "./masterDetail.css";
+
+// -- remembered sizes ------------------------------------------------------------------------------
+
+function readNumber(key: string): number | null {
+  try {
+    const raw = window.localStorage.getItem(key);
+    const value = raw === null ? Number.NaN : Number(raw);
+    return Number.isFinite(value) ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function writeValue(key: string, value: string | null): void {
+  try {
+    if (value === null) window.localStorage.removeItem(key);
+    else window.localStorage.setItem(key, value);
+  } catch {
+    // storage blocked: the size just is not remembered
+  }
+}
+
+/** Keep `value` inside `[min, max]` (min wins when the range is empty). */
+export function clamp(value: number, min: number, max: number): number {
+  return Math.max(min, Math.min(value, max));
+}
+
+// -- page header -----------------------------------------------------------------------------------
+
+/** The page's single header row: search at the left, tabs in the centre, a trailing slot. */
+export function PageHeader(props: { search?: ReactNode; tabs?: ReactNode; trailing?: ReactNode }) {
+  return (
+    <header className="md-header">
+      <div className="md-header-start">{props.search}</div>
+      <div className="md-header-centre">{props.tabs}</div>
+      <div className="md-header-end">{props.trailing}</div>
+    </header>
+  );
+}
+
+/** "Try "term"" — the placeholder walks through `terms` every few seconds. */
+export function usePlaceholderTerm(terms: readonly string[], everyMs = 3_000): string | null {
+  const [at, setAt] = useState(0);
+  useEffect(() => {
+    if (terms.length < 2) return;
+    const timer = setInterval(() => setAt((n) => n + 1), everyMs);
+    return () => clearInterval(timer);
+  }, [terms.length, everyMs]);
+  return terms.length === 0 ? null : (terms[at % terms.length] ?? null);
+}
+
+/** The borderless page search (magnifier + input). */
+export function PageSearch(props: {
+  label: string;
+  value: string;
+  placeholder: string;
+  onChange: (value: string) => void;
+}) {
+  return (
+    <label className="md-search">
+      <Search aria-hidden="true" size={13} />
+      <input
+        type="search"
+        aria-label={props.label}
+        placeholder={props.placeholder}
+        value={props.value}
+        onChange={(event) => props.onChange(event.target.value)}
+      />
+    </label>
+  );
+}
+
+export interface TextTab<T extends string> {
+  readonly id: T;
+  readonly label: string;
+  /** A count after the label; null = still loading (a small bar), undefined = none. */
+  readonly count?: number | null | undefined;
+}
+
+/** Plain text tabs with an underline under the active label and optional superscript counts. */
+export function TextTabs<T extends string>(props: {
+  label: string;
+  tabs: readonly TextTab<T>[];
+  value: T;
+  onChange: (id: T) => void;
+}) {
+  return (
+    <div role="tablist" aria-label={props.label} className="md-tabs">
+      {props.tabs.map((tab) => (
+        <button
+          key={tab.id}
+          type="button"
+          role="tab"
+          aria-selected={props.value === tab.id}
+          className="md-tab"
+          onClick={() => props.onChange(tab.id)}
+        >
+          <span className="md-tab-label">{tab.label}</span>
+          {tab.count === null ? (
+            <span className="md-tab-count md-tab-count-loading" aria-hidden="true" />
+          ) : tab.count !== undefined ? (
+            <sup className="md-tab-count">{tab.count}</sup>
+          ) : null}
+        </button>
+      ))}
+    </div>
+  );
+}
+
+// -- two columns -----------------------------------------------------------------------------------
+
+const MIN_LIST = 180;
+const MIN_DETAIL = 320;
+
+/**
+ * List and detail side by side. `wide`: the list takes 0.75fr until the seam is dragged (the
+ * width is kept per `id`; a double-click forgets it). `rail`: a fixed 224px list.
+ */
+export function MasterDetail(props: {
+  id: string;
+  variant?: "wide" | "rail";
+  list: ReactNode;
+  detail: ReactNode;
+  listLabel?: string;
+}) {
+  const variant = props.variant ?? "wide";
+  const key = `indus.masterDetail.${props.id}`;
+  const [width, setWidth] = useState<number | null>(() =>
+    variant === "wide" ? readNumber(key) : null,
+  );
+  const root = useRef<HTMLDivElement>(null);
+  const [dragging, setDragging] = useState(false);
+
+  const onDown = (event: ReactPointerEvent<HTMLDivElement>) => {
+    const box = root.current?.getBoundingClientRect();
+    if (box === undefined) return;
+    event.preventDefault();
+    setDragging(true);
+    const move = (moved: PointerEvent) => {
+      const next = clamp(moved.clientX - box.left, MIN_LIST, box.width - MIN_DETAIL);
+      setWidth(Math.round(next));
+    };
+    const up = () => {
+      setDragging(false);
+      window.removeEventListener("pointermove", move);
+      window.removeEventListener("pointerup", up);
+      setWidth((current) => {
+        if (current !== null) writeValue(key, String(current));
+        return current;
+      });
+    };
+    window.addEventListener("pointermove", move);
+    window.addEventListener("pointerup", up);
+  };
+
+  const columns =
+    variant === "rail"
+      ? "224px minmax(0, 1fr)"
+      : width === null
+        ? "minmax(0, 0.75fr) minmax(0, 1fr)"
+        : `${width}px minmax(0, 1fr)`;
+  return (
+    <div
+      ref={root}
+      className="md-frame"
+      data-variant={variant}
+      data-dragging={dragging ? "true" : undefined}
+      style={{ gridTemplateColumns: columns }}
+    >
+      <nav className="md-list" aria-label={props.listLabel}>
+        {props.list}
+      </nav>
+      <div className="md-detail-wrap">
+        {variant === "wide" && (
+          <div
+            className="md-sash"
+            aria-hidden="true"
+            onPointerDown={onDown}
+            onDoubleClick={() => {
+              setWidth(null);
+              writeValue(key, null);
+            }}
+          />
+        )}
+        {props.detail}
+      </div>
+    </div>
+  );
+}
+
+/** The strip over a list: a sort toggle at the left, a kebab menu at the right. */
+export function ListStrip(props: {
+  sortLabel: string;
+  descending: boolean;
+  onSort: () => void;
+  menuLabel?: string;
+  menu?: (close: () => void) => ReactNode;
+}) {
+  const [open, setOpen] = useState(false);
+  const trigger = useRef<HTMLSpanElement>(null);
+  const close = useCallback(() => setOpen(false), []);
+  return (
+    <div className="md-strip">
+      <button type="button" className="md-sort" onClick={props.onSort}>
+        {props.descending ? (
+          <ArrowDown aria-hidden="true" size={11} />
+        ) : (
+          <ArrowUp aria-hidden="true" size={11} />
+        )}
+        {props.sortLabel}
+      </button>
+      {props.menu !== undefined && (
+        <span className="md-strip-menu" ref={trigger}>
+          <IconButton
+            label={props.menuLabel ?? ""}
+            icon={<EllipsisVertical aria-hidden="true" size={14} />}
+            size="sm"
+            aria-haspopup="menu"
+            aria-expanded={open}
+            onClick={() => setOpen(!open)}
+          />
+          {open && (
+            <MenuPanel
+              label={props.menuLabel ?? ""}
+              onClose={close}
+              keepOpenFor={trigger}
+              className="md-strip-panel"
+            >
+              {props.menu(close)}
+            </MenuPanel>
+          )}
+        </span>
+      )}
+    </div>
+  );
+}
+
+/** The small switch of the rows (28x16, dimmed while off). */
+export function RowSwitch(props: {
+  label: string;
+  checked: boolean;
+  disabled?: boolean;
+  title?: string;
+  onChange: (on: boolean) => void;
+}) {
+  return (
+    <span className="md-switch" title={props.title}>
+      <Switch
+        size="sm"
+        label={props.label}
+        checked={props.checked}
+        {...(props.disabled === undefined ? {} : { disabled: props.disabled })}
+        onChange={props.onChange}
+      />
+    </span>
+  );
+}
+
+/** One selectable row: title, optional subtitle and badge, a meta chip and a trailing control. */
+export function CapRow(props: {
+  title: string;
+  subtitle?: string;
+  badge?: ReactNode;
+  meta?: string;
+  selected: boolean;
+  dim?: boolean;
+  control?: ReactNode;
+  onSelect: () => void;
+  testId?: string;
+}) {
+  const hasSub = props.subtitle !== undefined && props.subtitle !== "";
+  return (
+    <li
+      className="md-row"
+      data-selected={props.selected ? "true" : undefined}
+      data-dim={props.dim ? "true" : undefined}
+      data-tall={hasSub ? "true" : undefined}
+      data-testid={props.testId}
+    >
+      <button
+        type="button"
+        className="md-row-main"
+        aria-current={props.selected ? "true" : undefined}
+        onClick={props.onSelect}
+      >
+        <span className="md-row-title">{props.title}</span>
+        {(hasSub || props.badge !== undefined) && (
+          <span className="md-row-sub">
+            {hasSub && <span className="md-row-sub-text">{props.subtitle}</span>}
+            {props.badge}
+          </span>
+        )}
+      </button>
+      {props.meta !== undefined && <span className="md-meta">{props.meta}</span>}
+      {props.control !== undefined && <span className="md-row-control">{props.control}</span>}
+    </li>
+  );
+}
+
+/** The detail column: centred content that scrolls, and a pinned footer (caption or action bar). */
+export function DetailColumn(props: { children: ReactNode; footer?: ReactNode; label?: string }) {
+  return (
+    <section className="md-detail" aria-label={props.label}>
+      <div className="md-detail-scroll">
+        <div className="md-detail-body">{props.children}</div>
+      </div>
+      {props.footer !== undefined && <div className="md-detail-footer">{props.footer}</div>}
+    </section>
+  );
+}
+
+/** Title, pills after it and a one-line description. */
+export function DetailHeader(props: {
+  title: string;
+  pills?: ReactNode;
+  description?: string;
+  leading?: ReactNode;
+  actions?: ReactNode;
+}) {
+  return (
+    <div className="md-detail-header">
+      <div className="md-detail-title-row">
+        {props.leading}
+        <h2 className="md-detail-title">{props.title}</h2>
+        {props.pills}
+        {props.actions !== undefined && <span className="md-detail-actions">{props.actions}</span>}
+      </div>
+      {props.description !== undefined && props.description !== "" && (
+        <p className="md-detail-description">{props.description}</p>
+      )}
+    </div>
+  );
+}
+
+/** A small rounded pill: `muted`, `accent` (primary tint), `good`, `category`. */
+export function MdPill(props: {
+  children: ReactNode;
+  tone?: "muted" | "accent" | "good" | "category" | "warn";
+  dot?: boolean;
+}) {
+  return (
+    <span className="md-pill" data-tone={props.tone ?? "muted"}>
+      {props.dot && <span className="md-pill-dot" aria-hidden="true" />}
+      {props.children}
+    </span>
+  );
+}
+
+/** Key/value rows in an inset box. */
+export function MetaBox(props: { rows: ReadonlyArray<readonly [string, ReactNode]> }) {
+  return (
+    <dl className="md-meta-box">
+      {props.rows.map(([key, value]) => (
+        <div key={key} className="md-meta-row">
+          <dt>{key}</dt>
+          <dd>{value}</dd>
+        </div>
+      ))}
+    </dl>
+  );
+}
+
+/** A monospace chip (a tool name). */
+export function ToolChip(props: { children: ReactNode }) {
+  return <li className="md-tool-chip">{props.children}</li>;
+}
+
+/** The uppercase tracked title of a detail section. */
+export function DetailSection(props: { title: string; children: ReactNode; aside?: ReactNode }) {
+  return (
+    <section className="md-section">
+      <h3 className="md-section-title">
+        <span>{props.title}</span>
+        {props.aside}
+      </h3>
+      {props.children}
+    </section>
+  );
+}
+
+/** One centred panel across both columns (nothing to list, or a load failure). */
+export function EmptyPanel(props: {
+  icon?: ReactNode;
+  title: string;
+  body?: string;
+  action?: ReactNode;
+  role?: "alert" | "status";
+}) {
+  return (
+    <div className="md-empty" role={props.role}>
+      <span className="md-empty-icon">{props.icon ?? <Search aria-hidden="true" size={16} />}</span>
+      <p className="md-empty-title">{props.title}</p>
+      {props.body !== undefined && <p className="md-empty-body">{props.body}</p>}
+      {props.action}
+    </div>
+  );
+}
+
+// -- bottom section --------------------------------------------------------------------------------
+
+const MIN_BOTTOM = 120;
+const KEEP_ABOVE = 176;
+
+/**
+ * A section docked under the list and detail (the Skills Hub, the plugin catalog): a primary-tint
+ * line on top that drags to resize, a 32px header (label, actions, show/hide), a framed body and
+ * a hint line. Height and the collapsed state are kept per `id`.
+ */
+export function BottomSection(props: {
+  id: string;
+  label: string;
+  upper?: boolean;
+  actions?: ReactNode;
+  hideLabel: string;
+  showLabel: string;
+  hint?: string;
+  defaultCollapsed?: boolean;
+  defaultHeight?: number;
+  children: ReactNode;
+}) {
+  const heightKey = `indus.bottomSection.${props.id}.height`;
+  const collapsedKey = `indus.bottomSection.${props.id}.collapsed`;
+  const [height, setHeight] = useState(() => readNumber(heightKey) ?? props.defaultHeight ?? 380);
+  const [collapsed, setCollapsed] = useState(() => {
+    const stored = readNumber(collapsedKey);
+    return stored === null ? props.defaultCollapsed === true : stored === 1;
+  });
+  const root = useRef<HTMLElement>(null);
+
+  const onDown = (event: ReactPointerEvent<HTMLDivElement>) => {
+    if (collapsed) return;
+    const parent = root.current?.parentElement?.getBoundingClientRect();
+    if (parent === undefined) return;
+    event.preventDefault();
+    const startY = event.clientY;
+    const start = height;
+    const max = Math.min(window.innerHeight * 0.75, parent.height - KEEP_ABOVE);
+    let last = start;
+    const move = (moved: PointerEvent) => {
+      last = Math.round(clamp(start - (moved.clientY - startY), MIN_BOTTOM, max));
+      setHeight(last);
+    };
+    const up = () => {
+      window.removeEventListener("pointermove", move);
+      window.removeEventListener("pointerup", up);
+      writeValue(heightKey, String(last));
+    };
+    window.addEventListener("pointermove", move);
+    window.addEventListener("pointerup", up);
+  };
+
+  const toggle = () => {
+    const next = !collapsed;
+    setCollapsed(next);
+    writeValue(collapsedKey, next ? "1" : "0");
+  };
+
+  return (
+    <section
+      ref={root}
+      className="md-bottom"
+      aria-label={props.label}
+      data-collapsed={collapsed ? "true" : undefined}
+    >
+      <div className="md-bottom-edge" aria-hidden="true" onPointerDown={onDown} />
+      <div className="md-bottom-head">
+        <span className="md-bottom-label" data-upper={props.upper ? "true" : undefined}>
+          {props.label}
+        </span>
+        <span className="md-bottom-actions">
+          {props.actions}
+          <button type="button" className="md-text-action" onClick={toggle}>
+            {collapsed ? props.showLabel : props.hideLabel}
+          </button>
+        </span>
+      </div>
+      {!collapsed && (
+        <div className="md-bottom-body" style={{ height }}>
+          <div className="md-bottom-frame">{props.children}</div>
+          {props.hint !== undefined && <p className="md-bottom-hint">{props.hint}</p>}
+        </div>
+      )}
+    </section>
+  );
+}
+
+/** A quiet text action (11px, tertiary, primary on hover). */
+export function TextAction(props: {
+  children: ReactNode;
+  onClick: () => void;
+  disabled?: boolean;
+  tone?: "danger";
+}) {
+  return (
+    <button
+      type="button"
+      className="md-text-action"
+      data-tone={props.tone}
+      disabled={props.disabled}
+      onClick={props.onClick}
+    >
+      {props.children}
+    </button>
+  );
+}
