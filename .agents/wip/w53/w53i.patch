+// Labels and captions in our words for the schema fields the slice A pages show up front (W52-i).
+// A field without an entry keeps the derived label (`fieldLabel`) and the schema's description.
+// `suggest` turns a free-text field into a field with a suggestion list (the timezone).
+
+import type { MessageKey } from "../i18n/index.tsx";
+
+export interface FieldCopy {
+  readonly label: MessageKey;
+  readonly description?: MessageKey;
+  /** Suggestions for a free-text field (shown as a searchable list). */
+  readonly suggest?: () => readonly string[];
+}
+
+function timeZones(): readonly string[] {
+  const intl = Intl as unknown as { supportedValuesOf?: (key: string) => string[] };
+  try {
+    return intl.supportedValuesOf?.("timeZone") ?? [];
+  } catch {
+    return [];
+  }
+}
+
