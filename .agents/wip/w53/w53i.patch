+// -- Chat display (placeholders: no feature behind these yet) -----------------------------------------------
+
+export function AppearanceChatDisplayPage() {
+  const t = useT();
+  return (
+    <PageBody>
+      <SettingRow
+        title={t("settingsA.display.bubble")}
