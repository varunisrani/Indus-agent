@@ -0,0 +1,26 @@
+{
+  "about": "X-Line-Signature known answers, written from the LINE Messaging API spec (base64 of HMAC-SHA256 over the raw request body, keyed with the channel secret). Each signature was computed independently with `openssl dgst -sha256 -hmac <secret> -binary | base64` (OpenSSL 3.0.13) over the body's UTF-8 bytes, not with our code.",
+  "channel_secret": "test-channel-secret-0001",
+  "vectors": [
+    {
+      "name": "the console's verify call (no events)",
+      "body": "{\"destination\":\"Uffffffffffffffffffffffffffffffff\",\"events\":[]}",
+      "signature": "7vXM0ofsQgJbdxpMIeYBVRjZzlGAdG7g1CSFLwlZKUw="
+    },
