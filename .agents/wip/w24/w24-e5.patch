+    assert run(main()).ok
+    assert adapter.nick == f"{NICK}-send"
+    assert wire.joined == ["#ops"] and env.platform.texts("#ops") == ["deploy done"]
+    sent = wire.received()
+    assert sent[-1].startswith("QUIT") and not any("IDENTIFY" in line for line in sent)
