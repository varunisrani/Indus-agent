diff --git a/tests/fakes/platform/irc_wire.py b/tests/fakes/platform/irc_wire.py
new file mode 100644
index 0000000..1057da5
--- /dev/null
+++ b/tests/fakes/platform/irc_wire.py
@@ -0,0 +1,327 @@
+"""An in-process fake IRC server over the shared fake platform (P16-27), no socket.
+
+``IrcWire.connect(host, port, tls)`` is the adapter's connector: it records the call, connects the
+platform (an armed connect failure raises ``TimeoutError`` as a stalled TCP connect would) and
+returns a reader/writer pair with the shapes of asyncio's streams. Lines the adapter writes are
+handled on ``drain()``; the server's lines wait in the reader.
+
+The server speaks enough RFC 1459/2812 and IRCv3 for the adapter: ``CAP LS 302`` (``caps``),
+``REQ``/``ACK``/``NAK``/``END``, SASL PLAIN (``accounts``), ``PASS`` (``server_password``), ``NICK``
+(``taken`` nicks get 433), ``USER``, ``001`` once registered, ``PING``/``PONG``, ``JOIN`` (echo +
+366; ``closed_channels`` get 473), ``QUIT`` and ``PRIVMSG``. A PRIVMSG is posted on the platform and
+echoed back with its ``msgid`` when ``echo-message`` was acknowledged. An armed platform failure
+answers as an IRC server would: chat not found → 401, forbidden → 404, too long → 417, a format
+problem → ``FAIL PRIVMSG INVALID_UTF8``, a rate limit → ``FAIL PRIVMSG RATE_LIMITED <target>
+<seconds>``, a thread error → ``FAIL PRIVMSG MESSAGE_NOT_FOUND``, a connect timeout → ``FAIL
+PRIVMSG TEMPORARILY_UNAVAILABLE``; a read timeout gets no answer at all.
+
+``mute()`` makes the server read and answer nothing. ``pump()`` delivers the platform's inbound
+items as PRIVMSG lines (tags when message-tags is on: ``time``, ``msgid``, ``bot`` for bot
+authors); IRC has no threads, edits, media or buttons, so those items deliver nothing. ``drop()``
+closes the connection from the server side and ``ban()`` sends a K-line ``ERROR`` first. Every
+line the server read is kept in ``received`` (raw).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import itertools
+import ssl
+from dataclasses import dataclass, field
+
+from indus.gateway.adapters.irc.protocol import IrcLine
+from tests.fakes.platform.core import FailureKind, FakeChatPlatform, FakeInbound, FakePlatformError
+
+SERVER = "irc.fake.test"
+DEFAULT_CAPS = ("sasl", "message-tags", "server-time", "echo-message", "multi-prefix")
+
+
+class FakeReader:
+    def __init__(self) -> None:
+        self.queue: asyncio.Queue[bytes] = asyncio.Queue()
+
+    async def readline(self) -> bytes:
+        return await self.queue.get()
+
+
+class FakeWriter:
+    def __init__(self, connection: Connection) -> None:
+        self.connection = connection
+        self.buffer = b""
+        self.closing = False
+
+    def write(self, data: bytes) -> None:
+        if self.closing:
+            raise ConnectionResetError("the connection is closed")
+        self.buffer += data
+
+    async def drain(self) -> None:
+        while b"\r\n" in self.buffer:
+            raw, self.buffer = self.buffer.split(b"\r\n", 1)
+            await self.connection.handle(raw)
+
+    def close(self) -> None:
+        if not self.closing:
+            self.closing = True
+            self.connection.ended()
+
+    async def wait_closed(self) -> None:
+        return None
+
+    def is_closing(self) -> bool:
+        return self.closing
+
+
+@dataclass
+class Connection:
+    wire: IrcWire
+    tls: bool
+    reader: FakeReader = field(default_factory=FakeReader)
+    writer: FakeWriter = field(init=False)
+    nick: str = "*"
+    user: str = ""
+    password: str | None = None
+    caps: set[str] = field(default_factory=set[str])
+    negotiating: bool = False
+    registered: bool = False
+    account: str | None = None
+    open: bool = True
+    # A muted server reads lines and answers nothing (a stalled link).
+    muted: bool = False
+    received: list[str] = field(default_factory=list[str])
+
+    def __post_init__(self) -> None:
+        self.writer = FakeWriter(self)
+
+    # -- output ---------------------------------------------------------------------------------
+
+    def send(self, line: str) -> None:
+        if self.open:
+            self.reader.queue.put_nowait((line + "\r\n").encode("utf-8"))
+
+    def numeric(self, code: str, *params: str) -> None:
+        self.send(f":{SERVER} {code} {self.nick} " + " ".join(params))
+
+    def ended(self) -> None:
+        if self.open:
+            self.open = False
+            self.reader.queue.put_nowait(b"")
+            if self in self.wire.connections:
+                self.wire.connections.remove(self)
+            asyncio.ensure_future(self.wire.platform.disconnect())
+
+    # -- input ----------------------------------------------------------------------------------
+
+    async def handle(self, raw: bytes) -> None:
+        text = raw.decode("utf-8", "replace")
+        self.received.append(text)
+        line = IrcLine.parse(text)
+        if line is None or not self.open or self.muted:
+            return
+        handler = getattr(self, f"on_{line.command.lower()}", None)
+        if handler is not None:
+            await handler(line)
+
+    async def on_cap(self, line: IrcLine) -> None:
+        sub = line.param(0).upper()
+        if sub == "LS":
+            self.negotiating = True
+            self.send(f":{SERVER} CAP {self.nick} LS :{' '.join(self.wire.caps)}")
+        elif sub == "REQ":
+            wanted = line.param(-1).split()
+            if all(c in self.wire.caps for c in wanted):
+                self.caps.update(wanted)
+                self.send(f":{SERVER} CAP {self.nick} ACK :{' '.join(wanted)}")
+            else:
+                self.send(f":{SERVER} CAP {self.nick} NAK :{' '.join(wanted)}")
+        elif sub == "END":
+            self.negotiating = False
+            self.try_register()
+
+    async def on_authenticate(self, line: IrcLine) -> None:
+        arg = line.param(0)
+        if arg == "PLAIN":
+            self.send("AUTHENTICATE +")
+            return
+        try:
+            authz, user, password = base64.b64decode(arg).decode().split("\x00")
+        except (ValueError, UnicodeDecodeError):
+            self.numeric("904", ":SASL authentication failed")
+            return
+        if self.wire.accounts.get(user) == password and authz in ("", user):
+            self.account = user
+            self.numeric(
+                "900", f"{self.nick}!{user}@fake.host", user, f":You are now logged in as {user}"
+            )
+            self.numeric("903", ":SASL authentication successful")
+        else:
+            self.numeric("904", ":SASL authentication failed")
+
+    async def on_pass(self, line: IrcLine) -> None:
+        self.password = line.param(0)
+
+    async def on_nick(self, line: IrcLine) -> None:
+        wanted = line.param(0)
+        if wanted.lower() in {n.lower() for n in self.wire.taken}:
+            self.numeric("433", wanted, ":Nickname is already in use")
+            return
+        old, self.nick = self.nick, wanted
+        if self.registered:
+            self.send(f":{old}!u@fake.host NICK {wanted}")
+        self.try_register()
+
+    async def on_user(self, line: IrcLine) -> None:
+        self.user = line.param(0)
+        self.try_register()
+
+    def try_register(self) -> None:
+        if self.registered or self.negotiating or self.nick == "*" or not self.user:
+            return
+        if self.wire.server_password is not None and self.password != self.wire.server_password:
+            self.numeric("464", ":Password incorrect")
+            self.send("ERROR :Closing Link: bad password")
+            self.ended()
+            return
+        self.registered = True
+        self.numeric("001", f":Welcome to the fake network {self.nick}")
+
+    async def on_ping(self, line: IrcLine) -> None:
+        self.send(f":{SERVER} PONG {SERVER} :{line.param(-1)}")
+
+    async def on_join(self, line: IrcLine) -> None:
+        for channel in line.param(0).split(","):
+            if channel.lower() in self.wire.closed_channels:
+                self.numeric("473", channel, ":Cannot join channel (+i)")
+                continue
+            self.wire.joined.append(channel)
+            self.send(f":{self.nick}!{self.user}@fake.host JOIN {channel}")
+            self.numeric("366", channel, ":End of /NAMES list.")
+
+    async def on_quit(self, line: IrcLine) -> None:
+        self.send("ERROR :Closing Link: fake.host (Quit)")
+        self.ended()
+
+    def tags(self, **values: str | None) -> str:
+        if "message-tags" not in self.caps and "server-time" not in self.caps:
+            return ""
+        parts = [k if v == "" else f"{k}={v}" for k, v in values.items() if v is not None]
+        return "@" + ";".join(parts) + " " if parts else ""
+
+    def stamp(self) -> str:
+        return self.wire.platform.clock.now().strftime("%Y-%m-%dT%H:%M:%S.000Z")
+
+    async def on_privmsg(self, line: IrcLine) -> None:
+        target, text = line.param(0), line.param(-1)
+        try:
+            sent = await self.wire.platform.post(target, text)
+        except FakePlatformError as exc:
+            self.refuse(target, exc)
+            return
+        if "echo-message" in self.caps:
+            tags = self.tags(time=self.stamp(), msgid=sent.message_id)
+            self.send(f"{tags}:{self.nick}!{self.user}@fake.host PRIVMSG {target} :{text}")
+
+    def refuse(self, target: str, exc: FakePlatformError) -> None:
+        kind = exc.kind
+        if kind is FailureKind.READ_TIMEOUT:
+            return  # the server never answers
+        if kind is FailureKind.CHAT_NOT_FOUND:
+            self.numeric("401", target, f":{exc.text}")
+        elif kind is FailureKind.FORBIDDEN:
+            self.numeric("404", target, f":{exc.text}")
+        elif kind is FailureKind.TOO_LONG:
+            self.numeric("417", f":{exc.text}")
+        else:
+            code = {
+                FailureKind.PARSE_ERROR: "INVALID_UTF8",
+                FailureKind.RATE_LIMIT: "RATE_LIMITED",
+                FailureKind.THREAD_NOT_FOUND: "MESSAGE_NOT_FOUND",
+                FailureKind.CONNECT_TIMEOUT: "TEMPORARILY_UNAVAILABLE",
+            }[kind]
+            wait = f" {int(exc.retry_after)}" if exc.retry_after is not None else ""
+            self.send(f":{SERVER} FAIL PRIVMSG {code} {target}{wait} :{exc.text}")
+
+
+class IrcWire:
+    def __init__(
+        self,
+        platform: FakeChatPlatform,
+        *,
+        caps: tuple[str, ...] = DEFAULT_CAPS,
+        accounts: dict[str, str] | None = None,
+        server_password: str | None = None,
+    ) -> None:
+        self.platform = platform
+        self.caps = caps
+        self.accounts = dict(accounts or {})
+        self.server_password = server_password
+        self.taken: set[str] = set()
+        self.closed_channels: set[str] = set()
+        self.connections: list[Connection] = []
+        self.history: list[Connection] = []
+        self.opens: list[tuple[str, int, bool]] = []
+        self.joined: list[str] = []
+        self._ids = itertools.count(1)
+
+    async def connect(
+        self, host: str, port: int, tls: ssl.SSLContext | None
+    ) -> tuple[FakeReader, FakeWriter]:
+        self.opens.append((host, port, tls is not None))
+        try:
+            await self.platform.connect()
+        except FakePlatformError as exc:
+            raise TimeoutError(exc.text) from None
+        connection = Connection(self, tls is not None)
+        self.connections.append(connection)
+        self.history.append(connection)
+        return connection.reader, connection.writer
+
+    @property
+    def current(self) -> Connection:
+        live = [c for c in self.connections if c.registered]
+        if not live:
+            raise RuntimeError("no registered client")
+        return live[-1]
+
+    def received(self) -> list[str]:
+        return [line for c in self.history for line in c.received]
+
+    def render(self, item: FakeInbound, connection: Connection) -> str | None:
+        if item.thread_id or item.media or item.event != "message":
+            return None
+        text = item.text
+        if item.chat_kind == "dm":
+            target = connection.nick
+        else:
+            target = item.chat_id
+            if item.mentions_bot:
+                text = f"{connection.nick}: {text}"
+        tags = connection.tags(
+            time=connection.stamp(), msgid=item.message_id, bot="" if item.is_bot else None
+        )
+        user = item.user_id
+        return f"{tags}:{user}!{user}@people.fake PRIVMSG {target} :{text}"
+
+    async def pump(self) -> None:
+        connection = self.current
+        for item in self.platform.drain_inbound():
+            line = self.render(item, connection)
+            if line is not None:
+                connection.send(line)
+
+    def drop(self) -> None:
+        for connection in list(self.connections):
+            connection.ended()
+
+    def mute(self) -> None:
+        for connection in self.connections:
+            connection.muted = True
+
+    def ban(self) -> None:
+        for connection in list(self.connections):
+            connection.send("ERROR :Closing Link: fake.host (K-Lined)")
+            connection.ended()
+
+
+__all__ = ["DEFAULT_CAPS", "SERVER", "Connection", "FakeReader", "FakeWriter", "IrcWire"]
diff --git a/tests/fakes/platform/line_wire.py b/tests/fakes/platform/line_wire.py
new file mode 100644
index 0000000..85b418e
--- /dev/null
+++ b/tests/fakes/platform/line_wire.py
@@ -0,0 +1,301 @@
+"""A fake LINE Messaging API and webhook sender over the shared fake platform (P16-23).
+
+REST (``@api`` handlers of `HttpCallbackWire`), shaped like LINE's v2 API:
+
+- ``GET /v2/bot/info`` checks the bearer token (401 otherwise) and connects the platform;
+- ``POST /v2/bot/message/reply`` takes a reply token this fake issued with a webhook event, unused
+  and younger than ``token_ttl`` seconds (else 400 "Invalid reply token"), and posts into that
+  token's chat; ``POST /v2/bot/message/push`` posts into ``to``. Both refuse more than five
+  message objects, a text over 5,000 UTF-16 units and a template outside LINE's limits, and answer
+  ``{"sentMessages": [{"id", "quoteToken"}]}``. A call is all or nothing as on LINE: when the
+  platform fails part way (an armed failure), the bubbles already posted by this call are taken
+  back before the failure is answered;
+- ``POST /v2/bot/chat/loading/start`` shows typing; ``GET /v2/bot/message/{id}/content`` serves
+  ``contents``.
+
+Text, template (as a message with buttons; the button data is the postback data), image, audio and
+video objects land on the platform. Errors use LINE's ``{"message": …}`` body.
+
+Webhook: ``render`` turns platform inbound items into signed ``POST /line/webhook`` calls (a fresh
+reply token per event). LINE has no threads, bot authors, edits or captions: those items render
+to nothing (the caption-less photo still arrives). ``attach_listener`` also counts the adapter's
+listener going down as the platform disconnecting (LINE sees the webhook go away), and ``fetch``
+downloads a media URL the adapter handed to LINE from that listener.
+"""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import hmac
+import itertools
+import urllib.parse
+from typing import Any
+
+import httpx
+
+from indus.gateway.adapters._http import CallbackListener
+from tests.fakes.platform.core import (
+    Button,
+    FakeChatPlatform,
+    FakeInbound,
+    FakeMedia,
+    FakeMessage,
+    FakePlatformError,
+)
+from tests.fakes.platform.http_wire import (
+    ERROR_STATUS,
+    ApiCall,
+    Callback,
+    HttpCallbackWire,
+    api,
+    json_body,
+)
+
+WEBHOOK_PATH = "/line/webhook"
+API_HOST = "https://api.line.me"
+
+
+def line_signature(secret: str, body: bytes) -> str:
+    """``X-Line-Signature``: base64 of the HMAC-SHA256 of the raw body under the secret."""
+    return base64.b64encode(hmac.new(secret.encode(), body, hashlib.sha256).digest()).decode()
+
+
+def _units(text: str) -> int:
+    return len(text.encode("utf-16-le")) // 2
+
+
+class LineWire(HttpCallbackWire):
+    base_url = API_HOST
+
+    def __init__(self, platform: FakeChatPlatform, *, token: str, secret: str) -> None:
+        super().__init__(platform)
+        self.token = token
+        self.secret = secret
+        self.token_ttl = 60.0
+        # reply token → (chat id, issued at (monotonic), used)
+        self.reply_tokens: dict[str, list[Any]] = {}
+        self.contents: dict[str, bytes] = {}
+        self.listener: CallbackListener | None = None
+        self._events = itertools.count(1)
+
+    # -- REST -----------------------------------------------------------------------------------
+
+    def _authorized(self, call: ApiCall) -> bool:
+        return call.headers.get("authorization") == f"Bearer {self.token}"
+
+    @staticmethod
+    def _bad(message: str, status: int = 400) -> httpx.Response:
+        return httpx.Response(status, json={"message": message})
+
+    @api("GET", "/v2/bot/info")
+    async def bot_info(self, call: ApiCall) -> httpx.Response:
+        if not self._authorized(call):
+            return self._bad("Authentication failed", 401)
+        await self.platform.connect()
+        return httpx.Response(
+            200,
+            json={
+                "userId": self.platform.bot_user_id,
+                "displayName": self.platform.bot_name,
+                "basicId": "@indus",
+            },
+        )
+
+    def _check_objects(self, messages: object) -> str | None:
+        if not isinstance(messages, list) or not 1 <= len(messages) <= 5:
+            return "messages: size must be between 1 and 5"
+        for item in messages:
+            if not isinstance(item, dict):
+                return "messages: must be objects"
+            kind = item.get("type")
+            if kind == "text" and not 0 < _units(str(item.get("text") or "")) <= 5000:
+                return "messages[].text: length must be between 1 and 5000"
+            if kind == "template":
+                template = item.get("template") or {}
+                actions = template.get("actions") or []
+                if len(str(item.get("altText") or "")) > 400 or not 0 < len(actions) <= 4:
+                    return "template: altText or actions out of range"
+                if _units(str(template.get("text") or "")) > 160:
+                    return "template.text: must be 160 characters or fewer"
+                for action in actions:
+                    if _units(str(action.get("label") or "")) > 20:
+                        return "actions[].label: must be 20 characters or fewer"
+                    if len(str(action.get("data") or "")) > 300:
+                        return "actions[].data: must be 300 characters or fewer"
+            if kind in ("image", "video", "audio"):
+                url = str(item.get("originalContentUrl") or "")
+                if not url.startswith("https://"):
+                    return "originalContentUrl: must be an https URL"
+        return None
+
+    async def _post_one(self, chat_id: str, item: dict[str, Any]) -> FakeMessage:
+        kind = item["type"]
+        if kind == "text":
+            return await self.platform.post(chat_id, item["text"])
+        if kind == "template":
+            template = item["template"]
+            buttons = tuple(Button(a["label"], a["data"]) for a in template["actions"])
+            return await self.platform.post(chat_id, template["text"], buttons=buttons)
+        media_kind = {"image": "photo", "audio": "voice", "video": "video"}[kind]
+        media = FakeMedia(media_kind, item["originalContentUrl"])  # type: ignore[arg-type]
+        return await self.platform.upload(chat_id, media)
+
+    async def _post_batch(self, chat_id: str, messages: list[dict[str, Any]]) -> httpx.Response:
+        posted: list[FakeMessage] = []
+        try:
+            for item in messages:
+                posted.append(await self._post_one(chat_id, item))
+        except FakePlatformError:
+            for message in posted:  # LINE takes a call whole or not at all
+                message.deleted = True
+            raise
+        sent = [{"id": m.message_id, "quoteToken": f"q{m.message_id}"} for m in posted]
+        return httpx.Response(200, json={"sentMessages": sent})
+
+    @api("POST", "/v2/bot/message/reply")
+    async def reply(self, call: ApiCall) -> httpx.Response:
+        if not self._authorized(call):
+            return self._bad("Authentication failed", 401)
+        body = call.json()
+        problem = self._check_objects(body.get("messages"))
+        if problem:
+            return self._bad(problem)
+        entry = self.reply_tokens.get(str(body.get("replyToken")))
+        now = self.platform.clock.monotonic()
+        if entry is None or entry[2] or now - entry[1] >= self.token_ttl:
+            return self._bad("Invalid reply token")
+        entry[2] = True
+        return await self._post_batch(entry[0], body["messages"])
+
+    @api("POST", "/v2/bot/message/push")
+    async def push(self, call: ApiCall) -> httpx.Response:
+        if not self._authorized(call):
+            return self._bad("Authentication failed", 401)
+        body = call.json()
+        problem = self._check_objects(body.get("messages"))
+        if problem:
+            return self._bad(problem)
+        return await self._post_batch(str(body.get("to")), body["messages"])
+
+    @api("POST", "/v2/bot/chat/loading/start")
+    async def loading(self, call: ApiCall) -> httpx.Response:
+        body = call.json()
+        seconds = body.get("loadingSeconds")
+        if not isinstance(seconds, int) or seconds % 5 or not 5 <= seconds <= 60:
+            return self._bad("loadingSeconds: must be a multiple of 5 from 5 to 60")
+        await self.platform.typing(str(body.get("chatId")))
+        return httpx.Response(202, json={})
+
+    @api("GET", "/v2/bot/message/{message}/content")
+    async def content(self, call: ApiCall, message: str) -> httpx.Response:
+        if not self._authorized(call):
+            return self._bad("Authentication failed", 401)
+        data = self.contents.get(message)
+        if data is None:
+            return self._bad("Not found", 404)
+        return httpx.Response(200, content=data, headers={"Content-Type": "image/jpeg"})
+
+    def error_response(self, exc: FakePlatformError) -> httpx.Response:
+        headers: dict[str, str] = {}
+        if exc.retry_after is not None and exc.kind.value == "rate_limit":
+            headers["Retry-After"] = str(int(exc.retry_after))
+        status = ERROR_STATUS.get(exc.kind, 500)
+        return httpx.Response(status, json={"message": exc.text}, headers=headers)
+
+    def reply_calls(self) -> list[ApiCall]:
+        return self.calls_to("POST", "/v2/bot/message/reply")
+
+    def push_calls(self) -> list[ApiCall]:
+        return self.calls_to("POST", "/v2/bot/message/push")
+
+    # -- webhook --------------------------------------------------------------------------------
+
+    def attach_listener(self, listener: CallbackListener) -> None:
+        """Deliver callbacks to ``listener`` and see its going down as a disconnect."""
+        self.attach(listener.app)
+        self.listener = listener
+        stop = listener.stop
+        platform = self.platform
+
+        async def stopping(budget: float = 5.0) -> None:
+            await stop(budget)
+            await platform.disconnect()
+
+        listener.stop = stopping  # type: ignore[method-assign]
+
+    def issue_token(self, chat_id: str) -> str:
+        token = f"rt{next(self._events):030d}"
+        self.reply_tokens[token] = [chat_id, self.platform.clock.monotonic(), False]
+        return token
+
+    def event(self, item: FakeInbound) -> dict[str, Any] | None:
+        """The LINE webhook event for ``item``, or None when LINE has no such event."""
+        if item.thread_id is not None or item.is_bot or item.event == "edited":
+            return None
+        if item.chat_kind == "dm":
+            source: dict[str, Any] = {"type": "user", "userId": item.user_id}
+        else:
+            source = {"type": "group", "groupId": item.chat_id, "userId": item.user_id}
+        base: dict[str, Any] = {
+            "mode": "active",
+            "timestamp": int(item.at.timestamp() * 1000),
+            "source": source,
+            "webhookEventId": f"01EV{item.update_id:022d}",
+            "deliveryContext": {"isRedelivery": False},
+            "replyToken": self.issue_token(item.chat_id),
+        }
+        if item.event == "button":
+            return {**base, "type": "postback", "postback": {"data": item.button_data}}
+        message: dict[str, Any] = {"id": item.message_id, "quoteToken": f"q{item.message_id}"}
+        if item.media:
+            media = item.media[0]
+            kind = {"voice": "audio", "audio": "audio", "photo": "image", "video": "video"}.get(
+                media.kind, "file"
+            )
+            message.update(type=kind, contentProvider={"type": "line"})
+            if kind == "audio":
+                message["duration"] = int((media.duration or 1.0) * 1000)
+            if kind == "file":
+                message.update(fileName=media.ref, fileSize=len(media.ref))
+            self.contents[item.message_id] = b"fake bytes of " + media.ref.encode()
+        else:
+            text = item.text
+            message.update(type="text", text=text)
+            if item.mentions_bot:
+                handle = f"@{self.platform.bot_name}"
+                message["text"] = f"{handle} {text}"
+                message["mention"] = {
+                    "mentionees": [
+                        {
+                            "index": 0,
+                            "length": _units(handle),
+                            "type": "user",
+                            "userId": self.platform.bot_user_id,
+                            "isSelf": True,
+                        }
+                    ]
+                }
+        if item.reply_to:
+            message["quotedMessageId"] = item.reply_to
+        return {**base, "type": "message", "message": message}
+
+    def signed(self, events: list[dict[str, Any]], *, signature: str | None = None) -> Callback:
+        body = json_body({"destination": self.platform.bot_user_id, "events": events})
+        headers = {
+            "Content-Type": "application/json",
+            "X-Line-Signature": signature or line_signature(self.secret, body),
+        }
+        return Callback(WEBHOOK_PATH, body, headers)
+
+    def render(self, item: FakeInbound) -> Callback | None:
+        event = self.event(item)
+        return None if event is None else self.signed([event])
+
+    async def fetch(self, url: str) -> httpx.Response:
+        """Download a media URL the adapter gave LINE, from the adapter's own listener."""
+        parts = urllib.parse.urlsplit(url)
+        return await self.deliver(Callback(parts.path, b"", method="GET", query=parts.query))
+
+
+__all__ = ["API_HOST", "WEBHOOK_PATH", "LineWire", "line_signature"]
diff --git a/tests/fakes/platform/ntfy_wire.py b/tests/fakes/platform/ntfy_wire.py
new file mode 100644
index 0000000..c93a443
--- /dev/null
+++ b/tests/fakes/platform/ntfy_wire.py
@@ -0,0 +1,174 @@
+"""A fake ntfy server over the shared fake platform (P16-26), no socket.
+
+- ``GET /<topic>[,<topic>…]/json`` checks the credential (401 without it when ``token`` is set),
+  connects the platform and answers with an endless newline-delimited JSON stream: an ``open``
+  event, then every message published to those topics from then on (``since=<id>`` first replays
+  the cached messages after that id). Closing the stream disconnects the platform.
+- ``POST /<topic>`` posts the body on the platform (armed failures answer as ntfy would, with
+  ``{"code", "http", "error"}``), stores the message (``id``, ``time``, ``topic``, ``message``,
+  ``title``, ``tags``, ``priority`` from the query) and streams it to open subscribers of that topic
+  — our own replies come back, as on a real server.
+- ``pump()`` publishes the platform's inbound items as messages. ntfy has no groups, threads, bot
+  authors, edits or (in this adapter) attachments: those items publish nothing.
+- ``keepalive()`` sends a keepalive line on every open stream; ``drop()`` ends them all (the
+  server went away). A stream that gets nothing just stays silent, which is how a stall looks.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import itertools
+import json
+from collections.abc import AsyncIterator
+from typing import Any
+
+import httpx
+
+from tests.fakes.platform.core import FakeChatPlatform, FakeInbound, FakePlatformError
+from tests.fakes.platform.http_wire import ERROR_STATUS, ApiCall, HttpCallbackWire, api
+
+
+class FakeStream(httpx.AsyncByteStream):
+    """One open subscription: lines go in through ``put``; ``None`` ends it."""
+
+    def __init__(self, wire: NtfyWire, topics: tuple[str, ...]) -> None:
+        self.wire = wire
+        self.topics = topics
+        self.queue: asyncio.Queue[bytes | None] = asyncio.Queue()
+        self.closed = False
+
+    def put(self, event: dict[str, Any] | None) -> None:
+        if not self.closed:
+            self.queue.put_nowait(None if event is None else (json.dumps(event) + "\n").encode())
+
+    async def __aiter__(self) -> AsyncIterator[bytes]:
+        while True:
+            line = await self.queue.get()
+            if line is None:
+                return
+            yield line
+
+    async def aclose(self) -> None:
+        if self.closed:
+            return
+        self.closed = True
+        if self in self.wire.streams:
+            self.wire.streams.remove(self)
+        if not self.wire.streams:
+            await self.wire.platform.disconnect()
+
+
+class NtfyWire(HttpCallbackWire):
+    base_url = "https://ntfy.fake.test"
+
+    def __init__(self, platform: FakeChatPlatform, *, token: str | None = None) -> None:
+        super().__init__(platform)
+        self.token = token
+        self.streams: list[FakeStream] = []
+        self.cache: list[dict[str, Any]] = []
+        self.subscriptions: list[ApiCall] = []
+        self._ids = itertools.count(1)
+        # When set, a subscribe call answers with this status instead.
+        self.refuse_subscribe: int | None = None
+
+    def _authorized(self, call: ApiCall) -> bool:
+        if self.token is None:
+            return True
+        header = call.headers.get("authorization", "")
+        return header == f"Bearer {self.token}"
+
+    def _error(self, status: int, text: str) -> httpx.Response:
+        return httpx.Response(
+            status, json={"code": status * 100 + 1, "http": status, "error": text}
+        )
+
+    def error_response(self, exc: FakePlatformError) -> httpx.Response:
+        status = ERROR_STATUS.get(exc.kind, 500)
+        response = self._error(status, exc.text)
+        if exc.retry_after is not None and status == 429:
+            response.headers["Retry-After"] = str(int(exc.retry_after))
+        return response
+
+    def _event(self, topic: str, message: str, **fields: Any) -> dict[str, Any]:
+        event = {
+            "id": fields.pop("id", None) or f"m{next(self._ids):010d}",
+            "time": int(self.platform.clock.now().timestamp()),
+            "event": "message",
+            "topic": topic,
+            "message": message,
+            **{k: v for k, v in fields.items() if v not in (None, "", [])},
+        }
+        self.cache.append(event)
+        for stream in list(self.streams):
+            if topic in stream.topics:
+                stream.put(event)
+        return event
+
+    @api("GET", "/{topics}/json")
+    async def subscribe(self, call: ApiCall, topics: str) -> httpx.Response:
+        self.subscriptions.append(call)
+        if not self._authorized(call):
+            return self._error(401, "unauthorized")
+        if self.refuse_subscribe is not None:
+            return self._error(self.refuse_subscribe, "refused")
+        await self.platform.connect()
+        names = tuple(topics.split(","))
+        stream = FakeStream(self, names)
+        self.streams.append(stream)
+        stream.put({"id": "open", "time": 0, "event": "open", "topic": topics})
+        since = call.params.get("since")
+        if since:
+            ids = [e["id"] for e in self.cache]
+            after = self.cache[ids.index(since) + 1 :] if since in ids else []
+            for event in after:
+                if event["topic"] in names:
+                    stream.put(event)
+        return httpx.Response(200, stream=stream, headers={"Content-Type": "application/x-ndjson"})
+
+    @api("POST", "/{topic}")
+    async def publish(self, call: ApiCall, topic: str) -> httpx.Response:
+        if not self._authorized(call):
+            return self._error(401, "unauthorized")
+        text = call.body.decode("utf-8")
+        sent = await self.platform.post(topic, text)
+        tags = [t for t in call.params.get("tags", "").split(",") if t]
+        event = self._event(
+            topic,
+            text,
+            id=sent.message_id,
+            title=call.params.get("title"),
+            tags=tags,
+            priority=call.params.get("priority"),
+        )
+        return httpx.Response(200, json=event)
+
+    def publish_inbound(self, item: FakeInbound) -> dict[str, Any] | None:
+        if item.chat_kind != "dm" or item.thread_id or item.is_bot or item.media:
+            return None
+        if item.event != "message":
+            return None
+        return self._event(item.chat_id, item.text, id=item.message_id)
+
+    async def pump(self) -> list[httpx.Response]:
+        for item in self.platform.drain_inbound():
+            self.publish_inbound(item)
+        return []
+
+    def keepalive(self) -> None:
+        for stream in list(self.streams):
+            stream.put(
+                {"id": "ka", "time": 0, "event": "keepalive", "topic": ",".join(stream.topics)}
+            )
+
+    def drop(self) -> None:
+        for stream in list(self.streams):
+            stream.put(None)
+
+    def send_raw(self, line: str) -> None:
+        """A raw line on every open stream (not JSON, odd events)."""
+        for stream in list(self.streams):
+            if not stream.closed:
+                stream.queue.put_nowait((line + "\n").encode())
+
+
+__all__ = ["FakeStream", "NtfyWire"]
