+]
+
+log = logging.getLogger(__name__)
+
+API_TARGET: Final = "indus.gateway.adapters.line.api:LineApi"
+
+DEFAULT_PORT: Final = 8646
+WEBHOOK_PATH: Final = "/line/webhook"
+MEDIA_PATH: Final = "/line/media"
