@@ -0,0 +1,241 @@
+import * as React from "react";
+import { describe, expect, it, vi } from "vitest";
+import { HOST_KEY as MAIN_HOST_KEY } from "../../electron/plugins/diskPlugins.ts";
+import { REACT_EXPORTS, SDK_EXPORTS } from "../../electron/plugins/sdkNames.ts";
+import { PLUGIN_SCHEME as MAIN_SCHEME } from "../../electron/security/csp.ts";
+import { HOST_KEY, PLUGIN_SCHEME } from "./loader.ts";
+import {
+  AREAS,
+  type Contribution,
+  ContributionError,
+  ContributionRegistry,
+  MAX_PER_SOURCE,
+} from "./registry.ts";
+import {
+  createPluginContext,
+  definePlugin,
+  PluginLifetime,
+  PluginShapeError,
+  SDK_MODULE,
+} from "./sdk.ts";
+import { fakeHost } from "./testHost.ts";
+
+const render = () => null;
+
+function status(id: string, source = "app", order?: number): Contribution {
+  return { id, area: "status-bar", source, render, ...(order === undefined ? {} : { order }) };
+}
+
+describe("contribution registry", () => {
+  it("lists an area in order, then by id, and notifies once per change", () => {
+    const registry = new ContributionRegistry();
+    const seen = vi.fn();
+    registry.subscribe(seen);
+    registry.register(status("b"));
+    registry.registerMany([status("c", "app", -1), status("a")]);
+    expect(registry.list("status-bar").map((c) => c.id)).toEqual(["c", "a", "b"]);
+    expect(seen).toHaveBeenCalledTimes(2);
+    expect(registry.list("pane")).toEqual([]);
+  });
+
+  it("refuses bad contributions and duplicate ids", () => {
+    const registry = new ContributionRegistry();
+    registry.register(status("one"));
+    expect(() => registry.register(status("one"))).toThrow(ContributionError);
+    expect(() => registry.register({ id: "x", area: "nowhere" as never, source: "app" })).toThrow(
+      /unknown area/,
+    );
+    expect(() =>
+      registry.register({ id: "bad id", area: "status-bar", source: "app", render }),
+    ).toThrow(/bad contribution id/);
+    expect(() =>
+      registry.register({ id: "p", area: "palette-command", source: "app", title: "T" }),
+    ).toThrow(/needs title and run/);
+    expect(() =>
+      registry.register({ id: "r", area: "route", source: "app", path: "nope", render }),
+    ).toThrow(/path like/);
+    // all or nothing: one bad entry keeps the good one out
+    expect(() => registry.registerMany([status("two"), status("one")])).toThrow();
+    expect(registry.list("status-bar").map((c) => c.id)).toEqual(["one"]);
+  });
+
+  it("covers every area of the row", () => {
+    expect(AREAS).toEqual([
+      "pane",
+      "route",
+      "sidebar-nav",
+      "status-bar",
+      "title-bar",
+      "palette-command",
+      "keybind",
+      "theme",
+      "composer-extension",
+      "session-row-decoration",
+      "model-menu-decoration",
+      "appearance-setting",
+      "plugin-settings-page",
+      "transcript-directive",
+    ]);
+  });
+
+  it("a throwing register leaves no partial contributions", () => {
+    const registry = new ContributionRegistry();
+    const seen = vi.fn();
+    registry.subscribe(seen);
+    expect(() =>
+      registry.transaction("plugin:x", (stage) => {
+        stage.add(status("x:1", "plugin:x"));
+        stage.add(status("x:2", "plugin:x"));
+        throw new Error("boom in register");
+      }),
+    ).toThrow("boom in register");
+    expect(registry.list("status-bar")).toEqual([]);
+    expect(seen).not.toHaveBeenCalled();
+    // and after it, the same ids can be registered (nothing half-held)
+    registry.transaction("plugin:x", (stage) => {
+      stage.add(status("x:1", "plugin:x"));
+    });
+    expect(registry.list("status-bar").map((c) => c.id)).toEqual(["x:1"]);
+  });
+
+  it("commits a transaction in one change; its disposer drops all of it", () => {
+    const registry = new ContributionRegistry();
+    const seen = vi.fn();
+    registry.subscribe(seen);
+    const dispose = registry.transaction("plugin:y", (stage) => {
+      stage.add(status("y:1", "plugin:y"));
+      const undo = stage.add(status("y:2", "plugin:y"));
+      stage.add(status("y:3", "plugin:y"));
+      undo(); // withdrawn while staging: never committed
+    });
+    expect(seen).toHaveBeenCalledTimes(1);
+    expect(registry.list("status-bar").map((c) => c.id)).toEqual(["y:1", "y:3"]);
+    dispose();
+    dispose();
+    expect(registry.list("status-bar")).toEqual([]);
+    expect(seen).toHaveBeenCalledTimes(2);
+  });
+
+  it("bounds the contributions of one source", () => {
+    const registry = new ContributionRegistry();
+    expect(() =>
+      registry.transaction("plugin:z", (stage) => {
+        for (let i = 0; i <= MAX_PER_SOURCE; i += 1) stage.add(status(`z:${i}`, "plugin:z"));
+      }),
+    ).toThrow(new RegExp(String(MAX_PER_SOURCE)));
+    expect(registry.countOf("plugin:z")).toBe(0);
+    expect(() =>
+      registry.transaction("plugin:z", (stage) => stage.add(status("w:1", "plugin:w"))),
+    ).toThrow(/another source/);
+  });
+
+  it("a subscriber that throws does not stop the others", () => {
+    const registry = new ContributionRegistry();
+    const good = vi.fn();
+    registry.subscribe(() => {
+      throw new Error("bad");
+    });
+    registry.subscribe(good);
+    registry.register(status("a"));
+    expect(good).toHaveBeenCalledOnce();
+  });
+});
+
+describe("plugin context", () => {
+  function contextFor(registry = new ContributionRegistry(), host = fakeHost()) {
+    const lifetime = new PluginLifetime();
+    const ctx = createPluginContext({
+      pluginId: "demo",
+      host,
+      registry,
+      lifetime,
+      stage: () => null,
+    });
+    return { ctx, lifetime, registry, host };
+  }
+
+  it("stamps the source and namespaces ids", () => {
+    const { ctx, registry } = contextFor();
+    ctx.register({ id: "clock", area: "status-bar", render });
+    expect(registry.list("status-bar")).toEqual([
+      expect.objectContaining({ id: "demo:clock", source: "plugin:demo" }),
+    ]);
+  });
+
+  it("ending the lifetime undoes contributions, timers and listeners; one bad cleanup does not stop the rest", () => {
+    vi.useFakeTimers();
+    const { ctx, lifetime, registry } = contextFor();
+    const fired = vi.fn();
+    ctx.register({ id: "a", area: "status-bar", render });
+    ctx.setInterval(fired, 100);
+    const target = new EventTarget();
+    const heard = vi.fn();
+    ctx.addEventListener(target, "ping", heard);
+    ctx.onDispose(() => {
+      throw new Error("bad cleanup");
+    });
+    const errors: unknown[] = [];
+    lifetime.end((e) => errors.push(e));
+    vi.advanceTimersByTime(500);
+    target.dispatchEvent(new Event("ping"));
+    expect(fired).not.toHaveBeenCalled();
+    expect(heard).not.toHaveBeenCalled();
+    expect(registry.list("status-bar")).toEqual([]);
+    expect(errors).toHaveLength(1);
+    vi.useRealTimers();
+  });
+
+  it("curated doors: rpc allow-list, own REST namespace, app paths only", async () => {
+    const { ctx, host } = contextFor();
+    await ctx.rpc("session.list");
+    await expect(ctx.rpc("prompt.submit", {})).rejects.toThrow(PluginShapeError);
+    await expect(ctx.rpc("shell.exec", {})).rejects.toThrow(/not open to plugins/);
+    expect(host.rpcCalls).toEqual(["session.list"]);
+    await ctx.rest("/items");
+    expect(host.restCalls).toEqual(["/api/ext/demo/items"]);
+    await expect(async () => ctx.rest("/../../api/env")).rejects.toThrow();
+    expect(() => ctx.rest("https://elsewhere.test/x")).toThrow();
+    ctx.navigate("/settings?view=about");
+    expect(() => ctx.navigate("https://evil.test/")).toThrow();
+    expect(() => ctx.navigate("//evil.test/")).toThrow();
+    expect(host.navigated).toEqual(["/settings?view=about"]);
+  });
+
+  it("the context holds no bridge", () => {
+    const { ctx } = contextFor();
+    const reachable = JSON.stringify(Object.keys(ctx));
+    expect(reachable).not.toContain("indusDesktop");
+    for (const value of Object.values(ctx)) {
+      expect(value).not.toBe((globalThis as { indusDesktop?: unknown }).indusDesktop ?? Symbol());
+    }
+  });
+
+  it("storage is namespaced per plugin", () => {
+    const host = fakeHost();
+    const a = contextFor(new ContributionRegistry(), host).ctx;
+    a.storage.set("k", { n: 1 });
+    expect(a.storage.get("k", null)).toEqual({ n: 1 });
+    expect(host.storage()?.getItem("indus.plugin.demo.k")).toBe('{"n":1}');
+    a.storage.remove("k");
+    expect(a.storage.get("k", "gone")).toBe("gone");
+  });
+});
+
+describe("sdk module", () => {
+  it("definePlugin checks the shape", () => {
+    expect(() => definePlugin({ id: "Bad", register: () => undefined })).toThrow(PluginShapeError);
+    expect(() => definePlugin({ id: "ok" } as never)).toThrow(/register/);
+    const plugin = definePlugin({ id: "ok", register: () => undefined });
+    expect(plugin.id).toBe("ok");
+  });
+
+  it("exports exactly what main's shim re-exports; React has every shimmed name", () => {
+    expect(Object.keys(SDK_MODULE).sort()).toEqual([...SDK_EXPORTS].sort());
+    for (const name of REACT_EXPORTS) expect(name in React, name).toBe(true);
+  });
+
+  it("main and the renderer agree on the host key and the scheme", () => {
+    expect(HOST_KEY).toBe(MAIN_HOST_KEY);
+    expect(PLUGIN_SCHEME).toBe(MAIN_SCHEME);
+  });
+});
diff --git a/apps/desktop/src/contrib/registry.ts b/apps/desktop/src/contrib/registry.ts
new file mode 100644
index 0000000..41c2c68
--- /dev/null
+++ b/apps/desktop/src/contrib/registry.ts
@@ -0,0 +1,238 @@
+// The contribution registry (P24-32): the one place the shell's extensible areas read from.
+//
+// A contribution is a small record `{ id, area, source, order?, … }`; the shell lists an area
+// (`list("status-bar")`) and re-renders when it changes (`subscribe`). Bundled code registers
+// directly; plugins never do — they get a `PluginContext` (`sdk.ts`) that stamps the source
+// (`plugin:<id>`), namespaces the id (`<plugin>:<local>`) and stages what `register(ctx)` adds.
+//
+// Loading a plugin is a transaction (`stage`/`commit`/`abort`): everything a plugin's `register`
+// adds is checked and held back; only when `register` returned without throwing — and stayed under
+// `MAX_PER_SOURCE` — does all of it enter the registry, in one change. A throwing `register`
+// leaves nothing behind. Every entry carries a disposer; removing a source drops all of its
+// entries at once.
+
+export const AREAS = [
+  "pane",
+  "route",
+  "sidebar-nav",
+  "status-bar",
+  "title-bar",
+  "palette-command",
+  "keybind",
+  "theme",
+  "composer-extension",
+  "session-row-decoration",
+  "model-menu-decoration",
+  "appearance-setting",
+  "plugin-settings-page",
+  "transcript-directive",
+] as const;
+
+export type Area = (typeof AREAS)[number];
+
+/** At most this many live contributions per source (a plugin cannot flood an area). */
+export const MAX_PER_SOURCE = 200;
+
+const ID = /^[A-Za-z0-9][A-Za-z0-9:._-]{0,127}$/;
+
+export interface Contribution {
+  readonly id: string;
+  readonly area: Area;
+  /** `app` for bundled code, `plugin:<id>` for a plugin. */
+  readonly source: string;
+  /** Lower first; ties by id. */
+  readonly order?: number;
+  readonly [field: string]: unknown;
+}
+
+export class ContributionError extends Error {}
+
+type Fn = (...args: never[]) => unknown;
+
+function isFn(value: unknown): value is Fn {
+  return typeof value === "function";
+}
+
+function isText(value: unknown, max = 256): value is string {
+  return typeof value === "string" && value.trim() !== "" && value.length <= max;
+}
+
+/** The fields each area needs; anything else a contribution carries is the area's business. */
+const REQUIRED: Readonly<Record<Area, (c: Contribution) => string | null>> = {
+  pane: (c) => (isText(c.title) && isFn(c.render) ? null : "a pane needs title and render"),
+  route: (c) =>
+    typeof c.path === "string" && /^\/[a-z0-9][a-z0-9/_-]*$/.test(c.path) && isFn(c.render)
+      ? null
+      : "a route needs a path like /name and render",
+  "sidebar-nav": (c) =>
+    isText(c.label) && typeof c.path === "string" ? null : "a nav item needs label and path",
+  "status-bar": (c) => (isFn(c.render) ? null : "a status item needs render"),
+  "title-bar": (c) => (isFn(c.render) ? null : "a title bar item needs render"),
+  "palette-command": (c) =>
+    isText(c.title) && isFn(c.run) ? null : "a palette command needs title and run",
+  keybind: (c) => (isText(c.keys, 64) && isFn(c.run) ? null : "a keybind needs keys and run"),
+  theme: (c) =>
+    isText(c.label) && typeof c.tokens === "object" && c.tokens !== null
+      ? null
+      : "a theme needs label and tokens",
+  "composer-extension": (c) => (isFn(c.render) ? null : "a composer extension needs render"),
+  "session-row-decoration": (c) => (isFn(c.render) ? null : "a decoration needs render"),
+  "model-menu-decoration": (c) => (isFn(c.render) ? null : "a decoration needs render"),
+  "appearance-setting": (c) =>
+    isText(c.label) && isFn(c.render) ? null : "a setting needs label and render",
+  "plugin-settings-page": (c) =>
+    isText(c.title) && isFn(c.render) ? null : "a settings page needs title and render",
+  "transcript-directive": (c) =>
+    isText(c.name, 64) && isFn(c.render) ? null : "a directive needs name and render",
+};
+
+/** Throws `ContributionError` when `c` cannot be registered. */
+export function checkContribution(c: Contribution): void {
+  if (typeof c !== "object" || c === null) throw new ContributionError("not a contribution");
+  if (!ID.test(c.id)) throw new ContributionError(`bad contribution id ${JSON.stringify(c.id)}`);
+  if (!(AREAS as readonly string[]).includes(c.area)) {
+    throw new ContributionError(`unknown area ${JSON.stringify(c.area)}`);
+  }
+  if (!isText(c.source, 128)) throw new ContributionError("a contribution needs its source");
+  if (c.order !== undefined && !Number.isFinite(c.order)) {
+    throw new ContributionError("order must be a number");
+  }
+  const problem = REQUIRED[c.area](c);
+  if (problem !== null) throw new ContributionError(`${c.id}: ${problem}`);
+}
+
+type Listener = () => void;
+
+export interface Staging {
+  readonly source: string;
+  add(c: Contribution): () => void;
+}
+
+export class ContributionRegistry {
+  private readonly entries = new Map<string, Contribution>();
+  private readonly listeners = new Set<Listener>();
+  private version = 0;
+
+  /** Register one contribution now; returns its disposer (idempotent). */
+  register(c: Contribution): () => void {
+    return this.registerMany([c]);
+  }
+
+  /** Register several at once: all of them or none. */
+  registerMany(list: readonly Contribution[]): () => void {
+    const fresh = new Map<string, Contribution>();
+    const perSource = new Map<string, number>();
+    for (const c of list) {
+      checkContribution(c);
+      if (this.entries.has(c.id) || fresh.has(c.id)) {
+        throw new ContributionError(`contribution ${c.id} is already registered`);
+      }
+      fresh.set(c.id, c);
+      perSource.set(c.source, (perSource.get(c.source) ?? 0) + 1);
+    }
+    for (const [source, adding] of perSource) {
+      if (this.countOf(source) + adding > MAX_PER_SOURCE) {
+        throw new ContributionError(`${source} would pass ${MAX_PER_SOURCE} contributions`);
+      }
+    }
+    if (fresh.size === 0) return () => undefined;
+    for (const [id, c] of fresh) this.entries.set(id, c);
+    this.changed();
+    let disposed = false;
+    return () => {
+      if (disposed) return;
+      disposed = true;
+      let removed = false;
+      for (const [id, c] of fresh) {
+        if (this.entries.get(id) === c) {
+          this.entries.delete(id);
+          removed = true;
+        }
+      }
+      if (removed) this.changed();
+    };
+  }
+
+  /**
+   * Run `fill` with a staging area for `source`; commit what it added only when it returns
+   * normally. Returns the disposer of the committed set; rethrows (with nothing registered) when
+   * `fill` throws or the staged set is refused.
+   */
+  transaction(source: string, fill: (stage: Staging) => void): () => void {
+    const staged: Contribution[] = [];
+    const removed = new Set<Contribution>();
+    let open = true;
+    const stage: Staging = {
+      source,
+      add: (c) => {
+        if (!open) throw new ContributionError("the load of this plugin already finished");
+        checkContribution(c);
+        if (c.source !== source) throw new ContributionError("a contribution of another source");
+        staged.push(c);
+        if (staged.length > MAX_PER_SOURCE) {
+          throw new ContributionError(`${source} would pass ${MAX_PER_SOURCE} contributions`);
+        }
+        return () => {
+          removed.add(c);
+        };
+      },
+    };
+    try {
+      fill(stage);
+    } finally {
+      open = false;
+    }
+    return this.registerMany(staged.filter((c) => !removed.has(c)));
+  }
+
+  list(area: Area): Contribution[] {
+    return [...this.entries.values()]
+      .filter((c) => c.area === area)
+      .sort((a, b) => (a.order ?? 0) - (b.order ?? 0) || a.id.localeCompare(b.id));
+  }
+
+  bySource(source: string): Contribution[] {
+    return [...this.entries.values()].filter((c) => c.source === source);
+  }
+
+  countOf(source: string): number {
+    let count = 0;
+    for (const c of this.entries.values()) if (c.source === source) count += 1;
+    return count;
+  }
+
+  /** Drop every entry of `source` (a plugin unloaded, whatever disposers it lost). */
+  removeSource(source: string): void {
+    let removed = false;
+    for (const [id, c] of this.entries) {
+      if (c.source === source) {
+        this.entries.delete(id);
+        removed = true;
+      }
+    }
+    if (removed) this.changed();
+  }
+
+  snapshot = (): number => this.version;
+
+  subscribe = (listener: Listener): (() => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  private changed(): void {
+    this.version += 1;
+    for (const listener of [...this.listeners]) {
+      try {
+        listener();
+      } catch {
+        // a subscriber's bug never stops the others
+      }
+    }
+  }
+}
+
+/** The app's registry. */
+export const contributions = new ContributionRegistry();
diff --git a/apps/desktop/src/contrib/sdk.ts b/apps/desktop/src/contrib/sdk.ts
