@@ -0,0 +1,203 @@
+import { describe, expect, it, vi } from "vitest";
+import { FakeVoice } from "../../test/_stubs_u3.ts";
+import {
+  Conversation,
+  type LevelSource,
+  type Player,
+  ReadAloud,
+  speakable,
+  VAD,
+} from "./conversation.ts";
+import { type AudioClip, type Recipient, type Recorder, rpcVoicePort } from "./dictation.ts";
+
+const A: Recipient = { sessionId: "session-a", profile: "work" };
+
+class FakePlayer implements Player {
+  playing: AudioClip | null = null;
+  played: string[] = [];
+  stops = 0;
+  private end: (() => void) | null = null;
+
+  play(clip: AudioClip): Promise<void> {
+    this.playing = clip;
+    this.played.push(new TextDecoder().decode(clip.bytes));
+    return new Promise((resolve) => {
+      this.end = () => {
+        this.playing = null;
+        resolve();
+      };
+    });
+  }
+
+  finish(): void {
+    this.end?.();
+  }
+
+  stop(): void {
+    this.stops += 1;
+    this.end?.();
+  }
+}
+
+class FakeLevels implements LevelSource {
+  onFrame: ((rms: number, at: number) => void) | null = null;
+  stopped = 0;
+  async start(onFrame: (rms: number, at: number) => void) {
+    this.onFrame = onFrame;
+  }
+  stop() {
+    this.stopped += 1;
+  }
+}
+
+function recorder(): Recorder {
+  return {
+    start: async () => undefined,
+    stop: async () => ({ bytes: new Uint8Array([9, 9]), mime: "audio/webm" }),
+    cancel: () => undefined,
+  };
+}
+
+async function settle(): Promise<void> {
+  for (let i = 0; i < 10; i += 1) await Promise.resolve();
+}
+
+function rig() {
+  const voice = new FakeVoice();
+  const player = new FakePlayer();
+  const levels = new FakeLevels();
+  const submitted: Array<[string | null, string]> = [];
+  const conversation = new Conversation({
+    port: voice,
+    levels,
+    recorder: async () => recorder(),
+    player,
+    submit: async (recipient, text) => {
+      submitted.push([recipient.sessionId, text]);
+      return `**Reply** to ${text}`;
+    },
+  });
+  return { voice, player, levels, conversation, submitted };
+}
+
+/** Speech for `ms`, then silence long enough to end the turn. */
+async function sayAndPause(levels: FakeLevels, from: number, ms = 400): Promise<number> {
+  let at = from;
+  for (; at < from + ms; at += 50) levels.onFrame?.(0.2, at);
+  await settle();
+  for (; at <= from + ms + VAD.silenceMs; at += 100) levels.onFrame?.(0.001, at);
+  await settle();
+  return at;
+}
+
+describe("spoken conversation", () => {
+  it("VAD ends the turn after silence, submits to the pinned session and speaks the reply", async () => {
+    const { voice, player, levels, conversation, submitted } = rig();
+    await conversation.start(A);
+    expect(conversation.phase).toBe("listening");
+    await sayAndPause(levels, 0);
+    await settle();
+    expect(submitted).toEqual([["session-a", "hello"]]);
+    expect(voice.spoken).toEqual(["Reply to hello"]);
+    expect(conversation.phase).toBe("speaking");
+    player.finish();
+    await settle();
+    expect(conversation.phase).toBe("listening");
+  });
+
+  it("barge-in stops playback", async () => {
+    const { player, levels, conversation } = rig();
+    await conversation.start(A);
+    const at = await sayAndPause(levels, 0);
+    await settle();
+    expect(player.playing).not.toBeNull();
+    levels.onFrame?.(0.3, at + 10); // the person talks over the reply
+    await settle();
+    expect(player.stops).toBe(1);
+    expect(player.playing).toBeNull();
+    expect(conversation.phase).toBe("capturing");
+  });
+
+  it("barge-in while the reply's audio is still being made abandons it", async () => {
+    const { voice, player, levels, conversation } = rig();
+    voice.holdSpeechReplies = true;
+    await conversation.start(A);
+    const at = await sayAndPause(levels, 0);
+    await settle();
+    expect(conversation.phase).toBe("speaking");
+    levels.onFrame?.(0.3, at + 10);
+    voice.releaseSpeech();
+    await settle();
+    expect(player.played).toEqual([]);
+    expect(conversation.phase).toBe("capturing");
+  });
+
+  it("quiet frames never start a turn; stop ends capture and playback", async () => {
+    const { levels, conversation, submitted } = rig();
+    await conversation.start(A);
+    for (let at = 0; at < 3000; at += 100) levels.onFrame?.(0.005, at);
+    await settle();
+    expect(submitted).toEqual([]);
+    conversation.stop();
+    expect(conversation.phase).toBe("off");
+    expect(levels.stopped).toBe(1);
+    levels.onFrame?.(0.5, 4000);
+    expect(conversation.phase).toBe("off");
+  });
+
+  it("a turn never runs past the maximum", async () => {
+    const { levels, conversation, submitted } = rig();
+    await conversation.start(A);
+    levels.onFrame?.(0.2, 0);
+    await settle();
+    for (let at = 500; at <= VAD.maxTurnMs; at += 500) levels.onFrame?.(0.2, at);
+    await settle();
+    expect(submitted).toHaveLength(1);
+  });
+});
+
+describe("read-aloud", () => {
+  it("speaks markdown as plain words; a second reply stops the first", async () => {
+    const voice = new FakeVoice();
+    const player = new FakePlayer();
+    const reader = new ReadAloud(voice, player);
+    void reader.speak("# Title\n\nSee [the docs](https://x.test) and `code`.");
+    await settle();
+    expect(player.played).toEqual(["Title See the docs and code."]);
+    void reader.speak("Second");
+    await settle();
+    expect(player.stops).toBe(1);
+    expect(player.played.at(-1)).toBe("Second");
+    reader.stop();
+    expect(reader.speaking).toBe(false);
+    expect(speakable("```js\nx()\n```\n**done**")).toBe("done");
+  });
+});
+
+describe("rpcVoicePort", () => {
+  it("sends audio as base64 with the pinned session and decodes speech", async () => {
+    const calls: Array<[string, unknown]> = [];
+    const port = rpcVoicePort(async (method, params) => {
+      calls.push([method, params]);
+      return method === "voice.transcribe"
+        ? { text: "hi" }
+        : { audio_b64: btoa("RIFF"), mime: "audio/wav" };
+    });
+    const signal = new AbortController().signal;
+    expect(
+      await port.transcribe(
+        { bytes: new Uint8Array([104, 105]), mime: "audio/webm" },
+        { signal, recipient: A },
+      ),
+    ).toBe("hi");
+    expect(calls[0]).toEqual([
+      "voice.transcribe",
+      { session_id: "session-a", audio_b64: btoa("hi"), mime: "audio/webm" },
+    ]);
+    const clip = await port.speak("hello", { signal });
+    expect(new TextDecoder().decode(clip.bytes)).toBe("RIFF");
+    const failing = rpcVoicePort(async () => ({}));
+    await expect(failing.speak("x", { signal })).rejects.toThrow();
+    expect(vi.isMockFunction(port.speak)).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/chat/voice/conversation.ts b/apps/desktop/src/chat/voice/conversation.ts
new file mode 100644
index 0000000..4cc86da
--- /dev/null
+++ b/apps/desktop/src/chat/voice/conversation.ts
@@ -0,0 +1,268 @@
+// Read-aloud and spoken conversation (P24-35).
+//
+// `ReadAloud` speaks one reply at a time through one player: starting another stops the first; the
+// text is turned into audio by the daemon's text-to-speech (`VoicePort.speak`).
+//
+// `Conversation` is a loop over the microphone's level frames (RMS, 0..1):
+//
+//   listening ──speech──▶ capturing ──silence ≥ VAD.silenceMs──▶ thinking ──reply──▶ speaking
+//       ▲                    │ (or VAD.maxTurnMs)                 transcribe,          │
+//       └────────────────────┴──────────── nothing heard ◀─────── submit, speak ◀──────┘
+//
+// Barge-in: a speech frame while the reply is being fetched or played stops the playback (and
+// abandons the audio request) at once and starts capturing the new turn. The recipient is pinned
+// when the conversation starts, like dictation's (R08.19): every turn goes to that session.
+// `stop()` ends capture and playback.
+
+import {
+  type AudioClip,
+  abortable,
+  type Recipient,
+  type Recorder,
+  type RecorderFactory,
+  type VoicePort,
+} from "./dictation.ts";
+
+export const VAD = Object.freeze({
+  /** A frame at or above this level counts as speech. */
+  speechRms: 0.02,
+  /** This much quiet after speech ends the turn. */
+  silenceMs: 900,
+  /** A turn never runs longer than this. */
+  maxTurnMs: 60_000,
+});
+
+export interface Player {
+  /** Resolves when playback ends (also after `stop`). */
+  play(clip: AudioClip): Promise<void>;
+  stop(): void;
+}
+
+/** The microphone's level, one call per frame (`atMs` from a monotonic clock). */
+export interface LevelSource {
+  start(onFrame: (rms: number, atMs: number) => void): Promise<void>;
+  stop(): void;
+}
+
+/** Strip markdown so the reply reads naturally. */
+export function speakable(markdown: string): string {
+  return markdown
+    .replace(/```[\s\S]*?```/g, " ")
+    .replace(/`([^`]*)`/g, "$1")
+    .replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
+    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
+    .replace(/^#{1,6}\s+/gm, "")
+    .replace(/[*_~>]+/g, "")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export class ReadAloud {
+  private current: AbortController | null = null;
+  private readonly port: VoicePort;
+  private readonly player: Player;
+
+  constructor(port: VoicePort, player: Player) {
+    this.port = port;
+    this.player = player;
+  }
+
+  get speaking(): boolean {
+    return this.current !== null;
+  }
+
+  async speak(text: string): Promise<void> {
+    this.stop();
+    const words = speakable(text);
+    if (words === "") return;
+    const controller = new AbortController();
+    this.current = controller;
+    try {
+      const clip = await abortable(
+        this.port.speak(words, { signal: controller.signal }),
+        controller.signal,
+      );
+      if (controller.signal.aborted) return;
+      await this.player.play(clip);
+    } catch {
+      // aborted or the voice failed: nothing to play
+    } finally {
+      if (this.current === controller) this.current = null;
+    }
+  }
+
+  stop(): void {
+    if (this.current === null) return;
+    this.current.abort();
+    this.current = null;
+    this.player.stop();
+  }
+}
+
+export type ConversationPhase = "off" | "listening" | "capturing" | "thinking" | "speaking";
+
+export interface ConversationOptions {
+  port: VoicePort;
+  levels: LevelSource;
+  recorder: RecorderFactory;
+  player: Player;
+  /** Send the words to `recipient` and resolve the reply's text ("" for none). */
+  submit(recipient: Recipient, text: string): Promise<string>;
+  vad?: Partial<typeof VAD>;
+}
+
+export class Conversation {
+  private phaseNow: ConversationPhase = "off";
+  private recipient: Recipient | null = null;
+  private recorder: Recorder | null = null;
+  private lastSpeechAt = 0;
+  private turnStartedAt = 0;
+  private turn = 0;
+  private reply: ReadAloud;
+  private readonly listeners = new Set<() => void>();
+  private readonly vad: typeof VAD;
+  private readonly options: ConversationOptions;
+
+  constructor(options: ConversationOptions) {
+    this.options = options;
+    this.vad = { ...VAD, ...options.vad };
+    this.reply = new ReadAloud(options.port, options.player);
+  }
+
+  get phase(): ConversationPhase {
+    return this.phaseNow;
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  /** Start the loop for `recipient` (asks for the microphone now, the first time). */
+  async start(recipient: Recipient): Promise<void> {
+    if (this.phaseNow !== "off") return;
+    this.recipient = recipient;
+    this.set("listening");
+    try {
+      await this.options.levels.start((rms, at) => this.frame(rms, at));
+    } catch {
+      this.stop();
+      throw new Error("microphone not allowed");
+    }
+  }
+
+  stop(): void {
+    this.turn += 1;
+    this.options.levels.stop();
+    this.recorder?.cancel();
+    this.recorder = null;
+    this.reply.stop();
+    this.recipient = null;
+    this.set("off");
+  }
+
+  /** One level frame from the microphone. */
+  frame(rms: number, at: number): void {
+    const speech = rms >= this.vad.speechRms;
+    switch (this.phaseNow) {
+      case "off":
+        return;
+      case "listening":
+        if (speech) void this.beginTurn(at);
+        return;
+      case "thinking":
+      case "speaking":
+        if (speech) {
+          // barge-in: the person talks over the reply
+          this.reply.stop();
+          this.turn += 1;
+          void this.beginTurn(at);
+        }
+        return;
+      case "capturing":
+        if (speech) this.lastSpeechAt = at;
+        if (
+          at - this.lastSpeechAt >= this.vad.silenceMs ||
+          at - this.turnStartedAt >= this.vad.maxTurnMs
+        ) {
+          void this.endTurn();
+        }
+        return;
+    }
+  }
+
+  private async beginTurn(at: number): Promise<void> {
+    this.set("capturing");
+    this.lastSpeechAt = at;
+    this.turnStartedAt = at;
+    const mine = ++this.turn;
+    try {
+      const recorder = await this.options.recorder();
+      await recorder.start();
+      if (mine !== this.turn || this.phaseNow === "off") {
+        recorder.cancel();
+        return;
+      }
+      this.recorder = recorder;
+    } catch {
+      if (mine === this.turn) this.set("listening");
+    }
+  }
+
+  private async endTurn(): Promise<void> {
+    const recorder = this.recorder;
+    const recipient = this.recipient;
+    this.recorder = null;
+    if (recorder === null || recipient === null) {
+      this.set("listening");
+      return;
+    }
+    this.set("thinking");
+    const mine = this.turn;
+    const clip = await recorder.stop().catch(() => null);
+    if (mine !== this.turn) return;
+    if (clip === null || clip.bytes.byteLength === 0) {
+      this.set("listening");
+      return;
+    }
+    const controller = new AbortController();
+    let text = "";
+    try {
+      text = (
+        await this.options.port.transcribe(clip, { signal: controller.signal, recipient })
+      ).trim();
+    } catch {
+      text = "";
+    }
+    if (mine !== this.turn) return;
+    if (text === "") {
+      this.set("listening");
+      return;
+    }
+    let answer = "";
+    try {
+      answer = await this.options.submit(recipient, text);
+    } catch {
+      answer = "";
+    }
+    if (mine !== this.turn) return;
+    if (answer.trim() !== "") {
+      this.set("speaking");
+      await this.reply.speak(answer);
+    }
+    if (mine === this.turn && this.phaseNow !== "off") this.set("listening");
+  }
+
+  private set(phase: ConversationPhase): void {
+    this.phaseNow = phase;
+    for (const listener of [...this.listeners]) {
+      try {
+        listener();
+      } catch {
+        // ignore
+      }
+    }
+  }
+}
diff --git a/apps/desktop/src/chat/voice/dictation.test.ts b/apps/desktop/src/chat/voice/dictation.test.ts
new file mode 100644
index 0000000..03be9d3
--- /dev/null
+++ b/apps/desktop/src/chat/voice/dictation.test.ts
@@ -0,0 +1,170 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { FakeVoice } from "../../test/_stubs_u3.ts";
+import {
+  type AudioClip,
+  Dictation,
+  type Recipient,
+  type Recorder,
+  STT_TIMEOUT_MS,
+} from "./dictation.ts";
+
+const A: Recipient = { sessionId: "session-a", profile: "default" };
+const B: Recipient = { sessionId: "session-b", profile: "default" };
+const CLIP: AudioClip = { bytes: new Uint8Array([1, 2, 3]), mime: "audio/webm" };
+
+function fakeRecorder(
+  clip: AudioClip | null = CLIP,
+): Recorder & { started: number; cancelled: number } {
+  return {
+    started: 0,
+    cancelled: 0,
+    async start() {
+      this.started += 1;
+    },
+    async stop() {
+      return clip;
+    },
+    cancel() {
+      this.cancelled += 1;
+    },
+  };
+}
+
+function rig(options: { voice?: FakeVoice; deny?: boolean } = {}) {
+  const voice = options.voice ?? new FakeVoice();
+  const drafts: Array<[string | null, string]> = [];
+  const factory = vi.fn(async () => {
+    if (options.deny) throw new DOMException("denied", "NotAllowedError");
+    return fakeRecorder();
+  });
+  const dictation = new Dictation({
+    port: voice,
+    recorder: factory,
+    sink: (recipient, text) => drafts.push([recipient.sessionId, text]),
+  });
+  return { dictation, drafts, factory, voice };
+}
+
+async function settle(): Promise<void> {
+  for (let i = 0; i < 10; i += 1) await Promise.resolve();
+}
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("dictation", () => {
+  it("asks for the microphone only on first use", async () => {
+    const { dictation, factory } = rig();
+    expect(factory).not.toHaveBeenCalled();
+    expect(dictation.snapshot().state).toBe("idle");
+    await dictation.start(A);
+    expect(factory).toHaveBeenCalledOnce();
+    expect(dictation.snapshot()).toMatchObject({ state: "recording", recipient: A });
+  });
+
+  it("a session switch during capture still delivers the text to the original session", async () => {
+    const voice = new FakeVoice();
+    const gate = voice.holdTranscripts();
+    const { dictation, drafts } = rig({ voice });
+    await dictation.start(A);
+    // the person switches to session B while recording and while it transcribes: the composer's
+    // current session changes, the capture's pinned recipient does not
+    const stopping = dictation.stop();
+    await settle();
+    expect(dictation.snapshot()).toMatchObject({ state: "transcribing", recipient: A });
+    gate.release("hello from A");
+    await stopping;
+    expect(drafts).toEqual([["session-a", "hello from A"]]);
+    expect(voice.transcribed[0]?.recipient).toEqual(A);
+  });
+
+  it("transcription times out at 60 s and inserts nothing", async () => {
+    vi.useFakeTimers();
+    const voice = new FakeVoice();
+    voice.holdTranscripts(); // never answers
+    const { dictation, drafts } = rig({ voice });
+    await dictation.start(A);
+    const stopping = dictation.stop();
+    await vi.advanceTimersByTimeAsync(STT_TIMEOUT_MS - 1);
+    expect(dictation.snapshot().state).toBe("transcribing");
+    await vi.advanceTimersByTimeAsync(1);
+    await stopping;
+    expect(dictation.snapshot()).toMatchObject({ state: "idle", error: "timeout" });
+    expect(drafts).toEqual([]);
+    expect(voice.aborted).toBe(1);
+  });
+
+  it("the configured deadline replaces the default", async () => {
+    vi.useFakeTimers();
+    const voice = new FakeVoice();
+    voice.holdTranscripts();
+    const drafts: string[] = [];
+    const dictation = new Dictation({
+      port: voice,
+      recorder: async () => fakeRecorder(),
+      sink: (_r, text) => drafts.push(text),
+      timeoutMs: () => 5_000,
+    });
+    await dictation.start(A);
+    const stopping = dictation.stop();
+    await vi.advanceTimersByTimeAsync(5_000);
+    await stopping;
+    expect(dictation.snapshot().error).toBe("timeout");
+  });
+
+  it("a newer capture makes an older pending result stale", async () => {
+    const voice = new FakeVoice();
+    const first = voice.holdTranscripts();
+    const { dictation, drafts } = rig({ voice });
+    await dictation.start(A);
+    const stopping = dictation.stop();
+    await settle();
+    await dictation.start(B); // a new capture while A still transcribes
+    first.release("late words for A");
+    await stopping;
+    expect(drafts).toEqual([]);
+    expect(dictation.snapshot()).toMatchObject({ state: "recording", recipient: B });
+  });
+
+  it("a denied microphone records nothing", async () => {
+    const { dictation, drafts } = rig({ deny: true });
+    await dictation.start(A);
+    expect(dictation.snapshot()).toMatchObject({ state: "idle", error: "mic-denied" });
+    await dictation.stop();
+    expect(drafts).toEqual([]);
+  });
+
+  it("empty audio or an empty transcript inserts nothing", async () => {
+    const empty = new Dictation({
+      port: new FakeVoice(),
+      recorder: async () => fakeRecorder({ bytes: new Uint8Array(), mime: "audio/webm" }),
+      sink: () => {
+        throw new Error("nothing should arrive");
+      },
+    });
+    await empty.start(A);
+    await empty.stop();
+    expect(empty.snapshot().error).toBe("nothing-heard");
+    const voice = new FakeVoice();
+    voice.nextTranscript = "   ";
+    const { dictation, drafts } = rig({ voice });
+    await dictation.start(A);
+    await dictation.stop();
+    expect(drafts).toEqual([]);
+    expect(dictation.snapshot().error).toBe("nothing-heard");
+  });
+
+  it("cancel drops the capture", async () => {
+    const recorder = fakeRecorder();
+    const dictation = new Dictation({
+      port: new FakeVoice(),
+      recorder: async () => recorder,
+      sink: () => undefined,
+    });
+    await dictation.start(A);
+    dictation.cancel();
+    expect(recorder.cancelled).toBe(1);
+    expect(dictation.snapshot().state).toBe("idle");
+  });
+});
