+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { CONSOLE_PATH, ConsoleModal, type ConsoleSocket, connectConsole } from "./ConsoleModal.tsx";
+
+class FakeSocket implements ConsoleSocket {
+  sent: Record<string, unknown>[] = [];
+  closed: number | null = null;
+  onmessage: ((event: { data: unknown }) => void) | null = null;
+  onclose: ((event: { code: number; reason?: string }) => void) | null = null;
+  onerror: ((event: unknown) => void) | null = null;
+
+  send(data: string): void {
+    this.sent.push(JSON.parse(data) as Record<string, unknown>);
+  }
+
+  close(code?: number): void {
+    this.closed = code ?? 1000;
+  }
+
+  push(frame: Record<string, unknown>): void {
+    act(() => this.onmessage?.({ data: JSON.stringify(frame) }));
+  }
+}
+
+async function openWith(socket: FakeSocket, onClose = vi.fn()) {
+  const connect = vi.fn(async () => socket);
+  render(<ConsoleModal open onClose={onClose} connect={connect} />);
+  await act(async () => {});
+  socket.push({ type: "ready", profile: "work", prompt: "indus> " });
+  return { connect, onClose };
+}
+
+function type(line: string) {
+  fireEvent.change(screen.getByLabelText("Console command"), { target: { value: line } });
+  fireEvent.submit(screen.getByLabelText("Console command").closest("form") as HTMLFormElement);
+}
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("ConsoleModal", () => {
+  it("sends one input frame and shows the output", async () => {
+    const socket = new FakeSocket();
+    await openWith(socket);
+    expect(screen.getByText(/for work/)).toBeTruthy();
+    type("status");
+    expect(socket.sent).toEqual([{ type: "input", line: "status" }]);
+    // a second line cannot be sent while the first runs: the input is disabled
+    expect((screen.getByLabelText("Console command") as HTMLInputElement).disabled).toBe(true);
+    socket.push({ type: "output", id: 1, stream: "stdout", data: "all good", command: "status" });
+    socket.push({ type: "complete", id: 1, status: "ok", command: "status", prompt: "indus> " });
+    expect(screen.getByRole("log").textContent).toContain("indus> status");
+    expect(screen.getByRole("log").textContent).toContain("all good");
+    expect((screen.getByLabelText("Console command") as HTMLInputElement).disabled).toBe(false);
+  });
+
+  it("asks before a command that changes something and confirms the exact command", async () => {
+    const socket = new FakeSocket();
+    await openWith(socket);
+    type("config set agent.max_turns 3");
+    socket.push({
+      type: "confirm_required",
+      id: 1,
+      command: "config set agent.max_turns 3",
+      message: "Change this setting?",
+    });
+    socket.push({ type: "complete", id: 1, status: "confirm_required" });
+    expect(screen.getByRole("alertdialog").textContent).toContain("Change this setting?");
+    fireEvent.click(screen.getByText("Run it"));
+    expect(socket.sent.at(-1)).toEqual({
+      type: "confirm",
+      command: "config set agent.max_turns 3",
+    });
+    socket.push({ type: "complete", id: 1, status: "ok" });
+    expect(screen.queryByRole("alertdialog")).toBeNull();
+  });
+
+  it("cancel drops a pending confirmation", async () => {
+    const socket = new FakeSocket();
+    await openWith(socket);
+    type("cron pause nightly");
+    socket.push({ type: "confirm_required", id: 1, command: "cron pause nightly", message: "?" });
+    fireEvent.click(screen.getByText("Cancel"));
+    expect(socket.sent.at(-1)).toEqual({ type: "cancel" });
+    socket.push({ type: "complete", id: 1, status: "cancelled" });
+    expect(screen.queryByRole("alertdialog")).toBeNull();
+    expect(screen.getByRole("log").textContent).toContain("Cancelled.");
+  });
+
+  it("stop sends cancel while a command runs; clear empties the log; exit closes", async () => {
+    const socket = new FakeSocket();
+    const { onClose } = await openWith(socket);
+    type("sessions list");
+    fireEvent.click(screen.getByText("Stop"));
+    expect(socket.sent.at(-1)).toEqual({ type: "cancel" });
+    socket.push({ type: "error", id: 1, message: "The command was cancelled." });
+    socket.push({ type: "complete", id: 1, status: "cancelled" });
+    expect(screen.getByRole("log").textContent).toContain("The command was cancelled.");
+    socket.push({ type: "clear" });
+    expect(screen.getByRole("log").textContent).toBe("");
+    socket.push({ type: "complete", id: 2, status: "exit" });
+    expect(onClose).toHaveBeenCalled();
+  });
+
+  it("explains a refused socket", async () => {
+    const socket = new FakeSocket();
+    const connect = vi.fn(async () => socket);
+    render(<ConsoleModal open onClose={vi.fn()} connect={connect} />);
+    await act(async () => {});
+    act(() => socket.onclose?.({ code: 4404 }));
+    expect(screen.getByRole("log").textContent).toContain("not enabled");
+  });
+
+  it("the real dial puts the credential in the subprotocols, never the URL", async () => {
+    const made: { url: string; protocols: string[] }[] = [];
+    class RecordingSocket {
+      constructor(url: string, protocols: string[]) {
+        made.push({ url, protocols });
+      }
+    }
+    vi.stubGlobal("WebSocket", RecordingSocket);
+    const token = ["tok", "en", "-value-for-the-test"].join("");
+    window.__INDUS_SESSION_TOKEN__ = token;
+    await connectConsole("work");
+    expect(made).toHaveLength(1);
+    const first = made[0];
+    expect(first?.url).toContain(CONSOLE_PATH);
+    expect(first?.url).toContain("profile=work");
+    expect(first?.url).not.toContain(token);
+    expect(first?.protocols).toEqual(["indus-dashboard-v1", `indus-dashboard-token.${token}`]);
+  });
+});
diff --git a/apps/web/src/console/ConsoleModal.tsx b/apps/web/src/console/ConsoleModal.tsx
new file mode 100644
index 0000000..ddd68c2
--- /dev/null
+++ b/apps/web/src/console/ConsoleModal.tsx
@@ -0,0 +1,269 @@
+// The admin console modal (P24-36): one line of input, a log of what came back, and the confirm
+// step for commands that change something. It talks to `/api/console` (purpose `web-console`)
+// through the shared socket helper, so the credential rides the subprotocol list and never the
+// URL. Frames are JSON both ways; the server decides everything (which commands exist, what needs
+// confirmation, the limits), the modal only shows it.
+
+import { type FormEvent, useCallback, useEffect, useRef, useState } from "react";
+import { activeProfile } from "../lib/api.ts";
+import { openDashboardSocket } from "../lib/wsUrl.ts";
+import { Button } from "../ui/controls.tsx";
+import { Modal } from "../ui/Dialog.tsx";
+
+export const CONSOLE_PATH = "/api/console";
+export const CONSOLE_PURPOSE = "web-console";
+
+/** The part of a WebSocket the modal uses (a fake in tests). */
+export interface ConsoleSocket {
+  send(data: string): void;
+  close(code?: number): void;
+  onmessage: ((event: { data: unknown }) => void) | null;
+  onclose: ((event: { code: number; reason?: string }) => void) | null;
+  onerror: ((event: unknown) => void) | null;
+}
+
+export type ConnectConsole = (profile: string) => Promise<ConsoleSocket>;
+
+/** The real dial: the shared helper adds the credential as a subprotocol. */
+export const connectConsole: ConnectConsole = async (profile) =>
+  (await openDashboardSocket(CONSOLE_PATH, CONSOLE_PURPOSE, {
+    profile: profile || undefined,
+  })) as unknown as ConsoleSocket;
+
+interface LogLine {
+  key: number;
+  kind: "input" | "stdout" | "stderr" | "error" | "note";
+  text: string;
+}
+
+interface Pending {
+  command: string;
+  message: string;
+}
+
+type Phase = "connecting" | "ready" | "running" | "closed";
+
+const CLOSE_TEXT: Readonly<Record<number, string>> = {
+  1000: "The console closed.",
+  4401: "The console needs you to be signed in.",
+  4403: "The console refused this page's origin.",
+  4404: "The admin console is not enabled on this dashboard.",
+  4408: "The console only answers this machine.",
+  4400: "There is no such profile.",
+  1011: "The console could not start.",
+};
+
+function textOf(value: unknown): string {
+  return typeof value === "string" ? value : "";
+}
+
+export function ConsoleModal({
+  open,
+  onClose,
+  connect = connectConsole,
+}: {
+  open: boolean;
+  onClose: () => void;
+  connect?: ConnectConsole;
+}) {
+  const [lines, setLines] = useState<LogLine[]>([]);
+  const [phase, setPhase] = useState<Phase>("connecting");
+  const [prompt, setPrompt] = useState("indus> ");
+  const [profile, setProfile] = useState("");
+  const [pending, setPending] = useState<Pending | null>(null);
+  const [draft, setDraft] = useState("");
+  const socket = useRef<ConsoleSocket | null>(null);
+  const counter = useRef(0);
+
+  const add = useCallback((kind: LogLine["kind"], text: string) => {
+    if (!text) return;
+    counter.current += 1;
+    const key = counter.current;
+    setLines((was) => [...was, { key, kind, text }]);
+  }, []);
+
+  const handle = useCallback(
+    (frame: Record<string, unknown>) => {
+      switch (frame.type) {
+        case "ready":
+          setPhase("ready");
+          setProfile(textOf(frame.profile));
+          if (typeof frame.prompt === "string") setPrompt(frame.prompt);
+          return;
+        case "output":
+          add(frame.stream === "stderr" ? "stderr" : "stdout", textOf(frame.data));
+          return;
+        case "error":
+          add("error", textOf(frame.message));
+          return;
+        case "confirm_required":
+          setPending({ command: textOf(frame.command), message: textOf(frame.message) });
+          return;
+        case "clear":
+          setLines([]);
+          return;
+        case "complete":
+          if (typeof frame.prompt === "string") setPrompt(frame.prompt);
+          if (frame.status === "exit") {
+            setPhase("closed");
+            onClose();
+            return;
+          }
+          if (frame.status === "cancelled") {
+            setPending(null);
+            add("note", "Cancelled.");
+          }
+          if (frame.status !== "confirm_required") setPending(null);
+          setPhase("ready");
+          return;
+        default:
+          return;
+      }
+    },
+    [add, onClose],
+  );
+
+  useEffect(() => {
+    if (!open) return;
+    let live = true;
+    setLines([]);
+    setPending(null);
+    setPhase("connecting");
+    connect(activeProfile())
+      .then((ws) => {
+        if (!live) {
+          ws.close(1000);
+          return;
+        }
+        socket.current = ws;
+        ws.onmessage = (event) => {
+          try {
+            const frame: unknown = JSON.parse(textOf(event.data));
+            if (frame && typeof frame === "object") handle(frame as Record<string, unknown>);
+          } catch {
+            // the server only sends JSON; anything else is ignored
+          }
+        };
+        ws.onclose = (event) => {
+          if (!live) return;
+          socket.current = null;
+          setPhase("closed");
+          add("note", CLOSE_TEXT[event.code] ?? `The console closed (${event.code}).`);
+        };
+        ws.onerror = () => undefined;
+      })
+      .catch((error: unknown) => {
+        if (!live) return;
+        setPhase("closed");
+        add("error", error instanceof Error ? error.message : "The console could not connect.");
+      });
+    return () => {
+      live = false;
+      socket.current?.close(1000);
+      socket.current = null;
+    };
+  }, [open, connect, handle, add]);
+
+  const send = (frame: Record<string, unknown>) => socket.current?.send(JSON.stringify(frame));
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    const line = draft.trim();
+    if (!line || phase !== "ready" || pending !== null) return;
+    add("input", `${prompt}${line}`);
+    setDraft("");
+    setPhase("running");
+    send({ type: "input", line });
+  };
+
+  return (
+    <Modal
+      open={open}
+      onOpenChange={(next) => {
+        if (!next) onClose();
+      }}
+      title="Admin console"
+      description={
+        profile
+          ? `Curated indus commands for ${profile}, one per line. Type help for the list.`
+          : "Curated indus commands, one per line. Type help for the list."
+      }
+    >
+      <div
+        role="log"
+        aria-live="polite"
+        aria-label="Console output"
+        className="mb-3 h-64 overflow-auto rounded-md border border-line bg-code p-2 font-mono text-xs whitespace-pre-wrap"
+      >
+        {lines.map((line) => (
+          <div
+            key={line.key}
+            data-kind={line.kind}
+            className={
+              line.kind === "error" || line.kind === "stderr"
+                ? "text-danger"
+                : line.kind === "note"
+                  ? "text-muted"
+                  : ""
+            }
+          >
+            {line.text}
+          </div>
+        ))}
+      </div>
+      {pending !== null ? (
+        <div role="alertdialog" aria-label="Confirm command" className="mb-3 text-sm">
+          <p className="mb-2">
+            {pending.message} <code>{pending.command}</code>
+          </p>
+          <span className="inline-flex gap-2">
+            <Button
+              tone="primary"
+              onClick={() => send({ type: "confirm", command: pending.command })}
+            >
+              Run it
+            </Button>
+            <Button onClick={() => send({ type: "cancel" })}>Cancel</Button>
+          </span>
+        </div>
+      ) : null}
+      <form onSubmit={submit} className="flex items-center gap-2">
+        <label className="flex flex-1 items-center gap-1 font-mono text-sm">
+          <span aria-hidden="true">{prompt}</span>
+          <input
+            aria-label="Console command"
+            className="flex-1 rounded-md border border-line bg-bg px-2 py-1"
+            value={draft}
+            disabled={phase !== "ready" || pending !== null}
+            onChange={(event) => setDraft(event.target.value)}
+            autoComplete="off"
+            spellCheck={false}
+          />
+        </label>
+        {phase === "running" ? (
+          <Button tone="danger" onClick={() => send({ type: "cancel" })}>
+            Stop
+          </Button>
+        ) : (
+          <Button type="submit" disabled={phase !== "ready" || pending !== null}>
+            Run
+          </Button>
+        )}
+      </form>
+    </Modal>
+  );
+}
+
+/** The shell's entry: a button that opens the modal (only when the backend serves the console). */
+export function ConsoleEntry({ enabled }: { enabled: boolean }) {
+  const [open, setOpen] = useState(false);
+  if (!enabled) return null;
+  return (
+    <>
+      <Button tone="ghost" className="w-full justify-start" onClick={() => setOpen(true)}>
+        Admin console
+      </Button>
+      {open ? <ConsoleModal open onClose={() => setOpen(false)} /> : null}
+    </>
+  );
+}
