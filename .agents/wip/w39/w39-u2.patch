diff --git a/apps/desktop/electron/connections/install.test.ts b/apps/desktop/electron/connections/install.test.ts
new file mode 100644
index 0000000..29c91d3
--- /dev/null
+++ b/apps/desktop/electron/connections/install.test.ts
@@ -0,0 +1,108 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { closeFakeServes, fakeServe, SERVE_TOKEN } from "../../testing/fakeServe.ts";
+import { ConnectionsService } from "./install.ts";
+import { REGISTRY_FILE, secretName } from "./registry.ts";
+
+const dirs: string[] = [];
+afterAll(() => {
+  closeFakeServes();
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function service() {
+  const userData = fs.mkdtempSync(path.join(os.tmpdir(), "indus-conns-"));
+  dirs.push(userData);
+  const values = new Map<string, string>();
+  const secrets = {
+    get: (name: string) => values.get(name) ?? null,
+    put: (name: string, value: string) => void values.set(name, value),
+    delete: (name: string) => void values.delete(name),
+  };
+  const lines: string[] = [];
+  const conns = new ConnectionsService({
+    userData,
+    secrets,
+    log: (line) => lines.push(line),
+    test: { settleMs: 30, timeoutMs: 2000 },
+  });
+  return { conns, values, userData, lines };
+}
+
+describe("ConnectionsService", () => {
+  it("saves only after both legs pass; a failed test writes no secret", async () => {
+    const { conns, values } = service();
+    const serve = await fakeServe();
+    const refused = await conns.save({ kind: "remote", url: serve.url, token: "wrong" });
+    expect(refused).toMatchObject({ saved: false, test: { http: "unauthorized" } });
+    expect(values.size).toBe(0);
+    expect(conns.view().connections).toHaveLength(1);
+    const ok = await conns.save({
+      kind: "remote",
+      url: serve.url,
+      token: SERVE_TOKEN,
+      label: "Lab",
+    });
+    expect(ok).toMatchObject({ saved: true, test: { ok: true } });
+    expect(values.get(secretName(ok.id as string, "token"))).toBe(SERVE_TOKEN);
+  });
+
+  it("the view and the file carry names and flags, never a credential", async () => {
+    const { conns, userData } = service();
+    const serve = await fakeServe();
+    const ok = await conns.save({
+      kind: "remote",
+      url: serve.url,
+      token: SERVE_TOKEN,
+      headers: { "CF-Access-Client-Secret": "cf-value-9" },
+    });
+    const view = conns.view();
+    const entry = view.connections.find((c) => c.id === ok.id);
+    expect(entry).toMatchObject({ hasCredential: true, headerNames: ["CF-Access-Client-Secret"] });
+    const all = JSON.stringify(view) + fs.readFileSync(path.join(userData, REGISTRY_FILE), "utf8");
+    expect(all).not.toContain(SERVE_TOKEN);
+    expect(all).not.toContain("cf-value-9");
+  });
+
+  it("a blank token on an edit keeps the stored one; the launch dial comes from the primary", async () => {
+    const { conns, values } = service();
+    const serve = await fakeServe();
+    const ok = await conns.save({ kind: "remote", url: serve.url, token: SERVE_TOKEN });
+    const again = await conns.save({
+      id: ok.id as string,
+      kind: "remote",
+      url: serve.url,
+      token: "",
+      label: "Renamed",
+    });
+    expect(again.saved).toBe(true);
+    expect(values.get(secretName(ok.id as string, "token"))).toBe(SERVE_TOKEN);
+    expect(conns.launchRemote()).toBeNull(); // "This computer" is still the primary
+    conns.setPrimary(ok.id as string);
+    const dial = conns.launchRemote();
+    expect(dial).toMatchObject({ url: serve.url, connectionId: ok.id });
+    expect(dial?.auth).toBeDefined();
+  });
+
+  it("the first-run chooser's remote becomes the primary entry; forget removes it", () => {
+    const { conns, values } = service();
+    const id = conns.adoptRemote("http://r.example:9119", SERVE_TOKEN);
+    expect(conns.primaryRemote()).toEqual({ url: "http://r.example:9119", hasToken: true });
+    expect(conns.view().primaryId).toBe(id);
+    conns.forgetPrimaryRemote();
+    expect(conns.primaryRemote()).toEqual({ url: null, hasToken: false });
+    expect(values.size).toBe(0);
+  });
+
+  it("an OAuth entry is saved before its sign-in and is not dialled until signed in", async () => {
+    const { conns } = service();
+    const ok = await conns.save({ kind: "remote", url: "https://gw.example", authMode: "oauth" });
+    expect(ok).toMatchObject({ saved: true, test: null });
+    conns.setPrimary(ok.id as string);
+    expect(conns.view().connections.find((c) => c.id === ok.id)?.signedIn).toBe(false);
+    const dial = conns.launchRemote();
+    await expect(dial?.auth?.authHeaders()).rejects.toMatchObject({ kind: "unauthorized" });
+  });
+});
diff --git a/apps/desktop/electron/connections/install.ts b/apps/desktop/electron/connections/install.ts
new file mode 100644
index 0000000..a5ff41c
--- /dev/null
+++ b/apps/desktop/electron/connections/install.ts
@@ -0,0 +1,493 @@
+// The connections registry in main (P24-29): the service the boot orchestrator and the
+// `connections.*` channels use. Secrets (tokens, a basic user name and password, OAuth sets,
+// access-proxy headers) stay here and in the secrets store; the windows see names and flags only.
+//
+// Saving a token or basic entry tests both legs first (R08.5) and saves only when both pass; an
+// OAuth entry is saved first and becomes usable after `signIn`. The launch entry decides what
+// `RemoteStore.saved()` hands the orchestrator: null for "This computer", a remote dial for a
+// remote entry, and for an SSH entry a dial whose base URL is prepared over SSH (P24-30).
+
+import { randomBytes } from "node:crypto";
+import type { SavedRemote } from "../backend/remote.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import type { IpcRegistry } from "../ipc/registry.ts";
+import { OAuthError, OAuthSession, signIn } from "./nativeOauth.ts";
+import { decodeHeaders, encodeHeaders } from "./proxyHeaders.ts";
+import {
+  type AuthMode,
+  type ConnectionEntry,
+  type ConnectionRegistry,
+  type EntryInput,
+  type LaunchMode,
+  LOCAL_ID,
+  launchEntry,
+  RegistryError,
+  RegistryStore,
+  type SecretsLike,
+  type SshTarget,
+  secretName,
+  setLastUsed,
+  setLaunchMode,
+  setPrimary,
+  upsertEntry,
+} from "./registry.ts";
+import {
+  type ConnectionTestDeps,
+  type ConnectionTestResult,
+  RemoteAuth,
+  type RemoteCredentials,
+  testRemoteConnection,
+} from "./remoteDial.ts";
+
+export interface ConnectionView {
+  id: string;
+  kind: "local" | "remote" | "ssh";
+  label: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+  primary: boolean;
+  lastUsed: boolean;
+  hasCredential: boolean;
+  signedIn: boolean;
+  headerNames: string[];
+}
+
+export interface ConnectionsView {
+  connections: ConnectionView[];
+  primaryId: string;
+  launchMode: LaunchMode;
+  quarantined: number;
+}
+
+export interface ConnectionInput {
+  id?: string;
+  kind: "remote" | "ssh";
+  label?: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+  /** Token mode: a new token (blank keeps the stored one). */
+  token?: string;
+  /** Basic mode: user name and password (a blank password keeps the stored one). */
+  username?: string;
+  password?: string;
+  /** Access-proxy headers; `{}` clears them, absent keeps them. */
+  headers?: Record<string, string>;
+}
+
+export interface SaveResult {
+  saved: boolean;
+  id?: string;
+  test: ConnectionTestResult | null;
+  droppedHeaders: string[];
+  message?: string;
+}
+
+/** Prepares an SSH entry's base URL and serve token (P24-30's `SshBackends`). */
+export interface SshDialer {
+  prepare(entry: ConnectionEntry, token: string): Promise<{ url: string }>;
+}
+
+export interface ConnectionsDeps {
+  userData: string;
+  secrets: SecretsLike;
+  log: (line: string) => void;
+  fetch?: typeof fetch;
+  test?: ConnectionTestDeps;
+  ssh?: SshDialer;
+  /** A fresh session token for an SSH entry's remote serve. */
+  newToken?: () => string;
+}
+
+interface Stored {
+  token: string | null;
+  basic: { username: string; password: string } | null;
+  headers: Record<string, string>;
+}
+
+export class ConnectionsService {
+  readonly store: RegistryStore;
+  private readonly deps: ConnectionsDeps;
+
+  constructor(deps: ConnectionsDeps) {
+    this.deps = deps;
+    this.store = new RegistryStore({
+      userData: deps.userData,
+      secrets: deps.secrets,
+      log: deps.log,
+    });
+  }
+
+  private secret(id: string, kind: "token" | "oauth" | "headers"): string | null {
+    return this.deps.secrets.get(secretName(id, kind));
+  }
+
+  private stored(entry: ConnectionEntry): Stored {
+    const raw = this.secret(entry.id, "token");
+    let basic: Stored["basic"] = null;
+    let token: string | null = raw;
+    if (entry.authMode === "basic" && raw !== null) {
+      try {
+        const parsed = JSON.parse(raw) as { username?: unknown; password?: unknown };
+        basic = {
+          username: typeof parsed.username === "string" ? parsed.username : "",
+          password: typeof parsed.password === "string" ? parsed.password : "",
+        };
+      } catch {
+        basic = null;
+      }
+      token = null;
+    }
+    return { token, basic, headers: decodeHeaders(this.secret(entry.id, "headers")) };
+  }
+
+  private oauthFor(entry: ConnectionEntry): OAuthSession {
+    const name = secretName(entry.id, "oauth");
+    return new OAuthSession(
+      entry.url ?? "",
+      {
+        get: () => this.deps.secrets.get(name),
+        put: (value) => this.deps.secrets.put(name, value),
+        delete: () => this.deps.secrets.delete(name),
+      },
+      { ...(this.deps.fetch === undefined ? {} : { fetch: this.deps.fetch }) },
+    );
+  }
+
+  /** The credential view main uses for `entry` at `base` (a URL, or the SSH tunnel's address). */
+  authFor(entry: ConnectionEntry, base = entry.url ?? ""): RemoteAuth {
+    const stored = this.stored(entry);
+    const credentials: RemoteCredentials = {
+      mode: entry.kind === "ssh" ? "token" : (entry.authMode ?? "token"),
+      token: stored.token,
+      basic: stored.basic,
+      oauth: entry.authMode === "oauth" ? this.oauthFor(entry) : null,
+      headers: stored.headers,
+    };
+    return new RemoteAuth(
+      base,
+      credentials,
+      this.deps.fetch === undefined ? {} : { fetch: this.deps.fetch },
+    );
+  }
+
+  view(): ConnectionsView {
+    const registry = this.store.load();
+    return {
+      connections: registry.connections.map((entry) => this.describe(entry, registry)),
+      primaryId: registry.primaryId,
+      launchMode: registry.launchMode,
+      quarantined: registry.quarantined.length,
+    };
+  }
+
+  private describe(entry: ConnectionEntry, registry: ConnectionRegistry): ConnectionView {
+    const view: ConnectionView = {
+      id: entry.id,
+      kind: entry.kind,
+      label: entry.label,
+      primary: registry.primaryId === entry.id,
+      lastUsed: registry.lastUsedId === entry.id,
+      hasCredential: entry.kind === "local" || this.secret(entry.id, "token") !== null,
+      signedIn: entry.authMode === "oauth" && this.oauthFor(entry).signedIn(),
+      headerNames: Object.keys(decodeHeaders(this.secret(entry.id, "headers"))),
+    };
+    if (entry.url !== undefined) view.url = entry.url;
+    if (entry.authMode !== undefined) view.authMode = entry.authMode;
+    if (entry.ssh !== undefined) view.ssh = entry.ssh;
+    return view;
+  }
+
+  private draft(input: ConnectionInput): { registry: ConnectionRegistry; entry: ConnectionEntry } {
+    const entryInput: EntryInput = { kind: input.kind };
+    if (input.id !== undefined) entryInput.id = input.id;
+    if (input.label !== undefined) entryInput.label = input.label;
+    if (input.url !== undefined) entryInput.url = input.url;
+    if (input.authMode !== undefined) entryInput.authMode = input.authMode;
+    if (input.ssh !== undefined) entryInput.ssh = input.ssh;
+    try {
+      const { registry, entry } = upsertEntry(this.store.load(), entryInput);
+      return { registry, entry };
+    } catch (error) {
+      if (error instanceof RegistryError) throw new IpcError("bad-request", error.message);
+      throw error;
+    }
+  }
+
+  /** The secrets `input` would leave in place for `entry` (stored values kept where blank). */
+  private secretsFor(
+    entry: ConnectionEntry,
+    input: ConnectionInput,
+  ): Stored & { dropped: string[] } {
+    const now = this.stored(entry);
+    const token = input.token !== undefined && input.token !== "" ? input.token : now.token;
+    let basic = now.basic;
+    if (input.username !== undefined) {
+      basic = {
+        username: input.username,
+        password:
+          input.password !== undefined && input.password !== ""
+            ? input.password
+            : (basic?.password ?? ""),
+      };
+    }
+    let headers = now.headers;
+    let dropped: string[] = [];
+    if (input.headers !== undefined) {
+      const encoded = encodeHeaders(input.headers);
+      headers = decodeHeaders(encoded.stored);
+      dropped = encoded.dropped;
+    }
+    return { token, basic, headers, dropped };
+  }
+
+  async test(input: ConnectionInput): Promise<ConnectionTestResult> {
+    const { entry } = this.draft(input);
+    return this.testDraft(entry, this.secretsFor(entry, input));
+  }
+
+  private async testDraft(entry: ConnectionEntry, secrets: Stored): Promise<ConnectionTestResult> {
+    let base = entry.url ?? "";
+    if (entry.kind === "ssh") {
+      if (this.deps.ssh === undefined || secrets.token === null) {
+        return {
+          ok: false,
+          http: "error",
+          ws: "error",
+          nativeSignIn: false,
+          message: "SSH is not available",
+        };
+      }
+      try {
+        base = (await this.deps.ssh.prepare(entry, secrets.token)).url;
+      } catch (error) {
+        return {
+          ok: false,
+          http: "unreachable",
+          ws: "error",
+          nativeSignIn: false,
+          message: error instanceof Error ? error.message : "the SSH connection failed",
+        };
+      }
+    }
+    const auth = new RemoteAuth(
+      base,
+      {
+        mode: entry.kind === "ssh" ? "token" : (entry.authMode ?? "token"),
+        token: secrets.token,
+        basic: secrets.basic,
+        oauth: entry.authMode === "oauth" ? this.oauthFor(entry) : null,
+        headers: secrets.headers,
+      },
+      this.deps.fetch === undefined ? {} : { fetch: this.deps.fetch },
+    );
+    return testRemoteConnection(auth, this.deps.test ?? {});
+  }
+
+  async save(input: ConnectionInput): Promise<SaveResult> {
+    const { registry, entry } = this.draft(input);
+    const secrets = this.secretsFor(entry, input);
+    if (entry.kind === "ssh" && secrets.token === null) {
+      secrets.token = (this.deps.newToken ?? defaultToken)();
+    }
+    const needsTest = !(
+      entry.kind === "remote" &&
+      entry.authMode === "oauth" &&
+      !this.oauthFor(entry).signedIn()
+    );
+    const test = needsTest ? await this.testDraft(entry, secrets) : null;
+    if (test !== null && !test.ok) {
+      return {
+        saved: false,
+        test,
+        droppedHeaders: secrets.dropped,
+        message: test.message ?? "the test failed",
+      };
+    }
+    this.store.save(registry);
+    if (entry.authMode === "basic" && secrets.basic !== null) {
+      this.deps.secrets.put(secretName(entry.id, "token"), JSON.stringify(secrets.basic));
+    } else if (secrets.token !== null) {
+      this.deps.secrets.put(secretName(entry.id, "token"), secrets.token);
+    }
+    if (input.headers !== undefined) {
+      const stored =
+        Object.keys(secrets.headers).length === 0 ? "" : JSON.stringify(secrets.headers);
+      this.deps.secrets.put(secretName(entry.id, "headers"), stored);
+    }
+    this.deps.log(`[connections] saved "${entry.label}" (${entry.kind})`);
+    return { saved: true, id: entry.id, test, droppedHeaders: secrets.dropped };
+  }
+
+  remove(id: string): ConnectionsView {
+    try {
+      this.store.remove(id);
+    } catch (error) {
+      if (error instanceof RegistryError) throw new IpcError("bad-request", error.message);
+      throw error;
+    }
+    return this.view();
+  }
+
+  setPrimary(id: string): ConnectionsView {
+    this.change((registry) => setPrimary(registry, id));
+    return this.view();
+  }
+
+  setLaunchMode(mode: LaunchMode): ConnectionsView {
+    this.change((registry) => setLaunchMode(registry, mode));
+    return this.view();
+  }
+
+  /** The entry that opened (last-used launch mode reads it). */
+  markUsed(id: string): void {
+    try {
+      this.change((registry) => setLastUsed(registry, id));
+    } catch {
+      // a removed entry: nothing to remember
+    }
+  }
+
+  private change(fn: (registry: ConnectionRegistry) => ConnectionRegistry): void {
+    try {
+      this.store.update(fn);
+    } catch (error) {
+      if (error instanceof RegistryError) throw new IpcError("bad-request", error.message);
+      throw error;
+    }
+  }
+
+  private entry(id: string): ConnectionEntry {
+    const found = this.store.load().connections.find((c) => c.id === id);
+    if (found === undefined) throw new IpcError("bad-request", "no connection has that id");
+    return found;
+  }
+
+  async signIn(
+    id: string,
+    openBrowser: (url: string) => Promise<void> | void,
+  ): Promise<{ ok: boolean; message?: string }> {
+    const entry = this.entry(id);
+    if (entry.kind !== "remote" || entry.authMode !== "oauth" || entry.url === undefined) {
+      throw new IpcError("bad-request", "this connection does not sign in");
+    }
+    try {
+      const tokens = await signIn(entry.url, {
+        openBrowser,
+        ...(this.deps.fetch === undefined ? {} : { fetch: this.deps.fetch }),
+      });
+      this.oauthFor(entry).store(tokens);
+      return { ok: true };
+    } catch (error) {
+      const message = error instanceof OAuthError ? error.message : "the sign-in did not finish";
+      return { ok: false, message };
+    }
+  }
+
+  signOut(id: string): { ok: true } {
+    this.oauthFor(this.entry(id)).signOut();
+    return { ok: true };
+  }
+
+  /** The first-run chooser's view (P20-11): the primary remote's URL, if the primary is one. */
+  primaryRemote(): { url: string | null; hasToken: boolean } {
+    const registry = this.store.load();
+    const primary = registry.connections.find((c) => c.id === registry.primaryId);
+    if (primary?.kind !== "remote") return { url: null, hasToken: false };
+    return { url: primary.url ?? null, hasToken: this.secret(primary.id, "token") !== null };
+  }
+
+  /** The chooser saved a tested remote: it becomes (or updates) a token entry and the primary. */
+  adoptRemote(url: string, token: string): string {
+    const { registry, entry } = upsertEntry(this.store.load(), {
+      kind: "remote",
+      url,
+      authMode: "token",
+    });
+    this.store.save(setPrimary(registry, entry.id));
+    this.deps.secrets.put(secretName(entry.id, "token"), token);
+    return entry.id;
+  }
+
+  /** The chooser forgot its remote: the primary remote entry goes, "This computer" is primary. */
+  forgetPrimaryRemote(): void {
+    const registry = this.store.load();
+    const primary = registry.connections.find((c) => c.id === registry.primaryId);
+    if (primary?.kind === "remote") this.store.remove(primary.id);
+  }
+
+  /** What the boot orchestrator dials at launch: null for "This computer". */
+  launchRemote(): SavedRemote | null {
+    const registry = this.store.load();
+    const entry = launchEntry(registry);
+    if (entry.id === LOCAL_ID || entry.kind === "local") return null;
+    const stored = this.stored(entry);
+    if (entry.kind === "remote") {
+      if (entry.authMode !== "oauth" && stored.token === null && stored.basic === null) return null;
+      return {
+        url: entry.url as string,
+        token: stored.token ?? "",
+        connectionId: entry.id,
+        auth: this.authFor(entry),
+      };
+    }
+    const token = stored.token;
+    const ssh = this.deps.ssh;
+    if (token === null || ssh === undefined) return null;
+    return {
+      url: `ssh://${entry.ssh?.host ?? ""}`,
+      token,
+      connectionId: entry.id,
+      prepare: async () => {
+        const { url } = await ssh.prepare(entry, token);
+        return { url, auth: this.authFor(entry, url) };
+      },
+    };
+  }
+}
+
+function defaultToken(): string {
+  return randomBytes(32).toString("base64url");
+}
+
+/** The `connections.*` channels; `onChange` reconnects windows after the primary changed. */
+export function installConnectionsIpc(
+  registry: IpcRegistry,
+  service: ConnectionsService,
+  options: {
+    /** Reconnect the windows after the primary changed. */
+    onChange: () => void;
+    /** The audited system-browser opener (needs the person's click in that window). */
+    openExternal: (url: string, contentsId: number) => Promise<{ ok: boolean }>;
+  },
+): void {
+  const { onChange } = options;
+  registry.handle("indus:connections:list", () => service.view());
+  registry.handle("indus:connections:test", (input) => service.test(input as ConnectionInput));
+  registry.handle("indus:connections:save", async (input) => {
+    const result = await service.save(input as ConnectionInput);
+    if (result.saved && result.id !== undefined && service.view().primaryId === result.id)
+      onChange();
+    return result;
+  });
+  registry.handle("indus:connections:remove", ({ id }) => {
+    const before = service.view().primaryId;
+    const view = service.remove(id);
+    if (before !== view.primaryId) onChange();
+    return view;
+  });
+  registry.handle("indus:connections:set-primary", ({ id }) => {
+    const view = service.setPrimary(id);
+    onChange();
+    return view;
+  });
+  registry.handle("indus:connections:set-launch-mode", ({ mode }) => service.setLaunchMode(mode));
+  registry.handle("indus:connections:sign-in", ({ id }, { senderId }) =>
+    service.signIn(id, async (url) => {
+      const opened = await options.openExternal(url, senderId);
+      if (!opened.ok) throw new OAuthError("denied", "the system browser could not be opened");
+    }),
+  );
+  registry.handle("indus:connections:sign-out", ({ id }) => service.signOut(id));
+}
diff --git a/apps/desktop/electron/connections/nativeOauth.test.ts b/apps/desktop/electron/connections/nativeOauth.test.ts
new file mode 100644
index 0000000..af1b8fe
--- /dev/null
+++ b/apps/desktop/electron/connections/nativeOauth.test.ts
@@ -0,0 +1,195 @@
+import { createHash } from "node:crypto";
+import http from "node:http";
+import type net from "node:net";
+import { afterAll, describe, expect, it } from "vitest";
+import {
+  authorizeUrl,
+  CALLBACK_PATH,
+  decodeTokens,
+  listenForCallback,
+  needsRefresh,
+  OAuthError,
+  OAuthSession,
+  offersNativeSignIn,
+  parseCallback,
+  parseTokens,
+  pkcePair,
+  signIn,
+  type TokenVault,
+} from "./nativeOauth.ts";
+
+const servers: http.Server[] = [];
+afterAll(() => {
+  for (const server of servers) server.close();
+});
+
+const ACCESS = ["access", "value", "one"].join("-");
+const REFRESH = ["refresh", "value", "one"].join("-");
+
+function vault(initial: string | null = null): TokenVault & { value: string | null } {
+  const box = {
+    value: initial,
+    get: () => box.value,
+    put: (v: string) => {
+      box.value = v;
+    },
+    delete: () => {
+      box.value = null;
+    },
+  };
+  return box;
+}
+
+async function tokenServer(
+  answer: (path: string, body: Record<string, string>) => { status: number; body: unknown },
+): Promise<{ base: string; calls: Array<{ path: string; body: Record<string, string> }> }> {
+  const calls: Array<{ path: string; body: Record<string, string> }> = [];
+  const srv = http.createServer((request, response) => {
+    let text = "";
+    request.on("data", (chunk: Buffer) => {
+      text += chunk.toString();
+    });
+    request.on("end", () => {
+      const body = JSON.parse(text || "{}") as Record<string, string>;
+      calls.push({ path: request.url ?? "", body });
+      const out = answer(request.url ?? "", body);
+      response.writeHead(out.status, { "Content-Type": "application/json" });
+      response.end(JSON.stringify(out.body));
+    });
+  });
+  await new Promise<void>((resolve) => srv.listen(0, "127.0.0.1", resolve));
+  servers.push(srv);
+  return { base: `http://127.0.0.1:${(srv.address() as net.AddressInfo).port}/gw`, calls };
+}
+
+describe("PKCE and the callback", () => {
+  it("the PKCE pair verifies (RFC 7636 S256)", () => {
+    const pair = pkcePair();
+    expect(pair.verifier).toMatch(/^[A-Za-z0-9_-]{43}$/);
+    const expected = createHash("sha256").update(pair.verifier).digest("base64url");
+    expect(pair.challenge).toBe(expected);
+    expect(pkcePair().verifier).not.toBe(pair.verifier);
+  });
+
+  it("builds the authorize URL on the base's path prefix", () => {
+    const url = new URL(
+      authorizeUrl("https://gw.example/team/", {
+        challenge: "c",
+        redirectUri: "http://127.0.0.1:5000/callback",
+        state: "s",
+      }),
+    );
+    expect(url.pathname).toBe("/team/auth/native/authorize");
+    expect(url.searchParams.get("code_challenge_method")).toBe("S256");
+    expect(url.searchParams.get("redirect_uri")).toBe("http://127.0.0.1:5000/callback");
+    expect(offersNativeSignIn({ auth_flows: ["native_pkce"] })).toBe(true);
+    expect(offersNativeSignIn({ auth_required: true })).toBe(false);
+  });
+
+  it("an OAuth state mismatch is rejected and the code never redeemed", async () => {
+    expect(() => parseCallback("/callback?code=abc&state=other", "mine")).toThrow(OAuthError);
+    expect(() => parseCallback("/callback?code=abc", "mine")).toThrow(/did not match/);
+    expect(() => parseCallback("/callback?error=access_denied", "mine")).toThrow(/refused/);
+    expect(parseCallback("/callback?code=abc&state=mine", "mine")).toBe("abc");
+
+    const server = await tokenServer(() => ({ status: 200, body: { access_token: ACCESS } }));
+    const flow = signIn(server.base, {
+      openBrowser: async (url) => {
+        const redirect = new URL(new URL(url).searchParams.get("redirect_uri") as string);
+        await fetch(`${redirect.origin}${CALLBACK_PATH}?code=forged&state=not-ours`);
+      },
+    });
+    await expect(flow).rejects.toMatchObject({ kind: "state-mismatch" });
+    expect(server.calls).toEqual([]); // nothing was exchanged
+  });
+
+  it("accepts exactly one callback on a random loopback port", async () => {
+    const loopback = await listenForCallback("st");
+    expect(loopback.redirectUri).toMatch(/^http:\/\/127\.0\.0\.1:\d+\/callback$/);
+    const origin = new URL(loopback.redirectUri).origin;
+    expect((await fetch(`${origin}/elsewhere`)).status).toBe(404);
+    expect((await fetch(`${origin}${CALLBACK_PATH}?code=c1&state=st`)).status).toBe(200);
+    await expect(loopback.code).resolves.toBe("c1");
+  });
+
+  it("times out", async () => {
+    const loopback = await listenForCallback("st", { timeoutMs: 20 });
+    await expect(loopback.code).rejects.toMatchObject({ kind: "timeout" });
+  });
+});
+
+describe("the sign-in and the session", () => {
+  it("exchanges the code with the verifier and the same redirect", async () => {
+    const server = await tokenServer(() => ({
+      status: 200,
+      body: { access_token: ACCESS, refresh_token: REFRESH, expires_in: 3600 },
+    }));
+    const tokens = await signIn(server.base, {
+      nowS: () => 1000,
+      openBrowser: async (url) => {
+        const params = new URL(url).searchParams;
+        const redirect = params.get("redirect_uri") as string;
+        await fetch(`${redirect}?code=good&state=${params.get("state")}`);
+      },
+    });
+    expect(tokens).toEqual({ accessToken: ACCESS, refreshToken: REFRESH, expiresAt: 4600 });
+    const exchange = server.calls[0];
+    expect(exchange?.path).toBe("/gw/auth/native/token");
+    expect(exchange?.body.grant_type).toBe("authorization_code");
+    expect(exchange?.body.code).toBe("good");
+    expect(exchange?.body.code_verifier).toMatch(/^[A-Za-z0-9_-]{43}$/);
+  });
+
+  it("refreshes near expiry, single flight, keeps the rotated refresh token", async () => {
+    let n = 0;
+    const server = await tokenServer((_path, body) => {
+      n += 1;
+      return {
+        status: 200,
+        body: {
+          access_token: `a-${n}-${body.refresh_token}`,
+          refresh_token: `r-${n}`,
+          expires_in: 600,
+        },
+      };
+    });
+    let now = 1000;
+    const box = vault(
+      JSON.stringify({ accessToken: ACCESS, refreshToken: REFRESH, expiresAt: 1100 }),
+    );
+    const session = new OAuthSession(server.base, box, { nowS: () => now });
+    expect(await session.accessToken()).toBe(ACCESS); // 100 s left: fine
+    now = 1050; // within 60 s of expiry
+    const [one, two] = await Promise.all([session.accessToken(), session.accessToken()]);
+    expect(one).toBe(`a-1-${REFRESH}`);
+    expect(two).toBe(one);
+    expect(server.calls).toHaveLength(1);
+    expect(decodeTokens(box.value)?.refreshToken).toBe("r-1");
+    expect(needsRefresh({ accessToken: "x", refreshToken: "", expiresAt: 0 }, 0)).toBe(true);
+  });
+
+  it("a refused refresh clears the set; a server error keeps it", async () => {
+    let status = 503;
+    const server = await tokenServer(() => ({ status, body: { error: "x" } }));
+    const box = vault(JSON.stringify({ accessToken: ACCESS, refreshToken: REFRESH, expiresAt: 1 }));
+    const session = new OAuthSession(server.base, box, { nowS: () => 1000 });
+    await expect(session.accessToken()).rejects.toMatchObject({ kind: "unreachable" });
+    expect(box.value).not.toBeNull();
+    status = 400;
+    await expect(session.accessToken()).rejects.toMatchObject({ kind: "signed-out" });
+    expect(box.value).toBeNull();
+    expect(session.signedIn()).toBe(false);
+  });
+
+  it("parses expiry forms and refuses an answer without an access token", () => {
+    expect(parseTokens({ access_token: "a", expires_at: 50 }, 10).expiresAt).toBe(50);
+    expect(
+      parseTokens({ access_token: "a" }, 10, {
+        accessToken: "o",
+        refreshToken: "keep",
+        expiresAt: 0,
+      }).refreshToken,
+    ).toBe("keep");
+    expect(() => parseTokens({}, 10)).toThrow(OAuthError);
+  });
+});
diff --git a/apps/desktop/electron/connections/nativeOauth.ts b/apps/desktop/electron/connections/nativeOauth.ts
new file mode 100644
index 0000000..6f37fd3
--- /dev/null
+++ b/apps/desktop/electron/connections/nativeOauth.ts
@@ -0,0 +1,374 @@
+// Native sign-in to a remote Indus (P24-29), RFC 8252 (OAuth 2.0 for native apps: system browser,
+// loopback redirect) with RFC 7636 PKCE (S256). The server is the authorization server for the
+// desktop and brokers the upstream identity provider; the desktop gets its own access token and a
+// rotating refresh token, kept only in the secrets store (keychain), never in a file in plaintext,
+// a URL the renderer sees, a log line or an error message.
+//
+// Server interface (advertised by `GET /api/status` → `auth_flows: ["native_pkce", …]`):
+//   GET  <base>/auth/native/authorize?code_challenge&code_challenge_method=S256&redirect_uri&state
+//   POST <base>/auth/native/token   {grant_type: authorization_code, code, code_verifier, redirect_uri}
+//   POST <base>/auth/native/refresh {grant_type: refresh_token, refresh_token}
+// both answering {access_token, refresh_token?, expires_in? | expires_at?}. A server that does not
+// advertise the flow is used in token mode.
+//
+// Rules: one loopback listener per sign-in on a random 127.0.0.1 port, path `/callback`; exactly
+// one callback is accepted and only with the state we sent (a mismatch is rejected and its code is
+// never redeemed); the listener gives up after 5 minutes. Tokens refresh 60 s before they expire
+// (an unknown expiry refreshes before use); one refresh runs at a time and every caller waits for
+// it; a rotated refresh token replaces the old one; a refresh answered 400 or 401 clears the set
+// (sign in again), anything else keeps it.
+
+import { createHash, randomBytes } from "node:crypto";
+import http from "node:http";
+import type { AddressInfo } from "node:net";
+
+export const NATIVE_FLOW = "native_pkce";
+export const CALLBACK_PATH = "/callback";
+export const LISTENER_TIMEOUT_MS = 5 * 60_000;
+export const REFRESH_SKEW_S = 60;
+export const OAUTH_REQUEST_TIMEOUT_MS = 15_000;
+
+export type OAuthErrorKind =
+  | "state-mismatch"
+  | "denied"
+  | "missing-code"
+  | "timeout"
+  | "bad-answer"
+  | "signed-out"
+  | "unreachable";
+
+export class OAuthError extends Error {
+  readonly kind: OAuthErrorKind;
+
+  constructor(kind: OAuthErrorKind, message: string) {
+    super(message);
+    this.kind = kind;
+  }
+}
+
+export interface TokenSet {
+  accessToken: string;
+  refreshToken: string;
+  /** Unix seconds; 0 = unknown. */
+  expiresAt: number;
+}
+
+function b64url(bytes: Buffer): string {
+  return bytes.toString("base64url");
+}
+
+export function pkcePair(random: (n: number) => Buffer = randomBytes): {
+  verifier: string;
+  challenge: string;
+  method: "S256";
+} {
+  const verifier = b64url(random(32));
+  const challenge = b64url(createHash("sha256").update(verifier, "ascii").digest());
+  return { verifier, challenge, method: "S256" };
+}
+
+export function newState(random: (n: number) => Buffer = randomBytes): string {
+  return b64url(random(24));
+}
+
+export function offersNativeSignIn(status: unknown): boolean {
+  const flows = (status as { auth_flows?: unknown } | null)?.auth_flows;
+  return Array.isArray(flows) && flows.includes(NATIVE_FLOW);
+}
+
+function endpoint(base: string, route: string): URL {
+  const url = new URL(base);
+  url.pathname = `${url.pathname.replace(/\/+$/, "")}${route}`;
+  url.search = "";
+  url.hash = "";
+  return url;
+}
+
+export function authorizeUrl(
+  base: string,
+  params: { challenge: string; redirectUri: string; state: string },
+): string {
+  const url = endpoint(base, "/auth/native/authorize");
+  url.searchParams.set("code_challenge", params.challenge);
+  url.searchParams.set("code_challenge_method", "S256");
+  url.searchParams.set("redirect_uri", params.redirectUri);
+  url.searchParams.set("state", params.state);
+  return url.toString();
+}
+
+/** The code of a loopback callback (`/callback?code&state` or `?error`), checked against `state`. */
+export function parseCallback(requestUrl: string, expectedState: string): string {
+  const url = new URL(requestUrl, "http://127.0.0.1");
+  const error = url.searchParams.get("error");
+  if (error !== null) {
+    const text = (url.searchParams.get("error_description") ?? "").slice(0, 200);
+    throw new OAuthError(
+      "denied",
+      `the server refused the sign-in: ${error}${text ? ` (${text})` : ""}`,
+    );
+  }
+  const state = url.searchParams.get("state") ?? "";
+  if (expectedState === "" || state !== expectedState) {
+    throw new OAuthError("state-mismatch", "the sign-in answer did not match this sign-in");
+  }
+  const code = url.searchParams.get("code") ?? "";
+  if (code === "") throw new OAuthError("missing-code", "the sign-in answer had no code");
+  return code;
+}
+
+/** A token answer → a set (snake_case wire names); `previous` keeps a refresh token not rotated. */
+export function parseTokens(body: unknown, nowS: number, previous?: TokenSet): TokenSet {
+  const record = (body ?? {}) as Record<string, unknown>;
+  const accessToken = typeof record.access_token === "string" ? record.access_token : "";
+  if (accessToken === "") throw new OAuthError("bad-answer", "the server sent no access token");
+  const refresh =
+    typeof record.refresh_token === "string" && record.refresh_token !== ""
+      ? record.refresh_token
+      : (previous?.refreshToken ?? "");
+  let expiresAt = 0;
+  if (typeof record.expires_at === "number" && Number.isFinite(record.expires_at)) {
+    expiresAt = record.expires_at;
+  } else if (typeof record.expires_in === "number" && Number.isFinite(record.expires_in)) {
+    expiresAt = nowS + record.expires_in;
+  }
+  return { accessToken, refreshToken: refresh, expiresAt };
+}
+
+export function needsRefresh(tokens: TokenSet, nowS: number, skewS = REFRESH_SKEW_S): boolean {
+  if (!(tokens.expiresAt > 0)) return true;
+  return nowS >= tokens.expiresAt - skewS;
+}
+
+export function encodeTokens(tokens: TokenSet): string {
+  return JSON.stringify(tokens);
+}
+
+export function decodeTokens(stored: string | null): TokenSet | null {
+  if (stored === null || stored === "") return null;
+  try {
+    const raw = JSON.parse(stored) as Partial<TokenSet>;
+    if (typeof raw.accessToken !== "string" || raw.accessToken === "") return null;
+    return {
+      accessToken: raw.accessToken,
+      refreshToken: typeof raw.refreshToken === "string" ? raw.refreshToken : "",
+      expiresAt: typeof raw.expiresAt === "number" ? raw.expiresAt : 0,
+    };
+  } catch {
+    return null;
+  }
+}
+
+// -- the loopback listener ------------------------------------------------------------------------
+
+export interface Loopback {
+  redirectUri: string;
+  /** The code of the one accepted callback. */
+  code: Promise<string>;
+  close(): void;
+}
+
+const DONE_PAGE =
+  "<!doctype html><meta charset=utf-8><title>Indus</title><p>You can close this tab and return to Indus.</p>";
+
+/** Listen on a random loopback port for exactly one callback carrying `state`. */
+export function listenForCallback(
+  state: string,
+  options: { timeoutMs?: number | undefined; host?: string } = {},
+): Promise<Loopback> {
+  const host = options.host ?? "127.0.0.1";
+  return new Promise((resolveListener, rejectListener) => {
+    let settle: { resolve: (code: string) => void; reject: (error: Error) => void } | null = null;
+    let finished = false;
+    const code = new Promise<string>((resolve, reject) => {
+      settle = { resolve, reject };
+    });
+    code.catch(() => undefined);
+    const server = http.createServer((request, response) => {
+      const url = new URL(request.url ?? "/", `http://${host}`);
+      if (request.method !== "GET" || url.pathname !== CALLBACK_PATH) {
+        response.writeHead(404).end();
+        return;
+      }
+      if (finished) {
+        response.writeHead(400, { "Content-Type": "text/plain" }).end("already handled");
+        return;
+      }
+      try {
+        const found = parseCallback(request.url ?? "", state);
+        finish(() => settle?.resolve(found));
+        response.writeHead(200, { "Content-Type": "text/html", "Cache-Control": "no-store" });
+        response.end(DONE_PAGE);
+      } catch (error) {
+        finish(() => settle?.reject(error as Error));
+        response.writeHead(400, { "Content-Type": "text/plain" }).end("sign-in refused");
+      }
+    });
+    const timer = setTimeout(
+      () => finish(() => settle?.reject(new OAuthError("timeout", "the sign-in took too long"))),
+      options.timeoutMs ?? LISTENER_TIMEOUT_MS,
+    );
+    const finish = (then: () => void) => {
+      if (finished) return;
+      finished = true;
+      clearTimeout(timer);
+      then();
+      setImmediate(() => server.close());
+    };
+    server.on("error", (error) => rejectListener(error));
+    server.listen(0, host, () => {
+      const port = (server.address() as AddressInfo).port;
+      resolveListener({
+        redirectUri: `http://${host}:${port}${CALLBACK_PATH}`,
+        code,
+        close: () =>
+          finish(() => settle?.reject(new OAuthError("timeout", "the sign-in was cancelled"))),
+      });
+    });
+  });
+}
+
+// -- flows ----------------------------------------------------------------------------------------
+
+export interface OAuthDeps {
+  fetch?: typeof fetch;
+  nowS?: () => number;
+  openBrowser: (url: string) => Promise<void> | void;
+  random?: (n: number) => Buffer;
+  timeoutMs?: number;
+}
+
+async function postJson(
+  deps: OAuthDeps,
+  url: URL,
+  body: Record<string, string>,
+): Promise<{ status: number; json: unknown }> {
+  let response: Response;
+  try {
+    response = await (deps.fetch ?? fetch)(url, {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Accept: "application/json" },
+      body: JSON.stringify(body),
+      redirect: "error",
+      signal: AbortSignal.timeout(OAUTH_REQUEST_TIMEOUT_MS),
+    });
+  } catch {
+    throw new OAuthError("unreachable", "the server did not answer");
+  }
+  const json: unknown = await response.json().catch(() => null);
+  return { status: response.status, json };
+}
+
+/** The whole sign-in: listener, browser, callback, code exchange → a token set. */
+export async function signIn(base: string, deps: OAuthDeps): Promise<TokenSet> {
+  const pair = pkcePair(deps.random);
+  const state = newState(deps.random);
+  const loopback = await listenForCallback(state, { timeoutMs: deps.timeoutMs });
+  try {
+    await deps.openBrowser(
+      authorizeUrl(base, { challenge: pair.challenge, redirectUri: loopback.redirectUri, state }),
+    );
+    const code = await loopback.code;
+    const answer = await postJson(deps, endpoint(base, "/auth/native/token"), {
+      grant_type: "authorization_code",
+      code,
+      code_verifier: pair.verifier,
+      redirect_uri: loopback.redirectUri,
+    });
+    if (answer.status !== 200) {
+      throw new OAuthError("denied", `the server refused the sign-in (${answer.status})`);
+    }
+    return parseTokens(answer.json, (deps.nowS ?? nowSeconds)());
+  } finally {
+    loopback.close();
+  }
+}
+
+function nowSeconds(): number {
+  return Math.floor(Date.now() / 1000);
+}
+
+export interface TokenVault {
+  get(): string | null;
+  put(value: string): void;
+  delete(): void;
+}
+
+/** One connection's signed-in state: a fresh access token on demand, refreshed single-flight. */
+export class OAuthSession {
+  private readonly base: string;
+  private readonly vault: TokenVault;
+  private readonly deps: Omit<OAuthDeps, "openBrowser">;
+  private inflight: Promise<TokenSet> | null = null;
+
+  constructor(base: string, vault: TokenVault, deps: Omit<OAuthDeps, "openBrowser"> = {}) {
+    this.base = base;
+    this.vault = vault;
+    this.deps = deps;
+  }
+
+  signedIn(): boolean {
+    return decodeTokens(this.vault.get()) !== null;
+  }
+
+  store(tokens: TokenSet): void {
+    this.vault.put(encodeTokens(tokens));
+  }
+
+  signOut(): void {
+    this.vault.delete();
+  }
+
+  /** A usable access token; refreshes when near expiry. */
+  async accessToken(): Promise<string> {
+    const tokens = decodeTokens(this.vault.get());
+    if (tokens === null) throw new OAuthError("signed-out", "sign in to this server again");
+    const now = (this.deps.nowS ?? nowSeconds)();
+    if (!needsRefresh(tokens, now)) return tokens.accessToken;
+    return (await this.refresh(tokens)).accessToken;
+  }
+
+  /** After an explicit 401/403: try one refresh; a refused refresh means sign in again. */
+  async afterUnauthorized(): Promise<string> {
+    const tokens = decodeTokens(this.vault.get());
+    if (tokens === null) throw new OAuthError("signed-out", "sign in to this server again");
+    return (await this.refresh({ ...tokens, expiresAt: 0 })).accessToken;
+  }
+
+  private refresh(current: TokenSet): Promise<TokenSet> {
+    if (this.inflight !== null) return this.inflight;
+    const run = (async () => {
+      if (current.refreshToken === "") {
+        this.vault.delete();
+        throw new OAuthError("signed-out", "sign in to this server again");
+      }
+      const answer = await postJson(
+        { ...this.deps, openBrowser: () => undefined },
+        endpoint(this.base, "/auth/native/refresh"),
+        { grant_type: "refresh_token", refresh_token: current.refreshToken },
+      );
+      if (answer.status === 400 || answer.status === 401) {
+        this.vault.delete();
+        throw new OAuthError("signed-out", "sign in to this server again");
+      }
+      if (answer.status !== 200) {
+        throw new OAuthError(
+          "unreachable",
+          `the server could not refresh the sign-in (${answer.status})`,
+        );
+      }
+      const next = parseTokens(answer.json, (this.deps.nowS ?? nowSeconds)(), current);
+      this.vault.put(encodeTokens(next));
+      return next;
+    })();
+    this.inflight = run;
+    void run.then(
+      () => {
+        this.inflight = null;
+      },
+      () => {
+        this.inflight = null;
+      },
+    );
+    return run;
+  }
+}
