+// @vitest-environment jsdom
+import { act, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { fakeRest } from "../../settings/fakeRest.ts";
+import { markRestart, restartPending, type StorageLike } from "../manage/common.tsx";
+import { MessagingPage } from "./MessagingPage.tsx";
+
+const BOT_TOKEN = ["123456", "AAH", "fake", "telegram", "token"].join("-");
+
+function memory(): StorageLike & { map: Map<string, string> } {
+  const map = new Map<string, string>();
+  return {
+    map,
+    getItem: (k) => map.get(k) ?? null,
+    setItem: (k, v) => void map.set(k, v),
+    removeItem: (k) => void map.delete(k),
+  };
+}
+
+function platform(id: string, extra: Record<string, unknown> = {}) {
+  return {
+    id,
+    name: id === "telegram" ? "Telegram" : "Slack",
+    description: "",
+    installed: true,
+    install_hint: null,
+    enabled: false,
+    configured: false,
+    state: "not_configured",
+    reason: null,
+    fields: [
+      {
+        key: id === "telegram" ? "TELEGRAM_BOT_TOKEN" : "SLACK_BOT_TOKEN",
+        kind: "credential",
+        required: true,
+        is_set: id !== "telegram",
+        is_secret: true,
+        preview: id === "telegram" ? null : "…f00d",
+        value: null,
+      },
+      {
+        key: id === "telegram" ? "TELEGRAM_ALLOWED_USERS" : "SLACK_ALLOWED_USERS",
+        kind: "policy",
+        required: false,
+        is_set: false,
+        is_secret: false,
+        preview: null,
+        value: "",
+      },
+    ],
+    ...extra,
+  };
+}
+
+function backend() {
+  const api = fakeRest();
+  api.route("GET", "/api/messaging/platforms", {
+    platforms: [platform("slack"), platform("telegram")],
+    daemon_running: true,
+  });
+  api.route("PUT", "/api/messaging/platforms/slack", {
+    ok: true,
+    platform: "slack",
+    restart_needed: true,
+  });
+  api.route("PUT", "/api/messaging/platforms/telegram", {
+    ok: true,
+    platform: "telegram",
+    restart_needed: true,
+  });
+  api.route("POST", "/api/daemon/restart", { ok: true, action: "daemon-restart" });
+  api.route("POST", "/api/pairing/approve", { ok: true });
+  return api;
+}
+
+describe("restart mark", () => {
+  it("the restart banner clears only when the instance id changes", () => {
+    const store = memory();
+    markRestart(store, "work", "inst-1");
+    expect(restartPending(store, "work", "inst-1")).toBe(true); // a reconnect to the same daemon
+    expect(restartPending(store, "work", null)).toBe(true); // disconnected: keep it
+    expect(restartPending(store, "other", "inst-2")).toBe(false); // per profile
+    expect(restartPending(store, "work", "inst-2")).toBe(false); // the daemon restarted
+    expect(restartPending(store, "work", "inst-1")).toBe(false); // and the mark is gone
+    markRestart(store, "work", null); // saved before any instance was known
+    expect(restartPending(store, "work", "inst-3")).toBe(true); // adopts the first one seen
+    expect(restartPending(store, "work", "inst-4")).toBe(false);
+  });
+});
+
+describe("MessagingPage", () => {
+  it("a card shows masked credentials and saves only changed fields", async () => {
+    const api = backend();
+    const store = memory();
+    const view = render(
+      <MessagingPage api={api} profile="work" instanceId="inst-1" storage={store} />,
+    );
+    const slack = await screen.findByRole("article", { name: "Slack" });
+    const token = slack.querySelector("input[aria-label='SLACK_BOT_TOKEN']") as HTMLInputElement;
+    expect(token.type).toBe("password");
+    expect(token.value).toBe("");
+    expect(token.placeholder).toContain("…f00d");
+    fireEvent.change(
+      slack.querySelector("input[aria-label='SLACK_ALLOWED_USERS']") as HTMLInputElement,
+      {
+        target: { value: "U1,U2" },
+      },
+    );
+    fireEvent.click(slack.querySelector("input[type='checkbox']") as HTMLInputElement);
+    fireEvent.click(within(slack).getByText("Save"));
+    await waitFor(() => expect(api.calls.some((c) => c.method === "PUT")).toBe(true));
+    const put = api.calls.find((c) => c.method === "PUT");
+    expect(put).toMatchObject({
+      path: "/api/messaging/platforms/slack",
+      profile: "work",
+      body: { enabled: true, env: { SLACK_ALLOWED_USERS: "U1,U2" } },
+    });
+    // the restart banner appears and stays across a reconnect to the same instance
+    expect(await screen.findByText("Indus needs a restart to use the new settings.")).toBeTruthy();
+    view.rerender(<MessagingPage api={api} profile="work" instanceId="inst-1" storage={store} />);
+    expect(screen.queryByText("Indus needs a restart to use the new settings.")).toBeTruthy();
+    fireEvent.click(screen.getByText("Restart now"));
+    await waitFor(() => expect(api.calls.some((c) => c.path === "/api/daemon/restart")).toBe(true));
+    expect(screen.queryByText("Indus needs a restart to use the new settings.")).toBeTruthy();
+    view.rerender(<MessagingPage api={api} profile="work" instanceId="inst-2" storage={store} />);
+    expect(screen.queryByText("Indus needs a restart to use the new settings.")).toBeNull();
+  });
+
+  it("telegram quick setup detects the user id from the first message", async () => {
+    const api = backend();
+    let pairingCalls = 0;
+    api.route("GET", "/api/pairing", () => {
+      pairingCalls += 1;
+      return {
+        status: 200,
+        body:
+          pairingCalls < 2
+            ? { pending: [], approved: [] }
+            : {
+                pending: [
+                  {
+                    platform: "slack",
+                    request_id: "x",
+                    user_id: "U9",
+                    user_name: null,
+                    age_seconds: 1,
+                  },
+                  {
+                    platform: "telegram",
+                    request_id: "req-7",
+                    user_id: "42424242",
+                    user_name: "Asha",
+                    age_seconds: 3,
+                  },
+                ],
+                approved: [],
+              },
+      };
+    });
+    const opened: string[] = [];
+    render(
+      <MessagingPage
+        api={api}
+        profile="work"
+        instanceId="inst-1"
+        storage={memory()}
+        openExternal={(url) => opened.push(url)}
+        pollMs={5}
+      />,
+    );
+    fireEvent.click(await screen.findByText("Create a bot in Telegram"));
+    expect(opened).toEqual(["https://t.me/BotFather"]);
+    fireEvent.change(screen.getByLabelText("Bot token"), { target: { value: BOT_TOKEN } });
+    fireEvent.change(screen.getByLabelText("Bot name (optional)"), {
+      target: { value: "@asha_helper_bot" },
+    });
+    fireEvent.click(screen.getByText("Save and restart"));
+    expect(await screen.findByText("https://t.me/asha_helper_bot")).toBeTruthy();
+    const input = (await screen.findByLabelText("Your Telegram user id")) as HTMLInputElement;
+    expect(input.value).toBe("42424242");
+    expect(screen.getByText("A message arrived from Asha.")).toBeTruthy();
+    fireEvent.click(screen.getByText("Allow and finish"));
+    expect(await screen.findByText("Done. Your bot answers you now.")).toBeTruthy();
+    const puts = api.calls.filter(
+      (c) => c.method === "PUT" && c.path === "/api/messaging/platforms/telegram",
+    );
+    expect(puts.map((c) => c.body)).toEqual([
+      { enabled: true, env: { TELEGRAM_BOT_TOKEN: BOT_TOKEN } },
+      { env: { TELEGRAM_ALLOWED_USERS: "42424242" } },
+    ]);
+    expect(api.calls.find((c) => c.path === "/api/pairing/approve")?.body).toEqual({
+      platform: "telegram",
+      request_id: "req-7",
+    });
+    expect(api.calls.filter((c) => c.path === "/api/daemon/restart")).toHaveLength(2);
+    // the token was typed once and is not left in the page
+    expect(document.body.innerHTML).not.toContain(BOT_TOKEN);
+  });
+
+  it("telegram quick setup needs a token and times out after ten minutes", async () => {
+    const api = backend();
+    api.route("GET", "/api/pairing", { pending: [], approved: [] });
+    render(
+      <MessagingPage api={api} profile={null} instanceId={null} storage={memory()} pollMs={5} />,
+    );
+    fireEvent.click(await screen.findByText("I already have a token"));
+    fireEvent.click(screen.getByText("Save and restart"));
+    expect(await screen.findByText("Paste the token BotFather gave you.")).toBeTruthy();
+    const realNow = Date.now;
+    let offset = 0;
+    Date.now = () => realNow() + offset;
+    try {
+      fireEvent.change(screen.getByLabelText("Bot token"), { target: { value: BOT_TOKEN } });
+      fireEvent.click(screen.getByText("Save and restart"));
+      await screen.findByText(/Now send your bot any message/);
+      await act(async () => {
+        offset = 10 * 60_000 + 1;
+        await new Promise((resolve) => setTimeout(resolve, 30));
+      });
+      expect(
+        await screen.findByText("No message arrived within ten minutes. Try again."),
+      ).toBeTruthy();
+    } finally {
+      Date.now = realNow;
+    }
+  });
+});
diff --git a/apps/desktop/src/app/messaging/MessagingPage.tsx b/apps/desktop/src/app/messaging/MessagingPage.tsx
new file mode 100644
index 0000000..245920d
--- /dev/null
+++ b/apps/desktop/src/app/messaging/MessagingPage.tsx
@@ -0,0 +1,251 @@
+// The Messaging page (P24-27): one card per platform from `GET /api/messaging/platforms` — its
+// state, its credential fields (masked: only a preview is ever shown, a blank field keeps what is
+// stored), its settings and allowlist, an enable switch and a Test button. Values go to the daemon
+// through `PUT /api/messaging/platforms/{id}` (credentials into the profile's secret store);
+// nothing typed into a credential field is kept after the save. A change that needs a restart
+// raises the restart banner (see `manage/common.tsx`). Telegram gets the quick setup.
+
+import { useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestLike, rest } from "../../settings/settingsApi.ts";
+import { desktopBridge } from "../bridge.ts";
+import {
+  LoadState,
+  markRestart,
+  PageFrame,
+  RestartBanner,
+  restartPending,
+  type StorageLike,
+  sessionStore,
+  useApi,
+  useRestValue,
+} from "../manage/common.tsx";
+import { TelegramQrSetup } from "./TelegramQrSetup.tsx";
+
+export interface PlatformField {
+  key: string;
+  kind: "credential" | "setting" | "policy" | string;
+  required: boolean;
+  is_set: boolean;
+  is_secret: boolean;
+  preview: string | null;
+  value: string | null;
+}
+
+export interface MessagingPlatform {
+  id: string;
+  name: string;
+  description: string;
+  installed: boolean;
+  install_hint: string | null;
+  enabled: boolean;
+  configured: boolean;
+  state: string;
+  reason: string | null;
+  fields: PlatformField[];
+}
+
+const TONES: Readonly<Record<string, "ok" | "warn" | "bad">> = {
+  connected: "ok",
+  pending_restart: "warn",
+  retrying: "warn",
+  daemon_stopped: "warn",
+  not_configured: "warn",
+  fatal: "bad",
+};
+
+export interface MessagingPageProps {
+  api?: RestLike | null;
+  profile: string | null;
+  /** The daemon instance this window is connected to (the restart banner watches it). */
+  instanceId: string | null;
+  storage?: StorageLike | null;
+  openExternal?: (url: string) => void;
+  pollMs?: number;
+}
+
+function PlatformCard(props: {
+  platform: MessagingPlatform;
+  api: RestLike | null;
+  profile: string | null;
+  onSaved: (restartNeeded: boolean) => void;
+}) {
+  const t = useT();
+  const { platform } = props;
+  const [draft, setDraft] = useState<Record<string, string>>({});
+  const [enabled, setEnabled] = useState(platform.enabled);
+  const [note, setNote] = useState("");
+  const [busy, setBusy] = useState(false);
+  const changed = Object.entries(draft).filter(([key, value]) => {
+    const field = platform.fields.find((f) => f.key === key);
+    if (field === undefined) return false;
+    if (field.kind === "credential") return value.trim() !== "";
+    return value !== (field.value ?? "");
+  });
+
+  const save = async () => {
+    setBusy(true);
+    const body: { enabled?: boolean; env?: Record<string, string> } = {};
+    if (enabled !== platform.enabled) body.enabled = enabled;
+    if (changed.length > 0) body.env = Object.fromEntries(changed.map(([k, v]) => [k, v.trim()]));
+    const answer = await rest<{ restart_needed: boolean }>(
+      props.api,
+      "PUT",
+      `/api/messaging/platforms/${encodeURIComponent(platform.id)}`,
+      { profile: props.profile, body },
+    );
+    setBusy(false);
+    if (!answer.ok) {
+      setNote(answer.message);
+      return;
+    }
+    setDraft({}); // credentials typed here are the daemon's now
+    setNote(t("manage.messaging.saved"));
+    props.onSaved(answer.data.restart_needed);
+  };
+
+  const test = async () => {
+    setBusy(true);
+    const answer = await rest<{ ok: boolean; message: string }>(
+      props.api,
+      "POST",
+      `/api/messaging/platforms/${encodeURIComponent(platform.id)}/test`,
+      { profile: props.profile },
+    );
+    setBusy(false);
+    setNote(answer.ok ? answer.data.message : answer.message);
+  };
+
+  return (
+    <article className="manage-card" aria-label={platform.name} data-platform={platform.id}>
+      <div className="manage-inline">
+        <h2>{platform.name}</h2>
+        <span className="manage-badge" data-tone={TONES[platform.state]}>
+          {t("manage.messaging.state", { state: platform.state.replace(/_/g, " ") })}
+        </span>
+      </div>
+      {platform.description !== "" && <p className="manage-muted">{platform.description}</p>}
+      {!platform.installed ? (
+        <p className="manage-muted">
+          {t("manage.messaging.notInstalled", { hint: platform.install_hint ?? "" })}
+        </p>
+      ) : (
+        <>
+          {platform.fields.map((field) => (
+            <label className="manage-field" key={field.key}>
+              {field.key}
+              <input
+                type={field.kind === "credential" ? "password" : "text"}
+                autoComplete="off"
+                aria-label={field.key}
+                placeholder={
+                  field.kind === "credential"
+                    ? field.is_set
+                      ? t("manage.messaging.keep", { preview: field.preview ?? "" })
+                      : t("manage.messaging.notSet")
+                    : ""
+                }
+                value={draft[field.key] ?? (field.kind === "credential" ? "" : (field.value ?? ""))}
+                onChange={(e) => setDraft({ ...draft, [field.key]: e.target.value })}
+              />
+            </label>
+          ))}
+          <label className="manage-inline">
+            <input
+              type="checkbox"
+              checked={enabled}
+              onChange={(e) => setEnabled(e.target.checked)}
+            />
+            {t("manage.messaging.enabled")}
+          </label>
+          <div className="manage-inline">
+            <button
+              type="button"
+              className="button button-primary"
+              disabled={busy || (changed.length === 0 && enabled === platform.enabled)}
+              onClick={() => void save()}
+            >
+              {t("manage.save")}
+            </button>
+            <button
+              type="button"
+              className="button button-secondary"
+              disabled={busy}
+              onClick={() => void test()}
+            >
+              {t("manage.messaging.test")}
+            </button>
+          </div>
+        </>
+      )}
+      {note !== "" && (
+        <p className="manage-muted" role="status">
+          {note}
+        </p>
+      )}
+    </article>
+  );
+}
+
+export function MessagingPage(props: MessagingPageProps) {
+  const t = useT();
+  const api = useApi(props.api);
+  const storage = props.storage === undefined ? sessionStore() : props.storage;
+  const [, bump] = useState(0);
+  const [restarting, setRestarting] = useState(false);
+  const platforms = useRestValue<{ platforms: MessagingPlatform[] }>(
+    () => rest(api, "GET", "/api/messaging/platforms", { profile: props.profile }),
+    [api, props.profile],
+  );
+  const pending = restartPending(storage, props.profile, props.instanceId);
+  const askRestart = () => {
+    markRestart(storage, props.profile, props.instanceId);
+    bump((n) => n + 1);
+  };
+  const restart = async () => {
+    setRestarting(true);
+    await rest(api, "POST", "/api/daemon/restart", { profile: props.profile });
+    setRestarting(false);
+  };
+  const open =
+    props.openExternal ?? ((url: string) => void desktopBridge()?.external.open({ url }));
+
+  return (
+    <PageFrame title={t("nav.messaging")} id="messaging">
+      <RestartBanner visible={pending} restarting={restarting} onRestart={() => void restart()} />
+      <LoadState value={platforms}>
+        {(data) => (
+          <div className="manage-grid">
+            {data.platforms.map((platform) => (
+              <div key={platform.id} className="manage-body">
+                <PlatformCard
+                  platform={platform}
+                  api={api}
+                  profile={props.profile}
+                  onSaved={(restartNeeded) => {
+                    if (restartNeeded) askRestart();
+                    platforms.reload();
+                  }}
+                />
+                {platform.id === "telegram" && platform.installed && (
+                  <TelegramQrSetup
+                    api={api}
+                    platform={platform}
+                    profile={props.profile}
+                    openExternal={open}
+                    onRestartAsked={askRestart}
+                    onDone={platforms.reload}
+                    {...(props.pollMs === undefined ? {} : { pollMs: props.pollMs })}
+                  />
+                )}
+              </div>
+            ))}
+            {data.platforms.length === 0 && (
+              <p className="manage-muted">{t("manage.messaging.none")}</p>
+            )}
+          </div>
+        )}
+      </LoadState>
+    </PageFrame>
+  );
+}
diff --git a/apps/desktop/src/app/messaging/TelegramQrSetup.tsx b/apps/desktop/src/app/messaging/TelegramQrSetup.tsx
new file mode 100644
index 0000000..e5c61d4
--- /dev/null
+++ b/apps/desktop/src/app/messaging/TelegramQrSetup.tsx
@@ -0,0 +1,261 @@
+// Telegram quick setup (P24-27), our own flow (no hosted bot-minting service):
+//   1. "Create a bot" opens Telegram's BotFather in the system browser;
+//   2. the person pastes the bot token (and the bot's @name BotFather showed) → saved for the
+//      Telegram platform, the platform enabled, the gateway restarted;
+//   3. the page shows the bot's link and asks the person to send it any message;
+//   4. it polls the pairing list every 2 s: the first pending Telegram request carries the
+//      person's numeric user id (shown, editable, digits only);
+//   5. "Allow and finish" saves that id as the allowlist, approves the request and restarts the
+//      gateway again.
+// The wait gives up after 10 minutes. The token is sent once to the daemon (keychain/env through
+// the REST route) and never kept in this component after the save.
+
+import { useEffect, useRef, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestLike, rest } from "../../settings/settingsApi.ts";
+
+export const BOTFATHER_URL = "https://t.me/BotFather";
+export const PAIRING_POLL_MS = 2_000;
+export const SETUP_TIMEOUT_MS = 10 * 60_000;
+const USER_ID_RE = /^\d{3,20}$/;
+const BOT_NAME_RE = /^@?([A-Za-z][A-Za-z0-9_]{3,31}bot)$/i;
+
+export interface TelegramPlatform {
+  id: string;
+  fields: ReadonlyArray<{ key: string; kind: string }>;
+}
+
+interface PairingPending {
+  platform: string;
+  request_id: string;
+  user_id: string;
+  user_name: string | null;
+}
+
+type Phase = "idle" | "token" | "saving" | "waiting" | "detected" | "applying" | "done";
+
+export function tokenKey(platform: TelegramPlatform): string {
+  return platform.fields.find((f) => f.kind === "credential")?.key ?? "TELEGRAM_BOT_TOKEN";
+}
+
+export function allowlistKey(platform: TelegramPlatform): string {
+  return (
+    platform.fields.find((f) => f.key.endsWith("ALLOWED_USERS"))?.key ?? "TELEGRAM_ALLOWED_USERS"
+  );
+}
+
+export function TelegramQrSetup(props: {
+  api: RestLike | null;
+  platform: TelegramPlatform;
+  profile: string | null;
+  openExternal: (url: string) => void;
+  /** The gateway was asked to restart (the page keeps its banner until a new instance). */
+  onRestartAsked: () => void;
+  onDone?: () => void;
+  pollMs?: number;
+  timeoutMs?: number;
+}) {
+  const t = useT();
+  const [phase, setPhase] = useState<Phase>("idle");
+  const [token, setToken] = useState("");
+  const [botName, setBotName] = useState("");
+  const [detected, setDetected] = useState<PairingPending | null>(null);
+  const [userId, setUserId] = useState("");
+  const [error, setError] = useState("");
+  const started = useRef(0);
+  const { api, platform, profile } = props;
+
+  useEffect(() => {
+    if (phase !== "waiting") return;
+    let live = true;
+    let timer: ReturnType<typeof setTimeout> | null = null;
+    const poll = async () => {
+      if (!live) return;
+      if (Date.now() - started.current >= (props.timeoutMs ?? SETUP_TIMEOUT_MS)) {
+        setPhase("token");
+        setError(t("manage.telegram.timedOut"));
+        return;
+      }
+      const answer = await rest<{ pending: PairingPending[] }>(api, "GET", "/api/pairing", {
+        profile,
+      });
+      if (!live) return;
+      const first = answer.ok
+        ? answer.data.pending.find((p) => p.platform === platform.id)
+        : undefined;
+      if (first !== undefined) {
+        setDetected(first);
+        setUserId(USER_ID_RE.test(first.user_id) ? first.user_id : "");
+        setPhase("detected");
+        return;
+      }
+      setError(answer.ok ? "" : t("manage.telegram.stillWaiting"));
+      timer = setTimeout(() => void poll(), props.pollMs ?? PAIRING_POLL_MS);
+    };
+    timer = setTimeout(() => void poll(), props.pollMs ?? PAIRING_POLL_MS);
+    return () => {
+      live = false;
+      if (timer !== null) clearTimeout(timer);
+    };
+  }, [phase, api, platform.id, profile, props.pollMs, props.timeoutMs, t]);
+
+  const restart = async () => {
+    await rest(api, "POST", "/api/daemon/restart", { profile });
+    props.onRestartAsked();
+  };
+
+  const saveToken = async () => {
+    const clean = token.trim();
+    if (clean === "") {
+      setError(t("manage.telegram.needToken"));
+      return;
+    }
+    if (botName.trim() !== "" && !BOT_NAME_RE.test(botName.trim())) {
+      setError(t("manage.telegram.badBotName"));
+      return;
+    }
+    setPhase("saving");
+    setError("");
+    const saved = await rest(
+      api,
+      "PUT",
+      `/api/messaging/platforms/${encodeURIComponent(platform.id)}`,
+      {
+        profile,
+        body: { enabled: true, env: { [tokenKey(platform)]: clean } },
+      },
+    );
+    setToken(""); // the token is the daemon's now
+    if (!saved.ok) {
+      setPhase("token");
+      setError(saved.message);
+      return;
+    }
+    await restart();
+    started.current = Date.now();
+    setPhase("waiting");
+  };
+
+  const apply = async () => {
+    if (!USER_ID_RE.test(userId.trim())) {
+      setError(t("manage.telegram.numericOnly"));
+      return;
+    }
+    setPhase("applying");
+    setError("");
+    const saved = await rest(
+      api,
+      "PUT",
+      `/api/messaging/platforms/${encodeURIComponent(platform.id)}`,
+      {
+        profile,
+        body: { env: { [allowlistKey(platform)]: userId.trim() } },
+      },
+    );
+    if (!saved.ok) {
+      setPhase("detected");
+      setError(saved.message);
+      return;
+    }
+    if (detected !== null && detected.user_id === userId.trim()) {
+      await rest(api, "POST", "/api/pairing/approve", {
+        profile,
+        body: { platform: platform.id, request_id: detected.request_id },
+      });
+    }
+    await restart();
+    setPhase("done");
+    props.onDone?.();
+  };
+
+  const link = BOT_NAME_RE.exec(botName.trim())?.[1];
+  return (
+    <div className="manage-card" data-testid="telegram-setup">
+      <h3>{t("manage.telegram.title")}</h3>
+      <p className="manage-muted">{t("manage.telegram.help")}</p>
+      {error !== "" && (
+        <p className="manage-error" role="alert">
+          {error}
+        </p>
+      )}
+      {phase === "idle" && (
+        <div className="manage-inline">
+          <button
+            type="button"
+            className="button button-primary"
+            onClick={() => {
+              props.openExternal(BOTFATHER_URL);
+              setPhase("token");
+            }}
+          >
+            {t("manage.telegram.create")}
+          </button>
+          <button
+            type="button"
+            className="button button-secondary"
+            onClick={() => setPhase("token")}
+          >
+            {t("manage.telegram.haveToken")}
+          </button>
+        </div>
+      )}
+      {(phase === "token" || phase === "saving") && (
+        <>
+          <label className="manage-field">
+            {t("manage.telegram.token")}
+            <input
+              type="password"
+              autoComplete="off"
+              value={token}
+              onChange={(e) => setToken(e.target.value)}
+            />
+          </label>
+          <label className="manage-field">
+            {t("manage.telegram.botName")}
+            <input
+              value={botName}
+              onChange={(e) => setBotName(e.target.value)}
+              placeholder="@my_helper_bot"
+            />
+          </label>
+          <button
+            type="button"
+            className="button button-primary"
+            disabled={phase === "saving"}
+            onClick={() => void saveToken()}
+          >
+            {t("manage.telegram.saveToken")}
+          </button>
+        </>
+      )}
+      {phase === "waiting" && (
+        <div role="status">
+          <p>{t("manage.telegram.sendMessage")}</p>
+          {link !== undefined && <p className="manage-code">{`https://t.me/${link}`}</p>}
+        </div>
+      )}
+      {(phase === "detected" || phase === "applying") && (
+        <>
+          <p>
+            {t("manage.telegram.detected", {
+              name: detected?.user_name ?? detected?.user_id ?? "",
+            })}
+          </p>
+          <label className="manage-field">
+            {t("manage.telegram.userId")}
+            <input inputMode="numeric" value={userId} onChange={(e) => setUserId(e.target.value)} />
+          </label>
+          <button
+            type="button"
+            className="button button-primary"
+            disabled={phase === "applying"}
+            onClick={() => void apply()}
+          >
+            {t("manage.telegram.apply")}
+          </button>
+        </>
+      )}
+      {phase === "done" && <p role="status">{t("manage.telegram.done")}</p>}
+    </div>
+  );
+}
