@@ -0,0 +1,86 @@
+# STAND-IN: removed at integration
+"""Stand-ins for P24-31's tests until P24-07 (R1, ``state/bot_chat.py``) and the daemon wiring land.
+
+Assumed interface (``indus.service.bots_rpc.CanonicalChats``): ``find(profile) -> tip | None`` and
+``ensure(profile) -> (tip, created)``. R1's ``state.bot_chat.find_canonical(store)`` /
+``ensure_canonical(store)`` give exactly that per profile store; at integration the daemon passes
+an adapter over those two functions and this file goes. The behaviour copied here is R1's
+contract (title-only identity, hidden rows included, lineage tip, adopt before mint), written over
+the real P02 store so compression and races are exercised for real.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+import threading
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.ids import new_session_id
+from indus.state import lineage, sessions, titles
+from indus.state.registry import StoreHandle
+
+CANONICAL_TITLE = "Bot chat"
+
+
+def _find_in(conn: sqlite3.Connection) -> str | None:
+    row = conn.execute("SELECT id FROM sessions WHERE title = ?", (CANONICAL_TITLE,)).fetchone()
+    return None if row is None else lineage.tip_in(conn, str(row["id"]))
+
+
+class StoreCanonicalChats:
+    """``CanonicalChats`` over one real store per profile; counts mints and pauses on demand."""
+
+    def __init__(self, stores: Mapping[str, StoreHandle]) -> None:
+        self.stores = dict(stores)
+        self.mints = 0
+        self.between_looks: threading.Event | None = None  # set: hold the first look's caller
+
+    def find(self, profile: str) -> str | None:
+        with self.stores[profile].read() as conn:
+            return _find_in(conn)
+
+    def ensure(self, profile: str) -> tuple[str, bool]:
+        store = self.stores[profile]
+        found = self.find(profile)
+        if found is not None:
+            return found, False
+        if self.between_looks is not None:
+            self.between_looks.wait(2.0)
+        clock = store.scope.clock
+
+        def mint(conn: sqlite3.Connection) -> tuple[str, bool]:
+            again = _find_in(conn)
+            if again is not None:
+                return again, False
+            session_id = new_session_id(clock)
+            now = clock.now().timestamp()
+            sessions.create_in(conn, session_id, "bots", now=now, hidden=1)
+            titles.set_title_in(conn, session_id, CANONICAL_TITLE, source="user")
+            self.mints += 1
+            return session_id, True
+
+        return store.write(mint)
+
+
+class FakeProfiles:
+    def __init__(self, root: Path, names: Sequence[str]) -> None:
+        self.root = root
+        self._names = list(names)
+        for name in self._names:
+            (root / name).mkdir(parents=True, exist_ok=True)
+
+    def names(self) -> Sequence[str]:
+        return list(self._names)
+
+    def home(self, profile: str) -> Path:
+        return self.root / profile
+
+
+class FakeRoutines:
+    def __init__(self, jobs: Mapping[str, Sequence[Mapping[str, Any]]] | None = None) -> None:
+        self._jobs = dict(jobs or {})
+
+    def jobs(self, profile: str) -> Sequence[Mapping[str, Any]]:
+        return list(self._jobs.get(profile, ()))
