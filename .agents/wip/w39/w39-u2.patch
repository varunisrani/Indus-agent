+  "command-center",
+  "learning-map",
+  "bots",
+] as const;
 export const OVERLAYS = ["settings", "cron", "profiles", "agents"] as const;
 
 export type PageId = (typeof PAGES)[number];
diff --git a/apps/desktop/src/app/webhooks/WebhooksPage.tsx b/apps/desktop/src/app/webhooks/WebhooksPage.tsx
new file mode 100644
index 0000000..81a4f57
--- /dev/null
+++ b/apps/desktop/src/app/webhooks/WebhooksPage.tsx
@@ -0,0 +1,225 @@
+// The Webhooks page (P24-27): the routes the daemon's webhook receiver serves (P15-32) — list,
+// create, enable/disable, delete. Routes defined in config.yaml are shown read-only. The signing
+// secret exists in exactly one answer (the create) and lives only in this component's state until
+// the person closes the notice; it is never written to storage or a log.
+
+import { useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestLike, rest } from "../../settings/settingsApi.ts";
+import { LoadState, PageFrame, useApi, useRestValue, when } from "../manage/common.tsx";
+
+export const WEBHOOK_AUTHS = ["auto", "github", "gitlab", "hmac", "hmac_ts"] as const;
+
+export interface WebhookRoute {
+  name: string;
+  source: "subscribed" | "config" | string;
+  url: string;
+  auth: string;
+  events: string[];
+  prompt: string;
+  deliver: string | null;
+  description: string;
+  created_at: string | null;
+  enabled: boolean;
+  secret_set: boolean;
+}
+
+interface WebhooksAnswer {
+  receiver_enabled: boolean;
+  base_url: string;
+  routes: WebhookRoute[];
+}
+
+export function WebhooksPage(props: { api?: RestLike | null; profile: string | null }) {
+  const t = useT();
+  const api = useApi(props.api);
+  const routes = useRestValue<WebhooksAnswer>(
+    () => rest(api, "GET", "/api/webhooks", { profile: props.profile }),
+    [api, props.profile],
+  );
+  const [name, setName] = useState("");
+  const [events, setEvents] = useState("");
+  const [prompt, setPrompt] = useState("");
+  const [deliver, setDeliver] = useState("");
+  const [auth, setAuth] = useState<(typeof WEBHOOK_AUTHS)[number]>("auto");
+  const [secret, setSecret] = useState<{ name: string; value: string; url: string } | null>(null);
+  const [note, setNote] = useState("");
+
+  const create = async () => {
+    const body = {
+      name: name.trim(),
+      events: events
+        .split(",")
+        .map((e) => e.trim())
+        .filter((e) => e !== ""),
+      prompt,
+      auth,
+      ...(deliver.trim() === "" ? {} : { deliver: deliver.trim() }),
+    };
+    const answer = await rest<WebhookRoute & { secret: string }>(api, "POST", "/api/webhooks", {
+      profile: props.profile,
+      body,
+    });
+    if (!answer.ok) {
+      setNote(answer.message);
+      return;
+    }
+    setSecret({ name: answer.data.name, value: answer.data.secret, url: answer.data.url });
+    setName("");
+    setEvents("");
+    setPrompt("");
+    setDeliver("");
+    setNote("");
+    routes.reload();
+  };
+
+  const toggle = async (route: WebhookRoute) => {
+    const answer = await rest(
+      api,
+      "PUT",
+      `/api/webhooks/${encodeURIComponent(route.name)}/enabled`,
+      {
+        profile: props.profile,
+        body: { enabled: !route.enabled },
+      },
+    );
+    if (!answer.ok) setNote(answer.message);
+    routes.reload();
+  };
+
+  const remove = async (route: WebhookRoute) => {
+    const answer = await rest(api, "DELETE", `/api/webhooks/${encodeURIComponent(route.name)}`, {
+      profile: props.profile,
+    });
+    if (!answer.ok) setNote(answer.message);
+    routes.reload();
+  };
+
+  return (
+    <PageFrame title={t("nav.webhooks")} id="webhooks">
+      {secret !== null && (
+        <div className="manage-banner" role="alert">
+          <div>
+            <p>{t("manage.webhooks.secretOnce", { name: secret.name })}</p>
+            <p className="manage-code" data-testid="webhook-secret">
+              {secret.value}
+            </p>
+            <p className="manage-muted">{secret.url}</p>
+          </div>
+          <button type="button" className="button button-secondary" onClick={() => setSecret(null)}>
+            {t("manage.webhooks.secretDone")}
+          </button>
+        </div>
+      )}
+      {note !== "" && (
+        <p className="manage-error" role="alert">
+          {note}
+        </p>
+      )}
+      <LoadState value={routes}>
+        {(data) => (
+          <>
+            {!data.receiver_enabled && (
+              <p className="manage-muted">{t("manage.webhooks.receiverOff")}</p>
+            )}
+            <table className="manage-table">
+              <thead>
+                <tr>
+                  <th>{t("manage.webhooks.name")}</th>
+                  <th>{t("manage.webhooks.events")}</th>
+                  <th>{t("manage.webhooks.auth")}</th>
+                  <th>{t("manage.webhooks.created")}</th>
+                  <th />
+                </tr>
+              </thead>
+              <tbody>
+                {data.routes.map((route) => (
+                  <tr key={route.name}>
+                    <td>
+                      <strong>{route.name}</strong>
+                      <div className="manage-muted">{route.url}</div>
+                    </td>
+                    <td>
+                      {route.events.length === 0
+                        ? t("manage.webhooks.allEvents")
+                        : route.events.join(", ")}
+                    </td>
+                    <td>{route.auth}</td>
+                    <td>{when(route.created_at)}</td>
+                    <td>
+                      {route.source === "config" ? (
+                        <span className="manage-muted">{t("manage.webhooks.fromConfig")}</span>
+                      ) : (
+                        <span className="manage-inline">
+                          <label className="manage-inline">
+                            <input
+                              type="checkbox"
+                              checked={route.enabled}
+                              aria-label={t("manage.webhooks.enable", { name: route.name })}
+                              onChange={() => void toggle(route)}
+                            />
+                          </label>
+                          <button
+                            type="button"
+                            className="button button-secondary"
+                            onClick={() => void remove(route)}
+                          >
+                            {t("manage.delete")}
+                          </button>
+                        </span>
+                      )}
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+            {data.routes.length === 0 && (
+              <p className="manage-muted">{t("manage.webhooks.none")}</p>
+            )}
+          </>
+        )}
+      </LoadState>
+      <form
+        className="manage-card"
+        onSubmit={(e) => {
+          e.preventDefault();
+          void create();
+        }}
+      >
+        <h2>{t("manage.webhooks.new")}</h2>
+        <label className="manage-field">
+          {t("manage.webhooks.name")}
+          <input value={name} onChange={(e) => setName(e.target.value)} required />
+        </label>
+        <label className="manage-field">
+          {t("manage.webhooks.eventsHelp")}
+          <input value={events} onChange={(e) => setEvents(e.target.value)} />
+        </label>
+        <label className="manage-field">
+          {t("manage.webhooks.prompt")}
+          <textarea value={prompt} onChange={(e) => setPrompt(e.target.value)} rows={3} />
+        </label>
+        <label className="manage-field">
+          {t("manage.webhooks.deliver")}
+          <input value={deliver} onChange={(e) => setDeliver(e.target.value)} />
+        </label>
+        <label className="manage-field">
+          {t("manage.webhooks.auth")}
+          <select
+            value={auth}
+            onChange={(e) => setAuth(e.target.value as (typeof WEBHOOK_AUTHS)[number])}
+          >
+            {WEBHOOK_AUTHS.map((a) => (
+              <option key={a} value={a}>
+                {a}
+              </option>
+            ))}
+          </select>
+        </label>
+        <button type="submit" className="button button-primary" disabled={name.trim() === ""}>
+          {t("manage.webhooks.create")}
+        </button>
+      </form>
+    </PageFrame>
+  );
+}
diff --git a/apps/desktop/src/bots/BotsPage.tsx b/apps/desktop/src/bots/BotsPage.tsx
new file mode 100644
index 0000000..3f84c2b
--- /dev/null
+++ b/apps/desktop/src/bots/BotsPage.tsx
@@ -0,0 +1,279 @@
+// The Bots surface (P24-31): every profile as a bot — its avatar, its routines (that profile's cron
+// jobs), the sections the person sorted it into and a hidden flag — plus the group rooms. A click
+// opens the bot's forever-chat through `CanonicalChats` (identity from the daemon only). The
+// surface is a bundled desktop contribution: `registerBotsSurface` adds its route and nav entry to
+// the contribution registry (P24-32) and its switch unregisters both live.
+
+import { type ReactNode, useEffect, useMemo, useState } from "react";
+import { useNavigate } from "react-router";
+import { Loader } from "../app/Loader.tsx";
+import { sessionPath } from "../app/routes.ts";
+import { useT } from "../i18n/index.tsx";
+import "../app/manage/manage.css";
+import { type Avatar, AvatarView, readAvatarFile } from "./avatar.tsx";
+import { CanonicalChats, type CanonicalRow, type RpcLike } from "./canonicalChat.ts";
+import { GroupRoom } from "./GroupRoom.tsx";
+
+export interface BotRow {
+  profile: string;
+  avatar: Avatar;
+  hidden: boolean;
+  sections: string[];
+  routines: Array<{ id: string; name: string; schedule: string; enabled: boolean }>;
+  canonical: CanonicalRow | null;
+}
+
+interface RoomRow {
+  room_id: string;
+  name: string;
+  members: Array<Record<string, unknown>>;
+}
+
+export function BotsPage(props: {
+  rpc: RpcLike;
+  chats?: CanonicalChats;
+  onOpenChat?: (sessionId: string) => void;
+}) {
+  const t = useT();
+  const navigate = useNavigate();
+  const chats = useMemo(
+    () => props.chats ?? new CanonicalChats(props.rpc),
+    [props.chats, props.rpc],
+  );
+  const openChat = props.onOpenChat ?? ((id: string) => navigate(sessionPath(id)));
+  const [bots, setBots] = useState<BotRow[] | null>(null);
+  const [rooms, setRooms] = useState<RoomRow[]>([]);
+  const [room, setRoom] = useState<string | null>(null);
+  const [showHidden, setShowHidden] = useState(false);
+  const [error, setError] = useState("");
+  const [serial, setSerial] = useState(0);
+  const { rpc } = props;
+
+  // biome-ignore lint/correctness/useExhaustiveDependencies: `serial` asks for a reload after a change
+  useEffect(() => {
+    let live = true;
+    void (async () => {
+      try {
+        const answer = (await rpc.request("bots.list", {})) as { bots: BotRow[] };
+        if (!live) return;
+        for (const bot of answer.bots) chats.remember(bot.profile, bot.canonical);
+        setBots(answer.bots);
+      } catch (failure) {
+        if (live) setError(failure instanceof Error ? failure.message : t("manage.failed"));
+      }
+      try {
+        const listed = (await rpc.request("groups.list", {})) as { rooms: RoomRow[] };
+        if (live) setRooms(listed.rooms);
+      } catch {
+        if (live) setRooms([]); // no room support on this daemon
+      }
+    })();
+    return () => {
+      live = false;
+    };
+  }, [rpc, chats, t, serial]);
+
+  const open = async (bot: BotRow) => {
+    try {
+      openChat(await chats.open(bot.profile));
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  const update = async (
+    bot: BotRow,
+    change: Partial<Pick<BotRow, "hidden" | "sections" | "avatar">>,
+  ) => {
+    try {
+      await rpc.request("bots.update", { profile: bot.profile, ...change });
+      setSerial((n) => n + 1);
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  const visibleBots = (bots ?? []).filter((bot) => showHidden || !bot.hidden);
+  const sections = new Map<string, BotRow[]>();
+  for (const bot of visibleBots) {
+    const key = bot.sections[0] ?? "";
+    sections.set(key, [...(sections.get(key) ?? []), bot]);
+  }
+
+  return (
+    <section className="manage-page" aria-labelledby="bots-title">
+      <header className="manage-header">
+        <h1 id="bots-title">{t("nav.bots")}</h1>
+        <label className="manage-inline">
+          <input
+            type="checkbox"
+            checked={showHidden}
+            onChange={(e) => setShowHidden(e.target.checked)}
+          />
+          {t("manage.bots.showHidden")}
+        </label>
+      </header>
+      {error !== "" && (
+        <p className="manage-error" role="alert">
+          {error}
+        </p>
+      )}
+      {bots === null && error === "" && <Loader />}
+      {[...sections.entries()].map(([section, rows]) => (
+        <div className="manage-body" key={section || "-"}>
+          {section !== "" && <h2>{section}</h2>}
+          <div className="manage-grid">
+            {rows.map((bot) => (
+              <article className="manage-card" key={bot.profile} data-bot={bot.profile}>
+                <button type="button" className="bots-row" onClick={() => void open(bot)}>
+                  <AvatarView avatar={bot.avatar} fallbackSeed={bot.profile} label={bot.profile} />
+                  <span>
+                    <strong>{bot.profile}</strong>
+                    <span className="manage-muted">
+                      {" "}
+                      {t("manage.bots.routines", { count: bot.routines.length })}
+                    </span>
+                  </span>
+                </button>
+                <div className="manage-inline">
+                  <button
+                    type="button"
+                    className="button button-secondary"
+                    onClick={() =>
+                      void update(bot, {
+                        avatar: { kind: "face", seed: `${bot.profile}-${Date.now()}` },
+                      })
+                    }
+                  >
+                    {t("manage.bots.newFace")}
+                  </button>
+                  <label className="button button-secondary">
+                    {t("manage.bots.upload")}
+                    <input
+                      type="file"
+                      accept="image/png,image/jpeg,image/webp"
+                      hidden
+                      onChange={(e) => {
+                        const file = e.target.files?.[0];
+                        if (file === undefined) return;
+                        void readAvatarFile(file).then(
+                          (data) => update(bot, { avatar: { kind: "upload", data } }),
+                          (failure: Error) => setError(failure.message),
+                        );
+                      }}
+                    />
+                  </label>
+                  <button
+                    type="button"
+                    className="button button-secondary"
+                    onClick={() => void update(bot, { hidden: !bot.hidden })}
+                  >
+                    {bot.hidden ? t("manage.bots.unhide") : t("manage.bots.hide")}
+                  </button>
+                  <input
+                    aria-label={t("manage.bots.section", { name: bot.profile })}
+                    defaultValue={bot.sections.join(", ")}
+                    onBlur={(e) => {
+                      const next = e.target.value
+                        .split(",")
+                        .map((s) => s.trim())
+                        .filter((s) => s !== "");
+                      if (next.join(",") !== bot.sections.join(","))
+                        void update(bot, { sections: next });
+                    }}
+                  />
+                </div>
+                {bot.routines.length > 0 && (
+                  <ul className="manage-muted">
+                    {bot.routines.map((r) => (
+                      <li key={r.id}>
+                        {r.name || r.id} · {r.schedule}
+                        {r.enabled ? "" : ` (${t("manage.bots.paused")})`}
+                      </li>
+                    ))}
+                  </ul>
+                )}
+              </article>
+            ))}
+          </div>
+        </div>
+      ))}
+      {rooms.length > 0 && (
+        <div className="manage-body">
+          <h2>{t("manage.bots.rooms")}</h2>
+          <div className="manage-inline">
+            {rooms.map((r) => (
+              <button
+                key={r.room_id}
+                type="button"
+                className="button button-secondary"
+                aria-pressed={room === r.room_id}
+                onClick={() => setRoom(room === r.room_id ? null : r.room_id)}
+              >
+                {r.name}
+              </button>
+            ))}
+          </div>
+          {room !== null && (
+            <GroupRoom
+              rpc={rpc}
+              roomId={room}
+              onDisbanded={() => {
+                setRoom(null);
+                setSerial((n) => n + 1);
+              }}
+            />
+          )}
+        </div>
+      )}
+    </section>
+  );
+}
+
+// -- the bundled contribution ----------------------------------------------------------------------
+
+/** What the Bots surface adds to the shell (P24-32's contribution registry takes this shape). */
+export interface BundledContribution {
+  id: string;
+  routes: Array<{ path: string; render: () => ReactNode }>;
+  nav: Array<{ id: string; label: string; path: string }>;
+}
+
+/** The registry the surface registers with: `register` answers the function that unregisters. */
+export interface ContributionHost {
+  register(contribution: BundledContribution): () => void;
+}
+
+export const BOTS_CONTRIBUTION_ID = "indus.bots";
+
+export function botsContribution(render: () => ReactNode, label: string): BundledContribution {
+  return {
+    id: BOTS_CONTRIBUTION_ID,
+    routes: [{ path: "/bots", render }],
+    nav: [{ id: "bots", label, path: "/bots" }],
+  };
+}
+
+/** The surface's on/off switch: on registers it, off unregisters it at once (no reload). */
+export class BotsSurface {
+  private readonly host: ContributionHost;
+  private readonly contribution: BundledContribution;
+  private unregister: (() => void) | null = null;
+
+  constructor(host: ContributionHost, contribution: BundledContribution) {
+    this.host = host;
+    this.contribution = contribution;
+  }
+
+  enabled(): boolean {
+    return this.unregister !== null;
+  }
+
+  setEnabled(on: boolean): void {
+    if (on && this.unregister === null) this.unregister = this.host.register(this.contribution);
+    if (!on && this.unregister !== null) {
+      this.unregister();
+      this.unregister = null;
+    }
+  }
+}
diff --git a/apps/desktop/src/bots/GroupRoom.test.tsx b/apps/desktop/src/bots/GroupRoom.test.tsx
new file mode 100644
index 0000000..98e74fa
--- /dev/null
+++ b/apps/desktop/src/bots/GroupRoom.test.tsx
@@ -0,0 +1,115 @@
+// @vitest-environment jsdom
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import type { RpcLike } from "./canonicalChat.ts";
+import { GroupRoom, lineOf } from "./GroupRoom.tsx";
+
+function room(options: { failFirstSend?: boolean } = {}) {
+  const calls: Array<{ method: string; params: Record<string, unknown> }> = [];
+  let failed = false;
+  const events = [
+    {
+      seq: 1,
+      event_id: "e1",
+      kind: "room.created",
+      actor: { kind: "gateway", id: "g" },
+      payload: {},
+    },
+    {
+      seq: 2,
+      event_id: "e2",
+      kind: "message.member",
+      actor: { kind: "member", id: "coder" },
+      payload: { text: "Plan ready." },
+    },
+  ];
+  const rpc: RpcLike = {
+    request: async (method, params) => {
+      calls.push({ method, params });
+      if (method === "groups.log") {
+        const since = Number(params.since_seq ?? 0);
+        return { events: events.filter((e) => e.seq > since), latest_seq: 2, has_more: false };
+      }
+      if (method === "groups.status") {
+        return {
+          working: false,
+          blocked: true,
+          counts: { indeterminate: 1 },
+          pending_actions: [{ kind: "retry", task_id: "turn-7f3a9c21e0" }],
+        };
+      }
+      if (method === "groups.send" && options.failFirstSend && !failed) {
+        failed = true;
+        throw new Error("the connection dropped");
+      }
+      return {};
+    },
+  };
+  return { rpc, calls };
+}
+
+describe("GroupRoom", () => {
+  it("shows the room as text and offers only the driver's pending actions", async () => {
+    const { rpc, calls } = room();
+    render(<GroupRoom rpc={rpc} roomId="r1" pollMs={60_000} newId={() => "id-1"} />);
+    expect(await screen.findByText("Plan ready.")).toBeTruthy();
+    expect(screen.getByText("room created")).toBeTruthy();
+    fireEvent.click(await screen.findByText("Retry turn turn-7f3"));
+    await waitFor(() => expect(calls.some((c) => c.method === "groups.retry")).toBe(true));
+    expect(calls.find((c) => c.method === "groups.retry")?.params).toEqual({
+      room_id: "r1",
+      task_id: "turn-7f3a9c21e0",
+    });
+    expect(
+      lineOf({
+        seq: 3,
+        event_id: "x",
+        kind: "member.held",
+        actor: {},
+        payload: { member: "coder" },
+      }).text,
+    ).toBe("member held coder");
+  });
+
+  it("a retried send keeps its exact client event id; stop gets a fresh cancel id", async () => {
+    const { rpc, calls } = room({ failFirstSend: true });
+    const ids = ["client-a", "cancel-b", "client-c"];
+    render(<GroupRoom rpc={rpc} roomId="r1" pollMs={60_000} newId={() => ids.shift() as string} />);
+    await screen.findByText("Plan ready.");
+    fireEvent.change(screen.getByLabelText("Message the room"), {
+      target: { value: "Stop @coder please" },
+    });
+    fireEvent.click(screen.getByText("Send"));
+    expect(await screen.findByText("the connection dropped")).toBeTruthy();
+    fireEvent.click(screen.getByText("Send again"));
+    await waitFor(() => expect(calls.filter((c) => c.method === "groups.send")).toHaveLength(2));
+    const sends = calls
+      .filter((c) => c.method === "groups.send")
+      .map((c) => c.params.client_event_id);
+    expect(sends).toEqual(["client-a", "client-a"]);
+    fireEvent.click(screen.getByText("Stop"));
+    await waitFor(() => expect(calls.some((c) => c.method === "groups.stop")).toBe(true));
+    expect(calls.find((c) => c.method === "groups.stop")?.params).toEqual({
+      room_id: "r1",
+      cancel_id: "cancel-b",
+    });
+  });
+
+  it("group discard needs confirmation", async () => {
+    const { rpc, calls } = room();
+    let gone = false;
+    render(<GroupRoom rpc={rpc} roomId="r1" pollMs={60_000} onDisbanded={() => (gone = true)} />);
+    await screen.findByText("Plan ready.");
+    fireEvent.click(screen.getByText("Disband"));
+    expect(calls.some((c) => c.method === "groups.disband")).toBe(false); // nothing sent yet
+    fireEvent.click(screen.getByText("Cancel"));
+    expect(screen.queryByRole("alertdialog")).toBeNull();
+    fireEvent.click(screen.getByText("Disband"));
+    const dialog = screen.getByRole("alertdialog");
+    fireEvent.click(dialog.querySelector("button") as HTMLButtonElement);
+    await waitFor(() => expect(gone).toBe(true));
+    expect(calls.filter((c) => c.method === "groups.disband")).toEqual([
+      { method: "groups.disband", params: { room_id: "r1" } },
+    ]);
+  });
+});
diff --git a/apps/desktop/src/bots/GroupRoom.tsx b/apps/desktop/src/bots/GroupRoom.tsx
new file mode 100644
index 0000000..26a3eb3
--- /dev/null
+++ b/apps/desktop/src/bots/GroupRoom.tsx
@@ -0,0 +1,241 @@
+// A group room, text only (P24-31 over P24-05/06's `groups.*` methods). The log is read with
+// `groups.log` from the last seen sequence number; the person's messages go out with
+// `groups.send` under a client event id that a retry reuses (a lost answer never posts twice);
+// Stop sends `groups.stop` with a fresh cancel id. What the person may do next comes only from the
+// driver's `groups.status` (`pending_actions`: Retry of a deferred or indeterminate turn, sent with
+// exactly that task id). Disband needs an explicit second confirmation.
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { useT } from "../i18n/index.tsx";
+import type { RpcLike } from "./canonicalChat.ts";
+
+export const ROOM_POLL_MS = 2_000;
+
+export interface RoomEvent {
+  seq: number;
+  event_id: string;
+  kind: string;
+  actor: { kind?: string; id?: string };
+  payload: Record<string, unknown>;
+  created_at?: number;
+}
+
+interface LogPage {
+  events: RoomEvent[];
+  latest_seq: number;
+  has_more: boolean;
+}
+
+interface RoomStatus {
+  working: boolean;
+  blocked: boolean;
+  pending_actions: Array<{ kind: string; task_id: string }>;
+}
+
+function newClientId(): string {
+  return `c-${crypto.randomUUID()}`;
+}
+
+/** How one room event reads as a line of text. */
+export function lineOf(event: RoomEvent): { who: string; text: string; system: boolean } {
+  const text = typeof event.payload.text === "string" ? event.payload.text : "";
+  if (event.kind === "message.user") return { who: event.actor.id ?? "you", text, system: false };
+  if (event.kind === "message.member") return { who: event.actor.id ?? "bot", text, system: false };
+  const member = typeof event.payload.member === "string" ? ` ${event.payload.member}` : "";
+  return { who: "", text: `${event.kind.replace(/[._]/g, " ")}${member}`, system: true };
+}
+
+export function GroupRoom(props: {
+  rpc: RpcLike;
+  roomId: string;
+  pollMs?: number;
+  newId?: () => string;
+  onDisbanded?: () => void;
+}) {
+  const t = useT();
+  const { rpc, roomId } = props;
+  const makeId = props.newId ?? newClientId;
+  const [events, setEvents] = useState<RoomEvent[]>([]);
+  const [status, setStatus] = useState<RoomStatus | null>(null);
+  const [draft, setDraft] = useState("");
+  const [pendingSend, setPendingSend] = useState<{ id: string; text: string } | null>(null);
+  const [error, setError] = useState("");
+  const [confirmDisband, setConfirmDisband] = useState(false);
+  const since = useRef(0);
+
+  const refresh = useCallback(async () => {
+    try {
+      for (let pages = 0; pages < 20; pages += 1) {
+        const page = (await rpc.request("groups.log", {
+          room_id: roomId,
+          since_seq: since.current,
+        })) as LogPage;
+        if (page.events.length > 0) {
+          since.current = Math.max(since.current, ...page.events.map((e) => e.seq));
+          setEvents((current) => {
+            const known = new Set(current.map((e) => e.seq));
+            return [...current, ...page.events.filter((e) => !known.has(e.seq))].sort(
+              (a, b) => a.seq - b.seq,
+            );
+          });
+        }
+        if (!page.has_more) break;
+      }
+      setStatus((await rpc.request("groups.status", { room_id: roomId })) as RoomStatus);
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  }, [rpc, roomId, t]);
+
+  useEffect(() => {
+    void refresh();
+    const timer = setInterval(() => void refresh(), props.pollMs ?? ROOM_POLL_MS);
+    return () => clearInterval(timer);
+  }, [refresh, props.pollMs]);
+
+  const send = async (attempt: { id: string; text: string }) => {
+    setPendingSend(attempt);
+    try {
+      await rpc.request("groups.send", {
+        room_id: roomId,
+        client_event_id: attempt.id,
+        text: attempt.text,
+      });
+      setPendingSend(null);
+      setDraft("");
+      setError("");
+      await refresh();
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  const stop = async () => {
+    try {
+      await rpc.request("groups.stop", { room_id: roomId, cancel_id: makeId() });
+      await refresh();
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  const retry = async (taskId: string) => {
+    try {
+      await rpc.request("groups.retry", { room_id: roomId, task_id: taskId });
+      await refresh();
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  const disband = async () => {
+    setConfirmDisband(false);
+    try {
+      await rpc.request("groups.disband", { room_id: roomId });
+      props.onDisbanded?.();
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : t("manage.failed"));
+    }
+  };
+
+  return (
+    <div className="manage-card" data-room={roomId}>
+      <div className="room-log" aria-live="polite">
+        {events.map((event) => {
+          const line = lineOf(event);
+          return (
+            <p key={event.seq} className="room-line" data-kind={line.system ? "system" : "message"}>
+              {line.who !== "" && <strong>{line.who}: </strong>}
+              {line.text}
+            </p>
+          );
+        })}
+        {events.length === 0 && <p className="manage-muted">{t("manage.room.empty")}</p>}
+      </div>
+      {status !== null && (
+        <div className="manage-inline" role="status">
+          {status.working && (
+            <span className="manage-badge" data-tone="ok">
+              {t("manage.room.working")}
+            </span>
+          )}
+          {status.blocked && (
+            <span className="manage-badge" data-tone="warn">
+              {t("manage.room.blocked")}
+            </span>
+          )}
+          {status.pending_actions
+            .filter((action) => action.kind === "retry")
+            .map((action) => (
+              <button
+                key={action.task_id}
+                type="button"
+                className="button button-secondary"
+                onClick={() => void retry(action.task_id)}
+              >
+                {t("manage.room.retry", { task: action.task_id.slice(0, 8) })}
+              </button>
+            ))}
+        </div>
+      )}
+      {error !== "" && (
+        <p className="manage-error" role="alert">
+          {error}
+        </p>
+      )}
+      <form
+        className="manage-inline"
+        onSubmit={(e) => {
+          e.preventDefault();
+          const text = draft.trim();
+          if (text === "") return;
+          void send(
+            pendingSend !== null && pendingSend.text === text
+              ? pendingSend
+              : { id: makeId(), text },
+          );
+        }}
+      >
+        <input
+          aria-label={t("manage.room.message")}
+          value={draft}
+          onChange={(e) => setDraft(e.target.value)}
+        />
+        <button type="submit" className="button button-primary">
+          {pendingSend !== null && pendingSend.text === draft.trim()
+            ? t("manage.room.resend")
+            : t("manage.room.send")}
+        </button>
+        <button type="button" className="button button-secondary" onClick={() => void stop()}>
+          {t("manage.room.stop")}
+        </button>
+        <button
+          type="button"
+          className="button button-secondary"
+          onClick={() => setConfirmDisband(true)}
+        >
+          {t("manage.room.disband")}
+        </button>
+      </form>
+      {confirmDisband && (
+        <div
+          className="manage-banner"
+          role="alertdialog"
+          aria-label={t("manage.room.disbandConfirm")}
+        >
+          <span>{t("manage.room.disbandConfirm")}</span>
+          <button type="button" className="button button-primary" onClick={() => void disband()}>
+            {t("manage.room.disbandYes")}
+          </button>
+          <button
+            type="button"
+            className="button button-secondary"
+            onClick={() => setConfirmDisband(false)}
+          >
+            {t("manage.cancel")}
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/bots/avatar.tsx b/apps/desktop/src/bots/avatar.tsx
new file mode 100644
index 0000000..5f8041e
--- /dev/null
+++ b/apps/desktop/src/bots/avatar.tsx
@@ -0,0 +1,140 @@
+// Bot avatars (P24-31): our own geometric face drawn from a seed (deterministic: the same seed
+// always gives the same face), an uploaded image or portrait (a data URL the daemon checked), or
+// the profile's pet (P24-19 draws it; here a placeholder mark). No artwork from anywhere else.
+
+import type { ReactNode } from "react";
+
+export type Avatar =
+  | { kind: "face"; seed: string }
+  | { kind: "upload" | "portrait"; data: string }
+  | { kind: "pet" };
+
+export const MAX_AVATAR_BYTES = 256 * 1024;
+export const AVATAR_TYPES = ["image/png", "image/jpeg", "image/webp"] as const;
+
+/** 32 pseudo-random bytes from a seed (FNV-1a, re-mixed per byte). */
+export function seedBytes(seed: string): number[] {
+  const out: number[] = [];
+  let h = 2166136261;
+  for (let i = 0; i < seed.length; i += 1) {
+    h ^= seed.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  for (let i = 0; i < 32; i += 1) {
+    h ^= i + 0x9e;
+    h = Math.imul(h, 16777619) >>> 0;
+    out.push(h & 0xff);
+  }
+  return out;
+}
+
+export interface FaceParts {
+  hue: number;
+  shape: "circle" | "square" | "hexagon";
+  eyes: "dots" | "lines" | "rings";
+  mouth: "smile" | "flat" | "open";
+  eyeGap: number;
+}
+
+export function faceParts(seed: string): FaceParts {
+  const b = seedBytes(seed);
+  return {
+    hue: Math.round(((b[0] as number) / 255) * 359),
+    shape: (["circle", "square", "hexagon"] as const)[(b[1] as number) % 3] as FaceParts["shape"],
+    eyes: (["dots", "lines", "rings"] as const)[(b[2] as number) % 3] as FaceParts["eyes"],
+    mouth: (["smile", "flat", "open"] as const)[(b[3] as number) % 3] as FaceParts["mouth"],
+    eyeGap: 8 + ((b[4] as number) % 5),
+  };
+}
+
+export function BotFace(props: { seed: string; size?: number; label?: string }) {
+  const parts = faceParts(props.seed);
+  const size = props.size ?? 40;
+  const fill = `hsl(${parts.hue} 55% 55%)`;
+  const ink = `hsl(${parts.hue} 40% 18%)`;
+  let body: ReactNode;
+  if (parts.shape === "circle") body = <circle cx="24" cy="24" r="22" fill={fill} />;
+  else if (parts.shape === "square")
+    body = <rect x="3" y="3" width="42" height="42" rx="10" fill={fill} />;
+  else body = <polygon points="24,2 44,13 44,35 24,46 4,35 4,13" fill={fill} />;
+  const left = 24 - parts.eyeGap;
+  const right = 24 + parts.eyeGap;
+  const eye = (x: number) =>
+    parts.eyes === "dots" ? (
+      <circle key={x} cx={x} cy="20" r="2.6" fill={ink} />
+    ) : parts.eyes === "lines" ? (
+      <line
+        key={x}
+        x1={x - 3}
+        y1="20"
+        x2={x + 3}
+        y2="20"
+        stroke={ink}
+        strokeWidth="2.4"
+        strokeLinecap="round"
+      />
+    ) : (
+      <circle key={x} cx={x} cy="20" r="3" fill="none" stroke={ink} strokeWidth="1.8" />
+    );
+  const mouth =
+    parts.mouth === "smile" ? (
+      <path
+        d="M16 30 Q24 37 32 30"
+        fill="none"
+        stroke={ink}
+        strokeWidth="2.4"
+        strokeLinecap="round"
+      />
+    ) : parts.mouth === "flat" ? (
+      <line x1="17" y1="32" x2="31" y2="32" stroke={ink} strokeWidth="2.4" strokeLinecap="round" />
+    ) : (
+      <ellipse cx="24" cy="32" rx="5" ry="3.4" fill={ink} />
+    );
+  return (
+    <svg
+      className="bots-avatar"
+      viewBox="0 0 48 48"
+      width={size}
+      height={size}
+      role="img"
+      aria-label={props.label ?? "bot"}
+      data-face={`${parts.shape}-${parts.eyes}-${parts.mouth}`}
+    >
+      {body}
+      {eye(left)}
+      {eye(right)}
+      {mouth}
+    </svg>
+  );
+}
+
+export function AvatarView(props: { avatar: Avatar; fallbackSeed: string; label: string }) {
+  const { avatar } = props;
+  if (avatar.kind === "upload" || avatar.kind === "portrait") {
+    return <img className="bots-avatar" src={avatar.data} alt={props.label} />;
+  }
+  if (avatar.kind === "pet") {
+    return (
+      <span className="bots-avatar" role="img" aria-label={props.label} data-avatar="pet">
+        <BotFace seed={`pet:${props.fallbackSeed}`} label={props.label} />
+      </span>
+    );
+  }
+  const seed = avatar.kind === "face" ? avatar.seed : "";
+  return <BotFace seed={seed || props.fallbackSeed} label={props.label} />;
+}
+
+/** Read an image file into a data URL the daemon will accept, or say why not. */
+export function readAvatarFile(file: Blob & { type: string }): Promise<string> {
+  if (!(AVATAR_TYPES as readonly string[]).includes(file.type)) {
+    return Promise.reject(new Error("use a PNG, JPEG or WebP image"));
+  }
+  if (file.size > MAX_AVATAR_BYTES)
+    return Promise.reject(new Error("the image is larger than 256 KiB"));
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onerror = () => reject(new Error("the image could not be read"));
+    reader.onload = () => resolve(String(reader.result));
+    reader.readAsDataURL(file);
+  });
+}
diff --git a/apps/desktop/src/bots/canonicalChat.test.ts b/apps/desktop/src/bots/canonicalChat.test.ts
new file mode 100644
index 0000000..eb6ca33
--- /dev/null
+++ b/apps/desktop/src/bots/canonicalChat.test.ts
@@ -0,0 +1,97 @@
+import { describe, expect, it } from "vitest";
+import { FakeContributionRegistry } from "../test/_stubs_u2.ts";
+import { BotsSurface, botsContribution } from "./BotsPage.tsx";
+import { CANONICAL_TITLE, CanonicalChats, type RpcLike } from "./canonicalChat.ts";
+
+/** A daemon with one bot whose forever-chat may get compressed. */
+function daemon() {
+  let tip: string | null = null;
+  let mints = 0;
+  const calls: string[] = [];
+  let release: (() => void) | null = null;
+  const rpc: RpcLike = {
+    request: async (method, params) => {
+      calls.push(`${method} ${JSON.stringify(params)}`);
+      if (method !== "bots.open") throw new Error("unexpected");
+      if (release === null) await new Promise<void>((resolve) => setTimeout(resolve, 5));
+      if (tip === null) {
+        mints += 1;
+        tip = "chat-root";
+        return { session_id: tip, created: true };
+      }
+      return { session_id: tip, created: false };
+    },
+  };
+  return {
+    rpc,
+    calls,
+    mints: () => mints,
+    compress: () => {
+      tip = "chat-tip-2";
+    },
+    hold: (fn: () => void) => {
+      release = fn;
+    },
+  };
+}
+
+describe("canonical bot chat", () => {
+  it("two concurrent clicks create one chat", async () => {
+    const d = daemon();
+    const chats = new CanonicalChats(d.rpc);
+    const [a, b] = await Promise.all([chats.open("coder"), chats.open("coder")]);
+    expect(a).toBe("chat-root");
+    expect(b).toBe(a);
+    expect(d.calls).toEqual(['bots.open {"profile":"coder"}']); // one request in flight
+    expect(d.mints()).toBe(1);
+    expect(await chats.open("coder")).toBe("chat-root"); // a later open asks again: no pointer
+    expect(d.calls).toHaveLength(2);
+  });
+
+  it("canonical lookup after compression opens the live tip", async () => {
+    const d = daemon();
+    const chats = new CanonicalChats(d.rpc);
+    chats.remember("coder", { session_id: "chat-root" }); // what the list said earlier
+    await chats.open("coder");
+    d.compress();
+    expect(await chats.open("coder")).toBe("chat-tip-2");
+    expect(chats.isCanonical("chat-root")).toBe(true);
+    expect(chats.isCanonical("chat-tip-2")).toBe(true);
+    expect(chats.ownerOf("chat-tip-2")).toBe("coder");
+    expect(chats.isCanonical("side-chat")).toBe(false);
+  });
+
+  it("the canonical chat is absent from the sessions list; side-chats stay", () => {
+    const chats = new CanonicalChats(daemon().rpc);
+    chats.remember("coder", { session_id: "chat-tip-2" });
+    const rows = [
+      { id: "chat-tip-2", title: CANONICAL_TITLE, source: "bots" },
+      { id: "x", lineage_root: "chat-tip-2", title: "segment" },
+      { id: "other-bot", title: CANONICAL_TITLE, source: "bots" }, // never listed to us, still hidden
+      { id: "side-chat", title: "Ask coder about the build", source: "bots" },
+      { id: "plain", title: CANONICAL_TITLE, source: "cli" }, // a person's own chat titled the same
+    ];
+    expect(chats.withoutCanonical(rows).map((r) => r.id)).toEqual(["side-chat", "plain"]);
+  });
+
+  it("the surface's disable switch unregisters it live", () => {
+    const registry = new FakeContributionRegistry();
+    let changes = 0;
+    registry.subscribe(() => {
+      changes += 1;
+    });
+    const surface = new BotsSurface(
+      registry,
+      botsContribution(() => null, "Bots"),
+    );
+    surface.setEnabled(true);
+    expect(registry.navIds()).toEqual(["bots"]);
+    expect(registry.routePaths()).toEqual(["/bots"]);
+    surface.setEnabled(true); // idempotent
+    surface.setEnabled(false);
+    expect(registry.navIds()).toEqual([]);
+    expect(registry.routePaths()).toEqual([]);
+    expect(surface.enabled()).toBe(false);
+    expect(changes).toBe(2);
+  });
+});
diff --git a/apps/desktop/src/bots/canonicalChat.ts b/apps/desktop/src/bots/canonicalChat.ts
new file mode 100644
index 0000000..a169c32
--- /dev/null
+++ b/apps/desktop/src/bots/canonicalChat.ts
@@ -0,0 +1,85 @@
+// A bot's forever-chat in the renderer (P24-31). Identity is the daemon's: (profile, canonical
+// title), resolved by `bots.open` (hidden rows included, compression followed to the live tip,
+// adopt before mint — `service/bots_rpc.py`). The renderer never stores a session-id pointer: it
+// asks every time, keeps one in-flight open per bot (a double click makes one request, so one
+// chat), and remembers the ids it was told only to recognise a canonical chat on screen and to keep
+// canonical chats out of the sessions list. Side-chats of a bot are ordinary sessions and stay.
+
+export const CANONICAL_TITLE = "Bot chat";
+export const BOTS_SOURCE = "bots";
+
+/** The daemon methods the Bots surface calls (`bots.*`, `groups.*`). */
+export interface RpcLike {
+  request(method: string, params: Record<string, unknown>): Promise<unknown>;
+}
+
+export interface CanonicalRow {
+  readonly session_id: string;
+}
+
+export interface SessionRowLike {
+  readonly id: string;
+  readonly title?: string | null;
+  readonly source?: string | null;
+  readonly lineage_root?: string | null;
+  readonly durableId?: string;
+}
+
+export class CanonicalChats {
+  private readonly rpc: RpcLike;
+  private readonly inflight = new Map<string, Promise<string>>();
+  private readonly seen = new Map<string, Set<string>>();
+
+  constructor(rpc: RpcLike) {
+    this.rpc = rpc;
+  }
+
+  /** Remember what `bots.list` / `profiles.list` reported for a bot. */
+  remember(profile: string, canonical: CanonicalRow | null): void {
+    if (canonical === null) return;
+    const ids = this.seen.get(profile) ?? new Set<string>();
+    ids.add(canonical.session_id);
+    this.seen.set(profile, ids);
+  }
+
+  /** The live tip of the bot's forever-chat, created by the daemon only when none exists. */
+  open(profile: string): Promise<string> {
+    const running = this.inflight.get(profile);
+    if (running !== undefined) return running;
+    const run = (async () => {
+      const answer = (await this.rpc.request("bots.open", { profile })) as { session_id?: unknown };
+      if (typeof answer?.session_id !== "string" || answer.session_id === "") {
+        throw new Error("the daemon did not name the bot's chat");
+      }
+      this.remember(profile, { session_id: answer.session_id });
+      return answer.session_id;
+    })();
+    this.inflight.set(profile, run);
+    const clear = () => {
+      if (this.inflight.get(profile) === run) this.inflight.delete(profile);
+    };
+    run.then(clear, clear);
+    return run;
+  }
+
+  /** Is `sessionId` (any segment we were told of) some bot's forever-chat? */
+  isCanonical(sessionId: string): boolean {
+    for (const ids of this.seen.values()) if (ids.has(sessionId)) return true;
+    return false;
+  }
+
+  /** The owner of a canonical chat id, or null. */
+  ownerOf(sessionId: string): string | null {
+    for (const [profile, ids] of this.seen) if (ids.has(sessionId)) return profile;
+    return null;
+  }
+
+  /** `rows` without canonical chats (known ids, or the canonical title on a bots row). */
+  withoutCanonical<R extends SessionRowLike>(rows: readonly R[]): R[] {
+    return rows.filter((row) => {
+      const ids = [row.id, row.lineage_root ?? "", row.durableId ?? ""];
+      if (ids.some((id) => id !== "" && this.isCanonical(id))) return false;
+      return !(row.title === CANONICAL_TITLE && row.source === BOTS_SOURCE);
+    });
+  }
+}
diff --git a/apps/desktop/src/global.d.ts b/apps/desktop/src/global.d.ts
index 0bc546a..c169199 100644
--- a/apps/desktop/src/global.d.ts
+++ b/apps/desktop/src/global.d.ts
@@ -255,6 +255,166 @@ export interface IndusDesktopConnection {
   forgetRemote(payload?: Record<string, never>): Promise<{ ok: true }>;
 }
 
+export interface IndusDesktopConnections {
+  /** `indus:connections:list` (P24-29) */
+  list(payload?: Record<string, never>): Promise<{
+    connections: Array<{
+      id: string;
+      kind: "local" | "remote" | "ssh";
