--- /dev/null
+++ b/apps/desktop/src/app/cron/CronOverlay.tsx
@@ -0,0 +1,327 @@
+// Scheduled jobs (P24-27): the P14 cron jobs of this profile, or of every profile at once
+// ("All profiles": one `GET /api/cron/jobs` per profile, each row tagged with its owner). Every
+// action — pause, resume, run now, edit, delete — goes to the profile that owns the job, never to
+// the window's own. New jobs start blank or from a blueprint (a skill that suggests a schedule).
+// The last run's time, status and (redacted) error are the run history the REST view carries.
+
+import { useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestAnswer, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { LoadState, ManageOverlay, useApi, useRestValue, when } from "../manage/common.tsx";
+
+export interface CronJob {
+  id: string;
+  name: string;
+  prompt: string;
+  schedule: string;
+  schedule_display: string;
+  deliver: string;
+  skills: string[];
+  state: string;
+  enabled: boolean;
+  paused_reason: string | null;
+  last_run_at: string | null;
+  next_run_at: string | null;
+  last_status: string | null;
+  last_error: string | null;
+}
+
+export interface OwnedJob extends CronJob {
+  /** The profile that owns the job (actions go there). */
+  profile: string;
+}
+
+export interface Blueprint {
+  skill: string;
+  description: string;
+  schedule: string | null;
+  prompt: string | null;
+}
+
+interface ProfilesAnswer {
+  profiles: Array<{ name: string }>;
+}
+
+/** The jobs of `profiles` (each tagged); profiles that fail are named, the rest still listed. */
+export async function loadJobs(
+  api: RestLike | null,
+  profiles: readonly string[],
+): Promise<RestAnswer<{ jobs: OwnedJob[]; failed: string[] }>> {
+  const answers = await Promise.all(
+    profiles.map((profile) => rest<{ jobs: CronJob[] }>(api, "GET", "/api/cron/jobs", { profile })),
+  );
+  const jobs: OwnedJob[] = [];
+  const failed: string[] = [];
+  answers.forEach((answer, index) => {
+    const profile = profiles[index] as string;
+    if (answer.ok) for (const job of answer.data.jobs) jobs.push({ ...job, profile });
+    else failed.push(profile);
+  });
+  if (failed.length === profiles.length && answers[0] !== undefined && !answers[0].ok) {
+    return answers[0] as RestAnswer<never>;
+  }
+  return { ok: true, status: 200, data: { jobs, failed } };
+}
+
+/** Send `action` for `job` to its owning profile. */
+export function jobAction(
+  api: RestLike | null,
+  job: OwnedJob,
+  action: "pause" | "resume" | "trigger" | "delete",
+): Promise<RestAnswer<unknown>> {
+  const base = `/api/cron/jobs/${encodeURIComponent(job.id)}`;
+  if (action === "delete") return rest(api, "DELETE", base, { profile: job.profile });
+  return rest(api, "POST", `${base}/${action}`, { profile: job.profile });
+}
+
+function JobForm(props: {
+  api: RestLike | null;
+  profile: string;
+  job?: OwnedJob;
+  blueprints: Blueprint[];
+  onDone: () => void;
+  onCancel: () => void;
+}) {
+  const t = useT();
+  const [name, setName] = useState(props.job?.name ?? "");
+  const [prompt, setPrompt] = useState(props.job?.prompt ?? "");
+  const [schedule, setSchedule] = useState(props.job?.schedule ?? "");
+  const [deliver, setDeliver] = useState(props.job?.deliver ?? "");
+  const [skills, setSkills] = useState<string[]>(props.job?.skills ?? []);
+  const [error, setError] = useState("");
+  const submit = async () => {
+    const body = {
+      name: name.trim() || undefined,
+      prompt,
+      schedule,
+      ...(deliver.trim() === "" ? {} : { deliver: deliver.trim() }),
+      ...(skills.length > 0 ? { skills } : {}),
+    };
+    const answer =
+      props.job === undefined
+        ? await rest(props.api, "POST", "/api/cron/jobs", { profile: props.profile, body })
+        : await rest(props.api, "PUT", `/api/cron/jobs/${encodeURIComponent(props.job.id)}`, {
+            profile: props.job.profile,
+            body,
+          });
+    if (!answer.ok) {
+      setError(answer.message);
+      return;
+    }
+    props.onDone();
+  };
+  return (
+    <form
+      className="manage-card"
+      onSubmit={(e) => {
+        e.preventDefault();
+        void submit();
+      }}
+    >
+      <h3>{props.job === undefined ? t("manage.cron.new") : t("manage.cron.edit")}</h3>
+      {props.job === undefined && props.blueprints.length > 0 && (
+        <label className="manage-field">
+          {t("manage.cron.blueprint")}
+          <select
+            defaultValue=""
+            onChange={(e) => {
+              const plan = props.blueprints.find((b) => b.skill === e.target.value);
+              if (plan === undefined) return;
+              setName(plan.skill);
+              setPrompt(plan.prompt ?? plan.description);
+              setSchedule(plan.schedule ?? "");
+              setSkills([plan.skill]);
+            }}
+          >
+            <option value="">{t("manage.cron.blank")}</option>
+            {props.blueprints.map((plan) => (
+              <option key={plan.skill} value={plan.skill}>
+                {plan.skill}
+              </option>
+            ))}
+          </select>
+        </label>
+      )}
+      <label className="manage-field">
+        {t("manage.cron.name")}
+        <input value={name} onChange={(e) => setName(e.target.value)} />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.prompt")}
+        <textarea value={prompt} onChange={(e) => setPrompt(e.target.value)} rows={3} required />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.schedule")}
+        <input
+          value={schedule}
+          onChange={(e) => setSchedule(e.target.value)}
+          placeholder="every 2h"
+          required
+        />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.deliver")}
+        <input value={deliver} onChange={(e) => setDeliver(e.target.value)} placeholder="local" />
+      </label>
+      {error !== "" && (
+        <p className="manage-error" role="alert">
+          {error}
+        </p>
+      )}
+      <div className="manage-inline">
+        <button type="submit" className="button button-primary">
+          {t("manage.save")}
+        </button>
+        <button type="button" className="button button-secondary" onClick={props.onCancel}>
+          {t("manage.cancel")}
+        </button>
+      </div>
+    </form>
+  );
+}
+
+export function CronOverlay(props: {
+  api?: RestLike | null;
+  profile: string | null;
+  onClose: () => void;
+}) {
+  const t = useT();
+  const api = useApi(props.api);
+  const own = props.profile ?? "default";
+  const [all, setAll] = useState(false);
+  const [editing, setEditing] = useState<OwnedJob | "new" | null>(null);
+  const [note, setNote] = useState("");
+  const profiles = useRestValue<ProfilesAnswer>(() => rest(api, "GET", "/api/profiles"), [api]);
+  const names = all && profiles.state === "ok" ? profiles.data.profiles.map((p) => p.name) : [own];
+  const jobs = useRestValue(() => loadJobs(api, names), [api, names.join("\n")]);
+  const blueprints = useRestValue<{ blueprints: Blueprint[] }>(
+    () => rest(api, "GET", "/api/cron/blueprints", { profile: own }),
+    [api, own],
+  );
+
+  const act = async (job: OwnedJob, action: "pause" | "resume" | "trigger" | "delete") => {
+    const answer = await jobAction(api, job, action);
+    setNote(answer.ok ? "" : answer.message);
+    jobs.reload();
+  };
+
+  return (
+    <ManageOverlay title={t("nav.cron")} onClose={props.onClose}>
+      <div className="manage-inline">
+        <label className="manage-inline">
+          <input type="checkbox" checked={all} onChange={(e) => setAll(e.target.checked)} />
+          {t("manage.cron.allProfiles")}
+        </label>
+        <button type="button" className="button button-primary" onClick={() => setEditing("new")}>
+          {t("manage.cron.new")}
+        </button>
+      </div>
+      {note !== "" && (
+        <p className="manage-error" role="alert">
+          {note}
+        </p>
+      )}
+      {editing !== null && (
+        <JobForm
+          api={api}
+          profile={own}
+          {...(editing === "new" ? {} : { job: editing })}
+          blueprints={blueprints.state === "ok" ? blueprints.data.blueprints : []}
+          onDone={() => {
+            setEditing(null);
+            jobs.reload();
+          }}
+          onCancel={() => setEditing(null)}
+        />
+      )}
+      <LoadState value={jobs}>
+        {(data) => (
+          <>
+            {data.failed.length > 0 && (
+              <p className="manage-muted">
+                {t("manage.cron.someFailed", { names: data.failed.join(", ") })}
+              </p>
+            )}
+            <table className="manage-table">
+              <thead>
+                <tr>
+                  <th>{t("manage.cron.name")}</th>
+                  {all && <th>{t("manage.cron.profile")}</th>}
+                  <th>{t("manage.cron.schedule")}</th>
+                  <th>{t("manage.cron.lastRun")}</th>
+                  <th>{t("manage.cron.next")}</th>
+                  <th />
+                </tr>
+              </thead>
+              <tbody>
+                {data.jobs.map((job) => (
+                  <tr key={`${job.profile}/${job.id}`} data-job={job.id}>
+                    <td>
+                      <strong>{job.name || job.id}</strong>
+                      <div className="manage-muted">{job.state}</div>
+                    </td>
+                    {all && <td>{job.profile}</td>}
+                    <td>{job.schedule_display}</td>
+                    <td>
+                      {when(job.last_run_at)}
+                      {job.last_status !== null && (
+                        <div className="manage-muted">{job.last_status}</div>
+                      )}
+                      {job.last_error !== null && (
+                        <div className="manage-error">{job.last_error}</div>
+                      )}
+                    </td>
+                    <td>{when(job.next_run_at)}</td>
+                    <td>
+                      <span className="manage-inline">
+                        {job.state === "paused" || !job.enabled ? (
+                          <button
+                            type="button"
+                            className="button button-secondary"
+                            onClick={() => void act(job, "resume")}
+                          >
+                            {t("manage.cron.resume")}
+                          </button>
+                        ) : (
+                          <button
+                            type="button"
+                            className="button button-secondary"
+                            onClick={() => void act(job, "pause")}
+                          >
+                            {t("manage.cron.pause")}
+                          </button>
+                        )}
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void act(job, "trigger")}
+                        >
+                          {t("manage.cron.runNow")}
+                        </button>
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => setEditing(job)}
+                        >
+                          {t("manage.cron.edit")}
+                        </button>
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void act(job, "delete")}
+                        >
+                          {t("manage.delete")}
+                        </button>
+                      </span>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+            {data.jobs.length === 0 && <p className="manage-muted">{t("manage.cron.none")}</p>}
+          </>
+        )}
+      </LoadState>
+    </ManageOverlay>
+  );
+}
diff --git a/apps/desktop/src/app/learning-map/LearningMap.tsx b/apps/desktop/src/app/learning-map/LearningMap.tsx
new file mode 100644
index 0000000..90cd0fe
--- /dev/null
+++ b/apps/desktop/src/app/learning-map/LearningMap.tsx
@@ -0,0 +1,281 @@
+// The learning map (P24-28): skills and memories as a force-directed graph (`layout.ts`), with a
+// playback slider over time, filters all / used / learned, node edit (a skill's on/off switch) and
+// delete (a memory), and Share, which copies a code holding the layout only.
+//
+// Data: `GET /api/learning/graph` (`{nodes, edges}`; memories with timestamps and the skill they
+// were learned with) when the server has it; otherwise the skills list alone (`GET /api/skills`,
+// linked by category, no times — playback then has nothing to replay).
+
+import { useMemo, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestAnswer, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { copyText } from "../clipboard.ts";
+import { LoadState, PageFrame, useApi, useRestValue } from "../manage/common.tsx";
+import {
+  graphFromSkills,
+  type LearningGraph,
+  type LearningNode,
+  layout,
+  type MapFilter,
+  readShareCode,
+  ShareCodeError,
+  shareCode,
+  timeRange,
+  visible,
+} from "./layout.ts";
+
+const BOX = { width: 900, height: 560 };
+
+/** Stable keys for shared points (they carry no ids): kind and position, numbered on a clash. */
+function keyed<T extends { kind: string; x: number; y: number }>(
+  items: readonly T[],
+): Array<{ key: string; node: T }> {
+  const seen = new Map<string, number>();
+  return items.map((node) => {
+    const base = `${node.kind}:${node.x}:${node.y}`;
+    const count = (seen.get(base) ?? 0) + 1;
+    seen.set(base, count);
+    return { key: `${base}:${count}`, node };
+  });
+}
+
+/** The graph, from the learning read when the server has one, else from the skills list. */
+export async function loadGraph(
+  api: RestLike | null,
+  profile: string | null,
+): Promise<RestAnswer<{ graph: LearningGraph; full: boolean }>> {
+  const full = await rest<LearningGraph>(api, "GET", "/api/learning/graph", { profile });
+  if (full.ok && Array.isArray(full.data.nodes))
+    return { ...full, data: { graph: full.data, full: true } };
+  const skills = await rest<{
+    skills: Array<{ name: string; category: string; enabled: boolean; source?: string }>;
+  }>(api, "GET", "/api/skills", { profile });
+  if (!skills.ok) return skills;
+  return { ...skills, data: { graph: graphFromSkills(skills.data.skills), full: false } };
+}
+
+function MapView(props: {
+  api: RestLike | null;
+  profile: string | null;
+  graph: LearningGraph;
+  full: boolean;
+  reload: () => void;
+}) {
+  const t = useT();
+  const [filter, setFilter] = useState<MapFilter>("all");
+  const range = timeRange(props.graph);
+  const [until, setUntil] = useState<number | null>(null);
+  const [selected, setSelected] = useState<LearningNode | null>(null);
+  const [note, setNote] = useState("");
+  const shown = useMemo(() => visible(props.graph, filter, until), [props.graph, filter, until]);
+  const placed = useMemo(() => layout(props.graph, BOX), [props.graph]);
+  const [importText, setImportText] = useState("");
+
+  const toggleSkill = async (node: LearningNode) => {
+    const answer = await rest(props.api, "POST", "/api/skills/toggle", {
+      profile: props.profile,
+      body: { name: node.label, enabled: !node.enabled },
+    });
+    setNote(answer.ok ? "" : answer.message);
+    props.reload();
+  };
+  const deleteMemory = async (node: LearningNode) => {
+    const answer = await rest(
+      props.api,
+      "DELETE",
+      `/api/learning/nodes/${encodeURIComponent(node.id)}`,
+      {
+        profile: props.profile,
+      },
+    );
+    setNote(answer.ok ? "" : answer.message);
+    setSelected(null);
+    props.reload();
+  };
+  const share = async () => {
+    const code = shareCode(shown, placed, BOX);
+    const copied = await copyText(code);
+    setNote(copied ? t("manage.map.copied") : code);
+  };
+  let imported: ReturnType<typeof readShareCode> | null = null;
+  let importError = "";
+  if (importText.trim() !== "") {
+    try {
+      imported = readShareCode(importText);
+    } catch (error) {
+      importError = error instanceof ShareCodeError ? error.message : t("manage.failed");
+    }
+  }
+
+  return (
+    <div className="manage-body">
+      <div className="manage-inline">
+        {(["all", "used", "learned"] as const).map((f) => (
+          <button
+            key={f}
+            type="button"
+            className="button button-secondary"
+            aria-pressed={filter === f}
+            onClick={() => setFilter(f)}
+          >
+            {t(`manage.map.filter.${f}`)}
+          </button>
+        ))}
+        <button type="button" className="button button-secondary" onClick={() => void share()}>
+          {t("manage.map.share")}
+        </button>
+      </div>
+      {range !== null && (
+        <label className="manage-field">
+          {t("manage.map.playback")}
+          <input
+            type="range"
+            min={range.from}
+            max={range.to}
+            value={until ?? range.to}
+            onChange={(e) => setUntil(Number(e.target.value))}
+          />
+        </label>
+      )}
+      {!props.full && <p className="manage-muted">{t("manage.map.skillsOnly")}</p>}
+      <svg
+        className="manage-map"
+        viewBox={`0 0 ${BOX.width} ${BOX.height}`}
+        role="img"
+        aria-label={t("nav.learning-map")}
+      >
+        {shown.edges.map((edge) => {
+          const a = placed.get(edge.from);
+          const b = placed.get(edge.to);
+          if (a === undefined || b === undefined) return null;
+          return (
+            <line
+              key={`${edge.from}->${edge.to}`}
+              x1={a.x}
+              y1={a.y}
+              x2={b.x}
+              y2={b.y}
+              stroke="var(--color-line)"
+            />
+          );
+        })}
+        {shown.nodes.map((node) => {
+          const at = placed.get(node.id);
+          if (at === undefined) return null;
+          return (
+            // biome-ignore lint/a11y/useSemanticElements: SVG has no <button>; the group takes its role
+            <g
+              key={node.id}
+              data-node={node.id}
+              role="button"
+              tabIndex={0}
+              aria-label={node.label}
+              onClick={() => setSelected(node)}
+              onKeyDown={(e) => {
+                if (e.key === "Enter" || e.key === " ") setSelected(node);
+              }}
+              style={{ cursor: "pointer" }}
+            >
+              <circle
+                cx={at.x}
+                cy={at.y}
+                r={at.r}
+                fill={node.kind === "skill" ? "var(--color-accent)" : "var(--color-ok)"}
+                opacity={node.enabled ? 0.9 : 0.35}
+              />
+              <title>{node.label}</title>
+            </g>
+          );
+        })}
+      </svg>
+      <p className="manage-muted" data-testid="map-count">
+        {t("manage.map.count", { count: shown.nodes.length })}
+      </p>
+      {selected !== null && (
+        <div className="manage-card" role="dialog" aria-label={selected.label}>
+          <h3>{selected.label}</h3>
+          <p className="manage-muted">{selected.category}</p>
+          {selected.kind === "skill" ? (
+            <button
+              type="button"
+              className="button button-secondary"
+              onClick={() => void toggleSkill(selected)}
+            >
+              {selected.enabled ? t("manage.map.disable") : t("manage.map.enable")}
+            </button>
+          ) : (
+            props.full && (
+              <button
+                type="button"
+                className="button button-secondary"
+                onClick={() => void deleteMemory(selected)}
+              >
+                {t("manage.delete")}
+              </button>
+            )
+          )}
+          <button
+            type="button"
+            className="button button-secondary"
+            onClick={() => setSelected(null)}
+          >
+            {t("common.close")}
+          </button>
+        </div>
+      )}
+      {note !== "" && (
+        <p className="manage-muted manage-code" role="status">
+          {note}
+        </p>
+      )}
+      <label className="manage-field">
+        {t("manage.map.import")}
+        <textarea rows={2} value={importText} onChange={(e) => setImportText(e.target.value)} />
+      </label>
+      {importError !== "" && <p className="manage-error">{importError}</p>}
+      {imported !== null && (
+        <svg
+          className="manage-map"
+          viewBox="0 0 1 1"
+          role="img"
+          aria-label={t("manage.map.importedMap")}
+        >
+          {keyed(imported.nodes).map(({ key, node: n }) => (
+            <circle
+              key={key}
+              cx={n.x}
+              cy={n.y}
+              r={0.008}
+              fill={n.kind === "skill" ? "var(--color-accent)" : "var(--color-ok)"}
+            />
+          ))}
+        </svg>
+      )}
+    </div>
+  );
+}
+
+export function LearningMap(props: { api?: RestLike | null; profile: string | null }) {
+  const t = useT();
+  const api = useApi(props.api);
+  const graph = useRestValue(() => loadGraph(api, props.profile), [api, props.profile]);
+  return (
+    <PageFrame title={t("nav.learning-map")} id="learning-map">
+      <LoadState value={graph}>
+        {(data) =>
+          data.graph.nodes.length === 0 ? (
+            <p className="manage-muted">{t("manage.map.empty")}</p>
+          ) : (
+            <MapView
+              api={api}
+              profile={props.profile}
+              graph={data.graph}
+              full={data.full}
+              reload={graph.reload}
+            />
+          )
+        }
+      </LoadState>
+    </PageFrame>
+  );
+}
diff --git a/apps/desktop/src/app/learning-map/layout.test.ts b/apps/desktop/src/app/learning-map/layout.test.ts
new file mode 100644
index 0000000..79b86b3
--- /dev/null
+++ b/apps/desktop/src/app/learning-map/layout.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from "vitest";
+import {
+  graphFromSkills,
+  type LearningGraph,
+  type LearningNode,
+  layout,
+  readShareCode,
+  SHARE_PREFIX,
+  ShareCodeError,
+  shareCode,
+  timeRange,
+  visible,
+} from "./layout.ts";
+
+function node(id: string, extra: Partial<LearningNode> = {}): LearningNode {
+  return {
+    id,
+    kind: "skill",
+    label: `Label of ${id}`,
+    category: "research",
+    useCount: 0,
+    createdBy: null,
+    timestamp: null,
+    enabled: true,
+    ...extra,
+  };
+}
+
+const GRAPH: LearningGraph = {
+  nodes: [
+    node("s1", { label: "pdf-summariser", useCount: 9, timestamp: 100 }),
+    node("s2", { label: "git-bisect-helper", createdBy: "agent", timestamp: 200 }),
+    node("m1", {
+      kind: "memory",
+      label: "The user's dog is called Pixel",
+      createdBy: "agent",
+      timestamp: 300,
+      useCount: 2,
+    }),
+    node("m2", { kind: "memory", label: "Prefers tabs over spaces", timestamp: 400 }),
+  ],
+  edges: [
+    { from: "m1", to: "s1" },
+    { from: "s1", to: "s2" },
+    { from: "m2", to: "ghost" },
+  ],
+};
+const BOX = { width: 900, height: 560 };
+
+describe("learning map layout", () => {
+  it("is deterministic and stays inside the box", () => {
+    const one = layout(GRAPH, BOX);
+    const two = layout(GRAPH, BOX);
+    expect([...one.entries()]).toEqual([...two.entries()]);
+    for (const at of one.values()) {
+      expect(at.x).toBeGreaterThanOrEqual(10);
+      expect(at.x).toBeLessThanOrEqual(BOX.width - 10);
+      expect(at.y).toBeGreaterThanOrEqual(10);
+      expect(at.y).toBeLessThanOrEqual(BOX.height - 10);
+    }
+    expect((one.get("s1")?.r ?? 0) > (one.get("s2")?.r ?? 0)).toBe(true); // used more, drawn bigger
+  });
+
+  it("the layout share string contains no node text", () => {
+    const placed = layout(GRAPH, BOX);
+    const code = shareCode(GRAPH, placed, BOX);
+    expect(code.startsWith(SHARE_PREFIX)).toBe(true);
+    const decoded = atob(code.slice(SHARE_PREFIX.length).replace(/-/g, "+").replace(/_/g, "/"));
+    for (const n of GRAPH.nodes) {
+      for (const text of [n.id, n.label, n.category, "Pixel", "tabs"]) {
+        expect(decoded).not.toContain(text); // short ids may match base64 by chance, so the text
+        if (text.length >= 6) expect(code).not.toContain(text); // check is on the decoded body
+      }
+    }
+    expect(Object.keys(JSON.parse(decoded)).sort()).toEqual(["e", "k", "p", "v"]);
+  });
+
+  it("a share code round-trips the shape: kinds, positions and edges", () => {
+    const placed = layout(GRAPH, BOX);
+    const shared = readShareCode(shareCode(GRAPH, placed, BOX));
+    expect(shared.nodes.map((n) => n.kind)).toEqual(["skill", "skill", "memory", "memory"]);
+    expect(shared.edges).toEqual([
+      [2, 0],
+      [0, 1],
+    ]); // the dangling edge is not shared
+    const s1 = placed.get("s1");
+    expect(shared.nodes[0]?.x).toBeCloseTo((s1?.x ?? 0) / BOX.width, 3);
+    for (const bad of ["", "xyz", `${SHARE_PREFIX}!!!`, `${SHARE_PREFIX}${btoa('{"v":9}')}`]) {
+      expect(() => readShareCode(bad)).toThrow(ShareCodeError);
+    }
+  });
+
+  it("filters and playback pick the right nodes", () => {
+    expect(visible(GRAPH, "used", null).nodes.map((n) => n.id)).toEqual(["s1", "m1"]);
+    expect(visible(GRAPH, "learned", null).nodes.map((n) => n.id)).toEqual(["s2", "m1"]);
+    const early = visible(GRAPH, "all", 250);
+    expect(early.nodes.map((n) => n.id)).toEqual(["s1", "s2"]);
+    expect(early.edges).toEqual([{ from: "s1", to: "s2" }]);
+    expect(timeRange(GRAPH)).toEqual({ from: 100, to: 400 });
+    expect(timeRange({ nodes: [node("x")], edges: [] })).toBeNull();
+  });
+
+  it("a skills-only graph links each category", () => {
+    const graph = graphFromSkills([
+      { name: "a", category: "web", enabled: true },
+      { name: "b", category: "web", enabled: false },
+      { name: "c", category: "", enabled: true },
+    ]);
+    expect(graph.nodes.map((n) => n.id)).toEqual(["skill:a", "skill:b", "skill:c"]);
+    expect(graph.edges).toEqual([{ from: "skill:a", to: "skill:b" }]);
+  });
+});
