@@ -0,0 +1,73 @@
+import { describe, expect, it } from "vitest";
+import {
+  cleanHeaders,
+  decodeHeaders,
+  encodeHeaders,
+  isDroppedHeader,
+  matchesGateway,
+  proxyHeadersFor,
+} from "./proxyHeaders.ts";
+
+const SECRET = ["access", "client", "value"].join("-");
+
+describe("proxy headers", () => {
+  it("Cookie in a configured header set is dropped", () => {
+    const { headers, dropped } = cleanHeaders({
+      "CF-Access-Client-Id": "id-1",
+      "CF-Access-Client-Secret": SECRET,
+      Cookie: "session=1",
+      authorization: "Bearer x",
+      HOST: "evil",
+      Origin: "x",
+      Referer: "x",
+      "X-Indus-Session-Token": "x",
+      "Sec-WebSocket-Protocol": "x",
+      "Proxy-Authorization": "x",
+      "Content-Length": "9",
+      "Bad Name": "x",
+    });
+    expect(headers).toEqual({ "CF-Access-Client-Id": "id-1", "CF-Access-Client-Secret": SECRET });
+    expect(dropped).toEqual([
+      "Cookie",
+      "authorization",
+      "HOST",
+      "Origin",
+      "Referer",
+      "X-Indus-Session-Token",
+      "Sec-WebSocket-Protocol",
+      "Proxy-Authorization",
+      "Content-Length",
+      "Bad Name",
+    ]);
+    expect(isDroppedHeader("COOKIE")).toBe(true);
+  });
+
+  it("values lose CR and LF and empty ones are refused", () => {
+    expect(cleanHeaders({ A: "one\r\nInjected: yes", B: "  ", C: 3 })).toEqual({
+      headers: { A: "oneInjected: yes" },
+      dropped: ["B", "C"],
+    });
+  });
+
+  it("headers go only to the connection's own gateway", () => {
+    const base = "https://gw.example/indus";
+    expect(matchesGateway("https://gw.example/indus/api/config", base)).toBe(true);
+    expect(matchesGateway("wss://gw.example/indus/api/ws", base)).toBe(true);
+    expect(matchesGateway("https://gw.example/indus", base)).toBe(true);
+    expect(matchesGateway("https://gw.example/indusx/api", base)).toBe(false);
+    expect(matchesGateway("http://gw.example/indus/api", base)).toBe(false);
+    expect(matchesGateway("https://gw.example:8443/indus/api", base)).toBe(false);
+    expect(matchesGateway("https://other.example/indus/api", base)).toBe(false);
+    expect(matchesGateway("not a url", base)).toBe(false);
+    expect(proxyHeadersFor("https://other.example/x", base, { A: "b" })).toEqual({});
+    expect(proxyHeadersFor("https://gw.example/indus/api/x", base, { A: "b" })).toEqual({ A: "b" });
+  });
+
+  it("round-trips the stored form", () => {
+    const { stored, dropped } = encodeHeaders({ A: "b", Cookie: "c" });
+    expect(dropped).toEqual(["Cookie"]);
+    expect(decodeHeaders(stored)).toEqual({ A: "b" });
+    expect(decodeHeaders("{broken")).toEqual({});
+    expect(encodeHeaders({}).stored).toBe("");
+  });
+});
diff --git a/apps/desktop/electron/connections/proxyHeaders.ts b/apps/desktop/electron/connections/proxyHeaders.ts
new file mode 100644
index 0000000..ebc3578
--- /dev/null
+++ b/apps/desktop/electron/connections/proxyHeaders.ts
@@ -0,0 +1,117 @@
+// Per-connection access-proxy headers (P24-29): a remote behind Cloudflare Access or a similar
+// gateway may need extra headers on every request. They are a secret (keychain entry
+// `connection-<id>-headers`), sent only to the connection's own gateway (same scheme family, host
+// and path prefix; ws/wss count as http/https), never to anything else.
+//
+// A configured set can never carry a credential or a header that changes the request's framing or
+// origin: `Authorization`, `Cookie`, `Host`, `Origin`, `Referer` and our session-token header are
+// always dropped, as are `Connection`, `Content-Length`, `Content-Type`, `Transfer-Encoding`,
+// `Upgrade`, `Proxy-*` and `Sec-*`. Names must be HTTP tokens; values lose CR and LF.
+
+import { SESSION_TOKEN_HEADER } from "../backend/localAttach.ts";
+
+const NAME_RE = /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/;
+export const DROPPED_HEADERS: ReadonlySet<string> = new Set([
+  "authorization",
+  "cookie",
+  "host",
+  "origin",
+  "referer",
+  SESSION_TOKEN_HEADER.toLowerCase(),
+  "connection",
+  "content-length",
+  "content-type",
+  "transfer-encoding",
+  "upgrade",
+  "te",
+  "trailer",
+  "keep-alive",
+]);
+const DROPPED_PREFIXES = ["proxy-", "sec-"];
+export const MAX_HEADERS = 16;
+export const MAX_VALUE_CHARS = 4096;
+
+export interface CleanHeaders {
+  headers: Record<string, string>;
+  /** Names refused (said back to the person by name, never by value). */
+  dropped: string[];
+}
+
+export function isDroppedHeader(name: string): boolean {
+  const lower = name.toLowerCase();
+  return DROPPED_HEADERS.has(lower) || DROPPED_PREFIXES.some((prefix) => lower.startsWith(prefix));
+}
+
+/** The usable part of a configured header set. */
+export function cleanHeaders(raw: unknown): CleanHeaders {
+  const headers: Record<string, string> = {};
+  const dropped: string[] = [];
+  if (raw === null || typeof raw !== "object" || Array.isArray(raw)) return { headers, dropped };
+  for (const [rawName, rawValue] of Object.entries(raw as Record<string, unknown>)) {
+    const name = rawName.trim();
+    if (name === "") continue;
+    if (!NAME_RE.test(name) || isDroppedHeader(name) || typeof rawValue !== "string") {
+      dropped.push(name.slice(0, 64));
+      continue;
+    }
+    const value = rawValue.replace(/[\r\n]+/g, "").trim();
+    if (value === "" || value.length > MAX_VALUE_CHARS) {
+      dropped.push(name);
+      continue;
+    }
+    if (Object.keys(headers).length >= MAX_HEADERS) {
+      dropped.push(name);
+      continue;
+    }
+    headers[name] = value;
+  }
+  return { headers, dropped };
+}
+
+function family(protocol: string): string {
+  if (protocol === "ws:") return "http:";
+  if (protocol === "wss:") return "https:";
+  return protocol;
+}
+
+/** Does `requestUrl` go to the gateway at `baseUrl` (scheme family, host, path prefix)? */
+export function matchesGateway(requestUrl: string, baseUrl: string): boolean {
+  let request: URL;
+  let base: URL;
+  try {
+    request = new URL(requestUrl);
+    base = new URL(baseUrl);
+  } catch {
+    return false;
+  }
+  if (family(request.protocol) !== family(base.protocol) || request.host !== base.host) {
+    return false;
+  }
+  const prefix = base.pathname.replace(/\/+$/, "");
+  return prefix === "" || request.pathname === prefix || request.pathname.startsWith(`${prefix}/`);
+}
+
+/** The headers to add to `requestUrl` for a connection at `baseUrl` (empty when it is elsewhere). */
+export function proxyHeadersFor(
+  requestUrl: string,
+  baseUrl: string,
+  configured: unknown,
+): Record<string, string> {
+  if (!matchesGateway(requestUrl, baseUrl)) return {};
+  return cleanHeaders(configured).headers;
+}
+
+/** The stored form of a header set (JSON of the clean headers) and the names refused. */
+export function encodeHeaders(raw: unknown): { stored: string; dropped: string[] } {
+  const { headers, dropped } = cleanHeaders(raw);
+  return { stored: Object.keys(headers).length === 0 ? "" : JSON.stringify(headers), dropped };
+}
+
+export function decodeHeaders(stored: string | null): Record<string, string> {
+  if (stored === null || stored === "") return {};
+  try {
+    return cleanHeaders(JSON.parse(stored)).headers;
+  } catch {
+    return {};
+  }
+}
diff --git a/apps/desktop/electron/connections/registry.test.ts b/apps/desktop/electron/connections/registry.test.ts
new file mode 100644
index 0000000..0835b3c
--- /dev/null
+++ b/apps/desktop/electron/connections/registry.test.ts
@@ -0,0 +1,256 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { REMOTE_FILE, REMOTE_TOKEN_SECRET } from "../backend/remote.ts";
+import {
+  agentHandle,
+  identityOf,
+  LOCAL_ID,
+  launchEntry,
+  normalizeRegistry,
+  QUARANTINE_CAP,
+  REGISTRY_FILE,
+  RegistryError,
+  RegistryStore,
+  removeEntry,
+  rosterHandles,
+  secretName,
+  setLastUsed,
+  setLaunchMode,
+  setPrimary,
+  upsertEntry,
+} from "./registry.ts";
+
+const dirs: string[] = [];
+afterAll(() => {
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function tempUserData(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "indus-conn-"));
+  dirs.push(dir);
+  return dir;
+}
+
+function memorySecrets() {
+  const values = new Map<string, string>();
+  return {
+    values,
+    get: (name: string) => values.get(name) ?? null,
+    put: (name: string, value: string) => void values.set(name, value),
+    delete: (name: string) => void values.delete(name),
+  };
+}
+
+const TOKEN = ["conn", "test", "value"].join("-");
+
+describe("normalizeRegistry", () => {
+  it("exactly one local entry exists, whatever the file says", () => {
+    expect(normalizeRegistry(null).connections).toEqual([
+      { id: LOCAL_ID, kind: "local", label: "This computer" },
+    ]);
+    const two = normalizeRegistry({
+      connections: [
+        { id: "local", kind: "local", label: "Laptop" },
+        { id: "x", kind: "local", label: "Other" },
+      ],
+    });
+    expect(two.connections.filter((c) => c.kind === "local")).toEqual([
+      { id: LOCAL_ID, kind: "local", label: "Laptop" },
+    ]);
+    expect(two.quarantined.map((q) => q.reason)).toEqual(["second-local"]);
+  });
+
+  it("a malformed entry survives a save verbatim", () => {
+    const dir = tempUserData();
+    const store = new RegistryStore({ userData: dir, secrets: memorySecrets(), log: () => {} });
+    const odd = { kind: "cloud", label: "Hosted", org: "acme", future: { nested: [1, 2] } };
+    fs.writeFileSync(
+      path.join(dir, REGISTRY_FILE),
+      JSON.stringify({
+        connections: [
+          odd,
+          "hand-edited",
+          { id: "r1", kind: "remote", label: "Work", url: "https://work.example:9119" },
+          { kind: "remote", url: "ftp://bad" },
+        ],
+      }),
+    );
+    const loaded = store.load();
+    expect(loaded.connections.map((c) => c.id)).toEqual(["local", "r1"]);
+    expect(loaded.quarantined).toEqual([
+      { reason: "unknown-kind", entry: odd },
+      { reason: "malformed", entry: "hand-edited" },
+      { reason: "bad-url", entry: { kind: "remote", url: "ftp://bad" } },
+    ]);
+    store.update((registry) => setPrimary(registry, "r1"));
+    const written = JSON.parse(fs.readFileSync(path.join(dir, REGISTRY_FILE), "utf8"));
+    expect(written.quarantined[0]).toEqual({ reason: "unknown-kind", entry: odd });
+    expect(store.load().quarantined).toHaveLength(3);
+    expect(fs.statSync(path.join(dir, REGISTRY_FILE)).mode & 0o777).toBe(0o600);
+  });
+
+  it("caps the quarantine", () => {
+    const junk = Array.from({ length: QUARANTINE_CAP + 5 }, (_, i) => `junk-${i}`);
+    expect(normalizeRegistry({ connections: junk }).quarantined).toHaveLength(QUARANTINE_CAP);
+  });
+
+  it("labels stay unique ignoring case", () => {
+    const registry = normalizeRegistry({
+      connections: [
+        { id: "a", kind: "remote", label: "Office", url: "http://a.example" },
+        { id: "b", kind: "remote", label: "office", url: "http://b.example" },
+      ],
+    });
+    expect(registry.connections.map((c) => c.label)).toEqual([
+      "This computer",
+      "Office",
+      "office 2",
+    ]);
+    const added = upsertEntry(registry, {
+      kind: "remote",
+      url: "http://c.example",
+      label: "OFFICE",
+    });
+    expect(added.entry.label).toBe("OFFICE 3");
+  });
+
+  it("never keeps credentials or unknown fields in an entry", () => {
+    const registry = normalizeRegistry({
+      connections: [
+        { id: "r", kind: "remote", url: "http://r.example", token: TOKEN, headers: { A: "b" } },
+      ],
+    });
+    expect(JSON.stringify(registry)).not.toContain(TOKEN);
+    expect(registry.connections[1]).toEqual({
+      id: "r",
+      kind: "remote",
+      label: "r.example",
+      url: "http://r.example",
+      authMode: "token",
+    });
+  });
+});
+
+describe("changes", () => {
+  it("dedupes remotes by normalised URL and SSH targets by user@host:port + profile", () => {
+    let registry = normalizeRegistry({});
+    const first = upsertEntry(registry, {
+      kind: "remote",
+      url: "work.example:9119/",
+      label: "Work",
+    });
+    registry = first.registry;
+    const again = upsertEntry(registry, { kind: "remote", url: "http://work.example:9119" });
+    expect(again.created).toBe(false);
+    expect(again.entry.id).toBe(first.entry.id);
+    expect(again.entry.label).toBe("Work");
+    registry = again.registry;
+    const ssh = upsertEntry(registry, {
+      kind: "ssh",
+      ssh: { host: "Build.example", user: "dev", port: 22 },
+    });
+    registry = ssh.registry;
+    const sameHost = upsertEntry(registry, {
+      kind: "ssh",
+      ssh: { host: "build.example", user: "dev" },
+    });
+    expect(sameHost.created).toBe(false);
+    const otherProfile = upsertEntry(sameHost.registry, {
+      kind: "ssh",
+      ssh: { host: "build.example", user: "dev", remoteProfile: "research" },
+    });
+    expect(otherProfile.created).toBe(true);
+    expect(otherProfile.registry.connections).toHaveLength(4);
+    expect(identityOf(otherProfile.entry)).toBe("ssh:dev@build.example:22/research");
+  });
+
+  it("refuses an SSH target that could be read as an option", () => {
+    const registry = normalizeRegistry({});
+    for (const ssh of [
+      { host: "-oProxyCommand=x" },
+      { host: "h", user: "-l" },
+      { host: "h", port: 70_000 },
+      { host: "h", keyPath: "-i\nx" },
+    ]) {
+      expect(() => upsertEntry(registry, { kind: "ssh", ssh })).toThrow(RegistryError);
+    }
+  });
+
+  it("removing the primary retargets the local entry", () => {
+    let registry = upsertEntry(normalizeRegistry({}), {
+      kind: "remote",
+      url: "http://r.example",
+    }).registry;
+    const id = registry.connections[1]?.id as string;
+    registry = setLastUsed(setPrimary(registry, id), id);
+    const after = removeEntry(registry, id);
+    expect(after.primaryId).toBe(LOCAL_ID);
+    expect(after.lastUsedId).toBeUndefined();
+    expect(() => removeEntry(after, LOCAL_ID)).toThrow(/cannot be removed/);
+    expect(removeEntry(after, "ghost")).toBe(after);
+  });
+
+  it("launch mode last-used reopens the last entry that worked", () => {
+    let registry = upsertEntry(normalizeRegistry({}), {
+      kind: "remote",
+      url: "http://r.example",
+    }).registry;
+    const id = registry.connections[1]?.id as string;
+    registry = setLastUsed(registry, id);
+    expect(launchEntry(registry).id).toBe(LOCAL_ID); // primary mode
+    expect(launchEntry(setLaunchMode(registry, "last-used")).id).toBe(id);
+    expect(launchEntry(setLaunchMode(removeEntry(registry, id), "last-used")).id).toBe(LOCAL_ID);
+  });
+});
+
+describe("handles", () => {
+  it("same-named profiles on two gateways get the label suffix", () => {
+    const handles = rosterHandles([
+      { connectionId: "local", label: "This computer", profiles: ["default", "coder"] },
+      { connectionId: "box", label: "Build Box", profiles: ["default", "research"] },
+    ]);
+    expect(handles.get("local::default")).toBe("@default-this-computer");
+    expect(handles.get("box::default")).toBe("@default-build-box");
+    expect(handles.get("local::coder")).toBe("@coder");
+    expect(handles.get("box::research")).toBe("@research");
+    expect(agentHandle("", "x", false)).toBe("@default");
+  });
+});
+
+describe("RegistryStore", () => {
+  it("takes over the P20 saved remote once, token into the connection's secret", () => {
+    const dir = tempUserData();
+    const secrets = memorySecrets();
+    secrets.put(REMOTE_TOKEN_SECRET, TOKEN);
+    fs.writeFileSync(
+      path.join(dir, REMOTE_FILE),
+      JSON.stringify({ v: 1, url: "http://old.example:9119" }),
+    );
+    const store = new RegistryStore({ userData: dir, secrets, log: () => {} });
+    const loaded = store.load();
+    const remote = loaded.connections.find((c) => c.kind === "remote");
+    expect(remote?.url).toBe("http://old.example:9119");
+    expect(loaded.primaryId).toBe(remote?.id);
+    expect(secrets.get(secretName(remote?.id as string, "token"))).toBe(TOKEN);
+    expect(fs.readFileSync(path.join(dir, REGISTRY_FILE), "utf8")).not.toContain(TOKEN);
+    // a second load reads the registry, it does not migrate again
+    store.update((registry) => removeEntry(registry, remote?.id as string));
+    expect(store.load().connections).toHaveLength(1);
+  });
+
+  it("remove drops the entry's secrets", () => {
+    const dir = tempUserData();
+    const secrets = memorySecrets();
+    const store = new RegistryStore({ userData: dir, secrets, log: () => {} });
+    const registry = store.update(
+      (current) => upsertEntry(current, { kind: "remote", url: "http://r.example" }).registry,
+    );
+    const id = registry.connections[1]?.id as string;
+    secrets.put(secretName(id, "token"), TOKEN);
+    secrets.put(secretName(id, "headers"), "{}");
+    store.remove(id);
+    expect(secrets.values.size).toBe(0);
+  });
+});
diff --git a/apps/desktop/electron/connections/registry.ts b/apps/desktop/electron/connections/registry.ts
new file mode 100644
index 0000000..d4ba623
--- /dev/null
+++ b/apps/desktop/electron/connections/registry.ts
@@ -0,0 +1,514 @@
+// The connections registry (P24-29): every Indus server this desktop knows, in one file.
+//
+// `<userData>/connections.json` holds `{v, connections[], primaryId, lastUsedId?, launchMode,
+// quarantined[]}`. Rules:
+//   - exactly one `local` entry ("This computer") always exists; a second one in the file is
+//     quarantined, a missing one is added;
+//   - labels are unique ignoring case (a clash gets " 2", " 3", …);
+//   - a remote is identified by its normalised URL, an SSH entry by `user@host:port` plus its
+//     remote profile: adding one that exists updates that entry (id and label kept);
+//   - an entry this app cannot read is never dropped: it goes to `quarantined[]` verbatim (at most
+//     20) and is written back on every save;
+//   - removing the primary makes `local` the primary; `local` cannot be removed;
+//   - launch mode `primary` opens the primary, `last-used` the last entry that worked.
+// Credentials never live in this file: a token, an OAuth set and access-proxy headers are secrets
+// named `connection-<id>-token|oauth|headers` in the desktop secrets store (keychain by default).
+// Cloud connections are not built (D-16.12).
+
+import fs from "node:fs";
+import path from "node:path";
+import { normalizeRemoteUrl, REMOTE_FILE, REMOTE_TOKEN_SECRET } from "../backend/remote.ts";
+import { readJsonFile, writeFileAtomic } from "../fsSecure.ts";
+
+export const REGISTRY_FILE = "connections.json";
+export const REGISTRY_VERSION = 1;
+export const LOCAL_ID = "local";
+export const LOCAL_LABEL = "This computer";
+export const QUARANTINE_CAP = 20;
+export const LABEL_MAX = 64;
+const ID_RE = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const PROFILE_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/;
+
+export type ConnectionKind = "local" | "remote" | "ssh";
+export type AuthMode = "token" | "oauth" | "basic";
+export type LaunchMode = "primary" | "last-used";
+export type SecretKind = "token" | "oauth" | "headers";
+
+export interface SshTarget {
+  host: string;
+  user?: string;
+  port?: number;
+  /** An identity file, used as `-i` (the agent and ~/.ssh/config work without one). */
+  keyPath?: string;
+  /** The profile the remote Indus serves (default: its default profile). */
+  remoteProfile?: string;
+}
+
+export interface ConnectionEntry {
+  id: string;
+  kind: ConnectionKind;
+  label: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+  /** Profiles last seen on that server (for the roster before it answers). */
+  profiles?: string[];
+}
+
+export interface QuarantinedEntry {
+  reason: string;
+  entry: unknown;
+}
+
+export interface ConnectionRegistry {
+  v: typeof REGISTRY_VERSION;
+  connections: ConnectionEntry[];
+  primaryId: string;
+  lastUsedId?: string;
+  launchMode: LaunchMode;
+  quarantined: QuarantinedEntry[];
+}
+
+export class RegistryError extends Error {
+  readonly code: "local-not-removable" | "unknown-connection" | "bad-entry";
+
+  constructor(code: RegistryError["code"], message: string) {
+    super(message);
+    this.code = code;
+  }
+}
+
+export function secretName(id: string, kind: SecretKind): `connection-${string}` {
+  return `connection-${id}-${kind}`;
+}
+
+// -- labels, ids, handles -------------------------------------------------------------------------
+
+export function labelKey(label: string): string {
+  return label.trim().toLowerCase();
+}
+
+/** `candidate` (cut to fit) or the first free `candidate N`, ignoring case. */
+export function uniqueLabel(candidate: string, taken: Iterable<string>): string {
+  const used = new Set([...taken].map(labelKey));
+  const base = candidate.trim().slice(0, LABEL_MAX - 4) || "Connection";
+  if (!used.has(labelKey(base))) return base;
+  for (let n = 2; ; n += 1) {
+    const next = `${base} ${n}`;
+    if (!used.has(labelKey(next))) return next;
+  }
+}
+
+export function labelSlug(label: string): string {
+  const slug = label
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48)
+    .replace(/-+$/, "");
+  return slug || "connection";
+}
+
+function freshId(label: string, taken: ReadonlySet<string>): string {
+  const base = labelSlug(label);
+  if (base !== LOCAL_ID && !taken.has(base)) return base;
+  for (let n = 2; ; n += 1) {
+    const next = `${base}-${n}`;
+    if (!taken.has(next)) return next;
+  }
+}
+
+/** How a profile shows in a roster spanning several gateways: bare when unique, else suffixed. */
+export function agentHandle(profile: string, label: string, duplicated: boolean): string {
+  const name = profile.trim() || "default";
+  return `@${duplicated ? `${name}-${labelSlug(label)}` : name}`;
+}
+
+/** Handles for every (connection, profile) of a roster; same-named profiles get the label. */
+export function rosterHandles(
+  rosters: ReadonlyArray<{ connectionId: string; label: string; profiles: readonly string[] }>,
+): Map<string, string> {
+  const counts = new Map<string, number>();
+  for (const roster of rosters)
+    for (const profile of new Set(roster.profiles))
+      counts.set(profile, (counts.get(profile) ?? 0) + 1);
+  const out = new Map<string, string>();
+  for (const roster of rosters) {
+    for (const profile of roster.profiles) {
+      const handle = agentHandle(profile, roster.label, (counts.get(profile) ?? 0) > 1);
+      out.set(`${roster.connectionId}::${profile}`, handle);
+    }
+  }
+  return out;
+}
+
+// -- identity -------------------------------------------------------------------------------------
+
+const HOST_RE = /^[A-Za-z0-9._-]+$|^\[?[0-9A-Fa-f:.]+(%[A-Za-z0-9._-]+)?\]?$/;
+
+/** A checked SSH target, or null. */
+export function normalizeSsh(raw: unknown): SshTarget | null {
+  if (raw === null || typeof raw !== "object") return null;
+  const record = raw as Record<string, unknown>;
+  const host = typeof record.host === "string" ? record.host.trim() : "";
+  if (host === "" || host.startsWith("-") || !HOST_RE.test(host)) return null;
+  const out: SshTarget = { host };
+  if (typeof record.user === "string" && record.user.trim() !== "") {
+    const user = record.user.trim();
+    if (user.startsWith("-") || !/^[A-Za-z0-9._-]+$/.test(user)) return null;
+    out.user = user;
+  }
+  if (record.port !== undefined && record.port !== null && record.port !== "") {
+    const port = Number(record.port);
+    if (!Number.isInteger(port) || port < 1 || port > 65_535) return null;
+    if (port !== 22) out.port = port;
+  }
+  if (typeof record.keyPath === "string" && record.keyPath.trim() !== "") {
+    const key = record.keyPath.trim();
+    if (key.startsWith("-") || /[\r\n\0]/.test(key)) return null;
+    out.keyPath = key;
+  }
+  if (typeof record.remoteProfile === "string" && record.remoteProfile.trim() !== "") {
+    const profile = record.remoteProfile.trim();
+    if (!PROFILE_RE.test(profile)) return null;
+    out.remoteProfile = profile;
+  }
+  return out;
+}
+
+/** The identity two entries share when they are the same server. */
+export function identityOf(entry: Pick<ConnectionEntry, "kind" | "url" | "ssh">): string {
+  if (entry.kind === "local") return "local";
+  if (entry.kind === "remote") return `remote:${entry.url ?? ""}`;
+  const ssh = entry.ssh;
+  if (ssh === undefined) return "ssh:";
+  return `ssh:${ssh.user ?? ""}@${ssh.host.toLowerCase()}:${ssh.port ?? 22}/${ssh.remoteProfile ?? "default"}`;
+}
+
+function hostLabel(entry: { kind: ConnectionKind; url?: string; ssh?: SshTarget }): string {
+  if (entry.kind === "ssh") return entry.ssh?.host ?? "SSH";
+  try {
+    return new URL(entry.url ?? "").host || "Remote";
+  } catch {
+    return "Remote";
+  }
+}
+
+// -- normalise ------------------------------------------------------------------------------------
+
+function localEntry(label = LOCAL_LABEL): ConnectionEntry {
+  return { id: LOCAL_ID, kind: "local", label };
+}
+
+function plainCopy(value: unknown): unknown {
+  try {
+    return JSON.parse(JSON.stringify(value)) as unknown;
+  } catch {
+    return { unserializable: true };
+  }
+}
+
+function profilesOf(raw: unknown): string[] | undefined {
+  if (!Array.isArray(raw)) return undefined;
+  const names = raw.filter((p): p is string => typeof p === "string" && PROFILE_RE.test(p));
+  return names.length > 0 ? [...new Set(names)] : undefined;
+}
+
+/** Any parsed JSON → a valid registry (see the file notes); never throws. */
+export function normalizeRegistry(raw: unknown): ConnectionRegistry {
+  const parsed = raw !== null && typeof raw === "object" ? (raw as Record<string, unknown>) : {};
+  const quarantined: QuarantinedEntry[] = [];
+  const quarantine = (reason: string, entry: unknown) => {
+    if (quarantined.length < QUARANTINE_CAP) quarantined.push({ reason, entry: plainCopy(entry) });
+  };
+  if (Array.isArray(parsed.quarantined)) {
+    for (const item of parsed.quarantined) {
+      if (item !== null && typeof item === "object" && "entry" in item) {
+        const record = item as { reason?: unknown; entry: unknown };
+        quarantine(typeof record.reason === "string" ? record.reason : "unknown", record.entry);
+      }
+    }
+  }
+  const connections: ConnectionEntry[] = [];
+  const ids = new Set<string>();
+  const labels: string[] = [];
+  const identities = new Set<string>();
+  const list = Array.isArray(parsed.connections) ? parsed.connections : [];
+  for (const item of list) {
+    if (item === null || item === undefined || item === false || item === "") continue;
+    if (typeof item !== "object" || Array.isArray(item)) {
+      quarantine("malformed", item);
+      continue;
+    }
+    try {
+      const record = item as Record<string, unknown>;
+      const kind = record.kind;
+      if (kind !== "local" && kind !== "remote" && kind !== "ssh") {
+        quarantine("unknown-kind", item);
+        continue;
+      }
+      if (kind === "local" && ids.has(LOCAL_ID)) {
+        quarantine("second-local", item);
+        continue;
+      }
+      const clean: ConnectionEntry = { id: "", kind, label: "" };
+      if (kind === "remote") {
+        try {
+          clean.url = normalizeRemoteUrl(typeof record.url === "string" ? record.url : "");
+        } catch {
+          quarantine("bad-url", item);
+          continue;
+        }
+        const mode = record.authMode;
+        clean.authMode = mode === "oauth" || mode === "basic" ? mode : "token";
+      } else if (kind === "ssh") {
+        const ssh = normalizeSsh(record.ssh);
+        if (ssh === null) {
+          quarantine("bad-ssh", item);
+          continue;
+        }
+        clean.ssh = ssh;
+      }
+      const identity = identityOf(clean);
+      if (kind !== "local" && identities.has(identity)) {
+        quarantine("duplicate", item);
+        continue;
+      }
+      const rawLabel = typeof record.label === "string" ? record.label.trim() : "";
+      clean.label = uniqueLabel(
+        rawLabel || (kind === "local" ? LOCAL_LABEL : hostLabel(clean)),
+        labels,
+      );
+      const rawId = typeof record.id === "string" ? record.id.trim() : "";
+      clean.id =
+        kind === "local"
+          ? LOCAL_ID
+          : ID_RE.test(rawId) && rawId !== LOCAL_ID && !ids.has(rawId)
+            ? rawId
+            : freshId(clean.label, ids);
+      const profiles = profilesOf(record.profiles);
+      if (profiles !== undefined) clean.profiles = profiles;
+      ids.add(clean.id);
+      labels.push(clean.label);
+      identities.add(identity);
+      connections.push(clean);
+    } catch {
+      quarantine("unreadable", item);
+    }
+  }
+  if (!ids.has(LOCAL_ID)) {
+    const label = uniqueLabel(LOCAL_LABEL, labels);
+    connections.unshift(localEntry(label));
+    ids.add(LOCAL_ID);
+  }
+  const primaryId =
+    typeof parsed.primaryId === "string" && ids.has(parsed.primaryId) ? parsed.primaryId : LOCAL_ID;
+  const registry: ConnectionRegistry = {
+    v: REGISTRY_VERSION,
+    connections,
+    primaryId,
+    launchMode: parsed.launchMode === "last-used" ? "last-used" : "primary",
+    quarantined,
+  };
+  if (typeof parsed.lastUsedId === "string" && ids.has(parsed.lastUsedId)) {
+    registry.lastUsedId = parsed.lastUsedId;
+  }
+  return registry;
+}
+
+// -- changes (pure: each returns a new registry) --------------------------------------------------
+
+export interface EntryInput {
+  id?: string;
+  kind: "remote" | "ssh";
+  label?: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+}
+
+/** Add or update an entry; an existing server (same identity or id) keeps its id and label. */
+export function upsertEntry(
+  registry: ConnectionRegistry,
+  input: EntryInput,
+): { registry: ConnectionRegistry; entry: ConnectionEntry; created: boolean } {
+  const draft: ConnectionEntry = { id: "", kind: input.kind, label: "" };
+  if (input.kind === "remote") {
+    try {
+      draft.url = normalizeRemoteUrl(input.url ?? "");
+    } catch (error) {
+      throw new RegistryError("bad-entry", error instanceof Error ? error.message : "bad address");
+    }
+    draft.authMode = input.authMode ?? "token";
+  } else {
+    const ssh = normalizeSsh(input.ssh);
+    if (ssh === null) throw new RegistryError("bad-entry", "that is not a usable SSH target");
+    draft.ssh = ssh;
+  }
+  const identity = identityOf(draft);
+  const existing =
+    registry.connections.find((c) => input.id !== undefined && c.id === input.id) ??
+    registry.connections.find((c) => c.kind !== "local" && identityOf(c) === identity);
+  const others = registry.connections.filter((c) => c.id !== existing?.id);
+  const clash = others.find((c) => c.kind !== "local" && identityOf(c) === identity);
+  if (clash !== undefined) {
+    throw new RegistryError("bad-entry", `"${clash.label}" already connects to that server`);
+  }
+  const wanted = input.label?.trim() ?? "";
+  draft.label = uniqueLabel(
+    wanted || existing?.label || hostLabel(draft),
+    others.map((c) => c.label),
+  );
+  draft.id = existing?.id ?? freshId(draft.label, new Set(registry.connections.map((c) => c.id)));
+  if (existing?.profiles !== undefined) draft.profiles = existing.profiles;
+  const connections =
+    existing === undefined
+      ? [...registry.connections, draft]
+      : registry.connections.map((c) => (c.id === existing.id ? draft : c));
+  return { registry: { ...registry, connections }, entry: draft, created: existing === undefined };
+}
+
+export function removeEntry(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  const target = registry.connections.find((c) => c.id === id);
+  if (target === undefined) return registry;
+  if (target.kind === "local") {
+    throw new RegistryError("local-not-removable", "This computer cannot be removed");
+  }
+  const primaryId = registry.primaryId === id ? LOCAL_ID : registry.primaryId;
+  const next: ConnectionRegistry = {
+    ...registry,
+    primaryId,
+    connections: registry.connections.filter((c) => c.id !== id),
+  };
+  if (registry.lastUsedId === id) delete next.lastUsedId;
+  return next;
+}
+
+function known(registry: ConnectionRegistry, id: string): void {
+  if (!registry.connections.some((c) => c.id === id)) {
+    throw new RegistryError("unknown-connection", "no connection has that id");
+  }
+}
+
+export function setPrimary(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  known(registry, id);
+  return { ...registry, primaryId: id };
+}
+
+export function setLastUsed(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  known(registry, id);
+  return { ...registry, lastUsedId: id };
+}
+
+export function setLaunchMode(registry: ConnectionRegistry, mode: LaunchMode): ConnectionRegistry {
+  return { ...registry, launchMode: mode };
+}
+
+export function setProfiles(
+  registry: ConnectionRegistry,
+  id: string,
+  profiles: readonly string[],
+): ConnectionRegistry {
+  known(registry, id);
+  const clean = profilesOf([...profiles]);
+  return {
+    ...registry,
+    connections: registry.connections.map((c) => {
+      if (c.id !== id) return c;
+      const { profiles: _old, ...rest } = c;
+      return clean === undefined ? rest : { ...rest, profiles: clean };
+    }),
+  };
+}
+
+/** The entry a launch opens (launch mode decides; anything missing falls back to the primary). */
+export function launchEntry(registry: ConnectionRegistry): ConnectionEntry {
+  const byId = (id: string | undefined) => registry.connections.find((c) => c.id === id);
+  const chosen =
+    registry.launchMode === "last-used"
+      ? (byId(registry.lastUsedId) ?? byId(registry.primaryId))
+      : byId(registry.primaryId);
+  return chosen ?? (byId(LOCAL_ID) as ConnectionEntry);
+}
+
+// -- the file -------------------------------------------------------------------------------------
+
+export interface SecretsLike {
+  get(name: string): string | null;
+  put(name: string, value: string): void;
+  delete(name: string): void;
+}
+
+export interface RegistryStoreDeps {
+  userData: string;
+  secrets: SecretsLike;
+  log: (line: string) => void;
+}
+
+/** Load and save the registry; the first load takes over the P20 single saved remote. */
+export class RegistryStore {
+  private readonly deps: RegistryStoreDeps;
+
+  constructor(deps: RegistryStoreDeps) {
+    this.deps = deps;
+  }
+
+  file(): string {
+    return path.join(this.deps.userData, REGISTRY_FILE);
+  }
+
+  load(): ConnectionRegistry {
+    const exists = fs.existsSync(this.file());
+    if (!exists) return this.migrate();
+    let raw: unknown = null;
+    try {
+      raw = readJsonFile(this.file());
+    } catch {
+      raw = null;
+    }
+    return normalizeRegistry(raw);
+  }
+
+  save(registry: ConnectionRegistry): void {
+    const clean = normalizeRegistry(registry);
+    fs.mkdirSync(this.deps.userData, { recursive: true });
+    writeFileAtomic(this.file(), `${JSON.stringify(clean, null, 2)}\n`, { mode: 0o600 });
+  }
+
+  /** Change the registry under one load → change → save. */
+  update(change: (registry: ConnectionRegistry) => ConnectionRegistry): ConnectionRegistry {
+    const next = change(this.load());
+    this.save(next);
+    return this.load();
+  }
+
+  /** Drop an entry and its secrets. */
+  remove(id: string): ConnectionRegistry {
+    const next = this.update((registry) => removeEntry(registry, id));
+    for (const kind of ["token", "oauth", "headers"] as const) {
+      this.deps.secrets.delete(secretName(id, kind));
+    }
+    return next;
+  }
+
+  private migrate(): ConnectionRegistry {
+    const legacy = readJsonFile(path.join(this.deps.userData, REMOTE_FILE)) as {
+      url?: unknown;
+    } | null;
+    let registry = normalizeRegistry({});
+    if (legacy !== null && typeof legacy.url === "string") {
+      try {
+        const added = upsertEntry(registry, { kind: "remote", url: legacy.url });
+        registry = setPrimary(added.registry, added.entry.id);
+        const token = this.deps.secrets.get(REMOTE_TOKEN_SECRET);
+        if (token !== null) this.deps.secrets.put(secretName(added.entry.id, "token"), token);
+        this.deps.log("[connections] took the saved remote connection into the registry");
+      } catch {
+        this.deps.log("[connections] the saved remote connection could not be taken over");
+      }
+    }
+    this.save(registry);
+    return this.load();
+  }
+}
