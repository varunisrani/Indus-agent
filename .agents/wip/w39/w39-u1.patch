index 0000000..ec3f12a
--- /dev/null
+++ b/src/indus/service/pets_rpc.py
@@ -0,0 +1,331 @@
+"""``pet.*``: the pet methods the desktop and the TUI call (P24-19).
+
+``PET_METHODS`` lists ``(name, params, result, extra errors)`` rows in the shape of the other
+method groups and ``PET_HANDLERS`` maps each name to its handler; ``register(table)`` adds them to
+a dispatcher table once the names are in the method catalogue (a wiring step), and
+``PET_DEADLINES`` gives the dispatcher the two long deadlines (the drawing steps).
+
+Handlers take ``(context, params)`` where the context carries the caller's ``Scope``. Store work
+runs off the event loop; the drawing steps await the image service directly. A missing pet or a
+bad value is ``INVALID_PARAMS`` with the reason; no usable image service or a missed drawing
+deadline is ``PROVIDER_UNAVAILABLE``.
+"""
+
+from __future__ import annotations
+
+import base64
+from collections.abc import Awaitable, Callable, Mapping
+from typing import Any, Protocol
+
+from pydantic import Field
+
+from indus.foundation.blocking import run_blocking
+from indus.foundation.scope import Scope
+from indus.protocol.base import ProtocolModel
+from indus.protocol.errors import INVALID_PARAMS, PROVIDER_UNAVAILABLE, ErrorCode
+from indus.protocol.methods import ProtocolError
+from indus.service import pets
+from indus.service.pets import PetError, PetStore, PetTimeout, PetUnavailable
+
+__all__ = [
+    "PET_DEADLINES",
+    "PET_HANDLERS",
+    "PET_METHODS",
+    "PetContext",
+    "PetDraftInfo",
+    "PetGenerateParams",
+    "PetGenerateResult",
+    "PetHatchParams",
+    "PetInfoParams",
+    "PetInfoResult",
+    "PetListResult",
+    "PetRow",
+    "PetSlugParams",
+    "PetSlugResult",
+    "register",
+]
+
+
+class PetContext(Protocol):
+    @property
+    def scope(self) -> Scope: ...
+
+
+class PetNoParams(ProtocolModel):
+    """No parameters."""
+
+
+class PetInfoParams(ProtocolModel):
+    """The shown pet, for a renderer."""
+
+    known_revision: str | None = None
+    """The revision the caller already holds; the pictures are left out when it is current."""
+
+
+class PetInfoResult(ProtocolModel):
+    """The shown pet; only ``enabled`` (false) when no pet is shown."""
+
+    enabled: bool
+    """A pet is chosen and the display is on."""
+    slug: str | None = None
+    """The pet's slug."""
+    name: str | None = None
+    """Its display name."""
+    scale: float | None = None
+    """Size on every surface (0.25-3)."""
+    revision: str | None = None
+    """Changes whenever a picture or the name changes."""
+    unchanged: bool | None = None
+    """True when ``known_revision`` is current and ``moods`` is left out."""
+    moods: dict[str, str] | None = None
+    """Mood → picture as a data URI."""
+
+
+class PetRow(ProtocolModel):
+    """One pet in the list."""
+
+    slug: str
+    """The pet's slug."""
+    name: str
+    """Its display name."""
+    shown: bool
+    """It is the active pet and the display is on."""
+
+
+class PetListResult(ProtocolModel):
+    """Every pet of the profile."""
+
+    pets: list[PetRow]
+    """The pets, by slug."""
+    active: str
+    """The chosen slug ("" when none)."""
+    enabled: bool
+    """The display is on."""
+
+
+class PetGenerateParams(ProtocolModel):
+    """Draw draft looks for a new pet."""
+
+    idea: str = Field(min_length=1, max_length=pets.MAX_IDEA_CHARS)
+    """What the pet is, in a few words."""
+    count: int = Field(default=pets.MAX_DRAFTS, ge=1, le=pets.MAX_DRAFTS)
+    """How many looks to draw."""
+
+
+class PetDraftInfo(ProtocolModel):
+    """One draft look."""
+
+    index: int
+    """Its number, for ``pet.hatch``."""
+    data_uri: str
+    """The picture."""
+
+
+class PetGenerateResult(ProtocolModel):
+    """The drafts and the token that names them."""
+
+    token: str
+    """Pass it to ``pet.hatch`` (valid for an hour)."""
+    drafts: list[PetDraftInfo]
+    """The looks that came back."""
+
+
+class PetHatchParams(ProtocolModel):
+    """Turn one draft into a pet."""
+
+    token: str = Field(min_length=1, max_length=64)
+    """From ``pet.generate``."""
+    pick: int = Field(ge=0, lt=pets.MAX_DRAFTS)
+    """The draft's index."""
+    name: str = Field(min_length=1, max_length=pets.MAX_NAME_CHARS)
+    """The pet's name."""
+
+
+class PetSlugParams(ProtocolModel):
+    """One pet."""
+
+    slug: str = Field(min_length=1, max_length=64)
+    """The pet's slug."""
+
+
+class PetRenameParams(ProtocolModel):
+    """Rename a pet."""
+
+    slug: str = Field(min_length=1, max_length=64)
+    """The pet's slug."""
+    name: str = Field(min_length=1, max_length=pets.MAX_NAME_CHARS)
+    """The new name."""
+
+
+class PetSlugResult(ProtocolModel):
+    """The pet the call acted on."""
+
+    slug: str
+    """Its slug (after a rename, the new one)."""
+    name: str
+    """Its display name."""
+    shown: bool
+    """It is the pet shown now."""
+
+
+class PetDisableResult(ProtocolModel):
+    """The display state after the call."""
+
+    enabled: bool
+    """Always false."""
+
+
+def _fail(exc: PetError) -> ProtocolError:
+    if isinstance(exc, (PetUnavailable, PetTimeout)):
+        return ProtocolError(PROVIDER_UNAVAILABLE, str(exc))
+    return ProtocolError(INVALID_PARAMS, str(exc))
+
+
+async def _with_store[T](scope: Scope, fn: Callable[[PetStore], T]) -> T:
+    def call() -> T:
+        try:
+            return fn(PetStore(scope))
+        except PetError as exc:
+            raise _fail(exc) from exc
+
+    return await run_blocking(call, label="pet rpc")
+
+
+def _slug_result(store: PetStore, pet: pets.Pet) -> PetSlugResult:
+    settings = store.settings()
+    return PetSlugResult(
+        slug=pet.slug, name=pet.name, shown=settings.enabled and settings.active == pet.slug
+    )
+
+
+async def pet_info(ctx: PetContext, params: PetInfoParams) -> PetInfoResult:
+    def fn(store: PetStore) -> PetInfoResult:
+        pet = store.shown()
+        if pet is None:
+            return PetInfoResult(enabled=False)
+        payload = pets.sprite_payload(pet, store.settings())
+        same = params.known_revision is not None and params.known_revision == payload["revision"]
+        return PetInfoResult(
+            enabled=True,
+            slug=pet.slug,
+            name=pet.name,
+            scale=payload["scale"],
+            revision=payload["revision"],
+            unchanged=True if same else None,
+            moods=None if same else payload["moods"],
+        )
+
+    return await _with_store(ctx.scope, fn)
+
+
+async def pet_list(ctx: PetContext, params: PetNoParams) -> PetListResult:
+    def fn(store: PetStore) -> PetListResult:
+        settings = store.settings()
+        return PetListResult(
+            pets=[
+                PetRow(
+                    slug=p.slug,
+                    name=p.name,
+                    shown=settings.enabled and settings.active == p.slug,
+                )
+                for p in store.list()
+            ],
+            active=settings.active,
+            enabled=settings.enabled,
+        )
+
+    return await _with_store(ctx.scope, fn)
+
+
+async def pet_generate(ctx: PetContext, params: PetGenerateParams) -> PetGenerateResult:
+    try:
+        made = await pets.generate_drafts(ctx.scope, params.idea, count=params.count)
+    except PetError as exc:
+        raise _fail(exc) from exc
+
+    def encode() -> list[PetDraftInfo]:
+        return [
+            PetDraftInfo(
+                index=d.index,
+                data_uri=f"data:{d.mime};base64,"
+                + base64.b64encode(d.path.read_bytes()).decode("ascii"),
+            )
+            for d in made.drafts
+        ]
+
+    return PetGenerateResult(token=made.token, drafts=await run_blocking(encode, label="pet rpc"))
+
+
+async def pet_hatch(ctx: PetContext, params: PetHatchParams) -> PetSlugResult:
+    try:
+        pet = await pets.hatch(ctx.scope, params.token, params.pick, params.name)
+    except PetError as exc:
+        raise _fail(exc) from exc
+    return await _with_store(ctx.scope, lambda store: _slug_result(store, pet))
+
+
+async def pet_select(ctx: PetContext, params: PetSlugParams) -> PetSlugResult:
+    return await _with_store(ctx.scope, lambda store: _slug_result(store, store.use(params.slug)))
+
+
+async def pet_disable(ctx: PetContext, params: PetNoParams) -> PetDisableResult:
+    def fn(store: PetStore) -> PetDisableResult:
+        store.off()
+        return PetDisableResult(enabled=False)
+
+    return await _with_store(ctx.scope, fn)
+
+
+async def pet_rename(ctx: PetContext, params: PetRenameParams) -> PetSlugResult:
+    return await _with_store(
+        ctx.scope, lambda store: _slug_result(store, store.rename(params.slug, params.name))
+    )
+
+
+async def pet_remove(ctx: PetContext, params: PetSlugParams) -> PetSlugResult:
+    def fn(store: PetStore) -> PetSlugResult:
+        pet = store.remove(params.slug)
+        return PetSlugResult(slug=pet.slug, name=pet.name, shown=False)
+
+    return await _with_store(ctx.scope, fn)
+
+
+type _Row = tuple[str, type[ProtocolModel], type[ProtocolModel], tuple[ErrorCode, ...]]
+
+PET_METHODS: tuple[_Row, ...] = (
+    ("pet.info", PetInfoParams, PetInfoResult, ()),
+    ("pet.list", PetNoParams, PetListResult, ()),
+    ("pet.generate", PetGenerateParams, PetGenerateResult, (PROVIDER_UNAVAILABLE,)),
+    ("pet.hatch", PetHatchParams, PetSlugResult, (PROVIDER_UNAVAILABLE,)),
+    ("pet.select", PetSlugParams, PetSlugResult, ()),
+    ("pet.disable", PetNoParams, PetDisableResult, ()),
+    ("pet.rename", PetRenameParams, PetSlugResult, ()),
+    ("pet.remove", PetSlugParams, PetSlugResult, ()),
+)
+"""``(name, params, result, extra errors)`` for the pet methods, in declaration order."""
+
+type _Handler = Callable[[Any, Any], Awaitable[ProtocolModel]]
+
+PET_HANDLERS: Mapping[str, _Handler] = {
+    "pet.info": pet_info,
+    "pet.list": pet_list,
+    "pet.generate": pet_generate,
+    "pet.hatch": pet_hatch,
+    "pet.select": pet_select,
+    "pet.disable": pet_disable,
+    "pet.rename": pet_rename,
+    "pet.remove": pet_remove,
+}
+
+PET_DEADLINES: Mapping[str, float] = {
+    # The provider deadline plus a little room to write and answer.
+    "pet.generate": pets.GENERATE_TIMEOUT_S + 15.0,
+    "pet.hatch": pets.HATCH_TIMEOUT_S + 15.0,
+}
+"""Dispatcher deadlines for the drawing steps (merge into ``rpc.dispatch.DEADLINES``)."""
+
+
+def register(table: Any) -> None:
+    """Add every handler to a ``MethodTable`` (the names must be in the method catalogue)."""
+    for name, handler in PET_HANDLERS.items():
+        table.add(name, handler)
