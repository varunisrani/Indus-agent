+// @vitest-environment jsdom
+import { act, fireEvent, render, screen, within } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { MemoryRouter } from "react-router";
+import { describe, expect, it, vi } from "vitest";
+import { I18nProvider } from "../../i18n/index.tsx";
+import { fakeRest } from "../../settings/fakeRest.ts";
+import { StubDesktopPlugins } from "../../test/_stubs_u1.ts";
+import { CapabilitiesPage, CapabilitiesRoute } from "./CapabilitiesPage.tsx";
+import { mergePlugins } from "./tabs.tsx";
+
+const SHA = "a".repeat(40);
+
+function backend() {
+  const api = fakeRest();
+  api.route("GET", "/api/profiles", {
+    profiles: [{ name: "default" }, { name: "work" }],
+    active: "default",
+  });
+  api.route("GET", "/api/skills", (request) => ({
+    status: 200,
+    body: {
+      skills: [
+        {
+          name: request.profile === "work" ? "work-notes" : "brew-tea",
+          description: "about",
+          category: "",
+          enabled: true,
+          source: "hub",
+        },
+      ],
+    },
+  }));
+  api.route("GET", "/api/tools/toolsets", {
+    toolsets: [
+      { name: "web", label: "Web", description: "", enabled: true, tools: ["web_search"] },
+    ],
+  });
+  api.route("GET", "/api/mcp/servers", { servers: [] });
+  api.route("GET", "/api/plugins", {
+    plugins: [
+      { name: "weather", version: "1.0.0", description: "", enabled: true, sha: SHA },
+      { name: "tides", version: "0.1.0", description: "", enabled: false, sha: null },
+    ],
+  });
+  api.route("POST", "/api/skills/hub/install", { ok: true, name: "zen" });
+  return api;
+}
+
+const flush = async () => {
+  await act(async () => {
+    for (let i = 0; i < 10; i++) await Promise.resolve();
+  });
+};
+
+function wrap(node: ReactNode) {
+  return render(<I18nProvider>{node}</I18nProvider>);
+}
+
+describe("capabilities page", () => {
+  it("a scope switch reloads the profile-scoped tabs only", async () => {
+    const api = backend();
+    const desktop = new StubDesktopPlugins([{ id: "d1", name: "weather", enabled: true }]);
+    wrap(<CapabilitiesPage api={api} desktopPlugins={desktop} profile="default" />);
+    await flush();
+    expect(screen.getByText("brew-tea")).toBeTruthy();
+    fireEvent.click(screen.getByRole("tab", { name: /Plugins/ }));
+    await flush();
+    const pluginCalls = () => api.calls.filter((c) => c.path === "/api/plugins");
+    expect(pluginCalls().map((c) => c.profile)).toEqual(["default"]);
+    expect(desktop.calls).toBe(1);
+
+    fireEvent.change(screen.getByRole("combobox"), { target: { value: "work" } });
+    await flush();
+    expect(pluginCalls().map((c) => c.profile)).toEqual(["default", "work"]);
+    expect(desktop.calls).toBe(1); // app-level: never re-read on a switch
+    fireEvent.click(screen.getByRole("tab", { name: /Skills/ }));
+    await flush();
+    expect(screen.getByText("work-notes")).toBeTruthy();
+    const skillProfiles = api.calls.filter((c) => c.path === "/api/skills").map((c) => c.profile);
+    expect(skillProfiles).toEqual(["default", "work"]);
+    expect(api.calls.filter((c) => c.path === "/api/profiles")).toHaveLength(1);
+  });
+
+  it("an install deep link shows the confirmation before any call", async () => {
+    const api = backend();
+    wrap(
+      <MemoryRouter initialEntries={["/capabilities?tab=skills&install=hub%2Fzen"]}>
+        <CapabilitiesRoute api={api} profile="default" />
+      </MemoryRouter>,
+    );
+    await flush();
+    const dialog = screen.getByRole("dialog");
+    expect(within(dialog).getByText(/hub\/zen/)).toBeTruthy();
+    expect(api.calls.filter((c) => c.method === "POST")).toEqual([]);
+
+    fireEvent.click(within(dialog).getByRole("button", { name: "Cancel" }));
+    await flush();
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(api.calls.filter((c) => c.method === "POST")).toEqual([]);
+  });
+
+  it("confirming installs once into the chosen profile", async () => {
+    const api = backend();
+    wrap(<CapabilitiesPage api={api} profile="default" pendingInstall="hub/zen" />);
+    await flush();
+    const button = within(screen.getByRole("dialog")).getByRole("button", {
+      name: "Install skill",
+    });
+    fireEvent.click(button);
+    fireEvent.click(button);
+    await flush();
+    const posts = api.calls.filter((c) => c.method === "POST");
+    expect(posts).toEqual([
+      expect.objectContaining({
+        path: "/api/skills/hub/install",
+        body: { identifier: "hub/zen" },
+        profile: "default",
+      }),
+    ]);
+    expect(screen.getByRole("status").textContent).toContain("zen was installed");
+  });
+
+  it("plugin rows badge agent, desktop and both from fixture data", async () => {
+    const api = backend();
+    const desktop = new StubDesktopPlugins([
+      { id: "d1", name: "weather", version: "2.0.0", enabled: true },
+      { id: "d2", name: "canvas", enabled: true },
+    ]);
+    wrap(
+      <CapabilitiesPage
+        api={api}
+        desktopPlugins={desktop}
+        profile="default"
+        initialTab="plugins"
+      />,
+    );
+    await flush();
+    const badge = (name: string) =>
+      screen
+        .getByTestId(`plugin-${name}`)
+        .querySelector("[data-badge]")
+        ?.getAttribute("data-badge");
+    expect(badge("weather")).toBe("both");
+    expect(badge("tides")).toBe("agent");
+    expect(badge("canvas")).toBe("desktop");
+  });
+
+  it("a plugin install needs a full commit pin", async () => {
+    const api = backend();
+    api.route("POST", "/api/plugins/install", { ok: true, name: "x", sha: SHA });
+    wrap(<CapabilitiesPage api={api} profile="default" initialTab="plugins" />);
+    await flush();
+    fireEvent.change(screen.getByRole("textbox", { name: /Repository/ }), {
+      target: { value: "acme/tool" },
+    });
+    fireEvent.change(screen.getByRole("textbox", { name: /Commit/ }), {
+      target: { value: "abc123" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: "Install" }));
+    await flush();
+    expect(screen.getByRole("alert").textContent).toContain("40-character");
+    expect(api.calls.some((c) => c.path === "/api/plugins/install")).toBe(false);
+    fireEvent.change(screen.getByRole("textbox", { name: /Commit/ }), { target: { value: SHA } });
+    fireEvent.click(screen.getByRole("button", { name: "Install" }));
+    await flush();
+    expect(api.calls.find((c) => c.path === "/api/plugins/install")?.body).toEqual({
+      url: "acme/tool",
+      sha: SHA,
+    });
+  });
+
+  it("toggles and counts", async () => {
+    const api = backend();
+    api.route("POST", "/api/skills/toggle", { ok: true });
+    const summary = vi.fn(async () => ({
+      skills: { total: 3, enabled: 2 },
+      toolsets: { total: 9, enabled: 4 },
+      mcp_servers: { total: 0, enabled: 0 },
+      plugins: { total: 2, enabled: 1 },
+    }));
+    wrap(<CapabilitiesPage api={api} profile="default" summary={summary} />);
+    await flush();
+    expect(screen.getByRole("tab", { name: /Skills/ }).textContent).toContain("2 of 3 on");
+    fireEvent.click(screen.getByRole("switch", { name: "brew-tea is on" }));
+    await flush();
+    expect(api.calls.find((c) => c.path === "/api/skills/toggle")?.body).toEqual({
+      name: "brew-tea",
+      enabled: false,
+    });
+  });
+
+  it("mergePlugins keeps one row per name", () => {
+    const rows = mergePlugins(
+      [{ name: "b", version: null, description: "", enabled: true, sha: null }],
+      [
+        { id: "1", name: "a", enabled: true },
+        { id: "2", name: "b", enabled: false },
+      ],
+    );
+    expect(rows.map((r) => [r.name, r.badge])).toEqual([
+      ["a", "desktop"],
+      ["b", "both"],
+    ]);
+  });
+});
diff --git a/apps/desktop/src/app/capabilities/CapabilitiesPage.tsx b/apps/desktop/src/app/capabilities/CapabilitiesPage.tsx
new file mode 100644
index 0000000..4517ce2
--- /dev/null
+++ b/apps/desktop/src/app/capabilities/CapabilitiesPage.tsx
@@ -0,0 +1,211 @@
+// The Capabilities page (P24-26) at the reserved `capabilities` route (P20-15): Skills, Toolsets,
+// Connectors and Plugins for one profile, picked with the scope selector.
+//
+// Profile-scoped tabs are keyed by the profile, so a switch remounts them and they reload for the
+// new profile; the Desktop column of the Plugins tab is app-level and is read once per page, never
+// again on a switch. The pills count each kind (`capabilities.summary` when the daemon serves it,
+// passed in as `summary`; else no count). `?tab=skills&install=<identifier>` (an install deep link)
+// opens the Skills tab with a confirmation first.
+
+import { useEffect, useState } from "react";
+import { useLocation } from "react-router";
+import { type MessageKey, useT } from "../../i18n/index.tsx";
+import { bridgeRest, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { desktopBridge } from "../bridge.ts";
+import {
+  ConnectorsTab,
+  type DesktopPluginRow,
+  type DesktopPluginSource,
+  PluginsTab,
+  SkillsTab,
+  ToolsetsTab,
+} from "./tabs.tsx";
+
+export const CAPABILITY_TABS = ["skills", "toolsets", "connectors", "plugins"] as const;
+export type CapabilityTab = (typeof CAPABILITY_TABS)[number];
+
+const TAB_KEYS: Record<CapabilityTab, MessageKey> = {
+  skills: "capabilities.tab.skills",
+  toolsets: "capabilities.tab.toolsets",
+  connectors: "capabilities.tab.connectors",
+  plugins: "capabilities.tab.plugins",
+};
+
+/** `capabilities.summary`'s answer (P24-26 backend). */
+export interface CapabilitySummary {
+  skills: { total: number; enabled: number };
+  toolsets: { total: number; enabled: number };
+  mcp_servers: { total: number; enabled: number };
+  plugins: { total: number; enabled: number };
+}
+
+const SUMMARY_FIELD: Record<CapabilityTab, keyof CapabilitySummary> = {
+  skills: "skills",
+  toolsets: "toolsets",
+  connectors: "mcp_servers",
+  plugins: "plugins",
+};
+
+export interface CapabilitiesPageProps {
+  api?: RestLike | null;
+  /** The app-level desktop plugins (U3, P24-32); none: an empty Desktop column. */
+  desktopPlugins?: DesktopPluginSource | null;
+  /** The profile to start with (the window's foreground profile). */
+  profile?: string;
+  initialTab?: CapabilityTab;
+  pendingInstall?: string | null;
+  summary?: (profile: string) => Promise<CapabilitySummary | null>;
+  openUrl?: (url: string) => void;
+}
+
+export function CapabilitiesPage(props: CapabilitiesPageProps) {
+  const t = useT();
+  const api = props.api === undefined ? bridgeRest() : props.api;
+  const [tab, setTab] = useState<CapabilityTab>(props.initialTab ?? "skills");
+  const [profile, setProfile] = useState(props.profile ?? "default");
+  const [profiles, setProfiles] = useState<string[]>([props.profile ?? "default"]);
+  const [desktop, setDesktop] = useState<DesktopPluginRow[]>([]);
+  const [counts, setCounts] = useState<CapabilitySummary | null>(null);
+  const [pending, setPending] = useState<string | null>(props.pendingInstall ?? null);
+
+  // the profile list is read once per page (the starting profile stays in it)
+  // biome-ignore lint/correctness/useExhaustiveDependencies: once per page and api
+  useEffect(() => {
+    let live = true;
+    void rest<{ profiles?: { name: string }[] }>(api, "GET", "/api/profiles").then((answer) => {
+      if (!live || !answer.ok) return;
+      const names = (answer.data.profiles ?? []).map((p) => p.name).filter(Boolean);
+      if (names.length > 0) setProfiles(names.includes(profile) ? names : [profile, ...names]);
+    });
+    return () => {
+      live = false;
+    };
+  }, [api]);
+
+  // the Desktop column: app-level, read once (a profile switch never reloads it)
+  useEffect(() => {
+    let live = true;
+    void props.desktopPlugins
+      ?.list()
+      .then((rows) => {
+        if (live) setDesktop(rows);
+      })
+      .catch(() => {});
+    return () => {
+      live = false;
+    };
+  }, [props.desktopPlugins]);
+
+  const { summary } = props;
+  useEffect(() => {
+    let live = true;
+    setCounts(null);
+    void summary?.(profile)
+      .then((value) => {
+        if (live) setCounts(value);
+      })
+      .catch(() => {});
+    return () => {
+      live = false;
+    };
+  }, [summary, profile]);
+
+  useEffect(() => {
+    if (props.pendingInstall) {
+      setPending(props.pendingInstall);
+      setTab("skills");
+    }
+  }, [props.pendingInstall]);
+
+  const scoped = `${tab}-${profile}`;
+  const openUrl =
+    props.openUrl ??
+    ((url: string) =>
+      void desktopBridge()
+        ?.external.open({ url })
+        .catch(() => {}));
+
+  return (
+    <section className="flex h-full min-h-0 flex-col" aria-labelledby="page-capabilities">
+      <header className="flex items-center gap-3 border-b border-line px-4 py-2">
+        <h1 id="page-capabilities" className="text-base font-semibold">
+          {t("nav.capabilities")}
+        </h1>
+        <div role="tablist" aria-label={t("capabilities.tabs")} className="flex gap-1">
+          {CAPABILITY_TABS.map((id) => {
+            const count = counts?.[SUMMARY_FIELD[id]];
+            return (
+              <button
+                key={id}
+                type="button"
+                role="tab"
+                aria-selected={tab === id}
+                className={`rounded px-2 py-0.5 text-sm ${tab === id ? "bg-raised text-fg" : "text-muted hover:text-fg"}`}
+                onClick={() => setTab(id)}
+              >
+                {t(TAB_KEYS[id])}
+                {count !== undefined ? (
+                  <span className="ml-1 text-xs text-muted">
+                    {t("capabilities.count", { enabled: count.enabled, total: count.total })}
+                  </span>
+                ) : null}
+              </button>
+            );
+          })}
+        </div>
+        {profiles.length > 1 ? (
+          <label className="ml-auto flex items-center gap-1 text-xs text-muted">
+            {t("capabilities.scope")}
+            <select
+              className="rounded border border-line bg-bg px-1 py-0.5 text-sm text-fg"
+              value={profile}
+              onChange={(event) => setProfile(event.target.value)}
+            >
+              {profiles.map((name) => (
+                <option key={name} value={name}>
+                  {name}
+                </option>
+              ))}
+            </select>
+          </label>
+        ) : null}
+      </header>
+      <div role="tabpanel" className="min-h-0 flex-1 overflow-auto">
+        {tab === "skills" ? (
+          <SkillsTab
+            key={scoped}
+            api={api}
+            profile={profile}
+            pendingInstall={pending}
+            onPendingDone={() => setPending(null)}
+          />
+        ) : tab === "toolsets" ? (
+          <ToolsetsTab key={scoped} api={api} profile={profile} />
+        ) : tab === "connectors" ? (
+          <ConnectorsTab key={scoped} api={api} profile={profile} openUrl={openUrl} />
+        ) : (
+          <PluginsTab key={scoped} api={api} profile={profile} desktop={desktop} />
+        )}
+      </div>
+    </section>
+  );
+}
+
+/** The route's page: `?tab=` and `?install=` from the address, the window's profile. */
+export function CapabilitiesRoute(
+  props: Omit<CapabilitiesPageProps, "initialTab" | "pendingInstall">,
+) {
+  const location = useLocation();
+  const query = new URLSearchParams(location.search);
+  const tab = query.get("tab");
+  const install = query.get("install");
+  return (
+    <CapabilitiesPage
+      {...props}
+      {...(CAPABILITY_TABS.includes(tab as CapabilityTab)
+        ? { initialTab: tab as CapabilityTab }
+        : {})}
+      pendingInstall={install !== null && install.trim() !== "" ? install.trim() : null}
+    />
+  );
+}
