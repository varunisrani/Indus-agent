new file mode 100644
index 0000000..27cda40
--- /dev/null
+++ b/apps/desktop/electron/windows/petWindow.test.ts
@@ -0,0 +1,315 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import { fileAppOrigin } from "../appOrigin.ts";
+import type { MainContext } from "../context.ts";
+import { type IpcMainLike, IpcRegistry } from "../ipc/registry.ts";
+import type { FrameLike, IpcEventLike } from "../ipc/senderCheck.ts";
+import type { BrowserWindowLike, WebContentsLike } from "./manager.ts";
+import { WindowManager } from "./manager.ts";
+import {
+  installPetWindow,
+  PET_BUBBLE_MS,
+  PET_FULLSCREEN_POLL_MS,
+  PetController,
+  type PetWindowLike,
+} from "./petWindow.ts";
+import { installWakeIndicator } from "./wakeIndicator.ts";
+
+type Handler = (...args: unknown[]) => void;
+const AREA = { x: 0, y: 25, width: 1440, height: 875 };
+const PNG = "data:image/png;base64,iVBORw0KGgo=";
+
+let nextId = 500;
+function fakeWindow(options: Record<string, unknown> = {}) {
+  const handlers = new Map<string, Handler[]>();
+  let url = "";
+  let destroyed = false;
+  let fullscreen = false;
+  let focused = false;
+  const contents: WebContentsLike = {
+    id: nextId++,
+    on: () => contents,
+    reload: vi.fn(),
+    getURL: () => url,
+    getZoomLevel: () => 0,
+    setZoomLevel: vi.fn(),
+    isDestroyed: () => destroyed,
+    send: vi.fn(),
+  };
+  const win = {
+    options,
+    webContents: contents,
+    on: (event: string, fn: Handler) => {
+      handlers.set(event, [...(handlers.get(event) ?? []), fn]);
+      return win;
+    },
+    emit: (event: string) => {
+      for (const fn of handlers.get(event) ?? []) fn();
+    },
+    loadURL: vi.fn(async (next: string) => {
+      url = next;
+    }),
+    show: vi.fn(),
+    showInactive: vi.fn(),
+    hide: vi.fn(),
+    focus: vi.fn(),
+    restore: vi.fn(),
+    minimize: vi.fn(),
+    maximize: vi.fn(),
+    unmaximize: vi.fn(),
+    close: vi.fn(() => {
+      destroyed = true;
+      win.emit("closed");
+    }),
+    setBounds: vi.fn(),
+    setIgnoreMouseEvents: vi.fn(),
+    setAlwaysOnTop: vi.fn(),
+    setVisibleOnAllWorkspaces: vi.fn(),
+    isDestroyed: () => destroyed,
+    isVisible: () => false,
+    isMinimized: () => false,
+    isMaximized: () => false,
+    isFullScreen: () => fullscreen,
+    isFocused: () => focused,
+    setFullscreen: (on: boolean) => {
+      fullscreen = on;
+      focused = on;
+    },
+    getNormalBounds: () => ({ x: 0, y: 0, width: 800, height: 600 }),
+  };
+  return win;
+}
+
+type FakeWin = ReturnType<typeof fakeWindow>;
+
+class Timers extends FakeTimers {
+  setInterval = (fn: () => void, ms: number): unknown => {
+    const tick = () => {
+      fn();
+      handle.id = this.setTimeout(tick, ms);
+    };
+    const handle = { id: this.setTimeout(tick, ms) };
+    return handle;
+  };
+  clearInterval = (handle: unknown): void => {
+    this.clearTimeout((handle as { id: unknown }).id);
+  };
+}
+
+function controller(options: { fullscreen?: () => boolean } = {}) {
+  const timers = new Timers();
+  const made: FakeWin[] = [];
+  const views: unknown[] = [];
+  const kinds = new Map<number, string>();
+  const pet = new PetController({
+    create: (bounds) => {
+      const win = fakeWindow({ bounds });
+      made.push(win);
+      kinds.set(win.webContents.id, "pet");
+      return win as unknown as PetWindowLike;
+    },
+    screen: { getPrimaryDisplay: () => ({ workArea: AREA }) },
+    kindOf: (id) => kinds.get(id) ?? null,
+    fullscreenFocused: options.fullscreen ?? (() => false),
+    emit: (_win, view) => views.push(view),
+    timers,
+    platform: "darwin",
+    log: vi.fn(),
+  });
+  return { pet, timers, made, views, kinds };
+}
+
+const pictures = { name: "Otto", scale: 1, revision: "r1", moods: { rest: PNG, walk: PNG } };
+
+describe("PetController", () => {
+  it("opens one click-through overlay over the work area and pushes the pictures", () => {
+    const { pet, made, views } = controller();
+    expect(pet.show(pictures)).toEqual({ visible: true });
+    expect(pet.show(pictures)).toEqual({ visible: true });
+    expect(made).toHaveLength(1);
+    const win = made[0] as FakeWin;
+    expect(win.options).toEqual({ bounds: AREA });
+    expect(win.setIgnoreMouseEvents).toHaveBeenCalledWith(true, { forward: true });
+    expect(win.setVisibleOnAllWorkspaces).toHaveBeenCalledWith(true, {
+      visibleOnFullScreen: false,
+    });
+    expect(views.at(-1)).toMatchObject({ visible: true, name: "Otto", moods: pictures.moods });
+    expect(win.focus).not.toHaveBeenCalled();
+  });
+
+  it("only the figure takes clicks", () => {
+    const { pet, made } = controller();
+    pet.show(pictures);
+    const win = made[0] as FakeWin;
+    pet.pointer(true);
+    pet.pointer(true);
+    expect(win.setIgnoreMouseEvents).toHaveBeenLastCalledWith(false, {});
+    pet.pointer(false);
+    expect(win.setIgnoreMouseEvents).toHaveBeenLastCalledWith(true, { forward: true });
+    expect(win.setIgnoreMouseEvents).toHaveBeenCalledTimes(3);
+  });
+
+  it("hides while a full-screen window is focused and comes back after", () => {
+    let full = false;
+    const { pet, made, timers, views } = controller({ fullscreen: () => full });
+    pet.show(pictures);
+    const win = made[0] as FakeWin;
+    full = true;
+    timers.advance(PET_FULLSCREEN_POLL_MS);
+    expect(win.hide).toHaveBeenCalledTimes(1);
+    expect(views.at(-1)).toMatchObject({ visible: false });
+    full = false;
+    timers.advance(PET_FULLSCREEN_POLL_MS);
+    expect(win.showInactive).toHaveBeenCalledTimes(1);
+    expect(views.at(-1)).toMatchObject({ visible: true });
+  });
+
+  it("the bubble clears itself; hide closes the overlay and stops polling", () => {
+    const { pet, made, timers, views } = controller();
+    pet.show(pictures);
+    pet.say("  Reading the tests…  ");
+    expect(views.at(-1)).toMatchObject({ bubble: "Reading the tests…" });
+    timers.advance(PET_BUBBLE_MS);
+    expect(views.at(-1)).toMatchObject({ bubble: null });
+    pet.hide();
+    expect(made[0]?.close).toHaveBeenCalled();
+    expect(timers.pending()).toBe(0);
+    expect(pet.view()).toMatchObject({ visible: false, name: null });
+  });
+});
+
+// -- the channels behind the registry's sender checks (D-16.18) ------------------------------------
+
+const ORIGIN = fileAppOrigin("/opt/Indus/dist/index.html", "linux");
+type Listener = (event: IpcEventLike, ...args: unknown[]) => unknown;
+
+function frame(url: string): FrameLike {
+  return { url, processId: 7, routingId: 1, frameTreeNodeId: 1 };
+}
+
+function eventFrom(win: BrowserWindowLike, type = "window"): IpcEventLike {
+  const main = frame(win.webContents.getURL());
+  return {
+    sender: { id: win.webContents.id, mainFrame: main, getType: () => type },
+    senderFrame: main,
+  };
+}
+
+const dirs: string[] = [];
+afterEach(() => {
+  for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function app() {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "indus-pet-"));
+  dirs.push(dir);
+  const timers = new Timers();
+  const handles = new Map<string, Listener>();
+  const ons = new Map<string, Listener>();
+  const ipc: IpcMainLike = {
+    handle: (channel, listener) => {
+      handles.set(channel, listener as Listener);
+    },
+    on: (channel, listener) => {
+      ons.set(channel, listener as Listener);
+      return ipc;
+    },
+  };
+  let windows: WindowManager | null = null;
+  const registry = new IpcRegistry({
+    ipc,
+    policy: {
+      appOrigin: ORIGIN,
+      isKnownWebContents: (id) => windows?.isKnownWebContents(id) ?? false,
+    },
+    log: vi.fn(),
+  });
+  const created: FakeWin[] = [];
+  windows = new WindowManager({
+    createWindow: (options) => {
+      const win = fakeWindow(options);
+      created.push(win);
+      return win as unknown as BrowserWindowLike;
+    },
+    screen: {
+      getAllDisplays: () => [{ workArea: AREA }],
+      getPrimaryDisplay: () => ({ workArea: AREA }),
+    },
+    appOrigin: ORIGIN,
+    preloadPath: "/opt/Indus/preload.cjs",
+    dev: false,
+    platform: "linux",
+    title: "Indus",
+    windowStatePath: path.join(dir, "w.json"),
+    zoomStatePath: path.join(dir, "z.json"),
+    timers,
+    now: timers.clock,
+    log: vi.fn(),
+    prepareContents: () => {},
+    emitWindowState: () => {},
+    emitZoom: () => {},
+  });
+  const context = {
+    registry,
+    windows,
+    platform: "linux",
+    log: { write: vi.fn() },
+  } as unknown as MainContext;
+  const screen = { getPrimaryDisplay: () => ({ workArea: AREA }) };
+  const pet = installPetWindow(context, { screen });
+  const wake = installWakeIndicator(context, { screen });
+  registry.seal();
+  const main = windows.openMain();
+  return { handles, ons, windows, pet, wake, main, created };
+}
+
+describe("pet and wake channels pass the sender checks", () => {
+  it("an app window shows the pet but may not read the pet window's state", async () => {
+    const { handles, main } = app();
+    const show = handles.get("indus:pet:show") as Listener;
+    expect(await show(eventFrom(main), pictures)).toEqual({ ok: true, value: { visible: true } });
+    const get = handles.get("indus:pet:get") as Listener;
+    expect(await get(eventFrom(main))).toMatchObject({ ok: false, code: "sender-rejected" });
+  });
+
+  it("from the real pet window: get works, pointer works, show is refused", async () => {
+    const { handles, ons, main, pet, created } = app();
+    await (handles.get("indus:pet:show") as Listener)(eventFrom(main), pictures);
+    const petWin = created.find((w) => w.webContents.id === pet.contentsId()) as FakeWin;
+    expect(petWin.webContents.getURL()).toContain("win=pet");
+    const fromPet = eventFrom(petWin as unknown as BrowserWindowLike);
+    const got = await (handles.get("indus:pet:get") as Listener)(fromPet);
+    expect(got).toMatchObject({ ok: true, value: { visible: true, name: "Otto" } });
+    (ons.get("indus:pet:pointer") as Listener)(fromPet, { over: true });
+    expect(petWin.setIgnoreMouseEvents).toHaveBeenLastCalledWith(false, {});
+    const refused = await (handles.get("indus:pet:show") as Listener)(fromPet, pictures);
+    expect(refused).toMatchObject({ ok: false, code: "sender-rejected" });
+    const guest = eventFrom(petWin as unknown as BrowserWindowLike, "webview");
+    expect(await (handles.get("indus:pet:get") as Listener)(guest)).toMatchObject({
+      ok: false,
+      code: "sender-rejected",
+    });
+  });
+
+  it("a bad mood picture is a bad request", async () => {
+    const { handles, main } = app();
+    const answer = await (handles.get("indus:pet:show") as Listener)(eventFrom(main), {
+      ...pictures,
+      moods: { rest: "javascript:alert(1)" },
+    });
+    expect(answer).toMatchObject({ ok: false, code: "bad-request" });
+  });
+
+  it("overlays close with the last app window", async () => {
+    const { handles, ons, main, pet, wake } = app();
+    await (handles.get("indus:pet:show") as Listener)(eventFrom(main), pictures);
+    (ons.get("indus:wake:indicator") as Listener)(eventFrom(main), { state: "listening" });
+    expect(wake.state()).toBe("listening");
+    main.close();
+    expect(pet.contentsId()).toBeNull();
+    expect(wake.state()).toBe("hidden");
+  });
+});
diff --git a/apps/desktop/electron/windows/petWindow.ts b/apps/desktop/electron/windows/petWindow.ts
new file mode 100644
index 0000000..932f51d
--- /dev/null
+++ b/apps/desktop/electron/windows/petWindow.ts
@@ -0,0 +1,290 @@
+// The desktop pet overlay (P24-19): one transparent window over the primary display's work area,
+// created by the window manager as kind `pet`. Main owns where it is and whether it shows; the pet
+// window's renderer draws the figure, wanders inside the window (`src/pet/roam.ts`) and says when
+// the pointer is over the figure — main then lets that one area take clicks and keeps the rest of
+// the window click-through (`setIgnoreMouseEvents(true, { forward: true })` so pointer moves still
+// reach the page).
+//
+// - App windows (main / secondary / instance) show it with the pet's pictures (`pet:show`, fetched
+//   from the daemon's `pet.info`), hide it, and give it a short status line (`pet:say`); only the
+//   pet window may report the pointer or read its state. Every channel is a registry channel, so the
+//   sender checks of P20-03 apply on top of these kind checks (D-16.18).
+// - The overlay never takes focus (factory: `focusable: false`) and is hidden while one of our
+//   windows is full screen and focused; on macOS it is not shown on full-screen spaces at all.
+// - The speech bubble clears itself after `PET_BUBBLE_MS`.
+
+import type { MainContext } from "../context.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import type { PayloadOf } from "../ipc/schemas.ts";
+import type { BrowserWindowLike } from "./manager.ts";
+import type { DisplayLike, Rect } from "./windowState.ts";
+
+export const PET_BUBBLE_MS = 6_000;
+export const PET_FULLSCREEN_POLL_MS = 1_000;
+
+export type PetView = PayloadOf<"indus:pet:state">;
+
+export interface PetWindowLike extends BrowserWindowLike {
+  setBounds(bounds: Rect): void;
+  hide(): void;
+  showInactive?(): void;
+  setIgnoreMouseEvents(ignore: boolean, options?: { forward?: boolean }): void;
+  setVisibleOnAllWorkspaces?(visible: boolean, options?: Record<string, boolean>): void;
+  setAlwaysOnTop?(flag: boolean, level?: string): void;
+}
+
+export interface PetScreen {
+  getPrimaryDisplay(): DisplayLike;
+  on?(event: "display-metrics-changed" | "display-added" | "display-removed", fn: () => void): void;
+}
+
+export interface Timers {
+  setTimeout(fn: () => void, ms: number): unknown;
+  clearTimeout(handle: unknown): void;
+  setInterval(fn: () => void, ms: number): unknown;
+  clearInterval(handle: unknown): void;
+}
+
+export interface PetDeps {
+  create(bounds: Rect): PetWindowLike;
+  screen: PetScreen;
+  /** The window kind of a web contents (`windows.kindOf`). */
+  kindOf(contentsId: number): string | null;
+  /** True while one of our windows is full screen and focused. */
+  fullscreenFocused(): boolean;
+  emit(win: PetWindowLike, view: PetView): void;
+  timers: Timers;
+  platform: string;
+  log(line: string): void;
+}
+
+export interface PetPictures {
+  name: string;
+  scale: number;
+  revision: string;
+  moods: Record<string, string>;
+}
+
+const APP_KINDS: ReadonlySet<string> = new Set(["main", "secondary", "instance"]);
+
+export class PetController {
+  private readonly deps: PetDeps;
+  private win: PetWindowLike | null = null;
+  private pictures: PetPictures | null = null;
+  private bubble: string | null = null;
+  private bubbleTimer: unknown = null;
+  private poll: unknown = null;
+  private hiddenForFullscreen = false;
+  private clickable = false;
+
+  constructor(deps: PetDeps) {
+    this.deps = deps;
+    deps.screen.on?.("display-metrics-changed", () => this.place());
+    deps.screen.on?.("display-removed", () => this.place());
+  }
+
+  /** The pet window's web contents id, or null. */
+  contentsId(): number | null {
+    return this.win !== null && !this.win.isDestroyed() ? this.win.webContents.id : null;
+  }
+
+  view(): PetView {
+    const pictures = this.pictures;
+    return {
+      visible: pictures !== null && !this.hiddenForFullscreen,
+      name: pictures?.name ?? null,
+      scale: pictures?.scale ?? 1,
+      revision: pictures?.revision ?? null,
+      moods: pictures?.moods ?? {},
+      bubble: this.bubble,
+    };
+  }
+
+  /** Only app windows may show, hide or speak through the pet. */
+  requireApp(senderId: number): void {
+    const kind = this.deps.kindOf(senderId);
+    if (kind === null || !APP_KINDS.has(kind)) {
+      throw new IpcError("sender-rejected", "only an app window may drive the pet");
+    }
+  }
+
+  /** Only the pet window reads its state and reports the pointer. */
+  requirePet(senderId: number): void {
+    if (this.deps.kindOf(senderId) !== "pet" || senderId !== this.contentsId()) {
+      throw new IpcError("sender-rejected", "only the pet window may do this");
+    }
+  }
+
+  show(pictures: PetPictures): { visible: boolean } {
+    this.pictures = pictures;
+    if (this.win === null || this.win.isDestroyed()) this.open();
+    this.refresh();
+    this.push();
+    return { visible: this.view().visible };
+  }
+
+  hide(): { visible: boolean } {
+    this.pictures = null;
+    this.clearBubble();
+    this.stopPolling();
+    const win = this.win;
+    this.win = null;
+    if (win !== null && !win.isDestroyed()) win.close();
+    return { visible: false };
+  }
+
+  say(text: string): void {
+    const line = text.trim();
+    this.clearBubble();
+    this.bubble = line === "" ? null : line;
+    if (this.bubble !== null) {
+      this.bubbleTimer = this.deps.timers.setTimeout(() => {
+        this.bubbleTimer = null;
+        this.bubble = null;
+        this.push();
+      }, PET_BUBBLE_MS);
+    }
+    this.push();
+  }
+
+  /** The pointer entered or left the figure: only the figure takes clicks. */
+  pointer(over: boolean): void {
+    const win = this.win;
+    if (win === null || win.isDestroyed() || over === this.clickable) return;
+    this.clickable = over;
+    win.setIgnoreMouseEvents(!over, over ? {} : { forward: true });
+  }
+
+  /** Hide while a full-screen window of ours is focused; come back after. */
+  refresh(): void {
+    const win = this.win;
+    if (win === null || win.isDestroyed()) return;
+    const hide = this.deps.fullscreenFocused();
+    if (hide === this.hiddenForFullscreen) return;
+    this.hiddenForFullscreen = hide;
+    if (hide) win.hide();
+    else if (win.showInactive !== undefined) win.showInactive();
+    else win.show();
+    this.push();
+  }
+
+  private open(): void {
+    const area = this.deps.screen.getPrimaryDisplay().workArea;
+    const win = this.deps.create({ ...area });
+    this.win = win;
+    this.clickable = false;
+    this.hiddenForFullscreen = false;
+    win.setIgnoreMouseEvents(true, { forward: true });
+    try {
+      win.setAlwaysOnTop?.(true, this.deps.platform === "darwin" ? "floating" : "screen-saver");
+      // Not on other apps' full-screen spaces (macOS): the OS hides it there.
+      win.setVisibleOnAllWorkspaces?.(true, { visibleOnFullScreen: false });
+    } catch {
+      // window managers without these keep the plain always-on-top window
+    }
+    win.on("closed", () => {
+      if (this.win === win) {
+        this.win = null;
+        this.stopPolling();
+      }
+    });
+    this.startPolling();
+    this.deps.log("[pet] overlay opened");
+  }
+
+  private place(): void {
+    const win = this.win;
+    if (win === null || win.isDestroyed()) return;
+    win.setBounds({ ...this.deps.screen.getPrimaryDisplay().workArea });
+    this.push();
+  }
+
+  private push(): void {
+    const win = this.win;
+    if (win !== null && !win.isDestroyed()) this.deps.emit(win, this.view());
+  }
+
+  private clearBubble(): void {
+    if (this.bubbleTimer !== null) {
+      this.deps.timers.clearTimeout(this.bubbleTimer);
+      this.bubbleTimer = null;
+    }
+    this.bubble = null;
+  }
+
+  private startPolling(): void {
+    if (this.poll !== null) return;
+    this.poll = this.deps.timers.setInterval(() => this.refresh(), PET_FULLSCREEN_POLL_MS);
+  }
+
+  private stopPolling(): void {
+    if (this.poll === null) return;
+    this.deps.timers.clearInterval(this.poll);
+    this.poll = null;
+  }
+}
+
+/** Close an overlay with the last app window, so it never keeps the app running on its own. */
+export function closeWithLastAppWindow(
+  windows: Pick<MainContext["windows"], "onWindowCreated" | "windows" | "kindOf">,
+  close: () => void,
+): void {
+  const appKinds = new Set(["main", "secondary", "instance"]);
+  windows.onWindowCreated((win, kind) => {
+    if (!appKinds.has(kind)) return;
+    win.on("closed", () => {
+      const left = windows
+        .windows()
+        .some((w) => !w.isDestroyed() && appKinds.has(windows.kindOf(w.webContents.id) ?? ""));
+      if (!left) close();
+    });
+  });
+}
+
+/** Main's pet install step: the controller and its six channels. */
+export function installPetWindow(
+  context: MainContext,
+  electron: { screen: PetScreen },
+): PetController {
+  const { registry, windows } = context;
+  const controller = new PetController({
+    create: (bounds) => windows.openPet(bounds) as PetWindowLike,
+    screen: electron.screen,
+    kindOf: (id) => windows.kindOf(id),
+    fullscreenFocused: () =>
+      windows.windows().some((w) => w.isFullScreen() && w.isFocused() && !w.isDestroyed()),
+    emit: (win, view) => {
+      registry.emit(win.webContents, "indus:pet:state", view);
+    },
+    timers: {
+      setTimeout: (fn, ms) => setTimeout(fn, ms),
+      clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+      setInterval: (fn, ms) => setInterval(fn, ms),
+      clearInterval: (handle) => clearInterval(handle as ReturnType<typeof setInterval>),
+    },
+    platform: context.platform,
+    log: (line) => context.log.write(line),
+  });
+  closeWithLastAppWindow(windows, () => controller.hide());
+  registry.handle("indus:pet:show", (pictures, { senderId }) => {
+    controller.requireApp(senderId);
+    return controller.show(pictures);
+  });
+  registry.handle("indus:pet:hide", (_payload, { senderId }) => {
+    controller.requireApp(senderId);
+    return controller.hide();
+  });
+  registry.on("indus:pet:say", ({ text }, { senderId }) => {
+    controller.requireApp(senderId);
+    controller.say(text);
+  });
+  registry.handle("indus:pet:get", (_payload, { senderId }) => {
+    controller.requirePet(senderId);
+    return controller.view();
+  });
+  registry.on("indus:pet:pointer", ({ over }, { senderId }) => {
+    controller.requirePet(senderId);
+    controller.pointer(over);
+  });
+  return controller;
+}
diff --git a/apps/desktop/electron/windows/wakeIndicator.test.ts b/apps/desktop/electron/windows/wakeIndicator.test.ts
new file mode 100644
index 0000000..c0cbba2
--- /dev/null
+++ b/apps/desktop/electron/windows/wakeIndicator.test.ts
@@ -0,0 +1,105 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  type IndicatorWindowLike,
+  indicatorBounds,
+  WAKE_INDICATOR_SIZE,
+  WakeIndicatorController,
+} from "./wakeIndicator.ts";
+
+let nextId = 900;
+function fakeWindow() {
+  const closed: Array<() => void> = [];
+  let destroyed = false;
+  return {
+    webContents: { id: nextId++ },
+    on: (event: string, fn: () => void) => {
+      if (event === "closed") closed.push(fn);
+    },
+    setBounds: vi.fn(),
+    hide: vi.fn(),
+    show: vi.fn(),
+    showInactive: vi.fn(),
+    focus: vi.fn(),
+    close: vi.fn(() => {
+      destroyed = true;
+      for (const fn of closed) fn();
+    }),
+    isDestroyed: () => destroyed,
+  };
+}
+
+function setup() {
+  const made: ReturnType<typeof fakeWindow>[] = [];
+  const emitted: string[] = [];
+  const kinds = new Map<number, string>([
+    [1, "main"],
+    [2, "hud"],
+    [3, "quick"],
+  ]);
+  const controller = new WakeIndicatorController({
+    create: () => {
+      const win = fakeWindow();
+      made.push(win);
+      kinds.set(win.webContents.id, "wake");
+      return win as unknown as IndicatorWindowLike;
+    },
+    screen: {
+      getPrimaryDisplay: () => ({ workArea: { x: 100, y: 30, width: 1600, height: 900 } }),
+    },
+    kindOf: (id) => kinds.get(id) ?? null,
+    emit: (_win, state) => emitted.push(state),
+  });
+  return { controller, made, emitted };
+}
+
+describe("wake indicator", () => {
+  it("sits at the top centre of the work area", () => {
+    expect(indicatorBounds({ workArea: { x: 100, y: 30, width: 1600, height: 900 } })).toEqual({
+      ...WAKE_INDICATOR_SIZE,
+      x: 100 + (1600 - WAKE_INDICATOR_SIZE.width) / 2,
+      y: 38,
+    });
+    const tiny = indicatorBounds({ workArea: { x: 0, y: 0, width: 100, height: 20 } });
+    expect(tiny).toEqual({ x: 0, y: 0, width: 100, height: 20 });
+  });
+
+  it("is made on the first visible state, hidden (not closed) on hidden, never focused", () => {
+    const { controller, made, emitted } = setup();
+    controller.set("hidden");
+    expect(made).toHaveLength(0);
+    controller.set("listening");
+    controller.set("heard");
+    controller.set("heard");
+    controller.set("capturing");
+    controller.set("hidden");
+    controller.set("listening");
+    expect(made).toHaveLength(1);
+    const win = made[0] as ReturnType<typeof fakeWindow>;
+    expect(win.hide).toHaveBeenCalledTimes(1);
+    expect(win.showInactive).toHaveBeenCalledTimes(3);
+    expect(win.focus).not.toHaveBeenCalled();
+    expect(emitted).toEqual(["listening", "heard", "capturing", "hidden", "listening"]);
+  });
+
+  it("only app windows set it and only the indicator reads it", () => {
+    const { controller, made } = setup();
+    expect(() => controller.requireApp(1)).not.toThrow();
+    expect(() => controller.requireApp(2)).not.toThrow();
+    expect(() => controller.requireApp(3)).toThrow(/only an app window/);
+    expect(() => controller.requireApp(77)).toThrow(/only an app window/);
+    controller.set("listening");
+    const id = made[0]?.webContents.id as number;
+    expect(() => controller.requireIndicator(id)).not.toThrow();
+    expect(() => controller.requireIndicator(1)).toThrow(/only the wake indicator/);
+  });
+
+  it("close forgets the window and the state", () => {
+    const { controller, made } = setup();
+    controller.set("capturing");
+    controller.close();
+    expect(made[0]?.close).toHaveBeenCalled();
+    expect(controller.state()).toBe("hidden");
+    controller.set("listening");
+    expect(made).toHaveLength(2);
+  });
+});
diff --git a/apps/desktop/electron/windows/wakeIndicator.ts b/apps/desktop/electron/windows/wakeIndicator.ts
new file mode 100644
index 0000000..db113df
--- /dev/null
+++ b/apps/desktop/electron/windows/wakeIndicator.ts
@@ -0,0 +1,136 @@
+// The wake-word indicator (P24-20): a small always-on-top light at the top centre of the primary
+// display, created by the window manager as kind `wake`. It is up whenever the microphone is in
+// use for the wake word — `listening`, `heard` (the phrase was just detected) and `capturing`
+// (voice mode records) — and hidden otherwise, so listening is never invisible to the person.
+//
+// App windows set the state (`wake:indicator`); the indicator window reads it once
+// (`wake:indicator-get`) and then follows `wake:indicator-state`. The window is made on the first
+// visible state, never takes focus, and is hidden (not closed) on `hidden`.
+
+import type { MainContext } from "../context.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import type { PayloadOf } from "../ipc/schemas.ts";
+import type { BrowserWindowLike } from "./manager.ts";
+import { closeWithLastAppWindow } from "./petWindow.ts";
+import type { DisplayLike, Rect } from "./windowState.ts";
+
+export const WAKE_INDICATOR_SIZE = { width: 184, height: 44 } as const;
+/** Gap between the top of the work area and the light. */
+export const WAKE_INDICATOR_TOP = 8;
+
+export type WakeIndicatorState = PayloadOf<"indus:wake:indicator-state">["state"];
+
+export interface IndicatorWindowLike extends BrowserWindowLike {
+  setBounds(bounds: Rect): void;
+  hide(): void;
+  showInactive?(): void;
+}
+
+export interface IndicatorDeps {
+  create(bounds: Rect): IndicatorWindowLike;
+  screen: { getPrimaryDisplay(): DisplayLike };
+  kindOf(contentsId: number): string | null;
+  emit(win: IndicatorWindowLike, state: WakeIndicatorState): void;
+}
+
+const APP_KINDS: ReadonlySet<string> = new Set(["main", "secondary", "instance", "hud"]);
+
+/** Where the light sits on a display: centred, just under the top of the work area. */
+export function indicatorBounds(display: DisplayLike): Rect {
+  const area = display.workArea;
+  const width = Math.min(WAKE_INDICATOR_SIZE.width, area.width);
+  const height = Math.min(WAKE_INDICATOR_SIZE.height, area.height);
+  return {
+    width,
+    height,
+    x: Math.round(area.x + (area.width - width) / 2),
+    y: area.y + Math.min(WAKE_INDICATOR_TOP, Math.max(0, area.height - height)),
+  };
+}
+
+export class WakeIndicatorController {
+  private readonly deps: IndicatorDeps;
+  private win: IndicatorWindowLike | null = null;
+  private current: WakeIndicatorState = "hidden";
+
+  constructor(deps: IndicatorDeps) {
+    this.deps = deps;
+  }
+
+  state(): WakeIndicatorState {
+    return this.current;
+  }
+
+  requireApp(senderId: number): void {
+    const kind = this.deps.kindOf(senderId);
+    if (kind === null || !APP_KINDS.has(kind)) {
+      throw new IpcError("sender-rejected", "only an app window may set the wake indicator");
+    }
+  }
+
+  requireIndicator(senderId: number): void {
+    const win = this.win;
+    if (this.deps.kindOf(senderId) !== "wake" || win === null || win.webContents.id !== senderId) {
+      throw new IpcError("sender-rejected", "only the wake indicator reads its state");
+    }
+  }
+
+  set(state: WakeIndicatorState): void {
+    if (state === this.current) return;
+    this.current = state;
+    let win = this.win !== null && !this.win.isDestroyed() ? this.win : null;
+    if (state === "hidden") {
+      if (win !== null) {
+        this.deps.emit(win, state);
+        win.hide();
+      }
+      return;
+    }
+    if (win === null) {
+      win = this.deps.create(indicatorBounds(this.deps.screen.getPrimaryDisplay()));
+      this.win = win;
+      const made = win;
+      made.on("closed", () => {
+        if (this.win === made) this.win = null;
+      });
+    } else {
+      win.setBounds(indicatorBounds(this.deps.screen.getPrimaryDisplay()));
+      if (win.showInactive !== undefined) win.showInactive();
+      else win.show();
+    }
+    this.deps.emit(win, state);
+  }
+
+  close(): void {
+    const win = this.win;
+    this.win = null;
+    this.current = "hidden";
+    if (win !== null && !win.isDestroyed()) win.close();
+  }
+}
+
+/** Main's wake-indicator install step. */
+export function installWakeIndicator(
+  context: MainContext,
+  electron: { screen: { getPrimaryDisplay(): DisplayLike } },
+): WakeIndicatorController {
+  const { registry, windows } = context;
+  const controller = new WakeIndicatorController({
+    create: (bounds) => windows.openWakeIndicator(bounds) as IndicatorWindowLike,
+    screen: electron.screen,
+    kindOf: (id) => windows.kindOf(id),
+    emit: (win, state) => {
+      registry.emit(win.webContents, "indus:wake:indicator-state", { state });
+    },
+  });
+  closeWithLastAppWindow(windows, () => controller.close());
+  registry.on("indus:wake:indicator", ({ state }, { senderId }) => {
+    controller.requireApp(senderId);
+    controller.set(state);
+  });
+  registry.handle("indus:wake:indicator-get", (_payload, { senderId }) => {
+    controller.requireIndicator(senderId);
+    return { state: controller.state() };
+  });
+  return controller;
+}
