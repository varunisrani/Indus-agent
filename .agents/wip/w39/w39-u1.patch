+    expect(batches[0]?.label).toBe("section.pricing");
+    expect(batches[0]?.pins.map((p) => p.number)).toEqual([1, 2]);
+  });
+
+  it("disjoint subtrees stay apart, nested pins join their container, loose pins trail", () => {
+    const batches = groupPins([
