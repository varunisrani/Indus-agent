+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { presetTheme } from "@indus/ui";
+import { describe, expect, it, vi } from "vitest";
+import { fakeRest } from "../settings/fakeRest.ts";
+import { installMarketplaceTheme } from "./AppearancePage.tsx";
+import {
+  APPEARANCE_KEY,
+  AppearanceStore,
+  PROFILE_APPEARANCE_KEY,
+  syncTui,
+  userThemeFrom,
+} from "./themeStore.ts";
+import { convertVscodeTheme, type VscodeTheme } from "./vscodeImport.ts";
+
+function memory(): Storage {
+  const data = new Map<string, string>();
+  return {
+    get length() {
+      return data.size;
+    },
+    clear: () => data.clear(),
+    getItem: (k) => data.get(k) ?? null,
+    key: (i) => [...data.keys()][i] ?? null,
+    removeItem: (k) => {
+      data.delete(k);
+    },
+    setItem: (k, v) => {
+      data.set(k, v);
+    },
+  };
+}
+
+const FIXTURE = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../../../../tests/fixtures/desktop/vscode_theme.json",
+);
+
+describe("appearance store", () => {
+  it("paints nothing until something is chosen", () => {
+    const store = new AppearanceStore(memory());
+    expect(store.resolve(null, "dark")).toBeNull();
+    expect(store.css(null, "dark")).toBe("");
+  });
+
+  it("presets, accent and per-profile choices resolve and persist in two keys", () => {
+    const storage = memory();
+    const store = new AppearanceStore(storage);
+    store.choose("lotus");
+    store.setAccent(380);
+    store.setProfile("work", { theme: "basalt", chatFont: "Inter, sans-serif" });
+    expect(store.resolve(null, "light")).toEqual(presetTheme("lotus", "light", { accentHue: 20 }));
+    expect(store.resolve("work", "dark")).toEqual(presetTheme("basalt", "dark", { accentHue: 20 }));
+    expect(store.css("work", "dark")).toContain("--indus-chat-font: Inter, sans-serif;");
+    expect(JSON.parse(storage.getItem(PROFILE_APPEARANCE_KEY) ?? "{}")).toEqual({
+      work: { theme: "basalt", chatFont: "Inter, sans-serif" },
+    });
+    expect(JSON.parse(storage.getItem(APPEARANCE_KEY) ?? "{}")).not.toHaveProperty("profiles");
+    const again = new AppearanceStore(storage);
+    expect(again.get()).toEqual(store.get());
+    store.setProfile("work", { theme: "", chatFont: "" });
+    expect(store.get().profiles.work).toEqual({});
+  });
+
+  it("bad stored data and unsafe fonts are dropped", () => {
+    const storage = memory();
+    storage.setItem(APPEARANCE_KEY, "{not json");
+    storage.setItem(PROFILE_APPEARANCE_KEY, JSON.stringify({ work: { chatFont: "x; } body {" } }));
+    const store = new AppearanceStore(storage);
+    expect(store.get().theme).toBeNull();
+    expect(store.get().profiles.work).toEqual({});
+  });
+
+  it("user themes from VS Code install once, re-activate, and can be removed", async () => {
+    const store = new AppearanceStore(memory());
+    const fixture = JSON.parse(fs.readFileSync(FIXTURE, "utf8")) as VscodeTheme;
+    store.addUserTheme(userThemeFrom(convertVscodeTheme(fixture), "acme.river"));
+    const download = vi.fn(async () => ({ vsixBase64: "" }));
+    const label = await installMarketplaceTheme(
+      {
+        publisher: "acme",
+        extension: "river",
+        version: "1.0.0",
+        displayName: "River",
+        description: "",
+        installs: 1,
+      },
+      { downloadMarketplace: download },
+      store,
+    );
+    expect(label).toBe("Riverbank Night");
+    expect(download).not.toHaveBeenCalled(); // already installed: just used
+    expect(store.get().theme).toBe("user:vscode-riverbank-night");
+    expect(store.resolve(null, "light")?.bg.hex).toBe("#16202a");
+    store.removeUserTheme("vscode-riverbank-night");
+    expect(store.get().theme).toBeNull();
+    expect(store.get().userThemes).toEqual([]);
+  });
+
+  it("the TUI sync writes the polarity through the config route", async () => {
+    const api = fakeRest();
+    api.route("PUT", "/api/config", { ok: true });
+    expect(await syncTui(api, "work", "light")).toBe(true);
+    expect(api.calls[0]).toMatchObject({
+      method: "PUT",
+      path: "/api/config",
+      body: { config: { tui: { theme: "light" } } },
+      profile: "work",
+    });
+  });
+});
diff --git a/apps/desktop/src/theme/themeStore.ts b/apps/desktop/src/theme/themeStore.ts
new file mode 100644
index 0000000..fdb385c
--- /dev/null
+++ b/apps/desktop/src/theme/themeStore.ts
@@ -0,0 +1,252 @@
+// The desktop's appearance choices (P24-33), kept per device in the renderer's storage:
+//
+// - a preset (`@indus/ui` presets) or a user theme (imported from VS Code or written by hand), an
+//   optional accent hue, and per-profile overrides (preset, chat font, terminal font);
+// - `resolve(profile, mode)` gives the semantic theme to paint, `css(profile, mode)` its variables.
+//
+// Nothing is painted until the person chooses something: with no choice the built-in Indus light
+// and dark themes stay as they are. `syncTui` writes the polarity to the backend's `tui.theme`, so
+// the terminal UI follows (its colour payload is a follow-up).
+
+import {
+  type PresetMode,
+  presetIds,
+  presetTheme,
+  type SemanticColour,
+  type SemanticName,
+  type SemanticTheme,
+  semanticNames,
+  themeCss,
+} from "@indus/ui";
+import { type RestLike, rest } from "../settings/settingsApi.ts";
+import type { AnsiKey, ConvertedTheme } from "./vscodeImport.ts";
+
+/** Window-wide choices (theme, accent, user themes). */
+export const APPEARANCE_KEY = "indus-desktop-appearance";
+/** Per-profile overrides: a `record` family (`{ [profile]: … }`), moved on a profile rename. */
+export const PROFILE_APPEARANCE_KEY = "indus.desktop.appearance.profiles";
+
+export interface StoredUserTheme {
+  readonly id: string;
+  readonly label: string;
+  /** The side the theme was made for; the other mode uses it too. */
+  readonly mode: PresetMode;
+  readonly colours: Readonly<Record<SemanticName, string>>;
+  readonly terminal: Readonly<Record<AnsiKey, string>> | null;
+  /** `publisher.extension` when installed from the Marketplace. */
+  readonly origin: string | null;
+}
+
+export interface ProfileAppearance {
+  readonly theme?: string;
+  readonly chatFont?: string;
+  readonly terminalFont?: string;
+}
+
+export interface Appearance {
+  /** A preset id, `user:<id>`, or null for the built-in look. */
+  readonly theme: string | null;
+  readonly accentHue: number | null;
+  readonly userThemes: readonly StoredUserTheme[];
+  readonly profiles: Readonly<Record<string, ProfileAppearance>>;
+}
+
+export const EMPTY_APPEARANCE: Appearance = {
+  theme: null,
+  accentHue: null,
+  userThemes: [],
+  profiles: {},
+};
+
+const FONT = /^[\w ,'"-]{1,120}$/;
+
+function clean(raw: unknown): Appearance {
+  if (raw === null || typeof raw !== "object") return EMPTY_APPEARANCE;
+  const data = raw as Record<string, unknown>;
+  const users = Array.isArray(data.userThemes)
+    ? (data.userThemes as StoredUserTheme[]).filter(
+        (u) =>
+          typeof u?.id === "string" &&
+          typeof u.label === "string" &&
+          u.colours !== null &&
+          typeof u.colours === "object" &&
+          semanticNames.every((n) => typeof u.colours[n] === "string"),
+      )
+    : [];
+  const profiles: Record<string, ProfileAppearance> = {};
+  if (data.profiles !== null && typeof data.profiles === "object") {
+    for (const [name, value] of Object.entries(data.profiles as Record<string, unknown>)) {
+      if (value === null || typeof value !== "object") continue;
+      const entry = value as Record<string, unknown>;
+      profiles[name] = {
+        ...(typeof entry.theme === "string" ? { theme: entry.theme } : {}),
+        ...(typeof entry.chatFont === "string" && FONT.test(entry.chatFont)
+          ? { chatFont: entry.chatFont }
+          : {}),
+        ...(typeof entry.terminalFont === "string" && FONT.test(entry.terminalFont)
+          ? { terminalFont: entry.terminalFont }
+          : {}),
+      };
+    }
+  }
+  return {
+    theme: typeof data.theme === "string" ? data.theme : null,
+    accentHue:
+      typeof data.accentHue === "number" && Number.isFinite(data.accentHue) ? data.accentHue : null,
+    userThemes: users,
+    profiles,
+  };
+}
+
+export function userThemeFrom(converted: ConvertedTheme, origin: string | null): StoredUserTheme {
+  return {
+    id: converted.id,
+    label: converted.label,
+    mode: converted.mode,
+    colours: Object.fromEntries(semanticNames.map((n) => [n, converted.theme[n].hex])) as Record<
+      SemanticName,
+      string
+    >,
+    terminal: converted.terminal,
+    origin,
+  };
+}
+
+function fromColours(user: StoredUserTheme): SemanticTheme {
+  return Object.fromEntries(
+    semanticNames.map((n): [SemanticName, SemanticColour] => [
+      n,
+      { css: user.colours[n], hex: user.colours[n], source: `user.${user.id}` },
+    ]),
+  ) as SemanticTheme;
+}
+
+export class AppearanceStore {
+  private value: Appearance;
+  private readonly listeners = new Set<() => void>();
+  private readonly storage: Storage | null;
+
+  constructor(storage?: Storage | null) {
+    this.storage = storage === undefined ? safeStorage() : storage;
+    const read = (key: string): unknown => {
+      try {
+        const text = this.storage?.getItem(key);
+        return text ? JSON.parse(text) : null;
+      } catch {
+        return null;
+      }
+    };
+    const base = read(APPEARANCE_KEY);
+    this.value = clean({
+      ...(base !== null && typeof base === "object" ? base : {}),
+      profiles: read(PROFILE_APPEARANCE_KEY),
+    });
+  }
+
+  get = (): Appearance => this.value;
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  private set(next: Appearance): void {
+    this.value = next;
+    try {
+      const { profiles, ...windowWide } = next;
+      this.storage?.setItem(APPEARANCE_KEY, JSON.stringify(windowWide));
+      this.storage?.setItem(PROFILE_APPEARANCE_KEY, JSON.stringify(profiles));
+    } catch {
+      // storage unavailable: the choice lasts for this window
+    }
+    for (const listener of [...this.listeners]) listener();
+  }
+
+  choose(theme: string | null): void {
+    this.set({ ...this.value, theme });
+  }
+
+  setAccent(hue: number | null): void {
+    this.set({ ...this.value, accentHue: hue === null ? null : ((hue % 360) + 360) % 360 });
+  }
+
+  addUserTheme(theme: StoredUserTheme): void {
+    const others = this.value.userThemes.filter((u) => u.id !== theme.id);
+    this.set({ ...this.value, userThemes: [...others, theme] });
+  }
+
+  removeUserTheme(id: string): void {
+    const theme = this.value.theme === `user:${id}` ? null : this.value.theme;
+    this.set({
+      ...this.value,
+      theme,
+      userThemes: this.value.userThemes.filter((u) => u.id !== id),
+    });
+  }
+
+  setProfile(profile: string, patch: ProfileAppearance): void {
+    const merged: Record<string, string> = { ...(this.value.profiles[profile] ?? {}) };
+    for (const [key, value] of Object.entries(patch)) {
+      if (value === undefined || value === "") delete merged[key];
+      else merged[key] = value;
+    }
+    this.set({ ...this.value, profiles: { ...this.value.profiles, [profile]: merged } });
+  }
+
+  /** The theme `profile` paints in `mode`, or null for the built-in look. */
+  resolve(profile: string | null, mode: PresetMode): SemanticTheme | null {
+    const choice =
+      (profile !== null ? this.value.profiles[profile]?.theme : undefined) ?? this.value.theme;
+    if (choice === null) return null;
+    if (choice.startsWith("user:")) {
+      const user = this.value.userThemes.find((u) => u.id === choice.slice(5));
+      return user === undefined ? null : fromColours(user);
+    }
+    if (!presetIds.includes(choice)) return null;
+    return presetTheme(
+      choice,
+      mode,
+      this.value.accentHue === null ? {} : { accentHue: this.value.accentHue },
+    );
+  }
+
+  /** The CSS to paint (colours over the built-in themes, fonts), or "" for the built-in look. */
+  css(profile: string | null, mode: PresetMode): string {
+    const parts: string[] = [];
+    const theme = this.resolve(profile, mode);
+    // three :root beat the built-in `:root[data-theme=…]` blocks
+    if (theme !== null) parts.push(themeCss(theme, ":root:root:root"));
+    const fonts = profile !== null ? this.value.profiles[profile] : undefined;
+    const decl: string[] = [];
+    if (fonts?.chatFont) decl.push(`  --indus-chat-font: ${fonts.chatFont};`);
+    if (fonts?.terminalFont) decl.push(`  --indus-terminal-font: ${fonts.terminalFont};`);
+    if (decl.length > 0) parts.push([":root {", ...decl, "}"].join("\n"));
+    return parts.join("\n");
+  }
+}
+
+function safeStorage(): Storage | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+/** The window's appearance store. */
+export const appearance = new AppearanceStore();
+
+/** Tell the backend which polarity the TUI should use (`tui.theme`). */
+export async function syncTui(
+  api: RestLike | null,
+  profile: string | null,
+  mode: PresetMode,
+): Promise<boolean> {
+  const answer = await rest(api, "PUT", "/api/config", {
+    body: { config: { tui: { theme: mode } } },
+    ...(profile === null ? {} : { profile }),
+  });
+  return answer.ok;
+}
diff --git a/apps/desktop/src/theme/vscodeImport.test.ts b/apps/desktop/src/theme/vscodeImport.test.ts
new file mode 100644
index 0000000..5dcc880
--- /dev/null
+++ b/apps/desktop/src/theme/vscodeImport.test.ts
@@ -0,0 +1,150 @@
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { deflateRawSync } from "node:zlib";
+import { contrastRatio, semanticNames } from "@indus/ui";
+import { describe, expect, it } from "vitest";
+import {
+  convertVscodeTheme,
+  failingPairs,
+  mix,
+  parseColour,
+  parseJsonc,
+  readVsix,
+  themesFromVsix,
+  type VscodeTheme,
+} from "./vscodeImport.ts";
+
+const FIXTURE = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../../../../tests/fixtures/desktop/vscode_theme.json",
+);
+const raw = () => JSON.parse(fs.readFileSync(FIXTURE, "utf8")) as VscodeTheme;
+
+describe("VS Code theme conversion", () => {
+  it("converts the fixture deterministically", () => {
+    const a = convertVscodeTheme(raw());
+    const b = convertVscodeTheme(raw());
+    expect(b).toEqual(a);
+    expect(a.id).toBe("vscode-riverbank-night");
+    expect(a.label).toBe("Riverbank Night");
+    expect(a.mode).toBe("dark");
+    const hex = Object.fromEntries(semanticNames.map((n) => [n, a.theme[n].hex]));
+    expect(hex).toMatchObject({
+      bg: "#16202a",
+      "bg-raised": "#1b2733",
+      fg: "#c9d4dc",
+      "accent-fg": "#ffffff",
+      danger: "#e0786a",
+      warning: "#d6b25e",
+      success: "#6cbf8a",
+      "focus-ring": "#5aa9d6",
+      selection: "#3b8ec255",
+    });
+    // the code background is translucent in the file: composited over the editor background
+    expect(hex["code-bg"]).toBe(mix("#16202a", "#1f2c38", 0x80 / 255));
+    expect(a.derived).toEqual([]);
+    expect(a.terminal?.brightWhite).toBe("#eef3f6");
+    expect(Object.keys(a.terminal ?? {})).toHaveLength(16);
+  });
+
+  it("every converted theme passes the contrast pairs", () => {
+    expect(failingPairs(convertVscodeTheme(raw()).theme)).toEqual([]);
+    const harsh: VscodeTheme = {
+      name: "Low Contrast",
+      type: "light",
+      colors: {
+        "editor.background": "#ffffff",
+        "editor.foreground": "#dddddd",
+        "button.background": "#ffee99",
+        descriptionForeground: "#eeeeee",
+      },
+    };
+    const converted = convertVscodeTheme(harsh);
+    expect(failingPairs(converted.theme)).toEqual([]);
+    expect(contrastRatio(converted.theme.fg.hex, "#ffffff")).toBeGreaterThanOrEqual(4.5);
+  });
+
+  it("derives what is missing and guesses the mode from the background", () => {
+    const bare = convertVscodeTheme({ colors: { "editor.background": "#f4f1ea" } }, "Paper");
+    expect(bare.mode).toBe("light");
+    expect(bare.label).toBe("Paper");
+    expect(bare.derived).toContain("accent");
+    expect(bare.terminal).toBeNull();
+    expect(convertVscodeTheme({}).mode).toBe("dark");
+  });
+
+  it("reads JSONC with comments and trailing commas, and short colours", () => {
+    const text = `{
+      // a line comment
+      "name": "With // slashes in a string",
+      /* a block comment */
+      "colors": { "editor.background": "#123", },
+    }`;
+    const parsed = parseJsonc(text) as VscodeTheme;
+    expect(parsed.name).toBe("With // slashes in a string");
+    expect(convertVscodeTheme(parsed).theme.bg.hex).toBe("#112233");
+    expect(parseColour("#abcd")).toEqual({ hex: "#aabbcc", alpha: 0xdd / 255 });
+    expect(parseColour("red")).toBeNull();
+  });
+});
+
+// -- a VSIX built here --------------------------------------------------------------------------------
+
+function zip(files: Record<string, string>): Uint8Array {
+  const chunks: Buffer[] = [];
+  const central: Buffer[] = [];
+  let offset = 0;
+  for (const [name, text] of Object.entries(files)) {
+    const data = deflateRawSync(Buffer.from(text));
+    const nameBytes = Buffer.from(name);
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt16LE(8, 8);
+    local.writeUInt32LE(data.length, 18);
+    local.writeUInt32LE(Buffer.byteLength(text), 22);
+    local.writeUInt16LE(nameBytes.length, 26);
+    chunks.push(local, nameBytes, data);
+    const entry = Buffer.alloc(46);
+    entry.writeUInt32LE(0x02014b50, 0);
+    entry.writeUInt16LE(8, 10);
+    entry.writeUInt32LE(data.length, 20);
+    entry.writeUInt32LE(Buffer.byteLength(text), 24);
+    entry.writeUInt16LE(nameBytes.length, 28);
+    entry.writeUInt32LE(offset, 42);
+    central.push(entry, nameBytes);
+    offset += local.length + nameBytes.length + data.length;
+  }
+  const directory = Buffer.concat(central);
+  const end = Buffer.alloc(22);
+  end.writeUInt32LE(0x06054b50, 0);
+  end.writeUInt16LE(Object.keys(files).length, 8);
+  end.writeUInt16LE(Object.keys(files).length, 10);
+  end.writeUInt32LE(directory.length, 12);
+  end.writeUInt32LE(offset, 16);
+  return new Uint8Array(Buffer.concat([...chunks, directory, end]));
+}
+
+describe("extension packages", () => {
+  it("reads the theme the manifest lists and converts it", async () => {
+    const bytes = zip({
+      "extension/package.json": JSON.stringify({
+        contributes: {
+          themes: [{ label: "Riverbank", uiTheme: "vs-dark", path: "./themes/river.json" }],
+        },
+      }),
+      "extension/themes/river.json": fs.readFileSync(FIXTURE, "utf8"),
+    });
+    expect(readVsix(bytes).names()).toContain("extension/themes/river.json");
+    const themes = await themesFromVsix(bytes);
+    expect(themes).toHaveLength(1);
+    expect(themes[0]?.label).toBe("Riverbank");
+    expect(themes[0]?.theme.bg.hex).toBe("#16202a");
+  });
+
+  it("refuses what is not a theme package", async () => {
+    expect(() => readVsix(new Uint8Array([1, 2, 3]))).toThrow(/not a zip/);
+    const noThemes = zip({ "extension/package.json": "{}" });
+    await expect(themesFromVsix(noThemes)).rejects.toThrow(/no colour theme/);
+  });
+});
diff --git a/apps/desktop/src/theme/vscodeImport.ts b/apps/desktop/src/theme/vscodeImport.ts
