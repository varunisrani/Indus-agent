diff --git a/apps/desktop/src/panes/preview/automation.test.ts b/apps/desktop/src/panes/preview/automation.test.ts
new file mode 100644
index 0000000..ac60e9e
--- /dev/null
+++ b/apps/desktop/src/panes/preview/automation.test.ts
@@ -0,0 +1,170 @@
+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { GUEST_GLOBAL } from "./annotate.ts";
+import { PreviewAutomation, type PreviewGuestHandle, type PreviewRequest } from "./automation.ts";
+
+const SECRET = ["s3cr", "et-", "value"].join("");
+
+/** A guest that runs scripts against this jsdom page (standing in for the webview's page). */
+function guest(sessionId: string | null) {
+  const scripts: string[] = [];
+  const loaded: string[] = [];
+  const handle: PreviewGuestHandle = {
+    executeJavaScript: vi.fn(async (code: string) => {
+      scripts.push(code);
+      // biome-ignore lint/security/noGlobalEval: the guest script runs in this test page, as executeJavaScript would run it in the webview
+      return window.eval(code) as unknown;
+    }),
+    loadURL: vi.fn(async (url: string) => {
+      loaded.push(url);
+    }),
+    sessionId: () => sessionId,
+  };
+  return { handle, scripts, loaded };
+}
+
+function req(fields: Partial<PreviewRequest>): PreviewRequest {
+  return { kind: "preview.act", request_id: "srq-1", session_id: "s-1", ...fields };
+}
+
+afterEach(() => {
+  document.body.innerHTML = "";
+  delete (window as unknown as Record<string, unknown>)[GUEST_GLOBAL];
+});
+
+describe("preview automation", () => {
+  it("a request for a session this window does not show is declined not_shown", async () => {
+    const host = new PreviewAutomation();
+    expect(await host.handle(req({ action: "click", selector: "a" }))).toEqual({
+      declined: "not_shown",
+    });
+    const { handle, scripts } = guest("s-2");
+    host.attach(handle);
+    expect(await host.handle(req({ action: "click", selector: "a" }))).toEqual({
+      declined: "not_shown",
+    });
+    expect(await host.handle(req({ kind: "preview.read", what: "snapshot" }))).toEqual({
+      declined: "not_shown",
+    });
+    expect(scripts).toEqual([]);
+    const unset = guest(null);
+    host.attach(unset.handle);
+    expect(await host.handle(req({ action: "click" }))).toEqual({ declined: "not_shown" });
+  });
+
+  it("acts inside the guest page with JSON arguments", async () => {
+    document.body.innerHTML = `<form><input id="q" name="q"><button id="go" type="button">Go</button></form>`;
+    const clicked = vi.fn();
+    document.getElementById("go")?.addEventListener("click", clicked);
+    const host = new PreviewAutomation();
+    const { handle, scripts } = guest("s-1");
+    host.attach(handle);
+    expect(
+      await host.handle(req({ action: "type", selector: "#q", text: 'tea "and" cake' })),
+    ).toEqual({ ok: true });
+    expect((document.getElementById("q") as HTMLInputElement).value).toBe('tea "and" cake');
+    expect(await host.handle(req({ action: "click", selector: "#go" }))).toMatchObject({
+      ok: true,
+    });
+    expect(clicked).toHaveBeenCalledTimes(1);
+    expect(await host.handle(req({ action: "click", selector: "#missing" }))).toEqual({
+      ok: false,
+      error: "no element matches #missing",
+    });
+    // every call carries its arguments as JSON after the install script
+    expect(scripts.filter((s) => s.includes("act(")).every((s) => s.includes('{"action":'))).toBe(
+      true,
+    );
+  });
+
+  it("snapshot reads the page with secrets redacted", async () => {
+    document.title = "Shop";
+    document.body.innerHTML = `<h1>Basket</h1><input type="password" name="pw"><input name="coupon"><textarea name="session_key">${SECRET}</textarea>`;
+    (document.querySelector('input[name="pw"]') as HTMLInputElement).value = SECRET;
+    (document.querySelector('input[name="coupon"]') as HTMLInputElement).value = "SPRING";
+    const host = new PreviewAutomation();
+    host.attach(guest("s-1").handle);
+    const snap = (await host.handle(req({ kind: "preview.read", what: "snapshot" }))) as Record<
+      string,
+      unknown
+    >;
+    expect(snap).toMatchObject({ ok: true, title: "Shop" });
+    expect(JSON.stringify(snap)).not.toContain(SECRET);
+    expect(JSON.stringify(snap)).toContain("SPRING");
+    expect(snap.text).toContain("Basket");
+  });
+
+  it("typing into a secret field is left to the person", async () => {
+    document.body.innerHTML = `<input type="password" id="pw">`;
+    const host = new PreviewAutomation();
+    host.attach(guest("s-1").handle);
+    expect(await host.handle(req({ action: "type", selector: "#pw", text: "x" }))).toEqual({
+      ok: false,
+      error: "secret fields are left to the person",
+    });
+  });
+
+  it("navigates inside the guest, web and local files only", async () => {
+    const host = new PreviewAutomation();
+    const { handle, loaded } = guest("s-1");
+    host.attach(handle);
+    expect(await host.handle(req({ action: "navigate", url: "http://localhost:5173/x" }))).toEqual({
+      ok: true,
+      url: "http://localhost:5173/x",
+    });
+    expect(await host.handle(req({ action: "navigate", url: "file:///tmp/a.html" }))).toMatchObject(
+      {
+        ok: true,
+      },
+    );
+    for (const url of [
+      "javascript:alert(1)",
+      "data:text/html,x",
+      "indus://open",
+      "https://u:p@h/",
+    ]) {
+      expect(await host.handle(req({ action: "navigate", url }))).toMatchObject({ ok: false });
+    }
+    expect(loaded).toEqual(["http://localhost:5173/x", "file:///tmp/a.html"]);
+  });
+
+  it("agent pins are drawn on the page; unknown actions and detached guests are refused", async () => {
+    document.body.innerHTML = `<h1>Title</h1>`;
+    const host = new PreviewAutomation();
+    const { handle } = guest("s-1");
+    const detach = host.attach(handle);
+    const answer = await host.handle(
+      req({
+        action: "annotate",
+        pins: [
+          { selector: "h1", note: "typo" },
+          { selector: "#gone", note: "x" },
+        ],
+      }),
+    );
+    expect(answer).toEqual({ ok: true, shown: 1, missing: 1 });
+    expect(document.querySelector('[data-indus-pin="1"]')?.textContent).toBe("1");
+    expect(await host.handle(req({ action: "explode" }))).toEqual({
+      ok: false,
+      error: "unknown action explode",
+    });
+    detach();
+    expect(host.shownSession()).toBeNull();
+    expect(await host.handle(req({ action: "click", selector: "h1" }))).toEqual({
+      declined: "not_shown",
+    });
+  });
+
+  it("a page that never answers times out", async () => {
+    const host = new PreviewAutomation({ timeoutMs: 20 });
+    host.attach({
+      executeJavaScript: () => new Promise(() => {}),
+      loadURL: async () => {},
+      sessionId: () => "s-1",
+    });
+    expect(await host.handle(req({ action: "click", selector: "a" }))).toEqual({
+      ok: false,
+      error: "no answer from the page within 20 ms",
+    });
+  });
+});
diff --git a/apps/desktop/src/panes/preview/automation.ts b/apps/desktop/src/panes/preview/automation.ts
new file mode 100644
index 0000000..7e85950
--- /dev/null
+++ b/apps/desktop/src/panes/preview/automation.ts
@@ -0,0 +1,142 @@
+// Agent-driven preview automation (P24-25): the window side of the `preview.act` /
+// `preview.read` server requests.
+//
+// The window that shows a session's preview answers them for that session; any other session's
+// request — or one arriving while no preview guest is attached — is declined with `not_shown`
+// (P17-07), so the daemon offers it to the next window. Every action runs inside the guest page
+// through `executeJavaScript` (the guest API of `annotate.ts`, installed on demand), never in the
+// app's renderer, with the arguments passed as JSON. Navigation stays inside the guest
+// (`loadURL` on the webview) and accepts http(s) and `file:///` only; nothing here opens the OS
+// browser (D-16.20: the guest preload hands off trusted clicks only, and these clicks are not).
+//
+// Interface until the protocol carries the two kinds: `handle(request)` takes the server
+// request's fields and resolves to the answer object, or to `{ declined: "not_shown" }`.
+
+import { guestCall, guestInstallScript } from "./annotate.ts";
+import { isWebUrl } from "./target.ts";
+
+export const ACT_TIMEOUT_MS = 15_000;
+
+export type PreviewRequestKind = "preview.act" | "preview.read";
+
+export interface PreviewRequest {
+  readonly kind: PreviewRequestKind;
+  readonly request_id: string;
+  readonly session_id: string;
+  readonly action?: string;
+  readonly what?: string;
+  readonly url?: string;
+  readonly selector?: string;
+  readonly text?: string;
+  readonly submit?: boolean;
+  readonly dx?: number;
+  readonly dy?: number;
+  readonly pins?: readonly { selector: string; note: string }[];
+}
+
+export type PreviewAnswer =
+  | { readonly declined: "not_shown" }
+  | ({ readonly ok: boolean } & Readonly<Record<string, unknown>>);
+
+/** What the pane hands over for the guest it shows. */
+export interface PreviewGuestHandle {
+  executeJavaScript(code: string): Promise<unknown>;
+  loadURL(url: string): Promise<void>;
+  /** The session whose preview this is (null: a preview nobody's agent may drive). */
+  sessionId(): string | null;
+}
+
+const NOT_SHOWN: PreviewAnswer = { declined: "not_shown" };
+const ACTIONS: ReadonlySet<string> = new Set(["click", "type", "scroll", "annotate"]);
+
+function navigable(url: string): boolean {
+  if (isWebUrl(url)) return true;
+  try {
+    const parsed = new URL(url);
+    return parsed.protocol === "file:" && (parsed.host === "" || parsed.host === "localhost");
+  } catch {
+    return false;
+  }
+}
+
+function withTimeout<T>(work: Promise<T>, ms: number): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(
+      () => reject(new Error(`no answer from the page within ${ms} ms`)),
+      ms,
+    );
+    work.then(
+      (value) => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      (error: unknown) => {
+        clearTimeout(timer);
+        reject(error);
+      },
+    );
+  });
+}
+
+export class PreviewAutomation {
+  private guest: PreviewGuestHandle | null = null;
+  private readonly timeoutMs: number;
+
+  constructor(options: { timeoutMs?: number } = {}) {
+    this.timeoutMs = options.timeoutMs ?? ACT_TIMEOUT_MS;
+  }
+
+  attach(guest: PreviewGuestHandle): () => void {
+    this.guest = guest;
+    return () => {
+      if (this.guest === guest) this.guest = null;
+    };
+  }
+
+  /** The session this window can answer for now, or null. */
+  shownSession(): string | null {
+    return this.guest?.sessionId() ?? null;
+  }
+
+  async handle(request: PreviewRequest): Promise<PreviewAnswer> {
+    const guest = this.guest;
+    if (guest === null || guest.sessionId() === null || guest.sessionId() !== request.session_id) {
+      return NOT_SHOWN;
+    }
+    try {
+      if (request.kind === "preview.read") {
+        if ((request.what ?? "snapshot") !== "snapshot") {
+          return { ok: false, error: `cannot read ${String(request.what)}` };
+        }
+        return await this.call(guest, guestCall("snapshot"));
+      }
+      const action = request.action ?? "";
+      if (action === "navigate") {
+        const url = (request.url ?? "").trim();
+        if (!navigable(url)) return { ok: false, error: "only http(s) and file:/// addresses" };
+        await withTimeout(guest.loadURL(url), this.timeoutMs);
+        return { ok: true, url };
+      }
+      if (!ACTIONS.has(action)) return { ok: false, error: `unknown action ${action}` };
+      const payload: Record<string, unknown> = { action };
+      for (const key of ["selector", "text", "submit", "dx", "dy", "pins"] as const) {
+        if (request[key] !== undefined) payload[key] = request[key];
+      }
+      return await this.call(guest, guestCall("act", payload));
+    } catch (error) {
+      return { ok: false, error: error instanceof Error ? error.message : String(error) };
+    }
+  }
+
+  private async call(guest: PreviewGuestHandle, code: string): Promise<PreviewAnswer> {
+    await withTimeout(guest.executeJavaScript(guestInstallScript()), this.timeoutMs);
+    const answer = await withTimeout(guest.executeJavaScript(code), this.timeoutMs);
+    if (answer === null || typeof answer !== "object") {
+      return { ok: false, error: "the page gave no answer" };
+    }
+    return { ok: true, ...(answer as Record<string, unknown>) } as PreviewAnswer;
+  }
+}
+
+/** This window's automation host (the preview pane attaches its guest). */
+export const windowPreviewAutomation = new PreviewAutomation();
diff --git a/apps/desktop/src/pet/PetOverlay.tsx b/apps/desktop/src/pet/PetOverlay.tsx
new file mode 100644
index 0000000..5c590ee
--- /dev/null
+++ b/apps/desktop/src/pet/PetOverlay.tsx
@@ -0,0 +1,205 @@
+// The desktop pet (P24-19), two halves:
+//
+// - `PetOverlay` is the root of the pet window (`?win=pet`, a transparent click-through window over
+//   the work area). It shows the picture of the current mood where `roam.ts` puts it, a speech
+//   bubble for short status lines, and tells main when the pointer is over the figure, so only the
+//   figure takes clicks. A click nudges a sleeping pet awake.
+// - `PetHost` lives in an app window. When the daemon has a shown pet (`pet.info`, which sends the
+//   pictures only when its revision changed) it asks main to show the overlay with them, hides it
+//   otherwise, and turns turn events into bubble lines ("On it…", "All done.", "I need you…").
+//
+// `pet.info` is not in the generated method catalogue yet (P24-19 wiring): `PetHost` calls it
+// through `LooseRpc`, and a daemon that does not serve it simply leaves the pet hidden.
+
+import { type PointerEvent, useEffect, useRef, useState } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import type { IndusPetView } from "../global.d.ts";
+import { useT } from "../i18n/index.tsx";
+import { nudge, type RoamState, startRoam, stepRoam } from "./roam.ts";
+
+/** The figure's size at scale 1 (pictures are drawn square). */
+export const PET_SIZE_PX = 96;
+/** How often an app window re-reads `pet.info` (cheap when nothing changed). */
+export const PET_INFO_POLL_MS = 30_000;
+
+const EMPTY: IndusPetView = {
+  visible: false,
+  name: null,
+  scale: 1,
+  revision: null,
+  moods: {},
+  bubble: null,
+};
+
+/** Which picture a moment shows: talking while there is a bubble, else the roam mood. */
+export function moodFor(view: IndusPetView, roam: RoamState | null): string {
+  const has = (mood: string) => typeof view.moods[mood] === "string";
+  const wanted = view.bubble !== null ? "talk" : (roam?.mood ?? "rest");
+  if (has(wanted)) return wanted;
+  if (has("rest")) return "rest";
+  return Object.keys(view.moods)[0] ?? "rest";
+}
+
+export function PetOverlay() {
+  const t = useT();
+  const bridge = desktopBridge();
+  const [view, setView] = useState<IndusPetView>(EMPTY);
+  const [roam, setRoam] = useState<RoamState | null>(null);
+  const over = useRef(false);
+  const size = Math.round(PET_SIZE_PX * view.scale);
+
+  useEffect(() => {
+    document.documentElement.dataset.window = "pet";
+    document.body.style.background = "transparent";
+    if (bridge === null) return;
+    let live = true;
+    const off = bridge.pet.onState((next) => {
+      if (live) setView(next);
+    });
+    void bridge.pet
+      .get()
+      .then((next) => {
+        if (live) setView(next);
+      })
+      .catch(() => {});
+    return () => {
+      live = false;
+      off();
+    };
+  }, [bridge]);
+
+  // one animation loop while the pet is visible
+  useEffect(() => {
+    if (!view.visible) return;
+    const area = () => ({ width: window.innerWidth, height: window.innerHeight });
+    const sprite = { width: size, height: size };
+    let last = performance.now();
+    let frame = 0;
+    setRoam((current) => current ?? startRoam(area(), sprite, Math.random));
+    const tick = (now: number) => {
+      const dt = now - last;
+      last = now;
+      setRoam((current) =>
+        current === null ? current : stepRoam(current, area(), sprite, dt, Math.random),
+      );
+      frame = requestAnimationFrame(tick);
+    };
+    frame = requestAnimationFrame(tick);
+    return () => cancelAnimationFrame(frame);
+  }, [view.visible, size]);
+
+  useEffect(() => {
+    if (view.bubble !== null) setRoam((current) => (current === null ? current : nudge(current)));
+  }, [view.bubble]);
+
+  const report = (next: boolean) => {
+    if (over.current === next) return;
+    over.current = next;
+    bridge?.pet.pointer({ over: next });
+  };
+
+  if (!view.visible || roam === null) return null;
+  const mood = moodFor(view, roam);
+  const picture = view.moods[mood];
+  return (
+    <main className="pointer-events-none fixed inset-0 select-none" aria-live="polite">
+      <div
+        className="pointer-events-auto absolute"
+        style={{ left: roam.x, top: roam.y, width: size, height: size }}
+        data-testid="pet-figure"
+        data-mood={mood}
+        onPointerEnter={() => report(true)}
+        onPointerLeave={() => report(false)}
+        onPointerDown={(event: PointerEvent<HTMLDivElement>) => {
+          if (event.button === 0)
+            setRoam((current) => (current === null ? current : nudge(current)));
+        }}
+      >
+        {view.bubble !== null ? (
+          <p
+            role="status"
+            className="absolute bottom-full left-1/2 mb-1 w-max max-w-56 -translate-x-1/2 rounded-lg border border-line bg-raised px-2 py-1 text-xs text-fg shadow"
+          >
+            {view.bubble}
+          </p>
+        ) : null}
+        {picture !== undefined ? (
+          <img
+            src={picture}
+            alt={t("pet.label", { name: view.name ?? "" })}
+            draggable={false}
+            className="h-full w-full object-contain"
+            style={{ transform: roam.facing < 0 ? "scaleX(-1)" : undefined }}
+          />
+        ) : null}
+      </div>
+    </main>
+  );
+}
+
+/** The part of a connection `PetHost` needs (methods outside the generated catalogue). */
+export interface LooseRpc {
+  request(method: string, params: object, options?: { timeoutMs?: number }): Promise<unknown>;
+  onEvent?(listener: (event: { type?: string }) => void): () => void;
+}
+
+interface PetInfo {
+  enabled?: boolean;
+  name?: string;
+  scale?: number;
+  revision?: string;
+  unchanged?: boolean;
+  moods?: Record<string, string>;
+}
+
+export function PetHost(props: { connection: LooseRpc | null; pollMs?: number }) {
+  const t = useT();
+  const bridge = desktopBridge();
+  const { connection } = props;
+  const pollMs = props.pollMs ?? PET_INFO_POLL_MS;
+  const held = useRef<{ revision: string; moods: Record<string, string> } | null>(null);
+
+  useEffect(() => {
+    if (bridge === null || connection === null) return;
+    let live = true;
+    const refresh = async () => {
+      let info: PetInfo;
+      try {
+        info = (await connection.request("pet.info", {
+          ...(held.current === null ? {} : { known_revision: held.current.revision }),
+        })) as PetInfo;
+      } catch {
+        return; // not served here (or offline): leave the overlay as it is
+      }
+      if (!live) return;
+      if (info.enabled !== true || typeof info.revision !== "string") {
+        if (held.current !== null) {
+          held.current = null;
+          await bridge.pet.hide().catch(() => {});
+        }
+        return;
+      }
+      const moods = info.unchanged === true ? held.current?.moods : info.moods;
+      if (moods === undefined) return;
+      held.current = { revision: info.revision, moods };
+      await bridge.pet
+        .show({ name: info.name ?? "", scale: info.scale ?? 1, revision: info.revision, moods })
+        .catch(() => {});
+    };
+    void refresh();
+    const timer = setInterval(() => void refresh(), pollMs);
+    const off = connection.onEvent?.((event) => {
+      if (held.current === null) return;
+      if (event.type === "turn.started") bridge.pet.say({ text: t("pet.say.working") });
+      else if (event.type === "turn.done") bridge.pet.say({ text: t("pet.say.done") });
+      else if (event.type === "server_request") bridge.pet.say({ text: t("pet.say.waiting") });
+    });
+    return () => {
+      live = false;
+      clearInterval(timer);
+      off?.();
+    };
+  }, [bridge, connection, pollMs, t]);
+
+  return null;
+}
diff --git a/apps/desktop/src/pet/roam.test.ts b/apps/desktop/src/pet/roam.test.ts
new file mode 100644
index 0000000..a9d451a
--- /dev/null
+++ b/apps/desktop/src/pet/roam.test.ts
@@ -0,0 +1,128 @@
+import { describe, expect, it } from "vitest";
+import {
+  clampPoint,
+  MIN_TRIP_PX,
+  nudge,
+  pickTarget,
+  REST_MAX_MS,
+  REST_MIN_MS,
+  type RoamState,
+  restDuration,
+  roomFor,
+  type Size,
+  SLEEP_AFTER_MS,
+  seededRng,
+  startRoam,
+  stepRoam,
+} from "./roam.ts";
+
+function inside(state: RoamState, area: Size, sprite: Size): boolean {
+  const { maxX, maxY } = roomFor(area, sprite);
+  return state.x >= 0 && state.y >= 0 && state.x <= maxX && state.y <= maxY;
+}
+
+describe("pet roam", () => {
+  it("stays inside the work area for random geometries", () => {
+    const rng = seededRng(20261021);
+    for (let geometry = 0; geometry < 200; geometry++) {
+      const area = { width: 40 + Math.floor(rng() * 3000), height: 40 + Math.floor(rng() * 2000) };
+      const sprite = { width: 16 + Math.floor(rng() * 300), height: 16 + Math.floor(rng() * 300) };
+      let state = startRoam(area, sprite, rng);
+      expect(inside(state, area, sprite)).toBe(true);
+      let current = area;
+      for (let frame = 0; frame < 600; frame++) {
+        // now and then a display change shrinks or grows the area mid-walk
+        if (frame === 300) {
+          current = {
+            width: Math.max(20, Math.floor(area.width * (0.3 + rng()))),
+            height: Math.max(20, Math.floor(area.height * (0.3 + rng()))),
+          };
+        }
+        state = stepRoam(state, current, sprite, 16 + rng() * 400, rng);
+        expect(inside(state, current, sprite)).toBe(true);
+        if (state.target !== null) {
+          expect(inside({ ...state, ...state.target }, current, sprite)).toBe(true);
+        }
+      }
+    }
+  });
+
+  it("a figure larger than the area sits at the corner", () => {
+    const area = { width: 100, height: 80 };
+    const sprite = { width: 200, height: 200 };
+    expect(clampPoint(area, sprite, { x: 50, y: 50 })).toEqual({ x: 0, y: 0 });
+    let state = startRoam(area, sprite, seededRng(3));
+    for (let i = 0; i < 100; i++) state = stepRoam(state, area, sprite, 500, seededRng(i + 1));
+    expect([state.x, state.y]).toEqual([0, 0]);
+  });
+
+  it("non-finite inputs never escape", () => {
+    const area = { width: 800, height: 600 };
+    const sprite = { width: 100, height: 100 };
+    expect(clampPoint(area, sprite, { x: Number.NaN, y: Number.POSITIVE_INFINITY })).toEqual({
+      x: 0,
+      y: 0,
+    });
+    const state = stepRoam(
+      startRoam(area, sprite, seededRng(1)),
+      area,
+      sprite,
+      Number.NaN,
+      seededRng(2),
+    );
+    expect(inside(state, area, sprite)).toBe(true);
+  });
+
+  it("rests, then walks at least a trip's length, then rests again", () => {
+    const area = { width: 1600, height: 900 };
+    const sprite = { width: 96, height: 96 };
+    const rng = seededRng(7);
+    let state = startRoam(area, sprite, rng);
+    expect(state.mood).toBe("rest");
+    let waited = 0;
+    while (state.mood === "rest" && waited < REST_MAX_MS + 2_000) {
+      state = stepRoam(state, area, sprite, 1_000, rng); // one step covers at most a second
+      waited += 1_000;
+    }
+    expect(state.mood).toBe("walk");
+    const start = { x: state.x, y: state.y };
+    const target = state.target as { x: number; y: number };
+    expect(Math.hypot(target.x - start.x, target.y - start.y)).toBeGreaterThanOrEqual(MIN_TRIP_PX);
+    let frames = 0;
+    while (state.mood === "walk" && frames < 10_000) {
+      state = stepRoam(state, area, sprite, 50, rng);
+      frames += 1;
+    }
+    expect(state.mood).toBe("rest");
+    expect([state.x, state.y]).toEqual([target.x, target.y]);
+    expect(state.facing).toBe(target.x < start.x ? -1 : 1);
+  });
+
+  it("falls asleep after a long idle and wakes on a nudge", () => {
+    const area = { width: 800, height: 600 };
+    const sprite = { width: 64, height: 64 };
+    let state: RoamState = { ...startRoam(area, sprite, seededRng(1)), restLeft: 10 ** 9 };
+    for (let t = 0; t < SLEEP_AFTER_MS; t += 1_000)
+      state = stepRoam(state, area, sprite, 1_000, seededRng(t));
+    expect(state.mood).toBe("sleep");
+    expect(nudge(state).mood).toBe("rest");
+  });
+
+  it("rest lengths and targets stay in their ranges", () => {
+    const rng = seededRng(99);
+    for (let i = 0; i < 500; i++) {
+      const rest = restDuration(rng);
+      expect(rest).toBeGreaterThanOrEqual(REST_MIN_MS);
+      expect(rest).toBeLessThanOrEqual(REST_MAX_MS);
+      const t = pickTarget(
+        { width: 500, height: 400 },
+        { width: 50, height: 50 },
+        { x: 0, y: 0 },
+        rng,
+      );
+      expect(t.x).toBeGreaterThanOrEqual(0);
+      expect(t.x).toBeLessThanOrEqual(450);
+      expect(t.y).toBeLessThanOrEqual(350);
+    }
+  });
+});
diff --git a/apps/desktop/src/pet/roam.ts b/apps/desktop/src/pet/roam.ts
new file mode 100644
index 0000000..635be83
--- /dev/null
+++ b/apps/desktop/src/pet/roam.ts
@@ -0,0 +1,168 @@
+// How the desktop pet wanders (P24-19). Pure: the overlay calls `stepRoam` once per animation
+// frame with the time that passed, and draws the figure where the state says.
+//
+// The pet window covers the work area, so "inside the work area" means inside the window: the
+// figure's whole box stays within `[0, area.width - sprite.width] × [0, area.height -
+// sprite.height]` at every step, also after the area shrinks (a display change). A figure larger
+// than the area sits at the top-left corner.
+//
+// Rhythm: rest for a while (most of the time), then walk at a steady pace to a new spot that is
+// at least `MIN_TRIP_PX` away, mostly along the bottom band of the screen where it stays out of
+// the way; after `SLEEP_AFTER_MS` of rests in a row it falls asleep until something happens.
+
+export interface Size {
+  readonly width: number;
+  readonly height: number;
+}
+
+export interface Point {
+  readonly x: number;
+  readonly y: number;
+}
+
+export type RoamMood = "rest" | "walk" | "sleep";
+
+export interface RoamState {
+  readonly x: number;
+  readonly y: number;
+  readonly target: Point | null;
+  /** Milliseconds of rest left before the next walk. */
+  readonly restLeft: number;
+  /** Rest time in a row (sleep after `SLEEP_AFTER_MS`). */
+  readonly idleFor: number;
+  readonly facing: 1 | -1;
+  readonly mood: RoamMood;
+}
+
+export type Rng = () => number;
+
+export const WALK_SPEED_PX_S = 70;
+export const MIN_TRIP_PX = 120;
+export const REST_MIN_MS = 3_000;
+export const REST_MAX_MS = 14_000;
+export const SLEEP_AFTER_MS = 90_000;
+/** Share of trips that stay in the bottom band (the rest go anywhere). */
+export const BOTTOM_BIAS = 0.8;
+/** Height of the bottom band, as a share of the free height. */
+export const BOTTOM_BAND = 0.25;
+
+/** The largest x and y the figure's top-left corner may take (never below 0). */
+export function roomFor(area: Size, sprite: Size): { maxX: number; maxY: number } {
+  return {
+    maxX: Math.max(0, Math.floor(area.width - sprite.width)),
+    maxY: Math.max(0, Math.floor(area.height - sprite.height)),
+  };
+}
+
+export function clampPoint(area: Size, sprite: Size, point: Point): Point {
+  const { maxX, maxY } = roomFor(area, sprite);
+  const fix = (v: number, max: number) => (Number.isFinite(v) ? Math.min(max, Math.max(0, v)) : 0);
+  return { x: fix(point.x, maxX), y: fix(point.y, maxY) };
+}
+
+export function restDuration(rng: Rng): number {
+  // squared: mostly short rests, now and then a long one
+  const u = rng();
+  return Math.round(REST_MIN_MS + (REST_MAX_MS - REST_MIN_MS) * u * u);
+}
+
+/** A destination at least `MIN_TRIP_PX` away when the area allows it. */
+export function pickTarget(area: Size, sprite: Size, from: Point, rng: Rng): Point {
+  const { maxX, maxY } = roomFor(area, sprite);
+  const bottom = rng() < BOTTOM_BIAS;
+  const bandTop = Math.floor(maxY * (1 - BOTTOM_BAND));
+  let best: Point = from;
+  let bestDistance = -1;
+  for (let attempt = 0; attempt < 6; attempt++) {
+    const x = Math.round(rng() * maxX);
+    const y = bottom ? Math.round(bandTop + rng() * (maxY - bandTop)) : Math.round(rng() * maxY);
+    const distance = Math.hypot(x - from.x, y - from.y);
+    if (distance >= MIN_TRIP_PX) return { x, y };
+    if (distance > bestDistance) {
+      best = { x, y };
+      bestDistance = distance;
+    }
+  }
+  return best;
+}
+
+export function startRoam(area: Size, sprite: Size, rng: Rng): RoamState {
+  const { maxX, maxY } = roomFor(area, sprite);
+  return {
+    x: Math.round(maxX * (0.6 + 0.3 * rng())),
+    y: maxY,
+    target: null,
+    restLeft: restDuration(rng),
+    idleFor: 0,
+    facing: -1,
+    mood: "rest",
+  };
+}
+
+/** Wake a sleeping pet (a click, a status line): it rests briefly and goes on. */
+export function nudge(state: RoamState): RoamState {
+  return { ...state, idleFor: 0, mood: state.target === null ? "rest" : "walk" };
+}
+
+/** Advance the wander by `dtMs` inside `area` (see the module notes). */
+export function stepRoam(
+  state: RoamState,
+  area: Size,
+  sprite: Size,
+  dtMs: number,
+  rng: Rng,
+): RoamState {
+  const dt = Number.isFinite(dtMs) ? Math.max(0, Math.min(dtMs, 1_000)) : 0;
+  const here = clampPoint(area, sprite, state);
+  if (state.target === null) {
+    const restLeft = state.restLeft - dt;
+    const idleFor = state.idleFor + dt;
+    if (idleFor >= SLEEP_AFTER_MS) {
+      return { ...state, ...here, restLeft: Math.max(0, restLeft), idleFor, mood: "sleep" };
+    }
+    if (restLeft > 0) return { ...state, ...here, restLeft, idleFor, mood: "rest" };
+    const target = pickTarget(area, sprite, here, rng);
+    const facing = target.x < here.x ? -1 : target.x > here.x ? 1 : state.facing;
+    return { ...state, ...here, target, restLeft: 0, facing, mood: "walk" };
+  }
+  const goal = clampPoint(area, sprite, state.target);
+  const dx = goal.x - here.x;
+  const dy = goal.y - here.y;
+  const distance = Math.hypot(dx, dy);
+  const travel = (WALK_SPEED_PX_S * dt) / 1_000;
+  if (distance <= travel || distance === 0) {
+    return {
+      ...state,
+      ...goal,
+      target: null,
+      restLeft: restDuration(rng),
+      idleFor: 0,
+      mood: "rest",
+    };
+  }
+  const next = clampPoint(area, sprite, {
+    x: here.x + (dx / distance) * travel,
+    y: here.y + (dy / distance) * travel,
+  });
+  return {
+    ...state,
+    ...next,
+    target: goal,
+    idleFor: 0,
+    facing: dx < 0 ? -1 : dx > 0 ? 1 : state.facing,
+    mood: "walk",
+  };
+}
+
+/** A small seeded generator (tests, and a stable first position per session). */
+export function seededRng(seed: number): Rng {
+  let s = seed >>> 0 || 1;
+  return () => {
+    s ^= s << 13;
+    s >>>= 0;
+    s ^= s >>> 17;
+    s ^= s << 5;
+    s >>>= 0;
+    return s / 4_294_967_296;
+  };
+}
