+++ b/src/indus/tools/builtin/media/wake_word.py
@@ -0,0 +1,598 @@
+"""Wake word (P24-20): listen for "hey indus" and hand off to voice mode.
+
+Pieces, smallest first:
+
+- ``WakeEngine``: scores one audio frame (16 kHz mono int16 little-endian, ``frame_length``
+  samples) from 0 to 1. ``OpenWakeWordEngine`` (the default) and ``SherpaKeywordEngine`` are thin
+  adapters over optional packages, imported only when built; no wake model ships with Indus — the
+  person trains one with the engine's own tools or supplies one (``wake_word.model``).
+- ``WakeDetector``: turns scores into detections, one per utterance: ``confirm_frames`` frames in
+  a row at or over the threshold fire once; it then stays quiet until ``REARM_FRAMES`` frames fall
+  below the threshold again, and never fires twice within ``cooldown_s``.
+- ``WakeService``: the one listener of a process. It opens the microphone only when the person
+  enabled the feature *and* gave consent (``wake_word.enabled`` and ``wake_word.consent``, both
+  written only by an explicit "on"), only for the surface that owns the lease, and only while it
+  is started and not paused. On a detection it pauses itself (the surface's own voice capture
+  needs the microphone) and calls ``on_detect(owner, phrase)``; the RPC layer turns that into a
+  ``wake.detected`` event (``indus.service.wake_rpc``). With client capture the surface sends the
+  audio (``feed``) and no microphone is opened here at all.
+"""
+
+from __future__ import annotations
+
+import importlib
+import logging
+import math
+import struct
+import threading
+import time
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Literal, Protocol, cast
+
+__all__ = [
+    "CONFIRM_FRAMES",
+    "COOLDOWN_S",
+    "DEFAULT_PHRASE",
+    "FRAME_LENGTH",
+    "MAX_FEED_BYTES",
+    "REARM_FRAMES",
+    "SAMPLE_RATE",
+    "AudioStream",
+    "Microphone",
+    "OpenWakeWordEngine",
+    "SherpaKeywordEngine",
+    "SoundDeviceMicrophone",
+    "StartOutcome",
+    "WakeDetector",
+    "WakeEngine",
+    "WakeError",
+    "WakeService",
+    "WakeSettings",
+    "WakeUnavailable",
+    "build_engine",
+    "check_requirements",
+    "split_frames",
+]
+
+log = logging.getLogger(__name__)
+
+SAMPLE_RATE = 16_000
+FRAME_LENGTH = 1_280
+"""80 ms at 16 kHz: what both engines expect."""
+DEFAULT_PHRASE = "hey indus"
+CONFIRM_FRAMES = 3
+REARM_FRAMES = 5
+COOLDOWN_S = 2.0
+MAX_FEED_BYTES = 64_000
+"""Two seconds of client audio in one ``wake.feed``."""
+
+type EngineName = Literal["openwakeword", "sherpa"]
+ENGINES: tuple[EngineName, ...] = ("openwakeword", "sherpa")
+
+_PACKAGES: Mapping[str, tuple[str, str]] = {
+    "openwakeword": ("openwakeword", "pip install openwakeword (or uv add openwakeword)"),
+    "sherpa": ("sherpa_onnx", "uv sync --extra wake-sherpa"),
+}
+
+
+class WakeError(Exception):
+    """A wake-word action that cannot be done; the message is meant for the person."""
+
+
+class WakeUnavailable(WakeError):
+    """The engine or its model is missing here; the message says what to install or set."""
+
+
+# -- settings -------------------------------------------------------------------------------------
+
+
+def _clamp(value: object, lo: float, hi: float, fallback: float) -> float:
+    try:
+        number = float(cast(Any, value))
+    except (TypeError, ValueError):
+        return fallback
+    if math.isnan(number):
+        return fallback
+    return max(lo, min(hi, number))
+
+
+@dataclass(frozen=True)
+class WakeSettings:
+    enabled: bool = False
+    consent: bool = False
+    engine: EngineName = "openwakeword"
+    phrase: str = DEFAULT_PHRASE
+    model: str = ""
+    threshold: float = 0.5
+    confirm_frames: int = CONFIRM_FRAMES
+    cooldown_s: float = COOLDOWN_S
+
+    @classmethod
+    def from_mapping(cls, raw: Mapping[str, Any]) -> WakeSettings:
+        """The ``wake_word`` section, with out-of-range numbers clamped."""
+        engine = str(raw.get("engine") or "openwakeword").strip().lower()
+        return cls(
+            enabled=raw.get("enabled") is True,
+            consent=raw.get("consent") is True,
+            engine=cast(EngineName, engine if engine in ENGINES else "openwakeword"),
+            phrase=" ".join(str(raw.get("phrase") or DEFAULT_PHRASE).split()) or DEFAULT_PHRASE,
+            model=str(raw.get("model") or "").strip(),
+            threshold=_clamp(raw.get("threshold"), 0.05, 0.99, 0.5),
+            confirm_frames=int(_clamp(raw.get("confirm_frames"), 1, 10, CONFIRM_FRAMES)),
+            cooldown_s=_clamp(raw.get("cooldown_s"), 0.0, 60.0, COOLDOWN_S),
+        )
+
+
+# -- engines --------------------------------------------------------------------------------------
+
+
+class WakeEngine(Protocol):
+    @property
+    def name(self) -> str: ...
+
+    @property
+    def frame_length(self) -> int: ...
+
+    def score(self, frame: bytes, /) -> float:
+        """How sure the engine is that ``frame`` ends the phrase, 0..1."""
+        ...
+
+
+def _samples(frame: bytes) -> list[int]:
+    count = len(frame) // 2
+    return list(struct.unpack(f"<{count}h", frame[: count * 2]))
+
+
+class OpenWakeWordEngine:
+    """openWakeWord with the person's own model file (``.onnx`` or ``.tflite``)."""
+
+    name = "openwakeword"
+    frame_length = FRAME_LENGTH
+
+    def __init__(self, model_path: Path) -> None:
+        module: Any = importlib.import_module("openwakeword.model")
+        framework = "onnx" if model_path.suffix.lower() == ".onnx" else "tflite"
+        self._model: Any = module.Model(
+            wakeword_models=[str(model_path)], inference_framework=framework
+        )
+        self._np: Any = importlib.import_module("numpy")
+
+    def score(self, frame: bytes) -> float:
+        audio = self._np.frombuffer(frame, dtype=self._np.int16)
+        scores = cast(Mapping[str, float], self._model.predict(audio))
+        return max((float(v) for v in scores.values()), default=0.0)
+
+
+class SherpaKeywordEngine:
+    """sherpa-onnx keyword spotting with a model folder and a keywords file the person supplies.
+
+    The folder holds ``tokens.txt``, ``encoder*.onnx``, ``decoder*.onnx``, ``joiner*.onnx`` and
+    ``keywords.txt`` (the phrase in the model's token units). A spotted keyword scores 1.
+    """
+
+    name = "sherpa"
+    frame_length = FRAME_LENGTH
+
+    def __init__(self, model_dir: Path) -> None:
+        sherpa: Any = importlib.import_module("sherpa_onnx")
+
+        def one(pattern: str) -> str:
+            found = sorted(model_dir.glob(pattern))
+            if not found:
+                raise WakeUnavailable(f"the sherpa model folder has no {pattern}")
+            return str(found[0])
+
+        self._spotter: Any = sherpa.KeywordSpotter(
+            tokens=one("tokens.txt"),
+            encoder=one("encoder*.onnx"),
+            decoder=one("decoder*.onnx"),
+            joiner=one("joiner*.onnx"),
+            keywords_file=one("keywords.txt"),
+            num_threads=1,
+        )
+        self._stream: Any = self._spotter.create_stream()
+
+    def score(self, frame: bytes) -> float:
+        samples = [s / 32768.0 for s in _samples(frame)]
+        self._stream.accept_waveform(SAMPLE_RATE, samples)
+        hit = False
+        while self._spotter.is_ready(self._stream):
+            self._spotter.decode_stream(self._stream)
+            if self._spotter.get_result(self._stream):
+                hit = True
+                self._spotter.reset_stream(self._stream)
+        return 1.0 if hit else 0.0
+
+
+def check_requirements(
+    settings: WakeSettings, *, find_module: Callable[[str], bool] | None = None
+) -> tuple[bool, str]:
+    """``(available, hint)`` without opening anything: package present, model set and found."""
+    module, install = _PACKAGES[settings.engine]
+    finder = find_module or _module_present
+    if not finder(module):
+        return False, f"The {settings.engine} engine is not installed: {install}."
+    if not settings.model:
+        return False, (
+            "No wake model is set: train or download a model for the phrase "
+            f"“{settings.phrase}” and set wake_word.model to its path."
+        )
+    if not Path(settings.model).expanduser().exists():
+        return False, f"The wake model {settings.model} does not exist."
+    return True, ""
+
+
+def _module_present(name: str) -> bool:
+    import importlib.util
+
+    try:
+        return importlib.util.find_spec(name) is not None
+    except (ImportError, ValueError):
+        return False
+
+
+def build_engine(settings: WakeSettings) -> WakeEngine:
+    available, hint = check_requirements(settings)
+    if not available:
+        raise WakeUnavailable(hint)
+    path = Path(settings.model).expanduser()
+    try:
+        if settings.engine == "sherpa":
+            return SherpaKeywordEngine(path)
+        return OpenWakeWordEngine(path)
+    except WakeUnavailable:
+        raise
+    except Exception as exc:
+        raise WakeUnavailable(
+            f"The {settings.engine} engine could not load the model: {exc}"
+        ) from None
+
+
+# -- detection ------------------------------------------------------------------------------------
+
+
+def split_frames(pcm: bytes, frame_length: int) -> list[bytes]:
+    """``pcm`` cut into frames of ``frame_length`` samples; the last one zero-padded."""
+    size = frame_length * 2
+    if size <= 0:
+        return []
+    usable = len(pcm) - (len(pcm) % 2)
+    frames = [pcm[i : i + size] for i in range(0, usable, size)]
+    if frames and len(frames[-1]) < size:
+        frames[-1] = frames[-1] + b"\x00" * (size - len(frames[-1]))
+    return frames
+
+
+class WakeDetector:
+    """Scores in, one detection per utterance out (see the module notes)."""
+
+    def __init__(
+        self,
+        engine: WakeEngine,
+        settings: WakeSettings,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self.engine = engine
+        self.threshold = settings.threshold
+        self.confirm = settings.confirm_frames
+        self.cooldown = settings.cooldown_s
+        self._clock = clock
+        self._streak = 0
+        self._quiet = REARM_FRAMES
+        self._armed = True
+        self._last_fire: float | None = None
+
+    def feed(self, frame: bytes) -> bool:
+        """Score one frame; True when this frame is the detection."""
+        try:
+            score = self.engine.score(frame)
+        except Exception:
+            log.warning("wake word: the engine failed on a frame", exc_info=True)
+            return False
+        if score >= self.threshold:
+            self._streak += 1
+            self._quiet = 0
+        else:
+            self._streak = 0
+            self._quiet += 1
+            if self._quiet >= REARM_FRAMES:
+                self._armed = True
+        if not self._armed or self._streak < self.confirm:
+            return False
+        now = self._clock()
+        if self._last_fire is not None and now - self._last_fire < self.cooldown:
+            return False
+        self._armed = False
+        self._streak = 0
+        self._last_fire = now
+        return True
+
+    def reset(self) -> None:
+        self._streak = 0
+        self._quiet = REARM_FRAMES
+        self._armed = True
+
+
+# -- the microphone -------------------------------------------------------------------------------
+
+
+class AudioStream(Protocol):
+    def read(self) -> bytes | None:
+        """One frame, or None when the stream ended."""
+        ...
+
+    def close(self) -> None: ...
+
+
+class Microphone(Protocol):
+    def open(self, sample_rate: int, frame_length: int) -> AudioStream: ...
+
+
+class _SoundDeviceStream:
+    def __init__(self, stream: Any, frame_length: int) -> None:
+        self._stream = stream
+        self._frame_length = frame_length
+        self._closed = False
+
+    def read(self) -> bytes | None:
+        if self._closed:
+            return None
+        try:
+            data, _overflow = self._stream.read(self._frame_length)
+        except Exception:
+            return None
+        return bytes(data)
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            self._stream.stop()
+            self._stream.close()
+        except Exception:
+            log.debug("wake word: closing the input stream failed", exc_info=True)
+
+
+class SoundDeviceMicrophone:
+    """The default input device through ``sounddevice`` (the ``voice`` extra)."""
+
+    def open(self, sample_rate: int, frame_length: int) -> AudioStream:
+        try:
+            sd: Any = importlib.import_module("sounddevice")
+        except ImportError:
+            raise WakeUnavailable("No audio input here: uv sync --extra voice.") from None
+        stream: Any = sd.RawInputStream(
+            samplerate=sample_rate, channels=1, dtype="int16", blocksize=frame_length
+        )
+        stream.start()
+        return _SoundDeviceStream(stream, frame_length)
+
+
+# -- the service ----------------------------------------------------------------------------------
+
+type StartReason = Literal["disabled", "consent_required", "unavailable", "owned"]
+
+
+@dataclass(frozen=True)
+class StartOutcome:
+    started: bool
+    reason: StartReason | None = None
+    hint: str = ""
+    phrase: str = DEFAULT_PHRASE
+    engine: str = ""
+    capture: Literal["local", "client"] = "local"
+
+
+@dataclass
+class _Lease:
+    owner: object
+    surface: str
+    detector: WakeDetector
+    phrase: str
+    client_capture: bool
+    paused: bool = False
+    stream: AudioStream | None = None
+    reader: threading.Thread | None = None
+    stop: threading.Event = field(default_factory=threading.Event)
+
+
+class WakeService:
+    """The process's one wake-word listener (see the module notes)."""
+
+    def __init__(
+        self,
+        settings: Callable[[], WakeSettings],
+        *,
+        on_detect: Callable[[object, str], None],
+        microphone: Microphone | None = None,
+        engine_factory: Callable[[WakeSettings], WakeEngine] = build_engine,
+        clock: Callable[[], float] = time.monotonic,
+    ) -> None:
+        self._settings = settings
+        self._on_detect = on_detect
+        self._microphone: Microphone = microphone or SoundDeviceMicrophone()
+        self._engine_factory = engine_factory
+        self._clock = clock
+        self._lock = threading.RLock()
+        self._lease: _Lease | None = None
+
+    # -- lease ----------------------------------------------------------------------------------
+
+    def owner(self) -> object | None:
+        with self._lock:
+            return self._lease.owner if self._lease is not None else None
+
+    def owner_surface(self) -> str | None:
+        with self._lock:
+            return self._lease.surface if self._lease is not None else None
+
+    def start(self, owner: object, surface: str, *, client_capture: bool = False) -> StartOutcome:
+        """Arm the listener for ``owner``; the microphone opens only when every rule allows it."""
+        settings = self._settings()
+        if not settings.enabled:
+            return StartOutcome(False, "disabled", phrase=settings.phrase)
+        if not settings.consent:
+            return StartOutcome(
+                False,
+                "consent_required",
+                "Turn the wake word on from Settings or /wake on to agree to listening.",
+                phrase=settings.phrase,
+            )
+        with self._lock:
+            current = self._lease
+            if current is not None and current.owner is not owner:
+                return StartOutcome(False, "owned", phrase=settings.phrase)
+            if current is not None:
+                return self._outcome(current, settings)
+            try:
+                engine = self._engine_factory(settings)
+            except WakeUnavailable as exc:
+                return StartOutcome(False, "unavailable", str(exc), phrase=settings.phrase)
+            lease = _Lease(
+                owner=owner,
+                surface=surface,
+                detector=WakeDetector(engine, settings, self._clock),
+                phrase=settings.phrase,
+                client_capture=client_capture,
+            )
+            if not client_capture:
+                try:
+                    self._open(lease)
+                except WakeUnavailable as exc:
+                    return StartOutcome(False, "unavailable", str(exc), phrase=settings.phrase)
+            self._lease = lease
+            return self._outcome(lease, settings)
+
+    def _outcome(self, lease: _Lease, settings: WakeSettings) -> StartOutcome:
+        return StartOutcome(
+            True,
+            phrase=lease.phrase,
+            engine=lease.detector.engine.name,
+            capture="client" if lease.client_capture else "local",
+        )
+
+    def stop(self, owner: object) -> bool:
+        with self._lock:
+            lease = self._lease
+            if lease is None or lease.owner is not owner:
+                return False
+            self._lease = None
+        self._close(lease)
+        return True
+
+    def release_owner(self, owner: object) -> bool:
+        """The owner went away (its connection closed)."""
+        return self.stop(owner)
+
+    def pause(self, owner: object) -> bool:
+        """Release the microphone (the surface records now); the lease stays."""
+        with self._lock:
+            lease = self._lease
+            if lease is None or lease.owner is not owner:
+                return False
+            if lease.paused:
+                return True
+            lease.paused = True
+        self._close(lease)
+        return True
+
+    def resume(self, owner: object) -> bool:
+        with self._lock:
+            lease = self._lease
+            if lease is None or lease.owner is not owner:
+                return False
+            if not lease.paused:
+                return True
+            settings = self._settings()
+            if not (settings.enabled and settings.consent):
+                return False
+            lease.paused = False
+            lease.detector.reset()
+            if not lease.client_capture:
+                try:
+                    self._open(lease)
+                except WakeUnavailable:
+                    lease.paused = True
+                    return False
+        return True
+
+    def listening(self, owner: object | None = None) -> bool:
+        with self._lock:
+            lease = self._lease
+            if lease is None or lease.paused:
+                return False
+            return owner is None or lease.owner is owner
+
+    def feed(self, owner: object, pcm: bytes) -> bool:
+        """Client-captured audio for an armed client-capture lease; True when it was used."""
+        if len(pcm) > MAX_FEED_BYTES:
+            raise WakeError(f"one feed carries at most {MAX_FEED_BYTES} bytes")
+        with self._lock:
+            lease = self._lease
+            if (
+                lease is None
+                or lease.owner is not owner
+                or lease.paused
+                or not lease.client_capture
+            ):
+                return False
+        for frame in split_frames(pcm, lease.detector.engine.frame_length):
+            if self._frame(lease, frame):
+                break
+        return True
+
+    # -- audio ----------------------------------------------------------------------------------
+
+    def _open(self, lease: _Lease) -> None:
+        stream = self._microphone.open(SAMPLE_RATE, lease.detector.engine.frame_length)
+        lease.stop = threading.Event()
+        lease.stream = stream
+        reader = threading.Thread(
+            target=self._read_loop, args=(lease, stream, lease.stop), daemon=True, name="wake-word"
+        )
+        lease.reader = reader
+        reader.start()
+
+    def _close(self, lease: _Lease) -> None:
+        lease.stop.set()
+        stream, lease.stream = lease.stream, None
+        if stream is not None:
+            stream.close()
+        reader, lease.reader = lease.reader, None
+        if reader is not None and reader is not threading.current_thread():
+            reader.join(timeout=2.0)
+
+    def _read_loop(self, lease: _Lease, stream: AudioStream, stop: threading.Event) -> None:
+        while not stop.is_set():
+            frame = stream.read()
+            if frame is None:
+                return
+            if self._frame(lease, frame):
+                return
+
+    def _frame(self, lease: _Lease, frame: bytes) -> bool:
+        if not lease.detector.feed(frame):
+            return False
+        with self._lock:
+            if self._lease is not lease or lease.paused:
+                return False
+            lease.paused = True
+        lease.stop.set()
+        stream, lease.stream = lease.stream, None
+        if stream is not None:
+            stream.close()
+        try:
+            self._on_detect(lease.owner, lease.phrase)
+        except Exception:
+            log.warning("wake word: the detection hand-off failed", exc_info=True)
+        return True
+
+    def wait_idle(self, timeout: float = 2.0) -> None:
+        """Join the reader thread (tests)."""
+        with self._lock:
+            reader = self._lease.reader if self._lease is not None else None
+        if reader is not None:
+            reader.join(timeout)
diff --git a/src/indus/tools/builtin/preview.py b/src/indus/tools/builtin/preview.py
new file mode 100644
index 0000000..7276bd1
--- /dev/null
+++ b/src/indus/tools/builtin/preview.py
@@ -0,0 +1,248 @@
+"""Desktop-only preview tools (P24-25): ``drive_preview`` and ``annotate_preview``.
+
+The desktop app's preview pane shows a web page or a local file next to a session. These tools let
+the agent use it: ``drive_preview`` navigates, clicks, types, scrolls or reads a snapshot of the
+page; ``annotate_preview`` puts numbered notes on elements for the person to see. Each call
+becomes one server request — ``preview.act`` or ``preview.read`` — answered by the desktop window
+that shows this session's preview. A window that does not show it declines with ``not_shown``;
+every action runs inside the page's own sandbox there, never in the app.
+
+The tools exist only in sessions a desktop window created: ``register_tools(registry,
+surface=...)`` registers them for the ``gui`` surface and does nothing otherwise. The handler gets
+the session's preview channel as the ``preview`` keyword (``PreviewPort``); without one it says so.
+
+Interface (until the protocol knows the two request kinds): ``PreviewPort.request(kind, payload,
+timeout)`` returns the window's answer as a mapping, or raises ``PreviewDeclined`` (no window shows
+the preview) or ``PreviewUndelivered`` (no desktop window is attached any more).
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Mapping
+from typing import Any, Literal, Protocol, cast
+
+from indus.tools.calls import ToolResult
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+__all__ = [
+    "ACTIONS",
+    "ANNOTATE_SCHEMA",
+    "DESKTOP_SURFACE",
+    "DRIVE_SCHEMA",
+    "MAX_PINS",
+    "PREVIEW_TIMEOUT_S",
+    "PREVIEW_TOOLSET",
+    "PreviewDeclined",
+    "PreviewPort",
+    "PreviewUndelivered",
+    "annotate_preview",
+    "drive_preview",
+    "register_tools",
+]
+
+PREVIEW_TOOLSET = "desktop-preview"
+DESKTOP_SURFACE = "gui"
+PREVIEW_TIMEOUT_S = 30.0
+MAX_PINS = 20
+MAX_TEXT = 4_000
+MAX_SELECTOR = 500
+MAX_NOTE = 500
+
+type Kind = Literal["preview.act", "preview.read"]
+
+ACTIONS: tuple[str, ...] = ("navigate", "click", "type", "scroll", "snapshot")
+_URL = re.compile(r"^(https?://|file:///)", re.IGNORECASE)
+
+
+class PreviewDeclined(Exception):
+    """The window answering does not show this session's preview (``not_shown``)."""
+
+    def __init__(self, reason: str = "not_shown") -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+class PreviewUndelivered(Exception):
+    """No desktop window is attached to the session any more."""
+
+
+class PreviewPort(Protocol):
+    async def request(
+        self, kind: Kind, payload: Mapping[str, Any], *, timeout: float
+    ) -> Mapping[str, Any]: ...
+
+
+def _text(args: Mapping[str, Any], key: str, limit: int) -> str | None:
+    value = args.get(key)
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise ValueError(f"{key} must be text")
+    if len(value) > limit:
+        raise ValueError(f"{key} is longer than {limit:,} characters")
+    return value
+
+
+def _number(args: Mapping[str, Any], key: str) -> int:
+    value = args.get(key, 0)
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError(f"{key} must be a number of pixels")
+    return max(-20_000, min(20_000, int(value)))
+
+
+def _drive_payload(args: Mapping[str, Any]) -> tuple[Kind, dict[str, Any]]:
+    action = str(args.get("action") or "").strip().lower()
+    if action not in ACTIONS:
+        raise ValueError(f"action must be one of {', '.join(ACTIONS)}")
+    if action == "snapshot":
+        return "preview.read", {"what": "snapshot"}
+    payload: dict[str, Any] = {"action": action}
+    if action == "navigate":
+        url = (_text(args, "url", 2_048) or "").strip()
+        if not _URL.match(url):
+            raise ValueError("url must be an http(s) address or a file:/// path")
+        payload["url"] = url
+    elif action in ("click", "type"):
+        selector = (_text(args, "selector", MAX_SELECTOR) or "").strip()
+        if not selector:
+            raise ValueError(f"{action} needs a CSS selector")
+        payload["selector"] = selector
+        if action == "type":
+            payload["text"] = _text(args, "text", MAX_TEXT) or ""
+            payload["submit"] = args.get("submit") is True
+    else:  # scroll
+        selector = (_text(args, "selector", MAX_SELECTOR) or "").strip()
+        if selector:
+            payload["selector"] = selector
+        else:
+            payload["dx"] = _number(args, "dx")
+            payload["dy"] = _number(args, "dy")
+    return "preview.act", payload
+
+
+def _failure(exc: BaseException) -> str:
+    if isinstance(exc, PreviewDeclined):
+        return ToolResult.error(
+            "This session's preview is not open in a desktop window; ask the person to open "
+            "the preview pane, then try again."
+        ).text
+    if isinstance(exc, PreviewUndelivered):
+        return ToolResult.error("No desktop window is attached to this session now.").text
+    if isinstance(exc, TimeoutError):
+        return ToolResult.error(f"The preview did not answer within {PREVIEW_TIMEOUT_S:g} s.").text
+    return ToolResult.error(f"The preview could not do that: {exc}").text
+
+
+async def _ask(preview: PreviewPort | None, kind: Kind, payload: dict[str, Any]) -> str:
+    if preview is None:
+        return ToolResult.error("There is no desktop preview in this session.").text
+    try:
+        answer = await preview.request(kind, payload, timeout=PREVIEW_TIMEOUT_S)
+    except (PreviewDeclined, PreviewUndelivered, TimeoutError) as exc:
+        return _failure(exc)
+    if answer.get("ok") is False:
+        return ToolResult.error(str(answer.get("error") or "the page refused the action")).text
+    return json.dumps(dict(answer), ensure_ascii=False)
+
+
+async def drive_preview(args: Mapping[str, Any], *, preview: PreviewPort | None = None) -> str:
+    """The ``drive_preview`` handler (see the module notes)."""
+    try:
+        kind, payload = _drive_payload(args)
+    except ValueError as exc:
+        return ToolResult.error(str(exc)).text
+    return await _ask(preview, kind, payload)
+
+
+async def annotate_preview(args: Mapping[str, Any], *, preview: PreviewPort | None = None) -> str:
+    """The ``annotate_preview`` handler: numbered notes on page elements, shown to the person."""
+    raw: object = args.get("pins")
+    if not isinstance(raw, list) or not raw:
+        return ToolResult.error("pins must be a non-empty list of {selector, note}.").text
+    items = cast(list[object], raw)
+    if len(items) > MAX_PINS:
+        return ToolResult.error(f"at most {MAX_PINS} pins fit in one call.").text
+    pins: list[dict[str, str]] = []
+    for index, item in enumerate(items):
+        if not isinstance(item, Mapping):
+            return ToolResult.error(f"pins[{index}] must be an object.").text
+        entry = cast(Mapping[str, Any], item)
+        try:
+            selector = (_text(entry, "selector", MAX_SELECTOR) or "").strip()
+            note = (_text(entry, "note", MAX_NOTE) or "").strip()
+        except ValueError as exc:
+            return ToolResult.error(f"pins[{index}]: {exc}").text
+        if not selector or not note:
+            return ToolResult.error(f"pins[{index}] needs a selector and a note.").text
+        pins.append({"selector": selector, "note": note})
+    return await _ask(preview, "preview.act", {"action": "annotate", "pins": pins})
+
+
+DRIVE_SCHEMA: dict[str, Any] = {
+    "name": "drive_preview",
+    "description": (
+        "Use the page shown in this session's desktop preview pane. action: navigate (url), "
+        "click (selector), type (selector, text, submit?), scroll (selector, or dx/dy pixels) "
+        "or snapshot (title, address, visible text and the interactive elements). Works only "
+        "while the person has the preview open; secret field values are never returned."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["action"],
+        "properties": {
+            "action": {"type": "string", "enum": list(ACTIONS)},
+            "url": {"type": "string", "description": "For navigate: http(s) or file:/// only."},
+            "selector": {"type": "string", "description": "A CSS selector on the page."},
+            "text": {"type": "string", "description": "For type: the text to enter."},
+            "submit": {"type": "boolean", "description": "For type: press Enter after."},
+            "dx": {"type": "integer", "description": "For scroll: pixels to the right."},
+            "dy": {"type": "integer", "description": "For scroll: pixels down."},
+        },
+    },
+}
+
+ANNOTATE_SCHEMA: dict[str, Any] = {
+    "name": "annotate_preview",
+    "description": (
+        "Point things out on the page in this session's desktop preview: each pin puts a "
+        "numbered note on the element its CSS selector matches, for the person to read."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["pins"],
+        "properties": {
+            "pins": {
+                "type": "array",
+                "minItems": 1,
+                "maxItems": MAX_PINS,
+                "items": {
+                    "type": "object",
+                    "required": ["selector", "note"],
+                    "properties": {
+                        "selector": {"type": "string"},
+                        "note": {"type": "string"},
+                    },
+                },
+            }
+        },
+    },
+}
+
+
+def register_tools(registry: ToolRegistry, *, surface: str | None = None) -> bool:
+    """Register both tools for a desktop session (``surface == "gui"``); True when registered."""
+    if surface != DESKTOP_SURFACE:
+        return False
+    registry.register(
+        "drive_preview", PREVIEW_TOOLSET, DRIVE_SCHEMA, drive_preview, traits=ToolTraits()
+    )
+    registry.register(
+        "annotate_preview",
+        PREVIEW_TOOLSET,
+        ANNOTATE_SCHEMA,
+        annotate_preview,
+        traits=ToolTraits(),
+    )
+    return True
