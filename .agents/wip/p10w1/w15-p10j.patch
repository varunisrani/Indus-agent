@@ -0,0 +1,35 @@
+"""Media tools: ``vision_analyze``, image and video generation, ``text_to_speech`` (P10-15..17).
+
+``register_tools`` registers them on the module defaults. The provider registries are where
+plugins add backends (P13): ``image_providers`` and ``video_providers`` (generation) and
+``tts_providers`` (speech); they are the registries the default tools use. Speech-to-text is a
+library (``media.stt``), not a model tool.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from indus.tools.registry import ToolRegistry
+
+__all__ = ["register_tools"]
+
+
+def register_tools(registry: ToolRegistry) -> None:
+    from indus.tools.builtin.media import generate, tts, vision
+
+    vision.DEFAULT_TOOL.register(registry)
+    generate.DEFAULT_TOOLS.register(registry)
+    tts.DEFAULT_TOOL.register(registry)
+
+
+def __getattr__(name: str) -> Any:
+    if name in ("image_providers", "video_providers"):
+        from indus.tools.builtin.media import generate
+
+        return getattr(generate.DEFAULT_TOOLS.providers, name)
+    if name == "tts_providers":
+        from indus.tools.builtin.media import tts
+
+        return tts.DEFAULT_TOOL.providers
+    raise AttributeError(name)
diff --git a/src/indus/tools/builtin/media/audio.py b/src/indus/tools/builtin/media/audio.py
new file mode 100644
index 0000000..2c38c57
--- /dev/null
+++ b/src/indus/tools/builtin/media/audio.py
@@ -0,0 +1,234 @@
+"""Audio helpers shared by speech output and transcription: WAV facts, joining, silences, cuts,
+and running ``ffmpeg``.
+
+WAV work uses the standard ``wave`` module on PCM data. Silence finding scans 8- and 16-bit PCM
+in short windows and reports the middle of every quiet run that lasts long enough; other sample
+widths report no silences (callers then cut at the ideal points). ``ffmpeg`` is looked up on the
+profile's ``PATH`` and run with the minimal child environment, never a shell.
+"""
+
+from __future__ import annotations
+
+import io
+import math
+import subprocess
+import wave
+from array import array
+from dataclasses import dataclass
+from pathlib import Path
+
+from indus.foundation.scope import Scope
+from indus.platform.locate import which
+from indus.safety.child_env import child_env
+
+__all__ = [
+    "MAX_LOOKBACK_S",
+    "WavFacts",
+    "cut_points",
+    "find_ffmpeg",
+    "find_program",
+    "is_wav",
+    "join_wav",
+    "run_tool",
+    "silences",
+    "split_wav",
+    "to_opus",
+    "wav_facts",
+]
+
+MAX_LOOKBACK_S = 60.0
+WINDOW_S = 0.05
+QUIET_DBFS = -35.0
+MIN_QUIET_S = 0.4
+FFMPEG_TIMEOUT_S = 300.0
+
+
+@dataclass(frozen=True)
+class WavFacts:
+    channels: int
+    sample_width: int
+    rate: int
+    frames: int
+
+    @property
+    def duration(self) -> float:
+        return self.frames / self.rate if self.rate else 0.0
+
+
+def is_wav(data: bytes) -> bool:
+    return len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WAVE"
+
+
+def wav_facts(source: Path | bytes) -> WavFacts:
+    with wave.open(
+        io.BytesIO(source) if isinstance(source, bytes) else str(source), "rb"
+    ) as handle:
+        return WavFacts(
+            handle.getnchannels(), handle.getsampwidth(), handle.getframerate(), handle.getnframes()
+        )
+
+
+def join_wav(pieces: list[bytes]) -> bytes:
+    """One WAV from several with the same format (``wave.Error`` when they differ)."""
+    out = io.BytesIO()
+    params = None
+    writer: wave.Wave_write | None = None
+    try:
+        for piece in pieces:
+            with wave.open(io.BytesIO(piece), "rb") as reader:
+                current = (reader.getnchannels(), reader.getsampwidth(), reader.getframerate())
+                if writer is None:
+                    params = current
+                    writer = wave.open(out, "wb")  # noqa: SIM115 - closed in finally
+                    writer.setnchannels(current[0])
+                    writer.setsampwidth(current[1])
+                    writer.setframerate(current[2])
+                elif current != params:
+                    raise wave.Error("the audio pieces have different formats")
+                writer.writeframes(reader.readframes(reader.getnframes()))
+    finally:
+        if writer is not None:
+            writer.close()
+    return out.getvalue()
+
+
+def _levels(frames: bytes, width: int, channels: int, per_window: int) -> list[float]:
+    """RMS per window as a share of full scale (0..1), over all channels."""
+    if width == 2:
+        samples = array("h")
+        samples.frombytes(frames[: len(frames) - len(frames) % 2])
+        full = 32768.0
+        values = samples
+    elif width == 1:
+        values = array("h", (b - 128 for b in frames))
+        full = 128.0
+    else:
+        return []
+    step = per_window * channels
+    out: list[float] = []
+    for start in range(0, len(values), step):
+        window = values[start : start + step]
+        if not window:
+            break
+        energy = sum(v * v for v in window) / len(window)
+        out.append(math.sqrt(energy) / full)
+    return out
+
+
+def silences(
+    path: Path, *, quiet_dbfs: float = QUIET_DBFS, min_quiet_s: float = MIN_QUIET_S
+) -> list[float]:
+    """Middle times (seconds) of the quiet runs in a PCM WAV, in order."""
+    facts = wav_facts(path)
+    per_window = max(1, int(facts.rate * WINDOW_S))
+    with wave.open(str(path), "rb") as reader:
+        frames = reader.readframes(facts.frames)
+    levels = _levels(frames, facts.sample_width, facts.channels, per_window)
+    threshold = 10 ** (quiet_dbfs / 20)
+    window_s = per_window / facts.rate
+    found: list[float] = []
+    start: int | None = None
+    for index, level in enumerate([*levels, 1.0]):  # the sentinel closes a trailing run
+        if level < threshold:
+            if start is None:
+                start = index
+            continue
+        if start is not None and (index - start) * window_s >= min_quiet_s:
+            found.append((start + index) * window_s / 2)
+        start = None
+    return found
+
+
+def cut_points(
+    duration: float, target: float, quiet: list[float], *, max_lookback: float = MAX_LOOKBACK_S
+) -> list[float]:
+    """Times to cut at so no piece is longer than ``target`` seconds.
+
+    For each piece the ideal cut is ``target`` after the previous cut; the latest pause no more
+    than the lookback window before it is used instead when there is one. The window is a third
+    of the target, at most ``max_lookback``.
+    """
+    if target <= 0:
+        raise ValueError("target must be positive")
+    lookback = min(max_lookback, target / 3)
+    cuts: list[float] = []
+    previous = 0.0
+    while duration - previous > target:
+        ideal = previous + target
+        nearby = [t for t in quiet if previous < t <= ideal and t >= ideal - lookback]
+        previous = max(nearby) if nearby else ideal
+        cuts.append(previous)
+    return cuts
+
+
+def split_wav(path: Path, cuts: list[float], out_dir: Path) -> list[Path]:
+    """Write the pieces between ``cuts`` as ``part-NNN.wav`` in ``out_dir``, in order."""
+    facts = wav_facts(path)
+    bounds = [0, *(int(round(c * facts.rate)) for c in cuts), facts.frames]
+    pieces: list[Path] = []
+    with wave.open(str(path), "rb") as reader:
+        for index in range(len(bounds) - 1):
+            reader.setpos(bounds[index])
+            frames = reader.readframes(bounds[index + 1] - bounds[index])
+            target = out_dir / f"part-{index:03d}.wav"
+            with wave.open(str(target), "wb") as writer:
+                writer.setnchannels(facts.channels)
+                writer.setsampwidth(facts.sample_width)
+                writer.setframerate(facts.rate)
+                writer.writeframes(frames)
+            pieces.append(target)
+    return pieces
+
+
+def find_program(name: str, scope: Scope | None) -> str | None:
+    """``name`` on the profile's ``PATH`` (the process ``PATH`` when the profile has none)."""
+    return which(name, path=scope.env.get("PATH") if scope is not None else None)
+
+
+def find_ffmpeg(scope: Scope | None) -> str | None:
+    return find_program("ffmpeg", scope)
+
+
+def run_tool(
+    argv: list[str],
+    scope: Scope | None,
+    *,
+    stdin: bytes | None = None,
+    timeout: float = FFMPEG_TIMEOUT_S,
+) -> subprocess.CompletedProcess[bytes]:
+    """Run an external program (no shell) with the minimal child environment."""
+    env = child_env(scope, variant="minimal") if scope is not None else {}
+    return subprocess.run(  # noqa: S603 - argv list, no shell
+        argv,
+        input=stdin,
+        stdin=None if stdin is not None else subprocess.DEVNULL,
+        capture_output=True,
+        timeout=timeout,
+        env=env,
+        check=False,
+    )
+
+
+def to_opus(ffmpeg: str, source: Path, target: Path, scope: Scope | None) -> str | None:
+    """Convert ``source`` to Ogg Opus at ``target``; an error text, or None on success."""
+    argv = [
+        ffmpeg,
+        "-y",
+        "-loglevel",
+        "error",
+        "-i",
+        str(source),
+        "-c:a",
+        "libopus",
+        "-b:a",
+        "48k",
+        str(target),
+    ]
+    try:
+        done = run_tool(argv, scope)
+    except (OSError, subprocess.SubprocessError) as exc:
+        return f"ffmpeg could not run: {exc}"
+    if done.returncode != 0 or not target.is_file() or target.stat().st_size == 0:
+        detail = done.stderr.decode("utf-8", "replace").strip()[-300:]
+        return f"ffmpeg failed ({done.returncode}): {detail or 'no output file'}"
+    return None
diff --git a/src/indus/tools/builtin/media/common.py b/src/indus/tools/builtin/media/common.py
new file mode 100644
index 0000000..8668ce8
--- /dev/null
+++ b/src/indus/tools/builtin/media/common.py
@@ -0,0 +1,170 @@
+"""What the media tools share: settings and secrets, their folders, and the output path rules.
+
+Folders (under the profile home, created owner-only): ``cache/media`` (generated images and
+videos), ``cache/audio`` (speech), ``cache/vision`` (scratch), ``voice-memos`` (speech made on the
+CLI). ``sandbox_path`` gives the in-sandbox name of a cached file when the terminal runs in Docker.
+
+``checked_output_path`` is the producing side of the media path policy (R06.22): a path a caller
+asked us to write must be plain text (no control characters, no ``..`` part, no embedded
+``MEDIA:`` directive that a delivery scanner would take for a second attachment) and, after
+resolving symlinks, may not land on a credential folder, a system path or an Indus secret or
+control file. What we hand back in a ``MEDIA:`` line is always that resolved path.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+import secrets
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.config.schema import default_for
+from indus.foundation.home import secure_dir
+from indus.foundation.scope import Scope
+from indus.safety.path_guards import write_denial, write_needs_approval
+
+__all__ = [
+    "AUDIO_DIR",
+    "MEDIA_DIR",
+    "VISION_DIR",
+    "VOICE_MEMOS_DIR",
+    "OutputRefused",
+    "checked_output_path",
+    "folder",
+    "json_text",
+    "media_line",
+    "sandbox_path",
+    "secret",
+    "setting",
+    "unique_name",
+]
+
+log = logging.getLogger(__name__)
+
+MEDIA_DIR = Path("cache") / "media"
+AUDIO_DIR = Path("cache") / "audio"
+VISION_DIR = Path("cache") / "vision"
+VOICE_MEMOS_DIR = Path("voice-memos")
+SANDBOX_HOME = {"docker": "/root/.indus"}
+
+# A ``MEDIA:`` directive followed by something path-like or quoted (case-insensitive).
+_DIRECTIVE = re.compile(r"media:\s*[`'\"*_]*(?:[`'\"]|[a-z]:[/\\]|~?/)", re.IGNORECASE)
+_CONTROL = re.compile(r"[\x00-\x1f\x7f  ]")
+
+
+def setting(scope: Scope | None, key: str, fallback: Any = None) -> Any:
+    """The profile's value at ``key``, else the schema default, else ``fallback``."""
+    value: Any = None
+    if scope is not None and scope.config is not None:
+        try:
+            value = scope.config.get(key)
+        except Exception:
+            log.debug("config %s unreadable", key, exc_info=True)
+    if value is None:
+        value = default_for(key, fallback)
+    return fallback if value is None else value
+
+
+def setting_text(scope: Scope | None, key: str, fallback: str = "") -> str:
+    value = setting(scope, key, fallback)
+    return value.strip() if isinstance(value, str) else fallback
+
+
+def setting_number(scope: Scope | None, key: str, fallback: float) -> float:
+    value = setting(scope, key, fallback)
+    if isinstance(value, bool):
+        return fallback
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return fallback
+
+
+def secret(scope: Scope | None, name: str) -> str:
+    """A key from the profile's secret store, else its environment; ``""`` when unset."""
+    if scope is None or not name:
+        return ""
+    value: str | None = None
+    if scope.secrets is not None:
+        try:
+            value = scope.secrets.get(name)
+        except Exception:
+            log.debug("secret %s unreadable", name, exc_info=True)
+    if not value:
+        value = scope.env.get(name)
+    return (value or "").strip()
+
+
+def folder(scope: Scope, relative: Path) -> Path:
+    return secure_dir(scope.home / relative, home=scope.home, env=scope.env)
+
+
+def unique_name(prefix: str, extension: str, scope: Scope | None = None) -> str:
+    """``<prefix>-<utc stamp>-<random>.<ext>``; the stamp comes from the profile's clock."""
+    stamp = ""
+    if scope is not None:
+        try:
+            stamp = scope.clock.now().strftime("%Y%m%d-%H%M%S") + "-"
+        except Exception:
+            stamp = ""
+    return f"{prefix}-{stamp}{secrets.token_hex(4)}.{extension.lstrip('.')}"
+
+
+def sandbox_path(scope: Scope, host_path: Path) -> str | None:
+    """Where ``host_path`` (inside the profile home) sits for a container terminal, else None."""
+    backend = setting_text(scope, "terminal.backend", "local").lower()
+    base = SANDBOX_HOME.get(backend)
+    if base is None:
+        return None
+    try:
+        relative = host_path.resolve().relative_to(scope.home.resolve())
+    except ValueError:
+        return None
+    return f"{base}/{relative.as_posix()}"
+
+
+class OutputRefused(ValueError):
+    """A caller-chosen output path broke the media path policy (the message says how)."""
+
+
+def checked_output_path(raw: str, scope: Scope, *, base: Path | None = None) -> Path:
+    """``raw`` resolved and checked for writing media to (see the module notes)."""
+    if not raw.strip():
+        raise OutputRefused("output_path is empty")
+    if _CONTROL.search(raw):
+        raise OutputRefused("output_path contains control characters or line breaks")
+    if _DIRECTIVE.search(raw):
+        raise OutputRefused("output_path must not contain a MEDIA: directive")
+    parts = re.split(r"[\\/]", raw)
+    if ".." in parts:
+        raise OutputRefused("output_path must not contain '..'; give a direct path")
+    text = raw.strip()
+    if text.startswith("~"):
+        home = scope.env.get("HOME")
+        if not home:
+            raise OutputRefused("output_path starts with ~ but no home folder is known here")
+        text = home + text[1:]
+    path = Path(text)
+    if not path.is_absolute():
+        path = (base or Path.cwd()) / path
+    resolved = Path(os.path.realpath(path))
+    reason = write_denial([str(resolved)], scope) or write_needs_approval([str(resolved)], scope)
+    if reason:
+        raise OutputRefused(f"output_path is a protected location: {reason}")
+    return resolved
+
+
+def media_line(path: Path) -> str:
+    return f"MEDIA:{path}"
+
+
+def json_text(body: Mapping[str, Any]) -> str:
+    return json.dumps(body, ensure_ascii=False)
+
+
+def error_text(message: str, **extra: Any) -> str:
+    return json_text({"success": False, "error": message, **extra})
diff --git a/src/indus/tools/builtin/media/generate.py b/src/indus/tools/builtin/media/generate.py
new file mode 100644
index 0000000..27d7fcc
--- /dev/null
+++ b/src/indus/tools/builtin/media/generate.py
@@ -0,0 +1,525 @@
+"""``image_generate`` and the video tools over the provider registries (P10-16).
+
+``image_generate`` (toolset ``image_gen``) is always registered; whether it shows depends on its
+probe (the active image provider is ready). ``video_generate``, ``video_edit`` and
+``video_extend`` (toolset ``video_gen``, opt-in) are registered only while some registered video
+provider declares the matching capability; ``GenerationTools`` re-checks that on every change to
+the video registry, for every tool registry it was registered into. Each tool's description and
+optional parameters are rebuilt from the active provider's capabilities (``schema_overrides``).
+
+The provider and model are the user's (``image_gen.provider`` / ``image_gen.model``,
+``media.video_provider`` / ``media.video_model``); a ``model`` argument from the agent is
+ignored. Input images and videos are loaded under the media source rules (URL policy, secret-file
+guard, size cap). At most ``image_gen.max_parallel_requests`` image requests run at once per
+profile. Bytes and file results are saved under ``<home>/cache/media/``; a URL result is returned
+as given. When the terminal runs in a container the result also says where the saved file sits
+inside the sandbox (``sandbox_path``).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import shutil
+import threading
+import weakref
+from collections.abc import Callable, Mapping
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation.blocking import run_blocking
+from indus.foundation.fsio import atomic_write_bytes
+from indus.foundation.scope import Scope
+from indus.safety.safe_transport import TransportFactory
+from indus.safety.url_policy import Blocked, Resolver, check_url_async
+from indus.tools.builtin.media import imaging
+from indus.tools.builtin.media.common import (
+    MEDIA_DIR,
+    error_text,
+    folder,
+    json_text,
+    sandbox_path,
+    setting_number,
+    setting_text,
+    unique_name,
+)
+from indus.tools.builtin.media.providers import (
+    ImageProvider,
+    ImageRequest,
+    InputMedia,
+    MediaProviders,
+    MediaResult,
+    NoProvider,
+    ProviderFailed,
+    VideoProvider,
+    VideoRequest,
+    active,
+    default_providers,
+)
+from indus.tools.builtin.media.sources import SourceError, load_source
+from indus.tools.registry import ToolRegistry, ToolTraits, scope_key
+
+__all__ = ["IMAGE_TOOLSET", "VIDEO_TOOLSET", "VIDEO_TOOLS", "GenerationTools"]
+
+log = logging.getLogger(__name__)
+
+IMAGE_TOOLSET = "image_gen"
+VIDEO_TOOLSET = "video_gen"
+IMAGE_KEY = "image_gen.provider"
+VIDEO_KEY = "media.video_provider"
+MAX_INPUT_BYTES = 50 * 1024 * 1024
+MAX_VIDEO_INPUT_BYTES = 200 * 1024 * 1024
+DEFAULT_PARALLEL = 4
+MAX_GATES = 64
+
+Operation = Literal["generate", "edit", "extend"]
+# tool name → (operation, capability flag on VideoCapabilities; None = any video provider)
+VIDEO_TOOLS: dict[str, tuple[Operation, str | None]] = {
+    "video_generate": ("generate", None),
+    "video_edit": ("edit", "edit"),
+    "video_extend": ("extend", "extend"),
+}
+
+_IMAGE_BASE = (
+    "Create an image from a text description and save it. The image service and model are "
+    "chosen in the user's settings, not by you. Returns the saved file's absolute path (or a "
+    "URL); show it to the user the way this surface delivers files."
+)
+_VIDEO_BASE = {
+    "generate": "Create a short video from a text description",
+    "edit": "Change an existing video as the prompt describes",
+    "extend": "Continue an existing video past its end as the prompt describes",
+}
+
+
+def _prompt_param(text: str) -> dict[str, Any]:
+    return {"type": "string", "description": text}
+
+
+def _image_schema(provider: ImageProvider | None) -> dict[str, Any]:
+    caps = provider.capabilities if provider is not None else None
+    ratios = list(caps.aspect_ratios) if caps is not None else ["landscape", "square", "portrait"]
+    props: dict[str, Any] = {
+        "prompt": _prompt_param("What the image should show, in detail (or the change to make)."),
+        "aspect_ratio": {
+            "type": "string",
+            "enum": ratios,
+            "default": ratios[0],
+            "description": "Shape of the image.",
+        },
+    }
+    parts = [_IMAGE_BASE]
+    if provider is None:
+        parts.append("No image service is set up yet; calls will say what to configure.")
+    else:
+        parts.append(f"Active service: {provider.title}.")
+        if caps is not None and caps.edit:
+            parts.append("It can change an existing image: pass it as image_url.")
+            props["image_url"] = _prompt_param("An image to change (URL, local path or data: URL).")
+        if caps is not None and caps.max_reference_images > 0:
+            parts.append(
+                f"It accepts up to {caps.max_reference_images} reference images for style or "
+                "content (reference_image_urls)."
+            )
+            props["reference_image_urls"] = {
+                "type": "array",
+                "items": {"type": "string"},
+                "maxItems": caps.max_reference_images,
+                "description": "Images to take style or content from.",
+            }
+    return {
+        "description": " ".join(parts),
+        "parameters": {"type": "object", "required": ["prompt"], "properties": props},
+    }
+
+
+def _video_schema(name: str, provider: VideoProvider | None) -> dict[str, Any]:
+    operation = VIDEO_TOOLS[name][0]
+    caps = provider.capabilities if provider is not None else None
+    parts = [
+        _VIDEO_BASE[operation]
+        + ". The video service and model are chosen in the user's settings. A call can take "
+        "minutes. Returns the saved file's absolute path (or a URL)."
+    ]
+    props: dict[str, Any] = {"prompt": _prompt_param("What should happen in the video.")}
+    if operation != "generate":
+        props["video_url"] = _prompt_param("The video to work on (URL, local path or data: URL).")
+        required = ["video_url", "prompt"]
+    else:
+        required = ["prompt"]
+    if provider is not None and caps is not None:
+        parts.append(f"Active service: {provider.title}.")
+        if operation == "generate":
+            props["aspect_ratio"] = {
+                "type": "string",
+                "enum": list(caps.aspect_ratios),
+                "description": "Shape of the video.",
+            }
+            props["resolution"] = {
+                "type": "string",
+                "enum": list(caps.resolutions),
+                "description": "Output resolution.",
+            }
+            parts.append(
+                f"Aspect ratios: {', '.join(caps.aspect_ratios)}; resolutions: "
+                f"{', '.join(caps.resolutions)}."
+            )
+            if caps.durations:
+                props["duration"] = {
+                    "type": "integer",
+                    "enum": list(caps.durations),
+                    "description": "Length in seconds.",
+                }
+                parts.append(
+                    "Durations: " + ", ".join(str(d) for d in caps.durations) + " seconds."
+                )
+            if caps.image_input:
+                props["image_url"] = _prompt_param("A still image to animate.")
+                parts.append("It can animate a still image passed as image_url.")
+    return {
+        "description": " ".join(parts),
+        "parameters": {"type": "object", "required": required, "properties": props},
+    }
+
+
+def _offers(provider: VideoProvider, capability: str | None) -> bool:
+    return capability is None or bool(getattr(provider.capabilities, capability, False))
+
+
+def _closest(value: int, allowed: tuple[int, ...]) -> int:
+    return min(allowed, key=lambda d: (abs(d - value), d))
+
+
+class GenerationTools:
+    """Handlers, the parallel gate and the registry sync (see the module notes)."""
+
+    def __init__(
+        self,
+        providers: MediaProviders | None = None,
+        *,
+        resolver: Resolver | None = None,
+        inner_factory: TransportFactory | None = None,
+        cwd: Path | None = None,
+    ) -> None:
+        self.providers = providers if providers is not None else default_providers()
+        self.resolver = resolver
+        self.inner_factory = inner_factory
+        self.cwd = cwd
+        self._gates: dict[tuple[int, str, int], asyncio.Semaphore] = {}
+        self._lock = threading.Lock()
+        self._registries: weakref.WeakSet[ToolRegistry] = weakref.WeakSet()
+        self.providers.video_providers.add_listener(self._resync)
+
+    # -- registration ----------------------------------------------------------------------------
+
+    def register(self, registry: ToolRegistry) -> None:
+        registry.register(
+            "image_generate",
+            IMAGE_TOOLSET,
+            {"name": "image_generate", **_image_schema(None)},
+            self.image_generate,
+            probe=self._image_ready,
+            schema_overrides=self._image_overrides,
+            # Each call only creates a new file in the media cache, so calls may run side by side
+            # (the parallel gate bounds them).
+            traits=ToolTraits(read_only=True),
+        )
+        self._registries.add(registry)
+        self.sync(registry)
+
+    def _resync(self) -> None:
+        for registry in list(self._registries):
+            self.sync(registry)
+
+    def sync(self, registry: ToolRegistry) -> None:
+        """Register each video tool some provider can serve; drop the others."""
+        providers = self.providers.video_providers.all()
+        for name, (_operation, capability) in VIDEO_TOOLS.items():
+            if any(_offers(p, capability) for p in providers):
+                if registry.get(name) is None:
+                    registry.register(
+                        name,
+                        VIDEO_TOOLSET,
+                        {"name": name, **_video_schema(name, None)},
+                        self._video_handler(name),
+                        probe=self._video_probe(name),
+                        schema_overrides=self._video_overrides(name),
+                    )
+            elif registry.get(name) is not None:
+                registry.deregister(name)
+
+    def _image_ready(self, scope: Scope) -> bool:
+        try:
+            return active(self.providers.image_providers, scope, IMAGE_KEY).missing(scope) is None
+        except NoProvider:
+            return False
+
+    def _image_overrides(self, scope: Scope | None) -> Mapping[str, Any]:
+        try:
+            provider: ImageProvider | None = active(
+                self.providers.image_providers, scope, IMAGE_KEY
+            )
+        except NoProvider:
+            provider = None
+        return _image_schema(provider)
+
+    def _video_probe(self, name: str) -> Callable[[Scope], bool]:
+        capability = VIDEO_TOOLS[name][1]
+
+        def probe(scope: Scope) -> bool:
+            try:
+                provider = active(self.providers.video_providers, scope, VIDEO_KEY)
+            except NoProvider:
+                return False
+            return _offers(provider, capability) and provider.missing(scope) is None
+
+        probe.__qualname__ = f"GenerationTools.{name}_ready"
+        return probe
+
+    def _video_overrides(self, name: str) -> Callable[[Scope | None], Mapping[str, Any]]:
+        def overrides(scope: Scope | None) -> Mapping[str, Any]:
+            try:
+                provider: VideoProvider | None = active(
+                    self.providers.video_providers, scope, VIDEO_KEY
+                )
+            except NoProvider:
+                provider = None
+            return _video_schema(name, provider)
+
+        return overrides
+
+    def _video_handler(self, name: str) -> Callable[..., Any]:
+        operation = VIDEO_TOOLS[name][0]
+
+        async def handler(args: Mapping[str, Any], *, scope: Scope | None = None) -> str:
+            return await self.video(operation, args, scope=scope)
+
+        handler.__qualname__ = f"GenerationTools.{name}"
+        return handler
+
+    # -- shared steps ----------------------------------------------------------------------------
+
+    def _gate(self, scope: Scope | None) -> asyncio.Semaphore:
+        configured = setting_number(scope, "image_gen.max_parallel_requests", DEFAULT_PARALLEL)
+        limit = max(1, int(configured))
+        key = (id(asyncio.get_running_loop()), scope_key(scope) if scope else "", limit)
+        with self._lock:
+            gate = self._gates.get(key)
+            if gate is None:
+                if len(self._gates) >= MAX_GATES:
+                    self._gates.clear()
+                gate = self._gates[key] = asyncio.Semaphore(limit)
+            return gate
+
+    async def _image_input(self, src: str, scope: Scope | None) -> InputMedia:
+        loaded = await load_source(
+            src,
+            scope,
+            max_bytes=MAX_INPUT_BYTES,
+            cwd=self.cwd,
+            resolver=self.resolver,
+            inner_factory=self.inner_factory,
+        )
+        info = imaging.inspect(loaded.data)
+        return InputMedia(data=loaded.data, mime=info.mime)
+
+    async def _video_input(self, src: str, scope: Scope | None) -> InputMedia:
+        text = src.strip()
+        if text.lower().startswith(("http://", "https://")):
+            verdict = await check_url_async(text, scope, resolver=self.resolver)
+            if isinstance(verdict, Blocked):
+                raise SourceError(f"the address was refused: {verdict.reason}")
+            return InputMedia(url=text)
+        loaded = await load_source(
+            text, scope, max_bytes=MAX_VIDEO_INPUT_BYTES, cwd=self.cwd, resolver=self.resolver
+        )
+        return InputMedia(data=loaded.data, mime="video/mp4")
+
+    async def _save(
+        self, result: MediaResult, scope: Scope | None, kind: str
+    ) -> tuple[str, str | None]:
+        """(what to show: path or URL, sandbox path or None)."""
+        if scope is None:
+            if result.url:
+                return result.url, None
+            raise ProviderFailed("no profile is active, so the result cannot be saved")
+        if result.data is not None:
+            ext = result.extension or _sniff_ext(result.data, kind)
+            target = folder(scope, MEDIA_DIR) / unique_name(kind, ext, scope)
+            await run_blocking(atomic_write_bytes, target, result.data, label="media save")
+        elif result.path is not None:
+            source = Path(result.path)
+            if not source.is_file():
+                raise ProviderFailed(f"the provider named a file that does not exist: {source}")
+            media = folder(scope, MEDIA_DIR)
+            if source.resolve().parent == media.resolve():
+                target = source.resolve()
+            else:
+                target = media / unique_name(kind, source.suffix or "bin", scope)
+                await run_blocking(shutil.copyfile, source, target, label="media save")
+        elif result.url:
+            return result.url, None
+        else:
+            raise ProviderFailed("the provider returned no URL, file or data")
+        return str(target), sandbox_path(scope, target)
+
+    # -- handlers --------------------------------------------------------------------------------
+
+    async def image_generate(self, args: Mapping[str, Any], *, scope: Scope | None = None) -> str:
+        prompt = str(args.get("prompt") or "").strip()
+        if not prompt:
+            return error_text("prompt is required", error_type="bad_arguments")
+        try:
+            provider = active(self.providers.image_providers, scope, IMAGE_KEY)
+        except NoProvider as exc:
+            return error_text(str(exc), error_type="no_provider")
+        reason = provider.missing(scope)
+        if reason:
+            return error_text(
+                f"image provider {provider.name!r} is not ready: {reason}", error_type="not_ready"
+            )
+        caps = provider.capabilities
+        ratio = str(args.get("aspect_ratio") or "").strip().lower()
+        if ratio not in caps.aspect_ratios:
+            ratio = caps.aspect_ratios[0]
+        image_src = str(args.get("image_url") or "").strip()
+        refs_raw = args.get("reference_image_urls") or []
+        refs = [refs_raw] if isinstance(refs_raw, str) else [str(r) for r in refs_raw if r]
+        if image_src and not caps.edit:
+            return error_text(
+                f"{provider.title} cannot change an existing image; leave out image_url",
+                error_type="unsupported",
+            )
+        if len(refs) > caps.max_reference_images:
+            return error_text(
+                f"{provider.title} takes at most {caps.max_reference_images} reference images",
+                error_type="unsupported",
+            )
+        try:
+            image = await self._image_input(image_src, scope) if image_src else None
+            references = tuple([await self._image_input(r, scope) for r in refs])
+        except (SourceError, imaging.BadImage) as exc:
+            return error_text(f"an input image could not be used: {exc}", error_type="bad_input")
+        model = setting_text(scope, "image_gen.model") or provider.default_model
+        request = ImageRequest(prompt, ratio, model, image, references)
+        async with self._gate(scope):
+            outcome = await self._call(provider, request, scope)
+        if isinstance(outcome, str):
+            return outcome
+        try:
+            shown, inside = await self._save(outcome, scope, "image")
+        except (ProviderFailed, OSError) as exc:
+            return error_text(f"the image could not be saved: {exc}", error_type="save_failed")
+        body: dict[str, Any] = {
+            "success": True,
+            "image": shown,
+            "provider": provider.name,
+            "model": model,
+        }
+        if inside:
+            body["sandbox_path"] = inside
+        return json_text(body)
+
+    async def _call(
+        self, provider: ImageProvider | VideoProvider, request: Any, scope: Scope | None
+    ) -> MediaResult | str:
+        try:
+            result = await provider.generate(request, scope=scope)
+        except ProviderFailed as exc:
+            return error_text(f"{provider.title}: {exc}", error_type="provider_error")
+        except Exception as exc:
+            log.warning("media provider %s raised", provider.name, exc_info=True)
+            return error_text(
+                f"{provider.title} failed: {type(exc).__name__}: {exc}",
+                error_type="provider_error",
+            )
+        if not isinstance(result, MediaResult):
+            return error_text(
+                f"{provider.title} returned {type(result).__name__}, not a media result",
+                error_type="provider_contract",
+            )
+        return result
+
+    async def video(
+        self, operation: Operation, args: Mapping[str, Any], *, scope: Scope | None = None
+    ) -> str:
+        prompt = str(args.get("prompt") or "").strip()
+        if not prompt:
+            return error_text("prompt is required", error_type="bad_arguments")
+        try:
+            provider = active(self.providers.video_providers, scope, VIDEO_KEY)
+        except NoProvider as exc:
+            return error_text(str(exc), error_type="no_provider")
+        caps = provider.capabilities
+        capability = {"generate": None, "edit": "edit", "extend": "extend"}[operation]
+        if not _offers(provider, capability):
+            return error_text(
+                f"{provider.title} cannot {operation} videos", error_type="unsupported"
+            )
+        reason = provider.missing(scope)
+        if reason:
+            return error_text(
+                f"video provider {provider.name!r} is not ready: {reason}", error_type="not_ready"
+            )
+        try:
+            image = video = None
+            if operation == "generate":
+                src = str(args.get("image_url") or "").strip()
+                if src and not caps.image_input:
+                    return error_text(
+                        f"{provider.title} cannot animate an image; leave out image_url",
+                        error_type="unsupported",
+                    )
+                image = await self._image_input(src, scope) if src else None
+            else:
+                src = str(args.get("video_url") or "").strip()
+                if not src:
+                    return error_text("video_url is required", error_type="bad_arguments")
+                video = await self._video_input(src, scope)
+        except (SourceError, imaging.BadImage) as exc:
+            return error_text(f"an input could not be used: {exc}", error_type="bad_input")
+        ratio = str(args.get("aspect_ratio") or "").strip()
+        resolution = str(args.get("resolution") or "").strip()
+        duration: int | None = None
+        raw_duration = args.get("duration")
+        if isinstance(raw_duration, int | float) and not isinstance(raw_duration, bool):
+            duration = int(raw_duration)
+        if operation == "generate":
+            ratio = ratio if ratio in caps.aspect_ratios else caps.aspect_ratios[0]
+            resolution = resolution if resolution in caps.resolutions else caps.resolutions[0]
+            if caps.durations:
+                duration = _closest(duration, caps.durations) if duration else caps.durations[0]
+            else:
+                duration = None
+        model = setting_text(scope, "media.video_model") or provider.default_model
+        request = VideoRequest(
+            prompt, model, operation, ratio, duration, resolution, image=image, video=video
+        )
+        outcome = await self._call(provider, request, scope)
+        if isinstance(outcome, str):
+            return outcome
+        try:
+            shown, inside = await self._save(outcome, scope, "video")
+        except (ProviderFailed, OSError) as exc:
+            return error_text(f"the video could not be saved: {exc}", error_type="save_failed")
+        body: dict[str, Any] = {
+            "success": True,
+            "video": shown,
+            "provider": provider.name,
+            "model": model,
+        }
+        if inside:
+            body["sandbox_path"] = inside
+        return json_text(body)
+
+
+def _sniff_ext(data: bytes, kind: str) -> str:
+    mime = imaging.sniff(data)
+    if mime is not None:
+        return {"image/jpeg": "jpg"}.get(mime, mime.split("/")[1])
+    if kind == "video":
+        return "webm" if data[:4] == b"\x1a\x45\xdf\xa3" else "mp4"
+    return "bin"
+
+
+DEFAULT_TOOLS = GenerationTools()
diff --git a/src/indus/tools/builtin/media/imaging.py b/src/indus/tools/builtin/media/imaging.py
new file mode 100644
index 0000000..38d0ebb
--- /dev/null
+++ b/src/indus/tools/builtin/media/imaging.py
@@ -0,0 +1,628 @@
+"""Image facts and the few pixel operations the media tools need.
+
+``inspect(data)`` reads only headers: the type from the first bytes (never the file name), the
+canvas size and the frame count of animated GIF, PNG (APNG) and WebP files. ``check_limits`` turns
+those facts into a refusal before anything decodes the pixels.
+
+Pixel work (``crop``, ``fit``) uses Pillow when it is installed and our own small PNG codec
+otherwise. The fallback reads 8- and 16-bit, non-interlaced PNG in every colour type and writes
+8-bit PNG, which covers screenshots and generated images; anything else without Pillow raises
+``NeedsPillow`` so the caller can say what to install.
+"""
+
+from __future__ import annotations
+
+import base64
+import importlib
+import io
+import struct
+import zlib
+from dataclasses import dataclass
+from types import ModuleType
+from typing import Any
+
+__all__ = [
+    "MAX_FRAMES",
+    "MAX_TOTAL_PIXELS",
+    "BadImage",
+    "Fitted",
+    "ImageInfo",
+    "NeedsPillow",
+    "Raster",
+    "b64_len",
+    "check_limits",
+    "crop",
+    "data_url",
+    "decode_png",
+    "encode_png",
+    "fit",
+    "inspect",
+    "pillow",
+]
+
+MAX_FRAMES = 100
+MAX_TOTAL_PIXELS = 100_000_000
+MIN_SIDE = 64
+PILLOW_EXTRA = "vision"
+
+PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
+
+
+class BadImage(ValueError):
+    """The bytes are not a usable image (the message says why, in plain words)."""
+
+
+class NeedsPillow(BadImage):
+    """This operation on this image type needs Pillow."""
+
+    def __init__(self, what: str) -> None:
+        super().__init__(
+            f"{what} needs the Pillow library, which is not installed "
+            f"(install the `{PILLOW_EXTRA}` extra: pip install 'indus-agent[{PILLOW_EXTRA}]')."
+        )
+
+
+@dataclass(frozen=True)
+class ImageInfo:
+    mime: str
+    width: int
+    height: int
+    frames: int = 1
+
+    @property
+    def longest(self) -> int:
+        return max(self.width, self.height)
+
+
+def pillow() -> ModuleType | None:
+    """``PIL.Image`` when Pillow is installed, else None (it is an optional extra)."""
+    try:
+        return importlib.import_module("PIL.Image")
+    except ImportError:
+        return None
+
+
+# -- sniffing -----------------------------------------------------------------------------------
+
+
+def _png_info(data: bytes) -> ImageInfo:
+    if len(data) < 33 or data[12:16] != b"IHDR":
+        raise BadImage("the PNG header is damaged")
+    width, height = struct.unpack(">II", data[16:24])
+    frames = 1
+    for kind, body in _png_chunks(data, verify=False):
+        if kind == b"acTL" and len(body) >= 4:
+            frames = max(1, struct.unpack(">I", body[:4])[0])
+        if kind == b"IDAT":
+            break
+    return ImageInfo("image/png", width, height, frames)
+
+
+_SOF_MARKERS = frozenset(range(0xC0, 0xD0)) - {0xC4, 0xC8, 0xCC}
+
+
+def _jpeg_info(data: bytes) -> ImageInfo:
+    pos = 2
+    while pos + 4 <= len(data):
+        if data[pos] != 0xFF:
+            pos += 1
+            continue
+        marker = data[pos + 1]
+        if marker == 0xFF:
+            pos += 1
+            continue
+        if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
+            pos += 2
+            continue
+        (length,) = struct.unpack(">H", data[pos + 2 : pos + 4])
+        if marker in _SOF_MARKERS and pos + 9 <= len(data):
+            height, width = struct.unpack(">HH", data[pos + 5 : pos + 9])
+            return ImageInfo("image/jpeg", width, height)
+        if marker == 0xDA or length < 2:
+            break
+        pos += 2 + length
+    raise BadImage("the JPEG has no frame header (damaged or truncated)")
+
+
+def _skip_sub_blocks(data: bytes, pos: int) -> int:
+    while pos < len(data):
+        size = data[pos]
+        pos += 1
+        if size == 0:
+            return pos
+        pos += size
+    raise BadImage("the GIF is truncated")
+
+
+def _gif_info(data: bytes) -> ImageInfo:
+    if len(data) < 13:
+        raise BadImage("the GIF header is damaged")
+    width, height = struct.unpack("<HH", data[6:10])
+    flags = data[10]
+    pos = 13
+    if flags & 0x80:
+        pos += 3 * (2 ** ((flags & 0x07) + 1))
+    frames = 0
+    while pos < len(data):
+        block = data[pos]
+        if block == 0x3B:  # trailer
+            break
+        if block == 0x21:  # extension: label, then sub-blocks
+            pos = _skip_sub_blocks(data, pos + 2)
+        elif block == 0x2C:  # image descriptor
+            frames += 1
+            if frames > MAX_FRAMES:
+                break  # enough to refuse; no need to walk the rest
+            local = data[pos + 9] if pos + 9 < len(data) else 0
+            pos += 10
+            if local & 0x80:
+                pos += 3 * (2 ** ((local & 0x07) + 1))
+            pos = _skip_sub_blocks(data, pos + 1)  # LZW minimum code size, then the data
+        else:
+            raise BadImage("the GIF has an unknown block (damaged)")
+    if frames == 0:
+        raise BadImage("the GIF holds no image")
+    return ImageInfo("image/gif", width, height, frames)
+
+
+def _webp_info(data: bytes) -> ImageInfo:
+    pos = 12
+    width = height = 0
+    frames = 0
+    while pos + 8 <= len(data):
+        kind = data[pos : pos + 4]
+        (size,) = struct.unpack("<I", data[pos + 4 : pos + 8])
+        body = data[pos + 8 : pos + 8 + size]
+        if kind == b"VP8X" and len(body) >= 10:
+            width = 1 + int.from_bytes(body[4:7], "little")
+            height = 1 + int.from_bytes(body[7:10], "little")
+        elif kind == b"VP8 " and len(body) >= 10 and not width:
+            width = struct.unpack("<H", body[6:8])[0] & 0x3FFF
+            height = struct.unpack("<H", body[8:10])[0] & 0x3FFF
+        elif kind == b"VP8L" and len(body) >= 5 and not width:
+            bits = int.from_bytes(body[1:5], "little")
+            width = (bits & 0x3FFF) + 1
+            height = ((bits >> 14) & 0x3FFF) + 1
+        elif kind == b"ANMF":
+            frames += 1
+        pos += 8 + size + (size & 1)
+    if not width or not height:
+        raise BadImage("the WebP has no readable size (damaged)")
+    return ImageInfo("image/webp", width, height, max(frames, 1))
+
+
+def _bmp_info(data: bytes) -> ImageInfo:
+    if len(data) < 26:
+        raise BadImage("the BMP header is damaged")
+    width, height = struct.unpack("<ii", data[18:26])
+    return ImageInfo("image/bmp", abs(width), abs(height))
+
+
+def sniff(data: bytes) -> str | None:
+    """The image type the first bytes announce, or None."""
+    if data.startswith(PNG_SIGNATURE):
+        return "image/png"
+    if data.startswith(b"\xff\xd8\xff"):
+        return "image/jpeg"
+    if data[:6] in (b"GIF87a", b"GIF89a"):
+        return "image/gif"
+    if len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
+        return "image/webp"
+    if data.startswith(b"BM") and len(data) >= 26:
+        return "image/bmp"
+    return None
+
+
+def inspect(data: bytes) -> ImageInfo:
+    """Type, size and frame count from the headers; ``BadImage`` when it is not an image."""
+    mime = sniff(data)
+    if mime is None:
+        hint = "text" if _looks_textual(data[:512]) else "unknown binary data"
+        raise BadImage(
+            f"the content is not a supported image (it looks like {hint}); "
+            "PNG, JPEG, GIF and WebP are accepted"
+        )
+    try:
+        info = {
+            "image/png": _png_info,
+            "image/jpeg": _jpeg_info,
+            "image/gif": _gif_info,
+            "image/webp": _webp_info,
+            "image/bmp": _bmp_info,
+        }[mime](data)
+    except (struct.error, IndexError) as exc:
+        raise BadImage(f"the {mime.split('/')[1].upper()} header is damaged") from exc
+    if info.width <= 0 or info.height <= 0:
+        raise BadImage("the image reports a zero size")
+    return info
+
+
+def _looks_textual(head: bytes) -> bool:
+    if not head:
+        return False
+    try:
+        text = head.decode("utf-8")
+    except UnicodeDecodeError:
+        return False
+    return all(c.isprintable() or c in "\r\n\t" for c in text)
+
+
+def check_limits(
+    info: ImageInfo, *, max_frames: int = MAX_FRAMES, max_pixels: int = MAX_TOTAL_PIXELS
+) -> None:
+    """Refuse oversized animations (frames, or frames times canvas) before decoding."""
+    if info.frames > max_frames:
+        raise BadImage(
+            f"the animation has more than {max_frames} frames; send a still image or a shorter clip"
+        )
+    total = info.frames * info.width * info.height
+    if total > max_pixels:
+        raise BadImage(
+            f"the image is too big to decode safely ({info.width}x{info.height} px x "
+            f"{info.frames} frame(s) = {total:,} pixels; the limit is {max_pixels:,})"
+        )
+
+
+# -- our PNG codec ------------------------------------------------------------------------------
+
+_CHANNELS = {0: 1, 2: 3, 3: 1, 4: 2, 6: 4}
+_MODES = {1: "L", 2: "LA", 3: "RGB", 4: "RGBA"}
+
+
+@dataclass(frozen=True)
+class Raster:
+    """Packed 8-bit pixels, row after row; ``mode`` is L, LA, RGB or RGBA."""
+
+    width: int
+    height: int
+    mode: str
+    pixels: bytes
+
+    @property
+    def channels(self) -> int:
+        return len(self.mode)
+
+    def pixel(self, x: int, y: int) -> tuple[int, ...]:
+        start = (y * self.width + x) * self.channels
+        return tuple(self.pixels[start : start + self.channels])
+
+
+def _png_chunks(data: bytes, *, verify: bool = True):
+    pos = 8
+    while pos + 8 <= len(data):
+        (length,) = struct.unpack(">I", data[pos : pos + 4])
+        kind = data[pos + 4 : pos + 8]
+        body = data[pos + 8 : pos + 8 + length]
+        if len(body) < length:
+            raise BadImage("the PNG is truncated")
+        if verify:
+            crc = data[pos + 8 + length : pos + 12 + length]
+            if len(crc) < 4 or struct.unpack(">I", crc)[0] != zlib.crc32(kind + body):
+                raise BadImage("the PNG is damaged (a chunk checksum does not match)")
+        yield kind, body
+        if kind == b"IEND":
+            return
+        pos += 12 + length
+
+
+def _paeth(a: int, b: int, c: int) -> int:
+    p = a + b - c
+    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
+    if pa <= pb and pa <= pc:
+        return a
+    return b if pb <= pc else c
+
+
+def _unfilter(raw: bytes, height: int, stride: int, bpp: int) -> bytearray:
+    out = bytearray(height * stride)
+    prev = bytearray(stride)
+    pos = 0
+    for row in range(height):
+        kind = raw[pos]
+        line = bytearray(raw[pos + 1 : pos + 1 + stride])
+        pos += 1 + stride
+        if kind == 1:
+            for i in range(bpp, stride):
+                line[i] = (line[i] + line[i - bpp]) & 0xFF
+        elif kind == 2:
+            for i in range(stride):
+                line[i] = (line[i] + prev[i]) & 0xFF
+        elif kind == 3:
+            for i in range(stride):
+                left = line[i - bpp] if i >= bpp else 0
+                line[i] = (line[i] + ((left + prev[i]) >> 1)) & 0xFF
+        elif kind == 4:
+            for i in range(stride):
+                left = line[i - bpp] if i >= bpp else 0
+                up_left = prev[i - bpp] if i >= bpp else 0
+                line[i] = (line[i] + _paeth(left, prev[i], up_left)) & 0xFF
+        elif kind != 0:
+            raise BadImage("the PNG uses an unknown row filter (damaged)")
+        out[row * stride : (row + 1) * stride] = line
+        prev = line
+    return out
+
+
+def png_stream_complete(data: bytes) -> None:
+    """Raise ``BadImage`` unless the PNG's pixel stream inflates to its full declared size."""
+    width, height, depth, color, interlace = _png_header(data)
+    raw = _png_inflate(data)
+    if interlace:
+        return  # the size check below does not apply to Adam7; Pillow validates those
+    stride = (width * _CHANNELS[color] * depth + 7) // 8
+    if len(raw) < height * (stride + 1):
+        raise BadImage("the PNG pixel data is truncated")
+
+
+def _png_header(data: bytes) -> tuple[int, int, int, int, int]:
+    if not data.startswith(PNG_SIGNATURE) or data[12:16] != b"IHDR":
+        raise BadImage("not a PNG")
+    width, height, depth, color, _comp, _filt, interlace = struct.unpack(">IIBBBBB", data[16:29])
+    if color not in _CHANNELS:
+        raise BadImage("the PNG colour type is invalid")
+    return width, height, depth, color, interlace
+
+
+def _png_inflate(data: bytes) -> bytes:
+    idat = b"".join(body for kind, body in _png_chunks(data) if kind == b"IDAT")
+    try:
+        return zlib.decompress(idat)
+    except zlib.error as exc:
+        raise BadImage("the PNG pixel data is damaged or truncated") from exc
+
+
+def decode_png(data: bytes) -> Raster:
+    """Decode an 8/16-bit non-interlaced PNG to 8-bit pixels (palette becomes RGB or RGBA)."""
+    width, height, depth, color, interlace = _png_header(data)
+    if interlace or depth not in (8, 16):
+        raise NeedsPillow("reading an interlaced or low-bit-depth PNG")
+    palette = b""
+    alpha = b""
+    for kind, body in _png_chunks(data):
+        if kind == b"PLTE":
+            palette = body
+        elif kind == b"tRNS":
+            alpha = body
+    channels = _CHANNELS[color]
+    sample = depth // 8
+    stride = width * channels * sample
+    raw = _png_inflate(data)
+    if len(raw) < height * (stride + 1):
+        raise BadImage("the PNG pixel data is truncated")
+    flat = _unfilter(raw, height, stride, channels * sample)
+    if sample == 2:
+        flat = flat[0::2]  # keep the high byte of each 16-bit sample
+    if color == 3:
+        if not palette:
+            raise BadImage("the PNG has no palette")
+        with_alpha = bool(alpha)
+        out = bytearray()
+        for index in flat:
+            out += palette[index * 3 : index * 3 + 3]
+            if with_alpha:
+                out.append(alpha[index] if index < len(alpha) else 255)
+        return Raster(width, height, "RGBA" if with_alpha else "RGB", bytes(out))
+    return Raster(width, height, _MODES[channels], bytes(flat))
+
+
+def _chunk(kind: bytes, body: bytes) -> bytes:
+    return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))
+
+
+_COLOR_TYPES = {"L": 0, "LA": 4, "RGB": 2, "RGBA": 6}
+
+
+def encode_png(raster: Raster) -> bytes:
+    stride = raster.width * raster.channels
+    rows = bytearray()
+    for row in range(raster.height):
+        rows.append(0)
+        rows += raster.pixels[row * stride : (row + 1) * stride]
+    header = struct.pack(
+        ">IIBBBBB", raster.width, raster.height, 8, _COLOR_TYPES[raster.mode], 0, 0, 0
+    )
+    return (
+        PNG_SIGNATURE
+        + _chunk(b"IHDR", header)
+        + _chunk(b"IDAT", zlib.compress(bytes(rows), 6))
+        + _chunk(b"IEND", b"")
+    )
+
+
+def _crop_raster(raster: Raster, box: tuple[int, int, int, int]) -> Raster:
+    x1, y1, x2, y2 = box
+    ch = raster.channels
+    stride = raster.width * ch
+    out = bytearray()
+    for row in range(y1, y2):
+        start = row * stride + x1 * ch
+        out += raster.pixels[start : start + (x2 - x1) * ch]
+    return Raster(x2 - x1, y2 - y1, raster.mode, bytes(out))
+
+
+def _shrink_raster(raster: Raster, width: int, height: int) -> Raster:
+    """Area-average downscale (every source pixel counts once)."""
+    ch = raster.channels
+    src = raster.pixels
+    stride = raster.width * ch
+    xs = [x * raster.width // width for x in range(width + 1)]
+    ys = [y * raster.height // height for y in range(height + 1)]
+    out = bytearray()
+    for ty in range(height):
+        y0, y1 = ys[ty], max(ys[ty + 1], ys[ty] + 1)
+        for tx in range(width):
+            x0, x1 = xs[tx], max(xs[tx + 1], xs[tx] + 1)
+            count = (y1 - y0) * (x1 - x0)
+            sums = [0] * ch
+            for sy in range(y0, y1):
+                base = sy * stride
+                for sx in range(x0, x1):
+                    at = base + sx * ch
+                    for c in range(ch):
+                        sums[c] += src[at + c]
+            out += bytes((s + count // 2) // count for s in sums)
+    return Raster(width, height, raster.mode, bytes(out))
+
+
+# -- operations ---------------------------------------------------------------------------------
+
+
+def clamp_box(region: Any, info: ImageInfo) -> tuple[int, int, int, int]:
+    """``[x1, y1, x2, y2]`` in original pixels, clamped to the image; ``BadImage`` when unusable."""
+    if not (
+        isinstance(region, list | tuple)
+        and len(region) == 4
+        and all(isinstance(v, int | float) and not isinstance(v, bool) for v in region)
+    ):
+        raise BadImage("region must be four numbers [x1, y1, x2, y2] in original image pixels")
+    x1, y1, x2, y2 = (int(v) for v in region)
+    cx1, cx2 = (max(0, min(v, info.width)) for v in (x1, x2))
+    cy1, cy2 = (max(0, min(v, info.height)) for v in (y1, y2))
+    if cx2 <= cx1 or cy2 <= cy1:
+        raise BadImage(
+            f"region [{x1}, {y1}, {x2}, {y2}] has no area inside the image, which is "
+            f"{info.width}x{info.height} px; use x1 < x2 and y1 < y2 within those bounds"
+        )
+    return cx1, cy1, cx2, cy2
+
+
+def crop(data: bytes, info: ImageInfo, box: tuple[int, int, int, int]) -> bytes:
+    """The box (already clamped) at original resolution, as PNG."""
+    image_mod = pillow()
+    if image_mod is not None:
+        with image_mod.open(io.BytesIO(data)) as img:
+            part = img.crop(box)
+            if part.mode not in ("RGB", "RGBA", "L", "LA"):
+                part = part.convert("RGBA" if "A" in part.getbands() else "RGB")
+            buf = io.BytesIO()
+            part.save(buf, format="PNG")
+            return buf.getvalue()
+    if info.mime != "image/png":
+        raise NeedsPillow(f"cutting a region out of a {info.mime.split('/')[1].upper()} image")
+    return encode_png(_crop_raster(decode_png(data), box))
+
+
+@dataclass(frozen=True)
+class Fitted:
+    data: bytes
+    mime: str
+    width: int
+    height: int
+    scaled_from: tuple[int, int] | None = None  # original size when it was shrunk
+
+
+def data_url(data: bytes, mime: str) -> str:
+    return f"data:{mime};base64,{base64.b64encode(data).decode('ascii')}"
+
+
+def b64_len(size: int) -> int:
+    """Length of the base64 text for ``size`` bytes."""
+    return 4 * ((size + 2) // 3)
+
+
+def _target_size(width: int, height: int, longest: int) -> tuple[int, int]:
+    if max(width, height) <= longest:
+        return width, height
+    if width >= height:
+        return longest, max(1, round(height * longest / width))
+    return max(1, round(width * longest / height)), longest
+
+
+def fit(data: bytes, info: ImageInfo, *, max_side: int, max_b64_bytes: int) -> Fitted:
+    """The image with its longest side ≤ ``max_side`` and its base64 form ≤ ``max_b64_bytes``.
+
+    An image already inside both limits comes back unchanged. Otherwise it is shrunk; PNG output
+    keeps exact pixels, Pillow may also use JPEG quality steps to reach the byte target. Each pass
+    that still misses the target halves the size again, never below ``MIN_SIDE``. ``BadImage``
+    when the target cannot be reached.
+    """
+    if info.longest <= max_side and b64_len(len(data)) <= max_b64_bytes:
+        return Fitted(data, info.mime, info.width, info.height)
+    image_mod = pillow()
+    if image_mod is not None:
+        return _fit_pillow(image_mod, data, info, max_side, max_b64_bytes)
+    if info.mime != "image/png":
+        raise NeedsPillow(f"shrinking a {info.mime.split('/')[1].upper()} image")
+    raster = decode_png(data)
+    width, height = _target_size(info.width, info.height, max_side)
+    while True:
+        small = (
+            _shrink_raster(raster, width, height)
+            if (width, height)
+            != (
+                raster.width,
+                raster.height,
+            )
+            else raster
+        )
+        encoded = encode_png(small)
+        if b64_len(len(encoded)) <= max_b64_bytes:
+            return Fitted(encoded, "image/png", width, height, (info.width, info.height))
+        if max(width, height) <= MIN_SIDE:
+            raise BadImage("the image cannot be made small enough to embed")
+        width, height = _target_size(width, height, max(MIN_SIDE, max(width, height) // 2))
+
+
+def _fit_pillow(
+    image_mod: ModuleType, data: bytes, info: ImageInfo, max_side: int, max_b64_bytes: int
+) -> Fitted:
+    with image_mod.open(io.BytesIO(data)) as opened:
+        img = opened.convert("RGBA") if opened.mode in ("P", "PA", "LA") else opened.copy()
+    keep_png = info.mime == "image/png" and img.mode == "RGBA"
+    width, height = _target_size(img.width, img.height, max_side)
+    lanczos = getattr(image_mod, "LANCZOS", None) or image_mod.Resampling.LANCZOS
+    while True:
+        small = img.resize((width, height), lanczos) if (width, height) != img.size else img
+        attempts: list[tuple[str, dict[str, Any]]] = [("PNG", {})]
+        if not keep_png:
+            attempts = [("JPEG", {"quality": q}) for q in (85, 70, 50)]
+        for fmt, options in attempts:
+            out = small if fmt == "PNG" or small.mode in ("RGB", "L") else small.convert("RGB")
+            buf = io.BytesIO()
+            out.save(buf, format=fmt, **options)
+            encoded = buf.getvalue()
+            if b64_len(len(encoded)) <= max_b64_bytes:
+                scaled = (
+                    (info.width, info.height)
+                    if (width, height)
+                    != (
+                        info.width,
+                        info.height,
+                    )
+                    else None
+                )
+                mime = "image/png" if fmt == "PNG" else "image/jpeg"
+                return Fitted(encoded, mime, width, height, scaled)
+        if max(width, height) <= MIN_SIDE:
+            raise BadImage("the image cannot be made small enough to embed")
+        width, height = _target_size(width, height, max(MIN_SIDE, max(width, height) // 2))
+
+
+def validate_decodable(data: bytes, info: ImageInfo) -> None:
+    """A deeper check than the headers: Pillow loads every frame; without it PNG streams are
+    inflated to their declared size (a cut-off download is caught either way for PNG)."""
+    image_mod = pillow()
+    if image_mod is None:
+        if info.mime == "image/png":
+            png_stream_complete(data)
+        return
+    try:
+        with image_mod.open(io.BytesIO(data)) as img:
+            for index in range(info.frames):
+                img.seek(index)
+                img.load()
+    except EOFError:
+        return
+    except Exception as exc:
+        raise BadImage(f"the image could not be decoded ({type(exc).__name__})") from exc
+
+
+def to_png(data: bytes) -> bytes:
+    """Re-encode (first frame) as PNG with Pillow; used for types providers do not take (BMP)."""
+    image_mod = pillow()
+    if image_mod is None:
+        raise NeedsPillow("converting a BMP image")
+    with image_mod.open(io.BytesIO(data)) as img:
+        buf = io.BytesIO()
+        img.convert("RGBA" if "A" in img.getbands() else "RGB").save(buf, format="PNG")
+        return buf.getvalue()
