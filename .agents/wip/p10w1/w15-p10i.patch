+        rig.clock.advance(200)
+        await rig.manager.janitor_tick()
+        assert rig.manager.failures["t"] == 1 and rig.manager.get("t") is made
+        await rig.manager.janitor_tick()
+        assert rig.manager.failures["t"] == 2 and rig.manager.get("t") is made
+        await rig.manager.janitor_tick()
