+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [
+        ("127.0.0.1:9222", "http://127.0.0.1:9222"),
+        ("http://localhost:9222/json/version?x=1", "http://localhost:9222"),
+        ("ws://127.0.0.1:9222/devtools/browser/abc", "ws://127.0.0.1:9222/devtools/browser/abc"),
