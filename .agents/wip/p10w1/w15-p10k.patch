+def test_attach_block_to_list_content_and_without_a_user_message() -> None:
+    out = moa.attach_block([{"role": "user", "content": [{"type": "text", "text": "q"}]}], "B")
+    assert out[0]["content"][-1] == {"type": "text", "text": "B"}
+    assert moa.attach_block([{"role": "system", "content": "s"}], "B")[-1] == {
+        "role": "user",
+        "content": "B",
+    }
+
+
+# -- the real auxiliary client -------------------------------------------------------------------
+
+
+def test_aux_references_over_the_real_client(scope: Scope, fake_clock: FakeClock) -> None:
+    import httpx
+
+    from indus.providers.auxiliary import AuxClient
+    from tests.fakes.model import FakeModelServer, fake_route, script_of
+
+    seen: list[dict[str, Any]] = []
+
+    def answer(request: httpx.Request) -> httpx.Response:
+        import json
+
+        seen.append(json.loads(request.content))
+        return httpx.Response(
+            200,
+            json={
+                "choices": [
+                    {"message": {"role": "assistant", "content": "try X"}, "finish_reason": "stop"}
+                ],
+                "usage": {"prompt_tokens": 11, "completion_tokens": 2},
+            },
+        )
+
+    recorded: list[tuple[str, str]] = []
+
+    async def record(task: str, route: RuntimeRoute, usage: Any, latency: float) -> None:
+        recorded.append((task, route.model))
+
+    server = FakeModelServer(script_of(), clock=fake_clock)
+    aux = AuxClient(
+        scope,
+        fake_route(server),
+        clock=fake_clock,
+        client_factory=lambda _r: httpx.AsyncClient(transport=httpx.MockTransport(answer)),
+        record=record,
+    )
+    refs = moa.AuxReferences(aux)
+    main = fake_route(server)
+    slot = Slot(main.provider, "reference-model", reasoning_effort="low")
+    text = asyncio.run(refs.ask(slot, [{"role": "user", "content": "q"}]))
+    assert text == "try X"
+    assert recorded == [("moa", "reference-model")]
+    assert seen[0]["model"] == "reference-model" and seen[0]["stream"] is False
diff --git a/tests/unit/core/test_moa_presets.py b/tests/unit/core/test_moa_presets.py
new file mode 100644
index 0000000..32cfc9c
--- /dev/null
+++ b/tests/unit/core/test_moa_presets.py
@@ -0,0 +1,170 @@
+"""MoA presets (P10-22): strict validation listing every problem, tolerant reading, fan-out."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from indus.core import moa_presets as mp
+
+KNOWN = {"openai", "anthropic", "openrouter"}
+
+
+def known(name: str) -> bool:
+    return name in KNOWN
+
+
+def ref(provider: str = "openai", model: str = "m1", **extra: Any) -> dict[str, Any]:
+    return {"provider": provider, "model": model, **extra}
+
+
+def problems_of(name: str, raw: object, **values: Any) -> list[str]:
+    return mp.validate_preset(name, raw, known_provider=known, **values)[1]
+
+
+def test_a_good_preset() -> None:
+    preset, problems = mp.validate_preset(
+        "review",
+        {
+            "reference_models": [
+                ref(),
+                ref("anthropic", "m2", enabled=False, reasoning_effort="high"),
+            ],
+            "aggregator": ref("openrouter", "big"),
+            "reference_timeout": 90,
+            "fanout": "every_n:3",
+        },
+        known_provider=known,
+    )
+    assert problems == []
+    assert preset == mp.Preset(
+        "review",
+        (mp.Slot("openai", "m1"), mp.Slot("anthropic", "m2", False, "high")),
+        mp.Slot("openrouter", "big"),
+        90.0,
+        "every_n:3",
+    )
+    assert preset is not None and preset.enabled_references == (mp.Slot("openai", "m1"),)
+    assert mp.Slot("anthropic", "m2", False, "high").label == "anthropic:m2 (reasoning high)"
+
+
+def test_empty_preset() -> None:
+    assert problems_of("p", {}) == ["preset 'p': no reference models (add at least one)"]
+    assert problems_of("p", {"reference_models": []}) == [
+        "preset 'p': no reference models (add at least one)"
+    ]
+    assert problems_of("p", {"reference_models": [ref(enabled=False)]}) == [
+        "preset 'p': every reference model is disabled"
+    ]
+
+
+def test_unknown_provider() -> None:
+    assert problems_of("p", {"reference_models": [ref("nowhere")]}) == [
+        "preset 'p' reference 1: no provider is called 'nowhere'"
+    ]
+
+
+def test_nested_moa_slots_are_refused() -> None:
+    raw = {"reference_models": [ref("moa", "x"), ref("other", "y")]}
+    assert problems_of("p", raw, preset_names=["p", "other"]) == [
+        "preset 'p' reference 1: 'moa' is a mixture of agents itself; presets cannot be nested",
+        "preset 'p' reference 2: 'other' is a mixture of agents itself; presets cannot be nested",
+    ]
+    aggregated = {"reference_models": [ref()], "aggregator": ref("moa", "z")}
+    assert problems_of("p", aggregated) == [
+        "preset 'p' aggregator: 'moa' is a mixture of agents itself; presets cannot be nested"
+    ]
+
+
+def test_every_problem_is_listed_at_once() -> None:
+    raw = {
+        "reference_models": [ref("nowhere"), {"provider": "openai"}, "text", ref(enabled="maybe")],
+        "aggregator": {"model": "x"},
+        "reference_timeout": -1,
+        "fanout": "sometimes",
+    }
+    assert problems_of("bad name!", raw) == [
+        "preset 'bad name!': the name must be letters, digits, '-', '_' or '.'",
+        "preset 'bad name!' reference 1: no provider is called 'nowhere'",
+        "preset 'bad name!' reference 2: model is missing",
+        "preset 'bad name!' reference 3: must be a mapping with provider and model",
+        "preset 'bad name!' reference 4: enabled must be true or false",
+        "preset 'bad name!' aggregator: provider is missing",
+        "preset 'bad name!' reference_timeout: must be more than 0 seconds",
+        "preset 'bad name!' fanout: must be per_iteration, user_turn or every_n:N (N at least 1)",
+    ]
+
+
+def test_section_validation_and_tolerant_reading() -> None:
+    raw = {
+        "default_preset": "gone",
+        "reference_timeout": "soon",
+        "privacy_filter": "loud",
+        "presets": {"good": {"reference_models": [ref()]}, "broken": {"reference_models": []}},
+    }
+    settings, problems = mp.validate_section(raw, known_provider=known)
+    assert problems == [
+        "preset 'broken': no reference models (add at least one)",
+        "moa.default_preset: no preset is called 'gone'",
+        "moa.reference_timeout: must be a number of seconds",
+        "moa.privacy_filter: must be empty, display or full",
+    ]
+    assert list(settings.presets) == ["good"] and settings.default_preset == ""
+    tolerant = mp.read_settings(raw)
+    assert list(tolerant.presets) == ["good"] and tolerant.problems == tuple(problems)
+    assert mp.read_settings(None) == mp.MoaSettings()
+    assert mp.read_settings({"presets": "nope"}).problems == (
+        "moa.presets: must be a mapping of name → preset",
+    )
+
+
+def test_default_preset_choice_and_timeouts() -> None:
+    one = mp.Preset("solo", (mp.Slot("openai", "m"),))
+    two = mp.Preset("pair", (mp.Slot("openai", "m"),), reference_timeout=5.0)
+    assert mp.MoaSettings(presets={"solo": one}).preset() is one
+    both = mp.MoaSettings(presets={"solo": one, "pair": two}, reference_timeout=60.0)
+    assert both.preset() is None and both.preset("pair") is two
+    assert mp.MoaSettings(presets={"solo": one, "pair": two}, default_preset="pair").preset() is two
+    assert both.timeout_for(one) == 60.0 and both.timeout_for(two) == 5.0
+
+
+@pytest.mark.parametrize(
+    ("fanout", "runs"),
+    [
+        ("per_iteration", [True, True, True, True]),
+        ("user_turn", [True, False, False, False]),
+        ("every_n:2", [True, False, True, False]),
+        ("every_n:3", [True, False, False, True]),
+    ],
+)
+def test_fanout(fanout: str, runs: list[bool]) -> None:
+    assert [mp.fanout_runs(fanout, i) for i in range(1, 5)] == runs
+
+
+def test_fanout_parsing() -> None:
+    assert mp.parse_fanout(None) == ("per_iteration", None)
+    assert mp.parse_fanout("every_n:1") == ("per_iteration", None)
+    assert mp.parse_fanout("USER_TURN") == ("user_turn", None)
+    assert mp.parse_fanout("every_n:0")[1] is not None
+
+
+def test_slot_text_and_config_round_trip() -> None:
+    assert mp.parse_slot_text("OpenRouter:vendor/model:free") == mp.Slot(
+        "openrouter", "vendor/model:free"
+    )
+    assert mp.parse_slot_text("no-colon") is None and mp.parse_slot_text(":m") is None
+    preset = mp.Preset("p", (mp.Slot("openai", "m"),), mp.Slot("anthropic", "a"), 30.0, "user_turn")
+    again, problems = mp.validate_preset("p", mp.preset_to_config(preset), known_provider=known)
+    assert problems == [] and again == preset
+
+
+def test_privacy_modes() -> None:
+    assert [mp.privacy_mode(v) for v in ("", "display", "FULL", True, None, "x")] == [
+        "",
+        "display",
+        "full",
+        "full",
+        "",
+        "",
+    ]
diff --git a/tests/unit/core/test_side_question.py b/tests/unit/core/test_side_question.py
new file mode 100644
index 0000000..c6c7722
--- /dev/null
+++ b/tests/unit/core/test_side_question.py
@@ -0,0 +1,224 @@
+"""Side questions (P10-23): the cache-parity fork, tool refusal, the transcript fallback and
+running beside a live turn."""
+
+from __future__ import annotations
+
+import asyncio
+from typing import Any, cast
+
+import pytest
+
+from indus.core import side_question as sq
+from indus.core.agent import Agent
+from indus.core.exit_reasons import ExitReason
+from indus.core.persist import MemoryStore
+from indus.core.transcript import TranscriptRow
+from indus.foundation.scope import Scope
+from indus.providers.auxiliary import AuxClient
+from indus.tools.registry import ToolRegistry
+from tests.fakes.agent import fake_options, run_driven
+from tests.fakes.aux_model import FakeAuxModel
+from tests.fakes.clock import FakeClock
+from tests.fakes.model import (
+    FakeModelServer,
+    Finish,
+    Stall,
+    Text,
+    ToolCall,
+    Turn,
+    fake_route,
+    script_of,
+    text_turn,
+    tool_batch,
+)
+from tests.fakes.tools import FakeTools
+
+
+def as_aux(fake: object) -> AuxClient:
+    """A fake auxiliary model where the real client is expected (duck-typed)."""
+    return cast(AuxClient, fake)
+
+
+def rows_of(agent: Agent) -> list[TranscriptRow]:
+    store = agent.runtime.store
+    assert isinstance(store, MemoryStore)
+    return store.rows.get(agent.session_id, [])
+
+
+def test_fork_answers_from_the_warm_prefix_and_writes_nothing(
+    scope: Scope, fake_clock: FakeClock
+) -> None:
+    server = FakeModelServer(
+        script_of(text_turn("we chose blue"), text_turn("You decided on blue.")), clock=fake_clock
+    )
+    tasks: list[str] = []
+
+    async def main() -> tuple[Agent, sq.SideAnswer, int]:
+        agent = await Agent.start(scope, fake_route(server), [], fake_options(server))
+
+        async def heard(_usage: Any, task: str) -> None:
+            tasks.append(task)
+
+        agent.usage.add_listener(heard)
+        await agent.run_turn("which colour?")
+        before = len(rows_of(agent))
+        answer = await sq.answer_side_question(
+            "what did we decide?", session_id=agent.session_id, agent=agent
+        )
+        return agent, answer, before
+
+    agent, answer, before = asyncio.run(run_driven(main(), fake_clock))
+    assert answer == sq.SideAnswer("You decided on blue.", "fork")
+    assert len(rows_of(agent)) == before == 2
+    parent, fork = (r.body for r in server.model_requests)
+    # same system prompt, same history bytes, same tools: the provider's prefix cache is warm
+    assert fork["messages"][:2] == parent["messages"]
+    assert fork["messages"][2]["content"] == "we chose blue"
+    assert fork["messages"][-1]["content"].endswith("Question: what did we decide?")
+    assert fork.get("tools") == parent.get("tools")
+    assert tasks == ["", sq.TASK]
+    asyncio.run(agent.close())
+
+
+def test_tools_are_refused_and_no_fourth_call_is_made(scope: Scope, fake_clock: FakeClock) -> None:
+    calls = [tool_batch(ToolCall("echo", {"text": f"try {i}"}, id=f"c{i}")) for i in range(3)]
+    server = FakeModelServer(script_of(text_turn("ok"), *calls), clock=fake_clock)
+    tools = FakeTools(fake_clock)
+    registry = tools.register(ToolRegistry(clock=fake_clock))
+
+    async def main() -> tuple[Agent, sq.SideAnswer]:
+        options = fake_options(server, registry=registry)
+        agent = await Agent.start(scope, fake_route(server), ["fake"], options)
+        assert "echo" in agent.tool_names
+        await agent.run_turn("hi")
+        answer = await sq.answer_side_question("anything?", session_id="s1", agent=agent)
+        return agent, answer
+
+    agent, answer = asyncio.run(run_driven(main(), fake_clock))
+    assert answer.text == sq.NO_ANSWER and answer.path == "fork"
+    assert len(server.model_requests) == 4  # the parent's one and the fork's three
+    assert server.turns_left == 0
+    assert tools.effects == [] and tools.events == []
+    refused = [m for m in server.model_requests[3].body["messages"] if m["role"] == "tool"]
+    assert refused and all(sq.TOOL_REFUSED in m["content"] for m in refused)
+    assert len(rows_of(agent)) == 2
+    asyncio.run(agent.close())
+
+
+def test_runs_beside_a_turn_in_flight_without_interrupting_it(
+    scope: Scope, fake_clock: FakeClock
+) -> None:
+    slow = Turn((Stall(30.0), Text(("second answer",)), Finish("stop")))
+    server = FakeModelServer(
+        script_of(text_turn("first answer"), slow, text_turn("side answer")), clock=fake_clock
+    )
+
+    async def main() -> tuple[Any, sq.SideAnswer]:
+        agent = await Agent.start(scope, fake_route(server), [], fake_options(server))
+        await agent.run_turn("one")
+        running = await agent.start_turn("two")
+        while len(server.model_requests) < 2:
+            await fake_clock.run_until_idle()
+        answer = await sq.answer_side_question("status?", session_id="s1", agent=agent)
+        assert not running.done
+        result = await running.task
+        await agent.close()
+        return result, answer
+
+    result, answer = asyncio.run(run_driven(main(), fake_clock))
+    assert answer.text == "side answer"
+    assert result.exit_reason is ExitReason.COMPLETED and result.final_text == "second answer"
+    fork = server.model_requests[2].body["messages"]
+    # the in-flight turn's stored user row is cut off: the history ends on a finished answer
+    assert [m["role"] for m in fork] == ["system", "user", "assistant", "user"]
+    assert fork[2]["content"] == "first answer"
+
+
+def test_no_live_agent_falls_back_to_the_transcript(scope: Scope) -> None:
+    store = MemoryStore()
+    rows: list[TranscriptRow] = []
+    for i in range(40):
+        rows.append(TranscriptRow(role="user", content=f"q{i} " + "u" * 3_000))
+        rows.append(TranscriptRow(role="assistant", content=f"a{i} " + "a" * 300))
+    store.rows["old"] = rows
+    aux = FakeAuxModel("we talked about q39")
+    answer = asyncio.run(
+        sq.answer_side_question("what was last?", session_id="old", store=store, aux=as_aux(aux))
+    )
+    assert answer == sq.SideAnswer("we talked about q39", "transcript")
+    (call,) = aux.calls
+    assert call.task == sq.TASK
+    text = call.messages[1]["content"]
+    assert text.startswith("Transcript:\n" + sq.OLDER_LEFT_OUT)
+    assert "a39 " in text and "q0 " not in text
+    transcript = text.split("\n\nSide question:")[0]
+    assert len(transcript) <= sq.TRANSCRIPT_CHARS + 100
+    assert all(len(line) <= sq.MESSAGE_CHARS + 20 for line in transcript.splitlines())
+
+
+def test_render_transcript_rules() -> None:
+    rows = [
+        TranscriptRow(role="user", content="find it"),
+        TranscriptRow(
+            role="assistant",
+            content="",
+            tool_calls=[{"id": "c", "function": {"name": "search_files", "arguments": "{}"}}],
+        ),
+        TranscriptRow(role="tool", content="found", tool_call_id="c"),
+        TranscriptRow(role="assistant", content="It is in a.txt"),
+    ]
+    assert sq.render_transcript(rows) == (
+        "User: find it\nAssistant used tools: search_files\nTool result: found\n"
+        "Assistant: It is in a.txt"
+    )
+    assert sq.render_transcript([]) == "(the conversation is empty so far)"
+    assert sq.trim_to_answer(rows[:3]) == []
+
+
+def test_routed_side_question_uses_the_aux_task(scope: Scope) -> None:
+    class Routed(FakeAuxModel):
+        def task_config(self, task: str) -> dict[str, str]:
+            return {"provider": "other", "model": "small"}
+
+    store = MemoryStore()
+    store.rows["s"] = [TranscriptRow(role="user", content="hi")]
+    aux = Routed("short answer")
+    answer = asyncio.run(
+        sq.answer_side_question("q?", session_id="s", store=store, aux=as_aux(aux))
+    )
+    assert answer.path == "routed" and answer.text == "short answer"
+
+
+def test_empty_question_and_no_way_to_answer() -> None:
+    with pytest.raises(ValueError):
+        asyncio.run(sq.answer_side_question("  ", session_id="s"))
+    with pytest.raises(sq.SideQuestionUnavailable):
+        asyncio.run(sq.answer_side_question("why?", session_id="s"))
+
+
+def test_a_failing_fork_falls_back_to_the_transcript(
+    scope: Scope, fake_clock: FakeClock, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    server = FakeModelServer(script_of(text_turn("blue it is")), clock=fake_clock)
+    aux = FakeAuxModel("from the transcript")
+
+    async def broken(*_args: Any, **_kwargs: Any) -> str:
+        raise RuntimeError("fork broke")
+
+    monkeypatch.setattr(sq, "ask_fork", broken)
+
+    async def main() -> sq.SideAnswer:
+        agent = await Agent.start(scope, fake_route(server), [], fake_options(server))
+        await agent.run_turn("colour?")
+        answer = await sq.answer_side_question(
+            "which?",
+            session_id=agent.session_id,
+            agent=agent,
+            aux=as_aux(aux),
+        )
+        await agent.close()
+        return answer
+
+    answer = asyncio.run(run_driven(main(), fake_clock))
+    assert answer == sq.SideAnswer("from the transcript", "transcript")
+    assert "Assistant: blue it is" in aux.calls[0].messages[1]["content"]
