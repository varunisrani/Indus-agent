+def test_loop_first_run_starts_at_once(scope: Scope, fake_clock: FakeClock, tmp_path: Path) -> None:
+    svc, server, auto = make(
+        scope, fake_clock, tmp_path, text_turn("checked.\nLOOP_COMPLETE"), judge=FakeJudge()
