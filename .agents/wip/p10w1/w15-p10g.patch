+# STAND-IN: removed at integration
+"""Stand-in for slice H's session kernel pool (P10-10) as far as P10-06 needs it.
+
+The real pool keeps top-level kernels in an LRU of at most four and child kernels (keys
+``<parent>::child::<child>``) pinned outside it, and registers a releaser with
+``core.subagents.teardown`` that disposes a child's kernel when the child ends. At integration the
+teardown test should use the real pool instead.
+"""
+
+from __future__ import annotations
+
+from collections import OrderedDict
+
+from indus.core.subagents.teardown import child_kernel_key, register_releaser
+
+RELEASER_NAME = "code-kernels"
+
+
+class KernelPoolStandIn:
+    def __init__(self, lru_size: int = 4) -> None:
+        self.lru: OrderedDict[str, str] = OrderedDict()
+        self.pinned: dict[str, str] = {}
+        self.disposed: list[str] = []
+        self.lru_size = lru_size
+
+    def open_child(self, parent: str, child: str) -> str:
+        key = child_kernel_key(parent, child)
+        self.pinned[key] = "kernel"
+        return key
+
+    def release_child(self, parent: str, child: str) -> None:
+        key = child_kernel_key(parent, child)
+        if self.pinned.pop(key, None) is not None:
+            self.disposed.append(key)
+
+    def install(self) -> None:
+        register_releaser(RELEASER_NAME, self.release_child)
+
+    @staticmethod
+    def uninstall() -> None:
+        register_releaser(RELEASER_NAME, None)
