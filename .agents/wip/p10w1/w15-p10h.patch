--- /dev/null
+++ b/src/indus/tools/builtin/code/kernel.py
@@ -0,0 +1,626 @@
+# pyright: strict
+"""Persistent session kernels for ``execute_code`` on this machine (P10-10).
+
+A kernel is one Python child (``kernel_runner.SOURCE``) per ``KernelKey`` — owner, mode,
+interpreter, cwd and tool set — that keeps its namespace between calls. ``KernelPool`` holds the
+live kernels of the process (local here, remote ones in ``remote``) and applies the same rules to
+both:
+
+- one cell at a time per kernel (a second caller waits on the clock);
+- ``reset`` closes the old kernel first; a kernel found dead is replaced and the call says the
+  state was lost; after a timeout or an interrupt the kernel is closed and the *next* call for
+  that key also says so;
+- idle kernels (``kernel_idle_timeout`` on the scope's clock, not running a cell) are closed on
+  every take and by ``reap_idle`` / ``run_reaper``;
+- at most ``max_session_kernels`` unpinned kernels; the least recently used idle one goes first,
+  a running one never. Kernels of delegated children (owner ``<parent>::child::<child>``) are
+  pinned: outside the count, never evicted or reaped, closed by ``dispose_child`` (R02.32).
+
+Every kernel is closed on every way out: ``shutdown`` at host exit, and an ``atexit`` hook that
+force-kills whatever is still alive; the runner also exits by itself when its request pipe closes.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import atexit
+import contextlib
+import json
+import logging
+import os
+import queue
+import secrets
+import shutil
+import threading
+import uuid
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Protocol, cast
+
+from indus.backends.contract import CancelSignal
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.tools.builtin.code import launch
+from indus.tools.builtin.code import output as out
+from indus.tools.builtin.code.kernel_runner import SOURCE as RUNNER_SOURCE
+from indus.tools.builtin.code.rpc import RpcPipeline, SocketRpcServer
+from indus.tools.builtin.code.runner import RunOutcome, timeout_message
+from indus.tools.builtin.code.settings import (
+    CELL_CAPTURE_BYTES,
+    MODULE_NAME,
+    STDERR_BYTES,
+    TOOL_ERRORS_SHOWN,
+    Mode,
+)
+from indus.tools.builtin.code.stub_module import (
+    ENV_PERSISTENT,
+    ENV_SOCKET,
+    ENV_TOKEN,
+    module_source,
+)
+
+log = logging.getLogger(__name__)
+
+CHILD_MARK = "::child::"
+WAIT_TURN_S = 0.05
+POLL_START_S = 0.01
+POLL_MAX_S = 0.1
+REAPER_FLOOR_S = 30.0
+REAPER_CEIL_S = 300.0
+
+
+def child_owner(parent: str, child: str) -> str:
+    """The kernel owner of a delegated child (P10-06 passes it as ``code_kernel_owner``)."""
+    return f"{parent}{CHILD_MARK}{child}"
+
+
+def is_child_owner(owner: str) -> bool:
+    return CHILD_MARK in owner
+
+
+@dataclass(frozen=True)
+class KernelKey:
+    owner: str
+    place: str  # "local", or the remote backend and environment
+    mode: Mode
+    interpreter: str
+    cwd: str
+    tools: tuple[str, ...]
+
+
+class PooledKernel(Protocol):
+    last_used: float
+    busy: bool
+    pinned: bool
+
+    async def alive(self) -> bool: ...
+
+    async def close(self) -> None: ...
+
+    def force_close(self) -> None: ...
+
+
+@dataclass
+class Taken[K: PooledKernel]:
+    kernel: K
+    reused: bool
+    state_reset: bool
+    state_lost: bool
+
+    def info(self, mode: str) -> dict[str, Any]:
+        info: dict[str, Any] = {"mode": mode, "reused": self.reused}
+        if self.state_reset:
+            info["state_reset"] = True
+        if self.state_lost:
+            info["state_lost"] = True
+            info["note"] = (
+                "The earlier session kernel was gone (stopped after a timeout or interrupt, "
+                "ended, or lost); variables from earlier calls are not here. This call started "
+                "a fresh one."
+            )
+        return info
+
+
+class KernelPool[K: PooledKernel]:
+    """See the module notes."""
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+        self._kernels: dict[KernelKey, K] = {}
+        self._lost: set[KernelKey] = set()
+        self._lock = threading.Lock()
+
+    def __len__(self) -> int:
+        with self._lock:
+            return len(self._kernels)
+
+    def live_keys(self) -> list[KernelKey]:
+        with self._lock:
+            return list(self._kernels)
+
+    def get(self, key: KernelKey) -> K | None:
+        with self._lock:
+            return self._kernels.get(key)
+
+    def counted(self) -> int:
+        """Kernels that count against the cap (unpinned)."""
+        with self._lock:
+            return sum(1 for k in self._kernels.values() if not k.pinned)
+
+    async def take(
+        self,
+        key: KernelKey,
+        *,
+        clock: Clock,
+        reset: bool,
+        idle_s: float,
+        cap: int,
+        make: Callable[[], Awaitable[K]],
+    ) -> Taken[K]:
+        """The kernel for ``key``, marked busy (``give_back`` it). Starts one when needed."""
+        doomed: list[K] = []
+        state_reset = state_lost = False
+        while True:
+            with self._lock:
+                doomed += self._pop_idle(clock.monotonic(), idle_s)
+                current = self._kernels.get(key)
+                if current is None or not current.busy:
+                    if current is not None:
+                        current.busy = True
+                    break
+            await clock.sleep(WAIT_TURN_S)
+        try:
+            await self._close_all(doomed)
+            doomed = []
+            if current is not None and reset:
+                self._forget(key, current)
+                await current.close()
+                current, state_reset = None, True
+            if current is not None and not await current.alive():
+                self._forget(key, current)
+                await current.close()
+                current, state_lost = None, True
+            reused = current is not None
+            if current is None:
+                fresh = await make()
+                fresh.busy = True
+                fresh.pinned = is_child_owner(key.owner)
+                with self._lock:
+                    state_lost = state_lost or (key in self._lost and not state_reset)
+                    self._lost.discard(key)
+                    self._kernels[key] = fresh
+                current = fresh
+            current.last_used = clock.monotonic()
+            with self._lock:
+                doomed = self._over_cap(key, cap)
+        except BaseException:
+            if current is not None:
+                current.busy = False
+            raise
+        await self._close_all(doomed)
+        return Taken(current, reused, state_reset, state_lost)
+
+    def give_back(self, kernel: K, clock: Clock) -> None:
+        kernel.last_used = clock.monotonic()
+        kernel.busy = False
+
+    async def discard(self, key: KernelKey, kernel: K, *, lost: bool = True) -> None:
+        """Close ``kernel`` and drop it; ``lost`` makes the next call for ``key`` say so."""
+        self._forget(key, kernel)
+        if lost:
+            with self._lock:
+                self._lost.add(key)
+        kernel.busy = False
+        await kernel.close()
+
+    def _forget(self, key: KernelKey, kernel: K) -> None:
+        with self._lock:
+            if self._kernels.get(key) is kernel:
+                del self._kernels[key]
+
+    def _pop_idle(self, now: float, idle_s: float) -> list[K]:
+        stale = [
+            k
+            for k, kernel in self._kernels.items()
+            if not kernel.busy and not kernel.pinned and now - kernel.last_used > idle_s
+        ]
+        return [self._kernels.pop(k) for k in stale]
+
+    def _over_cap(self, keep: KernelKey, cap: int) -> list[K]:
+        unpinned = [k for k, kernel in self._kernels.items() if not kernel.pinned]
+        excess = len(unpinned) - cap
+        if excess <= 0:
+            return []
+        idle = sorted(
+            (k for k in unpinned if k != keep and not self._kernels[k].busy),
+            key=lambda k: self._kernels[k].last_used,
+        )
+        return [self._kernels.pop(k) for k in idle[:excess]]
+
+    async def _close_all(self, kernels: list[K]) -> None:
+        for kernel in kernels:
+            try:
+                await kernel.close()
+            except Exception:
+                log.warning("closing a %s kernel failed", self.label, exc_info=True)
+
+    async def reap_idle(self, clock: Clock, idle_s: float) -> int:
+        with self._lock:
+            doomed = self._pop_idle(clock.monotonic(), idle_s)
+        await self._close_all(doomed)
+        return len(doomed)
+
+    async def dispose_where(self, owner_matches: Callable[[str], bool]) -> int:
+        with self._lock:
+            keys = [k for k in self._kernels if owner_matches(k.owner)]
+            doomed = [self._kernels.pop(k) for k in keys]
+            self._lost.difference_update(keys)
+        await self._close_all(doomed)
+        return len(doomed)
+
+    async def dispose_owner(self, owner: str) -> int:
+        return await self.dispose_where(lambda o: o == owner)
+
+    async def shutdown(self) -> None:
+        with self._lock:
+            doomed = list(self._kernels.values())
+            self._kernels.clear()
+            self._lost.clear()
+        await self._close_all(doomed)
+
+    def force_shutdown(self) -> None:
+        """Kill everything now, without waiting (process exit)."""
+        with self._lock:
+            doomed = list(self._kernels.values())
+            self._kernels.clear()
+        for kernel in doomed:
+            with contextlib.suppress(Exception):
+                kernel.force_close()
+
+
+# -- the local kernel ------------------------------------------------------------------------------
+
+
+class LocalKernel:
+    """One kernel child on this machine plus its RPC server and pipes."""
+
+    def __init__(
+        self,
+        folder: Path,
+        server: SocketRpcServer,
+        token: str,
+        child: launch.Child,
+        request_fd: int,
+        replies: queue.Queue[dict[str, Any]],
+        clock: Clock,
+    ) -> None:
+        self.folder = folder
+        self.server = server
+        self.token = token
+        self.child = child
+        self._request_fd: int | None = request_fd
+        self.replies = replies
+        self.clock = clock
+        self.last_used = clock.monotonic()
+        self.busy = False
+        self.pinned = False
+        self.count = 0
+        self._closed = False
+
+    async def alive(self) -> bool:
+        return not self._closed and self.child.alive()
+
+    def send(self, payload: dict[str, Any]) -> None:
+        if self._request_fd is None:
+            raise BrokenPipeError("the kernel is closed")
+        data = (json.dumps(payload, ensure_ascii=False) + "\n").encode("utf-8")
+        view = memoryview(data)
+        while view:
+            written = os.write(self._request_fd, view)
+            view = view[written:]
+
+    def _close_pipe(self) -> None:
+        if self._request_fd is not None:
+            with contextlib.suppress(OSError):
+                os.close(self._request_fd)
+            self._request_fd = None
+
+    async def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        self._close_pipe()  # the runner exits on its own when the pipe closes
+        try:
+            await self.child.stop(self.clock)
+        finally:
+            self._cleanup()
+
+    def force_close(self) -> None:
+        self._closed = True
+        self._close_pipe()
+        with contextlib.suppress(Exception):
+            self.child.force_stop()
+        self._cleanup()
+
+    def _cleanup(self) -> None:
+        self.server.close()
+        shutil.rmtree(self.folder, ignore_errors=True)
+
+
+def _read_replies(fd: int, sink: queue.Queue[dict[str, Any]]) -> None:
+    try:
+        with os.fdopen(fd, "rb") as source:
+            for line in source:
+                try:
+                    reply: object = json.loads(line)
+                except ValueError:
+                    reply = None
+                if isinstance(reply, dict):
+                    sink.put(cast(dict[str, Any], reply))
+                else:
+                    sink.put({"state": "broken"})
+    except OSError:
+        pass
+    finally:
+        sink.put({"state": "gone"})
+
+
+async def start_local_kernel(
+    scope: Scope,
+    *,
+    session_id: str | None,
+    interpreter: str,
+    cwd: str | None,
+    tools: tuple[str, ...],
+    idle_s: float,
+    clock: Clock,
+) -> LocalKernel:
+    folder = launch.private_dir(launch.staging_root(scope), prefix="indus-kernel-")
+    server: SocketRpcServer | None = None
+    fds: list[int] = []
+    try:
+        launch.write_private(folder / f"{MODULE_NAME}.py", module_source(tools, "socket"))
+        launch.write_private(folder / "kernel.py", RUNNER_SOURCE)
+        token = secrets.token_urlsafe(32)
+        server = SocketRpcServer(folder)
+        req_r, req_w = os.pipe()
+        rep_r, rep_w = os.pipe()
+        fds = [req_r, req_w, rep_r, rep_w]
+        for fd in (req_w, rep_r):
+            os.set_inheritable(fd, False)
+        env = launch.child_environment(
+            scope,
+            session_id=session_id,
+            staging=folder,
+            extra={
+                ENV_SOCKET: server.endpoint,
+                ENV_TOKEN: token,
+                ENV_PERSISTENT: "1",
+                "INDUS_KERNEL_IN_FD": str(req_r),
+                "INDUS_KERNEL_OUT_FD": str(rep_w),
+                "INDUS_KERNEL_IDLE_S": str(idle_s),
+                "INDUS_KERNEL_CAPTURE": str(CELL_CAPTURE_BYTES),
+            },
+        )
+        child = launch.Child(
+            [interpreter, str(folder / "kernel.py")],
+            cwd=cwd or str(folder),
+            env=env,
+            stdout=out.ByteCapture(CELL_CAPTURE_BYTES),
+            stderr=out.ByteCapture(STDERR_BYTES * 4, tail=STDERR_BYTES),
+            pass_fds=(req_r, rep_w),
+        )
+        os.close(req_r)
+        os.close(rep_w)
+        fds = []
+        replies: queue.Queue[dict[str, Any]] = queue.Queue()
+        threading.Thread(
+            target=_read_replies, args=(rep_r, replies), name="code-kernel-replies", daemon=True
+        ).start()
+        return LocalKernel(folder, server, token, child, req_w, replies, clock)
+    except BaseException:
+        for fd in fds:
+            with contextlib.suppress(OSError):
+                os.close(fd)
+        if server is not None:
+            server.close()
+        shutil.rmtree(folder, ignore_errors=True)
+        raise
+
+
+# -- running one cell ------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class CellJob:
+    code: str
+    scope: Scope
+    session_id: str | None
+    key: KernelKey
+    reset: bool
+    timeout_s: float
+    idle_s: float
+    cap: int
+    pipeline: RpcPipeline
+    clock: Clock
+    cancel: CancelSignal | None = None
+
+
+async def _await_reply(kernel: LocalKernel, job: CellJob) -> tuple[str, dict[str, Any]]:
+    deadline = job.clock.monotonic() + job.timeout_s
+    delay = POLL_START_S
+    while True:
+        try:
+            reply = kernel.replies.get_nowait()
+        except queue.Empty:
+            pass
+        else:
+            state = str(reply.get("state", ""))
+            if state in ("gone", "broken"):
+                return "died", reply
+            return "done", reply
+        if job.cancel is not None and job.cancel.is_set():
+            return "interrupted", {}
+        if job.clock.monotonic() >= deadline:
+            return "timeout", {}
+        await job.clock.sleep(delay)
+        delay = min(delay * 1.5, POLL_MAX_S)
+
+
+async def run_cell(
+    pool: KernelPool[LocalKernel], job: CellJob, make: Callable[[], Awaitable[LocalKernel]]
+) -> RunOutcome:
+    """Run ``job.code`` in the kernel for ``job.key`` (see the module notes)."""
+    started = job.clock.monotonic()
+    taken = await pool.take(
+        job.key, clock=job.clock, reset=job.reset, idle_s=job.idle_s, cap=job.cap, make=make
+    )
+    kernel = taken.kernel
+    info = taken.info("session")
+    released = False
+    try:
+        while True:  # drop replies and output left over from an earlier cell
+            try:
+                kernel.replies.get_nowait()
+            except queue.Empty:
+                break
+        kernel.child.stdout.drain()
+        kernel.child.stderr.drain()
+        job.pipeline.token = kernel.token
+        kernel.server.attach(job.pipeline, asyncio.get_running_loop())
+        try:
+            kernel.send({"id": uuid.uuid4().hex, "code": job.code})
+        except OSError:
+            state, reply = "died", {}
+        else:
+            state, reply = await _await_reply(kernel, job)
+        kernel.server.detach()
+        outcome = RunOutcome(
+            status="success",
+            tool_calls_made=job.pipeline.calls_made,
+            tool_errors=job.pipeline.tool_errors(TOOL_ERRORS_SHOWN),
+            exit_code=0,
+            kernel=info,
+            show_stderr=True,
+        )
+        if state in ("timeout", "interrupted"):
+            await pool.discard(job.key, kernel)
+            released = True
+            await kernel.child.finish_reading(job.clock, within=0.5)
+            info["ended"] = True
+            outcome.exit_code = -1
+            if state == "timeout":
+                outcome.status = "timeout"
+                outcome.error = timeout_message(job.timeout_s, kernel=True)
+            else:
+                outcome.status = "interrupted"
+                outcome.error = "Interrupted: the session kernel was stopped and its state is gone."
+            raw_out, _ = kernel.child.stdout.drain()
+            outcome.stdout = out.decode(raw_out)
+            return _timed(outcome, job, started)
+        if state == "died":
+            raw_err, _ = kernel.child.stderr.drain()
+            await pool.discard(job.key, kernel)
+            released = True
+            info["ended"] = True
+            why = out.decode(raw_err).strip()
+            outcome.status, outcome.exit_code = "error", -1
+            outcome.error = "The session kernel stopped while running the call" + (
+                f": {why[-2000:]}" if why else "."
+            )
+            outcome.hint_text = why
+            return _timed(outcome, job, started)
+        await kernel.child.finish_reading(job.clock, within=0.0)
+        raw_out, _ = kernel.child.stdout.drain()
+        raw_err, _ = kernel.child.stderr.drain()
+        kernel.count = int(reply.get("count", kernel.count + 1) or 0)
+        info["execution_count"] = kernel.count
+        outcome.stdout = str(reply.get("stdout", "")) + out.decode(raw_out)
+        stderr = str(reply.get("stderr", "")) + out.decode(raw_err)
+        trace = str(reply.get("traceback", ""))
+        cell_state = str(reply.get("state", "ok"))
+        if reply.get("stdout_cut"):
+            info["capture_cut"] = (
+                f"The call printed more than {CELL_CAPTURE_BYTES:,} characters; only the first "
+                "part was kept."
+            )
+        if cell_state == "error":
+            outcome.status, outcome.exit_code = "error", 1
+            outcome.error = trace.strip().splitlines()[-1] if trace.strip() else "The cell raised."
+            outcome.stderr = stderr + trace
+            outcome.hint_text = trace
+        elif cell_state == "exit":
+            info["ended"] = True
+            outcome.stderr = stderr
+            await pool.discard(job.key, kernel, lost=False)
+            released = True
+        else:
+            outcome.stderr = stderr
+        return _timed(outcome, job, started)
+    finally:
+        kernel.server.detach()
+        if not released:
+            pool.give_back(kernel, job.clock)
+
+
+def _timed(outcome: RunOutcome, job: CellJob, started: float) -> RunOutcome:
+    outcome.seconds = max(0.0, job.clock.monotonic() - started)
+    return outcome
+
+
+# -- the process-wide pool -------------------------------------------------------------------------
+
+POOL: KernelPool[LocalKernel] = KernelPool("local")
+
+
+async def dispose_child(child_session_id: str) -> int:
+    """Close every kernel (local and remote) a finished delegated child owned (P10-06)."""
+    from indus.tools.builtin.code import remote
+
+    suffix = f"{CHILD_MARK}{child_session_id}"
+    closed = await POOL.dispose_where(lambda owner: owner.endswith(suffix))
+    return closed + await remote.POOL.dispose_where(lambda owner: owner.endswith(suffix))
+
+
+async def dispose_session(owner: str) -> int:
+    """Close the kernels of a session that ended (``/new``, session close)."""
+    from indus.tools.builtin.code import remote
+
+    return await POOL.dispose_owner(owner) + await remote.POOL.dispose_owner(owner)
+
+
+async def run_reaper(clock: Clock, idle_s: Callable[[], float]) -> None:
+    """Background task for long-lived hosts: close idle kernels on a schedule."""
+    from indus.tools.builtin.code import remote
+
+    while True:
+        window = idle_s()
+        await clock.sleep(min(REAPER_CEIL_S, max(REAPER_FLOOR_S, window / 6.0)))
+        try:
+            await POOL.reap_idle(clock, window)
+            await remote.POOL.reap_idle(clock, window)
+        except Exception:
+            log.exception("kernel reaper pass failed; trying again next time")
+
+
+atexit.register(POOL.force_shutdown)
+
+
+__all__ = [
+    "CHILD_MARK",
+    "POOL",
+    "CellJob",
+    "KernelKey",
+    "KernelPool",
+    "LocalKernel",
+    "PooledKernel",
+    "Taken",
+    "child_owner",
+    "dispose_child",
+    "dispose_session",
+    "is_child_owner",
+    "run_cell",
+    "run_reaper",
+    "start_local_kernel",
+]
diff --git a/src/indus/tools/builtin/code/kernel_runner.py b/src/indus/tools/builtin/code/kernel_runner.py
new file mode 100644
index 0000000..3471eff
--- /dev/null
+++ b/src/indus/tools/builtin/code/kernel_runner.py
@@ -0,0 +1,108 @@
+# pyright: strict
+"""The program a local session kernel runs (P10-10), kept as text and written to its staging dir.
+
+Requests arrive on an inherited pipe (``INDUS_KERNEL_IN_FD``), one JSON line ``{"id", "code"}``
+each; a listener thread queues them and ends the process the moment the pipe closes, which is
+also how the kernel notices that Indus is gone, even in the middle of a cell. Each cell runs in
+one namespace kept for the kernel's life, with ``sys.stdout``/``sys.stderr`` captured (each cut
+to ``INDUS_KERNEL_CAPTURE`` characters); the reply goes out as one JSON line on a second pipe
+(``INDUS_KERNEL_OUT_FD``). Output written straight to file descriptors 1 and 2 (child processes)
+reaches Indus on the real stdout/stderr pipes. With no request for ``INDUS_KERNEL_IDLE_S``
+seconds the kernel exits by itself; a cell that calls ``sys.exit`` ends it after its reply.
+"""
+
+from __future__ import annotations
+
+SOURCE = '''\
+"""Indus Agent session kernel: runs execute_code cells in one long-lived namespace."""
+import contextlib
+import io
+import json
+import linecache
+import os
+import queue
+import sys
+import threading
+import traceback
+
+_IN = int(os.environ.pop("INDUS_KERNEL_IN_FD"))
+_OUT = int(os.environ.pop("INDUS_KERNEL_OUT_FD"))
+_IDLE_S = float(os.environ.pop("INDUS_KERNEL_IDLE_S", "1800"))
+_LIMIT = int(os.environ.pop("INDUS_KERNEL_CAPTURE", "1000000"))
+os.set_inheritable(_IN, False)
+os.set_inheritable(_OUT, False)
+
+_requests = queue.Queue()
+
+
+def _listen():
+    try:
+        with os.fdopen(_IN, "rb") as source:
+            for line in source:
+                _requests.put(line)
+    finally:
+        os._exit(0)
+
+
+threading.Thread(target=_listen, name="indus-kernel-requests", daemon=True).start()
+_reply = os.fdopen(_OUT, "wb")
+_namespace = {"__name__": "__main__", "__builtins__": __builtins__}
+
+
+def _clip(text):
+    if len(text) <= _LIMIT:
+        return text, False
+    return text[:_LIMIT], True
+
+
+def _run(number, code):
+    name = "<cell %d>" % number
+    linecache.cache[name] = (len(code), None, code.splitlines(True), name)
+    stdout, stderr = io.StringIO(), io.StringIO()
+    state, trace = "ok", ""
+    try:
+        with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
+            exec(compile(code, name, "exec"), _namespace)
+    except SystemExit as exc:
+        state, trace = "exit", "SystemExit: %r" % (exc.code,)
+    except BaseException:
+        state, trace = "error", traceback.format_exc()
+    out_text, out_cut = _clip(stdout.getvalue())
+    err_text, err_cut = _clip(stderr.getvalue())
+    return {
+        "state": state,
+        "stdout": out_text,
+        "stderr": err_text,
+        "stdout_cut": out_cut,
+        "stderr_cut": err_cut,
+        "traceback": trace,
+        "count": number,
+    }
+
+
+def main():
+    number = 0
+    while True:
+        try:
+            line = _requests.get(timeout=_IDLE_S)
+        except queue.Empty:
+            os._exit(0)
+        try:
+            request = json.loads(line)
+            code = request["code"]
+        except (ValueError, KeyError, TypeError):
+            continue
+        number += 1
+        reply = _run(number, code)
+        reply["id"] = request.get("id", "")
+        _reply.write(json.dumps(reply, ensure_ascii=False).encode("utf-8") + b"\\n")
+        _reply.flush()
+        if reply["state"] == "exit":
+            sys.stdout.flush()
+            os._exit(0)
+
+
+main()
+'''
+
+__all__ = ["SOURCE"]
diff --git a/src/indus/tools/builtin/code/launch.py b/src/indus/tools/builtin/code/launch.py
new file mode 100644
index 0000000..90b5533
--- /dev/null
+++ b/src/indus/tools/builtin/code/launch.py
@@ -0,0 +1,239 @@
+# pyright: strict
+"""Starting a local Python child for ``execute_code``: where, with which interpreter and env.
+
+- ``private_dir``: a fresh 0700 directory (``indus-code-*``) under the scope's ``TMPDIR`` when
+  that is a usable directory, else the system temp dir; ``write_private`` writes 0600 files.
+- ``choose_interpreter``: ``strict`` → our interpreter; ``project`` → the active virtualenv or
+  conda interpreter from the scope's environment when it is executable and answers as Python 3.8
+  or newer (checked once per path, successes cached), else ours.
+- ``child_environment``: ``safety.child_env`` variant ``code`` (R02.22), then what the run needs:
+  RPC variables, ``TZ`` from the profile's zone, UTF-8 forced, no bytecode files, and a
+  ``PYTHONPATH`` that starts with the staging dir and holds nothing of Indus's own install.
+- ``spawn``: a new session and process group, stdin closed unless asked, stdout and stderr on
+  pipes pumped into ``ByteCapture`` objects by daemon threads. ``stop`` is the local backend's
+  ordered tree kill (SIGTERM, then SIGKILL after ``KILL_GRACE_S``); ``force_stop`` kills at once.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import subprocess
+import sys
+import tempfile
+import threading
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import IO
+
+from indus.backends.local import LocalProcess, force_kill_tree, stop_tree, strip_app_pythonpath
+from indus.foundation.blocking import run_blocking
+from indus.foundation.clock import Clock, resolve_zone
+from indus.foundation.scope import Scope
+from indus.safety.child_env import child_env
+from indus.tools.builtin.code.output import ByteCapture
+from indus.tools.builtin.code.settings import KILL_GRACE_S, Mode
+
+log = logging.getLogger(__name__)
+
+PROBE_TIMEOUT_S = 5.0
+_PROBE_CACHE_MAX = 32
+_usable: dict[str, bool] = {}
+_usable_lock = threading.Lock()
+_PROBE = "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)"
+
+
+# -- staging -------------------------------------------------------------------------------------
+
+
+def staging_root(scope: Scope) -> str:
+    configured = scope.env.get("TMPDIR", "").strip()
+    if configured and os.path.isdir(configured) and os.access(configured, os.W_OK | os.X_OK):
+        return configured
+    return tempfile.gettempdir()
+
+
+def private_dir(root: str, prefix: str = "indus-code-") -> Path:
+    """A new owner-only directory under ``root``."""
+    return Path(tempfile.mkdtemp(prefix=prefix, dir=root))
+
+
+def write_private(path: Path, text: str) -> None:
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as handle:
+        handle.write(text)
+
+
+# -- the interpreter -----------------------------------------------------------------------------
+
+
+def _probe(path: str) -> bool:
+    with _usable_lock:
+        if path in _usable:
+            return True
+    try:
+        done = subprocess.run(  # noqa: S603 - a fixed check of a known interpreter path
+            [path, "-c", _PROBE],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            timeout=PROBE_TIMEOUT_S,
+            env={"PATH": os.defpath},
+            check=False,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return False
+    if done.returncode != 0:
+        return False
+    with _usable_lock:
+        if len(_usable) >= _PROBE_CACHE_MAX:
+            _usable.pop(next(iter(_usable)))
+        _usable[path] = True
+    return True
+
+
+def _candidates(scope: Scope) -> list[str]:
+    found: list[str] = []
+    folder, names = (
+        ("Scripts", ("python.exe",)) if os.name == "nt" else ("bin", ("python3", "python"))
+    )
+    for variable in ("VIRTUAL_ENV", "CONDA_PREFIX"):
+        root = scope.env.get(variable, "").strip()
+        if not root:
+            continue
+        for name in names:
+            candidate = os.path.join(root, folder, name)
+            if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
+                found.append(candidate)
+                break
+    return found
+
+
+async def choose_interpreter(scope: Scope, mode: Mode) -> str:
+    """See the module notes."""
+    if mode == "strict":
+        return sys.executable
+    for candidate in _candidates(scope):
+        if candidate == sys.executable:
+            return candidate
+        if await run_blocking(_probe, candidate, pool="io", label="python probe"):
+            return candidate
+        log.info("execute_code: %s is not a usable Python 3.8+; using Indus's own", candidate)
+    return sys.executable
+
+
+def forget_probes() -> None:
+    with _usable_lock:
+        _usable.clear()
+
+
+# -- the environment -----------------------------------------------------------------------------
+
+
+def child_environment(
+    scope: Scope,
+    *,
+    session_id: str | None,
+    staging: Path,
+    extra: Mapping[str, str],
+) -> dict[str, str]:
+    env = child_env(scope, variant="code", session_id=session_id)
+    zone = resolve_zone(scope)
+    if zone is not None and os.name != "nt":
+        env["TZ"] = zone.key
+    env["PYTHONIOENCODING"] = "utf-8"
+    env["PYTHONUTF8"] = "1"
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    kept = strip_app_pythonpath(env.get("PYTHONPATH", ""))
+    env["PYTHONPATH"] = os.pathsep.join(p for p in (str(staging), kept) if p)
+    env.update(extra)
+    return env
+
+
+# -- the process ---------------------------------------------------------------------------------
+
+
+def _pump(stream: IO[bytes], capture: ByteCapture) -> None:
+    try:
+        while True:
+            chunk = stream.read1(65536)  # pyright: ignore[reportAttributeAccessIssue, reportUnknownMemberType, reportUnknownVariableType]
+            if not chunk:
+                return
+            capture.append(bytes(chunk))  # pyright: ignore[reportUnknownArgumentType]
+    except (OSError, ValueError):
+        return
+    finally:
+        with contextlib.suppress(OSError):
+            stream.close()
+
+
+class Child:
+    """One running Python child and the threads reading its output."""
+
+    def __init__(
+        self,
+        argv: Sequence[str],
+        *,
+        cwd: str,
+        env: Mapping[str, str],
+        stdout: ByteCapture,
+        stderr: ByteCapture,
+        pass_fds: Sequence[int] = (),
+    ) -> None:
+        popen = subprocess.Popen(  # noqa: S603 - the interpreter and our staged file
+            list(argv),
+            cwd=cwd,
+            env=dict(env),
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            start_new_session=True,
+            close_fds=True,
+            pass_fds=tuple(pass_fds),
+        )
+        self.process = LocalProcess(popen)
+        self.stdout, self.stderr = stdout, stderr
+        assert popen.stdout is not None and popen.stderr is not None
+        self._readers = [
+            threading.Thread(target=_pump, args=(popen.stdout, stdout), daemon=True),
+            threading.Thread(target=_pump, args=(popen.stderr, stderr), daemon=True),
+        ]
+        for reader in self._readers:
+            reader.start()
+
+    @property
+    def pid(self) -> int:
+        return self.process.popen.pid
+
+    def poll(self) -> int | None:
+        return self.process.poll()
+
+    def alive(self) -> bool:
+        return self.process.poll() is None
+
+    async def stop(self, clock: Clock, grace: float = KILL_GRACE_S) -> None:
+        if self.alive():
+            await stop_tree(self.process, clock=clock, grace=grace)
+        else:
+            force_kill_tree(self.process)  # leftovers of an exited leader's group
+
+    def force_stop(self) -> None:
+        force_kill_tree(self.process)
+
+    async def finish_reading(self, clock: Clock, within: float = 2.0) -> None:
+        """Give the reader threads a moment to take what is left in the pipes."""
+        deadline = clock.monotonic() + within
+        while any(r.is_alive() for r in self._readers) and clock.monotonic() < deadline:
+            await clock.sleep(0.02)
+
+
+__all__ = [
+    "Child",
+    "child_environment",
+    "choose_interpreter",
+    "forget_probes",
+    "private_dir",
+    "staging_root",
+    "write_private",
+]
diff --git a/src/indus/tools/builtin/code/output.py b/src/indus/tools/builtin/code/output.py
new file mode 100644
index 0000000..257750b
--- /dev/null
+++ b/src/indus/tools/builtin/code/output.py
@@ -0,0 +1,185 @@
+# pyright: strict
+"""What a script printed, turned into the text the model sees.
+
+``ByteCapture`` collects one stream from a reader thread: the first ``keep`` bytes whole, then only
+a rolling tail, plus the total count. ``present_stdout`` cuts the text to the inline budget by
+bytes (first 40 %, last 60 %, one marker naming what was left out) and saves the whole text (at
+most ``SPILL_MAX_BYTES``) to ``<home>/cache/exec/stdout-<digest>.txt`` so the model can page it
+with ``read_file`` instead of running the script again. ``clean`` strips terminal escapes and
+masks secrets; every piece of output passes through it before it is cut or saved.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import os
+import threading
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from indus.backends.processes import strip_ansi
+from indus.foundation.scope import Scope
+from indus.safety.redaction import redact_output
+from indus.tools.builtin.code.settings import (
+    SPILL_MAX_BYTES,
+    STDERR_BYTES,
+    STDOUT_HEAD_SHARE,
+    STDOUT_INLINE_BYTES,
+)
+
+log = logging.getLogger(__name__)
+
+SPILL_DIR = ("cache", "exec")
+# A command name that is neither an env dump nor a file reader: secrets and credential shapes
+# are masked, ordinary ``name = value`` lines in printed source are left alone.
+REDACT_AS = "python3 script.py"
+STDERR_SEPARATOR = "\n--- stderr ---\n"
+
+
+class ByteCapture:
+    """One output stream: whole up to ``keep`` bytes, then a rolling tail (thread-safe)."""
+
+    def __init__(self, keep: int, tail: int = STDOUT_INLINE_BYTES) -> None:
+        self._keep = keep
+        self._tail_max = tail
+        self._head = bytearray()
+        self._tail = bytearray()
+        self.total = 0
+        self._lock = threading.Lock()
+
+    def append(self, data: bytes) -> None:
+        if not data:
+            return
+        with self._lock:
+            self.total += len(data)
+            room = self._keep - len(self._head)
+            if room > 0:
+                self._head += data[:room]
+                data = data[room:]
+            if data:
+                self._tail += data
+                if len(self._tail) > self._tail_max:
+                    del self._tail[: len(self._tail) - self._tail_max]
+
+    @property
+    def overflowed(self) -> bool:
+        return self.total > self._keep
+
+    def kept(self) -> bytes:
+        """The whole stream when it fit, else the kept head."""
+        with self._lock:
+            return bytes(self._head)
+
+    def last(self, count: int) -> bytes:
+        """The last ``count`` bytes of the stream (as far as they were kept)."""
+        with self._lock:
+            joined = bytes(self._head) + bytes(self._tail) if self._tail else bytes(self._head)
+        return joined[-count:] if count > 0 else b""
+
+    def drain(self) -> tuple[bytes, int]:
+        """Kept bytes and the total so far; then start empty (per kernel cell)."""
+        with self._lock:
+            data = bytes(self._head) + bytes(self._tail)
+            total = self.total
+            self._head.clear()
+            self._tail.clear()
+            self.total = 0
+        return data, total
+
+
+def decode(data: bytes) -> str:
+    return data.decode("utf-8", errors="replace")
+
+
+def clean(text: str, scope: Scope | None) -> str:
+    """Escapes stripped, secrets masked."""
+    return redact_output(strip_ansi(text), command=REDACT_AS, scope=scope)
+
+
+def cut_marker(omitted: int, total: int) -> str:
+    return (
+        f"\n\n[... {omitted:,} of {total:,} bytes of output left out here; "
+        "the full text is in the file named in the result ...]\n\n"
+    )
+
+
+def head_tail(raw: bytes, budget: int) -> tuple[str, int]:
+    """``raw`` cut to ``budget`` bytes around one marker; returns (text, bytes left out)."""
+    if len(raw) <= budget:
+        return decode(raw), 0
+    head = int(budget * STDOUT_HEAD_SHARE)
+    tail = budget - head
+    omitted = len(raw) - budget
+    return decode(raw[:head]) + cut_marker(omitted, len(raw)) + decode(raw[-tail:]), omitted
+
+
+def spill(scope: Scope | None, text: str) -> str | None:
+    """Save the full text owner-only under ``<home>/cache/exec``; None when it could not be."""
+    if scope is None:
+        return None
+    raw = text.encode("utf-8", errors="replace")
+    if len(raw) > SPILL_MAX_BYTES:
+        raw = (
+            raw[:SPILL_MAX_BYTES]
+            + f"\n\n[... saved copy stops at {SPILL_MAX_BYTES:,} bytes ...]".encode()
+        )
+    try:
+        folder = Path(scope.home).joinpath(*SPILL_DIR)
+        folder.mkdir(parents=True, exist_ok=True, mode=0o700)
+        digest = hashlib.sha256(raw).hexdigest()[:16]
+        path = folder / f"stdout-{digest}.txt"
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+        with os.fdopen(fd, "wb") as handle:
+            handle.write(raw)
+        return str(path)
+    except OSError as exc:
+        log.warning("could not save the full execute_code output: %s", exc)
+        return None
+
+
+@dataclass
+class Presented:
+    text: str
+    fields: dict[str, Any] = field(default_factory=lambda: {})
+
+
+def present_stdout(text: str, scope: Scope | None) -> Presented:
+    """The inline stdout and the truncation fields (``stdout_*``, ``full_output_path``)."""
+    raw = text.encode("utf-8", errors="replace")
+    total = len(raw)
+    if total <= STDOUT_INLINE_BYTES:
+        return Presented(text)
+    shown, omitted = head_tail(raw, STDOUT_INLINE_BYTES)
+    fields: dict[str, Any] = {
+        "stdout_truncated": True,
+        "stdout_bytes_total": total,
+        "stdout_bytes_omitted": omitted,
+    }
+    path = spill(scope, text)
+    if path is not None:
+        fields["full_output_path"] = path
+        fields["note"] = (
+            "The script ran; its printed output was longer than the inline limit, so the middle "
+            f"is left out above. The whole output is in {path}: read it with "
+            f'read_file(path="{path}", offset=...) rather than running the script again.'
+        )
+    else:
+        fields["note"] = (
+            "The script ran; its printed output was longer than the inline limit, so the middle "
+            "is left out above. Print less (a summary or a slice) if you need that part."
+        )
+    return Presented(shown, fields)
+
+
+def present_stderr(text: str) -> str:
+    raw = text.encode("utf-8", errors="replace")
+    shown, _ = head_tail(raw, STDERR_BYTES)
+    return shown
+
+
+def with_stderr(stdout: str, stderr: str) -> str:
+    if not stderr.strip():
+        return stdout
+    return f"{stdout}{STDERR_SEPARATOR}{stderr}" if stdout else stderr
diff --git a/src/indus/tools/builtin/code/remote.py b/src/indus/tools/builtin/code/remote.py
new file mode 100644
index 0000000..54b6793
--- /dev/null
+++ b/src/indus/tools/builtin/code/remote.py
@@ -0,0 +1,652 @@
+# pyright: strict
+"""``execute_code`` on a backend that is not this machine (P10-11).
+
+All we can do there is ``env.execute``. Every internal command runs from ``/`` with
+``bounded=False`` (R02.2: a tool result or cell output is never cut by the backend's capture),
+and files are shipped through stdin, base64-encoded and decoded by the remote ``python3`` — never
+on a command line, where other users could read them.
+
+- ``run_remote`` first checks that ``python3`` exists there. With kernels on it takes the
+  owner's remote kernel from ``POOL`` (starting one when needed); when no kernel can start it
+  ships one script for this call instead.
+- A kernel lives in a private directory (``umask 077``, mode 700) in the backend's temp dir:
+  ``runner.py``, ``indus_tools.py`` (file transport), ``cells/`` and ``rpc/``. It is started
+  detached and must write ``ready`` within ``START_WAIT_S``.
+- One poll round trip every ``REMOTE_POLL_S`` (0.5 s, on the scope's clock) takes pending tool
+  requests (``rpc/req_<n>.json``), the cell result when it is there, and a liveness check.
+  Requests go through the same ``RpcPipeline`` as local calls; answers are written back as
+  ``rpc/res_<n>.json`` (temp name, then rename).
+- A timeout or an interrupt stops the runner (TERM to its group, KILL after 5 s) and removes its
+  directory; the next call says the state was lost.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import contextlib
+import json
+import logging
+import os
+import secrets
+import shlex
+import uuid
+from collections.abc import Mapping
+from dataclasses import dataclass
+from typing import Any, cast
+
+from indus.backends.contract import CancelSignal, Environment, ExecResult
+from indus.foundation.clock import Clock, resolve_zone
+from indus.foundation.errors import IndusError
+from indus.foundation.scope import Scope
+from indus.tools.builtin.code.kernel import KernelKey, KernelPool
+from indus.tools.builtin.code.remote_runner import SOURCE as RUNNER_SOURCE
+from indus.tools.builtin.code.rpc import RpcPipeline, decode_request
+from indus.tools.builtin.code.runner import RunOutcome, timeout_message
+from indus.tools.builtin.code.settings import (
+    CELL_CAPTURE_BYTES,
+    KILL_GRACE_S,
+    MODULE_NAME,
+    REMOTE_POLL_S,
+    TOOL_ERRORS_SHOWN,
+    CodeSettings,
+    Mode,
+)
+from indus.tools.builtin.code.stub_module import ENV_DIR, ENV_TOKEN, module_source
+
+log = logging.getLogger(__name__)
+
+POLL_S = REMOTE_POLL_S  # tests may shorten it; the default is the plan's 0.5 s
+START_WAIT_S = 15.0
+SHORT_TIMEOUT_S = 30.0
+SHIP_TIMEOUT_S = 120.0
+INTERPRETERS = ("python3", "python")
+PYTHON_CHECK = (
+    "for p in " + " ".join(INTERPRETERS) + '; do command -v "$p" >/dev/null 2>&1 && '
+    "\"$p\" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' 2>/dev/null && "
+    'echo "INDUS-PY:$p"; done; true'
+)
+NO_PYTHON = (
+    "execute_code needs Python 3.8 or newer (python3) on the {backend} backend, and there is none "
+    "there. Install Python 3 in that environment, or use the tools directly."
+)
+
+
+class RemoteSetupError(IndusError):
+    default_code = "tools.code_remote_setup"
+
+
+# -- remote shell helpers --------------------------------------------------------------------------
+
+
+async def sh(
+    env: Environment,
+    command: str,
+    *,
+    timeout: float = SHORT_TIMEOUT_S,
+    stdin: str | None = None,
+    cancel: CancelSignal | None = None,
+) -> ExecResult:
+    return await env.execute(
+        command, timeout=timeout, cwd="/", stdin=stdin, bounded=False, cancel=cancel
+    )
+
+
+async def checked(
+    env: Environment,
+    command: str,
+    what: str,
+    *,
+    timeout: float = SHORT_TIMEOUT_S,
+    stdin: str | None = None,
+) -> ExecResult:
+    result = await sh(env, command, timeout=timeout, stdin=stdin)
+    if result.returncode != 0:
+        raise RemoteSetupError(f"{what} failed (exit {result.returncode}): {result.output[-500:]}")
+    return result
+
+
+_DECODE = (
+    "import base64,os,sys;p=sys.argv[1];t=p+'.part';"
+    "d=base64.b64decode(sys.stdin.buffer.read());"
+    "f=os.open(t,os.O_WRONLY|os.O_CREAT|os.O_TRUNC,0o600);os.write(f,d) if d else None;"
+    "os.close(f);os.replace(t,p)"
+)
+
+
+async def ship(env: Environment, path: str, text: str, *, python: str = "python3") -> None:
+    """Write ``text`` owner-only to ``path`` on the backend (temp name, then rename)."""
+    payload = base64.b64encode(text.encode("utf-8")).decode("ascii")
+    command = f"umask 077 && {python} -c {shlex.quote(_DECODE)} {shlex.quote(path)}"
+    await checked(env, command, f"writing {path}", timeout=SHIP_TIMEOUT_S, stdin=payload)
+
+
+async def remote_temp_dir(env: Environment) -> str:
+    declared = getattr(env, "temp_dir", None)
+    if isinstance(declared, str) and declared.startswith("/"):
+        return declared.rstrip("/") or "/"
+    snapshot = getattr(env, "snapshot_path", None)
+    if isinstance(snapshot, str) and snapshot.startswith("/"):
+        return os.path.dirname(snapshot) or "/"
+    asked = await sh(env, 'printf %s "${TMPDIR:-/tmp}"')
+    value = asked.output.strip()
+    return value if value.startswith("/") else "/tmp"  # noqa: S108 - the remote's temp dir
+
+
+def private_dirs_command(root: str, *inside: str) -> str:
+    made = " ".join(shlex.quote(p) for p in (root, *inside))
+    return f"umask 077 && mkdir -p {made} && chmod 700 {made}"
+
+
+def env_file(values: Mapping[str, str]) -> str:
+    return "".join(f"{name}={shlex.quote(value)}\n" for name, value in values.items())
+
+
+def run_env(scope: Scope, folder: str, token: str, extra: Mapping[str, str]) -> dict[str, str]:
+    values = {
+        ENV_DIR: f"{folder}/rpc",
+        ENV_TOKEN: token,
+        "PYTHONPATH": folder,
+        "PYTHONDONTWRITEBYTECODE": "1",
+        "PYTHONIOENCODING": "utf-8",
+        "PYTHONUTF8": "1",
+        **extra,
+    }
+    zone = resolve_zone(scope)
+    if zone is not None:
+        values["TZ"] = zone.key
+    return values
+
+
+def launch_command(folder: str, cwd: str, env_name: str, program: str) -> str:
+    """Source the env file inside a subshell (its names never reach the backend's session
+    snapshot), delete it, then run ``program`` from ``cwd``."""
+    env_path = shlex.quote(f"{folder}/{env_name}")
+    return (
+        f"cd {shlex.quote(cwd)} && ( set -a && . {env_path} && set +a && rm -f {env_path} && "
+        f"{program} )"
+    )
+
+
+# -- the tool-request poll -------------------------------------------------------------------------
+
+_MARK_REQ = "@@INDUS-REQ "
+_MARK_CELL = "@@INDUS-CELL"
+_MARK_DEAD = "@@INDUS-DEAD"
+_MARK_GONE = "@@INDUS-GONE"
+
+
+@dataclass
+class Tick:
+    requests: list[object]
+    cell: dict[str, Any] | None = None
+    cell_broken: bool = False
+    dead: bool = False
+    gone: bool = False
+
+
+def tick_command(folder: str, *, cell_seq: int | None = None, pid: str | None = None) -> str:
+    q = shlex.quote(folder)
+    parts = [
+        f"cd {q} 2>/dev/null || {{ echo {_MARK_GONE}; exit 0; }}",
+        'for f in rpc/req_*.json; do [ -f "$f" ] || continue; '
+        f'printf \'{_MARK_REQ}%s\\n\' "$f"; cat "$f"; printf \'\\n\'; rm -f "$f"; done',
+    ]
+    if cell_seq is not None:
+        name = f"cells/res_{cell_seq:06d}.json"
+        parts.append(
+            f"if [ -f {name} ]; then echo {_MARK_CELL}; cat {name}; printf '\\n'; rm -f {name}; fi"
+        )
+    if pid is not None:
+        parts.append(f"kill -0 {shlex.quote(pid)} 2>/dev/null || echo {_MARK_DEAD}")
+    return "; ".join(parts)
+
+
+def parse_tick(output: str) -> Tick:
+    tick = Tick([])
+    lines = output.split("\n")
+    index = 0
+    while index < len(lines):
+        line = lines[index].rstrip("\r")
+        if line.startswith(_MARK_REQ) and index + 1 < len(lines):
+            tick.requests.append(decode_request(lines[index + 1].encode("utf-8")))
+            index += 2
+            continue
+        if line == _MARK_CELL and index + 1 < len(lines):
+            try:
+                parsed = json.loads(lines[index + 1])
+            except ValueError:
+                tick.cell_broken = True
+            else:
+                if isinstance(parsed, dict):
+                    tick.cell = {str(k): v for k, v in parsed.items()}  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+                else:
+                    tick.cell_broken = True
+            index += 2
+            continue
+        if line == _MARK_DEAD:
+            tick.dead = True
+        elif line == _MARK_GONE:
+            tick.gone = True
+        index += 1
+    return tick
+
+
+async def answer_requests(
+    env: Environment, folder: str, tick: Tick, pipeline: RpcPipeline, *, python: str = "python3"
+) -> None:
+    for request in tick.requests:
+        if not isinstance(request, dict):
+            continue  # unreadable: removed, never answered
+        body = cast(dict[str, Any], request)
+        seq = body.get("seq")
+        if isinstance(seq, bool) or not isinstance(seq, int) or seq < 0:
+            continue
+        answer = await pipeline.handle(body)
+        await ship(
+            env,
+            f"{folder}/rpc/res_{seq:06d}.json",
+            json.dumps(answer, ensure_ascii=False),
+            python=python,
+        )
+
+
+# -- the remote kernel -----------------------------------------------------------------------------
+
+
+class KernelStartFailed(IndusError):
+    default_code = "tools.code_kernel_start"
+
+
+class RemoteKernel:
+    def __init__(self, env: Environment, folder: str, pid: str, token: str, clock: Clock) -> None:
+        self.env = env
+        self.folder = folder
+        self.pid = pid
+        self.token = token
+        self.clock = clock
+        self.last_used = clock.monotonic()
+        self.busy = False
+        self.pinned = False
+        self.seq = 0
+        self.count = 0
+        self._closed = False
+
+    async def alive(self) -> bool:
+        if self._closed:
+            return False
+        try:
+            probe = await sh(self.env, f"kill -0 {shlex.quote(self.pid)} 2>/dev/null && echo ALIVE")
+        except Exception:
+            return False  # a dropped link and a dead runner get the same answer: start again
+        return "ALIVE" in probe.output
+
+    async def close(self) -> None:
+        if self._closed:
+            return
+        self._closed = True
+        await stop_remote(self.env, self.pid, self.folder)
+
+    def force_close(self) -> None:
+        self._closed = True  # needs the backend; the runner exits when its directory goes
+
+
+async def stop_remote(env: Environment, pid: str, folder: str) -> None:
+    """TERM the runner's group, KILL whatever is left after ``KILL_GRACE_S``, remove the dir."""
+    p = shlex.quote(pid)
+    rounds = int(KILL_GRACE_S * 10)
+    command = (
+        f"kill -TERM -- -{p} 2>/dev/null; kill -TERM {p} 2>/dev/null; "
+        f"i=0; while kill -0 {p} 2>/dev/null && [ $i -lt {rounds} ]; "
+        "do sleep 0.1; i=$((i+1)); done; "
+        f"kill -KILL -- -{p} 2>/dev/null; kill -KILL {p} 2>/dev/null; "
+        f"rm -rf {shlex.quote(folder)}; true"
+    )
+    try:
+        await sh(env, command, timeout=KILL_GRACE_S + SHORT_TIMEOUT_S)
+    except Exception:
+        log.warning("could not stop the remote kernel %s in %s", pid, folder, exc_info=True)
+
+
+async def start_remote_kernel(
+    scope: Scope,
+    env: Environment,
+    *,
+    cwd: str | None,
+    tools: tuple[str, ...],
+    idle_s: float,
+    clock: Clock,
+) -> RemoteKernel:
+    root = await remote_temp_dir(env)
+    folder = f"{root}/indus-rkernel-{uuid.uuid4().hex[:12]}"
+    pid = ""
+    try:
+        await checked(
+            env,
+            private_dirs_command(folder, f"{folder}/cells", f"{folder}/rpc"),
+            "making the kernel directory",
+        )
+        token = secrets.token_urlsafe(32)
+        await ship(env, f"{folder}/runner.py", RUNNER_SOURCE)
+        await ship(env, f"{folder}/{MODULE_NAME}.py", module_source(tools, "file"))
+        values = run_env(
+            scope,
+            folder,
+            token,
+            {
+                "INDUS_KERNEL_DIR": folder,
+                "INDUS_KERNEL_IDLE_S": str(idle_s),
+                "INDUS_KERNEL_CAPTURE": str(CELL_CAPTURE_BYTES),
+            },
+        )
+        await ship(env, f"{folder}/kernel.env", env_file(values))
+        log_file = shlex.quote(folder + "/runner.log")
+        # Only the interpreter goes to the background (``{ ... & }``), so ``$!`` is its pid and
+        # nothing left running holds this command's output pipe.
+        program = (
+            f": > {log_file} && "
+            f"{{ python3 {shlex.quote(folder + '/runner.py')} > {log_file} 2>&1 < /dev/null & }} "
+            '&& echo "INDUS-PID:$!"'
+        )
+        started = await sh(env, launch_command(folder, cwd or folder, "kernel.env", program))
+        pid = next(
+            (
+                line.strip().removeprefix("INDUS-PID:")
+                for line in started.output.splitlines()
+                if line.strip().startswith("INDUS-PID:")
+            ),
+            "",
+        )
+        if not pid.isdigit():
+            raise KernelStartFailed(f"the remote kernel did not start: {started.output[-300:]!r}")
+        deadline = clock.monotonic() + START_WAIT_S
+        ready = f"{folder}/ready"
+        while True:
+            check = await sh(
+                env,
+                f"[ -f {shlex.quote(ready)} ] && echo READY; "
+                f"kill -0 {shlex.quote(pid)} 2>/dev/null || echo DEAD",
+            )
+            if "READY" in check.output:
+                return RemoteKernel(env, folder, pid, token, clock)
+            if "DEAD" in check.output or clock.monotonic() >= deadline:
+                raise KernelStartFailed("the remote kernel stopped before it was ready")
+            await clock.sleep(POLL_S)
+    except BaseException:
+        if pid.isdigit():
+            await stop_remote(env, pid, folder)
+        else:
+            try:
+                await sh(env, f"rm -rf {shlex.quote(folder)}")
+            except Exception:
+                log.debug("could not remove %s", folder, exc_info=True)
+        raise
+
+
+POOL: KernelPool[RemoteKernel] = KernelPool("remote")
+
+
+# -- one call --------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RemoteJob:
+    code: str
+    scope: Scope
+    env: Environment
+    env_key: str
+    owner: str
+    mode: Mode
+    tools: tuple[str, ...]
+    settings: CodeSettings
+    reset: bool
+    pipeline: RpcPipeline
+    clock: Clock
+    cancel: CancelSignal | None = None
+
+
+def _cwd(job: RemoteJob) -> str | None:
+    return job.env.cwd if job.mode == "project" else None
+
+
+async def run_remote(job: RemoteJob) -> RunOutcome:
+    """See the module notes. Raises ``RemoteSetupError`` when python3 is missing."""
+    started = job.clock.monotonic()
+    probe = await sh(job.env, PYTHON_CHECK)
+    found = [
+        line.strip().removeprefix("INDUS-PY:")
+        for line in probe.output.splitlines()
+        if line.strip().startswith("INDUS-PY:")
+    ]
+    usable = [name for name in INTERPRETERS if name in found]
+    if not usable:
+        raise RemoteSetupError(NO_PYTHON.format(backend=job.env.name))
+    outcome: RunOutcome | None = None
+    if job.settings.kernel == "auto" and "python3" in usable:
+        try:
+            outcome = await _run_in_kernel(job)
+        except KernelStartFailed as exc:
+            log.warning(
+                "remote kernel unavailable on %s (%s); shipping a script", job.env.name, exc
+            )
+        except RemoteSetupError as exc:
+            log.warning(
+                "remote kernel setup failed on %s (%s); shipping a script", job.env.name, exc
+            )
+    if outcome is None:
+        outcome = await _run_shipped(job, usable[0])
+    outcome.seconds = max(0.0, job.clock.monotonic() - started)
+    return outcome
+
+
+async def _run_in_kernel(job: RemoteJob) -> RunOutcome:
+    key = KernelKey(
+        job.owner, f"{job.env.name}:{job.env_key}", job.mode, "python3", _cwd(job) or "", job.tools
+    )
+
+    async def make() -> RemoteKernel:
+        return await start_remote_kernel(
+            job.scope,
+            job.env,
+            cwd=_cwd(job),
+            tools=job.tools,
+            idle_s=job.settings.kernel_idle_s,
+            clock=job.clock,
+        )
+
+    taken = await POOL.take(
+        key,
+        clock=job.clock,
+        reset=job.reset,
+        idle_s=job.settings.kernel_idle_s,
+        cap=job.settings.max_kernels,
+        make=make,
+    )
+    kernel = taken.kernel
+    info = taken.info("remote")
+    released = False
+    job.pipeline.token = kernel.token
+    try:
+        q = shlex.quote(kernel.folder)
+        await sh(job.env, f"rm -f {q}/rpc/req_* {q}/rpc/res_*")  # nothing left from a past call
+        kernel.seq += 1
+        seq = kernel.seq
+        try:
+            await ship(
+                job.env,
+                f"{kernel.folder}/cells/req_{seq:06d}.json",
+                json.dumps({"id": uuid.uuid4().hex, "code": job.code}, ensure_ascii=False),
+            )
+        except RemoteSetupError:
+            await POOL.discard(key, kernel)
+            released = True
+            raise KernelStartFailed("the call could not be handed to the remote kernel") from None
+        state, reply = await _poll_cell(job, kernel, seq)
+        outcome = RunOutcome(
+            status="success",
+            exit_code=0,
+            tool_calls_made=job.pipeline.calls_made,
+            tool_errors=job.pipeline.tool_errors(TOOL_ERRORS_SHOWN),
+            kernel=info,
+            show_stderr=True,
+        )
+        if state in ("timeout", "interrupted", "died"):
+            await POOL.discard(key, kernel)
+            released = True
+            info["ended"] = True
+            outcome.exit_code = -1
+            if state == "timeout":
+                outcome.status = "timeout"
+                outcome.error = timeout_message(job.settings.timeout_s, kernel=True)
+            elif state == "interrupted":
+                outcome.status = "interrupted"
+                outcome.error = (
+                    "Interrupted: the remote session kernel was stopped; its state is gone."
+                )
+            else:
+                outcome.status = "error"
+                outcome.error = "The remote session kernel stopped while running the call."
+            return outcome
+        kernel.count = int(reply.get("count", kernel.count + 1) or 0)
+        info["execution_count"] = kernel.count
+        outcome.stdout = str(reply.get("stdout", ""))
+        outcome.stderr = str(reply.get("stderr", ""))
+        trace = str(reply.get("traceback", ""))
+        cell_state = str(reply.get("state", "ok"))
+        if reply.get("stdout_cut"):
+            info["capture_cut"] = (
+                f"The call printed more than {CELL_CAPTURE_BYTES:,} bytes; only the first part "
+                "was kept."
+            )
+        if cell_state == "error":
+            outcome.status, outcome.exit_code = "error", 1
+            outcome.error = trace.strip().splitlines()[-1] if trace.strip() else "The cell raised."
+            outcome.stderr += trace
+            outcome.hint_text = trace
+        elif cell_state == "exit":
+            info["ended"] = True
+            await POOL.discard(key, kernel, lost=False)
+            released = True
+        return outcome
+    finally:
+        if not released:
+            POOL.give_back(kernel, job.clock)
+
+
+async def _poll_cell(job: RemoteJob, kernel: RemoteKernel, seq: int) -> tuple[str, dict[str, Any]]:
+    deadline = job.clock.monotonic() + job.settings.timeout_s
+    command = tick_command(kernel.folder, cell_seq=seq, pid=kernel.pid)
+    while True:
+        try:
+            result = await sh(job.env, command)
+        except Exception:
+            log.debug("remote kernel poll failed once", exc_info=True)
+            result = None
+        if result is not None:
+            tick = parse_tick(result.output)
+            await answer_requests(job.env, kernel.folder, tick, job.pipeline)
+            if tick.cell is not None:
+                return "done", tick.cell
+            if tick.cell_broken or tick.dead or tick.gone:
+                return "died", {}
+        if job.cancel is not None and job.cancel.is_set():
+            return "interrupted", {}
+        if job.clock.monotonic() >= deadline:
+            return "timeout", {}
+        await job.clock.sleep(POLL_S)
+
+
+# -- shipping one script ---------------------------------------------------------------------------
+
+
+async def _run_shipped(job: RemoteJob, python: str) -> RunOutcome:
+    root = await remote_temp_dir(job.env)
+    folder = f"{root}/indus-rscript-{uuid.uuid4().hex[:12]}"
+    stop_polling = False
+
+    async def serve() -> None:
+        command = tick_command(folder)
+        while not stop_polling:
+            try:
+                result = await sh(job.env, command)
+            except Exception:
+                log.debug("remote request poll failed once", exc_info=True)
+            else:
+                await answer_requests(
+                    job.env, folder, parse_tick(result.output), job.pipeline, python=python
+                )
+            await job.clock.sleep(POLL_S)
+
+    poller: asyncio.Task[None] | None = None
+    try:
+        await checked(
+            job.env, private_dirs_command(folder, f"{folder}/rpc"), "making the script directory"
+        )
+        token = secrets.token_urlsafe(32)
+        job.pipeline.token = token
+        await ship(
+            job.env, f"{folder}/{MODULE_NAME}.py", module_source(job.tools, "file"), python=python
+        )
+        await ship(job.env, f"{folder}/script.py", job.code, python=python)
+        await ship(
+            job.env,
+            f"{folder}/run.env",
+            env_file(run_env(job.scope, folder, token, {})),
+            python=python,
+        )
+        poller = asyncio.ensure_future(serve())
+        program = f"exec {python} {shlex.quote(folder + '/script.py')}"
+        result = await job.env.execute(
+            launch_command(folder, _cwd(job) or folder, "run.env", program),
+            timeout=job.settings.timeout_s,
+            cwd="/",
+            bounded=False,
+            cancel=job.cancel,
+        )
+    finally:
+        stop_polling = True
+        if poller is not None:
+            poller.cancel()
+            with contextlib.suppress(BaseException):  # its own cancellation, or a poll error
+                await poller
+        try:
+            await sh(job.env, f"rm -rf {shlex.quote(folder)}")
+        except Exception:
+            log.debug("could not remove %s", folder, exc_info=True)
+    outcome = RunOutcome(
+        status="success",
+        stdout=result.output,
+        exit_code=result.returncode,
+        tool_calls_made=job.pipeline.calls_made,
+        tool_errors=job.pipeline.tool_errors(TOOL_ERRORS_SHOWN),
+        kernel={"mode": "script", "remote": True},
+    )
+    if result.timed_out:
+        outcome.status, outcome.exit_code = "timeout", -1
+        outcome.error = timeout_message(job.settings.timeout_s)
+    elif result.interrupted:
+        outcome.status, outcome.exit_code = "interrupted", -1
+        outcome.error = "Interrupted: the script was stopped."
+    elif result.returncode != 0:
+        outcome.status = "error"
+        outcome.error = f"The script exited with code {result.returncode}."
+        outcome.hint_text = result.output
+    return outcome
+
+
+__all__ = [
+    "POLL_S",
+    "POOL",
+    "KernelStartFailed",
+    "RemoteJob",
+    "RemoteKernel",
+    "RemoteSetupError",
+    "answer_requests",
+    "parse_tick",
+    "remote_temp_dir",
+    "run_remote",
+    "ship",
+    "start_remote_kernel",
+    "stop_remote",
+    "tick_command",
+]
