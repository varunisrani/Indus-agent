new file mode 100644
index 0000000..2b44efa
--- /dev/null
+++ b/src/indus/tools/builtin/code/remote_runner.py
@@ -0,0 +1,139 @@
+# pyright: strict
+"""The program a remote session kernel runs (P10-11), kept as text and shipped to the backend.
+
+It starts its own session (so Indus can stop it as a group), writes ``ready`` into its kernel
+directory, then polls ``cells/`` for ``req_<n>.json``. Each request is removed, run in the one
+namespace kept for the kernel's life with file descriptors 1 and 2 pointed at private temp files
+(so output of programs the cell starts is caught too, each stream cut to
+``INDUS_KERNEL_CAPTURE`` bytes), and answered with ``res_<n>.json`` (temp name, then rename,
+mode 0600). It exits when the kernel directory disappears, after ``INDUS_KERNEL_IDLE_S`` seconds
+without a request, or after a cell that called ``sys.exit``.
+"""
+
+from __future__ import annotations
+
+SOURCE = '''\
+"""Indus Agent remote session kernel: runs execute_code cells shipped as files."""
+import json
+import linecache
+import os
+import sys
+import tempfile
+import time
+import traceback
+
+try:
+    os.setsid()
+except OSError:
+    pass
+
+_DIR = os.environ["INDUS_KERNEL_DIR"]
+_CELLS = os.path.join(_DIR, "cells")
+_IDLE_S = float(os.environ.get("INDUS_KERNEL_IDLE_S", "1800"))
+_LIMIT = int(os.environ.get("INDUS_KERNEL_CAPTURE", "1000000"))
+_namespace = {"__name__": "__main__", "__builtins__": __builtins__}
+try:  # keep printed lines in order with output of programs a cell starts
+    sys.stdout.reconfigure(line_buffering=True)
+except (AttributeError, ValueError):
+    pass
+
+
+def _grab(handle):
+    handle.seek(0)
+    data = handle.read(_LIMIT + 1)
+    cut = len(data) > _LIMIT
+    return data[:_LIMIT].decode("utf-8", errors="replace"), cut
+
+
+def _run(number, code):
+    name = "<cell %d>" % number
+    linecache.cache[name] = (len(code), None, code.splitlines(True), name)
+    state, trace = "ok", ""
+    sys.stdout.flush()
+    sys.stderr.flush()
+    saved = (os.dup(1), os.dup(2))
+    out_file = tempfile.TemporaryFile(dir=_DIR)
+    err_file = tempfile.TemporaryFile(dir=_DIR)
+    os.dup2(out_file.fileno(), 1)
+    os.dup2(err_file.fileno(), 2)
+    try:
+        exec(compile(code, name, "exec"), _namespace)
+    except SystemExit as exc:
+        state, trace = "exit", "SystemExit: %r" % (exc.code,)
+    except BaseException:
+        state, trace = "error", traceback.format_exc()
+    finally:
+        try:
+            sys.stdout.flush()
+            sys.stderr.flush()
+        except Exception:
+            pass
+        os.dup2(saved[0], 1)
+        os.dup2(saved[1], 2)
+        os.close(saved[0])
+        os.close(saved[1])
+    out_text, out_cut = _grab(out_file)
+    err_text, err_cut = _grab(err_file)
+    out_file.close()
+    err_file.close()
+    return {
+        "state": state,
+        "stdout": out_text,
+        "stderr": err_text,
+        "stdout_cut": out_cut,
+        "stderr_cut": err_cut,
+        "traceback": trace,
+        "count": number,
+    }
+
+
+def _answer(name, reply):
+    final = os.path.join(_CELLS, name.replace("req_", "res_", 1))
+    partial = final + ".part"
+    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as handle:
+        json.dump(reply, handle, ensure_ascii=False)
+    os.replace(partial, final)
+
+
+def main():
+    open(os.path.join(_DIR, "ready"), "w").close()
+    number = 0
+    last = time.monotonic()
+    while True:
+        if not os.path.isdir(_CELLS):
+            return
+        names = sorted(
+            n for n in os.listdir(_CELLS) if n.startswith("req_") and n.endswith(".json")
+        )
+        if not names:
+            if time.monotonic() - last > _IDLE_S:
+                return
+            time.sleep(0.1)
+            continue
+        for name in names:
+            path = os.path.join(_CELLS, name)
+            try:
+                with open(path, encoding="utf-8") as handle:
+                    request = json.load(handle)
+                code = request["code"]
+            except (OSError, ValueError, KeyError, TypeError):
+                try:
+                    os.remove(path)
+                except OSError:
+                    pass
+                continue
+            os.remove(path)
+            last = time.monotonic()
+            number += 1
+            reply = _run(number, code)
+            reply["id"] = request.get("id", "")
+            _answer(name, reply)
+            if reply["state"] == "exit":
+                return
+
+
+main()
+'''
+
+__all__ = ["SOURCE"]
diff --git a/src/indus/tools/builtin/code/rpc.py b/src/indus/tools/builtin/code/rpc.py
new file mode 100644
index 0000000..b6d9041
--- /dev/null
+++ b/src/indus/tools/builtin/code/rpc.py
@@ -0,0 +1,330 @@
+# pyright: strict
+"""Tool calls from a running script: the request pipeline and the socket server (P10-08).
+
+``RpcPipeline.handle`` answers one request in a fixed order: token (constant-time; an empty
+server token refuses everything) → allow-list → call budget (only dispatched calls count, a
+refusal is free) → argument shape and the foreground-only rule for ``terminal`` → dispatch
+through the normal tool dispatcher (``ToolInvoker``; approvals and hooks apply as for any call)
+→ log. Answers are ``{"result": <tool text>}`` or ``{"refused": <why>}``.
+
+``SocketRpcServer`` listens on a Unix socket (owner-only) inside the run's private directory, or
+on loopback TCP with a random port on Windows. It runs on its own threads and hands each request
+to the event loop of the call that is running (``attach``), so a session kernel that outlives one
+turn keeps working when the next call comes from another loop. Between calls nothing is attached
+and every request is refused.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import hmac
+import json
+import logging
+import os
+import select
+import shutil
+import socket
+import tempfile
+import threading
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation.clock import Clock
+
+log = logging.getLogger(__name__)
+
+type ToolInvoker = Callable[[str, dict[str, Any]], Awaitable[str]]
+type Answer = dict[str, str]
+
+# ``terminal`` arguments a script may not use: a script's commands run in the foreground only.
+FOREGROUND_ONLY: frozenset[str] = frozenset(
+    {
+        "background",
+        "pty",
+        "notify",
+        "notify_on_complete",
+        "watch_patterns",
+        "heartbeat",
+        "persist_on_release",
+    }
+)
+MAX_LINE_BYTES = 64 * 1024 * 1024
+ERROR_PREVIEW_CHARS = 300
+SOCKET_NAME = "rpc.sock"
+MAX_SOCKET_PATH = 100  # AF_UNIX allows 104 (macOS) to 108 (Linux) bytes
+ACCEPT_POLL_S = 0.1
+ANSWER_POLL_S = 0.2
+
+NOT_RUNNING = (
+    "No execute_code call is running for this script, so the tool call was refused (the call "
+    "that started it has ended)."
+)
+
+
+def refused(why: str) -> Answer:
+    return {"refused": why}
+
+
+def token_ok(sent: object, expected: str) -> bool:
+    if not expected:
+        return False
+    given = sent if isinstance(sent, str) else ""
+    return hmac.compare_digest(given.encode("utf-8", "replace"), expected.encode("utf-8"))
+
+
+def error_of(text: str) -> str | None:
+    """The ``error`` text of a JSON-object tool result, else None."""
+    if '"error"' not in text:
+        return None
+    try:
+        body = json.loads(text)
+    except ValueError:
+        return None
+    if not isinstance(body, dict):
+        return None
+    error = cast(dict[str, Any], body).get("error")
+    return str(error)[:ERROR_PREVIEW_CHARS] if error else None
+
+
+@dataclass(frozen=True)
+class CallRecord:
+    tool: str
+    seconds: float
+    error: str | None = None
+
+
+class RpcPipeline:
+    """The checks and the dispatch for one run (or one kernel cell)."""
+
+    def __init__(
+        self,
+        *,
+        token: str,
+        allowed: frozenset[str],
+        max_calls: int,
+        invoke: ToolInvoker,
+        clock: Clock,
+    ) -> None:
+        self.token = token
+        self.allowed = allowed
+        self.max_calls = max_calls
+        self.invoke = invoke
+        self.clock = clock
+        self.calls_made = 0
+        self.records: list[CallRecord] = []
+
+    async def handle(self, request: object) -> Answer:
+        if not isinstance(request, Mapping):
+            return refused("The request is not a JSON object.")
+        body = cast(Mapping[str, Any], request)
+        if not token_ok(body.get("token"), self.token):
+            log.warning("execute_code: a tool request with a wrong token was refused")
+            return refused("Unauthorised tool request.")
+        tool = body.get("tool")
+        if not isinstance(tool, str) or tool not in self.allowed:
+            offered = ", ".join(sorted(self.allowed)) or "none"
+            return refused(f"'{tool}' cannot be called from execute_code here. Offered: {offered}.")
+        if self.calls_made >= self.max_calls:
+            return refused(
+                f"This execute_code call already made its {self.max_calls} tool calls, the most "
+                "one call may make. Split the work over several execute_code calls."
+            )
+        raw_args = body.get("args", {})
+        if raw_args is None:
+            raw_args = {}
+        if not isinstance(raw_args, Mapping):
+            return refused(f"The arguments for {tool} must be a JSON object.")
+        args = dict(cast(Mapping[str, Any], raw_args))
+        if tool == "terminal":
+            used = sorted(k for k in FOREGROUND_ONLY if args.get(k))
+            if used:
+                return refused(
+                    "terminal inside execute_code runs commands in the foreground only; "
+                    f"{', '.join(used)} cannot be used here. Start background work with a direct "
+                    "terminal call instead."
+                )
+            for name in FOREGROUND_ONLY:
+                args.pop(name, None)
+        started = self.clock.monotonic()
+        self.calls_made += 1
+        try:
+            text = await self.invoke(tool, args)
+        except Exception as exc:
+            log.error("execute_code: in-script %s call failed: %s", tool, exc, exc_info=exc)
+            text = json.dumps({"error": f"{tool} failed: {type(exc).__name__}: {exc}"})
+        seconds = round(max(0.0, self.clock.monotonic() - started), 3)
+        self.records.append(CallRecord(tool, seconds, error_of(text)))
+        return {"result": text}
+
+    def tool_errors(self, limit: int) -> list[dict[str, str]]:
+        return [{"tool": r.tool, "error": r.error} for r in self.records if r.error][:limit]
+
+
+def decode_request(line: bytes) -> object:
+    try:
+        return json.loads(line.decode("utf-8"))
+    except (UnicodeDecodeError, ValueError):
+        return None
+
+
+# -- the socket server -----------------------------------------------------------------------------
+
+
+class SocketRpcServer:
+    """See the module notes. ``endpoint`` is what ``INDUS_RPC_SOCKET`` carries."""
+
+    def __init__(self, folder: Path, *, use_tcp: bool | None = None) -> None:
+        self._tcp = os.name == "nt" if use_tcp is None else use_tcp
+        self._lock = threading.Lock()
+        self._pipeline: RpcPipeline | None = None
+        self._loop: asyncio.AbstractEventLoop | None = None
+        self._stopped = threading.Event()
+        self._conns: set[socket.socket] = set()
+        self._short_dir: str | None = None
+        self.socket_path: str | None = None
+        if self._tcp:
+            server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            server.bind(("127.0.0.1", 0))
+            host, port = cast(tuple[str, int], server.getsockname()[:2])
+            self.endpoint = f"tcp://{host}:{port}"
+        else:
+            path = str(folder / SOCKET_NAME)
+            if len(path.encode()) > MAX_SOCKET_PATH:
+                self._short_dir = tempfile.mkdtemp(prefix="irpc")
+                path = os.path.join(self._short_dir, SOCKET_NAME)
+            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            old = os.umask(0o177)
+            try:
+                server.bind(path)
+            finally:
+                os.umask(old)
+            os.chmod(path, 0o600)
+            self.socket_path = path
+            self.endpoint = path
+        server.listen(8)
+        server.setblocking(False)
+        self._server = server
+        self._thread = threading.Thread(target=self._accept_loop, name="code-rpc", daemon=True)
+        self._thread.start()
+
+    # -- attachment -------------------------------------------------------------------------------
+
+    def attach(self, pipeline: RpcPipeline, loop: asyncio.AbstractEventLoop) -> None:
+        with self._lock:
+            self._pipeline, self._loop = pipeline, loop
+
+    def detach(self) -> None:
+        with self._lock:
+            self._pipeline, self._loop = None, None
+
+    # -- serving ----------------------------------------------------------------------------------
+
+    def _accept_loop(self) -> None:
+        while not self._stopped.is_set():
+            try:
+                ready, _, _ = select.select([self._server], [], [], ACCEPT_POLL_S)
+            except (OSError, ValueError):
+                return
+            if not ready:
+                continue
+            try:
+                conn, _ = self._server.accept()
+            except (BlockingIOError, InterruptedError):
+                continue
+            except OSError:
+                return
+            conn.setblocking(True)
+            with self._lock:
+                if self._stopped.is_set():
+                    conn.close()
+                    return
+                self._conns.add(conn)
+            threading.Thread(
+                target=self._serve, args=(conn,), name="code-rpc-conn", daemon=True
+            ).start()
+
+    def _serve(self, conn: socket.socket) -> None:
+        try:
+            reader = conn.makefile("rb")
+            while not self._stopped.is_set():
+                line = reader.readline(MAX_LINE_BYTES + 1)
+                if not line:
+                    return
+                if not line.endswith(b"\n"):
+                    answer = refused("The request is too large.")
+                    conn.sendall((json.dumps(answer) + "\n").encode())
+                    return
+                if not line.strip():
+                    continue
+                answer = self._answer(decode_request(line))
+                conn.sendall((json.dumps(answer, ensure_ascii=False) + "\n").encode("utf-8"))
+        except OSError:
+            return
+        finally:
+            with self._lock:
+                self._conns.discard(conn)
+            with contextlib.suppress(OSError):
+                conn.close()
+
+    def _answer(self, request: object) -> Answer:
+        with self._lock:
+            pipeline, loop = self._pipeline, self._loop
+        if pipeline is None or loop is None or loop.is_closed():
+            return refused(NOT_RUNNING)
+        try:
+            future = asyncio.run_coroutine_threadsafe(pipeline.handle(request), loop)
+        except RuntimeError:
+            return refused(NOT_RUNNING)
+        while True:
+            try:
+                return future.result(timeout=ANSWER_POLL_S)
+            except TimeoutError:
+                if self._stopped.is_set() or loop.is_closed():
+                    future.cancel()
+                    return refused(NOT_RUNNING)
+            except Exception as exc:  # cancelled with its call, or the dispatch itself broke
+                log.debug("execute_code rpc answer failed: %s", type(exc).__name__)
+                return refused(NOT_RUNNING)
+
+    # -- closing ----------------------------------------------------------------------------------
+
+    def close(self) -> None:
+        """Stop serving and remove the socket; safe to call twice."""
+        if self._stopped.is_set():
+            return
+        self._stopped.set()
+        self.detach()
+        with contextlib.suppress(OSError):
+            self._server.close()
+        with self._lock:
+            conns = list(self._conns)
+            self._conns.clear()
+        for conn in conns:
+            with contextlib.suppress(OSError):
+                conn.shutdown(socket.SHUT_RDWR)
+            with contextlib.suppress(OSError):
+                conn.close()
+        self._thread.join(timeout=2)
+        if self.socket_path is not None:
+            with contextlib.suppress(OSError):
+                os.unlink(self.socket_path)
+        if self._short_dir is not None:
+            shutil.rmtree(self._short_dir, ignore_errors=True)
+
+
+__all__ = [
+    "FOREGROUND_ONLY",
+    "NOT_RUNNING",
+    "Answer",
+    "CallRecord",
+    "RpcPipeline",
+    "SocketRpcServer",
+    "ToolInvoker",
+    "decode_request",
+    "error_of",
+    "refused",
+    "token_ok",
+]
diff --git a/src/indus/tools/builtin/code/runner.py b/src/indus/tools/builtin/code/runner.py
new file mode 100644
index 0000000..3386775
--- /dev/null
+++ b/src/indus/tools/builtin/code/runner.py
@@ -0,0 +1,236 @@
+# pyright: strict
+"""Script mode: one fresh Python child per ``execute_code`` call on this machine (P10-08).
+
+``run_script`` stages ``indus_tools.py`` and ``script.py`` in a private directory, opens the RPC
+socket with a new token, starts the child, waits on the scope's clock (the turn's stop signal and
+``timeout`` checked each round), and on every way out — finished, timed out, interrupted, an
+error of ours — stops the child's whole process tree, closes the socket and removes the
+directory. ``finish_result`` turns what happened into the tool's JSON result; the kernel and
+remote paths use it too.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import secrets
+import shutil
+from collections.abc import Iterable
+from dataclasses import dataclass, field
+from typing import Any, Literal
+
+from indus.backends.contract import CancelSignal
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.tools.builtin.code import launch
+from indus.tools.builtin.code import output as out
+from indus.tools.builtin.code.rpc import RpcPipeline, SocketRpcServer, ToolInvoker
+from indus.tools.builtin.code.schema import failure_hint
+from indus.tools.builtin.code.settings import (
+    MODULE_NAME,
+    SPILL_MAX_BYTES,
+    STDERR_BYTES,
+    TOOL_ERRORS_SHOWN,
+    CodeSettings,
+    Mode,
+)
+from indus.tools.builtin.code.stub_module import ENV_SOCKET, ENV_TOKEN, module_source
+
+log = logging.getLogger(__name__)
+
+type Status = Literal["success", "error", "timeout", "interrupted"]
+
+POLL_START_S = 0.01
+POLL_MAX_S = 0.1
+INTERRUPTED_NOTE = "[execution interrupted]"
+
+
+@dataclass
+class RunOutcome:
+    """What one run (script, kernel cell or remote call) produced, before presentation."""
+
+    status: Status
+    stdout: str = ""
+    stderr: str = ""
+    exit_code: int | None = None
+    error: str | None = None
+    tool_calls_made: int = 0
+    tool_errors: list[dict[str, str]] = field(default_factory=lambda: [])
+    seconds: float = 0.0
+    kernel: dict[str, Any] | None = None
+    show_stderr: bool | None = None  # None: only for a non-zero exit
+    hint_text: str = ""  # where failure hints look (stderr or the traceback)
+
+
+def timeout_message(timeout: float, *, kernel: bool = False) -> str:
+    if kernel:
+        return (
+            f"The call ran past its {timeout:g}s limit. The session kernel was stopped and its "
+            "state is gone; the next call starts a fresh one."
+        )
+    return f"The script ran past its {timeout:g}s limit and was stopped."
+
+
+def finish_result(outcome: RunOutcome, scope: Scope | None, tools: Iterable[str]) -> str:
+    """The tool's JSON result (see the package notes for the fields)."""
+    stdout = out.clean(outcome.stdout, scope)
+    shown = out.present_stdout(stdout, scope)
+    text = shown.text
+    show_stderr = outcome.show_stderr
+    if show_stderr is None:
+        show_stderr = outcome.exit_code not in (0, None)
+    if show_stderr and outcome.stderr:
+        text = out.with_stderr(text, out.present_stderr(out.clean(outcome.stderr, scope)))
+    if outcome.status == "timeout" and outcome.error:
+        text = f"{text}\n\n[{outcome.error}]" if text else f"[{outcome.error}]"
+    elif outcome.status == "interrupted":
+        text = f"{text}\n{INTERRUPTED_NOTE}" if text else INTERRUPTED_NOTE
+    result: dict[str, Any] = {
+        "status": outcome.status,
+        "output": text,
+        "tool_calls_made": outcome.tool_calls_made,
+        "duration_seconds": round(outcome.seconds, 2),
+    }
+    if outcome.exit_code is not None:
+        result["exit_code"] = outcome.exit_code
+    if outcome.error and outcome.status != "success":
+        result["error"] = out.clean(outcome.error, scope)
+    if outcome.tool_errors:
+        result["tool_errors"] = outcome.tool_errors[:TOOL_ERRORS_SHOWN]
+    if outcome.kernel is not None:
+        result["kernel"] = outcome.kernel
+    result.update(shown.fields)
+    if outcome.status == "error":
+        hint = failure_hint(outcome.hint_text or outcome.stderr, tools)
+        if hint:
+            result["hint"] = hint
+    return json.dumps(result, ensure_ascii=False)
+
+
+def error_result(message: str, *, user_summary: str | None = None, calls: int = 0) -> str:
+    body: dict[str, Any] = {
+        "status": "error",
+        "error": message,
+        "tool_calls_made": calls,
+        "duration_seconds": 0.0,
+    }
+    if user_summary:
+        body["user_summary"] = user_summary
+    return json.dumps(body, ensure_ascii=False)
+
+
+def stdout_text(capture: out.ByteCapture) -> str:
+    """The captured stdout; past the kept head, a note and the stream's last bytes."""
+    text = out.decode(capture.kept())
+    if capture.overflowed:
+        missing = capture.total - len(capture.kept())
+        tail = out.decode(capture.last(30_000))
+        text += f"\n[... {missing:,} more bytes were printed; only the end is kept ...]\n{tail}"
+    return text
+
+
+@dataclass(frozen=True)
+class ScriptJob:
+    code: str
+    scope: Scope
+    session_id: str | None
+    tools: tuple[str, ...]
+    settings: CodeSettings
+    interpreter: str
+    cwd: str | None  # None: the staging directory (strict mode)
+    invoke: ToolInvoker
+    clock: Clock
+    cancel: CancelSignal | None = None
+    mode: Mode = "project"
+
+
+async def run_script(job: ScriptJob) -> RunOutcome:
+    """Run ``job`` as a fresh process (see the module notes)."""
+    started = job.clock.monotonic()
+    folder = launch.private_dir(launch.staging_root(job.scope))
+    server: SocketRpcServer | None = None
+    child: launch.Child | None = None
+    pipeline: RpcPipeline | None = None
+    try:
+        launch.write_private(folder / f"{MODULE_NAME}.py", module_source(job.tools, "socket"))
+        launch.write_private(folder / "script.py", job.code)
+        token = secrets.token_urlsafe(32)
+        server = SocketRpcServer(folder)
+        pipeline = RpcPipeline(
+            token=token,
+            allowed=frozenset(job.tools),
+            max_calls=job.settings.max_tool_calls,
+            invoke=job.invoke,
+            clock=job.clock,
+        )
+        server.attach(pipeline, asyncio.get_running_loop())
+        env = launch.child_environment(
+            job.scope,
+            session_id=job.session_id,
+            staging=folder,
+            extra={ENV_SOCKET: server.endpoint, ENV_TOKEN: token},
+        )
+        stdout = out.ByteCapture(SPILL_MAX_BYTES)
+        stderr = out.ByteCapture(STDERR_BYTES * 4, tail=STDERR_BYTES)
+        child = launch.Child(
+            [job.interpreter, str(folder / "script.py")],
+            cwd=job.cwd or str(folder),
+            env=env,
+            stdout=stdout,
+            stderr=stderr,
+        )
+        status, code = await _wait(child, job)
+        if status != "success":
+            await child.stop(job.clock)
+        await child.finish_reading(job.clock)
+        outcome = RunOutcome(
+            status=status,
+            stdout=stdout_text(stdout),
+            stderr=out.decode(stderr.last(STDERR_BYTES * 4)),
+            exit_code=code if status == "success" else -1,
+            tool_calls_made=pipeline.calls_made,
+            tool_errors=pipeline.tool_errors(TOOL_ERRORS_SHOWN),
+        )
+        if status == "success" and code != 0:
+            outcome.status = "error"
+            outcome.error = f"The script exited with code {code}."
+        elif status == "timeout":
+            outcome.error = timeout_message(job.settings.timeout_s)
+        elif status == "interrupted":
+            outcome.error = "Interrupted: the script was stopped."
+        outcome.hint_text = outcome.stderr
+        outcome.seconds = max(0.0, job.clock.monotonic() - started)
+        return outcome
+    finally:
+        if child is not None and child.alive():
+            child.force_stop()
+        if server is not None:
+            server.close()
+        shutil.rmtree(folder, ignore_errors=True)
+
+
+async def _wait(child: launch.Child, job: ScriptJob) -> tuple[Status, int | None]:
+    deadline = job.clock.monotonic() + job.settings.timeout_s
+    delay = POLL_START_S
+    while True:
+        code = child.poll()
+        if code is not None:
+            return "success", code
+        if job.cancel is not None and job.cancel.is_set():
+            return "interrupted", None
+        if job.clock.monotonic() >= deadline:
+            return "timeout", None
+        await job.clock.sleep(delay)
+        delay = min(delay * 1.5, POLL_MAX_S)
+
+
+__all__ = [
+    "RunOutcome",
+    "ScriptJob",
+    "error_result",
+    "finish_result",
+    "run_script",
+    "stdout_text",
+    "timeout_message",
+]
diff --git a/src/indus/tools/builtin/code/schema.py b/src/indus/tools/builtin/code/schema.py
new file mode 100644
index 0000000..48af5d7
--- /dev/null
+++ b/src/indus/tools/builtin/code/schema.py
@@ -0,0 +1,226 @@
+# pyright: strict
+"""The ``execute_code`` schema, rebuilt per session, and the failure hints (P10-09).
+
+``ALLOWED`` is the fixed set of tools a script may reach. A session gets the intersection with
+its own tools: ``allowed_for(enabled)``. The description names only that intersection (R02.21);
+``rewrite`` is the registry hook that rebuilds it once the tool array knows which tools survived
+filtering. ``failure_hint`` turns a well-known script failure into one sentence of advice.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Callable, Iterable
+from typing import Any
+
+from indus.tools.builtin.code.settings import (
+    MODULE_NAME,
+    STDOUT_INLINE_BYTES,
+    TOOL_NAME,
+    Mode,
+)
+from indus.tools.builtin.code.stub_module import HELPERS, STUBS, offered
+
+# Tools never offered inside a script whatever the session has (no recursion, no agents, no MCP).
+NEVER: frozenset[str] = frozenset({TOOL_NAME, "delegate_task"})
+ALLOWED: frozenset[str] = frozenset(STUBS)
+
+_SIGNATURES: dict[str, str] = {
+    "read_file": "read_file(path, offset=1, limit=None) -> dict  # numbered lines from 1",
+    "write_file": "write_file(path, content) -> dict  # replaces the whole file; read it first",
+    "patch": "patch(path, old_string, new_string, replace_all=False) -> dict",
+    "search_files": (
+        'search_files(pattern, target="content", path=".", file_glob=None, limit=50) -> dict'
+        '  # target="files" finds names'
+    ),
+    "web_search": "web_search(query, limit=5) -> dict  # title, url and snippet per result",
+    "web_extract": "web_extract(urls, char_limit=None) -> dict  # page text per address",
+    "terminal": (
+        "terminal(command, timeout=None, workdir=None) -> dict  # foreground only: no background,"
+        " pty or notify"
+    ),
+}
+
+
+def allowed_for(enabled: Iterable[str] | None) -> tuple[str, ...]:
+    """The script tools this session has, in description order (``None`` = every allowed one)."""
+    if enabled is None:
+        return tuple(offered(ALLOWED))
+    names = {n for n in enabled if not n.startswith("mcp__") and n not in NEVER}
+    return tuple(offered(names & ALLOWED))
+
+
+def _cwd_sentence(mode: Mode) -> str:
+    if mode == "strict":
+        return (
+            "The script starts in a private empty directory, not the session's working "
+            "directory: give absolute paths for files elsewhere."
+        )
+    return (
+        "The script starts in the session's working directory, under the project's active "
+        "virtualenv or conda Python when there is one, otherwise under Indus's own Python "
+        "(standard library plus Indus's dependencies; check an import before relying on it)."
+    )
+
+
+def describe(tools: Iterable[str], mode: Mode = "project", *, kernel: bool = True) -> str:
+    """The model-facing description for exactly ``tools`` (already intersected)."""
+    names = offered(tools)
+    if names:
+        listing = "\n".join(f"  {_SIGNATURES[n]}" for n in names)
+        sample = ", ".join([n for n in ("read_file", "terminal") if n in names] or names[:2])
+        tools_part = (
+            f"Functions available with `from {MODULE_NAME} import {sample}, ...`:\n{listing}\n"
+            "Each returns the tool's result as a dict; a failed call returns a dict with an "
+            "'error' key. A call Indus refuses (budget used up, bad arguments) raises "
+            "ToolCallRefused."
+        )
+    else:
+        tools_part = (
+            f"No Indus tools are offered to scripts in this session; `{MODULE_NAME}` holds only "
+            "the helpers."
+        )
+    state = (
+        "Variables, imports and loaded data stay in memory between calls in this conversation, "
+        "so build on earlier results; reset=true starts over, and a call that times out or is "
+        "interrupted loses that state."
+        if kernel
+        else "Each call runs in a fresh Python process."
+    )
+    helpers = ", ".join(HELPERS)
+    return (
+        "Run a Python script that calls Indus tools from code. Worth it when a job needs three "
+        "or more tool calls with logic between them: looping over files or pages, filtering a "
+        "large result down before it reaches the conversation, retrying on failure. For a single "
+        "call, or anything that needs the user, call the tool directly. Only what the script "
+        "prints comes back.\n\n"
+        f"{tools_part}\n\n"
+        f"Helpers (import them too): {helpers}. json_parse(text) is a lenient json.loads, "
+        "shell_quote(s) quotes a value for a shell command line, retry(fn, max_attempts=3, "
+        "delay=2) retries with doubling waits.\n\n"
+        f"{state}\n\n"
+        f"Limits: 5 minutes per call, 50 tool calls per call. Printed output over "
+        f"{STDOUT_INLINE_BYTES // 1000} kB shows its beginning and end; the full text is saved "
+        "to a file named in the result.\n\n"
+        f"{_cwd_sentence(mode)}"
+    )
+
+
+def build_schema(
+    tools: Iterable[str], mode: Mode = "project", *, kernel: bool = True
+) -> dict[str, Any]:
+    names = offered(tools)
+    sample = (
+        ", ".join([n for n in ("read_file", "terminal") if n in names] or names[:2]) or "json_parse"
+    )
+    return {
+        "name": TOOL_NAME,
+        "description": describe(names, mode, kernel=kernel),
+        "parameters": {
+            "type": "object",
+            "required": ["code"],
+            "properties": {
+                "code": {
+                    "type": "string",
+                    "description": (
+                        f"Python source. Import tools with `from {MODULE_NAME} import {sample}` "
+                        "and print what you want back."
+                    ),
+                },
+                "reset": {
+                    "type": "boolean",
+                    "default": False,
+                    "description": "Throw away the kept interpreter state before running.",
+                },
+            },
+        },
+    }
+
+
+def schema_rewrite(
+    mode_of: Callable[[], Mode], kernel_of: Callable[[], bool]
+) -> Callable[[dict[str, Any], frozenset[str]], dict[str, Any] | None]:
+    """The registry ``rewrite`` hook: the schema for the tools that survived filtering."""
+
+    def rewrite(function: dict[str, Any], present: frozenset[str]) -> dict[str, Any] | None:
+        built = build_schema(allowed_for(present), mode_of(), kernel=kernel_of())
+        return {**function, "description": built["description"], "parameters": built["parameters"]}
+
+    return rewrite
+
+
+# -- failure hints ---------------------------------------------------------------------------------
+
+_SCAN_CHARS = 6000
+
+
+def _missing_name(match: re.Match[str], tools: tuple[str, ...]) -> str:
+    name = match.group(1)
+    if name in HELPERS:
+        return (
+            f"`{name}` is a helper of {MODULE_NAME}; import it with `from {MODULE_NAME} import "
+            f"{name}`. If that import itself failed, another module named {MODULE_NAME} may come "
+            "first on sys.path; retry with reset=true."
+        )
+    available = ", ".join(tools) if tools else "none"
+    return (
+        f"`{name}` cannot be called from a script in this session. Tools importable from "
+        f"{MODULE_NAME} here: {available}. Call any other tool directly, outside execute_code."
+    )
+
+
+def _helper_not_imported(match: re.Match[str], tools: tuple[str, ...]) -> str:
+    return f"Import the helper before using it: `from {MODULE_NAME} import {match.group(1)}`."
+
+
+def _not_installed(match: re.Match[str], tools: tuple[str, ...]) -> str:
+    return (
+        f"The module '{match.group(1)}' is not installed for the interpreter the script runs "
+        "under. Use the standard library here, or run the code with the project's own Python "
+        "through terminal()."
+    )
+
+
+def _result_is_dict(match: re.Match[str], tools: tuple[str, ...]) -> str:
+    return (
+        f"Functions from {MODULE_NAME} already return parsed dicts, not JSON text: index them "
+        "directly (for example read_file(path)['content']) instead of calling json.loads or "
+        "treating them as strings."
+    )
+
+
+type _Rule = tuple[re.Pattern[str], Callable[[re.Match[str], tuple[str, ...]], str]]
+
+_RULES: tuple[_Rule, ...] = (
+    (re.compile(rf"cannot import name '(\w+)' from '{MODULE_NAME}'"), _missing_name),
+    (
+        re.compile(r"NameError: name '(json_parse|shell_quote|retry)' is not defined"),
+        _helper_not_imported,
+    ),
+    (re.compile(r"ModuleNotFoundError: No module named '([\w.]+)'"), _not_installed),
+    (
+        re.compile(
+            r"TypeError: (?:string indices must be integers|the JSON object must be str, bytes "
+            r"or bytearray, not dict)|AttributeError: 'str' object has no attribute 'get'"
+        ),
+        _result_is_dict,
+    ),
+)
+
+
+def failure_hint(text: str, tools: Iterable[str] = ()) -> str | None:
+    """One hint for a recognised failure in ``text`` (stderr or a traceback); first rule wins."""
+    if not text:
+        return None
+    window = text[-_SCAN_CHARS:]
+    available = tuple(offered(tools))
+    for pattern, explain in _RULES:
+        found = pattern.search(window)
+        if found is not None:
+            if pattern is _RULES[2][0] and found.group(1).split(".")[0] == MODULE_NAME:
+                return (
+                    f"{MODULE_NAME} could not be imported; retry with reset=true. If it keeps "
+                    "failing, run the code without execute_code."
+                )
+            return explain(found, available)
+    return None
diff --git a/src/indus/tools/builtin/code/settings.py b/src/indus/tools/builtin/code/settings.py
new file mode 100644
index 0000000..f5d4a34
--- /dev/null
+++ b/src/indus/tools/builtin/code/settings.py
@@ -0,0 +1,99 @@
+# pyright: strict
+"""Limits and settings of ``execute_code``, read from the call's scope on every call.
+
+The numbers the plan fixes live here as constants; the ones a user may change are read from the
+``code_execution`` config section (defaults in ``foundation.config.schema``). A value that is not a
+positive whole number falls back to its default with a warning, so a typo never removes a limit.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import Literal
+
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+log = logging.getLogger(__name__)
+
+TOOL_NAME = "execute_code"
+TOOLSET = "code_execution"
+MODULE_NAME = "indus_tools"
+
+STDOUT_INLINE_BYTES = 50_000
+STDOUT_HEAD_SHARE = 0.4  # the rest of the inline budget goes to the tail
+STDERR_BYTES = 10_000
+SPILL_MAX_BYTES = 5_000_000
+CELL_CAPTURE_BYTES = 1_000_000
+KILL_GRACE_S = 5.0
+REMOTE_POLL_S = 0.5
+RPC_CALL_WAIT_S = 300.0  # how long the in-script stub waits for one answer
+TOOL_ERRORS_SHOWN = 5
+MAX_RESULT_CHARS = 100_000
+
+type Mode = Literal["project", "strict"]
+type KernelSetting = Literal["auto", "off"]
+
+MODES: tuple[Mode, ...] = ("project", "strict")
+
+
+@dataclass(frozen=True)
+class CodeSettings:
+    timeout_s: float = 300.0
+    max_tool_calls: int = 50
+    mode: Mode = "project"
+    kernel: KernelSetting = "auto"
+    kernel_idle_s: float = 1800.0
+    max_kernels: int = 4
+
+    @classmethod
+    def from_scope(cls, scope: Scope | None) -> CodeSettings:
+        return cls(
+            timeout_s=float(_positive_int(scope, "timeout")),
+            max_tool_calls=_positive_int(scope, "max_tool_calls"),
+            mode=_mode(scope),
+            kernel="off" if _text(scope, "kernel") == "off" else "auto",
+            kernel_idle_s=float(_positive_int(scope, "kernel_idle_timeout")),
+            max_kernels=_positive_int(scope, "max_session_kernels"),
+        )
+
+
+def _raw(scope: Scope | None, name: str) -> object:
+    key = f"code_execution.{name}"
+    value: object = None
+    if scope is not None and scope.config is not None:
+        try:
+            value = scope.config.get(key)
+        except Exception:
+            log.debug("could not read %s", key, exc_info=True)
+    return default_for(key) if value is None else value
+
+
+def _text(scope: Scope | None, name: str) -> str:
+    return str(_raw(scope, name)).strip().lower()
+
+
+def _positive_int(scope: Scope | None, name: str) -> int:
+    raw = _raw(scope, name)
+    fallback = int(default_for(f"code_execution.{name}"))
+    if isinstance(raw, bool):
+        return fallback
+    try:
+        value = int(raw)  # pyright: ignore[reportArgumentType]
+    except (TypeError, ValueError):
+        log.warning("code_execution.%s=%r is not a whole number; using %d", name, raw, fallback)
+        return fallback
+    if value < 1:
+        log.warning("code_execution.%s=%r must be at least 1; using %d", name, raw, fallback)
+        return fallback
+    return value
+
+
+def _mode(scope: Scope | None) -> Mode:
+    value = _text(scope, "mode")
+    if value == "strict":
+        return "strict"
+    if value != "project":
+        log.warning("code_execution.mode=%r is not project or strict; using project", value)
+    return "project"
diff --git a/src/indus/tools/builtin/code/stub_module.py b/src/indus/tools/builtin/code/stub_module.py
new file mode 100644
index 0000000..05c8e5a
--- /dev/null
+++ b/src/indus/tools/builtin/code/stub_module.py
@@ -0,0 +1,280 @@
+# pyright: strict
+"""The source of ``indus_tools``, the module a script imports to call our tools (P10-09).
+
+``module_source(tools, transport)`` writes one function per allowed tool the session has, the
+three helpers (``json_parse``, ``shell_quote``, ``retry``) and one of two transports:
+
+- ``socket``: newline-delimited JSON over the Unix socket (or ``tcp://127.0.0.1:<port>``) named
+  by ``INDUS_RPC_SOCKET``; one lock serialises round trips so script threads never read each
+  other's answers; a kernel's stub (``INDUS_RPC_PERSISTENT=1``) reconnects once after a drop.
+- ``file``: for remote backends. A request is written owner-only to a temp name in
+  ``INDUS_RPC_DIR`` and renamed to ``req_<seq>.json``; the answer appears as
+  ``res_<seq>.json``; the wait grows from 50 ms to 250 ms and gives up after
+  ``RPC_CALL_WAIT_S``.
+
+Every request carries ``INDUS_RPC_TOKEN``. An answer is ``{"result": <text>}`` (the tool's own
+result: parsed when it is JSON, else returned as text) or ``{"refused": <why>}``, which raises
+``ToolCallRefused`` in the script. The module uses the standard library only, so it works under
+any Python 3.8+ the project's virtualenv provides.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Literal
+
+from indus.tools.builtin.code.settings import MODULE_NAME, RPC_CALL_WAIT_S
+
+type Transport = Literal["socket", "file"]
+
+ENV_SOCKET = "INDUS_RPC_SOCKET"
+ENV_TOKEN = "INDUS_RPC_TOKEN"
+ENV_DIR = "INDUS_RPC_DIR"
+ENV_PERSISTENT = "INDUS_RPC_PERSISTENT"
+
+HELPERS: tuple[str, ...] = ("json_parse", "shell_quote", "retry")
+
+
+@dataclass(frozen=True)
+class Stub:
+    signature: str
+    doc: str
+    payload: str  # a Python dict expression over the parameters
+
+
+# One entry per tool a script may call, in the order the description lists them.
+STUBS: dict[str, Stub] = {
+    "read_file": Stub(
+        "path, offset=1, limit=None",
+        "Lines of a text file, numbered from 1. Returns a dict with the file's content.",
+        '{"path": path, "offset": offset, "limit": limit}',
+    ),
+    "write_file": Stub(
+        "path, content",
+        "Replace a file's whole content (an existing file must have been read first).",
+        '{"path": path, "content": content}',
+    ),
+    "patch": Stub(
+        "path, old_string, new_string, replace_all=False",
+        "Swap one exact piece of a file for another.",
+        '{"path": path, "old_string": old_string, "new_string": new_string, '
+        '"replace_all": replace_all}',
+    ),
+    "search_files": Stub(
+        'pattern, target="content", path=".", file_glob=None, limit=50, offset=0, '
+        'output_mode="content", context=0',
+        'Search inside files (target="content") or for file names (target="files").',
+        '{"pattern": pattern, "target": target, "path": path, "file_glob": file_glob, '
+        '"limit": limit, "offset": offset, "output_mode": output_mode, "context": context}',
+    ),
+    "web_search": Stub(
+        "query, limit=5",
+        "Ranked web results: title, address and snippet for each.",
+        '{"query": query, "limit": limit}',
+    ),
+    "web_extract": Stub(
+        "urls, char_limit=None",
+        "The readable text of each page address given.",
+        '{"urls": urls, "char_limit": char_limit}',
+    ),
+    "terminal": Stub(
+        "command, timeout=None, workdir=None, **options",
+        "Run one shell command in the foreground and wait for it.",
+        '{"command": command, "timeout": timeout, "workdir": workdir, **options}',
+    ),
+}
+
+
+_PRELUDE = '''\
+"""Generated by Indus Agent for one execute_code run: call Indus tools from Python."""
+import json
+import os
+import shlex
+import threading
+import time
+
+__all__ = [__NAMES__]
+
+_TOKEN = os.environ.get("INDUS_RPC_TOKEN", "")
+_WAIT_S = __WAIT__
+
+
+class ToolCallRefused(RuntimeError):
+    """Indus refused the call itself (unknown tool, call budget used up, bad arguments)."""
+
+
+def json_parse(text):
+    """json.loads that also accepts raw control characters inside strings and a leading BOM."""
+    if isinstance(text, (bytes, bytearray)):
+        text = bytes(text).decode("utf-8", errors="replace")
+    if isinstance(text, str) and text[:1] == "\\ufeff":
+        text = text[1:]
+    return json.loads(text, strict=False)
+
+
+def shell_quote(value):
+    """Quote one value for use inside a shell command line."""
+    return shlex.quote(str(value))
+
+
+def retry(fn, max_attempts=3, delay=2):
+    """Call fn() until it does not raise, at most max_attempts times; waits double each time."""
+    attempts = max(1, int(max_attempts))
+    for attempt in range(attempts):
+        try:
+            return fn()
+        except Exception:
+            if attempt + 1 >= attempts:
+                raise
+            time.sleep(delay * (2 ** attempt))
+
+
+def _answer(raw):
+    try:
+        reply = json.loads(raw)
+    except ValueError:
+        raise ToolCallRefused("Indus sent an answer that is not JSON") from None
+    if not isinstance(reply, dict):
+        raise ToolCallRefused("Indus sent an answer of the wrong shape")
+    if "refused" in reply:
+        raise ToolCallRefused(str(reply["refused"]))
+    result = reply.get("result")
+    if isinstance(result, str):
+        try:
+            return json.loads(result)
+        except ValueError:
+            return result
+    return result
+'''
+
+_SOCKET_TRANSPORT = """
+import socket
+
+_lock = threading.Lock()
+_conn = None
+_PERSISTENT = os.environ.get("INDUS_RPC_PERSISTENT") == "1"
+
+
+def _open():
+    endpoint = os.environ["INDUS_RPC_SOCKET"]
+    if endpoint.startswith("tcp://"):
+        host, _, port = endpoint[len("tcp://"):].rpartition(":")
+        conn = socket.create_connection((host or "127.0.0.1", int(port)))
+    else:
+        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        conn.connect(endpoint)
+    conn.settimeout(_WAIT_S)
+    return conn
+
+
+def _round_trip(line):
+    global _conn
+    if _conn is None:
+        _conn = _open()
+    _conn.sendall(line)
+    chunks = []
+    while True:
+        chunk = _conn.recv(1 << 16)
+        if not chunk:
+            raise ConnectionError("Indus closed the tool connection")
+        chunks.append(chunk)
+        if chunk.endswith(b"\\n"):
+            return b"".join(chunks)
+
+
+def _call(tool, args):
+    global _conn
+    args = {key: value for key, value in args.items() if value is not None}
+    line = (json.dumps({"tool": tool, "args": args, "token": _TOKEN}) + "\\n").encode("utf-8")
+    tries = 2 if _PERSISTENT else 1
+    with _lock:
+        for attempt in range(tries):
+            try:
+                raw = _round_trip(line)
+                break
+            except (OSError, ConnectionError):
+                if _conn is not None:
+                    try:
+                        _conn.close()
+                    except OSError:
+                        pass
+                _conn = None
+                if attempt + 1 >= tries:
+                    raise
+    return _answer(raw.decode("utf-8", errors="replace"))
+"""
+
+_FILE_TRANSPORT = """
+_lock = threading.Lock()
+_seq = 0
+
+
+def _call(tool, args):
+    global _seq
+    args = {key: value for key, value in args.items() if value is not None}
+    folder = os.environ["INDUS_RPC_DIR"]
+    with _lock:
+        _seq += 1
+        number = "%06d" % _seq
+    request = os.path.join(folder, "req_" + number + ".json")
+    answer = os.path.join(folder, "res_" + number + ".json")
+    partial = request + ".part"
+    body = json.dumps({"tool": tool, "args": args, "token": _TOKEN, "seq": _seq})
+    fd = os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w", encoding="utf-8") as handle:
+        handle.write(body)
+    os.replace(partial, request)
+    deadline = time.monotonic() + _WAIT_S
+    gap = 0.05
+    while not os.path.exists(answer):
+        if time.monotonic() > deadline:
+            raise TimeoutError("no answer from Indus for %s within %ss" % (tool, _WAIT_S))
+        time.sleep(gap)
+        gap = min(gap * 1.25, 0.25)
+    with open(answer, encoding="utf-8") as handle:
+        raw = handle.read()
+    try:
+        os.remove(answer)
+    except OSError:
+        pass
+    return _answer(raw)
+"""
+
+
+def _function(name: str, stub: Stub) -> str:
+    return (
+        f"\n\ndef {name}({stub.signature}):\n"
+        f'    """{stub.doc}"""\n'
+        f"    return _call({name!r}, {stub.payload})\n"
+    )
+
+
+def offered(tools: Iterable[str]) -> list[str]:
+    """The tools among ``tools`` that have a stub, in description order."""
+    wanted = set(tools)
+    return [name for name in STUBS if name in wanted]
+
+
+def module_source(tools: Iterable[str], transport: Transport = "socket") -> str:
+    """The text of ``indus_tools.py`` for ``tools`` (see the module notes)."""
+    names = offered(tools)
+    exported = ", ".join(repr(n) for n in [*names, *HELPERS, "ToolCallRefused"])
+    prelude = _PRELUDE.replace("__NAMES__", exported).replace("__WAIT__", repr(RPC_CALL_WAIT_S))
+    body = _SOCKET_TRANSPORT if transport == "socket" else _FILE_TRANSPORT
+    return prelude + body + "".join(_function(n, STUBS[n]) for n in names)
+
+
+__all__ = [
+    "ENV_DIR",
+    "ENV_PERSISTENT",
+    "ENV_SOCKET",
+    "ENV_TOKEN",
+    "HELPERS",
+    "MODULE_NAME",
+    "STUBS",
+    "Stub",
+    "Transport",
+    "module_source",
+    "offered",
+]
