+    async def main() -> Agent:
+        agent = await Agent.start(
+            with_mode(scope, "fast"), fast_route(server), [], fake_options(server)
+        )
+        agent.usage.add_listener(lambda usage, task: seen.append(usage.raw if usage else None))
