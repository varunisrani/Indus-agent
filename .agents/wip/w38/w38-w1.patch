+@dataclass(frozen=True)
+class ItemMeta:
+    """What may be shown about a vault item (never its secret)."""
+
+    handle: str
+    backend: str
+    kind: str
+    label: str
+    origins: tuple[str, ...] = ()
+    identifier: str = ""
+    identifier_type: str = ""
+    has_otp: bool = False
