index 0000000..24da264
--- /dev/null
+++ b/apps/web/src/lib/visibility.ts
@@ -0,0 +1,40 @@
+// Page-visibility aware polling: work runs on a fixed period only while the browser tab is visible,
+// and once immediately when the tab comes back.
+
+import { useEffect, useRef, useState } from "react";
+
+export function isPageVisible(): boolean {
+  return typeof document === "undefined" || !document.hidden;
+}
+
+/** True while the tab is visible; follows `visibilitychange`. */
+export function usePageVisible(): boolean {
+  const [visible, setVisible] = useState(isPageVisible);
+  useEffect(() => {
+    const update = () => setVisible(isPageVisible());
+    document.addEventListener("visibilitychange", update);
+    return () => document.removeEventListener("visibilitychange", update);
+  }, []);
+  return visible;
+}
+
+/** Call `tick` every `periodMs` while the page is visible (and `enabled`). */
+export function useVisiblePolling(tick: () => void, periodMs: number, enabled = true): void {
+  const latest = useRef(tick);
+  latest.current = tick;
+  const visible = usePageVisible();
+  const wasVisible = useRef(visible);
+
+  useEffect(() => {
+    if (!enabled || !visible) {
+      wasVisible.current = visible;
+      return;
+    }
+    if (!wasVisible.current) latest.current();
+    wasVisible.current = true;
+    const timer = setInterval(() => {
+      if (isPageVisible()) latest.current();
+    }, periodMs);
+    return () => clearInterval(timer);
+  }, [enabled, visible, periodMs]);
+}
diff --git a/apps/web/src/lib/wsUrl.ts b/apps/web/src/lib/wsUrl.ts
new file mode 100644
index 0000000..040be06
--- /dev/null
+++ b/apps/web/src/lib/wsUrl.ts
@@ -0,0 +1,87 @@
+// WebSocket URLs for the dashboard's sockets (PTY, events, RPC sidecar). Browsers cannot set
+// headers on an upgrade, so the credential rides the query: the loopback session token, or in
+// gated mode a single-use ticket minted by a cookie-authenticated POST just before each dial
+// (R09.2). The value never goes to a log.
+
+import { ApiError } from "./api.ts";
+import { authRequired, basePath, sessionToken } from "./bootstrap.ts";
+
+export const WS_TICKET_PATH = "/api/auth/ws-ticket";
+export const TICKET_TIMEOUT_MS = 8_000;
+
+export type WsAuthParam = readonly ["token" | "ticket", string];
+
+interface TicketReply {
+  ticket: string;
+  ttl_seconds?: number;
+}
+
+function isTicketReply(value: unknown): value is TicketReply {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    typeof (value as { ticket?: unknown }).ticket === "string"
+  );
+}
+
+/** Mint one ticket for `purpose`; fails with `ApiError(0)` when nothing answers within 8 s. */
+export async function fetchWsTicket(purpose: string): Promise<string> {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), TICKET_TIMEOUT_MS);
+  let res: Response;
+  try {
+    res = await fetch(`${basePath()}${WS_TICKET_PATH}`, {
+      method: "POST",
+      credentials: "include",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ purpose }),
+      signal: controller.signal,
+    });
+  } catch (cause) {
+    const timedOut = controller.signal.aborted;
+    throw new ApiError(
+      0,
+      timedOut
+        ? "The dashboard did not hand out a connection ticket in time."
+        : "The dashboard backend is unreachable.",
+      `POST ${WS_TICKET_PATH}: ${timedOut ? "timed out" : String(cause)}`,
+    );
+  } finally {
+    clearTimeout(timer);
+  }
+  const body: unknown = await res.json().catch(() => undefined);
+  if (!res.ok || !isTicketReply(body)) {
+    throw new ApiError(
+      res.status,
+      "The dashboard refused a connection ticket.",
+      `POST ${WS_TICKET_PATH} → ${res.status}`,
+    );
+  }
+  return body.ticket;
+}
+
+/** The credential for one dial: a fresh ticket in gated mode, else the session token. */
+export async function wsAuthParam(purpose: string): Promise<WsAuthParam> {
+  if (authRequired()) return ["ticket", await fetchWsTicket(purpose)];
+  return ["token", sessionToken() ?? ""];
+}
+
+/**
+ * Absolute `ws(s)://` URL for a dashboard socket path such as `/api/pty`, with `params` first and
+ * the credential last. The scheme follows the page (https → wss).
+ */
+export async function buildWsUrl(
+  path: string,
+  purpose: string,
+  params: Record<string, string | undefined> = {},
+): Promise<string> {
+  const query = new URLSearchParams();
+  for (const [key, value] of Object.entries(params)) {
+    if (value !== undefined && value !== "") query.set(key, value);
+  }
+  const [name, value] = await wsAuthParam(purpose);
+  if (value) query.set(name, value);
+  const scheme = window.location.protocol === "https:" ? "wss:" : "ws:";
+  const text = query.toString();
+  return `${scheme}//${window.location.host}${basePath()}${path}${text ? `?${text}` : ""}`;
+}
