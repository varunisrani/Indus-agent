@@ -0,0 +1,170 @@
+// Left navigation. Wide screens: an inline column that collapses to a narrow rail (remembered per
+// browser). Below 1,024 px: a slide-over drawer opened from the header's menu button.
+
+import { type ReactNode, useEffect, useState } from "react";
+import { NavLink } from "react-router";
+import { ProfileSwitcher } from "./ProfileScope.tsx";
+import { DOCS_LINK, type PageRoute } from "./routes.ts";
+import { ThemeSwitch } from "./ThemeSwitch.tsx";
+
+export const SIDEBAR_KEY = "indus-sidebar-collapsed";
+export const WIDE_QUERY = "(min-width: 1024px)";
+
+export function readCollapsed(): boolean {
+  try {
+    return window.localStorage.getItem(SIDEBAR_KEY) === "true";
+  } catch {
+    return false;
+  }
+}
+
+export function writeCollapsed(value: boolean): void {
+  try {
+    window.localStorage.setItem(SIDEBAR_KEY, String(value));
+  } catch {
+    // private browsing: not remembered
+  }
+}
+
+/** True at 1,024 px and wider (also when the browser cannot tell). */
+export function useWideScreen(): boolean {
+  const [query] = useState(() =>
+    typeof window.matchMedia === "function" ? window.matchMedia(WIDE_QUERY) : null,
+  );
+  const [wide, setWide] = useState(query ? query.matches : true);
+  useEffect(() => {
+    if (!query) return;
+    const update = () => setWide(query.matches);
+    query.addEventListener("change", update);
+    return () => query.removeEventListener("change", update);
+  }, [query]);
+  return wide;
+}
+
+interface SidebarProps {
+  items: readonly PageRoute[];
+  search: string;
+  wide: boolean;
+  collapsed: boolean;
+  onToggleCollapsed: () => void;
+  mobileOpen: boolean;
+  onCloseMobile: () => void;
+  /** Status strip (P18-25) and auth widget (P18-28) slots. */
+  footer?: ReactNode;
+}
+
+function NavItems({
+  items,
+  search,
+  compact,
+  onNavigate,
+}: {
+  items: readonly PageRoute[];
+  search: string;
+  compact: boolean;
+  onNavigate: () => void;
+}) {
+  const linkClass = ({ isActive }: { isActive: boolean }) =>
+    `flex items-center gap-2 rounded-md px-2 py-1.5 text-sm ${
+      isActive ? "bg-accent text-accent-fg" : "text-fg hover:bg-code"
+    }`;
+  return (
+    <ul className="flex flex-col gap-0.5">
+      {items.map((item) => (
+        <li key={item.path}>
+          <NavLink
+            to={{ pathname: item.path, search }}
+            className={linkClass}
+            onClick={onNavigate}
+            {...(compact ? { "aria-label": item.title, title: item.title } : {})}
+          >
+            {compact ? <span aria-hidden="true">{item.title.slice(0, 2)}</span> : item.title}
+          </NavLink>
+        </li>
+      ))}
+      <li>
+        <a
+          href={DOCS_LINK.href}
+          target="_blank"
+          rel="noopener noreferrer"
+          className="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-fg hover:bg-code"
+          {...(compact ? { "aria-label": DOCS_LINK.title, title: DOCS_LINK.title } : {})}
+        >
+          {compact ? <span aria-hidden="true">Do</span> : `${DOCS_LINK.title} ↗`}
+        </a>
+      </li>
+    </ul>
+  );
+}
+
+export function Sidebar(props: SidebarProps) {
+  const { items, search, wide, collapsed, onToggleCollapsed, mobileOpen, onCloseMobile, footer } =
+    props;
+  const compact = wide && collapsed;
+
+  const body = (
+    <nav aria-label="Dashboard" className="flex h-full flex-col gap-3 p-2">
+      <div className="flex items-center justify-between gap-2 px-1">
+        {compact ? null : <span className="text-sm font-semibold">Indus Agent</span>}
+        {wide ? (
+          <button
+            type="button"
+            className="rounded-md border border-line px-2 py-1 text-xs"
+            aria-label={collapsed ? "Expand sidebar" : "Collapse sidebar"}
+            aria-expanded={!collapsed}
+            onClick={onToggleCollapsed}
+          >
+            {collapsed ? "»" : "«"}
+          </button>
+        ) : (
+          <button
+            type="button"
+            className="rounded-md border border-line px-2 py-1 text-xs"
+            onClick={onCloseMobile}
+          >
+            Close
+          </button>
+        )}
+      </div>
+      <ProfileSwitcher compact={compact} />
+      <div className="min-h-0 flex-1 overflow-y-auto">
+        <NavItems
+          items={items}
+          search={search}
+          compact={compact}
+          onNavigate={wide ? () => {} : onCloseMobile}
+        />
+      </div>
+      <div className="flex flex-col gap-2 border-t border-line pt-2">
+        {footer}
+        <ThemeSwitch compact={compact} />
+      </div>
+    </nav>
+  );
+
+  if (wide) {
+    return (
+      <aside
+        data-testid="sidebar"
+        data-collapsed={collapsed ? "true" : "false"}
+        className={`shrink-0 border-r border-line bg-raised ${collapsed ? "w-16" : "w-56"}`}
+      >
+        {body}
+      </aside>
+    );
+  }
+  if (!mobileOpen) return null;
+  return (
+    <div className="fixed inset-0 z-40 flex" data-testid="sidebar-drawer">
+      <aside data-testid="sidebar" className="h-full w-64 border-r border-line bg-raised">
+        {body}
+      </aside>
+      <button
+        type="button"
+        aria-label="Close navigation"
+        className="flex-1 bg-black/40"
+        onClick={onCloseMobile}
+      />
+    </div>
+  );
+}
diff --git a/apps/web/src/shell/ThemeSwitch.tsx b/apps/web/src/shell/ThemeSwitch.tsx
new file mode 100644
index 0000000..9cf6bfa
--- /dev/null
+++ b/apps/web/src/shell/ThemeSwitch.tsx
@@ -0,0 +1,61 @@
+// Our light/dark pair (L16, P2 part). The token CSS for both themes comes from @indus/ui and is
+// written once into <head>; switching only flips `data-theme` on <html>. The choice is remembered
+// per browser; without one we follow the system preference.
+
+import { type ThemeName, themeNames, tokensToCss } from "@indus/ui";
+import { useEffect, useState } from "react";
+
+export const THEME_KEY = "indus-theme";
+
+function stored(): ThemeName | null {
+  try {
+    const value = window.localStorage.getItem(THEME_KEY);
+    return value === "indus-light" || value === "indus-dark" ? value : null;
+  } catch {
+    return null;
+  }
+}
+
+function systemTheme(): ThemeName {
+  const query =
+    typeof window.matchMedia === "function"
+      ? window.matchMedia("(prefers-color-scheme: dark)")
+      : null;
+  return query?.matches ? "indus-dark" : "indus-light";
+}
+
+/** One <style> with every theme's tokens; mounted once at the root. */
+export function ThemeStyles() {
+  return (
+    <style data-indus-tokens="">{themeNames.map((name) => tokensToCss(name)).join("\n")}</style>
+  );
+}
+
+export function ThemeSwitch({ compact }: { compact: boolean }) {
+  const [theme, setTheme] = useState<ThemeName>(() => stored() ?? systemTheme());
+
+  useEffect(() => {
+    document.documentElement.dataset.theme = theme;
+  }, [theme]);
+
+  const next: ThemeName = theme === "indus-dark" ? "indus-light" : "indus-dark";
+  const label = next === "indus-dark" ? "Switch to dark theme" : "Switch to light theme";
+  return (
+    <button
+      type="button"
+      aria-label={label}
+      title={label}
+      className="rounded-md border border-line px-2 py-1 text-xs text-fg"
+      onClick={() => {
+        setTheme(next);
+        try {
+          window.localStorage.setItem(THEME_KEY, next);
+        } catch {
+          // storage unavailable: the choice lasts for this page only
+        }
+      }}
+    >
+      {compact ? (theme === "indus-dark" ? "☾" : "☀") : theme === "indus-dark" ? "Dark" : "Light"}
+    </button>
+  );
+}
diff --git a/apps/web/src/shell/Toasts.tsx b/apps/web/src/shell/Toasts.tsx
new file mode 100644
index 0000000..9f76c9d
--- /dev/null
+++ b/apps/web/src/shell/Toasts.tsx
@@ -0,0 +1,99 @@
+// Short-lived notices. Network failures from the REST client arrive here as one plain sentence;
+// the technical details were already written to the console by the client.
+
+import {
+  createContext,
+  type ReactNode,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+import { onUnreachable } from "../lib/api.ts";
+
+export type ToastTone = "info" | "success" | "error";
+
+interface Toast {
+  id: number;
+  message: string;
+  tone: ToastTone;
+}
+
+interface ToastApi {
+  show(message: string, tone?: ToastTone): void;
+}
+
+const ToastContext = createContext<ToastApi>({ show: () => {} });
+
+export function useToast(): ToastApi {
+  return useContext(ToastContext);
+}
+
+export const TOAST_MS = 5_000;
+export const UNREACHABLE_TOAST = "Backend unreachable. The dashboard server is not answering.";
+
+export function ToastProvider({ children }: { children: ReactNode }) {
+  const [toasts, setToasts] = useState<Toast[]>([]);
+  const nextId = useRef(1);
+
+  const dismiss = useCallback((id: number) => {
+    setToasts((all) => all.filter((t) => t.id !== id));
+  }, []);
+
+  const show = useCallback(
+    (message: string, tone: ToastTone = "info") => {
+      setToasts((all) => {
+        // One copy of a message at a time: a burst of failed requests is one notice.
+        if (all.some((t) => t.message === message)) return all;
+        const id = nextId.current++;
+        setTimeout(() => dismiss(id), TOAST_MS);
+        return [...all, { id, message, tone }];
+      });
+    },
+    [dismiss],
+  );
+
+  useEffect(() => onUnreachable(() => show(UNREACHABLE_TOAST, "error")), [show]);
+
+  const value = useMemo(() => ({ show }), [show]);
+  return (
+    <ToastContext.Provider value={value}>
+      {children}
+      <div
+        aria-live="polite"
+        className="pointer-events-none fixed right-4 bottom-4 z-50 flex flex-col gap-2"
+      >
+        {toasts.map((toast) => (
+          <div
+            key={toast.id}
+            role={toast.tone === "error" ? "alert" : "status"}
+            className={`pointer-events-auto flex items-start gap-3 rounded-md border bg-raised px-3 py-2 text-sm shadow ${
+              toast.tone === "error"
+                ? "border-danger text-danger"
+                : toast.tone === "success"
+                  ? "border-ok text-fg"
+                  : "border-line text-fg"
+            }`}
+          >
+            <span>{toast.message}</span>
+            <button
+              type="button"
+              aria-label="Dismiss"
+              className="text-muted"
+              onClick={() => dismiss(toast.id)}
+            >
+              ×
+            </button>
+          </div>
+        ))}
+      </div>
+    </ToastContext.Provider>
+  );
+}
+
+/** A plain sentence for any thrown value. */
+export function errorText(error: unknown): string {
+  return error instanceof Error ? error.message : "Something went wrong.";
+}
diff --git a/apps/web/src/shell/assets.test.ts b/apps/web/src/shell/assets.test.ts
new file mode 100644
index 0000000..9b18213
