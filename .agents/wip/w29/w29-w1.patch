index 0000000..fd01a26
--- /dev/null
+++ b/src/indus/web/auth/proxy.py
@@ -0,0 +1,284 @@
+"""Public URL, trusted proxies and forwarded headers (P18-05).
+
+**Public URL.** ``INDUS_DASHBOARD_PUBLIC_URL`` (a blank value counts as unset), else
+``dashboard.public_url``: the complete address people reach the dashboard at. It fixes the OAuth
+callback to ``<public_url>/auth/callback`` verbatim (the prefix header is not added on top), its
+host joins the hosts the Host and Origin checks accept, and a non-loopback host engages the login
+gate even on a loopback bind (``auth.gate``). A value without an http/https scheme or a host, or
+with quotes, angle brackets, whitespace or control characters, is ignored with one warning.
+
+**Trusted proxies.** ``dashboard.trusted_proxies``: exact addresses or bounded networks. ``*``,
+``0.0.0.0/0`` and ``::/0`` (any ``/0``), names and networks with host bits set are refused when the
+list is parsed, so the dashboard does not start with them. A loopback peer is always trusted.
+
+**Forwarded headers.** ``ForwardedHeaders`` (pure ASGI, the outermost layer) believes
+``X-Forwarded-Proto`` and ``X-Forwarded-For`` only when the connecting peer is trusted: the scheme
+becomes the forwarded one (http/https only) and the client becomes the right-most address in the
+chain that is not itself a trusted proxy. It records the verdict in the scope so the prefix header
+(``indus.web.prefix``) is read only from trusted peers too. Everything downstream (rate limits, the
+audit log, the ``Secure`` cookie flag) reads ``scope["client"]`` / ``scope["scheme"]`` and nothing
+else; no code parses forwarding headers from an untrusted peer.
+"""
+
+from __future__ import annotations
+
+import ipaddress
+import logging
+import threading
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import dataclass, field
+from typing import Any, Final, cast
+from urllib.parse import urlsplit
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+__all__ = [
+    "PUBLIC_URL_ENV",
+    "TRUSTED_SCOPE_KEY",
+    "ForwardedHeaders",
+    "ProxyConfigError",
+    "PublicOrigin",
+    "TrustedProxies",
+    "callback_url",
+    "client_ip",
+    "normalise_public_url",
+    "parse_trusted_proxies",
+    "peer_is_trusted",
+    "resolve_public_url",
+]
+
+log = logging.getLogger(__name__)
+
+PUBLIC_URL_ENV: Final = "INDUS_DASHBOARD_PUBLIC_URL"
+TRUSTED_SCOPE_KEY: Final = "indus.trusted_peer"
+"""Scope key ``ForwardedHeaders`` sets: True when the connecting peer is a trusted proxy."""
+CALLBACK_PATH: Final = "/auth/callback"
+_URL_BAD_CHARS: Final = frozenset("\"'<>`\\")
+_FORWARDED_SCHEMES: Final = frozenset({"http", "https"})
+_MAX_FORWARDED_HOPS: Final = 32
+
+type Network = ipaddress.IPv4Network | ipaddress.IPv6Network
+type Address = ipaddress.IPv4Address | ipaddress.IPv6Address
+
+_warned: set[tuple[str, str]] = set()
+_warned_lock = threading.Lock()
+
+
+class ProxyConfigError(ValueError):
+    """A ``trusted_proxies`` entry the dashboard refuses to start with."""
+
+
+def _warn_once(source: str, value: str, why: str) -> None:
+    with _warned_lock:
+        key = (source, value)
+        if key in _warned or len(_warned) > 256:
+            return
+        _warned.add(key)
+    log.warning("%s was ignored: %s", source, why)
+
+
+# -- public URL -----------------------------------------------------------------------------------
+
+
+def normalise_public_url(raw: object) -> str:
+    """``scheme://host[:port][/path]`` without a trailing slash, or ``""`` when unusable."""
+    if not isinstance(raw, str):
+        return ""
+    value = raw.strip()
+    if not value:
+        return ""
+    if any(ord(char) < 0x20 or ord(char) == 0x7F or char.isspace() for char in value):
+        return ""
+    if any(char in _URL_BAD_CHARS for char in value):
+        return ""
+    try:
+        parts = urlsplit(value)
+        host = parts.hostname
+        parts.port  # noqa: B018 - a bad port raises here
+    except ValueError:
+        return ""
+    if parts.scheme not in ("http", "https") or not host:
+        return ""
+    if parts.username is not None or parts.password is not None:
+        return ""
+    if parts.query or parts.fragment:
+        return ""
+    return value.rstrip("/")
+
+
+@dataclass(frozen=True, slots=True)
+class PublicOrigin:
+    """A declared public URL and its lower-case host name."""
+
+    url: str
+    host: str
+
+    @classmethod
+    def parse(cls, raw: object) -> PublicOrigin | None:
+        url = normalise_public_url(raw)
+        if not url:
+            return None
+        host = urlsplit(url).hostname or ""
+        return cls(url, host.lower())
+
+
+def resolve_public_url(env: Mapping[str, str], configured: object) -> PublicOrigin | None:
+    """The public URL from ``env`` (non-blank wins), else from config; malformed values warn."""
+    env_raw = env.get(PUBLIC_URL_ENV, "")
+    if env_raw.strip():
+        found = PublicOrigin.parse(env_raw)
+        if found is not None:
+            return found
+        _warn_once(PUBLIC_URL_ENV, env_raw, "it is not an absolute http(s) URL with a host")
+    if isinstance(configured, str) and configured.strip():
+        found = PublicOrigin.parse(configured)
+        if found is not None:
+            return found
+        _warn_once("dashboard.public_url", configured, "it is not an absolute http(s) URL")
+    return None
+
+
+def callback_url(public: PublicOrigin | None, *, scheme: str, host_header: str, prefix: str) -> str:
+    """Where the IdP sends the browser back: ``<public_url>/auth/callback`` verbatim when declared
+    (the prefix header is ignored there), else built from the request (scheme, Host, prefix)."""
+    if public is not None:
+        return public.url + CALLBACK_PATH
+    safe_scheme = scheme if scheme in _FORWARDED_SCHEMES else "http"
+    return f"{safe_scheme}://{host_header}{prefix}{CALLBACK_PATH}"
+
+
+# -- trusted proxies ------------------------------------------------------------------------------
+
+
+def _parse_entry(entry: object) -> Network:
+    if not isinstance(entry, str) or not entry.strip():
+        raise ProxyConfigError("dashboard.trusted_proxies: an entry is empty or not text")
+    text = entry.strip()
+    if text == "*":
+        raise ProxyConfigError("dashboard.trusted_proxies: '*' would trust every client")
+    try:
+        network = ipaddress.ip_network(text, strict=True)
+    except ValueError as exc:
+        raise ProxyConfigError(
+            f"dashboard.trusted_proxies: {text!r} is not an IP address or network ({exc})"
+        ) from None
+    if network.prefixlen == 0:
+        raise ProxyConfigError(
+            f"dashboard.trusted_proxies: {text!r} would trust every client; list the proxy's "
+            "address or a dedicated proxy network"
+        )
+    return network
+
+
+@dataclass(frozen=True, slots=True)
+class TrustedProxies:
+    """Peers whose forwarding headers are believed (loopback always)."""
+
+    networks: tuple[Network, ...] = field(default=())
+
+    def trusts(self, host: object) -> bool:
+        address = _address(host)
+        if address is None:
+            return False
+        if address.is_loopback:
+            return True
+        return any(address in network for network in self.networks)
+
+
+def parse_trusted_proxies(entries: object) -> TrustedProxies:
+    """Parse ``dashboard.trusted_proxies``; ``ProxyConfigError`` for any refused entry."""
+    if entries is None or entries == "":
+        return TrustedProxies()
+    if isinstance(entries, str):
+        items: list[object] = [part for part in entries.split(",") if part.strip()]
+    elif isinstance(entries, list | tuple):
+        items = list(cast(Sequence[object], entries))
+    else:
+        raise ProxyConfigError("dashboard.trusted_proxies must be a list of addresses")
+    return TrustedProxies(tuple(_parse_entry(item) for item in items))
+
+
+def _address(host: object) -> Address | None:
+    if not isinstance(host, str) or not host:
+        return None
+    try:
+        address = ipaddress.ip_address(host.strip().strip("[]").split("%", 1)[0])
+    except ValueError:
+        return None
+    if isinstance(address, ipaddress.IPv6Address) and address.ipv4_mapped is not None:
+        return address.ipv4_mapped
+    return address
+
+
+def peer_is_trusted(scope: Mapping[str, Any]) -> bool:
+    """What ``ForwardedHeaders`` decided for this connection (False when it did not run)."""
+    return scope.get(TRUSTED_SCOPE_KEY) is True
+
+
+def client_ip(scope: Mapping[str, Any]) -> str:
+    """The client address after forwarding was applied, or ``""``."""
+    client: object = scope.get("client")
+    if isinstance(client, list | tuple) and cast(Sequence[object], client):
+        first = cast(Sequence[object], client)[0]
+        return first if isinstance(first, str) else ""
+    return ""
+
+
+def _header(scope: Mapping[str, Any], name: bytes) -> str | None:
+    raw: object = scope.get("headers") or ()
+    if not isinstance(raw, list | tuple):
+        return None
+    found: list[str] = []
+    for pair in cast(Iterable[object], raw):
+        if not isinstance(pair, list | tuple) or len(cast(Sequence[object], pair)) != 2:
+            continue
+        key, value = cast(Sequence[object], pair)
+        if isinstance(key, bytes) and key.lower() == name and isinstance(value, bytes):
+            found.append(value.decode("latin-1"))
+    return ",".join(found) if found else None
+
+
+def _forwarded_client(chain: str, proxies: TrustedProxies) -> str | None:
+    hops = [part.strip() for part in chain.split(",") if part.strip()][-_MAX_FORWARDED_HOPS:]
+    for hop in reversed(hops):
+        address = _address(hop)
+        if address is None:
+            return None
+        if not proxies.trusts(str(address)):
+            return str(address)
+    return str(_address(hops[0])) if hops else None
+
+
+class ForwardedHeaders:
+    """Apply ``X-Forwarded-Proto`` / ``-For`` from trusted peers only (see the module notes)."""
+
+    def __init__(self, app: ASGIApp, *, proxies: TrustedProxies) -> None:
+        self.app = app
+        self.proxies = proxies
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] not in ("http", "websocket"):
+            await self.app(scope, receive, send)
+            return
+        peer = client_ip(scope)
+        trusted = self.proxies.trusts(peer)
+        scope = dict(scope)
+        scope[TRUSTED_SCOPE_KEY] = trusted
+        if trusted:
+            proto = (_header(scope, b"x-forwarded-proto") or "").split(",")[0].strip().lower()
+            if proto in _FORWARDED_SCHEMES:
+                if scope["type"] == "websocket":
+                    scope["scheme"] = "wss" if proto == "https" else "ws"
+                else:
+                    scope["scheme"] = proto
+            chain = _header(scope, b"x-forwarded-for")
+            if chain:
+                forwarded = _forwarded_client(chain, self.proxies)
+                if forwarded:
+                    client: object = scope.get("client")
+                    port = 0
+                    if isinstance(client, list | tuple) and len(cast(Sequence[object], client)) > 1:
+                        raw_port = cast(Sequence[object], client)[1]
+                        port = raw_port if isinstance(raw_port, int) else 0
+                    scope["client"] = (forwarded, port)
+        await self.app(scope, receive, send)
diff --git a/src/indus/web/auth/public_paths.py b/src/indus/web/auth/public_paths.py
new file mode 100644
index 0000000..4d6da8e
--- /dev/null
+++ b/src/indus/web/auth/public_paths.py
@@ -0,0 +1,74 @@
+"""The one list of ``/api`` paths reachable without a credential (P18-02, R09.4).
+
+Both gates — the loopback session-token gate and the gated-mode login gate — import
+``PUBLIC_API_PATHS`` from here and match it exactly, so the two lists can never drift apart (a
+test asserts both gates hold this very object). Every entry must be safe to show anyone who can
+reach the port: liveness, coarse status, the config defaults and schema, model metadata, the theme
+list, the dashboard plugin manifest list, and the cron fire webhook (which carries its own
+short-lived signed token, checked by its handler, P18-14). Widening this list needs a D-id.
+
+``LOGIN_PUBLIC_PREFIXES`` are what gated mode additionally lets through before login: the login
+page and the auth round trip, the providers list the login page reads, and the static bundle files
+the login page needs. They are not API data, so they are not on the shared list.
+"""
+
+from __future__ import annotations
+
+from typing import Final
+
+__all__ = [
+    "LOGIN_PUBLIC_PREFIXES",
+    "PUBLIC_API_PATHS",
+    "QUERY_TOKEN_PATHS",
+    "is_login_public",
+    "is_public_api_path",
+]
+
+PUBLIC_API_PATHS: Final[frozenset[str]] = frozenset(
+    {
+        "/api/config/defaults",
+        "/api/config/schema",
+        "/api/cron/fire",
+        "/api/dashboard/plugins",
+        "/api/dashboard/themes",
+        "/api/health",
+        "/api/model/info",
+        "/api/status",
+    }
+)
+"""Exact paths, no prefix matching: ``/api/status/x`` is not public."""
+
+LOGIN_PUBLIC_PREFIXES: Final[tuple[str, ...]] = (
+    "/login",
+    "/auth/login",
+    "/auth/callback",
+    "/auth/password-login",
+    "/auth/logout",
+    "/api/auth/providers",
+    "/assets/",
+    "/fonts/",
+    "/favicon.ico",
+    "/favicon.svg",
+)
+"""Gated mode only: exact path, or a prefix when the entry ends with ``/``."""
+
+QUERY_TOKEN_PATHS: Final[frozenset[str]] = frozenset({"/api/files/download"})
+"""The only REST route that may carry the loopback token as ``?token=`` (a download opened in a
+new tab cannot set a header; P18-16)."""
+
+
+def is_public_api_path(path: str) -> bool:
+    return path in PUBLIC_API_PATHS
+
+
+def is_login_public(path: str) -> bool:
+    """Reachable before login in gated mode: the shared list or a login-bootstrap path."""
+    if path in PUBLIC_API_PATHS:
+        return True
+    for entry in LOGIN_PUBLIC_PREFIXES:
+        if entry.endswith("/"):
+            if path.startswith(entry):
+                return True
+        elif path == entry:
+            return True
+    return False
diff --git a/src/indus/web/auth/service_bearer.py b/src/indus/web/auth/service_bearer.py
new file mode 100644
index 0000000..ef3521e
--- /dev/null
+++ b/src/indus/web/auth/service_bearer.py
@@ -0,0 +1,177 @@
+"""Service bearer providers and the bearer seam (P18-04).
+
+A token provider opts exact route paths into ``Authorization: Bearer``; no other route ever
+accepts its token, and those routes accept nothing else (no cookie, no session token). The seam is
+the outermost auth layer: on an opted-in path a recognised token puts a ``TokenPrincipal`` into the
+request state and later gates step aside; anything else is 401 (503 when a provider's store could
+not be reached). A path whose provider is configured but refused (``ProviderRegistry.
+disabled_routes``) answers 404, so the route stays switched off.
+
+The bundled provider guards the daemon drain route (``DRAIN_ROUTE``, handler P18-15) with the
+shared secret in ``INDUS_DASHBOARD_DRAIN_SECRET``. The secret must carry at least 256 bits
+(``secret_bits``: length × log2 of the smallest alphabet among hex, base64url and printable ASCII
+that holds every character); a weaker one keeps the route disabled. Tokens are compared through
+SHA-256 digests with ``hmac.compare_digest``.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import math
+import string
+from collections.abc import Mapping
+from typing import ClassVar, Final
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+from indus.web.auth.audit import AuditEvent, AuditLog
+from indus.web.auth.providers import Provider, ProviderRegistry, ProviderUnavailable, TokenPrincipal
+from indus.web.auth.proxy import client_ip
+from indus.web.auth.token import bearer_of
+
+__all__ = [
+    "DRAIN_ROUTE",
+    "DRAIN_SECRET_ENV",
+    "MIN_SECRET_BITS",
+    "PRINCIPAL_KEY",
+    "BearerSeam",
+    "SharedSecretProvider",
+    "register_drain",
+    "secret_bits",
+]
+
+DRAIN_ROUTE: Final = "/api/daemon/drain"
+DRAIN_SECRET_ENV: Final = "INDUS_DASHBOARD_DRAIN_SECRET"
+MIN_SECRET_BITS: Final = 256
+PRINCIPAL_KEY: Final = "indus.token_principal"
+"""Scope ``state`` key holding the ``TokenPrincipal`` of an opted-in route."""
+
+_HEX: Final = frozenset(string.hexdigits)
+_B64URL: Final = frozenset(string.ascii_letters + string.digits + "-_")
+_PRINTABLE: Final = frozenset(chr(code) for code in range(0x21, 0x7F))
+
+
+def secret_bits(secret: str) -> float:
+    """Estimated strength of ``secret`` in bits (see the module notes); 0 for anything else."""
+    if not secret:
+        return 0.0
+    chars = set(secret)
+    for alphabet, size in ((_HEX, 16), (_B64URL, 64), (_PRINTABLE, 95)):
+        if chars <= alphabet:
+            return len(secret) * math.log2(size)
+    return 0.0
+
+
+def _digest(value: str) -> bytes:
+    return hashlib.sha256(value.encode("utf-8", errors="surrogatepass")).digest()
+
+
+class SharedSecretProvider(Provider):
+    """A bearer provider that knows one shared secret for a fixed set of routes."""
+
+    kind = "token"
+    name: ClassVar[str] = "drain"
+    display_name: ClassVar[str] = "Daemon drain (service token)"
+
+    def __init__(self, secret: str, routes: frozenset[str], *, principal: str = "drain") -> None:
+        if secret_bits(secret) < MIN_SECRET_BITS:
+            raise ValueError(f"the shared secret must carry at least {MIN_SECRET_BITS} bits")
+        self._digest = _digest(secret)
+        self._routes = routes
+        self._principal = principal
+
+    @property
+    def token_routes(self) -> frozenset[str]:
+        return self._routes
+
+    def verify_bearer(self, token: str, path: str) -> TokenPrincipal | None:
+        if path not in self._routes or not token:
+            return None
+        if hmac.compare_digest(_digest(token), self._digest):
+            return TokenPrincipal(principal=self._principal, provider=self.name)
+        return None
+
+
+def register_drain(registry: ProviderRegistry, env: Mapping[str, str]) -> Provider | None:
+    """The drain provider from ``INDUS_DASHBOARD_DRAIN_SECRET``; a weak secret disables its
+    route."""
+    secret = env.get(DRAIN_SECRET_ENV, "")
+    if not secret:
+        registry.unavailable("drain", f"{DRAIN_SECRET_ENV} is not set")
+        return None
+    try:
+        provider = SharedSecretProvider(secret, frozenset({DRAIN_ROUTE}))
+    except ValueError as exc:
+        registry.unavailable("drain", str(exc))
+        registry.disabled_routes.add(DRAIN_ROUTE)
+        return None
+    registry.register(provider)
+    return provider
+
+
+async def _answer(send: Send, status: int, payload: dict[str, str]) -> None:
+    body = json.dumps(payload).encode()
+    await send(
+        {
+            "type": "http.response.start",
+            "status": status,
+            "headers": [
+                (b"content-type", b"application/json"),
+                (b"content-length", str(len(body)).encode()),
+                (b"cache-control", b"no-store"),
+            ],
+        }
+    )
+    await send({"type": "http.response.body", "body": body})
+
+
+class BearerSeam:
+    """Outermost auth layer for opted-in bearer routes (see the module notes)."""
+
+    def __init__(self, app: ASGIApp, *, registry: ProviderRegistry, audit: AuditLog) -> None:
+        self.app = app
+        self.registry = registry
+        self.audit = audit
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        path: str = scope.get("path", "")
+        if path in self.registry.disabled_routes:
+            await _answer(send, 404, {"error": "not_found", "detail": "This route is disabled."})
+            return
+        if path not in self.registry.token_routes():
+            await self.app(scope, receive, send)
+            return
+        authorization = None
+        for name, value in scope.get("headers") or ():
+            if name.lower() == b"authorization":
+                authorization = value.decode("latin-1")
+        token = bearer_of(authorization)
+        unreachable = ""
+        for provider in self.registry.token_providers():
+            try:
+                principal = provider.verify_bearer(token, path)
+            except ProviderUnavailable:
+                unreachable = unreachable or provider.name
+                continue
+            if principal is not None:
+                state = scope.setdefault("state", {})
+                state[PRINCIPAL_KEY] = principal
+                await self.app(scope, receive, send)
+                return
+        self.audit.record(
+            AuditEvent.TOKEN_AUTH_FAILURE,
+            reason="provider_unreachable" if unreachable else "no_provider_accepted",
+            path=path,
+            ip=client_ip(scope),
+        )
+        if unreachable:
+            await _answer(send, 503, {"error": "unavailable", "detail": "Try again shortly."})
+            return
+        await _answer(
+            send, 401, {"error": "unauthenticated", "detail": "A service token is required."}
+        )
diff --git a/src/indus/web/auth/token.py b/src/indus/web/auth/token.py
new file mode 100644
index 0000000..4684f3c
--- /dev/null
+++ b/src/indus/web/auth/token.py
@@ -0,0 +1,102 @@
+"""The loopback session token (P18-02).
+
+In loopback mode the dashboard mints a 32-byte URL-safe random token when it starts, or takes the
+one the desktop shell minted and handed over in ``INDUS_DASHBOARD_SESSION_TOKEN`` (D-16.89). The
+token is injected into ``index.html`` (never in gated mode) and every ``/api`` request outside the
+public list carries it in ``X-Indus-Session-Token`` or ``Authorization: Bearer``. Comparison is
+constant time over SHA-256 digests, so neither content nor length leaks. A handed-over token must
+look like one we would mint (at least 32 URL-safe characters); anything else is refused at start.
+
+``SessionToken`` never shows its value in ``repr``/``str``.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import re
+import secrets
+from collections.abc import Mapping
+from typing import Final
+
+__all__ = [
+    "SESSION_HEADER",
+    "SESSION_TOKEN_ENV",
+    "SessionToken",
+    "SessionTokenError",
+    "bearer_of",
+]
+
+SESSION_TOKEN_ENV: Final = "INDUS_DASHBOARD_SESSION_TOKEN"
+SESSION_HEADER: Final = "X-Indus-Session-Token"
+TOKEN_BYTES: Final = 32
+MIN_HANDED_CHARS: Final = 32
+_SHAPE: Final = re.compile(r"^[A-Za-z0-9_-]{32,512}$")
+
+
+class SessionTokenError(ValueError):
+    """The handed-over token is not usable (too short or outside the URL-safe alphabet)."""
+
+
+def _digest(value: str) -> bytes:
+    return hashlib.sha256(value.encode("utf-8", errors="surrogatepass")).digest()
+
+
+def bearer_of(authorization: str | None) -> str:
+    """The token of an ``Authorization: Bearer <t>`` header (scheme case-insensitive), or ``""``."""
+    if not authorization:
+        return ""
+    scheme, _, rest = authorization.strip().partition(" ")
+    if scheme.lower() != "bearer":
+        return ""
+    return rest.strip()
+
+
+class SessionToken:
+    """One process's loopback token (see the module notes)."""
+
+    __slots__ = ("_digest", "_value", "handed_over")
+
+    def __init__(self, value: str, *, handed_over: bool = False) -> None:
+        if not _SHAPE.match(value):
+            raise SessionTokenError(
+                f"the dashboard session token must be at least {MIN_HANDED_CHARS} URL-safe "
+                "characters"
+            )
+        self._value = value
+        self._digest = _digest(value)
+        self.handed_over = handed_over
+
+    @classmethod
+    def mint(cls) -> SessionToken:
+        return cls(secrets.token_urlsafe(TOKEN_BYTES))
+
+    @classmethod
+    def from_env(cls, env: Mapping[str, str]) -> SessionToken:
+        """The handed-over token when the env carries one (``SessionTokenError`` when it is not
+        usable), else a fresh one."""
+        handed = env.get(SESSION_TOKEN_ENV, "")
+        if handed.strip():
+            return cls(handed.strip(), handed_over=True)
+        return cls.mint()
+
+    @property
+    def value(self) -> str:
+        """The secret itself: only for the index injection and a spawned child's env."""
+        return self._value
+
+    def matches(self, candidate: object) -> bool:
+        if not isinstance(candidate, str) or not candidate:
+            return False
+        return hmac.compare_digest(self._digest, _digest(candidate))
+
+    def carried_by(self, headers: Mapping[str, str]) -> bool:
+        """The header or a Bearer credential equals this token."""
+        return self.matches(headers.get(SESSION_HEADER.lower(), "")) or self.matches(
+            bearer_of(headers.get("authorization"))
+        )
+
+    def __repr__(self) -> str:
+        return "SessionToken(<hidden>)"
+
+    __str__ = __repr__
diff --git a/src/indus/web/command.py b/src/indus/web/command.py
