+    found: dict[str, list[str]] = {key: [] for key in _DASHBOARD_QUERY_KEYS}
+    if not isinstance(raw, bytes) or not raw:
+        return found
+    for key, value in parse_qsl(raw.decode("latin-1"), keep_blank_values=True):
+        if key in found:
+            found[key].append(value)
+    return found
