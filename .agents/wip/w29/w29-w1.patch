+    gated: bool,
+    book: TicketBook,
+    session_token: Callable[[str], bool],
+    host_origin_problem: str | None,
+    require_loopback_peer: bool,
+    internal: InternalCredential | None = None,
+    allow_internal: bool = False,
+    profile_id: str | None = None,
