index 0000000..e3c84e9
--- /dev/null
+++ b/src/indus/web/serve_runtime.py
@@ -0,0 +1,387 @@
+"""Records of running dashboard backends, and ``indus serve ensure`` / ``discover`` (P18-01).
+
+Two kinds of record, both JSON written atomically with mode 0600, removed by their owner on a
+clean exit:
+
+- ``<root>/dashboard.json`` — the machine's dashboard backend (one per machine root, it serves every
+  profile under it);
+- ``<home>/serve.json`` — a profile's headless backend (``indus serve``; the desktop shell's REST
+  side, D-16.89).
+
+A record proves nothing alone: a backend is live only when its pid is alive with the recorded start
+fingerprint **and** ``GET /api/health`` on its loopback URL answers with the same profile id.
+
+``discover(home)`` returns the live headless backend of a profile or None. ``ensure(home, env)``
+discovers one, or starts ``indus serve --port 0`` detached (double fork, own session, stdin from
+``/dev/null``, output appended to ``<home>/logs/serve-stdio.log``) and waits for its record and its
+health answer. A backend running another ``code_version`` than the caller is stopped (SIGTERM, a
+bounded wait) and replaced, once per call. The session token is the caller's: it travels to the
+child only through the environment (``INDUS_DASHBOARD_SESSION_TOKEN``) and is never printed —
+``Served.to_json`` is ``{url, port, pid, profile_id, code_version}``.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import logging
+import os
+import signal
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import asdict, dataclass
+from pathlib import Path
+from typing import Any, Final, Literal, cast
+
+import httpx
+
+from indus.foundation.fsio import FileLock, LockTimeout, atomic_write_json
+from indus.service.creation_policy import scrub_launch_env
+from indus.service.gateway_units import default_program
+from indus.service.ws_auth import stable_profile_id
+from indus.state import gateway_runtime
+
+__all__ = [
+    "DASHBOARD_RECORD",
+    "SERVE_RECORD",
+    "Served",
+    "ServerRecord",
+    "clear_record",
+    "dashboard_record_path",
+    "discover",
+    "ensure",
+    "health_probe",
+    "live_health",
+    "read_record",
+    "serve_record_path",
+    "url_for",
+    "write_record",
+]
+
+log = logging.getLogger(__name__)
+
+SERVE_RECORD: Final = "serve.json"
+SERVE_LOCK: Final = "serve.lock"
+DASHBOARD_RECORD: Final = "dashboard.json"
+STDIO_LOG: Final = "serve-stdio.log"
+DEFAULT_TIMEOUT_S: Final = 30.0
+_POLL_S: Final = 0.1
+_STOP_WAIT_S: Final = 10.0
+_LAUNCHER: Final = (
+    "import subprocess, sys\n"
+    "child = subprocess.Popen(sys.argv[1:], stdin=subprocess.DEVNULL, stdout=2, stderr=2,"
+    " start_new_session=True, close_fds=True)\n"
+    "sys.stdout.write(str(child.pid))\n"
+)
+
+type Mode = Literal["dashboard", "serve"]
+
+
+@dataclass(frozen=True)
+class ServerRecord:
+    pid: int
+    start_time: int | None
+    host: str
+    port: int
+    url: str
+    profile_id: str
+    profile: str
+    code_version: str
+    mode: str
+    started_at: float
+
+    @classmethod
+    def from_json(cls, data: object) -> ServerRecord | None:
+        if not isinstance(data, dict):
+            return None
+        raw = cast(dict[str, Any], data)
+        try:
+            pid = raw["pid"]
+            port = raw["port"]
+            if not isinstance(pid, int) or not isinstance(port, int) or pid <= 0:
+                return None
+            start = raw.get("start_time")
+            return cls(
+                pid=pid,
+                start_time=start if isinstance(start, int) else None,
+                host=str(raw["host"]),
+                port=port,
+                url=str(raw["url"]),
+                profile_id=str(raw["profile_id"]),
+                profile=str(raw.get("profile", "")),
+                code_version=str(raw.get("code_version", "")),
+                mode=str(raw.get("mode", "")),
+                started_at=float(raw.get("started_at", 0.0)),
+            )
+        except (KeyError, TypeError, ValueError):
+            return None
+
+
+def serve_record_path(home: Path) -> Path:
+    return home / SERVE_RECORD
+
+
+def dashboard_record_path(root: Path) -> Path:
+    return root / DASHBOARD_RECORD
+
+
+def url_for(host: str, port: int) -> str:
+    """A loopback-reachable URL for a bound address (all-interfaces binds answer on 127.0.0.1)."""
+    bare = host.strip("[]")
+    if bare in ("0.0.0.0", ""):
+        bare = "127.0.0.1"
+    elif bare == "::":
+        bare = "::1"
+    shown = f"[{bare}]" if ":" in bare else bare
+    return f"http://{shown}:{port}"
+
+
+def write_record(path: Path, record: ServerRecord) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write_json(path, asdict(record), sort_keys=True, mode=0o600, preserve_mode=False)
+
+
+def read_record(path: Path) -> ServerRecord | None:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return ServerRecord.from_json(data)
+
+
+def clear_record(path: Path, pid: int) -> None:
+    """Remove the record when it still names ``pid`` (never another process's)."""
+    found = read_record(path)
+    if found is not None and found.pid == pid:
+        with contextlib.suppress(OSError):
+            path.unlink()
+
+
+def new_record(
+    *, home: Path, profile: str, host: str, port: int, mode: Mode, code_version: str
+) -> ServerRecord:
+    pid = os.getpid()
+    return ServerRecord(
+        pid=pid,
+        start_time=gateway_runtime.process_start_time(pid),
+        host=host,
+        port=port,
+        url=url_for(host, port),
+        profile_id=stable_profile_id(home),
+        profile=profile,
+        code_version=code_version,
+        mode=mode,
+        started_at=time.time(),
+    )
+
+
+# -- liveness -------------------------------------------------------------------------------------
+
+
+def health_probe(url: str, *, timeout: float = 2.0) -> dict[str, Any] | None:
+    """``GET <url>/api/health`` on loopback (no proxy); the JSON answer or None."""
+    try:
+        with httpx.Client(timeout=timeout, trust_env=False) as client:
+            response = client.get(url.rstrip("/") + "/api/health")
+    except httpx.HTTPError:
+        return None
+    if response.status_code != 200:
+        return None
+    try:
+        data: Any = response.json()
+    except ValueError:
+        return None
+    return cast(dict[str, Any], data) if isinstance(data, dict) else None
+
+
+type Probe = Callable[[str], dict[str, Any] | None]
+type Alive = Callable[[int, int | None], bool]
+
+
+def live_health(
+    record: ServerRecord, *, probe: Probe = health_probe, alive: Alive = gateway_runtime.alive
+) -> dict[str, Any] | None:
+    """The health answer of the backend ``record`` names, or None when it is not that backend."""
+    if not alive(record.pid, record.start_time):
+        return None
+    answer = probe(record.url)
+    if answer is None or answer.get("profile_id") != record.profile_id:
+        return None
+    return answer
+
+
+@dataclass(frozen=True)
+class Served:
+    """A live headless backend (no credential in here)."""
+
+    url: str
+    port: int
+    pid: int
+    profile_id: str
+    code_version: str
+    started: bool = False
+    restarted: bool = False
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "url": self.url,
+            "port": self.port,
+            "pid": self.pid,
+            "profile_id": self.profile_id,
+            "code_version": self.code_version,
+        }
+
+
+def discover(
+    home: Path, *, probe: Probe = health_probe, alive: Alive = gateway_runtime.alive
+) -> Served | None:
+    record = read_record(serve_record_path(home))
+    if record is None or record.profile_id != stable_profile_id(home):
+        return None
+    answer = live_health(record, probe=probe, alive=alive)
+    if answer is None:
+        return None
+    version = answer.get("code_version")
+    return Served(
+        url=record.url,
+        port=record.port,
+        pid=record.pid,
+        profile_id=record.profile_id,
+        code_version=version if isinstance(version, str) else record.code_version,
+    )
+
+
+# -- ensure ---------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class EnsureFailed:
+    reason: str
+    detail: str
+
+    def to_json(self) -> dict[str, Any]:
+        return {"state": "failed", "reason": self.reason, "detail": self.detail}
+
+
+def _wait(seconds: float) -> None:
+    threading.Event().wait(max(0.0, seconds))
+
+
+def serve_argv() -> list[str]:
+    return [*default_program(), "serve", "--port", "0"]
+
+
+def spawn_detached(home: Path, env: Mapping[str, str], argv: Sequence[str]) -> int:
+    """Start ``argv`` detached for ``home``; the server's pid."""
+    child_env = scrub_launch_env(env)
+    child_env["INDUS_HOME"] = str(home)
+    logs = home / "logs"
+    logs.mkdir(parents=True, exist_ok=True)
+    with open(logs / STDIO_LOG, "ab") as out:
+        launcher = subprocess.Popen(
+            [sys.executable, "-I", "-c", _LAUNCHER, *argv],
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+            stderr=out,
+            cwd=str(home),
+            env=child_env,
+            start_new_session=True,
+            close_fds=True,
+        )
+    try:
+        printed, _ = launcher.communicate(timeout=10.0)
+    except subprocess.TimeoutExpired:
+        launcher.kill()
+        launcher.communicate()
+        raise
+    text = printed.decode("ascii", errors="replace").strip()
+    if launcher.returncode != 0 or not text.isdigit():
+        raise OSError(f"the launcher failed (exit {launcher.returncode})")
+    return int(text)
+
+
+def _terminate(pid: int) -> None:
+    with contextlib.suppress(ProcessLookupError, PermissionError):
+        os.kill(pid, signal.SIGTERM)
+
+
+def ensure(
+    home: Path,
+    env: Mapping[str, str],
+    *,
+    timeout: float = DEFAULT_TIMEOUT_S,
+    **kwargs: Any,
+) -> Served | EnsureFailed:
+    """Discover the profile's headless backend or start one (see the module notes). Concurrent
+    calls for one home are serialised by ``<home>/serve.lock``, so two callers start one backend."""
+    try:
+        with FileLock(home / SERVE_LOCK, timeout=timeout + _STOP_WAIT_S):
+            return _ensure(home, env, timeout=timeout, **kwargs)
+    except LockTimeout:
+        return EnsureFailed("busy", "another caller is starting the backend")
+
+
+def _ensure(
+    home: Path,
+    env: Mapping[str, str],
+    *,
+    version: str | None = None,
+    timeout: float = DEFAULT_TIMEOUT_S,
+    argv: Sequence[str] | None = None,
+    spawn: Callable[[Path, Mapping[str, str], Sequence[str]], int] = spawn_detached,
+    terminate: Callable[[int], None] = _terminate,
+    probe: Probe = health_probe,
+    alive: Alive = gateway_runtime.alive,
+    monotonic: Callable[[], float] = time.monotonic,
+    pause: Callable[[float], None] = _wait,
+) -> Served | EnsureFailed:
+    if version is None:
+        import indus
+
+        version = indus.__version__
+    deadline = monotonic() + max(0.0, timeout)
+    found = discover(home, probe=probe, alive=alive)
+    restarted = False
+    if found is not None and found.code_version == version:
+        return found
+    if found is not None:
+        log.info(
+            "the headless backend runs version %s, not %s: restarting it",
+            found.code_version,
+            version,
+        )
+        record = read_record(serve_record_path(home))
+        terminate(found.pid)
+        stop_by = monotonic() + _STOP_WAIT_S
+        start_time = record.start_time if record is not None else None
+        while alive(found.pid, start_time):
+            if monotonic() >= stop_by:
+                return EnsureFailed("restart_timeout", f"pid {found.pid} did not stop in time")
+            pause(_POLL_S)
+        restarted = True
+    try:
+        pid = spawn(home, env, list(argv) if argv is not None else serve_argv())
+    except (OSError, ValueError, subprocess.SubprocessError) as exc:
+        return EnsureFailed("spawn_failed", f"could not start the backend: {exc}")
+    while True:
+        found = discover(home, probe=probe, alive=alive)
+        if found is not None and found.pid == pid:
+            return Served(
+                url=found.url,
+                port=found.port,
+                pid=found.pid,
+                profile_id=found.profile_id,
+                code_version=found.code_version,
+                started=True,
+                restarted=restarted,
+            )
+        if not gateway_runtime.pid_alive(pid) and spawn is spawn_detached:
+            return EnsureFailed(
+                "exited", f"the backend exited before it answered; see {home / 'logs' / STDIO_LOG}"
+            )
+        if monotonic() >= deadline:
+            return EnsureFailed("timeout", "the backend did not answer in time")
+        pause(_POLL_S)
diff --git a/src/indus/web/spa.py b/src/indus/web/spa.py
new file mode 100644
index 0000000..9b05d18
--- /dev/null
+++ b/src/indus/web/spa.py
@@ -0,0 +1,332 @@
+"""Serving the built SPA, and building it on first launch (P18-01, R09.5).
+
+``mount_spa(app, state)`` adds the routes that must come after every API router:
+
+- ``/api`` and ``/api/...`` with any method → JSON 404 naming the path (a missing endpoint is never
+  answered with HTML, which would break JSON clients);
+- serve mode (headless): every other path → JSON 404 as well; no HTML, no assets, even when a
+  bundle is on disk;
+- dashboard mode: ``/assets/<file>`` from the bundle's ``assets`` dir, marked immutable (the names
+  carry content hashes; CSS is rewritten under a proxy prefix and varies on it); any other GET →
+  the file when it resolves inside the bundle, else ``index.html`` (client-side routes) with the
+  bootstrap script injected and ``Cache-Control: no-store`` so a reload always sees the current
+  session token.
+
+Paths with ``..`` segments, backslashes or NUL (also percent-encoded) are refused with a JSON 404,
+and a file is served only when its resolved path stays inside the bundle directory. A missing
+bundle (or ``index.html``) answers a JSON 404 naming the build command on every request, so a build
+that appears while the process runs is picked up without a restart.
+
+Bootstrap: one inline ``<script>`` before ``</head>`` sets ``__INDUS_SESSION_TOKEN__`` (loopback
+mode only), ``__INDUS_BASE_PATH__``, ``__INDUS_AUTH_REQUIRED__``,
+``__INDUS_DASHBOARD_EMBEDDED_CHAT__``, ``__INDUS_INITIAL_PROFILE__`` and
+``__INDUS_DASHBOARD_PROFILE__``. Values are JSON with ``<``, ``>``,
+``&`` and the two JavaScript line separators escaped, so no value can close the script. The active
+theme's first-paint CSS goes in just before it.
+
+``BuildPlan``: when the bundle is missing in a source checkout (``apps/web/package.json``) and
+``pnpm`` is on PATH, the dashboard builds once before serving: ``pnpm --filter @indus/web build``
+with the Node heap capped at half the cgroup memory limit (at most 4 GiB, at least 512 MiB) and
+``UV_THREADPOOL_SIZE`` at half the cores.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import shutil
+import subprocess
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Final
+
+from fastapi import FastAPI, Request
+from fastapi.responses import FileResponse, HTMLResponse, JSONResponse, Response
+
+from indus.web.auth.gate import request_prefix
+from indus.web.prefix import rewrite_css, rewrite_index_html
+from indus.web.state import DashboardState
+
+__all__ = [
+    "BUILD_COMMAND",
+    "IMMUTABLE",
+    "NO_STORE",
+    "BuildPlan",
+    "SpaBundle",
+    "bootstrap_script",
+    "build_plan",
+    "default_bundle_dir",
+    "mount_spa",
+    "run_build",
+    "theme_css",
+]
+
+log = logging.getLogger(__name__)
+
+BUILD_COMMAND: Final = "pnpm --filter @indus/web build"
+IMMUTABLE: Final = "public, max-age=31536000, immutable"
+NO_STORE: Final = "no-store"
+_ALL_METHODS: Final = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
+_THEMES: Final[dict[str, tuple[str, str, str]]] = {
+    "light": ("light", "#f7f7f5", "#1d1d1b"),
+    "dark": ("dark", "#141413", "#ececea"),
+}
+MIN_HEAP_MIB: Final = 512
+MAX_HEAP_MIB: Final = 4096
+
+
+def default_bundle_dir() -> Path:
+    """Where a release build puts the SPA (P18-29 owns the full locator)."""
+    return Path(__file__).resolve().parent / "static"
+
+
+@dataclass(frozen=True, slots=True)
+class SpaBundle:
+    """The built SPA's directory (it may not exist yet)."""
+
+    directory: Path
+
+    @property
+    def index(self) -> Path:
+        return self.directory / "index.html"
+
+    def inside(self, relative: str) -> Path | None:
+        """The file at ``relative`` when it is safely inside the bundle, else None."""
+        if not relative or "\\" in relative or "\x00" in relative:
+            return None
+        parts = relative.split("/")
+        if any(part in ("..", ".") for part in parts):
+            return None
+        try:
+            root = self.directory.resolve(strict=True)
+            target = (self.directory / relative).resolve(strict=True)
+        except (OSError, RuntimeError):
+            return None
+        if not target.is_relative_to(root) or not target.is_file():
+            return None
+        return target
+
+
+def _js(value: object) -> str:
+    text = json.dumps(value, ensure_ascii=False)
+    for raw, escaped in (
+        ("<", "\\u003c"),
+        (">", "\\u003e"),
+        ("&", "\\u0026"),
+        (" ", "\\u2028"),
+        (" ", "\\u2029"),
+    ):
+        text = text.replace(raw, escaped)
+    return text
+
+
+def bootstrap_script(state: DashboardState, prefix: str) -> str:
+    """The inline script with the runtime globals (see the module notes)."""
+    lines: list[str] = []
+    if not state.gated:
+        lines.append(f"window.__INDUS_SESSION_TOKEN__={_js(state.auth.token.value)};")
+    lines.extend(
+        [
+            f"window.__INDUS_BASE_PATH__={_js(prefix)};",
+            f"window.__INDUS_AUTH_REQUIRED__={_js(state.gated)};",
+            f"window.__INDUS_DASHBOARD_EMBEDDED_CHAT__={_js(state.embedded_chat)};",
+            f"window.__INDUS_INITIAL_PROFILE__={_js(state.initial_profile)};",
+            f"window.__INDUS_DASHBOARD_PROFILE__={_js(state.profile_name)};",
+        ]
+    )
+    return "<script>" + "".join(lines) + "</script>"
+
+
+def theme_css(theme: str) -> str:
+    """First-paint CSS for our light/dark pair; ``system`` follows the OS."""
+    found = _THEMES.get(theme)
+    if found is None:
+        light, dark = _THEMES["light"], _THEMES["dark"]
+        return (
+            '<style id="indus-theme-bootstrap">:root{color-scheme:light dark}'
+            f"html,body{{background:{light[1]};color:{light[2]}}}"
+            "@media (prefers-color-scheme: dark){"
+            f"html,body{{background:{dark[1]};color:{dark[2]}}}}}</style>"
+        )
+    scheme, background, foreground = found
+    return (
+        f'<style id="indus-theme-bootstrap">:root{{color-scheme:{scheme}}}'
+        f"html,body{{background:{background};color:{foreground}}}</style>"
+    )
+
+
+def _not_built(where: str) -> JSONResponse:
+    return JSONResponse(
+        {
+            "error": "not_built",
+            "detail": f"The dashboard has not been built ({where} is missing).",
+            "build": BUILD_COMMAND,
+        },
+        status_code=404,
+        headers={"cache-control": NO_STORE},
+    )
+
+
+def _not_found(path: str) -> JSONResponse:
+    return JSONResponse(
+        {"error": "not_found", "detail": f"No route answers {path}."},
+        status_code=404,
+        headers={"cache-control": NO_STORE},
+    )
+
+
+def _index(state: DashboardState, bundle: SpaBundle, request: Request) -> Response:
+    try:
+        text = bundle.index.read_text(encoding="utf-8-sig")
+    except OSError:
+        return _not_built("index.html")
+    prefix = request_prefix(request.scope)
+    text = rewrite_index_html(text, prefix)
+    head = theme_css(state.theme) + bootstrap_script(state, prefix)
+    text = text.replace("</head>", head + "</head>", 1) if "</head>" in text else head + text
+    return HTMLResponse(text, headers={"cache-control": NO_STORE})
+
+
+def mount_spa(app: FastAPI, state: DashboardState) -> None:
+    """Add the catch-all routes (call after every API router is included)."""
+
+    @app.api_route("/api", methods=_ALL_METHODS, include_in_schema=False)
+    @app.api_route("/api/{rest:path}", methods=_ALL_METHODS, include_in_schema=False)
+    async def unknown_api(request: Request) -> Response:  # pyright: ignore[reportUnusedFunction]
+        return _not_found(request.url.path)
+
+    if state.mode == "serve" or not isinstance(state.bundle, SpaBundle):
+
+        @app.api_route("/{rest:path}", methods=_ALL_METHODS, include_in_schema=False)
+        async def headless(request: Request) -> Response:  # pyright: ignore[reportUnusedFunction]
+            return JSONResponse(
+                {
+                    "error": "not_found",
+                    "detail": "This is the headless backend (indus serve): no web pages here.",
+                },
+                status_code=404,
+                headers={"cache-control": NO_STORE},
+            )
+
+        return
+
+    bundle: SpaBundle = state.bundle
+
+    @app.get("/assets/{name:path}", include_in_schema=False)
+    async def asset(name: str, request: Request) -> Response:  # pyright: ignore[reportUnusedFunction]
+        if not bundle.directory.is_dir():
+            return _not_built("the bundle directory")
+        found = bundle.inside(f"assets/{name}")
+        if found is None:
+            return _not_found(request.url.path)
+        if found.suffix == ".css":
+            prefix = request_prefix(request.scope)
+            css = rewrite_css(found.read_text(encoding="utf-8-sig"), prefix)
+            return Response(
+                css,
+                media_type="text/css",
+                headers={"cache-control": IMMUTABLE, "vary": "X-Forwarded-Prefix"},
+            )
+        return FileResponse(found, headers={"cache-control": IMMUTABLE})
+
+    @app.get("/{rest:path}", include_in_schema=False)
+    async def page(rest: str, request: Request) -> Response:  # pyright: ignore[reportUnusedFunction]
+        if rest and ("\\" in rest or "\x00" in rest or ".." in rest.split("/")):
+            return _not_found(request.url.path)
+        if not bundle.directory.is_dir():
+            return _not_built("the bundle directory")
+        if rest and rest != "index.html":
+            found = bundle.inside(rest)
+            if found is not None:
+                return FileResponse(found, headers={"cache-control": "no-cache"})
+        return _index(state, bundle, request)
+
+    @app.api_route(
+        "/{rest:path}",
+        methods=["POST", "PUT", "PATCH", "DELETE"],
+        include_in_schema=False,
+    )
+    async def no_page(request: Request) -> Response:  # pyright: ignore[reportUnusedFunction]
+        return _not_found(request.url.path)
+
+
+# -- building on first launch ---------------------------------------------------------------------
+
+
+@dataclass(frozen=True, slots=True)
+class BuildPlan:
+    argv: tuple[str, ...]
+    cwd: Path
+    env: dict[str, str]
+    heap_mib: int
+    threads: int
+
+
+def cgroup_memory_bytes(root: Path = Path("/sys/fs/cgroup")) -> int | None:
+    """The cgroup memory limit (v2 ``memory.max``, else v1), or None when unlimited/unknown."""
+    for candidate in (root / "memory.max", root / "memory" / "memory.limit_in_bytes"):
+        try:
+            text = candidate.read_text(encoding="ascii").strip()
+        except OSError:
+            continue
+        if text.isdigit():
+            value = int(text)
+            if 0 < value < 1 << 60:
+                return value
+        return None
+    return None
+
+
+def heap_mib(limit_bytes: int | None) -> int:
+    if limit_bytes is None:
+        return MAX_HEAP_MIB
+    half = limit_bytes // 2 // (1024 * 1024)
+    return max(MIN_HEAP_MIB, min(MAX_HEAP_MIB, half))
+
+
+def build_plan(
+    repo_root: Path,
+    env: Mapping[str, str],
+    *,
+    which: Callable[[str], str | None] = shutil.which,
+    memory_limit: Callable[[], int | None] = cgroup_memory_bytes,
+    cpu_count: Callable[[], int | None] = os.cpu_count,
+) -> BuildPlan | None:
+    """How to build the SPA here, or None (not a source checkout, or no ``pnpm``)."""
+    if not (repo_root / "apps" / "web" / "package.json").is_file():
+        return None
+    pnpm = which("pnpm")
+    if not pnpm:
+        return None
+    heap = heap_mib(memory_limit())
+    threads = max(1, (cpu_count() or 2) // 2)
+    child_env = dict(env)
+    options = child_env.get("NODE_OPTIONS", "")
+    child_env["NODE_OPTIONS"] = f"{options} --max-old-space-size={heap}".strip()
+    child_env["UV_THREADPOOL_SIZE"] = str(threads)
+    return BuildPlan(
+        argv=(pnpm, "--filter", "@indus/web", "build"),
+        cwd=repo_root,
+        env=child_env,
+        heap_mib=heap,
+        threads=threads,
+    )
+
+
+def run_build(
+    plan: BuildPlan,
+    *,
+    runner: Callable[..., Any] = subprocess.run,
+    timeout: float = 900.0,
+) -> bool:
+    """Run the build; True when it exited 0."""
+    log.info("building the dashboard (heap %d MiB, %d threads)", plan.heap_mib, plan.threads)
+    argv: Sequence[str] = list(plan.argv)
+    try:
+        done = runner(argv, cwd=str(plan.cwd), env=plan.env, timeout=timeout, check=False)
+    except (OSError, subprocess.SubprocessError) as exc:
+        log.warning("the dashboard build could not run: %s", exc)
+        return False
+    return getattr(done, "returncode", 1) == 0
diff --git a/src/indus/web/state.py b/src/indus/web/state.py
new file mode 100644
index 0000000..9cf49fd
--- /dev/null
+++ b/src/indus/web/state.py
@@ -0,0 +1,108 @@
+"""The dashboard's per-app state (``app.state.indus``), shared by the app factory, the gates, the
+WebSocket helper and the routes.
+
+It holds what one dashboard process decided at start: the mode, the auth context (gate mode,
+session token, providers, signer, audit log, Host rules), the WebSocket ticket book and internal
+credential, which WebSocket features are on, the profile it serves and the machine root, the bound
+address, the public origin and trusted proxies, the SPA bundle and the daemon link. Routes read it
+through ``dashboard_state(app)`` and nothing else (no globals).
+
+``resolve_profile`` is the small name → home lookup the ticket route and the WebSocket helper need
+(``""`` = this backend's own profile); P18-10's per-request ``Scope`` builds on the same rules.
+"""
+
+from __future__ import annotations
+
+import threading
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation.errors import InvalidProfileId
+from indus.foundation.profiles import DEFAULT_PROFILE, is_live, normalize_id, profile_home
+from indus.service.ws_auth import InternalCredential, TicketBook, stable_profile_id
+from indus.web.auth.gate import AuthContext
+from indus.web.auth.proxy import PublicOrigin, TrustedProxies
+
+__all__ = ["DashboardState", "Mode", "ProfileRef", "dashboard_state"]
+
+type Mode = Literal["dashboard", "serve"]
+
+
+@dataclass(frozen=True, slots=True)
+class ProfileRef:
+    """A live profile: its id (name), home and the stable hash ticket books bind to."""
+
+    name: str
+    home: Path
+    stable_id: str
+
+
+@dataclass
+class DashboardState:
+    mode: Mode
+    auth: AuthContext
+    tickets: TicketBook
+    internal: InternalCredential
+    home: Path
+    root: Path
+    profile_name: str
+    bound_host: str
+    port: int
+    public: PublicOrigin | None = None
+    proxies: TrustedProxies = field(default_factory=TrustedProxies)
+    embedded_chat: bool = True
+    console_enabled: bool = False
+    initial_profile: str = ""
+    theme: str = "system"
+    bundle: Any = None
+    """The SPA bundle (``spa.SpaBundle``) in dashboard mode, None in serve mode."""
+    daemon: Any = None
+    """The daemon link (``app.DaemonLink``) when the process attaches to the profile daemon."""
+    code_version: str = ""
+    extras: dict[str, Any] = field(default_factory=dict[str, Any])
+    _lock: threading.Lock = field(default_factory=threading.Lock, repr=False)
+
+    @property
+    def gated(self) -> bool:
+        return self.auth.gated
+
+    @property
+    def stable_id(self) -> str:
+        return stable_profile_id(self.home)
+
+    def feature_enabled(self, purpose: str) -> bool:
+        """Is the WebSocket feature behind ``purpose`` on?"""
+        if purpose == "web-console":
+            return self.console_enabled
+        return self.embedded_chat
+
+    def resolve_profile(self, name: str | None) -> ProfileRef | None:
+        """``""``/None → this backend's profile; a live profile name → its ref; else None."""
+        if not name:
+            return ProfileRef(self.profile_name, self.home, self.stable_id)
+        try:
+            pid = normalize_id(name)
+        except InvalidProfileId:
+            return None
+        if pid == self.profile_name:
+            return ProfileRef(self.profile_name, self.home, self.stable_id)
+        if not is_live(self.root, pid):
+            return None
+        home = profile_home(self.root, pid)
+        return ProfileRef(pid, home, stable_profile_id(home))
+
+    def own_profile_label(self) -> str:
+        return self.profile_name or DEFAULT_PROFILE
+
+
+def dashboard_state(app: Any) -> DashboardState:
+    """The state ``create_app`` stored on ``app`` (``RuntimeError`` when it is missing)."""
+    state: object = getattr(getattr(app, "state", None), "indus", None)
+    if not isinstance(state, DashboardState):
+        raise RuntimeError("this app was not built by indus.web.app.create_app")
+    return state
+
+
+StateFactory = Callable[[], DashboardState]
