+``create_app`` (``indus.web.app``) builds the FastAPI app; ``indus dashboard`` and ``indus serve``
+(``indus.cli.commands.dashboard``) run it. Names are loaded lazily so importing a submodule (the
+WebSocket helper, a route module) does not import the whole app.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+if TYPE_CHECKING:
+    from indus.web.app import AppOptions, create_app
+
+__all__ = ["AppOptions", "create_app"]
+
+
+def __getattr__(name: str) -> Any:
+    if name in __all__:
+        from indus.web import app
+
+        return getattr(app, name)
+    raise AttributeError(name)
