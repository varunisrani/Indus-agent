index 0000000..bc9fca8
--- /dev/null
+++ b/src/indus/web/scope.py
@@ -0,0 +1,230 @@
+"""The profile a dashboard request acts on (P18-10, R09.20).
+
+One backend serves every profile under the machine's root. A request names its profile with
+``?profile=<name>``; ``ProfileScopes.resolve`` turns that into a full ``Scope`` — the profile's
+home, its ``.env``-aware env view, its config view and its secret store — built the same way the
+process scope is (``foundation.bootstrap.attach_profile_state``). Nothing is created by a lookup:
+an unknown, invalid or deleted profile is ``ProfileUnknown`` (404 at the HTTP layer), never a new
+directory (R04.25).
+
+Two FastAPI dependencies are the only way a route gets its scope (route modules never read the
+home or the process env themselves, architecture rule 4):
+
+- ``read_scope``: the named profile, else the backend's own;
+- ``write_scope``: the same, except that on a host with more than one profile a request that names
+  none is refused with 400 ``profile_required`` — an unnamed write would land on whichever profile
+  the backend happened to start with. Every write or destructive route depends on it;
+  ``unscoped_write_routes(app)`` lists the ones that do not (the route-introspection check).
+
+``install(app, scopes)`` puts the resolver on ``app.state``; WebSocket routes call
+``ProfileScopes.resolve`` themselves (a socket cannot answer 404).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping
+from pathlib import Path
+from typing import Any, Final
+
+from fastapi import FastAPI, HTTPException
+from fastapi.routing import APIRoute
+from starlette.requests import HTTPConnection
+
+from indus.foundation.bootstrap import attach_profile_state
+from indus.foundation.envload import build_env
+from indus.foundation.errors import InvalidProfileId
+from indus.foundation.home import HOME_ENV
+from indus.foundation.profiles import (
+    is_live,
+    list_profiles,
+    normalize_id,
+    profile_home,
+    profile_id_of,
+)
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "PROFILE_PARAM",
+    "STATE_KEY",
+    "WRITE_METHODS",
+    "ProfileRequired",
+    "ProfileScopes",
+    "ProfileUnknown",
+    "build_profile_scope",
+    "install",
+    "read_scope",
+    "scopes_of",
+    "unscoped_write_routes",
+    "write_scope",
+]
+
+PROFILE_PARAM: Final = "profile"
+STATE_KEY: Final = "profile_scopes"
+WRITE_METHODS: Final = frozenset({"POST", "PUT", "PATCH", "DELETE"})
+
+
+class ProfileUnknown(LookupError):
+    """No live profile has this name (or the name is not a profile id)."""
+
+    def __init__(self, name: str | None) -> None:
+        super().__init__("no such profile")
+        self.name = name
+
+
+class ProfileRequired(ValueError):
+    """A write on a multi-profile host named no profile."""
+
+    def __init__(self) -> None:
+        super().__init__("this backend serves several profiles: name the profile to change")
+
+
+def build_profile_scope(base: Scope, home: Path) -> Scope:
+    """A full scope for another profile at ``home``: the backend's inherited process env with
+    ``INDUS_HOME`` pinned there, that profile's ``.env``, config and secret store."""
+    inherited = dict(base.env.base)
+    inherited[HOME_ENV] = str(home)
+    draft = Scope(
+        profile_id=profile_id_of(home),
+        home=home,
+        root=base.root,
+        env=build_env(home, inherited),
+        clock=base.clock,
+        routed=True,
+    )
+    return attach_profile_state(draft, inherited)
+
+
+def _same_dir(a: Path, b: Path) -> bool:
+    if a == b:
+        return True
+    try:
+        return a.resolve(strict=False) == b.resolve(strict=False)
+    except OSError:
+        return False
+
+
+class ProfileScopes:
+    """Resolves ``?profile=`` names to scopes for one backend whose own scope is ``base``."""
+
+    def __init__(
+        self,
+        base: Scope,
+        *,
+        build: Callable[[Scope, Path], Scope] = build_profile_scope,
+    ) -> None:
+        self.base = base
+        self._build = build
+
+    def profiles(self) -> list[str]:
+        """The live profiles under the root, ``default`` first."""
+        return list_profiles(self.base.root)
+
+    def is_multi(self) -> bool:
+        """More than one profile lives under the root (read now, not at start)."""
+        return len(self.profiles()) > 1
+
+    def resolve(self, name: str | None) -> Scope:
+        """The scope ``name`` refers to (blank: the backend's own). ``ProfileUnknown`` otherwise."""
+        text = (name or "").strip()
+        if not text:
+            return self.base
+        try:
+            profile = normalize_id(text)
+        except InvalidProfileId:
+            raise ProfileUnknown(None) from None
+        try:
+            live = is_live(self.base.root, profile)
+        except (InvalidProfileId, OSError):
+            live = False
+        if not live:
+            raise ProfileUnknown(profile)
+        home = profile_home(self.base.root, profile)
+        if _same_dir(home, self.base.home):
+            return self.base
+        return self._build(self.base, home)
+
+    def resolve_for_write(self, name: str | None) -> Scope:
+        """``resolve``, refusing an unnamed write on a multi-profile host."""
+        if not (name or "").strip() and self.is_multi():
+            raise ProfileRequired()
+        return self.resolve(name)
+
+
+def install(app: FastAPI, scopes: ProfileScopes) -> None:
+    """Make ``scopes`` the resolver of ``app``'s requests."""
+    setattr(app.state, STATE_KEY, scopes)
+
+
+def scopes_of(connection: HTTPConnection) -> ProfileScopes:
+    found: object = getattr(connection.app.state, STATE_KEY, None)
+    if not isinstance(found, ProfileScopes):
+        raise RuntimeError("the dashboard app has no profile resolver installed")
+    return found
+
+
+def _named(connection: HTTPConnection) -> str | None:
+    return connection.query_params.get(PROFILE_PARAM)
+
+
+def _not_found(exc: ProfileUnknown) -> HTTPException:
+    detail: dict[str, Any] = {"error": "profile_not_found", "message": "No such profile."}
+    if exc.name is not None:
+        detail["profile"] = exc.name
+    return HTTPException(status_code=404, detail=detail)
+
+
+def read_scope(request: HTTPConnection) -> Scope:
+    """Dependency: the scope of a read (the backend's own profile unless one is named)."""
+    try:
+        return scopes_of(request).resolve(_named(request))
+    except ProfileUnknown as exc:
+        raise _not_found(exc) from None
+
+
+def write_scope(request: HTTPConnection) -> Scope:
+    """Dependency: the scope of a write or destructive call (see the module notes)."""
+    try:
+        return scopes_of(request).resolve_for_write(_named(request))
+    except ProfileRequired:
+        raise HTTPException(
+            status_code=400,
+            detail={
+                "error": "profile_required",
+                "message": "This backend serves several profiles: add ?profile=<name> to say "
+                "which one to change.",
+            },
+        ) from None
+    except ProfileUnknown as exc:
+        raise _not_found(exc) from None
+
+
+def _depends_on(dependant: Any, target: Callable[..., object], seen: set[int]) -> bool:
+    if id(dependant) in seen:
+        return False
+    seen.add(id(dependant))
+    if getattr(dependant, "call", None) is target:
+        return True
+    children: Iterable[Any] = getattr(dependant, "dependencies", ()) or ()
+    return any(_depends_on(child, target, seen) for child in children)
+
+
+def unscoped_write_routes(app: FastAPI, *, methods: Iterable[str] = WRITE_METHODS) -> list[str]:
+    """``"METHOD /path"`` of every write route of ``app`` that does not depend on
+    ``write_scope`` (empty when every write route is scoped)."""
+    wanted = {m.upper() for m in methods}
+    missing: list[str] = []
+    for route in app.routes:
+        if not isinstance(route, APIRoute):
+            continue
+        writes = sorted(wanted & {m.upper() for m in (route.methods or set())})
+        if not writes:
+            continue
+        if _depends_on(route.dependant, write_scope, set()):
+            continue
+        missing.extend(f"{method} {route.path}" for method in writes)
+    return missing
+
+
+def query_profile(params: Mapping[str, str]) -> str | None:
+    """The ``profile`` named in query ``params`` (for WebSocket routes)."""
+    return params.get(PROFILE_PARAM)
diff --git a/src/indus/web/ws/chat_gate.py b/src/indus/web/ws/chat_gate.py
new file mode 100644
index 0000000..b5bc10b
--- /dev/null
+++ b/src/indus/web/ws/chat_gate.py
@@ -0,0 +1,82 @@
+"""What the Chat tab's WebSocket routes need from the dashboard's one WebSocket gate (P18-06).
+
+Every dashboard WebSocket is accepted only through the shared gate: ``await gate(websocket,
+purpose)`` runs the pre-accept checks in order (feature enabled → 4404, credential → 4401,
+Host/Origin → 4403, peer → 4408) and either accepts the socket and returns the identity the
+credential proved, or closes it and returns None. The identity is the only authority a route has
+about who is calling — nothing in a frame or a query can claim one. ``credential`` says which kind
+proved it: ``token`` (the loopback session token), ``ticket`` (a single-use ticket minted over a
+logged-in session) or ``internal`` (the process-lifetime credential of a client the server itself
+spawned — the TUI child publishing its events; never handed to a browser).
+
+``SidecarLink`` is how the PTY route tells the TUI child where to publish: the loopback base URL
+of this server (``ws://127.0.0.1:<port>``, no credential in it) and the internal credential, which
+travels in its own environment variable.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from typing import Final, Protocol
+from urllib.parse import quote
+
+from starlette.websockets import WebSocket
+
+__all__ = [
+    "INTERNAL",
+    "PURPOSE_EVENTS",
+    "PURPOSE_PTY",
+    "PURPOSE_RPC",
+    "SidecarLink",
+    "WsGate",
+    "WsIdentity",
+    "purpose_of",
+]
+
+PURPOSE_PTY: Final = "web-pty"
+PURPOSE_EVENTS: Final = "web-events"
+PURPOSE_RPC: Final = "web-rpc"
+INTERNAL: Final = "internal"
+_PURPOSE_ATTR: Final = "__indus_ws_purpose__"
+
+
+class WsIdentity(Protocol):
+    """Who a gated socket belongs to."""
+
+    @property
+    def credential(self) -> str: ...
+
+    @property
+    def user_id(self) -> str | None: ...
+
+
+class WsGate(Protocol):
+    """The shared WebSocket gate (see the module notes)."""
+
+    async def __call__(self, websocket: WebSocket, purpose: str) -> WsIdentity | None: ...
+
+
+def mark_purpose[T](endpoint: T, purpose: str) -> T:
+    """Tag a WebSocket endpoint with the gate purpose it passes (route enumeration checks it)."""
+    setattr(endpoint, _PURPOSE_ATTR, purpose)
+    return endpoint
+
+
+def purpose_of(endpoint: object) -> str | None:
+    found: object = getattr(endpoint, _PURPOSE_ATTR, None)
+    return found if isinstance(found, str) else None
+
+
+@dataclass(frozen=True)
+class SidecarLink:
+    """Where the TUI child publishes its events (see the module notes)."""
+
+    base_url: Callable[[], str | None]
+    credential: Callable[[], str] = field(repr=False)
+
+    def publish_url(self, channel: str) -> str | None:
+        base = self.base_url()
+        if not base:
+            return None
+        return f"{base.rstrip('/')}/api/pub?channel={quote(channel, safe='')}"
diff --git a/src/indus/web/ws/events_fanout.py b/src/indus/web/ws/events_fanout.py
new file mode 100644
index 0000000..d77a368
--- /dev/null
+++ b/src/indus/web/ws/events_fanout.py
@@ -0,0 +1,207 @@
+"""``/api/pub`` and ``/api/events``: the Chat tab's event feed (P18-09).
+
+The TUI child (started by ``/api/pty`` with the publish URL and the internal credential) opens
+``/api/pub?channel=<id>`` and sends every event it sees as one text frame. The backend hands each
+frame to every ``/api/events?channel=<id>`` subscriber of that channel — the right rail's feed —
+without touching the TUI's own terminal stream.
+
+Both pass the shared gate with purpose ``web-events``. Publishing is for the server-spawned child
+only: a socket whose identity is not the internal credential is closed 4401, so a browser cannot
+put events into anyone's feed. A missing or invalid channel closes 4400. Publisher frames must be
+text (binary closes 1003) of at most 1 MiB (else 1009).
+
+Subscribers never speak: whatever they send is read and dropped. Each subscriber has its own queue
+of at most 256 frames and its own writer, so a slow tab never holds up the publisher or the other
+tabs; one that falls that far behind is closed 1013 and reconnects. A channel whose last subscriber
+left is dropped.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+from collections.abc import Awaitable, Callable
+from typing import Final
+
+from starlette.websockets import WebSocket, WebSocketDisconnect
+
+from indus.web.pty.channels import valid_channel
+from indus.web.pty.registry import close_quietly
+from indus.web.ws.chat_gate import INTERNAL, PURPOSE_EVENTS, WsGate, mark_purpose
+
+__all__ = [
+    "CLOSE_BAD_CHANNEL",
+    "CLOSE_NOT_PUBLISHER",
+    "MAX_FRAME_BYTES",
+    "QUEUE_FRAMES",
+    "EventsFanout",
+    "EventsRoutes",
+]
+
+log = logging.getLogger(__name__)
+
+CLOSE_BAD_CHANNEL: Final = 4400
+CLOSE_NOT_PUBLISHER: Final = 4401
+CLOSE_UNSUPPORTED: Final = 1003
+CLOSE_TOO_BIG: Final = 1009
+CLOSE_TOO_SLOW: Final = 1013
+MAX_FRAME_BYTES: Final = 1024 * 1024
+QUEUE_FRAMES: Final = 256
+
+
+class _Subscriber:
+    def __init__(self, limit: int) -> None:
+        self.queue: asyncio.Queue[str | None] = asyncio.Queue(maxsize=limit)
+        self.overflowed = False
+
+    def offer(self, frame: str) -> None:
+        if self.overflowed:
+            return
+        try:
+            self.queue.put_nowait(frame)
+        except asyncio.QueueFull:
+            self.overflowed = True
+            self._wake()
+
+    def _wake(self) -> None:
+        # Make room for the stop marker: the writer ends at once and closes the socket.
+        with contextlib.suppress(asyncio.QueueEmpty):
+            while True:
+                self.queue.get_nowait()
+        self.queue.put_nowait(None)
+
+    def stop(self) -> None:
+        with contextlib.suppress(asyncio.QueueFull):
+            self.queue.put_nowait(None)
+
+
+class EventsFanout:
+    """Channels and their subscribers (in-process, one per backend)."""
+
+    def __init__(self, *, queue_frames: int = QUEUE_FRAMES) -> None:
+        self._queue_frames = queue_frames
+        self._channels: dict[str, set[_Subscriber]] = {}
+
+    def channels(self) -> dict[str, int]:
+        """Subscriber counts per live channel."""
+        return {name: len(subs) for name, subs in self._channels.items()}
+
+    def _join(self, channel: str) -> _Subscriber:
+        subscriber = _Subscriber(self._queue_frames)
+        self._channels.setdefault(channel, set()).add(subscriber)
+        return subscriber
+
+    def _leave(self, channel: str, subscriber: _Subscriber) -> None:
+        subs = self._channels.get(channel)
+        if subs is None:
+            return
+        subs.discard(subscriber)
+        if not subs:
+            del self._channels[channel]
+
+    def publish(self, channel: str, frame: str) -> int:
+        """Queue ``frame`` for every subscriber of ``channel``; how many got it."""
+        subs = list(self._channels.get(channel, ()))
+        for subscriber in subs:
+            subscriber.offer(frame)
+        return len(subs)
+
+    async def serve_subscriber(self, websocket: WebSocket, channel: str) -> None:
+        """Send ``channel``'s frames to an accepted socket until it goes (or falls behind)."""
+        subscriber = self._join(channel)
+
+        async def drain_input() -> None:
+            try:
+                while True:
+                    message = await websocket.receive()
+                    if message.get("type") == "websocket.disconnect":
+                        break
+            except (RuntimeError, WebSocketDisconnect):
+                pass
+            finally:
+                subscriber.stop()
+
+        reader = asyncio.get_running_loop().create_task(drain_input(), name="indus-events-in")
+        try:
+            while True:
+                frame = await subscriber.queue.get()
+                if frame is None:
+                    break
+                try:
+                    await websocket.send_text(frame)
+                except Exception:
+                    break
+            if subscriber.overflowed:
+                await close_quietly(websocket, CLOSE_TOO_SLOW, "event feed fell behind")
+        finally:
+            self._leave(channel, subscriber)
+            reader.cancel()
+            with contextlib.suppress(BaseException):
+                await reader
+
+    async def serve_publisher(self, websocket: WebSocket, channel: str) -> None:
+        """Fan out every text frame of an accepted publisher socket."""
+        while True:
+            try:
+                message = await websocket.receive()
+            except (RuntimeError, WebSocketDisconnect):
+                return
+            if message.get("type") == "websocket.disconnect":
+                return
+            text = message.get("text")
+            if not isinstance(text, str):
+                await close_quietly(websocket, CLOSE_UNSUPPORTED, "text frames only")
+                return
+            if len(text.encode("utf-8", "replace")) > MAX_FRAME_BYTES:
+                await close_quietly(websocket, CLOSE_TOO_BIG, "frame too large")
+                return
+            self.publish(channel, text)
+
+
+class EventsRoutes:
+    """The two endpoints over one ``EventsFanout`` (see the module notes)."""
+
+    purpose: Final = PURPOSE_EVENTS
+
+    def __init__(self, *, gate: WsGate, fanout: EventsFanout | None = None) -> None:
+        self.gate = gate
+        self.fanout = fanout if fanout is not None else EventsFanout()
+
+    @property
+    def publish_endpoint(self) -> Callable[[WebSocket], Awaitable[None]]:
+        async def pub_socket(websocket: WebSocket) -> None:
+            await self.handle_publish(websocket)
+
+        return mark_purpose(pub_socket, self.purpose)
+
+    @property
+    def events_endpoint(self) -> Callable[[WebSocket], Awaitable[None]]:
+        async def events_socket(websocket: WebSocket) -> None:
+            await self.handle_events(websocket)
+
+        return mark_purpose(events_socket, self.purpose)
+
+    async def handle_publish(self, websocket: WebSocket) -> None:
+        identity = await self.gate(websocket, self.purpose)
+        if identity is None:
+            return
+        if identity.credential != INTERNAL:
+            log.warning("event publish refused: not the server's own child")
+            await close_quietly(websocket, CLOSE_NOT_PUBLISHER, "publishing is not allowed")
+            return
+        channel = valid_channel(websocket.query_params.get("channel"))
+        if channel is None:
+            await close_quietly(websocket, CLOSE_BAD_CHANNEL, "bad channel")
+            return
+        await self.fanout.serve_publisher(websocket, channel)
+
+    async def handle_events(self, websocket: WebSocket) -> None:
+        identity = await self.gate(websocket, self.purpose)
+        if identity is None:
+            return
+        channel = valid_channel(websocket.query_params.get("channel"))
+        if channel is None:
+            await close_quietly(websocket, CLOSE_BAD_CHANNEL, "bad channel")
+            return
+        await self.fanout.serve_subscriber(websocket, channel)
