+# STAND-IN: removed at integration
+"""Stand-ins for W1's pieces the chat routes need (P18-06 gate, P18-01 app factory).
+
+Assumed interface (W1 owns the real one): ``await gate(websocket, purpose)`` runs the pre-accept
+checks in order — feature enabled (else 4404), credential (else 4401), Origin (else 4403), peer
+(else 4408) — accepting the socket and returning an identity with ``credential`` in ``token`` /
+``ticket`` / ``internal``, or accepting, closing with the code and returning None. The loopback
+token is refused in gated mode; tickets are single use. Here a credential is offered as a
+subprotocol ``indus-web-<kind>.<value>`` next to ``indus-web-v1`` (which the gate echoes), so
+nothing secret sits in a test URL. ``chat_app`` mounts the three chat route families on a bare
+FastAPI app with the profile resolver installed; ``serving`` runs it on 127.0.0.1.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hmac
+import secrets
+from collections.abc import AsyncIterator
+from dataclasses import dataclass
+from typing import Final
+
+from fastapi import FastAPI
+from starlette.websockets import WebSocket
+
+from indus.foundation.clock import SystemClock
+from indus.gateway.http.serving import HttpServer, bind_listener
+from indus.web.scope import ProfileScopes, install
+from indus.web.ws.events_fanout import EventsRoutes
+from indus.web.ws.pty_route import PtyRoute
+from indus.web.ws.rpc_sidecar import RpcSidecar
+
+PROTOCOL: Final = "indus-web-v1"
+PREFIX: Final = "indus-web-"
+LOOPBACK: Final = frozenset({"127.0.0.1", "::1"})
+
+
+@dataclass(frozen=True)
+class StubIdentity:
+    credential: str
+    user_id: str | None = None
+
+
+class StubGate:
+    def __init__(self, *, gated: bool = False, enabled: bool = True) -> None:
+        self.gated = gated
+        self.enabled = enabled
+        self.token = "loop" + secrets.token_urlsafe(16)
+        self.internal = "int" + secrets.token_urlsafe(16)
+        self.tickets: set[str] = set()
+        self.origins = {"http://127.0.0.1:9119"}
+        self.purposes: list[str] = []
+
+    def mint_ticket(self) -> str:
+        ticket = secrets.token_urlsafe(24)
+        self.tickets.add(ticket)
+        return ticket
+
+    def offer(self, kind: str, value: str | None = None) -> list[str]:
+        if value is None:
+            value = {"token": self.token, "internal": self.internal}.get(kind) or self.mint_ticket()
+        return [PROTOCOL, f"{PREFIX}{kind}.{value}"]
+
+    def _identity(self, offered: list[str]) -> StubIdentity | None:
+        found = [o for o in offered if o.startswith(PREFIX) and o != PROTOCOL]
+        if len(found) != 1:
+            return None
+        kind, _, value = found[0][len(PREFIX) :].partition(".")
+        if kind == "token" and not self.gated and hmac.compare_digest(value, self.token):
+            return StubIdentity("token", "owner")
+        if kind == "ticket" and self.gated and value in self.tickets:
+            self.tickets.discard(value)
+            return StubIdentity("ticket", "someone")
+        if kind == "internal" and hmac.compare_digest(value, self.internal):
+            return StubIdentity("internal")
+        return None
+
+    async def __call__(self, websocket: WebSocket, purpose: str) -> StubIdentity | None:
+        self.purposes.append(purpose)
+        offered = [str(o) for o in websocket.scope.get("subprotocols") or []]
+        echo = PROTOCOL if PROTOCOL in offered else None
+
+        async def refuse(code: int) -> None:
+            await websocket.accept(subprotocol=echo)
+            await websocket.close(code)
+
+        if not self.enabled:
+            return await refuse(4404)
+        identity = self._identity(offered)
+        if identity is None:
+            return await refuse(4401)
+        origin = websocket.headers.get("origin")
+        if origin is not None and origin not in self.origins:
+            return await refuse(4403)
+        client = websocket.client
+        if client is None or client.host not in LOOPBACK:
+            return await refuse(4408)
+        await websocket.accept(subprotocol=echo)
+        return identity
+
+
+def chat_app(
+    scopes: ProfileScopes,
+    *,
+    pty: PtyRoute | None = None,
+    events: EventsRoutes | None = None,
+    rpc: RpcSidecar | None = None,
+) -> FastAPI:
+    app = FastAPI()
+    install(app, scopes)
+    if pty is not None:
+        app.add_api_websocket_route("/api/pty", pty.endpoint)
+    if events is not None:
+        app.add_api_websocket_route("/api/pub", events.publish_endpoint)
+        app.add_api_websocket_route("/api/events", events.events_endpoint)
+    if rpc is not None:
+        app.add_api_websocket_route("/api/ws", rpc.endpoint)
+    return app
+
+
+@contextlib.asynccontextmanager
+async def serving(app: FastAPI) -> AsyncIterator[str]:
+    """Run ``app`` on 127.0.0.1 (a free port); yields ``ws://127.0.0.1:<port>``."""
+    sock = await bind_listener("127.0.0.1", 0, SystemClock())
+    server = HttpServer(
+        app, sock, name="web-test", ws={"ws": "wsproto", "ws_max_size": 4 * 1024 * 1024}
+    )
+    await server.start()
+    try:
+        host, port = server.address
+        yield f"ws://{host}:{port}"
+    finally:
+        await server.stop()
