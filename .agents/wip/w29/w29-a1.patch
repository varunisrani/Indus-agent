diff --git a/tests/contract/acp/harness.py b/tests/contract/acp/harness.py
new file mode 100644
index 0000000..63fa153
--- /dev/null
+++ b/tests/contract/acp/harness.py
@@ -0,0 +1,173 @@
+"""One ACP agent + client over either host, for the handler suites (P19-03..07).
+
+``open_harness(kind, ...)`` builds the agent with a ``HostSelector`` for ``kind``:
+
+- ``local``: ``LocalHost`` over a ``SessionService`` on the fake model and the test's store;
+- ``attached``: ``AttachedHost`` over the real P17 daemon endpoint (``tests.fakes.daemon``), with
+  the stand-in methods the adapter calls.
+
+Both write to the same store file the read-only views read. Nothing here is product code.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from collections.abc import AsyncIterator, Callable, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+from indus.acp.agent import AcpAgent
+from indus.acp.attached_host import AttachedHost
+from indus.acp.backend import AcpBackend, HostSelector
+from indus.acp.local_host import LocalHost
+from indus.core.persist import StateStore
+from indus.foundation.scope import Scope
+from indus.protocol.events import EventBase
+from indus.service.host_inprocess import ALL_KINDS
+from indus.service.remote.channel import Channel, ChannelLimits
+from indus.service.remote.host import RemoteSessionService
+from indus.service.remote.journal import Journal
+from indus.service.session_service import AgentFactory, SessionService
+from indus.state import messages, sessions
+from indus.state.registry import StoreHandle
+from tests.fakes.acp_client import AcpPair
+from tests.fakes.agent import fake_options
+from tests.fakes.daemon import AcpDaemon, open_daemon
+from tests.fakes.model import FakeModelServer, Turn, fake_route, script_of
+
+__all__ = ["KINDS", "Harness", "open_harness", "seed_session"]
+
+KINDS = ("local", "attached")
+FAST = ChannelLimits(backoff_first=0.01, backoff_cap=0.05)
+
+
+@dataclass
+class Harness:
+    kind: str
+    agent: AcpAgent
+    pair: AcpPair
+    selector: HostSelector
+    daemon: AcpDaemon | None = None
+    server: FakeModelServer | None = None
+    events: list[EventBase] = field(default_factory=list[EventBase])
+
+    async def backend(self) -> AcpBackend:
+        return await self.selector.get()
+
+    async def call(self, method: str, params: Mapping[str, Any] | None = None) -> Any:
+        return await self.pair.call(method, params)
+
+
+async def _inline(build: Callable[[], SessionService]) -> SessionService:
+    return build()
+
+
+def local_backend(
+    scope: Scope,
+    store: StoreHandle,
+    tmp_path: Path,
+    *turns: Turn,
+    tools: Mapping[str, Any] | None = None,
+) -> tuple[LocalHost, FakeModelServer]:
+    server = FakeModelServer(script_of(*turns), clock=scope.clock)
+    inline = dict(tools or {})
+
+    def build(factory: AgentFactory) -> SessionService:
+        return SessionService(
+            scope,
+            fake_route(server),
+            toolsets=[],
+            options=fake_options(
+                server, session_id=None, platform="acp", source="acp", inline=inline
+            ),
+            store=StateStore(store),
+            lock_dir=tmp_path / "locks",
+            owner="acp",
+            answerable_kinds=tuple(ALL_KINDS),
+            agent_factory=factory,
+        )
+
+    return LocalHost(scope, build, offload=_inline), server
+
+
+def attached_backend(scope: Scope, daemon: AcpDaemon) -> AttachedHost:
+    async def connect() -> RemoteSessionService:
+        channel = Channel(daemon.dial, surface="acp", limits=FAST)
+        return RemoteSessionService(channel, Journal(scope.home), surface="acp")
+
+    return AttachedHost(scope, connect=connect, describe=daemon.describe)
+
+
+@contextlib.asynccontextmanager
+async def open_harness(
+    kind: str,
+    scope: Scope,
+    store: StoreHandle,
+    tmp_path: Path,
+    *turns: Turn,
+    tools: dict[str, Any] | None = None,
+    env: Mapping[str, str] | None = None,
+    wsl: bool = False,
+    script: Mapping[str, Any] | None = None,
+) -> AsyncIterator[Harness]:
+    daemon: AcpDaemon | None = None
+    server: FakeModelServer | None = None
+    if kind == "local":
+        local, server = local_backend(scope, store, tmp_path, *turns, tools=tools)
+
+        async def build_local() -> AcpBackend:
+            return local
+
+        async def no_daemon() -> AcpBackend:
+            raise AssertionError("a local harness never attaches")
+
+        selector = HostSelector(
+            local_only=True, allow_fallback=False, attached=no_daemon, local=build_local
+        )
+    else:
+        daemon = await open_daemon(scope, store, tmp_path, *turns, tools=tools)
+        found = daemon
+
+        async def build_attached() -> AcpBackend:
+            host = attached_backend(scope, found)
+            await host.start()
+            return host
+
+        async def no_local() -> AcpBackend:
+            raise AssertionError("an attached harness never runs locally")
+
+        selector = HostSelector(
+            local_only=False, allow_fallback=False, attached=build_attached, local=no_local
+        )
+    agent = AcpAgent(scope, selector, env=dict(env or {}), wsl=wsl)
+    pair = AcpPair(agent, script=script)
+    harness = Harness(kind, agent, pair, selector, daemon, server)
+    try:
+        yield harness
+    finally:
+        await pair.close()
+        if daemon is not None:
+            await daemon.close()
+
+
+def seed_session(
+    store: StoreHandle,
+    session_id: str,
+    *,
+    cwd: str | None,
+    rows: list[dict[str, Any]] | None = None,
+    source: str = "acp",
+    title: str | None = None,
+) -> None:
+    """A stored conversation (row + messages) both hosts can resume."""
+    fields: dict[str, Any] = {}
+    if cwd is not None:
+        fields["cwd"] = cwd
+    sessions.create(store, session_id, source, **fields)
+    for row in rows or []:
+        messages.append(store, session_id, row)
+    if title is not None:
+        from indus.state import titles
+
+        titles.set_title(store, session_id, title)
diff --git a/tests/contract/acp/test_attached_host.py b/tests/contract/acp/test_attached_host.py
new file mode 100644
index 0000000..1dfa2a1
--- /dev/null
+++ b/tests/contract/acp/test_attached_host.py
@@ -0,0 +1,194 @@
+"""P19-04: the attached host as a viewer of the real daemon endpoint (``tests.fakes.daemon``).
+
+Profile and capability checks, a transport killed mid-turn (the waiter's outcome is unknown, the
+reconnect resubscribes from the last seq and the open approval card is offered once), and a turn
+the daemon lost being announced once.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+from typing import Any
+
+import pytest
+from acp import RequestError
+
+from indus.acp.attached_host import AttachedHost
+from indus.acp.backend import BackendError
+from indus.foundation.scope import Scope
+from indus.protocol.attach import ACP_EDITOR_POLICY
+from indus.protocol.events import ExitReason, TurnDone
+from indus.service.remote.host import OutcomeUnknown
+from indus.state import messages
+from indus.state.registry import StoreHandle
+from tests.contract.acp.harness import attached_backend, open_harness
+from tests.fakes.agent import eventually
+from tests.fakes.daemon import open_daemon
+from tests.fakes.model import text_turn, tool_batch
+from tests.fakes.session_host import confirm
+from tests.unit.backends._aio import aio
+
+NEW = {"mcpServers": []}
+
+
+@aio
+async def test_a_daemon_of_another_profile_is_refused(
+    scope: Scope, store: StoreHandle, tmp_path: Path
+) -> None:
+    daemon = await open_daemon(scope, store, tmp_path)
+    try:
+        daemon.profile_id = "0123456789abcdef"
+        host = attached_backend(scope, daemon)
+        with pytest.raises(BackendError) as refused:
+            await host.start()
+        assert refused.value.code == "profile_mismatch"
+        assert daemon.rig.dials == 0  # nothing dialled for another profile
+        await host.aclose()
+    finally:
+        await daemon.close()
+
+
+@aio
+async def test_a_daemon_without_the_editor_policy_cannot_host_editor_sessions(
+    scope: Scope, store: StoreHandle, tmp_path: Path
+) -> None:
+    async with open_harness("attached", scope, store, tmp_path) as h:
+        assert h.daemon is not None
+        h.daemon.capabilities.remove(ACP_EDITOR_POLICY)
+        with pytest.raises(RequestError) as refused:
+            await h.call("session/new", {"cwd": str(tmp_path), **NEW})
+        assert (refused.value.data or {}).get("reason") == "acp_policy_unavailable"
+        assert h.daemon.host.hosted() == []
+
+
+@aio
+async def test_no_daemon_is_daemon_unavailable(scope: Scope, tmp_path: Path) -> None:
+    async def nobody() -> Any:
+        return None
+
+    async def never() -> Any:
+        raise AssertionError("no dial without a daemon")
+
+    host = AttachedHost(scope, connect=never, describe=nobody)
+    with pytest.raises(BackendError) as missing:
+        await host.start()
+    assert missing.value.code == "daemon_unavailable"
+
+
+async def _start_turn_waiting_on_approval(h: Any, tmp_path: Path) -> tuple[AttachedHost, str]:
+    result = await h.call("session/new", {"cwd": str(tmp_path), **NEW})
+    sid = result["sessionId"]
+    host = await h.backend()
+    assert isinstance(host, AttachedHost)
+    events = h.events
+    h.agent.on_backend_event = lambda _key, event: events.append(event)
+    await host.submit(sid, "clean up", input_id="b" * 32)
+    held = h.agent.sessions.by_editor(sid)
+    await eventually(lambda: len(held.offered) == 1, limit=10)
+    return host, sid
+
+
+@aio
+async def test_a_killed_transport_fails_the_waiter_and_the_reconnect_resumes_from_the_last_seq(
+    scope: Scope, store: StoreHandle, tmp_path: Path
+) -> None:
+    turns = (tool_batch(("confirm", {})), text_turn("cleaned"))
+    async with open_harness(
+        "attached", scope, store, tmp_path, *turns, tools={"confirm": confirm}
+    ) as h:
+        daemon = h.daemon
+        assert daemon is not None
+        host, sid = await _start_turn_waiting_on_approval(h, tmp_path)
+        service = await host.start()
+        waiter = asyncio.ensure_future(service.wait(sid))
+        await h.pair.settle()
+        assert not waiter.done()
+        seen = max(e.seq for e in h.events)
+        await daemon.rig.last.kill()
+        with pytest.raises(OutcomeUnknown) as lost:
+            await waiter
+        assert "Do not resend" in str(lost.value)
+        await eventually(lambda: len(daemon.rig.transports) == 2, limit=10)
+        await eventually(lambda: service.channel.state == "ready", limit=10)
+        resubscribe = [f for f in daemon.rig.last.sent if f.get("method") == "session.subscribe"]
+        assert resubscribe and resubscribe[0]["params"]["cursor"] == seen
+        held = h.agent.sessions.by_editor(sid)
+        assert held is not None and len(held.offered) == 1  # the open card is not shown twice
+        request, generation = held.offered[0]
+        assert generation is not None
+        accepted = await host.answer(
+            sid, str(request.request_id), generation, {"kind": "approval", "choice": "once"}
+        )
+        assert accepted is True
+        await eventually(lambda: any(isinstance(e, TurnDone) for e in h.events), limit=10)
+        done = [e for e in h.events if isinstance(e, TurnDone)]
+        assert len(done) == 1 and done[0].reason is ExitReason.COMPLETED
+        seqs = [e.seq for e in h.events]
+        assert seqs == sorted(set(seqs))  # no event applied twice across the reconnect
+        assert any(
+            m["role"] == "assistant" and m["content"] == "cleaned" for m in messages.get(store, sid)
+        )
+
+
+@aio
+async def test_reconnect_reattaches_editor_mcp_and_reasoning(
+    scope: Scope, store: StoreHandle, tmp_path: Path
+) -> None:
+    spec = {"name": "docs", "command": "/usr/bin/true", "args": [], "env": []}
+    async with open_harness("attached", scope, store, tmp_path) as h:
+        daemon = h.daemon
+        assert daemon is not None
+        result = await h.call("session/new", {"cwd": str(tmp_path), "mcpServers": [spec]})
+        sid = result["sessionId"]
+        host = await h.backend()
+        assert isinstance(host, AttachedHost)
+        service = await host.start()
+        before = list(daemon.calls)
+        await daemon.rig.last.kill()
+        await eventually(lambda: len(daemon.rig.transports) == 2, limit=10)
+        await eventually(lambda: service.channel.state == "ready", limit=10)
+        after = daemon.calls[len(before) :]
+        assert ("session.mutate", "editor_mcp") in {
+            (m, p.get("operation")) for m, p in after if m == "session.mutate"
+        }
+        assert any(m == "config.set" and p["key"] == "show_reasoning" for m, p in after)
+        assert all(p.get("session_id") == sid for m, p in after if m == "session.mutate")
+
+
+@aio
+async def test_a_lost_turn_is_announced_once(
+    scope: Scope, store: StoreHandle, tmp_path: Path
+) -> None:
+    async with open_harness("attached", scope, store, tmp_path, text_turn("first")) as h:
+        daemon = h.daemon
+        assert daemon is not None
+        result = await h.call("session/new", {"cwd": str(tmp_path), **NEW})
+        sid = result["sessionId"]
+        host = await h.backend()
+        assert isinstance(host, AttachedHost)
+        service = await host.start()
+        admission = await host.submit(sid, "hi", input_id="c" * 32)
+        await eventually(
+            lambda: any(m["role"] == "assistant" for m in messages.get(store, sid)), limit=10
+        )
+        store.write(
+            lambda conn: conn.execute(
+                "UPDATE runtime_admissions SET state = 'unknown', outcome = NULL "
+                "WHERE admission_id = ?",
+                (admission.admission_id,),
+            )
+        )
+        for round_ in (2, 3):
+            await daemon.rig.last.kill()
+            await eventually(lambda n=round_: len(daemon.rig.transports) == n, limit=10)
+            await eventually(lambda: service.channel.state == "ready", limit=10)
+            await h.pair.settle()
+        notices = [
+            u["content"]["text"]
+            for u in h.pair.updates(sid)
+            if u["sessionUpdate"] == "agent_message_chunk"
+        ]
+        lost = [t for t in notices if "outcome is unknown" in t]
+        assert len(lost) == 1
+        assert f"/discard {admission.admission_id}" in lost[0]
