+"""The ``indus acp`` click command (P19-01), loaded by name from the CLI's registry.
+
+It lives beside the adapter (as ``indus tui-bridge`` does) because ``indus.cli`` and ``indus.acp``
+are independent siblings in the layer contract.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import click
+
+from indus.foundation.scope import Scope
+
+__all__ = ["acp_command"]
+
+
+@click.command(
+    "acp",
+    help=(
+        "Run Indus Agent inside an editor that speaks the Agent Client Protocol (Zed, VS Code, "
+        "JetBrains). The editor starts this command; stdin and stdout carry the protocol. By "
+        "default sessions run in the profile's gateway daemon; --local runs them in this process."
+    ),
+)
+@click.option("--local", is_flag=True, help="Run sessions in this process instead of the daemon.")
+@click.option("--version", "show_version", is_flag=True, help="Print the version and exit.")
+@click.option("--check", is_flag=True, help="Check that the ACP support is installed, then exit.")
+@click.option("--setup", is_flag=True, help="Set up a provider and model in this terminal.")
+@click.option("--setup-browser", is_flag=True, help="Install the browser tools, then exit.")
+@click.option("--yes", "-y", is_flag=True, help="With --setup-browser: accept the downloads.")
+@click.pass_context
+def acp_command(
+    ctx: click.Context,
+    local: bool,
+    show_version: bool,
+    check: bool,
+    setup: bool,
+    setup_browser: bool,
+    yes: bool,
+) -> int:
+    state: Any = ctx.obj
+    scope = getattr(state, "scope", None)
+    if not isinstance(scope, Scope):
+        raise click.UsageError("acp was started without the process scope")
+    from indus.acp.entry import Options, run
+
+    return run(
+        scope,
+        Options(
+            local=local,
+            version=show_version,
+            check=check,
+            setup=setup,
+            setup_browser=setup_browser,
+            yes=yes,
+        ),
+    )
diff --git a/src/indus/acp/entry.py b/src/indus/acp/entry.py
new file mode 100644
index 0000000..11d5f62
--- /dev/null
+++ b/src/indus/acp/entry.py
@@ -0,0 +1,271 @@
+"""``indus acp``: the editor agent over stdio (P19-01).
+
+Order (R09.14, R09.15):
+
+1. The informational flags run first and start nothing: ``--version`` prints the version,
+   ``--check`` imports the ACP SDK and the adapter and prints OK (exit 1 with an install hint when
+   the ``acp`` extra is missing), ``--setup`` runs ``indus setup`` as a child process and then,
+   on a terminal, offers the browser tools, ``--setup-browser [--yes]`` installs them (also a
+   child ``indus`` process: this package may not import the CLI).
+2. ``stdout_guard.claim()`` takes descriptors 0 and 1 for the protocol and guards ``sys.stdout``
+   before anything heavy is imported. Logging is already the process's ``stdio`` mode (stderr,
+   redacted, HTTP client loggers at WARNING): the CLI lists ``acp`` among its stdio commands.
+3. On Windows the native modules that deadlocked when first imported off the main thread (the
+   keyring backend, the memory providers) are imported here, before the reader starts.
+4. The SDK's JSON-RPC ``Connection`` runs over asyncio streams on the private descriptors with
+   ``AcpAgent.dispatch`` as its handler, until the editor closes its end (or SIGTERM).
+5. The backend is closed while its loop is alive. Sessions are never ended here: an attached
+   daemon ends an ``acp`` session once no viewer is left and nothing is queued (D-16.421); local
+   mode only detaches.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import shutil
+import signal
+import subprocess
+import sys
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from typing import Any, Final, TextIO
+
+from indus import __version__
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "MISSING_SDK_HINT",
+    "Options",
+    "check",
+    "indus_command",
+    "make_selector",
+    "run",
+    "serve",
+    "setup",
+    "setup_browser",
+]
+
+log = logging.getLogger(__name__)
+
+MISSING_SDK_HINT: Final = (
+    "The Agent Client Protocol SDK is not installed. Install Indus Agent with the `acp` extra, "
+    "for example: uv tool install 'indus-agent[acp]'"
+)
+ADAPTER_MODULES: Final = (
+    "indus.acp.agent",
+    "indus.acp.sessions",
+    "indus.acp.history",
+    "indus.acp.listing",
+    "indus.acp.local_host",
+    "indus.acp.attached_host",
+)
+
+
+@dataclass(frozen=True)
+class Options:
+    local: bool = False
+    version: bool = False
+    check: bool = False
+    setup: bool = False
+    setup_browser: bool = False
+    yes: bool = False
+
+
+def indus_command() -> list[str]:
+    """How to start this program again as a child process."""
+    found = shutil.which("indus")
+    if found:
+        return [found]
+    return [sys.executable, "-m", "indus"]
+
+
+# -- informational flags --------------------------------------------------------------------------
+
+
+def check(out: TextIO | None = None, err: TextIO | None = None) -> int:
+    try:
+        import acp
+    except ImportError:
+        print(MISSING_SDK_HINT, file=err or sys.stderr)
+        return 1
+    import importlib
+
+    for name in ADAPTER_MODULES:
+        importlib.import_module(name)
+    version = getattr(acp, "__version__", None) or _sdk_version()
+    print(
+        f"Indus Agent ACP check OK (agent-client-protocol {version}, protocol "
+        f"{acp.PROTOCOL_VERSION})",
+        file=out or sys.stdout,
+    )
+    return 0
+
+
+def _sdk_version() -> str:
+    from importlib.metadata import PackageNotFoundError, version
+
+    try:
+        return version("agent-client-protocol")
+    except PackageNotFoundError:
+        return "unknown"
+
+
+type Runner = Callable[..., subprocess.CompletedProcess[Any]]
+
+
+def setup(
+    *,
+    run_child: Runner = subprocess.run,
+    stdin: TextIO | None = None,
+    ask: Callable[[str], str] = input,
+) -> int:
+    """``indus setup`` in a child process, then (on a terminal) offer the browser tools."""
+    code = run_child([*indus_command(), "setup"], check=False).returncode
+    if code != 0:
+        return int(code)
+    source = stdin or sys.stdin
+    if not source.isatty():
+        return 0
+    try:
+        reply = ask("\nInstall the browser tools as well (downloads Chromium)? [y/N] ")
+    except (EOFError, KeyboardInterrupt):
+        return 0
+    if reply.strip().lower() in {"y", "yes"}:
+        return setup_browser(yes=False, run_child=run_child)
+    return 0
+
+
+def setup_browser(*, yes: bool, run_child: Runner = subprocess.run) -> int:
+    argv = [*indus_command(), "tools", "install", "browser"]
+    if yes:
+        argv.append("--yes")
+    code = int(run_child(argv, check=False).returncode)
+    if code != 0:
+        sys.stderr.write("Browser setup did not finish; see the messages above.\n")
+    return code
+
+
+# -- the server -----------------------------------------------------------------------------------
+
+
+def _allow_fallback(scope: Scope) -> bool:
+    from indus.foundation.config import load
+
+    try:
+        return load(scope).get("acp.allow_local_fallback") is True
+    except Exception:
+        return False
+
+
+def make_selector(scope: Scope, *, local: bool) -> Any:
+    """The host selector for this process (``backend.HostSelector``)."""
+    from indus.acp.attached_host import AttachedHost
+    from indus.acp.backend import AcpBackend, HostSelector
+    from indus.acp.local_host import LocalHost, build_service
+
+    async def attached() -> AcpBackend:
+        host = AttachedHost(scope)
+        try:
+            await host.start()
+        except BaseException:
+            await host.aclose()
+            raise
+        return host
+
+    async def in_process() -> AcpBackend:
+        return LocalHost(scope, lambda factory: build_service(scope, factory))
+
+    return HostSelector(
+        local_only=local,
+        allow_fallback=_allow_fallback(scope),
+        attached=attached,
+        local=in_process,
+    )
+
+
+def _warm_native_imports() -> None:
+    """Windows: import native modules on the main thread before any reader thread (R09.15)."""
+    if sys.platform != "win32":
+        return
+    for name in ("keyring", "indus.learning.memory.providers"):
+        with contextlib.suppress(Exception):
+            __import__(name)
+    with contextlib.suppress(Exception):
+        import keyring
+
+        keyring.get_keyring()
+
+
+class SdkPeer:
+    """``agent.ClientPeer`` over the SDK connection."""
+
+    def __init__(self, connection: Any) -> None:
+        self._connection = connection
+
+    async def notify(self, method: str, params: Mapping[str, Any]) -> None:
+        await self._connection.send_notification(method, dict(params))
+
+    async def request(self, method: str, params: Mapping[str, Any]) -> Any:
+        return await self._connection.send_request(method, dict(params))
+
+
+async def _serve(scope: Scope, claimed: Any, *, local: bool) -> int:
+    from acp.connection import Connection
+
+    from indus.acp.agent import AcpAgent
+
+    reader, writer = await claimed.streams()
+    agent = AcpAgent(scope, make_selector(scope, local=local))
+    connection = Connection(agent.dispatch, writer, reader, listening=False)
+    agent.peer = SdkPeer(connection)
+    main = asyncio.current_task()
+    loop = asyncio.get_running_loop()
+    if main is not None and sys.platform != "win32":
+        with contextlib.suppress(NotImplementedError, RuntimeError):
+            loop.add_signal_handler(signal.SIGTERM, main.cancel)
+    try:
+        await connection.main_loop()
+    except asyncio.CancelledError:
+        log.info("the editor agent was asked to stop")
+    except Exception:
+        log.exception("the editor connection failed")
+        return 1
+    finally:
+        with contextlib.suppress(Exception):
+            await agent.aclose()
+        with contextlib.suppress(Exception):
+            await connection.close()
+    return 0
+
+
+def serve(scope: Scope, *, local: bool) -> int:
+    from indus.acp import stdout_guard
+
+    claimed = stdout_guard.claim()
+    try:
+        import acp  # noqa: F401
+    except ImportError:
+        sys.stderr.write(MISSING_SDK_HINT + "\n")
+        return 1
+    _warm_native_imports()
+    log.info("starting the editor agent (%s)", "local" if local else "attached")
+    try:
+        return asyncio.run(_serve(scope, claimed, local=local))
+    except KeyboardInterrupt:
+        return 0
+
+
+def run(scope: Scope, options: Options) -> int:
+    """``indus acp`` (see the module notes)."""
+    if options.version:
+        sys.stdout.write(f"Indus Agent {__version__}\n")
+        return 0
+    if options.check:
+        return check()
+    if options.setup:
+        return setup()
+    if options.setup_browser:
+        return setup_browser(yes=options.yes)
+    return serve(scope, local=options.local)
diff --git a/src/indus/acp/history.py b/src/indus/acp/history.py
new file mode 100644
index 0000000..8d69988
--- /dev/null
+++ b/src/indus/acp/history.py
@@ -0,0 +1,266 @@
+"""``session/load``, ``session/resume`` and ``session/fork`` (P19-06).
+
+Load and resume do the same thing:
+
+1. the id the editor holds is mapped to the session: compression rotates stored ids, so an old id
+   resolves to its conversation and becomes an alias; every update is addressed to the id this
+   editor used on its latest load;
+2. when the session's folder differs from the editor's (translated, then compared with
+   ``paths.same_folder``), a ``workspace`` change moves it (idle sessions only); a session without
+   a folder gets a short message instead;
+3. a non-empty ``mcpServers`` is the editor's selection for the session; an empty list keeps the
+   servers the session has;
+4. the session is subscribed and its stored history is streamed as ``session/update``
+   notifications **before** the response (R09.9): user chunks, thought chunks, agent chunks, and
+   for each tool call a ``tool_call`` start plus a ``tool_call_update`` with its result;
+5. open approval/clarify requests are offered again through the subscription; turns lost in a
+   daemon restart are announced; the response carries modes, config options and provenance.
+
+Fork branches the parent (the editor's MCP servers for the child, else a copy of the parent's),
+moves the child's folder when it differs, subscribes it and answers with the child's id (no
+replay: the editor shows a fork as a new thread).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from collections.abc import Callable, Iterator, Mapping, Sequence
+from typing import Any, Final, cast
+
+from indus.acp import paths
+from indus.acp.agent import AcpAgent, HeldSession, handler, wire
+from indus.acp.backend import AcpBackend, LostTurn, SessionSnapshot
+from indus.acp.sessions import attach, editor_policy, notices_after_attach, session_fields
+from indus.core.transcript import TranscriptRow, call_arguments, call_id, call_name
+
+__all__ = [
+    "MAX_OUTPUT",
+    "NO_CWD_TEXT",
+    "ToolKinds",
+    "announce_lost",
+    "lost_text",
+    "replay_updates",
+]
+
+log = logging.getLogger(__name__)
+
+MAX_OUTPUT: Final = 5000
+"""Characters of a replayed tool result shown in the editor."""
+NO_CWD_TEXT: Final = (
+    "This conversation has no working folder of its own, so the editor's folder is not applied.\n"
+)
+
+type ToolKinds = Callable[[str], str]
+"""Tool name → ACP tool kind (``read``, ``edit``, ``execute``, …). P19-10 supplies the real map."""
+
+
+def _other(_name: str) -> str:
+    return "other"
+
+
+_IMAGE_PARTS: Final = frozenset({"image", "image_url", "input_image"})
+
+
+def _text(content: object) -> str:
+    """The text of a stored content value (parts joined; images as ``[image]``), stripped."""
+    if content is None:
+        return ""
+    if isinstance(content, str):
+        return content.strip()
+    if isinstance(content, list):
+        pieces: list[str] = []
+        for part in cast(list[object], content):
+            if isinstance(part, str):
+                pieces.append(part)
+            elif isinstance(part, Mapping):
+                entry = cast(Mapping[str, Any], part)
+                if str(entry.get("type", "")) in _IMAGE_PARTS:
+                    pieces.append("[image]")
+                elif isinstance(entry.get("text"), str):
+                    pieces.append(str(entry["text"]))
+        return "\n".join(p.strip() for p in pieces if p.strip()).strip()
+    return str(content).strip()
+
+
+def _chunk(kind: str, text: str) -> dict[str, Any]:
+    return {"sessionUpdate": kind, "content": {"type": "text", "text": text}}
+
+
+def _args(raw: str | None) -> Any:
+    if not raw:
+        return {}
+    try:
+        return json.loads(raw)
+    except ValueError:
+        return {"arguments": raw}
+
+
+def _cut(text: str) -> str:
+    if len(text) <= MAX_OUTPUT:
+        return text
+    return text[:MAX_OUTPUT] + f"\n… ({len(text) - MAX_OUTPUT} more characters not shown)"
+
+
+def replay_updates(
+    rows: Sequence[TranscriptRow], *, kinds: ToolKinds | None = None
+) -> Iterator[dict[str, Any]]:
+    """The ``session/update`` payloads that rebuild a stored transcript in an editor."""
+    kind_of = kinds or _other
+    open_calls: dict[str, str] = {}
+    for row in rows:
+        if row.scaffold or row.display_kind == "hidden":
+            continue
+        if row.role == "user":
+            text = _text(row.content)
+            if text:
+                yield _chunk("user_message_chunk", text)
+        elif row.role == "assistant":
+            thought = (row.reasoning or "").strip()
+            if thought:
+                yield _chunk("agent_thought_chunk", thought)
+            text = _text(row.content)
+            if text:
+                yield _chunk("agent_message_chunk", text)
+            for call in row.tool_calls or ():
+                ident = call_id(call)
+                if not ident:
+                    continue
+                name = call_name(call) or "tool"
+                open_calls[ident] = name
+                yield {
+                    "sessionUpdate": "tool_call",
+                    "toolCallId": ident,
+                    "title": name,
+                    "kind": kind_of(name),
+                    "status": "in_progress",
+                    "rawInput": _args(call_arguments(call)),
+                }
+        elif row.role == "tool":
+            ident = (row.tool_call_id or "").strip()
+            name = open_calls.pop(ident, None)
+            if not ident or name is None:
+                continue  # a result whose call is not in the replayed history
+            result = _text(row.content)
+            failed = bool(row.extra.get("is_error")) if row.extra else False
+            update: dict[str, Any] = {
+                "sessionUpdate": "tool_call_update",
+                "toolCallId": ident,
+                "status": "failed" if failed else "completed",
+            }
+            if result:
+                update["content"] = [
+                    {"type": "content", "content": {"type": "text", "text": _cut(result)}}
+                ]
+            yield update
+
+
+def lost_text(session_id: str, lost: Sequence[LostTurn]) -> str:
+    """Why the next prompt in this session will be refused, and how to recover (R09.11)."""
+    ids = " and ".join(f"`/discard {turn.admission_id}`" for turn in lost)
+    return (
+        "A turn in this conversation was lost when the Indus gateway restarted, so its outcome "
+        "is unknown. Nothing is sent again from here. Resolve it in a terminal: "
+        f"`indus -r {session_id}`, then {ids}, then continue here.\n"
+    )
+
+
+async def announce_lost(agent: AcpAgent, held: HeldSession, lost: Sequence[LostTurn]) -> None:
+    if not lost:
+        return
+    await agent.update(held.editor_id, _chunk("agent_message_chunk", lost_text(held.key, lost)))
+
+
+async def _replay(agent: AcpAgent, held: HeldSession, snapshot: SessionSnapshot) -> None:
+    kinds = getattr(agent, "tool_kinds", None)
+    try:
+        for update in replay_updates(snapshot.history, kinds=kinds):
+            await agent.update(held.editor_id, update)
+    except Exception:
+        log.warning("the history replay of %s stopped early", held.editor_id, exc_info=True)
+
+
+async def _move_if_needed(
+    agent: AcpAgent, backend: AcpBackend, snapshot: SessionSnapshot, editor_id: str, cwd: str
+) -> SessionSnapshot:
+    if snapshot.cwd is None:
+        await agent.update(editor_id, _chunk("agent_message_chunk", NO_CWD_TEXT))
+        return snapshot
+    if paths.same_folder(snapshot.cwd, cwd):
+        return snapshot
+    result = await backend.mutate(snapshot.session_id, "workspace", {"cwd": cwd})
+    if result.status != "applied":
+        log.info("session %s stays in its folder (%s)", snapshot.session_id, result.status)
+        return snapshot
+    return SessionSnapshot(**{**snapshot.__dict__, "cwd": cwd})
+
+
+async def _open(agent: AcpAgent, params: Mapping[str, Any]) -> tuple[HeldSession, SessionSnapshot]:
+    editor_id = str(params["sessionId"])
+    cwd = paths.translate_cwd(str(params.get("cwd") or ""), wsl=agent.wsl)
+    chosen = editor_policy(params.get("mcpServers"))
+    backend = await agent.backend()
+    known = agent.sessions.key_for(editor_id)
+    snapshot = await backend.resume(
+        known or editor_id, editor=chosen if chosen.mcp_servers else None
+    )
+    if cwd:
+        snapshot = await _move_if_needed(agent, backend, snapshot, editor_id, cwd)
+    held = await attach(agent, backend, snapshot, editor_id)
+    await _replay(agent, held, snapshot)
+    for pending in snapshot.pending:
+        agent.sink.on_request(held.key, pending.request, pending.generation)
+    await announce_lost(agent, held, snapshot.lost)
+    await backend.show_reasoning(snapshot.session_id)
+    return held, snapshot
+
+
+async def _answer(agent: AcpAgent, held: HeldSession, snapshot: SessionSnapshot) -> dict[str, Any]:
+    backend = await agent.backend()
+    fields = await session_fields(agent, backend, snapshot, held.editor_id)
+    agent.after_reply(lambda: notices_after_attach(agent, held))
+    return fields
+
+
+@handler("session/load")
+async def load_session(agent: AcpAgent, params: Mapping[str, Any]) -> dict[str, Any]:
+    from acp.schema import LoadSessionRequest, LoadSessionResponse
+
+    LoadSessionRequest.model_validate(params)
+    held, snapshot = await _open(agent, params)
+    fields = await _answer(agent, held, snapshot)
+    response = LoadSessionResponse.model_validate(fields)
+    return wire(response)
+
+
+@handler("session/resume")
+async def resume_session(agent: AcpAgent, params: Mapping[str, Any]) -> dict[str, Any]:
+    from acp.schema import ResumeSessionRequest, ResumeSessionResponse
+
+    ResumeSessionRequest.model_validate(params)
+    held, snapshot = await _open(agent, params)
+    fields = await _answer(agent, held, snapshot)
+    response = ResumeSessionResponse.model_validate(fields)
+    return wire(response)
+
+
+@handler("session/fork")
+async def fork_session(agent: AcpAgent, params: Mapping[str, Any]) -> dict[str, Any]:
+    from acp.schema import ForkSessionRequest, ForkSessionResponse
+
+    request = ForkSessionRequest.model_validate(params)
+    chosen = editor_policy(params.get("mcpServers"))
+    cwd = paths.translate_cwd(request.cwd, wsl=agent.wsl)
+    backend = await agent.backend()
+    parent = agent.sessions.key_for(request.session_id) or request.session_id
+    child = await backend.fork(parent, editor=chosen if chosen.mcp_servers else None)
+    snapshot = await backend.resume(child)
+    if cwd and snapshot.cwd is not None and not paths.same_folder(snapshot.cwd, cwd):
+        result = await backend.mutate(snapshot.session_id, "workspace", {"cwd": cwd})
+        if result.status == "applied":
+            snapshot = SessionSnapshot(**{**snapshot.__dict__, "cwd": cwd})
+    held = await attach(agent, backend, snapshot, snapshot.session_id)
+    await backend.show_reasoning(snapshot.session_id)
+    fields = await _answer(agent, held, snapshot)
+    response = ForkSessionResponse.model_validate({"sessionId": held.editor_id, **fields})
+    return wire(response)
diff --git a/src/indus/acp/listing.py b/src/indus/acp/listing.py
new file mode 100644
index 0000000..dc764f1
--- /dev/null
+++ b/src/indus/acp/listing.py
@@ -0,0 +1,95 @@
+"""``session/list``: the editor's history panel (P19-07).
+
+At most 1,000 ``acp``-source conversations are read (read-only, both host modes), one row per
+logical conversation, newest activity first. The editor's ``cwd`` filters them, both sides
+compared by ``paths.comparable`` (``~``, Windows drive → WSL mount, ``realpath`` so macOS
+``/var`` and ``/private/var`` agree; R09.16). Pages hold 50 rows; the ``cursor`` is the last
+session id of the previous page; an unknown cursor gives an empty page — never the first page
+again; ``nextCursor`` is set only when more rows remain. Listing needs no daemon: before any
+session call has picked a host, the store is read directly (the same read both hosts do).
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Mapping, Sequence
+from datetime import UTC, datetime
+from typing import Any, Final
+
+from indus.acp import paths, store_view
+from indus.acp.agent import AcpAgent, handler, wire
+from indus.acp.backend import ListedSession
+from indus.foundation.blocking import run_blocking
+
+__all__ = ["PAGE_SIZE", "Page", "page", "title_of"]
+
+PAGE_SIZE: Final = 50
+FALLBACK_TITLE: Final = "New conversation"
+
+
+def title_of(row: ListedSession) -> str:
+    """Stored title, else the first ask, else the folder's name, else a fixed label."""
+    for candidate in (row.title, row.preview):
+        if candidate and candidate.strip():
+            return candidate.strip()
+    leaf = os.path.basename((row.cwd or "").rstrip("/\\"))
+    return leaf or FALLBACK_TITLE
+
+
+def _stamp(value: float | None) -> str | None:
+    if value is None:
+        return None
+    try:
+        return datetime.fromtimestamp(float(value), tz=UTC).isoformat()
+    except (OverflowError, OSError, ValueError):
+        return None
+
+
+type Page = tuple[list[ListedSession], str | None]
+
+
+def page(
+    rows: Sequence[ListedSession],
+    *,
+    cwd: str | None = None,
+    cursor: str | None = None,
+    size: int = PAGE_SIZE,
+) -> Page:
+    """One page of ``rows`` (already newest first) and the next cursor (module notes)."""
+    wanted = paths.comparable(cwd) if cwd else None
+    chosen = [r for r in rows if wanted is None or paths.comparable(r.cwd) == wanted]
+    if cursor:
+        index = next((i for i, r in enumerate(chosen) if r.session_id == cursor), None)
+        chosen = [] if index is None else chosen[index + 1 :]
+    shown = chosen[:size]
+    more = len(chosen) > size
+    return shown, (shown[-1].session_id if more and shown else None)
+
+
+@handler("session/list")
+async def list_sessions(agent: AcpAgent, params: Mapping[str, Any]) -> dict[str, Any]:
+    from acp.schema import ListSessionsRequest, ListSessionsResponse
+
+    request = ListSessionsRequest.model_validate(params)
+    cwd = paths.translate_cwd(request.cwd, wsl=agent.wsl) if request.cwd else None
+    backend = agent.selector.built
+    if backend is not None:
+        rows = await backend.list_sessions()
+    else:  # listing needs no daemon: the store is read the same way in both modes
+        rows = await run_blocking(store_view.listed, agent.scope, label="acp session list")
+    shown, following = page(rows, cwd=cwd, cursor=request.cursor)
+    response = ListSessionsResponse.model_validate(
+        {
+            "sessions": [
+                {
+                    "sessionId": row.session_id,
+                    "cwd": row.cwd or "",
+                    "title": title_of(row),
+                    "updatedAt": _stamp(row.updated_at),
+                }
+                for row in shown
+            ],
+            "nextCursor": following,
+        }
+    )
+    return wire(response)
diff --git a/src/indus/acp/local_host.py b/src/indus/acp/local_host.py
new file mode 100644
index 0000000..88b727b
--- /dev/null
+++ b/src/indus/acp/local_host.py
@@ -0,0 +1,530 @@
+"""``indus acp --local``: the ACP backend over an in-process ``SessionService`` (P19-03).
+
+The service is built the way the TUI bridge builds one (the profile's route, the session store,
+built-in tools, MCP servers and plugins, the shared terminal runtime), off the event loop, on first
+use. Sessions it creates have source ``acp`` and the platform's toolset; the editor policy is the
+same as in attached mode (ask before edits; the editor's MCP specs held in memory only).
+
+The working folder is per session: ``LocalHost`` wraps the service's agent factory and puts the
+session's folder into every agent it builds, so a workspace move is "store the new folder, rebuild
+the agent" (``SessionService.reload``), allowed only while the session is idle.
+
+Admissions are this process's own: a submit with an ``input_id`` seen before for the session
+returns its first admission (the editor's retry never starts a second turn); receipts come from
+the turns this process saw end. A restarted process resumes sessions from the store with no open
+turn, so the ``unknown`` state never occurs here.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from collections import OrderedDict
+from collections.abc import Awaitable, Callable, Mapping, Sequence
+from dataclasses import replace
+from pathlib import Path
+from typing import Any, Final, cast
+
+from indus.acp import store_view
+from indus.acp.backend import (
+    Admission,
+    BackendError,
+    CancelOutcome,
+    CreateRequest,
+    EditorPolicy,
+    EventSink,
+    HostMode,
+    ListedSession,
+    MutationResult,
+    PendingPrompt,
+    SessionSnapshot,
+    UsageInfo,
+)
+from indus.core.agent import Agent, AgentOptions
+from indus.core.events import EventSink as AgentSink
+from indus.core.persist import StateStore
+from indus.foundation.blocking import run_blocking
+from indus.foundation.errors import IndusError
+from indus.foundation.scope import Scope
+from indus.protocol.errors import SESSION_BUSY, SESSION_NOT_FOUND
+from indus.protocol.events import EventBase, ExitReason, TurnDone, TurnStarted
+from indus.protocol.methods import ProtocolError, SessionCreateParams
+from indus.protocol.server_requests import ServerRequest, ServerRequestBase
+from indus.service.broker import ServerRequestBroker
+from indus.service.session_service import AgentFactory, SessionService
+from indus.state import rewind, sessions, titles
+
+__all__ = ["PLATFORM", "SOURCE", "LocalHost", "ServiceBuilder", "build_service"]
+
+log = logging.getLogger(__name__)
+
+PLATFORM: Final = "acp"
+SOURCE: Final = "acp"
+DEFAULT_TOOLSET: Final = "indus-acp"
+_KEPT_ADMISSIONS: Final = 256
+
+type ServiceBuilder = Callable[[AgentFactory], SessionService]
+"""Builds the service (blocking) with the given agent factory installed."""
+
+
+def _outcome(reason: ExitReason) -> str:
+    if reason is ExitReason.COMPLETED:
+        return "completed"
+    if reason in (ExitReason.INTERRUPTED_BY_USER, ExitReason.INTERRUPTED_BY_SYSTEM):
+        return "cancelled"
+    return "failed"
+
+
+def _backend_error(exc: BaseException) -> BackendError:
+    if isinstance(exc, BackendError):
+        return exc
+    if isinstance(exc, ProtocolError):
+        if exc.error.code == SESSION_NOT_FOUND.code:
+            return BackendError("not_found", exc.message or "no such session")
+        if exc.error.code == SESSION_BUSY.code:
+            return BackendError("session_busy", exc.message or "the session is busy")
+        return BackendError("backend_failed", exc.message or exc.error.name)
+    if isinstance(exc, IndusError):
+        hint = f" ({exc.hint})" if exc.hint else ""
+        return BackendError("backend_failed", exc.message + hint)
+    return BackendError("backend_failed", f"{type(exc).__name__}: the session call failed")
+
+
+class _Turn:
+    __slots__ = ("admission", "turn_id")
+
+    def __init__(self, admission: Admission, turn_id: str) -> None:
+        self.admission = admission
+        self.turn_id = turn_id
+
+
+class LocalHost:
+    """``AcpBackend`` in this process (see the module notes)."""
+
+    def __init__(
+        self,
+        scope: Scope,
+        builder: ServiceBuilder,
+        *,
+        offload: Callable[[Callable[[], SessionService]], Awaitable[SessionService]] | None = None,
+    ) -> None:
+        self.scope = scope
+        self._builder = builder
+        self._offload = offload
+        self._service: SessionService | None = None
+        self._building: asyncio.Lock = asyncio.Lock()
+        self._cwds: dict[str, str] = {}
+        self._editors: dict[str, EditorPolicy] = {}
+        self._inputs: OrderedDict[tuple[str, str], str] = OrderedDict()
+        self._turns: OrderedDict[str, _Turn] = OrderedDict()
+        self._by_turn: dict[str, str] = {}
+        self._watch: dict[str, Callable[[], None]] = {}
+
+    @property
+    def mode(self) -> HostMode:
+        return "local"
+
+    # -- the service ------------------------------------------------------------------------------
+
+    async def service(self) -> SessionService:
+        if self._service is not None:
+            return self._service
+        async with self._building:
+            if self._service is None:
+                factory: AgentFactory = self._factory
+
+                def build() -> SessionService:
+                    return self._builder(factory)
+
+                try:
+                    if self._offload is not None:
+                        self._service = await self._offload(build)
+                    else:
+                        self._service = await run_blocking(build, label="acp local service")
+                except BaseException as exc:
+                    raise _backend_error(exc) from None
+        return self._service
+
+    async def _factory(
+        self,
+        session_id: str,
+        sink: AgentSink,
+        broker: ServerRequestBroker,
+        options: AgentOptions,
+        selection: Sequence[str] | None,
+    ) -> Agent:
+        service = self._service
+        assert service is not None, "agents are built by the service this host made"
+        cwd = self._cwds.get(session_id)
+        if cwd:
+            fields = {**options.session_fields, "cwd": cwd}
+            options = replace(options, cwd=Path(cwd), session_fields=fields)
+        return await service._make_agent(  # pyright: ignore[reportPrivateUsage]
+            session_id, sink, broker, options, selection
+        )
+
+    def _handle(self, service: SessionService) -> Any:
+        store = service.store
+        if not isinstance(store, StateStore):
+            raise BackendError("mutation_unavailable", "this host has no session store")
+        return store.handle
+
+    # -- sessions ---------------------------------------------------------------------------------
+
+    async def create(self, request: CreateRequest) -> SessionSnapshot:
+        service = await self.service()
+        model = request.launch.fields.get("model")
+        params = SessionCreateParams(
+            cwd=request.cwd or None,
+            model=model if isinstance(model, str) and model else None,
+            idempotency_key=request.request_id,
+        )
+        try:
+            created = await service.create(params)
+        except BaseException as exc:
+            raise _backend_error(exc) from None
+        sid = created.session_id
+        if request.cwd:
+            self._cwds[sid] = request.cwd
+        self._editors[sid] = request.editor
+        self._follow_turns(service, sid)
+        return SessionSnapshot(
+            session_id=sid,
+            cwd=request.cwd or None,
+            model=params.model or service.route.model,
+            provider=service.route.provider,
+            replay_epoch=service.replay_epoch,
+            created=created.created,
+        )
+
+    async def resume(
+        self, session_id: str, *, editor: EditorPolicy | None = None
+    ) -> SessionSnapshot:
+        service = await self.service()
+        target = session_id
+        if session_id not in service.attached():
+            _root, tip = await run_blocking(
+                store_view.resolve, self.scope, session_id, label="acp lineage"
+            )
+            target = service.current_id(tip)
+        if target not in service.attached():
+            row = await run_blocking(
+                store_view.session_row, self.scope, target, label="acp session row"
+            )
+            cwd = row.get("cwd") if row else None
+            if isinstance(cwd, str) and cwd:
+                self._cwds.setdefault(target, cwd)
+        try:
+            resumed = await service.resume(target)
+            rows = await service.store.load(resumed.session_id)
+        except BaseException as exc:
+            raise _backend_error(exc) from None
+        sid = resumed.session_id
+        if editor is not None and editor.mcp_servers:
+            self._editors[sid] = editor
+        else:
+            self._editors.setdefault(sid, EditorPolicy())
+        self._follow_turns(service, sid)
+        row = await run_blocking(store_view.session_row, self.scope, sid, label="acp session row")
+        cwd = self._cwds.get(sid) or (row.get("cwd") if row else None)
+        title = row.get("title") if row else None
+        model = row.get("model") if row else None
+        return SessionSnapshot(
+            session_id=sid,
+            cwd=cwd if isinstance(cwd, str) and cwd else None,
+            title=title if isinstance(title, str) else None,
+            model=model if isinstance(model, str) and model else service.route.model,
+            provider=service.route.provider,
+            history=tuple(rows),
+            pending=tuple(PendingPrompt(r) for r in resumed.pending_requests),
+            replay_epoch=service.replay_epoch,
+            last_seq=resumed.last_seq,
+        )
+
+    def editor_policy(self, session_id: str) -> EditorPolicy | None:
+        """The editor policy this host holds for a session (memory only)."""
+        service = self._service
+        key = service.current_id(session_id) if service is not None else session_id
+        return self._editors.get(key)
+
+    async def fork(self, session_id: str, *, editor: EditorPolicy | None = None) -> str:
+        service = await self.service()
+        handle = self._handle(service)
+        parent = service.current_id(session_id)
+        if parent not in service.attached():
+            _root, parent = await run_blocking(
+                store_view.resolve, self.scope, session_id, label="acp lineage"
+            )
+        if parent in service.attached() and not service.is_idle(parent):
+            raise BackendError("session_busy", "the session is running a turn; fork it when idle")
+        try:
+            child = await run_blocking(lambda: rewind.branch(handle, parent), label="acp fork")
+        except rewind.BranchRefused as exc:
+            raise BackendError("not_found", str(exc)) from None
+        except BaseException as exc:
+            raise _backend_error(exc) from None
+        chosen = editor if editor is not None and editor.mcp_servers else None
+        self._editors[child] = chosen or self._editors.get(parent, EditorPolicy())
+        if parent in self._cwds:
+            self._cwds[child] = self._cwds[parent]
+        return child
+
+    async def mutate(
+        self, session_id: str, operation: str, payload: Mapping[str, Any]
+    ) -> MutationResult:
+        service = await self.service()
+        sid = service.current_id(session_id)
+        if operation == "workspace":
+            return await self._move(service, sid, str(payload.get("cwd") or ""))
+        if operation == "editor_mcp":
+            specs = payload.get("mcp_servers")
+            servers = tuple(dict(s) for s in specs) if isinstance(specs, list) else ()
+            self._editors[sid] = EditorPolicy(mcp_servers=servers)  # pyright: ignore[reportUnknownArgumentType]
+            return MutationResult("applied")
+        if operation == "branch":
+            servers = payload.get("mcp_servers")
+            editor = (
+                EditorPolicy(mcp_servers=tuple(dict(s) for s in servers))  # pyright: ignore[reportUnknownArgumentType]
+                if isinstance(servers, list) and servers
+                else None
+            )
+            return MutationResult("applied", {"session_id": await self.fork(sid, editor=editor)})
+        if operation == "rename":
+            title = str(payload.get("title") or "").strip()
+            handle = self._handle(service)
+            clean = titles.sanitize(title)
+            try:
+                written = await run_blocking(
+                    lambda: titles.set_title(handle, sid, clean), label="acp title"
+                )
+            except titles.TitleTaken as exc:
+                return MutationResult("refused", {"reason": str(exc)})
+            return MutationResult("applied" if written else "deferred", {"title": clean})
+        if operation == "compress":
+            focus = payload.get("focus")
+            try:
+                outcome = await service.compress(sid, focus if isinstance(focus, str) else None)
+            except BaseException as exc:
+                raise _backend_error(exc) from None
+            return MutationResult(
+                "applied",
+                {"status": outcome.status, "session_id": service.current_id(sid)},
+            )
+        raise BackendError(
+            "mutation_unavailable", f"the {operation} change is not available in --local mode"
+        )
+
+    async def _move(self, service: SessionService, sid: str, cwd: str) -> MutationResult:
+        if not cwd:
+            return MutationResult("refused", {"reason": "no folder given"})
+        attached = sid in service.attached()
+        if attached and not service.is_idle(sid):
+            raise BackendError("session_busy", "the session is running a turn; move it when idle")
+        handle = self._handle(service)
+        await run_blocking(lambda: sessions.set_cwd(handle, sid, cwd), label="acp workspace")
+        self._cwds[sid] = cwd
+        if attached:
+            try:
+                await service.reload(sid)
+            except BaseException as exc:
+                raise _backend_error(exc) from None
+        return MutationResult("applied", {"cwd": cwd})
+
+    async def list_sessions(self, *, limit: int = 1000) -> list[ListedSession]:
+        return await run_blocking(
+            lambda: store_view.listed(self.scope, limit=limit), label="acp session list"
+        )
+
+    # -- turns ------------------------------------------------------------------------------------
+
+    def _follow_turns(self, service: SessionService, sid: str) -> None:
+        if sid in self._watch:
+            return
+        self._watch[sid] = service.subscribe(sid, self._on_event)
+
+    def _on_event(self, event: EventBase) -> None:
+        if isinstance(event, TurnStarted):
+            return
+        if isinstance(event, TurnDone):
+            admission_id = self._by_turn.get(event.turn_id)
+            if admission_id is None:
+                return
+            held = self._turns.get(admission_id)
+            if held is not None:
+                held.admission = replace(
+                    held.admission, state="terminal", outcome=_outcome(event.reason)
+                )
+
+    async def submit(self, session_id: str, text: str, *, input_id: str) -> Admission:
+        service = await self.service()
+        sid = service.current_id(session_id)
+        known = self._inputs.get((sid, input_id))
+        if known is not None and known in self._turns:
+            return self._turns[known].admission
+        try:
+            started = await service.submit(sid, text)
+        except BaseException as exc:
+            raise _backend_error(exc) from None
+        admission = Admission(started.turn_id, started.generation, "started")
+        self._turns[started.turn_id] = _Turn(admission, started.turn_id)
+        self._by_turn[started.turn_id] = started.turn_id
+        self._inputs[(sid, input_id)] = started.turn_id
+        self._follow_turns(service, service.current_id(sid))
+        while len(self._turns) > _KEPT_ADMISSIONS:
+            old, _ = self._turns.popitem(last=False)
+            self._by_turn.pop(old, None)
+        while len(self._inputs) > _KEPT_ADMISSIONS:
+            self._inputs.popitem(last=False)
+        return admission
+
+    async def cancel(self, session_id: str, admission_id: str) -> CancelOutcome:
+        service = await self.service()
+        held = self._turns.get(admission_id)
+        if held is None:
+            return "not_found"
+        if held.admission.state == "terminal":
+            return "settled"
+        result = service.interrupt(session_id, held.admission.generation)
+        return "interrupted" if result.interrupted else "settled"
+
+    async def receipt(self, session_id: str, admission_id: str) -> Admission:
+        held = self._turns.get(admission_id)
+        if held is None:
+            raise BackendError("not_found", "no such admission in this process")
+        return held.admission
+
+    async def answer(
+        self,
+        session_id: str,
+        request_id: str,
+        generation: int | None,
+        answer: Mapping[str, Any],
+    ) -> bool:
+        service = await self.service()
+        try:
+            result = service.answer_server_request(session_id, request_id, answer)
+        except ProtocolError:
+            return False
+        return result.accepted
+
+    async def usage(self, session_id: str) -> UsageInfo | None:
+        service = await self.service()
+        try:
+            agent = service.agent(session_id)
+            size = agent.binding.state.window.tokens
+            used = agent.usage.last_prompt_tokens
+        except Exception:
+            return None
+        if not isinstance(size, int) or size <= 0:
+            return None
+        return UsageInfo(size=size, used=max(int(used or 0), 0))
+
+    async def show_reasoning(self, session_id: str) -> None:
+        return None  # in process the agent's sink carries reasoning deltas already
+
+    def subscribe(self, session_id: str, sink: EventSink) -> Callable[[], None]:
+        service = self._service
+        if service is None:
+            raise BackendError("not_found", "no session is attached in this process")
+        key = session_id
+        try:
+            off_events = service.subscribe(session_id, lambda e: sink.on_event(key, e))
+            off_requests = service.on_request(session_id, lambda r: _request(sink, key, r))
+        except ProtocolError as exc:
+            raise _backend_error(exc) from None
+
+        def off() -> None:
+            off_events()
+            off_requests()
+
+        return off
+
+    def current_id(self, session_id: str) -> str:
+        service = self._service
+        return service.current_id(session_id) if service is not None else session_id
+
+    async def close_session(self, session_id: str) -> None:
+        service = self._service
+        if service is None:
+            return
+        sid = service.current_id(session_id)
+        undo = self._watch.pop(sid, None)
+        if undo is not None:
+            undo()
+        await service.close(sid)
+
+    async def aclose(self) -> None:
+        service, self._service = self._service, None
+        for undo in self._watch.values():
+            undo()
+        self._watch.clear()
+        if service is not None:
+            await service.aclose()
+
+
+def _request(sink: EventSink, key: str, request: object) -> None:
+    if isinstance(request, ServerRequestBase):
+        sink.on_request(key, cast(ServerRequest, request), None)
+
+
+# -- the production service -----------------------------------------------------------------------
+
+
+def build_service(scope: Scope, factory: AgentFactory) -> SessionService:
+    """The profile's in-process service for ACP sessions (see the module notes). Blocking."""
+    from indus.core.turn_state import LoopOptions
+    from indus.providers.auxiliary import AuxClient
+    from indus.providers.route import resolve
+    from indus.service import terminal_host
+    from indus.service.code_host import KernelUpkeep
+    from indus.service.host_inprocess import ALL_KINDS
+    from indus.service.mcp_host import McpUpkeep
+    from indus.service.plugin_host import PluginUpkeep
+    from indus.state import registry
+    from indus.tools.builtin import load_builtins, terminal
+    from indus.tools.registry import ToolRegistry
+
+    route = resolve(scope)
+    handle = registry.acquire(scope)
+    store = StateStore(handle)
+    cwd = Path.cwd()
+    terminal_host.install(handle, terminal.runtime().processes)
+    tool_registry = ToolRegistry(clock=scope.clock)
+    load_builtins(tool_registry)
+    aux = AuxClient(scope, route)
+    options = AgentOptions(
+        platform=PLATFORM,
+        source=SOURCE,
+        cwd=cwd,
+        loop=LoopOptions.from_scope(scope, platform=PLATFORM),
+        session_fields={"cwd": str(cwd), "model": route.model},
+        store=store,
+        registry=tool_registry,
+    )
+    return SessionService(
+        scope,
+        route,
+        toolsets=_toolsets(scope),
+        options=options,
+        store=store,
+        owner=SOURCE,
+        answerable_kinds=ALL_KINDS,
+        agent_factory=factory,
+        aux=aux,
+        kernels=KernelUpkeep(scope, reaper=True),
+        mcp=McpUpkeep(scope, tool_registry, aux=aux, watch=True),
+        plugins=PluginUpkeep(scope, tool_registry, surface="acp", cwd=str(cwd)),
+    )
+
+
+def _toolsets(scope: Scope) -> list[str]:
+    """``platform_toolsets.acp`` when set, else the ACP bundle (P19-13 refines this)."""
+    from indus.foundation.config import load
+
+    try:
+        configured = load(scope).get("platform_toolsets.acp")
+    except Exception:
+        configured = None
+    if isinstance(configured, list) and configured:
+        return [str(name) for name in configured]  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+    return [DEFAULT_TOOLSET]
diff --git a/src/indus/acp/paths.py b/src/indus/acp/paths.py
new file mode 100644
index 0000000..5bf30de
--- /dev/null
+++ b/src/indus/acp/paths.py
@@ -0,0 +1,95 @@
+"""Editor folders: translating a Windows-host cwd under WSL, and comparing two folders (P19-05/07).
+
+An editor running on Windows may hand a WSL-hosted agent its workspace as a drive path
+(``E:\\Projects\\x``) or as a UNC path into the distro (``\\\\wsl.localhost\\Ubuntu\\home\\me``,
+also the older ``\\\\wsl$\\Ubuntu\\…``). Tools and stored sessions need the POSIX form, so
+``translate_cwd`` maps both when this process runs under WSL and leaves every other path alone.
+
+``comparable`` is what two folders are compared by (session listing filters, "did the editor open
+this session from another folder"): ``~`` expanded, a drive path in its ``/mnt/<drive>/`` form (the
+drive letter lowered, also when it was already a mount path), then ``realpath`` so symlinked
+spellings agree — macOS reports ``/var/…`` and ``/tmp/…`` for folders stored as ``/private/var/…``
+and ``/private/tmp/…`` (R09.16). A folder that does not exist compares by its normalised spelling.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from collections.abc import Callable
+from typing import Final
+
+__all__ = ["comparable", "drive_to_mount", "same_folder", "translate_cwd", "unc_to_posix"]
+
+_DRIVE: Final = re.compile(r"^([A-Za-z]):[\\/](.*)$")
+_BARE_DRIVE: Final = re.compile(r"^([A-Za-z]):$")
+_UNC: Final = re.compile(r"^\\\\wsl(?:\.localhost|\$)\\[^\\]+(?:\\(.*))?$", re.IGNORECASE)
+_MOUNT: Final = re.compile(r"^/mnt/([A-Za-z])(/.*)?$")
+
+
+def drive_to_mount(path: str) -> str | None:
+    """``E:\\a\\b`` → ``/mnt/e/a/b`` (``E:`` alone → ``/mnt/e``); None for anything else."""
+    text = path.strip()
+    bare = _BARE_DRIVE.match(text)
+    if bare is not None:
+        return f"/mnt/{bare.group(1).lower()}"
+    found = _DRIVE.match(text)
+    if found is None:
+        return None
+    rest = found.group(2).replace("\\", "/").strip("/")
+    base = f"/mnt/{found.group(1).lower()}"
+    return f"{base}/{rest}" if rest else base
+
+
+def unc_to_posix(path: str) -> str | None:
+    """``\\\\wsl.localhost\\Distro\\home\\me`` → ``/home/me``; None for anything else."""
+    found = _UNC.match(path.strip().replace("/", "\\"))
+    if found is None:
+        return None
+    rest = (found.group(1) or "").replace("\\", "/").strip("/")
+    return "/" + rest
+
+
+def _running_in_wsl() -> bool:
+    from indus.platform.facts import is_wsl
+
+    try:
+        return is_wsl()
+    except Exception:
+        return False
+
+
+def translate_cwd(cwd: str, *, wsl: bool | Callable[[], bool] | None = None) -> str:
+    """The cwd tools and the store should use: under WSL a Windows drive or ``wsl.localhost``
+    path becomes POSIX; otherwise ``cwd`` unchanged. ``wsl`` overrides detection (tests)."""
+    text = str(cwd)
+    under_wsl = wsl() if callable(wsl) else wsl
+    if under_wsl is None:
+        under_wsl = _running_in_wsl()
+    if not under_wsl:
+        return text
+    for translate in (unc_to_posix, drive_to_mount):
+        found = translate(text)
+        if found is not None:
+            return found
+    return text
+
+
+def comparable(cwd: str | None) -> str:
+    """The spelling two folders are compared by (see the module notes)."""
+    text = os.path.expanduser(str(cwd or "").strip() or ".")
+    mounted = drive_to_mount(text)
+    if mounted is not None:
+        text = mounted
+    else:
+        found = _MOUNT.match(text)
+        if found is not None:
+            text = f"/mnt/{found.group(1).lower()}{found.group(2) or ''}"
+    try:
+        return os.path.realpath(text)
+    except (OSError, ValueError):
+        return os.path.normpath(text)
+
+
+def same_folder(a: str | None, b: str | None) -> bool:
+    return comparable(a) == comparable(b)
diff --git a/src/indus/acp/sessions.py b/src/indus/acp/sessions.py
new file mode 100644
index 0000000..2e5bc72
--- /dev/null
+++ b/src/indus/acp/sessions.py
@@ -0,0 +1,257 @@
+"""``session/new`` and the parts every session response shares (P19-05).
+
+New session, in order:
+
+1. the editor's cwd is translated (``paths.translate_cwd``: Windows-host forms under WSL);
+2. the launch flags this process was started with are frozen into the session's launch policy
+   (``creation_policy.launch_flags_from_env``); a safe-mode or ignore-config launch must name an
+   explicit model and provider, or creation is refused before anything is created;
+3. the backend creates the session (random request id, source ``acp``, editor policy
+   ``{mcp_servers, edit_approval_policy: "ask"}`` — the editor's MCP specs stay in memory);
+4. live reasoning is asked for (10 s, failures ignored);
+5. the answer is ``{sessionId, modes, configOptions, _meta.indus.sessionProvenance}``; after it
+   is queued, ``available_commands_update`` and ``usage_update`` follow (R09.9).
+
+The pinned schema (v1.19.0) has no ``models`` field on session responses: the model picker is a
+``select`` config option with ``category: "model"`` (its current value ``provider:model``; the
+full catalogue arrives with P19-12).
+"""
+
+from __future__ import annotations
+
+import logging
+import secrets
+from collections.abc import Mapping, Sequence
+from typing import Any, Final
+
+from indus.acp import paths, store_view
+from indus.acp.agent import INVALID_PARAMS, AcpAgent, AcpError, HeldSession, handler, wire
+from indus.acp.backend import (
+    AcpBackend,
+    BackendError,
+    CreateRequest,
+    EditorPolicy,
+    LaunchPolicy,
+    SessionSnapshot,
+)
+from indus.foundation.blocking import run_blocking
+from indus.service.creation_policy import launch_flags_from_env
+
+__all__ = [
+    "ADVERTISED_COMMANDS",
+    "DEFAULT_MODE",
+    "MODEL_OPTION_ID",
+    "attach",
+    "available_commands",
+    "editor_policy",
+    "launch_policy",
+    "provenance",
+    "session_fields",
+]
+
+log = logging.getLogger(__name__)
+
+DEFAULT_MODE: Final = "default"
+MODEL_OPTION_ID: Final = "model"
+ADVERTISED_COMMANDS: Final[tuple[str, ...]] = (
+    "help",
+    "model",
+    "tools",
+    "compress",
+    "title",
+    "undo",
+    "retry",
+    "steer",
+    "queue",
+    "new",
+    "clear",
+    "usage",
+)
+"""Registry commands an editor is offered until P19-12 owns the list."""
+
+BYPASS_REFUSED: Final = (
+    "Safe mode and ignore-user-config read no profile defaults, so this launch must name both a "
+    "model and a provider, e.g. `INDUS_MODEL=<model> INDUS_PROVIDER=<provider> indus acp` with "
+    "the same switches."
+)
+
+
+# -- inputs ---------------------------------------------------------------------------------------
+
+
+def editor_policy(raw: object) -> EditorPolicy:
+    """The editor's ``mcpServers`` (validated against the vendor models, kept as sent)."""
+    if raw is None:
+        return EditorPolicy()
+    if not isinstance(raw, list):
+        raise AcpError(INVALID_PARAMS, "mcpServers must be a list", {"path": "mcpServers"})
+    from acp.schema import HttpMcpServer, McpServerStdio, SseMcpServer
+    from pydantic import TypeAdapter
+
+    adapter: TypeAdapter[Any] = TypeAdapter(HttpMcpServer | SseMcpServer | McpServerStdio)
+    specs: list[Mapping[str, Any]] = []
+    for item in raw:  # pyright: ignore[reportUnknownVariableType]
+        model = adapter.validate_python(item)
+        specs.append(wire(model))
+    return EditorPolicy(mcp_servers=tuple(specs))
+
+
+def _first(env: Mapping[str, str], *names: str) -> str | None:
+    for name in names:
+        value = env.get(name, "").strip()
+        if value:
+            return value
+    return None
+
+
+def launch_policy(env: Mapping[str, str]) -> LaunchPolicy:
+    """The launch choices of this process (switches from the env, plus an explicit route)."""
+    fields: dict[str, Any] = dict(launch_flags_from_env(env))
+    model = _first(env, "INDUS_MODEL", "INDUS_INFERENCE_MODEL")
+    provider = _first(env, "INDUS_PROVIDER", "INDUS_INFERENCE_PROVIDER")
+    policy = LaunchPolicy(fields)
+    if policy.bypass:
+        if not model or not provider:
+            raise BackendError("creation_refused", BYPASS_REFUSED)
+        fields["model"] = model
+        fields["provider"] = provider
+    return LaunchPolicy(fields)
+
+
+# -- shared response parts ------------------------------------------------------------------------
+
+
+def modes() -> dict[str, Any]:
+    """The one mode both hosts offer (D-16.29): ask before edits."""
+    return {
+        "currentModeId": DEFAULT_MODE,
+        "availableModes": [
+            {"id": DEFAULT_MODE, "name": "Default", "description": "Ask before edits."}
+        ],
+    }
+
+
+def model_option(model: str | None, provider: str | None) -> dict[str, Any] | None:
+    if not model:
+        return None
+    value = f"{provider}:{model}" if provider else model
+    return {
+        "type": "select",
+        "id": MODEL_OPTION_ID,
+        "name": "Model",
+        "category": "model",
+        "currentValue": value,
+        "options": [{"value": value, "name": model}],
+    }
+
+
+def provenance(scope: Any, editor_id: str, session_id: str) -> dict[str, Any] | None:
+    """``_meta`` with ``indus.sessionProvenance`` (blocking; None when the store has no row)."""
+    found = store_view.lineage_of(scope, session_id)
+    if found is None:
+        return None
+    return {
+        "indus": {
+            "sessionProvenance": {
+                "acpSessionId": editor_id,
+                "currentSessionId": found.current,
+                "rootSessionId": found.root,
+                "parentSessionId": found.parent,
+                "sessionKind": "continuation" if found.continuation else "root",
+                "compressionDepth": found.depth,
+            }
+        }
+    }
+
+
+async def session_fields(
+    agent: AcpAgent, backend: AcpBackend, snapshot: SessionSnapshot, editor_id: str
+) -> dict[str, Any]:
+    """``modes``, ``configOptions`` and ``_meta`` of a new/load/resume/fork answer."""
+    fields: dict[str, Any] = {"modes": modes()}
+    option = model_option(snapshot.model, snapshot.provider)
+    if option is not None:
+        fields["configOptions"] = [option]
+    current = backend.current_id(snapshot.session_id)
+    meta = await run_blocking(
+        lambda: provenance(agent.scope, editor_id, current), label="acp provenance"
+    )
+    if meta is not None:
+        fields["_meta"] = meta
+    return fields
+
+
+def available_commands() -> list[dict[str, Any]]:
+    """``availableCommands`` from the shared slash registry (the editor subset)."""
+    from indus.service.commands.registry import REGISTRY
+
+    out: list[dict[str, Any]] = []
+    for name in ADVERTISED_COMMANDS:
+        found = REGISTRY.resolve(name)
+        if found is None or found.name != name:
+            continue
+        entry: dict[str, Any] = {"name": name, "description": found.description}
+        if found.args_hint:
+            entry["input"] = {"hint": found.args_hint}
+        out.append(entry)
+    return out
+
+
+async def notices_after_attach(agent: AcpAgent, held: HeldSession) -> None:
+    """``available_commands_update`` then ``usage_update`` (when the window is known)."""
+    try:
+        await agent.update(
+            held.editor_id,
+            {
+                "sessionUpdate": "available_commands_update",
+                "availableCommands": available_commands(),
+            },
+        )
+        backend = await agent.backend()
+        usage = await backend.usage(held.key)
+        if usage is not None:
+            await agent.update(
+                held.editor_id,
+                {"sessionUpdate": "usage_update", "size": usage.size, "used": usage.used},
+            )
+    except Exception:
+        log.debug("post-attach notices for %s not delivered", held.editor_id, exc_info=True)
+
+
+async def attach(
+    agent: AcpAgent, backend: AcpBackend, snapshot: SessionSnapshot, editor_id: str
+) -> HeldSession:
+    """Hold the session for this editor and subscribe it (once)."""
+    held = agent.sessions.hold(snapshot.session_id, editor_id)
+    held.cwd = snapshot.cwd
+    held.title = snapshot.title
+    if held.unsubscribe is None:
+        held.unsubscribe = backend.subscribe(snapshot.session_id, agent.sink)
+    return held
+
+
+# -- the handler ----------------------------------------------------------------------------------
+
+
+@handler("session/new")
+async def new_session(agent: AcpAgent, params: Mapping[str, Any]) -> dict[str, Any]:
+    from acp.schema import NewSessionRequest, NewSessionResponse
+
+    request = NewSessionRequest.model_validate(params)
+    editor = editor_policy(params.get("mcpServers"))
+    cwd = paths.translate_cwd(request.cwd, wsl=agent.wsl)
+    launch = launch_policy(agent.env)
+    backend = await agent.backend()
+    snapshot = await backend.create(
+        CreateRequest(cwd=cwd, request_id=secrets.token_hex(16), editor=editor, launch=launch)
+    )
+    held = await attach(agent, backend, snapshot, snapshot.session_id)
+    await backend.show_reasoning(snapshot.session_id)
+    fields = await session_fields(agent, backend, snapshot, held.editor_id)
+    response = NewSessionResponse.model_validate({"sessionId": held.editor_id, **fields})
+    agent.after_reply(lambda: notices_after_attach(agent, held))
+    return wire(response)
+
+
+def server_names(specs: Sequence[Mapping[str, Any]]) -> list[str]:
+    return [str(spec.get("name", "")) for spec in specs]
