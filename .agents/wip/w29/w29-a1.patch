index 0000000..851f735
--- /dev/null
+++ b/tests/fakes/daemon.py
@@ -0,0 +1,127 @@
+"""A daemon for ACP attached-host tests: the real P17 endpoint plus stand-in methods (P19).
+
+``AcpDaemon`` is the real ``DaemonSessionHost`` and WebSocket endpoint over the fake model (the
+P17 ``Rig``, reached in-loop through the ASGI double), with:
+
+- ``describe()``: what the control socket's ``describe`` answers (profile id, instance id,
+  creatable sources, capabilities); ``capabilities`` and ``profile_id`` can be changed per test;
+- stand-ins for methods P17-25 adds to the daemon's WebSocket and an ACP client already calls:
+  ``session.mutate`` (``editor_mcp``, ``branch``, ``workspace``), ``config.set`` and
+  ``session.usage``. They are answered by a shim in the transport, against the daemon's own store,
+  before the frame would reach the endpoint (which answers ``-32601`` for them). ``shim = False``
+  turns them off (today's daemon).
+
+Every call to a stand-in is recorded in ``calls``. Nothing here is product code.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.scope import Scope
+from indus.protocol.attach import ACP_EDITOR_POLICY
+from indus.service.remote.channel import Dialed
+from indus.state import rewind, sessions
+from indus.state.registry import StoreHandle
+from tests.fakes.model import Turn
+from tests.unit.service.remote.wire import AsgiTransport, Rig, rig
+
+__all__ = ["AcpDaemon", "open_daemon"]
+
+STAND_INS = frozenset({"session.mutate", "config.set", "session.usage"})
+
+
+class AcpDaemon:
+    def __init__(self, inner: Rig, store: StoreHandle) -> None:
+        self.rig = inner
+        self.store = store
+        self.shim = True
+        self.profile_id = inner.book.profile_id
+        self.capabilities: list[str] = [*inner.host.capabilities(), ACP_EDITOR_POLICY]
+        self.sources: list[str] = list(inner.host.creatable_sources())
+        self.calls: list[tuple[str, dict[str, Any]]] = []
+        self.editor_mcp: dict[str, list[dict[str, Any]]] = {}
+        self.usage = {"context_window": 200000, "context_tokens": 1234}
+        self.up = True
+
+    @property
+    def host(self) -> Any:
+        return self.rig.host
+
+    async def describe(self) -> Mapping[str, Any] | None:
+        if not self.up:
+            return None
+        return {
+            "profile_id": self.profile_id,
+            "instance_id": self.rig.book.instance_id,
+            "creatable_sources": list(self.sources),
+            "capabilities": list(self.capabilities),
+        }
+
+    async def dial(self) -> Dialed:
+        dialed = await self.rig.dial()
+        transport = dialed.transport
+        assert isinstance(transport, AsgiTransport)
+        original = transport.send
+
+        async def send(text: str) -> None:
+            frame = json.loads(text)
+            method = frame.get("method")
+            if self.shim and method in STAND_INS and "id" in frame and not transport.dead:
+                params = dict(frame.get("params") or {})
+                self.calls.append((str(method), params))
+                reply: dict[str, Any] = {"jsonrpc": "2.0", "id": frame["id"]}
+                try:
+                    reply["result"] = self._answer(str(method), params)
+                except KeyError as exc:
+                    reply["error"] = {"code": 2001, "message": f"no session {exc}"}
+                transport.sent.append(frame)
+                await transport.client._from_app.put(  # pyright: ignore[reportPrivateUsage]
+                    {"type": "websocket.send", "text": json.dumps(reply)}
+                )
+                return
+            await original(text)
+
+        transport.send = send  # type: ignore[method-assign]
+        return dialed
+
+    def _answer(self, method: str, params: dict[str, Any]) -> dict[str, Any]:
+        sid = str(params.get("session_id", ""))
+        if method == "config.set":
+            return {"applied": "session", "value": params.get("value")}
+        if method == "session.usage":
+            return {"usage": dict(self.usage)}
+        operation = params.get("operation")
+        payload = dict(params.get("payload") or {})
+        if operation == "editor_mcp":
+            self.editor_mcp[sid] = list(payload.get("mcp_servers") or [])
+            return {"status": "applied"}
+        if operation == "branch":
+            if sessions.get(self.store, sid) is None:
+                raise KeyError(sid)
+            child = rewind.branch(self.store, sid)
+            servers = payload.get("mcp_servers")
+            self.editor_mcp[child] = (
+                list(servers) if servers else list(self.editor_mcp.get(sid, []))
+            )
+            return {"status": "applied", "session_id": child}
+        if operation == "workspace":
+            sessions.set_cwd(self.store, sid, str(payload.get("cwd")))
+            return {"status": "applied", "cwd": payload.get("cwd")}
+        return {"status": "refused", "reason": f"unknown operation {operation}"}
+
+    async def close(self) -> None:
+        await self.rig.close()
+
+
+async def open_daemon(
+    scope: Scope,
+    store: StoreHandle,
+    tmp_path: Path,
+    *turns: Turn,
+    tools: dict[str, Any] | None = None,
+) -> AcpDaemon:
+    return AcpDaemon(await rig(scope, store, tmp_path, *turns, tools=tools), store)
