+def test_stderr_log_stamps_redacts_and_rotates(tmp_path: Path) -> None:
+    path = tmp_path / "logs" / "mcp-stderr.log"
+    sink = StderrLog(path, max_bytes=400, backups=2)
+    secret = forge_token()
