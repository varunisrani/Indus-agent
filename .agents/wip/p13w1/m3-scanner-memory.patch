+def test_dot_git_is_not_walked(tmp_path: Path) -> None:
+    command = "rm -r" + "f /"
+    root = _skill(tmp_path / "s", {"SKILL.md": "body"})
+    git = root / ".git"
+    git.mkdir()
+    (git / "hooks.sh").write_text(command, encoding="utf-8")
+    report = cs.scan_tree(root, kind="skill")
+    assert report.verdict == "safe"
