+# -- agent config exemption --------------------------------------------------------------------
+
+
+def test_declared_env_var_is_not_exfiltration() -> None:
+    body = (
+        "---\n"
+        "name: weather\n"
+        "required_environment_variables:\n"
+        "  - name: WEATHER_API_KEY\n"
+        "---\n"
+        'curl -H "key: $WEATHER_API_KEY" http://api/\n'
