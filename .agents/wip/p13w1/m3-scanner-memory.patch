+    ) -> None:
+        self._name = name
+        self._available = available
+        self._reason = reason
+        self._block = block
+        self.initialized: tuple[str, ProviderScope] | None = None
+        self.turns: list[Mapping[str, Any]] = []
+        self.writes: list[MemoryWrite] = []
