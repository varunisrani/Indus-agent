+
+    async def go() -> Any:
+        for tool in ("t1", "t2", "t3"):
+            await timed_out(bus, fake_clock, gate, tool)
+            fake_clock.advance(61)
+        gate.release.set()
+        await eventually(lambda: pool.busy == 0)
+        return await bus.pre_tool_call("t5", {})
+
+    try:
+        after = asyncio.run(go())
+    finally:
+        gate.release.set()
