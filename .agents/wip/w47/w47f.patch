+    assert printf is not None
+    sh_keys = re.findall(r'"([a-z_]+)":', printf.group(1))
+    complete = _ps_function("Invoke-IndusComplete")
+    record = re.search(r"\$record = \[ordered\]@\{(?P<body>.*?)\n    \}", complete, re.DOTALL)
