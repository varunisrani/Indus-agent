+    ctx = context(scope, run=run)
+    assert (
+        run_finish(request_file(tmp_path, scope.root, checkout), ctx, no_gateway_restart=True) == 0
+    )
+    receipt = final_receipt(scope.root)
+    assert len(calls) == 1 and outcomes(receipt)["web_pages"] == "skipped"
+    assert receipt["owed"] == []
