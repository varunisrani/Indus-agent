+++ b/tests/fakes/platform/discord_wire.py
@@ -0,0 +1,392 @@
+"""A fake of the Discord library surface our adapter touches (P15-01).
+
+Shapes follow discord.py: a client whose ``get_channel`` returns messageable channels; channels
+``send(content, reference=, view=, allowed_mentions=)`` and yield ``typing()``; messages
+``edit``, ``delete``, ``add_reaction``, ``create_thread``. Errors are raised as stand-ins named
+like the library's (``HTTPException`` with ``status``/``code``/``text``, ``Forbidden``,
+``NotFound``). Inbound traffic arrives through the ``on_message`` / ``on_interaction`` handlers
+the adapter registers, delivered by ``dispatch_pending()``. Cap: 2,000 code points.
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Awaitable, Callable
+from contextlib import asynccontextmanager
+from dataclasses import dataclass, field
+from typing import Any
+
+from tests.fakes.platform.core import (
+    Button,
+    FailureKind,
+    FakeChatPlatform,
+    FakeInbound,
+    FakeMedia,
+    FakePlatformError,
+)
+
+MAX_LEN = 2000
+
+SURFACE: dict[str, tuple[str, ...]] = {
+    "discord:Client": ("start", "close", "wait_until_ready", "get_channel", "fetch_channel"),
+    "discord:Intents": ("default", "message_content", "dm_messages", "guild_messages", "members"),
+    "discord.abc:Messageable": ("send", "typing", "fetch_message"),
+    "discord:Message": ("edit", "delete", "add_reaction", "remove_reaction", "create_thread"),
+    "discord:AllowedMentions": ("none",),
+    "discord:HTTPException": (),
+    "discord:Forbidden": (),
+    "discord:NotFound": (),
+    "discord.ui:View": ("add_item",),
+    "discord.ui:Button": (),
+    "discord.app_commands:CommandTree": ("sync", "add_command", "clear_commands"),
+}
+
+
+class DiscordException(Exception):
+    pass
+
+
+class HTTPException(DiscordException):
+    def __init__(self, status: int, code: int, text: str) -> None:
+        super().__init__(f"{status} (error code: {code}): {text}")
+        self.status = status
+        self.code = code
+        self.text = text
+
+
+class Forbidden(HTTPException):
+    pass
+
+
+class NotFound(HTTPException):
+    pass
+
+
+def _translate(exc: FakePlatformError) -> Exception:
+    kind = exc.kind
+    if kind is FailureKind.RATE_LIMIT:
+        return HTTPException(429, 0, "You are being rate limited.")
+    if kind is FailureKind.FORBIDDEN:
+        return Forbidden(403, 50007, "Cannot send messages to this user")
+    if kind is FailureKind.CHAT_NOT_FOUND:
+        return NotFound(404, 10003, "Unknown Channel")
+    if kind is FailureKind.THREAD_NOT_FOUND:
+        return NotFound(404, 10008, "Unknown Message")
+    if kind is FailureKind.TOO_LONG:
+        return HTTPException(400, 50035, "Invalid Form Body: Must be 2000 or fewer in length.")
+    if kind is FailureKind.READ_TIMEOUT:
+        return TimeoutError()
+    if kind is FailureKind.CONNECT_TIMEOUT:
+        return ConnectionRefusedError("Cannot connect to host discord.com:443")
+    return HTTPException(400, 50035, "Invalid Form Body")
+
+
+@dataclass(frozen=True)
+class AllowedMentions:
+    everyone: bool = False
+    users: bool = False
+    roles: bool = False
+
+    @classmethod
+    def none(cls) -> AllowedMentions:
+        return cls()
+
+
+@dataclass(frozen=True)
+class Intents:
+    message_content: bool = False
+    dm_messages: bool = True
+    guild_messages: bool = True
+    members: bool = False
+
+    @classmethod
+    def default(cls) -> Intents:
+        return cls()
+
+
+@dataclass(frozen=True)
+class Author:
+    id: int
+    name: str
+    bot: bool = False
+
+
+@dataclass(frozen=True)
+class Attachment:
+    filename: str
+    url: str
+    content_type: str
+
+
+@dataclass(frozen=True)
+class MessageReference:
+    message_id: int
+
+
+@dataclass
+class View:
+    """``discord.ui.View`` stand-in: buttons with ``custom_id``."""
+
+    items: list[Button] = field(default_factory=list[Button])
+
+    def add_item(self, item: Button) -> None:
+        self.items.append(item)
+
+
+def _wrap[T](coro: Awaitable[T]) -> Awaitable[T]:
+    async def run() -> T:
+        try:
+            return await coro
+        except FakePlatformError as exc:
+            raise _translate(exc) from None
+
+    return run()
+
+
+@dataclass
+class DiscordMessage:
+    id: int
+    channel: Channel
+    content: str
+    author: Author
+    reference: MessageReference | None = None
+    attachments: tuple[Attachment, ...] = ()
+    mentions_bot: bool = False
+    created_at: Any = None
+
+    async def edit(self, content: str | None = None, view: View | None = None) -> DiscordMessage:
+        buttons = tuple(view.items) if view is not None else None
+        text = content if content is not None else self.content
+        await _wrap(
+            self.channel.wire.platform.edit(
+                str(self.channel.id), str(self.id), text, buttons=buttons
+            )
+        )
+        self.content = text
+        return self
+
+    async def delete(self) -> None:
+        await _wrap(self.channel.wire.platform.delete(str(self.channel.id), str(self.id)))
+
+    async def add_reaction(self, emoji: str) -> None:
+        await _wrap(self.channel.wire.platform.react(str(self.channel.id), str(self.id), emoji))
+
+    async def remove_reaction(self, emoji: str, member: Any = None) -> None:
+        self.channel.wire.removed_reactions.append((self.id, emoji))
+
+    async def create_thread(self, name: str, auto_archive_duration: int = 1440) -> Channel:
+        thread_id = self.id  # Discord: a thread started from a message reuses its id
+        self.channel.wire.threads.append((thread_id, name, auto_archive_duration))
+        return self.channel.wire.channel(thread_id, kind="thread", parent=self.channel.id)
+
+
+@dataclass
+class Channel:
+    id: int
+    wire: DiscordWire
+    kind: str = "text"  # text, dm, thread
+    parent_id: int | None = None
+    guild_id: int | None = None
+
+    async def send(
+        self,
+        content: str | None = None,
+        *,
+        reference: MessageReference | DiscordMessage | None = None,
+        view: View | None = None,
+        allowed_mentions: AllowedMentions | None = None,
+        file: Any = None,
+    ) -> DiscordMessage:
+        self.wire.sent_allowed_mentions.append(allowed_mentions)
+        reply_to = (
+            str(reference.message_id if isinstance(reference, MessageReference) else reference.id)
+            if reference
+            else None
+        )
+        if file is not None:
+            media = FakeMedia("document", str(file), caption=content or "")
+            sent = await _wrap(self.wire.platform.upload(str(self.id), media, reply_to=reply_to))
+        else:
+            buttons = tuple(view.items) if view is not None else ()
+            sent = await _wrap(
+                self.wire.platform.post(
+                    str(self.id), content or "", reply_to=reply_to, buttons=buttons
+                )
+            )
+        bot = Author(int(self.wire.platform.bot_user_id), self.wire.platform.bot_name, True)
+        return DiscordMessage(int(sent.message_id), self, sent.text, bot)
+
+    @asynccontextmanager
+    async def typing(self) -> AsyncIterator[None]:
+        await _wrap(self.wire.platform.typing(str(self.id)))
+        yield
+
+    async def fetch_message(self, message_id: int) -> DiscordMessage:
+        found = self.wire.platform.message(str(message_id))
+        if found is None or found.deleted:
+            raise NotFound(404, 10008, "Unknown Message")
+        author = Author(int(self.wire.platform.bot_user_id), "bot", found.from_bot)
+        return DiscordMessage(message_id, self, found.text, author)
+
+
+@dataclass
+class Interaction:
+    """A component press: ``custom_id`` in ``data``."""
+
+    id: str
+    user: Author
+    channel: Channel
+    data: dict[str, Any]
+    message: DiscordMessage | None = None
+
+
+class CommandTree:
+    """``discord.app_commands.CommandTree`` stand-in: records registrations and syncs."""
+
+    def __init__(self, client: FakeClient) -> None:
+        self.client = client
+        self.commands: list[Any] = []
+        self.synced: list[list[str]] = []
+
+    def add_command(self, command: Any) -> None:
+        self.commands.append(command)
+
+    def clear_commands(self, *, guild: Any = None) -> None:
+        self.commands.clear()
+
+    async def sync(self, *, guild: Any = None) -> list[Any]:
+        names = [str(getattr(c, "name", c)) for c in self.commands]
+        self.synced.append(names)
+        return list(self.commands)
+
+
+class FakeClient:
+    """``discord.Client`` stand-in: ``start`` connects, handlers receive inbound traffic."""
+
+    def __init__(self, wire: DiscordWire, intents: Intents | None = None) -> None:
+        self.wire = wire
+        self.intents = intents or Intents.default()
+        self.handlers: dict[str, Callable[..., Awaitable[None]]] = {}
+        self.user = Author(int(wire.platform.bot_user_id), wire.platform.bot_name, True)
+        self.tree = CommandTree(self)
+
+    def event(self, fn: Callable[..., Awaitable[None]]) -> Callable[..., Awaitable[None]]:
+        self.handlers[fn.__name__] = fn
+        return fn
+
+    async def start(self, token: str) -> None:
+        await _wrap(self.wire.platform.connect())
+
+    async def wait_until_ready(self) -> None:
+        return None
+
+    async def close(self) -> None:
+        await self.wire.platform.disconnect()
+
+    def get_channel(self, channel_id: int) -> Channel | None:
+        return self.wire.channel(channel_id)
+
+    async def fetch_channel(self, channel_id: int) -> Channel:
+        return self.wire.channel(channel_id)
+
+
+class DiscordWire:
+    SURFACE = SURFACE
+    # Which fake stands in for each surface object (the wire self-check reads it).
+    FAKES: dict[str, type] = {}
+
+    def __init__(self, platform: FakeChatPlatform | None = None) -> None:
+        self.platform = platform or FakeChatPlatform("discord", max_len=MAX_LEN, bot_user_id="900")
+        self._channels: dict[int, Channel] = {}
+        self.threads: list[tuple[int, str, int]] = []
+        self.removed_reactions: list[tuple[int, str]] = []
+        self.sent_allowed_mentions: list[AllowedMentions | None] = []
+        self.client = FakeClient(self)
+
+    def channel(self, channel_id: int, *, kind: str = "text", parent: int | None = None) -> Channel:
+        found = self._channels.get(int(channel_id))
+        if found is None:
+            found = Channel(int(channel_id), self, kind, parent)
+            self._channels[found.id] = found
+        return found
+
+    def _message(self, item: FakeInbound) -> DiscordMessage:
+        kind = {"dm": "dm", "thread": "thread"}.get(item.chat_kind, "text")
+        channel = self.channel(int(item.thread_id or item.chat_id), kind=kind)
+        if item.chat_kind == "thread":
+            channel.parent_id = int(item.chat_id)
+        if item.guild_id is not None:
+            channel.guild_id = int(item.guild_id)
+        author = Author(int(item.user_id), item.user_name or item.user_id, item.is_bot)
+        attachments = tuple(
+            Attachment(m.ref, f"https://cdn.example/{m.ref}", m.mime) for m in item.media
+        )
+        reference = MessageReference(int(item.reply_to)) if item.reply_to else None
+        return DiscordMessage(
+            int(item.message_id or 0),
+            channel,
+            item.text,
+            author,
+            reference,
+            attachments,
+            item.mentions_bot,
+            item.at,
+        )
+
+    async def dispatch_pending(self) -> int:
+        """Deliver every queued inbound update to the registered handlers."""
+        delivered = 0
+        for item in self.platform.drain_inbound():
+            message = self._message(item)
+            if item.event == "button":
+                handler = self.client.handlers.get("on_interaction")
+                interaction = Interaction(
+                    str(item.button_id),
+                    message.author,
+                    message.channel,
+                    {"custom_id": item.button_data},
+                    None,
+                )
+                if handler is not None:
+                    await handler(interaction)
+            else:
+                name = "on_message_edit" if item.event == "edited" else "on_message"
+                handler = self.client.handlers.get(name)
+                if handler is not None:
+                    if name == "on_message_edit":
+                        await handler(message, message)
+                    else:
+                        await handler(message)
+            delivered += 1
+        return delivered
+
+
+DiscordWire.FAKES = {
+    "discord:Client": FakeClient,
+    "discord:Intents": Intents,
+    "discord.abc:Messageable": Channel,
+    "discord:Message": DiscordMessage,
+    "discord:AllowedMentions": AllowedMentions,
+    "discord:HTTPException": HTTPException,
+    "discord:Forbidden": Forbidden,
+    "discord:NotFound": NotFound,
+    "discord.ui:View": View,
+    "discord.ui:Button": Button,
+    "discord.app_commands:CommandTree": CommandTree,
+}
+
+__all__ = [
+    "SURFACE",
+    "CommandTree",
+    "AllowedMentions",
+    "Author",
+    "Channel",
+    "DiscordMessage",
+    "DiscordWire",
+    "FakeClient",
+    "Forbidden",
+    "HTTPException",
+    "Intents",
+    "Interaction",
+    "NotFound",
+    "View",
+]
diff --git a/tests/fakes/platform/slack_wire.py b/tests/fakes/platform/slack_wire.py
new file mode 100644
index 0000000..6314f78
--- /dev/null
+++ b/tests/fakes/platform/slack_wire.py
@@ -0,0 +1,377 @@
+"""A fake of the Slack library surface our adapter touches (P15-01).
+
+Shapes follow slack-sdk / slack-bolt: an async Web API client whose methods take keyword
+arguments and answer dict-like responses (``{"ok": True, "ts": ..., "channel": ...}``); errors
+raise a ``SlackApiError`` stand-in carrying ``response["error"]`` (``ratelimited`` with a
+``Retry-After`` header, ``channel_not_found``, ``not_in_channel``, ``msg_too_long``,
+``invalid_blocks``, ...). Inbound events are Events API payloads (``message``, ``app_mention``
+sharing one ``ts``, ``bot_message`` subtype, ``block_actions`` for buttons) handed to the
+handlers the adapter registers on the fake app by ``dispatch_pending()``. Cap: 39,000.
+"""
+
+from __future__ import annotations
+
+import itertools
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass, field
+from typing import Any
+
+from tests.fakes.platform.core import (
+    Button,
+    FailureKind,
+    FakeChatPlatform,
+    FakeInbound,
+    FakeMedia,
+    FakeMessage,
+    FakePlatformError,
+)
+
+MAX_LEN = 39000
+
+SURFACE: dict[str, tuple[str, ...]] = {
+    "slack_sdk.web.async_client:AsyncWebClient": (
+        "auth_test",
+        "chat_postMessage",
+        "chat_update",
+        "chat_delete",
+        "chat_postEphemeral",
+        "reactions_add",
+        "reactions_remove",
+        "files_upload_v2",
+        "conversations_replies",
+        "users_info",
+        "assistant_threads_setStatus",
+    ),
+    "slack_sdk.errors:SlackApiError": (),
+    "slack_bolt.app.async_app:AsyncApp": ("event", "action", "client"),
+    "slack_bolt.adapter.socket_mode.async_handler:AsyncSocketModeHandler": (
+        "connect_async",
+        "start_async",
+        "close_async",
+    ),
+}
+
+
+class SlackResponse(dict[str, Any]):
+    """Dict-like response with ``headers`` (``Retry-After`` on rate limits)."""
+
+    def __init__(self, data: dict[str, Any], headers: dict[str, str] | None = None) -> None:
+        super().__init__(data)
+        self.headers = headers or {}
+
+
+class SlackApiError(Exception):
+    def __init__(self, message: str, response: SlackResponse) -> None:
+        super().__init__(f"{message}\nThe server responded with: {dict(response)}")
+        self.response = response
+
+
+def _error_code(exc: FakePlatformError) -> str:
+    return {
+        FailureKind.RATE_LIMIT: "ratelimited",
+        FailureKind.CHAT_NOT_FOUND: "channel_not_found",
+        FailureKind.THREAD_NOT_FOUND: "thread_not_found",
+        FailureKind.FORBIDDEN: "not_in_channel",
+        FailureKind.PARSE_ERROR: "invalid_blocks",
+        FailureKind.TOO_LONG: "msg_too_long",
+    }.get(exc.kind, "internal_error")
+
+
+def _translate(exc: FakePlatformError) -> Exception:
+    if exc.kind is FailureKind.READ_TIMEOUT:
+        return TimeoutError()
+    if exc.kind is FailureKind.CONNECT_TIMEOUT:
+        return ConnectionResetError("Cannot connect to host slack.com:443")
+    code = _error_code(exc)
+    headers = {"Retry-After": str(int(exc.retry_after or 5))} if code == "ratelimited" else {}
+    response = SlackResponse({"ok": False, "error": code}, headers)
+    return SlackApiError("The request to the Slack API failed.", response)
+
+
+def _ts(message: FakeMessage | FakeInbound) -> str:
+    return f"1700000000.{int(message.message_id or 0):06d}"
+
+
+def _id_of(ts: str | None) -> str | None:
+    if not ts:
+        return None
+    return str(int(ts.split(".", 1)[1]))
+
+
+@dataclass
+class FakeWebClient:
+    """``AsyncWebClient`` stand-in over a `FakeChatPlatform`; ids are ``ts`` strings."""
+
+    wire: SlackWire
+    calls: list[tuple[str, dict[str, Any]]] = field(
+        default_factory=list[tuple[str, dict[str, Any]]]
+    )
+
+    async def _do(self, name: str, kwargs: dict[str, Any], coro: Any) -> Any:
+        self.calls.append((name, kwargs))
+        try:
+            return await coro
+        except FakePlatformError as exc:
+            raise _translate(exc) from None
+
+    async def auth_test(self) -> SlackResponse:
+        platform = self.wire.platform
+        await self._do("auth_test", {}, platform.connect())
+        return SlackResponse(
+            {
+                "ok": True,
+                "user_id": platform.bot_user_id,
+                "team_id": self.wire.team_id,
+                "bot_id": "B" + platform.bot_user_id,
+            }
+        )
+
+    async def chat_postMessage(  # noqa: N802 (vendor method name)
+        self,
+        *,
+        channel: str,
+        text: str = "",
+        thread_ts: str | None = None,
+        blocks: list[dict[str, Any]] | None = None,
+        **kw: Any,
+    ) -> SlackResponse:
+        buttons = tuple(
+            Button(str(e.get("text", {}).get("text", "")), str(e.get("action_id", "")))
+            for b in blocks or ()
+            if b.get("type") == "actions"
+            for e in b.get("elements", ())
+        )
+        sent = await self._do(
+            "chat_postMessage",
+            {"channel": channel, "text": text, "thread_ts": thread_ts, "blocks": blocks, **kw},
+            self.wire.platform.post(channel, text, thread_id=_id_of(thread_ts), buttons=buttons),
+        )
+        return SlackResponse({"ok": True, "channel": channel, "ts": _ts(sent)})
+
+    async def chat_update(  # noqa: N802
+        self, *, channel: str, ts: str, text: str = "", **kw: Any
+    ) -> SlackResponse:
+        await self._do(
+            "chat_update",
+            {"channel": channel, "ts": ts, "text": text, **kw},
+            self.wire.platform.edit(channel, str(_id_of(ts)), text),
+        )
+        return SlackResponse({"ok": True, "channel": channel, "ts": ts})
+
+    async def chat_delete(self, *, channel: str, ts: str) -> SlackResponse:  # noqa: N802
+        await self._do(
+            "chat_delete",
+            {"channel": channel, "ts": ts},
+            self.wire.platform.delete(channel, str(_id_of(ts))),
+        )
+        return SlackResponse({"ok": True})
+
+    async def chat_postEphemeral(  # noqa: N802
+        self, *, channel: str, user: str, text: str, **kw: Any
+    ) -> SlackResponse:
+        self.calls.append(("chat_postEphemeral", {"channel": channel, "user": user, "text": text}))
+        self.wire.ephemeral.append((channel, user, text))
+        return SlackResponse({"ok": True, "message_ts": "1700000000.999999"})
+
+    async def reactions_add(self, *, channel: str, timestamp: str, name: str) -> SlackResponse:
+        await self._do(
+            "reactions_add",
+            {"channel": channel, "timestamp": timestamp, "name": name},
+            self.wire.platform.react(channel, str(_id_of(timestamp)), name),
+        )
+        return SlackResponse({"ok": True})
+
+    async def reactions_remove(self, *, channel: str, timestamp: str, name: str) -> SlackResponse:
+        self.calls.append(("reactions_remove", {"channel": channel, "timestamp": timestamp}))
+        return SlackResponse({"ok": True})
+
+    async def files_upload_v2(
+        self,
+        *,
+        channel: str,
+        file: str,
+        initial_comment: str = "",
+        thread_ts: str | None = None,
+        **kw: Any,
+    ) -> SlackResponse:
+        media = FakeMedia("document", str(file), caption=initial_comment)
+        sent = await self._do(
+            "files_upload_v2",
+            {"channel": channel, "file": file, **kw},
+            self.wire.platform.upload(channel, media, thread_id=_id_of(thread_ts)),
+        )
+        return SlackResponse({"ok": True, "files": [{"id": f"F{sent.message_id}"}]})
+
+    async def conversations_replies(self, *, channel: str, ts: str, **kw: Any) -> SlackResponse:
+        self.calls.append(("conversations_replies", {"channel": channel, "ts": ts}))
+        root = self.wire.platform.message(str(_id_of(ts)))
+        messages = [{"ts": ts, "text": root.text}] if root is not None else []
+        return SlackResponse({"ok": True, "messages": messages})
+
+    async def users_info(self, *, user: str) -> SlackResponse:
+        self.calls.append(("users_info", {"user": user}))
+        return SlackResponse({"ok": True, "user": {"id": user, "name": f"user-{user}"}})
+
+    async def assistant_threads_setStatus(  # noqa: N802
+        self, *, channel_id: str, thread_ts: str, status: str
+    ) -> SlackResponse:
+        await self._do(
+            "assistant_threads_setStatus",
+            {"channel_id": channel_id, "thread_ts": thread_ts, "status": status},
+            self.wire.platform.typing(channel_id, thread_id=_id_of(thread_ts)),
+        )
+        return SlackResponse({"ok": True})
+
+
+Handler = Callable[..., Awaitable[None]]
+
+
+class FakeApp:
+    """``AsyncApp`` stand-in: ``event(name)`` / ``action(id)`` decorators register handlers."""
+
+    def __init__(self, wire: SlackWire) -> None:
+        self.wire = wire
+        self.events: dict[str, Handler] = {}
+        self.actions: dict[str, Handler] = {}
+
+    @property
+    def client(self) -> FakeWebClient:
+        return self.wire.client
+
+    def event(self, name: str) -> Callable[[Handler], Handler]:
+        def register(fn: Handler) -> Handler:
+            self.events[name] = fn
+            return fn
+
+        return register
+
+    def action(self, action_id: str) -> Callable[[Handler], Handler]:
+        def register(fn: Handler) -> Handler:
+            self.actions[action_id] = fn
+            return fn
+
+        return register
+
+
+class FakeSocketModeHandler:
+    """``AsyncSocketModeHandler`` stand-in: connecting checks the app token with the platform."""
+
+    def __init__(self, app: FakeApp, app_token: str) -> None:
+        self.app = app
+        self.app_token = app_token
+        self.connected = False
+
+    async def connect_async(self) -> None:
+        try:
+            await self.app.wire.platform.connect()
+        except FakePlatformError as exc:
+            raise _translate(exc) from None
+        self.connected = True
+
+    async def start_async(self) -> None:
+        await self.connect_async()
+
+    async def close_async(self) -> None:
+        self.connected = False
+        await self.app.wire.platform.disconnect()
+
+
+class SlackWire:
+    SURFACE = SURFACE
+    FAKES: dict[str, type] = {}
+
+    def __init__(self, platform: FakeChatPlatform | None = None, *, team_id: str = "T1") -> None:
+        self.platform = platform or FakeChatPlatform("slack", max_len=MAX_LEN, bot_user_id="U0BOT")
+        self.team_id = team_id
+        self.client = FakeWebClient(self)
+        self.app = FakeApp(self)
+        self.ephemeral: list[tuple[str, str, str]] = []
+        self._envelopes = itertools.count(1)
+
+    def handler(self, app_token: str) -> FakeSocketModeHandler:
+        return FakeSocketModeHandler(self.app, app_token)
+
+    def payloads(self, item: FakeInbound) -> list[tuple[str, dict[str, Any]]]:
+        """Events API payloads for one inbound update (a mention yields two sharing one ts)."""
+        team = item.scope_id or self.team_id
+        ts = _ts(item)
+        if item.event == "button":
+            body = {
+                "type": "block_actions",
+                "team": {"id": team},
+                "user": {"id": item.user_id},
+                "channel": {"id": item.chat_id},
+                "actions": [{"action_id": item.button_data, "value": item.button_data}],
+                "message": {"ts": f"1700000000.{int(item.message_id or 0):06d}"},
+            }
+            return [("action", body)]
+        event: dict[str, Any] = {
+            "type": "message",
+            "channel": item.chat_id,
+            "channel_type": "im" if item.chat_kind == "dm" else "channel",
+            "text": item.text,
+            "ts": ts,
+            "team": team,
+        }
+        if item.is_bot:
+            event.update(subtype="bot_message", bot_id=item.user_id)
+        else:
+            event["user"] = item.user_id
+        if item.thread_id:
+            event["thread_ts"] = f"1700000000.{int(item.thread_id):06d}"
+        if item.event == "edited":
+            event = {
+                "type": "message",
+                "subtype": "message_changed",
+                "channel": item.chat_id,
+                "message": {**event, "edited": {"ts": ts}},
+                "ts": ts,
+                "team": team,
+            }
+        if item.media:
+            event["files"] = [
+                {"name": m.ref, "mimetype": m.mime, "url_private": f"https://files.example/{m.ref}"}
+                for m in item.media
+            ]
+        out = [("message", event)]
+        if item.mentions_bot and item.event == "message":
+            out.append(("app_mention", {**event, "type": "app_mention"}))
+        return out
+
+    async def dispatch_pending(self) -> int:
+        delivered = 0
+        for item in self.platform.drain_inbound():
+            for kind, body in self.payloads(item):
+                if kind == "action":
+                    action_id = body["actions"][0]["action_id"]
+                    handler = self.app.actions.get(action_id) or self.app.actions.get("*")
+                    if handler is not None:
+                        await handler(body=body, ack=_ack)
+                else:
+                    handler = self.app.events.get(kind)
+                    if handler is not None:
+                        await handler(event=body, say=None)
+            delivered += 1
+        return delivered
+
+
+async def _ack(*args: Any, **kwargs: Any) -> None:
+    return None
+
+
+SlackWire.FAKES = {
+    "slack_sdk.web.async_client:AsyncWebClient": FakeWebClient,
+    "slack_sdk.errors:SlackApiError": SlackApiError,
+    "slack_bolt.app.async_app:AsyncApp": FakeApp,
+    "slack_bolt.adapter.socket_mode.async_handler:AsyncSocketModeHandler": FakeSocketModeHandler,
+}
+
+__all__ = [
+    "SURFACE",
+    "FakeApp",
+    "FakeSocketModeHandler",
+    "FakeWebClient",
+    "SlackApiError",
+    "SlackResponse",
+    "SlackWire",
+]
diff --git a/tests/fakes/platform/telegram_wire.py b/tests/fakes/platform/telegram_wire.py
new file mode 100644
index 0000000..e02173a
--- /dev/null
+++ b/tests/fakes/platform/telegram_wire.py
@@ -0,0 +1,421 @@
+"""A fake of the Telegram library surface our adapter touches (P15-01).
+
+Shapes follow python-telegram-bot (method names snake_case, keyword arguments as the library
+takes them, results with ``message_id`` / ``chat.id``), backed by one `FakeChatPlatform`.
+Errors are raised as stand-ins named like the library's (``RetryAfter``, ``BadRequest``,
+``Forbidden``, ``TimedOut``, ``NetworkError``) so the adapter's error mapping can be exercised.
+Only names listed in ``SURFACE`` exist; the drift check proves each is real in the pinned
+library (P15-33 extends both together).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+from indus.gateway.adapters.base import utf16_units
+from tests.fakes.platform.core import (
+    Button,
+    FailureKind,
+    FakeChatPlatform,
+    FakeInbound,
+    FakeMedia,
+    FakeMessage,
+    FakePlatformError,
+)
+
+MAX_LEN = 4096
+
+SURFACE: dict[str, tuple[str, ...]] = {
+    "telegram:Bot": (
+        "get_me",
+        "get_updates",
+        "set_webhook",
+        "delete_webhook",
+        "send_message",
+        "edit_message_text",
+        "delete_message",
+        "send_chat_action",
+        "set_message_reaction",
+        "send_photo",
+        "send_document",
+        "send_voice",
+        "send_audio",
+        "send_video",
+        "set_my_commands",
+        "get_file",
+        "answer_callback_query",
+    ),
+    "telegram:InlineKeyboardButton": (),
+    "telegram:InlineKeyboardMarkup": (),
+    "telegram.error:RetryAfter": ("retry_after",),
+    "telegram.error:BadRequest": (),
+    "telegram.error:Forbidden": (),
+    "telegram.error:TimedOut": (),
+    "telegram.error:NetworkError": (),
+}
+
+
+# -- library-shaped errors ----------------------------------------------------------------------
+
+
+class TelegramError(Exception):
+    def __init__(self, message: str) -> None:
+        super().__init__(message)
+        self.message = message
+
+
+class NetworkError(TelegramError):
+    pass
+
+
+class TimedOut(NetworkError):
+    def __init__(self, message: str = "Timed out") -> None:
+        super().__init__(message)
+
+
+class BadRequest(NetworkError):
+    pass
+
+
+class Forbidden(TelegramError):
+    pass
+
+
+class RetryAfter(TelegramError):
+    def __init__(self, retry_after: float) -> None:
+        super().__init__(f"Flood control exceeded. Retry in {int(retry_after)} seconds")
+        self._retry_after = retry_after
+
+    @property
+    def retry_after(self) -> float:
+        return self._retry_after
+
+
+def _translate(exc: FakePlatformError) -> TelegramError:
+    kind = exc.kind
+    if kind is FailureKind.RATE_LIMIT:
+        return RetryAfter(exc.retry_after or 5.0)
+    if kind is FailureKind.READ_TIMEOUT:
+        return TimedOut()
+    if kind is FailureKind.CONNECT_TIMEOUT:
+        return NetworkError("httpx.ConnectError: connection refused")
+    if kind is FailureKind.FORBIDDEN:
+        return Forbidden(exc.text)
+    return BadRequest(exc.text.removeprefix("Bad Request: "))
+
+
+# -- library-shaped objects ---------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class InlineKeyboardButton:
+    text: str
+    callback_data: str
+
+
+@dataclass(frozen=True)
+class InlineKeyboardMarkup:
+    inline_keyboard: tuple[tuple[InlineKeyboardButton, ...], ...]
+
+
+@dataclass(frozen=True)
+class User:
+    id: int
+    is_bot: bool
+    first_name: str
+    username: str | None = None
+
+
+@dataclass(frozen=True)
+class Chat:
+    id: int
+    type: str  # private, group, supergroup, channel
+    title: str | None = None
+    is_forum: bool = False
+
+
+@dataclass(frozen=True)
+class File:
+    file_id: str
+    file_path: str
+
+
+@dataclass(frozen=True)
+class Message:
+    message_id: int
+    chat: Chat
+    text: str | None = None
+    caption: str | None = None
+    from_user: User | None = None
+    message_thread_id: int | None = None
+    reply_to_message: Message | None = None
+    voice: File | None = None
+    photo: tuple[File, ...] = ()
+    document: File | None = None
+    date: Any = None
+
+
+@dataclass(frozen=True)
+class CallbackQuery:
+    id: str
+    from_user: User
+    data: str
+    message: Message | None = None
+
+
+@dataclass(frozen=True)
+class Update:
+    update_id: int
+    message: Message | None = None
+    edited_message: Message | None = None
+    callback_query: CallbackQuery | None = None
+
+
+_CHAT_TYPES = {
+    "dm": "private",
+    "group": "supergroup",
+    "thread": "supergroup",
+    "forum": "supergroup",
+}
+
+
+def _int(value: str | None) -> int | None:
+    return int(value) if value not in (None, "") else None  # type: ignore[arg-type]
+
+
+def _chat_of(item: FakeInbound) -> Chat:
+    kind = _CHAT_TYPES.get(item.chat_kind, "channel")
+    title = None if item.chat_kind == "dm" else item.chat_name
+    return Chat(int(item.chat_id), kind, title, is_forum=item.chat_kind in ("thread", "forum"))
+
+
+def _file(media: FakeMedia) -> File:
+    return File(file_id=f"f-{media.ref}", file_path=media.ref)
+
+
+@dataclass
+class FakeBot:
+    """A stand-in for ``telegram.Bot`` over a `FakeChatPlatform`."""
+
+    platform: FakeChatPlatform
+    calls: list[tuple[str, dict[str, Any]]] = field(
+        default_factory=list[tuple[str, dict[str, Any]]]
+    )
+    _offset: int = 0
+
+    async def _do(self, name: str, kwargs: dict[str, Any], coro: Any) -> Any:
+        self.calls.append((name, kwargs))
+        try:
+            return await coro
+        except FakePlatformError as exc:
+            raise _translate(exc) from None
+
+    def _message(self, sent: FakeMessage) -> Message:
+        chat = Chat(int(sent.chat_id), "private")
+        return Message(int(sent.message_id), chat, text=sent.text)
+
+    async def get_me(self) -> User:
+        await self._do("get_me", {}, self.platform.connect())
+        return User(int(self.platform.bot_user_id or 1), True, self.platform.bot_name)
+
+    async def get_updates(
+        self, offset: int | None = None, timeout: float = 0, **kwargs: Any
+    ) -> list[Update]:
+        self.calls.append(("get_updates", {"offset": offset, "timeout": timeout, **kwargs}))
+        updates = [self._update(item) for item in self.platform.drain_inbound()]
+        return [u for u in updates if offset is None or u.update_id >= offset]
+
+    def _update(self, item: FakeInbound) -> Update:
+        chat = _chat_of(item)
+        user = User(int(item.user_id), item.is_bot, item.user_name or item.user_id)
+        reply = None
+        if item.reply_to:
+            original = self.platform.message(item.reply_to)
+            # Telegram does not echo rich content: the quoted text is dropped for our own messages.
+            text = None if original is None or original.from_bot else original.text
+            reply = Message(int(item.reply_to), chat, text=text)
+        media = item.media[0] if item.media else None
+        message = Message(
+            message_id=int(item.message_id) if item.message_id else 0,
+            chat=chat,
+            text=item.text if media is None else None,
+            caption=item.text if media is not None else None,
+            from_user=user,
+            message_thread_id=_int(item.thread_id),
+            reply_to_message=reply,
+            voice=_file(media) if media and media.kind == "voice" else None,
+            photo=(_file(media),) if media and media.kind == "photo" else (),
+            document=_file(media) if media and media.kind == "document" else None,
+            date=item.at,
+        )
+        if item.event == "button":
+            query = CallbackQuery(str(item.button_id), user, str(item.button_data), message)
+            return Update(item.update_id, callback_query=query)
+        if item.event == "edited":
+            return Update(item.update_id, edited_message=message)
+        return Update(item.update_id, message=message)
+
+    async def set_webhook(self, url: str, secret_token: str | None = None, **kw: Any) -> bool:
+        self.calls.append(("set_webhook", {"url": url, "secret_token": secret_token, **kw}))
+        return True
+
+    async def delete_webhook(self, **kw: Any) -> bool:
+        self.calls.append(("delete_webhook", kw))
+        return True
+
+    async def send_message(
+        self,
+        chat_id: int | str,
+        text: str,
+        parse_mode: str | None = None,
+        reply_to_message_id: int | None = None,
+        message_thread_id: int | None = None,
+        reply_markup: InlineKeyboardMarkup | None = None,
+        **kw: Any,
+    ) -> Message:
+        buttons = tuple(
+            Button(b.text, b.callback_data)
+            for row in (reply_markup.inline_keyboard if reply_markup else ())
+            for b in row
+        )
+        args = {"chat_id": chat_id, "text": text, "parse_mode": parse_mode, **kw}
+        sent = await self._do(
+            "send_message",
+            args,
+            self.platform.post(
+                str(chat_id),
+                text,
+                reply_to=str(reply_to_message_id) if reply_to_message_id else None,
+                thread_id=str(message_thread_id) if message_thread_id else None,
+                buttons=buttons,
+                extra={"parse_mode": parse_mode},
+            ),
+        )
+        return self._message(sent)
+
+    async def edit_message_text(
+        self,
+        text: str,
+        chat_id: int | str,
+        message_id: int,
+        parse_mode: str | None = None,
+        **kw: Any,
+    ) -> Message:
+        args = {"chat_id": chat_id, "message_id": message_id, "text": text, **kw}
+        edited = await self._do(
+            "edit_message_text", args, self.platform.edit(str(chat_id), str(message_id), text)
+        )
+        return self._message(edited)
+
+    async def delete_message(self, chat_id: int | str, message_id: int) -> bool:
+        args = {"chat_id": chat_id, "message_id": message_id}
+        return await self._do(
+            "delete_message", args, self.platform.delete(str(chat_id), str(message_id))
+        )
+
+    async def send_chat_action(
+        self, chat_id: int | str, action: str, message_thread_id: int | None = None
+    ) -> bool:
+        thread = str(message_thread_id) if message_thread_id else None
+        await self._do(
+            "send_chat_action",
+            {"chat_id": chat_id, "action": action},
+            self.platform.typing(str(chat_id), thread_id=thread),
+        )
+        return True
+
+    async def set_message_reaction(
+        self, chat_id: int | str, message_id: int, reaction: str | None = None
+    ) -> bool:
+        await self._do(
+            "set_message_reaction",
+            {"chat_id": chat_id, "message_id": message_id, "reaction": reaction},
+            self.platform.react(str(chat_id), str(message_id), reaction or ""),
+        )
+        return True
+
+    async def _upload(
+        self, name: str, kind: Any, chat_id: int | str, ref: Any, **kw: Any
+    ) -> Message:
+        caption = kw.get("caption") or ""
+        media = FakeMedia(kind, str(ref), caption=caption)
+        thread = kw.get("message_thread_id")
+        sent = await self._do(
+            name,
+            {"chat_id": chat_id, **kw},
+            self.platform.upload(str(chat_id), media, thread_id=str(thread) if thread else None),
+        )
+        return self._message(sent)
+
+    async def send_photo(self, chat_id: int | str, photo: Any, **kw: Any) -> Message:
+        return await self._upload("send_photo", "photo", chat_id, photo, **kw)
+
+    async def send_document(self, chat_id: int | str, document: Any, **kw: Any) -> Message:
+        return await self._upload("send_document", "document", chat_id, document, **kw)
+
+    async def send_voice(self, chat_id: int | str, voice: Any, **kw: Any) -> Message:
+        return await self._upload("send_voice", "voice", chat_id, voice, **kw)
+
+    async def send_audio(self, chat_id: int | str, audio: Any, **kw: Any) -> Message:
+        return await self._upload("send_audio", "audio", chat_id, audio, **kw)
+
+    async def send_video(self, chat_id: int | str, video: Any, **kw: Any) -> Message:
+        return await self._upload("send_video", "video", chat_id, video, **kw)
+
+    async def set_my_commands(self, commands: Any, **kw: Any) -> bool:
+        self.calls.append(("set_my_commands", {"commands": list(commands), **kw}))
+        return True
+
+    async def get_file(self, file_id: str) -> File:
+        self.calls.append(("get_file", {"file_id": file_id}))
+        return File(file_id, file_id.removeprefix("f-"))
+
+    async def answer_callback_query(self, callback_query_id: str, text: str | None = None) -> bool:
+        await self._do(
+            "answer_callback_query",
+            {"callback_query_id": callback_query_id, "text": text},
+            self.platform.answer(callback_query_id, text),
+        )
+        return True
+
+
+class TelegramWire:
+    """One fake Telegram service: the platform (UTF-16 cap 4096) and its bot."""
+
+    SURFACE = SURFACE
+    FAKES: dict[str, type] = {
+        "telegram:Bot": FakeBot,
+        "telegram:InlineKeyboardButton": InlineKeyboardButton,
+        "telegram:InlineKeyboardMarkup": InlineKeyboardMarkup,
+        "telegram.error:RetryAfter": RetryAfter,
+        "telegram.error:BadRequest": BadRequest,
+        "telegram.error:Forbidden": Forbidden,
+        "telegram.error:TimedOut": TimedOut,
+        "telegram.error:NetworkError": NetworkError,
+    }
+
+    def __init__(self, platform: FakeChatPlatform | None = None) -> None:
+        self.platform = platform or FakeChatPlatform(
+            "telegram", max_len=MAX_LEN, len_fn=utf16_units, bot_user_id="1000"
+        )
+        self.bot = FakeBot(self.platform)
+
+
+__all__ = [
+    "SURFACE",
+    "BadRequest",
+    "CallbackQuery",
+    "Chat",
+    "FakeBot",
+    "Forbidden",
+    "InlineKeyboardButton",
+    "InlineKeyboardMarkup",
+    "Message",
+    "NetworkError",
+    "RetryAfter",
+    "TelegramWire",
+    "TimedOut",
+    "Update",
+    "User",
+]
