+    kinds = [k for k, _ in seen]
+    assert kinds == ["message", "app_mention", "message", "action"]
+    assert seen[0][1]["ts"] == seen[1][1]["ts"] and seen[0][1]["team"] == "T2"
+    assert seen[2][1]["subtype"] == "bot_message" and "user" not in seen[2][1]
