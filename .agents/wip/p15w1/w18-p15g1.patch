new file mode 100644
index 0000000..ed778b1
--- /dev/null
+++ b/src/indus/gateway/adapters/base.py
@@ -0,0 +1,581 @@
+"""The adapter contract every platform implements, and its capability flags (P15-05).
+
+The public methods of `Adapter` are templates around small abstract or overridable hooks
+(``_open``, ``_close``, ``_send``, ``_edit``, ...), so every adapter gets the same guarantees:
+
+- ``connect`` / ``disconnect`` are idempotent: the hooks run only on a real transition;
+- an exception from a hook becomes a classified `SendResult` whose error text has this adapter's
+  credentials masked (tokens appear in vendor URLs and error messages);
+- optional operations a platform lacks are refused cleanly and never reach the platform;
+- sends and edits to one chat share one send slot (R06.13): sends wait, interim edits are skipped
+  while it is busy, the final edit is never gated;
+- inbound events leave through ``emit`` to the admission pipeline the runner installs.
+
+The rest of the gateway asks `Capabilities` what a platform can do instead of asking which
+platform it is. ``dm_is_private`` is False for broadcast surfaces that report every chat as a DM
+(R06.24): pairing codes and login links must never go there.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+import re
+from abc import ABC, abstractmethod
+from collections.abc import Awaitable, Callable, Mapping, Sequence
+from dataclasses import dataclass, replace
+from typing import TYPE_CHECKING, Any, ClassVar, Literal
+
+from indus.foundation.clock import Clock
+from indus.foundation.redact import redact_text
+from indus.gateway.core.events import ChatType, InboundEvent
+from indus.gateway.core.send import DELIVERY_FAILED_NOTICE, RetryPolicy, SendResult, send_with_retry
+from indus.gateway.core.send_slot import SendSlots
+
+if TYPE_CHECKING:
+    from indus.gateway.config import PlatformSettings
+
+log = logging.getLogger(__name__)
+
+LenFn = Callable[[str], int]
+InboundSink = Callable[[InboundEvent], Awaitable[None]]
+MediaKind = Literal["image", "file", "voice", "video", "document"]
+ApprovalChoice = Literal["once", "session", "always", "deny"]
+APPROVAL_CHOICES: tuple[ApprovalChoice, ...] = ("once", "session", "always", "deny")
+
+# Telegram caps callback data at 64 bytes; every platform gets the same bound.
+CALLBACK_MAX_BYTES = 64
+
+
+def code_points(text: str) -> int:
+    return len(text)
+
+
+def utf16_units(text: str) -> int:
+    """Length in UTF-16 code units (astral characters count two), as Telegram counts."""
+    return len(text.encode("utf-16-le")) // 2
+
+
+@dataclass(frozen=True)
+class Capabilities:
+    max_len: int = 4096
+    len_fn: LenFn = code_points
+    # ``send`` splits long text itself and reports every chunk id.
+    splits_natively: bool = False
+    supports_edit: bool = False
+    supports_delete: bool = False
+    supports_buttons: bool = False
+    # The adapter enforces its own DM/group policy (P15-08 asks it first).
+    owns_access_policy: bool = False
+    # Whoever reaches the adapter was authorised upstream (a relay, a signed webhook).
+    auth_upstream: bool = False
+    # False for broadcast surfaces that report every chat as a DM (R06.24).
+    dm_is_private: bool = True
+    # Can start a conversation later (background completions, cron) — False for stateless HTTP.
+    push_capable: bool = True
+    # Seconds between operations on one chat (Telegram 1.0).
+    slot_spacing: float = 0.0
+    # Longest server wait slept inline before handing it to the ledger (Telegram 5).
+    inline_wait_cap: float = 60.0
+
+
+@dataclass(frozen=True)
+class ChatInfo:
+    name: str
+    type: ChatType | None = None
+
+
+@dataclass(frozen=True)
+class ApprovalAction:
+    label: str
+    choice: ApprovalChoice
+    style: Literal["primary", "danger", ""] = ""
+
+
+@dataclass(frozen=True)
+class ApprovalPrompt:
+    """A dangerous-command approval card; wording comes from the prompts module (P15-22)."""
+
+    request_id: str
+    session_key: str
+    text: str
+    # The same card for platforms without buttons, ending with the /approve and /deny hints.
+    fallback_text: str
+    actions: tuple[ApprovalAction, ...] = ()
+
+
+@dataclass(frozen=True)
+class ClarifyPrompt:
+    clarify_id: str
+    session_key: str
+    question: str
+    choices: tuple[str, ...] = ()
+    multi: bool = False
+    # Numbered choices for platforms without buttons.
+    fallback_text: str = ""
+
+
+class AdapterConnectError(Exception):
+    """``_open`` failed. ``retryable`` false means a configuration problem (fatal)."""
+
+    def __init__(self, message: str, *, retryable: bool = True, code: str = "connect_failed"):
+        super().__init__(message)
+        self.retryable = retryable
+        self.code = code
+
+
+# -- button callback data --------------------------------------------------------------------------
+
+_CALLBACK_ID = re.compile(r"^[A-Za-z0-9_.-]{1,40}$")
+
+
+def _callback(prefix: str, ident: str, tail: str) -> str:
+    if not _CALLBACK_ID.match(ident):
+        raise ValueError(f"callback id {ident!r} must be 1-40 characters of [A-Za-z0-9_.-]")
+    data = f"{prefix}:{ident}:{tail}"
+    if len(data.encode("utf-8")) > CALLBACK_MAX_BYTES:
+        raise ValueError(f"callback data longer than {CALLBACK_MAX_BYTES} bytes")
+    return data
+
+
+def approval_callback(request_id: str, choice: ApprovalChoice) -> str:
+    if choice not in APPROVAL_CHOICES:
+        raise ValueError(f"unknown approval choice {choice!r}")
+    return _callback("apv", request_id, choice)
+
+
+def parse_approval_callback(data: str) -> tuple[str, ApprovalChoice] | None:
+    prefix, _, rest = data.partition(":")
+    request_id, _, choice = rest.partition(":")
+    if prefix != "apv" or not _CALLBACK_ID.match(request_id):
+        return None
+    for known in APPROVAL_CHOICES:
+        if choice == known:
+            return request_id, known
+    return None
+
+
+def clarify_callback(clarify_id: str, index: int) -> str:
+    if index < 0:
+        raise ValueError("choice index must be >= 0")
+    return _callback("clr", clarify_id, str(index))
+
+
+def parse_clarify_callback(data: str) -> tuple[str, int] | None:
+    prefix, _, rest = data.partition(":")
+    clarify_id, _, index = rest.partition(":")
+    if prefix != "clr" or not _CALLBACK_ID.match(clarify_id) or not index.isdigit():
+        return None
+    return clarify_id, int(index)
+
+
+# -- the adapter -----------------------------------------------------------------------------------
+
+
+def _merged_meta(meta: Mapping[str, Any] | None) -> dict[str, Any]:
+    return dict(meta) if meta else {}
+
+
+class Adapter(ABC):
+    """One platform connection: inbound normaliser plus outbound sender."""
+
+    platform: ClassVar[str] = ""
+    capabilities: ClassVar[Capabilities] = Capabilities()
+    # ``"module:Object"`` → attribute names this adapter calls on the vendor library; the drift
+    # check (P15-01) proves each exists in the pinned version.
+    vendor_names: ClassVar[Mapping[str, tuple[str, ...]]] = {}
+
+    def __init__(
+        self,
+        *,
+        clock: Clock,
+        settings: PlatformSettings | None = None,
+        secrets: Sequence[str] = (),
+        sink: InboundSink | None = None,
+    ) -> None:
+        self.clock = clock
+        self.settings = settings
+        held = list(secrets)
+        if settings is not None:
+            held.extend(settings.credentials.values())
+        self._secrets: tuple[str, ...] = tuple(v for v in held if v)
+        self._sink = sink
+        self._sink_warned = False
+        self.connected = False
+        self.slots = SendSlots(clock, self.capabilities.slot_spacing)
+
+    def __repr__(self) -> str:
+        state = "connected" if self.connected else "disconnected"
+        return f"<{type(self).__name__} {self.platform or '?'} {state}>"
+
+    # -- secrets -----------------------------------------------------------------------------------
+
+    def scrub(self, text: str) -> str:
+        """``text`` with this adapter's credentials and credential shapes masked."""
+        return redact_text(text, self._secrets)
+
+    def _scrubbed(self, result: SendResult) -> SendResult:
+        if result.error is None:
+            return result
+        clean = self.scrub(result.error)
+        return result if clean == result.error else replace(result, error=clean)
+
+    def _failed(self, exc: BaseException) -> SendResult:
+        log.warning(
+            "%s: platform call failed: %s",
+            self.platform,
+            self.scrub(f"{type(exc).__name__}: {exc}"),
+        )
+        return self._scrubbed(SendResult.failure(exc=exc))
+
+    # -- lifecycle ---------------------------------------------------------------------------------
+
+    async def connect(self, *, is_reconnect: bool = False) -> None:
+        """Connect and start receiving; a second call while connected does nothing."""
+        if self.connected:
+            return
+        try:
+            await self._open(is_reconnect)
+        except AdapterConnectError as exc:
+            raise AdapterConnectError(
+                self.scrub(str(exc)), retryable=exc.retryable, code=exc.code
+            ) from None
+        except Exception as exc:
+            raise AdapterConnectError(
+                self.scrub(f"{type(exc).__name__}: {exc}"), retryable=True
+            ) from None
+        self.connected = True
+
+    async def disconnect(self) -> None:
+        """Stop receiving and close; a second call (or one before connect) does nothing."""
+        if not self.connected:
+            return
+        self.connected = False
+        try:
+            await self._close()
+        except Exception as exc:
+            log.warning("%s: disconnect failed: %s", self.platform, self.scrub(str(exc)))
+
+    @abstractmethod
+    async def _open(self, is_reconnect: bool) -> None:
+        """Connect to the platform and start listening; raise `AdapterConnectError` on failure.
+
+        ``is_reconnect``: keep any server-side update queue so outage-time messages survive."""
+
+    @abstractmethod
+    async def _close(self) -> None:
+        """Stop listeners and close connections."""
+
+    # -- inbound -----------------------------------------------------------------------------------
+
+    def set_sink(self, sink: InboundSink | None) -> None:
+        self._sink = sink
+
+    async def emit(self, event: InboundEvent) -> None:
+        """Hand one normalised event to the admission pipeline; never raises into the adapter."""
+        if self._sink is None:
+            if not self._sink_warned:
+                self._sink_warned = True
+                log.warning("%s: inbound event dropped: no handler installed", self.platform)
+            return
+        try:
+            await self._sink(event)
+        except Exception:
+            log.exception("%s: inbound handler failed", self.platform)
+
+    # -- outbound: text ----------------------------------------------------------------------------
+
+    async def send(
+        self,
+        chat_id: str,
+        text: str,
+        *,
+        reply_to: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        """Send ``text`` to a chat. Never raises: failures come back classified."""
+        if not text or not text.strip():
+            return SendResult(ok=False, error="nothing to send")
+        try:
+            async with self.slots.hold(chat_id):
+                result = await self._send(chat_id, text, reply_to, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    @abstractmethod
+    async def _send(
+        self, chat_id: str, text: str, reply_to: str | None, meta: dict[str, Any]
+    ) -> SendResult:
+        """Send inside the chat's slot. Adapters that split call ``await self.slots.pace(chat_id)``
+        before each further chunk; ``meta["plain"]`` asks for no formatting."""
+
+    async def edit(
+        self,
+        chat_id: str,
+        message_id: str,
+        text: str,
+        *,
+        final: bool = False,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        """Edit a sent message. Interim edits are skipped while the chat's slot is busy;
+        the final edit is never gated."""
+        if not self.capabilities.supports_edit:
+            return SendResult.refused("editing")
+        try:
+            if final:
+                self.slots.mark(chat_id)
+                result = await self._edit(chat_id, message_id, text, True, _merged_meta(meta))
+            else:
+                held = self.slots.try_interim(chat_id)
+                if held is None:
+                    return SendResult.skip()
+                async with held:
+                    result = await self._edit(chat_id, message_id, text, False, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    async def _edit(
+        self, chat_id: str, message_id: str, text: str, final: bool, meta: dict[str, Any]
+    ) -> SendResult:
+        return SendResult.refused("editing")
+
+    async def delete(self, chat_id: str, message_id: str) -> bool:
+        if not self.capabilities.supports_delete:
+            return False
+        try:
+            async with self.slots.hold(chat_id):
+                return await self._delete(chat_id, message_id)
+        except Exception as exc:
+            log.warning("%s: delete failed: %s", self.platform, self.scrub(str(exc)))
+            return False
+
+    async def _delete(self, chat_id: str, message_id: str) -> bool:
+        return False
+
+    async def send_with_retry(
+        self,
+        chat_id: str,
+        text: str,
+        *,
+        reply_to: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+        rng: Callable[[], float] = random.random,
+        notice: str | None = DELIVERY_FAILED_NOTICE,
+    ) -> SendResult:
+        """``send`` under the P15-04 retry policy with this platform's inline wait cap."""
+
+        async def attempt(body: str, plain: bool) -> SendResult:
+            extra = _merged_meta(meta)
+            if plain:
+                extra["plain"] = True
+            return await self.send(chat_id, body, reply_to=reply_to, meta=extra)
+
+        policy = RetryPolicy(inline_wait_cap=self.capabilities.inline_wait_cap)
+        return await send_with_retry(
+            attempt,
+            text,
+            clock=self.clock,
+            policy=policy,
+            rng=rng,
+            notice=notice,
+            is_final=self.is_final_failure,
+        )
+
+    def is_final_failure(self, result: SendResult) -> bool:
+        """A failure neither a retry nor plain text can fix (an auth refusal). Default: none."""
+        return False
+
+    # -- outbound: typing --------------------------------------------------------------------------
+
+    async def typing_start(self, chat_id: str, meta: Mapping[str, Any] | None = None) -> None:
+        """Show (or refresh) the typing indicator; failures are logged, never raised."""
+        try:
+            await self._typing(chat_id, _merged_meta(meta))
+        except Exception as exc:
+            log.debug("%s: typing failed: %s", self.platform, self.scrub(str(exc)))
+
+    async def typing_stop(self, chat_id: str) -> None:
+        try:
+            await self._typing_stop(chat_id)
+        except Exception as exc:
+            log.debug("%s: typing stop failed: %s", self.platform, self.scrub(str(exc)))
+
+    async def _typing(self, chat_id: str, meta: dict[str, Any]) -> None:
+        return None
+
+    async def _typing_stop(self, chat_id: str) -> None:
+        return None
+
+    # -- outbound: media ---------------------------------------------------------------------------
+
+    async def _media(
+        self,
+        kind: MediaKind,
+        chat_id: str,
+        path: str,
+        caption: str | None,
+        meta: Mapping[str, Any] | None,
+    ) -> SendResult:
+        try:
+            async with self.slots.hold(chat_id):
+                result = await self._send_media(kind, chat_id, path, caption, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    async def _send_media(
+        self, kind: MediaKind, chat_id: str, path: str, caption: str | None, meta: dict[str, Any]
+    ) -> SendResult:
+        return SendResult.refused(f"sending {kind}s")
+
+    async def send_image(
+        self,
+        chat_id: str,
+        path: str,
+        *,
+        caption: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        return await self._media("image", chat_id, path, caption, meta)
+
+    async def send_file(
+        self,
+        chat_id: str,
+        path: str,
+        *,
+        caption: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        return await self._media("file", chat_id, path, caption, meta)
+
+    async def send_voice(
+        self,
+        chat_id: str,
+        path: str,
+        *,
+        caption: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        return await self._media("voice", chat_id, path, caption, meta)
+
+    async def send_video(
+        self,
+        chat_id: str,
+        path: str,
+        *,
+        caption: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        return await self._media("video", chat_id, path, caption, meta)
+
+    async def send_document(
+        self,
+        chat_id: str,
+        path: str,
+        *,
+        caption: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        return await self._media("document", chat_id, path, caption, meta)
+
+    # -- outbound: prompts -------------------------------------------------------------------------
+
+    async def send_approval(
+        self, chat_id: str, prompt: ApprovalPrompt, meta: Mapping[str, Any] | None = None
+    ) -> SendResult:
+        """Buttons where the platform has them, else the text card with /approve hints."""
+        if not self.capabilities.supports_buttons or not prompt.actions:
+            return await self.send(chat_id, prompt.fallback_text, meta=meta)
+        try:
+            async with self.slots.hold(chat_id):
+                result = await self._send_approval(chat_id, prompt, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    async def _send_approval(
+        self, chat_id: str, prompt: ApprovalPrompt, meta: dict[str, Any]
+    ) -> SendResult:
+        return SendResult.refused("approval buttons")
+
+    async def send_clarify(
+        self, chat_id: str, prompt: ClarifyPrompt, meta: Mapping[str, Any] | None = None
+    ) -> SendResult:
+        """Buttons for the choices where the platform has them, else numbered text."""
+        if not self.capabilities.supports_buttons or not prompt.choices:
+            return await self.send(chat_id, prompt.fallback_text or prompt.question, meta=meta)
+        try:
+            async with self.slots.hold(chat_id):
+                result = await self._send_clarify(chat_id, prompt, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    async def _send_clarify(
+        self, chat_id: str, prompt: ClarifyPrompt, meta: dict[str, Any]
+    ) -> SendResult:
+        return SendResult.refused("clarify buttons")
+
+    async def send_notice_private(
+        self,
+        chat_id: str,
+        user_id: str,
+        text: str,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResult:
+        """A notice only ``user_id`` sees. Refused unless the platform has private notices:
+        a plain send into a group would show it to everyone."""
+        try:
+            async with self.slots.hold(chat_id):
+                result = await self._send_private(chat_id, user_id, text, _merged_meta(meta))
+        except Exception as exc:
+            return self._failed(exc)
+        return self._scrubbed(result)
+
+    async def _send_private(
+        self, chat_id: str, user_id: str, text: str, meta: dict[str, Any]
+    ) -> SendResult:
+        return SendResult.refused("private notices")
+
+    # -- descriptive -------------------------------------------------------------------------------
+
+    async def chat_info(self, chat_id: str) -> ChatInfo:
+        """Name and type of a chat; type None when the platform cannot tell."""
+        try:
+            return await self._chat_info(chat_id)
+        except Exception as exc:
+            log.debug("%s: chat info failed: %s", self.platform, self.scrub(str(exc)))
+            return ChatInfo(name=str(chat_id))
+
+    async def _chat_info(self, chat_id: str) -> ChatInfo:
+        return ChatInfo(name=str(chat_id))
+
+    def format(self, text: str) -> str:
+        """Markdown from the agent → this platform's markup (formatters arrive in P15-15)."""
+        return text
+
+
+__all__ = [
+    "APPROVAL_CHOICES",
+    "CALLBACK_MAX_BYTES",
+    "Adapter",
+    "AdapterConnectError",
+    "ApprovalAction",
+    "ApprovalChoice",
+    "ApprovalPrompt",
+    "Capabilities",
+    "ChatInfo",
+    "ClarifyPrompt",
+    "InboundSink",
+    "LenFn",
+    "MediaKind",
+    "approval_callback",
+    "clarify_callback",
+    "code_points",
+    "parse_approval_callback",
+    "parse_clarify_callback",
+    "utf16_units",
+]
diff --git a/src/indus/gateway/config.py b/src/indus/gateway/config.py
new file mode 100644
index 0000000..5b94452
--- /dev/null
+++ b/src/indus/gateway/config.py
@@ -0,0 +1,291 @@
+"""Gateway settings and platform enablement (P15-02).
+
+Settings come through the one config loader and defaults table (D-16.32, R06.25): the
+``platforms.<name>`` and ``gateway`` rows live in ``foundation/config/schema.py`` like every other
+section, so a value set only in the defaults reads the same here as in the CLI.
+
+A platform starts when its vendor credentials are present — secret store first, environment
+second — unless its config says ``enabled: false``. An explicit false always wins and logs one
+warning per platform and profile per process, naming the ignored credentials (never their values;
+R06.15). A missing key keeps credential enablement; ``enabled: true`` without credentials does not
+start the platform and is reported as a problem.
+
+The legacy idle/daily conversation reset (``session_reset``) is never read: conversations reset
+only on ``/new``. A timed one still in the file gets one warning (and a ``doctor`` line).
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any, cast
+
+from pydantic import ValidationError
+
+from indus.foundation import config as config_mod
+from indus.foundation.config.schema import (
+    ChannelOverride,
+    GatewaySection,
+    PlatformSection,
+    PlatformsSection,
+)
+from indus.foundation.scope import Scope
+
+log = logging.getLogger(__name__)
+
+# Vendor credential names (kept as the vendors spell them, D-16.22). Every name must be present.
+BUILTIN_CREDENTIALS: Mapping[str, tuple[str, ...]] = MappingProxyType(
+    {
+        "telegram": ("TELEGRAM_BOT_TOKEN",),
+        "discord": ("DISCORD_BOT_TOKEN",),
+        "slack": ("SLACK_BOT_TOKEN", "SLACK_APP_TOKEN"),
+    }
+)
+
+GLOBAL_ALLOWED_USERS_ENV = "INDUS_GATEWAY_ALLOWED_USERS"
+GLOBAL_ALLOW_ALL_ENV = "INDUS_GATEWAY_ALLOW_ALL_USERS"
+
+_TIMED_RESET_MODES = frozenset({"idle", "daily", "both"})
+
+
+@dataclass(frozen=True)
+class PolicyEnvNames:
+    """Per-platform policy variables (our prefix; glossary proposal (e)4)."""
+
+    allowed_users: str
+    allow_all_users: str
+    allow_bots: str
+    home_channel: str
+
+
+def policy_env(platform: str) -> PolicyEnvNames:
+    stem = f"INDUS_{platform.upper()}"
+    return PolicyEnvNames(
+        allowed_users=f"{stem}_ALLOWED_USERS",
+        allow_all_users=f"{stem}_ALLOW_ALL_USERS",
+        allow_bots=f"{stem}_ALLOW_BOTS",
+        home_channel=f"{stem}_HOME_CHANNEL",
+    )
+
+
+def read_secret(scope: Scope, name: str) -> str | None:
+    """A credential: the profile's secret store first, then its environment. Blank = absent."""
+    if scope.secrets is not None:
+        try:
+            value = scope.secrets.get(name)
+        except Exception as exc:  # an unreadable store must not stop the env fallback
+            log.warning("secret store could not be read for %s: %s", name, type(exc).__name__)
+            value = None
+        if value and value.strip():
+            return value.strip()
+    value = scope.env.get(name)
+    return value.strip() if value and value.strip() else None
+
+
+@dataclass(frozen=True)
+class HomeChannel:
+    platform: str
+    chat_id: str
+    name: str = ""
+    thread_id: str | None = None
+
+
+@dataclass(frozen=True)
+class PlatformSettings:
+    name: str
+    enabled: bool
+    # Why: "credentials", "disabled in config", "missing credentials: X", "not configured".
+    reason: str
+    section: PlatformSection
+    # The config's own value: True, False or None (unset).
+    explicit: bool | None = None
+    credentials: Mapping[str, str] = field(default_factory=dict[str, str], repr=False)
+    home_channel: HomeChannel | None = None
+
+    @property
+    def reply_to_mode(self) -> str:
+        return self.section.reply_to_mode
+
+    @property
+    def restart_notice(self) -> bool:
+        return self.section.restart_notice
+
+    @property
+    def typing_indicator(self) -> bool:
+        return self.section.typing_indicator
+
+    @property
+    def extra(self) -> Mapping[str, Any]:
+        """Platform-specific settings: keys written straight under ``platforms.<name>`` (where
+        ``indus config set`` puts them) plus the ``extra`` block, which wins on a clash."""
+        return {**(self.section.model_extra or {}), **self.section.extra}
+
+    def channel_override(self, chat_id: str) -> ChannelOverride | None:
+        return self.section.channel_overrides.get(str(chat_id))
+
+
+@dataclass(frozen=True)
+class GatewaySettings:
+    platforms: Mapping[str, PlatformSettings]
+    gateway: GatewaySection
+    problems: tuple[str, ...] = ()
+
+    def enabled(self) -> list[str]:
+        return sorted(name for name, p in self.platforms.items() if p.enabled)
+
+    def get(self, name: str) -> PlatformSettings | None:
+        return self.platforms.get(name)
+
+
+# -- one warning per platform per profile per process --------------------------------------------
+
+_warned: set[tuple[str, str]] = set()
+_warned_lock = threading.Lock()
+
+
+def _warn_once(key: tuple[str, str], message: str, *args: object) -> None:
+    with _warned_lock:
+        if key in _warned:
+            return
+        _warned.add(key)
+    log.warning(message, *args)
+
+
+def reset_warnings() -> None:
+    """Forget which warnings were given (a fresh process, for tests)."""
+    with _warned_lock:
+        _warned.clear()
+
+
+# -- reading ------------------------------------------------------------------------------------
+
+
+def _view(scope: Scope) -> Any:
+    return scope.config if scope.config is not None else config_mod.load(scope)
+
+
+def _mapping(value: object) -> dict[str, Any]:
+    if isinstance(value, Mapping):
+        return dict(cast(Mapping[str, Any], value))
+    return {}
+
+
+def _section(name: str, raw: object, problems: list[str]) -> PlatformSection:
+    try:
+        return PlatformSection.model_validate(_mapping(raw))
+    except ValidationError as exc:
+        errors = exc.errors()
+        where = ".".join(str(p) for p in errors[0]["loc"]) if errors else ""
+        problems.append(f"platforms.{name}.{where}: invalid value; using the built-in settings")
+        return PlatformSection()
+
+
+def _home_channel(scope: Scope, name: str, section: PlatformSection) -> HomeChannel | None:
+    home = section.home_channel
+    if home is not None and home.chat_id.strip():
+        return HomeChannel(
+            platform=home.platform.strip() or name,
+            chat_id=home.chat_id.strip(),
+            name=home.name,
+            thread_id=home.thread_id or None,
+        )
+    chat_id = (scope.env.get(policy_env(name).home_channel) or "").strip()
+    return HomeChannel(platform=name, chat_id=chat_id) if chat_id else None
+
+
+def _platform(
+    scope: Scope,
+    name: str,
+    section: PlatformSection,
+    names: tuple[str, ...],
+    problems: list[str],
+) -> PlatformSettings:
+    found = {n: v for n in names if (v := read_secret(scope, n)) is not None}
+    missing = [n for n in names if n not in found]
+    has_credentials = bool(names) and not missing
+    explicit = section.enabled
+    home = _home_channel(scope, name, section)
+    if explicit is False:
+        if has_credentials:
+            _warn_once(
+                (str(scope.home), name),
+                "platform %s is turned off by platforms.%s.enabled: false, so its credentials "
+                "(%s) are ignored; remove the key or set it to true to turn it back on",
+                name,
+                name,
+                ", ".join(names),
+            )
+        return PlatformSettings(name, False, "disabled in config", section, False, {}, home)
+    if has_credentials:
+        return PlatformSettings(name, True, "credentials", section, explicit, found, home)
+    if explicit is True:
+        if not names:
+            # A platform with no credential table (a plugin's own transport) runs on config alone.
+            return PlatformSettings(name, True, "enabled in config", section, True, {}, home)
+        reason = "missing credentials: " + ", ".join(missing)
+        problems.append(f"{name} is enabled in config but {reason}")
+        _warn_once((str(scope.home), f"{name}:missing"), "%s is enabled but %s", name, reason)
+        return PlatformSettings(name, False, reason, section, True, {}, home)
+    return PlatformSettings(name, False, "not configured", section, explicit, {}, home)
+
+
+def legacy_reset_notice(tree: Mapping[str, Any]) -> str | None:
+    """The `doctor` / startup line for a timed ``session_reset`` block still in the config."""
+    gateway = _mapping(tree.get("gateway"))
+    for path, block in (
+        ("session_reset", tree.get("session_reset")),
+        ("gateway.session_reset", gateway.get("session_reset")),
+    ):
+        mode = str(_mapping(block).get("mode") or "").strip().lower()
+        if mode in _TIMED_RESET_MODES:
+            return (
+                f"{path}.mode: {mode} is not used: messaging conversations reset only when you "
+                "send /new (or /reset); remove the block to silence this warning"
+            )
+    return None
+
+
+def load_gateway_settings(
+    scope: Scope, *, credentials: Mapping[str, tuple[str, ...]] = BUILTIN_CREDENTIALS
+) -> GatewaySettings:
+    """Effective gateway settings for ``scope``: one entry per known or configured platform."""
+    view = _view(scope)
+    problems: list[str] = []
+    raw_platforms = _mapping(view.get("platforms"))
+    names = sorted(set(credentials) | set(raw_platforms) | set(PlatformsSection.model_fields))
+    platforms: dict[str, PlatformSettings] = {}
+    for name in names:
+        section = _section(name, raw_platforms.get(name), problems)
+        platforms[name] = _platform(
+            scope, name, section, tuple(credentials.get(name, ())), problems
+        )
+    try:
+        gateway = GatewaySection.model_validate(_mapping(view.get("gateway")))
+    except ValidationError:
+        problems.append("gateway: invalid value; using the built-in settings")
+        gateway = GatewaySection()
+    tree = {"session_reset": view.get("session_reset"), "gateway": view.get("gateway")}
+    notice = legacy_reset_notice(tree)
+    if notice is not None:
+        problems.append(notice)
+        _warn_once((str(scope.home), "session_reset"), "%s", notice)
+    return GatewaySettings(MappingProxyType(platforms), gateway, tuple(problems))
+
+
+__all__ = [
+    "BUILTIN_CREDENTIALS",
+    "GLOBAL_ALLOWED_USERS_ENV",
+    "GLOBAL_ALLOW_ALL_ENV",
+    "GatewaySettings",
+    "HomeChannel",
+    "PlatformSettings",
+    "PolicyEnvNames",
+    "legacy_reset_notice",
+    "load_gateway_settings",
+    "policy_env",
+    "read_secret",
+    "reset_warnings",
+]
diff --git a/src/indus/gateway/core/__init__.py b/src/indus/gateway/core/__init__.py
