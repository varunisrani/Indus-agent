+        self.sent_index = sent_index
+        self.adapters: dict[str, Adapter] = dict(adapters or {})
+        self._settings = settings or (lambda: IntakeSettings.from_scope(scope))
+        self.extra_for = extra_for or (lambda _platform: None)
+        self.channel_model = channel_model or (lambda _platform, _chat: None)
+        self.home_for = home_for or (lambda _platform: None)
+        self.switcher: ModelSwitcher = switcher or RouteSwitcher()
+        self.toolsets_for = toolsets_for
+        self.batching = batching
+        self.on_request = on_request
+        self.automation = automation
+        self.clock: Clock = clock or scope.clock
+        self.claims = ClaimTable(self.clock)
+        self.pending = PendingQueue()
+        self.paused_platforms: set[str] = set()
+        self.progress_modes: dict[str, str] = {}
+        self.once_next: dict[str, ModelChoice] = {}
+        self._once_turns: dict[int, tuple[str, str, Source]] = {}
+        self._applied: dict[str, ModelChoice | None] = {}
+        self._sessions: dict[str, str] = {}
+        self._history: dict[str, list[str]] = {}
+        self._origins: OrderedDict[str, _Origin] = OrderedDict()
+        self._anchors: OrderedDict[tuple[str, int], str] = OrderedDict()
+        self._watched: set[str] = set()
+        self._tasks: set[asyncio.Task[Any]] = set()
+        self._restoring = False
+        self._restore_queue: list[InboundEvent] = []
+        self._undo: list[Callable[[], None]] = []
+        self._tip_shown = False
+        self._closed = False
+        self.interceptors: list[Interceptor] = list(interceptors)
+        self.busy_guard: BusyGuard = BusyGuard(self)
+        self.commands: ChatCommands = commands(self) if commands else ChatCommands(self)
+        self.interceptors.insert(0, self.commands.confirms.intercept)
+        self._paste: Batcher[InboundEvent] = Batcher(
+            self.clock,
+            flush=self._flush_paste,
+            merge=merge_events,
+            delay_for=self._paste_delay,
+        )
+        self._paste_policy: dict[str, TextBatchPolicy] = {}
+
+    # -- lifecycle ---------------------------------------------------------------------------------
+
+    def start(self) -> None:
+        """Listen to the service (turn ends, moved sessions, queued input). Call on its loop."""
+        self.service.set_answerable_kinds(ANSWERABLE_KINDS)
+        self._undo.append(self.service.on_turn_end(self._on_turn_end))
+        self._undo.append(self.service.on_session_moved(self._on_moved))
+        self.service.set_input_probe(self._input_waiting)
+        self._undo.append(lambda: self.service.set_input_probe(None))
+        for adapter in self.adapters.values():
+            adapter.set_sink(self.accept)
+
+    async def aclose(self) -> None:
+        self._closed = True
+        for undo in reversed(self._undo):
+            with contextlib.suppress(Exception):
+                undo()
+        self._undo.clear()
+        await self._paste.aclose()
+        await self.busy_guard.aclose()
+        tasks = [t for t in self._tasks if not t.done()]
+        for task in tasks:
+            task.cancel()
+        for task in tasks:
+            with contextlib.suppress(asyncio.CancelledError, Exception):
+                await task
+
+    def settings(self) -> IntakeSettings:
+        try:
+            return self._settings()
+        except Exception:
+            log.warning("could not read the intake settings", exc_info=True)
+            return IntakeSettings(profile=self.scope.profile_id)
+
+    def spawn(
+        self, coro: Coroutine[Any, Any, Any], *, name: str = "gateway task"
+    ) -> asyncio.Task[Any]:
+        """Run ``coro`` as a tracked task (cancelled at ``aclose``; failures logged)."""
+        task = asyncio.ensure_future(coro)
+        task.set_name(name)
+        self._tasks.add(task)
+
+        def done(finished: asyncio.Task[Any]) -> None:
+            self._tasks.discard(finished)
+            if not finished.cancelled() and finished.exception() is not None:
+                log.error("%s failed", name, exc_info=finished.exception())
+
+        task.add_done_callback(done)
+        return task
+
+    async def idle(self) -> None:
+        """Wait until no tracked task is running (tests and drain)."""
+        while True:
+            tasks = [t for t in self._tasks if not t.done()]
+            if not tasks:
+                return
+            await asyncio.wait(tasks)
+
+    # -- startup restore ---------------------------------------------------------------------------
+
+    def begin_restore(self) -> None:
+        """Hold new events while boot recovery runs (P15-26)."""
+        self._restoring = True
+
+    async def finish_restore(self) -> int:
+        """Replay the held events in arrival order; how many there were."""
+        self._restoring = False
+        held, self._restore_queue = self._restore_queue, []
+        for event in held:
+            await self.accept(event)
+        return len(held)
+
+    def _held_for_restore(self, event: InboundEvent) -> bool:
+        if self._restoring and not event.internal:
+            self._restore_queue.append(event)
+            return True
+        return False
+
+    # -- keys and state ----------------------------------------------------------------------------
+
+    def session_key(self, source: Source) -> str:
+        settings = self.settings()
+        return build_session_key(
+            source,
+            profile=settings.profile,
+            group_sessions_per_user=settings.group_sessions_per_user,
+            thread_sessions_per_user=settings.thread_sessions_per_user,
+        )
+
+    def cached_session(self, key: str) -> str | None:
+        sid = self._sessions.get(key)
+        return self.service.current_id(sid) if sid else None
+
+    async def session_id_for(self, key: str) -> str | None:
+        """The key's session id (cached, else from the routing index); never creates one."""
+        cached = self.cached_session(key)
+        if cached:
+            return cached
+        entry = await run_blocking(routes.get, self.store, key, label="gateway route")
+        return None if entry is None else self.service.current_id(entry.session_id)
+
+    def history(self, key: str) -> list[str]:
+        """Session ids this key used in this process, newest first."""
+        return list(reversed(self._history.get(key, [])))
+
+    def _remember(self, key: str, session_id: str) -> None:
+        self._sessions[key] = session_id
+        seen = self._history.setdefault(key, [])
+        if session_id in seen:
+            seen.remove(session_id)
+        seen.append(session_id)
+        del seen[:-50]
+
+    def is_running(self, session_id: str | None) -> bool:
+        """True while the service runs a turn for the session."""
+        if not session_id:
+            return False
+        try:
+            return self.service.agent(session_id).current is not None
+        except ProtocolError:
+            return False
+
+    def busy(self, key: str) -> bool:
+        """The key holds a claim or its session is replying."""
+        return self.claims.current(key) is not None or self.is_running(self.cached_session(key))
+
+    def _input_waiting(self, session_id: str) -> bool:
+        origin = self._origins.get(self.service.current_id(session_id))
+        return origin is not None and self.pending.depth(origin.key) > 0
+
+    def drop_claim(self, key: str, *, cancel: bool) -> Claim | None:
+        """Take the key's claim away (``/new``, ``/stop``); ``cancel`` also stops its handler
+        when that is not the caller. The dropped turn's own release is then a no-op."""
+        claim = self.claims.drop(key)
+        if claim is None:
+            return None
+        if claim.capped and self.cap is not None:
+            self.cap.release(key)
+        task = claim.task
+        if cancel and task is not None and task is not asyncio.current_task() and not task.done():
+            task.cancel()
+        return claim
+
+    def evict(self, key: str) -> None:
+        evicted = self.claims.evict_stale(
+            key,
+            stale_after=self.settings().stale_after,
+            running=lambda claim: self.is_running(claim.session_id),
+        )
+        if evicted is not None and evicted.capped and self.cap is not None:
+            self.cap.release(key)
+
+    # -- replies -----------------------------------------------------------------------------------
+
+    async def reply(
+        self,
+        source: Source,
+        text: str,
+        *,
+        reply_to: str | None = None,
+        kind: ReplyKind = "command",
+    ) -> None:
+        """Send through the outbound sender; a failure is logged, never raised."""
+        if not text or not text.strip():
+            return
+        try:
+            await self.sender.reply(source, text, reply_to=reply_to, kind=kind)
+        except Exception:
+            log.warning("could not send a %s reply on %s", kind, source.platform, exc_info=True)
+
+    def _note_origin(self, session_id: str, key: str, source: Source) -> None:
+        self._origins[session_id] = _Origin(key, source)
+        self._origins.move_to_end(session_id)
+        while len(self._origins) > _ORIGINS_KEPT:
+            self._origins.popitem(last=False)
+
+    async def _origin_of(self, session_id: str) -> _Origin | None:
+        found = self._origins.get(session_id)
+        if found is not None:
+            return found
+        try:
+            entries = await run_blocking(
+                routes.routes_for_session, self.store, session_id, label="gateway route"
+            )
+        except Exception:
+            log.warning("could not look up the route of %s", session_id, exc_info=True)
+            return None
+        for entry in entries:
+            try:
+                source = Source.model_validate(entry.origin)
+            except Exception:
+                continue
+            origin = _Origin(entry.session_key, source)
+            self._note_origin(session_id, entry.session_key, source)
+            return origin
+        return None
+
+    # -- the sink ----------------------------------------------------------------------------------
+
+    async def accept(self, event: InboundEvent) -> None:
+        """The adapter sink: inline control, guard 1, split-paste batching or a handler task."""
+        if self._closed:
+            return
+        platform = str(event.source.platform).lower()
+        if platform in self.paused_platforms and not event.internal:
+            log.debug("dropped a message from paused platform %s", platform)
+            return
+        if self._held_for_restore(event):
+            return
+        if self.busy_guard.is_control(event):
+            await self.handle(event, inline=True)  # never the background path (R06.1)
+            return
+        key = self.session_key(event.source)
+        self.evict(key)
+        if not event.internal and self.busy(key):
+            await self.busy_guard.adapter_level(event, key)
+            return
+        policy = self._batch_policy(event)
+        if policy is not None:
+            self._paste_policy[key] = policy
+            self._paste.add(key, event)
+            return
+        self.spawn(self.handle(event), name=f"inbound {platform}")
+
+    def _batch_policy(self, event: InboundEvent) -> TextBatchPolicy | None:
+        if self.batching is None or event.internal or event.is_command:
+            return None
+        if event.kind is not MessageKind.TEXT or event.media:
+            return None
+        try:
+            return self.batching(str(event.source.platform).lower())
+        except Exception:
+            log.warning("split-paste policy lookup failed", exc_info=True)
+            return None
+
+    def _paste_delay(self, last: InboundEvent) -> float:
+        key = self.session_key(last.source)
+        policy = self._paste_policy.get(key) or TextBatchPolicy()
+        adapter = self.adapters.get(str(last.source.platform).lower())
+        length = adapter.capabilities.len_fn if adapter is not None else len
+        return policy.delay_for(length(last.text))
+
+    async def _flush_paste(self, key: str, event: InboundEvent) -> None:
+        self._paste_policy.pop(key, None)
+        if self.busy(key):
+            await self.busy_guard.adapter_level(event, key)
+            return
+        self.spawn(self.handle(event), name="inbound batch")
+
+    # -- the gates ---------------------------------------------------------------------------------
+
+    async def handle(self, event: InboundEvent, *, inline: bool = False) -> None:
+        """Run one message through the gates (see the module notes).
+
+        ``inline``: called in the adapter's own await (control commands); a turn the message
+        turns into (``/queue`` while idle) then runs as a task so the adapter keeps reading."""
+        reset_identity()
+        if not self._identity_ok(event) or self._held_for_restore(event):
+            return
+        if not event.internal:
+            rewritten = await self._pre_dispatch(event)
+            if rewritten is None:
+                return
+            event = rewritten
+        source = event.source
+        key = self.session_key(source)
+        bind_identity(
+            GatewayIdentity(
+                platform=str(source.platform),
+                chat_id=str(source.chat_id),
+                user_id=str(source.user_id or ""),
+                thread_id=str(source.thread_id or ""),
+                session_key=key,
+            )
+        )
+        if not event.internal and not await self.authorize(event):
+            return
+        notice = self._pause_notice(event, key)
+        if notice is not None:
+            await self.reply(source, notice, reply_to=event.message_id, kind="notice")
+            return
+        if not event.internal and await self.intercept(event, key):
+            return
+        self.evict(key)
+        if self.busy(key):
+            await self.busy_guard.runner_level(event, key)
+            return
+        if event.is_command:
+            from indus.gateway.core.commands import Rewrite
+
+            outcome = await self.commands.dispatch_idle(event, key)
+            if not isinstance(outcome, Rewrite):
+                if outcome:
+                    await self.reply(source, outcome, reply_to=event.message_id)
+                return
+            event = event.model_copy(update={"text": outcome.text, "allow_control": False})
+        await self.run_admitted(event, key, background=inline)
+
+    def _identity_ok(self, event: InboundEvent) -> bool:
+        source = event.source
+        if not str(source.platform).strip() or not str(source.chat_id).strip():
+            log.debug("dropped an event without a platform or chat id")
+            return False
+        return True
+
+    async def _pre_dispatch(self, event: InboundEvent) -> InboundEvent | None:
+        hooks = self.hooks
+        if hooks is None:
+            return event
+        source = event.source
+        try:
+            answer = await hooks.pre_gateway_dispatch(
+                event=event,
+                platform=source.platform,
+                chat_id=source.chat_id,
+                user_id=source.user_id,
+                text=event.text,
+            )
+        except Exception:
+            log.warning("pre_gateway_dispatch failed; message dispatched as is", exc_info=True)
+            return event
+        if not answer:
+            return event
+        action = answer.get("action")
+        if action == "skip":
+            log.info("a plugin skipped a %s message: %s", source.platform, answer.get("reason"))
+            return None
+        text = answer.get("text")
+        if action == "rewrite" and isinstance(text, str):
+            return event.model_copy(update={"text": text})
+        return event
+
+    async def authorize(self, event: InboundEvent) -> bool:
+        """Authorization, unknown-sender handling, the bot-loop count and mention gating."""
+        source = event.source
+        decision = self.authorizer.check(source)
+        if not decision.granted:
+            log.info(
+                "refused a %s message from %s (%s)",
+                source.platform,
+                source.user_id or "?",
+                decision.step,
+            )
+            if decision.step != "bot_cooldown" and self.unauthorized is not None:
+                await self._unauthorized(source, event)
+            return False
+        if source.is_bot and self.bot_guard is not None and not event.metadata.get("bot_counted"):
+            state = self.bot_guard.admit(
+                conversation_of(source, self.settings().profile), event.message_id
+            )
+            if state in ("tripped", "cooldown"):
+                return False
+        platform = str(source.platform).lower()
+        if source.chat_type != "dm" and not event.is_command and not event.reply_to_is_own:
+            mentioned = event.metadata.get("mentioned") is True
+            policy = MentionPolicy.from_extra(self.extra_for(platform))
+            if not should_answer(
+                source,
+                mentioned=mentioned,
+                policy=policy,
+                bot_mode=self.authorizer.bot_mode(platform),
+            ):
+                return False
+        return True
+
+    async def _unauthorized(self, source: Source, event: InboundEvent) -> None:
+        handler = self.unauthorized
+        if handler is None:
+            return
+        platform = str(source.platform).lower()
+        home = self.home_for(platform)
+
+        async def send_reply(text: str) -> None:
+            await self.reply(source, text, reply_to=event.message_id, kind="notice")
+
+        async def notify_home(text: str) -> None:
+            if home:
+                await self.reply(Source(platform=platform, chat_id=str(home)), text, kind="notice")
+
+        try:
+            await handler.respond(
+                source, send_reply=send_reply, notify_home=notify_home, home_chat_id=home
+            )
+        except Exception:
+            log.warning("the unknown-sender reply failed on %s", platform, exc_info=True)
+
+    def _pause_notice(self, event: InboundEvent, key: str) -> str | None:
+        probe = self.paused
+        if probe is None or event.internal:
+            return None
+        try:
+            notice = probe()
+        except Exception:
+            log.warning("the pause probe failed; treating the gateway as running", exc_info=True)
+            return None
+        if notice is None:
+            return None
+        name = event.command
+        if name and REGISTRY.resolve(name) is not None:
+            return None
+        if self.busy(key) or self.commands.confirms.waiting(key):
+            return None
+        return notice
+
+    async def intercept(self, event: InboundEvent, key: str) -> bool:
+        """Offer the message to pending prompts; True when one took it."""
+        if not event.allow_control:
+            return False
+        for interceptor in list(self.interceptors):
+            try:
+                answer = await interceptor(event, key)
+            except Exception:
+                log.warning("a prompt reply handler failed", exc_info=True)
+                continue
+            if answer is None:
+                continue
+            await self.reply(event.source, answer, reply_to=event.message_id)
+            return True
+        return False
+
+    # -- sessions ----------------------------------------------------------------------------------
+
+    async def _create_session(self, source: Source) -> str:
+        platform = str(source.platform).lower()
+        toolsets = self.toolsets_for(platform)
+        created = await self.service.create(SessionCreateParams(toolsets=toolsets))
+        return created.session_id
+
+    async def session_for(self, key: str, source: Source) -> str:
+        """The key's session, created and routed on first use, attached to the service."""
+        entry = await run_blocking(routes.get, self.store, key, label="gateway route")
+        fresh: str | None = None
+        if entry is None:
+            fresh = await self._create_session(source)
+        made = fresh
+        entry, created = await run_blocking(
+            lambda: routes.get_or_create(
+                self.store,
+                key,
+                new_session_id=lambda: made or "",
+                platform=str(source.platform).lower(),
+                chat_type=str(source.chat_type),
+                origin=origin_of(source),
+                display_name=source.chat_name or source.user_name,
+            ),
+            label="gateway route",
+        )
+        if fresh is not None and not created and entry.session_id != fresh:
+            await self.service.close(fresh)
+        sid = self.service.current_id(entry.session_id)
+        if sid not in self.service.attached():
+            try:
+                await self.service.resume(sid)
+            except ProtocolError as exc:
+                if exc.error is not SESSION_NOT_FOUND:
+                    raise
+                sid = await self._create_session(source)
+                await run_blocking(routes.rotate, self.store, key, sid, label="gateway route")
+        self._remember(key, sid)
+        self._note_origin(sid, key, source)
+        self._watch(sid)
+        return sid
+
+    async def new_session(self, key: str, source: Source) -> str:
+        """Point the key at a fresh session (``/new``); the old one is closed."""
+        old = await self.session_id_for(key)
+        if old:
+            with contextlib.suppress(ProtocolError):
+                self.service.interrupt(old, hard=True)
+            await self.service.close(old)
+            self._applied.pop(old, None)
+        sid = await self._create_session(source)
+        entry = await run_blocking(routes.rotate, self.store, key, sid, label="gateway route")
+        if entry is None:
+            await run_blocking(
+                lambda: routes.get_or_create(
+                    self.store,
+                    key,
+                    new_session_id=lambda: sid,
+                    platform=str(source.platform).lower(),
+                    chat_type=str(source.chat_type),
+                    origin=origin_of(source),
+                ),
+                label="gateway route",
+            )
+        self._remember(key, sid)
+        self._note_origin(sid, key, source)
+        self._watch(sid)
+        return sid
+
+    async def switch_session(self, key: str, source: Source, session_id: str) -> str:
+        """Point the key at an existing session (``/resume``) and attach it."""
+        old = await self.session_id_for(key)
+        if old and old != session_id:
+            await self.service.close(old)
+        if session_id not in self.service.attached():
+            await self.service.resume(session_id)
+        entry = await run_blocking(
+            routes.rotate, self.store, key, session_id, label="gateway route"
+        )
+        if entry is None:
+            await self.session_for(key, source)
+            await run_blocking(routes.rotate, self.store, key, session_id, label="gateway route")
+        self._remember(key, session_id)
+        self._note_origin(session_id, key, source)
+        self._watch(session_id)
+        return session_id
+
+    def _watch(self, session_id: str) -> None:
+        """Listen for the session's server requests once."""
+        if session_id in self._watched:
+            return
+        try:
+            self._undo.append(
+                self.service.on_request(session_id, lambda req: self._on_request(session_id, req))
+            )
+        except ProtocolError:
+            return
+        self._watched.add(session_id)
+
+    def _on_request(self, session_id: str, request: ProtocolModel) -> None:
+        self.spawn(self._deliver_request(session_id, request), name="server request")
+
+    async def _deliver_request(self, session_id: str, request: ProtocolModel) -> None:
+        origin = await self._origin_of(self.service.current_id(session_id))
+        if origin is None:
+            return
+        kind = getattr(request, "kind", "")
+        if kind in _SECRET_KINDS:
+            await self.reply(origin.source, SECRET_PROMPT, kind="notice")
+            return
+        if self.on_request is not None:
+            await self.on_request(origin.source, request)
+            return
+        if kind == "approval":
+            text = APPROVAL_FALLBACK.format(
+                command=getattr(request, "command", ""), why=getattr(request, "description", "")
+            )
+            await self.reply(origin.source, text, kind="notice")
+
+    async def _on_moved(self, old: str, new: str) -> None:
+        """A rotating compaction continued ``old`` in ``new``: keep the routes pointing at it."""
+        try:
+            entries = await run_blocking(
+                routes.routes_for_session, self.store, old, label="gateway route"
+            )
+            for entry in entries:
+                await run_blocking(
+                    routes.rotate, self.store, entry.session_key, new, label="gateway route"
+                )
+                self._remember(entry.session_key, new)
+        except Exception:
+            log.warning("could not move the routes of %s to %s", old, new, exc_info=True)
+        origin = self._origins.pop(old, None)
+        if origin is not None:
+            self._note_origin(new, origin.key, origin.source)
+        self._watch(new)
+
+    # -- models ------------------------------------------------------------------------------------
+
+    async def effective_model(
+        self, key: str, source: Source, *, include_once: bool = True
+    ) -> ModelChoice | None:
+        """Precedence: one-turn override → session override → channel override → default."""
+        if include_once and key in self.once_next:
+            return self.once_next[key]
+        entry = await run_blocking(routes.get, self.store, key, label="gateway route")
+        override = entry.model_override if entry is not None else None
+        if override and override.get("model"):
+            return ModelChoice(
+                override["model"],
+                override.get("provider") or None,
+                override.get("base_url") or None,
+                "session",
+            )
+        try:
+            channel = self.channel_model(str(source.platform).lower(), str(source.chat_id))
+        except Exception:
+            channel = None
+        return channel
+
+    async def apply_model(self, session_id: str, choice: ModelChoice | None) -> None:
+        """Bind ``choice`` to the session when it differs from what it has now."""
+        current = self._applied.get(session_id)
+        same = (current is None and choice is None) or (
+            current is not None
+            and choice is not None
+            and current.as_override() == choice.as_override()
+        )
+        if same:
+            return
+        await self.switcher.apply(self.service, session_id, choice)
+        self._applied[session_id] = choice
+
+    # -- turns -------------------------------------------------------------------------------------
+
+    async def run_admitted(
+        self, event: InboundEvent, key: str, *, background: bool = False
+    ) -> None:
+        """Claim the key (synchronously) and run the turn; a lost race makes it a busy message."""
+        claim = self.claims.claim(key)
+        if claim is None:
+            await self.busy_guard.while_busy(event, key)
+            return
+        if background:
+            self.spawn(self.run_claimed(event, key, claim), name="turn")
+            return
+        await self.run_claimed(event, key, claim)
+
+    async def run_claimed(self, event: InboundEvent, key: str, claim: Claim) -> None:
+        cap = self.cap
+        if cap is not None:
+            if not cap.try_claim(key):
+                self.claims.release(claim)
+                await self.reply(event.source, CONCURRENCY_REFUSAL, reply_to=event.message_id)
+                return
+            claim.capped = True
+        claim.task = asyncio.current_task()
+        await self._turn(event, key, claim)
+
+    async def _post_admission(self, event: InboundEvent, key: str) -> None:
+        if self.hooks is None or event.internal:
+            return
+        try:
+            await self.hooks.observe(
+                "post_gateway_admission",
+                event=event,
+                session_key=key,
+                platform=event.source.platform,
+            )
+        except Exception:
+            log.warning("post_gateway_admission failed (ignored)", exc_info=True)
+
+    async def _model_text(self, event: InboundEvent) -> str:
+        if self.enrich is not None:
+            return await self.enrich(event)
+        if self.sent_index is not None:
+            from indus.gateway.core.events import with_reply_context
+
+            event = with_reply_context(event, self.sent_index)
+        text = model_text(event)
+        if event.media and not text.strip():
+            count = len(event.media)
+            text = f"[The person sent {count} attachment(s) this chat cannot read yet.]"
+        return text
+
+    async def _turn(self, event: InboundEvent, key: str, claim: Claim) -> None:
+        source = event.source
+        token = f"turn-{claim.generation}"
+        marked = False
+        sid: str | None = None
+        try:
+            await self._post_admission(event, key)
+            sid = await self.session_for(key, source)
+            claim.session_id = sid
+            identity = current_identity()
+            if identity is not None:
+                bind_identity(replace(identity, session_id=sid))
+            choice = await self.effective_model(key, source)
+            if key in self.once_next:
+                del self.once_next[key]
+                self._once_turns[claim.generation] = (key, sid, source)
+            try:
+                await self.apply_model(sid, choice)
+            except Exception as exc:
+                log.warning("could not switch the model of %s: %s", sid, exc)
+            text = await self._model_text(event)
+            if not text.strip():
+                return
+            marked = await run_blocking(
+                routes.begin_turn, self.store, key, token, label="active-turn marker"
+            )
+            try:
+                ticket = await self.service.submit(sid, text)
+            except ProtocolError as exc:
+                if exc.error is SESSION_BUSY and sid in self.service.attached():
+                    self.pending.push_front(key, event)  # runs when the running turn ends
+                    return
+                raise
+            claim.turn_generation = ticket.generation
+            self._anchor(sid, ticket.generation, event.message_id)
+            result = await self.service.wait(sid, ticket.turn_id)
+            if result.exit_reason is not ExitReason.COMPLETED and result.exit_reason not in (
+                _INTERRUPTED
+            ):
+                reason = result.failure_reason or result.exit_reason.value.replace("_", " ")
+                await self.reply(
+                    source,
+                    FAILED_TURN.format(reason=reason),
+                    reply_to=event.message_id,
+                    kind="notice",
+                )
+        except ProtocolError as exc:
+            if exc.error is TEXT_EMPTY:
+                return
+            if exc.error is SESSION_BUSY:
+                text = f"{BUSY_COPY['what']} {BUSY_COPY['todo']}"
+            else:
+                text = FAILED_TURN.format(reason=exc.message)
+            await self.reply(source, text, reply_to=event.message_id, kind="notice")
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            log.exception("the turn for %s failed", key)
+            await self.reply(
+                source,
+                FAILED_TURN.format(reason=type(exc).__name__),
+                reply_to=event.message_id,
+                kind="notice",
+            )
+        finally:
+            await self._finish(key, claim, token, marked, sid)
+
+    async def _finish(
+        self, key: str, claim: Claim, token: str, marked: bool, sid: str | None
+    ) -> None:
+        once = self._once_turns.pop(claim.generation, None)
+        if once is not None:
+            once_key, once_sid, once_source = once
+            try:
+                choice = await self.effective_model(once_key, once_source, include_once=False)
+                await self.apply_model(self.service.current_id(once_sid), choice)
+            except Exception:
+                log.warning("could not restore the model after a one-turn switch", exc_info=True)
+        if marked:
+            try:
+                await run_blocking(
+                    routes.end_turn, self.store, key, token, label="active-turn marker"
+                )
+            except Exception:
+                log.warning("could not clear the active-turn marker of %s", key, exc_info=True)
+        released = self.claims.release(claim)
+        if released and claim.capped and self.cap is not None:
+            self.cap.release(key)
+        if released:
+            self.drain(key)
+
+    def _anchor(self, session_id: str, generation: int, message_id: str | None) -> None:
+        if not message_id:
+            return
+        self._anchors[(session_id, generation)] = message_id
+        while len(self._anchors) > _ANCHORS_KEPT:
+            self._anchors.popitem(last=False)
+
+    def drain(self, key: str) -> bool:
+        """Start the key's next queued message when the key is free; True when one started."""
+        if self._closed or self.claims.current(key) is not None:
+            return False
+        if self.is_running(self.cached_session(key)):
+            return False
+        event = self.pending.pop(key)
+        if event is None:
+            return False
+        claim = self.claims.claim(key)
+        assert claim is not None  # checked above, no await in between
+        self.spawn(self.run_claimed(event, key, claim), name="queued message")
+        return True
+
+    async def _on_turn_end(self, ended: TurnEnd) -> None:
+        """Deliver a completed turn's final text to its chat; then the next queued message."""
+        session_id = self.service.current_id(ended.session_id)
+        origin = await self._origin_of(session_id)
+        if origin is None:
+            return
+        anchor = self._anchors.pop((ended.session_id, ended.generation), None)
+        if ended.completed and ended.final_text.strip():
+            await self.reply(origin.source, ended.final_text, reply_to=anchor, kind="final")
+        self.drain(origin.key)
+
+    # -- busy acknowledgements ---------------------------------------------------------------------
+
+    def take_tip(self, settings: IntakeSettings) -> bool:
+        """True once per install: the first busy acknowledgement carries the tip."""
+        if self._tip_shown or settings.busy_tip_seen:
+            return False
+        self._tip_shown = True
+        self.spawn(self._save_tip_seen(), name="busy tip flag")
+        return True
+
+    async def _save_tip_seen(self) -> None:
+        try:
+            await run_blocking(
+                config_writer.save,
+                self.scope,
+                {"onboarding": {"seen": {"busy_input": True}}},
+                label="settings write",
+            )
+        except Exception:
+            log.warning("could not record that the busy tip was shown", exc_info=True)
+
+
+def admitted_copy(event: InboundEvent, **changes: Any) -> InboundEvent:
+    """A copy marked as already counted by the bot-loop guard (queued follow-ups)."""
+    metadata = {**event.metadata, "bot_counted": True}
+    return event.model_copy(update={"metadata": metadata, **changes})
diff --git a/src/indus/gateway/core/authz.py b/src/indus/gateway/core/authz.py
new file mode 100644
index 0000000..604483a
--- /dev/null
+++ b/src/indus/gateway/core/authz.py
@@ -0,0 +1,618 @@
+"""Who may talk to the agent, what a stranger sees, and when a group message is answered (P15-08).
+
+``Authorizer.check`` runs an ordered chain; the first grant wins and anything that falls through
+is denied (K14). Any error inside the chain is a denial: it fails closed.
+
+1. ``trusted_platform``: webhook and ``trusted_inbound`` platforms (their own signature or key
+   authenticated the event);
+2. chat-scoped grants that need no user id: ``upstream`` (the adapter authorizes upstream),
+   ``group_chat_allowlist`` (a group chat listed by id), ``bot_allowed`` (a bot sender admitted by
+   the platform's allow-bots setting ``mentions`` or ``all``);
+3. ``no_user_id``: deny;
+4. ``platform_allow_all``: the platform's allow-all switch;
+5. ``role``: an adapter-verified role grant carried on the source (Discord role allowlist);
+6. ``paired``: a pairing approval (P15-09);
+7. when no env allowlist exists at all: ``own_policy`` (the adapter's own access policy, only an
+   ``allowlist`` policy is a verdict), ``config_allowlist`` (``allow_from`` /
+   ``group_allow_from``), ``global_allow_all``;
+8. otherwise ``allowlist``: the union of the platform, group-user and global env allowlists plus
+   ids the adapter resolved from names; ``*`` means everyone;
+9. ``default_deny``.
+A bot-authored message that passes is still refused (``bot_cooldown``) while its conversation's
+bot-loop guard cools down; the guard is only read here (admission counts once, P15-10).
+Button presses are authorized by the same chain with the presser as the source.
+
+Unknown DM behaviour (``pair`` / ``ignore`` / ``decline``, R06.8): the platform's own setting;
+else the global one when it differs from the default; else the adapter's own DM policy (pairing →
+pair, allowlist / disabled → ignore); else ``ignore`` when any allowlist is configured; else
+``pair``. ``UnauthorizedHandler`` acts on it: groups and id-less messages are dropped silently,
+bots never get a code, codes and login offers need a platform whose DMs are private (R06.24),
+``ignore`` logs the fix and tells the home channel once per sender, ``decline`` answers once per
+sender per 24 h (stamp first). Mention gating: in groups, answer only when mentioned unless the
+channel is free-response.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import threading
+from collections.abc import Awaitable, Callable, Iterable, Mapping
+from dataclasses import dataclass
+from typing import Any, Literal
+
+from indus.gateway.core._shapes import AdapterLike, SourceLike, capability, flag, text_of
+from indus.gateway.core.bot_loop import BotLoopGuard, conversation_of
+from indus.gateway.registry import PlatformEntry, PlatformRegistry, policy_env_name
+from indus.state.pairing import CODE_TTL_SECONDS, PairingStore
+
+__all__ = [
+    "DEFAULT_UNKNOWN_DM",
+    "GLOBAL_ALLOWLIST_ENV",
+    "GLOBAL_ALLOW_ALL_ENV",
+    "UNKNOWN_DM_MODES",
+    "AuthzDecision",
+    "Authorizer",
+    "MentionPolicy",
+    "PlatformPolicy",
+    "Response",
+    "UnauthorizedHandler",
+    "UnknownDmMode",
+    "allow_set",
+    "decline_text",
+    "pairing_reply",
+    "should_answer",
+    "try_later_text",
+]
+
+log = logging.getLogger(__name__)
+
+GLOBAL_ALLOWLIST_ENV = "INDUS_GATEWAY_ALLOWED_USERS"
+GLOBAL_ALLOW_ALL_ENV = "INDUS_GATEWAY_ALLOW_ALL_USERS"
+UNKNOWN_DM_MODES = ("pair", "ignore", "decline")
+DEFAULT_UNKNOWN_DM = "pair"
+_TRUTHY = frozenset({"1", "true", "yes", "on"})
+_BOT_MODES = frozenset({"mentions", "all"})
+_MAX_NAME = 64
+_MAX_SEEN = 2048
+_SIGILS = set("@<>[]()`*_~#|")
+
+type UnknownMode = Literal["pair", "ignore", "decline"]
+
+
+# -- helpers --------------------------------------------------------------------------------------
+
+
+def allow_set(raw: object) -> set[str]:
+    """An allowlist from a YAML list, a JSON-list string or a comma string; blanks dropped."""
+    if raw is None:
+        return set()
+    if isinstance(raw, str):
+        text = raw.strip()
+        if text.startswith("["):
+            try:
+                raw = json.loads(text)
+            except ValueError:
+                raw = text
+        else:
+            return {part.strip() for part in text.split(",") if part.strip()}
+    if isinstance(raw, list | tuple | set | frozenset):
+        items: Iterable[Any] = raw  # pyright: ignore[reportUnknownVariableType]
+        return {str(item).strip() for item in items if str(item).strip()}
+    text = str(raw).strip()
+    return {text} if text else set()
+
+
+def _allows(allowed: set[str], *candidates: str) -> bool:
+    return "*" in allowed or any(c and c in allowed for c in candidates)
+
+
+def _truthy(value: str) -> bool:
+    return value.strip().lower() in _TRUTHY
+
+
+def _is_group(source: SourceLike) -> bool:
+    return (text_of(source.chat_type).lower() or "dm") != "dm"
+
+
+def _str_or_empty(value: object) -> str:
+    return value.strip() if isinstance(value, str) else ""
+
+
+# -- inputs and results ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PlatformPolicy:
+    """What the chain needs to know about one platform (from its registry entry)."""
+
+    platform: str
+    allowlist_env: str = ""
+    allow_all_env: str = ""
+    allow_bots_env: str = ""
+    group_users_env: str = ""
+    group_chats_env: str = ""
+    trusted_inbound: bool = False
+    dm_is_private: bool = True
+
+    @classmethod
+    def from_entry(cls, entry: PlatformEntry) -> PlatformPolicy:
+        return cls(
+            platform=entry.name,
+            allowlist_env=entry.allowlist_env,
+            allow_all_env=entry.allow_all_env,
+            allow_bots_env=entry.allow_bots_env or "",
+            group_users_env=entry.group_users_env,
+            group_chats_env=entry.group_chats_env,
+            trusted_inbound=entry.trusted_inbound,
+            dm_is_private=entry.dm_is_private,
+        )
+
+    @classmethod
+    def standard(cls, platform: str) -> PlatformPolicy:
+        """The ``INDUS_<PLATFORM>_*`` names for a platform with no special settings."""
+        return cls(
+            platform=platform,
+            allowlist_env=policy_env_name(platform, "ALLOWED_USERS"),
+            allow_all_env=policy_env_name(platform, "ALLOW_ALL_USERS"),
+            allow_bots_env=policy_env_name(platform, "ALLOW_BOTS"),
+        )
+
+
+@dataclass(frozen=True)
+class AuthzDecision:
+    granted: bool
+    step: str
+    detail: str = ""
+
+
+@dataclass(frozen=True)
+class UnknownDmMode:
+    mode: UnknownMode
+    why: str
+
+
+def _grant(step: str, detail: str = "") -> AuthzDecision:
+    return AuthzDecision(True, step, detail)
+
+
+def _deny(step: str, detail: str = "") -> AuthzDecision:
+    return AuthzDecision(False, step, detail)
+
+
+# -- the chain ------------------------------------------------------------------------------------
+
+
+class Authorizer:
+    """The authorization chain for one gateway profile.
+
+    ``env(name)`` reads a policy value (the profile's secret store first, then its env);
+    ``extra_for(platform)`` returns ``platforms.<platform>.extra``; ``adapter_for(platform)`` the
+    connected adapter (or None); ``is_paired(platform, user_id)`` the pairing check.
+    """
+
+    def __init__(
+        self,
+        *,
+        policy_for: Callable[[str], PlatformPolicy | None],
+        env: Callable[[str], str | None],
+        extra_for: Callable[[str], Mapping[str, Any] | None] = lambda _p: None,
+        adapter_for: Callable[[str], AdapterLike | None] = lambda _p: None,
+        is_paired: Callable[[str, str], bool] | None = None,
+        global_unknown_dm: Callable[[], object] = lambda: None,
+        bot_guard: BotLoopGuard | None = None,
+        profile: str = "",
+    ) -> None:
+        self._policy_for = policy_for
+        self._env = env
+        self._extra_for = extra_for
+        self._adapter_for = adapter_for
+        self._is_paired = is_paired
+        self._global_unknown_dm = global_unknown_dm
+        self.bot_guard = bot_guard
+        self.profile = profile
+
+    @classmethod
+    def from_registry(cls, registry: PlatformRegistry, **kwargs: Any) -> Authorizer:
+        def policy_for(platform: str) -> PlatformPolicy | None:
+            entry = registry.get(platform)
+            return None if entry is None else PlatformPolicy.from_entry(entry)
+
+        return cls(policy_for=policy_for, **kwargs)
+
+    # -- readers ---------------------------------------------------------------------------------
+
+    def policy(self, platform: str) -> PlatformPolicy | None:
+        return self._policy_for(platform.strip().lower())
+
+    def _read(self, name: str) -> str:
+        if not name:
+            return ""
+        value = self._env(name)
+        return value.strip() if isinstance(value, str) else ""
+
+    def _extra(self, platform: str) -> Mapping[str, Any]:
+        extra = self._extra_for(platform)
+        return extra if isinstance(extra, Mapping) else {}
+
+    def bot_mode(self, platform: str) -> str:
+        """``none`` / ``mentions`` / ``all``: which bot senders the platform admits."""
+        extra = self._extra(platform)
+        raw = extra.get("allow_bots")
+        if raw is None:
+            policy = self._policy_for(platform)
+            raw = self._read(policy.allow_bots_env) if policy is not None else ""
+        mode = str(raw).strip().lower() if raw is not None else ""
+        return mode if mode in _BOT_MODES else "none"
+
+    def _env_lists(self, policy: PlatformPolicy, *, group: bool) -> dict[str, str]:
+        """The env allowlists that apply here, by env name (empty ones left out)."""
+        names = [policy.allowlist_env, GLOBAL_ALLOWLIST_ENV]
+        if group:
+            names += [policy.group_users_env, policy.group_chats_env]
+        return {n: v for n in names if n and (v := self._read(n))}
+
+    def configured_allowlists(self, platform: str) -> list[str]:
+        """Every allowlist the chain would read for ``platform`` that has entries."""
+        policy = self._policy_for(platform)
+        found: list[str] = []
+        if policy is not None:
+            found += list(self._env_lists(policy, group=True))
+        extra = self._extra(platform)
+        for key in ("allow_from", "group_allow_from", "group_allowed_chats"):
+            if allow_set(extra.get(key)):
+                found.append(f"platforms.{platform}.extra.{key}")
+        return found
+
+    # -- check -----------------------------------------------------------------------------------
+
+    def check(self, source: SourceLike, *, allow_delegation: bool = True) -> AuthzDecision:
+        """May ``source`` reach the agent? Never raises: an error is a denial."""
+        try:
+            decision = self._principal(source, allow_delegation=allow_delegation)
+            guard = self.bot_guard
+            if (
+                decision.granted
+                and flag(source, "is_bot")
+                and guard is not None
+                and guard.blocked(conversation_of(source, self.profile))
+            ):
+                return _deny("bot_cooldown", "this chat's bot-loop guard is cooling down")
+            return decision
+        except Exception as exc:
+            log.error("authorization failed closed for a %s message: %s", source.platform, exc)
+            return _deny("error", str(exc))
+
+    def _principal(self, source: SourceLike, *, allow_delegation: bool) -> AuthzDecision:
+        platform = text_of(source.platform).lower()
+        policy = self._policy_for(platform)
+        if policy is None:
+            return _deny("unknown_platform", platform)
+        if platform == "webhook" or policy.trusted_inbound:
+            return _grant("trusted_platform")
+
+        group = _is_group(source)
+        adapter = self._adapter_for(platform)
+        extra = self._extra(platform)
+        chat_id = text_of(source.chat_id)
+
+        # Chat-scoped grants: no user id needed.
+        if allow_delegation and capability(adapter, "auth_upstream"):
+            return _grant("upstream")
+        if group and chat_id:
+            chats = allow_set(self._read(policy.group_chats_env)) | allow_set(
+                extra.get("group_allowed_chats")
+            )
+            if _allows(chats, chat_id):
+                return _grant("group_chat_allowlist")
+        if flag(source, "is_bot") and self.bot_mode(platform) in _BOT_MODES:
+            return _grant("bot_allowed")
+
+        user = text_of(source.user_id)
+        if not user:
+            return _deny("no_user_id")
+        alt = text_of(source.user_id_alt)
+        if policy.allow_all_env and _truthy(self._read(policy.allow_all_env)):
+            return _grant("platform_allow_all")
+        if allow_delegation and source.role_authorized is True:
+            return _grant("role")
+        if self._is_paired is not None and self._is_paired(platform, user):
+            return _grant("paired")
+
+        env_lists = self._env_lists(policy, group=group)
+        if not env_lists:
+            owns = allow_delegation and capability(adapter, "owns_access_policy")
+            if owns and adapter is not None:
+                verdict = self._own_policy(adapter, user, group=group)
+                if verdict is not None:
+                    return (_grant if verdict else _deny)("own_policy")
+            configured = allow_set(extra.get("group_allow_from" if group else "allow_from"))
+            if configured and _allows(configured, user, alt):
+                return _grant("config_allowlist")
+            if _truthy(self._read(GLOBAL_ALLOW_ALL_ENV)):
+                return _grant("global_allow_all")
+            return _deny("default_deny", "no allowlist names this sender")
+
+        ids: set[str] = set()
+        for name in (policy.allowlist_env, policy.group_users_env, GLOBAL_ALLOWLIST_ENV):
+            if name in env_lists:
+                ids |= allow_set(env_lists[name])
+        if policy.allowlist_env in env_lists:
+            ids |= self._resolved_ids(adapter)
+        if _allows(ids, user, alt):
+            return _grant("allowlist")
+        return _deny("default_deny", "not in the allowlist")
+
+    @staticmethod
+    def _own_policy(adapter: AdapterLike, user: str, *, group: bool) -> bool | None:
+        """The adapter's own verdict: only an ``allowlist`` policy counts (open forwards anyone)."""
+        policy = adapter.access_policy("group" if group else "dm")
+        if not isinstance(policy, str) or policy.strip().lower() != "allowlist":
+            return None
+        if group:
+            return True
+        return adapter.allows_dm(user) is True
+
+    @staticmethod
+    def _resolved_ids(adapter: AdapterLike | None) -> set[str]:
+        if adapter is None:
+            return set()
+        found: Iterable[object] = adapter.resolved_allowlist_ids()
+        return {str(i).strip() for i in found if isinstance(i, str | int) and str(i).strip()}
+
+    # -- unknown senders -------------------------------------------------------------------------
+
+    def unknown_dm_mode(self, platform: str) -> UnknownDmMode:
+        """What an unauthorized DM on ``platform`` gets, and why (setup and doctor print it)."""
+        platform = platform.lower()
+        extra = self._extra(platform)
+        own = _str_or_empty(extra.get("unauthorized_dm_behavior")).lower()
+        if own in UNKNOWN_DM_MODES:
+            return UnknownDmMode(
+                own,  # pyright: ignore[reportArgumentType]
+                f"set by platforms.{platform}.extra.unauthorized_dm_behavior",
+            )
+        global_mode = _str_or_empty(self._global_unknown_dm()).lower()
+        if global_mode in UNKNOWN_DM_MODES and global_mode != DEFAULT_UNKNOWN_DM:
+            return UnknownDmMode(
+                global_mode,  # pyright: ignore[reportArgumentType]
+                "set by gateway.unauthorized_dm_behavior",
+            )
+        dm_policy = ""
+        adapter = self._adapter_for(platform)
+        if adapter is not None:
+            got = adapter.access_policy("dm")
+            dm_policy = got.strip().lower() if isinstance(got, str) else ""
+        if not dm_policy:
+            dm_policy = _str_or_empty(extra.get("dm_policy")).lower()
+        if dm_policy == "pairing":
+            return UnknownDmMode("pair", f"the {platform} DM policy is pairing")
+        if dm_policy in {"allowlist", "disabled"}:
+            return UnknownDmMode("ignore", f"the {platform} DM policy is {dm_policy}")
+        lists = self.configured_allowlists(platform)
+        if lists:
+            return UnknownDmMode(
+                "ignore",
+                f"an allowlist is configured ({', '.join(lists)}), so unknown senders get no "
+                "pairing code; set unauthorized_dm_behavior: pair to change that",
+            )
+        return UnknownDmMode("pair", "no allowlist is configured, so unknown senders get a code")
+
+    def explain(self, platform: str) -> str:
+        mode = self.unknown_dm_mode(platform)
+        return f"{platform}: unknown direct messages → {mode.mode} ({mode.why})"
+
+    def dm_is_private(self, platform: str) -> bool:
+        """Codes and login offers go only where a DM is really private (R06.24)."""
+        policy = self._policy_for(platform.lower())
+        if policy is None or not policy.dm_is_private:
+            return False
+        adapter = self._adapter_for(platform.lower())
+        return adapter is None or adapter.capabilities.dm_is_private is not False
+
+
+# -- reply copy (ours, D-16.23) -------------------------------------------------------------------
+
+
+def pairing_reply(platform: str, code: str, profile: str = "") -> str:
+    profile_arg = f"-p {profile} " if profile and profile != "default" else ""
+    hours = max(1, CODE_TTL_SECONDS // 3600)
+    lifetime = "one hour" if hours == 1 else f"{hours} hours"
+    return (
+        "Hi! This bot doesn't know you yet. Its owner can let you in by running:\n\n"
+        f"    indus {profile_arg}pairing approve {platform} {code}\n\n"
+        f"The code works for {lifetime}. Once you're in, send your message again."
+    )
+
+
+def try_later_text() -> str:
+    return "Too many pairing requests right now. Please try again later."
+
+
+def decline_text() -> str:
+    return "Sorry, this bot only talks to people its owner has let in."
+
+
+def _safe_name(name: str) -> str:
+    cut = "".join(ch for ch in name[:_MAX_NAME] if ch.isprintable() and ch not in _SIGILS)
+    return " ".join(cut.split())
+
+
+def owner_hint(platform: str, user_id: str, user_name: str, allowlist_env: str) -> str:
+    name = _safe_name(user_name)
+    who = f"{name} ({user_id})" if name else user_id
+    where = (
+        f"add {user_id} to {allowlist_env} in the profile's .env"
+        if allowlist_env
+        else "add their id to the platform's allowlist"
+    )
+    return (
+        f"Ignored a direct message on {platform} from {who}, who is not allowed in. To let them "
+        f"in, {where}, or set platforms.{platform}.extra.unauthorized_dm_behavior: pair."
+    )
+
+
+# -- acting on a denial ---------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Response:
+    action: Literal["silent", "ignored", "declined", "paired", "try_later"]
+    detail: str = ""
+
+
+class UnauthorizedHandler:
+    """What an unauthorized sender gets (and what the owner hears about it)."""
+
+    def __init__(
+        self,
+        authorizer: Authorizer,
+        pairing: PairingStore,
+        *,
+        max_seen: int = _MAX_SEEN,
+    ) -> None:
+        self.authorizer = authorizer
+        self.pairing = pairing
+        self._seen: dict[tuple[str, str], None] = {}
+        self._max_seen = max(1, max_seen)
+        self._lock = threading.Lock()
+
+    def first_time(self, platform: str, user_id: str) -> bool:
+        """True the first time this sender is seen (bounded memory: oldest senders forgotten)."""
+        key = (platform, user_id)
+        with self._lock:
+            known = key in self._seen
+            self._seen.pop(key, None)
+            self._seen[key] = None  # newest last
+            if len(self._seen) > self._max_seen:
+                oldest = next(iter(self._seen))
+                del self._seen[oldest]
+            return not known
+
+    async def respond(
+        self,
+        source: SourceLike,
+        *,
+        send_reply: Callable[[str], Awaitable[object]],
+        notify_home: Callable[[str], Awaitable[object]] | None = None,
+        home_chat_id: str | None = None,
+    ) -> Response:
+        platform = text_of(source.platform).lower()
+        user = text_of(source.user_id)
+        if _is_group(source) or not user:
+            return Response("silent")
+        mode = self.authorizer.unknown_dm_mode(platform).mode
+        if mode == "pair" and (
+            flag(source, "is_bot") or not self.authorizer.dm_is_private(platform)
+        ):
+            mode = "ignore"
+        if mode == "decline":
+            return await self._decline(platform, user, send_reply)
+        if mode == "pair":
+            return await self._pair(source, platform, user, send_reply)
+        return await self._ignore(source, platform, user, notify_home, home_chat_id)
+
+    async def _decline(
+        self, platform: str, user: str, send_reply: Callable[[str], Awaitable[object]]
+    ) -> Response:
+        if self.pairing.has_recent_decline(platform, user):
+            return Response("silent", "declined within the last 24 h")
+        self.pairing.record_decline(platform, user)  # before the send: a failure cannot repeat
+        try:
+            await send_reply(decline_text())
+        except Exception as exc:
+            log.warning("could not send the decline reply on %s: %s", platform, exc)
+        return Response("declined")
+
+    async def _pair(
+        self,
+        source: SourceLike,
+        platform: str,
+        user: str,
+        send_reply: Callable[[str], Awaitable[object]],
+    ) -> Response:
+        request = self.pairing.request_code(platform, user, text_of(source.user_name))
+        if request.status == "issued" and request.code is not None:
+            text = pairing_reply(platform, request.code, self.authorizer.profile)
+            try:
+                await send_reply(text)
+            except Exception as exc:
+                log.warning("could not send the pairing code on %s: %s", platform, exc)
+            log.info(
+                "pairing request %s opened on %s for user %s", request.request_id, platform, user
+            )
+            return Response("paired", request.request_id or "")
+        if request.notify:
+            try:
+                await send_reply(try_later_text())
+            except Exception as exc:
+                log.warning("could not send the try-later reply on %s: %s", platform, exc)
+            return Response("try_later", request.status)
+        return Response("silent", request.status)
+
+    async def _ignore(
+        self,
+        source: SourceLike,
+        platform: str,
+        user: str,
+        notify_home: Callable[[str], Awaitable[object]] | None,
+        home_chat_id: str | None,
+    ) -> Response:
+        if not self.first_time(platform, user):
+            return Response("silent", "already reported")
+        policy = self.authorizer.policy(platform)
+        hint = owner_hint(
+            platform,
+            user,
+            text_of(source.user_name),
+            policy.allowlist_env if policy is not None else "",
+        )
+        log.warning("%s", hint)
+        own_chat = text_of(source.chat_id)
+        if notify_home is not None and home_chat_id and str(home_chat_id) != own_chat:
+            try:
+                await notify_home(hint)
+            except Exception as exc:
+                log.warning(
+                    "could not tell the %s home channel about a stranger: %s", platform, exc
+                )
+        return Response("ignored")
+
+
+# -- mention gating -------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class MentionPolicy:
+    require_mention: bool = True
+    free_response: frozenset[str] = frozenset()
+
+    @classmethod
+    def from_extra(cls, extra: Mapping[str, Any] | None) -> MentionPolicy:
+        data: Mapping[str, Any] = extra if isinstance(extra, Mapping) else {}
+        raw = data.get("require_mention")
+        require = True if raw is None else (raw if isinstance(raw, bool) else _truthy(str(raw)))
+        return cls(require, frozenset(allow_set(data.get("free_response_channels"))))
+
+
+def should_answer(
+    source: SourceLike, *, mentioned: bool, policy: MentionPolicy, bot_mode: str = "none"
+) -> bool:
+    """In groups answer only when mentioned, unless the channel is free-response.
+
+    A bot admitted with ``mentions`` must mention us like anyone else; ``all`` answers bots freely.
+    """
+    if not _is_group(source):
+        return True
+    if flag(source, "is_bot") and bot_mode == "all":
+        return True
+    if not policy.require_mention:
+        return True
+    where = {
+        text_of(source.chat_id),
+        text_of(source.parent_chat_id),
+        text_of(source.thread_id),
+    } - {""}
+    if where & policy.free_response:
+        return True
+    return mentioned
