+    store = PairingStore(scoped)
+    store.approve_code("telegram", _issue(store, "c"))
+    assert (
+        envfile.read_env_file(env_file_path(scope.home))["INDUS_TELEGRAM_ALLOWED_USERS"] == "a,b,c"
