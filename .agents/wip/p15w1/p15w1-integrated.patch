@@ -0,0 +1,487 @@
+"""Media tags in replies and the outbound path policy (P15-18, R06.22).
+
+The agent attaches files by writing ``MEDIA:<path>`` (quote the path when it has spaces), adds
+``[[audio_as_voice]]`` or ``[[as_document]]`` to change how they are sent, or embeds image
+Markdown ``![alt](target)``. ``extract_media`` pulls these out of the reply text (never from
+fenced or inline code) and removes them.
+
+The path comes from the model, or from text the model was fed, so delivery is a security
+boundary. ``MediaPolicy.check`` delivers a local file only when, after every symlink is resolved:
+
+- it is a regular file that passes the P05 read checks (no device or ``/proc`` file, no Indus
+  secret store or control file, no secret env file) and is outside the deny-list of credential
+  and system locations (both the path as written and the resolved path are checked);
+- and it lives in a trusted place: the profile's gateway caches, an operator-listed folder, or —
+  only when ``gateway.media_trust_recent`` is on (off by default; lead decision, D-16) and not in
+  strict mode — it was modified in the last ``recent_seconds`` (600 by default). Linux keeps no
+  birth time, so "recent" is the modification time, which any process can bump with ``touch``.
+
+Strict mode trusts the listed folders only. Files inside a remote terminal sandbox are copied
+into the document cache only after the sandbox path passes the same deny-list before and after
+the sandbox resolves it; strict mode never fetches. Each refusal becomes a short notice.
+"""
+
+from __future__ import annotations
+
+import os
+import posixpath
+import re
+import secrets
+import stat
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Literal, Protocol
+
+from pydantic import ValidationError
+
+from indus.foundation.config.schema import GatewaySection
+from indus.foundation.home import secure_dir
+from indus.foundation.scope import Scope
+from indus.gateway.config import gateway_section
+from indus.safety.path_guards import (
+    INDUS_CONTROL_FILES,
+    INDUS_SECRET_FILES,
+    blocked_device,
+    homes_for,
+    indus_dirs,
+    nt_namespace_error,
+    read_denial,
+)
+
+__all__ = [
+    "CACHE_DIRS",
+    "FETCH_MAX_BYTES",
+    "MediaItem",
+    "MediaKind",
+    "MediaPolicy",
+    "MediaRef",
+    "RemoteFiles",
+    "Verdict",
+    "extract_media",
+    "fetch_remote",
+    "screen_remote_path",
+    "strip_media_tags",
+]
+
+type MediaKind = Literal["image", "video", "audio", "voice", "document"]
+
+CACHE_DIRS = ("images", "audio", "video", "documents")
+FETCH_MAX_BYTES = 50 * 1024 * 1024
+RECENT_SECONDS_DEFAULT = 600.0
+_FUTURE_SKEW = 60.0
+
+_IMAGE = frozenset([".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"])
+_VIDEO = frozenset([".mp4", ".mov", ".webm", ".mkv", ".avi", ".3gp", ".m4v"])
+_AUDIO = frozenset([".mp3", ".wav", ".ogg", ".opus", ".m4a", ".flac", ".aac"])
+
+SYSTEM_PREFIXES = (
+    "/etc",
+    "/proc",
+    "/sys",
+    "/dev",
+    "/boot",
+    "/root",
+    "/run",
+    "/var/run",
+    "/var/log",
+    "/var/lib",
+    "/private/etc",
+    "/private/var",
+)
+HOME_DENIED = (
+    ".ssh",
+    ".aws",
+    ".gnupg",
+    ".kube",
+    ".docker",
+    ".azure",
+    ".config",
+    ".gcloud",
+    ".netrc",
+    ".password-store",
+    ".local/share/keyrings",
+    "Library/Keychains",
+)
+_STORE_FILES = tuple(f"state.db{suffix}" for suffix in ("", "-wal", "-shm", "-journal"))
+INDUS_DENIED = (
+    *INDUS_SECRET_FILES,
+    *INDUS_CONTROL_FILES,
+    *_STORE_FILES,
+    "pairing",
+    "sessions",
+    "platforms",
+    "auth",
+    "credentials",
+    "backups",
+    "cache/browser",
+)
+
+
+# -- extraction ------------------------------------------------------------------------------------
+
+_FENCED = re.compile(r"^[^\n]*```[^\n]*\n.*?^\s*```[^\n]*$", re.DOTALL | re.MULTILINE)
+_OPEN_FENCE = re.compile(r"^[ \t]*```", re.MULTILINE)
+_INLINE_CODE = re.compile(r"(`+)[^\n]*?\1")
+# Upper case only: "Social media: /r/python" in prose is not a directive.
+_TAG = re.compile(
+    r"[*_\"']{0,3}MEDIA:[ \t]*"
+    r"(?P<path>\"[^\"\n]+\"|'[^'\n]+'|(?:~/|/)(?:(?!MEDIA:)\S)+)"
+    r"[*_\"']{0,3}"
+)
+_IMAGE_MD = re.compile(r"!\[[^\]\n]*\]\(\s*<?(?P<target>[^)\s>]+)>?\s*\)")
+_VOICE_FLAG = "[[audio_as_voice]]"
+_DOCUMENT_FLAG = "[[as_document]]"
+_TRAILING = ".,;:!?)]}*_\"'"
+_UNSAFE_NAME = re.compile(r"[\x00-\x1f\x7f\u0085  ]")
+
+
+@dataclass(frozen=True)
+class MediaRef:
+    """One attachment the reply asked for: a path as written, or an http(s) URL."""
+
+    raw: str
+    is_url: bool = False
+    as_voice: bool = False
+    as_document: bool = False
+
+    @property
+    def kind(self) -> MediaKind:
+        suffix = posixpath.splitext(self.raw.split("?", 1)[0])[1].lower()
+        if self.as_document:
+            return "document"
+        if suffix in _IMAGE:
+            return "image"
+        if suffix in _VIDEO:
+            return "video"
+        if suffix in _AUDIO:
+            return "voice" if self.as_voice else "audio"
+        return "document"
+
+    @property
+    def name(self) -> str:
+        base = posixpath.basename(self.raw.rstrip("/")) or self.raw
+        return _UNSAFE_NAME.sub("?", base)[:80]
+
+
+@dataclass(frozen=True)
+class MediaItem:
+    """An attachment cleared for sending: the host path (or URL) and how to send it."""
+
+    target: str
+    kind: MediaKind
+    name: str
+
+
+def _blank(chars: list[str], start: int, end: int) -> None:
+    for i in range(start, end):
+        if chars[i] != "\n":
+            chars[i] = " "
+
+
+def _mask(text: str) -> str:
+    """``text`` with fenced and inline code blanked (offsets and newlines kept); a fence left
+    open runs to the end."""
+    chars = list(text)
+    for match in _FENCED.finditer(text):
+        _blank(chars, *match.span())
+    unclosed = _OPEN_FENCE.search("".join(chars))
+    if unclosed is not None:
+        _blank(chars, unclosed.start(), len(chars))
+    for match in _INLINE_CODE.finditer("".join(chars)):
+        _blank(chars, *match.span())
+    return "".join(chars)
+
+
+def _clean_path(raw: str) -> str:
+    path = raw.strip()
+    if len(path) >= 2 and path[0] == path[-1] and path[0] in "\"'":
+        return path[1:-1].strip()
+    return path.rstrip(_TRAILING)
+
+
+def extract_media(text: str) -> tuple[str, list[MediaRef]]:
+    """The reply with its media directives removed, and the attachments they named."""
+    if not text or ("MEDIA:" not in text and "![" not in text and "[[" not in text):
+        return text, []
+    masked = _mask(text)
+    as_voice = _VOICE_FLAG in masked
+    as_document = _DOCUMENT_FLAG in masked
+    found: list[tuple[int, int, MediaRef]] = []
+    for match in _TAG.finditer(masked):
+        path = _clean_path(text[match.start("path") : match.end("path")])
+        if path:
+            ref = MediaRef(path, as_voice=as_voice, as_document=as_document)
+            found.append((match.start(), match.end(), ref))
+    for match in _IMAGE_MD.finditer(masked):
+        target = text[match.start("target") : match.end("target")]
+        is_url = target.lower().startswith(("https://", "http://"))
+        if is_url or target.startswith(("/", "~/")):
+            ref = MediaRef(target, is_url=is_url, as_document=as_document)
+            found.append((match.start(), match.end(), ref))
+    spans = [(s, e) for s, e, _ in found]
+    for flag in (_VOICE_FLAG, _DOCUMENT_FLAG):
+        start = masked.find(flag)
+        while start >= 0:
+            spans.append((start, start + len(flag)))
+            start = masked.find(flag, start + 1)
+    if not spans:
+        return text, []
+    out: list[str] = []
+    last = 0
+    for start, end in sorted(spans):
+        if start >= last:
+            out.append(text[last:start])
+            last = end
+        else:
+            last = max(last, end)
+    out.append(text[last:])
+    cleaned = re.sub(r"[ \t]+\n", "\n", "".join(out))
+    cleaned = re.sub(r"\n{3,}", "\n\n", cleaned).strip()
+    refs = [ref for _, _, ref in sorted(found, key=lambda item: item[0])]
+    return cleaned, refs
+
+
+def strip_media_tags(text: str) -> str:
+    """Display form of streamed text: directives removed, nothing resolved."""
+    return extract_media(text)[0]
+
+
+# -- the local policy ------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Verdict:
+    """``path`` when the file may be sent, else None with a short ``reason``."""
+
+    path: str | None
+    reason: str = ""
+    not_found: bool = False
+
+    @property
+    def ok(self) -> bool:
+        return self.path is not None
+
+
+def _refuse(reason: str, *, not_found: bool = False) -> Verdict:
+    return Verdict(None, reason, not_found)
+
+
+def _under(path: str, root: str) -> bool:
+    return path == root or path.startswith(root.rstrip("/") + "/")
+
+
+def _real(path: Path | str) -> str:
+    try:
+        return os.path.realpath(path)
+    except (OSError, ValueError):
+        return os.path.normpath(path)
+
+
+def _indus_secret(path: str, scope: Scope) -> bool | None:
+    """Inside an Indus root or profile: whether ``path`` is one of its secret or history stores
+    (any profile under the root, not just this one); None when ``path`` is not inside one."""
+    for base in indus_dirs(scope):
+        if not _under(path, base) or path == base:
+            continue
+        rel = path[len(base.rstrip("/")) + 1 :]
+        parts = rel.split("/")
+        if len(parts) > 2 and parts[0] == "profiles":
+            rel = "/".join(parts[2:])
+        return any(rel == name or rel.startswith(name + "/") for name in INDUS_DENIED)
+    return None
+
+
+def _denied(path: str, scope: Scope) -> bool:
+    inside = _indus_secret(path, scope)
+    if inside is not None:
+        # our own homes may live under a denied prefix (a root-run gateway, an XDG layout):
+        # inside them only their secret stores are denied
+        return inside
+    homes = homes_for(scope)
+    for prefix in SYSTEM_PREFIXES:
+        own_home = any(_under(home, prefix) and _under(path, home) for home in homes)
+        if _under(path, prefix) and not own_home:
+            return True
+    return any(_under(path, posixpath.join(home, rel)) for home in homes for rel in HOME_DENIED)
+
+
+@dataclass(frozen=True)
+class MediaPolicy:
+    scope: Scope
+    safe_roots: tuple[Path, ...]
+    extra_dirs: tuple[Path, ...] = ()
+    strict: bool = False
+    trust_recent: bool = False
+    recent_seconds: float = RECENT_SECONDS_DEFAULT
+
+    @classmethod
+    def for_scope(
+        cls, scope: Scope, settings: GatewaySection | Mapping[str, Any] | None = None
+    ) -> MediaPolicy:
+        """The policy for a profile from its ``gateway`` section (``media_strict``,
+        ``media_allow_dirs``, ``media_trust_recent``, ``media_trust_recent_seconds``); with no
+        ``settings`` the profile's config is read. Unset rows take the schema defaults."""
+        if settings is None:
+            section = gateway_section(scope)
+        elif isinstance(settings, GatewaySection):
+            section = settings
+        else:
+            try:
+                section = GatewaySection.model_validate(dict(settings))
+            except ValidationError:
+                section = GatewaySection()
+        extra: list[Path] = []
+        for raw in section.media_allow_dirs:
+            text = str(raw)
+            if text.startswith("~/"):
+                text = str(Path(scope.env.get("HOME") or Path.home()) / text[2:])
+            if os.path.isabs(text):
+                extra.append(Path(text))
+        return cls(
+            scope=scope,
+            safe_roots=tuple(scope.home / "cache" / name for name in CACHE_DIRS),
+            extra_dirs=tuple(extra),
+            strict=section.media_strict,
+            trust_recent=section.media_trust_recent,
+            recent_seconds=max(0.0, section.media_trust_recent_seconds),
+        )
+
+    @property
+    def document_cache(self) -> Path:
+        return self.scope.home / "cache" / "documents"
+
+    def _expand(self, raw: str) -> str | None:
+        if raw == "~" or raw.startswith("~/"):
+            home = self.scope.env.get("HOME") or str(Path.home())
+            return home + raw[1:]
+        if raw.startswith("~"):
+            return None  # another user's home
+        return raw
+
+    def _recent(self, info: os.stat_result) -> bool:
+        if self.strict or not self.trust_recent or self.recent_seconds <= 0:
+            return False
+        born = getattr(info, "st_birthtime", None)
+        made = born if isinstance(born, int | float) and born > 0 else info.st_mtime
+        age = self.scope.clock.now().timestamp() - made
+        return -_FUTURE_SKEW <= age <= self.recent_seconds
+
+    def check(self, raw: str) -> Verdict:
+        """Whether the local file ``raw`` (as the reply wrote it) may be sent."""
+        text = _clean_path(raw)
+        if not text or "\x00" in text or nt_namespace_error(text) is not None:
+            return _refuse("not a usable path")
+        expanded = self._expand(text)
+        if expanded is None or not os.path.isabs(expanded):
+            return _refuse("not an absolute path")
+        literal = os.path.normpath(expanded)
+        if blocked_device(literal):
+            return _refuse("not allowed")
+        try:
+            resolved = os.path.realpath(literal, strict=True)
+            info = os.stat(resolved)
+        except (OSError, ValueError):
+            return _refuse("file not found", not_found=True)
+        if not stat.S_ISREG(info.st_mode):
+            return _refuse("not a regular file")
+        scope = self.scope
+        if _denied(literal, scope) or _denied(resolved, scope):
+            return _refuse("not allowed")
+        if read_denial(resolved, scope) is not None or read_denial(literal, scope) is not None:
+            return _refuse("not allowed")
+        roots = (*self.safe_roots, *self.extra_dirs)
+        if any(_under(resolved, _real(root)) for root in roots):
+            return Verdict(resolved)
+        if self._recent(info):
+            return Verdict(resolved)
+        return _refuse("not in a folder media may be sent from")
+
+    async def resolve(
+        self, refs: Sequence[MediaRef], remote: RemoteFiles | None = None
+    ) -> tuple[list[MediaItem], list[str]]:
+        """Cleared attachments, and one short notice per refused one."""
+        items: list[MediaItem] = []
+        notices: list[str] = []
+        for ref in refs:
+            if ref.is_url:
+                items.append(MediaItem(ref.raw, ref.kind, ref.name))
+                continue
+            verdict = self.check(ref.raw)
+            if not verdict.ok and verdict.not_found and remote is not None:
+                verdict = await fetch_remote(self, remote, ref.raw)
+            if verdict.path is not None:
+                items.append(MediaItem(verdict.path, ref.kind, ref.name))
+            else:
+                notices.append(f"Could not attach {ref.name}: {verdict.reason}.")
+        return items, notices
+
+
+# -- remote sandboxes ------------------------------------------------------------------------------
+
+
+class RemoteFiles(Protocol):
+    """A non-local terminal backend's file access (P11 backends)."""
+
+    @property
+    def home(self) -> str | None: ...
+
+    async def realpath(self, path: str) -> str | None: ...
+
+    async def fetch(self, path: str, dest: Path, max_bytes: int) -> None: ...
+
+
+_REMOTE_HOME_DENIED = (*HOME_DENIED, *(f".indus/{name}" for name in INDUS_DENIED))
+
+
+def screen_remote_path(path: str, home: str | None) -> bool:
+    """True when the sandbox path ``path`` may be fetched (pure text check; the sandbox cannot be
+    stat'ed from here). With no known sandbox home, home-relative entries match anywhere."""
+    if not path.startswith("/") or "\x00" in path:
+        return False
+    target = posixpath.normpath(path)
+    if any(_under(target, prefix) for prefix in SYSTEM_PREFIXES):
+        return False
+    if home:
+        base = posixpath.normpath(home)
+        return not any(_under(target, posixpath.join(base, rel)) for rel in _REMOTE_HOME_DENIED)
+    parts = target.split("/")
+    for rel in _REMOTE_HOME_DENIED:
+        rel_parts = rel.split("/")
+        for i in range(len(parts) - len(rel_parts) + 1):
+            if parts[i : i + len(rel_parts)] == rel_parts:
+                return False
+    return True
+
+
+async def fetch_remote(policy: MediaPolicy, remote: RemoteFiles, raw: str) -> Verdict:
+    """Copy a sandbox file into the document cache after screening its path before and after the
+    sandbox resolves it, then check the copy like any local file."""
+    if policy.strict:
+        return _refuse("file not found", not_found=True)
+    path = _clean_path(raw)
+    home = remote.home
+    if path == "~" or path.startswith("~/"):
+        if not home:
+            return _refuse("not allowed")
+        path = posixpath.join(home, path[2:])
+    if not screen_remote_path(path, home):
+        return _refuse("not allowed")
+    try:
+        resolved = await remote.realpath(posixpath.normpath(path))
+    except Exception:
+        resolved = None
+    if not resolved or not screen_remote_path(resolved, home):
+        return _refuse("not allowed")
+    cache = secure_dir(policy.document_cache, env=policy.scope.env)
+    name = re.sub(r"[^\w.\-]", "_", posixpath.basename(resolved)) or "file"
+    dest = cache / f"remote_{secrets.token_hex(6)}_{name}"
+    try:
+        await remote.fetch(resolved, dest, FETCH_MAX_BYTES)
+    except Exception:
+        dest.unlink(missing_ok=True)
+        return _refuse("could not be fetched from the sandbox")
+    verdict = policy.check(str(dest))
+    if not verdict.ok:
+        dest.unlink(missing_ok=True)
+    return verdict
diff --git a/src/indus/gateway/outbound/ports.py b/src/indus/gateway/outbound/ports.py
new file mode 100644
index 0000000..98b6c53
--- /dev/null
+++ b/src/indus/gateway/outbound/ports.py
@@ -0,0 +1,188 @@
+"""The adapter surface outbound code uses, and the only place it calls an adapter.
+
+Adapters (``gateway.adapters.base``, P15-05), ``SendResult`` (``gateway.core.send``, P15-04) and
+the sent-message index (``gateway.core.sent_index``, P15-03) are the real types; outbound code
+reaches them only through this module. Every send and edit leaves through ``send_text`` /
+``edit_text``: they mask secrets (when the caller passes a redactor) and mark every non-final send
+as interim, at both egress doors (R06.12). The adapter base takes the ``interim`` / ``final``
+marks off before its hooks run, so they never reach the wire; an edit marked final is also passed
+as a final edit (never skipped by the chat's send slot).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from typing import Any
+
+from indus.gateway.adapters.base import FINAL_KEY, INTERIM_KEY, Adapter, MediaKind
+from indus.gateway.core.send import ErrorKind, SendResult
+from indus.gateway.outbound.chunker import LenFn
+from indus.gateway.outbound.formatting import Formatter, formatter_for
+
+__all__ = [
+    "FINAL_KEY",
+    "INTERIM_KEY",
+    "can_delete",
+    "can_edit",
+    "chat_unreachable",
+    "delete_message",
+    "edit_text",
+    "formatter",
+    "is_bad_format",
+    "is_flood",
+    "length_fn",
+    "max_length",
+    "platform_of",
+    "send_media_file",
+    "send_text",
+    "typing",
+]
+
+type Redact = Callable[[str], str]
+
+
+# -- adapter facts ---------------------------------------------------------------------------------
+
+
+def platform_of(adapter: Adapter) -> str:
+    return adapter.platform or "unknown"
+
+
+def length_fn(adapter: Adapter) -> LenFn:
+    return adapter.capabilities.len_fn
+
+
+def max_length(adapter: Adapter) -> int:
+    value = adapter.capabilities.max_len
+    return value if value > 0 else 4000
+
+
+def can_edit(adapter: Adapter) -> bool:
+    return adapter.capabilities.supports_edit
+
+
+def can_delete(adapter: Adapter) -> bool:
+    return adapter.capabilities.supports_delete
+
+
+def formatter(adapter: Adapter) -> Formatter:
+    """The adapter's markup bundle (``Capabilities.markup``; plain when it declares none)."""
+    return formatter_for(adapter.capabilities.markup)
+
+
+# -- result readings -------------------------------------------------------------------------------
+
+
+def is_flood(result: SendResult) -> bool:
+    return not result.ok and result.kind is ErrorKind.RATE_LIMITED
+
+
+def is_bad_format(result: SendResult) -> bool:
+    return not result.ok and result.kind is ErrorKind.BAD_FORMAT
+
+
+def chat_unreachable(result: SendResult) -> bool:
+    """True when the failure proves the whole chat gone (forbidden, chat-level not found).
+
+    Thread, topic and message not-found readings keep the chat alive; when both readings appear
+    the sub-chat one wins (P15-04's classifier, ``SendResult.chat_level``)."""
+    return result.chat_unreachable
+
+
+# -- egress doors ----------------------------------------------------------------------------------
+
+
+def _meta(meta: Mapping[str, Any] | None, final: bool) -> dict[str, Any]:
+    marked = dict(meta or {})
+    marked.pop(INTERIM_KEY, None)
+    marked.pop(FINAL_KEY, None)
+    marked[FINAL_KEY if final else INTERIM_KEY] = True
+    return marked
+
+
+async def send_text(
+    adapter: Adapter,
+    chat_id: str,
+    text: str,
+    *,
+    final: bool,
+    reply_to: str | None = None,
+    meta: Mapping[str, Any] | None = None,
+    redact: Redact | None = None,
+) -> SendResult:
+    body = redact(text) if redact is not None else text
+    return await adapter.send(chat_id, body, reply_to=reply_to, meta=_meta(meta, final))
+
+
+async def edit_text(
+    adapter: Adapter,
+    chat_id: str,
+    message_id: str,
+    text: str,
+    *,
+    final: bool,
+    meta: Mapping[str, Any] | None = None,
+    redact: Redact | None = None,
+) -> SendResult:
+    body = redact(text) if redact is not None else text
+    return await adapter.edit(chat_id, message_id, body, final=final, meta=_meta(meta, final))
+
+
+async def delete_message(adapter: Adapter, chat_id: str, message_id: str) -> bool:
+    """Delete when the adapter can; False otherwise or on failure (never raises)."""
+    if not can_delete(adapter):
+        return False
+    try:
+        return await adapter.delete(chat_id, message_id)
+    except Exception:
+        return False
+
+
+async def typing(adapter: Adapter, chat_id: str, *, on: bool) -> None:
+    """Start or stop the typing indicator; the adapter logs and swallows its failures."""
+    try:
+        if on:
+            await adapter.typing_start(chat_id)
+        else:
+            await adapter.typing_stop(chat_id)
+    except Exception:
+        return
+
+
+# Outbound media kinds → the adapter's native kind (audio goes out as a plain file).
+_MEDIA_KINDS: dict[str, MediaKind] = {
+    "image": "image",
+    "video": "video",
+    "voice": "voice",
+    "audio": "file",
+    "document": "document",
+}
+
+
+async def send_media_file(
+    adapter: Adapter,
+    chat_id: str,
+    kind: str,
+    target: str,
+    *,
+    reply_to: str | None = None,
+    meta: Mapping[str, Any] | None = None,
+) -> SendResult:
+    """Send one validated file (or URL) natively; a platform without that kind refuses it
+    (``SendResult.unsupported``) and an unknown kind goes out as a document."""
+    marked = _meta(meta, True)
+    match _MEDIA_KINDS.get(kind, "document"):
+        case "image":
+            send = adapter.send_image
+        case "video":
+            send = adapter.send_video
+        case "voice":
+            send = adapter.send_voice
+        case "file":
+            send = adapter.send_file
+        case _:
+            send = adapter.send_document
+    result = await send(chat_id, target, reply_to=reply_to, meta=marked)
+    if result.unsupported and send != adapter.send_document:
+        result = await adapter.send_document(chat_id, target, reply_to=reply_to, meta=marked)
+    return result
diff --git a/src/indus/gateway/outbound/progress.py b/src/indus/gateway/outbound/progress.py
new file mode 100644
index 0000000..89735cd
--- /dev/null
+++ b/src/indus/gateway/outbound/progress.py
@@ -0,0 +1,476 @@
+"""Tool progress, typing and the "still working" heartbeat in a chat (P15-16).
+
+- ``ToolProgress`` turns ``tool.started`` events into short lines. Modes: ``off``; ``new`` (only
+  when the tool changes); ``all``; ``verbose`` (plus the P05-redacted arguments, never the raw
+  ones); ``log`` (no chat lines: a redacted, rotating audit file, 5 MB × 3). Grouping
+  ``accumulate`` keeps one bubble per turn and edits it (a new bubble when it outgrows the
+  platform limit); ``separate`` sends one message per line, as does any platform without edits.
+  Repeats of the same line become ``(×N)``. Edits are spaced at least 1.5 s apart.
+- ``TypingLoop`` refreshes the typing indicator every 2 s while a turn runs and pauses while an
+  approval waits.
+- ``Heartbeat`` posts "Still working… N min" every 180 s on long turns, edited in place.
+
+Everything here is interim (never a turn's final) and leaves through ``ports``.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import math
+import os
+import threading
+from collections import deque
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation.clock import Clock
+from indus.foundation.home import secure_dir
+from indus.foundation.scope import Scope
+from indus.gateway.adapters.base import Adapter
+from indus.gateway.outbound import ports
+from indus.safety.redaction import redact_arguments, redact_output
+
+__all__ = [
+    "AUDIT_BACKUPS",
+    "AUDIT_MAX_BYTES",
+    "AuditLog",
+    "Grouping",
+    "Heartbeat",
+    "ProgressDefaults",
+    "ProgressMode",
+    "ToolProgress",
+    "TypingLoop",
+    "progress_defaults",
+    "progress_line",
+]
+
+type ProgressMode = Literal["off", "new", "all", "verbose", "log"]
+type Grouping = Literal["accumulate", "separate"]
+
+AUDIT_MAX_BYTES = 5 * 1024 * 1024
+AUDIT_BACKUPS = 3
+_VERBOSE_ARGS_CHARS = 400
+_EPSILON = 1e-6
+
+
+@dataclass(frozen=True)
+class ProgressDefaults:
+    mode: ProgressMode = "all"
+    heartbeat: bool = True
+
+
+_PLATFORM_DEFAULTS = {"telegram": ProgressDefaults(mode="off", heartbeat=True)}
+
+
+def progress_defaults(platform: str) -> ProgressDefaults:
+    """Per-platform defaults: phones (Telegram) get no tool lines, only the heartbeat."""
+    return _PLATFORM_DEFAULTS.get(platform, ProgressDefaults())
+
+
+_VERBS = {
+    "terminal": "Running a command",
+    "process": "Checking a background process",
+    "read_file": "Reading a file",
+    "write_file": "Writing a file",
+    "patch": "Editing a file",
+    "search_files": "Searching files",
+    "web_search": "Searching the web",
+    "web_extract": "Reading a web page",
+    "execute_code": "Running code",
+    "delegate_task": "Handing work to a helper",
+    "memory": "Updating memory",
+    "todo": "Updating the plan",
+    "vision_analyze": "Looking at an image",
+    "image_generate": "Making an image",
+    "text_to_speech": "Making audio",
+    "skill_view": "Opening a skill",
+}
+
+
+def progress_line(
+    name: str,
+    arguments: Mapping[str, Any] | None = None,
+    *,
+    verbose: bool = False,
+    scope: Scope | None = None,
+) -> str:
+    """The chat line for a tool call. Built from the tool name; in verbose mode the arguments
+    are added after P05 masking (raw arguments are never interpolated)."""
+    label = _VERBS.get(name, name.replace("_", " "))
+    line = f"⚙️ {label}"
+    if verbose and arguments:
+        masked = redact_arguments(dict(arguments), scope=scope)
+        shown = json.dumps(masked, ensure_ascii=False, default=str, sort_keys=True)
+        if len(shown) > _VERBOSE_ARGS_CHARS:
+            shown = shown[: _VERBOSE_ARGS_CHARS - 1] + "…"
+        line += f" ({name})\n```\n{shown}\n```"
+    return line
+
+
+# -- the audit log ---------------------------------------------------------------------------------
+
+
+class AuditLog:
+    """Append-only, redacted tool log with size rotation (``log`` mode)."""
+
+    def __init__(
+        self,
+        path: Path,
+        *,
+        scope: Scope | None = None,
+        max_bytes: int = AUDIT_MAX_BYTES,
+        backups: int = AUDIT_BACKUPS,
+    ) -> None:
+        self.path = path
+        self._scope = scope
+        self._max = max_bytes
+        self._backups = backups
+        self._lock = threading.Lock()
+
+    @classmethod
+    def for_scope(cls, scope: Scope) -> AuditLog:
+        return cls(scope.home / "logs" / "gateway-tools.log", scope=scope)
+
+    def _rotate(self) -> None:
+        for index in range(self._backups - 1, 0, -1):
+            older = self.path.with_name(f"{self.path.name}.{index}")
+            if older.exists():
+                older.replace(self.path.with_name(f"{self.path.name}.{index + 1}"))
+        self.path.replace(self.path.with_name(f"{self.path.name}.1"))
+
+    def write(self, line: str, *, when: datetime | None = None) -> None:
+        stamp = (when or datetime.now().astimezone()).strftime("%Y-%m-%d %H:%M:%S")
+        masked = redact_output(" ".join(line.split()), force=True, scope=self._scope)
+        data = f"{stamp}  {masked}\n".encode()
+        with self._lock:
+            env = self._scope.env if self._scope is not None else None
+            secure_dir(self.path.parent, env=env)
+            try:
+                size = self.path.stat().st_size
+            except OSError:
+                size = 0
+            if size and size + len(data) > self._max:
+                self._rotate()
+            fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
+            with os.fdopen(fd, "ab") as handle:
+                handle.write(data)
+
+
+# -- shared waiting --------------------------------------------------------------------------------
+
+
+async def _sleep_or_event(clock: Clock, delay: float | None, event: asyncio.Event) -> None:
+    """Wait until ``event`` is set or ``delay`` seconds pass (None: only the event)."""
+    if delay is None:
+        await event.wait()
+        return
+    waiter = asyncio.ensure_future(event.wait())
+    sleeper = asyncio.ensure_future(clock.sleep(max(0.0, delay)))
+    try:
+        await asyncio.wait({waiter, sleeper}, return_when=asyncio.FIRST_COMPLETED)
+    finally:
+        for task in (waiter, sleeper):
+            task.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await task
+
+
+# -- tool progress ---------------------------------------------------------------------------------
+
+
+class ToolProgress:
+    def __init__(
+        self,
+        port: Adapter,
+        chat_id: str,
+        *,
+        clock: Clock,
+        mode: ProgressMode = "all",
+        grouping: Grouping = "accumulate",
+        scope: Scope | None = None,
+        audit: AuditLog | None = None,
+        meta: Mapping[str, Any] | None = None,
+        min_edit_interval: float = 1.5,
+    ) -> None:
+        self._port = port
+        self._chat_id = chat_id
+        self._clock = clock
+        self.mode: ProgressMode = mode
+        self._separate = grouping == "separate" or not ports.can_edit(port)
+        self._scope = scope
+        self._audit = audit
+        self._meta = dict(meta or {})
+        self._min_edit = min_edit_interval
+        self._fmt = ports.formatter(port)
+        self._len = ports.length_fn(port)
+        self._limit = ports.max_length(port)
+        self._inbox: deque[tuple[str, Mapping[str, Any]] | None] = deque()
+        self._wake = asyncio.Event()
+        self._loop: asyncio.AbstractEventLoop | None = None
+        self._loop_thread: int | None = None
+        self._last_name: str | None = None
+        self._last_line: str | None = None
+        self._repeats = 0
+        self._lines: list[str] = []
+        self._unsent: list[str] = []
+        self._bubble: str | None = None
+        self._shown = ""
+        self._last_edit = -math.inf
+        self.message_ids: list[str] = []
+
+    # -- input (any thread) ----------------------------------------------------------------------
+
+    def _put(self, item: tuple[str, Mapping[str, Any]] | None) -> None:
+        self._inbox.append(item)
+        loop = self._loop
+        if loop is None or threading.get_ident() == self._loop_thread:
+            self._wake.set()
+        else:
+            loop.call_soon_threadsafe(self._wake.set)
+
+    def tool_started(self, name: str, arguments: Mapping[str, Any] | None = None) -> None:
+        if self.mode != "off" and name != "clarify":  # clarify renders its own prompt
+            self._put((name, dict(arguments or {})))
+
+    def feed(self, event: object) -> None:
+        if getattr(event, "type", None) == "tool.started":
+            arguments = getattr(event, "arguments", None)
+            self.tool_started(str(getattr(event, "name", "tool")), arguments)
+
+    def close(self) -> None:
+        """No more tools this turn: flush and let ``run`` return."""
+        self._put(None)
+
+    # -- the task --------------------------------------------------------------------------------
+
+    async def run(self) -> list[str]:
+        self._loop = asyncio.get_running_loop()
+        self._loop_thread = threading.get_ident()
+        closing = False
+        while True:
+            while self._inbox:
+                item = self._inbox.popleft()
+                if item is None:
+                    closing = True
+                else:
+                    self._absorb(*item)
+            await self._flush(force=closing)
+            if closing:
+                return self.message_ids
+            self._wake.clear()
+            if self._inbox:
+                continue
+            due = None
+            if self._pending():
+                due = self._last_edit + self._min_edit - self._clock.monotonic() - _EPSILON
+            await _sleep_or_event(self._clock, due, self._wake)
+
+    def _absorb(self, name: str, arguments: Mapping[str, Any]) -> None:
+        if self.mode == "log":
+            if self._audit is not None:
+                with contextlib.suppress(OSError):
+                    self._audit.write(
+                        progress_line(name, arguments, verbose=True, scope=self._scope)
+                    )
+            return
+        if self.mode == "new" and name == self._last_name:
+            return
+        self._last_name = name
+        line = progress_line(name, arguments, verbose=self.mode == "verbose", scope=self._scope)
+        if line == self._last_line:
+            self._repeats += 1
+            # a counter after a closing fence would break the fence: give it its own line
+            joiner = "\n" if line.endswith("```") else " "
+            counted = f"{line}{joiner}(×{self._repeats + 1})"
+            if self._separate:
+                self._unsent.append(counted)
+            elif self._lines:
+                self._lines[-1] = counted
+            return
+        self._last_line, self._repeats = line, 0
+        if self._separate:
+            self._unsent.append(line)
+        else:
+            self._lines.append(line)
+
+    def _pending(self) -> bool:
+        if self._separate:
+            return bool(self._unsent)
+        return "\n".join(self._lines) != self._shown
+
+    def _render(self, text: str) -> str:
+        return self._fmt.format(text)
+
+    async def _send(self, text: str) -> str | None:
+        result = await ports.send_text(
+            self._port, self._chat_id, self._render(text), final=False, meta=self._meta
+        )
+        if result.ok and result.message_id:
+            self.message_ids.append(result.message_id)
+            return result.message_id
+        return None
+
+    async def _flush(self, *, force: bool) -> None:
+        if self._separate:
+            while self._unsent:
+                await self._send(self._unsent.pop(0))
+            return
+        if not self._pending():
+            return
+        now = self._clock.monotonic()
+        if not force and now - self._last_edit < self._min_edit - _EPSILON:
+            return
+        self._last_edit = now
+        groups = self._groups()
+        if len(groups) > 1:  # the bubble is full: finish it, continue in new ones
+            rest = groups
+            if self._bubble is not None:
+                first = "\n".join(groups[0])
+                if first != self._shown:
+                    await self._edit(first)
+                rest = groups[1:]
+            for group in rest:
+                self._bubble = await self._send("\n".join(group))
+            self._lines = list(groups[-1])
+            self._shown = "\n".join(self._lines) if self._bubble is not None else ""
+            return
+        text = "\n".join(self._lines)
+        if self._bubble is None:
+            self._bubble = await self._send(text)
+            if self._bubble is not None:
+                self._shown = text
+            else:
+                self._separate = True
+            return
+        await self._edit(text)
+
+    def _groups(self) -> list[list[str]]:
+        groups: list[list[str]] = []
+        current: list[str] = []
+        for line in self._lines:
+            candidate = [*current, line]
+            if current and self._len(self._render("\n".join(candidate))) > self._limit:
+                groups.append(current)
+                candidate = [line]
+            current = candidate
+        return [*groups, current] if current else groups
+
+    async def _edit(self, text: str) -> None:
+        assert self._bubble is not None
+        result = await ports.edit_text(
+            self._port,
+            self._chat_id,
+            self._bubble,
+            self._render(text),
+            final=False,
+            meta=self._meta,
+        )
+        if result.ok:
+            self._shown = text
+        elif not ports.is_flood(result) and not result.retryable:
+            # this bubble cannot be edited: what it does not show yet goes out line by line
+            seen = len(self._shown.split("\n")) if self._shown else 0
+            self._separate = True
+            self._unsent = self._lines[seen:]
+
+
+# -- typing ----------------------------------------------------------------------------------------
+
+
+class TypingLoop:
+    """Keeps the typing indicator alive while a turn runs; paused while an approval waits."""
+
+    def __init__(self, port: Adapter, chat_id: str, *, clock: Clock, interval: float = 2.0) -> None:
+        self._port = port
+        self._chat_id = chat_id
+        self._clock = clock
+        self._interval = interval
+        self._changed = asyncio.Event()
+        self._paused = False
+        self._stopped = False
+
+    def pause(self) -> None:
+        self._paused = True
+        self._changed.set()
+
+    def resume(self) -> None:
+        self._paused = False
+        self._changed.set()
+
+    def stop(self) -> None:
+        self._stopped = True
+        self._changed.set()
+
+    async def run(self) -> None:
+        try:
+            while not self._stopped:
+                self._changed.clear()
+                if self._paused:
+                    await ports.typing(self._port, self._chat_id, on=False)
+                    await self._changed.wait()
+                    continue
+                await ports.typing(self._port, self._chat_id, on=True)
+                await _sleep_or_event(self._clock, self._interval, self._changed)
+        finally:
+            with contextlib.suppress(Exception):
+                await ports.typing(self._port, self._chat_id, on=False)
+
+
+# -- the long-turn heartbeat -----------------------------------------------------------------------
+
+
+def heartbeat_text(minutes: int) -> str:
+    return f"Still working… {minutes} min" if minutes else "Still working…"
+
+
+class Heartbeat:
+    """Posts a "still working" line every ``interval`` seconds, edited in place."""
+
+    def __init__(
+        self,
+        port: Adapter,
+        chat_id: str,
+        *,
+        clock: Clock,
+        interval: float = 180.0,
+        meta: Mapping[str, Any] | None = None,
+        text: Callable[[int], str] = heartbeat_text,
+    ) -> None:
+        self._port = port
+        self._chat_id = chat_id
+        self._clock = clock
+        self._interval = interval
+        self._meta = dict(meta or {})
+        self._text = text
+        self._stop = asyncio.Event()
+        self.message_id: str | None = None
+
+    def stop(self) -> None:
+        self._stop.set()
+
+    async def run(self) -> None:
+        if self._interval <= 0:
+            return
+        started = self._clock.monotonic()
+        while True:
+            await _sleep_or_event(self._clock, self._interval, self._stop)
+            if self._stop.is_set():
+                return
+            minutes = int((self._clock.monotonic() - started) // 60)
+            text = self._text(minutes)
+            if self.message_id is not None and ports.can_edit(self._port):
+                result = await ports.edit_text(
+                    self._port, self._chat_id, self.message_id, text, final=False, meta=self._meta
+                )
+                if result.ok:
+                    continue
+            result = await ports.send_text(
+                self._port, self._chat_id, text, final=False, meta=self._meta
+            )
+            if result.ok and result.message_id:
+                self.message_id = result.message_id
