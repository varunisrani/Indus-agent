+# STAND-IN: removed at integration
+"""Test-only stand-in for the outbound sender (P15-17, slice G3).
+
+The intake (P15-11) sends every reply through ``ReplySender.reply(source, text, *, reply_to,
+kind)``. Until G3's sender lands, this stub hands the text straight to the platform adapter
+(no formatting, chunking, redaction or ledger) and records what it sent.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+
+from indus.gateway.adapters.base import Adapter
+from indus.gateway.core.events import Source
+
+
+@dataclass(frozen=True)
+class Sent:
+    kind: str
+    platform: str
+    chat_id: str
+    text: str
+    reply_to: str | None
+
+
+@dataclass
+class StubSender:
+    adapters: Mapping[str, Adapter]
+    sent: list[Sent] = field(default_factory=list[Sent])
+
+    async def reply(
+        self,
+        source: Source,
+        text: str,
+        *,
+        reply_to: str | None = None,
+        kind: str = "final",
+    ) -> object:
+        platform = str(source.platform).lower()
+        self.sent.append(Sent(kind, platform, str(source.chat_id), text, reply_to))
+        adapter = self.adapters.get(platform)
+        if adapter is None:
+            return None
+        meta = {"thread_id": source.thread_id} if source.thread_id else None
+        return await adapter.send(str(source.chat_id), text, reply_to=reply_to, meta=meta)
+
+    def texts(self, kind: str | None = None) -> list[str]:
+        return [s.text for s in self.sent if kind is None or s.kind == kind]
