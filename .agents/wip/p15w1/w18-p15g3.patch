index 0000000..5b3fcf5
--- /dev/null
+++ b/src/indus/gateway/outbound/ports.py
@@ -0,0 +1,232 @@
+"""The adapter surface outbound code uses, and the only place it calls an adapter.
+
+Adapters, ``SendResult`` and the sent-message index belong to P15-01..05 (built in parallel); this
+module names just the parts outbound code needs as protocols, so integration changes one file.
+Every send and edit leaves through ``send_text`` / ``edit_text``: they mask secrets (when the
+caller passes a redactor) and mark every non-final send as interim, at both egress doors (R06.12).
+Adapters strip the ``interim`` / ``final`` keys before the wire.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping, Sequence
+from typing import Any, Protocol, cast, runtime_checkable
+
+from indus.gateway.outbound.chunker import LenFn, code_points
+from indus.gateway.outbound.formatting import Formatter, formatter_for
+
+__all__ = [
+    "FINAL_KEY",
+    "INTERIM_KEY",
+    "AdapterPort",
+    "SendResultLike",
+    "SentRecorder",
+    "chat_unreachable",
+    "delete_message",
+    "edit_text",
+    "formatter",
+    "is_bad_format",
+    "is_flood",
+    "length_fn",
+    "max_length",
+    "send_media_file",
+    "send_text",
+    "typing",
+]
+
+INTERIM_KEY = "interim"
+FINAL_KEY = "final"
+
+type Redact = Callable[[str], str]
+
+
+@runtime_checkable
+class SendResultLike(Protocol):
+    """The fields of P15-04's ``SendResult`` outbound code reads (read-only)."""
+
+    @property
+    def ok(self) -> bool: ...
+    @property
+    def message_id(self) -> str | None: ...
+    @property
+    def error(self) -> str | None: ...
+    @property
+    def retryable(self) -> bool: ...
+    @property
+    def retry_after(self) -> float | None: ...
+    @property
+    def continuation_ids(self) -> Sequence[str]: ...
+    @property
+    def kind(self) -> str | None: ...
+
+
+class AdapterPort(Protocol):
+    """The parts of P15-05's adapter contract outbound code calls."""
+
+    name: str
+    max_len: int
+    supports_edit: bool
+    supports_delete: bool
+
+    async def send(
+        self,
+        chat_id: str,
+        text: str,
+        reply_to: str | None = None,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResultLike: ...
+
+    async def edit(
+        self,
+        chat_id: str,
+        message_id: str,
+        text: str,
+        meta: Mapping[str, Any] | None = None,
+    ) -> SendResultLike: ...
+
+
+class SentRecorder(Protocol):
+    """P15-03's sent-message index, as far as the sender writes to it."""
+
+    def record(self, chat_id: str, message_id: str, text: str) -> None: ...
+
+
+# -- adapter facts ---------------------------------------------------------------------------------
+
+
+def length_fn(adapter: object) -> LenFn:
+    fn = getattr(adapter, "len_fn", None)
+    return cast(LenFn, fn) if callable(fn) else code_points
+
+
+def max_length(adapter: object) -> int:
+    value = getattr(adapter, "max_len", 4000)
+    return value if isinstance(value, int) and value > 0 else 4000
+
+
+def formatter(adapter: object) -> Formatter:
+    """The adapter's markup bundle (``markup`` capability; plain when it declares none)."""
+    return formatter_for(str(getattr(adapter, "markup", "plain")))
+
+
+# -- result readings -------------------------------------------------------------------------------
+
+
+def is_flood(result: SendResultLike) -> bool:
+    return result.kind == "rate_limited"
+
+
+def is_bad_format(result: SendResultLike) -> bool:
+    return result.kind == "bad_format"
+
+
+_SUB_CHAT = ("thread", "topic", "message to", "message not", "reply")
+
+
+def chat_unreachable(result: SendResultLike) -> bool:
+    """True when the failure proves the whole chat gone (forbidden, chat-level not found).
+
+    Thread, topic and message not-found readings keep the chat alive; when both readings appear
+    the sub-chat one wins (P15-04's classifier rule)."""
+    if result.ok:
+        return False
+    if result.kind == "forbidden":
+        return True
+    if result.kind != "not_found":
+        return False
+    explicit = getattr(result, "chat_level", None)
+    if isinstance(explicit, bool):
+        return explicit
+    error = (result.error or "").lower()
+    return "chat" in error and not any(word in error for word in _SUB_CHAT)
+
+
+# -- egress doors ----------------------------------------------------------------------------------
+
+
+def _meta(meta: Mapping[str, Any] | None, final: bool) -> dict[str, Any]:
+    marked = dict(meta or {})
+    marked.pop(INTERIM_KEY, None)
+    marked.pop(FINAL_KEY, None)
+    marked[FINAL_KEY if final else INTERIM_KEY] = True
+    return marked
+
+
+async def send_text(
+    adapter: AdapterPort,
+    chat_id: str,
+    text: str,
+    *,
+    final: bool,
+    reply_to: str | None = None,
+    meta: Mapping[str, Any] | None = None,
+    redact: Redact | None = None,
+) -> SendResultLike:
+    body = redact(text) if redact is not None else text
+    return await adapter.send(chat_id, body, reply_to=reply_to, meta=_meta(meta, final))
+
+
+async def edit_text(
+    adapter: AdapterPort,
+    chat_id: str,
+    message_id: str,
+    text: str,
+    *,
+    final: bool,
+    meta: Mapping[str, Any] | None = None,
+    redact: Redact | None = None,
+) -> SendResultLike:
+    body = redact(text) if redact is not None else text
+    return await adapter.edit(chat_id, message_id, body, meta=_meta(meta, final))
+
+
+async def delete_message(adapter: object, chat_id: str, message_id: str) -> bool:
+    """Delete when the adapter can; False otherwise or on failure."""
+    if not getattr(adapter, "supports_delete", False):
+        return False
+    delete = getattr(adapter, "delete", None)
+    if delete is None:
+        return False
+    try:
+        result = await delete(chat_id, message_id)
+    except Exception:
+        return False
+    return bool(getattr(result, "ok", result))
+
+
+async def typing(adapter: object, chat_id: str, *, on: bool) -> None:
+    """Start or stop the typing indicator; adapters without one are skipped, errors ignored."""
+    method = getattr(adapter, "typing_start" if on else "typing_stop", None)
+    if method is None:
+        return
+    try:
+        await method(chat_id)
+    except Exception:
+        return
+
+
+_MEDIA_METHODS = {
+    "image": "send_image",
+    "video": "send_video",
+    "voice": "send_voice",
+    "audio": "send_file",
+    "document": "send_document",
+}
+
+
+async def send_media_file(
+    adapter: object,
+    chat_id: str,
+    kind: str,
+    target: str,
+    *,
+    reply_to: str | None = None,
+    meta: Mapping[str, Any] | None = None,
+) -> SendResultLike | None:
+    """Send one validated file (or URL) natively; None when the adapter has no method for it."""
+    method = getattr(adapter, _MEDIA_METHODS.get(kind, "send_document"), None)
+    if method is None and kind != "document":
+        method = getattr(adapter, "send_document", None)
+    if method is None:
+        return None
+    return await method(chat_id, target, reply_to=reply_to, meta=_meta(meta, True))
diff --git a/src/indus/gateway/outbound/progress.py b/src/indus/gateway/outbound/progress.py
