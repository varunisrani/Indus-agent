index 0000000..675e6c2
--- /dev/null
+++ b/src/indus/gateway/core/session_keys.py
@@ -0,0 +1,120 @@
+"""The one session-key builder (P15-07, R06.7).
+
+A session key names one conversation slot. It is persisted in the routing index, so its bytes are
+a compatibility surface: ``tests/fixtures/gateway/session_keys.golden.json`` freezes them, and no
+other code may assemble a key.
+
+Layout: ``<ns>:<platform>:<chat_type>[:<scope_id>][:<chat_id>][<user and thread parts>]``.
+
+- ``<ns>`` is ``@default`` for the default profile and the profile id otherwise. ``@`` is outside
+  the profile-id alphabet, so no profile can ever produce the default namespace.
+- Only Slack puts a scope (its workspace id) before the chat id; a Discord guild id is never part
+  of a key.
+- DMs key on the chat id; without one on the sender, without both one slot per platform. In a DM
+  the user part comes before the thread part.
+- In groups each participant (alternate id first) gets their own slot by default
+  (``group_sessions_per_user``), except inside a thread: everyone in a thread shares it unless
+  ``thread_sessions_per_user`` is on. In a group the thread part comes before the user part.
+- A channel message that will open a thread (Discord auto-threads) is keyed on that future thread
+  (``prospective_thread_id``) with the chat-type slot ``thread``, so the follow-ups inside the
+  thread produce the same bytes; a real thread id always wins; DMs never use the prospective id.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from indus.foundation.profiles import DEFAULT_PROFILE
+from indus.gateway.core._shapes import SourceLike, text_of
+
+__all__ = [
+    "DEFAULT_NAMESPACE",
+    "build_session_key",
+    "canonical_participant",
+    "key_namespace",
+    "origin_of",
+]
+
+DEFAULT_NAMESPACE = "@default"
+_DM = "dm"
+_THREAD = "thread"
+# Platforms whose workspace id is part of the key (one bot installed in several workspaces can see
+# the same channel id in each).
+_SCOPED_PLATFORMS = frozenset({"slack"})
+_ORIGIN_FIELDS = (
+    "platform",
+    "chat_id",
+    "chat_name",
+    "chat_type",
+    "user_id",
+    "user_name",
+    "thread_id",
+    "user_id_alt",
+    "is_bot",
+    "scope_id",
+    "guild_id",
+    "parent_chat_id",
+    "prospective_thread_id",
+)
+
+
+def key_namespace(profile: str | None) -> str:
+    """``@default`` for the default profile (or none), else the profile id."""
+    name = (profile or "").strip()
+    if not name or name == DEFAULT_PROFILE:
+        return DEFAULT_NAMESPACE
+    return name
+
+
+def canonical_participant(source: SourceLike) -> str:
+    """The sender id used to separate participants: the alternate id when the platform has one.
+
+    Platform-specific identity folding (WhatsApp phone / JID aliases) plugs in here (P16).
+    """
+    return text_of(source.user_id_alt) or text_of(source.user_id)
+
+
+def build_session_key(
+    source: SourceLike,
+    *,
+    profile: str | None = None,
+    group_sessions_per_user: bool = True,
+    thread_sessions_per_user: bool = False,
+) -> str:
+    """The session key for ``source`` (see the module docstring for the rules)."""
+    platform = text_of(source.platform).lower()
+    chat_type = text_of(source.chat_type).lower() or _DM
+    is_dm = chat_type == _DM
+    chat_id = text_of(source.chat_id)
+    real_thread = text_of(source.thread_id)
+    thread = real_thread or ("" if is_dm else text_of(source.prospective_thread_id))
+    slot = _THREAD if thread and not real_thread else chat_type
+
+    if is_dm:
+        separate_user = not chat_id
+    else:
+        separate_user = group_sessions_per_user and not (thread and not thread_sessions_per_user)
+    participant = canonical_participant(source) if separate_user else ""
+
+    parts = [key_namespace(profile), platform, slot]
+    scope = text_of(source.scope_id)
+    if platform in _SCOPED_PLATFORMS and scope:
+        parts.append(scope)
+    if chat_id:
+        parts.append(chat_id)
+    user_part = [participant] if participant else []
+    thread_part = [thread] if thread else []
+    parts.extend(user_part + thread_part if is_dm else thread_part + user_part)
+    return ":".join(parts)
+
+
+def origin_of(source: SourceLike) -> dict[str, Any]:
+    """A JSON-safe copy of the source for the routing index (delivery and restore use it)."""
+    origin: dict[str, Any] = {}
+    for name in _ORIGIN_FIELDS:
+        value = getattr(source, name, None)
+        if name == "is_bot":
+            origin[name] = value is True
+        elif value is not None and value != "":
+            origin[name] = text_of(value)
+    return origin
diff --git a/src/indus/gateway/core/slash_access.py b/src/indus/gateway/core/slash_access.py
new file mode 100644
index 0000000..84f2d58
--- /dev/null
+++ b/src/indus/gateway/core/slash_access.py
@@ -0,0 +1,115 @@
+"""Slash-command admin tiers per platform and scope (P15-10, K17).
+
+Among the people allowed to talk to the agent, who may run which slash command. Each platform's
+``extra`` holds two lists per scope:
+
+- DM scope: ``allow_admin_from`` (admins: every command, plugin commands included) and
+  ``user_allowed_commands`` (what everyone else may run);
+- group scope: ``group_allow_admin_from`` and ``group_user_allowed_commands``.
+
+Non-admins can always run ``help`` and ``whoami``. A scope with no admin list has tiers off:
+everyone runs everything there, so nothing changes until an operator names an admin. Plain chat is
+never gated. ``/help`` lists only what the caller may run (``runnable``). A source with an empty or
+unknown chat type is judged by whichever scope is gated, so ambiguity never opens access.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass
+from typing import Any, Literal
+
+__all__ = [
+    "FLOOR",
+    "SlashPolicy",
+    "policy_for",
+    "policy_from_extra",
+    "runnable",
+    "scope_of",
+    "tier_label",
+]
+
+FLOOR: frozenset[str] = frozenset({"help", "whoami"})
+_DM_TYPES = frozenset({"dm", "direct", "private"})
+_KEYS: dict[str, tuple[str, str]] = {
+    "dm": ("allow_admin_from", "user_allowed_commands"),
+    "group": ("group_allow_admin_from", "group_user_allowed_commands"),
+}
+
+type Scope = Literal["dm", "group"]
+
+
+def _items(raw: object, normalise: Callable[[str], str]) -> frozenset[str]:
+    if raw is None:
+        return frozenset()
+    if isinstance(raw, str):
+        parts: Iterable[Any] = raw.split(",")
+    elif isinstance(raw, list | tuple | set | frozenset):
+        parts = raw  # pyright: ignore[reportUnknownVariableType]
+    else:
+        parts = (raw,)
+    return frozenset(v for v in (normalise(str(p).strip()) for p in parts) if v)
+
+
+def _command(name: str) -> str:
+    return name.lstrip("/").strip().lower()
+
+
+@dataclass(frozen=True)
+class SlashPolicy:
+    enabled: bool
+    admins: frozenset[str] = frozenset()
+    user_commands: frozenset[str] = frozenset()
+
+    def is_admin(self, user_id: str | None) -> bool:
+        """With tiers off everyone counts as an admin."""
+        if not self.enabled:
+            return True
+        return bool(user_id) and str(user_id) in self.admins
+
+    def can_run(self, user_id: str | None, command: str) -> bool:
+        if self.is_admin(user_id):
+            return True
+        name = _command(command)
+        return bool(name) and (name in FLOOR or name in self.user_commands)
+
+
+def policy_from_extra(extra: Mapping[str, Any] | None, scope: Scope) -> SlashPolicy:
+    data: Mapping[str, Any] = extra if isinstance(extra, Mapping) else {}
+    admin_key, commands_key = _KEYS[scope]
+    admins = _items(data.get(admin_key), str)
+    commands = _items(data.get(commands_key), _command)
+    return SlashPolicy(enabled=bool(admins), admins=admins, user_commands=commands)
+
+
+def scope_of(chat_type: object) -> Scope | None:
+    """``dm`` / ``group`` for a chat type; None when it is empty."""
+    raw = getattr(chat_type, "value", chat_type)
+    text = str(raw).strip().lower() if raw is not None else ""
+    if not text:
+        return None
+    return "dm" if text in _DM_TYPES else "group"
+
+
+def policy_for(extra: Mapping[str, Any] | None, chat_type: object) -> SlashPolicy:
+    """The policy for a chat; an empty chat type takes whichever scope is gated (group on a tie)."""
+    scope = scope_of(chat_type)
+    if scope is not None:
+        return policy_from_extra(extra, scope)
+    dm = policy_from_extra(extra, "dm")
+    group = policy_from_extra(extra, "group")
+    return dm if dm.enabled and not group.enabled else group
+
+
+def runnable(policy: SlashPolicy, user_id: str | None, names: Iterable[str]) -> list[str]:
+    """The commands of ``names`` the caller may run, in the given order (for ``/help``)."""
+    return [name for name in names if policy.can_run(user_id, name)]
+
+
+def tier_label(policy: SlashPolicy, user_id: str | None) -> str:
+    """What ``/whoami`` says about the caller's tier."""
+    if not policy.enabled:
+        return "full access (no admins are set here)"
+    if policy.is_admin(user_id):
+        return "admin (every command)"
+    return "user (limited commands)"
diff --git a/src/indus/gateway/registry.py b/src/indus/gateway/registry.py
new file mode 100644
index 0000000..bda7401
--- /dev/null
+++ b/src/indus/gateway/registry.py
@@ -0,0 +1,364 @@
+"""The platform registry: every platform the gateway can run, in one table (P15-06).
+
+Each ``PlatformEntry`` says how to build the platform's adapter, how to tell whether its library is
+installed without importing it, which env names carry its credential and its access lists, its
+message cap, whether its DMs are really private (R06.24) and an optional cron target parser.
+Telegram, Discord, Slack, the API server and the webhook receiver are built in; plugins add
+entries through the P13 provider registry (``load_plugin_entries``).
+
+A platform's SDK is imported in exactly one place, ``PlatformRegistry.create_adapter``, which the
+gateway calls only for enabled platforms: importing this module, listing entries or probing
+dependencies (``importlib.util.find_spec``) never imports an SDK.
+
+``proxy_for`` decides which proxy an adapter uses: a per-platform proxy setting always wins;
+otherwise the standard proxy env vars, unless ``gateway.trust_env`` is false.
+"""
+
+from __future__ import annotations
+
+import importlib
+import importlib.util
+import logging
+import threading
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass, field, replace
+from typing import Any, Literal
+
+__all__ = [
+    "BUILTIN_NAMES",
+    "PlatformEntry",
+    "PlatformRegistry",
+    "TargetParser",
+    "builtin_entries",
+    "modules_installed",
+    "policy_env_name",
+    "proxy_for",
+]
+
+log = logging.getLogger(__name__)
+
+type TargetParser = Callable[[str], tuple[str, str | None] | None]
+type AdapterFactory = Callable[[Any], Any]
+
+BUILTIN_NAMES: tuple[str, ...] = ("telegram", "discord", "slack", "api_server", "webhook")
+
+
+def policy_env_name(platform: str, suffix: str) -> str:
+    """``INDUS_<PLATFORM>_<SUFFIX>``: the env name of one of a platform's policy settings."""
+    return f"INDUS_{platform.upper()}_{suffix}"
+
+
+def modules_installed(*names: str) -> Callable[[], bool]:
+    """A passive dependency probe: true when every top-level module can be found.
+
+    ``find_spec`` on a top-level name locates the package without running it, so the probe is safe
+    from status screens and the enablement pass.
+    """
+
+    def probe() -> bool:
+        for name in names:
+            try:
+                if importlib.util.find_spec(name) is None:
+                    return False
+            except (ImportError, ValueError):
+                return False
+        return True
+
+    return probe
+
+
+def _lazy_factory(target: str) -> AdapterFactory:
+    """A factory that imports ``module:attr`` only when an adapter is actually built."""
+    module_name, _, attr = target.partition(":")
+
+    def build(config: Any) -> Any:
+        module = importlib.import_module(module_name)
+        return getattr(module, attr)(config)
+
+    build.__qualname__ = f"lazy({target})"
+    return build
+
+
+@dataclass(frozen=True)
+class PlatformEntry:
+    """One platform the gateway can run."""
+
+    name: str
+    label: str
+    factory: AdapterFactory
+    check_fn: Callable[[], bool]
+    required_env: tuple[str, ...] = ()
+    install_hint: str = ""
+    allowlist_env: str = ""
+    allow_all_env: str = ""
+    allow_bots_env: str | None = None
+    home_env: str = ""
+    max_len: int = 0
+    dm_is_private: bool = True
+    platform_hint: str = ""
+    cron_target_parser: TargetParser | None = None
+    # Group allowlists read from env (empty: config only). Authorization reads them (P15-08).
+    group_users_env: str = ""
+    group_chats_env: str = ""
+    # Inbound events are authenticated by the platform's own check (signature, key), so user
+    # allowlists and pairing do not apply. Never for a platform where people send messages.
+    trusted_inbound: bool = False
+    source: Literal["builtin", "plugin"] = "builtin"
+    plugin_name: str = ""
+    extra: Mapping[str, Any] = field(default_factory=dict[str, Any])
+
+
+def _chat_entry(
+    name: str,
+    label: str,
+    *,
+    sdk: tuple[str, ...],
+    extra_name: str,
+    required_env: tuple[str, ...],
+    max_len: int,
+    hint: str,
+) -> PlatformEntry:
+    return PlatformEntry(
+        name=name,
+        label=label,
+        factory=_lazy_factory(f"indus.gateway.adapters.{name}:create_adapter"),
+        check_fn=modules_installed(*sdk),
+        required_env=required_env,
+        install_hint=f"pip install 'indus-agent[{extra_name}]'",
+        allowlist_env=policy_env_name(name, "ALLOWED_USERS"),
+        allow_all_env=policy_env_name(name, "ALLOW_ALL_USERS"),
+        allow_bots_env=policy_env_name(name, "ALLOW_BOTS"),
+        home_env=policy_env_name(name, "HOME_CHANNEL"),
+        max_len=max_len,
+        dm_is_private=True,
+        platform_hint=hint,
+    )
+
+
+def builtin_entries() -> tuple[PlatformEntry, ...]:
+    """The platforms that ship with Indus Agent, in a fixed order."""
+    return (
+        _chat_entry(
+            "telegram",
+            "Telegram",
+            sdk=("telegram",),
+            extra_name="telegram",
+            required_env=("TELEGRAM_BOT_TOKEN",),
+            max_len=4096,
+            hint=(
+                "You are talking through Telegram. Keep replies short enough to read on a phone; "
+                "Markdown is converted for you."
+            ),
+        ),
+        _chat_entry(
+            "discord",
+            "Discord",
+            sdk=("discord",),
+            extra_name="discord",
+            required_env=("DISCORD_BOT_TOKEN",),
+            max_len=2000,
+            hint="You are talking through Discord. Standard Markdown renders natively.",
+        ),
+        _chat_entry(
+            "slack",
+            "Slack",
+            sdk=("slack_bolt", "slack_sdk"),
+            extra_name="slack",
+            required_env=("SLACK_BOT_TOKEN", "SLACK_APP_TOKEN"),
+            max_len=39000,
+            hint="You are talking through Slack. Formatting is converted to Slack's markup.",
+        ),
+        PlatformEntry(
+            name="api_server",
+            label="API server",
+            factory=_lazy_factory("indus.gateway.http.api_server:create_adapter"),
+            check_fn=modules_installed("fastapi", "uvicorn"),
+            install_hint="pip install 'indus-agent[gateway]'",
+            dm_is_private=False,
+            trusted_inbound=True,
+        ),
+        PlatformEntry(
+            name="webhook",
+            label="Webhook receiver",
+            factory=_lazy_factory("indus.gateway.http.webhook:create_adapter"),
+            check_fn=modules_installed("fastapi", "uvicorn"),
+            install_hint="pip install 'indus-agent[gateway]'",
+            dm_is_private=False,
+            trusted_inbound=True,
+        ),
+    )
+
+
+def _probe(entry: PlatformEntry) -> bool:
+    try:
+        return entry.check_fn() is True
+    except Exception as exc:  # a probe must never take the gateway down
+        log.warning("platform %s: dependency check failed: %s", entry.name, exc)
+        return False
+
+
+class PlatformRegistry:
+    """Name → ``PlatformEntry``. Thread-safe; built-ins first, plugin entries on top."""
+
+    def __init__(self, builtins: Iterable[PlatformEntry] | None = None) -> None:
+        self._lock = threading.RLock()
+        self._entries: dict[str, PlatformEntry] = {}
+        self._builtin_names: frozenset[str] = frozenset()
+        start = tuple(builtin_entries() if builtins is None else builtins)
+        for entry in start:
+            self._entries[entry.name] = entry
+        self._builtin_names = frozenset(e.name for e in start if e.source == "builtin")
+
+    # -- lookup ---------------------------------------------------------------------------------
+
+    def get(self, name: str) -> PlatformEntry | None:
+        with self._lock:
+            return self._entries.get(name.strip().lower())
+
+    def names(self) -> list[str]:
+        with self._lock:
+            return list(self._entries)
+
+    def entries(self) -> list[PlatformEntry]:
+        with self._lock:
+            return list(self._entries.values())
+
+    def is_builtin(self, name: str) -> bool:
+        return name.strip().lower() in self._builtin_names
+
+    def missing_deps(self, name: str) -> str | None:
+        """The install hint when the platform's library is missing, else None."""
+        entry = self.get(name)
+        if entry is None:
+            return f"unknown platform {name!r}"
+        if _probe(entry):
+            return None
+        return entry.install_hint or f"the {entry.label} library is not installed"
+
+    # -- changes --------------------------------------------------------------------------------
+
+    def register(self, entry: PlatformEntry, *, replace_existing: bool = False) -> bool:
+        """Add ``entry``; an existing name is replaced only with ``replace_existing``."""
+        name = entry.name.strip().lower()
+        if not name or not name.replace("_", "").isalnum():
+            raise ValueError(f"platform name {entry.name!r} must be letters, digits and _")
+        if entry.trusted_inbound and entry.source == "plugin" and name in self._builtin_names:
+            # People send messages on a shipped chat platform; a plugin replacing its adapter must
+            # not switch off allowlists and pairing for it.
+            log.warning(
+                "plugin %s: platform %s cannot be marked trusted_inbound; flag dropped",
+                entry.plugin_name or "?",
+                name,
+            )
+            entry = replace(entry, trusted_inbound=False)
+        if name != entry.name:
+            entry = replace(entry, name=name)
+        with self._lock:
+            if name in self._entries and not replace_existing:
+                log.warning("platform %s is already registered; refused", name)
+                return False
+            self._entries[name] = entry
+        return True
+
+    def unregister(self, name: str) -> bool:
+        with self._lock:
+            return self._entries.pop(name.strip().lower(), None) is not None
+
+    def load_plugin_entries(self, providers: Mapping[str, Mapping[str, Any]]) -> int:
+        """Register the platform entries plugins offered (the P13 provider slot ``platform``).
+
+        A plugin entry may replace a built-in adapter (user beats bundled, P13-14). Returns how
+        many entries were registered.
+        """
+        slot = providers.get("platform") or {}
+        added = 0
+        for label, offered in slot.items():
+            provider = getattr(offered, "provider", offered)
+            plugin_id = str(getattr(offered, "plugin_id", "") or "")
+            if not isinstance(provider, PlatformEntry):
+                log.warning(
+                    "plugin %s: platform %s is not a PlatformEntry; ignored", plugin_id, label
+                )
+                continue
+            entry = replace(
+                provider, source="plugin", plugin_name=plugin_id or provider.plugin_name
+            )
+            if self.register(entry, replace_existing=True):
+                added += 1
+        return added
+
+    # -- building -------------------------------------------------------------------------------
+
+    def create_adapter(self, name: str, config: Any) -> Any | None:
+        """Build the adapter for an enabled platform: the only place an SDK gets imported.
+
+        Returns None (and logs why) for an unknown platform, a missing library or a factory error.
+        """
+        entry = self.get(name)
+        if entry is None:
+            log.warning("no platform named %s is registered", name)
+            return None
+        if not _probe(entry):
+            log.warning(
+                "platform %s is enabled but its library is missing: %s",
+                entry.name,
+                entry.install_hint or "install its extra",
+            )
+            return None
+        try:
+            return entry.factory(config)
+        except Exception as exc:
+            log.error("platform %s: building the adapter failed: %s", entry.name, exc)
+            return None
+
+
+# -- proxy ----------------------------------------------------------------------------------------
+
+_PROXY_NAMES = {
+    "https": ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy"),
+    "http": ("HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy"),
+}
+
+
+def _bypassed(host: str, no_proxy: str) -> bool:
+    host = host.strip().lower().rstrip(".")
+    if not host:
+        return False
+    for raw in no_proxy.split(","):
+        item = raw.strip().lower()
+        if not item:
+            continue
+        if item == "*":
+            return True
+        item = item.split(":", 1)[0].lstrip(".").rstrip(".")
+        if item and (host == item or host.endswith("." + item)):
+            return True
+    return False
+
+
+def proxy_for(
+    *,
+    env: Mapping[str, str],
+    trust_env: bool = True,
+    platform_proxy: str | None = None,
+    target_host: str | None = None,
+    scheme: Literal["https", "http"] = "https",
+) -> str | None:
+    """The proxy URL an adapter should use, or None for a direct connection.
+
+    A per-platform proxy setting always wins. Otherwise the standard env vars apply unless
+    ``trust_env`` is false; ``NO_PROXY`` exempts ``target_host``.
+    """
+    explicit = (platform_proxy or "").strip()
+    if explicit:
+        return explicit
+    if not trust_env:
+        return None
+    no_proxy = env.get("NO_PROXY") or env.get("no_proxy") or ""
+    if target_host and _bypassed(target_host, no_proxy):
+        return None
+    for name in _PROXY_NAMES[scheme]:
+        value = (env.get(name) or "").strip()
+        if value:
+            return value
+    return None
diff --git a/src/indus/gateway/token_locks.py b/src/indus/gateway/token_locks.py
new file mode 100644
index 0000000..c61af33
--- /dev/null
+++ b/src/indus/gateway/token_locks.py
@@ -0,0 +1,362 @@
+"""Machine-local locks on platform credentials: two gateways never poll one bot token (P15-06).
+
+On connect, every adapter that owns a unique credential takes a lock file in a directory shared by
+every profile and install of the same OS user (R04.26). The file is named from the platform and
+the first 16 hex characters of the credential's SHA-256, so the credential itself is never written
+anywhere; it holds the owner's pid, process start time, profile and home.
+
+Outcomes (R06.16):
+- free, ours already, or held by a dead process → acquired (a dead holder is a pid that no longer
+  exists, or a pid whose start time differs from the record: the number was reused);
+- held by a live foreign process at startup → a fatal config conflict for that platform;
+- the same conflict while running → retryable (the other holder may be shutting down).
+A pid that is alive but whose start time cannot be read on either side counts as live (fail closed).
+
+Every read-decide-write runs under one cross-process guard lock in the directory, so two racers
+can never both reclaim one stale record; records land by atomic replace with mode 0600.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import errno
+import hashlib
+import json
+import logging
+import os
+import subprocess
+import sys
+import threading
+import time
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+from indus.foundation import fsio
+
+__all__ = [
+    "GUARD_FILE",
+    "LOCK_DIR_ENV",
+    "LockHolder",
+    "LockOutcome",
+    "TokenLocks",
+    "credential_hash",
+    "default_lock_dir",
+    "lock_file_name",
+    "pid_alive",
+    "process_start_time",
+]
+
+log = logging.getLogger(__name__)
+
+LOCK_DIR_ENV = "INDUS_GATEWAY_LOCK_DIR"
+GUARD_FILE = ".guard"
+GUARD_TIMEOUT = 10.0
+_DIR_NAME = "gateway-locks"
+_APP = "indus"
+
+
+# -- process identity -----------------------------------------------------------------------------
+
+
+def pid_alive(pid: int) -> bool:
+    """True when a process with ``pid`` exists (owned by anyone)."""
+    if pid < 1:
+        return False
+    try:
+        os.kill(pid, 0)  # signal 0 delivers nothing; it only asks whether the pid exists
+    except OSError as exc:
+        return exc.errno == errno.EPERM  # exists, but another user owns it
+    return True
+
+
+def _ps_start_time(pid: int) -> int | None:
+    try:
+        done = subprocess.run(
+            ["ps", "-o", "lstart=", "-p", str(pid)],
+            capture_output=True,
+            text=True,
+            timeout=2.0,
+            check=False,
+            env={"LC_ALL": "C", "PATH": "/bin:/usr/bin:/usr/sbin:/sbin"},
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    text = " ".join(done.stdout.split())
+    if not text:
+        return None
+    try:
+        return int(time.mktime(time.strptime(text, "%a %b %d %H:%M:%S %Y")))
+    except ValueError:
+        return None
+
+
+def process_start_time(pid: int) -> int | None:
+    """A per-process start fingerprint (None when unknown).
+
+    Linux: field 22 of ``/proc/<pid>/stat`` (clock ticks since boot). Elsewhere: ``ps``'s start
+    time in epoch seconds. Only compared with values read the same way on the same host.
+    """
+    if pid <= 0:
+        return None
+    if sys.platform.startswith("linux"):
+        try:
+            raw = Path(f"/proc/{pid}/stat").read_text(encoding="ascii", errors="replace")
+        except OSError:
+            return None
+        fields = raw.rsplit(")", 1)[-1].split()
+        try:
+            return int(fields[19])
+        except (IndexError, ValueError):
+            return None
+    if sys.platform == "win32":
+        return None
+    return _ps_start_time(pid)
+
+
+# -- names and places ------------------------------------------------------------------------------
+
+
+def credential_hash(credential: str) -> str:
+    return hashlib.sha256(credential.encode("utf-8")).hexdigest()[:16]
+
+
+def lock_file_name(platform: str, credential: str) -> str:
+    return f"{platform}-{credential_hash(credential)}.lock"
+
+
+def default_lock_dir(
+    env: Mapping[str, str],
+    *,
+    family: str | None = None,
+    user_home: Callable[[], Path] = Path.home,
+) -> Path:
+    """The per-OS-user directory every profile's gateway shares for credential locks.
+
+    ``INDUS_GATEWAY_LOCK_DIR`` (absolute) overrides. Linux and other POSIX:
+    ``$XDG_STATE_HOME/indus/gateway-locks`` (a relative ``XDG_STATE_HOME`` is invalid per the XDG
+    spec and ignored) else ``~/.local/state/indus/gateway-locks``; macOS:
+    ``~/Library/Application Support/indus/gateway-locks``; Windows:
+    ``%LOCALAPPDATA%\\indus\\gateway-locks``.
+    """
+    override = (env.get(LOCK_DIR_ENV) or "").strip()
+    if override and os.path.isabs(override):
+        return Path(override)
+    kind = family or ("darwin" if sys.platform == "darwin" else sys.platform)
+    if kind == "darwin":
+        return user_home() / "Library" / "Application Support" / _APP / _DIR_NAME
+    if kind == "win32":
+        local = (env.get("LOCALAPPDATA") or "").strip()
+        base = Path(local) if local else user_home() / "AppData" / "Local"
+        return base / _APP / _DIR_NAME
+    state = (env.get("XDG_STATE_HOME") or "").strip()
+    base = Path(state) if state and os.path.isabs(state) else user_home() / ".local" / "state"
+    return base / _APP / _DIR_NAME
+
+
+# -- records ---------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class LockHolder:
+    pid: int
+    start_time: int | None
+    platform: str
+    profile: str = ""
+    home: str = ""
+    acquired_at: str = ""
+
+    def to_json(self) -> dict[str, Any]:
+        return {
+            "pid": self.pid,
+            "start_time": self.start_time,
+            "platform": self.platform,
+            "profile": self.profile,
+            "home": self.home,
+            "acquired_at": self.acquired_at,
+        }
+
+    @classmethod
+    def from_json(cls, data: object) -> LockHolder | None:
+        if not isinstance(data, dict):
+            return None
+        raw: dict[str, Any] = {str(k): v for k, v in data.items()}  # pyright: ignore[reportUnknownVariableType]
+        pid = raw.get("pid")
+        start = raw.get("start_time")
+        if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
+            return None
+        if start is not None and (not isinstance(start, int) or isinstance(start, bool)):
+            start = None
+        return cls(
+            pid=pid,
+            start_time=start,
+            platform=str(raw.get("platform") or ""),
+            profile=str(raw.get("profile") or ""),
+            home=str(raw.get("home") or ""),
+            acquired_at=str(raw.get("acquired_at") or ""),
+        )
+
+    def describe(self) -> str:
+        who = f"profile {self.profile}" if self.profile else "another gateway"
+        return f"{who} (pid {self.pid})"
+
+
+@dataclass(frozen=True)
+class LockOutcome:
+    acquired: bool
+    fatal: bool = False
+    retryable: bool = False
+    holder: LockHolder | None = None
+    message: str = ""
+
+
+def _read_record(path: Path) -> tuple[bool, LockHolder | None]:
+    """``(exists, holder)``; an existing file that is not a valid record gives ``(True, None)``."""
+    try:
+        text = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return False, None
+    except OSError:
+        return True, None
+    try:
+        return True, LockHolder.from_json(json.loads(text))
+    except ValueError:
+        return True, None
+
+
+class TokenLocks:
+    """The credential locks one gateway process holds."""
+
+    def __init__(
+        self,
+        directory: Path,
+        *,
+        profile: str = "",
+        home: str = "",
+        pid: int | None = None,
+        start_time: Callable[[int], int | None] = process_start_time,
+        alive: Callable[[int], bool] = pid_alive,
+        now: Callable[[], datetime] | None = None,
+    ) -> None:
+        self.directory = Path(directory)
+        self.profile = profile
+        self.home = home
+        self.pid = os.getpid() if pid is None else pid
+        self._start_time = start_time
+        self._alive = alive
+        self._now = now if now is not None else (lambda: datetime.now(UTC))
+        self._held: dict[str, Path] = {}
+        self._lock = threading.Lock()
+
+    # -- helpers ------------------------------------------------------------------------------
+
+    def _path(self, platform: str, credential: str) -> Path:
+        return self.directory / lock_file_name(platform, credential)
+
+    def _ensure_dir(self) -> None:
+        self.directory.mkdir(parents=True, exist_ok=True)
+        with contextlib.suppress(OSError):
+            os.chmod(self.directory, 0o700)
+
+    def _guard(self) -> fsio.FileLock:
+        return fsio.FileLock(self.directory / GUARD_FILE, timeout=GUARD_TIMEOUT)
+
+    def _is_stale(self, holder: LockHolder | None) -> bool:
+        """A record no longer naming a live process (or not a record at all)."""
+        if holder is None:
+            return True
+        if not self._alive(holder.pid):
+            return True
+        current = self._start_time(holder.pid)
+        if holder.start_time is not None and current is not None:
+            return holder.start_time != current
+        return False
+
+    def _is_ours(self, holder: LockHolder | None) -> bool:
+        if holder is None or holder.pid != self.pid:
+            return False
+        mine = self._start_time(self.pid)
+        return holder.start_time is None or mine is None or holder.start_time == mine
+
+    def _record(self, platform: str) -> LockHolder:
+        return LockHolder(
+            pid=self.pid,
+            start_time=self._start_time(self.pid),
+            platform=platform,
+            profile=self.profile,
+            home=self.home,
+            acquired_at=self._now().astimezone(UTC).isoformat(timespec="seconds"),
+        )
+
+    # -- public ---------------------------------------------------------------------------------
+
+    def acquire(self, platform: str, credential: str, *, startup: bool) -> LockOutcome:
+        """Take the lock for ``platform``'s ``credential``.
+
+        A live foreign holder is fatal at ``startup`` and retryable later (R06.16).
+        """
+        if not credential:
+            raise ValueError("a token lock needs a non-empty credential")
+        path = self._path(platform, credential)
+        self._ensure_dir()
+        with self._guard():
+            exists, holder = _read_record(path)
+            if exists and not self._is_ours(holder) and not self._is_stale(holder):
+                assert holder is not None
+                return self._conflict(platform, holder, startup=startup)
+            if exists and not self._is_ours(holder):
+                log.info(
+                    "platform %s: reclaiming a stale credential lock (%s)",
+                    platform,
+                    holder.describe() if holder is not None else "unreadable record",
+                )
+            fsio.atomic_write_json(path, self._record(platform).to_json(), mode=0o600)
+        with self._lock:
+            self._held[f"{platform}\0{credential_hash(credential)}"] = path
+        return LockOutcome(acquired=True, holder=holder if exists else None)
+
+    def _conflict(self, platform: str, holder: LockHolder, *, startup: bool) -> LockOutcome:
+        if startup:
+            message = (
+                f"{platform}: this bot credential is already in use by {holder.describe()}; "
+                "one credential can serve only one gateway. Stop the other gateway or give this "
+                "profile its own bot."
+            )
+            return LockOutcome(acquired=False, fatal=True, holder=holder, message=message)
+        message = (
+            f"{platform}: the bot credential is held by {holder.describe()}; "
+            "retrying once it is released"
+        )
+        return LockOutcome(acquired=False, retryable=True, holder=holder, message=message)
+
+    def release(self, platform: str, credential: str) -> bool:
+        """Drop our lock (a record that is no longer ours is left alone)."""
+        key = f"{platform}\0{credential_hash(credential)}"
+        with self._lock:
+            path = self._held.pop(key, None)
+        if path is None:
+            path = self._path(platform, credential)
+        return self._release_path(path)
+
+    def _release_path(self, path: Path) -> bool:
+        if not self.directory.is_dir():
+            return False
+        with self._guard():
+            _exists, holder = _read_record(path)
+            if holder is None or holder.pid != self.pid:
+                return False
+            with contextlib.suppress(FileNotFoundError):
+                path.unlink()
+            return True
+
+    def release_all(self) -> int:
+        with self._lock:
+            paths = list(self._held.values())
+            self._held.clear()
+        return sum(1 for path in paths if self._release_path(path))
+
+    def held(self) -> list[Path]:
+        with self._lock:
+            return list(self._held.values())
diff --git a/src/indus/state/gateway_routes.py b/src/indus/state/gateway_routes.py
new file mode 100644
index 0000000..8226542
--- /dev/null
+++ b/src/indus/state/gateway_routes.py
@@ -0,0 +1,306 @@
+"""The gateway routing index: session key → current session and its routing state (P15-07).
+
+One row per session key (built only by ``indus.gateway.core.session_keys``). A row holds the
+session id the key points at now, the origin source (JSON) that replies and restores use, a
+display name, a session model override (model / provider / base URL only, never credentials),
+``resume_pending`` with its reason, the durable active-turn marker, and the previous session id
+after a rotation.
+
+Conversations never reset on idle or daily boundaries: nothing here looks at the time since the
+last message, and only ``rotate`` (``/new``) points a key at a new session.
+
+The active-turn marker is compare-and-clear: ``end_turn(token)`` clears only the marker that
+``begin_turn(token)`` set, so a displaced turn can never clear its successor's.
+"""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from typing import Any, Final, cast
+
+from indus.state.registry import StoreHandle
+from indus.state.writer import ROUTINE
+
+__all__ = [
+    "MODEL_OVERRIDE_KEYS",
+    "RouteEntry",
+    "begin_turn",
+    "clear_resume_pending",
+    "delete",
+    "end_turn",
+    "get",
+    "get_or_create",
+    "list_routes",
+    "mark_resume_pending",
+    "rotate",
+    "routes_for_session",
+    "sanitize_model_override",
+    "set_display_name",
+    "set_model_override",
+]
+
+MODEL_OVERRIDE_KEYS: Final = ("model", "provider", "base_url")
+_COLUMNS: Final = (
+    "session_key, session_id, platform, chat_type, origin_json, display_name, "
+    "model_override_json, resume_pending, resume_reason, active_turn_token, "
+    "active_turn_started_at, prev_session_id, created_at, updated_at"
+)
+
+
+@dataclass(frozen=True)
+class RouteEntry:
+    session_key: str
+    session_id: str
+    platform: str
+    chat_type: str
+    origin: dict[str, Any]
+    display_name: str | None
+    model_override: dict[str, str] | None
+    resume_pending: bool
+    resume_reason: str | None
+    active_turn_token: str | None
+    active_turn_started_at: float | None
+    prev_session_id: str | None
+    created_at: float
+    updated_at: float
+
+
+def _load_json_object(text: object) -> dict[str, Any]:
+    if not isinstance(text, str) or not text:
+        return {}
+    try:
+        value = json.loads(text)
+    except ValueError:
+        return {}
+    if not isinstance(value, dict):
+        return {}
+    return {str(k): v for k, v in cast(dict[object, Any], value).items()}
+
+
+def _row(row: tuple[Any, ...]) -> RouteEntry:
+    override = _load_json_object(row[6])
+    return RouteEntry(
+        session_key=str(row[0]),
+        session_id=str(row[1]),
+        platform=str(row[2]),
+        chat_type=str(row[3]),
+        origin=_load_json_object(row[4]),
+        display_name=None if row[5] is None else str(row[5]),
+        model_override={k: str(v) for k, v in override.items()} if override else None,
+        resume_pending=bool(row[7]),
+        resume_reason=None if row[8] is None else str(row[8]),
+        active_turn_token=None if row[9] is None else str(row[9]),
+        active_turn_started_at=None if row[10] is None else float(row[10]),
+        prev_session_id=None if row[11] is None else str(row[11]),
+        created_at=float(row[12]),
+        updated_at=float(row[13]),
+    )
+
+
+def _now(store: StoreHandle) -> float:
+    return store.scope.clock.now().timestamp()
+
+
+def _encode(value: Mapping[str, Any]) -> str:
+    return json.dumps(dict(value), ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _check_key(session_key: str) -> str:
+    if not session_key:
+        raise ValueError("a route needs a non-empty session key")
+    return session_key
+
+
+def sanitize_model_override(override: Mapping[str, object] | None) -> dict[str, str] | None:
+    """Keep only model / provider / base URL; credentials are re-resolved, never stored."""
+    if not override:
+        return None
+    kept = {
+        key: str(value).strip()
+        for key, value in override.items()
+        if key in MODEL_OVERRIDE_KEYS and value is not None and str(value).strip()
+    }
+    return kept or None
+
+
+def _get_in(conn: sqlite3.Connection, session_key: str) -> RouteEntry | None:
+    row = conn.execute(
+        f"SELECT {_COLUMNS} FROM gateway_routes WHERE session_key = ?", (session_key,)
+    ).fetchone()
+    return None if row is None else _row(tuple(row))
+
+
+# -- reads ----------------------------------------------------------------------------------------
+
+
+def get(store: StoreHandle, session_key: str) -> RouteEntry | None:
+    with store.read() as conn:
+        return _get_in(conn, session_key)
+
+
+def list_routes(store: StoreHandle, *, platform: str | None = None) -> list[RouteEntry]:
+    with store.read() as conn:
+        if platform is None:
+            rows = conn.execute(
+                f"SELECT {_COLUMNS} FROM gateway_routes ORDER BY session_key"
+            ).fetchall()
+        else:
+            rows = conn.execute(
+                f"SELECT {_COLUMNS} FROM gateway_routes WHERE platform = ? ORDER BY session_key",
+                (platform,),
+            ).fetchall()
+    return [_row(tuple(r)) for r in rows]
+
+
+def routes_for_session(store: StoreHandle, session_id: str) -> list[RouteEntry]:
+    """Every key currently pointing at ``session_id`` (several keys may share one transcript)."""
+    with store.read() as conn:
+        rows = conn.execute(
+            f"SELECT {_COLUMNS} FROM gateway_routes WHERE session_id = ? ORDER BY session_key",
+            (session_id,),
+        ).fetchall()
+    return [_row(tuple(r)) for r in rows]
+
+
+# -- writes ---------------------------------------------------------------------------------------
+
+
+def get_or_create(
+    store: StoreHandle,
+    session_key: str,
+    *,
+    new_session_id: Callable[[], str],
+    platform: str,
+    chat_type: str,
+    origin: Mapping[str, Any],
+    display_name: str | None = None,
+) -> tuple[RouteEntry, bool]:
+    """The route for ``session_key``, created with a fresh session id when missing.
+
+    Returns ``(entry, created)``. An existing route keeps its session id however long it was idle;
+    only its origin (the latest sender's details) and ``updated_at`` are refreshed.
+    """
+    _check_key(session_key)
+    now = _now(store)
+    origin_text = _encode(origin)
+
+    def apply(conn: sqlite3.Connection) -> tuple[RouteEntry, bool]:
+        current = _get_in(conn, session_key)
+        if current is not None:
+            conn.execute(
+                "UPDATE gateway_routes SET origin_json = ?, updated_at = ?, "
+                "display_name = COALESCE(?, display_name) WHERE session_key = ?",
+                (origin_text, now, display_name, session_key),
+            )
+            refreshed = _get_in(conn, session_key)
+            assert refreshed is not None
+            return refreshed, False
+        session_id = new_session_id()
+        if not session_id:
+            raise ValueError("new_session_id returned an empty id")
+        conn.execute(
+            "INSERT INTO gateway_routes(session_key, session_id, platform, chat_type, "
+            "origin_json, display_name, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+            (session_key, session_id, platform, chat_type, origin_text, display_name, now, now),
+        )
+        created = _get_in(conn, session_key)
+        assert created is not None
+        return created, True
+
+    return store.write(apply, budget=ROUTINE)
+
+
+def rotate(store: StoreHandle, session_key: str, new_session_id: str) -> RouteEntry | None:
+    """Point the key at a new session (``/new``), remembering the previous one.
+
+    Resume and active-turn state belong to the old session and are cleared. None when the key has
+    no route.
+    """
+    _check_key(session_key)
+    if not new_session_id:
+        raise ValueError("rotate needs a non-empty session id")
+    now = _now(store)
+
+    def apply(conn: sqlite3.Connection) -> RouteEntry | None:
+        current = _get_in(conn, session_key)
+        if current is None:
+            return None
+        conn.execute(
+            "UPDATE gateway_routes SET prev_session_id = session_id, session_id = ?, "
+            "resume_pending = 0, resume_reason = NULL, active_turn_token = NULL, "
+            "active_turn_started_at = NULL, updated_at = ? WHERE session_key = ?",
+            (new_session_id, now, session_key),
+        )
+        return _get_in(conn, session_key)
+
+    return store.write(apply, budget=ROUTINE)
+
+
+def _update(store: StoreHandle, session_key: str, sql: str, params: tuple[Any, ...]) -> bool:
+    now = _now(store)
+
+    def apply(conn: sqlite3.Connection) -> bool:
+        cur = conn.execute(
+            f"UPDATE gateway_routes SET {sql}, updated_at = ? WHERE session_key = ?",
+            (*params, now, session_key),
+        )
+        return cur.rowcount > 0
+
+    return store.write(apply, budget=ROUTINE)
+
+
+def set_display_name(store: StoreHandle, session_key: str, name: str | None) -> bool:
+    return _update(store, session_key, "display_name = ?", (name,))
+
+
+def set_model_override(
+    store: StoreHandle, session_key: str, override: Mapping[str, object] | None
+) -> bool:
+    """Persist a session ``/model`` choice across restarts (None clears it)."""
+    kept = sanitize_model_override(override)
+    text = None if kept is None else _encode(kept)
+    return _update(store, session_key, "model_override_json = ?", (text,))
+
+
+def mark_resume_pending(store: StoreHandle, session_key: str, reason: str) -> bool:
+    return _update(store, session_key, "resume_pending = 1, resume_reason = ?", (reason,))
+
+
+def clear_resume_pending(store: StoreHandle, session_key: str) -> bool:
+    return _update(store, session_key, "resume_pending = 0, resume_reason = NULL", ())
+
+
+def begin_turn(store: StoreHandle, session_key: str, token: str) -> bool:
+    """Set the durable active-turn marker (left behind by a kill; boot recovery reads it)."""
+    if not token:
+        raise ValueError("an active-turn marker needs a token")
+    now = _now(store)
+    return _update(
+        store, session_key, "active_turn_token = ?, active_turn_started_at = ?", (token, now)
+    )
+
+
+def end_turn(store: StoreHandle, session_key: str, token: str) -> bool:
+    """Clear the marker only when it is still ``token``'s."""
+    now = _now(store)
+
+    def apply(conn: sqlite3.Connection) -> bool:
+        cur = conn.execute(
+            "UPDATE gateway_routes SET active_turn_token = NULL, active_turn_started_at = NULL, "
+            "updated_at = ? WHERE session_key = ? AND active_turn_token = ?",
+            (now, session_key, token),
+        )
+        return cur.rowcount > 0
+
+    return store.write(apply, budget=ROUTINE)
+
+
+def delete(store: StoreHandle, session_key: str) -> bool:
+    def apply(conn: sqlite3.Connection) -> bool:
+        cur = conn.execute("DELETE FROM gateway_routes WHERE session_key = ?", (session_key,))
+        return cur.rowcount > 0
+
+    return store.write(apply, budget=ROUTINE)
