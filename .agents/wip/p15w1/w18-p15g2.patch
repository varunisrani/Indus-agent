+# STAND-IN: removed at integration
+"""Test-only stand-ins for the slice-G1 models this slice reads (P15-03 ``Source`` and the P15-05
+adapter capability flags), with the field lists of the phase file. At integration, import
+``Source`` from ``indus.gateway.core.events`` and the adapter base from
+``indus.gateway.adapters.base`` instead; nothing else in these tests names them.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import StrEnum
+from typing import Any
+
+
+class ChatType(StrEnum):
+    DM = "dm"
+    GROUP = "group"
+    CHANNEL = "channel"
+    THREAD = "thread"
+    FORUM = "forum"
+
+
+@dataclass(frozen=True)
+class Source:
+    platform: str
+    chat_id: str | None
+    chat_type: str = "dm"
+    chat_name: str | None = None
+    user_id: str | None = None
+    user_name: str | None = None
+    thread_id: str | None = None
+    user_id_alt: str | None = None
+    is_bot: bool = False
+    scope_id: str | None = None
+    guild_id: str | None = None
+    parent_chat_id: str | None = None
+    prospective_thread_id: str | None = None
+    # Set by an adapter that verified a role grant (Discord role allowlist).
+    role_authorized: bool = False
+
+
+@dataclass
+class Adapter:
+    """Only the capability flags and optional policy hooks authorization reads."""
+
+    auth_upstream: bool = False
+    owns_access_policy: bool = False
+    dm_is_private: bool = True
+    policies: dict[str, str] = field(default_factory=dict[str, str])
+    dm_allow: set[str] | None = None
+    resolved_ids: set[str] = field(default_factory=set[str])
+    extra: dict[str, Any] = field(default_factory=dict[str, Any])
+
+    def access_policy(self, kind: str) -> str:
+        return self.policies.get(kind, "")
+
+    def allows_dm(self, user_id: str) -> bool:
+        return self.dm_allow is not None and user_id in self.dm_allow
+
+    def resolved_allowlist_ids(self) -> set[str]:
+        return set(self.resolved_ids)
