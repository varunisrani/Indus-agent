@@ -0,0 +1,243 @@
+"""The bot-loop guard and the concurrent-session cap (P15-10).
+
+Bot-loop guard (R06.10): when a platform admits bot senders, two agents in one chat can answer each
+other forever. The guard keeps one sliding window per conversation ``(profile, platform, chat_id)``
+— never per sender pair, so N bots share one budget. Defaults: on, 20 bot-authored messages per
+300 s; the message that would be the 21st trips a 600 s cooldown and clears the window.
+
+``admit()`` counts one bot-authored message and answers ``ok`` / ``tripped`` / ``cooldown`` /
+``disabled``; admission calls it once per inbound message (a repeated message id is not counted
+again). ``blocked()`` only reads, so every authorization pass may ask it. Idle windows are swept at
+most once per window length. Settings are read on every call (an edit applies without a restart);
+a missing or unusable value falls back to its default.
+
+Concurrency cap: ``gateway.max_concurrent_sessions`` (a positive integer, unset = no cap) refuses a
+new session with a short message; a session already running is never counted twice.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import threading
+import time
+from collections import OrderedDict, deque
+from collections.abc import Callable, Hashable, Mapping
+from dataclasses import dataclass
+from typing import Any, Literal
+
+from indus.gateway.core._shapes import SourceLike, text_of
+
+__all__ = [
+    "CONCURRENCY_REFUSAL",
+    "AdmitState",
+    "BotLoopGuard",
+    "BotLoopSettings",
+    "ConcurrencyCap",
+    "cap_from_value",
+    "conversation_of",
+    "settings_reader",
+]
+
+log = logging.getLogger(__name__)
+
+type AdmitState = Literal["ok", "tripped", "cooldown", "disabled"]
+type Conversation = tuple[str, str, str]
+
+CONCURRENCY_REFUSAL = (
+    "I'm already handling as many conversations as I'm allowed to at once. "
+    "Please try again in a little while."
+)
+_RECENT_IDS = 64
+_TRUE = frozenset({"1", "true", "yes", "on"})
+_FALSE = frozenset({"0", "false", "no", "off"})
+
+
+def _bool(raw: object, default: bool) -> bool:
+    if isinstance(raw, bool):
+        return raw
+    text = str(raw).strip().lower() if raw is not None else ""
+    if text in _TRUE:
+        return True
+    if text in _FALSE:
+        return False
+    return default
+
+
+def _positive(raw: object, default: float) -> float:
+    if isinstance(raw, bool) or raw is None:
+        return default
+    try:
+        value = float(raw)  # pyright: ignore[reportArgumentType]
+    except (TypeError, ValueError):
+        return default
+    return value if math.isfinite(value) and value > 0 else default
+
+
+def _positive_int(raw: object, default: int) -> int:
+    value = _positive(raw, 0.0)
+    return int(value) if value >= 1 and value == int(value) else default
+
+
+@dataclass(frozen=True)
+class BotLoopSettings:
+    enabled: bool = True
+    max_messages: int = 20
+    window_seconds: float = 300.0
+    cooldown_seconds: float = 600.0
+
+    @classmethod
+    def from_mapping(cls, raw: object) -> BotLoopSettings:
+        """Settings from the ``gateway.bot_loop_guard`` block; unusable values keep defaults."""
+        if not isinstance(raw, Mapping):
+            return cls()
+        block: Mapping[str, Any] = raw  # pyright: ignore[reportUnknownVariableType]
+        base = cls()
+        return cls(
+            enabled=_bool(block.get("enabled"), base.enabled),
+            max_messages=_positive_int(block.get("max_messages"), base.max_messages),
+            window_seconds=_positive(block.get("window_seconds"), base.window_seconds),
+            cooldown_seconds=_positive(block.get("cooldown_seconds"), base.cooldown_seconds),
+        )
+
+
+def settings_reader(config_get: Callable[[str], object]) -> Callable[[], BotLoopSettings]:
+    """A settings callable that reads ``gateway.bot_loop_guard`` afresh on every call.
+
+    ``config_get`` is a dotted-key lookup such as ``ConfigView.get``; any failure gives defaults.
+    """
+
+    def read() -> BotLoopSettings:
+        try:
+            return BotLoopSettings.from_mapping(config_get("gateway.bot_loop_guard"))
+        except Exception:
+            return BotLoopSettings()
+
+    return read
+
+
+def conversation_of(source: SourceLike, profile: str = "") -> Conversation:
+    """The guard's budget key: one per chat, whoever the bots are."""
+    return (profile, text_of(source.platform).lower(), text_of(source.chat_id))
+
+
+class BotLoopGuard:
+    """Per-conversation sliding window of bot-authored messages, with a cooldown. Thread-safe."""
+
+    def __init__(
+        self,
+        settings: Callable[[], BotLoopSettings] = BotLoopSettings,
+        monotonic: Callable[[], float] | None = None,
+    ) -> None:
+        self._settings = settings
+        self._monotonic = monotonic if monotonic is not None else time.monotonic
+        self._lock = threading.Lock()
+        self._events: dict[Hashable, deque[float]] = {}
+        self._cooldown_until: dict[Hashable, float] = {}
+        self._recent: dict[Hashable, OrderedDict[str, None]] = {}
+        self._last_sweep: float | None = None
+
+    def _read_settings(self) -> BotLoopSettings:
+        try:
+            return self._settings()
+        except Exception:
+            return BotLoopSettings()
+
+    @property
+    def tracked(self) -> int:
+        with self._lock:
+            return len(self._events)
+
+    def blocked(self, conversation: Hashable) -> bool:
+        """True while ``conversation`` cools down. Read-only: never counts a message."""
+        if not self._read_settings().enabled:
+            return False
+        with self._lock:
+            return self._cooldown_until.get(conversation, float("-inf")) > self._monotonic()
+
+    def admit(self, conversation: Hashable, message_id: str | None = None) -> AdmitState:
+        """Count one bot-authored message for ``conversation``.
+
+        ``tripped`` means this message started the cooldown; ``ok`` and ``disabled`` let it in.
+        """
+        settings = self._read_settings()
+        if not settings.enabled:
+            return "disabled"
+        now = self._monotonic()
+        with self._lock:
+            self._sweep(now, settings)
+            if self._cooldown_until.get(conversation, float("-inf")) > now:
+                return "cooldown"
+            if message_id:
+                seen = self._recent.setdefault(conversation, OrderedDict())
+                if message_id in seen:
+                    return "ok"
+                seen[message_id] = None
+                while len(seen) > _RECENT_IDS:
+                    seen.popitem(last=False)
+            window = self._events.setdefault(conversation, deque())
+            cutoff = now - settings.window_seconds
+            while window and window[0] <= cutoff:
+                window.popleft()
+            if len(window) >= settings.max_messages:
+                self._cooldown_until[conversation] = now + settings.cooldown_seconds
+                window.clear()
+                log.warning(
+                    "bot-loop guard: too many bot messages in %s; ignoring bots there for %g s "
+                    "(gateway.bot_loop_guard)",
+                    conversation,
+                    settings.cooldown_seconds,
+                )
+                return "tripped"
+            window.append(now)
+            return "ok"
+
+    def _sweep(self, now: float, settings: BotLoopSettings) -> None:
+        """Forget idle conversations, at most once per window, so memory stays bounded."""
+        if self._last_sweep is not None and now - self._last_sweep < settings.window_seconds:
+            return
+        self._last_sweep = now
+        idle = now - settings.window_seconds
+        for key in [k for k, w in self._events.items() if not w or w[-1] <= idle]:
+            del self._events[key]
+            self._recent.pop(key, None)
+        for key in [k for k, until in self._cooldown_until.items() if until <= now]:
+            del self._cooldown_until[key]
+
+
+def cap_from_value(raw: object) -> int | None:
+    """``gateway.max_concurrent_sessions`` as a positive int, else None (no cap)."""
+    value = _positive_int(raw, 0)
+    return value or None
+
+
+class ConcurrencyCap:
+    """At most ``limit()`` sessions run at once; ``limit`` is read on every claim."""
+
+    def __init__(self, limit: Callable[[], int | None]) -> None:
+        self._limit = limit
+        self._active: set[str] = set()
+        self._lock = threading.Lock()
+
+    @property
+    def active(self) -> int:
+        with self._lock:
+            return len(self._active)
+
+    def try_claim(self, session_key: str) -> bool:
+        """Claim a slot for ``session_key`` (true when it already runs)."""
+        try:
+            limit = cap_from_value(self._limit())
+        except Exception:
+            limit = None
+        with self._lock:
+            if session_key in self._active:
+                return True
+            if limit is not None and len(self._active) >= limit:
+                return False
+            self._active.add(session_key)
+            return True
+
+    def release(self, session_key: str) -> None:
+        with self._lock:
+            self._active.discard(session_key)
diff --git a/src/indus/gateway/core/events.py b/src/indus/gateway/core/events.py
new file mode 100644
index 0000000..b669755
--- /dev/null
+++ b/src/indus/gateway/core/events.py
@@ -0,0 +1,227 @@
+"""The inbound event every adapter produces, and command detection on it (P15-03).
+
+Adapters turn a platform message into one `InboundEvent` whose `Source` says where it came from.
+Everything downstream (authorization, session keys, busy guards, slash dispatch) reads only these
+two models, never a platform payload.
+
+A message is a command when, after any leading attachment-reference lines (``@image:``,
+``@file:``, ``@url:``), it starts with ``/`` and the event allows control. The name is the first
+word without the slash, lower-cased, without an ``@botname`` suffix; a name containing ``/`` (a
+path such as ``/etc/hosts``) or an empty name means the message is plain text.
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import datetime
+from enum import StrEnum
+from typing import TYPE_CHECKING, Any, Literal, NamedTuple
+
+from pydantic import BaseModel, ConfigDict, Field
+
+if TYPE_CHECKING:
+    from indus.gateway.core.sent_index import SentIndex
+
+ChatType = Literal["dm", "group", "channel", "thread", "forum"]
+
+# A quoted reply is cut to this many UTF-8 bytes before it is put in front of the user's text.
+REPLY_QUOTE_MAX_BYTES = 4096
+
+
+class MessageKind(StrEnum):
+    # Plain text and commands first, then the attachment kinds alphabetically.
+    TEXT = "text"
+    COMMAND = "command"
+    AUDIO = "audio"
+    DOCUMENT = "document"
+    LOCATION = "location"
+    PHOTO = "photo"
+    STICKER = "sticker"
+    VIDEO = "video"
+    VOICE = "voice"
+
+
+class Source(BaseModel):
+    """Where an inbound message came from."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    platform: str
+    chat_id: str
+    chat_type: ChatType = "dm"
+    chat_name: str | None = None
+    user_id: str | None = None
+    user_name: str | None = None
+    thread_id: str | None = None
+    # A second id for the same sender where the platform has two (a phone number and a UUID).
+    user_id_alt: str | None = None
+    is_bot: bool = False
+    # Workspace or tenant the chat id is unique within (Slack team id).
+    scope_id: str | None = None
+    guild_id: str | None = None
+    parent_chat_id: str | None = None
+    # The thread a reply will open (Discord auto-threads), so the first message and the
+    # follow-ups inside the new thread share one session key (P15-07).
+    prospective_thread_id: str | None = None
+
+
+class Attachment(BaseModel):
+    """One media item of an event: a local path (downloaded) or a URL."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    ref: str
+    mime: str = ""
+    # True when the file's text is already part of the event text; None when unknown.
+    inlined: bool | None = None
+
+
+class ParsedCommand(NamedTuple):
+    name: str
+    args: str
+
+
+class InboundEvent(BaseModel):
+    """One normalised inbound message. Frozen: build changed copies with ``model_copy``."""
+
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+    source: Source
+    text: str = ""
+    kind: MessageKind = MessageKind.TEXT
+    message_id: str | None = None
+    # The platform's update counter (Telegram ``update_id``), for dedupe and restart offsets.
+    update_id: int | None = None
+    media: tuple[Attachment, ...] = ()
+    reply_to_id: str | None = None
+    reply_to_text: str | None = None
+    reply_to_author_id: str | None = None
+    reply_to_author_name: str | None = None
+    reply_to_is_own: bool = False
+    # Made by the gateway itself (a background completion), not by a person.
+    internal: bool = False
+    # False for untrusted proactive payloads: their text never runs a command.
+    allow_control: bool = True
+    # Was the message addressed to us? None = the adapter cannot tell.
+    reply_expected: bool | None = None
+    metadata: dict[str, Any] = Field(default_factory=dict[str, Any])
+    # The platform's own send time when it gives one.
+    timestamp: datetime | None = None
+
+    @property
+    def user_id(self) -> str | None:
+        return self.source.user_id
+
+    @property
+    def user_name(self) -> str | None:
+        return self.source.user_name
+
+    def parsed_command(self) -> ParsedCommand | None:
+        if not self.allow_control:
+            return None
+        return parse_command(self.text)
+
+    @property
+    def is_command(self) -> bool:
+        return self.parsed_command() is not None
+
+    @property
+    def command(self) -> str | None:
+        parsed = self.parsed_command()
+        return parsed.name if parsed is not None else None
+
+    @property
+    def command_args(self) -> str:
+        parsed = self.parsed_command()
+        return parsed.args if parsed is not None else ""
+
+
+# -- command detection ------------------------------------------------------------------------
+
+_REF_LINE = re.compile(r"@(?:image|file|url):\S.*", re.IGNORECASE)
+_EM_DASHES = re.compile("—+")
+_EN_DASH = "–"
+
+
+def strip_attachment_refs(text: str) -> str:
+    """``text`` without its leading attachment-reference lines (and surrounding whitespace)."""
+    rest = text.lstrip()
+    while rest:
+        line, newline, after = rest.partition("\n")
+        if not _REF_LINE.fullmatch(line.rstrip("\r")):
+            break
+        rest = after.lstrip() if newline else ""
+    return rest
+
+
+def normalise_dashes(text: str) -> str:
+    """Undo phone-keyboard dash replacement: em dash runs → ``--``, en dash → ``-``."""
+    return _EM_DASHES.sub("--", text).replace(_EN_DASH, "-")
+
+
+def parse_command(text: str) -> ParsedCommand | None:
+    """The command in ``text``, or None when it is plain text (``allow_control`` not checked)."""
+    body = strip_attachment_refs(text)
+    if not body.startswith("/"):
+        return None
+    parts = body[1:].split(None, 1)
+    if not parts or body[1:2].isspace():
+        return None
+    name = parts[0].lower().split("@", 1)[0]
+    if not name or "/" in name:
+        return None
+    args = parts[1].strip() if len(parts) > 1 else ""
+    return ParsedCommand(name, normalise_dashes(args))
+
+
+# -- reply context ----------------------------------------------------------------------------
+
+
+def _cut_utf8(text: str, limit: int) -> str:
+    data = text.encode("utf-8")
+    if len(data) <= limit:
+        return text
+    return data[:limit].decode("utf-8", errors="ignore")
+
+
+def with_reply_context(event: InboundEvent, index: SentIndex) -> InboundEvent:
+    """Fill the replied-to text from ``index`` when the platform gave none; mark own messages."""
+    if event.reply_to_id is None:
+        return event
+    platform, chat_id = event.source.platform, event.source.chat_id
+    own = event.reply_to_is_own or index.is_own(platform, chat_id, event.reply_to_id)
+    text = event.reply_to_text
+    if not text:
+        text = index.lookup(platform, chat_id, event.reply_to_id)
+    if own == event.reply_to_is_own and text == event.reply_to_text:
+        return event
+    return event.model_copy(update={"reply_to_is_own": own, "reply_to_text": text})
+
+
+def model_text(event: InboundEvent) -> str:
+    """The text the agent sees: the replied-to quote (when known) in front of the message."""
+    quote = (event.reply_to_text or "").strip()
+    if not quote:
+        return event.text
+    if event.reply_to_is_own:
+        who = "your earlier message"
+    else:
+        who = event.reply_to_author_name or "a message"
+    quote = _cut_utf8(quote, REPLY_QUOTE_MAX_BYTES)
+    return f'[Replying to {who}: "{quote}"]\n\n{event.text}'
+
+
+__all__ = [
+    "REPLY_QUOTE_MAX_BYTES",
+    "Attachment",
+    "ChatType",
+    "InboundEvent",
+    "MessageKind",
+    "ParsedCommand",
+    "Source",
+    "model_text",
+    "normalise_dashes",
+    "parse_command",
+    "strip_attachment_refs",
+    "with_reply_context",
+]
diff --git a/src/indus/gateway/core/pairing.py b/src/indus/gateway/core/pairing.py
new file mode 100644
index 0000000..ce1a254
--- /dev/null
+++ b/src/indus/gateway/core/pairing.py
@@ -0,0 +1,591 @@
+"""The pairing store: one-time codes that let a stranger in once the owner approves (P15-09).
+
+A stranger who DMs the bot on a platform in ``pair`` mode gets a code; the owner approves it with
+``indus pairing approve <platform> <code>`` and the stranger is let in from then on.
+
+- Codes: 8 characters from a 32-letter alphabet without 0/O/1/I, drawn with ``secrets``. Only a
+  salted SHA-256 (16-byte salt) is stored, under a random 16-hex request id; a code is never
+  logged and cannot be read back.
+- A code lives 3,600 s; at most 3 are pending per platform; a user may ask once per 600 s.
+- 5 failed code approvals lock the platform for 3,600 s; a success resets the streak. The lockout
+  is checked before any lookup, so a correct code is refused while it lasts.
+- Typed codes lose all whitespace and are upper-cased (chat clients add spacing); the compare is
+  constant-time.
+- An admin approving by request id never sees the code, is not gated by the lockout and does not
+  count toward it.
+- Approval adds the user to the platform's allowlist when one is configured, so the operator's
+  list stays the visible truth; revoke removes it there and tells live adapters
+  (``add_revoke_listener``) to forget the user. An empty allowlist is never created: that would
+  flip unknown DMs to ``ignore`` (R06.8).
+- Files are 0600 in a 0700 directory resolved from the scope on every call, never at import
+  (R06.9): a code the gateway issued is visible to the CLI that approves it.
+- A user refused a code (rate limit, full queue, lockout) is told "try later" once, then silence.
+- Decline stamps for the ``decline`` unknown-sender mode (P15-08) live here: one per sender per
+  24 h, written before the reply is sent.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import logging
+import os
+import re
+import secrets
+import threading
+from collections.abc import Callable, Iterator, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation import envfile, fsio
+from indus.foundation.envload import env_file_path
+from indus.foundation.scope import Scope, current_scope
+from indus.gateway.registry import policy_env_name
+
+__all__ = [
+    "ALPHABET",
+    "CODE_LENGTH",
+    "CODE_TTL_SECONDS",
+    "DECLINE_WINDOW_SECONDS",
+    "LOCKOUT_SECONDS",
+    "MAX_FAILED_APPROVALS",
+    "MAX_PENDING_PER_PLATFORM",
+    "REQUEST_INTERVAL_SECONDS",
+    "ApprovedUser",
+    "Approval",
+    "CodeRequest",
+    "EnvAllowlist",
+    "PairingStore",
+    "PendingRequest",
+    "add_revoke_listener",
+    "looks_like_request_id",
+    "normalise_code",
+    "pairing_dir",
+]
+
+log = logging.getLogger(__name__)
+
+ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
+CODE_LENGTH = 8
+CODE_TTL_SECONDS = 3600
+MAX_PENDING_PER_PLATFORM = 3
+REQUEST_INTERVAL_SECONDS = 600
+MAX_FAILED_APPROVALS = 5
+LOCKOUT_SECONDS = 3600
+DECLINE_WINDOW_SECONDS = 24 * 3600
+SALT_BYTES = 16
+LOCK_TIMEOUT = 10.0
+
+_PLATFORM_RE = re.compile(r"^[a-z0-9_]{1,32}$")
+_REQUEST_ID_RE = re.compile(r"^[0-9a-fA-F]{16}$")
+_LIMITS = "_limits.json"
+_DECLINED = "_declined.json"
+
+type RequestStatus = Literal["issued", "rate_limited", "pending_full", "locked_out"]
+type ApprovalStatus = Literal["approved", "invalid", "locked_out"]
+
+
+def pairing_dir(scope: Scope) -> Path:
+    """The pairing directory of ``scope``'s profile."""
+    return scope.home / "platforms" / "pairing"
+
+
+def normalise_code(value: str) -> str:
+    """What the user typed, as a code: every whitespace removed, upper-cased."""
+    return "".join(str(value or "").split()).upper()
+
+
+def looks_like_request_id(value: str) -> bool:
+    """16 hex characters: a request id from ``indus pairing list`` (codes are 8 letters)."""
+    return bool(_REQUEST_ID_RE.match(str(value or "").strip()))
+
+
+def _check_platform(platform: str) -> str:
+    name = str(platform or "").strip().lower()
+    if not _PLATFORM_RE.match(name):
+        raise ValueError(f"{platform!r} is not a platform name")
+    return name
+
+
+def _hash(code: str, salt: bytes) -> str:
+    return hashlib.sha256(salt + code.encode("utf-8")).hexdigest()
+
+
+# -- live adapters' allowlists ------------------------------------------------------------------
+
+type RevokeListener = Callable[[str, str], object]
+_revoke_listeners: list[RevokeListener] = []
+_listeners_lock = threading.Lock()
+
+
+def add_revoke_listener(listener: RevokeListener) -> Callable[[], None]:
+    """Call ``listener(platform, user_id)`` after each revoke (adapters drop in-memory copies).
+
+    Returns a function that removes the listener.
+    """
+    with _listeners_lock:
+        _revoke_listeners.append(listener)
+
+    def remove() -> None:
+        with _listeners_lock, contextlib.suppress(ValueError):
+            _revoke_listeners.remove(listener)
+
+    return remove
+
+
+def _notify_revoked(platform: str, user_id: str) -> None:
+    with _listeners_lock:
+        listeners = list(_revoke_listeners)
+    for listener in listeners:
+        try:
+            listener(platform, user_id)
+        except Exception as exc:
+            log.warning("a revoke listener failed for %s: %s", platform, exc)
+
+
+# -- results ------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class CodeRequest:
+    status: RequestStatus
+    code: str | None = None
+    request_id: str | None = None
+    # True when the caller should tell the user to try later (the first refusal only).
+    notify: bool = False
+
+
+@dataclass(frozen=True)
+class Approval:
+    status: ApprovalStatus
+    user_id: str = ""
+    user_name: str = ""
+    lockout_seconds: float = 0.0
+
+    @property
+    def approved(self) -> bool:
+        return self.status == "approved"
+
+
+@dataclass(frozen=True)
+class PendingRequest:
+    platform: str
+    request_id: str
+    user_id: str
+    user_name: str
+    age_seconds: float
+
+
+@dataclass(frozen=True)
+class ApprovedUser:
+    platform: str
+    user_id: str
+    user_name: str
+    approved_at: float
+
+
+# -- allowlist mirror ---------------------------------------------------------------------------
+
+
+class EnvAllowlist:
+    """Mirrors approvals into the profile's ``INDUS_<PLATFORM>_ALLOWED_USERS`` when it is set."""
+
+    def __init__(self, env_name_for: Callable[[str], str | None] | None = None) -> None:
+        self._env_name_for = env_name_for or (lambda p: policy_env_name(p, "ALLOWED_USERS"))
+
+    def _current(self, scope: Scope, name: str) -> tuple[Path, list[str]]:
+        path = env_file_path(scope.home)
+        raw = envfile.read_env_file(path).get(name)
+        if raw is None:
+            raw = scope.env.get(name, "")
+        return path, [part.strip() for part in raw.split(",") if part.strip()]
+
+    def add(self, scope: Scope, platform: str, user_id: str) -> bool:
+        name = self._env_name_for(platform)
+        if not name:
+            return False
+        path, ids = self._current(scope, name)
+        if not ids or "*" in ids or user_id in ids:
+            return False
+        envfile.set_value(path, name, ",".join([*ids, user_id]))
+        return True
+
+    def remove(self, scope: Scope, platform: str, user_id: str) -> bool:
+        name = self._env_name_for(platform)
+        if not name:
+            return False
+        path, ids = self._current(scope, name)
+        kept = [i for i in ids if i != user_id]
+        if len(kept) == len(ids):
+            return False
+        envfile.set_value(path, name, ",".join(kept) if kept else None)
+        return True
+
+
+# -- the store ----------------------------------------------------------------------------------
+
+_dir_locks: dict[str, threading.RLock] = {}
+_dir_locks_guard = threading.Lock()
+
+
+def _thread_lock(directory: Path) -> threading.RLock:
+    with _dir_locks_guard:
+        return _dir_locks.setdefault(str(directory), threading.RLock())
+
+
+class PairingStore:
+    """Pairing codes, approvals, limits and decline stamps of one profile.
+
+    With ``scope=None`` every call resolves the current scope (``current_scope()``) afresh.
+    """
+
+    def __init__(
+        self, scope: Scope | None = None, *, allowlist: EnvAllowlist | None = None
+    ) -> None:
+        self._scope = scope
+        self._allowlist = allowlist if allowlist is not None else EnvAllowlist()
+        self._warned_unreadable: set[str] = set()
+
+    # -- plumbing ---------------------------------------------------------------------------------
+
+    def scope(self) -> Scope:
+        return self._scope if self._scope is not None else current_scope()
+
+    def directory(self) -> Path:
+        return pairing_dir(self.scope())
+
+    def _now(self) -> float:
+        return self.scope().clock.now().timestamp()
+
+    def _ready_dir(self) -> Path:
+        directory = self.directory()
+        directory.mkdir(parents=True, exist_ok=True)
+        with contextlib.suppress(OSError):
+            os.chmod(directory, 0o700)
+            os.chmod(directory.parent, 0o700)
+        return directory
+
+    @contextlib.contextmanager
+    def _locked(self) -> Iterator[Path]:
+        """Cross-process file lock first, then the thread lock (gateway and CLI share files)."""
+        directory = self._ready_dir()
+        with fsio.FileLock(directory / ".lock", timeout=LOCK_TIMEOUT), _thread_lock(directory):
+            yield directory
+
+    def _load(self, path: Path) -> dict[str, Any]:
+        try:
+            data = json.loads(path.read_text(encoding="utf-8-sig"))
+        except FileNotFoundError:
+            return {}
+        except PermissionError as exc:
+            if str(path) not in self._warned_unreadable:
+                self._warned_unreadable.add(str(path))
+                log.warning(
+                    "pairing file %s is not readable by this user (%s); fix its owner or run "
+                    "the command as the gateway's user",
+                    path,
+                    exc,
+                )
+            return {}
+        except (OSError, ValueError):
+            return {}
+        return data if isinstance(data, dict) else {}
+
+    def _save(self, path: Path, data: Mapping[str, Any]) -> None:
+        fsio.atomic_write_json(path, dict(data), mode=0o600)
+
+    @staticmethod
+    def _pending_path(directory: Path, platform: str) -> Path:
+        return directory / f"{platform}-pending.json"
+
+    @staticmethod
+    def _approved_path(directory: Path, platform: str) -> Path:
+        return directory / f"{platform}-approved.json"
+
+    def _live_pending(self, directory: Path, platform: str, now: float) -> dict[str, Any]:
+        """Pending rows still inside their lifetime; expired or malformed rows are dropped."""
+        path = self._pending_path(directory, platform)
+        pending = self._load(path)
+        live = {
+            rid: row
+            for rid, row in pending.items()
+            if isinstance(row, dict)
+            and isinstance(row.get("created_at"), int | float)
+            and isinstance(row.get("hash"), str)
+            and isinstance(row.get("salt"), str)
+            and now - float(row["created_at"]) <= CODE_TTL_SECONDS
+        }
+        if len(live) != len(pending):
+            self._save(path, live)
+        return live
+
+    # -- limits -----------------------------------------------------------------------------------
+
+    def _limits(self, directory: Path) -> dict[str, Any]:
+        return self._load(directory / _LIMITS)
+
+    def _save_limits(self, directory: Path, limits: Mapping[str, Any]) -> None:
+        self._save(directory / _LIMITS, limits)
+
+    @staticmethod
+    def _number(data: Mapping[str, Any], key: str) -> float:
+        value = data.get(key)
+        return (
+            float(value) if isinstance(value, int | float) and not isinstance(value, bool) else 0.0
+        )
+
+    def _lockout_left(self, limits: Mapping[str, Any], platform: str, now: float) -> float:
+        return max(0.0, self._number(limits, f"lockout:{platform}") - now)
+
+    def lockout_remaining(self, platform: str) -> float:
+        """Seconds until the platform's approval lockout ends (0 when not locked out)."""
+        platform = _check_platform(platform)
+        directory = self._ready_dir()
+        return self._lockout_left(self._limits(directory), platform, self._now())
+
+    def _failed(self, directory: Path, platform: str, now: float) -> None:
+        limits = self._limits(directory)
+        key = f"failures:{platform}"
+        count = int(self._number(limits, key)) + 1
+        if count >= MAX_FAILED_APPROVALS:
+            limits[f"lockout:{platform}"] = now + LOCKOUT_SECONDS
+            limits[key] = 0
+            log.warning(
+                "pairing approvals for %s are locked for %d s after %d wrong codes",
+                platform,
+                LOCKOUT_SECONDS,
+                MAX_FAILED_APPROVALS,
+            )
+        else:
+            limits[key] = count
+        self._save_limits(directory, limits)
+
+    def _reset_failures(self, directory: Path, platform: str) -> None:
+        limits = self._limits(directory)
+        if limits.get(f"failures:{platform}"):
+            limits[f"failures:{platform}"] = 0
+            self._save_limits(directory, limits)
+
+    # -- codes ------------------------------------------------------------------------------------
+
+    def request_code(self, platform: str, user_id: str, user_name: str = "") -> CodeRequest:
+        """Issue a code for ``user_id``, or say why not (and whether to tell them once)."""
+        platform = _check_platform(platform)
+        user = str(user_id).strip()
+        if not user:
+            raise ValueError("a pairing code needs a user id")
+        with self._locked() as directory:
+            now = self._now()
+            pending = self._live_pending(directory, platform, now)
+            limits = self._limits(directory)
+            asked_key = f"asked:{platform}:{user}"
+            told_key = f"told:{platform}:{user}"
+            status: RequestStatus | None = None
+            if self._lockout_left(limits, platform, now) > 0:
+                status = "locked_out"
+            elif now - self._number(limits, asked_key) < REQUEST_INTERVAL_SECONDS:
+                status = "rate_limited"
+            elif len(pending) >= MAX_PENDING_PER_PLATFORM:
+                status = "pending_full"
+            if status is not None:
+                # Tell them once per refusal spell. A spell ends with their next issued code, or
+                # after the longest refusal (an hour: lockout length and code lifetime).
+                told = self._number(limits, told_key)
+                asked = self._number(limits, asked_key)
+                notify = told <= 0 or told < asked or now - told >= CODE_TTL_SECONDS
+                if notify:
+                    limits[told_key] = now
+                    self._save_limits(directory, limits)
+                return CodeRequest(status=status, notify=notify)
+            code = "".join(secrets.choice(ALPHABET) for _ in range(CODE_LENGTH))
+            salt = secrets.token_bytes(SALT_BYTES)
+            request_id = secrets.token_hex(8)
+            pending[request_id] = {
+                "hash": _hash(code, salt),
+                "salt": salt.hex(),
+                "user_id": user,
+                "user_name": str(user_name or ""),
+                "created_at": now,
+            }
+            self._save(self._pending_path(directory, platform), pending)
+            limits[asked_key] = now
+            self._save_limits(directory, limits)
+            return CodeRequest(status="issued", code=code, request_id=request_id)
+
+    def approve(self, platform: str, value: str) -> Approval:
+        """Approve by request id (16 hex) or by the code the user received."""
+        if looks_like_request_id(value):
+            return self.approve_request(platform, value)
+        return self.approve_code(platform, value)
+
+    def approve_code(self, platform: str, code: str) -> Approval:
+        platform = _check_platform(platform)
+        typed = normalise_code(code)
+        with self._locked() as directory:
+            now = self._now()
+            pending = self._live_pending(directory, platform, now)
+            left = self._lockout_left(self._limits(directory), platform, now)
+            if left > 0:  # before the lookup: a valid code must not slip past a lockout
+                return Approval(status="locked_out", lockout_seconds=left)
+            match: str | None = None
+            for request_id, row in pending.items():
+                try:
+                    salt = bytes.fromhex(str(row["salt"]))
+                except ValueError:
+                    continue
+                if secrets.compare_digest(_hash(typed, salt), str(row["hash"])):
+                    match = request_id
+            if match is None:
+                self._failed(directory, platform, now)
+                left = self._lockout_left(self._limits(directory), platform, now)
+                if left > 0:
+                    return Approval(status="locked_out", lockout_seconds=left)
+                return Approval(status="invalid")
+            self._reset_failures(directory, platform)
+            return self._finish(directory, platform, pending, match, now)
+
+    def approve_request(self, platform: str, request_id: str) -> Approval:
+        """Approve by request id: not gated by the lockout and never counted toward it."""
+        platform = _check_platform(platform)
+        wanted = str(request_id or "").strip().lower()
+        with self._locked() as directory:
+            now = self._now()
+            pending = self._live_pending(directory, platform, now)
+            for rid in pending:
+                if wanted and secrets.compare_digest(rid.lower(), wanted):
+                    return self._finish(directory, platform, pending, rid, now)
+            return Approval(status="invalid")
+
+    def _finish(
+        self,
+        directory: Path,
+        platform: str,
+        pending: dict[str, Any],
+        request_id: str,
+        now: float,
+    ) -> Approval:
+        row = pending.pop(request_id)
+        self._save(self._pending_path(directory, platform), pending)
+        user_id = str(row.get("user_id") or "")
+        user_name = str(row.get("user_name") or "")
+        path = self._approved_path(directory, platform)
+        approved = self._load(path)
+        approved[user_id] = {"user_name": user_name, "approved_at": now}
+        self._save(path, approved)
+        try:
+            self._allowlist.add(self.scope(), platform, user_id)
+        except Exception as exc:  # the pairing grant still authorizes on its own
+            log.warning("could not add the approved user to the %s allowlist: %s", platform, exc)
+        return Approval(status="approved", user_id=user_id, user_name=user_name)
+
+    # -- approvals --------------------------------------------------------------------------------
+
+    def is_approved(self, platform: str, user_id: str) -> bool:
+        try:
+            platform = _check_platform(platform)
+        except ValueError:
+            return False
+        user = str(user_id or "").strip()
+        if not user:
+            return False
+        return user in self._load(self._approved_path(self.directory(), platform))
+
+    def revoke(self, platform: str, user_id: str) -> bool:
+        platform = _check_platform(platform)
+        user = str(user_id or "").strip()
+        with self._locked() as directory:
+            path = self._approved_path(directory, platform)
+            approved = self._load(path)
+            if user not in approved:
+                return False
+            del approved[user]
+            self._save(path, approved)
+            try:
+                self._allowlist.remove(self.scope(), platform, user)
+            except Exception as exc:
+                log.warning("could not remove the user from the %s allowlist: %s", platform, exc)
+        _notify_revoked(platform, user)
+        return True
+
+    def _platforms(self, directory: Path, suffix: str) -> list[str]:
+        tail = f"-{suffix}.json"
+        try:
+            names = sorted(p.name for p in directory.iterdir() if p.name.endswith(tail))
+        except OSError:
+            return []
+        found = [n[: -len(tail)] for n in names]
+        return [p for p in found if _PLATFORM_RE.match(p)]
+
+    def list_pending(self, platform: str | None = None) -> list[PendingRequest]:
+        """Pending requests (codes are never part of the listing)."""
+        with self._locked() as directory:
+            now = self._now()
+            names = (
+                [_check_platform(platform)] if platform else self._platforms(directory, "pending")
+            )
+            out: list[PendingRequest] = []
+            for name in names:
+                for rid, row in self._live_pending(directory, name, now).items():
+                    out.append(
+                        PendingRequest(
+                            platform=name,
+                            request_id=rid,
+                            user_id=str(row.get("user_id") or ""),
+                            user_name=str(row.get("user_name") or ""),
+                            age_seconds=max(0.0, now - float(row["created_at"])),
+                        )
+                    )
+            return out
+
+    def list_approved(self, platform: str | None = None) -> list[ApprovedUser]:
+        directory = self._ready_dir()
+        names = [_check_platform(platform)] if platform else self._platforms(directory, "approved")
+        out: list[ApprovedUser] = []
+        for name in names:
+            for user_id, info in self._load(self._approved_path(directory, name)).items():
+                row: Mapping[str, Any] = info if isinstance(info, dict) else {}
+                out.append(
+                    ApprovedUser(
+                        platform=name,
+                        user_id=str(user_id),
+                        user_name=str(row.get("user_name") or ""),
+                        approved_at=self._number(row, "approved_at"),
+                    )
+                )
+        return out
+
+    def clear_pending(self, platform: str | None = None) -> int:
+        with self._locked() as directory:
+            names = (
+                [_check_platform(platform)] if platform else self._platforms(directory, "pending")
+            )
+            count = 0
+            for name in names:
+                path = self._pending_path(directory, name)
+                count += len(self._load(path))
+                self._save(path, {})
+            return count
+
+    # -- decline stamps ---------------------------------------------------------------------------
+
+    def has_recent_decline(self, platform: str, user_id: str) -> bool:
+        platform = _check_platform(platform)
+        stamps = self._load(self.directory() / _DECLINED)
+        stamp = self._number(stamps, f"{platform}:{user_id}")
+        return stamp > 0 and self._now() - stamp < DECLINE_WINDOW_SECONDS
+
+    def record_decline(self, platform: str, user_id: str) -> None:
+        """Stamp the sender (callers stamp before sending, so a failed send cannot repeat)."""
+        platform = _check_platform(platform)
+        with self._locked() as directory:
+            now = self._now()
+            path = directory / _DECLINED
+            stamps = {
+                key: value
+                for key, value in self._load(path).items()
+                if isinstance(value, int | float) and now - float(value) < DECLINE_WINDOW_SECONDS
+            }
+            stamps[f"{platform}:{user_id}"] = now
+            self._save(path, stamps)
