+++ b/src/indus/gateway/core/send.py
@@ -0,0 +1,422 @@
+"""Send results, the send-error classifier and the inline retry policy (P15-04).
+
+Every outbound platform call answers with a `SendResult`. Failures are sorted into seven kinds
+by an ordered rule table (first match wins; nothing matched is ``unknown``, never harmless).
+
+Retry rules (R06.3, R06.4):
+- read/write timeouts are never retried: the platform may already have the message;
+- connection-level failures and explicit rate limits are retried, at most ``max_retries`` times,
+  with backoff ``base_delay * 2**n`` plus jitter; a server ``retry_after`` replaces one backoff;
+- a server wait above the inline cap is not slept: the typed flood failure is returned so the
+  delivery ledger owns the wait, and no "delivery failed" notice is sent into the penalty;
+- a formatting failure is re-sent once as plain text;
+- a split payload that partly landed is never sent whole again: only a remainder the adapter
+  proves undelivered is sent.
+"""
+
+from __future__ import annotations
+
+import logging
+import random
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass, field, replace
+from enum import StrEnum
+
+from indus.foundation.clock import Clock
+
+log = logging.getLogger(__name__)
+
+DELIVERY_FAILED_NOTICE = (
+    "Sorry, I could not deliver my last reply because of a connection problem. "
+    "Ask again if you still need it."
+)
+
+
+class ErrorKind(StrEnum):
+    TOO_LONG = "too_long"
+    BAD_FORMAT = "bad_format"
+    FORBIDDEN = "forbidden"
+    NOT_FOUND = "not_found"
+    RATE_LIMITED = "rate_limited"
+    TRANSIENT = "transient"
+    UNKNOWN = "unknown"
+
+
+# -- classifier -------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class _Rule:
+    kind: ErrorKind
+    needles: tuple[str, ...]
+    classes: tuple[type[BaseException], ...] = ()
+    # Matches only when every needle of one group is present (``("parse", "entit")``).
+    together: tuple[tuple[str, ...], ...] = ()
+
+    def matches(self, blob: str, exc: BaseException | None) -> bool:
+        if any(needle in blob for needle in self.needles):
+            return True
+        if any(all(n in blob for n in group) for group in self.together):
+            return True
+        return exc is not None and isinstance(exc, self.classes)
+
+
+# A whole chat is gone.
+_CHAT_GONE = (
+    "chat not found",
+    "chat_not_found",
+    "channel not found",
+    "channel_not_found",
+    "unknown channel",
+    "peer_id_invalid",
+)
+# Something inside a chat is gone; the chat itself is still reachable.
+_SUB_CHAT_GONE = (
+    "thread not found",
+    "thread_not_found",
+    "topic not found",
+    "topic_deleted",
+    "topic_closed",
+    "message to edit not found",
+    "message to reply not found",
+    "message to delete not found",
+    "message_id_invalid",
+    "message_not_found",
+    "message not found",
+    "unknown message",
+)
+# The request may have reached the platform before the wait ran out.
+_AMBIGUOUS = (
+    "timed out",
+    "timedout",
+    "readtimeout",
+    "writetimeout",
+    "read timeout",
+    "write timeout",
+    "readerror",
+    "timeouterror",
+    "response ended prematurely",
+)
+# The request never reached the platform.
+_CONNECT_LEVEL = (
+    "connecterror",
+    "connectionerror",
+    "connect error",
+    "connecttimeout",
+    "connect timeout",
+    "pooltimeout",
+    "connection refused",
+    "connectionrefused",
+    "connection reset",
+    "connectionreset",
+    "connection aborted",
+    "connectionaborted",
+    "broken pipe",
+    "brokenpipe",
+    "remotedisconnected",
+    "server disconnected",
+    "cannot connect to host",
+    "network is unreachable",
+    "name or service not known",
+    "temporary failure in name resolution",
+    "nodename nor servname",
+    "eoferror",
+    "networkerror",
+)
+
+_RULES: tuple[_Rule, ...] = (
+    _Rule(
+        ErrorKind.TOO_LONG,
+        ("too long", "too_long", "msg_too_long", "or fewer in length", "message is too big"),
+    ),
+    _Rule(
+        ErrorKind.BAD_FORMAT,
+        (
+            "can't parse",
+            "cant parse",
+            "can not parse",
+            "unsupported start tag",
+            "can't find end",
+            "invalid_blocks",
+            "invalid_block",
+            "invalid_mrkdwn",
+            "invalid form body",
+        ),
+        together=(("parse", "entit"), ("bad request", "entit")),
+    ),
+    _Rule(
+        ErrorKind.FORBIDDEN,
+        (
+            "forbidden",
+            "bot was blocked",
+            "blocked by the user",
+            "user is deactivated",
+            "bot was kicked",
+            "not enough rights",
+            "have no rights",
+            "not a member",
+            "not_in_channel",
+            "is_archived",
+            "missing access",
+            "missing permissions",
+            "cannot send messages to this user",
+            "access_denied",
+        ),
+        (PermissionError,),
+    ),
+    _Rule(ErrorKind.NOT_FOUND, (*_CHAT_GONE, *_SUB_CHAT_GONE)),
+    _Rule(
+        ErrorKind.RATE_LIMITED,
+        (
+            "flood",
+            "too many requests",
+            "retry after",
+            "retryafter",
+            "rate limit",
+            "ratelimit",
+            "rate_limit",
+            "slow down",
+        ),
+    ),
+    # Ambiguous timeouts sort before the connection rule: a wrapper such as
+    # "NetworkError: ReadTimeout" must never be retried.
+    _Rule(ErrorKind.UNKNOWN, _AMBIGUOUS, (TimeoutError,)),
+    _Rule(
+        ErrorKind.TRANSIENT,
+        _CONNECT_LEVEL,
+        (ConnectionRefusedError, ConnectionResetError, ConnectionAbortedError, BrokenPipeError),
+    ),
+)
+
+
+def _blob(exc: BaseException | None, text: str) -> str:
+    parts = [text] if text else []
+    if exc is not None:
+        parts.extend(p for p in (str(exc), type(exc).__name__) if p)
+    return " ".join(parts).lower()
+
+
+def classify_send_error(exc: BaseException | None = None, text: str = "") -> ErrorKind:
+    """The kind of a send failure; ``unknown`` when no rule matches."""
+    blob = _blob(exc, text)
+    for rule in _RULES:
+        if rule.matches(blob, exc):
+            return rule.kind
+    return ErrorKind.UNKNOWN
+
+
+def is_chat_level_not_found(exc: BaseException | None = None, text: str = "") -> bool:
+    """True when "not found" means the whole chat; a sub-chat reading wins when both appear."""
+    blob = _blob(exc, text)
+    if any(needle in blob for needle in _SUB_CHAT_GONE):
+        return False
+    return any(needle in blob for needle in _CHAT_GONE)
+
+
+def is_ambiguous_timeout(exc: BaseException | None = None, text: str = "") -> bool:
+    """True for read/write timeouts: the platform may have the message, so never re-send."""
+    blob = _blob(exc, text)
+    if any(needle in blob for needle in _AMBIGUOUS):
+        return True
+    return exc is not None and isinstance(exc, TimeoutError)
+
+
+# -- result -----------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class SendResult:
+    ok: bool
+    message_id: str | None = None
+    error: str | None = None
+    retryable: bool = False
+    retry_after: float | None = None
+    # Earlier chunk ids in send order when a payload was split; ``message_id`` is the last one.
+    continuation_ids: tuple[str, ...] = ()
+    kind: ErrorKind | None = None
+    # ``not_found`` that means the whole chat.
+    chat_level: bool = False
+    # A timeout: the platform may have the message.
+    maybe_delivered: bool = False
+    # Part of a split payload is already visible.
+    partial: bool = False
+    # Text the adapter proves was not delivered (only with ``partial``); None = cannot resume.
+    remainder: str | None = None
+    # An optional operation this platform does not have; nothing was sent.
+    unsupported: bool = False
+    # An interim edit dropped because the chat's send slot was busy.
+    skipped: bool = False
+    extra: dict[str, object] = field(default_factory=dict[str, object], compare=False)
+
+    @classmethod
+    def sent(cls, message_id: str, continuation_ids: tuple[str, ...] = ()) -> SendResult:
+        return cls(ok=True, message_id=str(message_id), continuation_ids=tuple(continuation_ids))
+
+    @classmethod
+    def failure(
+        cls,
+        error: str | None = None,
+        *,
+        exc: BaseException | None = None,
+        retry_after: float | None = None,
+        partial: bool = False,
+        remainder: str | None = None,
+        delivered_ids: tuple[str, ...] = (),
+    ) -> SendResult:
+        """A classified failure. ``delivered_ids`` are the chunks that did land (``partial``)."""
+        text = error if error is not None else (f"{type(exc).__name__}: {exc}" if exc else "")
+        kind = classify_send_error(exc, text)
+        if retry_after is not None and kind is not ErrorKind.RATE_LIMITED:
+            kind = ErrorKind.RATE_LIMITED
+        ambiguous = kind is ErrorKind.UNKNOWN and is_ambiguous_timeout(exc, text)
+        ids = tuple(delivered_ids)
+        return cls(
+            ok=False,
+            message_id=ids[-1] if ids else None,
+            continuation_ids=ids[:-1],
+            error=text or "send failed",
+            retryable=kind in (ErrorKind.TRANSIENT, ErrorKind.RATE_LIMITED),
+            retry_after=retry_after,
+            kind=kind,
+            chat_level=kind is ErrorKind.NOT_FOUND and is_chat_level_not_found(exc, text),
+            maybe_delivered=ambiguous,
+            partial=partial or bool(ids),
+            remainder=remainder if (partial or ids) else None,
+        )
+
+    @classmethod
+    def refused(cls, what: str) -> SendResult:
+        return cls(ok=False, error=f"{what} is not supported on this platform", unsupported=True)
+
+    @classmethod
+    def skip(cls) -> SendResult:
+        return cls(ok=False, error="skipped: the chat's send slot is busy", skipped=True)
+
+    @property
+    def ids(self) -> tuple[str, ...]:
+        """Every delivered id in send order."""
+        tail = (self.message_id,) if self.message_id is not None else ()
+        return (*self.continuation_ids, *tail)
+
+    @property
+    def chat_unreachable(self) -> bool:
+        """The whole chat cannot be reached (dead-target registry, P15-17)."""
+        if self.ok:
+            return False
+        return self.kind is ErrorKind.FORBIDDEN or (
+            self.kind is ErrorKind.NOT_FOUND and self.chat_level
+        )
+
+    @property
+    def is_flood(self) -> bool:
+        """Rate limited with a server wait: the delivery ledger retries after ``retry_after``."""
+        return not self.ok and self.kind is ErrorKind.RATE_LIMITED and self.retry_after is not None
+
+    def with_earlier(self, earlier: tuple[str, ...]) -> SendResult:
+        """This result with ``earlier`` delivered ids in front (after a resumed remainder)."""
+        if not earlier:
+            return self
+        ids = (*earlier, *self.ids)
+        return replace(self, message_id=ids[-1], continuation_ids=ids[:-1], partial=not self.ok)
+
+
+# -- retry ------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RetryPolicy:
+    max_retries: int = 2
+    base_delay: float = 2.0
+    jitter: float = 1.0
+    # Longest wait slept inline; longer server waits return the typed flood failure.
+    inline_wait_cap: float = 60.0
+
+
+Attempt = Callable[[str, bool], Awaitable[SendResult]]
+
+
+def _wants_retry(result: SendResult) -> bool:
+    return not result.maybe_delivered and (
+        result.retryable or result.retry_after is not None or result.kind is ErrorKind.RATE_LIMITED
+    )
+
+
+async def _call(attempt: Attempt, text: str, plain: bool) -> SendResult:
+    try:
+        return await attempt(text, plain)
+    except Exception as exc:  # an adapter that raised instead of answering
+        return SendResult.failure(exc=exc)
+
+
+async def send_with_retry(
+    attempt: Attempt,
+    content: str,
+    *,
+    clock: Clock,
+    policy: RetryPolicy | None = None,
+    rng: Callable[[], float] = random.random,
+    notice: str | None = DELIVERY_FAILED_NOTICE,
+    is_final: Callable[[SendResult], bool] | None = None,
+) -> SendResult:
+    """Send ``content`` through ``attempt(text, plain)`` under the retry rules above."""
+    policy = policy or RetryPolicy()
+    result = await _call(attempt, content, False)
+    if result.ok or result.unsupported or (is_final is not None and is_final(result)):
+        return result
+    if result.maybe_delivered:
+        return result
+
+    if _wants_retry(result):
+        server_wait = result.retry_after
+        for n in range(policy.max_retries):
+            if server_wait is not None and server_wait > policy.inline_wait_cap:
+                log.warning(
+                    "send rate limited for %.0f s (inline cap %.0f s); handing the wait over",
+                    server_wait,
+                    policy.inline_wait_cap,
+                )
+                return result
+            if result.partial and not result.remainder:
+                log.warning("split send partly delivered; the rest cannot be resumed safely")
+                return result
+            base = server_wait if server_wait is not None else policy.base_delay * (2**n)
+            await clock.sleep(min(base + rng() * policy.jitter, max(base, policy.inline_wait_cap)))
+            earlier = result.ids if result.partial else ()
+            text = result.remainder if result.partial and result.remainder else content
+            again = await _call(attempt, text, False)
+            if earlier and not (again.ok or again.partial or again.maybe_delivered):
+                # Nothing of the remainder landed, so it is still the proven-undelivered tail.
+                again = replace(again, remainder=text)
+            result = again.with_earlier(earlier)
+            if result.ok or result.unsupported or (is_final is not None and is_final(result)):
+                return result
+            if result.maybe_delivered:
+                return result
+            server_wait = result.retry_after
+            if not _wants_retry(result):
+                break
+        else:
+            if result.kind is ErrorKind.RATE_LIMITED or result.retry_after is not None:
+                return result
+            log.warning("send failed after %d retries: %s", policy.max_retries, result.error)
+            if notice:
+                await _call(attempt, notice, True)
+            return result
+
+    if result.partial or result.kind not in (ErrorKind.BAD_FORMAT, ErrorKind.UNKNOWN):
+        return result
+    log.info("send failed (%s); trying once as plain text", result.kind)
+    return await _call(attempt, content, True)
+
+
+__all__ = [
+    "DELIVERY_FAILED_NOTICE",
+    "Attempt",
+    "ErrorKind",
+    "RetryPolicy",
+    "SendResult",
+    "classify_send_error",
+    "is_ambiguous_timeout",
+    "is_chat_level_not_found",
+    "send_with_retry",
+]
diff --git a/src/indus/gateway/core/send_slot.py b/src/indus/gateway/core/send_slot.py
new file mode 100644
index 0000000..6dd741b
--- /dev/null
+++ b/src/indus/gateway/core/send_slot.py
@@ -0,0 +1,114 @@
+"""One outbound slot per (adapter, chat), shared by sends and edits (P15-05, R06.13).
+
+Platforms count edits against the same per-chat allowance as sends, so pacing them separately
+draws flood penalties. Every send to a chat waits for the chat's slot and then for the adapter's
+spacing since the previous operation started. An interim edit (a streaming refresh) never waits:
+when the slot is busy, a send is queued for it, or the spacing has not passed, the edit is
+skipped and a later one carries the text. The final edit is never gated; it only stamps the time
+so the next send keeps its distance. Chats never block each other.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import AsyncIterator
+from contextlib import AbstractAsyncContextManager, asynccontextmanager
+from dataclasses import dataclass, field
+
+from indus.foundation.clock import Clock
+
+# Idle per-chat records are dropped once this many exist.
+_PRUNE_ABOVE = 256
+
+
+@dataclass
+class _Chat:
+    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
+    waiting: int = 0
+    last_start: float | None = None
+
+
+class SendSlots:
+    def __init__(self, clock: Clock, spacing: float = 0.0) -> None:
+        if spacing < 0:
+            raise ValueError("spacing must be >= 0")
+        self.clock = clock
+        self.spacing = spacing
+        self._chats: dict[str, _Chat] = {}
+
+    def _chat(self, chat_id: str) -> _Chat:
+        key = str(chat_id)
+        state = self._chats.get(key)
+        if state is None:
+            if len(self._chats) >= _PRUNE_ABOVE:
+                self._prune()
+            state = _Chat()
+            self._chats[key] = state
+        return state
+
+    def _idle(self, state: _Chat, now: float) -> bool:
+        if state.lock.locked() or state.waiting:
+            return False
+        return state.last_start is None or now - state.last_start >= self.spacing
+
+    def _prune(self) -> None:
+        now = self.clock.monotonic()
+        for key in [k for k, s in self._chats.items() if self._idle(s, now)]:
+            del self._chats[key]
+
+    def _due_in(self, state: _Chat) -> float:
+        if self.spacing <= 0 or state.last_start is None:
+            return 0.0
+        return state.last_start + self.spacing - self.clock.monotonic()
+
+    async def _pace(self, state: _Chat) -> None:
+        wait = self._due_in(state)
+        if wait > 0:
+            await self.clock.sleep(wait)
+        state.last_start = self.clock.monotonic()
+
+    @asynccontextmanager
+    async def hold(self, chat_id: str) -> AsyncIterator[None]:
+        """Wait for the chat's slot and its spacing, then hold the slot for one operation."""
+        state = self._chat(chat_id)
+        state.waiting += 1
+        try:
+            await state.lock.acquire()
+        finally:
+            state.waiting -= 1
+        try:
+            await self._pace(state)
+            yield
+        finally:
+            state.lock.release()
+
+    async def pace(self, chat_id: str) -> None:
+        """Inside ``hold``: wait out the spacing before the next platform call (split chunks)."""
+        await self._pace(self._chat(chat_id))
+
+    def try_interim(self, chat_id: str) -> AbstractAsyncContextManager[None] | None:
+        """A held slot for an interim edit, or None when the edit should be skipped."""
+        state = self._chat(chat_id)
+        if state.lock.locked() or state.waiting or self._due_in(state) > 0:
+            return None
+        return self._interim(state)
+
+    @asynccontextmanager
+    async def _interim(self, state: _Chat) -> AsyncIterator[None]:
+        await state.lock.acquire()
+        try:
+            state.last_start = self.clock.monotonic()
+            yield
+        finally:
+            state.lock.release()
+
+    def mark(self, chat_id: str) -> None:
+        """A final edit: never waits, but the next send keeps its distance from it."""
+        self._chat(chat_id).last_start = self.clock.monotonic()
+
+    def busy(self, chat_id: str) -> bool:
+        state = self._chats.get(str(chat_id))
+        return state is not None and (state.lock.locked() or state.waiting > 0)
+
+
+__all__ = ["SendSlots"]
diff --git a/src/indus/gateway/core/sent_index.py b/src/indus/gateway/core/sent_index.py
new file mode 100644
index 0000000..17d7a3c
--- /dev/null
+++ b/src/indus/gateway/core/sent_index.py
@@ -0,0 +1,93 @@
+"""A bounded memory of what the gateway sent, for reply context (P15-03).
+
+Some platforms do not echo a rich message's text when a user replies to it (Telegram) or quote
+only its id. The outbound sender records each delivered message here; inbound replies look the
+id up to recover the quoted text and to learn that the reply targets one of our own messages.
+
+Bounded twice: per chat the least recently used ids go first beyond ``per_chat``, and beyond
+``max_chats`` the least recently used chat is dropped whole. Texts are cut to ``max_text_bytes``
+of UTF-8 on a character boundary. Memory only: nothing is written to disk.
+"""
+
+from __future__ import annotations
+
+import threading
+from collections import OrderedDict
+
+DEFAULT_PER_CHAT = 2000
+DEFAULT_MAX_TEXT_BYTES = 4096
+DEFAULT_MAX_CHATS = 1000
+
+_ChatKey = tuple[str, str]
+
+
+def _cut(text: str, limit: int) -> str:
+    data = text.encode("utf-8")
+    if len(data) <= limit:
+        return text
+    return data[:limit].decode("utf-8", errors="ignore")
+
+
+class SentIndex:
+    def __init__(
+        self,
+        *,
+        per_chat: int = DEFAULT_PER_CHAT,
+        max_text_bytes: int = DEFAULT_MAX_TEXT_BYTES,
+        max_chats: int = DEFAULT_MAX_CHATS,
+    ) -> None:
+        if per_chat < 1 or max_chats < 1 or max_text_bytes < 0:
+            raise ValueError("SentIndex bounds must be positive")
+        self.per_chat = per_chat
+        self.max_text_bytes = max_text_bytes
+        self.max_chats = max_chats
+        self._chats: OrderedDict[_ChatKey, OrderedDict[str, str]] = OrderedDict()
+        self._lock = threading.Lock()
+
+    def record(self, platform: str, chat_id: str, message_id: str, text: str) -> None:
+        key = (platform, str(chat_id))
+        with self._lock:
+            entries = self._chats.get(key)
+            if entries is None:
+                entries = OrderedDict()
+                self._chats[key] = entries
+                while len(self._chats) > self.max_chats:
+                    self._chats.popitem(last=False)
+            else:
+                self._chats.move_to_end(key)
+            entries[str(message_id)] = _cut(text or "", self.max_text_bytes)
+            entries.move_to_end(str(message_id))
+            while len(entries) > self.per_chat:
+                entries.popitem(last=False)
+
+    def _touch(self, platform: str, chat_id: str, message_id: str) -> str | None:
+        key = (platform, str(chat_id))
+        entries = self._chats.get(key)
+        if entries is None:
+            return None
+        text = entries.get(str(message_id))
+        if text is None:
+            return None
+        entries.move_to_end(str(message_id))
+        self._chats.move_to_end(key)
+        return text
+
+    def lookup(self, platform: str, chat_id: str, message_id: str) -> str | None:
+        """The recorded text (None when unknown or recorded empty)."""
+        with self._lock:
+            return self._touch(platform, chat_id, message_id) or None
+
+    def is_own(self, platform: str, chat_id: str, message_id: str) -> bool:
+        with self._lock:
+            return self._touch(platform, chat_id, message_id) is not None
+
+    def chats(self) -> list[_ChatKey]:
+        with self._lock:
+            return list(self._chats)
+
+    def __len__(self) -> int:
+        with self._lock:
+            return sum(len(entries) for entries in self._chats.values())
+
+
+__all__ = ["DEFAULT_MAX_CHATS", "DEFAULT_MAX_TEXT_BYTES", "DEFAULT_PER_CHAT", "SentIndex"]
diff --git a/src/indus/gateway/core/session_keys.py b/src/indus/gateway/core/session_keys.py
new file mode 100644
index 0000000..675e6c2
--- /dev/null
+++ b/src/indus/gateway/core/session_keys.py
@@ -0,0 +1,120 @@
+"""The one session-key builder (P15-07, R06.7).
+
+A session key names one conversation slot. It is persisted in the routing index, so its bytes are
+a compatibility surface: ``tests/fixtures/gateway/session_keys.golden.json`` freezes them, and no
+other code may assemble a key.
+
+Layout: ``<ns>:<platform>:<chat_type>[:<scope_id>][:<chat_id>][<user and thread parts>]``.
+
+- ``<ns>`` is ``@default`` for the default profile and the profile id otherwise. ``@`` is outside
+  the profile-id alphabet, so no profile can ever produce the default namespace.
+- Only Slack puts a scope (its workspace id) before the chat id; a Discord guild id is never part
+  of a key.
+- DMs key on the chat id; without one on the sender, without both one slot per platform. In a DM
+  the user part comes before the thread part.
+- In groups each participant (alternate id first) gets their own slot by default
+  (``group_sessions_per_user``), except inside a thread: everyone in a thread shares it unless
+  ``thread_sessions_per_user`` is on. In a group the thread part comes before the user part.
+- A channel message that will open a thread (Discord auto-threads) is keyed on that future thread
+  (``prospective_thread_id``) with the chat-type slot ``thread``, so the follow-ups inside the
+  thread produce the same bytes; a real thread id always wins; DMs never use the prospective id.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+from indus.foundation.profiles import DEFAULT_PROFILE
+from indus.gateway.core._shapes import SourceLike, text_of
+
+__all__ = [
+    "DEFAULT_NAMESPACE",
+    "build_session_key",
+    "canonical_participant",
+    "key_namespace",
+    "origin_of",
+]
+
+DEFAULT_NAMESPACE = "@default"
+_DM = "dm"
+_THREAD = "thread"
+# Platforms whose workspace id is part of the key (one bot installed in several workspaces can see
+# the same channel id in each).
+_SCOPED_PLATFORMS = frozenset({"slack"})
+_ORIGIN_FIELDS = (
+    "platform",
+    "chat_id",
+    "chat_name",
+    "chat_type",
+    "user_id",
+    "user_name",
+    "thread_id",
+    "user_id_alt",
+    "is_bot",
+    "scope_id",
+    "guild_id",
+    "parent_chat_id",
+    "prospective_thread_id",
+)
+
+
+def key_namespace(profile: str | None) -> str:
+    """``@default`` for the default profile (or none), else the profile id."""
+    name = (profile or "").strip()
+    if not name or name == DEFAULT_PROFILE:
+        return DEFAULT_NAMESPACE
+    return name
+
+
+def canonical_participant(source: SourceLike) -> str:
+    """The sender id used to separate participants: the alternate id when the platform has one.
+
+    Platform-specific identity folding (WhatsApp phone / JID aliases) plugs in here (P16).
+    """
+    return text_of(source.user_id_alt) or text_of(source.user_id)
+
+
+def build_session_key(
+    source: SourceLike,
+    *,
+    profile: str | None = None,
+    group_sessions_per_user: bool = True,
+    thread_sessions_per_user: bool = False,
+) -> str:
+    """The session key for ``source`` (see the module docstring for the rules)."""
+    platform = text_of(source.platform).lower()
+    chat_type = text_of(source.chat_type).lower() or _DM
+    is_dm = chat_type == _DM
+    chat_id = text_of(source.chat_id)
+    real_thread = text_of(source.thread_id)
+    thread = real_thread or ("" if is_dm else text_of(source.prospective_thread_id))
+    slot = _THREAD if thread and not real_thread else chat_type
+
+    if is_dm:
+        separate_user = not chat_id
+    else:
+        separate_user = group_sessions_per_user and not (thread and not thread_sessions_per_user)
+    participant = canonical_participant(source) if separate_user else ""
+
+    parts = [key_namespace(profile), platform, slot]
+    scope = text_of(source.scope_id)
+    if platform in _SCOPED_PLATFORMS and scope:
+        parts.append(scope)
+    if chat_id:
+        parts.append(chat_id)
+    user_part = [participant] if participant else []
+    thread_part = [thread] if thread else []
+    parts.extend(user_part + thread_part if is_dm else thread_part + user_part)
+    return ":".join(parts)
+
+
+def origin_of(source: SourceLike) -> dict[str, Any]:
+    """A JSON-safe copy of the source for the routing index (delivery and restore use it)."""
+    origin: dict[str, Any] = {}
+    for name in _ORIGIN_FIELDS:
+        value = getattr(source, name, None)
+        if name == "is_bot":
+            origin[name] = value is True
+        elif value is not None and value != "":
+            origin[name] = text_of(value)
+    return origin
diff --git a/src/indus/gateway/core/slash_access.py b/src/indus/gateway/core/slash_access.py
new file mode 100644
index 0000000..84f2d58
--- /dev/null
+++ b/src/indus/gateway/core/slash_access.py
@@ -0,0 +1,115 @@
+"""Slash-command admin tiers per platform and scope (P15-10, K17).
+
+Among the people allowed to talk to the agent, who may run which slash command. Each platform's
+``extra`` holds two lists per scope:
+
+- DM scope: ``allow_admin_from`` (admins: every command, plugin commands included) and
+  ``user_allowed_commands`` (what everyone else may run);
+- group scope: ``group_allow_admin_from`` and ``group_user_allowed_commands``.
+
+Non-admins can always run ``help`` and ``whoami``. A scope with no admin list has tiers off:
+everyone runs everything there, so nothing changes until an operator names an admin. Plain chat is
+never gated. ``/help`` lists only what the caller may run (``runnable``). A source with an empty or
+unknown chat type is judged by whichever scope is gated, so ambiguity never opens access.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass
+from typing import Any, Literal
+
+__all__ = [
+    "FLOOR",
+    "SlashPolicy",
+    "policy_for",
+    "policy_from_extra",
+    "runnable",
+    "scope_of",
+    "tier_label",
+]
+
+FLOOR: frozenset[str] = frozenset({"help", "whoami"})
+_DM_TYPES = frozenset({"dm", "direct", "private"})
+_KEYS: dict[str, tuple[str, str]] = {
+    "dm": ("allow_admin_from", "user_allowed_commands"),
+    "group": ("group_allow_admin_from", "group_user_allowed_commands"),
+}
+
+type Scope = Literal["dm", "group"]
+
+
+def _items(raw: object, normalise: Callable[[str], str]) -> frozenset[str]:
+    if raw is None:
+        return frozenset()
+    if isinstance(raw, str):
+        parts: Iterable[Any] = raw.split(",")
+    elif isinstance(raw, list | tuple | set | frozenset):
+        parts = raw  # pyright: ignore[reportUnknownVariableType]
+    else:
+        parts = (raw,)
+    return frozenset(v for v in (normalise(str(p).strip()) for p in parts) if v)
+
+
+def _command(name: str) -> str:
+    return name.lstrip("/").strip().lower()
+
+
+@dataclass(frozen=True)
+class SlashPolicy:
+    enabled: bool
+    admins: frozenset[str] = frozenset()
+    user_commands: frozenset[str] = frozenset()
+
+    def is_admin(self, user_id: str | None) -> bool:
+        """With tiers off everyone counts as an admin."""
+        if not self.enabled:
+            return True
+        return bool(user_id) and str(user_id) in self.admins
+
+    def can_run(self, user_id: str | None, command: str) -> bool:
+        if self.is_admin(user_id):
+            return True
+        name = _command(command)
+        return bool(name) and (name in FLOOR or name in self.user_commands)
+
+
+def policy_from_extra(extra: Mapping[str, Any] | None, scope: Scope) -> SlashPolicy:
+    data: Mapping[str, Any] = extra if isinstance(extra, Mapping) else {}
+    admin_key, commands_key = _KEYS[scope]
+    admins = _items(data.get(admin_key), str)
+    commands = _items(data.get(commands_key), _command)
+    return SlashPolicy(enabled=bool(admins), admins=admins, user_commands=commands)
+
+
+def scope_of(chat_type: object) -> Scope | None:
+    """``dm`` / ``group`` for a chat type; None when it is empty."""
+    raw = getattr(chat_type, "value", chat_type)
+    text = str(raw).strip().lower() if raw is not None else ""
+    if not text:
+        return None
+    return "dm" if text in _DM_TYPES else "group"
+
+
+def policy_for(extra: Mapping[str, Any] | None, chat_type: object) -> SlashPolicy:
+    """The policy for a chat; an empty chat type takes whichever scope is gated (group on a tie)."""
+    scope = scope_of(chat_type)
+    if scope is not None:
+        return policy_from_extra(extra, scope)
+    dm = policy_from_extra(extra, "dm")
+    group = policy_from_extra(extra, "group")
+    return dm if dm.enabled and not group.enabled else group
+
+
+def runnable(policy: SlashPolicy, user_id: str | None, names: Iterable[str]) -> list[str]:
+    """The commands of ``names`` the caller may run, in the given order (for ``/help``)."""
+    return [name for name in names if policy.can_run(user_id, name)]
+
+
+def tier_label(policy: SlashPolicy, user_id: str | None) -> str:
+    """What ``/whoami`` says about the caller's tier."""
+    if not policy.enabled:
+        return "full access (no admins are set here)"
+    if policy.is_admin(user_id):
+        return "admin (every command)"
+    return "user (limited commands)"
diff --git a/src/indus/gateway/registry.py b/src/indus/gateway/registry.py
new file mode 100644
index 0000000..bda7401
--- /dev/null
+++ b/src/indus/gateway/registry.py
@@ -0,0 +1,364 @@
+"""The platform registry: every platform the gateway can run, in one table (P15-06).
+
+Each ``PlatformEntry`` says how to build the platform's adapter, how to tell whether its library is
+installed without importing it, which env names carry its credential and its access lists, its
+message cap, whether its DMs are really private (R06.24) and an optional cron target parser.
+Telegram, Discord, Slack, the API server and the webhook receiver are built in; plugins add
+entries through the P13 provider registry (``load_plugin_entries``).
+
+A platform's SDK is imported in exactly one place, ``PlatformRegistry.create_adapter``, which the
+gateway calls only for enabled platforms: importing this module, listing entries or probing
+dependencies (``importlib.util.find_spec``) never imports an SDK.
+
+``proxy_for`` decides which proxy an adapter uses: a per-platform proxy setting always wins;
+otherwise the standard proxy env vars, unless ``gateway.trust_env`` is false.
+"""
+
+from __future__ import annotations
+
+import importlib
+import importlib.util
+import logging
+import threading
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass, field, replace
+from typing import Any, Literal
+
+__all__ = [
+    "BUILTIN_NAMES",
+    "PlatformEntry",
+    "PlatformRegistry",
+    "TargetParser",
+    "builtin_entries",
+    "modules_installed",
+    "policy_env_name",
+    "proxy_for",
+]
+
+log = logging.getLogger(__name__)
+
+type TargetParser = Callable[[str], tuple[str, str | None] | None]
+type AdapterFactory = Callable[[Any], Any]
+
+BUILTIN_NAMES: tuple[str, ...] = ("telegram", "discord", "slack", "api_server", "webhook")
+
+
+def policy_env_name(platform: str, suffix: str) -> str:
+    """``INDUS_<PLATFORM>_<SUFFIX>``: the env name of one of a platform's policy settings."""
+    return f"INDUS_{platform.upper()}_{suffix}"
+
+
+def modules_installed(*names: str) -> Callable[[], bool]:
+    """A passive dependency probe: true when every top-level module can be found.
+
+    ``find_spec`` on a top-level name locates the package without running it, so the probe is safe
+    from status screens and the enablement pass.
+    """
+
+    def probe() -> bool:
+        for name in names:
+            try:
+                if importlib.util.find_spec(name) is None:
+                    return False
+            except (ImportError, ValueError):
+                return False
+        return True
+
+    return probe
+
+
+def _lazy_factory(target: str) -> AdapterFactory:
+    """A factory that imports ``module:attr`` only when an adapter is actually built."""
+    module_name, _, attr = target.partition(":")
+
+    def build(config: Any) -> Any:
+        module = importlib.import_module(module_name)
+        return getattr(module, attr)(config)
+
+    build.__qualname__ = f"lazy({target})"
+    return build
+
+
+@dataclass(frozen=True)
+class PlatformEntry:
+    """One platform the gateway can run."""
+
+    name: str
+    label: str
+    factory: AdapterFactory
+    check_fn: Callable[[], bool]
+    required_env: tuple[str, ...] = ()
+    install_hint: str = ""
+    allowlist_env: str = ""
+    allow_all_env: str = ""
+    allow_bots_env: str | None = None
+    home_env: str = ""
+    max_len: int = 0
+    dm_is_private: bool = True
+    platform_hint: str = ""
+    cron_target_parser: TargetParser | None = None
+    # Group allowlists read from env (empty: config only). Authorization reads them (P15-08).
+    group_users_env: str = ""
+    group_chats_env: str = ""
+    # Inbound events are authenticated by the platform's own check (signature, key), so user
+    # allowlists and pairing do not apply. Never for a platform where people send messages.
+    trusted_inbound: bool = False
+    source: Literal["builtin", "plugin"] = "builtin"
+    plugin_name: str = ""
+    extra: Mapping[str, Any] = field(default_factory=dict[str, Any])
+
+
+def _chat_entry(
+    name: str,
+    label: str,
+    *,
+    sdk: tuple[str, ...],
+    extra_name: str,
+    required_env: tuple[str, ...],
+    max_len: int,
+    hint: str,
+) -> PlatformEntry:
+    return PlatformEntry(
+        name=name,
+        label=label,
+        factory=_lazy_factory(f"indus.gateway.adapters.{name}:create_adapter"),
+        check_fn=modules_installed(*sdk),
+        required_env=required_env,
+        install_hint=f"pip install 'indus-agent[{extra_name}]'",
+        allowlist_env=policy_env_name(name, "ALLOWED_USERS"),
+        allow_all_env=policy_env_name(name, "ALLOW_ALL_USERS"),
+        allow_bots_env=policy_env_name(name, "ALLOW_BOTS"),
+        home_env=policy_env_name(name, "HOME_CHANNEL"),
+        max_len=max_len,
+        dm_is_private=True,
+        platform_hint=hint,
+    )
+
+
+def builtin_entries() -> tuple[PlatformEntry, ...]:
+    """The platforms that ship with Indus Agent, in a fixed order."""
+    return (
+        _chat_entry(
+            "telegram",
+            "Telegram",
+            sdk=("telegram",),
+            extra_name="telegram",
+            required_env=("TELEGRAM_BOT_TOKEN",),
+            max_len=4096,
+            hint=(
+                "You are talking through Telegram. Keep replies short enough to read on a phone; "
+                "Markdown is converted for you."
+            ),
+        ),
+        _chat_entry(
+            "discord",
+            "Discord",
+            sdk=("discord",),
+            extra_name="discord",
+            required_env=("DISCORD_BOT_TOKEN",),
+            max_len=2000,
+            hint="You are talking through Discord. Standard Markdown renders natively.",
+        ),
+        _chat_entry(
+            "slack",
+            "Slack",
+            sdk=("slack_bolt", "slack_sdk"),
+            extra_name="slack",
+            required_env=("SLACK_BOT_TOKEN", "SLACK_APP_TOKEN"),
+            max_len=39000,
+            hint="You are talking through Slack. Formatting is converted to Slack's markup.",
+        ),
+        PlatformEntry(
+            name="api_server",
+            label="API server",
+            factory=_lazy_factory("indus.gateway.http.api_server:create_adapter"),
+            check_fn=modules_installed("fastapi", "uvicorn"),
+            install_hint="pip install 'indus-agent[gateway]'",
+            dm_is_private=False,
+            trusted_inbound=True,
+        ),
+        PlatformEntry(
+            name="webhook",
+            label="Webhook receiver",
+            factory=_lazy_factory("indus.gateway.http.webhook:create_adapter"),
+            check_fn=modules_installed("fastapi", "uvicorn"),
+            install_hint="pip install 'indus-agent[gateway]'",
+            dm_is_private=False,
+            trusted_inbound=True,
+        ),
+    )
+
+
+def _probe(entry: PlatformEntry) -> bool:
+    try:
+        return entry.check_fn() is True
+    except Exception as exc:  # a probe must never take the gateway down
+        log.warning("platform %s: dependency check failed: %s", entry.name, exc)
+        return False
+
+
+class PlatformRegistry:
+    """Name → ``PlatformEntry``. Thread-safe; built-ins first, plugin entries on top."""
+
+    def __init__(self, builtins: Iterable[PlatformEntry] | None = None) -> None:
+        self._lock = threading.RLock()
+        self._entries: dict[str, PlatformEntry] = {}
+        self._builtin_names: frozenset[str] = frozenset()
+        start = tuple(builtin_entries() if builtins is None else builtins)
+        for entry in start:
+            self._entries[entry.name] = entry
+        self._builtin_names = frozenset(e.name for e in start if e.source == "builtin")
+
+    # -- lookup ---------------------------------------------------------------------------------
+
+    def get(self, name: str) -> PlatformEntry | None:
+        with self._lock:
+            return self._entries.get(name.strip().lower())
+
+    def names(self) -> list[str]:
+        with self._lock:
+            return list(self._entries)
+
+    def entries(self) -> list[PlatformEntry]:
+        with self._lock:
+            return list(self._entries.values())
+
+    def is_builtin(self, name: str) -> bool:
+        return name.strip().lower() in self._builtin_names
+
+    def missing_deps(self, name: str) -> str | None:
+        """The install hint when the platform's library is missing, else None."""
+        entry = self.get(name)
+        if entry is None:
+            return f"unknown platform {name!r}"
+        if _probe(entry):
+            return None
+        return entry.install_hint or f"the {entry.label} library is not installed"
+
+    # -- changes --------------------------------------------------------------------------------
+
+    def register(self, entry: PlatformEntry, *, replace_existing: bool = False) -> bool:
+        """Add ``entry``; an existing name is replaced only with ``replace_existing``."""
+        name = entry.name.strip().lower()
+        if not name or not name.replace("_", "").isalnum():
+            raise ValueError(f"platform name {entry.name!r} must be letters, digits and _")
+        if entry.trusted_inbound and entry.source == "plugin" and name in self._builtin_names:
+            # People send messages on a shipped chat platform; a plugin replacing its adapter must
+            # not switch off allowlists and pairing for it.
+            log.warning(
+                "plugin %s: platform %s cannot be marked trusted_inbound; flag dropped",
+                entry.plugin_name or "?",
+                name,
+            )
+            entry = replace(entry, trusted_inbound=False)
+        if name != entry.name:
+            entry = replace(entry, name=name)
+        with self._lock:
+            if name in self._entries and not replace_existing:
+                log.warning("platform %s is already registered; refused", name)
+                return False
+            self._entries[name] = entry
+        return True
+
+    def unregister(self, name: str) -> bool:
+        with self._lock:
+            return self._entries.pop(name.strip().lower(), None) is not None
+
+    def load_plugin_entries(self, providers: Mapping[str, Mapping[str, Any]]) -> int:
+        """Register the platform entries plugins offered (the P13 provider slot ``platform``).
+
+        A plugin entry may replace a built-in adapter (user beats bundled, P13-14). Returns how
+        many entries were registered.
+        """
+        slot = providers.get("platform") or {}
+        added = 0
+        for label, offered in slot.items():
+            provider = getattr(offered, "provider", offered)
+            plugin_id = str(getattr(offered, "plugin_id", "") or "")
+            if not isinstance(provider, PlatformEntry):
+                log.warning(
+                    "plugin %s: platform %s is not a PlatformEntry; ignored", plugin_id, label
+                )
+                continue
+            entry = replace(
+                provider, source="plugin", plugin_name=plugin_id or provider.plugin_name
+            )
+            if self.register(entry, replace_existing=True):
+                added += 1
+        return added
+
+    # -- building -------------------------------------------------------------------------------
+
+    def create_adapter(self, name: str, config: Any) -> Any | None:
+        """Build the adapter for an enabled platform: the only place an SDK gets imported.
+
+        Returns None (and logs why) for an unknown platform, a missing library or a factory error.
+        """
+        entry = self.get(name)
+        if entry is None:
+            log.warning("no platform named %s is registered", name)
+            return None
+        if not _probe(entry):
+            log.warning(
+                "platform %s is enabled but its library is missing: %s",
+                entry.name,
+                entry.install_hint or "install its extra",
+            )
+            return None
+        try:
+            return entry.factory(config)
+        except Exception as exc:
+            log.error("platform %s: building the adapter failed: %s", entry.name, exc)
+            return None
+
+
+# -- proxy ----------------------------------------------------------------------------------------
+
+_PROXY_NAMES = {
+    "https": ("HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy"),
+    "http": ("HTTP_PROXY", "http_proxy", "ALL_PROXY", "all_proxy"),
+}
+
+
+def _bypassed(host: str, no_proxy: str) -> bool:
+    host = host.strip().lower().rstrip(".")
+    if not host:
+        return False
+    for raw in no_proxy.split(","):
+        item = raw.strip().lower()
+        if not item:
+            continue
+        if item == "*":
+            return True
+        item = item.split(":", 1)[0].lstrip(".").rstrip(".")
+        if item and (host == item or host.endswith("." + item)):
+            return True
+    return False
+
+
+def proxy_for(
+    *,
+    env: Mapping[str, str],
+    trust_env: bool = True,
+    platform_proxy: str | None = None,
+    target_host: str | None = None,
+    scheme: Literal["https", "http"] = "https",
+) -> str | None:
+    """The proxy URL an adapter should use, or None for a direct connection.
+
+    A per-platform proxy setting always wins. Otherwise the standard env vars apply unless
+    ``trust_env`` is false; ``NO_PROXY`` exempts ``target_host``.
+    """
+    explicit = (platform_proxy or "").strip()
+    if explicit:
+        return explicit
+    if not trust_env:
+        return None
+    no_proxy = env.get("NO_PROXY") or env.get("no_proxy") or ""
+    if target_host and _bypassed(target_host, no_proxy):
+        return None
+    for name in _PROXY_NAMES[scheme]:
+        value = (env.get(name) or "").strip()
+        if value:
+            return value
+    return None
