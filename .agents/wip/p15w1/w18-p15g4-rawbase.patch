diff --git a/tests/fakes/platform/core.py b/tests/fakes/platform/core.py
new file mode 100644
index 0000000..e6609e6
--- /dev/null
+++ b/tests/fakes/platform/core.py
@@ -0,0 +1,652 @@
+"""A scriptable in-memory chat platform for adapter tests (P15-01).
+
+Platform-neutral on purpose: the per-platform wire fakes (``telegram_wire``, ``discord_wire``,
+``slack_wire``) sit on top and speak the vendor library's shapes. Tests:
+
+- inject inbound traffic with the builders (``dm``, ``group``, ``thread``, ``bot_message``,
+  ``edited``, ``voice``, ``photo``, ``document``, ``button_press``); adapters read it with
+  ``await receive_inbound()`` (blocks) or ``next_inbound()`` (None when empty);
+- read back every outbound operation in ``ops`` (with fake-clock times) and the message store;
+- arm failures by class with ``fail(kind, op=..., chat_id=..., times=..., after=...)``; each
+  failure raises a `FakePlatformError` subclass whose class name and text carry the reading the
+  send classifier recognises (P15-04).
+
+The platform enforces its own length cap with its own length function, so an adapter that does
+not split long text gets a "too long" error like on the real service.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import itertools
+from collections import deque
+from collections.abc import Callable
+from dataclasses import dataclass, field, replace
+from datetime import UTC, datetime
+from enum import StrEnum
+from typing import Any, Literal
+
+from tests.fakes.clock import FakeClock
+
+OpKind = Literal[
+    "connect",
+    "disconnect",
+    "send",
+    "edit",
+    "delete",
+    "typing",
+    "typing_stop",
+    "reaction",
+    "media",
+    "answer",
+]
+ChatKind = Literal["dm", "group", "channel", "thread", "forum"]
+
+
+class FailureKind(StrEnum):
+    CONNECT_TIMEOUT = "connect_timeout"
+    READ_TIMEOUT = "read_timeout"
+    RATE_LIMIT = "rate_limit"
+    CHAT_NOT_FOUND = "chat_not_found"
+    THREAD_NOT_FOUND = "thread_not_found"
+    FORBIDDEN = "forbidden"
+    PARSE_ERROR = "parse_error"
+    TOO_LONG = "too_long"
+
+
+class FakePlatformError(Exception):
+    kind: FailureKind
+
+    def __init__(self, text: str, *, retry_after: float | None = None) -> None:
+        super().__init__(text)
+        self.text = text
+        self.retry_after = retry_after
+
+
+class FakeConnectTimeout(FakePlatformError):
+    kind = FailureKind.CONNECT_TIMEOUT
+
+
+class FakeReadTimeout(FakePlatformError):
+    kind = FailureKind.READ_TIMEOUT
+
+
+class FakeRateLimited(FakePlatformError):
+    kind = FailureKind.RATE_LIMIT
+
+
+class FakeChatNotFound(FakePlatformError):
+    kind = FailureKind.CHAT_NOT_FOUND
+
+
+class FakeThreadNotFound(FakePlatformError):
+    kind = FailureKind.THREAD_NOT_FOUND
+
+
+class FakeForbidden(FakePlatformError):
+    kind = FailureKind.FORBIDDEN
+
+
+class FakeParseError(FakePlatformError):
+    kind = FailureKind.PARSE_ERROR
+
+
+class FakeTooLong(FakePlatformError):
+    kind = FailureKind.TOO_LONG
+
+
+class FakeMessageNotFound(FakePlatformError):
+    """An edit or delete of a message that does not exist (a sub-chat reading)."""
+
+    kind = FailureKind.THREAD_NOT_FOUND
+
+
+_ERRORS: dict[FailureKind, tuple[type[FakePlatformError], str]] = {
+    FailureKind.CONNECT_TIMEOUT: (FakeConnectTimeout, "could not connect to the platform"),
+    FailureKind.READ_TIMEOUT: (FakeReadTimeout, "the platform did not answer in time"),
+    FailureKind.RATE_LIMIT: (FakeRateLimited, "Too Many Requests: retry after {wait}"),
+    FailureKind.CHAT_NOT_FOUND: (FakeChatNotFound, "Bad Request: chat not found"),
+    FailureKind.THREAD_NOT_FOUND: (FakeThreadNotFound, "Bad Request: message thread not found"),
+    FailureKind.FORBIDDEN: (FakeForbidden, "Forbidden: bot was blocked by the user"),
+    FailureKind.PARSE_ERROR: (FakeParseError, "Bad Request: can't parse entities"),
+    FailureKind.TOO_LONG: (FakeTooLong, "Bad Request: message is too long"),
+}
+
+
+def make_error(kind: FailureKind, retry_after: float | None = None) -> FakePlatformError:
+    cls, text = _ERRORS[kind]
+    if kind is FailureKind.RATE_LIMIT:
+        wait = 5.0 if retry_after is None else retry_after
+        return cls(text.format(wait=int(wait)), retry_after=wait)
+    return cls(text)
+
+
+@dataclass(frozen=True)
+class Op:
+    kind: OpKind
+    chat_id: str = ""
+    message_id: str | None = None
+    text: str = ""
+    thread_id: str | None = None
+    reply_to: str | None = None
+    at: float = 0.0
+    extra: dict[str, Any] = field(default_factory=dict[str, Any], compare=False)
+
+
+@dataclass(frozen=True)
+class Button:
+    label: str
+    data: str
+
+
+@dataclass(frozen=True)
+class FakeMedia:
+    kind: Literal["voice", "audio", "photo", "video", "document", "sticker"]
+    ref: str
+    mime: str = ""
+    caption: str = ""
+    duration: float | None = None
+
+
+@dataclass
+class FakeMessage:
+    message_id: str
+    chat_id: str
+    text: str
+    thread_id: str | None = None
+    reply_to: str | None = None
+    buttons: tuple[Button, ...] = ()
+    media: tuple[FakeMedia, ...] = ()
+    deleted: bool = False
+    edits: int = 0
+    from_bot: bool = True
+
+
+@dataclass(frozen=True)
+class FakeChat:
+    chat_id: str
+    kind: ChatKind = "dm"
+    name: str = ""
+    scope_id: str | None = None
+    guild_id: str | None = None
+
+
+@dataclass(frozen=True)
+class FakeInbound:
+    """One inbound update, platform-neutral (wire fakes reshape it)."""
+
+    update_id: int
+    event: Literal["message", "edited", "button"]
+    chat_id: str
+    chat_kind: ChatKind
+    user_id: str
+    user_name: str = ""
+    text: str = ""
+    message_id: str = ""
+    thread_id: str | None = None
+    reply_to: str | None = None
+    is_bot: bool = False
+    mentions_bot: bool = False
+    media: tuple[FakeMedia, ...] = ()
+    button_data: str | None = None
+    button_id: str | None = None
+    chat_name: str = ""
+    scope_id: str | None = None
+    guild_id: str | None = None
+    at: datetime = datetime(2026, 1, 1, tzinfo=UTC)
+
+
+@dataclass
+class _Armed:
+    kind: FailureKind
+    op: str
+    chat_id: str | None
+    times: int
+    after: int
+    retry_after: float | None
+
+
+class FakeChatPlatform:
+    def __init__(
+        self,
+        name: str = "fake",
+        *,
+        clock: FakeClock | None = None,
+        max_len: int = 4096,
+        len_fn: Callable[[str], int] = len,
+        bot_user_id: str = "bot",
+        bot_name: str = "IndusBot",
+    ) -> None:
+        self.name = name
+        self.clock = clock or FakeClock(datetime(2026, 1, 1, tzinfo=UTC))
+        self.max_len = max_len
+        self.len_fn = len_fn
+        self.bot_user_id = bot_user_id
+        self.bot_name = bot_name
+        self.connected = False
+        self.ops: list[Op] = []
+        self.chats: dict[str, FakeChat] = {}
+        self._messages: dict[str, FakeMessage] = {}
+        self._ids = itertools.count(1)
+        self._updates = itertools.count(1)
+        self._armed: list[_Armed] = []
+        self._pending: deque[FakeInbound] = deque()
+        self._queue: asyncio.Queue[FakeInbound] | None = None
+        self.answered: list[tuple[str, str | None]] = []
+
+    # -- setup ---------------------------------------------------------------------------------
+
+    def add_chat(
+        self,
+        chat_id: str,
+        kind: ChatKind = "dm",
+        name: str = "",
+        *,
+        scope_id: str | None = None,
+        guild_id: str | None = None,
+    ) -> FakeChat:
+        chat = FakeChat(str(chat_id), kind, name or str(chat_id), scope_id, guild_id)
+        self.chats[chat.chat_id] = chat
+        return chat
+
+    def remove_chat(self, chat_id: str) -> None:
+        """Later operations on this chat fail with "chat not found"."""
+        self.chats.pop(str(chat_id), None)
+        self.fail(FailureKind.CHAT_NOT_FOUND, chat_id=str(chat_id), times=10**9)
+
+    def fail(
+        self,
+        kind: FailureKind,
+        *,
+        op: str = "*",
+        chat_id: str | None = None,
+        times: int = 1,
+        after: int = 0,
+        retry_after: float | None = None,
+    ) -> None:
+        """Arm a failure: the next ``times`` matching ops (after ``after`` matching successes)."""
+        self._armed.append(_Armed(kind, op, chat_id, times, after, retry_after))
+
+    def fail_connect(self, kind: FailureKind = FailureKind.CONNECT_TIMEOUT, times: int = 1) -> None:
+        self.fail(kind, op="connect", times=times)
+
+    def _check(self, op: str, chat_id: str = "") -> None:
+        for armed in self._armed:
+            if armed.times <= 0:
+                continue
+            if armed.op not in ("*", op) or (armed.op == "*" and op in ("connect", "disconnect")):
+                continue
+            if armed.chat_id is not None and armed.chat_id != str(chat_id):
+                continue
+            if armed.after > 0:
+                armed.after -= 1
+                continue
+            armed.times -= 1
+            raise make_error(armed.kind, armed.retry_after)
+
+    def _now(self) -> float:
+        return self.clock.monotonic()
+
+    def _log(self, kind: OpKind, chat_id: str = "", **kw: Any) -> Op:
+        op = Op(kind, str(chat_id), at=self._now(), **kw)
+        self.ops.append(op)
+        return op
+
+    def _fits(self, text: str) -> None:
+        if self.len_fn(text) > self.max_len:
+            raise make_error(FailureKind.TOO_LONG)
+
+    # -- outbound API (what wire fakes and simple adapters call) ---------------------------------
+
+    async def connect(self) -> None:
+        self._check("connect")
+        if not self.connected:
+            self.connected = True
+            self._log("connect")
+
+    async def disconnect(self) -> None:
+        if self.connected:
+            self.connected = False
+            self._log("disconnect")
+
+    async def post(
+        self,
+        chat_id: str,
+        text: str,
+        *,
+        reply_to: str | None = None,
+        thread_id: str | None = None,
+        buttons: tuple[Button, ...] = (),
+        extra: dict[str, Any] | None = None,
+    ) -> FakeMessage:
+        self._check("send", chat_id)
+        self._fits(text)
+        message = FakeMessage(
+            str(next(self._ids)), str(chat_id), text, thread_id, reply_to, tuple(buttons)
+        )
+        self._messages[message.message_id] = message
+        self._log(
+            "send",
+            chat_id,
+            message_id=message.message_id,
+            text=text,
+            thread_id=thread_id,
+            reply_to=reply_to,
+            extra={"buttons": tuple(buttons), **(extra or {})},
+        )
+        return message
+
+    def _existing(self, chat_id: str, message_id: str, what: str) -> FakeMessage:
+        message = self._messages.get(str(message_id))
+        if message is None or message.deleted or message.chat_id != str(chat_id):
+            raise FakeMessageNotFound(f"Bad Request: message to {what} not found")
+        return message
+
+    async def edit(
+        self,
+        chat_id: str,
+        message_id: str,
+        text: str,
+        *,
+        buttons: tuple[Button, ...] | None = None,
+    ) -> FakeMessage:
+        self._check("edit", chat_id)
+        message = self._existing(chat_id, message_id, "edit")
+        self._fits(text)
+        message.text = text
+        message.edits += 1
+        if buttons is not None:
+            message.buttons = tuple(buttons)
+        self._log("edit", chat_id, message_id=message.message_id, text=text)
+        return message
+
+    async def delete(self, chat_id: str, message_id: str) -> bool:
+        self._check("delete", chat_id)
+        message = self._existing(chat_id, message_id, "delete")
+        message.deleted = True
+        self._log("delete", chat_id, message_id=message.message_id)
+        return True
+
+    async def typing(self, chat_id: str, *, thread_id: str | None = None) -> None:
+        self._check("typing", chat_id)
+        self._log("typing", chat_id, thread_id=thread_id)
+
+    async def typing_stop(self, chat_id: str) -> None:
+        self._log("typing_stop", chat_id)
+
+    async def react(self, chat_id: str, message_id: str, emoji: str) -> None:
+        self._check("reaction", chat_id)
+        self._log("reaction", chat_id, message_id=str(message_id), text=emoji)
+
+    async def upload(
+        self,
+        chat_id: str,
+        media: FakeMedia,
+        *,
+        reply_to: str | None = None,
+        thread_id: str | None = None,
+    ) -> FakeMessage:
+        self._check("media", chat_id)
+        if media.caption:
+            self._fits(media.caption)
+        message = FakeMessage(
+            str(next(self._ids)), str(chat_id), media.caption, thread_id, reply_to, media=(media,)
+        )
+        self._messages[message.message_id] = message
+        self._log(
+            "media",
+            chat_id,
+            message_id=message.message_id,
+            text=media.caption,
+            thread_id=thread_id,
+            reply_to=reply_to,
+            extra={"kind": media.kind, "ref": media.ref},
+        )
+        return message
+
+    async def answer(self, button_id: str, text: str | None = None) -> None:
+        self._check("answer")
+        self.answered.append((button_id, text))
+        self._log("answer", text=text or "", extra={"button_id": button_id})
+
+    async def chat(self, chat_id: str) -> FakeChat:
+        self._check("chat_info", chat_id)
+        found = self.chats.get(str(chat_id))
+        if found is None:
+            raise make_error(FailureKind.CHAT_NOT_FOUND)
+        return found
+
+    # -- inbound -------------------------------------------------------------------------------
+
+    def _queue_for_loop(self) -> asyncio.Queue[FakeInbound]:
+        if self._queue is None:
+            self._queue = asyncio.Queue()
+            while self._pending:
+                self._queue.put_nowait(self._pending.popleft())
+        return self._queue
+
+    def _push(self, item: FakeInbound) -> FakeInbound:
+        if self._queue is not None:
+            self._queue.put_nowait(item)
+        else:
+            self._pending.append(item)
+        return item
+
+    async def receive_inbound(self) -> FakeInbound:
+        """The next inbound update; waits until one is injected."""
+        return await self._queue_for_loop().get()
+
+    def next_inbound(self) -> FakeInbound | None:
+        """The next inbound update, or None when nothing is waiting."""
+        if self._queue is not None:
+            return None if self._queue.empty() else self._queue.get_nowait()
+        return self._pending.popleft() if self._pending else None
+
+    def drain_inbound(self) -> list[FakeInbound]:
+        items: list[FakeInbound] = []
+        while (item := self.next_inbound()) is not None:
+            items.append(item)
+        return items
+
+    def _inbound(
+        self,
+        chat_id: str,
+        chat_kind: ChatKind,
+        user_id: str,
+        text: str,
+        *,
+        event: Literal["message", "edited", "button"] = "message",
+        message_id: str | None = None,
+        **kw: Any,
+    ) -> FakeInbound:
+        chat = self.chats.get(str(chat_id))
+        if chat is None:
+            chat = self.add_chat(str(chat_id), "group" if chat_kind == "thread" else chat_kind)
+        mid = message_id if message_id is not None else str(next(self._ids))
+        if event == "message" and mid not in self._messages:
+            self._messages[mid] = FakeMessage(
+                mid, str(chat_id), text, kw.get("thread_id"), kw.get("reply_to"), from_bot=False
+            )
+        item = FakeInbound(
+            update_id=next(self._updates),
+            event=event,
+            chat_id=str(chat_id),
+            chat_kind=chat_kind,
+            user_id=str(user_id),
+            text=text,
+            message_id=mid,
+            chat_name=chat.name,
+            scope_id=chat.scope_id,
+            guild_id=chat.guild_id,
+            at=self.clock.now(),
+            **kw,
+        )
+        return self._push(item)
+
+    def dm(
+        self, user_id: str, text: str, *, user_name: str = "", reply_to: str | None = None
+    ) -> FakeInbound:
+        """A direct message; the DM chat id is the user id."""
+        return self._inbound(user_id, "dm", user_id, text, user_name=user_name, reply_to=reply_to)
+
+    def group(
+        self,
+        chat_id: str,
+        user_id: str,
+        text: str,
+        *,
+        user_name: str = "",
+        mention: bool = False,
+        reply_to: str | None = None,
+    ) -> FakeInbound:
+        return self._inbound(
+            chat_id,
+            "group",
+            user_id,
+            text,
+            user_name=user_name,
+            mentions_bot=mention,
+            reply_to=reply_to,
+        )
+
+    def thread(
+        self,
+        chat_id: str,
+        thread_id: str,
+        user_id: str,
+        text: str,
+        *,
+        user_name: str = "",
+        mention: bool = False,
+    ) -> FakeInbound:
+        return self._inbound(
+            chat_id,
+            "thread",
+            user_id,
+            text,
+            thread_id=str(thread_id),
+            user_name=user_name,
+            mentions_bot=mention,
+        )
+
+    def bot_message(
+        self, chat_id: str, bot_id: str, text: str, *, chat_kind: ChatKind = "group"
+    ) -> FakeInbound:
+        return self._inbound(chat_id, chat_kind, bot_id, text, is_bot=True, user_name=bot_id)
+
+    def edited(self, original: FakeInbound, text: str) -> FakeInbound:
+        """An edit of an earlier inbound message (same message id)."""
+        message = self._messages.get(original.message_id)
+        if message is not None:
+            message.text = text
+        return self._push(
+            replace(original, update_id=next(self._updates), event="edited", text=text)
+        )
+
+    def _media(
+        self, chat_id: str, user_id: str, media: FakeMedia, chat_kind: ChatKind
+    ) -> FakeInbound:
+        return self._inbound(chat_id, chat_kind, user_id, media.caption, media=(media,))
+
+    def voice(
+        self,
+        chat_id: str,
+        user_id: str,
+        ref: str = "voice.ogg",
+        *,
+        duration: float = 3.0,
+        chat_kind: ChatKind = "dm",
+    ) -> FakeInbound:
+        return self._media(
+            chat_id, user_id, FakeMedia("voice", ref, "audio/ogg", duration=duration), chat_kind
+        )
+
+    def photo(
+        self,
+        chat_id: str,
+        user_id: str,
+        ref: str = "photo.jpg",
+        *,
+        caption: str = "",
+        chat_kind: ChatKind = "dm",
+    ) -> FakeInbound:
+        return self._media(
+            chat_id, user_id, FakeMedia("photo", ref, "image/jpeg", caption), chat_kind
+        )
+
+    def document(
+        self,
+        chat_id: str,
+        user_id: str,
+        ref: str = "notes.txt",
+        *,
+        mime: str = "text/plain",
+        caption: str = "",
+        chat_kind: ChatKind = "dm",
+    ) -> FakeInbound:
+        return self._media(chat_id, user_id, FakeMedia("document", ref, mime, caption), chat_kind)
+
+    def button_press(
+        self,
+        chat_id: str,
+        user_id: str,
+        data: str,
+        *,
+        message_id: str | None = None,
+        chat_kind: ChatKind = "dm",
+    ) -> FakeInbound:
+        """A press of an inline button we sent (``message_id``: the message carrying it)."""
+        return self._inbound(
+            chat_id,
+            chat_kind,
+            user_id,
+            "",
+            event="button",
+            message_id=message_id or "",
+            button_data=data,
+            button_id=f"cb{next(self._updates)}",
+        )
+
+    # -- reading -------------------------------------------------------------------------------
+
+    def ops_of(self, *kinds: OpKind) -> list[Op]:
+        return [op for op in self.ops if op.kind in kinds]
+
+    def message(self, message_id: str) -> FakeMessage | None:
+        return self._messages.get(str(message_id))
+
+    def messages(self, chat_id: str | None = None) -> list[FakeMessage]:
+        """Messages we (the bot) sent and did not delete, in send order."""
+        return [
+            m
+            for m in self._messages.values()
+            if m.from_bot and not m.deleted and (chat_id is None or m.chat_id == str(chat_id))
+        ]
+
+    def texts(self, chat_id: str | None = None) -> list[str]:
+        return [m.text for m in self.messages(chat_id)]
+
+
+__all__ = [
+    "Button",
+    "ChatKind",
+    "FailureKind",
+    "FakeChat",
+    "FakeChatNotFound",
+    "FakeChatPlatform",
+    "FakeConnectTimeout",
+    "FakeForbidden",
+    "FakeInbound",
+    "FakeMedia",
+    "FakeMessage",
+    "FakeMessageNotFound",
+    "FakeParseError",
+    "FakePlatformError",
+    "FakeRateLimited",
+    "FakeReadTimeout",
+    "FakeThreadNotFound",
+    "FakeTooLong",
+    "Op",
+    "OpKind",
+    "make_error",
+]
diff --git a/tests/fakes/platform/discord_wire.py b/tests/fakes/platform/discord_wire.py
new file mode 100644
index 0000000..bead745
--- /dev/null
+++ b/tests/fakes/platform/discord_wire.py
@@ -0,0 +1,392 @@
+"""A fake of the Discord library surface our adapter touches (P15-01).
+
+Shapes follow discord.py: a client whose ``get_channel`` returns messageable channels; channels
+``send(content, reference=, view=, allowed_mentions=)`` and yield ``typing()``; messages
+``edit``, ``delete``, ``add_reaction``, ``create_thread``. Errors are raised as stand-ins named
+like the library's (``HTTPException`` with ``status``/``code``/``text``, ``Forbidden``,
+``NotFound``). Inbound traffic arrives through the ``on_message`` / ``on_interaction`` handlers
+the adapter registers, delivered by ``dispatch_pending()``. Cap: 2,000 code points.
+"""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator, Awaitable, Callable
+from contextlib import asynccontextmanager
+from dataclasses import dataclass, field
+from typing import Any
+
+from tests.fakes.platform.core import (
+    Button,
+    FailureKind,
+    FakeChatPlatform,
+    FakeInbound,
+    FakeMedia,
+    FakePlatformError,
+)
+
+MAX_LEN = 2000
+
+SURFACE: dict[str, tuple[str, ...]] = {
+    "discord:Client": ("start", "close", "wait_until_ready", "get_channel", "fetch_channel"),
+    "discord:Intents": ("default", "message_content", "dm_messages", "guild_messages", "members"),
+    "discord.abc:Messageable": ("send", "typing", "fetch_message"),
+    "discord:Message": ("edit", "delete", "add_reaction", "remove_reaction", "create_thread"),
+    "discord:AllowedMentions": ("none",),
+    "discord:HTTPException": (),
+    "discord:Forbidden": (),
+    "discord:NotFound": (),
+    "discord.ui:View": ("add_item",),
+    "discord.ui:Button": (),
+    "discord.app_commands:CommandTree": ("sync", "add_command", "clear_commands"),
+}
+
+
+class DiscordException(Exception):
+    pass
+
+
+class HTTPException(DiscordException):
+    def __init__(self, status: int, code: int, text: str) -> None:
+        super().__init__(f"{status} (error code: {code}): {text}")
+        self.status = status
+        self.code = code
+        self.text = text
+
+
+class Forbidden(HTTPException):
+    pass
+
+
+class NotFound(HTTPException):
+    pass
+
+
+def _translate(exc: FakePlatformError) -> Exception:
+    kind = exc.kind
+    if kind is FailureKind.RATE_LIMIT:
+        return HTTPException(429, 0, "You are being rate limited.")
+    if kind is FailureKind.FORBIDDEN:
+        return Forbidden(403, 50007, "Cannot send messages to this user")
+    if kind is FailureKind.CHAT_NOT_FOUND:
+        return NotFound(404, 10003, "Unknown Channel")
+    if kind is FailureKind.THREAD_NOT_FOUND:
+        return NotFound(404, 10008, "Unknown Message")
+    if kind is FailureKind.TOO_LONG:
+        return HTTPException(400, 50035, "Invalid Form Body: Must be 2000 or fewer in length.")
+    if kind is FailureKind.READ_TIMEOUT:
+        return TimeoutError()
+    if kind is FailureKind.CONNECT_TIMEOUT:
+        return ConnectionRefusedError("Cannot connect to host discord.com:443")
+    return HTTPException(400, 50035, "Invalid Form Body")
+
+
+@dataclass(frozen=True)
+class AllowedMentions:
+    everyone: bool = False
+    users: bool = False
+    roles: bool = False
+
+    @classmethod
+    def none(cls) -> AllowedMentions:
+        return cls()
+
+
+@dataclass(frozen=True)
+class Intents:
+    message_content: bool = False
+    dm_messages: bool = True
+    guild_messages: bool = True
+    members: bool = False
+
+    @classmethod
+    def default(cls) -> Intents:
+        return cls()
+
+
+@dataclass(frozen=True)
+class Author:
+    id: int
+    name: str
+    bot: bool = False
+
+
+@dataclass(frozen=True)
+class Attachment:
+    filename: str
+    url: str
+    content_type: str
+
+
+@dataclass(frozen=True)
+class MessageReference:
+    message_id: int
+
+
+@dataclass
+class View:
+    """``discord.ui.View`` stand-in: buttons with ``custom_id``."""
+
+    items: list[Button] = field(default_factory=list[Button])
+
+    def add_item(self, item: Button) -> None:
+        self.items.append(item)
+
+
+def _wrap[T](coro: Awaitable[T]) -> Awaitable[T]:
+    async def run() -> T:
+        try:
+            return await coro
+        except FakePlatformError as exc:
+            raise _translate(exc) from None
+
+    return run()
+
+
+@dataclass
+class DiscordMessage:
+    id: int
+    channel: Channel
+    content: str
+    author: Author
+    reference: MessageReference | None = None
+    attachments: tuple[Attachment, ...] = ()
+    mentions_bot: bool = False
+    created_at: Any = None
+
+    async def edit(self, content: str | None = None, view: View | None = None) -> DiscordMessage:
+        buttons = tuple(view.items) if view is not None else None
+        text = content if content is not None else self.content
+        await _wrap(
+            self.channel.wire.platform.edit(
+                str(self.channel.id), str(self.id), text, buttons=buttons
+            )
+        )
+        self.content = text
+        return self
+
+    async def delete(self) -> None:
+        await _wrap(self.channel.wire.platform.delete(str(self.channel.id), str(self.id)))
+
+    async def add_reaction(self, emoji: str) -> None:
+        await _wrap(self.channel.wire.platform.react(str(self.channel.id), str(self.id), emoji))
+
+    async def remove_reaction(self, emoji: str, member: Any = None) -> None:
+        self.channel.wire.removed_reactions.append((self.id, emoji))
+
+    async def create_thread(self, name: str, auto_archive_duration: int = 1440) -> Channel:
+        thread_id = self.id  # Discord: a thread started from a message reuses its id
+        self.channel.wire.threads.append((thread_id, name, auto_archive_duration))
+        return self.channel.wire.channel(thread_id, kind="thread", parent=self.channel.id)
+
+
+@dataclass
+class Channel:
+    id: int
+    wire: DiscordWire
+    kind: str = "text"  # text, dm, thread
+    parent_id: int | None = None
+    guild_id: int | None = None
+
+    async def send(
+        self,
+        content: str | None = None,
+        *,
+        reference: MessageReference | DiscordMessage | None = None,
+        view: View | None = None,
+        allowed_mentions: AllowedMentions | None = None,
+        file: Any = None,
+    ) -> DiscordMessage:
+        self.wire.sent_allowed_mentions.append(allowed_mentions)
+        reply_to = (
+            str(reference.message_id if isinstance(reference, MessageReference) else reference.id)
+            if reference
+            else None
+        )
+        if file is not None:
+            media = FakeMedia("document", str(file), caption=content or "")
+            sent = await _wrap(self.wire.platform.upload(str(self.id), media, reply_to=reply_to))
+        else:
+            buttons = tuple(view.items) if view is not None else ()
+            sent = await _wrap(
+                self.wire.platform.post(
+                    str(self.id), content or "", reply_to=reply_to, buttons=buttons
+                )
+            )
+        bot = Author(int(self.wire.platform.bot_user_id), self.wire.platform.bot_name, True)
+        return DiscordMessage(int(sent.message_id), self, sent.text, bot)
+
+    @asynccontextmanager
+    async def typing(self) -> AsyncIterator[None]:
+        await _wrap(self.wire.platform.typing(str(self.id)))
+        yield
+
+    async def fetch_message(self, message_id: int) -> DiscordMessage:
+        found = self.wire.platform.message(str(message_id))
+        if found is None or found.deleted:
+            raise NotFound(404, 10008, "Unknown Message")
+        author = Author(int(self.wire.platform.bot_user_id), "bot", found.from_bot)
+        return DiscordMessage(message_id, self, found.text, author)
+
+
+@dataclass
+class Interaction:
+    """A component press: ``custom_id`` in ``data``."""
+
+    id: str
+    user: Author
+    channel: Channel
+    data: dict[str, Any]
+    message: DiscordMessage | None = None
+
+
+class CommandTree:
+    """``discord.app_commands.CommandTree`` stand-in: records registrations and syncs."""
+
+    def __init__(self, client: FakeClient) -> None:
+        self.client = client
+        self.commands: list[Any] = []
+        self.synced: list[list[str]] = []
+
+    def add_command(self, command: Any) -> None:
+        self.commands.append(command)
+
+    def clear_commands(self, *, guild: Any = None) -> None:
+        self.commands.clear()
+
+    async def sync(self, *, guild: Any = None) -> list[Any]:
+        names = [str(getattr(c, "name", c)) for c in self.commands]
+        self.synced.append(names)
+        return list(self.commands)
+
+
+class FakeClient:
+    """``discord.Client`` stand-in: ``start`` connects, handlers receive inbound traffic."""
+
+    def __init__(self, wire: DiscordWire, intents: Intents | None = None) -> None:
+        self.wire = wire
+        self.intents = intents or Intents.default()
+        self.handlers: dict[str, Callable[..., Awaitable[None]]] = {}
+        self.user = Author(int(wire.platform.bot_user_id), wire.platform.bot_name, True)
+        self.tree = CommandTree(self)
+
+    def event(self, fn: Callable[..., Awaitable[None]]) -> Callable[..., Awaitable[None]]:
+        self.handlers[fn.__name__] = fn
+        return fn
+
+    async def start(self, token: str) -> None:
+        await _wrap(self.wire.platform.connect())
+
+    async def wait_until_ready(self) -> None:
+        return None
+
+    async def close(self) -> None:
+        await self.wire.platform.disconnect()
+
+    def get_channel(self, channel_id: int) -> Channel | None:
+        return self.wire.channel(channel_id)
+
+    async def fetch_channel(self, channel_id: int) -> Channel:
+        return self.wire.channel(channel_id)
+
+
+class DiscordWire:
+    SURFACE = SURFACE
+    # Which fake stands in for each surface object (the wire self-check reads it).
+    FAKES: dict[str, type] = {}
+
+    def __init__(self, platform: FakeChatPlatform | None = None) -> None:
+        self.platform = platform or FakeChatPlatform("discord", max_len=MAX_LEN, bot_user_id="900")
+        self._channels: dict[int, Channel] = {}
+        self.threads: list[tuple[int, str, int]] = []
+        self.removed_reactions: list[tuple[int, str]] = []
+        self.sent_allowed_mentions: list[AllowedMentions | None] = []
+        self.client = FakeClient(self)
+
+    def channel(self, channel_id: int, *, kind: str = "text", parent: int | None = None) -> Channel:
+        found = self._channels.get(int(channel_id))
+        if found is None:
+            found = Channel(int(channel_id), self, kind, parent)
+            self._channels[found.id] = found
+        return found
+
+    def _message(self, item: FakeInbound) -> DiscordMessage:
+        kind = {"dm": "dm", "thread": "thread"}.get(item.chat_kind, "text")
+        channel = self.channel(int(item.thread_id or item.chat_id), kind=kind)
+        if item.chat_kind == "thread":
+            channel.parent_id = int(item.chat_id)
+        if item.guild_id is not None:
+            channel.guild_id = int(item.guild_id)
+        author = Author(int(item.user_id), item.user_name or item.user_id, item.is_bot)
+        attachments = tuple(
+            Attachment(m.ref, f"https://cdn.example/{m.ref}", m.mime) for m in item.media
+        )
+        reference = MessageReference(int(item.reply_to)) if item.reply_to else None
+        return DiscordMessage(
+            int(item.message_id or 0),
+            channel,
+            item.text,
+            author,
+            reference,
+            attachments,
+            item.mentions_bot,
+            item.at,
+        )
+
+    async def dispatch_pending(self) -> int:
+        """Deliver every queued inbound update to the registered handlers."""
+        delivered = 0
+        for item in self.platform.drain_inbound():
+            message = self._message(item)
+            if item.event == "button":
+                handler = self.client.handlers.get("on_interaction")
+                interaction = Interaction(
+                    str(item.button_id),
+                    message.author,
+                    message.channel,
+                    {"custom_id": item.button_data},
+                    None,
+                )
+                if handler is not None:
+                    await handler(interaction)
+            else:
+                name = "on_message_edit" if item.event == "edited" else "on_message"
+                handler = self.client.handlers.get(name)
+                if handler is not None:
+                    if name == "on_message_edit":
+                        await handler(message, message)
+                    else:
+                        await handler(message)
+            delivered += 1
+        return delivered
+
+
+DiscordWire.FAKES = {
+    "discord:Client": FakeClient,
+    "discord:Intents": Intents,
+    "discord.abc:Messageable": Channel,
+    "discord:Message": DiscordMessage,
+    "discord:AllowedMentions": AllowedMentions,
+    "discord:HTTPException": HTTPException,
+    "discord:Forbidden": Forbidden,
+    "discord:NotFound": NotFound,
+    "discord.ui:View": View,
+    "discord.ui:Button": Button,
+    "discord.app_commands:CommandTree": CommandTree,
+}
+
+__all__ = [
+    "SURFACE",
+    "CommandTree",
+    "AllowedMentions",
+    "Author",
+    "Channel",
+    "DiscordMessage",
+    "DiscordWire",
+    "FakeClient",
+    "Forbidden",
+    "HTTPException",
+    "Intents",
+    "Interaction",
+    "NotFound",
+    "View",
+]
