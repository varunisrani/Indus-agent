index 0000000..5dcc880
--- /dev/null
+++ b/apps/desktop/src/theme/vscodeImport.test.ts
@@ -0,0 +1,150 @@
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { deflateRawSync } from "node:zlib";
+import { contrastRatio, semanticNames } from "@indus/ui";
+import { describe, expect, it } from "vitest";
+import {
+  convertVscodeTheme,
+  failingPairs,
+  mix,
+  parseColour,
+  parseJsonc,
+  readVsix,
+  themesFromVsix,
+  type VscodeTheme,
+} from "./vscodeImport.ts";
+
+const FIXTURE = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../../../../tests/fixtures/desktop/vscode_theme.json",
+);
+const raw = () => JSON.parse(fs.readFileSync(FIXTURE, "utf8")) as VscodeTheme;
+
+describe("VS Code theme conversion", () => {
+  it("converts the fixture deterministically", () => {
+    const a = convertVscodeTheme(raw());
+    const b = convertVscodeTheme(raw());
+    expect(b).toEqual(a);
+    expect(a.id).toBe("vscode-riverbank-night");
+    expect(a.label).toBe("Riverbank Night");
+    expect(a.mode).toBe("dark");
+    const hex = Object.fromEntries(semanticNames.map((n) => [n, a.theme[n].hex]));
+    expect(hex).toMatchObject({
+      bg: "#16202a",
+      "bg-raised": "#1b2733",
+      fg: "#c9d4dc",
+      "accent-fg": "#ffffff",
+      danger: "#e0786a",
+      warning: "#d6b25e",
+      success: "#6cbf8a",
+      "focus-ring": "#5aa9d6",
+      selection: "#3b8ec255",
+    });
+    // the code background is translucent in the file: composited over the editor background
+    expect(hex["code-bg"]).toBe(mix("#16202a", "#1f2c38", 0x80 / 255));
+    expect(a.derived).toEqual([]);
+    expect(a.terminal?.brightWhite).toBe("#eef3f6");
+    expect(Object.keys(a.terminal ?? {})).toHaveLength(16);
+  });
+
+  it("every converted theme passes the contrast pairs", () => {
+    expect(failingPairs(convertVscodeTheme(raw()).theme)).toEqual([]);
+    const harsh: VscodeTheme = {
+      name: "Low Contrast",
+      type: "light",
+      colors: {
+        "editor.background": "#ffffff",
+        "editor.foreground": "#dddddd",
+        "button.background": "#ffee99",
+        descriptionForeground: "#eeeeee",
+      },
+    };
+    const converted = convertVscodeTheme(harsh);
+    expect(failingPairs(converted.theme)).toEqual([]);
+    expect(contrastRatio(converted.theme.fg.hex, "#ffffff")).toBeGreaterThanOrEqual(4.5);
+  });
+
+  it("derives what is missing and guesses the mode from the background", () => {
+    const bare = convertVscodeTheme({ colors: { "editor.background": "#f4f1ea" } }, "Paper");
+    expect(bare.mode).toBe("light");
+    expect(bare.label).toBe("Paper");
+    expect(bare.derived).toContain("accent");
+    expect(bare.terminal).toBeNull();
+    expect(convertVscodeTheme({}).mode).toBe("dark");
+  });
+
+  it("reads JSONC with comments and trailing commas, and short colours", () => {
+    const text = `{
+      // a line comment
+      "name": "With // slashes in a string",
+      /* a block comment */
+      "colors": { "editor.background": "#123", },
+    }`;
+    const parsed = parseJsonc(text) as VscodeTheme;
+    expect(parsed.name).toBe("With // slashes in a string");
+    expect(convertVscodeTheme(parsed).theme.bg.hex).toBe("#112233");
+    expect(parseColour("#abcd")).toEqual({ hex: "#aabbcc", alpha: 0xdd / 255 });
+    expect(parseColour("red")).toBeNull();
+  });
+});
+
+// -- a VSIX built here --------------------------------------------------------------------------------
+
+function zip(files: Record<string, string>): Uint8Array {
+  const chunks: Buffer[] = [];
+  const central: Buffer[] = [];
+  let offset = 0;
+  for (const [name, text] of Object.entries(files)) {
+    const data = deflateRawSync(Buffer.from(text));
+    const nameBytes = Buffer.from(name);
+    const local = Buffer.alloc(30);
+    local.writeUInt32LE(0x04034b50, 0);
+    local.writeUInt16LE(8, 8);
+    local.writeUInt32LE(data.length, 18);
+    local.writeUInt32LE(Buffer.byteLength(text), 22);
+    local.writeUInt16LE(nameBytes.length, 26);
+    chunks.push(local, nameBytes, data);
+    const entry = Buffer.alloc(46);
+    entry.writeUInt32LE(0x02014b50, 0);
+    entry.writeUInt16LE(8, 10);
+    entry.writeUInt32LE(data.length, 20);
+    entry.writeUInt32LE(Buffer.byteLength(text), 24);
+    entry.writeUInt16LE(nameBytes.length, 28);
+    entry.writeUInt32LE(offset, 42);
+    central.push(entry, nameBytes);
+    offset += local.length + nameBytes.length + data.length;
+  }
+  const directory = Buffer.concat(central);
+  const end = Buffer.alloc(22);
+  end.writeUInt32LE(0x06054b50, 0);
+  end.writeUInt16LE(Object.keys(files).length, 8);
+  end.writeUInt16LE(Object.keys(files).length, 10);
+  end.writeUInt32LE(directory.length, 12);
+  end.writeUInt32LE(offset, 16);
+  return new Uint8Array(Buffer.concat([...chunks, directory, end]));
+}
+
+describe("extension packages", () => {
+  it("reads the theme the manifest lists and converts it", async () => {
+    const bytes = zip({
+      "extension/package.json": JSON.stringify({
+        contributes: {
+          themes: [{ label: "Riverbank", uiTheme: "vs-dark", path: "./themes/river.json" }],
+        },
+      }),
+      "extension/themes/river.json": fs.readFileSync(FIXTURE, "utf8"),
+    });
+    expect(readVsix(bytes).names()).toContain("extension/themes/river.json");
+    const themes = await themesFromVsix(bytes);
+    expect(themes).toHaveLength(1);
+    expect(themes[0]?.label).toBe("Riverbank");
+    expect(themes[0]?.theme.bg.hex).toBe("#16202a");
+  });
+
+  it("refuses what is not a theme package", async () => {
+    expect(() => readVsix(new Uint8Array([1, 2, 3]))).toThrow(/not a zip/);
+    const noThemes = zip({ "extension/package.json": "{}" });
+    await expect(themesFromVsix(noThemes)).rejects.toThrow(/no colour theme/);
+  });
+});
diff --git a/apps/desktop/src/theme/vscodeImport.ts b/apps/desktop/src/theme/vscodeImport.ts
new file mode 100644
index 0000000..dd26b05
--- /dev/null
+++ b/apps/desktop/src/theme/vscodeImport.ts
@@ -0,0 +1,440 @@
+// VS Code colour themes into our tokens (P24-33).
+//
+// `convertVscodeTheme` maps a VS Code theme's `colors` to the thirteen semantic tokens of
+// `@indus/ui`, deterministically: each token reads a short list of VS Code keys in order and falls
+// back to a value derived from the background and foreground; translucent colours are composited
+// over what they sit on; every text pair is then nudged (towards black or white, in fixed steps)
+// until it reaches WCAG AA, so an imported theme is as readable as a preset. A full set of
+// `terminal.ansi*` colours is carried for the terminal.
+//
+// The Marketplace flow: search (main does the network, `themes:search`), download the extension
+// package (`themes:download`), read its `package.json` and the theme file it lists (`readVsix`: a
+// zip reader over `DecompressionStream`), convert, install as a user theme.
+
+import {
+  CONTRAST_PAIRS,
+  contrastRatio,
+  type SemanticColour,
+  type SemanticName,
+  type SemanticTheme,
+  semanticNames,
+} from "@indus/ui";
+
+export type ThemeMode = "light" | "dark";
+
+export interface VscodeTheme {
+  name?: string;
+  type?: string;
+  colors?: Record<string, unknown>;
+}
+
+export const ANSI_KEYS = [
+  "black",
+  "red",
+  "green",
+  "yellow",
+  "blue",
+  "magenta",
+  "cyan",
+  "white",
+  "brightBlack",
+  "brightRed",
+  "brightGreen",
+  "brightYellow",
+  "brightBlue",
+  "brightMagenta",
+  "brightCyan",
+  "brightWhite",
+] as const;
+export type AnsiKey = (typeof ANSI_KEYS)[number];
+
+export interface ConvertedTheme {
+  readonly id: string;
+  readonly label: string;
+  readonly mode: ThemeMode;
+  readonly theme: SemanticTheme;
+  readonly terminal: Readonly<Record<AnsiKey, string>> | null;
+  /** Tokens that had no VS Code key and were derived. */
+  readonly derived: readonly SemanticName[];
+}
+
+// -- JSONC ----------------------------------------------------------------------------------------
+
+/** JSON with comments and trailing commas (what VS Code theme files are). */
+export function parseJsonc(text: string): unknown {
+  let out = "";
+  let i = 0;
+  let inString = false;
+  while (i < text.length) {
+    const ch = text[i] as string;
+    const next = text[i + 1];
+    if (inString) {
+      out += ch;
+      if (ch === "\\") {
+        out += next ?? "";
+        i += 2;
+        continue;
+      }
+      if (ch === '"') inString = false;
+      i += 1;
+      continue;
+    }
+    if (ch === '"') {
+      inString = true;
+      out += ch;
+      i += 1;
+    } else if (ch === "/" && next === "/") {
+      while (i < text.length && text[i] !== "\n") i += 1;
+    } else if (ch === "/" && next === "*") {
+      const end = text.indexOf("*/", i + 2);
+      i = end < 0 ? text.length : end + 2;
+    } else {
+      out += ch;
+      i += 1;
+    }
+  }
+  return JSON.parse(out.replace(/,(\s*[}\]])/g, "$1"));
+}
+
+// -- colours --------------------------------------------------------------------------------------
+
+type Rgb = readonly [number, number, number];
+
+function toRgb(hex: string): Rgb {
+  const n = Number.parseInt(hex.slice(1, 7), 16);
+  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+}
+
+function toHex([r, g, b]: Rgb): string {
+  const part = (v: number) =>
+    Math.round(Math.min(255, Math.max(0, v)))
+      .toString(16)
+      .padStart(2, "0");
+  return `#${part(r)}${part(g)}${part(b)}`;
+}
+
+/** `#rgb`, `#rgba`, `#rrggbb`, `#rrggbbaa` → `{hex, alpha}`; anything else → null. */
+export function parseColour(value: unknown): { hex: string; alpha: number } | null {
+  if (typeof value !== "string") return null;
+  const text = value.trim().toLowerCase();
+  if (!/^#([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/.test(text)) return null;
+  let body = text.slice(1);
+  if (body.length <= 4) body = [...body].map((c) => c + c).join("");
+  const alpha = body.length === 8 ? Number.parseInt(body.slice(6, 8), 16) / 255 : 1;
+  return { hex: `#${body.slice(0, 6)}`, alpha };
+}
+
+export function mix(a: string, b: string, share: number): string {
+  const x = toRgb(a);
+  const y = toRgb(b);
+  return toHex(
+    [0, 1, 2].map(
+      (i) => (x[i] as number) * (1 - share) + (y[i] as number) * share,
+    ) as unknown as Rgb,
+  );
+}
+
+function opaque(value: unknown, backdrop: string): string | null {
+  const parsed = parseColour(value);
+  if (parsed === null) return null;
+  return parsed.alpha >= 1 ? parsed.hex : mix(backdrop, parsed.hex, parsed.alpha);
+}
+
+/** `colour` moved towards `target` in 2 % steps until it reaches `minimum` against `against`. */
+export function nudge(
+  colour: string,
+  against: readonly string[],
+  minimum: number,
+  target: string,
+): string {
+  let current = colour;
+  for (let step = 0; step <= 50; step++) {
+    if (against.every((other) => contrastRatio(current, other) >= minimum)) return current;
+    current = mix(colour, target, Math.min(1, (step + 1) * 0.02));
+  }
+  return current;
+}
+
+// -- conversion -----------------------------------------------------------------------------------
+
+const DEFAULTS: Record<ThemeMode, { bg: string; fg: string; accent: string }> = {
+  dark: { bg: "#1f2024", fg: "#e6e4df", accent: "#4f9cd8" },
+  light: { bg: "#fbfaf7", fg: "#24221f", accent: "#2a6fb0" },
+};
+
+/** VS Code keys read for each token, first found wins. */
+export const TOKEN_KEYS: Readonly<Record<Exclude<SemanticName, "accent-fg">, readonly string[]>> = {
+  bg: ["editor.background", "editorPane.background", "editorGroup.background"],
+  "bg-raised": [
+    "sideBar.background",
+    "editorWidget.background",
+    "panel.background",
+    "activityBar.background",
+  ],
+  fg: ["editor.foreground", "foreground"],
+  "fg-muted": ["descriptionForeground", "editorLineNumber.foreground", "tab.inactiveForeground"],
+  border: [
+    "panel.border",
+    "editorGroup.border",
+    "sideBar.border",
+    "contrastBorder",
+    "widget.border",
+    "input.border",
+  ],
+  accent: [
+    "button.background",
+    "textLink.foreground",
+    "activityBarBadge.background",
+    "focusBorder",
+  ],
+  success: ["gitDecoration.addedResourceForeground", "terminal.ansiGreen"],
+  warning: ["editorWarning.foreground", "list.warningForeground", "terminal.ansiYellow"],
+  danger: ["editorError.foreground", "errorForeground", "terminal.ansiRed"],
+  "focus-ring": ["focusBorder", "button.background"],
+  "code-bg": [
+    "textCodeBlock.background",
+    "editor.lineHighlightBackground",
+    "editorWidget.background",
+  ],
+  selection: ["editor.selectionBackground", "selection.background"],
+};
+
+export function slugOf(name: string): string {
+  const slug = name
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48);
+  return slug === "" ? "imported" : slug;
+}
+
+function modeOf(raw: VscodeTheme, bg: string | null): ThemeMode {
+  const type = (raw.type ?? "").toLowerCase();
+  if (type === "dark" || type === "hc" || type === "hc-black") return "dark";
+  if (type === "light" || type === "hclight" || type === "hc-light") return "light";
+  if (bg === null) return "dark";
+  const [r, g, b] = toRgb(bg);
+  return 0.299 * r + 0.587 * g + 0.114 * b < 128 ? "dark" : "light";
+}
+
+export function convertVscodeTheme(
+  raw: VscodeTheme,
+  fallbackName = "Imported theme",
+): ConvertedTheme {
+  const colors = raw.colors ?? {};
+  const derived: SemanticName[] = [];
+  const read = (name: keyof typeof TOKEN_KEYS, backdrop: string): string | null => {
+    for (const key of TOKEN_KEYS[name]) {
+      const value = opaque(colors[key], backdrop);
+      if (value !== null) return value;
+    }
+    return null;
+  };
+  const rawBg = parseColour(colors["editor.background"])?.hex ?? null;
+  const mode = modeOf(raw, rawBg);
+  const base = DEFAULTS[mode];
+  const dark = mode === "dark";
+  const away = dark ? "#ffffff" : "#000000";
+  const or = (name: SemanticName, value: string | null, fallback: () => string): string => {
+    if (value !== null) return value;
+    derived.push(name);
+    return fallback();
+  };
+
+  const bg = or("bg", read("bg", base.bg), () => base.bg);
+  let fg = or("fg", read("fg", bg), () => base.fg);
+  const raised = or("bg-raised", read("bg-raised", bg), () => mix(bg, away, 0.05));
+  const code = or("code-bg", read("code-bg", bg), () => mix(bg, away, 0.07));
+  fg = nudge(fg, [bg, raised, code], 4.5, away);
+  const muted = nudge(
+    or("fg-muted", read("fg-muted", bg), () => mix(fg, bg, 0.35)),
+    [bg, raised],
+    4.5,
+    away,
+  );
+  const border = nudge(
+    or("border", read("border", bg), () => mix(fg, bg, 0.6)),
+    [bg],
+    3,
+    away,
+  );
+  const accentRaw = or("accent", read("accent", bg), () => base.accent);
+  // the accent carries text: the theme's button text when it has one (the accent then moves until
+  // the pair reads), else white or the background, whichever reads better on it
+  const given = opaque(colors["button.foreground"], accentRaw);
+  const accentFg =
+    given ?? (contrastRatio("#ffffff", accentRaw) >= contrastRatio(bg, accentRaw) ? "#ffffff" : bg);
+  const lightText = contrastRatio(accentFg, "#000000") > contrastRatio(accentFg, "#ffffff");
+  const accent = nudge(accentRaw, [accentFg], 4.5, lightText ? "#000000" : "#ffffff");
+  const status = (name: "success" | "warning" | "danger", fallback: string) =>
+    nudge(
+      or(name, read(name, bg), () => fallback),
+      [bg],
+      3,
+      away,
+    );
+  const success = status("success", dark ? "#5fbf7f" : "#2f7d4a");
+  const warning = status("warning", dark ? "#d9a84a" : "#8a5a00");
+  const danger = status("danger", dark ? "#e0705f" : "#b23a2a");
+  const focus = nudge(
+    or("focus-ring", read("focus-ring", bg), () => accent),
+    [bg],
+    3,
+    away,
+  );
+  const selectionRaw = parseColour(
+    colors["editor.selectionBackground"] ?? colors["selection.background"],
+  );
+  let selection: string;
+  if (selectionRaw !== null) {
+    const alpha = Math.round(Math.min(1, Math.max(0.2, selectionRaw.alpha)) * 255);
+    selection = `${selectionRaw.hex}${alpha.toString(16).padStart(2, "0")}`;
+  } else {
+    derived.push("selection");
+    selection = `${accent}66`;
+  }
+
+  const values: Record<SemanticName, string> = {
+    bg,
+    "bg-raised": raised,
+    fg,
+    "fg-muted": muted,
+    border,
+    accent,
+    "accent-fg": accentFg,
+    success,
+    warning,
+    danger,
+    "focus-ring": focus,
+    "code-bg": code,
+    selection,
+  };
+  const label = (raw.name ?? "").trim() || fallbackName;
+  const theme = Object.fromEntries(
+    semanticNames.map((name): [SemanticName, SemanticColour] => [
+      name,
+      { css: values[name], hex: values[name], source: `vscode.${slugOf(label)}` },
+    ]),
+  ) as SemanticTheme;
+
+  let terminal: Record<AnsiKey, string> | null = {} as Record<AnsiKey, string>;
+  for (const key of ANSI_KEYS) {
+    const vsKey = `terminal.ansi${key[0]?.toUpperCase()}${key.slice(1)}`;
+    const value = opaque(colors[vsKey], bg);
+    if (value === null) {
+      terminal = null;
+      break;
+    }
+    terminal[key] = value;
+  }
+
+  return { id: `vscode-${slugOf(label)}`, label, mode, theme, terminal, derived };
+}
+
+/** The pairs an imported theme still misses (always empty after conversion; kept for checks). */
+export function failingPairs(theme: SemanticTheme): string[] {
+  return CONTRAST_PAIRS.filter(
+    ([fg, bg, min]) => contrastRatio(theme[fg].hex, theme[bg].hex) < min,
+  ).map(([fg, bg]) => `${fg}/${bg}`);
+}
+
+// -- the extension package ------------------------------------------------------------------------
+
+export const MAX_ENTRY_BYTES = 2 * 1024 * 1024;
+
+export interface VsixFile {
+  /** Entry names in the archive. */
+  names(): string[];
+  /** One entry as text (inflated when compressed). */
+  text(name: string): Promise<string>;
+}
+
+async function inflate(data: Uint8Array): Promise<Uint8Array> {
+  const stream = new Blob([data as BlobPart])
+    .stream()
+    .pipeThrough(new DecompressionStream("deflate-raw"));
+  const out = new Uint8Array(await new Response(stream).arrayBuffer());
+  if (out.byteLength > MAX_ENTRY_BYTES) throw new Error("a file in the package is too large");
+  return out;
+}
+
+/** A zip archive (a `.vsix`) read from its central directory. */
+export function readVsix(bytes: Uint8Array): VsixFile {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  let end = -1;
+  for (let i = bytes.byteLength - 22; i >= Math.max(0, bytes.byteLength - 65_557); i--) {
+    if (view.getUint32(i, true) === 0x06054b50) {
+      end = i;
+      break;
+    }
+  }
+  if (end < 0) throw new Error("not a zip archive");
+  const count = view.getUint16(end + 10, true);
+  let offset = view.getUint32(end + 16, true);
+  const entries = new Map<string, { method: number; size: number; local: number }>();
+  const decoder = new TextDecoder();
+  for (let n = 0; n < count; n++) {
+    if (view.getUint32(offset, true) !== 0x02014b50) throw new Error("a broken zip directory");
+    const method = view.getUint16(offset + 10, true);
+    const size = view.getUint32(offset + 20, true);
+    const nameLength = view.getUint16(offset + 28, true);
+    const extra = view.getUint16(offset + 30, true);
+    const comment = view.getUint16(offset + 32, true);
+    const local = view.getUint32(offset + 42, true);
+    const name = decoder.decode(bytes.subarray(offset + 46, offset + 46 + nameLength));
+    entries.set(name, { method, size, local });
+    offset += 46 + nameLength + extra + comment;
+  }
+  return {
+    names: () => [...entries.keys()],
+    text: async (name) => {
+      const entry = entries.get(name);
+      if (entry === undefined) throw new Error(`the package has no ${name}`);
+      if (entry.size > MAX_ENTRY_BYTES) throw new Error("a file in the package is too large");
+      const at = entry.local;
+      if (view.getUint32(at, true) !== 0x04034b50) throw new Error("a broken zip entry");
+      const start = at + 30 + view.getUint16(at + 26, true) + view.getUint16(at + 28, true);
+      const raw = bytes.subarray(start, start + entry.size);
+      if (entry.method === 0) return decoder.decode(raw);
+      if (entry.method === 8) return decoder.decode(await inflate(raw));
+      throw new Error("an unsupported zip compression");
+    },
+  };
+}
+
+function joinPath(base: string, relative: string): string {
+  const parts = base.split("/").slice(0, -1);
+  for (const piece of relative.split("/")) {
+    if (piece === "" || piece === ".") continue;
+    if (piece === "..") parts.pop();
+    else parts.push(piece);
+  }
+  return parts.join("/");
+}
+
+/** The colour themes an extension package contributes, converted (the first one when `pick` is absent). */
+export async function themesFromVsix(bytes: Uint8Array): Promise<ConvertedTheme[]> {
+  const vsix = readVsix(bytes);
+  const manifestName = "extension/package.json";
+  const manifest = parseJsonc(await vsix.text(manifestName)) as {
+    contributes?: { themes?: { label?: string; path?: string; uiTheme?: string }[] };
+  };
+  const listed = manifest.contributes?.themes ?? [];
+  const out: ConvertedTheme[] = [];
+  for (const entry of listed) {
+    if (typeof entry.path !== "string") continue;
+    const file = joinPath(manifestName, entry.path);
+    const raw = parseJsonc(await vsix.text(file)) as VscodeTheme;
+    const type = entry.uiTheme === "vs" || entry.uiTheme === "hc-light" ? "light" : "dark";
+    out.push(convertVscodeTheme({ type, ...raw, name: entry.label ?? raw.name ?? "" }));
+  }
+  if (out.length === 0) throw new Error("this extension contributes no colour theme");
+  return out;
+}
+
+export function base64Bytes(text: string): Uint8Array {
+  const binary = atob(text);
+  const out = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i);
+  return out;
+}
diff --git a/apps/desktop/src/wake/WakeIndicator.test.tsx b/apps/desktop/src/wake/WakeIndicator.test.tsx
new file mode 100644
index 0000000..2c27b23
--- /dev/null
+++ b/apps/desktop/src/wake/WakeIndicator.test.tsx
@@ -0,0 +1,182 @@
+// @vitest-environment jsdom
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import type { IndusWakeIndicatorState } from "../global.d.ts";
+import { I18nProvider } from "../i18n/index.tsx";
+import type { LooseRpc } from "../pet/PetOverlay.tsx";
+import {
+  WAKE_START_TIMEOUT_MS,
+  WakeController,
+  WakeIndicator,
+  WakeToggle,
+} from "./WakeIndicator.tsx";
+
+type Answer = unknown | (() => Promise<unknown>);
+
+function rpc(answers: Record<string, Answer>) {
+  const calls: Array<{ method: string; params: object; options?: { timeoutMs?: number } }> = [];
+  let listener: ((event: { type?: string }) => void) | null = null;
+  const fake: LooseRpc & { emit(type: string): void } = {
+    request: (method, params, options) => {
+      calls.push({ method, params, ...(options === undefined ? {} : { options }) });
+      const answer = answers[method];
+      if (typeof answer === "function") return (answer as () => Promise<unknown>)();
+      return Promise.resolve(answer ?? {});
+    },
+    onEvent: (fn) => {
+      listener = fn;
+      return () => {
+        listener = null;
+      };
+    },
+    emit: (type) => listener?.({ type }),
+  };
+  return { fake, calls };
+}
+
+function controller(answers: Record<string, Answer>) {
+  const timers = new FakeTimers();
+  const lights: IndusWakeIndicatorState[] = [];
+  const handOff = vi.fn();
+  const { fake, calls } = rpc(answers);
+  const wake = new WakeController({
+    rpc: fake,
+    handOff,
+    setIndicator: (state) => lights.push(state),
+    timers,
+  });
+  return { wake, timers, lights, handOff, calls, fake };
+}
+
+const flush = async () => {
+  for (let i = 0; i < 5; i++) await Promise.resolve();
+};
+
+afterEach(() => {
+  delete (globalThis as { indusDesktop?: unknown }).indusDesktop;
+});
+
+describe("WakeController", () => {
+  it("waits 180 s for the first start, then gives up and turns the light off", async () => {
+    expect(WAKE_START_TIMEOUT_MS).toBe(180_000);
+    const { wake, timers, calls, lights } = controller({
+      "wake.start": () => new Promise(() => {}), // a first start loading a model, never answering
+    });
+    void wake.start({ consent: true });
+    await flush();
+    expect(calls[0]).toEqual({
+      method: "wake.start",
+      params: { surface: "gui", consent: true },
+      options: { timeoutMs: 180_000 },
+    });
+    timers.advance(WAKE_START_TIMEOUT_MS - 1);
+    await flush();
+    expect(wake.get().pending).toBe(true);
+    timers.advance(1);
+    await flush();
+    expect(wake.get()).toMatchObject({
+      pending: false,
+      listening: false,
+      notice: { key: "wake.reason.timeout" },
+    });
+    expect(lights).toEqual([]);
+  });
+
+  it("a slow start inside the 180 s still arms", async () => {
+    let release: (value: unknown) => void = () => {};
+    const { wake, timers, lights } = controller({
+      "wake.start": () =>
+        new Promise((resolve) => {
+          release = resolve;
+        }),
+    });
+    void wake.start({ consent: true });
+    timers.advance(179_000);
+    release({ started: true, phrase: "hey indus" });
+    await flush();
+    expect(wake.get()).toMatchObject({ listening: true, pending: false, indicator: "listening" });
+    expect(lights).toEqual(["listening"]);
+    expect(timers.pending()).toBe(0);
+  });
+
+  it("refusals keep the light off and say why", async () => {
+    const { wake, lights } = controller({
+      "wake.start": { started: false, reason: "unavailable", hint: "no model is set" },
+    });
+    await wake.start({ consent: false });
+    expect(wake.get().notice).toEqual({
+      key: "wake.reason.unavailable",
+      vars: { hint: "no model is set" },
+    });
+    expect(lights).toEqual([]);
+  });
+
+  it("a detection lights 'heard', hands off, records, then listens again", async () => {
+    const { wake, lights, handOff, fake, calls } = controller({
+      "wake.start": { started: true },
+      "wake.resume": { ok: true },
+    });
+    const off = wake.attach(fake.onEvent);
+    await wake.start({ consent: true });
+    fake.emit("wake.detected");
+    fake.emit("wake.detected"); // a second event while capturing changes nothing
+    expect(handOff).toHaveBeenCalledTimes(1);
+    expect(wake.get().indicator).toBe("capturing");
+    await wake.captureDone();
+    expect(lights).toEqual(["listening", "heard", "capturing", "listening"]);
+    expect(calls.map((c) => c.method)).toEqual(["wake.start", "wake.resume"]);
+    await wake.stop({ persist: true });
+    expect(lights.at(-1)).toBe("hidden");
+    expect(wake.get().enabled).toBe(false);
+    off();
+  });
+});
+
+describe("indicator and toggle", () => {
+  it("the indicator window follows main's state", async () => {
+    let push: (payload: { state: IndusWakeIndicatorState }) => void = () => {};
+    (globalThis as { indusDesktop?: unknown }).indusDesktop = {
+      wake: {
+        getIndicator: vi.fn(async () => ({ state: "hidden" })),
+        onIndicator: (fn: typeof push) => {
+          push = fn;
+          return () => {};
+        },
+      },
+    };
+    render(
+      <I18nProvider>
+        <WakeIndicator />
+      </I18nProvider>,
+    );
+    await act(async () => flush());
+    expect(screen.queryByTestId("wake-indicator")).toBeNull();
+    act(() => push({ state: "listening" }));
+    expect(screen.getByRole("status").textContent).toContain("hey indus");
+    act(() => push({ state: "capturing" }));
+    expect(screen.getByTestId("wake-indicator").dataset.state).toBe("capturing");
+  });
+
+  it("only the switch sends consent", async () => {
+    const { wake, calls } = controller({ "wake.start": { started: true } });
+    render(
+      <I18nProvider>
+        <WakeToggle controller={wake} />
+      </I18nProvider>,
+    );
+    const toggle = screen.getByRole("switch");
+    expect((toggle as HTMLInputElement).checked).toBe(false);
+    await act(async () => {
+      fireEvent.click(toggle);
+      await flush();
+    });
+    expect(calls[0]?.params).toEqual({ surface: "gui", consent: true });
+    expect((screen.getByRole("switch") as HTMLInputElement).checked).toBe(true);
+    await act(async () => {
+      fireEvent.click(screen.getByRole("switch"));
+      await flush();
+    });
+    expect(calls.at(-1)).toEqual({ method: "wake.stop", params: { persist: true } });
+  });
+});
diff --git a/apps/desktop/src/wake/WakeIndicator.tsx b/apps/desktop/src/wake/WakeIndicator.tsx
new file mode 100644
index 0000000..9c1cfba
--- /dev/null
+++ b/apps/desktop/src/wake/WakeIndicator.tsx
@@ -0,0 +1,316 @@
+// The wake word on the desktop (P24-20), three pieces:
+//
+// - `WakeIndicator`: the root of the indicator window (`?win=wake`), a small light with a word
+//   that says what the microphone is doing (listening / heard / recording). Main shows the
+//   window whenever the state is not `hidden`.
+// - `WakeController`: the app window's side. `start({ consent })` asks the daemon (`wake.start`,
+//   waiting up to `WAKE_START_TIMEOUT_MS` because a first start may load a model), `stop`, and
+//   follows `wake.detected`: the light turns to "heard", the hand-off callback starts voice mode
+//   (P24-35 owns capture), and `captureDone()` resumes listening. The light follows every step,
+//   so the microphone is never in use without it.
+// - `WakeToggle`: the Settings switch. Only this explicit switch sends `consent: true`.
+//
+// `wake.*` are not in the generated method catalogue yet (P24-20 wiring): calls go through
+// `LooseRpc`.
+
+import { useEffect, useState, useSyncExternalStore } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import type { IndusWakeIndicatorState } from "../global.d.ts";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+import type { LooseRpc } from "../pet/PetOverlay.tsx";
+
+export const WAKE_START_TIMEOUT_MS = 180_000;
+export const DEFAULT_PHRASE = "hey indus";
+
+export interface WakeTimers {
+  setTimeout(fn: () => void, ms: number): unknown;
+  clearTimeout(handle: unknown): void;
+}
+
+export interface WakeView {
+  readonly enabled: boolean;
+  readonly listening: boolean;
+  readonly pending: boolean;
+  readonly indicator: IndusWakeIndicatorState;
+  readonly phrase: string;
+  /** Why it is not listening, as a message key with its values. */
+  readonly notice: { key: MessageKey; vars?: Record<string, string> } | null;
+}
+
+interface StartAnswer {
+  started?: boolean;
+  reason?: string | null;
+  hint?: string | null;
+  phrase?: string;
+}
+
+const REASON_KEYS: Record<string, MessageKey> = {
+  disabled: "wake.reason.disabled",
+  consent_required: "wake.reason.consent",
+  owned: "wake.reason.owned",
+  unavailable: "wake.reason.unavailable",
+};
+
+class StartTimeout extends Error {}
+
+export class WakeController {
+  private view: WakeView = {
+    enabled: false,
+    listening: false,
+    pending: false,
+    indicator: "hidden",
+    phrase: DEFAULT_PHRASE,
+    notice: null,
+  };
+  private readonly listeners = new Set<() => void>();
+  private readonly rpc: LooseRpc;
+  private readonly timers: WakeTimers;
+  private readonly setIndicator: (state: IndusWakeIndicatorState) => void;
+  private readonly handOff: () => void;
+  private serial = 0;
+
+  constructor(options: {
+    rpc: LooseRpc;
+    /** Start voice capture for a detection (P24-35's dictation / conversation). */
+    handOff: () => void;
+    setIndicator?: (state: IndusWakeIndicatorState) => void;
+    timers?: WakeTimers;
+  }) {
+    this.rpc = options.rpc;
+    this.handOff = options.handOff;
+    this.setIndicator =
+      options.setIndicator ?? ((state) => desktopBridge()?.wake.setIndicator({ state }));
+    this.timers = options.timers ?? {
+      setTimeout: (fn, ms) => setTimeout(fn, ms),
+      clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+    };
+  }
+
+  get(): WakeView {
+    return this.view;
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  private patch(next: Partial<WakeView>): void {
+    const before = this.view.indicator;
+    this.view = { ...this.view, ...next };
+    if (this.view.indicator !== before) this.setIndicator(this.view.indicator);
+    for (const listener of [...this.listeners]) listener();
+  }
+
+  private withDeadline<T>(call: Promise<T>): Promise<T> {
+    return new Promise<T>((resolve, reject) => {
+      const timer = this.timers.setTimeout(() => reject(new StartTimeout()), WAKE_START_TIMEOUT_MS);
+      call.then(
+        (value) => {
+          this.timers.clearTimeout(timer);
+          resolve(value);
+        },
+        (error: unknown) => {
+          this.timers.clearTimeout(timer);
+          reject(error);
+        },
+      );
+    });
+  }
+
+  /** Arm the listener. `consent` only from the explicit Settings switch (or `/wake on`). */
+  async start(options: { consent: boolean }): Promise<void> {
+    const serial = ++this.serial;
+    this.patch({ pending: true, notice: null });
+    let answer: StartAnswer;
+    try {
+      answer = (await this.withDeadline(
+        this.rpc.request(
+          "wake.start",
+          { surface: "gui", consent: options.consent },
+          { timeoutMs: WAKE_START_TIMEOUT_MS },
+        ),
+      )) as StartAnswer;
+    } catch (error) {
+      if (serial !== this.serial) return;
+      this.patch({
+        pending: false,
+        listening: false,
+        indicator: "hidden",
+        notice:
+          error instanceof StartTimeout
+            ? { key: "wake.reason.timeout" }
+            : {
+                key: "wake.reason.failed",
+                vars: { message: error instanceof Error ? error.message : String(error) },
+              },
+      });
+      return;
+    }
+    if (serial !== this.serial) return;
+    const phrase = answer.phrase?.trim() || this.view.phrase;
+    if (answer.started === true) {
+      this.patch({
+        pending: false,
+        enabled: true,
+        listening: true,
+        indicator: "listening",
+        phrase,
+        notice: null,
+      });
+      return;
+    }
+    const key = REASON_KEYS[answer.reason ?? ""] ?? "wake.reason.disabled";
+    this.patch({
+      pending: false,
+      listening: false,
+      indicator: "hidden",
+      phrase,
+      notice: { key, vars: { hint: answer.hint ?? "" } },
+    });
+  }
+
+  /** Disarm; `persist` (the Settings switch) also turns the feature off. */
+  async stop(options: { persist: boolean }): Promise<void> {
+    ++this.serial;
+    this.patch({ listening: false, pending: false, indicator: "hidden", notice: null });
+    if (options.persist) this.patch({ enabled: false });
+    try {
+      await this.rpc.request("wake.stop", { persist: options.persist });
+    } catch {
+      // the daemon went away: it released the microphone with the connection
+    }
+  }
+
+  /** The daemon heard the phrase (`wake.detected`). */
+  detected(): void {
+    if (!this.view.listening) return;
+    this.patch({ listening: false, indicator: "heard" });
+    try {
+      this.handOff();
+      this.patch({ indicator: "capturing" });
+    } catch {
+      void this.captureDone();
+    }
+  }
+
+  /** Voice capture finished: listen again. */
+  async captureDone(): Promise<void> {
+    if (this.view.indicator !== "capturing" && this.view.indicator !== "heard") return;
+    try {
+      const answer = (await this.rpc.request("wake.resume", {})) as { ok?: boolean };
+      if (answer.ok === true) {
+        this.patch({ listening: true, indicator: "listening" });
+        return;
+      }
+    } catch {
+      // fall through: not listening
+    }
+    this.patch({ listening: false, indicator: "hidden" });
+  }
+
+  /** Follow the connection's events (`wake.detected`). */
+  attach(onEvent: LooseRpc["onEvent"]): () => void {
+    return (
+      onEvent?.((event) => {
+        if (event.type === "wake.detected") this.detected();
+      }) ?? (() => {})
+    );
+  }
+}
+
+export function useWake(controller: WakeController): WakeView {
+  return useSyncExternalStore(
+    (listener) => controller.subscribe(listener),
+    () => controller.get(),
+    () => controller.get(),
+  );
+}
+
+const LIGHT: Record<Exclude<IndusWakeIndicatorState, "hidden">, string> = {
+  listening: "bg-accent",
+  heard: "bg-ok",
+  capturing: "bg-danger",
+};
+
+export function WakeIndicator(props: { phrase?: string }) {
+  const t = useT();
+  const bridge = desktopBridge();
+  const [state, setState] = useState<IndusWakeIndicatorState>("hidden");
+
+  useEffect(() => {
+    document.documentElement.dataset.window = "wake";
+    document.body.style.background = "transparent";
+    if (bridge === null) return;
+    let live = true;
+    let heard = false;
+    const off = bridge.wake.onIndicator((next) => {
+      heard = true;
+      if (live) setState(next.state);
+    });
+    void bridge.wake
+      .getIndicator()
+      .then((next) => {
+        if (live && !heard) setState(next.state);
+      })
+      .catch(() => {});
+    return () => {
+      live = false;
+      off();
+    };
+  }, [bridge]);
+
+  if (state === "hidden") return null;
+  const label =
+    state === "listening"
+      ? t("wake.indicator.listening", { phrase: props.phrase ?? DEFAULT_PHRASE })
+      : t(state === "heard" ? "wake.indicator.heard" : "wake.indicator.capturing");
+  return (
+    <main
+      className="flex h-full w-full items-center justify-center"
+      data-state={state}
+      data-testid="wake-indicator"
+    >
+      <p
+        role="status"
+        className="flex items-center gap-2 rounded-full border border-line bg-raised px-3 py-1 text-xs text-fg shadow"
+      >
+        <span aria-hidden="true" className={`inline-block h-2 w-2 rounded-full ${LIGHT[state]}`} />
+        {label}
+      </p>
+    </main>
+  );
+}
+
+export function WakeToggle(props: { controller: WakeController }) {
+  const t = useT();
+  const view = useWake(props.controller);
+  const on = view.listening || view.pending;
+  return (
+    <div className="flex flex-col gap-1" data-testid="wake-toggle">
+      <label className="flex items-center gap-2 text-sm">
+        <input
+          type="checkbox"
+          role="switch"
+          aria-checked={on}
+          checked={on}
+          disabled={view.pending}
+          onChange={(event) => {
+            if (event.target.checked) void props.controller.start({ consent: true });
+            else void props.controller.stop({ persist: true });
+          }}
+        />
+        {t("wake.toggle.label")}
+      </label>
+      <p className="text-xs text-muted">{t("wake.toggle.hint", { phrase: view.phrase })}</p>
+      {view.pending ? <p className="text-xs text-muted">{t("wake.toggle.starting")}</p> : null}
+      {view.notice !== null ? (
+        <p role="alert" className="text-xs text-warn">
+          {t(view.notice.key, view.notice.vars)}
+        </p>
+      ) : null}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/wake/appWake.test.ts b/apps/desktop/src/wake/appWake.test.ts
new file mode 100644
index 0000000..84c2079
--- /dev/null
+++ b/apps/desktop/src/wake/appWake.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  type DictateRequest,
+  dictationDone,
+  installAppWake,
+  requestDictation,
+  WAKE_DICTATE_EVENT,
+} from "./appWake.ts";
+
+function rig() {
+  const target = new EventTarget();
+  const listeners = new Set<(event: { type?: string }) => void>();
+  const calls: string[] = [];
+  const rpc = {
+    request: vi.fn(async (method: string) => {
+      calls.push(method);
+      if (method === "wake.start") return { started: true, phrase: "hey indus" };
+      if (method === "wake.resume") return { ok: true };
+      return {};
+    }),
+    onEvent: (listener: (event: { type?: string }) => void) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+  };
+  const lights: string[] = [];
+  const made = installAppWake(() => rpc, target);
+  made.controller.subscribe(() => lights.push(made.controller.get().indicator));
+  const emit = (type: string) => {
+    for (const listener of [...listeners]) listener({ type });
+  };
+  return { target, made, calls, emit, lights };
+}
+
+describe("the window's wake word hands off to the composer's dictation (P24-20 → P24-35)", () => {
+  it("a detection starts dictation on screen; its end listens again", async () => {
+    const { target, made, calls, emit } = rig();
+    const taken: number[] = [];
+    target.addEventListener(WAKE_DICTATE_EVENT, (event) => {
+      (event as CustomEvent<DictateRequest>).detail.taken = true;
+      taken.push(1);
+    });
+    await made.controller.start({ consent: false });
+    emit("wake.detected");
+    expect(taken).toEqual([1]);
+    expect(made.controller.get().indicator).toBe("capturing");
+    dictationDone(target);
+    await vi.waitFor(() => expect(made.controller.get().indicator).toBe("listening"));
+    expect(calls).toEqual(["wake.start", "wake.resume"]);
+    made.dispose();
+  });
+
+  it("with no composer on screen the controller listens again at once", async () => {
