+
+    @snapshot_group.command("import")
+    @click.argument("source", type=click.Path(dir_okay=False, path_type=Path))
+    @click.option("--force", is_flag=True, help="Install over a caution verdict (never dangerous).")
+    @click.option("--yes", "-y", is_flag=True, help="Do not ask first.")
+    def snapshot_import_command(source: Path, force: bool, yes: bool) -> None:
+        """Install the skills of a snapshot again (each one scanned)."""
+        from indus.learning.skills.hub.snapshot import import_snapshot, read_snapshot
+        from indus.learning.skills.hub.sources import HubError
+
+        scope = _scope()
+        try:
+            snapshot = read_snapshot(source.read_text(encoding="utf-8-sig"))
+        except OSError as exc:
+            _fail(f"Cannot read {source}: {exc.strerror or exc}")
+            return
+        except HubError as exc:
+            _fail(str(exc))
+            return
+        io = io_for(cli_state(), "Importing skills needs a terminal to confirm, or -y.")
+        no_terminal = False
+
+        def ask(preview: Preview) -> bool:
+            nonlocal no_terminal
+            answer = confirm(io, f"Install {preview.name!r}?", assume_yes=yes)
+            if answer is None:
+                no_terminal = True
+                return False
+            return answer
+
+        async def work(sources: SourceSet) -> Any:
+            return await import_snapshot(
+                scope, sources, snapshot, force=force, confirm=ask, say=click.echo
+            )
+
+        rows = _run(scope, work)
+        failed = 0
+        for row in rows:
+            mark = "✓" if row.ok else "✗"
+            note = f" — {row.message}" if row.message else ""
+            click.echo(f"{mark} {row.name} ({row.status}){note}")
+            failed += 0 if row.ok else 1
+        click.echo(f"{len(rows) - failed} of {len(rows)} skill(s) in place.")
+        if no_terminal:
+            raise click.exceptions.Exit(2)
+        if failed:
+            raise click.exceptions.Exit(1)
diff --git a/src/indus/cli/commands/vault.py b/src/indus/cli/commands/vault.py
new file mode 100644
index 0000000..4c3b6d6
--- /dev/null
+++ b/src/indus/cli/commands/vault.py
@@ -0,0 +1,184 @@
+"""``indus vault``: the local encrypted vault behind ``browser_vault`` (P24-40).
+
+``add`` asks for a login (site origin, label, identifier, then the password and an optional
+authenticator key, both hidden), a payment card or an address, and stores it encrypted in
+``<home>/vault/local.vault`` with its key in the profile's secret store. Secret values are only
+ever read from hidden prompts, never from arguments, so ``add`` needs a terminal (exit 1 without
+one). ``list`` (the default) shows handles and metadata, never values. ``remove HANDLE`` deletes an
+item. ``lock`` stops the agent from using the local vault until ``unlock`` (or until the user
+approves an unlock card in a chat).
+
+Exit codes: 0 done, 1 refused (no terminal for ``add``, unknown handle, a vault error), 2 usage.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import click
+
+if TYPE_CHECKING:
+    from indus.foundation.scope import Scope
+
+__all__ = ["vault_group"]
+
+_SETTINGS = {"help_option_names": ["-h", "--help"], "max_content_width": 100}
+_ALIASES = {"ls": "list", "rm": "remove"}
+_KINDS = ("login", "payment", "address")
+
+
+class _Group(click.Group):
+    def get_command(self, ctx: click.Context, cmd_name: str) -> click.Command | None:
+        return super().get_command(ctx, _ALIASES.get(cmd_name, cmd_name))
+
+
+def _scope() -> Scope:
+    from indus.cli.cmdkit import cli_state
+
+    return cli_state().scope
+
+
+def _store_scope() -> Scope:
+    """The scope with a writable secret store (the vault key lives there)."""
+    from indus.cli.commands._support import secret_store
+
+    scope = _scope()
+    return scope.with_secrets(secret_store(scope))
+
+
+def _fail(message: str) -> None:
+    click.echo(f"vault: {message}", err=True)
+    raise click.exceptions.Exit(1)
+
+
+def _ask(text: str, *, hidden: bool, required: bool = True) -> str:
+    """One prompt (hidden for secrets); empty answers repeat while ``required``."""
+    while True:
+        value = click.prompt(text, default="", show_default=False, hide_input=hidden)
+        value = str(value).strip()
+        if value or not required:
+            return value
+        click.echo("A value is needed.", err=True)
+
+
+@click.group("vault", cls=_Group, context_settings=_SETTINGS, invoke_without_command=True)
+@click.pass_context
+def vault_group(ctx: click.Context) -> None:
+    """Saved logins, cards and addresses the agent can fill without seeing them."""
+    if ctx.invoked_subcommand is None:
+        ctx.invoke(list_items)
+
+
+@vault_group.command("add", context_settings=_SETTINGS)
+@click.option("--kind", type=click.Choice(_KINDS), default=None, help="What to save.")
+@click.option("--origin", default="", help="The site it may be filled on, e.g. https://x.com.")
+@click.option("--label", default="", help="A short name shown by `list`.")
+def add_item(kind: str | None, origin: str, label: str) -> None:
+    """Save an item (values are asked for in hidden prompts)."""
+    from indus.cli.cmdkit import cli_state
+    from indus.cli.commands._support import interactive
+    from indus.tools.builtin.browser.vault import (
+        ADDRESS_FIELDS,
+        PAYMENT_FIELDS,
+        REQUIRED_FIELDS,
+        LocalVault,
+        VaultError,
+    )
+
+    if not interactive(cli_state()):
+        _fail("values are read from hidden prompts only; run `indus vault add` in a terminal.")
+    scope = _store_scope()
+    chosen = kind or click.prompt(
+        "Kind", type=click.Choice(_KINDS), default="login", show_choices=True
+    )
+    site = origin.strip() or _ask("Site origin (e.g. https://github.com)", hidden=False)
+    name = label.strip() or _ask("Label", hidden=False, required=False)
+    identifier = ""
+    otp_seed = ""
+    secret: dict[str, str] = {}
+    if chosen == "login":
+        identifier = _ask("Username or email", hidden=False)
+        secret["password"] = _ask("Password (hidden)", hidden=True)
+        otp_seed = _ask("Authenticator key (optional, hidden)", hidden=True, required=False)
+    else:
+        fields = PAYMENT_FIELDS if chosen == "payment" else ADDRESS_FIELDS
+        needed = REQUIRED_FIELDS[chosen]
+        for field_name in fields:
+            text = field_name.replace("_", " ").replace("cc ", "card ")
+            optional = "" if field_name in needed else " (optional)"
+            secret[field_name] = _ask(
+                f"{text}{optional}", hidden=chosen == "payment", required=field_name in needed
+            )
+    try:
+        meta = LocalVault().add(
+            scope,
+            kind=chosen,
+            label=name,
+            origin=site,
+            secret=secret,
+            identifier=identifier,
+            otp_seed=otp_seed,
+        )
+    except VaultError as exc:
+        _fail(str(exc))
+        return
+    finally:
+        secret.clear()
+    click.echo(f"Saved {meta.kind} {meta.handle} for {meta.origin}.")
+
+
+@vault_group.command("list", context_settings=_SETTINGS)
+def list_items() -> None:
+    """Show saved items (never their values)."""
+    from indus.tools.builtin.browser.vault import LocalVault, VaultError
+
+    scope = _store_scope()
+    vault = LocalVault()
+    try:
+        items = vault.list_items(scope)
+    except VaultError as exc:
+        _fail(str(exc))
+        return
+    if vault.locked(scope):
+        click.echo("The local vault is locked: the agent cannot use it (indus vault unlock).")
+    if not items:
+        click.echo("The vault is empty. Save a login with `indus vault add`.")
+        return
+    for meta in items:
+        who = f" {meta.identifier}" if meta.identifier else ""
+        click.echo(f"{meta.handle}  {meta.kind:<8} {meta.label}{who}  {meta.origin}")
+    click.echo("Values are never shown; the agent fills them from the handle.")
+
+
+@vault_group.command("remove", context_settings=_SETTINGS)
+@click.argument("handle")
+def remove_item(handle: str) -> None:
+    """Delete an item by its handle."""
+    from indus.tools.builtin.browser.vault import LocalVault, VaultError
+
+    try:
+        removed = LocalVault().remove(_store_scope(), handle)
+    except VaultError as exc:
+        _fail(str(exc))
+        return
+    if not removed:
+        _fail(f"no vault item has the handle {handle!r}")
+    click.echo(f"Removed {handle}.")
+
+
+@vault_group.command("lock", context_settings=_SETTINGS)
+def lock_vault() -> None:
+    """Stop the agent from using the local vault."""
+    from indus.tools.builtin.browser.vault import LocalVault
+
+    LocalVault().lock(_scope())
+    click.echo("The local vault is locked.")
+
+
+@vault_group.command("unlock", context_settings=_SETTINGS)
+def unlock_vault() -> None:
+    """Let the agent use the local vault again."""
+    from indus.tools.builtin.browser.vault import LocalVault
+
+    was = LocalVault().unlock_marker(_scope())
+    click.echo("The local vault is unlocked." if was else "The local vault was not locked.")
diff --git a/src/indus/cli/commands/verify.py b/src/indus/cli/commands/verify.py
new file mode 100644
index 0000000..60ee4c0
--- /dev/null
+++ b/src/indus/cli/commands/verify.py
@@ -0,0 +1,208 @@
+"""``indus verify [PATH]``: find how to check a workspace and run it (P24-17).
+
+The recipe comes from the workspace's files (``tools.verify.recipes``). Phases ``bootstrap``,
+``build`` and ``test`` run in that order on the local terminal backend (its environment builder,
+``terminal.*`` settings) and through the approval rules with nobody to ask, so a command that
+would need a person's approval is refused rather than run. Then, unless ``--skip-start``, the
+recipe's start command is booted and polled on 127.0.0.1 for up to ``verify.ready_timeout``.
+
+``--phase`` (repeatable) picks phases (``bootstrap``, ``build``, ``test``, ``start``);
+``--detect-only`` prints the recipe; ``--json`` prints one JSON object. Exit 0 when everything
+passed, 1 on a failure or when no recipe was found, 2 when PATH is not a folder.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+from typing import Any
+
+import click
+
+from indus.cli.cmdkit import cli_state, config_of, err
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+__all__ = ["report_lines", "run_for", "verify_command"]
+
+PHASE_CHOICES = ("bootstrap", "build", "test", "start")
+
+
+def _setting(scope: Scope, key: str) -> Any:
+    value = config_of(scope).get(key)
+    return default_for(key) if value is None else value
+
+
+def _gate(scope: Scope) -> Any:
+    from indus.safety import approvals
+
+    async def gate(command: str, cwd: str) -> str | None:
+        context = approvals.ApprovalContext(
+            scope=scope, run_context="interactive", broker=None, isolated=False, cwd=cwd
+        )
+        try:
+            decision = await approvals.decide(command, context)
+        except Exception as exc:  # fail closed: nothing runs unchecked
+            return f"the approval check failed ({type(exc).__name__})"
+        if decision.approved:
+            return None
+        return decision.user_summary or decision.description or "the approval rules refused it"
+
+    return gate
+
+
+async def run_for(
+    scope: Scope,
+    root: Path,
+    *,
+    phases: tuple[str, ...],
+    skip_start: bool,
+    port: int | None,
+    phase_timeout: float,
+    ready_timeout: float,
+) -> tuple[Any, Any]:
+    """``(recipe, result)`` for ``root`` (``result`` None when no recipe was found)."""
+    from indus.backends.local import open_local
+    from indus.safety.child_env import child_env
+    from indus.tools.verify.recipes import detect_recipe
+    from indus.tools.verify.runner import LocalStarter, run_verify
+
+    recipe = detect_recipe(root)
+    if recipe is None:
+        return None, None
+    host = await open_local(scope, cwd=str(root), timeout=phase_timeout)
+    try:
+        selected = phases or None
+        wants_start = not skip_start and (not phases or "start" in phases)
+        starter = LocalStarter(child_env(scope), clock=scope.clock) if wants_start else None
+        result = await run_verify(
+            host,
+            str(root),
+            recipe,
+            phases=selected,
+            phase_timeout=phase_timeout,
+            ready_timeout=ready_timeout,
+            clock=scope.clock,
+            gate=_gate(scope),
+            starter=starter,
+            port=port,
+        )
+    finally:
+        await host.cleanup()
+    return recipe, result
+
+
+def report_lines(recipe: Any, result: Any) -> list[str]:
+    lines = [f"Recipe: {recipe.name} ({recipe.kind})", ""]
+    if result.refused:
+        lines += [f"Refused: {result.refused}", "", "Result: FAILED"]
+        return lines
+    width = max([len(p.phase) for p in result.phases] + [5])
+    for phase in result.phases:
+        state = (
+            "PASS"
+            if phase.ok
+            else "TIMEOUT"
+            if phase.timed_out
+            else "REFUSED"
+            if (phase.refused)
+            else "FAIL"
+        )
+        lines.append(
+            f"  {phase.phase:<{width}}  {state:<7} {phase.duration:7.1f}s  {phase.command}"
+        )
+    if not result.phases:
+        lines.append("  (no phase ran)")
+    readiness = result.readiness
+    if readiness is not None:
+        state = "PASS" if readiness.ready else "FAIL"
+        lines.append(f"  {'start':<{width}}  {state:<7} {readiness.duration:7.1f}s  {recipe.start}")
+        answer = f"HTTP {readiness.status}" if readiness.ready else readiness.error or "no answer"
+        lines.append(f"  ready check: {readiness.url} -> {answer}")
+    lines += ["", f"Result: {'OK' if result.ok else 'FAILED'}"]
+    for phase in result.phases:
+        if phase.ok:
+            continue
+        if phase.refused:
+            lines += ["", f"--- {phase.phase}: {phase.command} was not run: {phase.refused}"]
+        elif phase.tail.strip():
+            lines += [
+                "",
+                f"--- output (end) of {phase.phase}: {phase.command}",
+                phase.tail.rstrip(),
+            ]
+    if readiness is not None and not readiness.ready and readiness.tail.strip():
+        lines += ["", "--- output (end) of start", readiness.tail.rstrip()]
+    return lines
+
+
+@click.command("verify", short_help="Build and test this workspace.")
+@click.argument("path", required=False, type=click.Path(file_okay=True, dir_okay=True))
+@click.option(
+    "--phase",
+    "phases",
+    multiple=True,
+    type=click.Choice(PHASE_CHOICES),
+    help="Run only this phase (repeatable).",
+)
+@click.option("--json", "as_json", is_flag=True, help="Print one JSON object.")
+@click.option("--detect-only", is_flag=True, help="Only print the detected recipe.")
+@click.option("--skip-start", is_flag=True, help="Do not boot the start command.")
+@click.option("--port", type=int, default=None, help="Port the start command serves on.")
+@click.option("--timeout", "phase_timeout", type=float, default=None, help="Seconds per command.")
+@click.option("--ready-timeout", type=float, default=None, help="Seconds to wait for the service.")
+def verify_command(
+    path: str | None,
+    phases: tuple[str, ...],
+    as_json: bool,
+    detect_only: bool,
+    skip_start: bool,
+    port: int | None,
+    phase_timeout: float | None,
+    ready_timeout: float | None,
+) -> int:
+    """Find how to check a workspace (lockfiles, scripts, Makefile, compose) and run its
+    bootstrap, build and test commands, then boot and poll its start command."""
+    from indus.tools.verify.recipes import detect_recipe
+
+    scope = cli_state().scope
+    scope = scope if scope.config is not None else scope.with_config(config_of(scope))
+    root = Path(path or ".").expanduser().resolve()
+    if not root.is_dir():
+        err(f"Not a folder: {root}")
+        return 2
+    if detect_only:
+        recipe = detect_recipe(root)
+        payload: dict[str, Any] = {
+            "root": str(root),
+            "recipe": recipe.as_dict() if recipe else None,
+        }
+        click.echo(json.dumps(payload, indent=None if as_json else 2))
+        return 0 if recipe is not None else 1
+    recipe, result = asyncio.run(
+        run_for(
+            scope,
+            root,
+            phases=phases,
+            skip_start=skip_start,
+            port=port,
+            phase_timeout=float(phase_timeout or _setting(scope, "verify.phase_timeout")),
+            ready_timeout=float(ready_timeout or _setting(scope, "verify.ready_timeout")),
+        )
+    )
+    if recipe is None:
+        if as_json:
+            click.echo(json.dumps({"ok": False, "error": "no_recipe", "root": str(root)}))
+        else:
+            err(
+                f"Nothing here says how to build or test {root}: no package.json, pyproject.toml, "
+                "go.mod, Cargo.toml, pom.xml, Gradle build, Makefile or compose file."
+            )
+        return 1
+    if as_json:
+        click.echo(json.dumps({**result.as_dict(), "root": str(root), "kind": recipe.kind}))
+    else:
+        for line in report_lines(recipe, result):
+            click.echo(line)
+    return 0 if result.ok else 1
diff --git a/src/indus/cli/console_engine.py b/src/indus/cli/console_engine.py
new file mode 100644
index 0000000..c47bef4
--- /dev/null
+++ b/src/indus/cli/console_engine.py
@@ -0,0 +1,120 @@
+"""``indus console``: the admin console in a terminal (P24-36).
+
+The engine — the curated command list, the refusals, confirmation, limits — is
+``indus.service.console``, shared with the dashboard's ``/api/console`` socket (``indus.web``
+may not import ``indus.cli``). This module is the local REPL over it:
+
+- in a terminal: a prompt; a confirm-first command asks ``[y/N]``; ``exit``, ``quit`` or end of
+  input leaves (exit 0);
+- ``indus console --run '<command>'`` runs one line and exits (1 when it failed or was refused);
+  a confirm-first command needs a terminal to confirm, else it is not run (exit 1);
+- without a terminal and without ``--run`` it says how to use ``--run`` and exits 1 (R04.19).
+"""
+
+from __future__ import annotations
+
+import sys
+from typing import TextIO
+
+import click
+
+from indus.service.console import PROMPT, ConsoleEngine, ConsoleResult
+
+__all__ = ["console_command", "run_repl"]
+
+
+def _show(result: ConsoleResult, stdout: TextIO, stderr: TextIO) -> None:
+    if result.output:
+        print(result.output, file=stdout)
+    if result.errors:
+        print(result.errors, file=stderr)
+    if result.status == "error" and result.message:
+        print(result.message, file=stderr)
+
+
+def _ask(question: str, stdin: TextIO, stdout: TextIO) -> bool:
+    """A yes/no question on the terminal; only ``y`` or ``yes`` is a yes."""
+    stdout.write(f"{question} [y/N] ")
+    stdout.flush()
+    return stdin.readline().strip().lower() in ("y", "yes")
+
+
+def run_repl(
+    engine: ConsoleEngine,
+    *,
+    stdin: TextIO,
+    stdout: TextIO,
+    stderr: TextIO,
+    interactive: bool,
+) -> int:
+    """Read lines until ``exit`` or end of input; without a terminal a confirm-first command
+    stops the run with exit 1."""
+    if interactive:
+        stdout.write("Indus console. `help` lists the commands, `exit` leaves.\n")
+    while True:
+        if interactive:
+            stdout.write(PROMPT)
+            stdout.flush()
+        line = stdin.readline()
+        if not line:
+            return 0
+        result = engine.execute(line)
+        if result.status == "confirm_required":
+            if not interactive:
+                stderr.write(f"{result.message} (needs a terminal to confirm)\n")
+                return 1
+            if _ask(result.message, stdin, stdout):
+                result = engine.execute(result.command, confirmed=True)
+            else:
+                stdout.write("Not run.\n")
+                continue
+        if result.status == "exit":
+            _show(result, stdout, stderr)
+            return 0
+        if result.status == "clear":
+            stdout.write("\033[2J\033[H")
+            stdout.flush()
+        else:
+            _show(result, stdout, stderr)
+
+
+@click.command("console")
+@click.option(
+    "--run",
+    "one",
+    default=None,
+    metavar="LINE",
+    help="Run one console command and exit.",
+)
+def console_command(one: str | None) -> None:
+    """The admin console: curated indus commands, one per line."""
+    from indus.cli.cmdkit import cli_state
+
+    state = cli_state()
+    engine = ConsoleEngine(state.scope)
+    tty = state.stdin_isatty() and state.stdout_isatty()
+    if one is not None:
+        result = engine.execute(one)
+        if result.status == "confirm_required":
+            if not tty or not click.confirm(result.message, default=False):
+                click.echo(f"{result.message} Not run.", err=True)
+                raise click.exceptions.Exit(1)
+            result = engine.execute(one, confirmed=True)
+        if result.output:
+            click.echo(result.output)
+        if result.errors:
+            click.echo(result.errors, err=True)
+        if result.status == "error":
+            if result.message:
+                click.echo(result.message, err=True)
+            raise click.exceptions.Exit(1)
+        return
+    if not tty:
+        click.echo(
+            "indus console needs a terminal. Run one command with: indus console --run '<command>'",
+            err=True,
+        )
+        raise click.exceptions.Exit(1)
+    code = run_repl(engine, stdin=sys.stdin, stdout=sys.stdout, stderr=sys.stderr, interactive=True)
+    if code:
+        raise click.exceptions.Exit(code)
