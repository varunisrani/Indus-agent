+# pyright: strict
+"""``message_agent``: a bot sends a message to another bot's canonical chat (P24-07).
+
+The tool exists only in the ``bots`` toolset, gated to sessions on the ``bots`` platform, and so
+only in the ``indus-bots`` bundle: canonical bot chats have it, nothing else does (selecting "all
+toolsets" never brings it in).
+
+``target`` names the recipient:
+
+- ``alice`` — the local profile ``alice`` (a local profile name always wins, so another machine's
+  name can never hijack it); when no local profile has that name, a registered peer gateway of
+  that name (its default profile);
+- ``spark/alice`` — profile ``alice`` on peer gateway ``spark``.
+
+A leading ``@`` is ignored. The tool writes the attribution line itself
+(``Message from bot @<sender>:``), so the recipient always knows who wrote. The message travels as
+a value, never through a shell.
+
+Delivery goes through the session's transport (the handler extra ``bot_transport`` when the turn
+offers one, else the one the host installed for the profile with ``install_transport``). Every
+failure comes back typed (``reason``, from ``indus.state.bot_chat.FAILURE_REASONS``). A failure a
+second attempt can help (runtime offline, delivery timeout, provider rate limit or server error,
+context overflow) is retried exactly once; auth, quota and configuration failures, and the rest,
+are returned at once. A reply longer than ``MAX_REPLY_CHARS`` arrives as its head with a note.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, replace
+from typing import Any, Final, Protocol
+
+from indus.foundation.redact import redact_text
+from indus.foundation.scope import Scope
+from indus.state.bot_chat import RETRYABLE_REASONS, FailureReason, classify_failure
+from indus.tools.calls import ToolResult
+from indus.tools.registry import ToolRegistry, scope_key
+
+__all__ = [
+    "MAX_MESSAGE_CHARS",
+    "MAX_REPLY_CHARS",
+    "SCHEMA",
+    "TOOLSET",
+    "TOOL_NAME",
+    "BotDelivery",
+    "BotTarget",
+    "BotTransport",
+    "DeliveryOutcome",
+    "attribution",
+    "deliver_with_retry",
+    "install_transport",
+    "message_agent",
+    "parse_target",
+    "register_tools",
+    "transport_for",
+]
+
+TOOL_NAME: Final = "message_agent"
+TOOLSET: Final = "bots"
+MAX_MESSAGE_CHARS: Final = 64_000
+MAX_REPLY_CHARS: Final = 16_000
+CALL_DEADLINE_S: Final = 2 * 600.0 + 60.0
+_NAME_CHARS: Final = frozenset("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")
+
+
+class TargetError(ValueError):
+    """The target text is not a profile or ``peer/profile`` name."""
+
+
+@dataclass(frozen=True)
+class BotTarget:
+    """``name`` alone: a local profile, else a peer of that name; with ``profile``: that
+    profile on peer ``name``."""
+
+    name: str
+    profile: str | None = None
+
+    @property
+    def is_peer_form(self) -> bool:
+        return self.profile is not None
+
+    def render(self) -> str:
+        return self.name if self.profile is None else f"{self.name}/{self.profile}"
+
+
+def _part(text: str, label: str) -> str:
+    clean = text.strip()
+    if not clean or len(clean) > 64 or not set(clean) <= _NAME_CHARS or clean[0] in "-_":
+        raise TargetError(f"{label} {text!r} is not a valid name")
+    return clean
+
+
+def parse_target(text: str) -> BotTarget:
+    raw = text.strip().removeprefix("@")
+    if "/" in raw:
+        peer, _, profile = raw.partition("/")
+        return BotTarget(_part(peer, "peer").lower(), _part(profile, "profile"))
+    return BotTarget(_part(raw, "target").lower())
+
+
+@dataclass(frozen=True)
+class BotDelivery:
+    sender: str
+    target: BotTarget
+    message: str
+    """The attributed text, exactly as the recipient sees it."""
+    attempt: int = 1
+
+
+@dataclass(frozen=True)
+class DeliveryOutcome:
+    ok: bool
+    reply: str = ""
+    reason: FailureReason | None = None
+    error: str = ""
+    session_id: str | None = None
+
+    @classmethod
+    def delivered(cls, reply: str, session_id: str | None = None) -> DeliveryOutcome:
+        return cls(True, reply, None, "", session_id)
+
+    @classmethod
+    def failed(cls, reason: FailureReason, error: str) -> DeliveryOutcome:
+        return cls(False, "", reason, error)
+
+
+class BotTransport(Protocol):
+    async def deliver(self, delivery: BotDelivery) -> DeliveryOutcome: ...
+
+
+# -- installed transports -------------------------------------------------------------------------
+
+_lock = threading.Lock()
+_installed: dict[str, BotTransport] = {}
+
+
+def install_transport(scope: Scope, transport: BotTransport) -> Callable[[], None]:
+    """Make ``transport`` the profile's delivery path; returns the undo."""
+    key = scope_key(scope)
+    with _lock:
+        _installed[key] = transport
+
+    def undo() -> None:
+        with _lock:
+            if _installed.get(key) is transport:
+                del _installed[key]
+
+    return undo
+
+
+def transport_for(scope: Scope | None) -> BotTransport | None:
+    if scope is None:
+        return None
+    with _lock:
+        return _installed.get(scope_key(scope))
+
+
+# -- delivery -------------------------------------------------------------------------------------
+
+
+def attribution(sender: str) -> str:
+    return f"Message from bot @{sender}:"
+
+
+async def _attempt(transport: BotTransport, delivery: BotDelivery) -> DeliveryOutcome:
+    try:
+        return await transport.deliver(delivery)
+    except Exception as exc:  # a transport bug must not end the turn; report it typed
+        text = redact_text(f"{type(exc).__name__}: {exc}")[:500]
+        return DeliveryOutcome.failed(classify_failure(text), text)
+
+
+async def deliver_with_retry(
+    transport: BotTransport, delivery: BotDelivery
+) -> tuple[DeliveryOutcome, int]:
+    """Deliver; retry exactly once when the failure is one a second attempt can help.
+    Answers the final outcome and the number of attempts made."""
+    first = await _attempt(transport, delivery)
+    if first.ok or first.reason not in RETRYABLE_REASONS:
+        return first, 1
+    second = await _attempt(transport, replace(delivery, attempt=2))
+    return second, 2
+
+
+def _cut(reply: str) -> str:
+    if len(reply) <= MAX_REPLY_CHARS:
+        return reply
+    dropped = len(reply) - MAX_REPLY_CHARS
+    return reply[:MAX_REPLY_CHARS] + f"\n[… {dropped:,} more characters of the reply were cut]"
+
+
+async def message_agent(
+    args: Mapping[str, Any],
+    *,
+    scope: Scope | None = None,
+    bot_transport: BotTransport | None = None,
+) -> str:
+    """The ``message_agent`` handler (see the module notes)."""
+    raw_target = args.get("target")
+    message = args.get("message")
+    if not isinstance(raw_target, str) or not raw_target.strip():
+        return ToolResult.error("target must name a bot (a profile, or peer/profile)").text
+    if not isinstance(message, str) or not message.strip():
+        return ToolResult.error("message must be non-empty text").text
+    if len(message) > MAX_MESSAGE_CHARS:
+        return ToolResult.error(
+            f"message has {len(message):,} characters; the limit is {MAX_MESSAGE_CHARS:,}"
+        ).text
+    try:
+        target = parse_target(raw_target)
+    except TargetError as exc:
+        return ToolResult.error(str(exc)).text
+    sender = scope.profile_id if scope is not None else "unknown"
+    if not target.is_peer_form and target.name == sender.lower():
+        return ToolResult.error("a bot cannot message itself").text
+    transport = bot_transport or transport_for(scope)
+    if transport is None:
+        return ToolResult.error(
+            "bot messaging is not available here",
+            error_type="runtime_offline",
+            reason="runtime_offline",
+            target=target.render(),
+            retried=False,
+        ).text
+    delivery = BotDelivery(sender, target, f"{attribution(sender)}\n\n{message.strip()}")
+    outcome, attempts = await deliver_with_retry(transport, delivery)
+    if outcome.ok:
+        body: dict[str, Any] = {
+            "status": "delivered",
+            "target": target.render(),
+            "reply": _cut(outcome.reply),
+            "attempts": attempts,
+        }
+        if not outcome.reply.strip():
+            body["note"] = "the recipient chose not to reply"
+        return json.dumps(body, ensure_ascii=False)
+    reason = outcome.reason or "unknown"
+    return ToolResult.error(
+        outcome.error or "the message could not be delivered",
+        error_type=reason,
+        reason=reason,
+        target=target.render(),
+        retried=attempts > 1,
+        retryable=reason in RETRYABLE_REASONS,
+    ).text
+
+
+SCHEMA: Final[dict[str, Any]] = {
+    "name": TOOL_NAME,
+    "description": (
+        "Send a message to another bot and get its reply. The message lands in that bot's own "
+        "permanent chat, signed with your name, and the bot answers there. target is the other "
+        "bot's profile name (for example researcher), or peer/profile for a bot on another "
+        "machine's gateway (for example spark/researcher). Write the message yourself: say who "
+        "you are only if it matters, state what you need, and keep it short. A failed delivery "
+        "returns a reason code (provider_auth, provider_quota, provider_rate_limit, "
+        "provider_server, context_overflow, missing_config, model_unavailable, runtime_offline, "
+        "queued_expired, delivery_timeout, target_busy, unknown); it was already retried once "
+        "when that could help, so do not resend at once."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["target", "message"],
+        "properties": {
+            "target": {
+                "description": "The bot to message: profile, or peer/profile.",
+                "type": "string",
+            },
+            "message": {"description": "What to send.", "type": "string"},
+        },
+    },
+}
+
+
+def register_tools(registry: ToolRegistry) -> None:
+    # Two attempts of at most a relayed turn's ten minutes each, plus the calls around them.
+    registry.register(TOOL_NAME, TOOLSET, SCHEMA, message_agent, timeout_s=CALL_DEADLINE_S)
diff --git a/src/indus/tools/builtin/preview.py b/src/indus/tools/builtin/preview.py
new file mode 100644
index 0000000..7276bd1
--- /dev/null
+++ b/src/indus/tools/builtin/preview.py
@@ -0,0 +1,248 @@
+"""Desktop-only preview tools (P24-25): ``drive_preview`` and ``annotate_preview``.
+
+The desktop app's preview pane shows a web page or a local file next to a session. These tools let
+the agent use it: ``drive_preview`` navigates, clicks, types, scrolls or reads a snapshot of the
+page; ``annotate_preview`` puts numbered notes on elements for the person to see. Each call
+becomes one server request — ``preview.act`` or ``preview.read`` — answered by the desktop window
+that shows this session's preview. A window that does not show it declines with ``not_shown``;
+every action runs inside the page's own sandbox there, never in the app.
+
+The tools exist only in sessions a desktop window created: ``register_tools(registry,
+surface=...)`` registers them for the ``gui`` surface and does nothing otherwise. The handler gets
+the session's preview channel as the ``preview`` keyword (``PreviewPort``); without one it says so.
+
+Interface (until the protocol knows the two request kinds): ``PreviewPort.request(kind, payload,
+timeout)`` returns the window's answer as a mapping, or raises ``PreviewDeclined`` (no window shows
+the preview) or ``PreviewUndelivered`` (no desktop window is attached any more).
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from collections.abc import Mapping
+from typing import Any, Literal, Protocol, cast
+
+from indus.tools.calls import ToolResult
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+__all__ = [
+    "ACTIONS",
+    "ANNOTATE_SCHEMA",
+    "DESKTOP_SURFACE",
+    "DRIVE_SCHEMA",
+    "MAX_PINS",
+    "PREVIEW_TIMEOUT_S",
+    "PREVIEW_TOOLSET",
+    "PreviewDeclined",
+    "PreviewPort",
+    "PreviewUndelivered",
+    "annotate_preview",
+    "drive_preview",
+    "register_tools",
+]
+
+PREVIEW_TOOLSET = "desktop-preview"
+DESKTOP_SURFACE = "gui"
+PREVIEW_TIMEOUT_S = 30.0
+MAX_PINS = 20
+MAX_TEXT = 4_000
+MAX_SELECTOR = 500
+MAX_NOTE = 500
+
+type Kind = Literal["preview.act", "preview.read"]
+
+ACTIONS: tuple[str, ...] = ("navigate", "click", "type", "scroll", "snapshot")
+_URL = re.compile(r"^(https?://|file:///)", re.IGNORECASE)
+
+
+class PreviewDeclined(Exception):
+    """The window answering does not show this session's preview (``not_shown``)."""
+
+    def __init__(self, reason: str = "not_shown") -> None:
+        super().__init__(reason)
+        self.reason = reason
+
+
+class PreviewUndelivered(Exception):
+    """No desktop window is attached to the session any more."""
+
+
+class PreviewPort(Protocol):
+    async def request(
+        self, kind: Kind, payload: Mapping[str, Any], *, timeout: float
+    ) -> Mapping[str, Any]: ...
+
+
+def _text(args: Mapping[str, Any], key: str, limit: int) -> str | None:
+    value = args.get(key)
+    if value is None:
+        return None
+    if not isinstance(value, str):
+        raise ValueError(f"{key} must be text")
+    if len(value) > limit:
+        raise ValueError(f"{key} is longer than {limit:,} characters")
+    return value
+
+
+def _number(args: Mapping[str, Any], key: str) -> int:
+    value = args.get(key, 0)
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        raise ValueError(f"{key} must be a number of pixels")
+    return max(-20_000, min(20_000, int(value)))
+
+
+def _drive_payload(args: Mapping[str, Any]) -> tuple[Kind, dict[str, Any]]:
+    action = str(args.get("action") or "").strip().lower()
+    if action not in ACTIONS:
+        raise ValueError(f"action must be one of {', '.join(ACTIONS)}")
+    if action == "snapshot":
+        return "preview.read", {"what": "snapshot"}
+    payload: dict[str, Any] = {"action": action}
+    if action == "navigate":
+        url = (_text(args, "url", 2_048) or "").strip()
+        if not _URL.match(url):
+            raise ValueError("url must be an http(s) address or a file:/// path")
+        payload["url"] = url
+    elif action in ("click", "type"):
+        selector = (_text(args, "selector", MAX_SELECTOR) or "").strip()
+        if not selector:
+            raise ValueError(f"{action} needs a CSS selector")
+        payload["selector"] = selector
+        if action == "type":
+            payload["text"] = _text(args, "text", MAX_TEXT) or ""
+            payload["submit"] = args.get("submit") is True
+    else:  # scroll
+        selector = (_text(args, "selector", MAX_SELECTOR) or "").strip()
+        if selector:
+            payload["selector"] = selector
+        else:
+            payload["dx"] = _number(args, "dx")
+            payload["dy"] = _number(args, "dy")
+    return "preview.act", payload
+
+
+def _failure(exc: BaseException) -> str:
+    if isinstance(exc, PreviewDeclined):
+        return ToolResult.error(
+            "This session's preview is not open in a desktop window; ask the person to open "
+            "the preview pane, then try again."
+        ).text
+    if isinstance(exc, PreviewUndelivered):
+        return ToolResult.error("No desktop window is attached to this session now.").text
+    if isinstance(exc, TimeoutError):
+        return ToolResult.error(f"The preview did not answer within {PREVIEW_TIMEOUT_S:g} s.").text
+    return ToolResult.error(f"The preview could not do that: {exc}").text
+
+
+async def _ask(preview: PreviewPort | None, kind: Kind, payload: dict[str, Any]) -> str:
+    if preview is None:
+        return ToolResult.error("There is no desktop preview in this session.").text
+    try:
+        answer = await preview.request(kind, payload, timeout=PREVIEW_TIMEOUT_S)
+    except (PreviewDeclined, PreviewUndelivered, TimeoutError) as exc:
+        return _failure(exc)
+    if answer.get("ok") is False:
+        return ToolResult.error(str(answer.get("error") or "the page refused the action")).text
+    return json.dumps(dict(answer), ensure_ascii=False)
+
+
+async def drive_preview(args: Mapping[str, Any], *, preview: PreviewPort | None = None) -> str:
+    """The ``drive_preview`` handler (see the module notes)."""
+    try:
+        kind, payload = _drive_payload(args)
+    except ValueError as exc:
+        return ToolResult.error(str(exc)).text
+    return await _ask(preview, kind, payload)
+
+
+async def annotate_preview(args: Mapping[str, Any], *, preview: PreviewPort | None = None) -> str:
+    """The ``annotate_preview`` handler: numbered notes on page elements, shown to the person."""
+    raw: object = args.get("pins")
+    if not isinstance(raw, list) or not raw:
+        return ToolResult.error("pins must be a non-empty list of {selector, note}.").text
+    items = cast(list[object], raw)
+    if len(items) > MAX_PINS:
+        return ToolResult.error(f"at most {MAX_PINS} pins fit in one call.").text
+    pins: list[dict[str, str]] = []
+    for index, item in enumerate(items):
+        if not isinstance(item, Mapping):
+            return ToolResult.error(f"pins[{index}] must be an object.").text
+        entry = cast(Mapping[str, Any], item)
+        try:
+            selector = (_text(entry, "selector", MAX_SELECTOR) or "").strip()
+            note = (_text(entry, "note", MAX_NOTE) or "").strip()
+        except ValueError as exc:
+            return ToolResult.error(f"pins[{index}]: {exc}").text
+        if not selector or not note:
+            return ToolResult.error(f"pins[{index}] needs a selector and a note.").text
+        pins.append({"selector": selector, "note": note})
+    return await _ask(preview, "preview.act", {"action": "annotate", "pins": pins})
+
+
+DRIVE_SCHEMA: dict[str, Any] = {
+    "name": "drive_preview",
+    "description": (
+        "Use the page shown in this session's desktop preview pane. action: navigate (url), "
+        "click (selector), type (selector, text, submit?), scroll (selector, or dx/dy pixels) "
+        "or snapshot (title, address, visible text and the interactive elements). Works only "
+        "while the person has the preview open; secret field values are never returned."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["action"],
+        "properties": {
+            "action": {"type": "string", "enum": list(ACTIONS)},
+            "url": {"type": "string", "description": "For navigate: http(s) or file:/// only."},
+            "selector": {"type": "string", "description": "A CSS selector on the page."},
+            "text": {"type": "string", "description": "For type: the text to enter."},
+            "submit": {"type": "boolean", "description": "For type: press Enter after."},
+            "dx": {"type": "integer", "description": "For scroll: pixels to the right."},
+            "dy": {"type": "integer", "description": "For scroll: pixels down."},
+        },
+    },
+}
+
+ANNOTATE_SCHEMA: dict[str, Any] = {
+    "name": "annotate_preview",
+    "description": (
+        "Point things out on the page in this session's desktop preview: each pin puts a "
+        "numbered note on the element its CSS selector matches, for the person to read."
+    ),
+    "parameters": {
+        "type": "object",
+        "required": ["pins"],
+        "properties": {
+            "pins": {
+                "type": "array",
+                "minItems": 1,
+                "maxItems": MAX_PINS,
+                "items": {
+                    "type": "object",
+                    "required": ["selector", "note"],
+                    "properties": {
+                        "selector": {"type": "string"},
+                        "note": {"type": "string"},
+                    },
+                },
+            }
+        },
+    },
+}
+
+
+def register_tools(registry: ToolRegistry, *, surface: str | None = None) -> bool:
+    """Register both tools for a desktop session (``surface == "gui"``); True when registered."""
+    if surface != DESKTOP_SURFACE:
+        return False
+    registry.register(
+        "drive_preview", PREVIEW_TOOLSET, DRIVE_SCHEMA, drive_preview, traits=ToolTraits()
+    )
+    registry.register(
+        "annotate_preview",
+        PREVIEW_TOOLSET,
+        ANNOTATE_SCHEMA,
+        annotate_preview,
+        traits=ToolTraits(),
+    )
+    return True
