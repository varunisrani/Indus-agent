+import { act, screen, waitFor, within } from "@testing-library/react";
+import { createElement } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { createMockApi, type MockApi } from "../testing/mockApi.ts";
+import { currentLocation, renderApp } from "../testing/render.tsx";
+import { type PluginManifest, pluginRegistry } from "./registry.ts";
+
+let mock: MockApi;
+let restore: () => void;
+
+const HELLO: PluginManifest = {
+  name: "hello",
+  label: "Hello",
+  tab: { path: "/hello", position: "after:skills" },
+  entry: "dist/index.js",
+  slots: ["sessions:top"],
+};
+
+beforeEach(() => {
+  mock = createMockApi();
+  restore = mock.install();
+  vi.spyOn(console, "warn").mockImplementation(() => {});
+});
+
+afterEach(() => {
+  restore();
+  pluginRegistry.clear();
+  for (const el of document.querySelectorAll("[data-indus-plugin]")) el.remove();
+});
+
+function listPlugins(plugins: PluginManifest[]) {
+  // the list is asked once per shell mount; queue a few answers
+  for (let i = 0; i < 4; i += 1) {
+    mock.failNext("GET", "/api/dashboard/plugins", { status: 200, body: { plugins } });
+  }
+}
+
+describe("plugins in the shell", () => {
+  it("a deep link to a plugin tab waits for the plugin instead of falling back", async () => {
+    listPlugins([HELLO]);
+    renderApp("/hello");
+    await waitFor(() =>
+      expect(document.querySelector('script[data-indus-plugin="hello"]')).not.toBeNull(),
+    );
+    expect(currentLocation()).toBe("/hello");
+    act(() => pluginRegistry.register("hello", () => createElement("p", null, "hello tab")));
+    expect(await screen.findByText("hello tab")).toBeTruthy();
+    const nav = within(screen.getByRole("navigation", { name: "Dashboard" }));
+    const links = nav.getAllByRole("link").map((a) => a.textContent);
+    expect(links.indexOf("Hello")).toBe(links.indexOf("Skills") + 1);
+  });
+
+  it("page slots render around their page, also when registered late", async () => {
+    listPlugins([HELLO]);
+    renderApp("/sessions");
+    await waitFor(() => expect(currentLocation()).toBe("/sessions"));
+    act(() =>
+      pluginRegistry.registerSlot("hello", "sessions:top", () =>
+        createElement("p", null, "slot above sessions"),
+      ),
+    );
+    expect(await screen.findByText("slot above sessions")).toBeTruthy();
+  });
+
+  it("no plugin list (older backend) leaves the shell as it was", async () => {
+    renderApp("/no/such/page");
+    await waitFor(() => expect(currentLocation()).toBe("/sessions"));
+  });
+});
diff --git a/apps/web/src/plugins/slots.tsx b/apps/web/src/plugins/slots.tsx
new file mode 100644
index 0000000..9c8cf7f
--- /dev/null
+++ b/apps/web/src/plugins/slots.tsx
@@ -0,0 +1,117 @@
+// Plugin slots (P24-37): named places in the shell and in pages that plugins can fill with
+// `registerSlot(name, slot, Component)`. Several plugins may fill one slot; they render in the
+// order they registered, each inside its own error boundary so a broken plugin hides itself
+// instead of the page. A slot re-renders when a plugin registers late.
+
+import { Component, type ComponentType, type ReactNode, useSyncExternalStore } from "react";
+import { type PluginManifest, type PluginRegistry, pluginRegistry } from "./registry.ts";
+
+/** Shell slots, by name (alphabetical). */
+export const SHELL_SLOTS = [
+  "backdrop",
+  "footer-left",
+  "footer-right",
+  "header-banner",
+  "header-left",
+  "header-right",
+  "overlay",
+  "post-main",
+  "pre-main",
+  "sidebar",
+] as const;
+
+export const SLOT_PAGES = [
+  "sessions",
+  "analytics",
+  "logs",
+  "cron",
+  "skills",
+  "plugins",
+  "config",
+  "env",
+  "chat",
+] as const;
+
+/** Every slot name the shell and pages render. */
+export const KNOWN_SLOTS: readonly string[] = [
+  ...SHELL_SLOTS,
+  ...SLOT_PAGES.flatMap((page) => [`${page}:top`, `${page}:bottom`]),
+];
+
+class SlotBoundary extends Component<{ plugin: string; children: ReactNode }, { failed: boolean }> {
+  override state = { failed: false };
+
+  static getDerivedStateFromError(): { failed: boolean } {
+    return { failed: true };
+  }
+
+  override componentDidCatch(error: unknown): void {
+    // biome-ignore lint/suspicious/noConsole: a plugin's render failure only warns
+    console.warn(`[plugins] ${this.props.plugin} failed to render`, error);
+  }
+
+  override render(): ReactNode {
+    return this.state.failed ? null : this.props.children;
+  }
+}
+
+export function PluginSlot({
+  name,
+  fallback = null,
+  registry = pluginRegistry,
+}: {
+  name: string;
+  fallback?: ReactNode;
+  registry?: PluginRegistry;
+}) {
+  useSyncExternalStore(registry.subscribe, registry.snapshot, registry.snapshot);
+  const entries = registry.slotEntries(name);
+  if (entries.length === 0) return <>{fallback}</>;
+  return (
+    <>
+      {entries.map(({ plugin, component: Slot }) => (
+        <SlotBoundary key={plugin} plugin={plugin}>
+          <Slot />
+        </SlotBoundary>
+      ))}
+    </>
+  );
+}
+
+/** A plugin's page (the route element), with the plugin's own boundary. */
+export function PluginPage({
+  manifest,
+  registry = pluginRegistry,
+}: {
+  manifest: PluginManifest;
+  registry?: PluginRegistry;
+}) {
+  useSyncExternalStore(registry.subscribe, registry.snapshot, registry.snapshot);
+  const Page = registry.component(manifest.name);
+  if (Page === undefined) {
+    const error = registry.loadError(manifest.name);
+    return (
+      <p className="p-6 text-sm text-muted">
+        {error === "LOAD_FAILED"
+          ? `The ${manifest.label} plugin could not be loaded.`
+          : `The ${manifest.label} plugin has not registered its page yet.`}
+      </p>
+    );
+  }
+  return (
+    <SlotBoundary plugin={manifest.name}>
+      <Page />
+    </SlotBoundary>
+  );
+}
+
+const pages = new Map<string, { manifest: PluginManifest; page: ComponentType }>();
+
+/** One stable route component per plugin (so a re-render never remounts the plugin's page). */
+export function pluginPageFor(manifest: PluginManifest): ComponentType {
+  const known = pages.get(manifest.name);
+  if (known !== undefined && known.manifest === manifest) return known.page;
+  const page = () => <PluginPage manifest={manifest} />;
+  pages.set(manifest.name, { manifest, page });
+  return page;
+}
diff --git a/apps/web/src/plugins/usePluginState.ts b/apps/web/src/plugins/usePluginState.ts
new file mode 100644
index 0000000..b3c1acf
--- /dev/null
+++ b/apps/web/src/plugins/usePluginState.ts
@@ -0,0 +1,57 @@
+// The shell's view of the dashboard plugins (P24-37): the manifests of the plugins that are on,
+// whether the first render may finish (every plugin registered, or the wait ran out), and a
+// version that changes whenever a plugin registers, so late registrations re-render the routes.
+
+import { useEffect, useState, useSyncExternalStore } from "react";
+import {
+  fetchManifests,
+  type LoadOptions,
+  loadPlugins,
+  type PluginManifest,
+  type PluginRegistry,
+  pluginRegistry,
+} from "./registry.ts";
+
+export interface PluginState {
+  manifests: PluginManifest[];
+  /** False until the plugins registered or the first-render wait ran out. */
+  settled: boolean;
+  version: number;
+}
+
+export function usePluginState(
+  options: {
+    registry?: PluginRegistry;
+    fetch?: () => Promise<PluginManifest[]>;
+    load?: (manifests: PluginManifest[], options: LoadOptions) => Promise<void>;
+  } = {},
+): PluginState {
+  const registry = options.registry ?? pluginRegistry;
+  const fetchList = options.fetch ?? fetchManifests;
+  const load = options.load ?? loadPlugins;
+  const [manifests, setManifests] = useState<PluginManifest[]>([]);
+  const [settled, setSettled] = useState(false);
+  const version = useSyncExternalStore(registry.subscribe, registry.snapshot, registry.snapshot);
+
+  useEffect(() => {
+    let live = true;
+    setSettled(false);
+    fetchList()
+      .then(async (list) => {
+        if (!live) return;
+        setManifests(list);
+        await load(list, { registry });
+      })
+      .catch(() => {
+        // no plugin list (an older backend, or it failed): the shell runs without plugins
+      })
+      .finally(() => {
+        if (live) setSettled(true);
+      });
+    return () => {
+      live = false;
+    };
+  }, [fetchList, load, registry]);
+
+  return { manifests, settled, version };
+}
