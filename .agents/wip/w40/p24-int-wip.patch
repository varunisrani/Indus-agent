+PASSWORD = "correct-" + "horse-" + "battery-" + "staple"
+CARD = "4111" + "1111" + "1111" + "1111"
+CVC = "9" + "31"
+MASTER = "master-" + "pass-" + "phrase-" + "42"
+SEED = "JBSWY3DPEHPK3PXP"  # the RFC 6238 style demo seed (not a credential)
