+class Outbox:
+    def __init__(self) -> None:
+        self.sent: list[tuple[str, str]] = []
+        self.fail = False
+
+    async def __call__(self, target: Mapping[str, str | None], text: str) -> bool:
+        if self.fail:
+            return False
+        self.sent.append((str(target["chat_id"]), text))
+        return True
+
