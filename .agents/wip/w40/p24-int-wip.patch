@@ -148,4 +152,21 @@ def cron_cmd(ctx: SlashContext, args: str) -> SlashResult:
     return SlashResult()
 
 
-HANDLERS = {"cron": cron_cmd}
+def suggestions_cmd(ctx: SlashContext, args: str) -> SlashResult:
