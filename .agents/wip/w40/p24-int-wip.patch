+def skill_md(name: str, body: str = "Do the thing.\n") -> bytes:
+    return f"---\nname: {name}\ndescription: The {name} skill.\n---\n\n# {name}\n\n{body}".encode()
+
+
+@pytest.fixture(autouse=True)
+def _fresh() -> Iterator[None]:
+    clear_scan_cache()
+    yield
+    clear_scan_cache()
+
