+// @vitest-environment jsdom
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { fakeRest } from "../../settings/fakeRest.ts";
+import { CronOverlay } from "./CronOverlay.tsx";
+
+function job(id: string, name: string, state = "scheduled") {
+  return {
+    id,
+    name,
+    prompt: "summarise the news",
+    schedule: "every 2h",
+    schedule_display: "every 2h",
+    deliver: "local",
+    skills: [],
+    state,
+    enabled: true,
+    paused_reason: null,
+    last_run_at: null,
+    next_run_at: null,
+    last_status: "ok",
+    last_error: null,
+  };
+}
+
+function backend() {
+  const api = fakeRest();
+  api.route("GET", "/api/profiles", { profiles: [{ name: "work" }, { name: "research" }] });
+  api.route("GET", "/api/cron/jobs", (request) => ({
+    status: 200,
+    body: {
+      jobs:
+        request.profile === "research" ? [job("r1", "paper digest")] : [job("w1", "standup notes")],
+    },
+  }));
+  api.route("GET", "/api/cron/blueprints", {
+    blueprints: [
+      {
+        skill: "weekly-review",
+        description: "Review the week",
+        schedule: "0 9 * * 1",
+        prompt: null,
+      },
+    ],
+  });
+  api.route("POST", "/api/cron/jobs/r1/pause", { ok: true });
+  api.route("POST", "/api/cron/jobs", { ok: true });
+  return api;
+}
+
+describe("CronOverlay", () => {
+  it("the aggregated cron list sends pause to the owning profile", async () => {
+    const api = backend();
+    render(<CronOverlay api={api} profile="work" onClose={() => {}} />);
+    expect(await screen.findByText("standup notes")).toBeTruthy();
+    expect(screen.queryByText("paper digest")).toBeNull();
+    fireEvent.click(screen.getByLabelText("All profiles"));
+    const row = (await screen.findByText("paper digest")).closest("tr") as HTMLElement;
+    expect(row.textContent).toContain("research");
+    fireEvent.click(row.querySelector("button") as HTMLButtonElement); // Pause
+    await waitFor(() =>
+      expect(api.calls.some((c) => c.path === "/api/cron/jobs/r1/pause")).toBe(true),
+    );
+    const pause = api.calls.find((c) => c.path === "/api/cron/jobs/r1/pause");
+    expect(pause?.profile).toBe("research"); // never the window's own profile
+  });
+
+  it("a new job can start from a blueprint", async () => {
+    const api = backend();
+    render(<CronOverlay api={api} profile="work" onClose={() => {}} />);
+    fireEvent.click(await screen.findByText("New job"));
+    fireEvent.change(await screen.findByLabelText("Start from"), {
+      target: { value: "weekly-review" },
+    });
+    fireEvent.click(screen.getByText("Save"));
+    await waitFor(() =>
+      expect(api.calls.some((c) => c.method === "POST" && c.path === "/api/cron/jobs")).toBe(true),
+    );
+    const created = api.calls.find((c) => c.method === "POST" && c.path === "/api/cron/jobs");
+    expect(created).toMatchObject({
+      profile: "work",
+      body: { prompt: "Review the week", schedule: "0 9 * * 1", skills: ["weekly-review"] },
+    });
+  });
+});
diff --git a/apps/desktop/src/app/cron/CronOverlay.tsx b/apps/desktop/src/app/cron/CronOverlay.tsx
new file mode 100644
index 0000000..c1a88ec
--- /dev/null
+++ b/apps/desktop/src/app/cron/CronOverlay.tsx
@@ -0,0 +1,327 @@
+// Scheduled jobs (P24-27): the P14 cron jobs of this profile, or of every profile at once
+// ("All profiles": one `GET /api/cron/jobs` per profile, each row tagged with its owner). Every
+// action — pause, resume, run now, edit, delete — goes to the profile that owns the job, never to
+// the window's own. New jobs start blank or from a blueprint (a skill that suggests a schedule).
+// The last run's time, status and (redacted) error are the run history the REST view carries.
+
+import { useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestAnswer, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { LoadState, ManageOverlay, useApi, useRestValue, when } from "../manage/common.tsx";
+
+export interface CronJob {
+  id: string;
+  name: string;
+  prompt: string;
+  schedule: string;
+  schedule_display: string;
+  deliver: string;
+  skills: string[];
+  state: string;
+  enabled: boolean;
+  paused_reason: string | null;
+  last_run_at: string | null;
+  next_run_at: string | null;
+  last_status: string | null;
+  last_error: string | null;
+}
+
+export interface OwnedJob extends CronJob {
+  /** The profile that owns the job (actions go there). */
+  profile: string;
+}
+
+export interface Blueprint {
+  skill: string;
+  description: string;
+  schedule: string | null;
+  prompt: string | null;
+}
+
+interface ProfilesAnswer {
+  profiles: Array<{ name: string }>;
+}
+
+/** The jobs of `profiles` (each tagged); profiles that fail are named, the rest still listed. */
+export async function loadJobs(
+  api: RestLike | null,
+  profiles: readonly string[],
+): Promise<RestAnswer<{ jobs: OwnedJob[]; failed: string[] }>> {
+  const answers = await Promise.all(
+    profiles.map((profile) => rest<{ jobs: CronJob[] }>(api, "GET", "/api/cron/jobs", { profile })),
+  );
+  const jobs: OwnedJob[] = [];
+  const failed: string[] = [];
+  answers.forEach((answer, index) => {
+    const profile = profiles[index] as string;
+    if (answer.ok) for (const job of answer.data.jobs) jobs.push({ ...job, profile });
+    else failed.push(profile);
+  });
+  if (failed.length === profiles.length && answers[0] !== undefined && !answers[0].ok) {
+    return answers[0] as RestAnswer<never>;
+  }
+  return { ok: true, status: 200, data: { jobs, failed } };
+}
+
+/** Send `action` for `job` to its owning profile. */
+export function jobAction(
+  api: RestLike | null,
+  job: OwnedJob,
+  action: "pause" | "resume" | "trigger" | "delete",
+): Promise<RestAnswer<unknown>> {
+  const base = `/api/cron/jobs/${encodeURIComponent(job.id)}`;
+  if (action === "delete") return rest(api, "DELETE", base, { profile: job.profile });
+  return rest(api, "POST", `${base}/${action}`, { profile: job.profile });
+}
+
+function JobForm(props: {
+  api: RestLike | null;
+  profile: string;
+  job?: OwnedJob;
+  blueprints: Blueprint[];
+  onDone: () => void;
+  onCancel: () => void;
+}) {
+  const t = useT();
+  const [name, setName] = useState(props.job?.name ?? "");
+  const [prompt, setPrompt] = useState(props.job?.prompt ?? "");
+  const [schedule, setSchedule] = useState(props.job?.schedule ?? "");
+  const [deliver, setDeliver] = useState(props.job?.deliver ?? "");
+  const [skills, setSkills] = useState<string[]>(props.job?.skills ?? []);
+  const [error, setError] = useState("");
+  const submit = async () => {
+    const body = {
+      name: name.trim() || undefined,
+      prompt,
+      schedule,
+      ...(deliver.trim() === "" ? {} : { deliver: deliver.trim() }),
+      ...(skills.length > 0 ? { skills } : {}),
+    };
+    const answer =
+      props.job === undefined
+        ? await rest(props.api, "POST", "/api/cron/jobs", { profile: props.profile, body })
+        : await rest(props.api, "PUT", `/api/cron/jobs/${encodeURIComponent(props.job.id)}`, {
+            profile: props.job.profile,
+            body,
+          });
+    if (!answer.ok) {
+      setError(answer.message);
+      return;
+    }
+    props.onDone();
+  };
+  return (
+    <form
+      className="manage-card"
+      onSubmit={(e) => {
+        e.preventDefault();
+        void submit();
+      }}
+    >
+      <h3>{props.job === undefined ? t("manage.cron.new") : t("manage.cron.edit")}</h3>
+      {props.job === undefined && props.blueprints.length > 0 && (
+        <label className="manage-field">
+          {t("manage.cron.blueprint")}
+          <select
+            defaultValue=""
+            onChange={(e) => {
+              const plan = props.blueprints.find((b) => b.skill === e.target.value);
+              if (plan === undefined) return;
+              setName(plan.skill);
+              setPrompt(plan.prompt ?? plan.description);
+              setSchedule(plan.schedule ?? "");
+              setSkills([plan.skill]);
+            }}
+          >
+            <option value="">{t("manage.cron.blank")}</option>
+            {props.blueprints.map((plan) => (
+              <option key={plan.skill} value={plan.skill}>
+                {plan.skill}
+              </option>
+            ))}
+          </select>
+        </label>
+      )}
+      <label className="manage-field">
+        {t("manage.cron.name")}
+        <input value={name} onChange={(e) => setName(e.target.value)} />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.prompt")}
+        <textarea value={prompt} onChange={(e) => setPrompt(e.target.value)} rows={3} required />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.schedule")}
+        <input
+          value={schedule}
+          onChange={(e) => setSchedule(e.target.value)}
+          placeholder="every 2h"
+          required
+        />
+      </label>
+      <label className="manage-field">
+        {t("manage.cron.deliver")}
+        <input value={deliver} onChange={(e) => setDeliver(e.target.value)} placeholder="local" />
+      </label>
+      {error !== "" && (
+        <p className="manage-error" role="alert">
+          {error}
+        </p>
+      )}
+      <div className="manage-inline">
+        <button type="submit" className="button button-primary">
+          {t("manage.save")}
+        </button>
+        <button type="button" className="button button-secondary" onClick={props.onCancel}>
+          {t("manage.cancel")}
+        </button>
+      </div>
+    </form>
+  );
+}
+
+export function CronOverlay(props: {
+  api?: RestLike | null;
+  profile: string | null;
+  onClose: () => void;
+}) {
+  const t = useT();
+  const api = useApi(props.api);
+  const own = props.profile ?? "default";
+  const [all, setAll] = useState(false);
+  const [editing, setEditing] = useState<OwnedJob | "new" | null>(null);
+  const [note, setNote] = useState("");
+  const profiles = useRestValue<ProfilesAnswer>(() => rest(api, "GET", "/api/profiles"), [api]);
+  const names = all && profiles.state === "ok" ? profiles.data.profiles.map((p) => p.name) : [own];
+  const jobs = useRestValue(() => loadJobs(api, names), [api, names.join("\n")]);
+  const blueprints = useRestValue<{ blueprints: Blueprint[] }>(
+    () => rest(api, "GET", "/api/cron/blueprints", { profile: own }),
+    [api, own],
+  );
+
+  const act = async (job: OwnedJob, action: "pause" | "resume" | "trigger" | "delete") => {
+    const answer = await jobAction(api, job, action);
+    setNote(answer.ok ? "" : answer.message);
+    jobs.reload();
+  };
+
+  return (
+    <ManageOverlay title={t("nav.cron")} onClose={props.onClose}>
+      <div className="manage-inline">
+        <label className="manage-inline">
+          <input type="checkbox" checked={all} onChange={(e) => setAll(e.target.checked)} />
+          {t("manage.cron.allProfiles")}
+        </label>
+        <button type="button" className="button button-primary" onClick={() => setEditing("new")}>
+          {t("manage.cron.new")}
+        </button>
+      </div>
+      {note !== "" && (
+        <p className="manage-error" role="alert">
+          {note}
+        </p>
+      )}
+      {editing !== null && (
+        <JobForm
+          api={api}
+          profile={own}
+          {...(editing === "new" ? {} : { job: editing })}
+          blueprints={blueprints.state === "ok" ? blueprints.data.blueprints : []}
+          onDone={() => {
+            setEditing(null);
+            jobs.reload();
+          }}
+          onCancel={() => setEditing(null)}
+        />
+      )}
+      <LoadState value={jobs}>
+        {(data) => (
+          <>
+            {data.failed.length > 0 && (
+              <p className="manage-muted">
+                {t("manage.cron.someFailed", { names: data.failed.join(", ") })}
+              </p>
+            )}
+            <table className="manage-table">
+              <thead>
+                <tr>
+                  <th>{t("manage.cron.name")}</th>
+                  {all && <th>{t("manage.cron.profile")}</th>}
+                  <th>{t("manage.cron.schedule")}</th>
+                  <th>{t("manage.cron.lastRun")}</th>
+                  <th>{t("manage.cron.next")}</th>
+                  <th />
+                </tr>
+              </thead>
+              <tbody>
+                {data.jobs.map((job) => (
+                  <tr key={`${job.profile}/${job.id}`} data-job={job.id}>
+                    <td>
+                      <strong>{job.name || job.id}</strong>
+                      <div className="manage-muted">{job.state}</div>
+                    </td>
+                    {all && <td>{job.profile}</td>}
+                    <td>{job.schedule_display}</td>
+                    <td>
+                      {when(job.last_run_at)}
+                      {job.last_status !== null && (
+                        <div className="manage-muted">{job.last_status}</div>
+                      )}
+                      {job.last_error !== null && (
+                        <div className="manage-error">{job.last_error}</div>
+                      )}
+                    </td>
+                    <td>{when(job.next_run_at)}</td>
+                    <td>
+                      <span className="manage-inline">
+                        {job.state === "paused" || !job.enabled ? (
+                          <button
+                            type="button"
+                            className="button button-secondary"
+                            onClick={() => void act(job, "resume")}
+                          >
+                            {t("manage.cron.resume")}
+                          </button>
+                        ) : (
+                          <button
+                            type="button"
+                            className="button button-secondary"
+                            onClick={() => void act(job, "pause")}
+                          >
+                            {t("manage.cron.pause")}
+                          </button>
+                        )}
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void act(job, "trigger")}
+                        >
+                          {t("manage.cron.runNow")}
+                        </button>
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => setEditing(job)}
+                        >
+                          {t("manage.cron.edit")}
+                        </button>
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void act(job, "delete")}
+                        >
+                          {t("manage.delete")}
+                        </button>
+                      </span>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+            {data.jobs.length === 0 && <p className="manage-muted">{t("manage.cron.none")}</p>}
+          </>
+        )}
+      </LoadState>
+    </ManageOverlay>
+  );
+}
diff --git a/apps/desktop/src/app/learning-map/LearningMap.tsx b/apps/desktop/src/app/learning-map/LearningMap.tsx
new file mode 100644
index 0000000..90cd0fe
--- /dev/null
+++ b/apps/desktop/src/app/learning-map/LearningMap.tsx
@@ -0,0 +1,281 @@
+// The learning map (P24-28): skills and memories as a force-directed graph (`layout.ts`), with a
+// playback slider over time, filters all / used / learned, node edit (a skill's on/off switch) and
+// delete (a memory), and Share, which copies a code holding the layout only.
+//
+// Data: `GET /api/learning/graph` (`{nodes, edges}`; memories with timestamps and the skill they
+// were learned with) when the server has it; otherwise the skills list alone (`GET /api/skills`,
+// linked by category, no times — playback then has nothing to replay).
+
+import { useMemo, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { type RestAnswer, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { copyText } from "../clipboard.ts";
+import { LoadState, PageFrame, useApi, useRestValue } from "../manage/common.tsx";
+import {
+  graphFromSkills,
+  type LearningGraph,
+  type LearningNode,
+  layout,
+  type MapFilter,
+  readShareCode,
+  ShareCodeError,
+  shareCode,
+  timeRange,
+  visible,
+} from "./layout.ts";
+
+const BOX = { width: 900, height: 560 };
+
+/** Stable keys for shared points (they carry no ids): kind and position, numbered on a clash. */
+function keyed<T extends { kind: string; x: number; y: number }>(
+  items: readonly T[],
+): Array<{ key: string; node: T }> {
+  const seen = new Map<string, number>();
+  return items.map((node) => {
+    const base = `${node.kind}:${node.x}:${node.y}`;
+    const count = (seen.get(base) ?? 0) + 1;
+    seen.set(base, count);
+    return { key: `${base}:${count}`, node };
+  });
+}
+
+/** The graph, from the learning read when the server has one, else from the skills list. */
+export async function loadGraph(
+  api: RestLike | null,
+  profile: string | null,
+): Promise<RestAnswer<{ graph: LearningGraph; full: boolean }>> {
+  const full = await rest<LearningGraph>(api, "GET", "/api/learning/graph", { profile });
+  if (full.ok && Array.isArray(full.data.nodes))
+    return { ...full, data: { graph: full.data, full: true } };
+  const skills = await rest<{
+    skills: Array<{ name: string; category: string; enabled: boolean; source?: string }>;
+  }>(api, "GET", "/api/skills", { profile });
+  if (!skills.ok) return skills;
+  return { ...skills, data: { graph: graphFromSkills(skills.data.skills), full: false } };
+}
+
+function MapView(props: {
+  api: RestLike | null;
+  profile: string | null;
+  graph: LearningGraph;
+  full: boolean;
+  reload: () => void;
+}) {
+  const t = useT();
+  const [filter, setFilter] = useState<MapFilter>("all");
+  const range = timeRange(props.graph);
+  const [until, setUntil] = useState<number | null>(null);
+  const [selected, setSelected] = useState<LearningNode | null>(null);
+  const [note, setNote] = useState("");
+  const shown = useMemo(() => visible(props.graph, filter, until), [props.graph, filter, until]);
+  const placed = useMemo(() => layout(props.graph, BOX), [props.graph]);
+  const [importText, setImportText] = useState("");
+
+  const toggleSkill = async (node: LearningNode) => {
+    const answer = await rest(props.api, "POST", "/api/skills/toggle", {
+      profile: props.profile,
+      body: { name: node.label, enabled: !node.enabled },
+    });
+    setNote(answer.ok ? "" : answer.message);
+    props.reload();
+  };
+  const deleteMemory = async (node: LearningNode) => {
+    const answer = await rest(
+      props.api,
+      "DELETE",
+      `/api/learning/nodes/${encodeURIComponent(node.id)}`,
+      {
+        profile: props.profile,
+      },
+    );
+    setNote(answer.ok ? "" : answer.message);
+    setSelected(null);
+    props.reload();
+  };
+  const share = async () => {
+    const code = shareCode(shown, placed, BOX);
+    const copied = await copyText(code);
+    setNote(copied ? t("manage.map.copied") : code);
+  };
+  let imported: ReturnType<typeof readShareCode> | null = null;
+  let importError = "";
+  if (importText.trim() !== "") {
+    try {
+      imported = readShareCode(importText);
+    } catch (error) {
+      importError = error instanceof ShareCodeError ? error.message : t("manage.failed");
+    }
+  }
+
+  return (
+    <div className="manage-body">
+      <div className="manage-inline">
+        {(["all", "used", "learned"] as const).map((f) => (
+          <button
+            key={f}
+            type="button"
+            className="button button-secondary"
+            aria-pressed={filter === f}
+            onClick={() => setFilter(f)}
+          >
+            {t(`manage.map.filter.${f}`)}
+          </button>
+        ))}
+        <button type="button" className="button button-secondary" onClick={() => void share()}>
+          {t("manage.map.share")}
+        </button>
+      </div>
+      {range !== null && (
+        <label className="manage-field">
+          {t("manage.map.playback")}
+          <input
+            type="range"
+            min={range.from}
+            max={range.to}
+            value={until ?? range.to}
+            onChange={(e) => setUntil(Number(e.target.value))}
+          />
+        </label>
+      )}
+      {!props.full && <p className="manage-muted">{t("manage.map.skillsOnly")}</p>}
+      <svg
+        className="manage-map"
+        viewBox={`0 0 ${BOX.width} ${BOX.height}`}
+        role="img"
+        aria-label={t("nav.learning-map")}
+      >
+        {shown.edges.map((edge) => {
+          const a = placed.get(edge.from);
+          const b = placed.get(edge.to);
+          if (a === undefined || b === undefined) return null;
+          return (
+            <line
+              key={`${edge.from}->${edge.to}`}
+              x1={a.x}
+              y1={a.y}
+              x2={b.x}
+              y2={b.y}
+              stroke="var(--color-line)"
+            />
+          );
+        })}
+        {shown.nodes.map((node) => {
+          const at = placed.get(node.id);
+          if (at === undefined) return null;
+          return (
+            // biome-ignore lint/a11y/useSemanticElements: SVG has no <button>; the group takes its role
+            <g
+              key={node.id}
+              data-node={node.id}
+              role="button"
+              tabIndex={0}
+              aria-label={node.label}
+              onClick={() => setSelected(node)}
+              onKeyDown={(e) => {
+                if (e.key === "Enter" || e.key === " ") setSelected(node);
+              }}
+              style={{ cursor: "pointer" }}
+            >
+              <circle
+                cx={at.x}
+                cy={at.y}
+                r={at.r}
+                fill={node.kind === "skill" ? "var(--color-accent)" : "var(--color-ok)"}
+                opacity={node.enabled ? 0.9 : 0.35}
+              />
+              <title>{node.label}</title>
+            </g>
+          );
+        })}
+      </svg>
+      <p className="manage-muted" data-testid="map-count">
+        {t("manage.map.count", { count: shown.nodes.length })}
+      </p>
+      {selected !== null && (
+        <div className="manage-card" role="dialog" aria-label={selected.label}>
+          <h3>{selected.label}</h3>
+          <p className="manage-muted">{selected.category}</p>
+          {selected.kind === "skill" ? (
+            <button
+              type="button"
+              className="button button-secondary"
+              onClick={() => void toggleSkill(selected)}
+            >
+              {selected.enabled ? t("manage.map.disable") : t("manage.map.enable")}
+            </button>
+          ) : (
+            props.full && (
+              <button
+                type="button"
+                className="button button-secondary"
+                onClick={() => void deleteMemory(selected)}
+              >
+                {t("manage.delete")}
+              </button>
+            )
+          )}
+          <button
+            type="button"
+            className="button button-secondary"
+            onClick={() => setSelected(null)}
+          >
+            {t("common.close")}
+          </button>
+        </div>
+      )}
+      {note !== "" && (
+        <p className="manage-muted manage-code" role="status">
+          {note}
+        </p>
+      )}
+      <label className="manage-field">
+        {t("manage.map.import")}
+        <textarea rows={2} value={importText} onChange={(e) => setImportText(e.target.value)} />
+      </label>
+      {importError !== "" && <p className="manage-error">{importError}</p>}
+      {imported !== null && (
+        <svg
+          className="manage-map"
+          viewBox="0 0 1 1"
+          role="img"
+          aria-label={t("manage.map.importedMap")}
+        >
+          {keyed(imported.nodes).map(({ key, node: n }) => (
+            <circle
+              key={key}
+              cx={n.x}
+              cy={n.y}
+              r={0.008}
+              fill={n.kind === "skill" ? "var(--color-accent)" : "var(--color-ok)"}
+            />
+          ))}
+        </svg>
+      )}
+    </div>
+  );
+}
+
+export function LearningMap(props: { api?: RestLike | null; profile: string | null }) {
+  const t = useT();
+  const api = useApi(props.api);
+  const graph = useRestValue(() => loadGraph(api, props.profile), [api, props.profile]);
+  return (
+    <PageFrame title={t("nav.learning-map")} id="learning-map">
+      <LoadState value={graph}>
+        {(data) =>
+          data.graph.nodes.length === 0 ? (
+            <p className="manage-muted">{t("manage.map.empty")}</p>
+          ) : (
+            <MapView
+              api={api}
+              profile={props.profile}
+              graph={data.graph}
+              full={data.full}
+              reload={graph.reload}
+            />
+          )
+        }
+      </LoadState>
+    </PageFrame>
+  );
+}
diff --git a/apps/desktop/src/app/learning-map/layout.test.ts b/apps/desktop/src/app/learning-map/layout.test.ts
new file mode 100644
index 0000000..79b86b3
--- /dev/null
+++ b/apps/desktop/src/app/learning-map/layout.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from "vitest";
+import {
+  graphFromSkills,
+  type LearningGraph,
+  type LearningNode,
+  layout,
+  readShareCode,
+  SHARE_PREFIX,
+  ShareCodeError,
+  shareCode,
+  timeRange,
+  visible,
+} from "./layout.ts";
+
+function node(id: string, extra: Partial<LearningNode> = {}): LearningNode {
+  return {
+    id,
+    kind: "skill",
+    label: `Label of ${id}`,
+    category: "research",
+    useCount: 0,
+    createdBy: null,
+    timestamp: null,
+    enabled: true,
+    ...extra,
+  };
+}
+
+const GRAPH: LearningGraph = {
+  nodes: [
+    node("s1", { label: "pdf-summariser", useCount: 9, timestamp: 100 }),
+    node("s2", { label: "git-bisect-helper", createdBy: "agent", timestamp: 200 }),
+    node("m1", {
+      kind: "memory",
+      label: "The user's dog is called Pixel",
+      createdBy: "agent",
+      timestamp: 300,
+      useCount: 2,
+    }),
+    node("m2", { kind: "memory", label: "Prefers tabs over spaces", timestamp: 400 }),
+  ],
+  edges: [
+    { from: "m1", to: "s1" },
+    { from: "s1", to: "s2" },
+    { from: "m2", to: "ghost" },
+  ],
+};
+const BOX = { width: 900, height: 560 };
+
+describe("learning map layout", () => {
+  it("is deterministic and stays inside the box", () => {
+    const one = layout(GRAPH, BOX);
+    const two = layout(GRAPH, BOX);
+    expect([...one.entries()]).toEqual([...two.entries()]);
+    for (const at of one.values()) {
+      expect(at.x).toBeGreaterThanOrEqual(10);
+      expect(at.x).toBeLessThanOrEqual(BOX.width - 10);
+      expect(at.y).toBeGreaterThanOrEqual(10);
+      expect(at.y).toBeLessThanOrEqual(BOX.height - 10);
+    }
+    expect((one.get("s1")?.r ?? 0) > (one.get("s2")?.r ?? 0)).toBe(true); // used more, drawn bigger
+  });
+
+  it("the layout share string contains no node text", () => {
+    const placed = layout(GRAPH, BOX);
+    const code = shareCode(GRAPH, placed, BOX);
+    expect(code.startsWith(SHARE_PREFIX)).toBe(true);
+    const decoded = atob(code.slice(SHARE_PREFIX.length).replace(/-/g, "+").replace(/_/g, "/"));
+    for (const n of GRAPH.nodes) {
+      for (const text of [n.id, n.label, n.category, "Pixel", "tabs"]) {
+        expect(decoded).not.toContain(text); // short ids may match base64 by chance, so the text
+        if (text.length >= 6) expect(code).not.toContain(text); // check is on the decoded body
+      }
+    }
+    expect(Object.keys(JSON.parse(decoded)).sort()).toEqual(["e", "k", "p", "v"]);
+  });
+
+  it("a share code round-trips the shape: kinds, positions and edges", () => {
+    const placed = layout(GRAPH, BOX);
+    const shared = readShareCode(shareCode(GRAPH, placed, BOX));
+    expect(shared.nodes.map((n) => n.kind)).toEqual(["skill", "skill", "memory", "memory"]);
+    expect(shared.edges).toEqual([
+      [2, 0],
+      [0, 1],
+    ]); // the dangling edge is not shared
+    const s1 = placed.get("s1");
+    expect(shared.nodes[0]?.x).toBeCloseTo((s1?.x ?? 0) / BOX.width, 3);
+    for (const bad of ["", "xyz", `${SHARE_PREFIX}!!!`, `${SHARE_PREFIX}${btoa('{"v":9}')}`]) {
+      expect(() => readShareCode(bad)).toThrow(ShareCodeError);
+    }
+  });
+
+  it("filters and playback pick the right nodes", () => {
+    expect(visible(GRAPH, "used", null).nodes.map((n) => n.id)).toEqual(["s1", "m1"]);
+    expect(visible(GRAPH, "learned", null).nodes.map((n) => n.id)).toEqual(["s2", "m1"]);
+    const early = visible(GRAPH, "all", 250);
+    expect(early.nodes.map((n) => n.id)).toEqual(["s1", "s2"]);
+    expect(early.edges).toEqual([{ from: "s1", to: "s2" }]);
+    expect(timeRange(GRAPH)).toEqual({ from: 100, to: 400 });
+    expect(timeRange({ nodes: [node("x")], edges: [] })).toBeNull();
+  });
+
+  it("a skills-only graph links each category", () => {
+    const graph = graphFromSkills([
+      { name: "a", category: "web", enabled: true },
+      { name: "b", category: "web", enabled: false },
+      { name: "c", category: "", enabled: true },
+    ]);
+    expect(graph.nodes.map((n) => n.id)).toEqual(["skill:a", "skill:b", "skill:c"]);
+    expect(graph.edges).toEqual([{ from: "skill:a", to: "skill:b" }]);
+  });
+});
diff --git a/apps/desktop/src/app/learning-map/layout.ts b/apps/desktop/src/app/learning-map/layout.ts
new file mode 100644
index 0000000..6bdf34c
--- /dev/null
+++ b/apps/desktop/src/app/learning-map/layout.ts
@@ -0,0 +1,295 @@
+// The learning map's geometry (P24-28): a deterministic force-directed layout of skills and
+// memories, the filters (all / used / learned) and time playback, and the share code.
+//
+// Layout: every node starts on a circle at an angle taken from a hash of its id, so the same graph
+// always draws the same picture; then a fixed number of steps applies pairwise repulsion, a spring
+// along each edge and a pull toward the centre, with a step size that cools linearly. Older nodes
+// (by timestamp rank) are pulled toward a wider ring, so the newest learning sits near the middle.
+//
+// Share code: `ilm1.` + base64url(JSON {v, k, p, e}) — node kinds (0 skill, 1 memory), positions
+// quantised to 0..4095 in the drawing box, and edges as index pairs. It never carries a node's id,
+// label, category, use count or any memory text: sharing shows the shape of what was learned,
+// never what it says.
+
+export type NodeKind = "skill" | "memory";
+export type MapFilter = "all" | "used" | "learned";
+
+export interface LearningNode {
+  readonly id: string;
+  readonly kind: NodeKind;
+  readonly label: string;
+  readonly category: string;
+  readonly useCount: number;
+  /** Who made it: the agent learning on its own, the person, or unknown. */
+  readonly createdBy: "agent" | "user" | null;
+  /** Unix seconds, null when unknown. */
+  readonly timestamp: number | null;
+  readonly enabled: boolean;
+}
+
+export interface LearningEdge {
+  readonly from: string;
+  readonly to: string;
+}
+
+export interface LearningGraph {
+  readonly nodes: readonly LearningNode[];
+  readonly edges: readonly LearningEdge[];
+}
+
+export interface Placed {
+  readonly x: number;
+  readonly y: number;
+  readonly r: number;
+}
+
+export interface LayoutOptions {
+  width: number;
+  height: number;
+  iterations?: number;
+}
+
+export const SHARE_PREFIX = "ilm1.";
+const GRID = 4095;
+const MAX_LAYOUT_NODES = 600;
+
+function hash(text: string): number {
+  let h = 2166136261;
+  for (let i = 0; i < text.length; i += 1) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 16777619);
+  }
+  return h >>> 0;
+}
+
+export function radiusOf(node: Pick<LearningNode, "useCount" | "kind">): number {
+  const base = node.kind === "skill" ? 6 : 4;
+  return base + Math.min(10, Math.log2(1 + Math.max(0, node.useCount)) * 2);
+}
+
+/** Positions for every node of `graph` in a `width` × `height` box (deterministic). */
+export function layout(graph: LearningGraph, options: LayoutOptions): Map<string, Placed> {
+  const nodes = graph.nodes.slice(0, MAX_LAYOUT_NODES);
+  const n = nodes.length;
+  const cx = options.width / 2;
+  const cy = options.height / 2;
+  const span = Math.min(options.width, options.height) / 2 - 20;
+  const index = new Map(nodes.map((node, i) => [node.id, i]));
+  const order = nodes
+    .map((node, i) => ({ i, ts: node.timestamp ?? Number.POSITIVE_INFINITY }))
+    .sort((a, b) => a.ts - b.ts);
+  const age = new Array<number>(n).fill(0);
+  order.forEach((entry, rank) => {
+    age[entry.i] = n <= 1 ? 0 : 1 - rank / (n - 1); // 1 = oldest, 0 = newest
+  });
+  const xs = new Float64Array(n);
+  const ys = new Float64Array(n);
+  nodes.forEach((node, i) => {
+    const angle = ((hash(node.id) % 3600) / 3600) * Math.PI * 2;
+    const ring = span * (0.25 + 0.6 * (age[i] ?? 0));
+    xs[i] = cx + Math.cos(angle) * ring;
+    ys[i] = cy + Math.sin(angle) * ring;
+  });
+  const edges = graph.edges
+    .map((e) => [index.get(e.from), index.get(e.to)] as const)
+    .filter(
+      (pair): pair is readonly [number, number] => pair[0] !== undefined && pair[1] !== undefined,
+    );
+  const steps = options.iterations ?? 200;
+  const ideal = Math.max(18, span / Math.sqrt(Math.max(1, n)));
+  for (let step = 0; step < steps; step += 1) {
+    const cool = 1 - step / steps;
+    const dx = new Float64Array(n);
+    const dy = new Float64Array(n);
+    for (let a = 0; a < n; a += 1) {
+      for (let b = a + 1; b < n; b += 1) {
+        let ex = (xs[a] as number) - (xs[b] as number);
+        let ey = (ys[a] as number) - (ys[b] as number);
+        let d2 = ex * ex + ey * ey;
+        if (d2 < 0.01) {
+          ex = ((a * 7 + b) % 5) - 2 || 1;
+          ey = ((a + b * 3) % 5) - 2 || 1;
+          d2 = ex * ex + ey * ey;
+        }
+        const force = (ideal * ideal) / d2;
+        dx[a] = (dx[a] as number) + ex * force;
+        dy[a] = (dy[a] as number) + ey * force;
+        dx[b] = (dx[b] as number) - ex * force;
+        dy[b] = (dy[b] as number) - ey * force;
+      }
+    }
+    for (const [a, b] of edges) {
+      const ex = (xs[a] as number) - (xs[b] as number);
+      const ey = (ys[a] as number) - (ys[b] as number);
+      const d = Math.sqrt(ex * ex + ey * ey) || 1;
+      const pull = (d - ideal) / d / 4;
+      dx[a] = (dx[a] as number) - ex * pull;
+      dy[a] = (dy[a] as number) - ey * pull;
+      dx[b] = (dx[b] as number) + ex * pull;
+      dy[b] = (dy[b] as number) + ey * pull;
+    }
+    for (let i = 0; i < n; i += 1) {
+      const ring = span * (0.15 + 0.7 * (age[i] ?? 0));
+      const ox = (xs[i] as number) - cx;
+      const oy = (ys[i] as number) - cy;
+      const dist = Math.sqrt(ox * ox + oy * oy) || 1;
+      dx[i] = (dx[i] as number) - (ox / dist) * (dist - ring) * 0.1;
+      dy[i] = (dy[i] as number) - (oy / dist) * (dist - ring) * 0.1;
+      const len = Math.sqrt((dx[i] as number) ** 2 + (dy[i] as number) ** 2) || 1;
+      const limit = Math.max(0.5, ideal * cool);
+      xs[i] = Math.min(
+        options.width - 10,
+        Math.max(10, (xs[i] as number) + ((dx[i] as number) / len) * Math.min(len, limit)),
+      );
+      ys[i] = Math.min(
+        options.height - 10,
+        Math.max(10, (ys[i] as number) + ((dy[i] as number) / len) * Math.min(len, limit)),
+      );
+    }
+  }
+  const out = new Map<string, Placed>();
+  nodes.forEach((node, i) => {
+    out.set(node.id, { x: xs[i] as number, y: ys[i] as number, r: radiusOf(node) });
+  });
+  return out;
+}
+
+/** The nodes `filter` keeps that existed by `until` (unix seconds; null = now), with their edges. */
+export function visible(
+  graph: LearningGraph,
+  filter: MapFilter,
+  until: number | null,
+): LearningGraph {
+  const nodes = graph.nodes.filter((node) => {
+    if (filter === "used" && node.useCount <= 0) return false;
+    if (filter === "learned" && node.createdBy !== "agent") return false;
+    if (until !== null && node.timestamp !== null && node.timestamp > until) return false;
+    return true;
+  });
+  const kept = new Set(nodes.map((node) => node.id));
+  return { nodes, edges: graph.edges.filter((e) => kept.has(e.from) && kept.has(e.to)) };
+}
+
+/** The playback range: earliest and latest known timestamps (null without any). */
+export function timeRange(graph: LearningGraph): { from: number; to: number } | null {
+  const stamps = graph.nodes.map((n) => n.timestamp).filter((t): t is number => t !== null);
+  if (stamps.length === 0) return null;
+  return { from: Math.min(...stamps), to: Math.max(...stamps) };
+}
+
+function toBase64Url(text: string): string {
+  const bytes = new TextEncoder().encode(text);
+  let binary = "";
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+function fromBase64Url(code: string): string {
+  const padded = code
+    .replace(/-/g, "+")
+    .replace(/_/g, "/")
+    .padEnd(Math.ceil(code.length / 4) * 4, "=");
+  const binary = atob(padded);
+  const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
+  return new TextDecoder().decode(bytes);
+}
+
+/** The share code of a drawn map: kinds, quantised positions and edges only. */
+export function shareCode(
+  graph: LearningGraph,
+  placed: ReadonlyMap<string, Placed>,
+  box: { width: number; height: number },
+): string {
+  const nodes = graph.nodes.filter((node) => placed.has(node.id));
+  const index = new Map(nodes.map((node, i) => [node.id, i]));
+  const q = (value: number, size: number) =>
+    Math.max(0, Math.min(GRID, Math.round((value / Math.max(1, size)) * GRID)));
+  const body = {
+    v: 1,
+    k: nodes.map((node) => (node.kind === "skill" ? 0 : 1)),
+    p: nodes.map((node) => {
+      const at = placed.get(node.id) as Placed;
+      return [q(at.x, box.width), q(at.y, box.height)];
+    }),
+    e: graph.edges
+      .map((edge) => [index.get(edge.from), index.get(edge.to)])
+      .filter((pair): pair is [number, number] => pair[0] !== undefined && pair[1] !== undefined),
+  };
+  return `${SHARE_PREFIX}${toBase64Url(JSON.stringify(body))}`;
+}
+
+export interface SharedMap {
+  nodes: Array<{ kind: NodeKind; x: number; y: number }>;
+  edges: Array<[number, number]>;
+}
+
+export class ShareCodeError extends Error {}
+
+/** Read a share code into fractions of the box (0..1); refuses anything else. */
+export function readShareCode(code: string): SharedMap {
+  const trimmed = code.trim();
+  if (!trimmed.startsWith(SHARE_PREFIX))
+    throw new ShareCodeError("this is not a learning map code");
+  let body: { v?: unknown; k?: unknown; p?: unknown; e?: unknown };
+  try {
+    body = JSON.parse(fromBase64Url(trimmed.slice(SHARE_PREFIX.length))) as typeof body;
+  } catch {
+    throw new ShareCodeError("the code is damaged");
+  }
+  if (body.v !== 1 || !Array.isArray(body.k) || !Array.isArray(body.p) || !Array.isArray(body.e)) {
+    throw new ShareCodeError("the code is from another version");
+  }
+  const kinds = body.k as unknown[];
+  const points = body.p as unknown[];
+  if (kinds.length !== points.length || kinds.length > 5000)
+    throw new ShareCodeError("the code is damaged");
+  const nodes = kinds.map((kind, i) => {
+    const point = points[i] as unknown;
+    if (!Array.isArray(point) || point.length !== 2 || (kind !== 0 && kind !== 1)) {
+      throw new ShareCodeError("the code is damaged");
+    }
+    const [x, y] = point as [unknown, unknown];
+    if (typeof x !== "number" || typeof y !== "number")
+      throw new ShareCodeError("the code is damaged");
+    return { kind: (kind === 0 ? "skill" : "memory") as NodeKind, x: x / GRID, y: y / GRID };
+  });
+  const edges = (body.e as unknown[]).filter(
+    (pair): pair is [number, number] =>
+      Array.isArray(pair) &&
+      pair.length === 2 &&
+      Number.isInteger(pair[0]) &&
+      Number.isInteger(pair[1]) &&
+      (pair[0] as number) < nodes.length &&
+      (pair[1] as number) < nodes.length,
+  );
+  return { nodes, edges };
+}
+
+/** A graph from the skills list alone (no learning-graph read on the server yet). */
+export function graphFromSkills(
+  skills: ReadonlyArray<{ name: string; category: string; enabled: boolean; source?: string }>,
+): LearningGraph {
+  const nodes: LearningNode[] = skills.map((skill) => ({
+    id: `skill:${skill.name}`,
+    kind: "skill",
+    label: skill.name,
+    category: skill.category,
+    useCount: 0,
+    createdBy: skill.source === "agent" ? "agent" : null,
+    timestamp: null,
+    enabled: skill.enabled,
+  }));
+  const edges: LearningEdge[] = [];
+  const byCategory = new Map<string, string[]>();
+  for (const node of nodes) {
+    if (node.category === "") continue;
+    const group = byCategory.get(node.category) ?? [];
+    group.push(node.id);
+    byCategory.set(node.category, group);
+  }
+  for (const group of byCategory.values()) {
+    for (let i = 1; i < group.length; i += 1)
+      edges.push({ from: group[0] as string, to: group[i] as string });
+  }
+  return { nodes, edges };
+}
diff --git a/apps/desktop/src/app/manage/common.tsx b/apps/desktop/src/app/manage/common.tsx
new file mode 100644
index 0000000..223fec5
--- /dev/null
+++ b/apps/desktop/src/app/manage/common.tsx
@@ -0,0 +1,224 @@
+// Shared pieces of the management pages (P24-27, P24-28): loading a REST value, the page frame,
+// the restart banner and its mark.
+//
+// The restart banner: a change the daemon picks up only on restart (a messaging credential, an
+// allowlist) leaves a mark `{instanceId}` — the daemon instance that was live when the change was
+// saved — in this window's session storage, per profile. The banner shows while the window's
+// connection still reports that instance; a reconnect to the same instance keeps it, a new
+// instance id (the daemon restarted) clears it. "Restart now" asks the daemon to restart.
+
+import * as Dialog from "@radix-ui/react-dialog";
+import { X } from "lucide-react";
+import { type DependencyList, type ReactNode, useCallback, useEffect, useState } from "react";
+import { useT } from "../../i18n/index.tsx";
+import { bridgeRest, type RestAnswer, type RestLike } from "../../settings/settingsApi.ts";
+import { Loader } from "../Loader.tsx";
+import "./manage.css";
+
+export type Loaded<T> =
+  | { readonly state: "loading" }
+  | { readonly state: "ok"; readonly data: T }
+  | { readonly state: "error"; readonly code: string; readonly message: string };
+
+/** Load a REST value; `reload()` loads it again. A late answer after unmount is dropped. */
+export function useRestValue<T>(
+  load: () => Promise<RestAnswer<T>>,
+  deps: DependencyList,
+): Loaded<T> & { reload: () => void } {
+  const [value, setValue] = useState<Loaded<T>>({ state: "loading" });
+  const [serial, setSerial] = useState(0);
+  // biome-ignore lint/correctness/useExhaustiveDependencies: the caller names what the load reads
+  useEffect(() => {
+    let live = true;
+    setValue((current) => (current.state === "ok" ? current : { state: "loading" }));
+    void load().then((answer) => {
+      if (!live) return;
+      setValue(
+        answer.ok
+          ? { state: "ok", data: answer.data }
+          : { state: "error", code: answer.code, message: answer.message },
+      );
+    });
+    return () => {
+      live = false;
+    };
+  }, [...deps, serial]);
+  const reload = useCallback(() => setSerial((n) => n + 1), []);
+  return { ...value, reload };
+}
+
+/** The REST proxy of this window (tests pass a fake). */
+export function useApi(api?: RestLike | null): RestLike | null {
+  return api === undefined ? bridgeRest() : api;
+}
+
+export function PageFrame(props: {
+  title: string;
+  id: string;
+  actions?: ReactNode;
+  children: ReactNode;
+}) {
+  return (
+    <section className="manage-page" aria-labelledby={`${props.id}-title`}>
+      <header className="manage-header">
+        <h1 id={`${props.id}-title`}>{props.title}</h1>
+        {props.actions !== undefined && <div className="manage-actions">{props.actions}</div>}
+      </header>
+      <div className="manage-body">{props.children}</div>
+    </section>
+  );
+}
+
+/** An overlay (cron, profiles, agents): a dialog over the route it was opened from. */
+export function ManageOverlay(props: { title: string; onClose: () => void; children: ReactNode }) {
+  const t = useT();
+  return (
+    <Dialog.Root
+      open
+      onOpenChange={(open) => {
+        if (!open) props.onClose();
+      }}
+    >
+      <Dialog.Portal>
+        <Dialog.Overlay className="overlay-backdrop" />
+        <Dialog.Content className="overlay-card" aria-describedby={undefined}>
+          <header className="overlay-header">
+            <Dialog.Title>{props.title}</Dialog.Title>
+            <Dialog.Close className="icon-button" aria-label={t("common.close")}>
+              <X aria-hidden="true" size={16} />
+            </Dialog.Close>
+          </header>
+          <div className="manage-overlay-body">{props.children}</div>
+        </Dialog.Content>
+      </Dialog.Portal>
+    </Dialog.Root>
+  );
+}
+
+export function LoadState<T>(props: {
+  value: Loaded<T> & { reload: () => void };
+  children: (data: T) => ReactNode;
+}) {
+  const t = useT();
+  const { value } = props;
+  if (value.state === "loading") return <Loader />;
+  if (value.state === "error") {
+    return (
+      <div className="manage-error" role="alert">
+        <p>
+          {value.code === "not-connected"
+            ? t("manage.notConnected")
+            : value.message || t("manage.failed")}
+        </p>
+        <button type="button" className="button button-secondary" onClick={value.reload}>
+          {t("manage.retry")}
+        </button>
+      </div>
+    );
+  }
+  return <>{props.children(value.data)}</>;
+}
+
+// -- the restart mark ----------------------------------------------------------------------------
+
+export interface StorageLike {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+}
+
+export function restartKey(profile: string | null): string {
+  return `indus.manage.restart.${profile ?? "default"}`;
+}
+
+export function sessionStore(): StorageLike | null {
+  try {
+    return window.sessionStorage;
+  } catch {
+    return null;
+  }
+}
+
+/** Remember that `profile`'s daemon needs a restart; `instanceId` is the instance live now. */
+export function markRestart(
+  storage: StorageLike | null,
+  profile: string | null,
+  instanceId: string | null,
+): void {
+  try {
+    storage?.setItem(restartKey(profile), JSON.stringify({ instanceId: instanceId ?? "" }));
+  } catch {
+    // storage full or blocked: the banner just will not survive a reload
+  }
+}
+
+/**
+ * Is a restart still owed? True while the connection reports the instance that was live at the
+ * change (or no instance yet); a different instance id clears the mark.
+ */
+export function restartPending(
+  storage: StorageLike | null,
+  profile: string | null,
+  instanceId: string | null,
+): boolean {
+  let raw: string | null = null;
+  try {
+    raw = storage?.getItem(restartKey(profile)) ?? null;
+  } catch {
+    raw = null;
+  }
+  if (raw === null) return false;
+  let marked = "";
+  try {
+    marked = String((JSON.parse(raw) as { instanceId?: unknown }).instanceId ?? "");
+  } catch {
+    marked = "";
+  }
+  if (instanceId === null || instanceId === "") return true; // no instance known yet: keep it
+  if (marked === "") {
+    markRestart(storage, profile, instanceId); // saved before any instance was seen: adopt this one
+    return true;
+  }
+  if (instanceId === marked) return true;
+  try {
+    storage?.removeItem(restartKey(profile));
+  } catch {
+    // ignore
+  }
+  return false;
+}
+
+export function RestartBanner(props: {
+  visible: boolean;
+  onRestart: () => void;
+  restarting: boolean;
+}) {
+  const t = useT();
+  if (!props.visible) return null;
+  return (
+    <div className="manage-banner" role="status">
+      <span>{t("manage.restart.body")}</span>
+      <button
+        type="button"
+        className="button button-primary"
+        onClick={props.onRestart}
+        disabled={props.restarting}
+      >
+        {props.restarting ? t("manage.restart.working") : t("manage.restart.now")}
+      </button>
+    </div>
+  );
+}
+
+/** "2 min ago" style time from unix seconds or an ISO string. */
+export function when(value: number | string | null | undefined, now = Date.now()): string {
+  if (value === null || value === undefined || value === "") return "—";
+  const ms = typeof value === "number" ? (value > 1e12 ? value : value * 1000) : Date.parse(value);
+  if (!Number.isFinite(ms)) return "—";
+  const seconds = Math.round((now - ms) / 1000);
+  if (seconds < 0) return new Date(ms).toLocaleString();
+  if (seconds < 60) return `${seconds} s ago`;
+  if (seconds < 3600) return `${Math.round(seconds / 60)} min ago`;
+  if (seconds < 86_400) return `${Math.round(seconds / 3600)} h ago`;
+  return new Date(ms).toLocaleDateString();
+}
