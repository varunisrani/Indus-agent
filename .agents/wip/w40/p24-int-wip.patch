index 0000000..348d5a6
--- /dev/null
+++ b/tests/fakes/ssh_bin/README.md
@@ -0,0 +1,8 @@
+# Fake `ssh` (P24-30)
+
+`ssh` here is a POSIX shell script written for Indus that stands in for OpenSSH in the desktop's
+SSH tests (`apps/desktop/electron/connections/ssh.test.ts`, `sshUpdate.test.ts`). It never opens a
+network connection: the "remote" is the machine running the tests and a remote command runs with
+`sh -c`. Scenarios and the call log are chosen with the environment variables listed at the top of
+the script. The host-key banner it prints imitates the shape of OpenSSH's message so the client's
+error classification can be tested; it is not copied from any other project.
diff --git a/tests/fakes/ssh_bin/ssh b/tests/fakes/ssh_bin/ssh
new file mode 100755
index 0000000..75928e2
--- /dev/null
+++ b/tests/fakes/ssh_bin/ssh
@@ -0,0 +1,73 @@
+#!/bin/sh
+# A scripted stand-in for OpenSSH's `ssh` (P24-30 tests). Written for Indus; it never connects
+# anywhere: the "remote" is this machine, and remote commands run here with `sh -c`.
+#
+#   INDUS_FAKE_SSH_LOG       append one line per call: every argument followed by \037
+#   INDUS_FAKE_SSH_SCENARIO  ok (default) | hostkey | auth | unreachable | hang
+#   INDUS_FAKE_SSH_TUNNEL    stay (default) | die      (what an `-N -L` forward child does)
+#   INDUS_FAKE_SSH_MASTER    alive (default) | dead    (what `-O check` answers)
+#
+# Arguments are read the way our client builds them: options, then `--`, the destination and an
+# optional remote command.
+
+if [ -n "$INDUS_FAKE_SSH_LOG" ]; then
+  for arg in "$@"; do printf '%s\037' "$arg" >> "$INDUS_FAKE_SSH_LOG"; done
+  printf '\n' >> "$INDUS_FAKE_SSH_LOG"
+fi
+
+control_op=""
+forward=0
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --) shift; break ;;
+    -O) control_op="$2"; shift 2 ;;
+    -o|-p|-i|-L) shift 2 ;;
+    -N) forward=1; shift ;;
+    *) shift ;;
+  esac
+done
+target="$1"
+[ $# -gt 0 ] && shift
+host="${target#*@}"
+
+case "${INDUS_FAKE_SSH_SCENARIO:-ok}" in
+  hostkey)
+    cat >&2 <<BANNER
+@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
+@    WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!     @
+@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@
+Offending ED25519 key in /home/someone/.ssh/known_hosts:3
+Host key for $host has changed and you have requested strict checking.
+Host key verification failed.
+BANNER
+    exit 255 ;;
+  auth)
+    echo "$target: Permission denied (publickey)." >&2
+    exit 255 ;;
+  unreachable)
+    echo "ssh: connect to host $host port 22: Connection refused" >&2
+    exit 255 ;;
+  hang)
+    exec sleep 30 ;;
+esac
+
+if [ -n "$control_op" ]; then
+  if [ "$control_op" = "check" ] && [ "${INDUS_FAKE_SSH_MASTER:-alive}" = "dead" ]; then
+    echo "Control socket connect: No such file or directory" >&2
+    exit 255
+  fi
+  exit 0
+fi
+
+if [ "$forward" = 1 ]; then
+  if [ "${INDUS_FAKE_SSH_TUNNEL:-stay}" = "die" ]; then
+    echo "channel 0: open failed: connect failed: Connection refused" >&2
+    exit 1
+  fi
+  exec sleep 300
+fi
+
+if [ $# -eq 0 ]; then
+  exit 0
+fi
+exec sh -c "$*"
diff --git a/tests/fakes/systemd_run.py b/tests/fakes/systemd_run.py
new file mode 100644
index 0000000..4121aa0
--- /dev/null
+++ b/tests/fakes/systemd_run.py
@@ -0,0 +1,60 @@
+"""A fake ``systemd-run`` (P24-43), written by us: it appends its argv as one JSON line to the
+file named by ``FAKE_SYSTEMD_RUN_LOG`` and then becomes the command after ``--`` (as the real one
+does with ``--scope``).
+
+``FAKE_SYSTEMD_RUN_REJECT_EXPAND=1`` makes it refuse ``--expand-environment`` like systemd < 254;
+``FAKE_SYSTEMD_RUN_FAIL=1`` makes every call fail like a missing user manager.
+
+``install(bin_dir)`` writes an executable ``systemd-run`` shim into ``bin_dir`` that runs this file
+with the current interpreter.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+_SHIM = """#!/bin/sh
+exec {python} {script} "$@"
+"""
+
+
+def install(bin_dir: Path) -> Path:
+    bin_dir.mkdir(parents=True, exist_ok=True)
+    shim = bin_dir / "systemd-run"
+    shim.write_text(_SHIM.format(python=sys.executable, script=Path(__file__).resolve()))
+    shim.chmod(0o755)
+    return shim
+
+
+def read_log(path: Path) -> list[list[str]]:
+    if not path.exists():
+        return []
+    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
+
+
+def main(argv: list[str]) -> int:
+    log = os.environ.get("FAKE_SYSTEMD_RUN_LOG")
+    if log:
+        with open(log, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(argv) + "\n")
+    if os.environ.get("FAKE_SYSTEMD_RUN_FAIL") == "1":
+        sys.stderr.write("Failed to connect to bus: No medium found\n")
+        return 1
+    if os.environ.get("FAKE_SYSTEMD_RUN_REJECT_EXPAND") == "1" and any(
+        a.startswith("--expand-environment") for a in argv
+    ):
+        sys.stderr.write("systemd-run: unrecognized option '--expand-environment=no'\n")
+        return 1
+    if "--" not in argv:
+        sys.stderr.write("systemd-run: no command\n")
+        return 1
+    command = argv[argv.index("--") + 1 :]
+    os.execvp(command[0], command)
+    return 127  # pragma: no cover - execvp does not return
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
