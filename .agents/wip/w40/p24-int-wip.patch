+Sample dashboard plugins for `tests/contract/web/test_dashboard_plugins.py` (P24-37), written by us.
+
+- `hello/` — a tab with a script, a stylesheet, slots and a Python `api` router (`GET /ping`).
+- `notes/` — overrides the built-in Logs page; no backend.
+- `takeover/` — tries to override `/plugins` (refused).
+- `sneaky/` — an `api` path that climbs out of its folder (backend refused, assets still served).
diff --git a/tests/fixtures/web/plugins/hello/dashboard/api.py b/tests/fixtures/web/plugins/hello/dashboard/api.py
new file mode 100644
index 0000000..1e09fad
--- /dev/null
+++ b/tests/fixtures/web/plugins/hello/dashboard/api.py
@@ -0,0 +1,23 @@
+"""The sample plugin's backend: mounted under /api/ext/hello/."""
+
+from fastapi import APIRouter
+from starlette.websockets import WebSocket
+
+from indus.service.ws_auth import WEB_PLUGIN
+from indus.web.ws import WsGrant, guarded_ws
+
+router = APIRouter()
+
+
+@router.get("/ping")
+async def ping() -> dict[str, str]:
+    return {"pong": "hello"}
+
+
+@guarded_ws(WEB_PLUGIN)
+async def live(websocket: WebSocket, grant: WsGrant) -> None:
+    await websocket.send_text(f"hello {grant.credential}")
+    await websocket.close(code=1000)
+
+
+router.add_api_websocket_route("/live", live)
