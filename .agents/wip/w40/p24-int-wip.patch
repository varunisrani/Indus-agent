@@ -0,0 +1,119 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  allowedUrl,
+  type Fetcher,
+  type FetchResponse,
+  MAX_VSIX_BYTES,
+  MarketplaceClient,
+  packageUrl,
+  parseSearch,
+  searchBody,
+} from "./marketplace.ts";
+
+function response(
+  status: number,
+  body: unknown,
+  headers: Record<string, string> = {},
+): FetchResponse {
+  return {
+    status,
+    headers: { get: (name) => headers[name.toLowerCase()] ?? null },
+    arrayBuffer: async () => {
+      const bytes =
+        body instanceof Uint8Array ? body : new TextEncoder().encode(JSON.stringify(body));
+      return bytes.slice().buffer as ArrayBuffer;
+    },
+    json: async () => body,
+  };
+}
+
+const SEARCH_ANSWER = {
+  results: [
+    {
+      extensions: [
+        {
+          publisher: { publisherName: "acme" },
+          extensionName: "night-owl-ish",
+          displayName: "Night Owlish",
+          shortDescription: "A calm dark theme",
+          versions: [{ version: "2.1.0" }],
+          statistics: [{ statisticName: "install", value: 1234 }],
+        },
+        { extensionName: "broken" },
+      ],
+    },
+  ],
+};
+
+describe("marketplace", () => {
+  it("allows only https on the gallery hosts", () => {
+    expect(allowedUrl("https://marketplace.visualstudio.com/_apis/x")).toBe(true);
+    expect(allowedUrl("https://acme.gallerycdn.vsassets.io/x.vsix")).toBe(true);
+    expect(allowedUrl("http://marketplace.visualstudio.com/")).toBe(false);
+    expect(allowedUrl("https://marketplace.visualstudio.com.evil.example/")).toBe(false);
+    expect(allowedUrl("https://user:pw@marketplace.visualstudio.com/")).toBe(false);
+    expect(allowedUrl("not a url")).toBe(false);
+  });
+
+  it("an empty query lists the most installed themes; text narrows it", () => {
+    const empty = JSON.parse(searchBody("  "));
+    expect(empty.filters[0].criteria).toHaveLength(2);
+    expect(empty.filters[0].sortBy).toBe(4);
+    const text = JSON.parse(searchBody("owl"));
+    expect(text.filters[0].criteria.at(-1)).toEqual({ filterType: 10, value: "owl" });
+  });
+
+  it("parses search answers and skips broken rows", () => {
+    expect(parseSearch(SEARCH_ANSWER)).toEqual([
+      {
+        publisher: "acme",
+        extension: "night-owl-ish",
+        version: "2.1.0",
+        displayName: "Night Owlish",
+        description: "A calm dark theme",
+        installs: 1234,
+      },
+    ]);
+    expect(parseSearch(null)).toEqual([]);
+  });
+
+  it("downloads through allowed redirects, without credentials", async () => {
+    const fetcher = vi.fn<Fetcher>(async (url) =>
+      url.startsWith("https://marketplace")
+        ? response(302, null, { location: "https://acme.gallerycdn.vsassets.io/pkg.vsix" })
+        : response(200, new Uint8Array([80, 75, 3, 4])),
+    );
+    const client = new MarketplaceClient(fetcher);
+    expect(await client.download("acme", "night-owl-ish", "2.1.0")).toBe(
+      Buffer.from([80, 75, 3, 4]).toString("base64"),
+    );
+    expect(fetcher.mock.calls[0]?.[0]).toBe(packageUrl("acme", "night-owl-ish", "2.1.0"));
+    expect(fetcher.mock.calls.every(([, init]) => init.credentials === "omit")).toBe(true);
+    expect(fetcher.mock.calls.every(([, init]) => init.redirect === "manual")).toBe(true);
+  });
+
+  it("refuses a redirect off the allow-list, a too large package and errors", async () => {
+    const offList = new MarketplaceClient(async () =>
+      response(302, null, { location: "https://evil.example/pkg" }),
+    );
+    await expect(offList.download("a", "b", "1.0.0")).rejects.toThrow(/not allowed/);
+    const big = new MarketplaceClient(async () =>
+      response(200, new Uint8Array(1), { "content-length": String(MAX_VSIX_BYTES + 1) }),
+    );
+    await expect(big.download("a", "b", "1.0.0")).rejects.toThrow(/over 5 MiB/);
+    const down = new MarketplaceClient(async () => response(503, null));
+    await expect(down.search("x")).rejects.toThrow(/answered 503/);
+    const loop = new MarketplaceClient(async () =>
+      response(302, null, { location: "https://marketplace.visualstudio.com/again" }),
+    );
+    await expect(loop.search("x")).rejects.toThrow(/too many redirects/);
+  });
+
+  it("search posts the query", async () => {
+    const fetcher = vi.fn<Fetcher>(async () => response(200, SEARCH_ANSWER));
+    const items = await new MarketplaceClient(fetcher).search("owl");
+    expect(items).toHaveLength(1);
+    expect(fetcher.mock.calls[0]?.[1].method).toBe("POST");
+    expect(fetcher.mock.calls[0]?.[1].body).toContain('"owl"');
+  });
+});
diff --git a/apps/desktop/electron/theme/marketplace.ts b/apps/desktop/electron/theme/marketplace.ts
new file mode 100644
index 0000000..e419486
--- /dev/null
+++ b/apps/desktop/electron/theme/marketplace.ts
@@ -0,0 +1,213 @@
+// VS Code Marketplace access for theme import (P24-33). The renderer never fetches the network
+// itself: it asks main to search colour themes (`themes:search`) or to download one extension
+// package (`themes:download`); the conversion happens in the renderer (`src/theme/vscodeImport.ts`).
+//
+// Rules: only https, only the hosts in `ALLOWED_HOSTS` (redirects are followed by hand, at most
+// `MAX_REDIRECTS`, each hop checked), no cookies or credentials, a package of at most
+// `MAX_VSIX_BYTES`, and a deadline per request. Search sorts by install count; an empty query lists
+// the most installed themes.
+
+import type { MainContext } from "../context.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import type { ResponseOf } from "../ipc/schemas.ts";
+
+export const GALLERY = "https://marketplace.visualstudio.com/_apis/public/gallery";
+export const ALLOWED_HOSTS: readonly RegExp[] = [
+  /^marketplace\.visualstudio\.com$/,
+  /^[a-z0-9-]+\.gallery\.vsassets\.io$/,
+  /^[a-z0-9-]+\.gallerycdn\.vsassets\.io$/,
+];
+export const MAX_VSIX_BYTES = 5 * 1024 * 1024;
+export const MAX_REDIRECTS = 3;
+export const REQUEST_TIMEOUT_MS = 20_000;
+export const PAGE_SIZE = 30;
+
+/** The Marketplace query API's numbers (filter types, sort, flags). */
+const FILTER_TARGET = 8;
+const FILTER_CATEGORY = 5;
+const FILTER_TEXT = 10;
+const SORT_INSTALLS = 4;
+const FLAGS = 0x1 | 0x2 | 0x10 | 0x80 | 0x100;
+
+export type MarketplaceItem = ResponseOf<"indus:themes:search">["items"][number];
+
+export interface FetchResponse {
+  status: number;
+  headers: { get(name: string): string | null };
+  arrayBuffer(): Promise<ArrayBuffer>;
+  json(): Promise<unknown>;
+}
+
+export type Fetcher = (
+  url: string,
+  init: {
+    method: string;
+    headers: Record<string, string>;
+    body?: string;
+    redirect: "manual";
+    signal: AbortSignal;
+    credentials: "omit";
+  },
+) => Promise<FetchResponse>;
+
+export function allowedUrl(raw: string): boolean {
+  try {
+    const url = new URL(raw);
+    return (
+      url.protocol === "https:" &&
+      url.username === "" &&
+      url.password === "" &&
+      ALLOWED_HOSTS.some((host) => host.test(url.hostname))
+    );
+  } catch {
+    return false;
+  }
+}
+
+/** The search request body for `query` (empty: the most installed themes). */
+export function searchBody(query: string): string {
+  const criteria: { filterType: number; value: string }[] = [
+    { filterType: FILTER_TARGET, value: "Microsoft.VisualStudio.Code" },
+    { filterType: FILTER_CATEGORY, value: "Themes" },
+  ];
+  const text = query.trim();
+  if (text !== "") criteria.push({ filterType: FILTER_TEXT, value: text });
+  return JSON.stringify({
+    filters: [
+      { criteria, pageNumber: 1, pageSize: PAGE_SIZE, sortBy: SORT_INSTALLS, sortOrder: 0 },
+    ],
+    flags: FLAGS,
+  });
+}
+
+const str = (value: unknown): string => (typeof value === "string" ? value : "");
+
+/** The items of a search answer; anything malformed is skipped. */
+export function parseSearch(body: unknown): MarketplaceItem[] {
+  const results = (body as { results?: unknown } | null)?.results;
+  const first = Array.isArray(results) ? (results[0] as { extensions?: unknown }) : undefined;
+  const extensions = Array.isArray(first?.extensions) ? first.extensions : [];
+  const items: MarketplaceItem[] = [];
+  for (const raw of extensions) {
+    const ext = raw as Record<string, unknown>;
+    const publisher = str((ext.publisher as Record<string, unknown> | undefined)?.publisherName);
+    const extension = str(ext.extensionName);
+    const versions = Array.isArray(ext.versions) ? ext.versions : [];
+    const version = str((versions[0] as Record<string, unknown> | undefined)?.version);
+    if (publisher === "" || extension === "" || version === "") continue;
+    const stats = Array.isArray(ext.statistics) ? ext.statistics : [];
+    const install = stats.find((s) => (s as Record<string, unknown>).statisticName === "install") as
+      | Record<string, unknown>
+      | undefined;
+    items.push({
+      publisher,
+      extension,
+      version,
+      displayName: str(ext.displayName) || extension,
+      description: str(ext.shortDescription),
+      installs: typeof install?.value === "number" ? install.value : 0,
+    });
+  }
+  return items;
+}
+
+export function packageUrl(publisher: string, extension: string, version: string): string {
+  const part = encodeURIComponent;
+  return `${GALLERY}/publishers/${part(publisher)}/vsextensions/${part(extension)}/${part(version)}/vspackage`;
+}
+
+export class MarketplaceClient {
+  private readonly fetcher: Fetcher;
+
+  constructor(fetcher: Fetcher) {
+    this.fetcher = fetcher;
+  }
+
+  private async request(
+    url: string,
+    init: { method: string; headers: Record<string, string>; body?: string },
+  ): Promise<FetchResponse> {
+    let target = url;
+    for (let hop = 0; hop <= MAX_REDIRECTS; hop++) {
+      if (!allowedUrl(target)) throw new IpcError("refused", "that address is not allowed");
+      const controller = new AbortController();
+      const timer = setTimeout(() => controller.abort(), REQUEST_TIMEOUT_MS);
+      let answer: FetchResponse;
+      try {
+        answer = await this.fetcher(target, {
+          ...init,
+          redirect: "manual",
+          signal: controller.signal,
+          credentials: "omit",
+        });
+      } catch {
+        throw new IpcError("unreachable", "the Marketplace did not answer");
+      } finally {
+        clearTimeout(timer);
+      }
+      if (answer.status >= 300 && answer.status < 400) {
+        const next = answer.headers.get("location");
+        if (next === null) throw new IpcError("unreachable", "a redirect without a location");
+        target = new URL(next, target).toString();
+        continue;
+      }
+      if (answer.status !== 200) {
+        throw new IpcError("unreachable", `the Marketplace answered ${answer.status}`);
+      }
+      return answer;
+    }
+    throw new IpcError("unreachable", "too many redirects");
+  }
+
+  async search(query: string): Promise<MarketplaceItem[]> {
+    const answer = await this.request(`${GALLERY}/extensionquery`, {
+      method: "POST",
+      headers: {
+        accept: "application/json;api-version=3.0-preview.1",
+        "content-type": "application/json",
+      },
+      body: searchBody(query),
+    });
+    return parseSearch(await answer.json());
+  }
+
+  async download(publisher: string, extension: string, version: string): Promise<string> {
+    const answer = await this.request(packageUrl(publisher, extension, version), {
+      method: "GET",
+      headers: { accept: "application/octet-stream" },
+    });
+    const declared = Number(answer.headers.get("content-length") ?? "0");
+    if (declared > MAX_VSIX_BYTES) throw new IpcError("too-large", "the package is over 5 MiB");
+    const bytes = new Uint8Array(await answer.arrayBuffer());
+    if (bytes.byteLength > MAX_VSIX_BYTES) {
+      throw new IpcError("too-large", "the package is over 5 MiB");
+    }
+    return Buffer.from(bytes).toString("base64");
+  }
+}
+
+/** Main's install step for the two Marketplace channels. */
+export function installThemeMarketplace(
+  context: MainContext,
+  options: { fetch: Fetcher },
+): MarketplaceClient {
+  const client = new MarketplaceClient(options.fetch);
+  const appWindow = (senderId: number) => {
+    const kind = context.windows.kindOf(senderId);
+    if (kind !== "main" && kind !== "secondary" && kind !== "instance") {
+      throw new IpcError("sender-rejected", "only an app window may import themes");
+    }
+  };
+  context.registry.handle("indus:themes:search", async ({ query }, { senderId }) => {
+    appWindow(senderId);
+    return { items: await client.search(query) };
+  });
+  context.registry.handle(
+    "indus:themes:download",
+    async ({ publisher, extension, version }, { senderId }) => {
+      appWindow(senderId);
+      return { vsixBase64: await client.download(publisher, extension, version) };
+    },
+  );
+  return client;
+}
diff --git a/apps/desktop/electron/uninstall.test.ts b/apps/desktop/electron/uninstall.test.ts
new file mode 100644
index 0000000..5f79f5f
--- /dev/null
+++ b/apps/desktop/electron/uninstall.test.ts
@@ -0,0 +1,204 @@
+import { describe, expect, it, vi } from "vitest";
+import {
+  CONFIRM_PHRASE,
+  decideOwnership,
+  helperCommand,
+  LEVEL_ARGS,
+  type OwnershipInput,
+  posixHelper,
+  SUMMARY_ARGS,
+  type UninstallDeps,
+  UninstallService,
+  windowsHelper,
+} from "./uninstall.ts";
+
+const HOME = "/home/someone/.indus";
+const INDUS = {
+  command: "/home/someone/.indus/indus-agent/venv/bin/python",
+  args: ["-m", "indus"],
+};
+
+function summary(extra: Record<string, unknown> = {}): string {
+  return JSON.stringify({
+    gui_installed: true,
+    agent_installed: true,
+    install_kind: "git",
+    home: HOME,
+    code_dir: "/home/someone/.indus/indus-agent",
+    ...extra,
+  });
+}
+
+function input(extra: Partial<OwnershipInput> = {}): OwnershipInput {
+  return {
+    home: HOME,
+    execPath: "/opt/Indus/indus",
+    summaryText: summary(),
+    receipts: [{ id: "r1", installer: "sh", outcome: "success" }],
+    ...extra,
+  };
+}
+
+function deps(extra: Partial<UninstallDeps> = {}) {
+  const spawned: Array<{ command: string; args: readonly string[] }> = [];
+  const scripts: string[] = [];
+  const ran: Array<readonly string[]> = [];
+  const quit = vi.fn();
+  const base: UninstallDeps = {
+    home: HOME,
+    platform: "linux",
+    pid: 4242,
+    execPath: "/opt/Indus/indus",
+    indus: async () => INDUS,
+    run: async (_indus, args) => {
+      ran.push(args);
+      return summary();
+    },
+    readReceipts: async () => [{ outcome: "success" }],
+    writeHelper: async (text, ext) => {
+      scripts.push(text);
+      return `/tmp/indus-uninstall${ext}`;
+    },
+    spawnDetached: (command, args) => spawned.push({ command, args }),
+    quit,
+    ...extra,
+  };
+  return { deps: base, spawned, scripts, ran, quit };
+}
+
+describe("levels and the CLI flags table", () => {
+  it("the helper command line matches docs/internals/uninstall-levels.md", () => {
+    expect(LEVEL_ARGS).toEqual({
+      gui: ["uninstall", "--gui", "--yes"],
+      "keep-data": ["uninstall", "--yes"],
+      full: ["uninstall", "--full", "--yes"],
+    });
+    expect(SUMMARY_ARGS).toEqual(["uninstall", "--gui-summary"]);
+    expect(helperCommand(INDUS, "full")).toEqual([
+      INDUS.command,
+      "-m",
+      "indus",
+      "uninstall",
+      "--full",
+      "--yes",
+    ]);
+    expect(() => helperCommand(INDUS, "data" as never)).toThrow();
+  });
+});
+
+describe("ownership", () => {
+  it("a confirmed git install offers all three levels", () => {
+    expect(decideOwnership(input())).toEqual({
+      allowed: true,
+      levels: ["gui", "keep-data", "full"],
+      installKind: "git",
+      home: HOME,
+      confirmPhrase: CONFIRM_PHRASE,
+    });
+  });
+
+  it("a Nix-owned receipt hides all options", () => {
+    const view = decideOwnership(input({ summaryText: summary({ install_kind: "nix" }) }));
+    expect(view.allowed).toBe(false);
+    expect(view.levels).toEqual([]);
+    expect(view.reason).toContain("Nix");
+    const store = decideOwnership(input({ execPath: "/nix/store/abc-indus/bin/indus" }));
+    expect(store).toMatchObject({ allowed: false, levels: [], installKind: "nix" });
+  });
+
+  it.each([
+    ["docker kind", { summaryText: summary({ install_kind: "docker" }) }],
+    ["bundled runtime", { summaryText: summary({ install_kind: "desktop" }) }],
+    ["no git checkout", { summaryText: summary({ agent_installed: false }) }],
+    ["another home", { summaryText: summary({ home: "/elsewhere" }) }],
+    ["summary failed", { summaryText: null }],
+    ["not JSON", { summaryText: "Traceback ..." }],
+    ["a JSON list", { summaryText: "[1]" }],
+    ["no receipt", { receipts: [] }],
+    ["only a failed receipt", { receipts: [{ outcome: "failed" }, { outcome: "interrupted" }] }],
+  ])("%s hides every level", (_label, extra) => {
+    const view = decideOwnership(input(extra as Partial<OwnershipInput>));
+    expect(view.allowed).toBe(false);
+    expect(view.levels).toEqual([]);
+    expect(view.reason).toBeTruthy();
+  });
+});
+
+describe("run", () => {
+  it('"everything" without the typed confirmation does nothing', async () => {
+    for (const typed of [undefined, "", "yes", "uninstall", "Uninstall Everything!"]) {
+      const rig = deps();
+      const answer = await new UninstallService(rig.deps).run("full", typed);
+      expect(answer).toMatchObject({ ok: false, code: "confirm" });
+      expect(rig.scripts).toEqual([]);
+      expect(rig.spawned).toEqual([]);
+      expect(rig.quit).not.toHaveBeenCalled();
+    }
+  });
+
+  it("with the phrase it writes the helper, starts it detached and quits", async () => {
+    const rig = deps();
+    const answer = await new UninstallService(rig.deps).run("full", CONFIRM_PHRASE);
+    expect(answer).toEqual({ ok: true });
+    expect(rig.spawned).toEqual([{ command: "/bin/sh", args: ["/tmp/indus-uninstall.sh"] }]);
+    expect(rig.scripts[0]).toContain("'uninstall' '--full' '--yes'");
+    expect(rig.quit).toHaveBeenCalledOnce();
+  });
+
+  it("ownership is checked again in main; a refused install spawns nothing", async () => {
+    const rig = deps({ run: async () => summary({ install_kind: "nix" }) });
+    const service = new UninstallService(rig.deps);
+    expect(await service.run("gui", undefined)).toMatchObject({ ok: false, code: "not-owned" });
+    expect(rig.spawned).toEqual([]);
+    const none = deps({ indus: async () => null });
+    expect(await new UninstallService(none.deps).run("keep-data", undefined)).toMatchObject({
+      ok: false,
+      code: "not-owned",
+    });
+  });
+
+  it("a second run while one is starting is refused", async () => {
+    const rig = deps();
+    const service = new UninstallService(rig.deps);
+    await service.run("gui", undefined);
+    expect(await service.run("gui", undefined)).toMatchObject({ ok: false, code: "busy" });
+    expect(rig.spawned).toHaveLength(1);
+  });
+
+  it("windows uses a batch helper through cmd", async () => {
+    const rig = deps({ platform: "win32", home: "C:\\Users\\me\\.indus" });
+    rig.deps.run = async () => summary({ home: "C:\\Users\\me\\.indus" });
+    await new UninstallService(rig.deps).run("keep-data", undefined);
+    expect(rig.spawned[0]?.command).toBe("cmd.exe");
+    expect(rig.scripts[0]).toContain('"uninstall" "--yes"');
+  });
+});
+
+describe("helper scripts", () => {
+  it("POSIX: waits for the pid (bounded), sets INDUS_HOME, quotes every word, removes itself", () => {
+    const text = posixHelper({
+      pid: 99,
+      argv: ["/path with space/py", "-m", "indus", "it's", "--yes"],
+      home: "/home/o'neil/.indus",
+    });
+    expect(text).toContain("pid=99");
+    expect(text).toContain('kill -0 "$pid"');
+    expect(text).toContain("-lt 60");
+    expect(text).toContain("INDUS_HOME='/home/o'\\''neil/.indus'");
+    expect(text).toContain("'/path with space/py' '-m' 'indus' 'it'\\''s' '--yes'");
+    expect(text.trimEnd().endsWith('rm -f -- "$0"')).toBe(true);
+    expect(posixHelper({ pid: Number.NaN, argv: ["x"], home: "/h" })).toContain("pid=0");
+  });
+
+  it("Windows: exact PID match, bounded wait, refuses paths cmd cannot quote", () => {
+    const text = windowsHelper({ pid: 7, argv: ["C:\\py.exe", "-m", "indus"], home: "C:\\h" });
+    expect(text).toContain('set "PID=7"');
+    expect(text).toContain('findstr /r /c:" %PID% "');
+    expect(text).toContain("geq 30");
+    expect(text).toContain('set "INDUS_HOME=C:\\h"');
+    expect(text).toContain("\r\n");
+    for (const bad of ['C:\\a"b', "C:\\100%", "C:\\a&b", "C:\\a^b"]) {
+      expect(() => windowsHelper({ pid: 1, argv: [bad], home: "C:\\h" })).toThrow();
+    }
+  });
+});
diff --git a/apps/desktop/electron/uninstall.ts b/apps/desktop/electron/uninstall.ts
new file mode 100644
index 0000000..b1ef9e5
--- /dev/null
+++ b/apps/desktop/electron/uninstall.ts
@@ -0,0 +1,278 @@
+// Uninstall from Settings → About (P24-34). The app never deletes anything itself: it runs the
+// CLI's own `indus uninstall` (P23-20, `docs/internals/uninstall-levels.md`) from a small helper
+// script that starts after the app has quit.
+//
+//   level        what the person picked                      the helper runs
+//   gui          the app only                                indus uninstall --gui --yes
+//   keep-data    the app and the runtime, keep my data       indus uninstall --yes
+//   full         everything                                  indus uninstall --full --yes
+//
+// The levels are offered only when ownership is confirmed from the install receipt (`summary`):
+// the CLI's `--gui-summary` answers with JSON naming an install kind no other manager owns and a
+// git checkout of ours (`agent_installed`), the installer left a `success` receipt under
+// `<home>/logs/install_receipts/`, and the app does not run from a Nix store. Anything missing,
+// unreadable or contradictory hides every level. "Everything" also needs the typed phrase
+// `CONFIRM_PHRASE`, checked here in main, not only in the page.
+//
+// The helper waits (at most ~30 s) for this app's pid to exit, runs the command with `INDUS_HOME`
+// set to the app's home, and deletes itself. Paths are single-quoted for POSIX shells; the Windows
+// batch file refuses paths holding characters cmd cannot quote (`"`, `%`, `^`, `&`, `!`).
+
+import path from "node:path";
+import type { CommandSpec } from "./backend/process.ts";
+import type { MainContext } from "./context.ts";
+import { IpcError } from "./ipc/envelope.ts";
+
+export type UninstallLevel = "gui" | "keep-data" | "full";
+
+export const LEVELS: readonly UninstallLevel[] = ["gui", "keep-data", "full"];
+
+/** The CLI arguments of each level, exactly the flags table. */
+export const LEVEL_ARGS: Readonly<Record<UninstallLevel, readonly string[]>> = {
+  gui: ["uninstall", "--gui", "--yes"],
+  "keep-data": ["uninstall", "--yes"],
+  full: ["uninstall", "--full", "--yes"],
+};
+
+export const SUMMARY_ARGS: readonly string[] = ["uninstall", "--gui-summary"];
+export const CONFIRM_PHRASE = "uninstall everything";
+export const SUMMARY_TIMEOUT_MS = 10_000;
+export const HELPER_WAIT_SECONDS = 30;
+
+/** Install kinds another manager owns (the CLI refuses code removal for them too). */
+export const MANAGED_KINDS: Readonly<Record<string, string>> = {
+  nix: "Nix installed this Indus. Remove it the way you added it (your flake or profile), then rebuild.",
+  docker: "This Indus runs in a container. Remove the image and its volumes with Docker.",
+  desktop:
+    "This Indus is the desktop app's bundled runtime. Remove the app the way your system removes apps.",
+};
+
+export interface UninstallSummaryView {
+  allowed: boolean;
+  levels: UninstallLevel[];
+  reason?: string;
+  installKind: string;
+  home: string;
+  confirmPhrase: string;
+}
+
+export interface OwnershipInput {
+  home: string;
+  execPath: string;
+  /** stdout of `indus uninstall --gui-summary`, or null when it could not run. */
+  summaryText: string | null;
+  /** The parsed installer receipts (`<home>/logs/install_receipts/*.json`). */
+  receipts: readonly unknown[];
+}
+
+const NOT_CONFIRMED = "Indus could not confirm how it was installed, so it cannot remove itself.";
+
+function hidden(input: OwnershipInput, reason: string, installKind = "unknown") {
+  return {
+    allowed: false,
+    levels: [],
+    reason,
+    installKind,
+    home: input.home,
+    confirmPhrase: CONFIRM_PHRASE,
+  } satisfies UninstallSummaryView;
+}
+
+/** Decide which levels to offer (see the module notes). */
+export function decideOwnership(input: OwnershipInput): UninstallSummaryView {
+  if (/[\\/]nix[\\/]store[\\/]/.test(input.execPath)) {
+    return hidden(input, MANAGED_KINDS.nix ?? NOT_CONFIRMED, "nix");
+  }
+  if (input.summaryText === null) return hidden(input, NOT_CONFIRMED);
+  let summary: Record<string, unknown>;
+  try {
+    const parsed: unknown = JSON.parse(input.summaryText);
+    if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+      return hidden(input, NOT_CONFIRMED);
+    }
+    summary = parsed as Record<string, unknown>;
+  } catch {
+    return hidden(input, NOT_CONFIRMED);
+  }
+  const kind = typeof summary.install_kind === "string" ? summary.install_kind : "unknown";
+  const managed = MANAGED_KINDS[kind];
+  if (managed !== undefined) return hidden(input, managed, kind);
+  if (summary.agent_installed !== true) return hidden(input, NOT_CONFIRMED, kind);
+  if (typeof summary.home === "string" && path.resolve(summary.home) !== path.resolve(input.home)) {
+    return hidden(input, NOT_CONFIRMED, kind);
+  }
+  const receipted = input.receipts.some(
+    (r) =>
+      typeof r === "object" && r !== null && (r as { outcome?: unknown }).outcome === "success",
+  );
+  if (!receipted) return hidden(input, NOT_CONFIRMED, kind);
+  return {
+    allowed: true,
+    levels: [...LEVELS],
+    installKind: kind,
+    home: input.home,
+    confirmPhrase: CONFIRM_PHRASE,
+  };
+}
+
+/** The full command line the helper runs for `level`. */
+export function helperCommand(indus: CommandSpec, level: UninstallLevel): string[] {
+  const args = LEVEL_ARGS[level];
+  if (args === undefined) throw new Error(`unknown uninstall level ${String(level)}`);
+  return [indus.command, ...indus.args, ...args];
+}
+
+function posixQuote(text: string): string {
+  return `'${text.replace(/'/g, `'\\''`)}'`;
+}
+
+export function posixHelper(options: {
+  pid: number;
+  argv: readonly string[];
+  home: string;
+}): string {
+  const pid = Number.isInteger(options.pid) && options.pid > 0 ? options.pid : 0;
+  return [
+    "#!/bin/sh",
+    "# Indus Agent: runs `indus uninstall` once the desktop app has quit (P24-34).",
+    `pid=${pid}`,
+    "i=0",
+    `while [ "$pid" -gt 0 ] && kill -0 "$pid" 2>/dev/null && [ "$i" -lt ${HELPER_WAIT_SECONDS * 2} ]; do`,
+    "  sleep 0.5",
+    "  i=$((i + 1))",
+    "done",
+    `INDUS_HOME=${posixQuote(options.home)}`,
+    "export INDUS_HOME",
+    `${options.argv.map(posixQuote).join(" ")}`,
+    'rm -f -- "$0"',
+    "",
+  ].join("\n");
+}
+
+const CMD_UNSAFE = /["%^&!\r\n]/;
+
+export function windowsHelper(options: {
+  pid: number;
+  argv: readonly string[];
+  home: string;
+}): string {
+  for (const part of [options.home, ...options.argv]) {
+    if (CMD_UNSAFE.test(part)) throw new Error("a path holds a character cmd cannot quote");
+  }
+  const pid = Number.isInteger(options.pid) && options.pid > 0 ? options.pid : 0;
+  return [
+    "@echo off",
+    "rem Indus Agent: runs `indus uninstall` once the desktop app has quit (P24-34).",
+    "setlocal",
+    `set "PID=${pid}"`,
+    "set /a WAITED=0",
+    ":wait",
+    'tasklist /NH /FI "PID eq %PID%" 2>nul | findstr /r /c:" %PID% " >nul',
+    "if errorlevel 1 goto run",
+    "set /a WAITED+=1",
+    `if %WAITED% geq ${HELPER_WAIT_SECONDS} goto run`,
+    "timeout /t 1 /nobreak >nul",
+    "goto wait",
+    ":run",
+    `set "INDUS_HOME=${options.home}"`,
+    options.argv.map((part) => `"${part}"`).join(" "),
+    '(goto) 2>nul & del "%~f0"',
+    "",
+  ].join("\r\n");
+}
+
+export interface UninstallDeps {
+  home: string;
+  platform: string;
+  pid: number;
+  execPath: string;
+  /** The `indus` the backend resolver picked, or null when there is none. */
+  indus(): Promise<CommandSpec | null>;
+  /** Run `indus` with `args`; stdout when it exits 0 within the deadline, else null. */
+  run(indus: CommandSpec, args: readonly string[], timeoutMs: number): Promise<string | null>;
+  readReceipts(): Promise<unknown[]>;
+  /** Write the helper script (owner-only, executable) and return its path. */
+  writeHelper(text: string, extension: ".sh" | ".cmd"): Promise<string>;
+  /** Start the helper detached from the app (it outlives the app's exit). */
+  spawnDetached(command: string, args: readonly string[]): void;
+  quit(): void;
+  log?: (line: string) => void;
+}
+
+export type RunAnswer = { ok: true } | { ok: false; code: string; message: string };
+
+export class UninstallService {
+  private started = false;
+  private readonly deps: UninstallDeps;
+
+  constructor(deps: UninstallDeps) {
+    this.deps = deps;
+  }
+
+  async summary(): Promise<UninstallSummaryView> {
+    const indus = await this.deps.indus();
+    const summaryText =
+      indus === null ? null : await this.deps.run(indus, SUMMARY_ARGS, SUMMARY_TIMEOUT_MS);
+    const receipts = await this.deps.readReceipts().catch(() => []);
+    return decideOwnership({
+      home: this.deps.home,
+      execPath: this.deps.execPath,
+      summaryText,
+      receipts,
+    });
+  }
+
+  async run(level: UninstallLevel, typed: string | undefined): Promise<RunAnswer> {
+    if (this.started) return { ok: false, code: "busy", message: "Uninstall is already starting." };
+    if (!LEVELS.includes(level)) {
+      return { ok: false, code: "bad-level", message: "That is not an uninstall level." };
+    }
+    if (level === "full" && (typed ?? "").trim() !== CONFIRM_PHRASE) {
+      return {
+        ok: false,
+        code: "confirm",
+        message: `Type "${CONFIRM_PHRASE}" to remove everything.`,
+      };
+    }
+    // Ownership is decided again here: the page's copy may be stale.
+    const view = await this.summary();
+    const indus = await this.deps.indus();
+    if (!view.allowed || indus === null || !view.levels.includes(level)) {
+      return { ok: false, code: "not-owned", message: view.reason ?? NOT_CONFIRMED };
+    }
+    const argv = helperCommand(indus, level);
+    const windows = this.deps.platform === "win32";
+    let script: string;
+    try {
+      const text = windows
+        ? windowsHelper({ pid: this.deps.pid, argv, home: this.deps.home })
+        : posixHelper({ pid: this.deps.pid, argv, home: this.deps.home });
+      script = await this.deps.writeHelper(text, windows ? ".cmd" : ".sh");
+    } catch (error) {
+      return {
+        ok: false,
+        code: "helper",
+        message: error instanceof Error ? error.message : "The helper could not be written.",
+      };
+    }
+    this.started = true;
+    this.deps.log?.(`[uninstall] helper started for level ${level}`);
+    if (windows) this.deps.spawnDetached("cmd.exe", ["/d", "/c", script]);
+    else this.deps.spawnDetached("/bin/sh", [script]);
+    this.deps.quit();
+    return { ok: true };
+  }
+}
+
+/** Register `indus:uninstall:summary` and `indus:uninstall:run`. */
+export function installUninstall(context: MainContext, deps: UninstallDeps): UninstallService {
+  const service = new UninstallService(deps);
+  context.registry.handle("indus:uninstall:summary", () => service.summary());
+  context.registry.handle("indus:uninstall:run", async (request) => {
+    const answer = await service.run(request.level, request.typed);
+    if (!answer.ok && answer.code === "bad-level")
+      throw new IpcError("bad-request", answer.message);
+    return answer;
+  });
+  return service;
+}
