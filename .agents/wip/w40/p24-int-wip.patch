+def manager(tmp_path: Path, clock: Any = None, **changes: Any) -> LspManager:
+    return LspManager(
+        settings(**changes),
+        clock=clock or SystemClock(),
+        env_factory=env_with_fake_binary(tmp_path),
+        client_factory=cast(Any, FakeClient),
