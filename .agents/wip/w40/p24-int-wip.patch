@@ -0,0 +1,574 @@
+"""P24-01: the host lock, the rendezvous record, the second-run verdict and the serve verbs."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+import stat
+from collections.abc import Mapping
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.foundation.profiles import tombstone
+from indus.foundation.scope import Scope
+from indus.gateway.control_socket import ControlServer, VerbRefused
+from indus.gateway.multiplex import host as host_mod
+from indus.gateway.multiplex.host import (
+    HostLock,
+    HostRecord,
+    MultiplexHost,
+    ServeRefused,
+    clear_record,
+    decide_second_run,
+    ensure_state_dir,
+    host_state_dir,
+    mint_routed_ticket,
+    publish_record,
+    read_record,
+    record_alive,
+)
+from indus.service import gateway_control as wire
+from indus.service.ws_auth import WS_INTERACTIVE, TicketBook, TicketRefused, stable_profile_id
+from indus.state.gateway_runtime import (
+    PidRecord,
+    ProcessIdentity,
+    process_start_time,
+    write_pid_record,
+)
+from tests.fakes.clock import FakeClock
+from tests.unit.gateway.multiplex.world import launch_scope, make_profile
+
+SUPERVISED = {"INDUS_GATEWAY_SUPERVISED": "1"}
+
+
+def run(coro: Any) -> Any:
+    return asyncio.run(coro)
+
+
+@pytest.fixture
+def root(isolated_home: Path) -> Path:
+    return isolated_home
+
+
+@pytest.fixture
+def state(tmp_path: Path) -> Path:
+    return tmp_path / "state" / "indus"
+
+
+@pytest.fixture
+def launch(root: Path, fake_clock: FakeClock) -> Scope:
+    return launch_scope(root, fake_clock)
+
+
+def live_record(base: Path, *, served: tuple[str, ...] = ("default",), **kw: Any) -> HostRecord:
+    fields: dict[str, Any] = {
+        "pid": os.getpid(),
+        "start_time": process_start_time(os.getpid()),
+        "root": str(base),
+        "home": str(base),
+        "served_profiles": served,
+    }
+    fields.update(kw)
+    return HostRecord(**fields)
+
+
+class Ticker:
+    """A monotonic clock that moves only when the code under test sleeps."""
+
+    def __init__(self) -> None:
+        self.now = 0.0
+        self.sleeps = 0
+
+    def monotonic(self) -> float:
+        return self.now
+
+    def sleep(self, seconds: float) -> None:
+        self.sleeps += 1
+        self.now += seconds
+
+
+def decide(root: Path, state: Path, profile: str = "default", **kw: Any) -> host_mod.RunVerdict:
+    ticker = kw.pop("ticker", Ticker())
+    kw.setdefault("env", {})
+    kw.setdefault("identify", lambda _home, _t: None)
+    kw.setdefault("serve", lambda _home, _p, _t: wire.ControlReply(False, error="no_socket"))
+    return decide_second_run(
+        profile,
+        root=root,
+        record_dir=state,
+        sleep=ticker.sleep,
+        monotonic=ticker.monotonic,
+        **kw,
+    )
+
+
+def answers(served: list[str], pid: int | None = None) -> Any:
+    def identify(_home: Path, _timeout: float) -> Mapping[str, Any]:
+        return {"pid": os.getpid() if pid is None else pid, "served_profiles": served}
+
+    return identify
+
+
+# -- state dir, lock and record --------------------------------------------------------------------
+
+
+def test_the_state_dir_follows_xdg_state_home_else_home(tmp_path: Path) -> None:
+    xdg = tmp_path / "xdg"
+    assert host_state_dir({"XDG_STATE_HOME": str(xdg)}) == xdg / "indus"
+    assert host_state_dir({"XDG_STATE_HOME": "relative", "HOME": str(tmp_path)}) == (
+        tmp_path / ".local" / "state" / "indus"
+    )
+
+
+def test_the_record_dir_is_owner_only(state: Path) -> None:
+    state.mkdir(parents=True, mode=0o755)
+    os.chmod(state, 0o755)
+    ensure_state_dir(state)
+    assert stat.S_IMODE(state.stat().st_mode) == 0o700
+
+
+def test_the_record_round_trips_owner_only(root: Path, state: Path) -> None:
+    record = live_record(root, served=("default", "b"))
+    publish_record(state, record)
+    path = state / host_mod.RECORD_FILE
+    assert stat.S_IMODE(path.stat().st_mode) == 0o600
+    assert read_record(state) == record
+    assert json.loads(path.read_text())["served_profiles"] == ["default", "b"]
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["not json", "[]", '{"pid": 0, "protocol": 1, "root": "/r", "home": "/r"}', '{"pid": 5}'],
+)
+def test_a_malformed_record_reads_as_none(state: Path, text: str) -> None:
+    ensure_state_dir(state)
+    (state / host_mod.RECORD_FILE).write_text(text)
+    assert read_record(state) is None
+
+
+def test_a_record_owned_by_another_user_is_ignored(
+    root: Path, state: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    publish_record(state, live_record(root))
+    real = os.getuid()
+    monkeypatch.setattr(host_mod.os, "getuid", lambda: real + 1)
+    assert read_record(state) is None
+
+
+def test_clear_leaves_another_owners_record(root: Path, state: Path) -> None:
+    publish_record(state, live_record(root, pid=os.getpid() + 100_000))
+    assert clear_record(state) is False
+    assert read_record(state) is not None
+    publish_record(state, live_record(root))
+    assert clear_record(state) is True
+    assert read_record(state) is None
+
+
+def test_the_lock_is_exclusive_and_observable(state: Path) -> None:
+    first, second = HostLock(state), HostLock(state)
+    assert first.observed_free() is True  # no lock file yet
+    assert first.try_acquire()
+    assert not second.try_acquire()
+    assert second.observed_free() is False
+    first.release()
+    assert second.observed_free() is True
+    assert second.try_acquire()
+    second.release()
+
+
+def test_a_record_with_a_recycled_pid_is_stale(root: Path, state: Path) -> None:
+    holder = HostLock(state)
+    assert holder.try_acquire()
+    try:
+        recycled = live_record(root, start_time=(process_start_time(os.getpid()) or 0) + 999)
+        publish_record(state, recycled)
+        assert record_alive(recycled, HostLock(state)) is False
+        assert decide(root, state, identify=answers(["default"])).outcome == "start"
+    finally:
+        holder.release()
+
+
+def test_a_free_host_lock_makes_a_live_looking_record_stale(root: Path, state: Path) -> None:
+    publish_record(state, live_record(root))
+    verdict = decide(root, state, identify=answers(["default"]))
+    assert verdict.outcome == "start"
+
+
+def test_no_record_and_a_free_lock_starts(root: Path, state: Path) -> None:
+    assert decide(root, state).outcome == "start"
+
+
+# -- the second run --------------------------------------------------------------------------------
+
+
+@pytest.fixture
+def owner(root: Path, state: Path) -> Any:
+    lock = HostLock(state)
+    assert lock.try_acquire()
+    publish_record(state, live_record(root, served=("default", "b")))
+    yield lock
+    lock.release()
+
+
+def test_a_served_profile_attaches_with_0_at_a_shell_and_75_supervised(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    shell = decide(root, state, "b", identify=answers(["default", "b"]))
+    assert (shell.outcome, shell.exit_code, shell.owner_pid) == ("attach", 0, os.getpid())
+    service = decide(root, state, "b", identify=answers(["default", "b"]), env=SUPERVISED)
+    assert (service.outcome, service.exit_code) == ("attach", 75)
+
+
+def test_an_owner_that_never_answers_is_a_transient_refusal(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    ticker = Ticker()
+    calls: list[Path] = []
+
+    def silent(home: Path, _timeout: float) -> None:
+        calls.append(home)
+
+    verdict = decide(root, state, identify=silent, ticker=ticker)
+    assert (verdict.outcome, verdict.exit_code, verdict.transient) == ("refuse", 75, True)
+    assert len(calls) > 1 and ticker.now >= host_mod.ATTACH_WAIT_S
+    assert calls[0] == root  # the owner's launch home names its control socket
+
+
+def test_an_owner_that_answers_late_in_the_wait_attaches(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    ticker = Ticker()
+
+    def late(_home: Path, _timeout: float) -> Mapping[str, Any] | None:
+        return {"pid": os.getpid(), "served_profiles": ["default"]} if ticker.now >= 1 else None
+
+    assert decide(root, state, identify=late, ticker=ticker).outcome == "attach"
+
+
+def test_an_identify_answer_naming_another_home_is_not_the_owner(
+    root: Path, state: Path, owner: HostLock, tmp_path: Path
+) -> None:
+    def elsewhere(_home: Path, _timeout: float) -> Mapping[str, Any]:
+        return {"pid": os.getpid(), "home": str(tmp_path / "x"), "served_profiles": ["default"]}
+
+    assert decide(root, state, identify=elsewhere).exit_code == 75
+
+    def same(_home: Path, _timeout: float) -> Mapping[str, Any]:
+        return {"pid": os.getpid(), "home": str(root), "served_profiles": ["default"]}
+
+    assert decide(root, state, identify=same).outcome == "attach"
+
+
+def test_an_identify_answer_from_another_pid_is_not_the_owner(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    verdict = decide(root, state, identify=answers(["default"], pid=os.getpid() + 1))
+    assert (verdict.outcome, verdict.exit_code) == ("refuse", 75)
+
+
+def test_an_unserved_profile_is_served_then_attached(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    asked: list[tuple[str, float]] = []
+
+    def serve(_home: Path, profile: str, timeout: float) -> wire.ControlReply:
+        asked.append((profile, timeout))
+        return wire.ControlReply(True, {"served": profile, "served_profiles": ["default", "c"]})
+
+    verdict = decide(root, state, "c", identify=answers(["default", "b"]), serve=serve)
+    assert verdict.outcome == "attach"
+    assert asked == [("c", host_mod.SERVE_TIMEOUT_S)]
+
+
+def test_an_owner_still_serving_is_a_transient_refusal(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    def pending(_home: Path, _p: str, _t: float) -> wire.ControlReply:
+        return wire.ControlReply(True, {"pending": True, "served_profiles": ["default"]})
+
+    def timed_out(_home: Path, _p: str, _t: float) -> wire.ControlReply:
+        return wire.ControlReply(False, error="timeout")
+
+    for serve in (pending, timed_out):
+        verdict = decide(root, state, "c", identify=answers(["default"]), serve=serve)
+        assert (verdict.outcome, verdict.exit_code, verdict.transient) == ("refuse", 75, True)
+
+
+def test_an_owner_that_will_not_serve_refuses_for_good(
+    root: Path, state: Path, owner: HostLock
+) -> None:
+    def refuse(_home: Path, _p: str, _t: float) -> wire.ControlReply:
+        return wire.ControlReply(False, error="unknown_profile", detail="no live profile 'zz'")
+
+    shell = decide(root, state, "zz", identify=answers(["default"]), serve=refuse)
+    assert (shell.outcome, shell.exit_code, shell.transient) == ("refuse", 1, False)
+    assert "no live profile" in shell.message
+    service = decide(root, state, "zz", identify=answers(["default"]), serve=refuse, env=SUPERVISED)
+    assert service.exit_code == 78
+
+
+def test_a_held_lock_without_a_record_is_a_transient_refusal(root: Path, state: Path) -> None:
+    lock = HostLock(state)
+    assert lock.try_acquire()
+    try:
+        verdict = decide(root, state)
+        assert (verdict.outcome, verdict.exit_code) == ("refuse", 75)
+    finally:
+        lock.release()
+
+
+def test_an_owner_of_another_root_refuses(root: Path, state: Path, tmp_path: Path) -> None:
+    lock = HostLock(state)
+    assert lock.try_acquire()
+    try:
+        other = tmp_path / "other-root"
+        publish_record(state, live_record(root, root=str(other), home=str(other)))
+        verdict = decide(root, state, identify=answers(["default"]))
+        assert (verdict.outcome, verdict.exit_code) == ("refuse", 1)
+    finally:
+        lock.release()
+
+
+# -- serving ---------------------------------------------------------------------------------------
+
+
+class Hooks:
+    def __init__(self) -> None:
+        self.calls: list[tuple[str, str]] = []
+        self.gate: asyncio.Event | None = None
+        self.fail: set[str] = set()
+
+    async def serve(self, name: str, home: Path) -> None:
+        self.calls.append(("serve", name))
+        if self.gate is not None:
+            await self.gate.wait()
+        if name in self.fail:
+            raise RuntimeError("adapter start failed")
+
+    async def unserve(self, name: str, _home: Path) -> None:
+        self.calls.append(("unserve", name))
+
+
+def make_host(launch: Scope, state: Path, hooks: Hooks, **kw: Any) -> MultiplexHost:
+    return MultiplexHost(
+        launch, record_dir=state, on_serve=hooks.serve, on_unserve=hooks.unserve, **kw
+    )
+
+
+def test_claim_publishes_and_close_clears(launch: Scope, state: Path) -> None:
+    host = make_host(launch, state, Hooks())
+    assert host.claim()
+    record = read_record(state)
+    assert record is not None and record.served_profiles == ("default",)
+    assert record.root == str(launch.root) and record.pid == os.getpid()
+    assert not make_host(launch, state, Hooks()).claim()  # the lock is held
+    host.close()
+    assert read_record(state) is None and HostLock(state).observed_free() is True
+
+
+def test_serve_unserve_and_rescan(launch: Scope, state: Path, root: Path) -> None:
+    make_profile(root, "b")
+    make_profile(root, "c")
+    hooks = Hooks()
+    host = make_host(launch, state, hooks)
+    assert host.claim()
+
+    async def main() -> None:
+        served = await host.serve("B")
+        assert served == {"served": "b", "served_profiles": ["default", "b"]}
+        assert (await host.serve("b"))["already"] is True
+        with pytest.raises(ServeRefused) as unknown:
+            await host.serve("nobody")
+        assert unknown.value.code == "unknown_profile"
+        with pytest.raises(ServeRefused) as bad:
+            await host.serve("../x")
+        assert bad.value.code == "invalid_profile"
+        record = read_record(state)
+        assert record is not None and record.served_profiles == ("default", "b")
+        rescanned = await host.rescan()
+        assert rescanned["added"] == ["c"] and rescanned["removed"] == []
+        tombstone(root, "b")
+        rescanned = await host.rescan()
+        assert rescanned["removed"] == ["b"]
+        assert host.served_profiles() == ["default", "c"]
+        assert (await host.unserve("c"))["served_profiles"] == ["default"]
+        with pytest.raises(ServeRefused) as missing:
+            await host.unserve("c")
+        assert missing.value.code == "not_served"
+
+    run(main())
+    assert hooks.calls == [("serve", "b"), ("serve", "c"), ("unserve", "b"), ("unserve", "c")]
+    host.close()
+
+
+def test_the_launch_profile_cannot_be_unserved(launch: Scope, state: Path) -> None:
+    host = make_host(launch, state, Hooks())
+
+    async def main() -> None:
+        with pytest.raises(ServeRefused) as refused:
+            await host.unserve("default")
+        assert refused.value.code == "launch_profile"
+        assert (await host.rescan())["removed"] == []
+
+    run(main())
+    assert host.served_profiles() == ["default"]
+
+
+def test_a_profile_whose_adapters_fail_is_not_served(
+    launch: Scope, state: Path, root: Path
+) -> None:
+    make_profile(root, "b")
+    hooks = Hooks()
+    hooks.fail.add("b")
+    host = make_host(launch, state, hooks)
+
+    async def main() -> None:
+        with pytest.raises(ServeRefused) as failed:
+            await host.serve("b")
+        assert failed.value.code == "serve_failed"
+        assert (await host.rescan())["failed"] == ["b"]
+
+    run(main())
+    assert host.served_profiles() == ["default"]
+
+
+def test_a_profile_running_its_own_gateway_is_not_taken_on(
+    launch: Scope, state: Path, root: Path
+) -> None:
+    home_b = make_profile(root, "b")
+    parent = os.getppid()  # a live process that is not us: "b's own gateway"
+    write_pid_record(home_b, PidRecord(ProcessIdentity(parent, process_start_time(parent))))
+    hooks = Hooks()
+    host = make_host(launch, state, hooks)
+
+    async def main() -> None:
+        with pytest.raises(ServeRefused) as refused:
+            await host.serve("b")
+        assert refused.value.code == "own_gateway"
+        assert (await host.rescan())["failed"] == ["b"]
+
+    run(main())
+    assert hooks.calls == [] and host.served_profiles() == ["default"]
+
+
+def test_rescan_answers_pending_past_five_seconds(
+    launch: Scope, state: Path, root: Path, fake_clock: FakeClock
+) -> None:
+    make_profile(root, "b")
+    hooks = Hooks()
+    host = make_host(launch, state, hooks)
+    handler = host.control_verbs()["rescan-profiles"][0]
+
+    async def main() -> None:
+        hooks.gate = asyncio.Event()
+        answer = asyncio.ensure_future(handler({}))
+        await fake_clock.run_until_idle()
+        assert not answer.done()
+        fake_clock.advance(host_mod.VERB_BUDGET_S - 0.5)
+        await fake_clock.run_until_idle()
+        assert not answer.done()
+        fake_clock.advance(0.5)
+        result = await answer
+        assert result == {"pending": True, "served_profiles": ["default"]}
+        hooks.gate.set()
+        await host.aclose()
+        assert host.served_profiles() == ["default", "b"]
+
+    run(main())
+
+
+def test_a_fast_verb_answers_its_result_and_refusals_carry_codes(
+    launch: Scope, state: Path, root: Path
+) -> None:
+    make_profile(root, "b")
+    host = make_host(launch, state, Hooks())
+    verbs = host.control_verbs()
+    assert set(verbs) == set(host_mod.PROFILE_VERBS)
+
+    async def main() -> None:
+        assert (await verbs["serve-profile"][0]({"name": "b"}))["served"] == "b"
+        with pytest.raises(VerbRefused) as refused:
+            await verbs["unserve-profile"][0]({"name": "default"})
+        assert refused.value.code == "launch_profile"
+        with pytest.raises(VerbRefused) as missing:
+            await verbs["serve-profile"][0]({})
+        assert missing.value.code == "bad_request"
+
+    run(main())
+
+
+def test_the_verbs_are_owner_only_on_the_control_socket(
+    launch: Scope, state: Path, root: Path
+) -> None:
+    make_profile(root, "b")
+    host = make_host(launch, state, Hooks())
+    server = ControlServer(root, env={})
+    for verb, (handler, seconds) in host.control_verbs().items():
+        server.register(verb, handler, timeout=seconds)
+    line = json.dumps(
+        {"protocol": 1, "verb": "serve-profile", "id": 1, "params": {"name": "b"}}
+    ).encode()
+
+    async def main() -> None:
+        stranger = json.loads(await server.handle_line(line))
+        assert (stranger["ok"], stranger["error"]) == (False, "forbidden")
+        mine = json.loads(await server.handle_line(line, peer_verified=True))
+        assert mine["ok"] and mine["result"]["served_profiles"] == ["default", "b"]
+
+    run(main())
+    unregistered = ControlServer(root, env={})
+    answer = run(unregistered.handle_line(line, peer_verified=True))
+    assert json.loads(answer)["error"] == "unsupported"
+
+
+def test_identify_fields_name_the_served_set(launch: Scope, state: Path) -> None:
+    host = make_host(launch, state, Hooks())
+    assert host.identify_fields() == {
+        "multiplex": True,
+        "root": str(launch.root),
+        "served_profiles": ["default"],
+    }
+
+
+# -- tickets ---------------------------------------------------------------------------------------
+
+
+def test_tickets_are_minted_for_served_profiles_only(
+    launch: Scope, state: Path, root: Path
+) -> None:
+    home_b = make_profile(root, "b")
+    host = make_host(launch, state, Hooks())
+    book = TicketBook.for_home(root, served=host.served_ticket_ids)
+    with pytest.raises(TicketRefused) as unserved:
+        mint_routed_ticket(book, host, "b", WS_INTERACTIVE)
+    assert unserved.value.reason == "wrong_profile"
+    with pytest.raises(TicketRefused) as direct:
+        book.mint(WS_INTERACTIVE, profile_id=stable_profile_id(home_b))
+    assert direct.value.reason == "wrong_profile"
+
+    run(host.serve("b"))
+    minted = mint_routed_ticket(book, host, "b", WS_INTERACTIVE)
+    assert minted.profile_id == stable_profile_id(home_b)
+    own = book.mint(WS_INTERACTIVE)
+    assert book.redeem(own.ticket, purpose=WS_INTERACTIVE).profile_id == stable_profile_id(root)
+
+    run(host.unserve("b"))
+    with pytest.raises(TicketRefused) as gone:
+        book.redeem(minted.ticket, purpose=WS_INTERACTIVE)
+    assert gone.value.reason == "wrong_profile"
+    with pytest.raises(TicketRefused) as used:
+        book.redeem(minted.ticket, purpose=WS_INTERACTIVE)
+    assert used.value.reason == "used"  # the refused redemption spent it
+
+
+def test_a_served_set_that_cannot_be_read_refuses_tickets(root: Path) -> None:
+    def broken() -> frozenset[str]:
+        raise RuntimeError("no set")
+
+    book = TicketBook.for_home(root, served=broken)
+    with pytest.raises(TicketRefused) as refused:
+        book.mint(WS_INTERACTIVE)
+    assert refused.value.reason == "wrong_profile"
diff --git a/tests/unit/gateway/multiplex/test_no_env_reads.py b/tests/unit/gateway/multiplex/test_no_env_reads.py
new file mode 100644
index 0000000..b078c99
--- /dev/null
+++ b/tests/unit/gateway/multiplex/test_no_env_reads.py
@@ -0,0 +1,116 @@
+"""P24-02 guard: nothing under ``src/indus/gateway`` reads the process environment.
+
+Under multiplexing the process env belongs to the launch profile; every served profile reads its
+own scope (R06.26). This test parses every gateway module and fails on ``os.environ`` /
+``os.environb`` / ``os.getenv`` / ``os.putenv`` / ``os.unsetenv`` (any alias of ``os``),
+``from os import environ`` and friends, ``getattr(os, "environ")`` and ``EnvView.from_process()``.
+
+The allow-list is never widened without a written reason in ``docs/notes/P24/multiplex-scope.md``.
+It holds one launch-only default, and only for ``from_process``: raw ``os`` reads are never allowed.
+"""
+
+from __future__ import annotations
+
+import ast
+from pathlib import Path
+
+import indus.gateway
+from tooling.checks.no_raw_environ import ENV_NAMES, find_hits
+
+GATEWAY = Path(indus.gateway.__file__).parent
+
+FROM_PROCESS_ALLOWED: dict[str, str] = {
+    "control_socket.py": "ControlServer(env=None) falls back to the launch process's env for "
+    "supervisor detection; the control socket serves only the launch profile and the daemon "
+    "passes scope.env",
+}
+
+
+def _os_aliases(tree: ast.AST) -> set[str]:
+    aliases = {"os"}
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            aliases.update(n.asname or "os" for n in node.names if n.name == "os")
+    return aliases
+
+
+def _extra_hits(source: str) -> list[tuple[int, str]]:
+    """``from_process()`` calls and ``getattr(os, "environ")``-style reads."""
+    tree = ast.parse(source)
+    aliases = _os_aliases(tree)
+    found: list[tuple[int, str]] = []
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Call):
+            continue
+        func = node.func
+        if isinstance(func, ast.Attribute) and func.attr == "from_process":
+            found.append((node.lineno, "from_process()"))
+        elif (
+            isinstance(func, ast.Name)
+            and func.id == "getattr"
+            and len(node.args) >= 2
+            and isinstance(node.args[0], ast.Name)
+            and node.args[0].id in aliases
+            and isinstance(node.args[1], ast.Constant)
+            and node.args[1].value in ENV_NAMES
+        ):
+            found.append((node.lineno, f"getattr(os, {node.args[1].value!r})"))
+    return found
+
+
+def env_reads(tree_root: Path, allowed: dict[str, str] | None = None) -> list[str]:
+    """Every process-env read under ``tree_root`` (paths relative to it), allowed ones removed."""
+    allow = FROM_PROCESS_ALLOWED if allowed is None else allowed
+    hits: list[str] = []
+    for path in sorted(tree_root.rglob("*.py")):
+        rel = path.relative_to(tree_root).as_posix()
+        source = path.read_text(encoding="utf-8")
+        for hit in find_hits(source):
+            hits.append(f"{rel}:{hit.line}: {hit.what}")
+        for line, what in _extra_hits(source):
+            if what == "from_process()" and rel in allow:
+                continue
+            hits.append(f"{rel}:{line}: {what}")
+    return hits
+
+
+def test_the_gateway_never_reads_the_process_env() -> None:
+    assert env_reads(GATEWAY) == []
+
+
+def test_every_allow_list_entry_has_a_reason_and_still_applies() -> None:
+    for rel, reason in FROM_PROCESS_ALLOWED.items():
+        assert len(reason.split()) >= 8, rel
+        source = (GATEWAY / rel).read_text(encoding="utf-8")
+        assert any(what == "from_process()" for _, what in _extra_hits(source)), rel
+
+
+def test_a_seeded_environ_get_in_an_adapter_fails_the_guard(tmp_path: Path) -> None:
+    tree = tmp_path / "gateway"
+    adapter = tree / "adapters" / "seeded"
+    adapter.mkdir(parents=True)
+    (adapter / "__init__.py").write_text("")
+    (adapter / "adapter.py").write_text(
+        'import os\n\nTOKEN = os.environ.get("SEEDED_TOKEN")\n', encoding="utf-8"
+    )
+    assert env_reads(tree) == ["adapters/seeded/adapter.py:3: os.environ"]
+
+
+def test_other_spellings_are_caught_too(tmp_path: Path) -> None:
+    tree = tmp_path / "gateway"
+    tree.mkdir()
+    (tree / "a.py").write_text("from os import getenv\n", encoding="utf-8")
+    (tree / "b.py").write_text("import os as o\nx = o.getenv('X')\n", encoding="utf-8")
+    (tree / "c.py").write_text("import os\nx = getattr(os, 'environ')\n", encoding="utf-8")
+    (tree / "d.py").write_text(
+        "from indus.foundation.scope import EnvView\nv = EnvView.from_process()\n",
+        encoding="utf-8",
+    )
+    (tree / "control_socket.py").write_text("import os\nx = os.environ\n", encoding="utf-8")
+    assert env_reads(tree) == [
+        "a.py:1: from os import getenv",
+        "b.py:2: o.getenv",
+        "c.py:2: getattr(os, 'environ')",
+        "control_socket.py:2: os.environ",
+        "d.py:2: from_process()",
+    ]
diff --git a/tests/unit/gateway/multiplex/test_routes.py b/tests/unit/gateway/multiplex/test_routes.py
new file mode 100644
index 0000000..41f7d99
--- /dev/null
+++ b/tests/unit/gateway/multiplex/test_routes.py
@@ -0,0 +1,358 @@
+"""P24-03: profile routes, identity first, the intake and delivery resolvers."""
+
+from __future__ import annotations
+
+import json
+import logging
+import stat
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.gateway.core.session_keys import profile_of_key
+from indus.gateway.multiplex.routes import (
+    RESEND_TEXT,
+    AdapterTable,
+    ProfileRoute,
+    ProfileRouter,
+    ReceivingBots,
+    RouteQuery,
+    RoutingIdentity,
+    Unresolved,
+    match_route,
+    parse_routes,
+)
+from tests.unit.gateway.builders import src
+
+DEFAULT_BOT = object()
+B_BOT = object()
+SERVED = {"default", "b", "ops", "guilds", "chats", "threads", "users", "c"}
+
+
+def table(**bots: object) -> AdapterTable:
+    adapters = AdapterTable()
+    for profile, adapter in bots.items():
+        adapters.register(profile, "telegram", adapter)
+    return adapters
+
+
+def router(routes: list[dict[str, Any]], adapters: AdapterTable, **kw: Any) -> ProfileRouter:
+    parsed, problems = parse_routes(routes)
+    assert problems == []
+    kw.setdefault("served", lambda: SERVED)
+    return ProfileRouter(parsed, adapters, **kw)
+
+
+def ident(found: RoutingIdentity | Unresolved) -> RoutingIdentity:
+    assert isinstance(found, RoutingIdentity), found
+    return found
+
+
+# -- matching --------------------------------------------------------------------------------------
+
+LADDER = [
+    {"name": "g", "platform": "telegram", "profile": "guilds", "guild": "G"},
+    {"name": "c", "platform": "telegram", "profile": "chats", "chat": "C"},
+    {"name": "t", "platform": "telegram", "profile": "threads", "thread": "T"},
+    {"name": "u", "platform": "telegram", "profile": "users", "user": "U"},
+]
+
+
+@pytest.mark.parametrize(
+    ("fields", "expected"),
+    [
+        ({"guild_id": "G", "chat_id": "C", "thread_id": "T", "user_id": "U"}, "users"),
+        ({"guild_id": "G", "chat_id": "C", "thread_id": "T", "user_id": "x"}, "threads"),
+        ({"guild_id": "G", "chat_id": "C", "thread_id": "x", "user_id": "x"}, "chats"),
+        ({"guild_id": "G", "chat_id": "x", "thread_id": "x", "user_id": "x"}, "guilds"),
+        ({"guild_id": "x", "chat_id": "x", "thread_id": "x", "user_id": "x"}, "default"),
+    ],
+)
+def test_specificity_table(fields: dict[str, str], expected: str) -> None:
+    chat = fields.pop("chat_id")
+    source = src("telegram", chat, "group", **fields)
+    found = ident(router(LADDER, table(default=DEFAULT_BOT)).identify(source, DEFAULT_BOT))
+    assert found.runtime_profile == expected and found.transport_profile == "default"
+
+
+def test_weights_add_up_and_ties_keep_config_order() -> None:
+    routes, _ = parse_routes(
+        [
+            {"name": "chat", "platform": "telegram", "profile": "a", "chat": "C"},
+            {"name": "chat-guild", "platform": "telegram", "profile": "b", "chat": "C",
+             "guild": "G"},
+            {"name": "thread", "platform": "telegram", "profile": "c", "thread": "T"},
+            {"name": "all3", "platform": "telegram", "profile": "d", "thread": "T", "chat": "C",
+             "guild": "G"},
+            {"name": "user", "platform": "telegram", "profile": "e", "user": "U"},
+            {"name": "chat-2", "platform": "telegram", "profile": "f", "chat": "C"},
+        ]
+    )  # fmt: skip
+    assert [r.specificity for r in routes] == [16, 14, 8, 6, 4, 4]
+    assert [r.name for r in routes][-2:] == ["chat", "chat-2"]
+    query = RouteQuery(platform="telegram", guild="G", chat="C", thread="T", user="U")
+    assert [r.name for r in routes if r.matches(query)][0] == "user"
+    found = match_route(routes, RouteQuery(platform="telegram", chat="C", guild="G"))
+    assert found is not None and found.name == "chat-guild"
+
+
+def test_every_named_discriminator_must_match() -> None:
+    route = ProfileRoute(name="r", platform="telegram", profile="ops", chat="1", user="5")
+    assert route.matches(RouteQuery(platform="telegram", chat="1", user="5"))
+    assert not route.matches(RouteQuery(platform="telegram", chat="1", user="6"))
+    assert not route.matches(RouteQuery(platform="slack", chat="1", user="5"))
+    disabled = ProfileRoute(name="r", platform="telegram", profile="ops", chat="1", enabled=False)
+    assert not disabled.matches(RouteQuery(platform="telegram", chat="1"))
+
+
+def test_a_route_for_bot_a_is_ignored_for_bot_b() -> None:
+    adapters = table(default=DEFAULT_BOT, b=B_BOT)
+    shared = router([{"platform": "telegram", "profile": "ops", "chat": "100"}], adapters)
+    message = src("telegram", "100", user_id="100")
+    assert ident(shared.identify(message, DEFAULT_BOT)).runtime_profile == "ops"
+    own = ident(shared.identify(message, B_BOT))
+    assert (own.runtime_profile, own.transport_profile) == ("b", "b")
+
+    for_b = router(
+        [{"platform": "telegram", "profile": "ops", "chat": "100", "bot": "b"}], adapters
+    )
+    assert ident(for_b.identify(message, B_BOT)).runtime_profile == "ops"
+    assert ident(for_b.identify(message, DEFAULT_BOT)).runtime_profile == "default"
+
+
+def test_a_chat_route_matches_threads_under_it() -> None:
+    routed = router(
+        [{"platform": "telegram", "profile": "ops", "chat": "100"}], table(default=DEFAULT_BOT)
+    )
+    thread = src("telegram", "555", "thread", thread_id="555", parent_chat_id="100")
+    assert ident(routed.identify(thread, DEFAULT_BOT)).runtime_profile == "ops"
+    elsewhere = src("telegram", "556", "thread", thread_id="556", parent_chat_id="101")
+    assert ident(routed.identify(elsewhere, DEFAULT_BOT)).runtime_profile == "default"
+
+
+def test_parse_coerces_numbers_and_skips_bad_rows(caplog: pytest.LogCaptureFixture) -> None:
+    with caplog.at_level(logging.WARNING):
+        routes, problems = parse_routes(
+            [
+                {"name": "num", "platform": "Telegram", "profile": "Ops", "chat": -100, "bot": "B"},
+                {"name": "float", "platform": "telegram", "profile": "ops", "chat": 1.5},
+                {"name": "flag", "platform": "telegram", "profile": "ops", "user": True},
+                {"name": "blank", "platform": "telegram", "profile": "ops", "user": "  "},
+                {"name": "bad", "platform": "telegram", "profile": "Bad Name!"},
+                {"name": "half", "profile": "ops"},
+                "not a mapping",
+                {"name": "off", "platform": "telegram", "profile": "ops", "enabled": False},
+            ]
+        )
+    assert [(r.name, r.platform, r.profile, r.bot, r.chat) for r in routes] == [
+        ("num", "telegram", "ops", "b", "-100"),
+        ("off", "telegram", "ops", "default", None),
+    ]
+    assert routes[1].enabled is False
+    assert len(problems) == 6
+    assert "quote it" in problems[0] and "gateway.profile_routes" in caplog.text
+    assert parse_routes(None) == ([], [])
+    assert parse_routes({"a": 1}) == ([], ["profile_routes must be a list"])
+
+
+# -- identity --------------------------------------------------------------------------------------
+
+
+def test_a_route_to_a_profile_not_served_is_unresolved() -> None:
+    routed = router(
+        [{"platform": "telegram", "profile": "ghost", "chat": "1"}], table(default=DEFAULT_BOT)
+    )
+    found = routed.identify(src("telegram", "1"), DEFAULT_BOT)
+    assert found == Unresolved("unserved_profile", "ghost")
+
+
+def test_an_unregistered_adapter_is_unresolved() -> None:
+    routed = router([], table(default=DEFAULT_BOT))
+    assert routed.identify(src("telegram", "1"), object()) == Unresolved("unknown_bot")
+
+
+def test_the_receiving_bot_answers_a_routed_message() -> None:
+    adapters = table(default=DEFAULT_BOT, b=B_BOT)
+    routed = router([{"platform": "telegram", "profile": "ops", "chat": "1"}], adapters)
+    found = ident(routed.identify(src("telegram", "1"), DEFAULT_BOT))
+    assert found.route is not None and found.live
+    assert routed.intake_adapter(found) is DEFAULT_BOT
+    assert routed.delivery_adapter(found) is DEFAULT_BOT
+
+
+def test_a_pinned_bot_that_is_offline_delivers_nothing() -> None:
+    adapters = table(default=DEFAULT_BOT, b=B_BOT)
+    routed = router([{"platform": "telegram", "profile": "b", "chat": "1"}], adapters)
+    found = ident(routed.identify(src("telegram", "9"), B_BOT))
+    adapters.unregister("b", "telegram")
+    assert routed.intake_adapter(found) is None
+    assert routed.delivery_adapter(found) is None  # never the default bot by guess
+
+
+def test_a_restored_source_with_two_possible_owners_delivers_nowhere(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    adapters = table(default=DEFAULT_BOT, b=B_BOT)
+    routes = [
+        {"platform": "telegram", "profile": "ops", "chat": "1"},
+        {"platform": "telegram", "profile": "ops", "chat": "2", "bot": "b"},
+    ]
+    routed = router(routes, adapters)
+    restored = routed.restored_identity("ops:telegram:dm:1", "telegram")
+    assert (restored.runtime_profile, restored.transport_profile, restored.live) == (
+        "ops",
+        None,
+        False,
+    )
+    assert routed.owners("telegram", "ops") == ["b", "default"]
+    with caplog.at_level(logging.WARNING):
+        assert routed.delivery_adapter(restored) is None
+        assert routed.delivery_adapter(restored) is None
+    assert len([r for r in caplog.records if "no single bot" in r.message]) == 1
+
+    adapters.unregister("b")
+    assert routed.delivery_adapter(restored) is DEFAULT_BOT  # now the unique owner
+
+
+def test_a_secondary_without_a_bot_never_borrows_the_default() -> None:
+    adapters = table(default=DEFAULT_BOT)
+    routed = router([], adapters)
+    restored = routed.restored_identity("c:telegram:dm:1", "telegram")
+    assert adapters.for_profile("c") == {}
+    assert routed.delivery_adapter(restored) is None
+    own = routed.restored_identity("@default:telegram:dm:1", "telegram")
+    assert routed.delivery_adapter(own) is DEFAULT_BOT
+
+
+def test_the_receiving_bot_survives_a_restart(tmp_path: Path) -> None:
+    adapters = table(default=DEFAULT_BOT, b=B_BOT)
+    routes = [{"platform": "telegram", "profile": "ops", "chat": "1", "bot": "b"}]
+    first = router(routes, adapters, bots=ReceivingBots(tmp_path))
+    message = src("telegram", "1", user_id="1")
+    found = ident(first.identify(message, B_BOT))
+    key = first.session_key(message, found)
+    first.remember(key, found)
+
+    again = router(routes, adapters, bots=ReceivingBots(tmp_path))
+    restored = again.restored_identity(key, "telegram")
+    assert (restored.runtime_profile, restored.transport_profile) == ("ops", "b")
+    assert again.delivery_adapter(restored) is B_BOT
+    path = tmp_path / "gateway" / "receiving_bots.json"
+    assert stat.S_IMODE(path.stat().st_mode) == 0o600
+
+
+def test_receiving_bots_keep_the_newest_rows(tmp_path: Path) -> None:
+    bots = ReceivingBots(tmp_path, limit=3)
+    for n in range(4):
+        bots.remember(f"k{n}", "b")
+    reloaded = ReceivingBots(tmp_path, limit=3)
+    assert [reloaded.get(f"k{n}") for n in range(4)] == [None, "b", "b", "b"]
+    reloaded.forget("k3")
+    assert ReceivingBots(tmp_path).get("k3") is None
+    bots.path.write_text(json.dumps({"x": "Not An Id!", "y": "ops", "z": 3}))
+    assert ReceivingBots(tmp_path).get("x") is None and ReceivingBots(tmp_path).get("y") == "ops"
+    bots.path.write_text("garbage")
+    assert ReceivingBots(tmp_path).get("y") is None
+
+
+def test_session_keys_use_the_runtime_profiles_namespace() -> None:
+    routed = router(
+        [{"platform": "telegram", "profile": "ops", "chat": "1"}], table(default=DEFAULT_BOT)
+    )
+    routed_dm = src("telegram", "1", user_id="1")
+    key = routed.session_key(routed_dm, ident(routed.identify(routed_dm, DEFAULT_BOT)))
+    assert key == "ops:telegram:dm:1" and profile_of_key(key) == "ops"
+    plain = src("telegram", "2", user_id="2")
+    own = routed.session_key(plain, ident(routed.identify(plain, DEFAULT_BOT)))
+    assert own == "@default:telegram:dm:2" and profile_of_key(own) == "default"
+    assert profile_of_key("") == "default"
+
+
+# -- dropping --------------------------------------------------------------------------------------
+
+
+def test_unresolved_is_dropped_with_one_warning_and_one_resend(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    routed = router(
+        [{"platform": "telegram", "profile": "ghost", "chat": "1"}], table(default=DEFAULT_BOT)
+    )
+    sent: list[tuple[str, str]] = []
+
+    def notify(source: Any, text: str) -> None:
+        sent.append((source.chat_id, text))
+
+    message = src("telegram", "1")
+    with caplog.at_level(logging.WARNING):
+        for _ in range(3):
+            unresolved = routed.identify(message, DEFAULT_BOT)
+            assert isinstance(unresolved, Unresolved)
+            routed.drop_unresolved(message, unresolved, acknowledged=True, notify=notify)
+    assert sent == [("1", RESEND_TEXT)]
+    assert len([r for r in caplog.records if "dropped" in r.message]) == 1
+
+    unacked = src("telegram", "7")
+    routed.drop_unresolved(unacked, Unresolved("unknown_bot"), acknowledged=False, notify=notify)
+    assert len(sent) == 1
+
+
+def test_a_target_that_resolves_again_is_warned_about_again(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    served = {"default"}
+    routed = router(
+        [{"platform": "telegram", "profile": "ops", "chat": "1"}],
+        table(default=DEFAULT_BOT),
+        served=lambda: served,
+    )
+    message = src("telegram", "1")
+    notices: list[str] = []
+    with caplog.at_level(logging.WARNING):
+        miss = routed.identify(message, DEFAULT_BOT)
+        assert isinstance(miss, Unresolved)
+        routed.drop_unresolved(
+            message, miss, acknowledged=True, notify=lambda _s, t: notices.append(t)
+        )
+        served.add("ops")
+        ident(routed.identify(message, DEFAULT_BOT))
+        served.discard("ops")
+        miss = routed.identify(message, DEFAULT_BOT)
+        assert isinstance(miss, Unresolved)
+        routed.drop_unresolved(
+            message, miss, acknowledged=True, notify=lambda _s, t: notices.append(t)
+        )
+    assert len(notices) == 2
+    assert len([r for r in caplog.records if "dropped" in r.message]) == 2
+
+
+def test_a_failing_resend_is_logged() -> None:
+    routed = router([], table(default=DEFAULT_BOT))
+
+    def broken(_source: Any, _text: str) -> None:
+        raise RuntimeError("send failed")
+
+    sent = routed.drop_unresolved(
+        src("telegram", "1"), Unresolved("unknown_bot"), acknowledged=True, notify=broken
+    )
+    assert sent is False
+
+
+def test_a_profile_with_its_own_bot_never_borrows_a_route_bot() -> None:
+    adapters = table(default=DEFAULT_BOT)
+    adapters.register("ops", "slack", object())
+    routed = router([{"platform": "telegram", "profile": "ops", "chat": "1"}], adapters)
+    restored = routed.restored_identity("ops:telegram:dm:1", "telegram")
+    assert adapters.claims("ops") == {"slack"}
+    assert routed.owners("telegram", "ops") == []
+    assert routed.delivery_adapter(restored) is None
+
+    own = AdapterTable()
+    own.register("c", "telegram", B_BOT)
+    own.register("default", "telegram", DEFAULT_BOT)
+    satellite = router([{"platform": "telegram", "profile": "c", "chat": "1"}], own)
+    own.unregister("c", "telegram")  # its bot went offline: still its own boundary
+    assert satellite.owners("telegram", "c") == []
+    own.unregister("c", release=True)  # unserved
+    assert own.claims("c") == set()
+    assert satellite.owners("telegram", "c") == ["default"]
