+"""Shared pm fixtures: a fake origin, a tiny package list and a ``Pm`` wired to both."""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Iterator
+from pathlib import Path
+
+import pytest
+
+from indus.pm.core import Package, Pm, parse_definitions
+from indus.pm.lock import Artifact, Lock, Pin
+from tests.fakes.clock import FakeClock
+from tests.fakes.pm_origin import MIRROR, FakeOrigin, definitions_text, sha256, tar_gz
+
+TARGET = "linux-x64"
+TOOL_SCRIPT = b"#!/bin/sh\necho tool-1.0\n"
+
+
+def tool_rows(version: str = "1.0", **extra: object) -> dict[str, object]:
+    return {
+        "summary": "a test tool",
+        "kind": "required",
+        "version": version,
+        "url": "https://dl.example/tool/{version}/tool-{plat}.tar.gz",
+        "format": "tar.gz",
+        "strip": 1,
+        "exe": "bin/tool",
+        "path": ["bin"],
+        "releases": "github:example/tool",
+        "targets": {TARGET: {"plat": "linux-x64"}, "darwin-arm64": {"plat": "darwin-arm64"}},
+        **extra,
+    }
+
+
+def extra_rows() -> dict[str, object]:
+    return {
+        "summary": "a default extra",
+        "kind": "default",
+        "version": "2.0",
+        "url": "https://dl.example/extra/extra-{version}",
+        "format": "file",
+        "exe": "extra",
+        "releases": "pinned",
+        "targets": {"any": {}},
+    }
+
+
+def standard_packages() -> dict[str, Package]:
+    return parse_definitions(definitions_text({"tool": tool_rows(), "extra": extra_rows()}))
+
+
+def tool_archive(version: str = "1.0") -> bytes:
+    return tar_gz({"bin/tool": TOOL_SCRIPT.replace(b"1.0", version.encode()), "README": b"hi"})
+
+
+@pytest.fixture
+def origin() -> FakeOrigin:
+    return FakeOrigin()
+
+
+@pytest.fixture
+def pm_root(tmp_path: Path) -> Path:
+    root = tmp_path / "root"
+    root.mkdir()
+    return root
+
+
+@pytest.fixture
+def make_pm(
+    pm_root: Path, origin: FakeOrigin, fake_clock: FakeClock
+) -> Iterator[Callable[..., Pm]]:
+    made: list[Pm] = []
+
+    def build(
+        packages: dict[str, Package] | None = None, root: Path | None = None, **kw: object
+    ) -> Pm:
+        settings: dict[str, object] = {
+            "env": {"PATH": "/usr/bin"},
+            "target": TARGET,
+            "packages": packages if packages is not None else standard_packages(),
+            "mirror": MIRROR,
+            "transport": origin.transport(),
+            "clock": fake_clock,
+        }
+        settings.update(kw)
+        pm = Pm(root or pm_root, **settings)  # type: ignore[arg-type]
+        made.append(pm)
+        return pm
+
+    yield build
+    for pm in made:
+        pm.close()
+
+
+def publish_tool(origin: FakeOrigin, version: str = "1.0") -> Artifact:
+    data = tool_archive(version)
+    url = origin.add(f"tool/{version}/tool-linux-x64.tar.gz", data)
+    return Artifact(url, sha256(data))
+
+
+def publish_extra(origin: FakeOrigin) -> Artifact:
+    data = b"#!/bin/sh\necho extra\n"
+    url = origin.add("extra/extra-2.0", data)
+    return Artifact(url, sha256(data))
+
+
+def write_lock(pm: Pm, pins: dict[str, Pin]) -> None:
+    Lock(pins).write(pm.paths.lock)
+
+
+@pytest.fixture
+def locked_pm(make_pm: Callable[..., Pm], origin: FakeOrigin) -> Pm:
+    """A pm whose lock pins ``tool`` 1.0 (linux-x64) and ``extra`` 2.0 (any)."""
+    pm = make_pm()
+    write_lock(
+        pm,
+        {
+            "tool": Pin("1.0", {TARGET: publish_tool(origin)}),
+            "extra": Pin("2.0", {"any": publish_extra(origin)}),
+        },
+    )
+    return pm
diff --git a/tests/unit/pm/test_commands.py b/tests/unit/pm/test_commands.py
new file mode 100644
index 0000000..aa8eaa0
--- /dev/null
+++ b/tests/unit/pm/test_commands.py
@@ -0,0 +1,304 @@
+"""P24-24: the operations behind `indus pm` (lock, install, doctor, repair, gc, bundle, status,
+update)."""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from datetime import timedelta
+from pathlib import Path
+
+import httpx
+import pytest
+
+from indus.pm import commands as ops
+from indus.pm.core import Pm, parse_definitions
+from indus.pm.lock import ANY, Lock, Pin, PmError
+from tests.fakes.clock import FakeClock
+from tests.fakes.pm_origin import FakeOrigin, definitions_text, sha256, tar_gz
+from tests.unit.pm.conftest import TARGET, extra_rows, publish_tool, tool_archive, tool_rows
+
+
+class NoNetwork(httpx.BaseTransport):
+    def handle_request(self, request: httpx.Request) -> httpx.Response:
+        raise AssertionError(f"network used: {request.url}")
+
+
+# -- lock ------------------------------------------------------------------------------------------
+
+
+def test_lock_pins_every_target_and_collapses_shared_urls(
+    make_pm: Callable[..., Pm], origin: FakeOrigin
+) -> None:
+    pm = make_pm()
+    linux = origin.add("tool/1.0/tool-linux-x64.tar.gz", tool_archive())
+    mac_data = tar_gz({"bin/tool": b"mac"})
+    origin.add("tool/1.0/tool-darwin-arm64.tar.gz", mac_data)
+    extra = origin.add("extra/extra-2.0", b"extra")
+    op = ops.lock_packages(pm)
+    assert op.exit_code == 0
+    lock = Lock.read(pm.paths.lock)
+    assert lock.packages["tool"].version == "1.0"
+    assert lock.packages["tool"].artifacts[TARGET].url == linux
+    assert lock.packages["tool"].artifacts["darwin-arm64"].sha256 == sha256(mac_data)
+    assert set(lock.packages["extra"].artifacts) == {ANY}
+    assert lock.packages["extra"].artifacts[ANY].url == extra
+    origin.seen.clear()
+    assert ops.lock_packages(pm).exit_code == 0
+    assert origin.seen == []  # unchanged URLs keep their hashes
+
+
+def test_a_target_that_fails_to_resolve_fails_its_package_only(
+    make_pm: Callable[..., Pm], origin: FakeOrigin
+) -> None:
+    pm = make_pm()
+    origin.add("extra/extra-2.0", b"extra")
+    op = ops.lock_packages(pm)
+    assert op.exit_code == 1
+    assert [(s.name, s.ok) for s in op.steps] == [("pin tool", False), ("pin extra", True)]
+    assert set(Lock.read(pm.paths.lock).packages) == {"extra"}
+    assert ops.read_receipt(pm)["outcome"] == "partial"  # type: ignore[index]
+
+
+# -- install ---------------------------------------------------------------------------------------
+
+
+def test_install_takes_required_and_default_packages(locked_pm: Pm) -> None:
+    op, warnings = ops.install(locked_pm)
+    assert op.exit_code == 0 and warnings == []
+    assert sorted(locked_pm.facts().packages) == ["extra", "tool"]
+
+
+def test_without_declines_a_default_now_and_later(locked_pm: Pm) -> None:
+    ops.install(locked_pm, without=["extra"])
+    assert sorted(locked_pm.facts().packages) == ["tool"]
+    assert locked_pm.facts().declined == ["extra"]
+    ops.install(locked_pm)
+    assert "extra" not in locked_pm.facts().packages
+    ops.install(locked_pm, ["extra"])
+    assert "extra" in locked_pm.facts().packages
+    assert locked_pm.facts().declined == []
+
+
+def test_without_takes_only_default_packages(locked_pm: Pm) -> None:
+    with pytest.raises(ops.UsageProblem, match="tool is required"):
+        ops.install(locked_pm, without=["tool"])
+    with pytest.raises(PmError, match="unknown package"):
+        ops.install(locked_pm, without=["nope"])
+
+
+def test_a_failing_default_warns_and_does_not_fail(locked_pm: Pm, origin: FakeOrigin) -> None:
+    pin = locked_pm.pin("extra").artifacts[ANY]
+    origin.status[pin.url] = 404
+    origin.mirror_blobs.clear()
+    op, warnings = ops.install(locked_pm)
+    assert op.exit_code == 0
+    assert warnings and "extra was not installed" in warnings[0]
+    assert ops.read_receipt(locked_pm)["outcome"] == "partial"  # type: ignore[index]
+
+
+def test_install_needs_a_lock(make_pm: Callable[..., Pm]) -> None:
+    with pytest.raises(PmError, match="nothing is locked yet"):
+        ops.install(make_pm())
+
+
+# -- doctor and repair -----------------------------------------------------------------------------
+
+
+def test_doctor_reports_a_tampered_store_entry(locked_pm: Pm) -> None:
+    ops.install(locked_pm)
+    assert {r.name: r.state for r in ops.doctor(locked_pm)} == {"extra": "ok", "tool": "ok"}
+    runner = locked_pm.ensure("tool")
+    (runner.entry / "README").write_text("changed behind pm's back")
+    rows = {r.name: r for r in ops.doctor(locked_pm)}
+    assert rows["tool"].state == "tampered" and rows["tool"].bad
+    assert rows["extra"].state == "ok"
+
+
+def test_doctor_states(locked_pm: Pm, origin: FakeOrigin) -> None:
+    rows = {r.name: (r.state, r.bad) for r in ops.doctor(locked_pm)}
+    assert rows == {"extra": ("not installed", False), "tool": ("not installed", True)}
+    ops.install(locked_pm)
+    runner = locked_pm.ensure("tool")
+    assert runner.executable is not None
+    runner.executable.unlink()
+    assert {r.name: r.state for r in ops.doctor(locked_pm)}["tool"] == "tampered"
+    ops.repair(locked_pm)
+    lock = Lock.read(locked_pm.paths.lock)
+    lock.packages["tool"] = Pin("1.1", {TARGET: publish_tool(origin, "1.1")})
+    lock.write(locked_pm.paths.lock)
+    rows2 = {r.name: r for r in ops.doctor(locked_pm)}
+    assert (rows2["tool"].state, rows2["tool"].detail) == ("outdated", "1.0 installed, 1.1 locked")
+
+
+def test_repair_rebuilds_without_changing_the_graph(locked_pm: Pm) -> None:
+    ops.install(locked_pm)
+    runner = locked_pm.ensure("tool")
+    lock_before = locked_pm.paths.lock.read_bytes()
+    (runner.entry / "bin" / "tool").write_text("broken")
+    op = ops.repair(locked_pm)
+    assert [(s.name, s.ok) for s in op.steps] == [("repair tool", True)]
+    assert (runner.entry / "bin" / "tool").read_bytes().startswith(b"#!/bin/sh")
+    assert {r.state for r in ops.doctor(locked_pm)} == {"ok"}
+    assert locked_pm.paths.lock.read_bytes() == lock_before
+    assert sorted(locked_pm.facts().packages) == ["extra", "tool"]
+    assert ops.repair(locked_pm).steps == []
+
+
+# -- gc --------------------------------------------------------------------------------------------
+
+
+def test_gc_keeps_everything_the_facts_reference(locked_pm: Pm) -> None:
+    ops.install(locked_pm)
+    store = locked_pm.paths.store
+    downloads = locked_pm.paths.downloads
+    (store / "old-0.9-0123456789abcdef").mkdir()
+    (store / ".staging-1-dead").mkdir()
+    (downloads / ("f" * 64)).write_bytes(b"stale")
+    (downloads / (("e" * 64) + ".part")).write_bytes(b"half")
+    kept_entries = {p.name for p in locked_pm.store.entries()} - {"old-0.9-0123456789abcdef"}
+    op = ops.gc(locked_pm)
+    removed = sorted(s.name for s in op.steps if s.name.startswith("remove"))
+    assert removed == [
+        "remove .staging-1-dead",
+        f"remove downloads/{'e' * 64}.part",
+        f"remove downloads/{'f' * 64}",
+        "remove old-0.9-0123456789abcdef",
+    ]
+    assert {p.name for p in locked_pm.store.entries()} == kept_entries
+    assert {p.name for p in downloads.iterdir()} == locked_pm.facts().blobs_in_use()
+    assert {r.state for r in ops.doctor(locked_pm)} == {"ok"}
+
+
+# -- bundle ----------------------------------------------------------------------------------------
+
+
+def test_a_bundle_installs_offline_in_a_second_root(
+    locked_pm: Pm, make_pm: Callable[..., Pm], tmp_path: Path
+) -> None:
+    ops.install(locked_pm)
+    out = tmp_path / "bundle"
+    op = ops.bundle(locked_pm, out)
+    assert {s.name for s in op.steps} == {"bundle tool", "bundle extra"}
+    assert (out / "lock.json").is_file() and (out / "facts.json").is_file()
+    assert (out / ops.BUNDLE_FILE).is_file()
+    for fact in locked_pm.facts().packages.values():
+        assert (out / "blobs" / fact.sha256).is_file()
+        assert (out / "store" / fact.entry).is_dir()
+    second = tmp_path / "second-root"
+    second.mkdir()
+    offline = make_pm(root=second, transport=NoNetwork(), mirror="", local_dirs=(out,))
+    assert ops.adopt_bundle_lock(offline, out)
+    install_op, _ = ops.install(offline)
+    assert install_op.exit_code == 0
+    runner = offline.ensure("tool")
+    assert runner.entry.is_relative_to(second)
+    assert {r.state for r in ops.doctor(offline)} == {"ok"}
+
+
+def test_bundle_refuses_a_used_folder_and_a_damaged_store(locked_pm: Pm, tmp_path: Path) -> None:
+    used = tmp_path / "used"
+    used.mkdir()
+    (used / "x").write_text("x")
+    with pytest.raises(ops.UsageProblem, match="not empty"):
+        ops.bundle(locked_pm, used)
+    with pytest.raises(PmError, match="installed nothing"):
+        ops.bundle(locked_pm, tmp_path / "empty")
+    ops.install(locked_pm)
+    (locked_pm.ensure("tool").entry / "README").write_text("x")
+    with pytest.raises(PmError, match="repair"):
+        ops.bundle(locked_pm, tmp_path / "fresh")
+
+
+# -- status ----------------------------------------------------------------------------------------
+
+
+def test_status_json_shape(locked_pm: Pm, fake_clock: FakeClock) -> None:
+    assert ops.status(locked_pm) == {"schema": 1, "receipt": None}
+    ops.install(locked_pm, ["tool"])
+    assert ops.status(locked_pm) == {
+        "schema": 1,
+        "receipt": {
+            "schema": 1,
+            "operation": "install",
+            "started_at": "2026-01-01T09:00:00+00:00",
+            "finished_at": "2026-01-01T09:00:00+00:00",
+            "outcome": "ok",
+            "exit_code": 0,
+            "steps": [{"name": "install tool", "ok": True, "detail": "1.0"}],
+        },
+    }
+
+
+# -- update ----------------------------------------------------------------------------------------
+
+
+def _releases(fake_clock: FakeClock, *rows: tuple[str, int, bool]) -> list[dict[str, object]]:
+    now = fake_clock.now()
+    return [
+        {
+            "tag_name": tag,
+            "published_at": (now - timedelta(days=age)).isoformat().replace("+00:00", "Z"),
+            "draft": False,
+            "prerelease": pre,
+        }
+        for tag, age, pre in rows
+    ]
+
+
+def test_update_takes_the_newest_release_at_least_14_days_old(
+    locked_pm: Pm, origin: FakeOrigin, fake_clock: FakeClock
+) -> None:
+    origin.json_docs[ops.GITHUB_RELEASES.format(repo="example/tool")] = _releases(
+        fake_clock, ("1.3", 3, False), ("1.2-rc", 15, True), ("1.1", 20, False), ("1.0", 90, False)
+    )
+    rows = {r.name: r for r in ops.check_updates(locked_pm)}
+    assert (rows["tool"].locked, rows["tool"].newest, rows["tool"].changed) == ("1.0", "1.1", True)
+    assert rows["extra"].newest is None and rows["extra"].reason == "moves only with the product"
+    assert Lock.read(locked_pm.paths.lock).packages["tool"].version == "1.0"  # check writes nothing
+
+
+def test_apply_updates_repins_and_reinstalls(
+    locked_pm: Pm, origin: FakeOrigin, fake_clock: FakeClock
+) -> None:
+    ops.install(locked_pm)
+    origin.json_docs[ops.GITHUB_RELEASES.format(repo="example/tool")] = _releases(
+        fake_clock, ("1.1", 20, False)
+    )
+    publish_tool(origin, "1.1")
+    origin.add("tool/1.1/tool-darwin-arm64.tar.gz", b"mac")
+    rows = ops.check_updates(locked_pm)
+    op = ops.apply_updates(locked_pm, rows)
+    assert op.exit_code == 0
+    assert Lock.read(locked_pm.paths.lock).packages["tool"].version == "1.1"
+    assert locked_pm.facts().packages["tool"].version == "1.1"
+
+
+def test_node_releases_take_the_newest_lts(
+    make_pm: Callable[..., Pm], origin: FakeOrigin, fake_clock: FakeClock
+) -> None:
+    pm = make_pm(parse_definitions(definitions_text({"node": {**tool_rows(), "releases": "node"}})))
+    day = fake_clock.now().date()
+    origin.json_docs[ops.NODE_INDEX] = [
+        {"version": "v24.0.0", "date": str(day - timedelta(days=30)), "lts": False},
+        {"version": "v22.12.0", "date": str(day - timedelta(days=5)), "lts": "Jod"},
+        {"version": "v22.11.0", "date": str(day - timedelta(days=40)), "lts": "Jod"},
+    ]
+    assert ops.newest_release(pm, pm.package("node"), fake_clock.now()) == "22.11.0"
+
+
+def test_a_failed_lookup_is_reported(locked_pm: Pm, origin: FakeOrigin) -> None:
+    rows = {r.name: r for r in ops.check_updates(locked_pm, ["tool"])}
+    assert rows["tool"].reason.startswith("lookup failed")
+
+
+def test_update_needs_a_lock(make_pm: Callable[..., Pm]) -> None:
+    with pytest.raises(PmError, match="indus pm lock"):
+        ops.check_updates(make_pm())
+
+
+def test_env_exports_only_installed_packages(locked_pm: Pm) -> None:
+    assert ops.env_exports(locked_pm) == {}
+    ops.install(locked_pm, ["tool"])
+    runner = locked_pm.ensure("tool")
+    assert ops.env_exports(locked_pm) == {"PATH": [str(runner.entry / "bin")]}
+    assert extra_rows()["kind"] == "default"
diff --git a/tests/unit/pm/test_fetch.py b/tests/unit/pm/test_fetch.py
new file mode 100644
index 0000000..d6a19aa
--- /dev/null
+++ b/tests/unit/pm/test_fetch.py
@@ -0,0 +1,185 @@
+"""P24-23: verified fetch with mirror fallback, resumable ranges, timeouts, https-only."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from indus.pm.fetch import Fetcher, FetchFailed, mirror_url
+from indus.pm.lock import PmError
+from tests.fakes.pm_origin import MIRROR, FakeOrigin, sha256
+
+DATA = bytes(range(256)) * 40  # 10,240 bytes
+DIGEST = sha256(DATA)
+
+
+def make(tmp_path: Path, origin: FakeOrigin, **kw: object) -> Fetcher:
+    settings: dict[str, object] = {
+        "mirror": MIRROR,
+        "timeout": 7.5,
+        "transport": origin.transport(),
+    }
+    settings.update(kw)
+    return Fetcher(tmp_path / "downloads", **settings)  # type: ignore[arg-type]
+
+
+def fetch(tmp_path: Path, origin: FakeOrigin, url: str, digest: str = DIGEST, **kw: object) -> Path:
+    fetcher = make(tmp_path, origin, **kw)
+    try:
+        return fetcher.fetch(url, digest)
+    finally:
+        fetcher.close()
+
+
+def test_mirror_url_is_content_addressed() -> None:
+    assert mirror_url("https://m.example/x/", "a" * 64) == "https://m.example/x/sha256/" + "a" * 64
+    with pytest.raises(PmError):
+        mirror_url("https://m.example", "abc")
+
+
+def test_a_hash_mismatch_at_the_primary_falls_back_to_the_mirror(
+    tmp_path: Path, origin: FakeOrigin
+) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.wrong.add(url)
+    blob = fetch(tmp_path, origin, url)
+    assert blob == tmp_path / "downloads" / DIGEST
+    assert blob.read_bytes() == DATA
+    assert origin.urls() == [url, f"{MIRROR}/sha256/{DIGEST}"]
+    assert not list((tmp_path / "downloads").glob("*.part"))
+
+
+def test_the_mirror_must_verify_too(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.wrong.update({url, f"{MIRROR}/sha256/{DIGEST}"})
+    with pytest.raises(FetchFailed) as caught:
+        fetch(tmp_path, origin, url)
+    text = str(caught.value)
+    assert f"primary {url}: sha256 mismatch" in text
+    assert "mirror https://mirror.example/pm/sha256/" in text
+    assert not (tmp_path / "downloads" / DIGEST).exists()
+
+
+def test_without_a_mirror_a_bad_primary_fails(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.wrong.add(url)
+    with pytest.raises(FetchFailed, match="pm.mirror_url"):
+        fetch(tmp_path, origin, url, mirror="")
+    assert origin.urls() == [url]
+
+
+def test_a_missing_primary_falls_back_to_the_mirror(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.status[url] = 404
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+
+
+def test_a_dropped_connection_resumes_with_a_range_request(
+    tmp_path: Path, origin: FakeOrigin
+) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.cut_once[url] = 4000
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+    assert [s.headers.get("range") for s in origin.seen] == [None, "bytes=4000-"]
+
+
+def test_a_part_left_by_an_earlier_run_is_continued(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    downloads = tmp_path / "downloads"
+    downloads.mkdir()
+    (downloads / f"{DIGEST}.part").write_bytes(DATA[:1000])
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+    assert [s.headers.get("range") for s in origin.seen] == ["bytes=1000-"]
+
+
+def test_a_server_that_ignores_ranges_restarts_from_zero(
+    tmp_path: Path, origin: FakeOrigin
+) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.ignore_range.add(url)
+    downloads = tmp_path / "downloads"
+    downloads.mkdir()
+    (downloads / f"{DIGEST}.part").write_bytes(DATA[:1000])
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+
+
+def test_a_complete_part_answered_416_is_checked_and_kept(
+    tmp_path: Path, origin: FakeOrigin
+) -> None:
+    url = origin.add("a.bin", DATA)
+    downloads = tmp_path / "downloads"
+    downloads.mkdir()
+    (downloads / f"{DIGEST}.part").write_bytes(DATA)
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+
+
+def test_a_bad_kept_part_is_retried_from_zero_at_the_same_origin(
+    tmp_path: Path, origin: FakeOrigin
+) -> None:
+    url = origin.add("a.bin", DATA)
+    downloads = tmp_path / "downloads"
+    downloads.mkdir()
+    (downloads / f"{DIGEST}.part").write_bytes(b"garbage!")
+    assert fetch(tmp_path, origin, url, mirror="").read_bytes() == DATA
+    assert [s.headers.get("range") for s in origin.seen] == ["bytes=8-", None]
+
+
+def test_every_request_carries_the_timeout(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    origin.cut_once[url] = 10
+    fetch(tmp_path, origin, url)
+    assert origin.seen
+    for seen in origin.seen:
+        assert seen.timeout == {"connect": 7.5, "read": 7.5, "write": 7.5, "pool": 7.5}
+
+
+def test_redirects_stay_on_https(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    hop = "https://dl.example/moved"
+    origin.redirects[hop] = url
+    assert fetch(tmp_path, origin, hop).read_bytes() == DATA
+    plain = "https://dl.example/plain"
+    origin.redirects[plain] = "http://dl.example/a.bin"
+    with pytest.raises(FetchFailed, match="refusing non-https URL"):
+        fetch(tmp_path / "other", origin, plain, mirror="")
+
+
+def test_a_plain_http_url_is_refused(tmp_path: Path, origin: FakeOrigin) -> None:
+    with pytest.raises(FetchFailed, match="non-https"):
+        fetch(tmp_path, origin, "http://dl.example/a.bin", mirror="")
+    assert origin.seen == []
+
+
+def test_a_cached_blob_is_reused_without_a_request(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    fetch(tmp_path, origin, url)
+    origin.seen.clear()
+    assert fetch(tmp_path, origin, url).read_bytes() == DATA
+    assert origin.seen == []
+
+
+def test_a_bundle_folder_is_tried_before_the_network(tmp_path: Path, origin: FakeOrigin) -> None:
+    bundle = tmp_path / "bundle"
+    (bundle / "blobs").mkdir(parents=True)
+    (bundle / "blobs" / DIGEST).write_bytes(DATA)
+    blob = fetch(tmp_path, origin, "https://dl.example/never", local_dirs=[bundle])
+    assert blob.read_bytes() == DATA
+    assert origin.seen == []
+
+
+def test_hash_url_pins_and_caches(tmp_path: Path, origin: FakeOrigin) -> None:
+    url = origin.add("a.bin", DATA)
+    fetcher = make(tmp_path, origin)
+    try:
+        assert fetcher.hash_url(url) == DIGEST
+        assert (tmp_path / "downloads" / DIGEST).read_bytes() == DATA
+        with pytest.raises(PmError, match="HTTP 404"):
+            fetcher.hash_url("https://dl.example/missing")
+    finally:
+        fetcher.close()
+
+
+def test_a_pin_without_a_full_hash_is_refused(tmp_path: Path, origin: FakeOrigin) -> None:
+    with pytest.raises(PmError, match="full sha256"):
+        fetch(tmp_path, origin, "https://dl.example/a.bin", digest="abc")
diff --git a/tests/unit/pm/test_lock.py b/tests/unit/pm/test_lock.py
new file mode 100644
index 0000000..87ff224
--- /dev/null
+++ b/tests/unit/pm/test_lock.py
@@ -0,0 +1,201 @@
+"""P24-23: lock and facts shapes, the stat cache, our package list and the machine target."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import pytest
+
+from indus.pm import core
+from indus.pm.core import current_target, definitions, parse_definitions
+from indus.pm.lock import (
+    ANY,
+    TARGETS,
+    Artifact,
+    Fact,
+    Facts,
+    Lock,
+    LockInvalid,
+    Pin,
+    PmError,
+    StatCache,
+)
+
+SHA_A = "a" * 64
+SHA_B = "b" * 64
+
+
+def test_targets_are_the_ten_of_the_row() -> None:
+    assert set(TARGETS) == {
+        "any",
+        "darwin-arm64",
+        "darwin-x64",
+        "linux-arm64",
+        "linux-arm64-bionic",
+        "linux-arm64-musl",
+        "linux-x64",
+        "linux-x64-musl",
+        "win32-arm64",
+        "win32-x64",
+    }
+
+
+def test_lock_round_trip_has_the_row_shape(tmp_path: Path) -> None:
+    lock = Lock(
+        {
+            "tool": Pin(
+                "1.0",
+                {"linux-x64": Artifact("https://dl.example/t", SHA_A), ANY: Artifact("u", SHA_B)},
+            )
+        }
+    )
+    path = tmp_path / "lock.json"
+    lock.write(path)
+    data = json.loads(path.read_text())
+    assert data == {
+        "schema": 1,
+        "packages": {
+            "tool": {
+                "version": "1.0",
+                "artifacts": {
+                    "any": {"url": "u", "sha256": SHA_B},
+                    "linux-x64": {"url": "https://dl.example/t", "sha256": SHA_A},
+                },
+            }
+        },
+    }
+    assert Lock.read(path) == lock
+
+
+def test_a_target_without_its_own_row_uses_any() -> None:
+    pin = Pin("1", {ANY: Artifact("u", SHA_A), "win32-x64": Artifact("w", SHA_B)})
+    assert pin.artifact("linux-x64") == Artifact("u", SHA_A)
+    assert pin.artifact("win32-x64") == Artifact("w", SHA_B)
+    assert Pin("1", {"win32-x64": Artifact("w", SHA_B)}).artifact("linux-x64") is None
+
+
+def test_a_missing_lock_is_empty(tmp_path: Path) -> None:
+    assert Lock.read(tmp_path / "absent.json").packages == {}
+
+
+@pytest.mark.parametrize(
+    "data",
+    [
+        {"schema": 2, "packages": {}},
+        {"schema": 1},
+        {"schema": 1, "packages": {"t": {"version": "1", "artifacts": {"mars-x64": {}}}}},
+        {"schema": 1, "packages": {"t": {"version": "1", "artifacts": {"any": {"url": "u"}}}}},
+        {
+            "schema": 1,
+            "packages": {"t": {"version": "1", "artifacts": {"any": {"url": "u", "sha256": "ab"}}}},
+        },
+        [],
+    ],
+)
+def test_a_lock_this_build_cannot_read_is_an_error(tmp_path: Path, data: object) -> None:
+    path = tmp_path / "lock.json"
+    path.write_text(json.dumps(data))
+    with pytest.raises(LockInvalid) as caught:
+        Lock.read(path)
+    assert "indus pm lock" in str(caught.value)
+
+
+def test_a_broken_facts_file_reads_empty_and_keeps_its_bytes(tmp_path: Path) -> None:
+    path = tmp_path / "facts.json"
+    path.write_text("{not json")
+    assert Facts.read(path).packages == {}
+    assert (tmp_path / "facts.json.corrupt").read_text() == "{not json"
+
+
+def test_facts_round_trip(tmp_path: Path) -> None:
+    fact = Fact("1.0", "linux-x64", "https://x", SHA_A, "tool-1.0-aaaa", SHA_B, "bin/t", ("bin",))
+    facts = Facts({"tool": fact}, ["extra"])
+    path = tmp_path / "facts.json"
+    facts.write(path)
+    again = Facts.read(path)
+    assert again.packages == {"tool": fact}
+    assert again.declined == ["extra"]
+    assert again.entries_in_use() == {"tool-1.0-aaaa"}
+    assert again.blobs_in_use() == {SHA_A}
+
+
+def test_a_fact_with_a_path_like_entry_is_dropped() -> None:
+    raw = Fact("1", "t", "u", SHA_A, "x", SHA_B, None, ()).to_json() | {"entry": "../x"}
+    assert Fact.from_json(raw) is None
+
+
+def test_stat_cache_reads_only_when_the_file_changes(tmp_path: Path) -> None:
+    path = tmp_path / "f"
+    path.write_text("1")
+    reads: list[str] = []
+
+    def load(p: Path) -> str:
+        reads.append(p.read_text())
+        return reads[-1]
+
+    cache: StatCache[str] = StatCache(load)
+    assert cache.get(path) == "1"
+    assert cache.get(path) == "1"
+    assert reads == ["1"]
+    path.write_text("22")
+    assert cache.get(path) == "22"
+    assert reads == ["1", "22"]
+
+
+# -- our package list ------------------------------------------------------------------------------
+
+
+def test_our_package_list_parses_and_covers_the_row() -> None:
+    packages = definitions()
+    assert {"ripgrep", "ffmpeg", "uv", "node", "gh", "chromium", "whispercpp", "llamacpp"} <= set(
+        packages
+    )
+    for package in packages.values():
+        for target in package.targets:
+            url = package.url_for(package.version, target)
+            assert url.startswith("https://"), url
+            assert package.format_for(target) in ("tar.gz", "tar.xz", "zip", "file")
+            exe = package.exe_for(package.version, target)
+            assert exe is None or (exe.endswith(".exe") == target.startswith("win32"))
+
+
+def test_definitions_refuse_unknown_targets_kinds_and_dependencies() -> None:
+    base = '[packages.x]\nkind = "required"\nversion = "1"\nurl = "https://a/{version}"\n'
+    base += 'format = "file"\n'
+    with pytest.raises(PmError, match="unknown target"):
+        parse_definitions(base + "[packages.x.targets]\nmars = {}\n")
+    with pytest.raises(PmError, match="kind"):
+        parse_definitions(base.replace("required", "maybe") + "[packages.x.targets]\nany = {}\n")
+    with pytest.raises(PmError, match="depends on unknown"):
+        parse_definitions(base + 'depends = ["y"]\n[packages.x.targets]\nany = {}\n')
+
+
+def test_windows_targets_get_an_exe_suffix() -> None:
+    node = definitions()["node"]
+    assert node.exe_for("22.11.0", "win32-x64") == "node.exe"
+    assert node.exe_for("22.11.0", "linux-x64") == "bin/node"
+    assert node.path_for("22.11.0", "linux-x64") == ("bin",)
+
+
+# -- target ----------------------------------------------------------------------------------------
+
+
+def test_current_target(monkeypatch: pytest.MonkeyPatch) -> None:
+    from indus.platform import facts
+
+    monkeypatch.setattr(facts, "os_family", lambda: "linux")
+    monkeypatch.setattr(facts, "process_arch", lambda: "amd64")
+    assert current_target({}, exists=lambda _p: False) == "linux-x64"
+    assert current_target({}, exists=lambda p: p in core.MUSL_LOADERS) == "linux-x64-musl"
+    monkeypatch.setattr(facts, "process_arch", lambda: "arm64")
+    termux = {"TERMUX_VERSION": "0.118"}
+    assert current_target(termux, exists=lambda _p: False) == "linux-arm64-bionic"
+    monkeypatch.setattr(facts, "os_family", lambda: "darwin")
+    assert current_target({}) == "darwin-arm64"
+    monkeypatch.setattr(facts, "os_family", lambda: "win32")
+    monkeypatch.setattr(facts, "process_arch", lambda: "amd64")
+    assert current_target({}) == "win32-x64"
+    monkeypatch.setattr(facts, "process_arch", lambda: "x86")
+    with pytest.raises(PmError):
+        current_target({})
