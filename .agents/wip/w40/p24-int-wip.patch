@@ -0,0 +1,36 @@
+"""The browser-control broker (P24-47): an external browser controller paired with callers.
+
+``broker`` holds the rules (identity-exact routing, single-use tickets, complete-once commands,
+detach vs disconnect, the capability allow-list and the developer gate), ``artifacts`` the
+id-only file hand-off, ``routes`` the API server's register route and controller WebSocket.
+The daemon builds one ``BrowserBroker`` over its ticket book when ``browser.control_enabled`` is
+on and passes it to the API server; callers reach the controller with ``BrowserBroker.call``.
+"""
+
+from __future__ import annotations
+
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+__all__ = ["control_enabled", "developer_mode"]
+
+
+def _flag(scope: Scope, key: str) -> bool:
+    value: object = None
+    if scope.config is not None:
+        try:
+            value = scope.config.get(key)
+        except Exception:
+            value = None
+    return (default_for(key) if value is None else value) is True
+
+
+def control_enabled(scope: Scope) -> bool:
+    """``browser.control_enabled``, read now (off by default)."""
+    return _flag(scope, "browser.control_enabled")
+
+
+def developer_mode(scope: Scope) -> bool:
+    """``browser.control_developer_mode``, read now: raw CDP and evaluate are allowed only while
+    it is on (the broker reads it again at every call)."""
+    return _flag(scope, "browser.control_developer_mode")
diff --git a/src/indus/gateway/browser_broker/artifacts.py b/src/indus/gateway/browser_broker/artifacts.py
new file mode 100644
index 0000000..82d7d79
--- /dev/null
+++ b/src/indus/gateway/browser_broker/artifacts.py
@@ -0,0 +1,208 @@
+"""Files a browser controller and its callers hand each other, by id only (P24-47).
+
+A screenshot, a downloaded file or a file to put into a page never travels inside a command: it
+is stored here and only its id moves. Rules:
+
+- ids are minted by the server: 32 lowercase hex characters from ``secrets``; anything else is
+  refused before a path is built from it;
+- at most ``MAX_BYTES`` (10 MiB) and a MIME type on ``ALLOWED_MIME`` (PNG, JPEG, WebP, GIF, PDF,
+  plain text, JSON, CSV);
+- every artefact is bound to the exact scope key it was stored under (the controller identity's
+  ``scope_key``) and lives ``TTL_S`` (300 s) on the store's monotonic clock;
+- bytes are written to a temp file in the store folder and renamed into place; the SHA-256 taken
+  on the way in is checked again on every read, so bytes changed on disk are refused;
+- ``consume`` takes an artefact once: the record leaves the table under the lock before the file
+  is read, so two consumers can never both get it; the file is removed whatever the outcome.
+
+Refusals raise ``ArtifactRefused`` with a short reason; nothing here logs file contents.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import hmac
+import os
+import re
+import secrets
+import threading
+import time
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+
+__all__ = [
+    "ALLOWED_MIME",
+    "ARTIFACT_ID",
+    "MAX_BYTES",
+    "TTL_S",
+    "ArtifactReceipt",
+    "ArtifactRefused",
+    "ArtifactStore",
+]
+
+MAX_BYTES = 10 * 1024 * 1024
+TTL_S = 300.0
+ALLOWED_MIME: frozenset[str] = frozenset(
+    {
+        "image/png",
+        "image/jpeg",
+        "image/webp",
+        "image/gif",
+        "application/pdf",
+        "text/plain",
+        "application/json",
+        "text/csv",
+    }
+)
+ARTIFACT_ID = re.compile(r"^[0-9a-f]{32}$")
+_SUFFIX = ".bin"
+
+
+class ArtifactRefused(Exception):
+    """An artefact could not be stored or read; ``reason`` is a short code."""
+
+    def __init__(self, reason: str, detail: str = "") -> None:
+        super().__init__(detail or reason)
+        self.reason = reason
+
+
+@dataclass(frozen=True, slots=True)
+class ArtifactReceipt:
+    """What the store recorded for one artefact (no bytes)."""
+
+    artifact_id: str
+    scope_key: str
+    mime: str
+    size: int
+    sha256: str
+    expires_at: float
+
+
+def _mime(value: str) -> str:
+    return value.split(";", 1)[0].strip().lower()
+
+
+class ArtifactStore:
+    """Artefacts of one process, kept in ``root`` (see the module notes). Thread-safe."""
+
+    def __init__(
+        self,
+        root: Path,
+        *,
+        monotonic: Callable[[], float] = time.monotonic,
+        ttl: float = TTL_S,
+        max_bytes: int = MAX_BYTES,
+    ) -> None:
+        self.root = Path(root)
+        self.ttl = ttl
+        self.max_bytes = max_bytes
+        self._now = monotonic
+        self._lock = threading.Lock()
+        self._records: dict[str, ArtifactReceipt] = {}
+
+    def _path(self, artifact_id: str) -> Path:
+        return self.root / f"{artifact_id}{_SUFFIX}"
+
+    def _prune_locked(self, now: float) -> list[str]:
+        stale = [key for key, rec in self._records.items() if rec.expires_at <= now]
+        for key in stale:
+            del self._records[key]
+        return stale
+
+    def _unlink(self, artifact_ids: list[str]) -> None:
+        for artifact_id in artifact_ids:
+            with contextlib.suppress(OSError):
+                self._path(artifact_id).unlink()
+
+    def sweep(self) -> int:
+        """Forget and delete expired artefacts; how many went."""
+        with self._lock:
+            stale = self._prune_locked(self._now())
+        self._unlink(stale)
+        return len(stale)
+
+    def put(self, scope_key: str, data: bytes, mime: str) -> ArtifactReceipt:
+        """Store ``data`` for ``scope_key``; the receipt carries the new id."""
+        if not scope_key:
+            raise ArtifactRefused("scope", "an artefact needs a scope key")
+        kind = _mime(mime)
+        if kind not in ALLOWED_MIME:
+            raise ArtifactRefused("mime", "this file type is not accepted")
+        if len(data) > self.max_bytes:
+            raise ArtifactRefused("size", f"artefacts are limited to {self.max_bytes} bytes")
+        self.sweep()
+        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
+        artifact_id = secrets.token_hex(16)
+        target = self._path(artifact_id)
+        tmp = self.root / f".{artifact_id}.tmp-{secrets.token_hex(4)}"
+        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+        try:
+            with os.fdopen(fd, "wb") as handle:
+                handle.write(data)
+                handle.flush()
+                os.fsync(handle.fileno())
+            os.replace(tmp, target)
+        except BaseException:
+            with contextlib.suppress(OSError):
+                tmp.unlink()
+            raise
+        receipt = ArtifactReceipt(
+            artifact_id=artifact_id,
+            scope_key=scope_key,
+            mime=kind,
+            size=len(data),
+            sha256=hashlib.sha256(data).hexdigest(),
+            expires_at=self._now() + self.ttl,
+        )
+        with self._lock:
+            self._records[artifact_id] = receipt
+        return receipt
+
+    def _live_locked(self, artifact_id: object, scope_key: str) -> ArtifactReceipt:
+        if not isinstance(artifact_id, str) or not ARTIFACT_ID.match(artifact_id):
+            raise ArtifactRefused("malformed", "not an artefact id")
+        stale = self._prune_locked(self._now())
+        if stale:
+            self._unlink(stale)
+        record = self._records.get(artifact_id)
+        if record is None:
+            raise ArtifactRefused("unknown", "no such artefact (or it expired)")
+        if not hmac.compare_digest(record.scope_key, scope_key):
+            raise ArtifactRefused("scope", "the artefact belongs to another scope")
+        return record
+
+    def check(self, artifact_id: object, scope_key: str) -> ArtifactReceipt:
+        """The receipt of a live artefact of ``scope_key`` (nothing is consumed)."""
+        with self._lock:
+            return self._live_locked(artifact_id, scope_key)
+
+    def consume(self, artifact_id: object, scope_key: str) -> tuple[bytes, ArtifactReceipt]:
+        """Take the artefact once: its bytes after the SHA-256 check, and its receipt."""
+        with self._lock:
+            record = self._live_locked(artifact_id, scope_key)
+            del self._records[record.artifact_id]
+        path = self._path(record.artifact_id)
+        try:
+            data = path.read_bytes()
+        except OSError:
+            raise ArtifactRefused("missing", "the artefact file is gone") from None
+        finally:
+            with contextlib.suppress(OSError):
+                path.unlink()
+        if len(data) != record.size or not hmac.compare_digest(
+            hashlib.sha256(data).hexdigest(), record.sha256
+        ):
+            raise ArtifactRefused("changed", "the artefact changed on disk; refused")
+        return data, record
+
+    def clear(self) -> None:
+        """Delete every artefact (shutdown)."""
+        with self._lock:
+            ids = list(self._records)
+            self._records.clear()
+        self._unlink(ids)
+
+    def __len__(self) -> int:
+        with self._lock:
+            return len(self._records)
diff --git a/src/indus/gateway/browser_broker/broker.py b/src/indus/gateway/browser_broker/broker.py
new file mode 100644
index 0000000..9e2be64
--- /dev/null
+++ b/src/indus/gateway/browser_broker/broker.py
@@ -0,0 +1,520 @@
+"""The browser-control broker: one external controller per identity, exact routing (P24-47).
+
+A browser controller (for example a browser extension that drives the user's own browser)
+registers through the API server, then holds a WebSocket; callers on any transport reach it
+through ``BrowserBroker.call``. Everything the broker decides:
+
+Identity. ``Identity`` has six attributes: transport family, principal, browser profile,
+controller id, session and profile. The register route fills the transport family (``api``), the
+principal (the API key id) and the profile (this daemon's profile id) itself; only the controller
+id, the browser profile and the session come from the controller. A call is routed only to the
+connected controller whose identity equals the caller's on all six and whose negotiated set holds
+the capability; anything else is ``ControllerUnavailable``, never another controller.
+
+Tickets. ``register`` mints a ticket in the shared ``TicketBook`` for the ``browser-controller``
+purpose (30 s, single use; ``service/ws_auth.py``) and remembers only its SHA-256 digest with the
+identity. ``admit`` decides the socket upgrade with the one helper, ``authenticate_upgrade``: the
+peer must be loopback, an Origin must be allow-listed, exactly one
+``indus-browser-control-ticket.<ticket>`` must be offered beside ``indus-browser-control-v1``, a
+ticket in the query is spent and refused. Reused, expired, unknown or other-purpose tickets close
+4401. Only the base protocol is echoed. No ticket value is logged, formatted or put in a URL.
+
+Capabilities. Allowed: ``noop``, ``back``, ``click``, ``navigate``, ``press``, ``screenshot``,
+``scroll``, ``snapshot``, ``tab_activate``, ``tabs``, ``type``, plus ``artifact_download`` and
+``artifact_upload`` (whose only argument is a server-minted artefact id that must be live for the
+caller's scope key). ``cdp`` and ``evaluate`` are developer capabilities: kept at negotiation only
+while developer mode is on, and refused at call time whenever developer mode is off, even when
+negotiated. Anything else offered is dropped; anything else asked is ``CapabilityRefused``.
+
+Commands. Each command has a fresh id, waits at most ``COMMAND_TIMEOUT_S`` (30 s) on the injected
+clock and completes at most once: a second answer, or an answer from another identity, is
+ignored. ``detach`` (the controller said goodbye, or a new controller took its lane) fails every
+outstanding command with ``ControllerCancelled``; ``disconnect`` (the socket dropped) only marks
+the controller offline: its commands keep waiting for a reconnect of the same identity or their
+timeout, and new calls are refused until it is back. A cancel meant for an offline controller is
+kept for its reconnect, at most ``MAX_DEFERRED_CANCELS`` (512, newest kept), and sent first when
+it attaches again. Wire protocol version 1.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import hashlib
+import logging
+import re
+import secrets
+from collections.abc import Awaitable, Callable, Mapping, Sequence
+from dataclasses import dataclass, field, fields
+from typing import Any, Final, cast
+
+from indus.foundation.clock import Clock
+from indus.gateway.browser_broker.artifacts import ArtifactRefused, ArtifactStore
+from indus.service.ws_auth import (
+    BROWSER_CONTROLLER,
+    CLOSE_BAD_TICKET,
+    TicketBook,
+    TicketRefused,
+    UpgradeRefused,
+    authenticate_upgrade,
+    offered_tickets,
+)
+
+__all__ = [
+    "ALLOWED_CAPABILITIES",
+    "ARTIFACT_CAPABILITIES",
+    "COMMAND_TIMEOUT_S",
+    "DEVELOPER_CAPABILITIES",
+    "FRAME_CANCEL",
+    "FRAME_COMMAND",
+    "MAX_DEFERRED_CANCELS",
+    "PROTOCOL_VERSION",
+    "SUBPROTOCOL",
+    "TICKET_PREFIX",
+    "BrokerError",
+    "BrowserBroker",
+    "CapabilityRefused",
+    "ControllerCancelled",
+    "ControllerRejected",
+    "ControllerTimeout",
+    "ControllerUnavailable",
+    "Identity",
+    "Registration",
+    "RegistrationRefused",
+    "negotiate",
+    "protocol_supported",
+]
+
+log = logging.getLogger(__name__)
+
+PROTOCOL_VERSION: Final = 1
+SUBPROTOCOL: Final = "indus-browser-control-v1"
+TICKET_PREFIX: Final = "indus-browser-control-ticket."
+COMMAND_TIMEOUT_S: Final = 30.0
+MAX_DEFERRED_CANCELS: Final = 512
+
+ALLOWED_CAPABILITIES: frozenset[str] = frozenset(
+    {"noop", "back", "click", "navigate", "press", "screenshot", "scroll", "snapshot",
+     "tab_activate", "tabs", "type"}
+)  # fmt: skip
+ARTIFACT_CAPABILITIES: frozenset[str] = frozenset({"artifact_download", "artifact_upload"})
+DEVELOPER_CAPABILITIES: frozenset[str] = frozenset({"cdp", "evaluate"})
+_KNOWN = ALLOWED_CAPABILITIES | ARTIFACT_CAPABILITIES | DEVELOPER_CAPABILITIES
+
+FRAME_HELLO: Final = "browser.controller.hello"
+FRAME_READY: Final = "browser.controller.ready"
+FRAME_COMMAND: Final = "browser.controller.command"
+FRAME_CANCEL: Final = "browser.controller.cancel"
+FRAME_RESULT: Final = "browser.controller.result"
+FRAME_DETACH: Final = "browser.controller.detach"
+
+_PART = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$")
+
+type Send = Callable[[dict[str, Any]], Awaitable[None]]
+
+
+class BrokerError(Exception):
+    """A broker refusal; the message is short and never carries a ticket or arguments."""
+
+
+class RegistrationRefused(BrokerError):
+    """The register request is malformed or the feature is off."""
+
+
+class ControllerUnavailable(BrokerError):
+    """No connected controller matches the identity and holds the capability."""
+
+
+class CapabilityRefused(BrokerError):
+    """The capability is not on the allow-list, or needs developer mode which is off."""
+
+
+class ControllerCancelled(BrokerError):
+    """The command was cancelled (by the caller, or because the controller detached)."""
+
+
+class ControllerTimeout(BrokerError):
+    """The controller did not answer in time."""
+
+
+class ControllerRejected(BrokerError):
+    """The controller answered ``ok: false``, or an artefact reference was refused."""
+
+
+def protocol_supported(value: object) -> bool:
+    """Exactly the int 1 (a bool is not an int here)."""
+    return type(value) is int and value == PROTOCOL_VERSION
+
+
+@dataclass(frozen=True, slots=True)
+class Identity:
+    """Who a controller is and who may call it; equality is over all six attributes."""
+
+    transport_family: str
+    principal: str
+    browser_profile: str
+    controller_id: str
+    session: str
+    profile: str
+
+    def scope_key(self) -> str:
+        """A stable digest of the identity (the artefact store's scope key)."""
+        joined = "\0".join(getattr(self, f.name) for f in fields(self))
+        return hashlib.sha256(b"indus-browser-control\0" + joined.encode("utf-8")).hexdigest()
+
+    def lane(self) -> tuple[str, str, str, str]:
+        """The session lane: one controller per (principal, profile, session, transport)."""
+        return (self.principal, self.profile, self.session, self.transport_family)
+
+
+def check_part(name: str, value: object) -> str:
+    if not isinstance(value, str) or not _PART.match(value):
+        raise RegistrationRefused(f"{name} must be a short id (letters, digits, . _ : @ -)")
+    return value
+
+
+def negotiate(offered: object, *, developer_mode: bool) -> frozenset[str]:
+    """The allowed subset of what a controller offers (a non-list offers nothing)."""
+    if not isinstance(offered, list | tuple):
+        return frozenset()
+    allowed = ALLOWED_CAPABILITIES | ARTIFACT_CAPABILITIES
+    if developer_mode:
+        allowed |= DEVELOPER_CAPABILITIES
+    return frozenset(
+        c for c in cast(Sequence[object], offered) if isinstance(c, str) and c in allowed
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class Registration:
+    """What the register route answers. ``ticket`` is the secret: body only, never logged."""
+
+    ticket: str = field(repr=False)
+    expires_in: float
+
+    def body(self) -> dict[str, Any]:
+        return {
+            "ticket": self.ticket,
+            "expires_in": self.expires_in,
+            "subprotocol": SUBPROTOCOL,
+            "ticket_prefix": TICKET_PREFIX,
+            "protocol": PROTOCOL_VERSION,
+        }
+
+
+@dataclass
+class _Controller:
+    identity: Identity
+    capabilities: frozenset[str]
+    send: Send
+    owner: object
+    connected: bool = True
+    deferred: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+    lock: asyncio.Lock = field(default_factory=asyncio.Lock)
+
+
+@dataclass
+class _Pending:
+    command_id: str
+    identity: Identity
+    call_id: str | None
+    future: asyncio.Future[tuple[bool, Any]]
+
+
+def _digest(ticket: str) -> str:
+    return hashlib.sha256(ticket.encode("utf-8", errors="surrogatepass")).hexdigest()
+
+
+def _cancel_frame(pending: _Pending) -> dict[str, Any]:
+    return {
+        "method": FRAME_CANCEL,
+        "params": {"command_id": pending.command_id, "call_id": pending.call_id},
+    }
+
+
+class BrowserBroker:
+    """The broker of one daemon (see the module notes). Runs on the daemon's event loop."""
+
+    def __init__(
+        self,
+        book: TicketBook,
+        *,
+        clock: Clock,
+        developer_mode: Callable[[], bool] = lambda: False,
+        enabled: Callable[[], bool] = lambda: True,
+        artifacts: ArtifactStore | None = None,
+        command_timeout: float = COMMAND_TIMEOUT_S,
+    ) -> None:
+        if BROWSER_CONTROLLER not in book.purposes:
+            raise ValueError("the ticket book does not mint browser-controller tickets")
+        self.book = book
+        self.clock = clock
+        self.developer_mode = developer_mode
+        self.enabled = enabled
+        self.artifacts = artifacts
+        self.command_timeout = command_timeout
+        self._bound: dict[str, tuple[Identity, float]] = {}
+        self._controllers: dict[Identity, _Controller] = {}
+        self._pending: dict[str, _Pending] = {}
+
+    # -- registration and the upgrade -------------------------------------------------------------
+
+    def _developer(self) -> bool:
+        try:
+            return self.developer_mode() is True
+        except Exception:
+            log.warning("the developer-mode switch could not be read; treating it as off")
+            return False
+
+    def _prune_bound(self) -> None:
+        now = self.clock.monotonic()
+        for key in [k for k, (_, until) in self._bound.items() if until <= now]:
+            del self._bound[key]
+
+    def register(self, identity: Identity) -> Registration:
+        """Mint a ticket bound to ``identity`` (30 s, single use)."""
+        if not self.enabled():
+            raise RegistrationRefused("browser control is turned off")
+        self._prune_bound()
+        try:
+            minted = self.book.mint(BROWSER_CONTROLLER)
+        except TicketRefused as refused:
+            raise RegistrationRefused(f"no ticket: {refused.reason}") from None
+        self._bound[_digest(minted.ticket)] = (identity, self.clock.monotonic() + minted.expires_in)
+        log.info("browser controller %s registered; ticket expires in %.0f s",
+                 identity.controller_id, minted.expires_in)  # fmt: skip
+        return Registration(ticket=minted.ticket, expires_in=minted.expires_in)
+
+    def admit(
+        self, scope: Mapping[str, Any], *, origins: Sequence[str] = ()
+    ) -> Identity | UpgradeRefused:
+        """Decide one controller socket upgrade (see the module notes)."""
+        raw: object = scope.get("subprotocols") or ()
+        offered = list(cast(Sequence[object], raw)) if isinstance(raw, list | tuple) else []
+        tickets = offered_tickets(offered, TICKET_PREFIX)
+        decided = authenticate_upgrade(
+            scope,
+            BROWSER_CONTROLLER,
+            book=self.book,
+            origins=origins,
+            subprotocol=SUBPROTOCOL,
+            ticket_prefix=TICKET_PREFIX,
+        )
+        bound = [self._bound.pop(_digest(t), None) for t in tickets]
+        if isinstance(decided, UpgradeRefused):
+            return decided
+        found = bound[0] if bound else None
+        if not self.enabled():
+            return UpgradeRefused(CLOSE_BAD_TICKET, "browser control is turned off")
+        if found is None or found[1] <= self.clock.monotonic():
+            return UpgradeRefused(CLOSE_BAD_TICKET, "ticket unknown")
+        return found[0]
+
+    # -- controllers ------------------------------------------------------------------------------
+
+    async def attach(
+        self, identity: Identity, offered: object, send: Send, *, owner: object
+    ) -> frozenset[str]:
+        """Attach (or re-attach) the controller of ``identity``; the negotiated capabilities.
+
+        A reconnect of the same identity keeps its outstanding commands and first gets the
+        cancels kept for it; another controller in the same lane replaces the old one, whose
+        commands fail."""
+        capabilities = negotiate(offered, developer_mode=self._developer())
+        for other in [
+            i for i in self._controllers if i != identity and i.lane() == identity.lane()
+        ]:
+            await self.detach(other)
+        existing = self._controllers.get(identity)
+        if existing is None:
+            self._controllers[identity] = _Controller(identity, capabilities, send, owner)
+            return capabilities
+        async with existing.lock:
+            existing.connected = False
+            existing.capabilities, existing.send, existing.owner = capabilities, send, owner
+            deferred, existing.deferred = existing.deferred, []
+            for index, frame in enumerate(deferred):
+                try:
+                    await send(frame)
+                except Exception:
+                    existing.deferred = deferred[index:][-MAX_DEFERRED_CANCELS:]
+                    existing.owner = None
+                    raise ControllerUnavailable("the kept cancels could not be sent") from None
+            existing.connected = True
+        return capabilities
+
+    def disconnect(self, identity: Identity, *, owner: object) -> bool:
+        """The socket of ``owner`` dropped: mark its controller offline (work keeps waiting)."""
+        controller = self._controllers.get(identity)
+        if controller is None or controller.owner is not owner:
+            return False
+        controller.connected = False
+        controller.owner = None
+        return True
+
+    async def detach(self, identity: Identity, *, owner: object | None = None) -> int:
+        """Remove the controller and fail its outstanding commands; how many failed."""
+        controller = self._controllers.get(identity)
+        if controller is None or (owner is not None and controller.owner is not owner):
+            return 0
+        del self._controllers[identity]
+        failed = [p for p in self._pending.values() if p.identity == identity]
+        for pending in failed:
+            self._resolve(pending, ControllerCancelled("the controller detached"))
+        if controller.connected:
+            async with controller.lock:
+                for pending in failed:
+                    with contextlib.suppress(Exception):
+                        await controller.send(_cancel_frame(pending))
+        return len(failed)
+
+    def lane(self, *, session: str, principal: str, transport_family: str) -> Identity | None:
+        """The one controller identity bound to a caller's session lane, or None."""
+        found = [
+            i
+            for i in self._controllers
+            if (i.session, i.principal, i.transport_family)
+            == (session, principal, transport_family)
+        ]
+        return found[0] if len(found) == 1 else None
+
+    def is_connected(self, identity: Identity) -> bool:
+        controller = self._controllers.get(identity)
+        return controller is not None and controller.connected
+
+    def deferred_cancels(self, identity: Identity) -> int:
+        controller = self._controllers.get(identity)
+        return len(controller.deferred) if controller is not None else 0
+
+    @property
+    def pending_count(self) -> int:
+        return len(self._pending)
+
+    # -- commands ---------------------------------------------------------------------------------
+
+    def _resolve(self, pending: _Pending, outcome: tuple[bool, Any] | BaseException) -> None:
+        self._pending.pop(pending.command_id, None)
+        if pending.future.done():
+            return
+        if isinstance(outcome, BaseException):
+            pending.future.set_exception(outcome)
+        else:
+            pending.future.set_result(outcome)
+
+    def _check_artifact(
+        self, identity: Identity, capability: str, arguments: Mapping[str, Any]
+    ) -> None:
+        if set(arguments) != {"artifact_id"}:
+            raise ControllerRejected(f"{capability} takes exactly one argument, artifact_id")
+        if self.artifacts is None:
+            raise ControllerRejected(f"{capability} needs the artefact store")
+        try:
+            self.artifacts.check(arguments["artifact_id"], identity.scope_key())
+        except ArtifactRefused as refused:
+            raise ControllerRejected(f"{capability}: artefact refused ({refused.reason})") from None
+
+    async def call(
+        self,
+        identity: Identity,
+        capability: str,
+        arguments: Mapping[str, Any] | None = None,
+        *,
+        call_id: str | None = None,
+    ) -> Any:
+        """Run one command on the controller of exactly ``identity``; its result."""
+        if capability not in _KNOWN:
+            raise CapabilityRefused(f"{capability!r} is not a browser-control capability")
+        if capability in DEVELOPER_CAPABILITIES and not self._developer():
+            raise CapabilityRefused(f"{capability} needs developer mode")
+        controller = self._controllers.get(identity)
+        if (
+            controller is None
+            or not controller.connected
+            or capability not in controller.capabilities
+        ):
+            raise ControllerUnavailable(
+                f"no connected controller for this identity with {capability}"
+            )
+        args = dict(arguments or {})
+        if capability in ARTIFACT_CAPABILITIES:
+            self._check_artifact(identity, capability, args)
+        loop = asyncio.get_running_loop()
+        pending = _Pending(secrets.token_hex(16), identity, call_id, loop.create_future())
+        frame = {
+            "method": FRAME_COMMAND,
+            "params": {"command_id": pending.command_id, "capability": capability,
+                       "arguments": args, "call_id": call_id},
+        }  # fmt: skip
+        async with controller.lock:
+            if self._controllers.get(identity) is not controller or not controller.connected:
+                raise ControllerUnavailable("the controller went away before the command was sent")
+            self._pending[pending.command_id] = pending
+            try:
+                await controller.send(frame)
+            except Exception:
+                self._pending.pop(pending.command_id, None)
+                raise ControllerUnavailable("the command could not be sent") from None
+        return await self._wait(pending)
+
+    async def _wait(self, pending: _Pending) -> Any:
+        timer = asyncio.ensure_future(self.clock.sleep(self.command_timeout))
+        try:
+            await asyncio.wait({pending.future, timer}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            timer.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await timer
+        if not pending.future.done():
+            self._resolve(pending, ControllerTimeout("no answer within the command timeout"))
+            await self._send_cancel(pending)
+        ok, result = await pending.future
+        if not ok:
+            raise ControllerRejected("the controller refused the command")
+        return result
+
+    async def _send_cancel(self, pending: _Pending) -> None:
+        controller = self._controllers.get(pending.identity)
+        if controller is None:
+            return
+        frame = _cancel_frame(pending)
+        if not controller.connected:
+            controller.deferred.append(frame)
+            del controller.deferred[:-MAX_DEFERRED_CANCELS]
+            return
+        async with controller.lock:
+            with contextlib.suppress(Exception):
+                await controller.send(frame)
+
+    def complete(
+        self, command_id: object, identity: Identity, *, ok: bool, result: Any = None
+    ) -> bool:
+        """Settle one command (from its own controller only); False when nothing was waiting."""
+        if not isinstance(command_id, str):
+            return False
+        pending = self._pending.get(command_id)
+        if pending is None or pending.identity != identity or pending.future.done():
+            return False
+        self._resolve(pending, (ok is True, result))
+        return True
+
+    async def cancel(self, identity: Identity, call_id: str) -> bool:
+        """Cancel the caller's outstanding command ``call_id`` (kept for an offline controller)."""
+        target = next(
+            (p for p in self._pending.values() if p.identity == identity and p.call_id == call_id),
+            None,
+        )
+        if target is None:
+            return False
+        self._resolve(target, ControllerCancelled("the command was cancelled"))
+        await self._send_cancel(target)
+        return True
+
+    async def aclose(self) -> None:
+        """Detach every controller and fail what is left (daemon stop)."""
+        for identity in list(self._controllers):
+            await self.detach(identity)
+        for pending in list(self._pending.values()):
+            self._resolve(pending, ControllerCancelled("the broker stopped"))
+        self._bound.clear()
+        if self.artifacts is not None:
+            self.artifacts.clear()
diff --git a/src/indus/gateway/browser_broker/routes.py b/src/indus/gateway/browser_broker/routes.py
new file mode 100644
index 0000000..d1e3c5f
--- /dev/null
+++ b/src/indus/gateway/browser_broker/routes.py
@@ -0,0 +1,342 @@
+"""The broker's two API-server routes (P24-47).
+
+``POST /v1/browser-control/register`` sits behind the API key like every API route, and also
+answers only a loopback peer (403 otherwise). Body: ``{controller_id, browser_profile, session,
+protocol: 1}``; the server adds the transport family (``api``), the principal (the API key id)
+and the profile. Answer: ``{ticket, expires_in, subprotocol, ticket_prefix, protocol, ws_path}``
+with ``Cache-Control: no-store``. The ticket is in the body only.
+
+``/v1/browser-control/ws`` is the controller's socket; ``BrowserBroker.admit`` decides the
+upgrade. A refusal is accepted (echoing the base protocol only when offered) and closed at once
+with its code. Then, per connection:
+
+- the first frame must be ``browser.controller.hello`` with ``protocol`` 1 and a capability list
+  within ``HELLO_TIMEOUT_S`` (10 s), else close 4400; the server answers
+  ``browser.controller.ready`` with the negotiated capabilities;
+- ``browser.controller.result {command_id, ok, result}`` settles a command;
+  ``browser.controller.detach`` detaches (outstanding commands fail) and closes 1000;
+- ``browser.controller.artifact.put {mime}`` followed by one binary frame stores an artefact for
+  this identity and answers ``browser.controller.artifact.stored {artifact_id, size, sha256}``
+  (or ``browser.controller.artifact.refused {reason}``);
+  ``browser.controller.artifact.fetch {artifact_id}`` consumes one of this identity's artefacts:
+  ``browser.controller.artifact.data {artifact_id, mime, size}`` then the bytes as one binary
+  frame, or the refusal;
+- a text frame over ``MAX_FRAME_BYTES`` (1 MiB) or a binary frame over the artefact cap closes
+  1009; text that is not a JSON object, or a binary frame nobody announced, closes 1003;
+- a dropped socket only marks the controller offline (``BrowserBroker.disconnect``).
+
+Logs name the controller id, never a ticket, a URL query or frame contents.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import importlib.util
+import json
+import logging
+from collections.abc import Callable, Mapping, Sequence
+from typing import Any, Final, cast
+
+from fastapi import FastAPI
+from starlette.requests import Request
+from starlette.responses import JSONResponse, Response
+from starlette.websockets import WebSocket, WebSocketDisconnect
+
+from indus.gateway.browser_broker.artifacts import MAX_BYTES, ArtifactRefused
+from indus.gateway.browser_broker.broker import (
+    FRAME_DETACH,
+    FRAME_HELLO,
+    FRAME_READY,
+    FRAME_RESULT,
+    PROTOCOL_VERSION,
+    SUBPROTOCOL,
+    BrowserBroker,
+    ControllerUnavailable,
+    Identity,
+    RegistrationRefused,
+    check_part,
+    protocol_supported,
+)
+from indus.gateway.http.serving import BadRequest, BodyTooLarge, read_json
+from indus.service.ws_auth import UpgradeRefused, clamp_close_reason, is_loopback_host
+
+__all__ = [
+    "HELLO_TIMEOUT_S",
+    "MAX_FRAME_BYTES",
+    "REGISTER_PATH",
+    "TRANSPORT_FAMILY",
+    "WS_PATH",
+    "ControllerConnection",
+    "mount_routes",
+    "ws_settings",
+]
+
+log = logging.getLogger(__name__)
+
+REGISTER_PATH: Final = "/v1/browser-control/register"
+WS_PATH: Final = "/v1/browser-control/ws"
+TRANSPORT_FAMILY: Final = "api"
+HELLO_TIMEOUT_S: Final = 10.0
+MAX_FRAME_BYTES: Final = 1024 * 1024
+MAX_REGISTER_BYTES: Final = 16 * 1024
+CLOSE_NORMAL: Final = 1000
+CLOSE_UNSUPPORTED: Final = 1003
+CLOSE_TOO_BIG: Final = 1009
+CLOSE_TRY_AGAIN: Final = 1013
+CLOSE_BAD_HELLO: Final = 4400
+
+FRAME_ARTIFACT_PUT: Final = "browser.controller.artifact.put"
+FRAME_ARTIFACT_STORED: Final = "browser.controller.artifact.stored"
+FRAME_ARTIFACT_FETCH: Final = "browser.controller.artifact.fetch"
+FRAME_ARTIFACT_DATA: Final = "browser.controller.artifact.data"
+FRAME_ARTIFACT_REFUSED: Final = "browser.controller.artifact.refused"
+
+
+def _peer(scope: Mapping[str, Any]) -> object:
+    client: object = scope.get("client")
+    if isinstance(client, list | tuple) and cast(Sequence[object], client):
+        return cast(Sequence[object], client)[0]
+    return None
+
+
+class _Close(Exception):
+    def __init__(self, code: int, reason: str) -> None:
+        super().__init__(reason)
+        self.code = code
+        self.reason = reason
+
+
+class ControllerConnection:
+    """One admitted controller socket (see the module notes)."""
+
+    def __init__(self, websocket: WebSocket, broker: BrowserBroker, identity: Identity) -> None:
+        self.websocket = websocket
+        self.broker = broker
+        self.identity = identity
+        self.detached = False
+        self._put_mime: str | None = None
+
+    async def send(self, frame: dict[str, Any]) -> None:
+        await self.websocket.send_text(json.dumps(frame, separators=(",", ":")))
+
+    async def _receive(self) -> Mapping[str, Any]:
+        message = await self.websocket.receive()
+        if message.get("type") == "websocket.disconnect":
+            raise WebSocketDisconnect(int(message.get("code") or CLOSE_NORMAL))
+        return message
+
+    async def _hello(self) -> object:
+        receiving = asyncio.ensure_future(self._receive())
+        timer = asyncio.ensure_future(self.broker.clock.sleep(HELLO_TIMEOUT_S))
+        try:
+            await asyncio.wait({receiving, timer}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            timer.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await timer
+        if not receiving.done():
+            receiving.cancel()
+            with contextlib.suppress(asyncio.CancelledError, Exception):
+                await receiving
+            raise _Close(CLOSE_BAD_HELLO, "no hello in time")
+        frame = self._frame(receiving.result(), hello=True)
+        params = frame.get("params")
+        if frame.get("method") != FRAME_HELLO or not isinstance(params, Mapping):
+            raise _Close(CLOSE_BAD_HELLO, "the first frame must be a hello")
+        hello = cast(Mapping[str, Any], params)
+        if not protocol_supported(hello.get("protocol")):
+            raise _Close(CLOSE_BAD_HELLO, f"protocol {PROTOCOL_VERSION} only")
+        return hello.get("capabilities")
+
+    def _frame(self, message: Mapping[str, Any], *, hello: bool = False) -> dict[str, Any]:
+        text = message.get("text")
+        if not isinstance(text, str):
+            raise _Close(CLOSE_BAD_HELLO if hello else CLOSE_UNSUPPORTED, "text frames only")
+        if len(text.encode("utf-8")) > MAX_FRAME_BYTES:
+            raise _Close(CLOSE_TOO_BIG, "frame too large")
+        try:
+            data = json.loads(text)
+        except ValueError:
+            raise _Close(CLOSE_BAD_HELLO if hello else CLOSE_UNSUPPORTED, "not JSON") from None
+        if not isinstance(data, dict):
+            raise _Close(CLOSE_BAD_HELLO if hello else CLOSE_UNSUPPORTED, "not a JSON object")
+        return cast(dict[str, Any], data)
+
+    async def run(self) -> None:
+        try:
+            offered = await self._hello()
+            try:
+                negotiated = await self.broker.attach(self.identity, offered, self.send, owner=self)
+            except ControllerUnavailable:
+                raise _Close(CLOSE_TRY_AGAIN, "reconnect could not be completed") from None
+            await self.send(
+                {
+                    "method": FRAME_READY,
+                    "params": {"protocol": PROTOCOL_VERSION, "capabilities": sorted(negotiated)},
+                }
+            )
+            log.info("browser controller %s attached", self.identity.controller_id)
+            while not self.detached:
+                await self._one(await self._receive())
+        except _Close as close:
+            with contextlib.suppress(Exception):
+                await self.websocket.close(code=close.code, reason=clamp_close_reason(close.reason))
+        except WebSocketDisconnect:
+            pass
+        finally:
+            if not self.detached and self.broker.disconnect(self.identity, owner=self):
+                log.info("browser controller %s went offline", self.identity.controller_id)
+
+    async def _one(self, message: Mapping[str, Any]) -> None:
+        if message.get("bytes") is not None:
+            await self._artifact_bytes(cast(bytes, message["bytes"]))
+            return
+        frame = self._frame(message)
+        if self._put_mime is not None:
+            raise _Close(CLOSE_UNSUPPORTED, "an artefact's bytes were expected")
+        method = frame.get("method")
+        raw: object = frame.get("params")
+        params = cast(Mapping[str, Any], raw) if isinstance(raw, Mapping) else {}
+        if method == FRAME_RESULT:
+            self.broker.complete(
+                params.get("command_id"),
+                self.identity,
+                ok=params.get("ok") is True,
+                result=params.get("result"),
+            )
+        elif method == FRAME_DETACH:
+            self.detached = True
+            await self.broker.detach(self.identity, owner=self)
+            log.info("browser controller %s detached", self.identity.controller_id)
+            raise _Close(CLOSE_NORMAL, "detached")
+        elif method == FRAME_ARTIFACT_PUT:
+            self._put_mime = str(params.get("mime") or "")
+        elif method == FRAME_ARTIFACT_FETCH:
+            await self._fetch(params.get("artifact_id"))
+        else:
+            raise _Close(CLOSE_UNSUPPORTED, "unknown frame")
+
+    async def _refused(self, reason: str) -> None:
+        await self.send({"method": FRAME_ARTIFACT_REFUSED, "params": {"reason": reason}})
+
+    async def _artifact_bytes(self, data: bytes) -> None:
+        mime, self._put_mime = self._put_mime, None
+        if mime is None:
+            raise _Close(CLOSE_UNSUPPORTED, "unannounced binary frame")
+        if len(data) > MAX_BYTES:
+            raise _Close(CLOSE_TOO_BIG, "artefact too large")
+        store = self.broker.artifacts
+        if store is None:
+            await self._refused("unavailable")
+            return
+        try:
+            receipt = store.put(self.identity.scope_key(), data, mime)
+        except ArtifactRefused as refused:
+            await self._refused(refused.reason)
+            return
+        await self.send(
+            {
+                "method": FRAME_ARTIFACT_STORED,
+                "params": {"artifact_id": receipt.artifact_id, "size": receipt.size,
+                           "sha256": receipt.sha256, "mime": receipt.mime},
+            }
+        )  # fmt: skip
+
+    async def _fetch(self, artifact_id: object) -> None:
+        store = self.broker.artifacts
+        if store is None:
+            await self._refused("unavailable")
+            return
+        try:
+            data, receipt = store.consume(artifact_id, self.identity.scope_key())
+        except ArtifactRefused as refused:
+            await self._refused(refused.reason)
+            return
+        await self.send(
+            {
+                "method": FRAME_ARTIFACT_DATA,
+                "params": {"artifact_id": receipt.artifact_id, "mime": receipt.mime,
+                           "size": receipt.size},
+            }
+        )  # fmt: skip
+        await self.websocket.send_bytes(data)
+
+
+async def controller_socket(
+    websocket: WebSocket, broker: BrowserBroker, origins: Sequence[str]
+) -> None:
+    """Admit or refuse one controller socket, then serve it."""
+    decided = broker.admit(websocket.scope, origins=origins)
+    if isinstance(decided, UpgradeRefused):
+        offered = websocket.scope.get("subprotocols") or []
+        await websocket.accept(subprotocol=SUBPROTOCOL if SUBPROTOCOL in offered else None)
+        await websocket.close(code=decided.close_code, reason=clamp_close_reason(decided.reason))
+        return
+    await websocket.accept(subprotocol=SUBPROTOCOL)
+    await ControllerConnection(websocket, broker, decided).run()
+
+
+def ws_settings() -> dict[str, Any]:
+    """uvicorn's WebSocket settings for the API server once the broker is mounted: room for one
+    artefact frame, no compression. ``RuntimeError`` when no WebSocket package is installed."""
+    for name in ("wsproto", "websockets"):
+        if importlib.util.find_spec(name) is not None:
+            return {
+                "ws": name,
+                "ws_max_size": MAX_BYTES + 64 * 1024,
+                "ws_per_message_deflate": False,
+            }
+    raise RuntimeError("browser control needs the wsproto (or websockets) package")
+
+
+def identity_from(body: object, *, principal: str, profile: str) -> Identity:
+    """The identity a register body asks for; ``RegistrationRefused`` when malformed."""
+    if not isinstance(body, Mapping):
+        raise RegistrationRefused("the body must be a JSON object")
+    data = cast(Mapping[str, Any], body)
+    if not protocol_supported(data.get("protocol")):
+        raise RegistrationRefused(f"protocol must be {PROTOCOL_VERSION}")
+    return Identity(
+        transport_family=TRANSPORT_FAMILY,
+        principal=principal,
+        browser_profile=check_part("browser_profile", data.get("browser_profile")),
+        controller_id=check_part("controller_id", data.get("controller_id")),
+        session=check_part("session", data.get("session")),
+        profile=profile,
+    )
+
+
+def mount_routes(app: FastAPI, broker: BrowserBroker, origins: Callable[[], Sequence[str]]) -> None:
+    """Add the register route and the controller socket to the API app."""
+
+    def refuse(message: str, status: int, code: str) -> Response:
+        failure = BadRequest(message, status=status, code=code)
+        return JSONResponse(failure.body(), status_code=failure.status)
+
+    async def register(request: Request) -> Response:
+        if not is_loopback_host(_peer(request.scope)):
+            return refuse("browser controllers register from this machine only", 403, "forbidden")
+        principal = getattr(request.state, "api_key_id", None)
+        if not isinstance(principal, str) or not principal:
+            return refuse("an API key is required", 401, "invalid_api_key")
+        try:
+            body = await read_json(request, MAX_REGISTER_BYTES)
+        except BodyTooLarge:
+            return refuse("the register body is too large", 413, "body_too_large")
+        except BadRequest as bad:
+            return refuse(bad.message, 400, bad.code or "invalid_json")
+        try:
+            identity = identity_from(body, principal=principal, profile=broker.book.profile_id)
+            registration = broker.register(identity)
+        except RegistrationRefused as refused:
+            return refuse(str(refused), 400, "registration_refused")
+        return JSONResponse(
+            {**registration.body(), "ws_path": WS_PATH}, headers={"Cache-Control": "no-store"}
+        )
+
+    async def socket(websocket: WebSocket) -> None:
+        await controller_socket(websocket, broker, tuple(origins()))
+
+    app.add_api_route(REGISTER_PATH, register, methods=["POST"])
+    app.add_api_websocket_route(WS_PATH, socket)
