@@ -0,0 +1,514 @@
+// The connections registry (P24-29): every Indus server this desktop knows, in one file.
+//
+// `<userData>/connections.json` holds `{v, connections[], primaryId, lastUsedId?, launchMode,
+// quarantined[]}`. Rules:
+//   - exactly one `local` entry ("This computer") always exists; a second one in the file is
+//     quarantined, a missing one is added;
+//   - labels are unique ignoring case (a clash gets " 2", " 3", …);
+//   - a remote is identified by its normalised URL, an SSH entry by `user@host:port` plus its
+//     remote profile: adding one that exists updates that entry (id and label kept);
+//   - an entry this app cannot read is never dropped: it goes to `quarantined[]` verbatim (at most
+//     20) and is written back on every save;
+//   - removing the primary makes `local` the primary; `local` cannot be removed;
+//   - launch mode `primary` opens the primary, `last-used` the last entry that worked.
+// Credentials never live in this file: a token, an OAuth set and access-proxy headers are secrets
+// named `connection-<id>-token|oauth|headers` in the desktop secrets store (keychain by default).
+// Cloud connections are not built (D-16.12).
+
+import fs from "node:fs";
+import path from "node:path";
+import { normalizeRemoteUrl, REMOTE_FILE, REMOTE_TOKEN_SECRET } from "../backend/remote.ts";
+import { readJsonFile, writeFileAtomic } from "../fsSecure.ts";
+
+export const REGISTRY_FILE = "connections.json";
+export const REGISTRY_VERSION = 1;
+export const LOCAL_ID = "local";
+export const LOCAL_LABEL = "This computer";
+export const QUARANTINE_CAP = 20;
+export const LABEL_MAX = 64;
+const ID_RE = /^[a-z0-9][a-z0-9-]{0,63}$/;
+const PROFILE_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$/;
+
+export type ConnectionKind = "local" | "remote" | "ssh";
+export type AuthMode = "token" | "oauth" | "basic";
+export type LaunchMode = "primary" | "last-used";
+export type SecretKind = "token" | "oauth" | "headers";
+
+export interface SshTarget {
+  host: string;
+  user?: string;
+  port?: number;
+  /** An identity file, used as `-i` (the agent and ~/.ssh/config work without one). */
+  keyPath?: string;
+  /** The profile the remote Indus serves (default: its default profile). */
+  remoteProfile?: string;
+}
+
+export interface ConnectionEntry {
+  id: string;
+  kind: ConnectionKind;
+  label: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+  /** Profiles last seen on that server (for the roster before it answers). */
+  profiles?: string[];
+}
+
+export interface QuarantinedEntry {
+  reason: string;
+  entry: unknown;
+}
+
+export interface ConnectionRegistry {
+  v: typeof REGISTRY_VERSION;
+  connections: ConnectionEntry[];
+  primaryId: string;
+  lastUsedId?: string;
+  launchMode: LaunchMode;
+  quarantined: QuarantinedEntry[];
+}
+
+export class RegistryError extends Error {
+  readonly code: "local-not-removable" | "unknown-connection" | "bad-entry";
+
+  constructor(code: RegistryError["code"], message: string) {
+    super(message);
+    this.code = code;
+  }
+}
+
+export function secretName(id: string, kind: SecretKind): `connection-${string}` {
+  return `connection-${id}-${kind}`;
+}
+
+// -- labels, ids, handles -------------------------------------------------------------------------
+
+export function labelKey(label: string): string {
+  return label.trim().toLowerCase();
+}
+
+/** `candidate` (cut to fit) or the first free `candidate N`, ignoring case. */
+export function uniqueLabel(candidate: string, taken: Iterable<string>): string {
+  const used = new Set([...taken].map(labelKey));
+  const base = candidate.trim().slice(0, LABEL_MAX - 4) || "Connection";
+  if (!used.has(labelKey(base))) return base;
+  for (let n = 2; ; n += 1) {
+    const next = `${base} ${n}`;
+    if (!used.has(labelKey(next))) return next;
+  }
+}
+
+export function labelSlug(label: string): string {
+  const slug = label
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 48)
+    .replace(/-+$/, "");
+  return slug || "connection";
+}
+
+function freshId(label: string, taken: ReadonlySet<string>): string {
+  const base = labelSlug(label);
+  if (base !== LOCAL_ID && !taken.has(base)) return base;
+  for (let n = 2; ; n += 1) {
+    const next = `${base}-${n}`;
+    if (!taken.has(next)) return next;
+  }
+}
+
+/** How a profile shows in a roster spanning several gateways: bare when unique, else suffixed. */
+export function agentHandle(profile: string, label: string, duplicated: boolean): string {
+  const name = profile.trim() || "default";
+  return `@${duplicated ? `${name}-${labelSlug(label)}` : name}`;
+}
+
+/** Handles for every (connection, profile) of a roster; same-named profiles get the label. */
+export function rosterHandles(
+  rosters: ReadonlyArray<{ connectionId: string; label: string; profiles: readonly string[] }>,
+): Map<string, string> {
+  const counts = new Map<string, number>();
+  for (const roster of rosters)
+    for (const profile of new Set(roster.profiles))
+      counts.set(profile, (counts.get(profile) ?? 0) + 1);
+  const out = new Map<string, string>();
+  for (const roster of rosters) {
+    for (const profile of roster.profiles) {
+      const handle = agentHandle(profile, roster.label, (counts.get(profile) ?? 0) > 1);
+      out.set(`${roster.connectionId}::${profile}`, handle);
+    }
+  }
+  return out;
+}
+
+// -- identity -------------------------------------------------------------------------------------
+
+const HOST_RE = /^[A-Za-z0-9._-]+$|^\[?[0-9A-Fa-f:.]+(%[A-Za-z0-9._-]+)?\]?$/;
+
+/** A checked SSH target, or null. */
+export function normalizeSsh(raw: unknown): SshTarget | null {
+  if (raw === null || typeof raw !== "object") return null;
+  const record = raw as Record<string, unknown>;
+  const host = typeof record.host === "string" ? record.host.trim() : "";
+  if (host === "" || host.startsWith("-") || !HOST_RE.test(host)) return null;
+  const out: SshTarget = { host };
+  if (typeof record.user === "string" && record.user.trim() !== "") {
+    const user = record.user.trim();
+    if (user.startsWith("-") || !/^[A-Za-z0-9._-]+$/.test(user)) return null;
+    out.user = user;
+  }
+  if (record.port !== undefined && record.port !== null && record.port !== "") {
+    const port = Number(record.port);
+    if (!Number.isInteger(port) || port < 1 || port > 65_535) return null;
+    if (port !== 22) out.port = port;
+  }
+  if (typeof record.keyPath === "string" && record.keyPath.trim() !== "") {
+    const key = record.keyPath.trim();
+    if (key.startsWith("-") || /[\r\n\0]/.test(key)) return null;
+    out.keyPath = key;
+  }
+  if (typeof record.remoteProfile === "string" && record.remoteProfile.trim() !== "") {
+    const profile = record.remoteProfile.trim();
+    if (!PROFILE_RE.test(profile)) return null;
+    out.remoteProfile = profile;
+  }
+  return out;
+}
+
+/** The identity two entries share when they are the same server. */
+export function identityOf(entry: Pick<ConnectionEntry, "kind" | "url" | "ssh">): string {
+  if (entry.kind === "local") return "local";
+  if (entry.kind === "remote") return `remote:${entry.url ?? ""}`;
+  const ssh = entry.ssh;
+  if (ssh === undefined) return "ssh:";
+  return `ssh:${ssh.user ?? ""}@${ssh.host.toLowerCase()}:${ssh.port ?? 22}/${ssh.remoteProfile ?? "default"}`;
+}
+
+function hostLabel(entry: { kind: ConnectionKind; url?: string; ssh?: SshTarget }): string {
+  if (entry.kind === "ssh") return entry.ssh?.host ?? "SSH";
+  try {
+    return new URL(entry.url ?? "").host || "Remote";
+  } catch {
+    return "Remote";
+  }
+}
+
+// -- normalise ------------------------------------------------------------------------------------
+
+function localEntry(label = LOCAL_LABEL): ConnectionEntry {
+  return { id: LOCAL_ID, kind: "local", label };
+}
+
+function plainCopy(value: unknown): unknown {
+  try {
+    return JSON.parse(JSON.stringify(value)) as unknown;
+  } catch {
+    return { unserializable: true };
+  }
+}
+
+function profilesOf(raw: unknown): string[] | undefined {
+  if (!Array.isArray(raw)) return undefined;
+  const names = raw.filter((p): p is string => typeof p === "string" && PROFILE_RE.test(p));
+  return names.length > 0 ? [...new Set(names)] : undefined;
+}
+
+/** Any parsed JSON → a valid registry (see the file notes); never throws. */
+export function normalizeRegistry(raw: unknown): ConnectionRegistry {
+  const parsed = raw !== null && typeof raw === "object" ? (raw as Record<string, unknown>) : {};
+  const quarantined: QuarantinedEntry[] = [];
+  const quarantine = (reason: string, entry: unknown) => {
+    if (quarantined.length < QUARANTINE_CAP) quarantined.push({ reason, entry: plainCopy(entry) });
+  };
+  if (Array.isArray(parsed.quarantined)) {
+    for (const item of parsed.quarantined) {
+      if (item !== null && typeof item === "object" && "entry" in item) {
+        const record = item as { reason?: unknown; entry: unknown };
+        quarantine(typeof record.reason === "string" ? record.reason : "unknown", record.entry);
+      }
+    }
+  }
+  const connections: ConnectionEntry[] = [];
+  const ids = new Set<string>();
+  const labels: string[] = [];
+  const identities = new Set<string>();
+  const list = Array.isArray(parsed.connections) ? parsed.connections : [];
+  for (const item of list) {
+    if (item === null || item === undefined || item === false || item === "") continue;
+    if (typeof item !== "object" || Array.isArray(item)) {
+      quarantine("malformed", item);
+      continue;
+    }
+    try {
+      const record = item as Record<string, unknown>;
+      const kind = record.kind;
+      if (kind !== "local" && kind !== "remote" && kind !== "ssh") {
+        quarantine("unknown-kind", item);
+        continue;
+      }
+      if (kind === "local" && ids.has(LOCAL_ID)) {
+        quarantine("second-local", item);
+        continue;
+      }
+      const clean: ConnectionEntry = { id: "", kind, label: "" };
+      if (kind === "remote") {
+        try {
+          clean.url = normalizeRemoteUrl(typeof record.url === "string" ? record.url : "");
+        } catch {
+          quarantine("bad-url", item);
+          continue;
+        }
+        const mode = record.authMode;
+        clean.authMode = mode === "oauth" || mode === "basic" ? mode : "token";
+      } else if (kind === "ssh") {
+        const ssh = normalizeSsh(record.ssh);
+        if (ssh === null) {
+          quarantine("bad-ssh", item);
+          continue;
+        }
+        clean.ssh = ssh;
+      }
+      const identity = identityOf(clean);
+      if (kind !== "local" && identities.has(identity)) {
+        quarantine("duplicate", item);
+        continue;
+      }
+      const rawLabel = typeof record.label === "string" ? record.label.trim() : "";
+      clean.label = uniqueLabel(
+        rawLabel || (kind === "local" ? LOCAL_LABEL : hostLabel(clean)),
+        labels,
+      );
+      const rawId = typeof record.id === "string" ? record.id.trim() : "";
+      clean.id =
+        kind === "local"
+          ? LOCAL_ID
+          : ID_RE.test(rawId) && rawId !== LOCAL_ID && !ids.has(rawId)
+            ? rawId
+            : freshId(clean.label, ids);
+      const profiles = profilesOf(record.profiles);
+      if (profiles !== undefined) clean.profiles = profiles;
+      ids.add(clean.id);
+      labels.push(clean.label);
+      identities.add(identity);
+      connections.push(clean);
+    } catch {
+      quarantine("unreadable", item);
+    }
+  }
+  if (!ids.has(LOCAL_ID)) {
+    const label = uniqueLabel(LOCAL_LABEL, labels);
+    connections.unshift(localEntry(label));
+    ids.add(LOCAL_ID);
+  }
+  const primaryId =
+    typeof parsed.primaryId === "string" && ids.has(parsed.primaryId) ? parsed.primaryId : LOCAL_ID;
+  const registry: ConnectionRegistry = {
+    v: REGISTRY_VERSION,
+    connections,
+    primaryId,
+    launchMode: parsed.launchMode === "last-used" ? "last-used" : "primary",
+    quarantined,
+  };
+  if (typeof parsed.lastUsedId === "string" && ids.has(parsed.lastUsedId)) {
+    registry.lastUsedId = parsed.lastUsedId;
+  }
+  return registry;
+}
+
+// -- changes (pure: each returns a new registry) --------------------------------------------------
+
+export interface EntryInput {
+  id?: string;
+  kind: "remote" | "ssh";
+  label?: string;
+  url?: string;
+  authMode?: AuthMode;
+  ssh?: SshTarget;
+}
+
+/** Add or update an entry; an existing server (same identity or id) keeps its id and label. */
+export function upsertEntry(
+  registry: ConnectionRegistry,
+  input: EntryInput,
+): { registry: ConnectionRegistry; entry: ConnectionEntry; created: boolean } {
+  const draft: ConnectionEntry = { id: "", kind: input.kind, label: "" };
+  if (input.kind === "remote") {
+    try {
+      draft.url = normalizeRemoteUrl(input.url ?? "");
+    } catch (error) {
+      throw new RegistryError("bad-entry", error instanceof Error ? error.message : "bad address");
+    }
+    draft.authMode = input.authMode ?? "token";
+  } else {
+    const ssh = normalizeSsh(input.ssh);
+    if (ssh === null) throw new RegistryError("bad-entry", "that is not a usable SSH target");
+    draft.ssh = ssh;
+  }
+  const identity = identityOf(draft);
+  const existing =
+    registry.connections.find((c) => input.id !== undefined && c.id === input.id) ??
+    registry.connections.find((c) => c.kind !== "local" && identityOf(c) === identity);
+  const others = registry.connections.filter((c) => c.id !== existing?.id);
+  const clash = others.find((c) => c.kind !== "local" && identityOf(c) === identity);
+  if (clash !== undefined) {
+    throw new RegistryError("bad-entry", `"${clash.label}" already connects to that server`);
+  }
+  const wanted = input.label?.trim() ?? "";
+  draft.label = uniqueLabel(
+    wanted || existing?.label || hostLabel(draft),
+    others.map((c) => c.label),
+  );
+  draft.id = existing?.id ?? freshId(draft.label, new Set(registry.connections.map((c) => c.id)));
+  if (existing?.profiles !== undefined) draft.profiles = existing.profiles;
+  const connections =
+    existing === undefined
+      ? [...registry.connections, draft]
+      : registry.connections.map((c) => (c.id === existing.id ? draft : c));
+  return { registry: { ...registry, connections }, entry: draft, created: existing === undefined };
+}
+
+export function removeEntry(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  const target = registry.connections.find((c) => c.id === id);
+  if (target === undefined) return registry;
+  if (target.kind === "local") {
+    throw new RegistryError("local-not-removable", "This computer cannot be removed");
+  }
+  const primaryId = registry.primaryId === id ? LOCAL_ID : registry.primaryId;
+  const next: ConnectionRegistry = {
+    ...registry,
+    primaryId,
+    connections: registry.connections.filter((c) => c.id !== id),
+  };
+  if (registry.lastUsedId === id) delete next.lastUsedId;
+  return next;
+}
+
+function known(registry: ConnectionRegistry, id: string): void {
+  if (!registry.connections.some((c) => c.id === id)) {
+    throw new RegistryError("unknown-connection", "no connection has that id");
+  }
+}
+
+export function setPrimary(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  known(registry, id);
+  return { ...registry, primaryId: id };
+}
+
+export function setLastUsed(registry: ConnectionRegistry, id: string): ConnectionRegistry {
+  known(registry, id);
+  return { ...registry, lastUsedId: id };
+}
+
+export function setLaunchMode(registry: ConnectionRegistry, mode: LaunchMode): ConnectionRegistry {
+  return { ...registry, launchMode: mode };
+}
+
+export function setProfiles(
+  registry: ConnectionRegistry,
+  id: string,
+  profiles: readonly string[],
+): ConnectionRegistry {
+  known(registry, id);
+  const clean = profilesOf([...profiles]);
+  return {
+    ...registry,
+    connections: registry.connections.map((c) => {
+      if (c.id !== id) return c;
+      const { profiles: _old, ...rest } = c;
+      return clean === undefined ? rest : { ...rest, profiles: clean };
+    }),
+  };
+}
+
+/** The entry a launch opens (launch mode decides; anything missing falls back to the primary). */
+export function launchEntry(registry: ConnectionRegistry): ConnectionEntry {
+  const byId = (id: string | undefined) => registry.connections.find((c) => c.id === id);
+  const chosen =
+    registry.launchMode === "last-used"
+      ? (byId(registry.lastUsedId) ?? byId(registry.primaryId))
+      : byId(registry.primaryId);
+  return chosen ?? (byId(LOCAL_ID) as ConnectionEntry);
+}
+
+// -- the file -------------------------------------------------------------------------------------
+
+export interface SecretsLike {
+  get(name: string): string | null;
+  put(name: string, value: string): void;
+  delete(name: string): void;
+}
+
+export interface RegistryStoreDeps {
+  userData: string;
+  secrets: SecretsLike;
+  log: (line: string) => void;
+}
+
+/** Load and save the registry; the first load takes over the P20 single saved remote. */
+export class RegistryStore {
+  private readonly deps: RegistryStoreDeps;
+
+  constructor(deps: RegistryStoreDeps) {
+    this.deps = deps;
+  }
+
+  file(): string {
+    return path.join(this.deps.userData, REGISTRY_FILE);
+  }
+
+  load(): ConnectionRegistry {
+    const exists = fs.existsSync(this.file());
+    if (!exists) return this.migrate();
+    let raw: unknown = null;
+    try {
+      raw = readJsonFile(this.file());
+    } catch {
+      raw = null;
+    }
+    return normalizeRegistry(raw);
+  }
+
+  save(registry: ConnectionRegistry): void {
+    const clean = normalizeRegistry(registry);
+    fs.mkdirSync(this.deps.userData, { recursive: true });
+    writeFileAtomic(this.file(), `${JSON.stringify(clean, null, 2)}\n`, { mode: 0o600 });
+  }
+
+  /** Change the registry under one load → change → save. */
+  update(change: (registry: ConnectionRegistry) => ConnectionRegistry): ConnectionRegistry {
+    const next = change(this.load());
+    this.save(next);
+    return this.load();
+  }
+
+  /** Drop an entry and its secrets. */
+  remove(id: string): ConnectionRegistry {
+    const next = this.update((registry) => removeEntry(registry, id));
+    for (const kind of ["token", "oauth", "headers"] as const) {
+      this.deps.secrets.delete(secretName(id, kind));
+    }
+    return next;
+  }
+
+  private migrate(): ConnectionRegistry {
+    const legacy = readJsonFile(path.join(this.deps.userData, REMOTE_FILE)) as {
+      url?: unknown;
+    } | null;
+    let registry = normalizeRegistry({});
+    if (legacy !== null && typeof legacy.url === "string") {
+      try {
+        const added = upsertEntry(registry, { kind: "remote", url: legacy.url });
+        registry = setPrimary(added.registry, added.entry.id);
+        const token = this.deps.secrets.get(REMOTE_TOKEN_SECRET);
+        if (token !== null) this.deps.secrets.put(secretName(added.entry.id, "token"), token);
+        this.deps.log("[connections] took the saved remote connection into the registry");
+      } catch {
+        this.deps.log("[connections] the saved remote connection could not be taken over");
+      }
+    }
+    this.save(registry);
+    return this.load();
+  }
+}
diff --git a/apps/desktop/electron/connections/remoteDial.test.ts b/apps/desktop/electron/connections/remoteDial.test.ts
new file mode 100644
index 0000000..1a40c04
--- /dev/null
+++ b/apps/desktop/electron/connections/remoteDial.test.ts
@@ -0,0 +1,122 @@
+import { afterAll, describe, expect, it } from "vitest";
+import { closeFakeServes, fakeServe, SERVE_TOKEN } from "../../testing/fakeServe.ts";
+import { OAuthSession } from "./nativeOauth.ts";
+import {
+  DialError,
+  dialProtocols,
+  mintRemoteTicket,
+  RemoteAuth,
+  testRemoteConnection,
+} from "./remoteDial.ts";
+
+afterAll(closeFakeServes);
+
+const TOKEN = SERVE_TOKEN;
+
+describe("remote dial", () => {
+  it("each dial mints its own single-use ticket", async () => {
+    const serve = await fakeServe();
+    const auth = new RemoteAuth(serve.url, { mode: "token", token: TOKEN });
+    const one = await mintRemoteTicket(auth, { profile: "work" });
+    const two = await mintRemoteTicket(auth);
+    expect(one.ticket).not.toBe(two.ticket);
+    expect(serve.minted).toEqual([one.ticket, two.ticket]);
+    expect(one.expiresInMs).toBe(30_000);
+    expect(dialProtocols(one.ticket)).toEqual([
+      "indus-dashboard-v1",
+      `indus-dashboard-ticket.${one.ticket}`,
+    ]);
+    // the token itself is never offered on a socket
+    expect(dialProtocols(one.ticket).join(" ")).not.toContain(TOKEN);
+  });
+
+  it("both legs pass with the credential; the socket used a ticket, not the token", async () => {
+    const serve = await fakeServe();
+    const auth = new RemoteAuth(serve.url, { mode: "token", token: TOKEN });
+    const result = await testRemoteConnection(auth, { settleMs: 50 });
+    expect(result).toEqual({ ok: true, http: "ok", ws: "ok", nativeSignIn: true });
+    const ws = serve.seen.find((line) => line.startsWith("WS "));
+    expect(ws).toContain("indus-dashboard-ticket.");
+    expect(ws).not.toContain(TOKEN);
+  });
+
+  it("HTTP-only success with a WS failure reports the connection as failing", async () => {
+    const serve = await fakeServe({ wsClose: 1011 });
+    const auth = new RemoteAuth(serve.url, { mode: "token", token: TOKEN });
+    const result = await testRemoteConnection(auth, { settleMs: 50 });
+    expect(result.ok).toBe(false);
+    expect(result.http).toBe("ok");
+    expect(result.ws).not.toBe("ok");
+    expect(result.message).toMatch(/WebSocket did not work/);
+  });
+
+  it("a wrong token is unauthorized on both legs; an old serve is named", async () => {
+    const serve = await fakeServe();
+    const wrong = new RemoteAuth(serve.url, { mode: "token", token: "nope" });
+    const result = await testRemoteConnection(wrong, { settleMs: 50 });
+    expect(result).toMatchObject({ ok: false, http: "unauthorized", ws: "unauthorized" });
+    const old = await fakeServe({ ticketStatus: 409 });
+    await expect(
+      mintRemoteTicket(new RemoteAuth(old.url, { mode: "token", token: TOKEN })),
+    ).rejects.toMatchObject({ kind: "old-server" });
+  });
+
+  it("503 is connectivity, not reauth; an unreachable server is unreachable", async () => {
+    const serve = await fakeServe({ configStatus: 503 });
+    const auth = new RemoteAuth(serve.url, { mode: "token", token: TOKEN });
+    expect((await testRemoteConnection(auth, { settleMs: 50 })).http).toBe("error");
+    const gone = new RemoteAuth("http://127.0.0.1:9", { mode: "token", token: TOKEN });
+    const result = await testRemoteConnection(gone, { timeoutMs: 2000 });
+    expect(result).toMatchObject({ ok: false, http: "unreachable" });
+    await expect(mintRemoteTicket(gone)).rejects.toBeInstanceOf(DialError);
+  });
+
+  it("access-proxy headers reach the gateway; dropped names never do", async () => {
+    const serve = await fakeServe();
+    const auth = new RemoteAuth(serve.url, {
+      mode: "token",
+      token: TOKEN,
+      headers: { "CF-Access-Client-Id": "cf-1", Cookie: "stolen=1" },
+    });
+    await mintRemoteTicket(auth);
+    expect(serve.seen.some((line) => line.includes("cf=cf-1"))).toBe(true);
+    expect(auth.proxyHeaders(`${serve.url}/api/x`)).toEqual({ "CF-Access-Client-Id": "cf-1" });
+  });
+
+  it("an OAuth connection sends its access token and refreshes once on an explicit 401", async () => {
+    const access = ["fresh", "access"].join("-");
+    const serve = await fakeServe({ bearer: access });
+    const stored = {
+      value: JSON.stringify({ accessToken: "stale", refreshToken: "r", expiresAt: 9e9 }),
+    };
+    const refreshes: string[] = [];
+    const fakeFetch: typeof fetch = async (input, init) => {
+      const url = String(input);
+      if (url.endsWith("/auth/native/refresh")) {
+        refreshes.push(String(init?.body));
+        return new Response(JSON.stringify({ access_token: access, expires_in: 600 }), {
+          status: 200,
+          headers: { "content-type": "application/json" },
+        });
+      }
+      return fetch(input, init);
+    };
+    const session = new OAuthSession(
+      serve.url,
+      {
+        get: () => stored.value,
+        put: (v) => {
+          stored.value = v;
+        },
+        delete: () => {
+          stored.value = "";
+        },
+      },
+      { fetch: fakeFetch, nowS: () => 1000 },
+    );
+    const auth = new RemoteAuth(serve.url, { mode: "oauth", oauth: session }, { fetch: fakeFetch });
+    const minted = await mintRemoteTicket(auth);
+    expect(minted.ticket).toBe(serve.minted[0]);
+    expect(refreshes).toHaveLength(1);
+  });
+});
diff --git a/apps/desktop/electron/connections/remoteDial.ts b/apps/desktop/electron/connections/remoteDial.ts
new file mode 100644
index 0000000..91c4387
--- /dev/null
+++ b/apps/desktop/electron/connections/remoteDial.ts
@@ -0,0 +1,402 @@
+// How main talks to a remote Indus for one registry entry (P24-29): the credential headers of
+// each request, the single-use WebSocket ticket of each dial, and the two-leg connection test.
+//
+// The WebSocket dial (D-16.691): Electron cannot put a token main holds into the renderer's
+// upgrade, so for every dial main asks the server for a ticket — `POST /api/auth/ws-ticket
+// {purpose: "web-rpc", profile?}` with the connection's credential — and the window offers
+// `indus-dashboard-v1` + `indus-dashboard-ticket.<ticket>`. The ticket is good once, for 30 s;
+// it is the only credential that crosses the bridge (R08.4).
+//
+// Credentials by mode: `token` → `X-Indus-Session-Token`; `oauth` → `Authorization: Bearer
+// <access>` from the native sign-in (refreshed near expiry); `basic` → main signs in with the
+// stored user name and password (`POST /auth/password-login`) and keeps the session cookie in
+// memory. Access-proxy headers (cleaned, `proxyHeaders.ts`) go on every request to that gateway.
+// Re-authentication happens only on an explicit 401 or 403: OAuth refreshes once, basic signs in
+// once; a timeout, a refused connection or a 5xx is connectivity and never asks for a credential.
+
+import { SESSION_TOKEN_HEADER } from "../backend/localAttach.ts";
+import { classifyStatus, type Leg, remoteWsUrl, WS_SETTLE_MS } from "../backend/remote.ts";
+import { REMOTE_PROBE_TIMEOUT_MS } from "../backend/remoteLiveness.ts";
+import { DASHBOARD_SUBPROTOCOL, DASHBOARD_TICKET_PREFIX } from "../backend/tickets.ts";
+import { OAuthError, type OAuthSession } from "./nativeOauth.ts";
+import { proxyHeadersFor } from "./proxyHeaders.ts";
+import type { AuthMode } from "./registry.ts";
+
+export const DIAL_PURPOSE = "web-rpc";
+export const TICKET_ROUTE = "/api/auth/ws-ticket";
+
+export type DialErrorKind = "unauthorized" | "unreachable" | "old-server" | "busy" | "error";
+
+export class DialError extends Error {
+  readonly kind: DialErrorKind;
+  readonly status: number | null;
+
+  constructor(kind: DialErrorKind, message: string, status: number | null = null) {
+    super(message);
+    this.kind = kind;
+    this.status = status;
+  }
+}
+
+export interface RemoteCredentials {
+  mode: AuthMode;
+  token?: string | null;
+  oauth?: OAuthSession | null;
+  basic?: { username: string; password: string } | null;
+  /** Access-proxy headers as stored (cleaned again before use). */
+  headers?: Record<string, string>;
+}
+
+export interface DialDeps {
+  fetch?: typeof fetch;
+  timeoutMs?: number;
+}
+
+function joinUrl(base: string, route: string): string {
+  const url = new URL(base);
+  url.pathname = `${url.pathname.replace(/\/+$/, "")}${route}`;
+  return url.toString();
+}
+
+/** Everything main needs to call one remote with its credential. */
+export class RemoteAuth {
+  readonly base: string;
+  private readonly credentials: RemoteCredentials;
+  private readonly deps: DialDeps;
+  private cookie: string | null = null;
+
+  constructor(base: string, credentials: RemoteCredentials, deps: DialDeps = {}) {
+    this.base = base;
+    this.credentials = credentials;
+    this.deps = deps;
+  }
+
+  get mode(): AuthMode {
+    return this.credentials.mode;
+  }
+
+  private fetcher(): typeof fetch {
+    return this.deps.fetch ?? fetch;
+  }
+
+  /** Access-proxy headers for `url` (only when it goes to this gateway). */
+  proxyHeaders(url: string): Record<string, string> {
+    return proxyHeadersFor(url, this.base, this.credentials.headers ?? {});
+  }
+
+  /** The credential headers of one request to this server. */
+  async authHeaders(): Promise<Record<string, string>> {
+    const { mode } = this.credentials;
+    if (mode === "token") {
+      const token = this.credentials.token ?? "";
+      if (token === "") throw new DialError("unauthorized", "no token is saved for this server");
+      return { [SESSION_TOKEN_HEADER]: token };
+    }
+    if (mode === "oauth") {
+      const session = this.credentials.oauth;
+      if (session === null || session === undefined) {
+        throw new DialError("unauthorized", "sign in to this server first");
+      }
+      try {
+        return { Authorization: `Bearer ${await session.accessToken()}` };
+      } catch (error) {
+        throw this.fromOAuth(error);
+      }
+    }
+    if (this.cookie === null) await this.basicSignIn();
+    return { Cookie: this.cookie as string };
+  }
+
+  private fromOAuth(error: unknown): DialError {
+    if (error instanceof OAuthError && error.kind === "unreachable") {
+      return new DialError("unreachable", error.message);
+    }
+    return new DialError(
+      "unauthorized",
+      error instanceof Error ? error.message : "sign in to this server again",
+    );
+  }
+
+  private async basicSignIn(): Promise<void> {
+    const basic = this.credentials.basic;
+    if (basic === null || basic === undefined || basic.username === "") {
+      throw new DialError("unauthorized", "no user name is saved for this server");
+    }
+    const url = joinUrl(this.base, "/auth/password-login");
+    let response: Response;
+    try {
+      response = await this.fetcher()(url, {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          Accept: "application/json",
+          ...this.proxyHeaders(url),
+        },
+        body: JSON.stringify({ username: basic.username, password: basic.password }),
+        redirect: "manual",
+        signal: AbortSignal.timeout(this.deps.timeoutMs ?? REMOTE_PROBE_TIMEOUT_MS),
+      });
+    } catch {
+      throw new DialError("unreachable", "the server did not answer");
+    }
+    await response.body?.cancel();
+    if (response.status === 401 || response.status === 403) {
+      throw new DialError(
+        "unauthorized",
+        "the server refused this user name or password",
+        response.status,
+      );
+    }
+    const cookies = response.headers
+      .getSetCookie()
+      .map((line) => line.split(";")[0]?.trim() ?? "")
+      .filter((pair) => pair.includes("="));
+    if (response.status >= 300 || cookies.length === 0) {
+      throw new DialError(
+        "error",
+        `the server's sign-in answered ${response.status}`,
+        response.status,
+      );
+    }
+    this.cookie = cookies.join("; ");
+  }
+
+  /** After an explicit 401/403: one fresh credential (OAuth refresh, basic sign-in), or false. */
+  async reauthenticate(): Promise<boolean> {
+    if (this.credentials.mode === "oauth" && this.credentials.oauth) {
+      try {
+        await this.credentials.oauth.afterUnauthorized();
+        return true;
+      } catch {
+        return false;
+      }
+    }
+    if (this.credentials.mode === "basic") {
+      this.cookie = null;
+      try {
+        await this.basicSignIn();
+        return true;
+      } catch {
+        return false;
+      }
+    }
+    return false;
+  }
+
+  /** One request with every header this server needs; a 401/403 re-authenticates once. */
+  async request(route: string, init: { method?: string; body?: unknown } = {}): Promise<Response> {
+    const url = joinUrl(this.base, route);
+    const send = async () =>
+      this.fetcher()(url, {
+        method: init.method ?? "GET",
+        headers: {
+          Accept: "application/json",
+          ...(init.body === undefined ? {} : { "Content-Type": "application/json" }),
+          ...this.proxyHeaders(url),
+          ...(await this.authHeaders()),
+        },
+        ...(init.body === undefined ? {} : { body: JSON.stringify(init.body) }),
+        redirect: "manual",
+        signal: AbortSignal.timeout(this.deps.timeoutMs ?? REMOTE_PROBE_TIMEOUT_MS),
+      });
+    let response: Response;
+    try {
+      response = await send();
+    } catch (error) {
+      if (error instanceof DialError) throw error;
+      throw new DialError("unreachable", "the server did not answer");
+    }
+    if ((response.status === 401 || response.status === 403) && (await this.reauthenticate())) {
+      await response.body?.cancel();
+      try {
+        response = await send();
+      } catch (error) {
+        if (error instanceof DialError) throw error;
+        throw new DialError("unreachable", "the server did not answer");
+      }
+    }
+    return response;
+  }
+}
+
+/** A single-use dashboard ticket for one WebSocket dial. */
+export async function mintRemoteTicket(
+  auth: RemoteAuth,
+  options: { purpose?: string; profile?: string | null } = {},
+): Promise<{ ticket: string; expiresInMs: number }> {
+  const body: Record<string, string> = { purpose: options.purpose ?? DIAL_PURPOSE };
+  if (options.profile) body.profile = options.profile;
+  const response = await auth.request(TICKET_ROUTE, { method: "POST", body });
+  const json = (await response.json().catch(() => null)) as {
+    ticket?: unknown;
+    expires_in?: unknown;
+    error?: unknown;
+  } | null;
+  if (response.status === 401 || response.status === 403) {
+    throw new DialError(
+      "unauthorized",
+      "the server refused this connection's credential",
+      response.status,
+    );
+  }
+  if (response.status === 409) {
+    throw new DialError(
+      "old-server",
+      "this server is too old to give the app a socket ticket; update Indus on it",
+      409,
+    );
+  }
+  if (response.status === 429) {
+    throw new DialError("busy", "too many sockets are opening; try again", 429);
+  }
+  if (response.status !== 200 || typeof json?.ticket !== "string" || json.ticket === "") {
+    throw new DialError(
+      "error",
+      `the server's ticket answer was ${response.status}`,
+      response.status,
+    );
+  }
+  const seconds = typeof json.expires_in === "number" ? json.expires_in : 30;
+  return { ticket: json.ticket, expiresInMs: Math.round(seconds * 1000) };
+}
+
+export function dialProtocols(ticket: string): string[] {
+  return [DASHBOARD_SUBPROTOCOL, `${DASHBOARD_TICKET_PREFIX}${ticket}`];
+}
+
+export interface WebSocketLike {
+  addEventListener(
+    type: "open" | "message" | "close" | "error",
+    listener: (event: unknown) => void,
+  ): void;
+  close(): void;
+}
+
+export interface ConnectionTestDeps extends DialDeps {
+  webSocket?: (url: string, protocols: string[], headers: Record<string, string>) => WebSocketLike;
+  settleMs?: number;
+}
+
+export interface ConnectionTestResult {
+  ok: boolean;
+  http: Leg;
+  ws: Leg;
+  /** The server offers native sign-in (`auth_flows`). */
+  nativeSignIn: boolean;
+  message?: string;
+}
+
+function wsProbe(
+  url: string,
+  protocols: string[],
+  headers: Record<string, string>,
+  deps: ConnectionTestDeps,
+): Promise<Leg> {
+  const timeout = deps.timeoutMs ?? REMOTE_PROBE_TIMEOUT_MS;
+  const settle = deps.settleMs ?? WS_SETTLE_MS;
+  return new Promise((resolve) => {
+    let opened = false;
+    let done = false;
+    let socket: WebSocketLike | null = null;
+    let settled: ReturnType<typeof setTimeout> | undefined;
+    const finish = (leg: Leg) => {
+      if (done) return;
+      done = true;
+      clearTimeout(deadline);
+      clearTimeout(settled);
+      try {
+        socket?.close();
+      } catch {
+        // already closed
+      }
+      resolve(leg);
+    };
+    const deadline = setTimeout(() => finish(opened ? "ok" : "unreachable"), timeout);
+    try {
+      socket = (
+        deps.webSocket ??
+        ((u, p, h) =>
+          new WebSocket(u, { protocols: p, headers: h } as unknown as string[]) as WebSocketLike)
+      )(url, protocols, headers);
+    } catch {
+      finish("error");
+      return;
+    }
+    socket.addEventListener("open", () => {
+      opened = true;
+      settled = setTimeout(() => finish("ok"), settle);
+    });
+    socket.addEventListener("message", () => finish("ok"));
+    socket.addEventListener("close", (event) => {
+      const code = (event as { code?: number }).code ?? 0;
+      if (code === 4401 || code === 4403) finish("unauthorized");
+      else finish(opened && code === 1000 ? "ok" : opened ? "error" : "unreachable");
+    });
+    socket.addEventListener("error", () => {
+      if (!opened) finish("unreachable");
+    });
+  });
+}
+
+function describe(http: Leg, ws: Leg): string {
+  if (http === "unauthorized" || ws === "unauthorized") return "the server refused this credential";
+  if (http === "unreachable" || ws === "unreachable") return "the server could not be reached";
+  if (http === "ok") return "the server answered over HTTP, but its WebSocket did not work";
+  return "the server answered with an error";
+}
+
+function legOf(error: unknown): Leg {
+  if (error instanceof DialError) {
+    if (error.kind === "unauthorized") return "unauthorized";
+    if (error.kind === "unreachable") return "unreachable";
+  }
+  return "error";
+}
+
+/** Both legs with the real credential (R08.5): HTTP `GET /api/config`, then a ticketed socket. */
+export async function testRemoteConnection(
+  auth: RemoteAuth,
+  deps: ConnectionTestDeps = {},
+): Promise<ConnectionTestResult> {
+  let nativeSignIn = false;
+  try {
+    const status = await (deps.fetch ?? fetch)(joinUrl(auth.base, "/api/status"), {
+      headers: {
+        Accept: "application/json",
+        ...auth.proxyHeaders(joinUrl(auth.base, "/api/status")),
+      },
+      redirect: "manual",
+      signal: AbortSignal.timeout(deps.timeoutMs ?? REMOTE_PROBE_TIMEOUT_MS),
+    });
+    const body = (await status.json().catch(() => null)) as { auth_flows?: unknown } | null;
+    nativeSignIn = Array.isArray(body?.auth_flows) && body.auth_flows.includes("native_pkce");
+  } catch {
+    return {
+      ok: false,
+      http: "unreachable",
+      ws: "error",
+      nativeSignIn,
+      message: "the server did not answer",
+    };
+  }
+  let http: Leg;
+  try {
+    const response = await auth.request("/api/config");
+    await response.body?.cancel();
+    http = classifyStatus(response.status);
+  } catch (error) {
+    http = legOf(error);
+  }
+  let ws: Leg;
+  try {
+    const { ticket } = await mintRemoteTicket(auth);
+    const url = remoteWsUrl(auth.base);
+    ws = await wsProbe(url, dialProtocols(ticket), auth.proxyHeaders(url), deps);
+  } catch (error) {
+    ws = legOf(error);
+  }
+  const ok = http === "ok" && ws === "ok";
+  const result: ConnectionTestResult = { ok, http, ws, nativeSignIn };
+  if (!ok) result.message = describe(http, ws);
+  return result;
+}
diff --git a/apps/desktop/electron/connections/ssh.test.ts b/apps/desktop/electron/connections/ssh.test.ts
