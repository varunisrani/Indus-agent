+
+# -- suggested jobs (P24-46) ----------------------------------------------------------------------
+
+
+@cron_group.group("suggestions", invoke_without_command=True)
+@click.pass_context
+def suggestions_group(ctx: click.Context) -> None:
+    """Suggested jobs: nothing is scheduled until you accept one."""
