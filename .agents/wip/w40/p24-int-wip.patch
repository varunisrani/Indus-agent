+    setConfirming(null);
+    props.onPendingDone?.();
+    setNote({
+      answer,
+      ...(answer.ok ? { ok: t("skills.done", { name: answer.data.name ?? identifier }) } : {}),
+    });
+    list.reload();
+  };
+
+  const uninstall = async (name: string) => {
