+// @vitest-environment jsdom
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router";
+import { describe, expect, it } from "vitest";
+import { fakeRest } from "../../settings/fakeRest.ts";
+import { type ArtifactsBridge, ArtifactsPage } from "./ArtifactsPage.tsx";
+import { extractArtifacts } from "./artifacts.ts";
+
+const MESSAGES = [
+  { role: "user", content: "make a chart and a report", timestamp: 10 },
+  {
+    role: "assistant",
+    content: "",
+    timestamp: 11,
+    tool_calls: [
+      {
+        id: "1",
+        name: "write_file",
+        arguments: JSON.stringify({ path: "/srv/work/report.md", content: "x" }),
+      },
+      { id: "2", name: "patch", arguments: "not json" },
+    ],
+  },
+  { role: "tool", content: "saved chart to /srv/work/out/chart.png", timestamp: 12 },
+  {
+    role: "assistant",
+    content:
+      "Here: ![chart](https://cdn.example.com/c.png) and the docs https://docs.example.com/guide.",
+    timestamp: 13,
+  },
+];
+
+describe("artifacts", () => {
+  it("finds images, files and links and jumps back to the session", async () => {
+    const found = extractArtifacts(MESSAGES, { id: "s1", title: "Charts", profile: "work" });
+    expect(found.map((a) => [a.kind, a.value])).toEqual([
+      ["file", "/srv/work/report.md"],
+      ["image", "/srv/work/out/chart.png"],
+      ["image", "https://cdn.example.com/c.png"],
+      ["link", "https://docs.example.com/guide"],
+    ]);
+    const api = fakeRest();
+    api.route("GET", "/api/sessions?limit=30", {
+      sessions: [
+        { id: "s1", title: "Charts" },
+        { id: "s2", title: null },
+      ],
+    });
+    api.route("GET", "/api/sessions/s1/messages?limit=200&order=latest", { messages: MESSAGES });
+    api.route("GET", "/api/sessions/s2/messages?limit=200&order=latest", () => ({
+      status: 500,
+      body: {},
+    }));
+    const opened: string[] = [];
+    render(
+      <MemoryRouter>
+        <ArtifactsPage
+          api={api}
+          profile="work"
+          bridge={null}
+          onOpenSession={(id) => opened.push(id)}
+        />
+      </MemoryRouter>,
+    );
+    expect(await screen.findByText("report.md")).toBeTruthy();
+    expect(screen.getByText("1 sessions could not be read.")).toBeTruthy();
+    fireEvent.click(screen.getByText("Files"));
+    expect(screen.queryByText("guide")).toBeNull();
+    fireEvent.click(screen.getAllByText("Open chat")[0] as HTMLElement);
+    expect(opened).toEqual(["s1"]);
+  });
+
+  it("a remote artifact download carries the originating profile", async () => {
+    const api = fakeRest();
+    api.route("GET", "/api/sessions?limit=30", { sessions: [{ id: "s9", title: "Remote run" }] });
+    api.route("GET", "/api/sessions/s9/messages?limit=200&order=latest", { messages: MESSAGES });
+    const downloads: unknown[] = [];
+    const bridge: ArtifactsBridge = {
+      artifacts: {
+        download: async (request) => {
+          downloads.push(request);
+          return { savedTo: "/home/me/Downloads/report.md" };
+        },
+      },
+      external: { open: async () => ({ ok: true }) },
+    };
+    render(
+      <MemoryRouter>
+        <ArtifactsPage api={api} profile="research" bridge={bridge} />
+      </MemoryRouter>,
+    );
+    const card = (await screen.findByText("report.md")).closest("[data-kind]") as HTMLElement;
+    fireEvent.click(
+      Array.from(card.querySelectorAll("button")).find(
+        (b) => b.textContent === "Download",
+      ) as HTMLElement,
+    );
+    await waitFor(() => expect(downloads).toHaveLength(1));
+    expect(downloads[0]).toEqual({
+      path: "/srv/work/report.md",
+      profile: "research",
+      sessionId: "s9",
+    });
+    expect(await screen.findByText("Saved to /home/me/Downloads/report.md")).toBeTruthy();
+  });
+});
diff --git a/apps/desktop/src/app/artifacts/ArtifactsPage.tsx b/apps/desktop/src/app/artifacts/ArtifactsPage.tsx
new file mode 100644
index 0000000..668749b
--- /dev/null
+++ b/apps/desktop/src/app/artifacts/ArtifactsPage.tsx
@@ -0,0 +1,205 @@
+// The Artifacts page (P24-28): images, files and links the agent produced in the recent sessions
+// (`artifacts.ts` finds them), filtered by kind and searched by name or session; each one jumps
+// back to the session that made it. A file is downloaded through main (`artifacts.download`):
+// main mints the download ticket on the current connection with the artifact's originating profile
+// and session and saves the bytes into Downloads — on a remote connection that is the only way to
+// fetch it, and the renderer never sees the ticket.
+
+import { useState } from "react";
+import { useNavigate } from "react-router";
+import type { IndusDesktopBridge } from "../../global.d.ts";
+import { useT } from "../../i18n/index.tsx";
+import { type RestAnswer, type RestLike, rest } from "../../settings/settingsApi.ts";
+import { desktopBridge } from "../bridge.ts";
+import { LoadState, PageFrame, useApi, useRestValue, when } from "../manage/common.tsx";
+import { sessionPath } from "../routes.ts";
+import {
+  type Artifact,
+  type ArtifactKind,
+  extractArtifacts,
+  isRemoteValue,
+  type MessageLike,
+} from "./artifacts.ts";
+
+export const RECENT_SESSIONS = 30;
+export const MESSAGES_PER_SESSION = 200;
+
+interface SessionRow {
+  id: string;
+  title: string | null;
+  preview?: string | null;
+}
+
+/** Index the recent sessions of `profile`; sessions whose messages fail are counted. */
+export async function loadArtifacts(
+  api: RestLike | null,
+  profile: string | null,
+): Promise<RestAnswer<{ artifacts: Artifact[]; skipped: number }>> {
+  const list = await rest<{ sessions: SessionRow[] }>(
+    api,
+    "GET",
+    `/api/sessions?limit=${RECENT_SESSIONS}`,
+    { profile },
+  );
+  if (!list.ok) return list;
+  let skipped = 0;
+  const all: Artifact[] = [];
+  const pages = await Promise.all(
+    list.data.sessions.map((session) =>
+      rest<{ messages: MessageLike[] }>(
+        api,
+        "GET",
+        `/api/sessions/${encodeURIComponent(session.id)}/messages?limit=${MESSAGES_PER_SESSION}&order=latest`,
+        { profile },
+      ),
+    ),
+  );
+  pages.forEach((page, i) => {
+    const session = list.data.sessions[i] as SessionRow;
+    if (!page.ok) {
+      skipped += 1;
+      return;
+    }
+    all.push(
+      ...extractArtifacts(page.data.messages, {
+        id: session.id,
+        title: session.title ?? session.preview ?? session.id,
+        profile,
+      }),
+    );
+  });
+  all.sort((a, b) => b.timestamp - a.timestamp);
+  return { ok: true, status: 200, data: { artifacts: all, skipped } };
+}
+
+export type ArtifactsBridge = Pick<IndusDesktopBridge, "artifacts" | "external">;
+
+export function ArtifactsPage(props: {
+  api?: RestLike | null;
+  profile: string | null;
+  bridge?: ArtifactsBridge | null;
+  /** Jump back to a session (default: the router). */
+  onOpenSession?: (sessionId: string) => void;
+}) {
+  const t = useT();
+  const api = useApi(props.api);
+  const bridge = props.bridge === undefined ? desktopBridge() : props.bridge;
+  const navigate = useNavigate();
+  const open = props.onOpenSession ?? ((id: string) => navigate(sessionPath(id)));
+  const [kind, setKind] = useState<"all" | ArtifactKind>("all");
+  const [query, setQuery] = useState("");
+  const [note, setNote] = useState("");
+  const loaded = useRestValue(() => loadArtifacts(api, props.profile), [api, props.profile]);
+
+  const download = async (artifact: Artifact) => {
+    if (bridge === null) return;
+    try {
+      const done = await bridge.artifacts.download({
+        path: artifact.value,
+        profile: artifact.profile,
+        sessionId: artifact.sessionId,
+      });
+      setNote(t("manage.artifacts.saved", { path: done.savedTo }));
+    } catch (error) {
+      setNote(error instanceof Error ? error.message : t("manage.failed"));
+    }
+  };
+
+  return (
+    <PageFrame title={t("nav.artifacts")} id="artifacts">
+      <div className="manage-inline">
+        {(["all", "image", "file", "link"] as const).map((k) => (
+          <button
+            key={k}
+            type="button"
+            className="button button-secondary"
+            aria-pressed={kind === k}
+            onClick={() => setKind(k)}
+          >
+            {t(`manage.artifacts.kind.${k}`)}
+          </button>
+        ))}
+        <input
+          aria-label={t("manage.artifacts.search")}
+          placeholder={t("manage.artifacts.search")}
+          value={query}
+          onChange={(e) => setQuery(e.target.value)}
+        />
+      </div>
+      {note !== "" && (
+        <p className="manage-muted" role="status">
+          {note}
+        </p>
+      )}
+      <LoadState value={loaded}>
+        {(data) => {
+          const q = query.trim().toLowerCase();
+          const shown = data.artifacts.filter(
+            (a) =>
+              (kind === "all" || a.kind === kind) &&
+              (q === "" ||
+                a.value.toLowerCase().includes(q) ||
+                a.sessionTitle.toLowerCase().includes(q)),
+          );
+          return (
+            <>
+              {data.skipped > 0 && (
+                <p className="manage-muted">
+                  {t("manage.artifacts.skipped", { count: data.skipped })}
+                </p>
+              )}
+              {shown.length === 0 && <p className="manage-muted">{t("manage.artifacts.none")}</p>}
+              <div className="manage-gallery">
+                {shown.map((artifact) => (
+                  <div className="manage-card" key={artifact.key} data-kind={artifact.kind}>
+                    {artifact.kind === "image" && isRemoteValue(artifact.value) && (
+                      <img
+                        className="manage-thumb"
+                        src={artifact.value}
+                        alt=""
+                        loading="lazy"
+                        referrerPolicy="no-referrer"
+                      />
+                    )}
+                    <span className="manage-code">
+                      {artifact.value.split("/").pop() || artifact.value}
+                    </span>
+                    <span className="manage-muted">
+                      {artifact.sessionTitle} · {when(artifact.timestamp)}
+                    </span>
+                    <div className="manage-inline">
+                      <button
+                        type="button"
+                        className="button button-secondary"
+                        onClick={() => open(artifact.sessionId)}
+                      >
+                        {t("manage.artifacts.openChat")}
+                      </button>
+                      {isRemoteValue(artifact.value) ? (
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void bridge?.external.open({ url: artifact.value })}
+                        >
+                          {t("manage.artifacts.openLink")}
+                        </button>
+                      ) : (
+                        <button
+                          type="button"
+                          className="button button-secondary"
+                          onClick={() => void download(artifact)}
+                        >
+                          {t("manage.artifacts.download")}
+                        </button>
+                      )}
+                    </div>
+                  </div>
+                ))}
+              </div>
+            </>
+          );
+        }}
+      </LoadState>
+    </PageFrame>
+  );
+}
diff --git a/apps/desktop/src/app/artifacts/artifacts.ts b/apps/desktop/src/app/artifacts/artifacts.ts
new file mode 100644
index 0000000..7e41f0d
--- /dev/null
+++ b/apps/desktop/src/app/artifacts/artifacts.ts
@@ -0,0 +1,107 @@
+// What the artifact gallery finds in a session's messages (P24-28): images (markdown images,
+// image paths and image URLs), files (the path of every `write_file` / `patch` call) and links
+// (other http(s) URLs in the agent's text). Each item remembers the session and profile it came
+// from, so the gallery can jump back and main can download it from the right place.
+
+export type ArtifactKind = "image" | "file" | "link";
+
+export interface Artifact {
+  readonly key: string;
+  readonly kind: ArtifactKind;
+  /** A path on the machine that ran the session, or a URL. */
+  readonly value: string;
+  readonly sessionId: string;
+  readonly sessionTitle: string;
+  readonly profile: string | null;
+  readonly timestamp: number;
+}
+
+export interface MessageLike {
+  readonly role: string;
+  readonly content: string;
+  readonly timestamp?: number;
+  readonly tool_calls?: ReadonlyArray<{ id?: string; name: string; arguments: string }>;
+}
+
+export const FILE_TOOLS: ReadonlySet<string> = new Set([
+  "write_file",
+  "patch",
+  "edit_file",
+  "create_file",
+]);
+const IMAGE_EXT = /\.(png|jpe?g|gif|webp|svg|bmp)$/i;
+const URL_RE = /\bhttps?:\/\/[^\s<>()"'`\]]+/g;
+const MD_IMAGE_RE = /!\[[^\]]*\]\(([^)\s]+)\)/g;
+const PATH_RE =
+  /(?:^|[\s"'(`])((?:\/|~\/|\.\/)[^\s"'`<>()]+\.(?:png|jpe?g|gif|webp|svg|bmp))(?=$|[\s"'`),.;:])/gi;
+
+function trimUrl(url: string): string {
+  return url.replace(/[.,;:!?]+$/, "");
+}
+
+export function isRemoteValue(value: string): boolean {
+  return /^https?:\/\//i.test(value);
+}
+
+/** Every artifact in `messages` of one session (deduplicated, in message order). */
+export function extractArtifacts(
+  messages: readonly MessageLike[],
+  session: { id: string; title: string; profile: string | null },
+): Artifact[] {
+  const found = new Map<string, Artifact>();
+  const add = (kind: ArtifactKind, value: string, timestamp: number) => {
+    const key = `${session.profile ?? ""}|${session.id}|${kind}|${value}`;
+    if (!found.has(key)) {
+      found.set(key, {
+        key,
+        kind,
+        value,
+        sessionId: session.id,
+        sessionTitle: session.title,
+        profile: session.profile,
+        timestamp,
+      });
+    }
+  };
+  for (const message of messages) {
+    const when = message.timestamp ?? 0;
+    for (const call of message.tool_calls ?? []) {
+      if (!FILE_TOOLS.has(call.name)) continue;
+      try {
+        const args = JSON.parse(call.arguments) as { path?: unknown; file_path?: unknown };
+        const path =
+          typeof args.path === "string"
+            ? args.path
+            : typeof args.file_path === "string"
+              ? args.file_path
+              : null;
+        if (path !== null && path !== "") add(IMAGE_EXT.test(path) ? "image" : "file", path, when);
+      } catch {
+        // arguments that are not JSON name no file
+      }
+    }
+    if (message.role !== "assistant" && message.role !== "tool") continue;
+    const text = message.content ?? "";
+    const images = new Set<string>();
+    for (const match of text.matchAll(MD_IMAGE_RE)) {
+      const value = trimUrl(match[1] as string);
+      images.add(value);
+      add("image", value, when);
+    }
+    for (const match of text.matchAll(PATH_RE)) add("image", match[1] as string, when);
+    if (message.role === "assistant") {
+      for (const match of text.matchAll(URL_RE)) {
+        const url = trimUrl(match[0]);
+        if (images.has(url)) continue;
+        let pathname: string;
+        try {
+          pathname = new URL(url).pathname;
+        } catch {
+          continue;
+        }
+        add(IMAGE_EXT.test(pathname) ? "image" : "link", url, when);
+      }
+    }
+  }
+  return [...found.values()];
+}
