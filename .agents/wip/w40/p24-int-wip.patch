index 0000000..22be8fd
--- /dev/null
+++ b/src/indus/service/self_chat.py
@@ -0,0 +1,68 @@
+"""The ``self-chat`` cron delivery target (P24-07, H11): a job's output is added to its own
+profile's canonical bot chat as an incoming (user-role) message; no turn runs.
+
+``install_self_chat`` registers ``deliver_self_chat`` in cron's deliverer table while at least
+one caller holds it (one per delivery router, the CLI scheduler pass; several may live in one
+process) and returns that caller's undo. It lives in the service layer so the gateway and the CLI
+share it (layer rule D-16.246).
+"""
+
+from __future__ import annotations
+
+import threading
+from collections.abc import Callable
+from typing import Final
+
+from indus.cron import delivery as cron_delivery
+from indus.cron.delivery import DeliveryReceipt, DeliveryRequest
+from indus.foundation.blocking import run_blocking
+from indus.state import registry
+from indus.state.bot_chat import inject_incoming
+
+__all__ = ["SELF_CHAT", "deliver_self_chat", "install_self_chat"]
+
+SELF_CHAT: Final = "self-chat"
+
+
+async def deliver_self_chat(request: DeliveryRequest) -> DeliveryReceipt:
+    """Add the job's output to its own profile's canonical chat as an incoming message."""
+    scope = request.scope
+    chat = request.target.chat_id
+    if chat not in (None, "", scope.profile_id):
+        return DeliveryReceipt(False, error="self-chat reaches only this profile's own chat")
+
+    def inject() -> tuple[str, int]:
+        with registry.shared(scope) as store:
+            return inject_incoming(store, request.text)
+
+    session_id, row = await run_blocking(inject, label="self-chat")
+    return DeliveryReceipt(True, message_id=f"{session_id}:{row}")
+
+
+_lock = threading.Lock()
+_users = 0
+_undo: Callable[[], None] | None = None
+
+
+def install_self_chat() -> Callable[[], None]:
+    """Register the deliverer while held (see the module notes); returns this caller's undo."""
+    global _users, _undo
+    with _lock:
+        _users += 1
+        if _undo is None:
+            _undo = cron_delivery.register_deliverer(SELF_CHAT, deliver_self_chat)
+    released = False
+
+    def undo() -> None:
+        global _users, _undo
+        nonlocal released
+        with _lock:
+            if released:
+                return
+            released = True
+            _users -= 1
+            if _users == 0 and _undo is not None:
+                _undo()
+                _undo = None
+
+    return undo
diff --git a/src/indus/service/session_import.py b/src/indus/service/session_import.py
new file mode 100644
index 0000000..108227a
--- /dev/null
+++ b/src/indus/service/session_import.py
@@ -0,0 +1,500 @@
+"""Bring sessions written by two other coding-agent CLIs into a profile's store (P24-28).
+
+Both tools keep one JSON-lines file per conversation in the user's home:
+
+- **Claude Code**: ``~/.claude/projects/<project>/<session>.jsonl``. Each line is a record whose
+  ``type`` is ``user`` or ``assistant`` (other types — summaries, system lines — carry no turn);
+  its ``message`` has a ``role`` and a ``content`` that is either text or a list of blocks:
+  ``text``, ``tool_use`` (``id``, ``name``, ``input``), ``tool_result`` (``tool_use_id``,
+  ``content`` as text or text blocks) and ``thinking``. Records also carry ``timestamp`` and
+  ``cwd``.
+- **Codex CLI**: ``~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl``. A ``session_meta`` record
+  (``id``, ``cwd``, ``timestamp``) opens the file; turns are ``response_item`` records whose
+  ``payload`` is a ``message`` (``role``, ``content`` blocks ``input_text`` / ``output_text``), a
+  ``function_call`` (``name``, ``arguments`` as JSON text, ``call_id``) or a
+  ``function_call_output`` (``call_id``, ``output``). Older files hold the same items unwrapped.
+
+Our mapping (written here, not taken from either tool): person text → ``user``; assistant text →
+``assistant``; a tool use / call → an ``assistant`` message carrying one ``tool_calls`` entry
+(``{id, type: "function", function: {name, arguments}}``); its result / output → a ``tool``
+message with that ``tool_call_id`` and ``tool_name``; thinking and reasoning are dropped, and so
+are the context blocks Codex injects as user turns (``<environment_context>``,
+``<user_instructions>``). The title is the first person line (80 characters); the session's
+``cwd`` and start time come from the file.
+
+``preview`` maps at most ``PREVIEW_RECORDS`` records and never writes; ``import_session`` writes
+one new session per file (source ``import-<kind>``) with at most
+``MAX_MESSAGES`` messages and records the file's SHA-256 under the ``import`` metadata namespace,
+so a second import of the same bytes is refused with the existing session id. A file in which no
+record is recognised is an unknown format and is refused; lines that do not parse are counted as
+``skipped``. Only files under the two tools' session roots are accepted (``candidates``).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sqlite3
+from collections.abc import Iterator, Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Final, Literal, cast
+
+from indus.foundation.ids import new_session_id
+from indus.state import messages, session_meta, sessions, titles
+from indus.state.registry import StoreHandle
+from indus.state.writer import TRANSCRIPT
+
+__all__ = [
+    "KINDS",
+    "MAX_CANDIDATES",
+    "MAX_MESSAGES",
+    "PREVIEW_RECORDS",
+    "Candidate",
+    "ImportRefused",
+    "Imported",
+    "Mapped",
+    "SourceKind",
+    "candidates",
+    "import_session",
+    "map_file",
+    "preview",
+    "resolve_candidate",
+    "roots",
+    "source_kind",
+]
+
+type SourceKind = Literal["claude-code", "codex"]
+KINDS: Final[tuple[SourceKind, ...]] = ("claude-code", "codex")
+PREVIEW_RECORDS: Final = 2_000
+MAX_MESSAGES: Final = 20_000
+MAX_CANDIDATES: Final = 200
+TITLE_CHARS: Final = 80
+IMPORT_NAMESPACE: Final = "import"
+_HEAD_LINES: Final = 60
+_INJECTED_PREFIXES: Final = ("<environment_context>", "<user_instructions>")
+
+
+class ImportRefused(Exception):
+    """The file cannot be previewed or imported; ``code`` says why."""
+
+    def __init__(self, code: str, message: str, *, session_id: str | None = None) -> None:
+        super().__init__(message)
+        self.code = code
+        self.session_id = session_id
+
+
+@dataclass(frozen=True)
+class Candidate:
+    kind: SourceKind
+    path: Path
+    title: str
+    cwd: str | None
+    modified: float
+    size: int
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "source": self.kind,
+            "path": str(self.path),
+            "title": self.title,
+            "cwd": self.cwd,
+            "modified": self.modified,
+            "size": self.size,
+        }
+
+
+@dataclass
+class Mapped:
+    """What a file maps to: our message rows plus what we learned about the conversation."""
+
+    kind: SourceKind
+    messages: list[dict[str, Any]] = field(default_factory=lambda: list[dict[str, Any]]())
+    cwd: str | None = None
+    started_at: float | None = None
+    recognised: int = 0
+    skipped: int = 0
+    truncated: bool = False
+
+    @property
+    def title(self) -> str:
+        for row in self.messages:
+            if row["role"] == "user" and isinstance(row.get("content"), str):
+                first = str(row["content"]).strip().splitlines()
+                if first and first[0].strip():
+                    return first[0].strip()[:TITLE_CHARS]
+        return "Imported session"
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "source": self.kind,
+            "title": self.title,
+            "cwd": self.cwd,
+            "started_at": self.started_at,
+            "messages": [_preview_row(row) for row in self.messages],
+            "skipped": self.skipped,
+            "truncated": self.truncated,
+        }
+
+
+@dataclass(frozen=True)
+class Imported:
+    session_id: str
+    title: str
+    message_count: int
+
+    def to_dict(self) -> dict[str, Any]:
+        return {
+            "session_id": self.session_id,
+            "title": self.title,
+            "message_count": self.message_count,
+        }
+
+
+# -- where the files are ---------------------------------------------------------------------------
+
+
+def roots(home_dir: Path) -> dict[SourceKind, Path]:
+    return {
+        "claude-code": home_dir / ".claude" / "projects",
+        "codex": home_dir / ".codex" / "sessions",
+    }
+
+
+def _files(kind: SourceKind, root: Path) -> Iterator[Path]:
+    if not root.is_dir():
+        return
+    pattern = "*/*.jsonl" if kind == "claude-code" else "**/rollout-*.jsonl"
+    for path in root.glob(pattern):
+        if path.is_file() and not path.is_symlink():
+            yield path
+
+
+def candidates(home_dir: Path, *, kind: SourceKind | None = None) -> list[Candidate]:
+    """Session files of both tools (or one), newest first, at most ``MAX_CANDIDATES``."""
+    found: list[tuple[float, SourceKind, Path, int]] = []
+    for each, root in roots(home_dir).items():
+        if kind is not None and each != kind:
+            continue
+        for path in _files(each, root):
+            try:
+                stat = path.stat()
+            except OSError:
+                continue
+            found.append((stat.st_mtime, each, path, stat.st_size))
+    found.sort(key=lambda item: item[0], reverse=True)
+    out: list[Candidate] = []
+    for modified, each, path, size in found[:MAX_CANDIDATES]:
+        head = map_file(path, each, limit=_HEAD_LINES)
+        out.append(Candidate(each, path, head.title, head.cwd, modified, size))
+    return out
+
+
+def source_kind(text: str | None) -> SourceKind:
+    """``text`` as a source kind, or ``ImportRefused("unknown_source")``."""
+    for kind in KINDS:
+        if text == kind:
+            return kind
+    raise ImportRefused("unknown_source", "Only Claude Code and Codex sessions can be imported.")
+
+
+def resolve_candidate(home_dir: Path, kind: str, raw_path: str) -> Path:
+    """``raw_path`` when it is one of ``kind``'s session files under the home; else refused."""
+    source = source_kind(kind)
+    root = roots(home_dir)[source].resolve()
+    try:
+        path = Path(raw_path).resolve(strict=True)
+    except (OSError, RuntimeError):
+        raise ImportRefused("not_found", "That session file does not exist.") from None
+    if not path.is_relative_to(root) or path.suffix != ".jsonl" or not path.is_file():
+        raise ImportRefused("not_a_candidate", "Only the tools' own session files are accepted.")
+    if source == "codex" and not path.name.startswith("rollout-"):
+        raise ImportRefused("not_a_candidate", "Only the tools' own session files are accepted.")
+    return path
+
+
+# -- mapping ---------------------------------------------------------------------------------------
+
+
+def _text_of(content: object) -> str:
+    """Text from a plain string or a list of text-like blocks."""
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        parts: list[str] = []
+        for block in cast(list[object], content):
+            if isinstance(block, str):
+                parts.append(block)
+            elif isinstance(block, dict):
+                entry = cast(dict[str, object], block)
+                if entry.get("type") in ("text", "input_text", "output_text") and isinstance(
+                    entry.get("text"), str
+                ):
+                    parts.append(cast(str, entry["text"]))
+        return "\n".join(parts)
+    return ""
+
+
+def _timestamp(value: object) -> float | None:
+    if isinstance(value, (int, float)) and not isinstance(value, bool):
+        return float(value) / 1000 if value > 1e12 else float(value)
+    if isinstance(value, str) and value:
+        try:
+            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
+        except ValueError:
+            return None
+    return None
+
+
+def _call(call_id: str, name: str, arguments: object) -> dict[str, Any]:
+    text = arguments if isinstance(arguments, str) else json.dumps(arguments, sort_keys=True)
+    return {
+        "role": "assistant",
+        "content": "",
+        "tool_calls": [
+            {"id": call_id, "type": "function", "function": {"name": name, "arguments": text}}
+        ],
+    }
+
+
+class _Mapper:
+    def __init__(self, kind: SourceKind) -> None:
+        self.out = Mapped(kind)
+        self.names: dict[str, str] = {}
+
+    def note(self, record: Mapping[str, object]) -> None:
+        stamp = _timestamp(record.get("timestamp"))
+        if stamp is not None and self.out.started_at is None:
+            self.out.started_at = stamp
+        cwd = record.get("cwd")
+        if isinstance(cwd, str) and cwd and self.out.cwd is None:
+            self.out.cwd = cwd
+
+    def add(self, row: dict[str, Any]) -> None:
+        self.out.messages.append(row)
+
+    def user_text(self, text: str) -> None:
+        if text.strip() and not text.lstrip().startswith(_INJECTED_PREFIXES):
+            self.add({"role": "user", "content": text})
+
+    def assistant_text(self, text: str) -> None:
+        if text.strip():
+            self.add({"role": "assistant", "content": text})
+
+    def tool_call(self, call_id: str, name: str, arguments: object) -> None:
+        self.names[call_id] = name
+        self.add(_call(call_id, name, arguments))
+
+    def tool_result(self, call_id: str, content: object) -> None:
+        name = self.names.get(call_id, "tool")
+        self.add(
+            {
+                "role": "tool",
+                "tool_call_id": call_id,
+                "tool_name": name,
+                "content": _text_of(content),
+            }
+        )
+
+    # -- Claude Code ------------------------------------------------------------------------------
+
+    def claude(self, record: Mapping[str, object]) -> bool:
+        kind = record.get("type")
+        message = record.get("message")
+        if kind not in ("user", "assistant") or not isinstance(message, dict):
+            return False
+        body = cast(dict[str, object], message)
+        self.note(record)
+        content = body.get("content")
+        if isinstance(content, str):
+            (self.user_text if kind == "user" else self.assistant_text)(content)
+            return True
+        if not isinstance(content, list):
+            return True
+        texts: list[str] = []
+        for block in cast(list[object], content):
+            if not isinstance(block, dict):
+                continue
+            entry = cast(dict[str, object], block)
+            tag = entry.get("type")
+            if tag == "text" and isinstance(entry.get("text"), str):
+                texts.append(cast(str, entry["text"]))
+            elif tag == "tool_use":
+                self._flush(kind, texts)
+                self.tool_call(
+                    str(entry.get("id") or ""),
+                    str(entry.get("name") or "tool"),
+                    entry.get("input") or {},
+                )
+            elif tag == "tool_result":
+                self._flush(kind, texts)
+                self.tool_result(str(entry.get("tool_use_id") or ""), entry.get("content"))
+        self._flush(kind, texts)
+        return True
+
+    def _flush(self, kind: object, texts: list[str]) -> None:
+        if texts:
+            joined = "\n".join(texts)
+            (self.user_text if kind == "user" else self.assistant_text)(joined)
+            texts.clear()
+
+    # -- Codex ------------------------------------------------------------------------------------
+
+    def codex(self, record: Mapping[str, object]) -> bool:
+        kind = record.get("type")
+        payload = record.get("payload")
+        if kind == "session_meta" and isinstance(payload, dict):
+            self.note(cast(dict[str, object], payload))
+            self.note(record)
+            return True
+        item: Mapping[str, object]
+        if kind == "response_item" and isinstance(payload, dict):
+            item = cast(dict[str, object], payload)
+            self.note(record)
+        elif kind in ("message", "function_call", "function_call_output"):
+            item = record
+        else:
+            return kind in ("event_msg", "turn_context", "compacted") or (
+                kind is None and isinstance(record.get("instructions"), str)
+            )
+        tag = item.get("type")
+        if tag == "message":
+            text = _text_of(item.get("content"))
+            role = item.get("role")
+            if role == "user":
+                self.user_text(text)
+            elif role == "assistant":
+                self.assistant_text(text)
+            return True
+        if tag == "function_call":
+            self.tool_call(
+                str(item.get("call_id") or ""),
+                str(item.get("name") or "tool"),
+                item.get("arguments") or "{}",
+            )
+            return True
+        if tag == "function_call_output":
+            output = item.get("output")
+            if isinstance(output, dict):
+                output = cast(dict[str, object], output).get("content", "")
+            self.tool_result(str(item.get("call_id") or ""), output)
+            return True
+        return tag == "reasoning"
+
+
+def map_file(path: Path, kind: SourceKind, *, limit: int | None = None) -> Mapped:
+    """Map ``path`` read as ``kind``; ``limit`` caps the records read (the preview's cap)."""
+    mapper = _Mapper(kind)
+    read = 0
+    try:
+        handle = path.open("r", encoding="utf-8", errors="replace")
+    except OSError as exc:
+        raise ImportRefused("unreadable", f"The file could not be read ({exc.strerror}).") from None
+    with handle:
+        for line in handle:
+            if not line.strip():
+                continue
+            if limit is not None and read >= limit:
+                mapper.out.truncated = True
+                break
+            read += 1
+            try:
+                record: object = json.loads(line)
+            except ValueError:
+                mapper.out.skipped += 1
+                continue
+            if not isinstance(record, dict):
+                mapper.out.skipped += 1
+                continue
+            entry = cast(dict[str, object], record)
+            known = mapper.claude(entry) if kind == "claude-code" else mapper.codex(entry)
+            if known:
+                mapper.out.recognised += 1
+            else:
+                mapper.out.skipped += 1
+            if len(mapper.out.messages) >= MAX_MESSAGES:
+                mapper.out.truncated = True
+                break
+    return mapper.out
+
+
+def _recognised(mapped: Mapped) -> Mapped:
+    if mapped.recognised == 0:
+        raise ImportRefused(
+            "unknown_format",
+            "This file is not a Claude Code or Codex session in a format we know.",
+        )
+    return mapped
+
+
+def preview(path: Path, kind: SourceKind) -> Mapped:
+    """The mapped messages of the first ``PREVIEW_RECORDS`` records; nothing is written."""
+    return _recognised(map_file(path, kind, limit=PREVIEW_RECORDS))
+
+
+def _preview_row(row: Mapping[str, Any]) -> dict[str, Any]:
+    out: dict[str, Any] = {"role": row["role"], "content": row.get("content", "")}
+    calls = row.get("tool_calls")
+    if isinstance(calls, list) and calls:
+        first = cast(dict[str, Any], cast(list[object], calls)[0])
+        out["tool"] = cast(dict[str, Any], first["function"])["name"]
+    if row.get("tool_name"):
+        out["tool"] = row["tool_name"]
+    return out
+
+
+# -- import ----------------------------------------------------------------------------------------
+
+
+def _digest(path: Path) -> str:
+    sha = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1 << 20), b""):
+            sha.update(chunk)
+    return sha.hexdigest()
+
+
+def _already(conn: sqlite3.Connection, key: str) -> str | None:
+    row = conn.execute(
+        "SELECT session_id FROM session_meta WHERE namespace = ? AND key = ?",
+        (IMPORT_NAMESPACE, key),
+    ).fetchone()
+    return None if row is None else str(row["session_id"])
+
+
+def import_session(store: StoreHandle, path: Path, kind: SourceKind) -> Imported:
+    """Write the file as one new session of ``store``'s profile (refused when already imported)."""
+    mapped = _recognised(map_file(path, kind))
+    if not mapped.messages:
+        raise ImportRefused("empty", "The session has no messages to import.")
+    key = f"sha256:{_digest(path)}"
+    clock = store.scope.clock
+    now = clock.now().timestamp()
+    session_id = new_session_id(clock)
+    origin = {"source": kind, "file": path.name, "skipped": mapped.skipped}
+    rows: Sequence[dict[str, Any]] = mapped.messages
+
+    def write(conn: sqlite3.Connection) -> str:
+        existing = _already(conn, key)
+        if existing is not None:
+            return existing
+        fields: dict[str, Any] = {"profile_id": store.scope.profile_id}
+        if mapped.cwd:
+            fields["cwd"] = mapped.cwd
+        if mapped.started_at is not None:
+            fields["started_at"] = mapped.started_at
+        sessions.create_in(conn, session_id, f"import-{kind}", now=now, **fields)
+        messages.append_batch_in(conn, session_id, rows, now=now)
+        titles.set_title_in(
+            conn, session_id, titles.next_lineage_title_in(conn, mapped.title), source="derived"
+        )
+        session_meta.put_in(conn, session_id, IMPORT_NAMESPACE, key, origin, now=now)
+        return session_id
+
+    written = store.write(write, budget=TRANSCRIPT)
+    if written != session_id:
+        raise ImportRefused(
+            "already_imported", "This session was imported before.", session_id=written
+        )
+    return Imported(session_id, titles.get_title(store, session_id) or mapped.title, len(rows))
diff --git a/src/indus/service/voice_rpc.py b/src/indus/service/voice_rpc.py
new file mode 100644
index 0000000..3360554
--- /dev/null
+++ b/src/indus/service/voice_rpc.py
@@ -0,0 +1,129 @@
+"""``voice.*``: the daemon's speech methods for the desktop composer (P24-35, integration).
+
+``voice.transcribe`` writes the clip to a private file under ``<home>/cache/voice/``, runs the
+profile's speech-to-text provider on it (``tools.builtin.media.stt.transcribe``) and removes the
+file; ``voice.speak`` runs the text-to-speech provider (``tts.SpeechTool``), reads the audio back
+and removes the file. A provider that is missing, not set up or failing is ``PROVIDER_UNAVAILABLE``
+with the provider's own reason (never a key); a clip that is not base64 is ``INVALID_PARAMS``.
+Neither the clip nor the text is logged.
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import contextlib
+import secrets
+from collections.abc import Awaitable, Callable, Mapping
+from pathlib import Path
+from typing import Any, Protocol
+
+from indus.foundation.blocking import run_blocking
+from indus.foundation.fsio import atomic_write_bytes
+from indus.foundation.home import secure_dir
+from indus.foundation.scope import Scope
+from indus.protocol.base import ProtocolModel
+from indus.protocol.errors import INVALID_PARAMS, PROVIDER_UNAVAILABLE
+from indus.protocol.methods import ProtocolError
+from indus.protocol.voice import (
+    MAX_CLIP_BYTES,
+    VOICE_METHODS,
+    VoiceSpeakParams,
+    VoiceSpeakResult,
+    VoiceTranscribeParams,
+    VoiceTranscribeResult,
+)
+
+__all__ = ["VOICE_HANDLERS", "VOICE_METHODS", "register", "voice_speak", "voice_transcribe"]
+
+_SUFFIXES: Mapping[str, str] = {
+    "audio/webm": ".webm",
+    "audio/ogg": ".ogg",
+    "audio/wav": ".wav",
+    "audio/x-wav": ".wav",
+    "audio/wave": ".wav",
+    "audio/mpeg": ".mp3",
+    "audio/mp4": ".m4a",
+    "audio/aac": ".aac",
+    "audio/flac": ".flac",
+}
+_MIMES: Mapping[str, str] = {
+    ".mp3": "audio/mpeg",
+    ".ogg": "audio/ogg",
+    ".wav": "audio/wav",
+    ".aac": "audio/aac",
+    ".flac": "audio/flac",
+}
+
+
+class VoiceContext(Protocol):
+    @property
+    def scope(self) -> Scope: ...
+
+
+def _clip_dir(scope: Scope) -> Path:
+    return secure_dir(scope.home / "cache" / "voice", env=scope.env)
+
+
+async def voice_transcribe(
+    ctx: VoiceContext, params: VoiceTranscribeParams
+) -> VoiceTranscribeResult:
+    from indus.tools.builtin.media import stt
+
+    try:
+        clip = base64.b64decode(params.audio_b64, validate=True)
+    except (binascii.Error, ValueError):
+        raise ProtocolError(INVALID_PARAMS, "audio_b64 is not base64", path="audio_b64") from None
+    if not clip or len(clip) > MAX_CLIP_BYTES:
+        raise ProtocolError(INVALID_PARAMS, "the clip is empty or too large", path="audio_b64")
+    scope = ctx.scope
+    base = params.mime.split(";", 1)[0].strip().lower()
+    suffix = _SUFFIXES.get(base, ".bin")
+
+    def save() -> Path:
+        path = _clip_dir(scope) / f"clip-{secrets.token_hex(8)}{suffix}"
+        atomic_write_bytes(path, clip, mode=0o600)
+        return path
+
+    path = await run_blocking(save, label="voice clip")
+    try:
+        heard = await stt.transcribe(path, scope=scope)
+    except stt.SttError as exc:
+        raise ProtocolError(PROVIDER_UNAVAILABLE, str(exc)) from None
+    finally:
+        with contextlib.suppress(OSError):
+            path.unlink()
+    return VoiceTranscribeResult(text="" if heard.inaudible else heard.text)
+
+
+async def voice_speak(ctx: VoiceContext, params: VoiceSpeakParams) -> VoiceSpeakResult:
+    from indus.tools.builtin.media import tts
+
+    scope = ctx.scope
+    try:
+        made = await tts.SpeechTool().speak(params.text, scope)
+    except (tts.SpeechError, tts.OutputRefused, OSError) as exc:
+        raise ProtocolError(PROVIDER_UNAVAILABLE, str(exc)) from None
+
+    def take() -> bytes:
+        try:
+            return made.path.read_bytes()
+        finally:
+            with contextlib.suppress(OSError):
+                made.path.unlink()
+
+    audio = await run_blocking(take, label="voice read")
+    mime = _MIMES.get(made.path.suffix.lower(), "application/octet-stream")
+    return VoiceSpeakResult(audio_b64=base64.b64encode(audio).decode("ascii"), mime=mime)
+
+
+VOICE_HANDLERS: Mapping[str, Callable[[Any, Any], Awaitable[ProtocolModel]]] = {
+    "voice.transcribe": voice_transcribe,
+    "voice.speak": voice_speak,
+}
+
+
+def register(table: Any) -> None:
+    """Add the handlers to a ``MethodTable``."""
+    for name, handler in VOICE_HANDLERS.items():
+        table.add(name, handler)
diff --git a/src/indus/service/wake_rpc.py b/src/indus/service/wake_rpc.py
new file mode 100644
index 0000000..f132d30
--- /dev/null
+++ b/src/indus/service/wake_rpc.py
@@ -0,0 +1,192 @@
+"""``wake.*``: the wake-word methods the desktop and the TUI call (P24-20).
+
+``WAKE_METHODS`` (with the wire models, in ``indus.protocol.wake``, re-exported here) lists the
+catalogue rows; ``WakeRpc`` holds the process's ``WakeService`` and answers them, the caller's
+connection context being the lease owner. ``register(table)`` adds the handlers to a dispatcher
+table (the daemon's WebSocket and the TUI bridge);
+``WAKE_DEADLINES`` gives ``wake.start`` its 180 s (a first start may load a model). A detection
+reaches the owner as a ``wake.detected`` event (``WakeDetected``) through ``emit``; the surface then
+starts its own voice capture (P10), and calls ``wake.resume`` when it is done.
+
+Consent: ``wake.start`` with ``consent: true`` — sent only from an explicit gesture (the Settings
+toggle, ``/wake on``) — writes ``wake_word.consent`` and ``wake_word.enabled``; every other start
+(an auto-arm at launch) uses what is stored and never opens the microphone without both.
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import threading
+from collections.abc import Awaitable, Callable, Mapping
+from typing import Any, Protocol, cast
+
+from indus.foundation import config
+from indus.foundation.blocking import run_blocking
+from indus.foundation.scope import Scope
+from indus.protocol.base import ProtocolModel
+from indus.protocol.errors import INVALID_PARAMS
+from indus.protocol.methods import ProtocolError
+from indus.protocol.wake import (
+    SAMPLE_RATE,
+    WAKE_DEADLINES,
+    WAKE_DETECTED_EVENT,
+    WAKE_METHODS,
+    WakeDetected,
+    WakeFeedParams,
+    WakeFeedResult,
+    WakeNoParams,
+    WakeOwnerResult,
+    WakeStartParams,
+    WakeStartResult,
+    WakeStatusResult,
+    WakeStopParams,
+)
+from indus.tools.builtin.media.wake_word import (
+    WakeError,
+    WakeService,
+    WakeSettings,
+    check_requirements,
+)
+
+__all__ = [
+    "WAKE_DEADLINES",
+    "WAKE_DETECTED_EVENT",
+    "WAKE_METHODS",
+    "WakeContext",
+    "WakeDetected",
+    "WakeFeedParams",
+    "WakeRpc",
+    "WakeStartParams",
+    "WakeStartResult",
+    "WakeStatusResult",
+    "WakeStopParams",
+    "settings_for",
+]
+
+
+class WakeContext(Protocol):
+    @property
+    def scope(self) -> Scope: ...
+
+
+def settings_for(scope: Scope) -> WakeSettings:
+    raw: object = config.load(scope).get("wake_word", {})
+    return WakeSettings.from_mapping(
+        cast(Mapping[str, Any], raw) if isinstance(raw, Mapping) else {}
+    )
+
+
+class WakeRpc:
+    """The ``wake.*`` handlers over one ``WakeService`` per process."""
+
+    def __init__(
+        self,
+        scope: Scope,
+        *,
+        emit: Callable[[object, str, ProtocolModel], None],
+        service: WakeService | None = None,
+    ) -> None:
+        self.scope = scope
+        self._emit = emit
+        self._surfaces: dict[int, str] = {}
+        self._lock = threading.Lock()
+        self.service = service or WakeService(lambda: settings_for(scope), on_detect=self._detected)
+
+    def _detected(self, owner: object, phrase: str) -> None:
+        with self._lock:
+            surface = self._surfaces.get(id(owner), "")
+        self._emit(owner, WAKE_DETECTED_EVENT, WakeDetected(phrase=phrase, surface=surface))
+
+    async def start(self, ctx: WakeContext, params: WakeStartParams) -> WakeStartResult:
+        settings = settings_for(ctx.scope)
+        saved = False
+        if params.consent:
+            available, hint = check_requirements(settings)
+            if not available:
+                # an "on" that cannot arm stores nothing: settings never say on while nothing runs
+                return WakeStartResult(
+                    started=False, reason="unavailable", hint=hint, phrase=settings.phrase
+                )
+            if not (settings.consent and settings.enabled):
+                await run_blocking(
+                    config.save, ctx.scope, {"wake_word": {"consent": True, "enabled": True}}
+                )
+                saved = True
+        with self._lock:
+            self._surfaces[id(ctx)] = params.surface
+        outcome = await run_blocking(
+            lambda: self.service.start(ctx, params.surface, client_capture=params.client_capture),
+            label="wake start",
+        )
+        return WakeStartResult(
+            started=outcome.started,
+            reason=outcome.reason,
+            hint=outcome.hint or None,
+            phrase=outcome.phrase,
+            engine=outcome.engine or None,
+            capture=outcome.capture if outcome.started else None,
+            consent_saved=True if saved else None,
+        )
+
+    async def stop(self, ctx: WakeContext, params: WakeStopParams) -> WakeOwnerResult:
+        stopped = await run_blocking(self.service.stop, ctx)
+        if params.persist:
+            await run_blocking(config.save, ctx.scope, {"wake_word": {"enabled": False}})
+        return WakeOwnerResult(ok=stopped, reason=None if stopped else "not_owner")
+
+    async def pause(self, ctx: WakeContext, params: WakeNoParams) -> WakeOwnerResult:
+        done = await run_blocking(self.service.pause, ctx)
+        return WakeOwnerResult(ok=done, reason=None if done else "not_owner")
+
+    async def resume(self, ctx: WakeContext, params: WakeNoParams) -> WakeOwnerResult:
+        done = await run_blocking(self.service.resume, ctx)
+        return WakeOwnerResult(ok=done, reason=None if done else "not_owner")
+
+    async def status(self, ctx: WakeContext, params: WakeNoParams) -> WakeStatusResult:
+        settings = settings_for(ctx.scope)
+        available, hint = check_requirements(settings)
+        return WakeStatusResult(
+            enabled=settings.enabled,
+            consent=settings.consent,
+            listening=self.service.listening(ctx),
+            owner_surface=self.service.owner_surface(),
+            phrase=settings.phrase,
+            engine=settings.engine,
+            available=available,
+            hint=hint or None,
+        )
+
+    async def feed(self, ctx: WakeContext, params: WakeFeedParams) -> WakeFeedResult:
+        if params.sample_rate != SAMPLE_RATE:
+            raise ProtocolError(INVALID_PARAMS, "wake.feed takes 16 kHz audio only")
+        try:
+            pcm = base64.b64decode(params.pcm, validate=True)
+        except (binascii.Error, ValueError):
+            raise ProtocolError(INVALID_PARAMS, "pcm is not base64") from None
+        try:
+            fed = await run_blocking(self.service.feed, ctx, pcm)
+        except WakeError as exc:
+            raise ProtocolError(INVALID_PARAMS, str(exc)) from None
+        return WakeFeedResult(fed=fed)
+
+    def connection_closed(self, ctx: object) -> None:
+        """Release the lease of a connection that went away."""
+        self.service.release_owner(ctx)
+        with self._lock:
+            self._surfaces.pop(id(ctx), None)
+
+    def handlers(self) -> Mapping[str, Callable[[Any, Any], Awaitable[ProtocolModel]]]:
+        return {
+            "wake.start": self.start,
+            "wake.stop": self.stop,
+            "wake.pause": self.pause,
+            "wake.resume": self.resume,
+            "wake.status": self.status,
+            "wake.feed": self.feed,
+        }
+
+    def register(self, table: Any) -> None:
+        """Add every handler to a ``MethodTable`` (the names must be in the method catalogue)."""
+        for name, handler in self.handlers().items():
+            table.add(name, handler)
