+  const [busy, setBusy] = useState(false);
+  const [note, setNote] = useState<{ answer: RestAnswer<unknown>; ok?: string } | null>(null);
+
+  useEffect(() => {
+    if (props.pendingInstall) setConfirming(props.pendingInstall);
