+def test_exit_reason_reads_the_last_error_line_only(tmp_path: Path) -> None:
+    log = tmp_path / "sidecar.log"
+    log.write_text('{"event":"listening","port":1}\nnot json\n{"event":"error","error":"listen"}\n')
+    assert exit_reason(log) == "listen"
