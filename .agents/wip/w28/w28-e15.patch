+// The sidecar's loopback HTTP API (routes and error codes in docs/notes/P16/photon.md).
+//
+// Every request is checked in this order: the Host header names a loopback host (no DNS rebinding
+// from a browser page), the bearer token matches (constant time), then the route. Bodies are JSON,
+// at most 64 KiB, refused before parsing when larger. `GET /events` is a long-lived NDJSON stream:
+// the kept events after the caller's cursor, then live ones, with an empty heartbeat line.
+
+import { createHash, timingSafeEqual } from "node:crypto";
+import { lstat } from "node:fs/promises";
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from "node:http";
+import { isAbsolute } from "node:path";
+import type { LinkErrorCode, SpectrumLink } from "./link.ts";
+import { LinkError } from "./link.ts";
+import { MAX_MEDIA_BYTES, type Relay, type SidecarEvent } from "./relay.ts";
+
+export const LOOPBACK_HOSTS: ReadonlySet<string> = new Set(["127.0.0.1", "::1", "localhost"]);
+export const MAX_BODY_BYTES = 64 * 1024;
+export const HEARTBEAT_MS = 15_000;
+const MAX_SPACE = 256;
+const ROUTES: ReadonlySet<string> = new Set([
+  "/health",
+  "/events",
+  "/media",
+  "/send",
+  "/send-link",
+  "/send-file",
+  "/typing",
+  "/react",
+  "/unreact",
+  "/read",
+]);
+
+const STATUS: Record<LinkErrorCode, number> = {
+  bad_request: 400,
+  forbidden: 403,
+  target_not_allowed: 403,
+  auth_failed: 403,
+  space_not_found: 404,
+  message_not_found: 404,
+  too_large: 413,
+  rate_limited: 429,
+  failed: 502,
+  not_connected: 503,
+  timeout: 504,
+};
+
+export function isLoopbackHost(host: string): boolean {
+  return LOOPBACK_HOSTS.has(
+    host
+      .trim()
+      .toLowerCase()
+      .replace(/^\[|\]$/g, ""),
+  );
+}
+
+/** Constant-time token check: both sides hashed first, so neither length nor content leaks. */
+export function tokenMatches(given: string, expected: string): boolean {
+  const a = createHash("sha256").update(given, "utf8").digest();
+  const b = createHash("sha256").update(expected, "utf8").digest();
+  return timingSafeEqual(a, b) && expected.length > 0;
+}
+
+export interface ServerOptions {
+  token: string;
+  profile: string;
+  relay: Relay;
+  /** The provider's link once it exists (null while connecting). */
+  link: () => SpectrumLink | null;
+  version?: string;
+  compare?: (given: string, expected: string) => boolean;
+  heartbeatMs?: number;
+}
+
+class HttpError extends Error {
+  readonly status: number;
+  readonly code: string;
+  readonly headers: Record<string, string>;
+
+  constructor(status: number, code: string, headers: Record<string, string> = {}) {
+    super(code);
+    this.status = status;
+    this.code = code;
+    this.headers = headers;
+  }
+}
+
+type Body = Record<string, unknown>;
+
+function hostOnly(header: string | undefined): string {
+  const raw = (header ?? "").trim();
+  if (raw.startsWith("[")) {
+    const end = raw.indexOf("]");
+    return raw.slice(1, end < 0 ? undefined : end);
+  }
+  const colon = raw.lastIndexOf(":");
+  return colon < 0 ? raw : raw.slice(0, colon);
+}
+
+function reply(
+  res: ServerResponse,
+  status: number,
+  body: unknown,
+  headers: Record<string, string> = {},
+): void {
+  const text = JSON.stringify(body);
+  res.writeHead(status, {
+    "content-type": "application/json; charset=utf-8",
+    "content-length": Buffer.byteLength(text),
+    "cache-control": "no-store",
+    "x-content-type-options": "nosniff",
+    ...headers,
+  });
+  res.end(text);
+}
+
+async function readJson(req: IncomingMessage): Promise<Body> {
+  const declared = Number(req.headers["content-length"] ?? "0");
+  if (Number.isFinite(declared) && declared > MAX_BODY_BYTES) throw new HttpError(413, "too_large");
+  const chunks: Buffer[] = [];
+  let total = 0;
+  for await (const chunk of req) {
+    const piece = chunk as Buffer;
+    total += piece.byteLength;
+    if (total > MAX_BODY_BYTES) throw new HttpError(413, "too_large");
+    chunks.push(piece);
+  }
+  try {
+    const parsed: unknown = JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
+    if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) throw new Error();
+    return parsed as Body;
+  } catch {
+    throw new HttpError(400, "bad_request");
+  }
+}
+
+function field(body: Body, name: string, { required = true } = {}): string {
+  const value = body[name];
+  if (value === undefined || value === null || value === "") {
+    if (required) throw new HttpError(400, "bad_request");
+    return "";
+  }
+  if (typeof value !== "string") throw new HttpError(400, "bad_request");
+  return value;
+}
+
+function spaceOf(body: Body): string {
+  const space = field(body, "space");
+  // biome-ignore lint/suspicious/noControlCharactersInRegex: control characters are what we refuse
+  if (space.length > MAX_SPACE || /[\u0000-\u001f\u007f]/.test(space)) {
+    throw new HttpError(400, "bad_request");
+  }
+  return space;
+}
+
+function httpUrl(text: string): string {
+  let url: URL;
+  try {
+    url = new URL(text);
+  } catch {
+    throw new HttpError(400, "bad_request");
+  }
+  if ((url.protocol !== "http:" && url.protocol !== "https:") || !url.hostname) {
+    throw new HttpError(400, "bad_request");
+  }
+  return text;
+}
+
+/** A file we may send: absolute, a regular file (never a symlink), at most 100 MiB. */
+async function sendablePath(path: string): Promise<string> {
+  if (!isAbsolute(path)) throw new HttpError(400, "bad_request");
+  let info: Awaited<ReturnType<typeof lstat>>;
+  try {
+    info = await lstat(path);
+  } catch {
+    throw new HttpError(400, "bad_request");
+  }
+  if (!info.isFile()) throw new HttpError(403, "forbidden");
+  if (info.size > MAX_MEDIA_BYTES) throw new HttpError(413, "too_large");
+  return path;
+}
+
+export function createSidecarServer(options: ServerOptions): Server {
+  const compare = options.compare ?? tokenMatches;
+  const heartbeat = options.heartbeatMs ?? HEARTBEAT_MS;
+  const relay = options.relay;
+
+  const ready = (): SpectrumLink => {
+    const link = options.link();
+    if (relay.status === "auth_failed") throw new LinkError("auth_failed");
+    if (link === null || (relay.status !== "open" && relay.status !== "degraded")) {
+      throw new LinkError("not_connected");
+    }
+    return link;
+  };
+
+  const stream = (res: ServerResponse, url: URL): void => {
+    const after = Number(url.searchParams.get("after") ?? "0");
+    const backlog = relay.after(
+      Number.isInteger(after) && after >= 0 ? after : 0,
+      url.searchParams.get("epoch") ?? "",
+    );
+    res.writeHead(200, {
+      "content-type": "application/x-ndjson; charset=utf-8",
+      "cache-control": "no-store",
+      "x-content-type-options": "nosniff",
+      "x-photon-epoch": relay.epoch,
+    });
+    const write = (event: SidecarEvent): void => {
+      res.write(`${JSON.stringify(event)}\n`);
+    };
+    for (const event of backlog) write(event);
+    const last = backlog.at(-1)?.seq ?? 0;
+    const stop = relay.subscribe((event) => {
+      if (event.seq > last) write(event);
+    });
+    const beat = setInterval(() => res.write("\n"), heartbeat);
+    res.on("close", () => {
+      clearInterval(beat);
+      stop();
+    });
+  };
+
+  const route = async (req: IncomingMessage, res: ServerResponse, url: URL): Promise<void> => {
+    switch (`${req.method ?? ""} ${url.pathname}`) {
+      case "GET /health":
+        return reply(res, 200, {
+          status: relay.status,
+          profile: options.profile,
+          epoch: relay.epoch,
+          version: options.version ?? "0",
+          kept: relay.kept,
+          link: { state: relay.status, since: relay.since, detail: relay.detail },
+        });
+      case "GET /events":
+        return stream(res, url);
+      case "GET /media": {
+        const ref = url.searchParams.get("ref") ?? "";
+        if (!/^[0-9a-f]{24}$/.test(ref)) throw new HttpError(400, "bad_request");
+        const data = await relay.readMedia(ref);
+        res.writeHead(200, {
+          "content-type": "application/octet-stream",
+          "content-length": data.byteLength,
+          "cache-control": "no-store",
+          "x-content-type-options": "nosniff",
+        });
+        res.end(data);
+        return;
+      }
+      case "POST /send": {
+        const body = await readJson(req);
+        const space = spaceOf(body);
+        const text = field(body, "text");
+        const format = field(body, "format", { required: false }) || "markdown";
+        if (format !== "markdown" && format !== "plain") throw new HttpError(400, "bad_request");
+        return reply(res, 200, { id: await ready().sendText(space, text, format) });
+      }
+      case "POST /send-link": {
+        const body = await readJson(req);
+        const space = spaceOf(body);
+        const url = httpUrl(field(body, "url"));
+        return reply(res, 200, { id: await ready().sendLink(space, url) });
+      }
+      case "POST /send-file": {
+        const body = await readJson(req);
+        const space = spaceOf(body);
+        const path = await sendablePath(field(body, "path"));
+        const name = field(body, "name", { required: false });
+        const mime = field(body, "mime", { required: false });
+        const id = await ready().sendFile(space, {
+          path,
+          voice: body.voice === true,
+          ...(name ? { name } : {}),
+          ...(mime ? { mime } : {}),
+        });
+        return reply(res, 200, { id });
+      }
+      case "POST /typing": {
+        const body = await readJson(req);
+        await ready().typing(spaceOf(body), body.on !== false);
+        return reply(res, 200, { ok: true });
+      }
+      case "POST /react": {
+        const body = await readJson(req);
+        const emoji = field(body, "emoji");
+        if (emoji.length > 16) throw new HttpError(400, "bad_request");
+        await ready().react(spaceOf(body), field(body, "id"), emoji);
+        return reply(res, 200, { ok: true });
+      }
+      case "POST /unreact": {
+        const body = await readJson(req);
+        await ready().unreact(spaceOf(body), field(body, "id"));
+        return reply(res, 200, { ok: true });
+      }
+      case "POST /read": {
+        const body = await readJson(req);
+        await ready().markRead(spaceOf(body), field(body, "id"));
+        return reply(res, 200, { ok: true });
+      }
+      default:
+        throw ROUTES.has(url.pathname)
+          ? new HttpError(405, "method_not_allowed")
+          : new HttpError(404, "not_found");
+    }
+  };
+
+  return createServer((req, res) => {
+    const reject = (error: HttpError): void => {
+      req.resume();
+      reply(res, error.status, { error: error.code }, error.headers);
+    };
+    if (!isLoopbackHost(hostOnly(req.headers.host))) {
+      reject(new HttpError(400, "bad_host"));
+      return;
+    }
+    const auth = req.headers.authorization ?? "";
+    const given = auth.startsWith("Bearer ") ? auth.slice(7) : "";
+    if (!compare(given, options.token)) {
+      reject(new HttpError(401, "unauthorized", { "www-authenticate": "Bearer" }));
+      return;
+    }
+    const url = new URL(req.url ?? "/", "http://127.0.0.1");
+    route(req, res, url).catch((error: unknown) => {
+      if (res.headersSent) {
+        res.destroy();
+        return;
+      }
+      if (error instanceof HttpError) {
+        reject(error);
+        return;
+      }
+      const failure = error instanceof LinkError ? error : new LinkError("failed");
+      const headers: Record<string, string> = {};
+      if (failure.code === "rate_limited") {
+        headers["retry-after"] = String(Math.ceil(failure.retryAfter ?? 30));
+      }
+      if (
+        failure.code === "not_connected" &&
+        (relay.status === "connecting" || relay.status === "starting")
+      ) {
+        headers["retry-after"] = "5";
+      }
+      reject(new HttpError(STATUS[failure.code], failure.code, headers));
+    });
+  });
+}
+
+/** Bind on a loopback host only; anything else is refused before a socket is opened. */
+export function listen(server: Server, host: string, port: number): Promise<number> {
+  if (!isLoopbackHost(host)) {
+    return Promise.reject(new Error("the sidecar binds loopback addresses only"));
+  }
+  return new Promise((resolve, reject) => {
+    const onError = (error: Error): void => reject(error);
+    server.once("error", onError);
+    server.listen(port, host === "localhost" ? "127.0.0.1" : host, () => {
+      server.off("error", onError);
+      const address = server.address();
+      resolve(typeof address === "object" && address !== null ? address.port : port);
+    });
+  });
+}
diff --git a/apps/photon-sidecar/src/link.ts b/apps/photon-sidecar/src/link.ts
new file mode 100644
index 0000000..ae50d14
--- /dev/null
+++ b/apps/photon-sidecar/src/link.ts
@@ -0,0 +1,142 @@
+// The one seam between the sidecar and a Photon Spectrum client.
+//
+// Everything else in the sidecar talks to `SpectrumLink`. No Spectrum package ships with this
+// workspace (its licences and availability are not cleared; docs/notes/P16/photon.md): the operator
+// supplies a module that exports `createSpectrumLink` (a `LinkProvider`) and names it with
+// INDUS_PHOTON_PROVIDER (an absolute module path or a package name). Without one the sidecar refuses
+// to start (main.ts).
+
+import { isAbsolute } from "node:path";
+import { pathToFileURL } from "node:url";
+
+/** The upstream connection as the provider sees it. */
+export type LinkState = "connecting" | "open" | "degraded" | "auth_failed" | "closed";
+
+export interface RawSpace {
+  id: string;
+  type: "dm" | "group";
+  name?: string;
+}
+
+export interface RawPerson {
+  id: string;
+  name?: string;
+}
+
+export interface RawFile {
+  type: "file";
+  name: string;
+  mime: string;
+  size: number | null;
+  /** An iMessage voice note rather than an audio file. */
+  voice: boolean;
+  read(): Promise<Uint8Array>;
+}
+
+export type RawContent =
+  | { type: "text"; text: string }
+  | RawFile
+  | { type: "link"; url: string; title?: string; summary?: string }
+  | { type: "group"; items: RawContent[] }
+  | { type: "reaction"; target: string; emoji: string; targetFromUs: boolean; targetText?: string }
+  | { type: "receipt"; target: string }
+  | { type: "other"; name: string };
+
+/** One message as the provider delivered it (the provider may deliver one more than once). */
+export interface RawMessage {
+  id: string;
+  space: RawSpace;
+  sender: RawPerson;
+  /** Sent by this line (an echo of our own send). */
+  fromUs: boolean;
+  /** Milliseconds since the epoch. */
+  at: number;
+  content: RawContent;
+  replyTo: { id: string; text?: string; fromUs?: boolean } | null;
+}
+
+export interface LinkHandlers {
+  onState(state: LinkState, detail?: string): void;
+  onMessage(message: RawMessage): void;
+}
+
+export interface LinkOptions {
+  projectId: string;
+  projectSecret: string;
+  handlers: LinkHandlers;
+}
+
+export interface OutboundFile {
+  path: string;
+  voice: boolean;
+  name?: string;
+  mime?: string;
+}
+
+export interface SpectrumLink {
+  /** Each send returns the new message's id. */
+  sendText(space: string, text: string, format: "markdown" | "plain"): Promise<string>;
+  sendLink(space: string, url: string): Promise<string>;
+  sendFile(space: string, file: OutboundFile): Promise<string>;
+  typing(space: string, on: boolean): Promise<void>;
+  react(space: string, messageId: string, emoji: string): Promise<void>;
+  unreact(space: string, messageId: string): Promise<void>;
+  markRead(space: string, messageId: string): Promise<void>;
+  close(): Promise<void>;
+}
+
+export type LinkProvider = (options: LinkOptions) => Promise<SpectrumLink>;
+
+export type LinkErrorCode =
+  | "not_connected"
+  | "space_not_found"
+  | "message_not_found"
+  | "forbidden"
+  | "target_not_allowed"
+  | "auth_failed"
+  | "rate_limited"
+  | "too_large"
+  | "timeout"
+  | "bad_request"
+  | "failed";
+
+/** A provider failure with our code; `detail` never holds message text, a number or a secret. */
+export class LinkError extends Error {
+  readonly code: LinkErrorCode;
+  readonly retryAfter: number | null;
+
+  constructor(code: LinkErrorCode, detail = "", retryAfter: number | null = null) {
+    super(detail || code);
+    this.name = "LinkError";
+    this.code = code;
+    this.retryAfter = retryAfter;
+  }
+}
+
+// -- loading -----------------------------------------------------------------------------------
+
+/** No provider was named: the sidecar has nothing to reach Photon with. */
+export class ProviderMissing extends Error {
+  constructor() {
+    super("no Photon provider is configured (INDUS_PHOTON_PROVIDER)");
+    this.name = "ProviderMissing";
+  }
+}
+
+/** The module URL or name to import for `spec`. */
+export function resolveProvider(spec: string): string {
+  const text = spec.trim();
+  if (!text) throw new ProviderMissing();
+  return isAbsolute(text) ? pathToFileURL(text).href : text;
+}
+
+export function providerFrom(loaded: Record<string, unknown>): LinkProvider {
+  const make = loaded.createSpectrumLink;
+  if (typeof make === "function") return make as LinkProvider;
+  throw new Error("the provider module does not export createSpectrumLink");
+}
+
+export async function loadProvider(spec: string): Promise<LinkProvider> {
+  const loaded = (await import(resolveProvider(spec))) as Record<string, unknown>;
+  return providerFrom(loaded);
+}
diff --git a/apps/photon-sidecar/src/main.test.ts b/apps/photon-sidecar/src/main.test.ts
new file mode 100644
index 0000000..ac044e9
--- /dev/null
+++ b/apps/photon-sidecar/src/main.test.ts
@@ -0,0 +1,212 @@
+import { spawn } from "node:child_process";
+import { readFileSync } from "node:fs";
+import { request } from "node:http";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it } from "vitest";
+import { LinkError } from "./link.ts";
+import { alive, DEFAULT_PORT, readConfig, run } from "./main.ts";
+import { FakePhoton } from "./testing/fakeLink.ts";
+
+const TOKEN = "q".repeat(40);
+const HERE = fileURLToPath(new URL(".", import.meta.url));
+// Built at run time: never a credential-shaped literal in the tree.
+const SECRET = ["fake", "project", "secret"].join("-");
+
+function env(extra: Record<string, string> = {}): Record<string, string> {
+  return {
+    INDUS_PHOTON_TOKEN: TOKEN,
+    INDUS_PHOTON_PORT: "0",
+    INDUS_PHOTON_PROFILE: "work",
+    PHOTON_PROJECT_ID: "project-1",
+    PHOTON_PROJECT_SECRET: SECRET,
+    ...extra,
+  };
+}
+
+/** Gone, or a zombie nobody reaped yet (an orphan's parent in a container may never reap). */
+function finished(pid: number): boolean {
+  if (!alive(pid)) return true;
+  try {
+    const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
+    return stat.slice(stat.lastIndexOf(")") + 2).startsWith("Z");
+  } catch {
+    return true;
+  }
+}
+
+function health(port: number): Promise<Record<string, unknown>> {
+  return new Promise((resolve, reject) => {
+    const req = request(
+      { host: "127.0.0.1", port, path: "/health", headers: { authorization: `Bearer ${TOKEN}` } },
+      (res) => {
+        let text = "";
+        res.setEncoding("utf8");
+        res.on("data", (c: string) => {
+          text += c;
+        });
+        res.on("end", () => resolve(JSON.parse(text) as Record<string, unknown>));
+      },
+    );
+    req.on("error", reject);
+    req.end();
+  });
+}
+
+const events = (lines: string[]): unknown[] => lines.map((l) => JSON.parse(l) as unknown);
+
+describe("settings", () => {
+  it("refuses a short token, a bad port and a non-loopback host; defaults to 8789", () => {
+    expect(readConfig(env({ INDUS_PHOTON_TOKEN: "short" }))).toEqual({ error: "token" });
+    expect(readConfig(env({ INDUS_PHOTON_PORT: "70000" }))).toEqual({ error: "port" });
+    expect(readConfig(env({ INDUS_PHOTON_HOST: "0.0.0.0" }))).toEqual({ error: "host" });
+    const { INDUS_PHOTON_PORT: _, ...rest } = env();
+    expect(readConfig(rest)).toMatchObject({ port: DEFAULT_PORT, host: "127.0.0.1" });
+  });
+
+  it("exits 2 on a non-loopback host before binding anything", async () => {
+    const lines: string[] = [];
+    const code = await run(env({ INDUS_PHOTON_HOST: "192.0.2.1" }), {
+      out: (l) => lines.push(l),
+      provider: new FakePhoton().provider,
+    });
+    expect(code).toBe(2);
+    expect(events(lines)).toEqual([{ event: "error", error: "bad_host" }]);
+  });
+
+  it("fails closed when no provider is configured or it cannot be loaded", async () => {
+    const lines: string[] = [];
+    expect(await run(env(), { out: (l) => lines.push(l) })).toBe(2);
+    expect(events(lines)).toEqual([{ event: "error", error: "no_provider" }]);
+    const other: string[] = [];
+    const missing = `${HERE}missing-provider.mjs`;
+    expect(await run(env({ INDUS_PHOTON_PROVIDER: missing }), { out: (l) => other.push(l) })).toBe(
+      2,
+    );
+    expect(events(other)).toEqual([{ event: "error", error: "provider" }]);
+  });
+
+  it("exits 2 without the project credentials and never prints the secret", async () => {
+    const lines: string[] = [];
+    const code = await run(env({ PHOTON_PROJECT_ID: "" }), {
+      out: (l) => lines.push(l),
+      provider: new FakePhoton().provider,
+    });
+    expect(code).toBe(2);
+    expect(events(lines)).toEqual([{ event: "error", error: "credentials" }]);
+    expect(lines.join("\n")).not.toContain(SECRET);
+  });
+});
+
+describe("running", () => {
+  it("serves, opens the link with the credentials and stops on its stop signal", async () => {
+    const photon = new FakePhoton();
+    let stop: () => void = () => {};
+    const lines: string[] = [];
+    let port = 0;
+    let seen: Record<string, unknown> = {};
+    const running = run(env(), {
+      out: (l) => {
+        lines.push(l);
+        const event = JSON.parse(l) as { event: string; port?: number; state?: string };
+        if (event.event === "listening") port = event.port ?? 0;
+        if (event.state === "open") {
+          void health(port).then((body) => {
+            seen = body;
+            stop();
+          });
+        }
+      },
+      provider: photon.provider,
+      stopSignal: new Promise((resolve) => {
+        stop = resolve;
+      }),
+    });
+    expect(await running).toBe(0);
+    expect(seen).toMatchObject({ status: "open", profile: "work" });
+    expect(photon.opened.map((o) => [o.projectId, o.projectSecret])).toEqual([
+      ["project-1", SECRET],
+    ]);
+    expect(photon.closes).toBe(1);
+    expect(events(lines)).toEqual([
+      { event: "listening", port },
+      { event: "link", state: "connecting" },
+      { event: "link", state: "open" },
+    ]);
+    expect(lines.join("\n")).not.toContain(SECRET);
+    expect(lines.join("\n")).not.toContain(TOKEN);
+  });
+
+  it("retries a failing link with a growing wait and stops retrying refused credentials", async () => {
+    const photon = new FakePhoton();
+    photon.refusals.push(new Error("down"), new Error("down"), new LinkError("auth_failed"));
+    let stop: () => void = () => {};
+    const states: string[] = [];
+    const running = run(env(), {
+      out: (l) => {
+        const event = JSON.parse(l) as { state?: string };
+        if (event.state) states.push(event.state);
+        if (event.state === "auth_failed") setTimeout(() => stop(), 60);
+      },
+      provider: photon.provider,
+      retryFirstMs: 5,
+      stopSignal: new Promise((resolve) => {
+        stop = resolve;
+      }),
+    });
+    expect(await running).toBe(0);
+    expect(photon.opened).toHaveLength(3);
+    expect(states).toEqual([
+      "connecting",
+      "closed",
+      "connecting",
+      "closed",
+      "connecting",
+      "auth_failed",
+    ]);
+  });
+});
+
+describe("parent watch", () => {
+  it("exits within 2 s of its parent's death", async () => {
+    const main = `${HERE}main.ts`;
+    const fake = `${HERE}testing/fakeLink.ts`;
+    // A parent process that starts the sidecar (pointing it at itself) and then just waits.
+    const script = [
+      "const { spawn } = require('node:child_process');",
+      `const child = spawn(process.execPath, [${JSON.stringify(main)}], {`,
+      "  stdio: ['ignore', 'inherit', 'inherit'],",
+      `  env: { ...JSON.parse(process.env.SIDECAR_ENV), INDUS_PHOTON_PARENT_PID: String(process.pid), INDUS_PHOTON_PROVIDER: ${JSON.stringify(fake)} },`,
+      "});",
+      "process.stdout.write(JSON.stringify({ child: child.pid }) + '\\n');",
+      "setInterval(() => {}, 1000);",
+    ].join("\n");
+    const parent = spawn(process.execPath, ["-e", script], {
+      stdio: ["ignore", "pipe", "inherit"],
+      env: { PATH: process.env.PATH ?? "", SIDECAR_ENV: JSON.stringify(env()) },
+    });
+    let childPid = 0;
+    let output = "";
+    await new Promise<void>((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error(`sidecar did not start: ${output}`)), 15_000);
+      parent.stdout?.on("data", (chunk: Buffer) => {
+        output += chunk.toString("utf8");
+        const found = /"child":(\d+)/.exec(output);
+        if (found) childPid = Number(found[1]);
+        if (childPid && output.includes('"open"')) {
+          clearTimeout(timer);
+          resolve();
+        }
+      });
+    });
+    expect(alive(childPid)).toBe(true);
+    parent.kill("SIGKILL");
+    const killedAt = Date.now();
+    while (!finished(childPid) && Date.now() - killedAt < 5000) {
+      await new Promise((resolve) => setTimeout(resolve, 50));
+    }
+    const took = Date.now() - killedAt;
+    if (!finished(childPid)) process.kill(childPid, "SIGKILL");
+    expect(took).toBeLessThan(2000);
+    expect(output).not.toContain(SECRET);
+  }, 30_000);
+});
diff --git a/apps/photon-sidecar/src/main.ts b/apps/photon-sidecar/src/main.ts
new file mode 100644
index 0000000..df9fc44
--- /dev/null
+++ b/apps/photon-sidecar/src/main.ts
@@ -0,0 +1,208 @@
+// Entry point of the Photon sidecar. Settings come from the environment the Python adapter builds
+// (never argv, so neither the token nor the project secret shows in a process list); lifecycle
+// events go to stdout as one JSON object per line, never with message text, a number or a secret.
+// Exit codes: 0 stopped (signal, parent gone), 1 failed at run time, 2 bad settings (nothing bound).
+
+import { pathToFileURL } from "node:url";
+import { createSidecarServer, isLoopbackHost, listen } from "./http.ts";
+import {
+  LinkError,
+  type LinkProvider,
+  type LinkState,
+  loadProvider,
+  ProviderMissing,
+  type SpectrumLink,
+} from "./link.ts";
+import { Relay } from "./relay.ts";
+
+export const VERSION = "1";
+export const DEFAULT_PORT = 8789;
+const MIN_TOKEN = 32;
+const PARENT_CHECK_MS = 500;
+const RETRY_FIRST_MS = 1000;
+const RETRY_MAX_MS = 30_000;
+
+export interface SidecarConfig {
+  token: string;
+  host: string;
+  port: number;
+  profile: string;
+  parentPid: number | null;
+  provider: string;
+  projectId: string;
+  projectSecret: string;
+}
+
+export type Env = Readonly<Record<string, string | undefined>>;
+
+/** The settings, or the name of the first bad one. */
+export function readConfig(env: Env): SidecarConfig | { error: string } {
+  const token = env.INDUS_PHOTON_TOKEN ?? "";
+  if (token.length < MIN_TOKEN) return { error: "token" };
+  const host = (env.INDUS_PHOTON_HOST ?? "127.0.0.1").trim();
+  if (!isLoopbackHost(host)) return { error: "host" };
+  const port = Number(env.INDUS_PHOTON_PORT ?? String(DEFAULT_PORT));
+  if (!Number.isInteger(port) || port < 0 || port > 65535) return { error: "port" };
+  const parent = Number(env.INDUS_PHOTON_PARENT_PID ?? "");
+  return {
+    token,
+    host,
+    port,
+    profile: env.INDUS_PHOTON_PROFILE ?? "",
+    parentPid: Number.isInteger(parent) && parent > 1 ? parent : null,
+    provider: env.INDUS_PHOTON_PROVIDER ?? "",
+    projectId: (env.PHOTON_PROJECT_ID ?? "").trim(),
+    projectSecret: env.PHOTON_PROJECT_SECRET ?? "",
+  };
+}
+
+export function alive(pid: number): boolean {
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return (error as NodeJS.ErrnoException).code === "EPERM";
+  }
+}
+
+export interface RunDeps {
+  out: (line: string) => void;
+  provider?: LinkProvider;
+  /** Resolves when the process should stop (signals); the parent watch is added on top. */
+  stopSignal?: Promise<void>;
+  heartbeatMs?: number;
+  retryFirstMs?: number;
+}
+
+const sleep = (ms: number): Promise<void> => new Promise((resolve) => setTimeout(resolve, ms));
+
+/** Run the sidecar until a stop; returns the exit code. */
+export async function run(env: Env, deps: RunDeps): Promise<number> {
+  const emit = (event: Record<string, unknown>): void => deps.out(JSON.stringify(event));
+  const config = readConfig(env);
+  if ("error" in config) {
+    emit({ event: "error", error: `bad_${config.error}` });
+    return 2;
+  }
+  process.umask(0o077);
+  let provider = deps.provider;
+  if (provider === undefined) {
+    try {
+      provider = await loadProvider(config.provider);
+    } catch (error) {
+      // Fail closed: no Spectrum client ships with the sidecar, so without one nothing is bound.
+      emit({
+        event: "error",
+        error: error instanceof ProviderMissing ? "no_provider" : "provider",
+      });
+      return 2;
+    }
+  }
+  if (!config.projectId || !config.projectSecret) {
+    emit({ event: "error", error: "credentials" });
+    return 2;
+  }
+
+  const relay = new Relay();
+  let link: SpectrumLink | null = null;
+  let stopping = false;
+  const setState = (state: LinkState, detail = ""): void => {
+    if (stopping) return;
+    // The detail is the provider's and could name anything: only its presence is reported.
+    if (relay.setStatus(state, detail)) emit({ event: "link", state });
+  };
+
+  let finish: (code: number) => void = () => {};
+  const finished = new Promise<number>((resolve) => {
+    finish = resolve;
+  });
+  const startPpid = process.ppid;
+  const watch = setInterval(() => {
+    const gone = config.parentPid !== null && !alive(config.parentPid);
+    if (gone || process.ppid !== startPpid) finish(0);
+  }, PARENT_CHECK_MS);
+  void deps.stopSignal?.then(() => finish(0));
+
+  const server = createSidecarServer({
+    token: config.token,
+    profile: config.profile,
+    relay,
+    link: () => link,
+    version: VERSION,
+    ...(deps.heartbeatMs === undefined ? {} : { heartbeatMs: deps.heartbeatMs }),
+  });
+
+  /** Open the link, retrying 1 s doubling to 30 s; refused credentials stop the retries. */
+  const connect = async (): Promise<void> => {
+    let wait = deps.retryFirstMs ?? RETRY_FIRST_MS;
+    while (!stopping) {
+      setState("connecting");
+      try {
+        const opened = await (provider as LinkProvider)({
+          projectId: config.projectId,
+          projectSecret: config.projectSecret,
+          handlers: {
+            onState: (state, detail) => setState(state, detail ?? ""),
+            onMessage: (message) => {
+              if (!stopping) relay.accept(message);
+            },
+          },
+        });
+        if (stopping) {
+          await opened.close().catch(() => {});
+          return;
+        }
+        link = opened;
+        if (relay.status === "connecting") setState("open");
+        return;
+      } catch (error) {
+        if (error instanceof LinkError && error.code === "auth_failed") {
+          setState("auth_failed");
+          return;
+        }
+        setState("closed");
+        emit({ event: "error", error: "link" });
+        await sleep(wait);
+        wait = Math.min(wait * 2, RETRY_MAX_MS);
+      }
+    }
+  };
+
+  let code: number;
+  try {
+    const port = await listen(server, config.host, config.port);
+    emit({ event: "listening", port });
+    void connect();
+    code = await finished;
+  } catch {
+    emit({ event: "error", error: "listen" });
+    code = 1;
+  } finally {
+    stopping = true;
+    clearInterval(watch);
+    const open = link as SpectrumLink | null;
+    link = null;
+    await open?.close().catch(() => {});
+    server.closeAllConnections();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+  return code;
+}
+
+function signalled(): Promise<void> {
+  return new Promise((resolve) => {
+    process.once("SIGTERM", () => resolve());
+    process.once("SIGINT", () => resolve());
+  });
+}
+
+const entry = process.argv[1];
+if (entry !== undefined && pathToFileURL(entry).href === import.meta.url) {
+  run(process.env, {
+    out: (line) => process.stdout.write(`${line}\n`),
+    stopSignal: signalled(),
+  }).then(
+    (code) => process.exit(code),
+    () => process.exit(1),
+  );
+}
diff --git a/apps/photon-sidecar/src/relay.ts b/apps/photon-sidecar/src/relay.ts
new file mode 100644
index 0000000..f2a6244
--- /dev/null
+++ b/apps/photon-sidecar/src/relay.ts
@@ -0,0 +1,233 @@
+// What the sidecar knows between the provider and the HTTP API: the link state, the ring of recent
+// events (the at-least-once stream replays from it) and the media refs handed out in events.
+//
+// Provider messages are reduced to our event shape here. Our own echoes (`fromUs`) and read receipts
+// never become events; everything else does, in arrival order, numbered by `seq` within one run
+// (`epoch`). The adapter dedupes by `id`: a provider that delivers a message twice gives two events.
+
+import { randomBytes } from "node:crypto";
+import type { LinkState, RawContent, RawFile, RawMessage } from "./link.ts";
+import { LinkError } from "./link.ts";
+
+export type Status = "starting" | LinkState;
+export type MediaKind = "image" | "video" | "audio" | "voice" | "file";
+
+export interface MediaItem {
+  ref: string;
+  kind: MediaKind;
+  mime: string;
+  name: string;
+  size: number | null;
+  /** iMessage's rich-link preview art, sent as an attachment right after a link. */
+  preview: boolean;
+}
+
+export interface SidecarEvent {
+  seq: number;
+  id: string;
+  kind: "message" | "reaction";
+  space: { id: string; type: "dm" | "group"; name: string };
+  sender: { id: string; name: string };
+  at: number;
+  text: string;
+  media: MediaItem[];
+  link: { url: string; title: string; summary: string } | null;
+  reply: { id: string; text: string; fromUs: boolean } | null;
+  reaction: { target: string; emoji: string; targetFromUs: boolean; targetText: string } | null;
+}
+
+export const KEEP_EVENTS = 1000;
+export const KEEP_MEDIA = 500;
+export const MEDIA_TTL_MS = 60 * 60 * 1000;
+export const MAX_MEDIA_BYTES = 100 * 1024 * 1024;
+const PREVIEW_MARK = ".pluginpayloadattachment";
+
+interface HeldMedia {
+  file: RawFile;
+  at: number;
+}
+
+export interface RelayOptions {
+  now?: () => number;
+  keepEvents?: number;
+  keepMedia?: number;
+}
+
+function kindOf(file: RawFile): MediaKind {
+  const mime = file.mime.toLowerCase();
+  if (file.voice || mime === "audio/x-caf" || file.name.toLowerCase().endsWith(".caf")) {
+    return "voice";
+  }
+  if (mime.startsWith("image/")) return "image";
+  if (mime.startsWith("video/")) return "video";
+  if (mime.startsWith("audio/")) return "audio";
+  return "file";
+}
+
+export class Relay {
+  readonly epoch: string = randomBytes(6).toString("hex");
+  status: Status = "starting";
+  since: number;
+  detail = "";
+  private readonly now: () => number;
+  private readonly keepEvents: number;
+  private readonly keepMedia: number;
+  private readonly ring: SidecarEvent[] = [];
+  private readonly media = new Map<string, HeldMedia>();
+  private readonly listeners = new Set<(event: SidecarEvent) => void>();
+  private seq = 0;
+
+  constructor(options: RelayOptions = {}) {
+    this.now = options.now ?? Date.now;
+    this.keepEvents = options.keepEvents ?? KEEP_EVENTS;
+    this.keepMedia = options.keepMedia ?? KEEP_MEDIA;
+    this.since = this.now();
+  }
+
+  get kept(): number {
+    return this.ring.length;
+  }
+
+  setStatus(status: Status, detail = ""): boolean {
+    if (status === this.status && detail === this.detail) return false;
+    this.status = status;
+    this.detail = detail;
+    this.since = this.now();
+    return true;
+  }
+
+  subscribe(listener: (event: SidecarEvent) => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  /** Events after `after` in this run; every kept event when `epoch` names another run. */
+  after(after: number, epoch: string): SidecarEvent[] {
+    const from = epoch === this.epoch ? after : 0;
+    return this.ring.filter((event) => event.seq > from);
+  }
+
+  private hold(file: RawFile): string {
+    const ref = randomBytes(12).toString("hex");
+    this.media.set(ref, { file, at: this.now() });
+    while (this.media.size > this.keepMedia) {
+      const oldest = this.media.keys().next();
+      if (oldest.done) break;
+      this.media.delete(oldest.value);
+    }
+    return ref;
+  }
+
+  private item(file: RawFile): MediaItem {
+    return {
+      ref: this.hold(file),
+      kind: kindOf(file),
+      mime: file.mime,
+      name: file.name,
+      size: file.size,
+      preview: file.name.toLowerCase().includes(PREVIEW_MARK),
+    };
+  }
+
+  /** Flatten `content` into text parts, media and the first link. */
+  private flatten(
+    content: RawContent,
+    into: { text: string[]; media: MediaItem[]; link: SidecarEvent["link"] },
+  ): void {
+    switch (content.type) {
+      case "text":
+        if (content.text) into.text.push(content.text);
+        return;
+      case "file":
+        into.media.push(this.item(content));
+        return;
+      case "link": {
+        const link = {
+          url: content.url,
+          title: content.title ?? "",
+          summary: content.summary ?? "",
+        };
+        if (into.link === null) into.link = link;
+        else into.text.push(content.url);
+        return;
+      }
+      case "group":
+        for (const part of content.items) this.flatten(part, into);
+        return;
+      case "other":
+        into.text.push(`[unsupported message: ${content.name}]`);
+        return;
+      default:
+        return;
+    }
+  }
+
+  /** Normalise one provider message; null when it is an echo or a receipt. */
+  accept(raw: RawMessage): SidecarEvent | null {
+    if (raw.fromUs || raw.content.type === "receipt") return null;
+    const base = {
+      id: raw.id,
+      space: { id: raw.space.id, type: raw.space.type, name: raw.space.name ?? "" },
+      sender: { id: raw.sender.id, name: raw.sender.name ?? "" },
+      at: raw.at,
+      reply:
+        raw.replyTo === null
+          ? null
+          : {
+              id: raw.replyTo.id,
+              text: raw.replyTo.text ?? "",
+              fromUs: raw.replyTo.fromUs === true,
+            },
+    };
+    let event: Omit<SidecarEvent, "seq">;
+    if (raw.content.type === "reaction") {
+      const { target, emoji, targetFromUs, targetText } = raw.content;
+      event = {
+        ...base,
+        kind: "reaction",
+        text: "",
+        media: [],
+        link: null,
+        reaction: { target, emoji, targetFromUs, targetText: targetText ?? "" },
+      };
+    } else {
+      const parts: { text: string[]; media: MediaItem[]; link: SidecarEvent["link"] } = {
+        text: [],
+        media: [],
+        link: null,
+      };
+      this.flatten(raw.content, parts);
+      event = {
+        ...base,
+        kind: "message",
+        text: parts.text.join("\n"),
+        media: parts.media,
+        link: parts.link,
+        reaction: null,
+      };
+    }
+    this.seq += 1;
+    const numbered: SidecarEvent = { seq: this.seq, ...event };
+    this.ring.push(numbered);
+    if (this.ring.length > this.keepEvents) this.ring.splice(0, this.ring.length - this.keepEvents);
+    for (const listener of this.listeners) listener(numbered);
+    return numbered;
+  }
+
+  /** The bytes of one attachment handed out in an event. */
+  async readMedia(ref: string): Promise<Uint8Array> {
+    const held = this.media.get(ref);
+    if (held === undefined || this.now() - held.at > MEDIA_TTL_MS) {
+      this.media.delete(ref);
+      throw new LinkError("message_not_found", "unknown or expired media ref");
+    }
+    if (held.file.size !== null && held.file.size > MAX_MEDIA_BYTES) {
+      throw new LinkError("too_large");
+    }
+    const data = await held.file.read();
+    if (data.byteLength > MAX_MEDIA_BYTES) throw new LinkError("too_large");
+    return data;
+  }
+}
