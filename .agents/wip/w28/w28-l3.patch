+# -- what the TUI reads at start -------------------------------------------------------------------
+
+
+def outcome_of(peer: Peer, method: str, **params: Any) -> Any:
+    answer = peer.answer_of(peer.send(method, **params), method)
+    if "error" in answer:
+        return {"error": answer["error"]["code"]}
+    return answer["result"]
+
