+    monkeypatch.setattr(gc._View, "load", classmethod(lambda cls, scope: broken(scope)))
+    (row,) = gc.gateway_findings(profile(scope, {}))
+    assert row == Finding(
+        "gateway", "warn", "the gateway settings could not be read: ValueError: bad settings"
+    )
