+def test_the_flood_gate_caps_and_resets() -> None:
+    clock = FakeClock(START)
+    gate = FloodGate(clock)
+    gate.flood(None)
+    gate.flood(None)
+    assert gate.waits == [1.0, 2.0] and not gate.open()
+    gate.passed()
+    assert gate.strikes == 0
+    gate.flood(500)
+    assert gate.waits[-1] == 30.0
+    clock.advance(30)
+    assert gate.open()
+
