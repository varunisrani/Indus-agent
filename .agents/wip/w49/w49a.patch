+def _build_step(job: dict[str, Any]) -> dict[str, Any]:
+    """The step that runs the desktop packaging script (``dist:unsigned`` or ``dist-mac.mjs``)."""
+    return next(
+        s
+        for s in job["steps"]
+        if "dist:unsigned" in str(s.get("run", "")) or "dist-mac.mjs" in str(s.get("run", ""))
+    )
+
