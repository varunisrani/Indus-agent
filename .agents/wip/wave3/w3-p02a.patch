index 0000000..713b6b0
--- /dev/null
+++ b/src/indus/state/readpool.py
@@ -0,0 +1,368 @@
+"""Bounded read-only connections for WAL stores.
+
+In WAL mode readers need no write lock, so reads borrow a read-only connection from a LIFO pool
+and never queue behind the writer's mutex; reads are autocommit, so a read after a write sees it.
+Read connections are file descriptors, and unbounded per-thread connections once pushed a process
+into EMFILE where the error surfaced in unrelated tools (R03.17). The limits:
+
+- at most 8 live read connections per database file, shared by every handle on that file in the
+  process (idle pooled ones keep their permit);
+- at most 24 per process across all files;
+- none when fewer than 64 descriptors remain under the soft ``RLIMIT_NOFILE`` (the count is
+  cached for 0.25 s; when it cannot be measured, reads are allowed).
+
+A reader without a permit first closes an idle pooled connection anywhere in the process; when
+there is none it reads on the writer connection — slower, never blocked forever. A failed open
+blocks new opens for 60 s (a timestamp, not a sticky flag). In DELETE mode every read uses the
+writer connection with ``busy_timeout`` raised to 5 s for the read.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import errno
+import logging
+import os
+import sqlite3
+import threading
+import weakref
+from collections.abc import Callable, Generator
+from pathlib import Path
+
+from indus.foundation.clock import Clock
+from indus.state.writer import Writer
+
+__all__ = [
+    "DELETE_READ_BUSY_MS",
+    "FD_CACHE_SECONDS",
+    "FD_RESERVE",
+    "OPEN_RETRY_SECONDS",
+    "POOL_MAX_PER_PATH",
+    "POOL_MAX_PER_PROCESS",
+    "ReadPool",
+    "fd_soft_limit",
+    "open_fd_count",
+    "open_read_only",
+    "process_permits_in_use",
+    "read_only_uri",
+    "reset_fd_cache",
+]
+
+log = logging.getLogger(__name__)
+
+POOL_MAX_PER_PATH = 8
+POOL_MAX_PER_PROCESS = 24
+FD_RESERVE = 64
+FD_CACHE_SECONDS = 0.25
+OPEN_RETRY_SECONDS = 60.0
+DELETE_READ_BUSY_MS = 5000
+READ_BUSY_SECONDS = 5.0
+
+_process_permits = threading.BoundedSemaphore(POOL_MAX_PER_PROCESS)
+_process_in_use = 0
+_process_lock = threading.Lock()
+
+
+def process_permits_in_use() -> int:
+    with _process_lock:
+        return _process_in_use
+
+
+def _take_process_permit() -> bool:
+    global _process_in_use
+    if not _process_permits.acquire(blocking=False):
+        return False
+    with _process_lock:
+        _process_in_use += 1
+    return True
+
+
+def _give_process_permit() -> None:
+    global _process_in_use
+    with _process_lock:
+        _process_in_use -= 1
+    _process_permits.release()
+
+
+# -- descriptor headroom ------------------------------------------------------------------------
+
+_fd_lock = threading.Lock()
+_fd_cache: tuple[float, int | None] | None = None
+
+
+def open_fd_count() -> int | None:
+    """Descriptors open in this process; None when unmeasurable, -1 when the probe hit EMFILE."""
+    candidates = [Path("/proc/self/fd"), Path("/dev/fd")]
+    existing = [d for d in candidates if d.is_dir()]
+    if not existing:
+        return None
+    try:
+        with os.scandir(existing[0]) as entries:
+            return sum(1 for _ in entries)
+    except OSError as exc:
+        starved = exc.errno in (errno.EMFILE, errno.ENFILE)
+        return -1 if starved else None
+
+
+def fd_soft_limit() -> int | None:
+    try:
+        import resource
+    except ImportError:
+        return None
+    try:
+        soft, _hard = resource.getrlimit(resource.RLIMIT_NOFILE)
+    except (OSError, ValueError):
+        return None
+    if soft == resource.RLIM_INFINITY or soft < 0:
+        return None
+    return int(soft)
+
+
+def reset_fd_cache() -> None:
+    global _fd_cache
+    with _fd_lock:
+        _fd_cache = None
+
+
+def _fd_headroom_ok(now: float) -> bool:
+    global _fd_cache
+    soft = fd_soft_limit()
+    if soft is None:
+        return True
+    with _fd_lock:
+        cached = _fd_cache
+    if cached is None or now - cached[0] >= FD_CACHE_SECONDS or now < cached[0]:
+        cached = (now, open_fd_count())
+        with _fd_lock:
+            _fd_cache = cached
+    count = cached[1]
+    if count is None:
+        return True
+    return count >= 0 and soft - count > FD_RESERVE
+
+
+# -- per-path budgets ---------------------------------------------------------------------------
+
+
+class _PathBudget:
+    """Read permits for one database file, shared by every pool on it in this process."""
+
+    def __init__(self) -> None:
+        self.permits = threading.BoundedSemaphore(POOL_MAX_PER_PATH)
+        self._lock = threading.Lock()
+        self._members: weakref.WeakSet[ReadPool] = weakref.WeakSet()
+
+    def register(self, pool: ReadPool) -> None:
+        with self._lock:
+            self._members.add(pool)
+
+    def unregister(self, pool: ReadPool) -> None:
+        with self._lock:
+            self._members.discard(pool)
+
+    def reclaim_idle(self) -> bool:
+        with self._lock:
+            members = list(self._members)
+        return any(member.evict_one_idle() for member in members)
+
+    def acquire(self, now: float) -> bool:
+        if not _fd_headroom_ok(now):
+            log.debug("not opening a read connection: too few file descriptors left")
+            return False
+        if not (_take_process_permit() or (_reclaim_anywhere() and _take_process_permit())):
+            return False
+        if self.permits.acquire(blocking=False) or (
+            self.reclaim_idle() and self.permits.acquire(blocking=False)
+        ):
+            return True
+        _give_process_permit()
+        return False
+
+    def release(self) -> None:
+        self.permits.release()
+        _give_process_permit()
+
+
+_budgets: weakref.WeakValueDictionary[str, _PathBudget] = weakref.WeakValueDictionary()
+_budgets_lock = threading.Lock()
+
+
+def _budget_for(path: Path) -> _PathBudget:
+    key = str(path.resolve(strict=False))
+    with _budgets_lock:
+        budget = _budgets.get(key)
+        if budget is None:
+            budget = _PathBudget()
+            _budgets[key] = budget
+        return budget
+
+
+def _reclaim_anywhere() -> bool:
+    with _budgets_lock:
+        budgets = list(_budgets.values())
+    return any(budget.reclaim_idle() for budget in budgets)
+
+
+# -- connections --------------------------------------------------------------------------------
+
+
+def read_only_uri(path: Path) -> str:
+    """``file:`` URI with every special character percent-encoded, opened ``mode=ro``."""
+    return f"{path.resolve(strict=False).as_uri()}?mode=ro"
+
+
+def open_read_only(path: Path, *, timeout: float = READ_BUSY_SECONDS) -> sqlite3.Connection:
+    conn = sqlite3.connect(
+        read_only_uri(path),
+        uri=True,
+        timeout=timeout,
+        isolation_level=None,
+        check_same_thread=False,
+    )
+    conn.row_factory = sqlite3.Row
+    return conn
+
+
+class ReadPool:
+    """Read connections for one handle; falls back to the writer connection."""
+
+    def __init__(
+        self,
+        path: Path,
+        writer: Writer,
+        *,
+        wal: bool,
+        clock: Clock,
+        setup: Callable[[sqlite3.Connection], None] | None = None,
+        opener: Callable[[Path], sqlite3.Connection] | None = None,
+        still_ours: Callable[[], bool] | None = None,
+    ) -> None:
+        self.path = path
+        # New read connections open by path: when the file there is no longer the one the
+        # writer opened (a restore), reads stay on the writer's connection instead.
+        self._still_ours = still_ours
+        self.wal = wal
+        self._writer = writer
+        self._clock = clock
+        self._setup = setup
+        self._opener = opener if opener is not None else open_read_only
+        self._lock = threading.Lock()
+        self._idle: list[sqlite3.Connection] = []
+        self._live = 0
+        self._closed = False
+        self._failed_at: float | None = None
+        self._budget = _budget_for(path)
+        self._budget.register(self)
+
+    # -- stats -----------------------------------------------------------------------------------
+
+    @property
+    def idle_count(self) -> int:
+        with self._lock:
+            return len(self._idle)
+
+    @property
+    def live_count(self) -> int:
+        with self._lock:
+            return self._live
+
+    # -- borrowing -------------------------------------------------------------------------------
+
+    @contextlib.contextmanager
+    def read(self) -> Generator[sqlite3.Connection]:
+        """A connection for read-only statements (pooled, else the writer's)."""
+        conn = self._checkout()
+        if conn is not None:
+            try:
+                yield conn
+            finally:
+                self._checkin(conn)
+            return
+        with self._writer.borrow() as wconn:
+            if self.wal:
+                yield wconn
+                return
+            previous = int(wconn.execute("PRAGMA busy_timeout").fetchone()[0])
+            wconn.execute(f"PRAGMA busy_timeout={DELETE_READ_BUSY_MS}")
+            try:
+                yield wconn
+            finally:
+                with contextlib.suppress(sqlite3.Error):
+                    wconn.execute(f"PRAGMA busy_timeout={previous}")
+
+    def _checkout(self) -> sqlite3.Connection | None:
+        if not self.wal:
+            return None
+        with self._lock:
+            if self._closed:
+                return None
+            if self._idle:
+                return self._idle.pop()
+            failed_at = self._failed_at
+        now = self._clock.monotonic()
+        if failed_at is not None and now - failed_at < OPEN_RETRY_SECONDS:
+            return None
+        if self._still_ours is not None and not self._still_ours():
+            return None
+        if not self._budget.acquire(now):
+            log.debug("read pool for %s is full; reading on the writer connection", self.path)
+            return None
+        conn: sqlite3.Connection | None = None
+        try:
+            conn = self._opener(self.path)
+            if self._setup is not None:
+                self._setup(conn)
+        except sqlite3.Error:
+            if conn is not None:
+                with contextlib.suppress(sqlite3.Error):
+                    conn.close()
+            self._budget.release()
+            with self._lock:
+                self._failed_at = self._clock.monotonic()
+            log.debug("opening a read connection on %s failed", self.path, exc_info=True)
+            return None
+        except BaseException:
+            if conn is not None:
+                with contextlib.suppress(sqlite3.Error):
+                    conn.close()
+            self._budget.release()
+            raise
+        with self._lock:
+            self._live += 1
+        return conn
+
+    def _checkin(self, conn: sqlite3.Connection) -> None:
+        with self._lock:
+            if not self._closed:
+                self._idle.append(conn)
+                return
+        self._discard(conn)
+
+    def _discard(self, conn: sqlite3.Connection) -> None:
+        """Close one live connection and give its permits back, even when the close fails."""
+        try:
+            conn.close()
+        except sqlite3.Error:
+            log.debug("closing a read connection on %s failed", self.path, exc_info=True)
+        finally:
+            with self._lock:
+                self._live -= 1
+            self._budget.release()
+
+    def evict_one_idle(self) -> bool:
+        """Close one idle pooled connection (another reader needs its permit)."""
+        with self._lock:
+            if not self._idle:
+                return False
+            conn = self._idle.pop(0)
+        self._discard(conn)
+        return True
+
+    def close(self) -> None:
+        """Close idle connections; connections in use are closed by their reader."""
+        with self._lock:
+            self._closed = True
+            idle, self._idle = self._idle, []
+        for conn in idle:
+            self._discard(conn)
+        self._budget.unregister(self)
diff --git a/src/indus/state/registry.py b/src/indus/state/registry.py
new file mode 100644
index 0000000..8e4269b
--- /dev/null
+++ b/src/indus/state/registry.py
@@ -0,0 +1,465 @@
+"""Store handles and the process-wide registry that shares one handle per store file.
+
+A ``StoreHandle`` owns a writer connection, a read pool, the integrity guard and a close-time
+checkpoint. Two handles on one file in one process race each other's checkpoints, so long-lived
+code shares one per resolved path: ``acquire(scope, path=None)`` returns the current generation
+and bumps its refcount, ``handle.close()`` gives one reference back, and the last release tears
+the handle down outside the registry lock (a slow close never stalls other paths).
+
+When the file at the path is a different inode than the generation opened (backup restore,
+recovery swap), that generation is retired — its holders keep it, its writes are fenced by the
+guard — and a new generation opens. Teardowns of one path are counted behind a barrier, so an
+acquire of that path waits until every admitted physical close has finished.
+
+Open sequence of a handle: ``connection.open_store`` → (under the quarantine lock when the file
+was missing or invalid) ``journal.apply`` + ``journal.apply_pragmas`` + ``schema.init`` → the guard
+records ``(st_dev, st_ino)`` and the ``application_id`` → writer + read pool → registered data
+migrations. Close sequence: PASSIVE checkpoint (skipped when quarantined or replaced) → close the
+readers → close the writer → release the cached header descriptor when no other handle in the
+process still uses the path.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+import random
+import sqlite3
+import threading
+import weakref
+from collections.abc import Callable, Generator
+from contextlib import AbstractContextManager
+from pathlib import Path
+
+from indus.foundation.scope import Scope
+from indus.state import connection, journal, schema
+from indus.state.guards import FileGuard
+from indus.state.readpool import ReadPool
+from indus.state.writer import ROUTINE, Budget, Writer, blocking_sleep
+
+__all__ = [
+    "EXTENSIONS",
+    "HANDLES_PER_PATH_WARN",
+    "MIGRATIONS",
+    "StoreHandle",
+    "acquire",
+    "close_all",
+    "close_all_under",
+    "live_handle_count",
+    "open_unshared",
+    "other_generations",
+    "release",
+    "shared",
+]
+
+log = logging.getLogger(__name__)
+
+HANDLES_PER_PATH_WARN = 4
+
+# Wired by later tasks: extra DDL inside schema init (P02-14 FTS) and data migrations.
+EXTENSIONS: list[schema.SchemaExtension] = []
+MIGRATIONS: list[schema.MigrationStep] = []
+
+
+class StoreHandle:
+    """One open store: writer, read pool, guard. Get one from ``acquire`` or ``open_unshared``."""
+
+    def __init__(
+        self,
+        scope: Scope,
+        path: Path,
+        *,
+        sleep: Callable[[float], None] | None = None,
+        rng: random.Random | None = None,
+    ) -> None:
+        self.scope = scope
+        self.path = path
+        self.journal_mode: str = "delete"
+        self.init_report = schema.InitReport()
+        self._sleep = sleep if sleep is not None else blocking_sleep(scope.clock)
+        self._rng = rng
+        self._shared = False
+        self._closed = False
+        self._torn_down = False
+        self._teardown_lock = threading.Lock()
+        cfg = journal.database_config(scope)
+
+        modes: list[str] = []
+
+        def setup(conn: sqlite3.Connection) -> None:
+            modes.append(journal.apply(conn, cfg, path))
+            journal.apply_pragmas(conn, cfg)
+            self.init_report = schema.init(
+                conn,
+                clock=scope.clock,
+                sleep=self._sleep,
+                rng=self._rng,
+                extensions=tuple(EXTENSIONS),
+            )
+
+        opened = connection.open_store(scope, path, on_connected=setup)
+        self.journal_mode = modes[-1]
+        self.path = opened.path
+        self.quarantined_file = opened.quarantined_to
+        self.guard = FileGuard(opened.path, opened.identity, opened.application_id, opened.conn)
+
+        def reopen() -> sqlite3.Connection:
+            conn = connection.connect(self.path)
+            journal.apply_pragmas(conn, cfg)
+            self.guard.attach(conn)
+            return conn
+
+        self.writer = Writer(
+            opened.path,
+            opened.conn,
+            clock=scope.clock,
+            reopen=reopen,
+            sleep=self._sleep,
+            rng=self._rng,
+            guard=self.guard,
+        )
+
+        def setup_reader(conn: sqlite3.Connection) -> None:
+            journal.apply_pragmas(conn, cfg)
+
+        self.reads = ReadPool(
+            opened.path,
+            self.writer,
+            wal=self.journal_mode == "wal",
+            clock=scope.clock,
+            setup=setup_reader,
+            still_ours=lambda: not (self.guard.replaced or self.guard.file_was_replaced()),
+        )
+        try:
+            if MIGRATIONS:
+                schema.run_migrations(self.writer.write, tuple(MIGRATIONS), clock=scope.clock)
+        except BaseException:
+            self._teardown()
+            raise
+        _track(self)
+
+    # -- use -------------------------------------------------------------------------------------
+
+    @property
+    def wal(self) -> bool:
+        return self.journal_mode == "wal"
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    @property
+    def quarantined(self) -> bool:
+        return self.guard.quarantined
+
+    @property
+    def replaced(self) -> bool:
+        return self.guard.replaced
+
+    def write[T](self, fn: Callable[[sqlite3.Connection], T], *, budget: Budget = ROUTINE) -> T:
+        return self.writer.write(fn, budget=budget)
+
+    async def awrite[T](
+        self, fn: Callable[[sqlite3.Connection], T], *, budget: Budget = ROUTINE
+    ) -> T:
+        return await self.writer.awrite(fn, budget=budget)
+
+    def read(self) -> AbstractContextManager[sqlite3.Connection]:
+        return self.reads.read()
+
+    # -- lifecycle -------------------------------------------------------------------------------
+
+    def close(self) -> None:
+        """Release this reference (shared) or tear the handle down (unshared)."""
+        if self._shared:
+            release(self)
+            return
+        self._teardown()
+
+    def _teardown(self) -> None:
+        with self._teardown_lock:
+            if self._torn_down:
+                return
+            self._torn_down = True
+            self._closed = True
+        checkpoint = not self.guard.skip_close_checkpoint
+        if not checkpoint:
+            log.warning(
+                "closing %s without a checkpoint: this handle saw the file %s",
+                self.path,
+                "replaced" if self.guard.replaced else "damaged",
+            )
+        try:
+            if checkpoint and self.writer.conn is not None:
+                self.writer.checkpoint_passive()
+        finally:
+            try:
+                self.reads.close()
+            finally:
+                try:
+                    self.writer.close(checkpoint=False)
+                finally:
+                    _untrack(self)
+                    if live_handle_count(self.path) == 0:
+                        connection.release_header_fd(self.path)
+
+    def __enter__(self) -> StoreHandle:
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self.close()
+
+    def __repr__(self) -> str:
+        return f"StoreHandle({self.path}, {self.journal_mode}, closed={self._closed})"
+
+
+# -- live handle tracking (diagnostics and the header descriptor) -------------------------------
+
+_track_lock = threading.Lock()
+_live: dict[str, weakref.WeakSet[StoreHandle]] = {}
+_warned_paths: set[str] = set()
+
+
+def _key(path: Path) -> str:
+    return os.path.normcase(str(Path(path).resolve(strict=False)))
+
+
+def _track(handle: StoreHandle) -> None:
+    key = _key(handle.path)
+    with _track_lock:
+        members = _live.setdefault(key, weakref.WeakSet())
+        members.add(handle)
+        count = len(members)
+        warn = count > HANDLES_PER_PATH_WARN and key not in _warned_paths
+        if warn:
+            _warned_paths.add(key)
+    if warn:
+        log.warning(
+            "%d store handles are open on %s in this process; long-lived code should share one "
+            "(registry.acquire)",
+            count,
+            handle.path,
+        )
+
+
+def _untrack(handle: StoreHandle) -> None:
+    key = _key(handle.path)
+    with _track_lock:
+        members = _live.get(key)
+        if members is not None:
+            members.discard(handle)
+            if not members:
+                _live.pop(key, None)
+
+
+def live_handle_count(path: Path) -> int:
+    with _track_lock:
+        members = _live.get(_key(path))
+        return len(members) if members is not None else 0
+
+
+# -- the registry -------------------------------------------------------------------------------
+
+
+class _Generation:
+    __slots__ = ("handle", "identity", "path", "refcount", "retired")
+
+    def __init__(self, path: Path, handle: StoreHandle, identity: tuple[int, int] | None) -> None:
+        self.path = path
+        self.handle = handle
+        self.identity = identity
+        self.refcount = 1
+        self.retired = False
+
+
+class _Barrier:
+    """Admitted but unfinished physical closes of one path; the last one to settle lifts it."""
+
+    __slots__ = ("event", "pending")
+
+    def __init__(self) -> None:
+        self.event = threading.Event()
+        self.pending = 0
+
+
+_lock = threading.Lock()
+_current: dict[Path, _Generation] = {}
+_retired: dict[int, _Generation] = {}
+_opening: dict[Path, threading.Event] = {}
+_barriers: dict[Path, _Barrier] = {}
+
+
+def _open_handle(scope: Scope, path: Path) -> StoreHandle:
+    """Construct a handle (tests patch this)."""
+    return StoreHandle(scope, path)
+
+
+def _resolve(scope: Scope, path: Path | None) -> Path:
+    raw = Path(path) if path is not None else connection.default_store_path(scope)
+    return raw.resolve(strict=False)
+
+
+def _admit_teardown_locked(path: Path) -> _Barrier:
+    barrier = _barriers.get(path)
+    if barrier is None:
+        barrier = _barriers[path] = _Barrier()
+    barrier.pending += 1
+    return barrier
+
+
+def _settle(path: Path, barrier: _Barrier) -> None:
+    with _lock:
+        barrier.pending -= 1
+        if barrier.pending > 0:
+            return
+        if _barriers.get(path) is barrier:
+            _barriers.pop(path, None)
+    barrier.event.set()
+
+
+def _teardown_handle(handle: StoreHandle) -> None:
+    try:
+        handle._teardown()  # pyright: ignore[reportPrivateUsage]
+    except Exception:
+        log.warning("closing the store handle for %s failed", handle.path, exc_info=True)
+
+
+def acquire(scope: Scope, path: Path | None = None) -> StoreHandle:
+    """The shared handle for the store of ``scope`` (or ``path``), with one more reference."""
+    resolved = _resolve(scope, path)
+    while True:
+        wait_for: threading.Event | None = None
+        opening: threading.Event | None = None
+        with _lock:
+            gen = _current.get(resolved)
+            if gen is not None:
+                now = connection.file_identity(resolved)
+                if now is not None and gen.identity is not None and now != gen.identity:
+                    gen.retired = True
+                    del _current[resolved]
+                    _retired[id(gen.handle)] = gen
+                else:
+                    gen.refcount += 1
+                    return gen.handle
+            barrier = _barriers.get(resolved)
+            if barrier is not None:
+                wait_for = barrier.event
+            elif resolved in _opening:
+                wait_for = _opening[resolved]
+            else:
+                opening = _opening[resolved] = threading.Event()
+        if wait_for is not None:
+            wait_for.wait()
+            continue
+        assert opening is not None
+        try:
+            handle = _open_handle(scope, resolved)
+        except BaseException:
+            with _lock:
+                _opening.pop(resolved, None)
+            opening.set()
+            raise
+        handle._shared = True  # pyright: ignore[reportPrivateUsage]
+        with _lock:
+            late = _barriers.get(resolved)
+            if late is None:
+                _current[resolved] = _Generation(resolved, handle, handle.guard.identity)
+            _opening.pop(resolved, None)
+        opening.set()
+        if late is None:
+            return handle
+        # A close of this path was admitted while we were opening: never publish over it.
+        _teardown_handle(handle)
+        late.event.wait()
+
+
+def release(handle: StoreHandle) -> bool:
+    """Give back one reference; the last one tears the handle down. False if not shared."""
+    barrier: _Barrier | None = None
+    with _lock:
+        gen = _retired.get(id(handle))
+        if gen is None:
+            gen = _current.get(_key_path(handle))
+            if gen is None or gen.handle is not handle:
+                return False
+        gen.refcount -= 1
+        if gen.refcount > 0:
+            return True
+        if gen.retired:
+            _retired.pop(id(handle), None)
+        elif _current.get(gen.path) is gen:
+            _current.pop(gen.path, None)
+        barrier = _admit_teardown_locked(gen.path)
+    try:
+        _teardown_handle(handle)
+    finally:
+        _settle(gen.path, barrier)
+    return True
+
+
+def _key_path(handle: StoreHandle) -> Path:
+    return handle.path.resolve(strict=False)
+
+
+def open_unshared(scope: Scope, path: Path | None = None) -> StoreHandle:
+    """A private handle (one-shot callers, tests); ``close()`` tears it down directly."""
+    return _open_handle(scope, _resolve(scope, path))
+
+
+def _is_under(path: Path, root: Path) -> bool:
+    return path == root or root in path.parents
+
+
+def _sweep(select: Callable[[Path], bool]) -> int:
+    with _lock:
+        gens = [g for g in (*_current.values(), *_retired.values()) if select(g.path)]
+        waiting = [b.event for p, b in _barriers.items() if select(p)]
+        barriers = {g.path: _admit_teardown_locked(g.path) for g in gens}
+        for gen in gens:
+            gen.retired = True
+            if _current.get(gen.path) is gen:
+                _current.pop(gen.path, None)
+            _retired.pop(id(gen.handle), None)
+    for path, barrier in barriers.items():
+        try:
+            for gen in gens:
+                if gen.path == path:
+                    _teardown_handle(gen.handle)
+        finally:
+            _settle(path, barrier)
+    for event in waiting:
+        event.wait()
+    return len(gens)
+
+
+def close_all() -> int:
+    """Close every shared handle regardless of references (process shutdown). Idempotent."""
+    return _sweep(lambda _path: True)
+
+
+def close_all_under(directory: Path) -> int:
+    """Close every shared handle whose file lives under ``directory`` (profile delete/rename)."""
+    root = Path(directory).expanduser().resolve(strict=False)
+    return _sweep(lambda path: _is_under(path, root))
+
+
+def other_generations(path: Path, *, exclude: StoreHandle | None = None) -> list[str]:
+    """Live (not retired) shared handles on ``path`` other than ``exclude`` (VACUUM gate)."""
+    resolved = Path(path).resolve(strict=False)
+    with _lock:
+        return [
+            f"in-process store handle (refcount {g.refcount})"
+            for g in _current.values()
+            if g.path == resolved and g.handle is not exclude and not g.retired
+        ]
+
+
+@contextlib.contextmanager
+def shared(scope: Scope, path: Path | None = None) -> Generator[StoreHandle]:
+    """``with shared(scope) as store:`` — acquire and release around a block."""
+    handle = acquire(scope, path)
+    try:
+        yield handle
+    finally:
+        handle.close()
