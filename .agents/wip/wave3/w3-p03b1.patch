+"""Test-only stand-in for the P03-18 fake model server while that slice is not merged.
+
+When ``tests/fakes/model/server.py`` exists its ``FakeModelServer`` is used; otherwise this module
+renders one scripted ``Turn`` per request in either wire format over ``httpx.MockTransport``.
+It understands the P00-11 vocabulary only: ``Text``, ``Reasoning``, ``ToolCall``, ``Usage``,
+``Finish`` and ``Fail``.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Iterator
+from typing import Any
+
+import httpx
+
+from tests.fakes.model import Fail, Finish, Reasoning, Script, Text, ToolCall, Turn, Usage
+
+try:  # pragma: no cover - depends on merge order
+    from tests.fakes.model.server import FakeModelServer as _Real  # type: ignore[import-not-found]
+except ImportError:  # pragma: no cover
+    _Real = None
+
+_ANTHROPIC_STOP = {"stop": "end_turn", "tool_calls": "tool_use", "length": "max_tokens"}
+
+
+def _pieces(text: str, count: int) -> list[str]:
+    count = max(1, min(count, len(text) or 1))
+    size = -(-len(text) // count) if text else 1
+    return [text[i : i + size] for i in range(0, len(text), size)] or [""]
+
+
+def _args_text(call: ToolCall) -> str:
+    return call.arguments if isinstance(call.arguments, str) else json.dumps(dict(call.arguments))
+
+
+def _data(obj: object) -> bytes:
+    return b"data: " + json.dumps(obj).encode() + b"\n\n"
+
+
+def _event(obj: dict[str, Any]) -> bytes:
+    return f"event: {obj['type']}\n".encode() + _data(obj)
+
+
+def _finish_of(turn: Turn) -> str:
+    for step in turn.steps:
+        if isinstance(step, Finish):
+            return step.reason
+    return "tool_calls" if any(isinstance(s, ToolCall) for s in turn.steps) else "stop"
+
+
+def render_chat(turn: Turn) -> Iterator[bytes]:
+    def chunk(delta: dict[str, Any], finish: str | None = None) -> bytes:
+        return _data(
+            {
+                "object": "chat.completion.chunk",
+                "choices": [{"index": 0, "delta": delta, "finish_reason": finish}],
+            }
+        )
+
+    calls = 0
+    usage: Usage | None = None
+    for step in turn.steps:
+        if isinstance(step, Text):
+            for piece in step.chunks:
+                yield chunk({"content": piece})
+        elif isinstance(step, Reasoning):
+            for piece in step.chunks:
+                yield chunk({"reasoning_content": piece})
+        elif isinstance(step, ToolCall):
+            call_id = step.id or f"call_{calls}"
+            yield chunk(
+                {
+                    "tool_calls": [
+                        {
+                            "index": calls,
+                            "id": call_id,
+                            "type": "function",
+                            "function": {"name": step.name, "arguments": ""},
+                        }
+                    ]
+                }
+            )
+            for piece in _pieces(_args_text(step), step.fragments):
+                yield chunk({"tool_calls": [{"index": calls, "function": {"arguments": piece}}]})
+            calls += 1
+        elif isinstance(step, Usage):
+            usage = step
+    yield chunk({}, _finish_of(turn))
+    if usage is not None:
+        yield _data(
+            {
+                "object": "chat.completion.chunk",
+                "choices": [],
+                "usage": {
+                    "prompt_tokens": usage.prompt,
+                    "completion_tokens": usage.completion,
+                    "prompt_tokens_details": {"cached_tokens": usage.cached},
+                },
+            }
+        )
+    yield b"data: [DONE]\n\n"
+
+
+def render_anthropic(turn: Turn) -> Iterator[bytes]:
+    usage = next((s for s in turn.steps if isinstance(s, Usage)), None)
+    start_usage = (
+        {
+            "input_tokens": usage.prompt - usage.cached,
+            "cache_read_input_tokens": usage.cached,
+            "output_tokens": 1,
+        }
+        if usage
+        else {"input_tokens": 0, "output_tokens": 0}
+    )
+    yield _event(
+        {
+            "type": "message_start",
+            "message": {
+                "id": "msg_fake",
+                "type": "message",
+                "role": "assistant",
+                "content": [],
+                "usage": start_usage,
+            },
+        }
+    )
+    index = 0
+    calls = 0
+    for step in turn.steps:
+        if isinstance(step, Text):
+            yield _event(
+                {
+                    "type": "content_block_start",
+                    "index": index,
+                    "content_block": {"type": "text", "text": ""},
+                }
+            )
+            for piece in step.chunks:
+                yield _event(
+                    {
+                        "type": "content_block_delta",
+                        "index": index,
+                        "delta": {"type": "text_delta", "text": piece},
+                    }
+                )
+        elif isinstance(step, Reasoning):
+            yield _event(
+                {
+                    "type": "content_block_start",
+                    "index": index,
+                    "content_block": {"type": "thinking", "thinking": "", "signature": ""},
+                }
+            )
+            for piece in step.chunks:
+                yield _event(
+                    {
+                        "type": "content_block_delta",
+                        "index": index,
+                        "delta": {"type": "thinking_delta", "thinking": piece},
+                    }
+                )
+            yield _event(
+                {
+                    "type": "content_block_delta",
+                    "index": index,
+                    "delta": {"type": "signature_delta", "signature": f"sig{index}"},
+                }
+            )
+        elif isinstance(step, ToolCall):
+            yield _event(
+                {
+                    "type": "content_block_start",
+                    "index": index,
+                    "content_block": {
+                        "type": "tool_use",
+                        "id": step.id or f"toolu_{calls}",
+                        "name": step.name,
+                        "input": {},
+                    },
+                }
+            )
+            for piece in _pieces(_args_text(step), step.fragments):
+                yield _event(
+                    {
+                        "type": "content_block_delta",
+                        "index": index,
+                        "delta": {"type": "input_json_delta", "partial_json": piece},
+                    }
+                )
+            calls += 1
+        else:
+            continue
+        yield _event({"type": "content_block_stop", "index": index})
+        index += 1
+    delta: dict[str, Any] = {
+        "type": "message_delta",
+        "delta": {"stop_reason": _ANTHROPIC_STOP.get(_finish_of(turn), "end_turn")},
+    }
+    if usage is not None:
+        delta["usage"] = {"output_tokens": usage.completion}
+    yield _event(delta)
+    yield _event({"type": "message_stop"})
+
+
+class _Body(httpx.AsyncByteStream):
+    def __init__(self, parts: list[bytes]) -> None:
+        self.parts = parts
+
+    async def __aiter__(self):  # noqa: ANN204
+        for part in self.parts:
+            yield part
+
+
+class _StandIn:
+    def __init__(self, script: Script, *, clock: object = None) -> None:
+        self.script = script
+        self.requests: list[dict[str, Any]] = []
+        self.transport = httpx.MockTransport(self._handle)
+
+    def _handle(self, request: httpx.Request) -> httpx.Response:
+        if len(self.requests) >= len(self.script.turns):
+            raise AssertionError(f"unexpected request #{len(self.requests) + 1} to the fake model")
+        turn = self.script.turns[len(self.requests)]
+        self.requests.append(json.loads(request.content))
+        fail = next((s for s in turn.steps if isinstance(s, Fail)), None)
+        if fail is not None:
+            return httpx.Response(fail.status, headers=dict(fail.headers), text=fail.body)
+        render = render_anthropic if request.url.path.endswith("/messages") else render_chat
+        return httpx.Response(
+            200, headers={"content-type": "text/event-stream"}, stream=_Body(list(render(turn)))
+        )
+
+
+FakeModelServer: Any = _Real if _Real is not None else _StandIn
