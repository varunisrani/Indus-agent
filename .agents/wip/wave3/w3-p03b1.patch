+"""Test-only stand-ins for the P03-A slice (``ProviderProfile``, ``RuntimeRoute``).
+
+The transports read routes and profiles by attribute, so these small dataclasses carry exactly the
+attributes the P03 task rows name. Replace with the real types once P03-01/P03-05 land.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+FAKE_KEY = "test-key-" + "0000-" + "abcd"
+
+
+@dataclass(frozen=True)
+class StubSecret:
+    value: str
+
+    def reveal(self) -> str:
+        return self.value
+
+    def __repr__(self) -> str:
+        return "StubSecret(****)"
+
+
+@dataclass(frozen=True)
+class StubProfile:
+    name: str = "stub"
+    auth_type: str = "api_key"
+    max_tokens_param: str = "max_tokens"
+    default_max_tokens: int | None = None
+    fixed_temperature: float | None = None
+    reasoning_efforts: tuple[str, ...] | None = None
+    adaptive_thinking_models: tuple[str, ...] = ()
+    bearer_auth: bool = False
+    prepare_body: Callable[[dict[str, Any], str], dict[str, Any]] | None = None
+
+
+@dataclass(frozen=True)
+class StubRoute:
+    provider: object
+    model: str
+    api_mode: str
+    base_url: str
+    api_key: StubSecret | None
+    source: str = "test"
+    headers: Mapping[str, str] = field(default_factory=dict[str, str])
+
+
+def stub_route(
+    api_mode: str = "chat_completions",
+    *,
+    base_url: str | None = None,
+    model: str = "test-model",
+    key: str | None = FAKE_KEY,
+    profile: StubProfile | None = None,
+) -> StubRoute:
+    if base_url is None:
+        base_url = (
+            "https://api.fake.invalid/v1"
+            if api_mode == "chat_completions"
+            else "https://anthropic.fake.invalid"
+        )
+    return StubRoute(
+        provider=profile if profile is not None else "stub",
+        model=model,
+        api_mode=api_mode,
+        base_url=base_url,
+        api_key=StubSecret(key) if key else None,
+    )
