@@ -0,0 +1,548 @@
+"""Test-only stand-ins for P03 modules built by parallel slices (wave 3).
+
+P03-B2 (timeouts, stream driver, classifier, retry, fake model, trial) codes against the names in
+the phase file for modules that P03-A (``hosts``, ``route``) and P03-B1 (``types``, ``sse``,
+``transports``) build at the same time. ``install()`` registers a stand-in **only for a module
+that does not exist**, so once the real modules land this file does nothing and can be deleted
+by the lead (with the three ``conftest.py`` lines that call it).
+
+The stand-ins implement just enough of each interface for the B2 tests: they are not product
+code and never ship.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import ipaddress
+import json
+import sys
+import types as _pytypes
+from collections.abc import AsyncIterator, Iterable, Mapping
+from dataclasses import dataclass, field
+from typing import Any, Protocol
+from urllib.parse import urlsplit
+
+import httpx
+
+from indus.foundation.errors import ProviderStreamError
+
+# -- providers.hosts (P03-04) ---------------------------------------------------------------------
+
+
+def is_loopback(url: str) -> bool:
+    host = (urlsplit(url).hostname or "").rstrip(".").lower()
+    if host == "localhost" or host.endswith(".localhost"):
+        return True
+    try:
+        return ipaddress.ip_address(host).is_loopback
+    except ValueError:
+        return False
+
+
+# -- providers.route (P03-05) ---------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RuntimeRoute:
+    provider: str
+    model: str
+    api_mode: str
+    base_url: str
+    api_key: Any = None
+    source: str = "test"
+    headers: Mapping[str, str] = field(default_factory=dict)
+
+
+# -- providers.types (P03-06) ---------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class ToolCall:
+    id: str
+    name: str
+    arguments: str
+
+
+@dataclass(frozen=True)
+class Usage:
+    prompt_tokens: int = 0
+    completion_tokens: int = 0
+    cache_read_tokens: int = 0
+    cache_write_tokens: int = 0
+    reasoning_tokens: int = 0
+
+
+@dataclass(frozen=True)
+class NormalizedResponse:
+    content: str | None
+    tool_calls: tuple[ToolCall, ...] = ()
+    finish_reason: str = "stop"
+    reasoning: str | None = None
+    reasoning_details: tuple[dict[str, Any], ...] = ()
+    usage: Usage | None = None
+    provider_data: dict[str, Any] = field(default_factory=dict)
+
+
+@dataclass(frozen=True)
+class TextDelta:
+    text: str
+
+
+@dataclass(frozen=True)
+class ReasoningDelta:
+    text: str
+
+
+@dataclass(frozen=True)
+class ToolCallStart:
+    index: int
+    id: str | None
+    name: str
+
+
+@dataclass(frozen=True)
+class ToolCallArgsDelta:
+    index: int
+    fragment: str
+
+
+@dataclass(frozen=True)
+class UsageReport:
+    usage: Usage
+
+
+@dataclass(frozen=True)
+class Finish:
+    reason: str
+
+
+@dataclass(frozen=True)
+class KeepAlive:
+    text: str = ""
+
+
+StreamEvent = TextDelta | ReasoningDelta | ToolCallStart | ToolCallArgsDelta | UsageReport | Finish
+StreamEvent = StreamEvent | KeepAlive
+
+
+@dataclass(frozen=True)
+class ChatRequest:
+    model: str
+    messages: list[dict[str, Any]]
+    tools: tuple[dict[str, Any], ...] = ()
+    max_tokens: int | None = None
+    temperature: float | None = None
+    reasoning_effort: str | None = None
+    stream: bool = True
+    extra_body: dict[str, Any] = field(default_factory=dict)
+    tool_choice: str | None = None
+
+
+_CHAT_FINISH = {
+    "stop": "stop",
+    "length": "length",
+    "tool_calls": "tool_calls",
+    "content_filter": "content_filter",
+}
+_ANTHROPIC_FINISH = {
+    "end_turn": "stop",
+    "stop_sequence": "stop",
+    "tool_use": "tool_calls",
+    "max_tokens": "length",
+    "refusal": "content_filter",
+}
+
+
+def map_finish_reason(raw: str | None, table: Mapping[str, str]) -> str:
+    return table.get(raw or "", "stop")
+
+
+def assemble(events: Iterable[Any]) -> NormalizedResponse:
+    text: list[str] = []
+    reasoning: list[str] = []
+    calls: dict[int, dict[str, Any]] = {}
+    usage: Usage | None = None
+    finish: str | None = None
+    for ev in events:
+        if isinstance(ev, TextDelta):
+            text.append(ev.text)
+        elif isinstance(ev, ReasoningDelta):
+            reasoning.append(ev.text)
+        elif isinstance(ev, ToolCallStart):
+            slot = calls.setdefault(ev.index, {"id": "", "name": "", "args": []})
+            slot["id"] = ev.id or slot["id"]
+            slot["name"] = ev.name or slot["name"]
+        elif isinstance(ev, ToolCallArgsDelta):
+            calls.setdefault(ev.index, {"id": "", "name": "", "args": []})["args"].append(
+                ev.fragment
+            )
+        elif isinstance(ev, UsageReport):
+            usage = ev.usage
+        elif isinstance(ev, Finish):
+            finish = ev.reason
+    tool_calls = tuple(
+        ToolCall(c["id"] or f"call_{i}", c["name"], "".join(c["args"]) or "{}")
+        for i, c in sorted(calls.items())
+    )
+    return NormalizedResponse(
+        content="".join(text) if text else None,
+        tool_calls=tool_calls,
+        finish_reason=finish or ("tool_calls" if tool_calls else "stop"),
+        reasoning="".join(reasoning) if reasoning else None,
+        usage=usage,
+    )
+
+
+# -- providers.sse (P03-07) -----------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class SSEEvent:
+    event: str = "message"
+    data: str = ""
+    id: str | None = None
+    retry: int | None = None
+
+
+class SSEDecoder:
+    def __init__(self) -> None:
+        self._buf = ""
+        self._data: list[str] = []
+        self._event = ""
+
+    def feed(self, chunk: bytes) -> list[SSEEvent | KeepAlive]:
+        self._buf += chunk.decode("utf-8")
+        out: list[SSEEvent | KeepAlive] = []
+        while "\n" in self._buf:
+            line, self._buf = self._buf.split("\n", 1)
+            line = line.rstrip("\r")
+            if not line:
+                if self._data:
+                    out.append(SSEEvent(self._event or "message", "\n".join(self._data)))
+                self._data, self._event = [], ""
+            elif line.startswith(":"):
+                out.append(KeepAlive(line[1:].strip()))
+            else:
+                name, _, value = line.partition(":")
+                value = value[1:] if value.startswith(" ") else value
+                if name == "data":
+                    self._data.append(value)
+                elif name == "event":
+                    self._event = value
+        return out
+
+    def flush(self) -> list[SSEEvent | KeepAlive]:
+        return self.feed(b"\n\n") if self._data else []
+
+
+async def aiter_sse(response: httpx.Response) -> AsyncIterator[SSEEvent | KeepAlive]:
+    decoder = SSEDecoder()
+    async for chunk in response.aiter_bytes():
+        for ev in decoder.feed(chunk):
+            yield ev
+    for ev in decoder.flush():
+        yield ev
+
+
+# -- providers.transports (P03-06, P03-09, P03-10) -------------------------------------------------
+
+
+class Transport(Protocol):
+    api_mode: str
+
+    def build_request(self, route: Any, req: ChatRequest) -> httpx.Request: ...
+
+    def parse_stream(self, events: AsyncIterator[Any]) -> AsyncIterator[Any]: ...
+
+    def parse_response(self, data: Mapping[str, Any]) -> NormalizedResponse: ...
+
+
+def _key(route: Any) -> str:
+    key = route.api_key
+    reveal = getattr(key, "reveal", None)
+    return str(reveal() if callable(reveal) else key or "")
+
+
+def _stream_error(message: str, code: str, error_type: str | None = None) -> ProviderStreamError:
+    error: dict[str, object] = {"message": message, "code": code}
+    if error_type:
+        error["type"] = error_type
+    return ProviderStreamError(f"provider stream error: {message}", body={"error": error})
+
+
+def _incomplete() -> ProviderStreamError:
+    return _stream_error(
+        "stream ended before the model finished", "incomplete_stream", "incomplete_stream"
+    )
+
+
+class ChatCompletionsTransport:
+    api_mode = "chat_completions"
+
+    def __init__(self) -> None:
+        self._no_stream_options: set[str] = set()
+
+    def on_request_rejected(self, route: Any, error: Any) -> bool:
+        text = f"{error.message} {json.dumps(error.body, default=str)}".lower()
+        if error.status not in (400, 422) or route.base_url in self._no_stream_options:
+            return False
+        if "stream_options" not in text:
+            return False
+        self._no_stream_options.add(route.base_url)
+        return True
+
+    def build_request(
+        self, route: Any, req: ChatRequest, *, profile: object = None
+    ) -> httpx.Request:
+        body: dict[str, Any] = {"model": req.model, "messages": req.messages, "stream": req.stream}
+        if req.stream and route.base_url not in self._no_stream_options:
+            body["stream_options"] = {"include_usage": True}
+        if req.tools:
+            body["tools"] = req.tools
+        if req.max_tokens is not None:
+            body["max_tokens"] = req.max_tokens
+        headers = {"content-type": "application/json"}
+        if _key(route):
+            headers["authorization"] = f"Bearer {_key(route)}"
+        url = route.base_url.rstrip("/") + "/chat/completions"
+        return httpx.Request("POST", url, headers=headers, content=json.dumps(body))
+
+    async def parse_stream(self, events: AsyncIterator[Any]) -> AsyncIterator[Any]:
+        finished = False
+        started: dict[int, dict[str, Any]] = {}
+        async for ev in events:
+            if isinstance(ev, KeepAlive):
+                yield ev
+                continue
+            if ev.data == "[DONE]":
+                if not finished:
+                    raise _incomplete()
+                return
+            try:
+                obj = json.loads(ev.data)
+            except ValueError:
+                raise _stream_error(ev.data, "non_json_data") from None
+            if "error" in obj:
+                err = obj["error"]
+                if not isinstance(err, dict):
+                    err = {"message": str(err)}
+                raise ProviderStreamError(
+                    f"provider stream error: {err.get('message', '')}", body={"error": err}
+                )
+            for choice in obj.get("choices") or []:
+                delta = choice.get("delta") or {}
+                if delta.get("content"):
+                    yield TextDelta(delta["content"])
+                reasoning = delta.get("reasoning") or delta.get("reasoning_content")
+                if reasoning:
+                    yield ReasoningDelta(reasoning)
+                for tc in delta.get("tool_calls") or []:
+                    slot = started.setdefault(
+                        tc["index"], {"id": "", "name": "", "sent": False, "buf": []}
+                    )
+                    fn = tc.get("function") or {}
+                    slot["id"] = slot["id"] or tc.get("id") or ""
+                    slot["name"] = slot["name"] or fn.get("name") or ""
+                    if fn.get("arguments"):
+                        slot["buf"].append(fn["arguments"])
+                    if not slot["sent"] and slot["id"] and slot["name"]:
+                        slot["sent"] = True
+                        yield ToolCallStart(tc["index"], slot["id"], slot["name"])
+                    if slot["sent"] and slot["buf"]:
+                        for piece in slot["buf"]:
+                            yield ToolCallArgsDelta(tc["index"], piece)
+                        slot["buf"] = []
+                if choice.get("finish_reason"):
+                    finished = True
+                    yield Finish(map_finish_reason(choice["finish_reason"], _CHAT_FINISH))
+            if obj.get("usage"):
+                u = obj["usage"]
+                cached = (u.get("prompt_tokens_details") or {}).get("cached_tokens", 0)
+                yield UsageReport(
+                    Usage(u.get("prompt_tokens", 0), u.get("completion_tokens", 0), cached)
+                )
+        if not finished:
+            raise _incomplete()
+
+    def parse_response(self, data: Mapping[str, Any]) -> NormalizedResponse:
+        choice = data["choices"][0]
+        message = choice["message"]
+        calls = tuple(
+            ToolCall(c["id"], c["function"]["name"], c["function"]["arguments"])
+            for c in message.get("tool_calls") or []
+        )
+        u = data.get("usage")
+        return NormalizedResponse(
+            content=message.get("content"),
+            tool_calls=calls,
+            finish_reason=map_finish_reason(choice.get("finish_reason"), _CHAT_FINISH),
+            reasoning=message.get("reasoning"),
+            usage=Usage(u["prompt_tokens"], u["completion_tokens"]) if u else None,
+        )
+
+
+class AnthropicTransport:
+    api_mode = "anthropic_messages"
+
+    def build_request(
+        self, route: Any, req: ChatRequest, *, profile: object = None
+    ) -> httpx.Request:
+        system = "\n".join(m["content"] for m in req.messages if m.get("role") == "system")
+        messages = [m for m in req.messages if m.get("role") != "system"]
+        body: dict[str, Any] = {
+            "model": req.model,
+            "messages": messages,
+            "max_tokens": req.max_tokens or 4096,
+            "stream": req.stream,
+        }
+        if system:
+            body["system"] = system
+        base = route.base_url.rstrip("/")
+        url = base + ("/messages" if base.endswith("/v1") else "/v1/messages")
+        headers = {
+            "content-type": "application/json",
+            "x-api-key": _key(route),
+            "anthropic-version": "2023-06-01",
+        }
+        return httpx.Request("POST", url, headers=headers, content=json.dumps(body))
+
+    async def parse_stream(self, events: AsyncIterator[Any]) -> AsyncIterator[Any]:
+        stopped = False
+        tool_index = -1
+        block_tool: dict[int, int] = {}
+        async for ev in events:
+            if isinstance(ev, KeepAlive):
+                yield ev
+                continue
+            try:
+                obj = json.loads(ev.data)
+            except ValueError:
+                raise _stream_error(ev.data, "non_json_data") from None
+            kind = obj.get("type")
+            if kind == "ping":
+                yield KeepAlive()
+            elif kind == "error":
+                err = obj.get("error") or {}
+                raise _stream_error(str(err.get("message", "")), "error_event", err.get("type"))
+            elif kind == "message_start":
+                u = obj["message"].get("usage") or {}
+                yield UsageReport(
+                    Usage(u.get("input_tokens", 0), 0, u.get("cache_read_input_tokens", 0))
+                )
+            elif kind == "content_block_start":
+                block = obj["content_block"]
+                if block["type"] == "tool_use":
+                    tool_index += 1
+                    block_tool[obj["index"]] = tool_index
+                    yield ToolCallStart(tool_index, block["id"], block["name"])
+            elif kind == "content_block_delta":
+                delta = obj["delta"]
+                if delta["type"] == "text_delta":
+                    yield TextDelta(delta["text"])
+                elif delta["type"] == "thinking_delta":
+                    yield ReasoningDelta(delta["thinking"])
+                elif delta["type"] == "input_json_delta":
+                    yield ToolCallArgsDelta(block_tool[obj["index"]], delta["partial_json"])
+            elif kind == "message_delta":
+                reason = (obj.get("delta") or {}).get("stop_reason")
+                out = (obj.get("usage") or {}).get("output_tokens", 0)
+                yield UsageReport(Usage(0, out))
+                if reason:
+                    yield Finish(map_finish_reason(reason, _ANTHROPIC_FINISH))
+            elif kind == "message_stop":
+                stopped = True
+                return
+        if not stopped:
+            raise _incomplete()
+
+    def parse_response(self, data: Mapping[str, Any]) -> NormalizedResponse:
+        text = "".join(b["text"] for b in data["content"] if b["type"] == "text")
+        calls = tuple(
+            ToolCall(b["id"], b["name"], json.dumps(b["input"]))
+            for b in data["content"]
+            if b["type"] == "tool_use"
+        )
+        u = data.get("usage") or {}
+        return NormalizedResponse(
+            content=text or None,
+            tool_calls=calls,
+            finish_reason=map_finish_reason(data.get("stop_reason"), _ANTHROPIC_FINISH),
+            usage=Usage(u.get("input_tokens", 0), u.get("output_tokens", 0)),
+        )
+
+
+_TRANSPORTS: dict[str, Any] = {
+    "chat_completions": ChatCompletionsTransport,
+    "anthropic_messages": AnthropicTransport,
+}
+
+
+def get_transport(api_mode: str) -> Any:
+    """A fresh stand-in per call, so per-route memory never leaks between tests."""
+    try:
+        return _TRANSPORTS[api_mode]()
+    except KeyError:
+        raise LookupError(f"no transport for api mode {api_mode!r}") from None
+
+
+# -- installation ---------------------------------------------------------------------------------
+
+_HERE = sys.modules[__name__]
+
+_MODULES: dict[str, tuple[str, ...]] = {
+    "indus.providers.hosts": ("is_loopback",),
+    "indus.providers.route": ("RuntimeRoute",),
+    "indus.providers.types": (
+        "ToolCall",
+        "Usage",
+        "NormalizedResponse",
+        "TextDelta",
+        "ReasoningDelta",
+        "ToolCallStart",
+        "ToolCallArgsDelta",
+        "UsageReport",
+        "Finish",
+        "KeepAlive",
+        "StreamEvent",
+        "ChatRequest",
+        "map_finish_reason",
+        "assemble",
+    ),
+    "indus.providers.sse": ("SSEEvent", "SSEDecoder", "aiter_sse"),
+    "indus.providers.transports": ("Transport", "get_transport"),
+}
+
+installed: list[str] = []
+
+
+def _missing(name: str) -> bool:
+    try:
+        return importlib.util.find_spec(name) is None
+    except ModuleNotFoundError:
+        return True
+
+
+def install() -> list[str]:
+    """Register stand-ins for whichever of the modules above do not exist yet."""
+    import indus.providers as providers_pkg
+
+    for name, names in _MODULES.items():
+        if name in sys.modules or not _missing(name):
+            continue
+        module = _pytypes.ModuleType(name, f"test stand-in for {name} (tests/_stubs_p03b2.py)")
+        for attr in names:
+            setattr(module, attr, getattr(_HERE, attr))
+        if name.endswith(".transports"):
+            module.__path__ = []  # a package, so submodule imports resolve to stand-ins too
+            for sub, cls in (
+                ("chat_completions", ChatCompletionsTransport),
+                ("anthropic", AnthropicTransport),
+            ):
+                child = _pytypes.ModuleType(f"{name}.{sub}", "test stand-in")
+                child.__dict__[cls.__name__] = cls
+                sys.modules[f"{name}.{sub}"] = child
+                setattr(module, sub, child)
+        sys.modules[name] = module
+        setattr(providers_pkg, name.rsplit(".", 1)[1], module)
+        installed.append(name)
+    return installed
diff --git a/tests/fakes/model/README.md b/tests/fakes/model/README.md
new file mode 100644
index 0000000..231647a
--- /dev/null
+++ b/tests/fakes/model/README.md
@@ -0,0 +1,74 @@
+# Fake model scripts
+
+`FakeModelServer` (`server.py`) is a model API inside the test process. It answers over
+`httpx.MockTransport`, so no socket is ever opened, and it speaks two wire formats from the same
+script:
+
+| Request | Answer |
+|---|---|
+| `POST …/chat/completions` | Chat Completions: SSE chunks, or one JSON object when `"stream": false` |
+| `POST …/messages` | Anthropic Messages: SSE events, or one `message` object when `"stream": false` |
+| `GET …/models` | `{"object": "list", "data": [...]}` (the `models=` argument, or the server's model) |
+
+Each POST uses up the next turn of the script. A request after the last turn raises
+`FakeScriptExhausted`, naming the script, so a test that calls the model once too often fails
+loudly.
+
+```python
+from tests.fakes.model import FakeModelServer, fake_route, load_script
+
+server = FakeModelServer(load_script("tool_then_text"), clock=fake_clock)
+async with server.client() as client:  # or httpx.AsyncClient(transport=server.transport)
+    ...
+server.model_requests[0].body["messages"]  # what the code under test sent
+```
+
+`fake_route(server, "chat_completions" | "anthropic_messages")` builds a route with a fake key
+on the `fake.invalid` host. `one_off_router()` gives a respx router for single canned answers.
+
+## File format
+
+Scripts live in `tests/fixtures/model_scripts/` as YAML (a small subset: block mappings and
+lists, one-line `[a, b]` / `{k: v}`) or JSON. A bare name (`load_script("hello")`) means
+`tests/fixtures/model_scripts/hello.yaml`.
+
+```yaml
+turns:                      # one entry per model request
+  - steps:                  # played in order
+      - reasoning: ["thinking ", "about it"]
+      - text: ["Hel", "lo"]
+      - tool_call: {name: read_file, arguments: {path: a.txt}, fragments: 3}
+      - usage: {prompt: 120, completion: 9, cached: 64}
+      - finish: tool_calls
+```
+
+Each step is a mapping with exactly one key, its kind:
+
+| Kind | Value | What the server sends |
+|---|---|---|
+| `text` | string or list of chunks | one content delta per chunk |
+| `reasoning` | string or list of chunks | reasoning deltas (Anthropic: a thinking block, closed with a fake signature) |
+| `tool_call` | `name`, `arguments` (mapping, or a raw string for broken JSON), `id`, `fragments` (default 3), `late_id` | the call, its arguments split into that many pieces; with `late_id` the id comes with the second piece (Chat Completions only) |
+| `usage` | `prompt`, `completion`, `cached` | Chat Completions: a usage chunk at this point; Anthropic: input usage in `message_start`, output usage in `message_delta` |
+| `keep_alive` | frame count (default 1) | SSE comment lines / `ping` events, no content |
+| `mid_stream_error` | mapping or string | an error frame inside the open stream (a string is sent as plain-text data), then the stream ends |
+| `stall` | seconds | waits on the server's clock (pass `clock=`); nothing is sent meanwhile |
+| `disconnect` | nothing | the body ends abruptly (`httpx.RemoteProtocolError` on the client) |
+| `eof` | nothing | the body ends cleanly here, without a finish or end-of-stream marker |
+| `fail` | `status`, `body`, `headers` | an HTTP error answer instead of a stream; only as a turn's first step |
+| `finish` | reason (`stop`, `tool_calls`, `length`, `content_filter`, or any raw word) | the finish chunk and `[DONE]` / `message_delta` + `message_stop` |
+
+A turn that runs out of steps without `finish` gets an implied one (`tool_calls` when it called a
+tool, else `stop`) and the end-of-stream marker. To script a stream that stops early, end the turn
+with `eof` (clean end) or `disconnect` (cut).
+
+## What a test can look at
+
+- `server.requests` / `server.model_requests`: `RecordedRequest(method, path, headers, body,
+  turn, at, timeout)` — `body` is the parsed JSON, `at` the server clock time, `timeout` the
+  httpx timeout the client sent.
+- `server.streams`: one `StreamRecord` per streamed answer with `opened_at`, `closed_at`
+  (`time.perf_counter()` seconds), `frames_sent` and `completed`.
+- `server.turns_left`: turns not used yet.
+- `yield_every=N` gives way to the event loop after every N frames and `on_frame(turn, bytes)`
+  sees each frame as it is sent (latency measurements in `tests/trials/`).
