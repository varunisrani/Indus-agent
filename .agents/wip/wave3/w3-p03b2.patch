+    expect: {reason: auth}
+  - id: stream-content-policy
+    stream: error_event
+    body: {error: {message: "Output blocked by content_filter"}}
+    expect: {reason: content_policy}
+  - id: stream-unsupported
+    stream: error_event
+    body: {error: {message: "This endpoint does not support streaming"}}
+    expect: {reason: stream_unsupported}
+  - id: stream-unknown
+    stream: error_event
+    body: {error: {message: "something odd happened"}}
+    expect: {reason: unknown, retryable: true}
+
+  # -- transport exceptions ------------------------------------------------------------------
+  - id: exc-read-timeout
+    exception: ReadTimeout
+    message: "The read operation timed out"
+    expect: {reason: timeout, retryable: true}
