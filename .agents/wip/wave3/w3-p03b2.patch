+
+def test_stall_after_visible_text_returns_length_stub() -> None:
+    h = Harness(
+        script(
+            [
+                {"text": ["Here is ", "the plan"]},
+                {"tool_call": {"name": "write_file", "arguments": {"path": "a"}, "fragments": 2}},
+                {"stall": 500},
+            ],
+            [{"text": "must not be requested"}],
+        )
