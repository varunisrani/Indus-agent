index 0000000..cda78bf
--- /dev/null
+++ b/src/indus/providers/retry.py
@@ -0,0 +1,352 @@
+"""Server-named waits, jittered backoff and the retry loop around one model call.
+
+``parse_retry_after`` reads how long a server asked us to wait, in any of the shapes providers
+use: a ``Retry-After`` header (seconds or an HTTP date), ``retry-after-ms``, a JSON field, or a
+sentence in the error text. ``backoff`` is the jittered exponential wait when the server named
+none. ``retry_call`` runs a call up to ``max_retries + 1`` times, retrying only verdicts the
+classifier marks retryable and sleeping on an injected clock in short slices so an interrupt
+lands quickly. Credential rotation and fallback chains (P08) act on the final ``ClassifiedError``
+that ``RetryFailed`` carries.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import math
+import random
+import re
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from email.utils import parsedate_to_datetime
+from typing import TYPE_CHECKING, Any
+
+import httpx
+
+from indus.foundation.errors import ProviderError
+
+if TYPE_CHECKING:
+    from indus.foundation.clock import Clock
+    from indus.providers.classify import ClassifiedError
+
+log = logging.getLogger(__name__)
+
+RETRY_AFTER_CAP = 600.0
+BACKOFF_BASE = 2.0
+BACKOFF_MAX = 60.0
+BACKOFF_JITTER = 0.5
+SLEEP_SLICE = 0.2
+ANNOUNCE_AFTER = 60.0
+DEFAULT_MAX_RETRIES = 3
+
+_UNITS: dict[str, float] = {
+    "ms": 0.001,
+    "msec": 0.001,
+    "msecs": 0.001,
+    "millisecond": 0.001,
+    "milliseconds": 0.001,
+    "s": 1.0,
+    "sec": 1.0,
+    "secs": 1.0,
+    "second": 1.0,
+    "seconds": 1.0,
+    "m": 60.0,
+    "min": 60.0,
+    "mins": 60.0,
+    "minute": 60.0,
+    "minutes": 60.0,
+    "h": 3600.0,
+    "hr": 3600.0,
+    "hrs": 3600.0,
+    "hour": 3600.0,
+    "hours": 3600.0,
+}
+_UNIT_ALT = "|".join(sorted(_UNITS, key=len, reverse=True))
+_PART = rf"(\d+(?:\.\d+)?)\s*({_UNIT_ALT})\b"
+_DURATION = re.compile(rf"(?:{_PART}[\s,]*(?:and\s+)?)+", re.IGNORECASE)
+_PART_RE = re.compile(_PART, re.IGNORECASE)
+# Lead-ins after which a duration (or a bare number of seconds) names the wait.
+_LEAD_INS = re.compile(
+    r"(?:retry|try\s+again)(?:\s+(?:after|in))?|resets?\s+(?:in|after)|"
+    r"(?:available|again)\s+in|wait(?:\s+for)?|cool[\s-]?down\s+of",
+    re.IGNORECASE,
+)
+_BARE_SECONDS = re.compile(r"\s*(\d+(?:\.\d+)?)(?![\d.]|\s*[a-z%])", re.IGNORECASE)
+_HEADER_SECONDS = ("retry-after-ms", "retry-after")
+_JSON_SECONDS = ("retry_after", "retryAfter", "retry_delay", "retryDelay", "resets_in_seconds")
+_JSON_MS = ("retry_after_ms", "retryAfterMs")
+
+
+def parse_retry_after(
+    value: Any, *, now: datetime | None = None, cap: float | None = RETRY_AFTER_CAP
+) -> float | None:
+    """Seconds to wait named by ``value``, or None when it names none.
+
+    ``value`` may be a header mapping, a header value, a number, a JSON mapping / JSON text, or
+    free text. HTTP dates are measured from ``now`` (an injected clock's time; the real UTC time
+    when omitted). The result is never negative and is capped at ``cap`` (600 s by default;
+    ``None`` disables the cap, for computing a quota reset time).
+    """
+    seconds = _parse(value, now)
+    if seconds is None or math.isnan(seconds):
+        return None
+    seconds = max(0.0, seconds)
+    return seconds if cap is None else min(seconds, cap)
+
+
+def _parse(value: Any, now: datetime | None) -> float | None:
+    if value is None or isinstance(value, bool):
+        return None
+    if isinstance(value, int | float):
+        return float(value)
+    if isinstance(value, Mapping):
+        return _from_mapping(value, now)  # pyright: ignore[reportUnknownArgumentType]
+    if isinstance(value, bytes):
+        value = value.decode("utf-8", "replace")
+    if not isinstance(value, str):
+        return None
+    text = value.strip()
+    if not text:
+        return None
+    number = _number(text)
+    if number is not None:
+        return number
+    if text[0] in "{[":
+        try:
+            decoded = json.loads(text)
+        except ValueError:
+            decoded = None
+        if isinstance(decoded, Mapping):
+            found = _from_mapping(decoded, now)  # pyright: ignore[reportUnknownArgumentType]
+            if found is not None:
+                return found
+    duration = _duration(text)
+    if duration is not None and _DURATION.fullmatch(text):
+        return duration
+    date = _http_date(text, now)
+    if date is not None:
+        return date
+    return _from_text(text)
+
+
+def _number(text: str) -> float | None:
+    try:
+        return float(text)
+    except ValueError:
+        return None
+
+
+def _duration(text: str) -> float | None:
+    parts = _PART_RE.findall(text)
+    if not parts:
+        return None
+    return sum(float(amount) * _UNITS[unit.lower()] for amount, unit in parts)
+
+
+def _http_date(text: str, now: datetime | None) -> float | None:
+    if not any(ch.isalpha() for ch in text) or ("," not in text and "GMT" not in text):
+        return None
+    try:
+        when = parsedate_to_datetime(text)
+    except (TypeError, ValueError, IndexError):
+        return None
+    if when.tzinfo is None:
+        when = when.replace(tzinfo=UTC)
+    reference = now if now is not None else datetime.now(UTC)
+    return (when - reference).total_seconds()
+
+
+def _from_text(text: str) -> float | None:
+    for lead in _LEAD_INS.finditer(text):
+        rest = text[lead.end() :]
+        match = _DURATION.match(rest.lstrip())
+        if match:
+            found = _duration(match.group(0))
+            if found is not None:
+                return found
+        bare = _BARE_SECONDS.match(rest)
+        if bare:
+            return float(bare.group(1))
+    return None
+
+
+def _from_mapping(data: Mapping[Any, Any], now: datetime | None) -> float | None:
+    lowered = {str(k).lower(): v for k, v in data.items()}
+    if "retry-after-ms" in lowered:
+        ms = _parse(lowered["retry-after-ms"], now)
+        if ms is not None:
+            return ms / 1000.0
+    if "retry-after" in lowered:
+        found = _parse(lowered["retry-after"], now)
+        if found is not None:
+            return found
+    for key in _JSON_MS:
+        if key in data:
+            ms = _parse(data[key], now)
+            if ms is not None:
+                return ms / 1000.0
+    for key in _JSON_SECONDS:
+        if key in data:
+            found = _parse(data[key], now)
+            if found is not None:
+                return found
+    for nested_key in ("error", "details", "metadata"):
+        nested = data.get(nested_key)
+        candidates = nested if isinstance(nested, list) else [nested]
+        for item in candidates:  # pyright: ignore[reportUnknownVariableType]
+            if isinstance(item, Mapping):
+                found = _from_mapping(item, now)  # pyright: ignore[reportUnknownArgumentType]
+                if found is not None:
+                    return found
+    message = data.get("message")
+    if isinstance(message, str):
+        return _from_text(message)
+    return None
+
+
+def backoff(attempt: int, *, rng: random.Random) -> float:
+    """Wait before retry number ``attempt`` (1-based): min(2·2^(n−1), 60) plus up to 50 %."""
+    exponent = max(0, attempt - 1)
+    delay = BACKOFF_MAX if exponent >= 32 else min(BACKOFF_BASE * (2**exponent), BACKOFF_MAX)
+    return delay + rng.uniform(0.0, BACKOFF_JITTER * delay)
+
+
+async def sleep_sliced(clock: Clock, seconds: float, *, slice_seconds: float = SLEEP_SLICE) -> None:
+    """Sleep ``seconds`` on ``clock`` in short slices measured against one deadline."""
+    if seconds <= 0:
+        return
+    deadline = clock.monotonic() + seconds
+    while (left := deadline - clock.monotonic()) > 0:
+        await clock.sleep(min(slice_seconds, left))
+
+
+# -- the retry loop -------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RetryWait:
+    """One wait between attempts. ``announced`` is True when it was reported as it started."""
+
+    attempt: int  # the attempt that failed, 1-based
+    attempts: int  # total attempts allowed
+    seconds: float
+    error: ClassifiedError
+    from_server: bool
+    announced: bool
+
+    def describe(self) -> str:
+        source = "the server asked for" if self.from_server else "backing off"
+        return (
+            f"attempt {self.attempt}/{self.attempts} failed ({self.error.reason}): "
+            f"{self.error.message}; {source} {self.seconds:.1f}s"
+        )
+
+
+class RetryFailed(ProviderError):
+    """Every attempt failed, or the first failure was not worth retrying."""
+
+    def __init__(
+        self,
+        classified: ClassifiedError,
+        *,
+        error: BaseException,
+        attempts: int,
+        waits: tuple[RetryWait, ...],
+    ) -> None:
+        super().__init__(classified.message or classified.reason)
+        self.classified = classified
+        self.error = error
+        self.attempts = attempts
+        self.waits = waits
+
+
+def clamp_max_retries(value: object) -> int:
+    """``agent.api_max_retries``: an integer, at least 1 (bad values give the default 3)."""
+    if isinstance(value, bool) or not isinstance(value, int):
+        return DEFAULT_MAX_RETRIES
+    return max(1, value)
+
+
+async def retry_call[T](
+    fn: Callable[[], Awaitable[T]],
+    *,
+    max_retries: int = DEFAULT_MAX_RETRIES,
+    clock: Clock,
+    on_wait: Callable[[RetryWait], object] | None = None,
+    classify: Callable[[BaseException], ClassifiedError] | None = None,
+    rng: random.Random | None = None,
+) -> T:
+    """Call ``fn`` until it succeeds, a failure is not retryable, or the attempts run out.
+
+    Waits up to 60 s are buffered and handed to ``on_wait`` only when every attempt failed; a
+    longer wait is handed over as it starts. Cancellation during a wait propagates at once.
+    """
+    if classify is None:
+        from indus.providers.classify import classify as default_classify
+
+        classify = default_classify
+    rng = rng if rng is not None else random.Random()
+    retries = max(1, max_retries)
+    total = retries + 1
+    buffered: list[RetryWait] = []
+    waits: list[RetryWait] = []
+    attempt = 0
+    while True:
+        attempt += 1
+        try:
+            return await fn()
+        except RetryFailed:
+            raise
+        except _RETRYABLE_TYPES as exc:  # anything else is a bug and propagates untouched
+            error: BaseException = exc
+        verdict = classify(error)
+        if not verdict.retryable or attempt >= total:
+            for wait in buffered:
+                _emit(on_wait, wait)
+            log.info(
+                "model call failed after %d attempt(s): %s (%s)",
+                attempt,
+                verdict.reason,
+                verdict.message,
+            )
+            raise RetryFailed(verdict, error=error, attempts=attempt, waits=tuple(waits)) from error
+        from_server = verdict.retry_after is not None
+        seconds = (
+            verdict.retry_after if verdict.retry_after is not None else backoff(attempt, rng=rng)
+        )
+        announce = seconds > ANNOUNCE_AFTER
+        wait = RetryWait(attempt, total, seconds, verdict, from_server, announce)
+        waits.append(wait)
+        log.debug("%s", wait.describe())
+        if announce:
+            _emit(on_wait, wait)
+        else:
+            buffered.append(wait)
+        await sleep_sliced(clock, seconds)
+
+
+# Failures a model call can legitimately produce; the classifier decides which are retried.
+_RETRYABLE_TYPES = (ProviderError, httpx.HTTPError, OSError, TimeoutError)
+
+
+def _emit(on_wait: Callable[[RetryWait], object] | None, wait: RetryWait) -> None:
+    if on_wait is None:
+        return
+    try:
+        on_wait(wait)
+    except Exception:  # a display hook must never break the call
+        log.debug("retry wait callback failed", exc_info=True)
+
+
+__all__ = [
+    "ANNOUNCE_AFTER",
+    "RETRY_AFTER_CAP",
+    "RetryFailed",
+    "RetryWait",
+    "backoff",
+    "clamp_max_retries",
+    "parse_retry_after",
+    "retry_call",
+    "sleep_sliced",
+]
diff --git a/src/indus/providers/streaming.py b/src/indus/providers/streaming.py
new file mode 100644
index 0000000..80853d1
--- /dev/null
+++ b/src/indus/providers/streaming.py
@@ -0,0 +1,600 @@
+"""Run one model call as a stream and decide what to do when the stream goes wrong.
+
+``stream_call`` sends the request, feeds the parsed events to ``on_event`` and returns the
+assembled response. Around that it handles:
+
+- **writer tokens** — each attempt owns a token; events of an attempt we gave up on are
+  discarded and counted, never delivered;
+- **stale detection** — a watchdog on the injected clock aborts an attempt that delivers no
+  content (keep-alive frames do not count) within the stale timeout of the ``TimeoutPolicy``;
+- **reconnects** — an attempt that failed before anything visible was shown is retried up to
+  ``stream_retries`` more times (default 2) after 1 s, 2 s, 4 s pauses; a 400 rejecting
+  ``stream_options`` gets one extra retry without it that costs nothing from that budget;
+- **route changes** — if the route epoch moved while the call ran, nothing is replayed and
+  ``RouteChanged`` is returned so the turn loop rebuilds the request (R01.5);
+- **the breaker** — consecutive silent attempts are counted in a ``StaleStreak`` the caller keeps
+  per route; at the threshold calls fail at once with ``StaleBreakerTripped``;
+- **partial delivery** — once text was shown, a failure becomes a ``length`` stub holding that
+  text, with mid-stream tool calls dropped and named, never run; a context overflow becomes an
+  empty terminal stub instead (R01.6);
+- **non-streaming fallback** — a provider that rejects streaming, or sends only keep-alive frames,
+  flips ``StreamFlags.streaming`` off and the call is redone once without streaming;
+- **cancellation** — the stream is closed and ``CancelledError`` propagates; nothing partial is
+  returned as a reply (R01.4).
+
+Errors before anything visible propagate to the caller (``retry_call``, P03-16).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import inspect
+import json
+import logging
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass, field, replace
+from typing import TYPE_CHECKING, Any
+from urllib.parse import urlsplit
+
+import httpx
+
+from indus.foundation.errors import (
+    ProviderError,
+    ProviderHTTPError,
+    ProviderStreamError,
+    StaleBreakerTripped,
+)
+from indus.foundation.redact import redact_text
+from indus.providers.classify import ClassifiedError, route_key
+from indus.providers.classify import classify as default_classify
+from indus.providers.retry import parse_retry_after, sleep_sliced
+from indus.providers.sse import aiter_sse
+from indus.providers.types import (
+    ChatRequest,
+    Finish,
+    KeepAlive,
+    NormalizedResponse,
+    ReasoningDelta,
+    TextDelta,
+    ToolCallArgsDelta,
+    ToolCallStart,
+    UsageReport,
+    assemble,
+)
+
+if TYPE_CHECKING:
+    from indus.foundation.clock import Clock
+    from indus.providers.timeouts import CallTimeouts, TimeoutPolicy
+
+log = logging.getLogger(__name__)
+
+RECONNECT_PAUSES = (1.0, 2.0, 4.0)
+PAUSE_SLICE = 0.1
+MAX_NAMED_DROPPED = 3
+# Verdicts a fresh connection can fix; HTTP status errors go to retry_call with their waits.
+RECONNECT_REASONS = frozenset({"timeout", "connection", "incomplete_response"})
+_CAUGHT = (httpx.HTTPError, ProviderError, OSError)
+
+
+@dataclass
+class StreamFlags:
+    """Per-route session switches the driver may turn off (kept by the caller)."""
+
+    streaming: bool = True
+    stream_options: bool = True
+
+
+@dataclass
+class StaleStreak:
+    """Consecutive attempts that went silent; reset by any answer or a route change."""
+
+    count: int = 0
+
+    def bump(self) -> int:
+        self.count += 1
+        return self.count
+
+    def reset(self) -> None:
+        self.count = 0
+
+
+@dataclass(frozen=True)
+class CallResult:
+    response: NormalizedResponse
+    stub: bool = False  # a length stub built from text shown before the stream failed
+    stub_terminal: bool = False  # the failure was a context overflow: end the turn
+    dropped_tools: tuple[str, ...] = ()  # up to 3 names of mid-stream tool calls not run
+    dropped_tool_count: int = 0
+    streamed: bool = True
+    attempts: int = 1
+    requests: int = 1
+    discarded_events: int = 0
+    error: ClassifiedError | None = None  # why a stub was needed
+
+
+@dataclass(frozen=True)
+class RouteChanged:
+    """The route moved while the call ran; the caller rebuilds the request for the new route."""
+
+    error: ClassifiedError | None
+    attempts: int
+    requests: int
+
+
+CallOutcome = CallResult | RouteChanged
+
+
+@dataclass
+class _Writer:
+    """The single-writer token: only the current attempt's events are delivered."""
+
+    token: int = 0
+    discarded: int = 0
+
+    def claim(self) -> int:
+        self.token += 1
+        return self.token
+
+    def release(self, token: int) -> None:
+        if token == self.token:
+            self.token += 1
+
+    def owns(self, token: int) -> bool:
+        return token == self.token
+
+
+@dataclass
+class _Attempt:
+    token: int
+    events: list[Any] = field(default_factory=list)
+    text: list[str] = field(default_factory=list)
+    tools: dict[int, str] = field(default_factory=dict)
+    visible: bool = False
+    content_events: int = 0
+    keepalives: int = 0
+    finished: bool = False
+    stale: bool = False
+    error: BaseException | None = None
+
+
+class _Call:
+    def __init__(
+        self,
+        client: httpx.AsyncClient,
+        transport: Any,
+        route: Any,
+        clock: Clock,
+        on_event: Callable[[Any], object],
+    ) -> None:
+        self.client = client
+        self.transport = transport
+        self.route = route
+        self.clock = clock
+        self.on_event = on_event
+        self.writer = _Writer()
+        self.attempts = 0
+        self.requests = 0
+
+    async def deliver(self, event: Any) -> None:
+        result = self.on_event(event)
+        if inspect.isawaitable(result):
+            await result
+
+    # -- one streamed attempt --------------------------------------------------------------------
+
+    async def attempt(self, request: httpx.Request, timeouts: CallTimeouts) -> _Attempt:
+        self.attempts += 1
+        self.requests += 1
+        att = _Attempt(self.writer.claim())
+        last_content = [self.clock.monotonic()]
+        reader = asyncio.ensure_future(self._read(att, request, last_content))
+        watchdog = (
+            asyncio.ensure_future(self._watch(att, reader, last_content, timeouts.stale))
+            if timeouts.stale is not None
+            else None
+        )
+        try:
+            await asyncio.wait({reader})
+        except asyncio.CancelledError:
+            self.writer.release(att.token)
+            reader.cancel()
+            if watchdog is not None:
+                watchdog.cancel()
+            await _settle(reader, watchdog)
+            raise
+        finally:
+            if watchdog is not None:
+                watchdog.cancel()
+        self.writer.release(att.token)
+        if watchdog is not None:
+            await _settle(watchdog)
+        if reader.cancelled():
+            # Only the watchdog cancels the reader without cancelling us; it set ``stale``.
+            att.error = att.error or _stale_error(self.route)
+        else:
+            reader.result()  # re-raises anything that is not a provider failure (a bug)
+        if att.error is None and not att.stale and not att.finished:
+            att.error = _stream_error(
+                "the stream ended before the model finished", "incomplete_stream"
+            )
+        return att
+
+    async def _watch(
+        self, att: _Attempt, reader: asyncio.Future[None], last: list[float], stale: float
+    ) -> None:
+        while not reader.done():
+            due = last[0] + stale
+            now = self.clock.monotonic()
+            if now >= due:
+                att.stale = True
+                self.writer.release(att.token)
+                log.warning(
+                    "no content from %s for %.0fs (limit %.0fs); aborting this attempt",
+                    _host(self.route),
+                    now - last[0],
+                    stale,
+                )
+                reader.cancel()
+                return
+            await self.clock.sleep(due - now)
+
+    async def _read(self, att: _Attempt, request: httpx.Request, last: list[float]) -> None:
+        response: httpx.Response | None = None
+        try:
+            response = await self.client.send(request, stream=True)
+            if response.status_code >= 400:
+                await response.aread()
+                raise http_error(response, self.clock, self.route)
+            async for event in self.transport.parse_stream(aiter_sse(response)):
+                if not self.writer.owns(att.token):
+                    self.writer.discarded += 1
+                    continue
+                if isinstance(event, KeepAlive):
+                    att.keepalives += 1
+                    continue
+                last[0] = self.clock.monotonic()
+                att.content_events += 1
+                att.events.append(event)
+                if isinstance(event, TextDelta):
+                    att.text.append(event.text)
+                    att.visible = att.visible or bool(event.text.strip())
+                elif isinstance(event, ToolCallStart):
+                    if event.name or event.index not in att.tools:
+                        att.tools[event.index] = event.name
+                elif isinstance(event, Finish):
+                    att.finished = True
+                await self.deliver(event)
+        except asyncio.CancelledError:
+            if not att.stale:
+                raise
+            att.error = att.error or _stale_error(self.route)
+        except _CAUGHT as exc:
+            att.error = exc
+        finally:
+            if response is not None:
+                await response.aclose()
+        if att.stale and att.error is None:
+            att.error = _stale_error(self.route)
+
+    # -- the non-streaming call ------------------------------------------------------------------
+
+    async def non_stream(
+        self, request: httpx.Request, timeouts: CallTimeouts
+    ) -> NormalizedResponse:
+        self.attempts += 1
+        self.requests += 1
+        token = self.writer.claim()
+
+        async def send() -> httpx.Response:
+            response = await self.client.send(request)
+            if response.status_code >= 400:
+                raise http_error(response, self.clock, self.route)
+            return response
+
+        task = asyncio.ensure_future(send())
+        timer = (
+            asyncio.ensure_future(self.clock.sleep(timeouts.stale))
+            if timeouts.stale is not None
+            else None
+        )
+        try:
+            waiting = {task} if timer is None else {task, timer}
+            await asyncio.wait(waiting, return_when=asyncio.FIRST_COMPLETED)
+        except asyncio.CancelledError:
+            task.cancel()
+            await _settle(task, timer)
+            raise
+        if not task.done():
+            task.cancel()
+            await _settle(task, timer)
+            raise httpx.ReadTimeout(
+                f"no answer from {_host(self.route)} within {timeouts.stale:.0f}s", request=request
+            )
+        if timer is not None:
+            timer.cancel()
+            await _settle(timer)
+        response = task.result()
+        normalized = self.transport.parse_response(response.json())
+        if self.writer.owns(token):
+            for event in _events_of(normalized):
+                await self.deliver(event)
+        self.writer.release(token)
+        return normalized
+
+
+async def stream_call(
+    client: httpx.AsyncClient,
+    transport: Any,
+    route: Any,
+    req: ChatRequest,
+    *,
+    policy: TimeoutPolicy,
+    clock: Clock,
+    on_event: Callable[[Any], object | Awaitable[object]],
+    route_epoch: Callable[[], object],
+    flags: StreamFlags | None = None,
+    streak: StaleStreak | None = None,
+    classify: Callable[[BaseException], ClassifiedError] | None = None,
+    est_prompt_tokens: int | None = None,
+    reasoning: bool | None = None,
+) -> CallOutcome:
+    flags = flags if flags is not None else StreamFlags()
+    streak = streak if streak is not None else StaleStreak()
+
+    def judge(err: BaseException) -> ClassifiedError:
+        if classify is not None:
+            return classify(err)
+        return default_classify(err, route=route, clock=clock)
+
+    epoch = route_epoch()
+    thinking = bool(req.reasoning_effort) if reasoning is None else reasoning
+    call = _Call(client, transport, route, clock, on_event)
+    first = transport.build_request(route, replace(req, stream=flags.streaming))
+    tokens = est_prompt_tokens if est_prompt_tokens is not None else len(first.content) // 4
+    stream_t = policy.for_call(route, tokens, streaming=True, reasoning=thinking)
+    threshold = stream_t.breaker_threshold
+    if threshold and streak.count >= threshold:
+        raise StaleBreakerTripped(_breaker_message(streak.count))
+
+    async def without_streaming() -> CallResult:
+        flags.streaming = False
+        call_t = policy.for_call(route, tokens, streaming=False, reasoning=thinking)
+        request = transport.build_request(route, replace(req, stream=False))
+        normalized = await call.non_stream(_with_read_timeout(client, request, call_t), call_t)
+        streak.reset()
+        return _result(call, normalized, streamed=False)
+
+    if not flags.streaming:
+        return await without_streaming()
+
+    reconnects = 0
+    compat_used = False
+    request = first
+    while True:
+        if not flags.stream_options:
+            request = _without_stream_options(request)
+        att = await call.attempt(_with_read_timeout(client, request, stream_t), stream_t)
+        if att.error is None:
+            streak.reset()
+            return _result(call, assemble(att.events), streamed=True)
+        err = att.error
+        if att.visible:
+            # Text reached the caller: never retry (it would repeat), hand back what was shown.
+            streak.reset()
+            return _stub(call, att, judge(err))
+        if att.stale:
+            count = streak.bump()
+            if threshold and count >= threshold:
+                raise StaleBreakerTripped(_breaker_message(count)) from err
+        verdict = judge(err)
+        if route_epoch() != epoch:
+            log.warning("route changed during the call; not replaying it on the new route")
+            return RouteChanged(verdict, call.attempts, call.requests)
+        if not compat_used and _compat_retry(transport, route, flags, err):
+            # The request shape changed for this route; one extra try outside the budget.
+            compat_used = True
+            request = transport.build_request(route, replace(req, stream=True))
+            continue
+        keepalive_only = att.keepalives > 0 and att.content_events == 0
+        if verdict.reason == "stream_unsupported" or keepalive_only:
+            log.warning(
+                "%s did not stream (%s); switching this route to non-streaming",
+                _host(route),
+                "keep-alive frames only" if keepalive_only else verdict.message,
+            )
+            return await without_streaming()
+        if (
+            att.stale or verdict.reason in RECONNECT_REASONS
+        ) and reconnects < stream_t.stream_retries:
+            pause = RECONNECT_PAUSES[min(reconnects, len(RECONNECT_PAUSES) - 1)]
+            reconnects += 1
+            log.info(
+                "stream attempt %d failed (%s); reconnecting in %.0fs",
+                call.attempts,
+                "stale" if att.stale else verdict.reason,
+                pause,
+            )
+            await sleep_sliced(clock, pause, slice_seconds=PAUSE_SLICE)
+            request = transport.build_request(route, replace(req, stream=True))
+            continue
+        raise err
+
+
+# -- helpers --------------------------------------------------------------------------------------
+
+
+def _result(call: _Call, response: NormalizedResponse, *, streamed: bool) -> CallResult:
+    return CallResult(
+        response=response,
+        streamed=streamed,
+        attempts=call.attempts,
+        requests=call.requests,
+        discarded_events=call.writer.discarded,
+    )
+
+
+def _stub(call: _Call, att: _Attempt, verdict: ClassifiedError) -> CallResult:
+    names = [att.tools[i] for i in sorted(att.tools)]
+    terminal = verdict.reason == "context_overflow"
+    content = None if terminal else "".join(att.text)
+    if names:
+        log.warning(
+            "stream failed mid tool call (%s); the call(s) were dropped and not run",
+            ", ".join(names[:MAX_NAMED_DROPPED]),
+        )
+    response = NormalizedResponse(
+        content=content,
+        tool_calls=(),
+        finish_reason="length",
+        reasoning=None,
+        reasoning_details=(),
+        usage=None,
+        provider_data={},
+    )
+    return CallResult(
+        response=response,
+        stub=True,
+        stub_terminal=terminal,
+        dropped_tools=tuple(names[:MAX_NAMED_DROPPED]),
+        dropped_tool_count=len(names),
+        streamed=True,
+        attempts=call.attempts,
+        requests=call.requests,
+        discarded_events=call.writer.discarded,
+        error=verdict,
+    )
+
+
+def _events_of(response: NormalizedResponse) -> list[Any]:
+    """The events a non-streamed answer stands for, so consumers see one shape."""
+    events: list[Any] = []
+    if response.reasoning:
+        events.append(ReasoningDelta(response.reasoning))
+    if response.content:
+        events.append(TextDelta(response.content))
+    for index, call in enumerate(response.tool_calls):
+        events.append(ToolCallStart(index, call.id, call.name))
+        events.append(ToolCallArgsDelta(index, call.arguments))
+    if response.usage is not None:
+        events.append(UsageReport(response.usage))
+    events.append(Finish(response.finish_reason))
+    return events
+
+
+def http_error(response: httpx.Response, clock: Clock, route: Any = None) -> ProviderHTTPError:
+    """``ProviderHTTPError`` for an error answer whose body has been read.
+
+    The route's key is masked out of the body and message (a server may echo it back).
+    """
+    key = route_key(route)
+    text = redact_text(response.text, [key] if key else [])
+    try:
+        body: Any = json.loads(text) if text.strip() else text
+    except ValueError:
+        body = text
+    headers = {k.lower(): v for k, v in response.headers.items()}
+    detail = body.get("error", body) if isinstance(body, dict) else body
+    if isinstance(detail, dict):
+        detail = detail.get("message") or json.dumps(detail)[:300]
+    summary = str(detail).strip().replace("\n", " ")[:300]
+    return ProviderHTTPError(
+        f"HTTP {response.status_code} from {response.request.url.host}: {summary}",
+        status=response.status_code,
+        body=body,
+        headers=headers,
+        retry_after=parse_retry_after(headers, now=clock.now()),
+    )
+
+
+def _compat_retry(transport: Any, route: Any, flags: StreamFlags, err: BaseException) -> bool:
+    """Whether a rejected request should be sent once more in a changed shape.
+
+    A transport with an ``on_request_rejected`` hook (P03-06) decides and remembers the change
+    itself; otherwise a 400/422 naming ``stream_options`` turns that option off in ``flags``.
+    """
+    if not isinstance(err, ProviderHTTPError):
+        return False
+    hook = getattr(transport, "on_request_rejected", None)
+    if callable(hook):
+        return bool(hook(route, err))
+    if not flags.stream_options or err.status not in (400, 422):
+        return False
+    text = err.body if isinstance(err.body, str) else json.dumps(err.body, default=str)
+    if "stream_options" not in f"{err.message} {text}":
+        return False
+    log.info("endpoint rejected stream_options; retrying once without it")
+    flags.stream_options = False
+    return True
+
+
+def _without_stream_options(request: httpx.Request) -> httpx.Request:
+    try:
+        body = json.loads(request.content)
+    except ValueError:
+        return request
+    if not isinstance(body, dict) or "stream_options" not in body:
+        return request
+    body.pop("stream_options")
+    headers = {k: v for k, v in request.headers.items() if k.lower() != "content-length"}
+    rebuilt = httpx.Request(request.method, request.url, headers=headers, content=json.dumps(body))
+    rebuilt.extensions = dict(request.extensions)
+    return rebuilt
+
+
+def _with_read_timeout(
+    client: httpx.AsyncClient, request: httpx.Request, timeouts: CallTimeouts
+) -> httpx.Request:
+    """Apply the client's timeouts with the read timeout raised to this call's value."""
+    if "timeout" in request.extensions:
+        return request
+    base = client.timeout
+    read = base.read
+    if read is not None:
+        read = max(read, timeouts.read)
+    request.extensions = {
+        **request.extensions,
+        "timeout": httpx.Timeout(
+            connect=base.connect, read=read, write=base.write, pool=base.pool
+        ).as_dict(),
+    }
+    return request
+
+
+def _stream_error(message: str, code: str) -> ProviderStreamError:
+    return ProviderStreamError(message, body={"error": {"message": message, "code": code}})
+
+
+def _stale_error(route: Any) -> ProviderStreamError:
+    return _stream_error(f"no content from {_host(route)} within the stale timeout", "stale_stream")
+
+
+def _breaker_message(count: int) -> str:
+    return (
+        f"the provider stayed silent on {count} attempts in a row; "
+        "switch the model or provider, or start a new session, then try again"
+    )
+
+
+def _host(route: Any) -> str:
+    try:
+        return urlsplit(str(getattr(route, "base_url", ""))).hostname or "the provider"
+    except ValueError:
+        return "the provider"
+
+
+async def _settle(*futures: asyncio.Future[Any] | None) -> None:
+    """Wait for cancelled helpers to finish unwinding; their errors are already recorded."""
+    pending = [f for f in futures if f is not None]
+    if pending:
+        await asyncio.gather(*pending, return_exceptions=True)
+
+
+__all__ = [
+    "CallOutcome",
+    "CallResult",
+    "RouteChanged",
+    "StaleStreak",
+    "StreamFlags",
+    "http_error",
+    "stream_call",
+]
