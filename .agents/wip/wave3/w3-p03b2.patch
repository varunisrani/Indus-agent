+
+  # -- errors inside a stream (no status) ----------------------------------------------------
+  - id: stream-anthropic-overloaded
+    stream: error_event
+    body: {error: {type: overloaded_error, message: "Overloaded"}}
+    expect: {reason: overloaded, retryable: true}
+  - id: stream-openai-overflow-message
+    stream: error_event
+    body: {error: {message: "This model's maximum context length is 8192 tokens."}}
+    expect: {reason: context_overflow, should_compress: true}
+  - id: stream-plain-text-rate-limit
+    stream: non_json
+    body: {error: {message: "rate limit exceeded, retry after 3 seconds"}}
+    expect: {reason: rate_limit, retry_after: 3.0}
+  - id: stream-usage-limit-no-reset
+    stream: error_event
+    body: {error: {message: "Weekly usage limit reached."}}
+    expect: {reason: billing}
+  - id: stream-auth
