+
+def test_breaker_disabled_with_zero() -> None:
+    stall = [{"stall": 200}]
+    h = Harness(script(*[stall] * 6), policy=TimeoutPolicy(breaker_threshold=0))
+    results = h.run(2)
+    assert all(isinstance(r, ProviderStreamError) for r in results)
