+                {"text": "plain answer"},
+                {"usage": {"prompt": 5, "completion": 2}},
+                {"finish": "stop"},
+            ],
+            [{"text": "again"}, {"finish": "stop"}],
+        )
+    )
+    first, second = h.run(2)
+    assert isinstance(first, CallResult) and not first.streamed
+    assert first.response.content == "plain answer"
