@@ -0,0 +1,143 @@
+"""The provider profiles that ship with Indus Agent, in catalogue order.
+
+Catalogue order is the order ``auto`` uses to pick the first provider with a usable key. Only
+providers reachable with an API key are bundled (D-16.42); there is no portal provider (D-16.12)
+and no route that borrows another product's identity (D-16.11, R01.12).
+
+Base URLs and key names are third-party facts. Each row cites the vendor page that states them
+(checked 2026-10-18); re-check a row against its page before changing it.
+"""
+
+from __future__ import annotations
+
+from indus.providers.profile import ProviderProfile
+
+# fmt: off
+PROFILES: tuple[ProviderProfile, ...] = (
+    # https://openrouter.ai/docs/quickstart (2026-10-18)
+    ProviderProfile(
+        name="openrouter", aliases=("or",), display_name="OpenRouter",
+        description="aggregator: many vendors' models behind one key",
+        base_url="https://openrouter.ai/api/v1", env_vars=("OPENROUTER_API_KEY",),
+        supports_vision=True,
+    ),
+    # https://github.com/openai/openai-python README and client defaults (2026-10-18).
+    # Chat completions until P08 adds the Responses transport.
+    ProviderProfile(
+        name="openai", aliases=("openai-api",), display_name="OpenAI",
+        description="OpenAI API",
+        base_url="https://api.openai.com/v1", env_vars=("OPENAI_API_KEY",),
+        max_tokens_param="max_completion_tokens", supports_vision=True,
+        reasoning_models=("o1", "o3", "o4", "gpt-5"),
+    ),
+    # https://docs.anthropic.com/en/api/overview (2026-10-18)
+    ProviderProfile(
+        name="anthropic", aliases=("claude",), display_name="Anthropic",
+        description="Anthropic Messages API",
+        base_url="https://api.anthropic.com", api_mode="anthropic_messages",
+        env_vars=("ANTHROPIC_API_KEY",),
+        supports_vision=True, supports_model_listing=False,
+    ),
+    # https://api-docs.deepseek.com/ (2026-10-18)
+    ProviderProfile(
+        name="deepseek", display_name="DeepSeek", description="DeepSeek API",
+        base_url="https://api.deepseek.com/v1", env_vars=("DEEPSEEK_API_KEY",),
+        reasoning_models=("reasoner",),
+    ),
+    # https://docs.x.ai/docs/api-reference (2026-10-18)
+    ProviderProfile(
+        name="xai", aliases=("grok",), display_name="xAI", description="xAI Grok API",
+        base_url="https://api.x.ai/v1", env_vars=("XAI_API_KEY",), supports_vision=True,
+    ),
+    # https://docs.mistral.ai/api/ (2026-10-18)
+    ProviderProfile(
+        name="mistral", display_name="Mistral AI", description="Mistral La Plateforme API",
+        base_url="https://api.mistral.ai/v1", env_vars=("MISTRAL_API_KEY",),
+    ),
+    # https://huggingface.co/docs/inference-providers/index (2026-10-18)
+    ProviderProfile(
+        name="huggingface", aliases=("hf",), display_name="Hugging Face",
+        description="Hugging Face inference providers router",
+        base_url="https://router.huggingface.co/v1", env_vars=("HF_TOKEN",),
+    ),
+    # https://docs.api.nvidia.com/nim/reference/llm-apis (2026-10-18)
+    ProviderProfile(
+        name="nvidia", aliases=("nim",), display_name="NVIDIA NIM",
+        description="NVIDIA hosted NIM endpoints",
+        base_url="https://integrate.api.nvidia.com/v1", env_vars=("NVIDIA_API_KEY",),
+    ),
+    # https://docs.z.ai/guides/develop/openai/python (2026-10-18)
+    ProviderProfile(
+        name="zai", aliases=("glm",), display_name="Z.ai", description="Z.ai GLM API",
+        base_url="https://api.z.ai/api/paas/v4", env_vars=("ZAI_API_KEY", "GLM_API_KEY"),
+    ),
+    # https://platform.moonshot.ai/docs/guide/start-using-kimi-api (2026-10-18)
+    ProviderProfile(
+        name="kimi-coding", aliases=("kimi", "moonshot"), display_name="Kimi (Moonshot AI)",
+        description="Moonshot AI Kimi API",
+        base_url="https://api.moonshot.ai/v1", env_vars=("MOONSHOT_API_KEY", "KIMI_API_KEY"),
+    ),
+    # https://platform.minimax.io/docs/api-reference/text-anthropic-api (2026-10-18)
+    ProviderProfile(
+        name="minimax", display_name="MiniMax", description="MiniMax (Anthropic-compatible API)",
+        base_url="https://api.minimax.io/anthropic", api_mode="anthropic_messages",
+        env_vars=("MINIMAX_API_KEY",), supports_model_listing=False,
+    ),
+    # https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope
+    # (2026-10-18; international endpoint)
+    ProviderProfile(
+        name="alibaba", aliases=("dashscope", "qwen"), display_name="Alibaba Cloud Model Studio",
+        description="Qwen models through DashScope (international)",
+        base_url="https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
+        env_vars=("DASHSCOPE_API_KEY",),
+    ),
+    # https://vercel.com/docs/ai-gateway/openai-compat (2026-10-18)
+    ProviderProfile(
+        name="ai-gateway", aliases=("vercel",), display_name="Vercel AI Gateway",
+        description="Vercel AI Gateway",
+        base_url="https://ai-gateway.vercel.sh/v1", env_vars=("AI_GATEWAY_API_KEY",),
+    ),
+    # https://docs.ollama.com/cloud (2026-10-18)
+    ProviderProfile(
+        name="ollama-cloud", display_name="Ollama Cloud", description="Ollama's hosted models",
+        base_url="https://ollama.com/v1", env_vars=("OLLAMA_API_KEY",),
+    ),
+    # https://lmstudio.ai/docs/app/api/endpoints/openai (2026-10-18; default port 1234)
+    ProviderProfile(
+        name="lmstudio", aliases=("lm-studio",), display_name="LM Studio",
+        description="LM Studio local server", family="custom", auto_detect=False,
+        base_url="http://127.0.0.1:1234/v1", auth_type="api_key_optional",
+        env_vars=("LM_API_KEY",), base_url_env_var="LM_BASE_URL",
+    ),
+    # Any OpenAI-compatible endpoint the user names. The generic OPENAI_API_KEY belongs here
+    # (never to another vendor's host); OPENAI_BASE_URL is read only when config names no URL.
+    ProviderProfile(
+        name="custom", display_name="Custom endpoint",
+        description="any OpenAI-compatible endpoint", family="custom", auto_detect=False,
+        auth_type="api_key_optional", env_vars=("OPENAI_API_KEY",),
+        base_url_env_var="OPENAI_BASE_URL",
+    ),
+)
+# fmt: on
+
+
+def by_name() -> dict[str, ProviderProfile]:
+    """Canonical name → profile (aliases not included)."""
+    return {p.name: p for p in PROFILES}
+
+
+def env_var_names() -> tuple[str, ...]:
+    """Every key and base-URL env name the bundled profiles read, in catalogue order."""
+    seen: dict[str, None] = {}
+    for profile in PROFILES:
+        for name in (*profile.env_vars, profile.base_url_env_var):
+            if name:
+                seen.setdefault(name, None)
+    return tuple(seen)
+
+
+def register_managed_env_names() -> None:
+    """Tell the ``.env`` loader these names are ours, so a key removed from ``.env`` is cleared."""
+    from indus.foundation.envload import register_managed_keys
+
+    register_managed_keys(*env_var_names())
diff --git a/src/indus/providers/context_length.py b/src/indus/providers/context_length.py
new file mode 100644
index 0000000..9d88a4a
--- /dev/null
+++ b/src/indus/providers/context_length.py
@@ -0,0 +1,329 @@
+"""How many tokens the model behind a route can hold.
+
+Order (first answer wins): a config override; the profile's own hook or hint; the persistent cache
+of provider-confirmed values; the live ``/models`` list of a custom or local endpoint; our family
+table; 256,000 with one warning per (model, base URL). Windows below 64,000 tokens are refused
+(``ContextTooSmall``): sessions and model switches need that much working room (A35).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import threading
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.errors import ContextTooSmall
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.scope import Scope
+from indus.providers.model_list import ModelInfo
+from indus.providers.route import RuntimeRoute
+from indus.providers.settings import (
+    as_mapping,
+    config_of,
+    model_entry,
+    model_section,
+    positive_int,
+    provider_entry,
+    text,
+)
+
+log = logging.getLogger(__name__)
+
+MIN_CONTEXT = 64_000
+FALLBACK_CONTEXT = 256_000
+SANE_RANGE = (1_024, 10_000_000)
+CACHE_DIR = "cache"
+CACHE_FILE = "context_lengths.json"
+CACHE_VERSION = 1
+# Only values a provider told us are persisted; table guesses and the fallback never are.
+CONFIRMED_SOURCES = frozenset({"endpoint", "provider-error"})
+
+SOURCE_CONFIG = "config"
+SOURCE_PROFILE = "profile"
+SOURCE_CACHE = "cache"
+SOURCE_ENDPOINT = "endpoint"
+SOURCE_FAMILY = "family"
+SOURCE_FALLBACK = "fallback"
+
+# Context windows by model family, matched by the longest key contained in the lowercased model
+# id. Values come from the vendors' model pages (checked 2026-10-18):
+#   Anthropic  https://docs.anthropic.com/en/docs/about-claude/models/overview
+#   OpenAI     https://platform.openai.com/docs/models
+#   DeepSeek   https://api-docs.deepseek.com/quick_start/pricing
+#   xAI        https://docs.x.ai/docs/models
+#   Google     https://ai.google.dev/gemini-api/docs/models
+#   Mistral    https://docs.mistral.ai/getting-started/models/
+#   Qwen       https://www.alibabacloud.com/help/en/model-studio/models
+#   Moonshot   https://platform.moonshot.ai/docs/introduction
+#   Z.ai       https://docs.z.ai/guides/overview/pricing
+#   MiniMax    https://platform.minimax.io/docs/guides/models-intro
+#   Meta       https://www.llama.com/docs/model-cards-and-prompt-formats/
+FAMILY_TABLE: dict[str, int] = {
+    "claude": 200_000,
+    "gpt-4o": 128_000,
+    "gpt-4.1": 1_047_576,
+    "gpt-5": 400_000,
+    "gpt-oss": 131_072,
+    "o1": 200_000,
+    "o3": 200_000,
+    "o4-mini": 200_000,
+    "deepseek": 128_000,
+    "grok-3": 131_072,
+    "grok-4": 256_000,
+    "gemini": 1_048_576,
+    "mistral-large": 128_000,
+    "mistral-medium": 128_000,
+    "codestral": 256_000,
+    "qwen3": 131_072,
+    "qwen3-coder": 262_144,
+    "kimi-k2": 262_144,
+    "glm-4.5": 131_072,
+    "glm-4.6": 200_000,
+    "minimax-m2": 204_800,
+    "llama-3.1": 131_072,
+    "llama-3.3": 131_072,
+}
+
+ListModels = Callable[[RuntimeRoute], Awaitable[list[ModelInfo]]]
+
+
+@dataclass(frozen=True)
+class ContextWindow:
+    tokens: int
+    source: str
+
+
+_warn_lock = threading.Lock()
+_warned: set[tuple[str, str]] = set()
+
+
+def reset_warnings() -> None:
+    """Forget which fallbacks were warned about (tests)."""
+    with _warn_lock:
+        _warned.clear()
+
+
+def _warn_fallback(model: str, base_url: str) -> None:
+    key = (model, base_url)
+    with _warn_lock:
+        if key in _warned:
+            return
+        _warned.add(key)
+    log.warning(
+        "the context window of %s at %s is unknown; assuming %s tokens "
+        "(set model.context_length to override)",
+        model,
+        base_url,
+        f"{FALLBACK_CONTEXT:,}",
+    )
+
+
+def _sane(value: object) -> int | None:
+    number = positive_int(value)
+    if number is None or not (SANE_RANGE[0] <= number <= SANE_RANGE[1]):
+        return None
+    return number
+
+
+# -- cache --------------------------------------------------------------------------------------
+
+
+def cache_path(scope: Scope) -> Path:
+    return scope.home / CACHE_DIR / CACHE_FILE
+
+
+def _cache_key(base_url: str, model: str) -> str:
+    return f"{base_url.rstrip('/')}|{model}"
+
+
+def _read_entries(path: Path) -> dict[str, Any]:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return {}
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        log.warning("ignored the context length cache %s: %s", path, exc)
+        return {}
+    document = as_mapping(data)
+    if document.get("version") != CACHE_VERSION:
+        return {}
+    return dict(as_mapping(document.get("entries")))
+
+
+def cached_length(scope: Scope, base_url: str, model: str) -> int | None:
+    """A provider-confirmed window from the cache, checked for sanity; None otherwise."""
+    entry = as_mapping(_read_entries(cache_path(scope)).get(_cache_key(base_url, model)))
+    if entry.get("source") not in CONFIRMED_SOURCES:
+        return None
+    return _sane(entry.get("tokens"))
+
+
+def remember(
+    scope: Scope, base_url: str, model: str, tokens: int, *, source: str = "provider-error"
+) -> bool:
+    """Persist a window the provider confirmed (its ``/models`` or an overflow error).
+
+    Returns False (and writes nothing) for an unconfirmed source or an implausible value.
+    """
+    if source not in CONFIRMED_SOURCES or _sane(tokens) is None or not model.strip():
+        return False
+    path = cache_path(scope)
+    entries = _read_entries(path)
+    entries[_cache_key(base_url, model)] = {
+        "tokens": tokens,
+        "source": source,
+        "at": scope.clock.now().isoformat(),
+    }
+    try:
+        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        atomic_write_json(path, {"version": CACHE_VERSION, "entries": entries}, mode=0o600)
+    except OSError as exc:
+        log.warning("could not save the context length cache %s: %s", path, exc)
+        return False
+    return True
+
+
+# -- resolution ---------------------------------------------------------------------------------
+
+
+def family_length(model: str) -> int | None:
+    """The family-table window for ``model`` (longest matching key), or None."""
+    lowered = model.lower()
+    best = ""
+    for key in FAMILY_TABLE:
+        if key in lowered and len(key) > len(best):
+            best = key
+    return FAMILY_TABLE[best] if best else None
+
+
+def _config_length(route: RuntimeRoute, scope: Scope) -> int | None:
+    config = config_of(scope)
+    saved = model_section(config)
+    saved_model = text(saved.get("default"))
+    if not saved_model or saved_model == route.model:
+        value = positive_int(saved.get("context_length"))
+        if value is not None:
+            return value
+    per_model = model_entry(provider_entry(config, route.provider), route.model)
+    return positive_int(per_model.get("context_length"))
+
+
+def _profile_length(route: RuntimeRoute) -> int | None:
+    profile = route.profile
+    if profile is None:
+        return None
+    hooked = profile.context_length(route.model)
+    if isinstance(hooked, int) and not isinstance(hooked, bool) and hooked > 0:
+        return hooked
+    return profile.context_length_hint
+
+
+async def _endpoint_length(
+    route: RuntimeRoute, scope: Scope, list_models: ListModels | None
+) -> int | None:
+    is_custom = route.profile is None or route.profile.is_custom
+    if list_models is None or not is_custom:
+        return None
+    models = await list_models(route)
+    wanted = route.model.lower()
+    for info in models:
+        if info.id == route.model or info.id.lower() == wanted:
+            if info.context_length is None:
+                return None
+            remember(scope, route.base_url, route.model, info.context_length, source="endpoint")
+            return info.context_length
+    return None
+
+
+async def find_window(
+    route: RuntimeRoute, *, scope: Scope, list_models: ListModels | None = None
+) -> ContextWindow:
+    """The window by the module's order, without the minimum check."""
+    configured = _config_length(route, scope)
+    if configured is not None:
+        return ContextWindow(configured, SOURCE_CONFIG)
+    declared = _profile_length(route)
+    if declared is not None:
+        return ContextWindow(declared, SOURCE_PROFILE)
+    if not route.model.strip():
+        return ContextWindow(FALLBACK_CONTEXT, SOURCE_FALLBACK)
+    cached = cached_length(scope, route.base_url, route.model)
+    if cached is not None:
+        return ContextWindow(cached, SOURCE_CACHE)
+    live = await _endpoint_length(route, scope, list_models)
+    if live is not None:
+        return ContextWindow(live, SOURCE_ENDPOINT)
+    family = family_length(route.model)
+    if family is not None:
+        return ContextWindow(family, SOURCE_FAMILY)
+    _warn_fallback(route.model, route.base_url)
+    return ContextWindow(FALLBACK_CONTEXT, SOURCE_FALLBACK)
+
+
+async def resolve(
+    route: RuntimeRoute, *, scope: Scope, list_models: ListModels | None = None
+) -> ContextWindow:
+    """The route's context window; raises ``ContextTooSmall`` below ``MIN_CONTEXT`` tokens."""
+    window = await find_window(route, scope=scope, list_models=list_models)
+    if window.tokens < MIN_CONTEXT:
+        raise ContextTooSmall(
+            f"{route.model or 'this model'} has a {window.tokens:,}-token context window "
+            f"({window.source}); at least {MIN_CONTEXT:,} tokens are needed",
+            tokens=window.tokens,
+            source=window.source,
+            hint="pick a model with a larger window, or raise the server's context size "
+            "(for local servers) and set model.context_length",
+        )
+    return window
+
+
+# -- overflow messages --------------------------------------------------------------------------
+
+_NUMBER = r"(\d[\d,]*\d|\d)"
+_OVERFLOW_PATTERNS = tuple(
+    re.compile(p)
+    for p in (
+        # "... too large for model with 131072 maximum context length"
+        _NUMBER + r"\s*(?:tokens?\s*)?maximum context length",
+        # "maximum context length is 128000 tokens", "maximum number of tokens allowed (1048576)"
+        r"maximum (?:context length|context window|number of tokens allowed|input length)"
+        r"[^0-9]{0,24}?" + _NUMBER,
+        # "prompt is too long: 215000 tokens > 200000 maximum"
+        r">\s*" + _NUMBER + r"\s*(?:tokens?\s*)?maximum",
+        # "available context size (32768 tokens)", "context length of only 4096 tokens",
+        # "context window of 200000", "context_length: 8192"
+        r"context[ _](?:size|length|window)\s*(?:\(|of|is|=|:)?\s*(?:only\s*)?" + _NUMBER,
+        # "max_model_len=32768", "num_ctx: 4096", "n_ctx (8192)"
+        r"\b(?:max_model_len|num_ctx|n_ctx)\b\s*(?:is\s*)?[=:(]?\s*" + _NUMBER,
+        # "exceeds the limit of 32768", "limit: 8192 tokens"
+        r"\blimit\s*(?:of|is|:|=)?\s*" + _NUMBER + r"\b",
+        # "supports up to 32768 tokens"
+        r"supports? (?:only )?up to\s*" + _NUMBER,
+    )
+)
+_OUTPUT_WORDS = ("output token", "max_tokens", "max_completion_tokens", "completion tokens")
+_INPUT_WORDS = ("context", "prompt", "input")
+
+
+def parse_overflow_limit(message: str) -> int | None:
+    """The context window an overflow error states, or None.
+
+    Messages about the output cap only (``max_tokens`` too large) are not context windows and
+    give None, so callers shrink ``max_tokens`` instead of the window.
+    """
+    lowered = message.lower()
+    if any(w in lowered for w in _OUTPUT_WORDS) and not any(w in lowered for w in _INPUT_WORDS):
+        return None
+    for pattern in _OVERFLOW_PATTERNS:
+        match = pattern.search(lowered)
+        if match is None:
+            continue
+        value = _sane(match.group(1).replace(",", ""))
+        if value is not None:
+            return value
+    return None
diff --git a/src/indus/providers/hosts.py b/src/indus/providers/hosts.py
new file mode 100644
index 0000000..99b577a
--- /dev/null
+++ b/src/indus/providers/hosts.py
@@ -0,0 +1,185 @@
+"""Base-URL parsing, exact host matching and API-mode detection from a URL.
+
+Every decision about where a key may be sent is made on a parsed, normalised host and never on a
+substring of the URL text: ``https://api.openai.com.evil.example`` and
+``https://evil.example/api.openai.com`` must not pass for ``api.openai.com`` (R01.11).
+"""
+
+from __future__ import annotations
+
+import ipaddress
+from dataclasses import dataclass
+from urllib.parse import urlsplit
+
+from indus.foundation.errors import InvalidBaseURL
+
+SCHEMES = frozenset({"http", "https"})
+DEFAULT_PORTS = {"http": 80, "https": 443}
+
+# Hosts whose chat endpoint is best served by the Responses API (P08); until then a route that
+# lands here falls back to chat completions with a note.
+OPENAI_OFFICIAL_HOSTS = frozenset({"api.openai.com", "us.api.openai.com", "eu.api.openai.com"})
+ANTHROPIC_OFFICIAL_HOSTS = frozenset({"api.anthropic.com"})
+
+API_MODE_CHAT = "chat_completions"
+API_MODE_ANTHROPIC = "anthropic_messages"
+API_MODE_RESPONSES = "responses"
+
+
+@dataclass(frozen=True)
+class ParsedURL:
+    scheme: str
+    host: str
+    port: int | None
+    path: str
+    query: str = ""
+
+    @property
+    def effective_port(self) -> int:
+        return self.port if self.port is not None else DEFAULT_PORTS[self.scheme]
+
+    @property
+    def origin(self) -> tuple[str, str, int]:
+        return (self.scheme, self.host, self.effective_port)
+
+
+def _bad(url: str, why: str) -> InvalidBaseURL:
+    return InvalidBaseURL(f"{url!r} is not a usable base URL: {why}")
+
+
+def normalise_host(host: str) -> str:
+    """Lowercase, drop one trailing dot and convert non-ASCII labels to punycode (IDNA)."""
+    text = host.strip().lower()
+    if text.endswith("."):
+        text = text[:-1]
+    if not text:
+        raise ValueError("empty host")
+    if ":" in text:  # IPv6 literal (brackets already removed by urlsplit)
+        return str(ipaddress.IPv6Address(text.split("%", 1)[0]))
+    if not text.isascii():
+        text = text.encode("idna").decode("ascii")
+    labels = text.split(".")
+    if any(not label for label in labels):
+        raise ValueError("empty label")
+    for label in labels:
+        if len(label) > 63 or not all(c.isalnum() or c in "-_" for c in label):
+            raise ValueError(f"bad label {label!r}")
+    return text
+
+
+def parse_base_url(url: str) -> ParsedURL:
+    """Parse a provider base URL strictly; raise ``InvalidBaseURL`` on anything ambiguous."""
+    if not isinstance(url, str) or not url:  # pyright: ignore[reportUnnecessaryIsInstance]
+        raise _bad(str(url), "empty")
+    if any(ch.isspace() for ch in url):
+        raise _bad(url, "contains whitespace")
+    if "\\" in url:
+        raise _bad(url, "contains a backslash")
+    if "://" not in url:
+        raise _bad(url, "no scheme (expected http:// or https://)")
+    try:
+        parts = urlsplit(url)
+    except ValueError as exc:
+        raise _bad(url, str(exc)) from exc
+    scheme = parts.scheme.lower()
+    if scheme not in SCHEMES:
+        raise _bad(url, f"scheme {parts.scheme!r} is not http or https")
+    if "@" in parts.netloc:
+        raise _bad(url, "user info before the host is not allowed")
+    if parts.fragment or url.endswith("#"):
+        raise _bad(url, "fragments are not allowed")
+    raw_host = parts.hostname
+    if not raw_host:
+        raise _bad(url, "no host")
+    try:
+        port = parts.port
+    except ValueError as exc:
+        raise _bad(url, "bad port") from exc
+    try:
+        host = normalise_host(raw_host)
+    except (UnicodeError, ValueError) as exc:
+        raise _bad(url, f"bad host ({exc})") from exc
+    return ParsedURL(
+        scheme=scheme, host=host, port=port, path=parts.path.rstrip("/"), query=parts.query
+    )
+
+
+def try_parse(url: str) -> ParsedURL | None:
+    try:
+        return parse_base_url(url)
+    except InvalidBaseURL:
+        return None
+
+
+def host_of(url: str) -> str:
+    """The normalised host of ``url``, or ``""`` when it does not parse."""
+    parsed = try_parse(url)
+    return parsed.host if parsed else ""
+
+
+def host_matches(url: str, domain: str, *, allow_subdomains: bool = False) -> bool:
+    """True when ``url``'s host is exactly ``domain``.
+
+    With ``allow_subdomains`` a host ending in ``"." + domain`` also matches; callers pass it only
+    for a suffix they explicitly allow. Never raises: an unparsable URL or domain does not match.
+    """
+    parsed = try_parse(url)
+    if parsed is None or not domain:
+        return False
+    try:
+        wanted = normalise_host(domain)
+    except (UnicodeError, ValueError):
+        return False
+    if parsed.host == wanted:
+        return True
+    return allow_subdomains and parsed.host.endswith("." + wanted)
+
+
+def _ip(host: str) -> ipaddress.IPv4Address | ipaddress.IPv6Address | None:
+    try:
+        addr = ipaddress.ip_address(host)
+    except ValueError:
+        return None
+    if isinstance(addr, ipaddress.IPv6Address) and addr.ipv4_mapped is not None:
+        return addr.ipv4_mapped
+    return addr
+
+
+def is_loopback(url: str) -> bool:
+    """127.0.0.0/8, ``::1`` (and its IPv4-mapped form) or ``localhost``."""
+    parsed = try_parse(url)
+    if parsed is None:
+        return False
+    if parsed.host == "localhost":
+        return True
+    addr = _ip(parsed.host)
+    return addr is not None and addr.is_loopback
+
+
+def is_private_network(url: str) -> bool:
+    """Loopback, RFC 1918, link-local or unique-local addresses (a server on the user's network)."""
+    if is_loopback(url):
+        return True
+    parsed = try_parse(url)
+    if parsed is None:
+        return False
+    addr = _ip(parsed.host)
+    return addr is not None and (addr.is_private or addr.is_link_local) and not addr.is_unspecified
+
+
+def api_mode_from_url(url: str) -> str:
+    """The wire format a URL most likely speaks.
+
+    Official OpenAI hosts → ``responses`` (a hint: the route uses chat completions until P08);
+    ``api.anthropic.com`` or a path ending ``/anthropic`` or ``/anthropic/v1`` →
+    ``anthropic_messages``; everything else → ``chat_completions``. Raises ``InvalidBaseURL``.
+    """
+    parsed = parse_base_url(url)
+    if parsed.host in OPENAI_OFFICIAL_HOSTS:
+        return API_MODE_RESPONSES
+    if parsed.host in ANTHROPIC_OFFICIAL_HOSTS:
+        return API_MODE_ANTHROPIC
+    path = parsed.path.lower()
+    if path.endswith("/anthropic") or path.endswith("/anthropic/v1"):
+        return API_MODE_ANTHROPIC
+    return API_MODE_CHAT
diff --git a/src/indus/providers/http.py b/src/indus/providers/http.py
new file mode 100644
index 0000000..3e3de6c
--- /dev/null
+++ b/src/indus/providers/http.py
@@ -0,0 +1,255 @@
+"""The one place that builds HTTP clients for model providers.
+
+Every request identifies as this product only (``User-Agent: indus/<version>`` plus the profile's
+own default headers; R01.12). Redirects are not followed, so a key never travels to a host the
+route did not name. ``open_stream`` returns a handle whose ``aclose()`` aborts the response, so a
+cancelled turn frees its socket at once instead of draining the body (R01.4).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import threading
+from collections.abc import AsyncIterator, Mapping
+from dataclasses import dataclass, replace
+from types import TracebackType
+from typing import Any
+
+import httpx
+
+from indus.foundation.scope import Scope
+from indus.providers.hosts import is_loopback
+from indus.providers.profile import USER_AGENT
+from indus.providers.route import RuntimeRoute
+from indus.providers.settings import (
+    as_mapping,
+    config_of,
+    model_entry,
+    positive_number,
+    provider_entry,
+)
+
+log = logging.getLogger(__name__)
+
+API_TIMEOUT_ENV = "INDUS_API_TIMEOUT"
+DEFAULT_CONNECT = 30.0
+DEFAULT_READ = 120.0
+DEFAULT_REQUEST = 1800.0
+DEFAULT_POOL = 30.0
+IPV4_ANY = "0.0.0.0"
+
+
+@dataclass(frozen=True)
+class Timeouts:
+    connect: float = DEFAULT_CONNECT
+    read: float = DEFAULT_READ
+    write: float = DEFAULT_REQUEST
+    pool: float = DEFAULT_POOL
+
+    def to_httpx(self) -> httpx.Timeout:
+        return httpx.Timeout(connect=self.connect, read=self.read, write=self.write, pool=self.pool)
+
+
+def request_timeout(
+    provider: str, model: str, *, config: Any, env: Mapping[str, str]
+) -> tuple[float, str]:
+    """``(seconds, source)``: per-model ``timeout_seconds`` > provider ``request_timeout_seconds``
+    > ``INDUS_API_TIMEOUT`` > 1,800 s. Source is ``model``, ``provider``, ``env`` or ``default``."""
+    entry = provider_entry(config, provider) if provider else {}
+    per_model = positive_number(model_entry(entry, model).get("timeout_seconds"))
+    if per_model is not None:
+        return per_model, "model"
+    per_provider = positive_number(entry.get("request_timeout_seconds"))
+    if per_provider is not None:
+        return per_provider, "provider"
+    from_env = positive_number(env.get(API_TIMEOUT_ENV))
+    if from_env is not None:
+        return from_env, "env"
+    return DEFAULT_REQUEST, "default"
+
+
+def timeouts_for(
+    route: RuntimeRoute, scope: Scope, *, stale_timeout: float | None = None
+) -> Timeouts:
+    """Socket timeouts for ``route``.
+
+    Write is the request timeout. A configured request timeout (per model or per provider) is also
+    the read timeout. Otherwise read is 120 s, raised to the request timeout for loopback
+    endpoints (local servers prefill slowly) and to ``stale_timeout`` when that is larger
+    (reasoning streams pause; the stale detector, not the socket, decides).
+    """
+    seconds, source = request_timeout(
+        route.provider, route.model, config=config_of(scope), env=scope.env
+    )
+    timeouts = Timeouts(
+        connect=min(DEFAULT_CONNECT, seconds), write=seconds, pool=min(DEFAULT_POOL, seconds)
+    )
+    if source in ("model", "provider"):
+        return replace(timeouts, read=seconds)
+    read = DEFAULT_READ
+    if is_loopback(route.base_url):
+        read = max(read, seconds)
+    if stale_timeout is not None and stale_timeout > read:
+        read = stale_timeout
+    return replace(timeouts, read=read)
+
+
+def force_ipv4_enabled(scope: Scope) -> bool:
+    return as_mapping(config_of(scope).get("network")).get("force_ipv4") is True
+
+
+def base_headers(route: RuntimeRoute) -> dict[str, str]:
+    """Our user agent and the profile's own default headers; nothing that names another product."""
+    headers = dict(route.headers)
+    headers["User-Agent"] = USER_AGENT
+    return headers
+
+
+def make_transport(*, force_ipv4: bool) -> httpx.AsyncHTTPTransport:
+    """The real network transport; ``force_ipv4`` binds the local address to ``0.0.0.0``."""
+    if force_ipv4:
+        return httpx.AsyncHTTPTransport(http1=True, http2=False, retries=0, local_address=IPV4_ANY)
+    return httpx.AsyncHTTPTransport(http1=True, http2=False, retries=0)
+
+
+def _loop_id() -> int:
+    try:
+        return id(asyncio.get_running_loop())
+    except RuntimeError:
+        return 0
+
+
+class ClientPool:
+    """``httpx.AsyncClient`` instances shared per (base URL, key fingerprint, settings)."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._clients: dict[tuple[object, ...], httpx.AsyncClient] = {}
+
+    def __len__(self) -> int:
+        with self._lock:
+            return len(self._clients)
+
+    def client_for(
+        self,
+        route: RuntimeRoute,
+        *,
+        timeouts: Timeouts,
+        transport: httpx.AsyncBaseTransport | None = None,
+        force_ipv4: bool = False,
+    ) -> httpx.AsyncClient:
+        fingerprint = route.api_key.fingerprint() if route.api_key else ""
+        key = (
+            route.base_url,
+            fingerprint,
+            timeouts,
+            force_ipv4,
+            id(transport) if transport is not None else 0,
+            tuple(sorted(route.headers.items())),
+            _loop_id(),
+        )
+        with self._lock:
+            client = self._clients.get(key)
+            if client is not None and not client.is_closed:
+                return client
+            client = httpx.AsyncClient(
+                headers=base_headers(route),
+                timeout=timeouts.to_httpx(),
+                transport=transport
+                if transport is not None
+                else make_transport(force_ipv4=force_ipv4),
+                http1=True,
+                http2=False,
+                follow_redirects=False,
+            )
+            self._clients[key] = client
+            return client
+
+    async def close_all(self) -> int:
+        """Close every cached client; returns how many were closed."""
+        with self._lock:
+            clients = list(self._clients.values())
+            self._clients.clear()
+        closed = 0
+        for client in clients:
+            if client.is_closed:
+                continue
+            try:
+                await client.aclose()
+            except Exception as exc:  # a client bound to a finished loop cannot close cleanly
+                log.debug("closing a provider client failed: %s", exc)
+            closed += 1
+        return closed
+
+
+_POOL = ClientPool()
+
+
+def client_for(
+    route: RuntimeRoute,
+    *,
+    timeouts: Timeouts,
+    transport: httpx.AsyncBaseTransport | None = None,
+    force_ipv4: bool = False,
+) -> httpx.AsyncClient:
+    """A cached client for ``route`` (one per base URL, key fingerprint and settings)."""
+    return _POOL.client_for(route, timeouts=timeouts, transport=transport, force_ipv4=force_ipv4)
+
+
+async def close_all() -> int:
+    return await _POOL.close_all()
+
+
+class StreamHandle:
+    """An open streaming response. ``aclose()`` aborts it; safe to call more than once."""
+
+    def __init__(self, response: httpx.Response) -> None:
+        self.response = response
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    @property
+    def status_code(self) -> int:
+        return self.response.status_code
+
+    @property
+    def headers(self) -> httpx.Headers:
+        return self.response.headers
+
+    async def aiter_bytes(self) -> AsyncIterator[bytes]:
+        async for chunk in self.response.aiter_bytes():
+            if chunk:
+                yield chunk
+
+    async def aread(self) -> bytes:
+        return await self.response.aread()
+
+    async def aclose(self) -> None:
+        """Close the response without reading the rest; the connection is dropped, not reused."""
+        if self._closed:
+            return
+        self._closed = True
+        try:
+            await self.response.aclose()
+        except Exception as exc:
+            log.debug("aborting a provider stream raised %s: %s", type(exc).__name__, exc)
+
+    async def __aenter__(self) -> StreamHandle:
+        return self
+
+    async def __aexit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc: BaseException | None,
+        tb: TracebackType | None,
+    ) -> None:
+        await self.aclose()
+
+
+async def open_stream(client: httpx.AsyncClient, request: httpx.Request) -> StreamHandle:
+    """Send ``request`` and return the response unread, wrapped in a ``StreamHandle``."""
+    return StreamHandle(await client.send(request, stream=True))
diff --git a/src/indus/providers/model_list.py b/src/indus/providers/model_list.py
new file mode 100644
index 0000000..0214ee9
--- /dev/null
+++ b/src/indus/providers/model_list.py
@@ -0,0 +1,203 @@
+"""Live model lists from a provider's ``/models`` endpoint, cached per base URL.
+
+The list feeds the model picker (P07) and context-window discovery for custom and local endpoints
+(P03-17). Failures never raise: they log a reason and return an empty list, so a picker can fall
+back to typing a model id.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, cast
+
+import httpx
+
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.scope import Scope
+from indus.providers.route import RuntimeRoute
+from indus.providers.settings import as_mapping, config_of, positive_int, positive_number
+
+log = logging.getLogger(__name__)
+
+CACHE_DIR = "cache"
+CACHE_FILE = "model_lists.json"
+CACHE_VERSION = 1
+DEFAULT_TTL_SECONDS = 20 * 60.0
+LIST_TIMEOUT_SECONDS = 10.0
+ANTHROPIC_VERSION = "2023-06-01"
+# Fields OpenAI-compatible servers use for a model's window (vLLM: max_model_len).
+CONTEXT_FIELDS = ("context_length", "max_model_len", "context_window")
+
+
+@dataclass(frozen=True)
+class ModelInfo:
+    id: str
+    context_length: int | None = None
+    owned_by: str | None = None
+
+    def to_json(self) -> dict[str, Any]:
+        return {"id": self.id, "context_length": self.context_length, "owned_by": self.owned_by}
+
+
+def models_url(route: RuntimeRoute) -> str:
+    """The profile's ``models_url`` when the route uses the profile's own endpoint, else
+    ``{base_url}/models`` (``/v1/models`` for Anthropic-wire hosts without a ``/v1`` suffix)."""
+    base = route.base_url.rstrip("/")
+    profile = route.profile
+    if profile is not None and profile.models_url and base == profile.base_url.rstrip("/"):
+        return profile.models_url
+    if route.api_mode == "anthropic_messages" and not base.endswith("/v1"):
+        return base + "/v1/models"
+    return base + "/models"
+
+
+def request_headers(route: RuntimeRoute) -> dict[str, str]:
+    headers = {"Accept": "application/json"}
+    if route.api_key is None:
+        return headers
+    bearer = route.profile is not None and route.profile.bearer_auth
+    if route.api_mode == "anthropic_messages" and not bearer:
+        headers["x-api-key"] = route.api_key.reveal()
+    else:
+        headers["Authorization"] = f"Bearer {route.api_key.reveal()}"
+    if route.api_mode == "anthropic_messages":
+        headers["anthropic-version"] = ANTHROPIC_VERSION
+    return headers
+
+
+def _context_of(item: dict[str, Any]) -> int | None:
+    for name in CONTEXT_FIELDS:
+        value = positive_int(item.get(name))
+        if value is not None:
+            return value
+    return None
+
+
+def parse_models(payload: object) -> list[ModelInfo]:
+    """Models from ``{"data": [...]}`` or a bare list; entries without a string id are skipped."""
+    raw: object = payload
+    if isinstance(payload, dict):
+        body = cast(dict[str, Any], payload)
+        raw = body.get("data", body.get("models"))
+    if not isinstance(raw, list):
+        return []
+    models: list[ModelInfo] = []
+    seen: set[str] = set()
+    for entry in cast(list[object], raw):
+        if not isinstance(entry, dict):
+            continue
+        item = cast(dict[str, Any], entry)
+        model_id = item.get("id")
+        if not isinstance(model_id, str) or not model_id.strip() or model_id in seen:
+            continue
+        seen.add(model_id)
+        owner = item.get("owned_by")
+        models.append(
+            ModelInfo(
+                id=model_id,
+                context_length=_context_of(item),
+                owned_by=owner if isinstance(owner, str) else None,
+            )
+        )
+    return models
+
+
+# -- cache --------------------------------------------------------------------------------------
+
+
+def cache_path(scope: Scope) -> Path:
+    return scope.home / CACHE_DIR / CACHE_FILE
+
+
+def ttl_seconds(scope: Scope) -> float:
+    minutes = positive_number(as_mapping(config_of(scope).get("model_catalog")).get("ttl_minutes"))
+    return minutes * 60.0 if minutes is not None else DEFAULT_TTL_SECONDS
+
+
+def _read_cache(path: Path) -> dict[str, Any]:
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except FileNotFoundError:
+        return {}
+    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
+        log.warning("ignored the model list cache %s: %s", path, exc)
+        return {}
+    document = as_mapping(data)
+    if document.get("version") != CACHE_VERSION:
+        return {}
+    return dict(as_mapping(document.get("lists")))
+
+
+def _cached(scope: Scope, base_url: str, ttl: float) -> list[ModelInfo] | None:
+    entry = as_mapping(_read_cache(cache_path(scope)).get(base_url))
+    fetched = positive_number(entry.get("fetched_at"))
+    if fetched is None:
+        return None
+    now = scope.clock.now().timestamp()
+    if not (fetched <= now < fetched + ttl):
+        return None
+    return parse_models({"data": entry.get("models")})
+
+
+def _store(scope: Scope, base_url: str, models: list[ModelInfo]) -> None:
+    path = cache_path(scope)
+    lists = _read_cache(path)
+    lists[base_url] = {
+        "fetched_at": scope.clock.now().timestamp(),
+        "models": [m.to_json() for m in models],
+    }
+    try:
+        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        atomic_write_json(path, {"version": CACHE_VERSION, "lists": lists}, mode=0o600)
+    except OSError as exc:
+        log.warning("could not save the model list cache %s: %s", path, exc)
+
+
+# -- fetch --------------------------------------------------------------------------------------
+
+
+async def list_models(
+    route: RuntimeRoute,
+    *,
+    client: httpx.AsyncClient,
+    scope: Scope | None = None,
+    cache_ttl: float | None = None,
+    refresh: bool = False,
+) -> list[ModelInfo]:
+    """The models ``route``'s endpoint offers; ``[]`` on any failure (reason logged).
+
+    With a ``scope`` the list is cached in ``<home>/cache/model_lists.json`` per base URL for
+    ``cache_ttl`` seconds (default ``model_catalog.ttl_minutes``) of the scope's clock time;
+    ``refresh`` skips the cached copy.
+    """
+    if route.profile is not None and not route.profile.supports_model_listing:
+        return []
+    base = route.base_url.rstrip("/")
+    ttl = cache_ttl if cache_ttl is not None else (ttl_seconds(scope) if scope else 0.0)
+    if scope is not None and not refresh and ttl > 0:
+        cached = _cached(scope, base, ttl)
+        if cached is not None:
+            return cached
+    url = models_url(route)
+    try:
+        response = await client.get(
+            url, headers=request_headers(route), timeout=LIST_TIMEOUT_SECONDS
+        )
+    except httpx.HTTPError as exc:
+        log.warning("could not list models at %s: %s", url, type(exc).__name__)
+        return []
+    if response.status_code >= 400:
+        log.warning("could not list models at %s: HTTP %s", url, response.status_code)
+        return []
+    try:
+        payload = response.json()
+    except (ValueError, UnicodeDecodeError):
+        log.warning("could not list models at %s: the answer is not JSON", url)
+        return []
+    models = parse_models(payload)
+    if scope is not None and ttl > 0:
+        _store(scope, base, models)
+    return models
diff --git a/src/indus/providers/profile.py b/src/indus/providers/profile.py
new file mode 100644
index 0000000..c9bb532
--- /dev/null
+++ b/src/indus/providers/profile.py
@@ -0,0 +1,214 @@
+"""``ProviderProfile``: a declarative description of one model provider.
+
+A profile says how to reach a provider (endpoint, wire format, key names, headers) and which
+request quirks it has. It owns no clients, connection pools or streams; ``http``, the transports
+and the streaming driver read it. Hooks are plain callables with no-op defaults so a vendor can
+adjust a request body, classify its own errors or report a context window without subclassing.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from types import MappingProxyType
+from typing import Any
+
+from indus import __version__
+from indus.foundation.errors import InvalidBaseURL, InvalidProviderProfile
+from indus.providers.hosts import normalise_host, parse_base_url
+
+USER_AGENT = f"indus/{__version__}"
+
+# Wire formats. P03 implements the first two; the rest validate so P08 profiles can be declared.
+ACTIVE_API_MODES = frozenset({"chat_completions", "anthropic_messages"})
+API_MODES = ACTIVE_API_MODES | {"responses", "bedrock", "gemini"}
+AUTH_TYPES = frozenset({"api_key", "api_key_optional", "none"})
+MAX_TOKENS_PARAMS = frozenset({"max_tokens", "max_completion_tokens"})
+FAMILIES = frozenset({"vendor", "custom"})
+REASONING_LEVELS = ("none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra")
+
+NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
+ENV_NAME_RE = re.compile(r"^[A-Z][A-Z0-9_]*$")
+_HEADER_NAME_RE = re.compile(r"^[A-Za-z0-9!#$%&'*+.^_`|~-]+$")
+# A product token in the RFC 9110 sense: ``Name/1.2``. Any such token that is not ours means the
+# header claims to be another program (R01.12).
+_PRODUCT_TOKEN_RE = re.compile(r"(?<![A-Za-z0-9._-])([A-Za-z][A-Za-z0-9._-]*)/\d")
+
+BodyHook = Callable[[dict[str, Any], str], dict[str, Any]]
+ErrorHook = Callable[[object], object | None]
+ContextHook = Callable[[str], int | None]
+
+
+def keep_body(body: dict[str, Any], model: str) -> dict[str, Any]:
+    """Default ``prepare_body``: the body unchanged."""
+    return body
+
+
+def no_verdict(ctx: object) -> object | None:
+    """Default ``classify_error``: no opinion, the generic classifier decides."""
+    return None
+
+
+def no_context_length(model: str) -> int | None:
+    """Default ``context_length``: unknown."""
+    return None
+
+
+def _frozen_map(value: Mapping[str, Any] | None) -> Mapping[str, Any]:
+    return MappingProxyType(dict(value or {}))
+
+
+def _bad(name: str, why: str) -> InvalidProviderProfile:
+    return InvalidProviderProfile(f"provider profile {name!r}: {why}")
+
+
+def foreign_product_tokens(value: str) -> list[str]:
+    """Product tokens (``Name/1.0``) in a header value that do not name this product."""
+    return [m.group(1) for m in _PRODUCT_TOKEN_RE.finditer(value) if m.group(1).lower() != "indus"]
+
+
+@dataclass(frozen=True)
+class ProviderProfile:
+    name: str
+    base_url: str = ""
+    api_mode: str = "chat_completions"
+    auth_type: str = "api_key"
+    env_vars: tuple[str, ...] = ()
+    aliases: tuple[str, ...] = ()
+    display_name: str = ""
+    description: str = ""
+    base_url_env_var: str = ""
+    models_url: str = ""
+    hostname: str = ""
+    default_headers: Mapping[str, str] = field(default_factory=dict, hash=False)
+    supports_streaming: bool = True
+    supports_vision: bool = False
+    supports_model_listing: bool = True
+    max_tokens_param: str = "max_tokens"
+    default_max_tokens: int | None = None
+    fixed_temperature: float | None = None
+    context_length_hint: int | None = None
+    model_aliases: Mapping[str, str] = field(default_factory=dict, hash=False)
+    hidden: bool = False
+    # ``vendor``: a named service with its own host. ``custom``: an endpoint the user chose
+    # (bare ``custom``, named custom providers, local servers).
+    family: str = "vendor"
+    # False keeps the profile out of ``auto`` provider detection (local servers, bare custom).
+    auto_detect: bool = True
+    # Ladder levels the provider accepts (None = not declared; the transport keeps its default).
+    reasoning_efforts: tuple[str, ...] | None = None
+    # Substrings of model ids that think before answering (stale-timeout floor, P03-13).
+    reasoning_models: tuple[str, ...] = ()
+    # Substrings of model ids that take an effort field instead of a thinking budget (P03-10).
+    adaptive_thinking_models: tuple[str, ...] = ()
+    # Anthropic-wire hosts that document ``Authorization: Bearer`` instead of ``x-api-key``.
+    bearer_auth: bool = False
+    prepare_body: BodyHook = keep_body
+    classify_error: ErrorHook = no_verdict
+    context_length: ContextHook = no_context_length
+
+    def __post_init__(self) -> None:
+        name = self.name
+        if not isinstance(name, str) or not NAME_RE.match(name):  # pyright: ignore[reportUnnecessaryIsInstance]
+            raise _bad(str(name), "name must be lowercase letters, digits, '.', '_' or '-'")
+        for alias in self.aliases:
+            if not NAME_RE.match(alias):
+                raise _bad(
+                    name, f"alias {alias!r} must be lowercase letters, digits, '.', '_', '-'"
+                )
+        if self.api_mode not in API_MODES:
+            raise _bad(name, f"api_mode {self.api_mode!r} is not one of {sorted(API_MODES)}")
+        if self.auth_type not in AUTH_TYPES:
+            raise _bad(name, f"auth_type {self.auth_type!r} is not one of {sorted(AUTH_TYPES)}")
+        if self.max_tokens_param not in MAX_TOKENS_PARAMS:
+            raise _bad(name, f"max_tokens_param {self.max_tokens_param!r} is not supported")
+        if self.family not in FAMILIES:
+            raise _bad(name, f"family {self.family!r} is not one of {sorted(FAMILIES)}")
+        for env in (*self.env_vars, *((self.base_url_env_var,) if self.base_url_env_var else ())):
+            if not ENV_NAME_RE.match(env):
+                raise _bad(name, f"env name {env!r} must match {ENV_NAME_RE.pattern}")
+        if self.reasoning_efforts is not None:
+            unknown = [e for e in self.reasoning_efforts if e not in REASONING_LEVELS]
+            if unknown:
+                raise _bad(name, f"unknown reasoning levels {unknown}")
+        for number, what in (
+            (self.default_max_tokens, "default_max_tokens"),
+            (self.context_length_hint, "context_length_hint"),
+        ):
+            if number is not None and (not isinstance(number, int) or number <= 0):  # pyright: ignore[reportUnnecessaryIsInstance]
+                raise _bad(name, f"{what} must be a positive integer")
+        if self.auth_type == "api_key" and not self.base_url:
+            raise _bad(name, "an api_key provider needs a base_url to send the key to")
+        host = self._checked_hosts()
+        object.__setattr__(self, "hostname", host)
+        object.__setattr__(self, "aliases", tuple(self.aliases))
+        object.__setattr__(self, "env_vars", tuple(self.env_vars))
+        object.__setattr__(self, "default_headers", self._checked_headers())
+        object.__setattr__(self, "model_aliases", _frozen_map(self.model_aliases))
+
+    def _checked_hosts(self) -> str:
+        derived = ""
+        for url, what in ((self.base_url, "base_url"), (self.models_url, "models_url")):
+            if not url:
+                continue
+            try:
+                parsed = parse_base_url(url)
+            except InvalidBaseURL as exc:
+                raise _bad(self.name, f"{what}: {exc}") from exc
+            if what == "base_url":
+                derived = parsed.host
+        if self.hostname:
+            try:
+                return normalise_host(self.hostname)
+            except (UnicodeError, ValueError) as exc:
+                raise _bad(self.name, f"hostname {self.hostname!r} is not a host name") from exc
+        return derived
+
+    def _checked_headers(self) -> Mapping[str, str]:
+        headers: dict[str, str] = {}
+        for key, value in dict(self.default_headers).items():
+            if not isinstance(key, str) or not isinstance(value, str):  # pyright: ignore[reportUnnecessaryIsInstance]
+                raise _bad(self.name, "header names and values must be strings")
+            if not _HEADER_NAME_RE.match(key):
+                raise _bad(self.name, f"header name {key!r} is not valid")
+            if "\r" in value or "\n" in value:
+                raise _bad(self.name, f"header {key!r} contains a line break")
+            if (
+                key.lower() == "user-agent"
+                and value != USER_AGENT
+                and not value.startswith("indus/")
+            ):
+                raise _bad(self.name, f"User-Agent must be ours ({USER_AGENT}), not {value!r}")
+            foreign = foreign_product_tokens(value)
+            if foreign:
+                raise _bad(
+                    self.name,
+                    f"header {key!r} names another product ({', '.join(foreign)}); "
+                    "requests only ever identify as this product",
+                )
+            headers[key] = value
+        return MappingProxyType(headers)
+
+    @property
+    def label(self) -> str:
+        return self.display_name or self.name
+
+    @property
+    def needs_key(self) -> bool:
+        return self.auth_type == "api_key"
+
+    @property
+    def is_custom(self) -> bool:
+        return self.family == "custom"
+
+    def all_names(self) -> tuple[str, ...]:
+        return (self.name, *self.aliases)
+
+    def resolve_model(self, model: str) -> str:
+        """The provider's id for ``model`` when it is one of the profile's model aliases."""
+        return self.model_aliases.get(model, model)
+
+    def is_reasoning_model(self, model: str) -> bool:
+        lowered = model.lower()
+        return any(p.lower() in lowered for p in self.reasoning_models)
