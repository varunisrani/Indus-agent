index 0000000..8b81237
--- /dev/null
+++ b/src/indus/gateway/http/serving.py
@@ -0,0 +1,396 @@
+"""Serving the gateway's HTTP apps: binding, the uvicorn server, and the shared ASGI layers.
+
+``bind_listener(host, port, clock)`` binds a TCP socket itself (so a port of 0 picks a free one
+and the real port is known), retrying ``EADDRINUSE`` ``BIND_ATTEMPTS`` times ``BIND_DELAY_S``
+apart on the injected clock while a restarting predecessor lets go of the port.
+``HttpServer`` runs uvicorn on that socket inside the caller's event loop without installing
+signal handlers (the daemon owns signals); ``stop()`` closes the listener and waits a few
+seconds for open connections.
+
+The ASGI layers, outermost first, as ``api_server`` stacks them:
+
+- ``SecurityHeaders``: fixed headers on every response, errors included;
+- ``CorsGate``: no ``Origin`` header passes untouched; an origin on the allow list gets CORS
+  headers (and a preflight answer); any other origin is refused with 403. With no allow list
+  (the default) every browser origin is refused;
+- ``BearerGate``: ``Authorization: Bearer <key>`` checked by the given verifier; a failure is 401
+  with the OpenAI error envelope; the key id is put in ``scope["state"]["api_key_id"]``;
+- ``LengthGate``: a ``Content-Length`` over the cap is 413 before the body is read.
+
+``read_body(request, limit)`` reads a body while counting, so a chunked body without a length is
+cut at the cap too (``BodyTooLarge`` → 413 by the app's handler).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import errno
+import json
+import logging
+import socket
+from collections.abc import Awaitable, Callable, Iterable, MutableMapping
+from typing import Any
+
+from starlette.requests import Request
+
+from indus.foundation.clock import Clock
+
+__all__ = [
+    "BIND_ATTEMPTS",
+    "BIND_DELAY_S",
+    "BearerGate",
+    "BodyTooLarge",
+    "CorsGate",
+    "HttpServer",
+    "LengthGate",
+    "SecurityHeaders",
+    "bind_listener",
+    "is_loopback",
+    "read_body",
+]
+
+log = logging.getLogger(__name__)
+
+BIND_ATTEMPTS = 5
+BIND_DELAY_S = 1.0
+SHUTDOWN_GRACE_S = 3.0
+LOOPBACK_HOSTS = frozenset({"127.0.0.1", "localhost", "::1"})
+
+type Scope_ = MutableMapping[str, Any]
+type Receive = Callable[[], Awaitable[MutableMapping[str, Any]]]
+type Send = Callable[[MutableMapping[str, Any]], Awaitable[None]]
+type Asgi = Callable[[Scope_, Receive, Send], Awaitable[None]]
+
+SECURITY_HEADERS: tuple[tuple[bytes, bytes], ...] = (
+    (b"x-content-type-options", b"nosniff"),
+    (b"x-frame-options", b"DENY"),
+    (b"referrer-policy", b"no-referrer"),
+    (b"content-security-policy", b"default-src 'none'; frame-ancestors 'none'"),
+    (b"cache-control", b"no-store"),
+    (b"cross-origin-resource-policy", b"same-origin"),
+)
+
+
+def is_loopback(host: str | None) -> bool:
+    return bool(host) and str(host).strip().lower() in LOOPBACK_HOSTS
+
+
+# -- binding and serving ------------------------------------------------------------------------
+
+
+def _open_socket(host: str, port: int) -> socket.socket:
+    infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM, flags=socket.AI_PASSIVE)
+    family, kind, proto, _, address = infos[0]
+    sock = socket.socket(family, kind, proto)
+    try:
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        sock.bind(address)
+        sock.listen(128)
+        sock.setblocking(False)
+    except BaseException:
+        sock.close()
+        raise
+    return sock
+
+
+async def bind_listener(
+    host: str,
+    port: int,
+    clock: Clock,
+    *,
+    attempts: int = BIND_ATTEMPTS,
+    delay: float = BIND_DELAY_S,
+    opener: Callable[[str, int], socket.socket] = _open_socket,
+) -> socket.socket:
+    """A listening socket on ``host:port`` (see the module notes)."""
+    for attempt in range(1, attempts + 1):
+        try:
+            return opener(host, port)
+        except OSError as exc:
+            if exc.errno != errno.EADDRINUSE or attempt == attempts:
+                raise
+            log.info("port %s:%d is busy (attempt %d of %d)", host, port, attempt, attempts)
+            await clock.sleep(delay)
+    raise AssertionError("unreachable")  # pragma: no cover
+
+
+class HttpServer:
+    """One ASGI app served by uvicorn on a socket we bound (see the module notes)."""
+
+    def __init__(self, app: Asgi, sock: socket.socket, *, name: str) -> None:
+        self.app = app
+        self.sock = sock
+        self.name = name
+        self._server: Any = None
+        self._task: asyncio.Task[None] | None = None
+
+    @property
+    def address(self) -> tuple[str, int]:
+        host, port = self.sock.getsockname()[:2]
+        return str(host), int(port)
+
+    async def start(self) -> None:
+        import uvicorn
+
+        config = uvicorn.Config(
+            self.app,
+            lifespan="off",
+            log_config=None,
+            access_log=False,
+            server_header=False,
+            proxy_headers=False,
+            ws="none",
+            timeout_graceful_shutdown=int(SHUTDOWN_GRACE_S),
+        )
+        config.load()
+        server = uvicorn.Server(config)
+        server.lifespan = config.lifespan_class(config)  # pyright: ignore[reportAttributeAccessIssue]
+        await server.startup(sockets=[self.sock])
+        if server.should_exit:
+            raise OSError(f"the {self.name} server could not start")
+        self._server = server
+        self._task = asyncio.ensure_future(server.main_loop())
+        host, port = self.address
+        log.info("%s listening on %s:%d", self.name, host, port)
+
+    async def stop(self) -> None:
+        server, task = self._server, self._task
+        self._server = self._task = None
+        if server is None:
+            self.sock.close()
+            return
+        server.should_exit = True
+        if task is not None:
+            with contextlib.suppress(Exception):
+                await task
+        with contextlib.suppress(Exception):
+            await server.shutdown(sockets=[self.sock])
+        self.sock.close()
+
+
+# -- request bodies -----------------------------------------------------------------------------
+
+
+class BodyTooLarge(Exception):
+    def __init__(self, limit: int) -> None:
+        super().__init__(f"the request body is larger than {limit} bytes")
+        self.limit = limit
+
+
+async def read_body(request: Request, limit: int) -> bytes:
+    """The request body, refused with ``BodyTooLarge`` once more than ``limit`` bytes arrive."""
+    declared = request.headers.get("content-length")
+    if declared is not None and declared.strip().isdigit() and int(declared) > limit:
+        raise BodyTooLarge(limit)
+    chunks: list[bytes] = []
+    size = 0
+    async for chunk in request.stream():
+        size += len(chunk)
+        if size > limit:
+            raise BodyTooLarge(limit)
+        chunks.append(chunk)
+    return b"".join(chunks)
+
+
+# -- ASGI layers --------------------------------------------------------------------------------
+
+
+def _header(scope: Scope_, name: bytes) -> str | None:
+    for key, value in scope.get("headers") or ():
+        if key.lower() == name:
+            return value.decode("latin-1")
+    return None
+
+
+async def send_json(
+    send: Send, status: int, body: object, headers: Iterable[tuple[bytes, bytes]] = ()
+) -> None:
+    data = json.dumps(body).encode()
+    await send(
+        {
+            "type": "http.response.start",
+            "status": status,
+            "headers": [
+                (b"content-type", b"application/json"),
+                (b"content-length", str(len(data)).encode()),
+                *headers,
+            ],
+        }
+    )
+    await send({"type": "http.response.body", "body": data})
+
+
+class SecurityHeaders:
+    def __init__(self, app: Asgi) -> None:
+        self.app = app
+
+    async def __call__(self, scope: Scope_, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        async def wrapped(message: MutableMapping[str, Any]) -> None:
+            if message["type"] == "http.response.start":
+                headers = list(message.get("headers") or [])
+                present = {k.lower() for k, _ in headers}
+                headers.extend((k, v) for k, v in SECURITY_HEADERS if k not in present)
+                message["headers"] = headers
+            await send(message)
+
+        await self.app(scope, receive, wrapped)
+
+
+class CorsGate:
+    """See the module notes. ``origins`` may contain ``*`` (every origin)."""
+
+    def __init__(self, app: Asgi, origins: Callable[[], Iterable[str]]) -> None:
+        self.app = app
+        self.origins = origins
+
+    def _allowed(self, origin: str) -> bool:
+        allowed = {o.strip().rstrip("/") for o in self.origins() if o.strip()}
+        return "*" in allowed or origin.rstrip("/") in allowed
+
+    async def __call__(self, scope: Scope_, receive: Receive, send: Send) -> None:
+        origin = _header(scope, b"origin") if scope["type"] == "http" else None
+        if origin is None:
+            await self.app(scope, receive, send)
+            return
+        if not self._allowed(origin):
+            await send_json(
+                send,
+                403,
+                {
+                    "error": {
+                        "message": "origin not allowed",
+                        "type": "invalid_request_error",
+                        "param": None,
+                        "code": "origin_not_allowed",
+                    }
+                },
+            )
+            return
+        cors = [
+            (b"access-control-allow-origin", origin.encode("latin-1")),
+            (b"vary", b"Origin"),
+            (
+                b"access-control-allow-headers",
+                b"Authorization, Content-Type, Last-Event-ID, X-Indus-Session-Id",
+            ),
+            (b"access-control-allow-methods", b"GET, POST, PATCH, DELETE, OPTIONS"),
+            (b"access-control-expose-headers", b"X-Indus-Session-Id"),
+            (b"access-control-max-age", b"600"),
+        ]
+        if scope.get("method") == "OPTIONS":
+            await send({"type": "http.response.start", "status": 204, "headers": cors})
+            await send({"type": "http.response.body", "body": b""})
+            return
+
+        async def wrapped(message: MutableMapping[str, Any]) -> None:
+            if message["type"] == "http.response.start":
+                message["headers"] = [*(message.get("headers") or []), *cors]
+            await send(message)
+
+        await self.app(scope, receive, wrapped)
+
+
+AUTH_FAILED = {
+    "error": {
+        "message": "a valid API key is required (Authorization: Bearer <key>; "
+        "make one with `indus gateway api-key create`)",
+        "type": "invalid_request_error",
+        "param": None,
+        "code": "invalid_api_key",
+    }
+}
+
+
+class BearerGate:
+    """See the module notes. ``verify(token)`` returns the key id or None."""
+
+    def __init__(self, app: Asgi, verify: Callable[[str], str | None]) -> None:
+        self.app = app
+        self.verify = verify
+
+    async def __call__(self, scope: Scope_, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        header = _header(scope, b"authorization") or ""
+        scheme, _, token = header.partition(" ")
+        key_id: str | None = None
+        if scheme.lower() == "bearer" and token.strip():
+            try:
+                key_id = self.verify(token.strip())
+            except Exception:
+                log.warning("the API key check failed", exc_info=True)
+                key_id = None
+        if key_id is None:
+            client = scope.get("client")
+            log.info(
+                "API request refused: missing or wrong key (%s %s from %s)",
+                scope.get("method"),
+                scope.get("path"),
+                client[0] if client else "?",
+            )
+            await send_json(send, 401, AUTH_FAILED, [(b"www-authenticate", b"Bearer")])
+            return
+        state = scope.setdefault("state", {})
+        state["api_key_id"] = key_id
+        await self.app(scope, receive, send)
+
+
+class LengthGate:
+    def __init__(self, app: Asgi, limit: int, body: Callable[[int], object]) -> None:
+        self.app = app
+        self.limit = limit
+        self.body = body
+
+    async def __call__(self, scope: Scope_, receive: Receive, send: Send) -> None:
+        if scope["type"] == "http":
+            declared = _header(scope, b"content-length")
+            if declared is not None:
+                text = declared.strip()
+                if not text.isdigit():
+                    await send_json(send, 400, self.body(-1))
+                    return
+                if int(text) > self.limit:
+                    await send_json(send, 413, self.body(self.limit))
+                    return
+        await self.app(scope, receive, send)
+
+
+# -- JSON helpers the apps share ----------------------------------------------------------------
+
+
+class BadRequest(Exception):
+    """A request the app answers with ``status`` and the OpenAI error envelope."""
+
+    def __init__(
+        self, message: str, *, status: int = 400, code: str | None = None, param: str | None = None
+    ) -> None:
+        super().__init__(message)
+        self.message = message
+        self.status = status
+        self.code = code
+        self.param = param
+
+    def body(self) -> dict[str, Any]:
+        kind = "invalid_request_error" if self.status < 500 else "server_error"
+        if self.status == 429:
+            kind = "rate_limit_error"
+        return {
+            "error": {"message": self.message, "type": kind, "param": self.param, "code": self.code}
+        }
+
+
+async def read_json(request: Request, limit: int) -> Any:
+    """The request's JSON body (``BodyTooLarge`` over ``limit``; ``BadRequest`` when not JSON)."""
+    raw = await read_body(request, limit)
+    if not raw.strip():
+        raise BadRequest("the request body must be JSON", code="invalid_json")
+    try:
+        return json.loads(raw)
+    except (ValueError, UnicodeDecodeError):
+        raise BadRequest("the request body is not valid JSON", code="invalid_json") from None
diff --git a/src/indus/gateway/http/turns.py b/src/indus/gateway/http/turns.py
new file mode 100644
index 0000000..1ab724a
--- /dev/null
+++ b/src/indus/gateway/http/turns.py
@@ -0,0 +1,426 @@
+"""One agent turn for an HTTP caller, over the session service (P15-30..32).
+
+``SessionDesk`` serves one HTTP surface (the API server or the webhook receiver) from the session
+service the daemon built for it:
+
+- ``open(session_id)`` resumes a stored session, or creates one with the surface's toolsets;
+- ``start(session_id, text, run_context=...)`` sets who is watching (``interactive`` for runs
+  whose client answers approvals, ``unattended`` otherwise: the P05 approval policy then denies a
+  flagged command at once, R02.27), subscribes to the session's events and server requests,
+  submits the text and returns a ``Turn``;
+- a ``Turn`` hands out its own events (``events()``; other turns of the session are filtered out)
+  and its outcome (``outcome()``): final text, exit reason, failure and the turn's token counts;
+- a session the desk opened is closed after ``idle_close_s`` with no turn running, unless a turn
+  starts again (background work delivered later starts its own turn through the service and
+  restarts the timer);
+- a turn the desk did not start (a background result the service delivered by itself) is written
+  to the ``CompletionLog``, the durable row pollers read (P15-31).
+
+Every method runs on the service's event loop.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import json
+import logging
+from collections.abc import AsyncIterator, Callable, Sequence
+from dataclasses import dataclass, field
+from typing import Any, Literal, Protocol
+
+from indus.core.session_scheduler import TurnEnd
+from indus.foundation import fsio
+from indus.foundation.clock import Clock
+from indus.foundation.profiles import mkdir_in_profile
+from indus.foundation.scope import Scope
+from indus.protocol.base import ProtocolModel
+from indus.protocol.events import EventBase, ExitReason
+from indus.protocol.methods import SessionCreateParams
+from indus.service.session_service import SessionService
+
+__all__ = [
+    "CompletionLog",
+    "FileCompletionLog",
+    "SessionDesk",
+    "Turn",
+    "TurnGate",
+    "TurnOutcome",
+]
+
+log = logging.getLogger(__name__)
+
+type RunContext = Literal["interactive", "unattended"]
+
+_SHORT = frozenset({ExitReason.MAX_ITERATIONS, ExitReason.BUDGET_EXHAUSTED})
+
+
+# -- outcome ------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True, slots=True)
+class TurnOutcome:
+    session_id: str
+    turn_id: str
+    generation: int
+    text: str
+    exit_reason: ExitReason | None  # None: the turn's result could not be read
+    failure: str | None = None
+    reasoning: str | None = None
+    prompt_tokens: int = 0
+    completion_tokens: int = 0
+
+    @property
+    def completed(self) -> bool:
+        return self.exit_reason is ExitReason.COMPLETED
+
+    @property
+    def interrupted(self) -> bool:
+        """Stopped on purpose (a client or the host); a system interruption is a failure."""
+        return self.exit_reason is ExitReason.INTERRUPTED_BY_USER
+
+    @property
+    def cut_short(self) -> bool:
+        return self.exit_reason in _SHORT
+
+    @property
+    def unknown(self) -> bool:
+        return self.exit_reason is None
+
+
+# -- the concurrency gate -----------------------------------------------------------------------
+
+
+class TurnGate:
+    """At most ``limit()`` turns at once (0 = no cap); ``enter`` is synchronous (no await between
+    the check and the count)."""
+
+    def __init__(self, limit: Callable[[], int]) -> None:
+        self._limit = limit
+        self.active = 0
+
+    def enter(self) -> bool:
+        cap = self._limit()
+        if cap > 0 and self.active >= cap:
+            return False
+        self.active += 1
+        return True
+
+    def leave(self) -> None:
+        self.active = max(0, self.active - 1)
+
+
+# -- completions for pollers --------------------------------------------------------------------
+
+
+class CompletionLog(Protocol):
+    def record(self, session_id: str, turn_id: str, text: str, completed: bool) -> None: ...
+
+    def recent(self, session_id: str, limit: int = 20) -> list[dict[str, Any]]: ...
+
+
+class FileCompletionLog:
+    """``<home>/gateway/api_completions.jsonl``: one JSON row per background completion; the
+    newest ``keep`` rows are kept."""
+
+    def __init__(self, scope: Scope, *, keep: int = 1_000) -> None:
+        self.scope = scope
+        self.keep = keep
+        self.path = scope.home / "gateway" / "api_completions.jsonl"
+
+    def _rows(self) -> list[dict[str, Any]]:
+        try:
+            lines = self.path.read_text(encoding="utf-8").splitlines()
+        except OSError:
+            return []
+        rows: list[dict[str, Any]] = []
+        for line in lines:
+            with contextlib.suppress(ValueError):
+                row = json.loads(line)
+                if isinstance(row, dict):
+                    rows.append(row)  # pyright: ignore[reportUnknownArgumentType]
+        return rows
+
+    def record(self, session_id: str, turn_id: str, text: str, completed: bool) -> None:
+        mkdir_in_profile(self.scope.home, "gateway")
+        row = {
+            "session_id": session_id,
+            "turn_id": turn_id,
+            "completed": completed,
+            "text": text,
+            "at": self.scope.clock.now().isoformat(timespec="seconds"),
+        }
+        with fsio.FileLock(self.path.with_suffix(".lock"), timeout=10.0):
+            rows = [*self._rows(), row][-self.keep :]
+            data = "".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows)
+            fsio.atomic_write_bytes(self.path, data.encode("utf-8"), mode=0o600)
+
+    def recent(self, session_id: str, limit: int = 20) -> list[dict[str, Any]]:
+        return [r for r in self._rows() if r.get("session_id") == session_id][-limit:]
+
+
+# -- one turn -----------------------------------------------------------------------------------
+
+
+type TurnItem = EventBase | ProtocolModel
+"""A session event of this turn, or a server request (approval, clarify) it raised."""
+
+
+class Turn:
+    """A submitted turn: its events and its outcome (see the module notes)."""
+
+    def __init__(self, service: SessionService, session_id: str) -> None:
+        self.service = service
+        self.session_id = session_id
+        self.turn_id = ""
+        self.generation = 0
+        self._queue: asyncio.Queue[TurnItem | None] = asyncio.Queue()
+        self._early: list[TurnItem] = []
+        self._undo: list[Callable[[], None]] = []
+        self._done: asyncio.Future[TurnOutcome] = asyncio.get_running_loop().create_future()
+        self._ended = False
+
+    # listeners (service loop)
+    def _on_event(self, event: EventBase) -> None:
+        if self._ended:
+            return
+        turn_id = getattr(event, "turn_id", None)
+        if not self.turn_id:
+            self._early.append(event)
+            return
+        if turn_id is not None and turn_id != self.turn_id:
+            return
+        self._queue.put_nowait(event)
+
+    def _on_request(self, request: ProtocolModel) -> None:
+        if self._ended:
+            return
+        turn_id = getattr(request, "turn_id", None)
+        if self.turn_id and turn_id is not None and turn_id != self.turn_id:
+            return
+        self._queue.put_nowait(request)
+
+    def _bind(self, turn_id: str, generation: int) -> None:
+        self.turn_id = turn_id
+        self.generation = generation
+        early, self._early = self._early, []
+        for item in early:
+            item_turn = getattr(item, "turn_id", None)
+            if item_turn is None or item_turn == turn_id:
+                self._queue.put_nowait(item)
+
+    def _finish(self, outcome: TurnOutcome) -> None:
+        self._ended = True
+        for undo in self._undo:
+            undo()
+        self._undo.clear()
+        self._queue.put_nowait(None)
+        if not self._done.done():
+            self._done.set_result(outcome)
+
+    @property
+    def done(self) -> bool:
+        return self._done.done()
+
+    async def events(self) -> AsyncIterator[TurnItem]:
+        """This turn's events and requests, in order, until the turn is over."""
+        while True:
+            item = await self._queue.get()
+            if item is None:
+                return
+            yield item
+
+    async def next_item(self) -> TurnItem | None:
+        """The next event or request; None once the turn is over."""
+        return await self._queue.get()
+
+    async def outcome(self) -> TurnOutcome:
+        return await asyncio.shield(self._done)
+
+    def interrupt(self, *, hard: bool = False) -> bool:
+        if self.done:
+            return False
+        try:
+            return self.service.interrupt(self.session_id, self.generation, hard=hard).interrupted
+        except Exception:
+            log.debug("interrupting turn %s failed", self.turn_id, exc_info=True)
+            return False
+
+
+# -- the desk -----------------------------------------------------------------------------------
+
+
+@dataclass
+class _Idle:
+    handle: asyncio.Task[None] | None = None
+
+
+@dataclass
+class SessionDesk:
+    """The sessions one HTTP surface runs (see the module notes)."""
+
+    service: SessionService
+    clock: Clock
+    toolsets: Sequence[str] | None = None
+    idle_close_s: float = 900.0
+    completions: CompletionLog | None = None
+    _mine: set[str] = field(default_factory=set[str])
+    _started: set[str] = field(default_factory=set[str])
+    _running: dict[str, Turn] = field(default_factory=dict[str, Turn])
+    _idle: dict[str, _Idle] = field(default_factory=dict[str, _Idle])
+    _tasks: set[asyncio.Task[Any]] = field(default_factory=set[asyncio.Task[Any]])
+    _undo: Callable[[], None] | None = None
+    _closed: bool = False
+
+    def __post_init__(self) -> None:
+        self._undo = self.service.on_turn_end(self._turn_ended)
+
+    # -- sessions -------------------------------------------------------------------------------
+
+    async def open(self, session_id: str | None) -> str:
+        """Resume ``session_id`` (ProtocolError when unknown or busy) or create a new session."""
+        if session_id:
+            result = await self.service.resume(session_id)
+            sid = result.session_id
+        else:
+            toolsets = list(self.toolsets) if self.toolsets is not None else None
+            created = await self.service.create(SessionCreateParams(toolsets=toolsets))
+            sid = created.session_id
+        self._mine.add(sid)
+        self._schedule_close(sid)
+        return sid
+
+    def tool_names(self, session_id: str) -> list[str]:
+        return list(self.service.agent(session_id).tool_names)
+
+    def running(self, session_id: str) -> Turn | None:
+        return self._running.get(self.service.current_id(session_id))
+
+    async def start(self, session_id: str, text: str, *, run_context: RunContext) -> Turn:
+        sid = self.service.current_id(session_id)
+        agent = self.service.agent(sid)
+        agent.runtime.run_context = run_context
+        turn = Turn(self.service, sid)
+        turn._undo.append(self.service.subscribe(sid, turn._on_event))  # pyright: ignore[reportPrivateUsage]
+        turn._undo.append(self.service.on_request(sid, turn._on_request))  # pyright: ignore[reportPrivateUsage]
+        before = agent.usage.usage
+        self._cancel_close(sid)
+        try:
+            ticket = await self.service.submit(sid, text)
+        except BaseException:
+            turn._finish(TurnOutcome(sid, "", 0, "", None, "not started"))  # pyright: ignore[reportPrivateUsage]
+            self._schedule_close(sid)
+            raise
+        turn._bind(ticket.turn_id, ticket.generation)  # pyright: ignore[reportPrivateUsage]
+        self._started.add(ticket.turn_id)
+        self._running[sid] = turn
+        self._spawn(self._wait(turn, before))
+        return turn
+
+    async def _wait(self, turn: Turn, before: Any) -> None:
+        sid = turn.session_id
+        try:
+            result = await self.service.wait(sid, turn.turn_id)
+        except BaseException as exc:
+            log.warning("the result of turn %s could not be read: %r", turn.turn_id, exc)
+            if self._running.get(sid) is turn:
+                del self._running[sid]
+            turn._finish(TurnOutcome(sid, turn.turn_id, turn.generation, "", None, str(exc)))  # pyright: ignore[reportPrivateUsage]
+            if not isinstance(exc, Exception):
+                raise
+            self._schedule_close(sid)
+            return
+        else:
+            after = self.service.agent(result.session_id).usage.usage
+            prompt = _prompt_tokens(after) - _prompt_tokens(before)
+            completion = int(after.output_tokens) - int(before.output_tokens)
+            outcome = TurnOutcome(
+                session_id=result.session_id,
+                turn_id=turn.turn_id,
+                generation=turn.generation,
+                text=result.final_text or "",
+                exit_reason=result.exit_reason,
+                failure=result.failure_reason,
+                reasoning=result.reasoning,
+                prompt_tokens=max(0, prompt),
+                completion_tokens=max(0, completion),
+            )
+        finally:
+            if self._running.get(sid) is turn:
+                del self._running[sid]
+        turn._finish(outcome)  # pyright: ignore[reportPrivateUsage]
+        self._mine.add(outcome.session_id)
+        self._schedule_close(outcome.session_id)
+
+    # -- background completions -----------------------------------------------------------------
+
+    def _turn_ended(self, ended: TurnEnd) -> None:
+        if ended.turn_id in self._started:
+            self._started.discard(ended.turn_id)
+            return
+        if ended.session_id not in self._mine:
+            return
+        if self.completions is not None and ended.final_text.strip():
+            try:
+                self.completions.record(
+                    ended.session_id, ended.turn_id, ended.final_text, ended.completed
+                )
+            except Exception:
+                log.warning("could not record the completion of %s", ended.turn_id, exc_info=True)
+        self._schedule_close(ended.session_id)
+
+    # -- idle closing ---------------------------------------------------------------------------
+
+    def _cancel_close(self, session_id: str) -> None:
+        idle = self._idle.pop(session_id, None)
+        if idle is not None and idle.handle is not None:
+            idle.handle.cancel()
+
+    def _schedule_close(self, session_id: str) -> None:
+        if self._closed:
+            return
+        self._cancel_close(session_id)
+        idle = _Idle()
+        due = self.clock.monotonic() + self.idle_close_s
+        idle.handle = self._spawn(self._close_later(session_id, due))
+        self._idle[session_id] = idle
+
+    async def _close_later(self, session_id: str, due: float) -> None:
+        delay = due - self.clock.monotonic()
+        if delay > 0:
+            await self.clock.sleep(delay)
+        self._idle.pop(session_id, None)
+        if session_id in self._running or not self.service.is_idle(session_id):
+            return
+        self._mine.discard(session_id)
+        await self.service.close(session_id)
+
+    # -- tasks ----------------------------------------------------------------------------------
+
+    def _spawn(self, coro: Any) -> asyncio.Task[Any]:
+        task: asyncio.Task[Any] = asyncio.ensure_future(coro)
+        self._tasks.add(task)
+        task.add_done_callback(self._tasks.discard)
+        return task
+
+    @property
+    def active(self) -> int:
+        return len(self._running)
+
+    async def aclose(self) -> None:
+        """Interrupt running turns, stop the timers; the service itself is the daemon's."""
+        self._closed = True
+        if self._undo is not None:
+            self._undo()
+            self._undo = None
+        for turn in list(self._running.values()):
+            turn.interrupt(hard=True)
+        for task in list(self._tasks):
+            task.cancel()
+        for task in list(self._tasks):
+            with contextlib.suppress(asyncio.CancelledError, Exception):
+                await task
+
+
+def _prompt_tokens(usage: Any) -> int:
+    return int(usage.input_tokens) + int(usage.cache_read_tokens) + int(usage.cache_write_tokens)
