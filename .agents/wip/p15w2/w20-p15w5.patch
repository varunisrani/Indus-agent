new file mode 100644
index 0000000..b4eb1e5
--- /dev/null
+++ b/tests/unit/gateway/http/_stubs_w5.py
@@ -0,0 +1,59 @@
+# STAND-IN: removed at integration
+"""Stands in for the P15-24 daemon (W3) around the HTTP surfaces.
+
+What the real daemon does here, and nothing more: build one ``SessionService`` per
+``SurfaceSpec`` it is asked for (toolsets, answerable request kinds and platform taken from the
+spec; for an ``untrusted`` spec no MCP or plugin toolsets), call ``start_http_surfaces`` on its
+own loop with the profile's store handle, and at shutdown close the surfaces before the services.
+Here the services run on the fake model.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from indus.foundation.config import loader
+from indus.foundation.scope import Scope
+from indus.gateway.http import HttpHost, HttpSurfaces, SurfaceSpec, start_http_surfaces
+from indus.service.session_service import SessionService
+from indus.state import registry as store_registry
+from indus.state.api_keys import KeyStore
+from tests.contract.gateway._http_kit import make_service
+from tests.fakes.model import FakeModelServer
+
+
+class DaemonStandIn:
+    def __init__(self, scope: Scope, server: FakeModelServer, tmp_path: Path) -> None:
+        self.scope = scope.with_config(loader.load(scope))
+        self.server = server
+        self.tmp_path = tmp_path
+        self.store = store_registry.open_unshared(scope)
+        self.built: list[SurfaceSpec] = []
+        self.services: list[SessionService] = []
+        self.surfaces: HttpSurfaces | None = None
+
+    def make_service(self, spec: SurfaceSpec) -> SessionService:
+        self.built.append(spec)
+        service = make_service(
+            self.scope,
+            self.server,
+            self.tmp_path / spec.name,
+            self.store,
+            toolsets=list(spec.toolsets),
+            kinds=spec.answerable_kinds,
+            platform=spec.platform,
+        )
+        self.services.append(service)
+        return service
+
+    async def start(self, secrets: KeyStore) -> HttpSurfaces:
+        host = HttpHost(self.scope, services=self.make_service, store=self.store, secrets=secrets)
+        self.surfaces = await start_http_surfaces(host)
+        return self.surfaces
+
+    async def stop(self) -> None:
+        if self.surfaces is not None:
+            await self.surfaces.aclose()
+        for service in self.services:
+            await service.aclose()
+        self.store.close()
