+    make_hook(two, "late", ["gateway:startup"], 'def handle(e, c):\n    return "late"\n')
+    assert run(hooks.emit("gateway:startup")) == ["two"]  # loaded once per home
+    assert [h.name for h in hooks.reload(two)] == ["hook", "late"]
+
