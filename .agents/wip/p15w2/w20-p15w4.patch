@@ -0,0 +1,107 @@
+# STAND-IN: removed at integration
+"""Test-only stand-ins for the W3 daemon (P15-24) that slice W4's tests plug into.
+
+- ``StubDaemon``: the ``DaemonPorts`` the side services need (P15-27/29), with a scripted
+  ``connect_platform`` and a recorded platform status.
+- ``run_command``: a click command standing in for ``indus gateway run`` (``RUN_TARGET``).
+- ``python _stubs_w4.py --home H``: a stand-in daemon process. It writes the runtime status
+  file, serves the real control socket, and on SIGTERM writes ``stub-stopped.json`` saying
+  whether a matching planned-stop record was there before the signal, marks itself stopped and
+  exits 0.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import os
+import signal
+import sys
+import time
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+import click
+
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.scope import Scope
+from indus.gateway.control_socket import ControlServer, Handler
+from indus.gateway.daemon.reconnect import ConnectOutcome
+from indus.service import gateway_runtime
+
+
+@dataclass
+class StubDaemon:
+    scope: Scope
+    pipeline: Any = None
+    hook_bus: Any = None
+    outcomes: list[ConnectOutcome] = field(default_factory=list[ConnectOutcome])
+    connects: list[str] = field(default_factory=list[str])
+    statuses: list[tuple[str, dict[str, Any] | None]] = field(
+        default_factory=list[tuple[str, dict[str, Any] | None]]
+    )
+    handlers: dict[str, tuple[Handler, float]] = field(
+        default_factory=dict[str, tuple[Handler, float]]
+    )
+    state: str = "running"
+
+    def runtime_status(self) -> Mapping[str, Any]:
+        return {"state": self.state, "pid": os.getpid()}
+
+    def control_handlers(self) -> Mapping[str, tuple[Handler, float]]:
+        return self.handlers
+
+    async def connect_platform(self, name: str) -> ConnectOutcome:
+        self.connects.append(name)
+        if self.outcomes:
+            return self.outcomes.pop(0)
+        return ConnectOutcome.retryable("still down")
+
+    def set_platform_status(self, name: str, status: Mapping[str, Any] | None) -> None:
+        self.statuses.append((name, dict(status) if status is not None else None))
+
+
+@click.command("run")
+@click.option("--replace", is_flag=True)
+def run_command(replace: bool) -> int:
+    click.echo(f"stub gateway run (replace={replace})")
+    return 0
+
+
+async def _serve(home: Path) -> None:
+    pid = os.getpid()
+    start = gateway_runtime.process_start_time(pid)
+    status: dict[str, Any] = {
+        "state": "running",
+        "pid": pid,
+        "start_time": start,
+        "updated_at": time.time(),
+        "platforms": {"telegram": {"state": "connected"}},
+    }
+    atomic_write_json(home / gateway_runtime.STATUS_FILE, status)
+    server = ControlServer(home, status=lambda: status, env=os.environ)
+    await server.start()
+    stop = asyncio.Event()
+    asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, stop.set)
+    await stop.wait()
+    planned = gateway_runtime.read_planned_stop(home)
+    ok = planned is not None and planned.matches(pid, start)
+    (home / "stub-stopped.json").write_text(json.dumps({"planned": ok}))
+    status.update(state="stopped", updated_at=time.time())
+    atomic_write_json(home / gateway_runtime.STATUS_FILE, status)
+    await server.stop()
+
+
+def main(argv: list[str]) -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--home", required=True)
+    args = parser.parse_args(argv)
+    asyncio.run(_serve(Path(args.home)))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
