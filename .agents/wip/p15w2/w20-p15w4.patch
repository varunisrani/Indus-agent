new file mode 100644
index 0000000..f0affd8
--- /dev/null
+++ b/src/indus/service/gateway_manager.py
@@ -0,0 +1,330 @@
+"""Install, start, stop and ask about the gateway's service (P15-28).
+
+Two managers, both per user and never needing root: ``SystemdUser`` (``systemctl --user``, the
+unit file under ``$XDG_CONFIG_HOME/systemd/user``) and ``Launchd`` (``launchctl`` in the user's
+``gui/<uid>`` domain, the agent under ``~/Library/LaunchAgents``). The tool is looked up on the
+caller's ``PATH`` (the scope's env), so tests put a fake ``systemctl`` there.
+
+``install`` writes the definition (refusing to overwrite a different one without ``force``) and
+registers it; it does not start the gateway on systemd (``indus gateway start`` does), while
+launchd starts an agent as soon as it is loaded (``RunAtLoad``). ``uninstall`` unregisters and
+removes the file. Stopping through the manager is the CLI's job after it has recorded the
+planned stop (``gateway_runtime.mark_planned_stop``).
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal, Protocol
+
+from indus.foundation.errors import IndusError
+from indus.foundation.fsio import atomic_write_text
+from indus.service.gateway_units import (
+    UnitSpec,
+    launch_agents_dir,
+    launchd_plist,
+    systemd_unit,
+    user_unit_dir,
+)
+
+__all__ = [
+    "Completed",
+    "InstallOutcome",
+    "Launchd",
+    "Runner",
+    "ServiceError",
+    "ServiceManager",
+    "SystemdUser",
+    "UnitState",
+    "manager_for",
+]
+
+_TIMEOUT_S = 30.0
+
+
+class ServiceError(IndusError):
+    default_code = "gateway.service"
+
+
+@dataclass(frozen=True)
+class Completed:
+    returncode: int
+    stdout: str = ""
+    stderr: str = ""
+
+
+type Runner = Callable[[Sequence[str]], Completed]
+
+type InstallOutcome = Literal["written", "unchanged", "conflict"]
+
+
+@dataclass(frozen=True)
+class UnitState:
+    """``active``: ``active`` / ``activating`` / ``deactivating`` / ``inactive`` / ``failed`` /
+    ``unknown``."""
+
+    installed: bool
+    active: str = "unknown"
+    main_pid: int | None = None
+    detail: str = ""
+
+    @property
+    def running(self) -> bool:
+        return self.active in ("active", "activating", "reloading")
+
+
+class ServiceManager(Protocol):
+    kind: str
+    tool: str
+    spec: UnitSpec
+
+    @property
+    def path(self) -> Path: ...
+
+    def available(self) -> bool: ...
+
+    def installed(self) -> bool: ...
+
+    def definition(self) -> str: ...
+
+    def install(self, *, force: bool = False) -> InstallOutcome: ...
+
+    def uninstall(self) -> None: ...
+
+    def start(self) -> None: ...
+
+    def stop(self) -> None: ...
+
+    def restart(self) -> None: ...
+
+    def state(self) -> UnitState: ...
+
+
+def _default_runner(tool: str, env: Mapping[str, str]) -> Runner:
+    def run(args: Sequence[str]) -> Completed:
+        binary = shutil.which(tool, path=env.get("PATH", ""))
+        if binary is None:
+            raise ServiceError(f"`{tool}` was not found on PATH")
+        try:
+            done = subprocess.run(
+                [binary, *args],
+                capture_output=True,
+                text=True,
+                timeout=_TIMEOUT_S,
+                check=False,
+                env=dict(env),
+            )
+        except subprocess.TimeoutExpired:
+            raise ServiceError(f"`{tool} {' '.join(args)}` did not finish in 30 s") from None
+        except OSError as exc:
+            raise ServiceError(f"`{tool}` could not run: {exc.strerror or exc}") from exc
+        return Completed(done.returncode, done.stdout or "", done.stderr or "")
+
+    return run
+
+
+def _write(path: Path, text: str, force: bool) -> InstallOutcome:
+    try:
+        current = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        current = None
+    if current == text:
+        return "unchanged"
+    if current is not None and not force:
+        return "conflict"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    atomic_write_text(path, text, mode=0o644)
+    return "written"
+
+
+class _Base:
+    kind = ""
+    tool = ""
+
+    def __init__(
+        self, spec: UnitSpec, env: Mapping[str, str], runner: Runner | None = None
+    ) -> None:
+        self.spec = spec
+        self.env = env
+        self._runner = runner or _default_runner(self.tool, env)
+
+    def available(self) -> bool:
+        return shutil.which(self.tool, path=self.env.get("PATH", "")) is not None
+
+    def _run(self, *args: str, check: bool = True) -> Completed:
+        done = self._runner(args)
+        if check and done.returncode != 0:
+            said = (done.stderr or done.stdout).strip()
+            raise ServiceError(
+                f"`{self.tool} {' '.join(args)}` failed ({done.returncode})"
+                + (f": {said}" if said else "")
+            )
+        return done
+
+
+class SystemdUser(_Base):
+    kind = "systemd"
+    tool = "systemctl"
+
+    @property
+    def path(self) -> Path:
+        return user_unit_dir(self.env) / self.spec.unit_file
+
+    def installed(self) -> bool:
+        return self.path.is_file()
+
+    def definition(self) -> str:
+        return systemd_unit(self.spec)
+
+    def _ctl(self, *args: str, check: bool = True) -> Completed:
+        return self._run("--user", *args, check=check)
+
+    def install(self, *, force: bool = False) -> InstallOutcome:
+        outcome = _write(self.path, self.definition(), force)
+        if outcome == "conflict":
+            return outcome
+        self._ctl("daemon-reload")
+        self._ctl("enable", self.spec.unit_file)
+        return outcome
+
+    def uninstall(self) -> None:
+        if self.installed():
+            self._ctl("disable", self.spec.unit_file, check=False)
+            self.path.unlink()
+        self._ctl("daemon-reload", check=False)
+        self._ctl("reset-failed", self.spec.unit_file, check=False)
+
+    def start(self) -> None:
+        self._ctl("start", self.spec.unit_file)
+
+    def stop(self) -> None:
+        self._ctl("stop", self.spec.unit_file)
+
+    def restart(self) -> None:
+        self._ctl("restart", self.spec.unit_file)
+
+    def state(self) -> UnitState:
+        if not self.installed():
+            return UnitState(False)
+        try:
+            done = self._ctl(
+                "show",
+                self.spec.unit_file,
+                "--no-pager",
+                "--property",
+                "ActiveState,SubState,MainPID,Result",
+                check=False,
+            )
+        except ServiceError as exc:
+            return UnitState(True, detail=exc.message)
+        props = dict(line.split("=", 1) for line in done.stdout.splitlines() if "=" in line)
+        pid = props.get("MainPID", "").strip()
+        sub = props.get("SubState", "").strip()
+        result = props.get("Result", "").strip()
+        detail = ", ".join(p for p in (sub, result if result != "success" else "") if p)
+        return UnitState(
+            True,
+            active=props.get("ActiveState", "").strip() or "unknown",
+            main_pid=int(pid) if pid.isdigit() and int(pid) > 0 else None,
+            detail=detail,
+        )
+
+
+class Launchd(_Base):
+    kind = "launchd"
+    tool = "launchctl"
+
+    def __init__(
+        self,
+        spec: UnitSpec,
+        env: Mapping[str, str],
+        runner: Runner | None = None,
+        *,
+        uid: int | None = None,
+    ) -> None:
+        super().__init__(spec, env, runner)
+        self.uid = os.getuid() if uid is None else uid
+
+    @property
+    def path(self) -> Path:
+        return launch_agents_dir(self.env) / f"{self.spec.label}.plist"
+
+    @property
+    def domain(self) -> str:
+        return f"gui/{self.uid}"
+
+    @property
+    def target(self) -> str:
+        return f"{self.domain}/{self.spec.label}"
+
+    def installed(self) -> bool:
+        return self.path.is_file()
+
+    def definition(self) -> str:
+        return launchd_plist(self.spec)
+
+    def _loaded(self) -> bool:
+        return self._run("print", self.target, check=False).returncode == 0
+
+    def install(self, *, force: bool = False) -> InstallOutcome:
+        outcome = _write(self.path, self.definition(), force)
+        if outcome == "conflict":
+            return outcome
+        if self._loaded():
+            self._run("bootout", self.target, check=False)
+        self._run("bootstrap", self.domain, str(self.path))
+        return outcome
+
+    def uninstall(self) -> None:
+        if self._loaded():
+            self._run("bootout", self.target, check=False)
+        if self.installed():
+            self.path.unlink()
+
+    def start(self) -> None:
+        if not self._loaded():
+            self._run("bootstrap", self.domain, str(self.path))
+        self._run("kickstart", self.target)
+
+    def stop(self) -> None:
+        # A clean exit (0) is not restarted (KeepAlive.SuccessfulExit=false).
+        self._run("kill", "SIGTERM", self.target)
+
+    def restart(self) -> None:
+        self._run("kickstart", "-k", self.target)
+
+    def state(self) -> UnitState:
+        if not self.installed():
+            return UnitState(False)
+        done = self._run("print", self.target, check=False)
+        if done.returncode != 0:
+            return UnitState(True, active="inactive", detail="not loaded")
+        state, pid = "unknown", None
+        for raw in done.stdout.splitlines():
+            key, _, value = raw.strip().partition(" = ")
+            if key == "state":
+                state = "active" if value.strip() == "running" else "inactive"
+            elif key == "pid" and value.strip().isdigit():
+                pid = int(value.strip())
+        return UnitState(True, active=state, main_pid=pid)
+
+
+def manager_for(
+    spec: UnitSpec,
+    env: Mapping[str, str],
+    *,
+    platform: str,
+    runner: Runner | None = None,
+) -> ServiceManager | None:
+    """The user-level service manager for ``platform`` (``sys.platform``), or None (Windows and
+    anything else: no native service in 1.0, D-16.55)."""
+    if platform.startswith("linux"):
+        return SystemdUser(spec, env, runner)
+    if platform == "darwin":
+        return Launchd(spec, env, runner)
+    return None
diff --git a/src/indus/service/gateway_runtime.py b/src/indus/service/gateway_runtime.py
new file mode 100644
index 0000000..71b2bc0
--- /dev/null
+++ b/src/indus/service/gateway_runtime.py
@@ -0,0 +1,264 @@
+"""Files a gateway leaves in its profile home, read and written by both the daemon and the CLI
+(P15-28; D-16.246 keeps them below the surfaces).
+
+- Runtime status (``gateway_status.json``, written by the daemon, P15-24): ``read_status`` turns
+  it into running / stale / stopped. A file is stale when its ``updated_at`` heartbeat is older
+  than ``STALE_AFTER_S`` (the daemon refreshes it every 60 s) or its pid is gone or now belongs
+  to another process (pid + start time, never bare pid: R06.18).
+- Planned stop (``gateway_planned_stop.json``): written by ``indus gateway stop`` / the unit's
+  ``ExecStop`` *before* the signal, so the daemon can tell a stop that was asked for from an
+  external kill (P15-25). It names the pid and start time it was meant for; a record for another
+  process means nothing.
+- Process identity: ``process_start_time`` is a per-process start fingerprint (Linux: field 22 of
+  ``/proc/<pid>/stat``; elsewhere ``ps``'s start time). Values are only compared with values read
+  the same way on the same host.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import errno
+import json
+import os
+import subprocess
+import sys
+import time
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Literal, cast
+
+from indus.foundation.fsio import atomic_write_json
+
+__all__ = [
+    "PLANNED_STOP_FILE",
+    "STALE_AFTER_S",
+    "STATUS_FILE",
+    "STDIO_LOG",
+    "PlannedStop",
+    "RuntimeView",
+    "alive",
+    "clear_planned_stop",
+    "mark_planned_stop",
+    "pid_exists",
+    "process_start_time",
+    "read_planned_stop",
+    "read_status",
+    "stdio_log_path",
+]
+
+STATUS_FILE = "gateway_status.json"
+PLANNED_STOP_FILE = "gateway_planned_stop.json"
+STDIO_LOG = "gateway-stdio.log"
+STALE_AFTER_S = 120.0
+
+_DOWN_STATES = frozenset({"stopped", "startup_failed"})
+
+
+# -- process identity -----------------------------------------------------------------------------
+
+
+def pid_exists(pid: int) -> bool:
+    """A process with ``pid`` exists (whoever owns it)."""
+    if pid < 1:
+        return False
+    try:
+        os.kill(pid, 0)  # signal 0 delivers nothing; it only asks
+    except OSError as exc:
+        return exc.errno == errno.EPERM
+    return True
+
+
+def _ps_start_time(pid: int) -> int | None:
+    try:
+        done = subprocess.run(
+            ["ps", "-o", "lstart=", "-p", str(pid)],
+            capture_output=True,
+            text=True,
+            timeout=2.0,
+            check=False,
+            env={"LC_ALL": "C", "PATH": "/bin:/usr/bin:/usr/sbin:/sbin"},
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    text = " ".join(done.stdout.split())
+    try:
+        return int(time.mktime(time.strptime(text, "%a %b %d %H:%M:%S %Y"))) if text else None
+    except ValueError:
+        return None
+
+
+def process_start_time(pid: int) -> int | None:
+    """See the module notes; None when unknown."""
+    if pid < 1 or sys.platform == "win32":
+        return None
+    if sys.platform.startswith("linux"):
+        try:
+            raw = Path(f"/proc/{pid}/stat").read_text(encoding="ascii", errors="replace")
+        except OSError:
+            return None
+        # The command name sits in parentheses and may itself contain ')' or spaces.
+        rest = raw.rsplit(")", 1)[-1].split()
+        try:
+            return int(rest[19])
+        except (IndexError, ValueError):
+            return None
+    return _ps_start_time(pid)
+
+
+def _zombie(pid: int) -> bool:
+    """Linux: the process has exited and only waits to be reaped."""
+    if not sys.platform.startswith("linux"):
+        return False
+    try:
+        raw = Path(f"/proc/{pid}/stat").read_text(encoding="ascii", errors="replace")
+    except OSError:
+        return False
+    rest = raw.rsplit(")", 1)[-1].split()
+    return bool(rest) and rest[0] in ("Z", "X")
+
+
+def alive(pid: int, start_time: int | None) -> bool:
+    """``pid`` still runs the same process: it exists, has not exited (a zombie is gone) and,
+    when both start times are known, they match (a recycled pid is not alive)."""
+    if not pid_exists(pid) or _zombie(pid):
+        return False
+    if start_time is None:
+        return True
+    current = process_start_time(pid)
+    return current is None or current == start_time
+
+
+# -- runtime status -------------------------------------------------------------------------------
+
+type Liveness = Literal["running", "stale", "stopped", "missing"]
+
+
+@dataclass(frozen=True)
+class RuntimeView:
+    """The status file as the CLI sees it. ``state`` is the gateway's own word (``running``,
+    ``draining``, ``degraded``, ...); ``liveness`` is ours."""
+
+    liveness: Liveness
+    state: str = ""
+    pid: int | None = None
+    start_time: int | None = None
+    age_s: float | None = None
+    reason: str = ""
+    data: dict[str, Any] | None = None
+
+
+def _as_int(value: object) -> int | None:
+    if isinstance(value, bool) or not isinstance(value, int):
+        return None
+    return value
+
+
+def _epoch(value: object) -> float | None:
+    """``updated_at`` as epoch seconds: a number, or an ISO-8601 text with a zone."""
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int | float):
+        return float(value)
+    if isinstance(value, str) and value:
+        try:
+            parsed = datetime.fromisoformat(value)
+        except ValueError:
+            return None
+        return parsed.timestamp() if parsed.tzinfo is not None else None
+    return None
+
+
+def status_path(home: Path) -> Path:
+    return home / STATUS_FILE
+
+
+def read_status(home: Path, *, now: float | None = None) -> RuntimeView:
+    """Read ``<home>/gateway_status.json``; never raises."""
+    path = status_path(home)
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return RuntimeView("missing")
+    except OSError as exc:
+        return RuntimeView("stale", reason=f"the status file cannot be read ({exc.strerror})")
+    try:
+        loaded: object = json.loads(raw)
+    except ValueError:
+        return RuntimeView("stale", reason="the status file is not valid JSON")
+    if not isinstance(loaded, dict):
+        return RuntimeView("stale", reason="the status file is not a JSON object")
+    data = cast(dict[str, Any], loaded)
+    state = str(data.get("state") or "")
+    pid = _as_int(data.get("pid"))
+    start = _as_int(data.get("start_time"))
+    updated = _epoch(data.get("updated_at"))
+    current = time.time() if now is None else now
+    age = None if updated is None else max(0.0, current - updated)
+    base = RuntimeView("running", state, pid, start, age, "", data)
+    if state in _DOWN_STATES:
+        return RuntimeView("stopped", state, pid, start, age, data.get("exit_reason") or "", data)
+    if pid is None or not alive(pid, start):
+        why = "its process is gone" if pid is not None else "it names no process"
+        return RuntimeView("stale", state, pid, start, age, why, data)
+    if age is None or age > STALE_AFTER_S:
+        return RuntimeView("stale", state, pid, start, age, "no heartbeat for over 120 s", data)
+    return base
+
+
+# -- planned stop ---------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class PlannedStop:
+    pid: int
+    start_time: int | None
+    at: float
+    by: str
+
+    def matches(self, pid: int, start_time: int | None) -> bool:
+        if pid != self.pid:
+            return False
+        return self.start_time is None or start_time is None or self.start_time == start_time
+
+
+def planned_stop_path(home: Path) -> Path:
+    return home / PLANNED_STOP_FILE
+
+
+def mark_planned_stop(
+    home: Path, pid: int, start_time: int | None, *, by: str, now: float | None = None
+) -> Path:
+    """Record that stopping ``pid`` was asked for (written before any signal)."""
+    record = {
+        "pid": pid,
+        "start_time": start_time,
+        "at": time.time() if now is None else now,
+        "by": by,
+    }
+    return atomic_write_json(planned_stop_path(home), record, mode=0o600)
+
+
+def read_planned_stop(home: Path) -> PlannedStop | None:
+    try:
+        loaded: object = json.loads(planned_stop_path(home).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    if not isinstance(loaded, dict):
+        return None
+    data = cast(dict[str, Any], loaded)
+    pid = _as_int(data.get("pid"))
+    at = data.get("at")
+    if pid is None or isinstance(at, bool) or not isinstance(at, int | float):
+        return None
+    return PlannedStop(pid, _as_int(data.get("start_time")), float(at), str(data.get("by") or ""))
+
+
+def clear_planned_stop(home: Path) -> None:
+    with contextlib.suppress(FileNotFoundError):
+        planned_stop_path(home).unlink()
+
+
+def stdio_log_path(home: Path) -> Path:
+    """Where a detached ``indus gateway run`` writes what it prints."""
+    return home / "logs" / STDIO_LOG
