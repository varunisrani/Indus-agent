+def built(scope: Scope, monkeypatch: pytest.MonkeyPatch) -> Iterator[list[RecordingAdapter]]:
+    """Telegram enabled (a fake token in the secret store) and adapters from the fake wire."""
+    secrets: Any = scope.secrets
