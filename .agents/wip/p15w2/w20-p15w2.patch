+# STAND-IN: removed at integration
+"""A home-channel deliverer for one adapter, standing in for P15-20's platform deliverers (W1).
+
+P15-20 registers the real ones (home channel from config, ``platform:chat[:thread]``, ``origin``,
+``all``, truncation); this only sends a cron result to a fixed chat so P15-21 can be tested.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+
+from indus.cron import delivery
+from indus.cron.delivery import DeliveryReceipt, DeliveryRequest
+from indus.gateway.adapters.base import Adapter
+
+
+def register_home_deliverer(adapter: Adapter, home_chat: str) -> Callable[[], None]:
+    async def deliver(request: DeliveryRequest) -> DeliveryReceipt:
+        chat = request.target.chat_id or home_chat
+        sent = await adapter.send(str(chat), request.text)
+        if not sent.ok:
+            return DeliveryReceipt(ok=False, error=sent.error or "send failed")
+        return DeliveryReceipt(ok=True, message_id=sent.message_id)
+
+    return delivery.register_deliverer(adapter.platform, deliver)
