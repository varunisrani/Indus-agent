index 0000000..9f49285
--- /dev/null
+++ b/src/indus/gateway/daemon/command.py
@@ -0,0 +1,52 @@
+"""``indus gateway run``: the gateway in the foreground (P15-24).
+
+The ``indus gateway`` group (P15-28) registers this command by its ``"module:attr"`` string,
+``indus.gateway.daemon.command:run_command``, so the CLI never imports the gateway (D-16.246).
+The exit code is the daemon's: 0 clean, 75 restart me, 78 fatal configuration.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import sys
+from typing import Any
+
+import click
+
+from indus.foundation import log as logsetup
+from indus.foundation.scope import Scope
+
+__all__ = ["main", "run_command"]
+
+
+def main(scope: Scope, *, replace: bool = False) -> int:
+    """Run the daemon for ``scope`` on a fresh event loop; the exit code."""
+    from indus.gateway.daemon.process import DaemonOptions, GatewayDaemon
+
+    daemon = GatewayDaemon(scope, options=DaemonOptions(replace=replace))
+    code = asyncio.run(daemon.run())
+    if daemon.holder is not None and code in (0, 75):
+        print(
+            f"indus gateway: already running for this profile (pid {daemon.holder.pid})",
+            file=sys.stderr,
+        )
+    return code
+
+
+@click.command(
+    "run",
+    help="Run the messaging gateway in the foreground (one per profile).",
+)
+@click.option(
+    "--replace",
+    is_flag=True,
+    help="Stop a gateway already serving this profile and take over.",
+)
+@click.pass_context
+def run_command(ctx: click.Context, replace: bool) -> None:
+    state: Any = ctx.obj
+    scope = getattr(state, "scope", None)
+    if not isinstance(scope, Scope):
+        raise click.UsageError("gateway run was started without the process scope")
+    logsetup.setup(scope, "gateway")
+    ctx.exit(main(scope, replace=replace))
diff --git a/src/indus/gateway/daemon/drain.py b/src/indus/gateway/daemon/drain.py
new file mode 100644
index 0000000..410205e
--- /dev/null
+++ b/src/indus/gateway/daemon/drain.py
@@ -0,0 +1,128 @@
+"""The external drain marker (P15-25, R06.20).
+
+A dashboard (or an operator) asks a running gateway to stop taking new turns by writing
+``<home>/gateway_drain.json``; removing it lets turns in again. While a marker is active the daemon
+reports ``draining`` and answers new turns with a maintenance notice.
+
+A marker can outlive what it was written for (a durable volume keeps it across the machine restart
+the drain was for), so it is ignored as stale when either holds:
+- its ``epoch`` differs from this machine's (both known): the boot it was written in is over;
+- its ``requested_at`` is older than ``DRAIN_MAX_AGE`` (3,600 s); writing it again refreshes it.
+Anything else counts: a file that is not valid JSON, or has no fields, is active (when unsure,
+quiesce). A future ``requested_at`` (clock skew) is active.
+
+The epoch is the Linux boot id plus PID 1's start time: stable for one boot of one container or
+VM, different after either restarts. Where neither can be read it is empty, which turns the epoch
+check off (never on by guesswork).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import functools
+import json
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any, Literal, cast
+
+from indus.foundation import fsio
+from indus.state.gateway_runtime import drain_marker_path
+
+__all__ = [
+    "DRAIN_MAX_AGE",
+    "DrainVerdict",
+    "clear_drain_marker",
+    "drain_verdict",
+    "machine_epoch",
+    "write_drain_marker",
+]
+
+DRAIN_MAX_AGE = 3600.0
+
+
+@functools.lru_cache(maxsize=1)
+def machine_epoch() -> str:
+    """``<boot id>:<pid 1 start>`` for this machine instance ("" where neither is readable)."""
+    boot_id = ""
+    first = ""
+    with contextlib.suppress(OSError):
+        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="ascii").strip()
+    with contextlib.suppress(OSError, IndexError):
+        raw = Path("/proc/1/stat").read_text(encoding="ascii", errors="replace")
+        first = raw.rsplit(")", 1)[1].split()[19]
+    return f"{boot_id}:{first}" if boot_id or first else ""
+
+
+def write_drain_marker(
+    home: Path,
+    *,
+    principal: str = "operator",
+    now: datetime | None = None,
+    epoch: str | None = None,
+) -> dict[str, Any]:
+    """Write (or refresh) the drain request; returns what was written."""
+    body: dict[str, Any] = {
+        "action": "drain",
+        "principal": principal,
+        "requested_at": (now or datetime.now(UTC)).astimezone(UTC).isoformat(),
+        "epoch": machine_epoch() if epoch is None else epoch,
+    }
+    fsio.atomic_write_json(drain_marker_path(home), body, mode=0o600)
+    return body
+
+
+def clear_drain_marker(home: Path) -> bool:
+    try:
+        drain_marker_path(home).unlink()
+    except FileNotFoundError:
+        return False
+    return True
+
+
+@dataclass(frozen=True)
+class DrainVerdict:
+    active: bool
+    why: Literal["absent", "requested", "malformed", "other_epoch", "expired"]
+    principal: str = ""
+
+
+def _parse(value: object) -> datetime | None:
+    if not isinstance(value, str) or not value:
+        return None
+    try:
+        when = datetime.fromisoformat(value)
+    except ValueError:
+        return None
+    return when if when.tzinfo is not None else when.replace(tzinfo=UTC)
+
+
+def drain_verdict(
+    home: Path, *, now: datetime, epoch: str | None = None, max_age: float = DRAIN_MAX_AGE
+) -> DrainVerdict:
+    """Is a drain requested right now? (see the module notes)."""
+    path = drain_marker_path(home)
+    try:
+        raw = path.read_text(encoding="utf-8")
+    except FileNotFoundError:
+        return DrainVerdict(False, "absent")
+    except OSError:
+        return DrainVerdict(True, "malformed")
+    try:
+        data = json.loads(raw)
+    except ValueError:
+        return DrainVerdict(True, "malformed")
+    if not isinstance(data, dict):
+        return DrainVerdict(True, "malformed")
+    body = {str(k): v for k, v in cast(dict[object, Any], data).items()}
+    principal = str(body.get("principal") or "")
+    ours = machine_epoch() if epoch is None else epoch
+    theirs = body.get("epoch")
+    if ours and isinstance(theirs, str) and theirs and theirs != ours:
+        return DrainVerdict(False, "other_epoch", principal)
+    requested = _parse(body.get("requested_at"))
+    if requested is not None and (now - requested).total_seconds() > max_age:
+        return DrainVerdict(False, "expired", principal)
+    if not body:
+        return DrainVerdict(True, "malformed")
+    return DrainVerdict(True, "requested", principal)
diff --git a/src/indus/gateway/daemon/lifecycle.py b/src/indus/gateway/daemon/lifecycle.py
new file mode 100644
index 0000000..ef7acc3
--- /dev/null
+++ b/src/indus/gateway/daemon/lifecycle.py
@@ -0,0 +1,270 @@
+"""Signals, drain, restart and stop for the gateway daemon (P15-25).
+
+``Lifecycle`` holds what the daemon was asked to do and why; signal handlers only call into it:
+
+- SIGINT / SIGTERM → ``request_stop``: a stop (exit 0). A second stop while one is under way only
+  hurries the drain. A stop always wins over a pending restart.
+- SIGUSR1 → ``request_restart``: refuse new turns, let the running ones finish (up to
+  ``restart_after_turn_timeout``), then stop and exit 75 for the supervisor to start a new process.
+- SIGUSR2 → the daemon's stack dump (keeps running).
+
+While draining (a stop, a restart wait, or an external drain marker) the intake's pause probe
+(``notice``) answers new turns with a short notice; commands and messages for a conversation that
+is already replying still pass (``AdmissionPipeline``'s pause gate).
+
+``drain_turns`` is the chat-turn part of a stop: every key with a running turn is flagged
+restart-interrupted **before** any wait (a kill during the drain still leaves the flag for boot
+recovery), the turns get ``restart_drain_timeout`` (default 0 s) to finish — a finished one loses
+its flag — and the rest are interrupted, their chats told the work continues after the restart, and
+given the post-interrupt grace to unwind.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import logging
+import signal
+from collections.abc import Callable
+from typing import TYPE_CHECKING, Literal
+
+from indus.foundation.blocking import run_blocking
+from indus.gateway.core.events import Source
+from indus.protocol.methods import ProtocolError
+from indus.state import gateway_routes as routes
+from indus.state.gateway_runtime import EXIT_OK, EXIT_RESTART
+
+if TYPE_CHECKING:
+    from indus.gateway.daemon.process import GatewayDaemon
+
+__all__ = [
+    "INTERRUPTED_REASON",
+    "MAINTENANCE_NOTICE",
+    "RESTARTING_NOTICE",
+    "Lifecycle",
+    "drain_turns",
+    "wait_for_turns",
+]
+
+log = logging.getLogger(__name__)
+
+INTERRUPTED_REASON = "restart_interrupted"
+"""``resume_reason`` of a route whose turn a stop or restart cut short (recovery resumes it)."""
+
+MAINTENANCE_NOTICE = (
+    "The gateway is in maintenance and isn't starting new work right now. "
+    "Please send your message again in a few minutes."
+)
+RESTARTING_NOTICE = (
+    "The gateway is restarting and isn't starting new work. Send your message again in a minute."
+)
+STOPPED_TURN_NOTICE = (
+    "The gateway is restarting, so I stopped working on your message. "
+    "I'll pick it up again as soon as I'm back."
+)
+
+type Mode = Literal["run", "stop", "restart"]
+
+
+class Lifecycle:
+    """What the daemon was asked to do (see the module notes). Use on the daemon's loop."""
+
+    def __init__(self) -> None:
+        self.mode: Mode = "run"
+        self.reason = ""
+        self.exit_code = EXIT_OK
+        self.drain_reason: str | None = None
+        self._requested: asyncio.Event | None = None
+        self._hurry: asyncio.Event | None = None
+        self._installed: list[int] = []
+
+    def _events(self) -> tuple[asyncio.Event, asyncio.Event]:
+        if self._requested is None or self._hurry is None:
+            self._requested = asyncio.Event()
+            self._hurry = asyncio.Event()
+        return self._requested, self._hurry
+
+    # -- requests ----------------------------------------------------------------------------------
+
+    @property
+    def stopping(self) -> bool:
+        return self.mode != "run"
+
+    def request_stop(self, reason: str, *, exit_code: int = EXIT_OK) -> None:
+        requested, hurry = self._events()
+        if self.mode == "stop":
+            log.info("second stop request (%s): interrupting the drain", reason)
+            hurry.set()
+            return
+        if self.mode == "restart":
+            hurry.set()  # a stop cuts the after-turn wait short
+        self.mode = "stop"
+        self.reason = reason
+        self.exit_code = exit_code
+        self.drain_reason = "stopping"
+        requested.set()
+
+    def request_restart(self, reason: str) -> None:
+        requested, _hurry = self._events()
+        if self.mode != "run":
+            return
+        self.mode = "restart"
+        self.reason = reason
+        self.exit_code = EXIT_RESTART
+        self.drain_reason = "restarting"
+        requested.set()
+
+    async def wait_requested(self) -> None:
+        requested, _hurry = self._events()
+        await requested.wait()
+
+    def hurried(self) -> bool:
+        _requested, hurry = self._events()
+        return hurry.is_set()
+
+    async def wait_hurry(self, timeout: float) -> bool:
+        """Sleep up to ``timeout``; True when a second stop request cut it short."""
+        _requested, hurry = self._events()
+        if timeout <= 0:
+            return hurry.is_set()
+        with contextlib.suppress(TimeoutError):
+            await asyncio.wait_for(hurry.wait(), timeout)
+        return hurry.is_set()
+
+    # -- draining ----------------------------------------------------------------------------------
+
+    @property
+    def draining(self) -> bool:
+        return self.drain_reason is not None
+
+    def set_draining(self, reason: str = "maintenance") -> None:
+        """Stop taking new turns (an external drain or ``pause-for-update``)."""
+        if self.mode == "run":
+            self.drain_reason = reason
+
+    def clear_draining(self) -> None:
+        if self.mode == "run":
+            self.drain_reason = None
+
+    def notice(self) -> str | None:
+        """The intake's pause probe: what a new turn is told while draining (else None)."""
+        if self.drain_reason is None:
+            return None
+        if self.drain_reason == "maintenance":
+            return MAINTENANCE_NOTICE
+        return RESTARTING_NOTICE
+
+    # -- signals -----------------------------------------------------------------------------------
+
+    def install_signals(
+        self, loop: asyncio.AbstractEventLoop, *, on_dump: Callable[[], None]
+    ) -> None:
+        handlers: dict[int, Callable[[], None]] = {
+            signal.SIGTERM: lambda: self.request_stop("signal:SIGTERM"),
+            signal.SIGINT: lambda: self.request_stop("signal:SIGINT"),
+            signal.SIGUSR1: lambda: self.request_restart("signal:SIGUSR1"),
+            signal.SIGUSR2: on_dump,
+        }
+        for signum, handler in handlers.items():
+            try:
+                loop.add_signal_handler(signum, handler)
+            except (NotImplementedError, RuntimeError, ValueError):
+                continue
+            self._installed.append(signum)
+
+    def remove_signals(self, loop: asyncio.AbstractEventLoop) -> None:
+        for signum in self._installed:
+            with contextlib.suppress(Exception):
+                loop.remove_signal_handler(signum)
+        self._installed.clear()
+
+
+# -- chat turns ------------------------------------------------------------------------------------
+
+
+async def wait_for_turns(daemon: GatewayDaemon, timeout: float, *, poll: float = 0.05) -> bool:
+    """Wait until no chat turn holds a claim (up to ``timeout`` s on the daemon's clock, cut
+    short by a second stop); True when none is left."""
+    clock = daemon.clock
+    end = clock.monotonic() + max(0.0, timeout)
+    while daemon.pipeline.claims.keys():
+        if clock.monotonic() >= end or daemon.lifecycle.hurried():
+            return False
+        await clock.sleep(poll)
+    return True
+
+
+async def _flag(daemon: GatewayDaemon, key: str) -> None:
+    try:
+        await run_blocking(
+            routes.mark_resume_pending,
+            daemon.store,
+            key,
+            INTERRUPTED_REASON,
+            label="resume flag",
+        )
+    except Exception:
+        log.warning("could not flag %s as restart-interrupted", key, exc_info=True)
+
+
+async def _unflag(daemon: GatewayDaemon, key: str) -> None:
+    try:
+        entry = await run_blocking(routes.get, daemon.store, key, label="gateway route")
+        if entry is not None and entry.resume_reason == INTERRUPTED_REASON:
+            await run_blocking(routes.clear_resume_pending, daemon.store, key, label="resume flag")
+    except Exception:
+        log.warning("could not clear the restart flag of %s", key, exc_info=True)
+
+
+async def _origin(daemon: GatewayDaemon, key: str) -> Source | None:
+    try:
+        entry = await run_blocking(routes.get, daemon.store, key, label="gateway route")
+    except Exception:
+        return None
+    if entry is None:
+        return None
+    try:
+        return Source.model_validate(entry.origin)
+    except Exception:
+        return None
+
+
+async def drain_turns(daemon: GatewayDaemon, *, drain_timeout: float, grace: float) -> list[str]:
+    """Flag, wait, interrupt and notify (see the module notes); the keys interrupted."""
+    pipeline = daemon.pipeline
+    running = {key: pipeline.claims.current(key) for key in pipeline.claims.keys()}  # noqa: SIM118
+    if not running:
+        return []
+    for key in running:
+        await _flag(daemon, key)
+    await wait_for_turns(daemon, drain_timeout)
+    interrupted: list[str] = []
+    for key, claim in running.items():
+        current = pipeline.claims.current(key)
+        if current is None or current is not claim:
+            await _unflag(daemon, key)  # finished during the drain: nothing to resume
+            continue
+        interrupted.append(key)
+        session_id = claim.session_id if claim is not None else None
+        if session_id:
+            with contextlib.suppress(ProtocolError, Exception):
+                daemon.service.interrupt(session_id, hard=True)
+    for key in interrupted:
+        source = await _origin(daemon, key)
+        if source is not None:
+            await pipeline.reply(source, STOPPED_TURN_NOTICE, kind="notice")
+    await wait_for_turns(daemon, grace)
+    for key in interrupted:
+        claim = running[key]
+        if claim is None:
+            continue
+        with contextlib.suppress(Exception):
+            await run_blocking(
+                routes.end_turn,
+                daemon.store,
+                key,
+                f"turn-{claim.generation}",
+                label="active-turn marker",
+            )
+    log.info("interrupted %d chat turn(s) for the stop", len(interrupted))
+    return interrupted
diff --git a/src/indus/gateway/daemon/liveness.py b/src/indus/gateway/daemon/liveness.py
new file mode 100644
index 0000000..1e48664
--- /dev/null
+++ b/src/indus/gateway/daemon/liveness.py
@@ -0,0 +1,178 @@
+"""One gateway per profile home: the instance lock, the pid record and takeover (P15-24).
+
+``InstanceLock`` is an exclusive ``flock`` on ``<home>/gateway.lock`` held for the whole life of
+the daemon. The kernel drops it when the process dies, so a crash never leaves a lock that needs
+cleaning, and two starts racing each other cannot both win. The lock file is never deleted (a
+process could otherwise lock a new file while another still holds the old one); only the pid
+record is removed at a clean exit. The descriptor is not inherited by child processes.
+
+``claim_instance`` decides what a start does:
+- the lock is free → it is ours; the pid record is (re)written;
+- the lock is held → another gateway serves this home: without ``replace`` the caller reports it
+  (exit 0 at a shell, 75 under a supervisor); with ``replace`` the holder named by the pid record
+  gets SIGTERM, then, after ``wait`` seconds and only while its start time still matches (never a
+  recycled pid), SIGKILL; the lock is retried while it goes away.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import fcntl
+import logging
+import os
+import signal
+import time
+from collections.abc import Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation.clock import SystemClock
+from indus.state.gateway_runtime import (
+    PidRecord,
+    ProcessIdentity,
+    lock_path,
+    pid_path,
+    process_start_time,
+    read_pid_record,
+    write_pid_record,
+)
+
+_SYSTEM = SystemClock()
+
+__all__ = ["InstanceClaim", "InstanceLock", "claim_instance", "release_instance"]
+
+log = logging.getLogger(__name__)
+
+
+class InstanceLock:
+    """The profile's single-instance ``flock`` (see the module notes)."""
+
+    def __init__(self, home: Path) -> None:
+        self.path = lock_path(home)
+        self._fd: int | None = None
+
+    @property
+    def held(self) -> bool:
+        return self._fd is not None
+
+    def try_acquire(self) -> bool:
+        """Take the lock without waiting; True when it is ours."""
+        if self._fd is not None:
+            return True
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)  # not inheritable (PEP 446)
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            os.close(fd)
+            return False
+        self._fd = fd
+        return True
+
+    def release(self) -> None:
+        fd, self._fd = self._fd, None
+        if fd is None:
+            return
+        with contextlib.suppress(OSError):
+            fcntl.flock(fd, fcntl.LOCK_UN)
+        with contextlib.suppress(OSError):
+            os.close(fd)
+
+
+@dataclass
+class InstanceClaim:
+    outcome: Literal["acquired", "running"]
+    lock: InstanceLock | None = None
+    holder: PidRecord | None = None
+    replaced: bool = False
+
+
+def _poll_lock(
+    lock: InstanceLock, wait: float, *, sleep: Callable[[float], None], step: float = 0.1
+) -> bool:
+    end = time.monotonic() + max(0.0, wait)
+    while True:
+        if lock.try_acquire():
+            return True
+        if time.monotonic() >= end:
+            return False
+        sleep(step)
+
+
+def _signal(
+    holder: PidRecord,
+    signum: int,
+    *,
+    kill: Callable[[int, int], None],
+    start_time: Callable[[int], int | None],
+) -> bool:
+    """Signal the holder only while its start time still matches (never a recycled pid)."""
+    recorded = holder.process.start_time
+    current = start_time(holder.pid)
+    if recorded is not None and current is not None and recorded != current:
+        log.warning("not signalling pid %d: it is no longer the recorded gateway", holder.pid)
+        return False
+    if current is None and recorded is not None:
+        return False  # gone (or unreadable): nothing safe to signal
+    try:
+        kill(holder.pid, signum)
+    except ProcessLookupError:
+        return False
+    except OSError as exc:
+        log.warning("could not signal gateway pid %d: %s", holder.pid, exc)
+        return False
+    return True
+
+
+def claim_instance(
+    home: Path,
+    record: PidRecord,
+    *,
+    replace: bool = False,
+    wait: float = 10.0,
+    kill_wait: float = 5.0,
+    settle: float = 1.0,
+    sleep: Callable[[float], None] = _SYSTEM.sleep_sync,
+    kill: Callable[[int, int], None] = os.kill,
+    start_time: Callable[[int], int | None] = process_start_time,
+    probes: dict[str, Any] | None = None,
+) -> InstanceClaim:
+    """Take the profile for ``record``'s process (see the module notes).
+
+    ``settle``: how long a held lock is retried before a holder without a readable pid record (one
+    still starting) is believed."""
+    lock = InstanceLock(home)
+    if lock.try_acquire():
+        write_pid_record(home, record)
+        return InstanceClaim("acquired", lock)
+    holder = read_pid_record(home)
+    if holder is None or holder.pid == record.pid:
+        # Locked but no record yet: another start is between its lock and its write.
+        if _poll_lock(lock, settle, sleep=sleep):
+            write_pid_record(home, record)
+            return InstanceClaim("acquired", lock)
+        holder = read_pid_record(home)
+    if not replace:
+        return InstanceClaim("running", holder=holder)
+    if holder is not None and holder.process.is_alive(**(probes or {})):
+        log.info("replacing the running gateway (pid %d)", holder.pid)
+        if _signal(holder, signal.SIGTERM, kill=kill, start_time=start_time) and not _poll_lock(
+            lock, wait, sleep=sleep
+        ):
+            log.warning("gateway pid %d did not stop within %.0f s; killing it", holder.pid, wait)
+            _signal(holder, signal.SIGKILL, kill=kill, start_time=start_time)
+    if _poll_lock(lock, kill_wait if holder is not None else wait, sleep=sleep):
+        write_pid_record(home, record)
+        return InstanceClaim("acquired", lock, replaced=holder is not None)
+    return InstanceClaim("running", holder=read_pid_record(home))
+
+
+def release_instance(home: Path, claim: InstanceClaim, me: ProcessIdentity) -> None:
+    """Remove our pid record (never someone else's), then drop the lock."""
+    current = read_pid_record(home)
+    if current is not None and current.pid == me.pid:
+        with contextlib.suppress(OSError):
+            pid_path(home).unlink(missing_ok=True)
+    if claim.lock is not None:
+        claim.lock.release()
