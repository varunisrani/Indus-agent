+# STAND-IN: removed at integration
+"""``indus gateway run`` until P15-28 registers the ``gateway`` group: the same bootstrap and the
+same command body (``indus.gateway.daemon.command.main``). Run as
+``python -m tests.integration.gateway._stubs_w3 [--replace]``."""
+
+from __future__ import annotations
+
+import sys
+
+from indus.foundation import bootstrap
+
+
+def main(argv: list[str]) -> int:
+    scope, rest = bootstrap.run(argv, mode="gateway")
+    from indus.gateway.daemon.command import main as run_gateway
+
+    return run_gateway(scope, replace="--replace" in rest)
