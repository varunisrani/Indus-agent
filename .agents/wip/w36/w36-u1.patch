diff --git a/.github/workflows/canary.yml b/.github/workflows/canary.yml
new file mode 100644
index 0000000..9c7ccdc
--- /dev/null
+++ b/.github/workflows/canary.yml
@@ -0,0 +1,49 @@
+name: Canary
+
+# P23-23. Once a day (and on demand) cut a canary of the default branch's tip through the same
+# attempt-ref path as a stable release: release.py --canary --autopublish claims
+# rc.1-v<next patch>-canary.<UTC stamp>, drafts it and dispatches release.yml, whose publish job
+# moves only the `canary` aliases and the canary channel record. A tip that already carries a
+# release tag is not cut again (--if-new), so a day without new commits does nothing. Runs queue;
+# none is cancelled while another is in flight.
+
+on:
+  schedule:
+    - cron: "41 6 * * *" # daily, 06:41 UTC
+  workflow_dispatch:
+
+permissions:
+  contents: write # push the attempt ref, create the draft
+  actions: write # dispatch release.yml
+
+concurrency:
+  group: canary
+  cancel-in-progress: false
+
+jobs:
+  cut:
+    name: Cut a canary of the default branch
+    # A dispatch from any other branch would claim code that never landed.
+    if: github.ref_name == github.event.repository.default_branch
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Check out the default branch with its tags
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          fetch-tags: true
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Claim, draft and start the release run
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GIT_AUTHOR_NAME: indus-release
+          GIT_COMMITTER_NAME: indus-release
+          GIT_AUTHOR_EMAIL: ${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com
+          GIT_COMMITTER_EMAIL: ${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com
+          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+        run: >-
+          uv run --locked --no-dev python scripts/release/release.py --canary --autopublish
+          --if-new --commit "$(git rev-parse "origin/$DEFAULT_BRANCH")"
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..b624440
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,378 @@
+name: Release
+run-name: Release ${{ inputs.attempt_ref }}
+
+# P23-23. Started only by scripts/release/release.py, on the default branch, with the attempt ref
+# it pushed (rc.<N>-v<version>). The workflow and the release scripts come from the default branch;
+# the code under test is the commit the attempt ref claims. `github.sha` is the default branch's
+# tip, never that commit (R10.24): every job that builds or tests checks out
+# `needs.admit.outputs.commit` explicitly. Nothing is rebuilt for publication (R10.23): the gate
+# judges the jobs that built the artefacts and images, and `publish` only re-points aliases at the
+# digests those jobs pushed.
+
+on:
+  workflow_dispatch:
+    inputs:
+      attempt_ref:
+        description: The attempt ref to admit (rc.<N>-v<version>)
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+env:
+  REF_REPOSITORY_URL: https://github.com/NousResearch/hermes-agent.git
+  REF_COMMIT: ab3fe9dffb0a89d534cb795e2a2940e5f6542056
+
+jobs:
+  admit:
+    name: Admit the attempt ref
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    outputs:
+      attempt-ref: ${{ steps.admit.outputs.attempt-ref }}
+      commit: ${{ steps.admit.outputs.commit }}
+      version: ${{ steps.admit.outputs.version }}
+      tag: ${{ steps.admit.outputs.tag }}
+      kind: ${{ steps.admit.outputs.kind }}
+      epoch: ${{ steps.admit.outputs.epoch }}
+      lanes: ${{ steps.admit.outputs.lanes }}
+      jobs: ${{ steps.admit.outputs.jobs }}
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Admit
+        id: admit
+        env:
+          ATTEMPT_REF: ${{ inputs.attempt_ref }}
+          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+        run: >-
+          uv run --locked --no-dev python scripts/release/publish.py admit
+          --ref "$ATTEMPT_REF" --default-branch "$DEFAULT_BRANCH"
+
+  ci:
+    name: Full suite and guards
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['ci']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Fetch the pinned reference (outside the workspace)
+        working-directory: ${{ runner.temp }}
+        run: |
+          git init --quiet ref
+          git -C ref fetch --quiet --depth 1 "$REF_REPOSITORY_URL" "$REF_COMMIT"
+          git -C ref checkout --quiet --detach FETCH_HEAD
+          echo "INDUS_REF=${RUNNER_TEMP}/ref" >> "$GITHUB_ENV"
+      - name: Install
+        run: uv sync --locked
+      - name: Lint, format, layers, types
+        run: |
+          uv run ruff check .
+          uv run ruff format --check .
+          uv run lint-imports
+          uv run pyright
+      - name: Tests
+        run: uv run pytest -q -m "not perf"
+      - name: Perf bounds (serial, alone)
+        run: uv run pytest -q -m perf
+      - name: Repo guards
+        run: uv run python -m tooling.checks --require-ref
+
+  docker:
+    name: Images (built, tested, pushed by digest)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['docker']
+    permissions:
+      contents: read
+      packages: write
+    uses: ./.github/workflows/docker.yml
+    with:
+      commit: ${{ needs.admit.outputs.commit }}
+      release-ref: ${{ needs.admit.outputs.attempt-ref }}
+
+  nix:
+    name: Nix flake check
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['nix']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Install Nix
+        uses: cachix/install-nix-action@630ae543ea3a38a9a4166f03376c02c50f408342 # v31.11.0
+      - name: Check
+        run: nix flake check -L
+
+  install-e2e:
+    name: Fresh install (${{ matrix.os }})
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['install-e2e']
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, macos-latest, windows-latest]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 45
+    env:
+      COMMIT: ${{ needs.admit.outputs.commit }}
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: install.sh
+        if: runner.os != 'Windows'
+        run: |
+          bash scripts/install.sh --channel main --commit "$COMMIT" \
+            --dir "$RUNNER_TEMP/indus-agent" --indus-home "$RUNNER_TEMP/indus-home" \
+            --non-interactive --skip-browser --skip-computer-use
+          "$RUNNER_TEMP/indus-agent/.venv/bin/indus" --version
+      - name: install.ps1
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          ./scripts/install.ps1 -Channel main -Commit $env:COMMIT `
+            -InstallDir "$env:RUNNER_TEMP\indus-agent" -IndusHome "$env:RUNNER_TEMP\indus-home" `
+            -NonInteractive -SkipBrowser -SkipComputerUse
+
+  desktop-mac:
+    name: Desktop (macOS, signed)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-mac']
+    runs-on: macos-latest
+    timeout-minutes: 90
+    environment: release
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build and sign
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+          APPLE_ID: ${{ secrets.APPLE_ID }}
+          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
+          APPLE_APP_SPECIFIC_PASSWORD: ${{ secrets.APPLE_APP_SPECIFIC_PASSWORD }}
+          CSC_LINK: ${{ secrets.MAC_CERTIFICATE }}
+          CSC_KEY_PASSWORD: ${{ secrets.MAC_CERTIFICATE_PASSWORD }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:mac
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-mac
+          path: apps/desktop/release/*.*
+          if-no-files-found: error
+
+  desktop-win:
+    name: Desktop (Windows, signed)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-win']
+    runs-on: windows-latest
+    timeout-minutes: 90
+    environment: release
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build and sign
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+          WIN_CSC_LINK: ${{ secrets.WIN_CERTIFICATE }}
+          WIN_CSC_KEY_PASSWORD: ${{ secrets.WIN_CERTIFICATE_PASSWORD }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:win
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-win
+          path: apps/desktop/release/*.*
+          if-no-files-found: error
+
+  desktop-linux:
+    name: Desktop (Linux)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-linux']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:linux
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-linux
+          path: apps/desktop/release/*.*
+          if-no-files-found: error
+
+  upgrade:
+    name: Previous release → this commit
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['upgrade']
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    env:
+      COMMIT: ${{ needs.admit.outputs.commit }}
+      VERSION: ${{ needs.admit.outputs.version }}
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Install the previous release, then update it to this commit
+        run: |
+          previous="$(git tag --list 'v*' --sort=-version:refname --merged "$COMMIT" \
+            | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1 || true)"
+          if [ -z "$previous" ]; then
+            echo "No earlier release: nothing to upgrade from."
+            exit 0
+          fi
+          home="$RUNNER_TEMP/indus-home"
+          checkout="$RUNNER_TEMP/indus-agent"
+          bash scripts/install.sh --channel stable --commit "$(git rev-parse "$previous^{commit}")" \
+            --dir "$checkout" --indus-home "$home" --non-interactive --skip-browser --skip-computer-use
+          git -C "$checkout" fetch --quiet origin "$COMMIT"
+          # The release is not published yet: a local tag makes it the newest stable it sees.
+          git -C "$checkout" tag "v$VERSION" "$COMMIT"
+          INDUS_HOME="$home" "$checkout/.venv/bin/indus" update -y --channel stable --no-gateway-restart
+          test "$(git -C "$checkout" rev-parse HEAD)" = "$COMMIT"
+          INDUS_HOME="$home" "$checkout/.venv/bin/indus" --version
+
+  upload:
+    name: Artefacts onto the draft (once)
+    needs: [admit, desktop-mac, desktop-win, desktop-linux]
+    if: ${{ !cancelled() && needs.admit.result == 'success' && !contains(needs.*.result, 'failure') }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: write
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Collect the tested artefacts
+        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          pattern: desktop-*
+          path: ${{ runner.temp }}/artefacts
+          merge-multiple: true
+      - name: Upload with the manifest
+        env:
+          GH_TOKEN: ${{ github.token }}
+          ATTEMPT_REF: ${{ needs.admit.outputs.attempt-ref }}
+        run: |
+          mkdir -p "$RUNNER_TEMP/artefacts"
+          uv run --locked --no-dev python scripts/release/publish.py upload \
+            --ref "$ATTEMPT_REF" --dir "$RUNNER_TEMP/artefacts"
+
+  gate:
+    name: Every selected job passed
+    if: always()
+    needs: [admit, ci, docker, nix, install-e2e, desktop-mac, desktop-win, desktop-linux, upgrade, upload]
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Strict gate
+        env:
+          NEEDS: ${{ toJSON(needs) }}
+          LANES: ${{ needs.admit.outputs.lanes }}
+        run: python3 scripts/release/claims.py gate
+
+  publish:
+    name: Publish (receipt, aliases, channel record, public last)
+    needs: [admit, gate]
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: release
+    permissions:
+      contents: write
+      packages: write
+      actions: read
+    concurrency:
+      group: release-publication
+      cancel-in-progress: false
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Log in to GHCR
+        env:
+          GH_TOKEN: ${{ github.token }}
+          ACTOR: ${{ github.actor }}
+        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$ACTOR" --password-stdin
+      - name: Resolve claims oldest first and publish what may go out
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GIT_COMMITTER_NAME: indus-release
+          GIT_COMMITTER_EMAIL: ${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com
+        run: uv run --locked --no-dev python scripts/release/publish.py publish
diff --git a/contributors/README.md b/contributors/README.md
new file mode 100644
index 0000000..a9e0d20
--- /dev/null
+++ b/contributors/README.md
@@ -0,0 +1,18 @@
+# Contributors
+
+Release notes credit the people whose commits a release contains. This folder maps a commit
+author to the name the notes print.
+
+- One file per author email: `<key>.txt`, where `<key>` is the first 16 hex digits of the SHA-256
+  of the lower-cased email address. The file's first non-empty line is the name to credit (a
+  GitHub handle such as `@someone`, or a full name). No email address is ever written into this
+  repository: not in a file name, not in a file.
+- A stable release refuses to cut while any commit since the previous release has an author with
+  no file here; the refusal names each missing `<key>.txt` (a canary only warns).
+- Compute a key (with the address in `AUTHOR_EMAIL`) with:
+
+  ```sh
+  printf '%s' "$AUTHOR_EMAIL" | tr 'A-Z' 'a-z' | sha256sum | cut -c1-16
+  ```
+
+The map starts empty on purpose: it is personal data, and nothing is copied in from elsewhere.
