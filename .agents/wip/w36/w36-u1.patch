+    assert (checkout / "apps/web/dist/index.html").read_text(encoding="utf-8") == "<html>old</html>"
+    assert not (checkout / "apps/web/dist.next").exists()
+    receipt = final_receipt(scope.root)
+    assert receipt["outcome"] == "ok_with_followups"
