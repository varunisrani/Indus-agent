diff --git a/tests/fakes/release/fake_github.py b/tests/fakes/release/fake_github.py
new file mode 100644
index 0000000..f8fcd24
--- /dev/null
+++ b/tests/fakes/release/fake_github.py
@@ -0,0 +1,178 @@
+"""An in-memory GitHub for the release tooling tests (P23-22, P23-23).
+
+Implements ``scripts.release.github.GitHubClient``: releases (drafts included) with assets,
+workflow dispatches and runs. ``fail_once(op)`` makes the next call of that operation raise, so a
+test can break the controller at any step and run it again. Every mutating call is appended to
+``calls`` so tests can check order and count.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass, field
+from typing import Any
+
+
+class InjectedFailure(RuntimeError):
+    pass
+
+
+@dataclass
+class FakeGitHub:
+    repository: str = "owner/indus-agent"
+    default: str = "main"
+    releases: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+    assets: dict[int, dict[str, bytes]] = field(default_factory=dict[int, dict[str, bytes]])
+    runs: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+    dispatches: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+    calls: list[str] = field(default_factory=list[str])
+    asset_writes: int = 0
+    _next_id: int = 100
+    _failures: dict[str, int] = field(default_factory=dict[str, int])
+    published_clock: int = 0
+
+    # -- failure injection -------------------------------------------------------------------------
+
+    def fail_once(self, op: str) -> None:
+        self._failures[op] = self._failures.get(op, 0) + 1
+
+    def _gate(self, op: str) -> None:
+        if self._failures.get(op):
+            self._failures[op] -= 1
+            raise InjectedFailure(f"injected failure in {op}")
+
+    # -- reads -------------------------------------------------------------------------------------
+
+    def default_branch(self) -> str:
+        return self.default
+
+    def list_releases(self) -> list[dict[str, Any]]:
+        self._gate("list_releases")
+        return [copy.deepcopy(r) for r in self.releases]
+
+    def release_by_tag(self, tag: str) -> dict[str, Any] | None:
+        for row in self.releases:
+            if row["tag_name"] == tag:
+                return copy.deepcopy(row)
+        return None
+
+    def release(self, release_id: int) -> dict[str, Any] | None:
+        for row in self.releases:
+            if row["id"] == release_id:
+                return copy.deepcopy(row)
+        return None
+
+    def workflow_runs(self, workflow: str) -> list[dict[str, Any]]:
+        return [copy.deepcopy(r) for r in self.runs if r.get("workflow") == workflow]
+
+    # -- release writes ----------------------------------------------------------------------------
+
+    def _row(self, release_id: int) -> dict[str, Any]:
+        for row in self.releases:
+            if row["id"] == release_id:
+                return row
+        raise KeyError(release_id)
+
+    def create_release(
+        self,
+        *,
+        tag: str,
+        name: str,
+        body: str,
+        draft: bool,
+        prerelease: bool,
+        target: str,
+    ) -> dict[str, Any]:
+        self._gate("create_release")
+        self.calls.append(f"create_release:{tag}")
+        row = {
+            "id": self._next_id,
+            "tag_name": tag,
+            "name": name,
+            "body": body,
+            "draft": draft,
+            "prerelease": prerelease,
+            "target_commitish": target,
+            "published_at": None,
+        }
+        self._next_id += 1
+        self.releases.append(row)
+        self.assets[row["id"]] = {}
+        return copy.deepcopy(row)
+
+    def update_release(self, release_id: int, **fields: Any) -> dict[str, Any]:
+        op = "publish_release" if fields.get("draft") is False else "update_release"
+        self._gate(op)
+        row = self._row(release_id)
+        if row["draft"] is False and row.get("published_at"):
+            raise RuntimeError("published releases are immutable")
+        self.calls.append(f"{op}:{release_id}")
+        row.update(fields)
+        if fields.get("draft") is False:
+            self.published_clock += 1
+            row["published_at"] = f"2026-10-21T07:00:{self.published_clock:02d}Z"
+        return copy.deepcopy(row)
+
+    def delete_release(self, release_id: int) -> None:
+        self._gate("delete_release")
+        self.calls.append(f"delete_release:{release_id}")
+        self.releases = [r for r in self.releases if r["id"] != release_id]
+        self.assets.pop(release_id, None)
+
+    # -- assets ------------------------------------------------------------------------------------
+
+    def _release_for(self, tag: str, *, create: bool) -> dict[str, Any] | None:
+        for row in self.releases:
+            if row["tag_name"] == tag:
+                return row
+        if not create:
+            return None
+        made = self.create_release(
+            tag=tag, name=tag, body="", draft=False, prerelease=True, target=self.default
+        )
+        return self._row(made["id"])
+
+    def read_asset(self, release_tag: str, name: str) -> bytes | None:
+        row = self._release_for(release_tag, create=False)
+        if row is None:
+            return None
+        return self.assets.get(row["id"], {}).get(name)
+
+    def replace_asset(self, release_tag: str, name: str, data: bytes) -> None:
+        self._gate("replace_asset")
+        row = self._release_for(release_tag, create=True)
+        assert row is not None
+        self.calls.append(f"replace_asset:{release_tag}/{name}")
+        self.asset_writes += 1
+        self.assets.setdefault(row["id"], {})[name] = data
+
+    def upload_asset(self, release_id: int, name: str, data: bytes) -> None:
+        self._gate("upload_asset")
+        self.calls.append(f"upload_asset:{release_id}/{name}")
+        current = self.assets.setdefault(release_id, {})
+        if name in current:
+            raise RuntimeError(f"asset {name} already exists")
+        current[name] = data
+
+    def asset_names(self, release_id: int) -> list[str]:
+        return sorted(self.assets.get(release_id, {}))
+
+    def read_release_asset(self, release_id: int, name: str) -> bytes | None:
+        return self.assets.get(release_id, {}).get(name)
+
+    # -- workflows ---------------------------------------------------------------------------------
+
+    def dispatch_workflow(self, workflow: str, ref: str, inputs: dict[str, str]) -> None:
+        self._gate("dispatch_workflow")
+        self.calls.append(f"dispatch:{workflow}@{ref}")
+        self.dispatches.append({"workflow": workflow, "ref": ref, "inputs": dict(inputs)})
+
+    def add_run(self, workflow: str, attempt_ref: str, status: str, conclusion: str | None) -> None:
+        self.runs.append(
+            {
+                "workflow": workflow,
+                "name": f"Release {attempt_ref}",
+                "status": status,
+                "conclusion": conclusion,
+            }
+        )
diff --git a/tests/fakes/release/fake_registry.py b/tests/fakes/release/fake_registry.py
new file mode 100644
index 0000000..7f3e1d9
--- /dev/null
+++ b/tests/fakes/release/fake_registry.py
@@ -0,0 +1,39 @@
+"""An in-memory GHCR for the publication controller tests (P23-23).
+
+``manifests[repository][tag] = digest``. ``tag()`` points a new tag at an existing digest (like
+``docker buildx imagetools create``); ``fail_once("tag")`` breaks the next call. ``events`` may be
+shared with the fake GitHub's ``calls`` so a test can check the order across both services.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+
+
+class RegistryFailure(RuntimeError):
+    pass
+
+
+@dataclass
+class FakeRegistry:
+    manifests: dict[str, dict[str, str]] = field(default_factory=dict[str, dict[str, str]])
+    events: list[str] = field(default_factory=list[str])
+    _failures: dict[str, int] = field(default_factory=dict[str, int])
+
+    def fail_once(self, op: str) -> None:
+        self._failures[op] = self._failures.get(op, 0) + 1
+
+    def push(self, repository: str, tag: str, digest: str) -> None:
+        self.manifests.setdefault(repository, {})[tag] = digest
+
+    def digest(self, repository: str, tag: str) -> str | None:
+        return self.manifests.get(repository, {}).get(tag)
+
+    def tag(self, repository: str, digest: str, tag: str) -> None:
+        if self._failures.get("tag"):
+            self._failures["tag"] -= 1
+            raise RegistryFailure(f"injected failure tagging {repository}:{tag}")
+        if digest not in self.manifests.get(repository, {}).values():
+            raise RegistryFailure(f"{repository}@{digest} was never pushed")
+        self.events.append(f"alias:{repository}:{tag}")
+        self.manifests[repository][tag] = digest
diff --git a/tests/fakes/updater.py b/tests/fakes/updater.py
new file mode 100644
index 0000000..589594f
--- /dev/null
+++ b/tests/fakes/updater.py
@@ -0,0 +1,131 @@
+"""Fakes for ``indus update`` tests (P23-17..19): uv, exec, the gateway, and a whole wiring.
+
+``FakeUv`` stands in for every child the apply step runs: ``uv venv`` makes the directory,
+``uv sync`` copies the checkout's ``uv.lock`` into the new venv (or fails on a lock carrying
+``BROKEN_LOCK_MARK``, or raises ``KeyboardInterrupt`` when asked), and the venv's ``python -m indus
+--version`` answers. ``ExecSpy`` records the hand-off instead of replacing the process.
+"""
+
+from __future__ import annotations
+
+import subprocess
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from indus.cli.commands import update as update_mod
+from indus.cli.update.apply import ApplyHooks
+from indus.cli.update.finish import DistBuilder, RestartResult
+from indus.foundation.scope import EnvView, Scope, make_scope
+from indus.foundation.secrets import open_secret_store
+from tests.fakes.clock import FakeClock
+from tests.fixtures.update.make_repo import BROKEN_LOCK_MARK, env
+
+
+def done(code: int = 0, out: str = "", err: str = "") -> subprocess.CompletedProcess[str]:
+    return subprocess.CompletedProcess([], code, out, err)
+
+
+@dataclass
+class FakeUv:
+    interrupt_on: str | None = None
+    calls: list[list[str]] = field(default_factory=list[list[str]])
+
+    def __call__(self, argv: Sequence[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
+        args = list(argv)
+        self.calls.append(args)
+        run_env: Mapping[str, str] = kwargs.get("env") or {}
+        cwd = Path(str(kwargs.get("cwd", ".")))
+        verb = args[1] if len(args) > 1 else ""
+        if self.interrupt_on is not None and verb == self.interrupt_on:
+            raise KeyboardInterrupt
+        if verb == "venv":
+            venv = Path(args[-1])
+            (venv / "bin").mkdir(parents=True, exist_ok=True)
+            (venv / "bin" / "python").write_text("new interpreter\n", encoding="utf-8")
+            return done()
+        if verb == "sync":
+            lock = (cwd / "uv.lock").read_text(encoding="utf-8")
+            if BROKEN_LOCK_MARK in lock:
+                return done(1, err="No solution found when resolving dependencies")
+            venv = Path(run_env["UV_PROJECT_ENVIRONMENT"])
+            (venv / "lock-of").write_text(lock, encoding="utf-8")
+            return done()
+        if args[1:] == ["-m", "indus", "--version"]:
+            return done(0, "Indus Agent 0.0.0\n")
+        return done(127, err=f"unexpected child {args}")
+
+
+@dataclass
+class ExecSpy:
+    calls: list[tuple[str, list[str], dict[str, str]]] = field(
+        default_factory=list[tuple[str, list[str], dict[str, str]]]
+    )
+
+    def __call__(self, path: str, argv: Sequence[str], env_map: Mapping[str, str]) -> None:
+        self.calls.append((path, list(argv), dict(env_map)))
+
+
+@dataclass
+class FakeGateway:
+    result: RestartResult = field(default_factory=lambda: RestartResult("skipped", "not running"))
+    restarts: int = 0
+
+    def describe(self) -> dict[str, Any]:
+        return {"kind": "gateway", "running": False, "managed_by": "none", "restart": "not running"}
+
+    def restart(self) -> RestartResult:
+        self.restarts += 1
+        return self.result
+
+
+@dataclass
+class Snapshots:
+    fail: bool = False
+    modes: list[str] = field(default_factory=list[str])
+
+    def __call__(self, mode: str) -> str:
+        self.modes.append(mode)
+        if self.fail:
+            raise RuntimeError("disk full")
+        return f"{mode} snapshot"
+
+
+def scope_for(root: Path, git_home: Path, clock: FakeClock) -> Scope:
+    """The default profile at ``root`` with a git-capable env that reads no user config."""
+    root.mkdir(parents=True, exist_ok=True)
+    overlay: dict[str, str | None] = {**env(git_home), "INDUS_HOME": str(root)}
+    view = EnvView.from_process().with_overlay(overlay)
+    scope = make_scope(root, env=view, clock=clock)
+    return scope.with_secrets(open_secret_store(root, scope.profile_id, mode="file"))
+
+
+@dataclass
+class World:
+    checkout: Path
+    uv: FakeUv = field(default_factory=FakeUv)
+    execs: ExecSpy = field(default_factory=ExecSpy)
+    gateway: FakeGateway = field(default_factory=FakeGateway)
+    snapshots: Snapshots = field(default_factory=Snapshots)
+    builders: list[DistBuilder] = field(default_factory=list[DistBuilder])
+    now: Callable[[], datetime] | None = None
+    uv_path: str | None = "uv"
+    runs: list[list[str]] = field(default_factory=list[list[str]])
+
+    def wiring(self, scope: Scope, _state: object) -> update_mod.Wiring:
+        def run(argv: Sequence[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
+            self.runs.append(list(argv))
+            return self.uv(argv, **kwargs)
+
+        return update_mod.Wiring(
+            package_dir=self.checkout / "src" / "indus",
+            run=run,
+            hooks=ApplyHooks(snapshot=self.snapshots, uv=self.uv_path, run=run, execv=self.execs),
+            gateway=self.gateway,
+            builders=self.builders,
+            pnpm="pnpm",
+            now=self.now or scope.clock.now,
+            exists=lambda _p: False,
+        )
diff --git a/tests/fixtures/update/make_repo.py b/tests/fixtures/update/make_repo.py
new file mode 100644
index 0000000..cb0e78f
--- /dev/null
+++ b/tests/fixtures/update/make_repo.py
@@ -0,0 +1,129 @@
+"""Temp git repositories with tagged releases for the updater tests (P23-17, P23-18).
+
+``Upstream(tmp)`` makes a bare ``origin`` and a publishing work tree. ``release(version)`` commits
+a minimal source tree (every startup file ``apply.CRITICAL_FILES`` names, a store schema, a lock)
+and pushes an annotated ``v<version>`` tag; flags make a release whose startup file does not
+compile (``broken_syntax``) or whose lock cannot resolve (``broken_lock``, read by the fake uv).
+``clone(dest, at=)`` is the user's checkout. Real ``git`` only; nothing touches the network or the
+user's git config (``env()`` pins an empty global config and a test identity).
+"""
+
+from __future__ import annotations
+
+import os
+import subprocess
+from pathlib import Path
+
+from indus.cli.update.apply import CRITICAL_FILES
+
+BROKEN_LOCK_MARK = "# unresolvable: the fake uv fails on this lock"
+OFFICIAL_URL_TAIL = "indusagi/indus-agent.git"
+OFFICIAL_URL = "https://github.com/" + OFFICIAL_URL_TAIL
+
+
+def env(home: Path) -> dict[str, str]:
+    """A git environment that reads no user or system config."""
+    who = "Indus Test"
+    mail = "test" + "@" + "example.invalid"
+    return {
+        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+        "HOME": str(home),
+        "GIT_CONFIG_NOSYSTEM": "1",
+        "GIT_CONFIG_GLOBAL": os.devnull,
+        "GIT_AUTHOR_NAME": who,
+        "GIT_AUTHOR_EMAIL": mail,
+        "GIT_COMMITTER_NAME": who,
+        "GIT_COMMITTER_EMAIL": mail,
+        "GIT_TERMINAL_PROMPT": "0",
+        "LC_ALL": "C",
+    }
+
+
+def git(cwd: Path, *args: str, home: Path) -> str:
+    done = subprocess.run(
+        ["git", *args],
+        cwd=str(cwd),
+        env=env(home),
+        capture_output=True,
+        text=True,
+        check=False,
+        timeout=60,
+    )
+    if done.returncode != 0:
+        raise RuntimeError(f"git {' '.join(args)} failed: {done.stderr.strip()}")
+    return done.stdout.strip()
+
+
+class Upstream:
+    def __init__(self, tmp: Path) -> None:
+        self.home = tmp / "git-home"
+        self.home.mkdir(parents=True, exist_ok=True)
+        self.origin = tmp / "remotes" / OFFICIAL_URL_TAIL
+        self.origin.mkdir(parents=True)
+        git(self.origin, "init", "--quiet", "--bare", "--initial-branch=main", home=self.home)
+        self.work = tmp / "publisher"
+        git(tmp, "clone", "--quiet", str(self.origin), str(self.work), home=self.home)
+        git(self.work, "checkout", "--quiet", "-B", "main", home=self.home)
+
+    def write_tree(
+        self,
+        version: str,
+        *,
+        broken_syntax: bool = False,
+        broken_lock: bool = False,
+        schema: int = 1,
+        extra: dict[str, str] | None = None,
+    ) -> None:
+        for name in CRITICAL_FILES:
+            path = self.work / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(
+                f'"""{name} at {version}."""\nVERSION = "{version}"\n', encoding="utf-8"
+            )
+        if broken_syntax:
+            (self.work / "src/indus/cli/app.py").write_text(
+                "def broken(:\n<<<<<<< HEAD\n", encoding="utf-8"
+            )
+        schema_file = self.work / "src/indus/state/schema.py"
+        schema_file.parent.mkdir(parents=True, exist_ok=True)
+        schema_file.write_text(f"SCHEMA_VERSION = {schema}\n", encoding="utf-8")
+        lock = f"version = 1\n# release {version}\n"
+        if broken_lock:
+            lock += BROKEN_LOCK_MARK + "\n"
+        (self.work / "uv.lock").write_text(lock, encoding="utf-8")
+        (self.work / "pyproject.toml").write_text(
+            '[project]\nname = "indus-agent"\nversion = "0.0.0"\n', encoding="utf-8"
+        )
+        (self.work / ".gitignore").write_text(".venv*/\n", encoding="utf-8")
+        for name, text in (extra or {}).items():
+            path = self.work / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(text, encoding="utf-8")
+
+    def commit(self, message: str) -> str:
+        git(self.work, "add", "--all", home=self.home)
+        git(self.work, "commit", "--quiet", "--allow-empty", "-m", message, home=self.home)
+        git(self.work, "push", "--quiet", "origin", "main", home=self.home)
+        return git(self.work, "rev-parse", "HEAD", home=self.home)
+
+    def tag(self, name: str, commit: str | None = None) -> None:
+        target = commit or git(self.work, "rev-parse", "HEAD", home=self.home)
+        git(self.work, "tag", "-a", name, target, "-m", name, home=self.home)
+        git(self.work, "push", "--quiet", "origin", f"refs/tags/{name}", home=self.home)
+
+    def release(self, version: str, **flags: object) -> str:
+        self.write_tree(version, **flags)  # type: ignore[arg-type]
+        sha = self.commit(f"release {version}")
+        self.tag(f"v{version}")
+        return sha
+
+    def clone(self, dest: Path, *, at: str | None = None, official: bool = True) -> Path:
+        """The user's checkout. ``official``: ``origin`` names the official repository (git
+        rewrites it to the local bare repo, so nothing reaches the network)."""
+        git(dest.parent, "clone", "--quiet", str(self.origin), str(dest), home=self.home)
+        if official:
+            git(dest, "config", "remote.origin.url", OFFICIAL_URL, home=self.home)
+            git(dest, "config", f"url.{self.origin}.insteadOf", OFFICIAL_URL, home=self.home)
+        if at is not None:
+            git(dest, "checkout", "--quiet", "--detach", at, home=self.home)
+        return dest
