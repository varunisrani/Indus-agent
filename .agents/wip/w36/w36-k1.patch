diff --git a/.dockerignore b/.dockerignore
new file mode 100644
index 0000000..12fee16
--- /dev/null
+++ b/.dockerignore
@@ -0,0 +1,49 @@
+# Build context for docker/Dockerfile and docker/sandbox/Dockerfile (P23-08, P23-09).
+# The images take only what they build from; everything else stays out of the context so it can
+# neither bloat the upload nor leak into a layer.
+
+# Version control, agent mailbox, editor and OS files
+.git
+.github
+.agents
+.idea
+.vscode
+**/.DS_Store
+**/*.swp
+
+# Local environments, caches and secrets
+.venv
+**/.venv
+**/__pycache__
+**/*.py[cod]
+.pytest_cache
+.ruff_cache
+**/.cache
+.uv-cache
+.mypy_cache
+.coverage
+htmlcov
+**/.env
+**/.env.*
+
+# Build output and installed packages (the images build their own)
+**/node_modules
+**/dist
+**/build
+**/*.egg-info
+src/indus/web/static
+apps/web/test-results
+apps/web/playwright-report
+
+# Tests, plans, notes and agent docs are not part of the product
+tests
+tooling
+docs
+nix
+HANDOFF.md
+AGENTS.md
+CLAUDE.md
+
+# Clean room: reference checkouts and analysis material never enter an image
+reference
+rea-lab
diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
new file mode 100644
index 0000000..51c9801
--- /dev/null
+++ b/.github/workflows/docker.yml
@@ -0,0 +1,306 @@
+# Container images (P23-12): the product image and the sandbox image, slim and browser, amd64 and
+# arm64 on native runners.
+#
+# - pull requests: lint, build and test every image; nothing is pushed;
+# - pushes to main: the same, then the tested images go to GHCR as :main / :main-browser (product)
+#   and :main-slim / :main-browser (sandbox);
+# - releases (called by the release workflow, P23-23): phase `test` builds and tests the admitted
+#   commit and keeps each image as an artifact; phase `publish` pushes those very archives (nothing
+#   is rebuilt) under the attempt ref and returns the manifest digests.
+#
+# Channel aliases (latest, stable, canary, and the sandbox's slim / browser) are never written here:
+# only the publication controller moves them, from the digests a release receipt binds (R10.23).
+# Every job checks out `inputs.commit || github.sha` explicitly: in a release run the workflow's own
+# SHA is not the commit under test (R10.24).
+
+name: Docker
+
+on:
+  workflow_call:
+    inputs:
+      commit:
+        description: The admitted commit to build (full 40-hex SHA).
+        required: true
+        type: string
+      attempt_ref:
+        description: The attempt ref under release (rc.<N>-vX.Y.Z); the images are tagged with it.
+        required: true
+        type: string
+      phase:
+        description: "test: build, test and keep the images; publish: push the kept images."
+        required: true
+        type: string
+    outputs:
+      product-digest:
+        description: Digest of the product image index (slim).
+        value: ${{ jobs.digests.outputs.product-slim }}
+      product-browser-digest:
+        description: Digest of the product image index (browser).
+        value: ${{ jobs.digests.outputs.product-browser }}
+      sandbox-digest:
+        description: Digest of the sandbox image index (slim).
+        value: ${{ jobs.digests.outputs.sandbox-slim }}
+      sandbox-browser-digest:
+        description: Digest of the sandbox image index (browser).
+        value: ${{ jobs.digests.outputs.sandbox-browser }}
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: docker-${{ inputs.attempt_ref || github.ref }}-${{ inputs.phase || 'ci' }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+env:
+  COMMIT: ${{ inputs.commit || github.sha }}
+  ATTEMPT_REF: ${{ inputs.attempt_ref }}
+  PHASE: ${{ inputs.phase }}
+
+jobs:
+  lint:
+    name: Lint Dockerfiles, pins and workflows
+    if: ${{ inputs.phase != 'publish' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Check the release inputs
+        if: ${{ inputs.phase }}
+        run: |
+          [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || { echo "commit must be a full SHA: $COMMIT" >&2; exit 1; }
+          [[ "$ATTEMPT_REF" =~ ^rc\.[0-9]+-v[0-9]+\.[0-9]+\.[0-9]+(-canary\.[0-9]{8}T[0-9]{6}Z)?$ ]] \
+            || { echo "not an attempt ref: $ATTEMPT_REF" >&2; exit 1; }
+          [[ "$PHASE" == test || "$PHASE" == publish ]] || { echo "unknown phase: $PHASE" >&2; exit 1; }
+
+      - name: Every pin filled and every Dockerfile on the pinned base
+        run: python3 scripts/docker/pins.py check --strict
+
+      - name: Fetch the pinned linters
+        run: |
+          python3 scripts/docker/pins.py fetch hadolint actionlint --arch amd64 --out "$RUNNER_TEMP/tools"
+          mkdir -p "$RUNNER_TEMP/bin"
+          install -m 0755 "$RUNNER_TEMP/tools/hadolint-Linux-x86_64" "$RUNNER_TEMP/bin/hadolint"
+          tar -xzf "$RUNNER_TEMP"/tools/actionlint_*_linux_amd64.tar.gz -C "$RUNNER_TEMP/bin" actionlint
+          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
+
+      - name: hadolint
+        run: hadolint docker/Dockerfile docker/sandbox/Dockerfile
+
+      - name: actionlint
+        run: actionlint .github/workflows/*.yml
+
+  build:
+    name: Build and test ${{ matrix.image }}/${{ matrix.variant }}/${{ matrix.arch }}
+    if: ${{ inputs.phase != 'publish' }}
+    needs: lint
+    strategy:
+      fail-fast: false
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+        arch: [amd64, arm64]
+        include:
+          - arch: amd64
+            runner: ubuntu-24.04
+          - arch: arm64
+            runner: ubuntu-24.04-arm
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 60
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+      ARCH: ${{ matrix.arch }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Build
+        run: |
+          if [ "$IMAGE" = product ]; then
+            set -- -f docker/Dockerfile --target product --build-arg "VARIANT=$VARIANT"
+          else
+            set -- -f docker/sandbox/Dockerfile --target "$VARIANT"
+          fi
+          docker build --platform "linux/$ARCH" --pull "$@" \
+            --label "org.opencontainers.image.revision=$COMMIT" \
+            -t "indus-$IMAGE:test" .
+          mkdir -p "$RUNNER_TEMP/image"
+          docker save -o "$RUNNER_TEMP/image/image.tar" "indus-$IMAGE:test"
+          docker image inspect --format '{{.Id}}' "indus-$IMAGE:test" > "$RUNNER_TEMP/image/image.id"
+          (cd "$RUNNER_TEMP/image" && sha256sum image.tar > image.tar.sha256)
+
+      - name: Set up the pinned uv
+        run: |
+          python3 scripts/docker/pins.py fetch uv --arch "$ARCH" --out "$RUNNER_TEMP/uv-dl"
+          mkdir -p "$RUNNER_TEMP/uv"
+          tar -xzf "$RUNNER_TEMP"/uv-dl/*.tar.gz -C "$RUNNER_TEMP/uv" --strip-components=1
+          echo "$RUNNER_TEMP/uv" >> "$GITHUB_PATH"
+
+      - name: Image tests
+        run: |
+          uv sync --locked
+          if [ "$IMAGE" = product ]; then
+            export INDUS_TEST_IMAGE="indus-$IMAGE:test" INDUS_TEST_IMAGE_VARIANT="$VARIANT"
+          else
+            export INDUS_TEST_SANDBOX_IMAGE="indus-$IMAGE:test" INDUS_TEST_IMAGE_VARIANT="$VARIANT"
+          fi
+          uv run pytest -q -m docker tests/docker
+
+      - name: Keep the tested image
+        if: ${{ github.event_name == 'push' || inputs.phase == 'test' }}
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: image-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/image/
+          retention-days: 7
+          if-no-files-found: error
+
+  push:
+    name: Push ${{ matrix.image }}/${{ matrix.variant }}/${{ matrix.arch }} by digest
+    needs: build
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    permissions:
+      contents: read
+      packages: write
+    strategy:
+      fail-fast: true
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+        arch: [amd64, arm64]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+      ARCH: ${{ matrix.arch }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Fetch the tested image
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          name: image-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/image
+
+      - name: Push the tested bytes
+        env:
+          REGISTRY_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          cd "$RUNNER_TEMP/image"
+          sha256sum -c image.tar.sha256
+          repo="$(python3 "$GITHUB_WORKSPACE/scripts/docker/pins.py" image "$IMAGE")"
+          if [ -n "$ATTEMPT_REF" ]; then base="$ATTEMPT_REF"; else base=main; fi
+          if [ "$IMAGE" = sandbox ] || [ "$VARIANT" != slim ]; then base="$base-$VARIANT"; fi
+          tag="$base-$ARCH"
+          printf '%s' "$REGISTRY_TOKEN" | skopeo login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
+          skopeo copy --digestfile digest.txt "docker-archive:image.tar" "docker://$repo:$tag"
+          mkdir -p "$RUNNER_TEMP/out"
+          printf '%s@%s\n' "$repo" "$(cat digest.txt)" > "$RUNNER_TEMP/out/$IMAGE-$VARIANT-$ARCH"
+          echo "pushed $repo:$tag ($(cat digest.txt)) image id $(cat image.id)"
+
+      - name: Record the digest
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: pushed-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/out/
+          retention-days: 7
+          if-no-files-found: error
+
+  manifest:
+    name: Multi-arch ${{ matrix.image }}/${{ matrix.variant }}
+    needs: push
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    permissions:
+      contents: read
+      packages: write
+    strategy:
+      fail-fast: true
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Collect the per-arch digests
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          pattern: pushed-${{ matrix.image }}-${{ matrix.variant }}-*-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/pushed
+          merge-multiple: true
+
+      - name: Tag the multi-arch index
+        env:
+          REGISTRY_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          repo="$(python3 scripts/docker/pins.py image "$IMAGE")"
+          if [ -n "$ATTEMPT_REF" ]; then tag="$ATTEMPT_REF"; else tag=main; fi
+          if [ "$IMAGE" = sandbox ] || [ "$VARIANT" != slim ]; then tag="$tag-$VARIANT"; fi
+          printf '%s' "$REGISTRY_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
+          docker buildx imagetools create -t "$repo:$tag" \
+            "$(cat "$RUNNER_TEMP/pushed/$IMAGE-$VARIANT-amd64")" \
+            "$(cat "$RUNNER_TEMP/pushed/$IMAGE-$VARIANT-arm64")"
+          digest="$(docker buildx imagetools inspect "$repo:$tag" --format '{{json .Manifest.Digest}}' | tr -d '"')"
+          mkdir -p "$RUNNER_TEMP/out"
+          printf '%s\n' "$digest" > "$RUNNER_TEMP/out/$IMAGE-$VARIANT"
+          echo "$repo:$tag -> $digest"
+
+      - name: Record the index digest
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: index-${{ matrix.image }}-${{ matrix.variant }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/out/
+          retention-days: 7
+          if-no-files-found: error
+
+  digests:
+    name: Digests for the publication controller
+    needs: manifest
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    outputs:
+      product-slim: ${{ steps.read.outputs.product-slim }}
+      product-browser: ${{ steps.read.outputs.product-browser }}
+      sandbox-slim: ${{ steps.read.outputs.sandbox-slim }}
+      sandbox-browser: ${{ steps.read.outputs.sandbox-browser }}
+    steps:
+      - name: Collect the index digests
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          pattern: index-*-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/index
+          merge-multiple: true
+
+      - name: Read them
+        id: read
+        run: |
+          for name in product-slim product-browser sandbox-slim sandbox-browser; do
+            digest="$(cat "$RUNNER_TEMP/index/$name")"
+            [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "bad digest for $name: $digest" >&2; exit 1; }
+            echo "$name=$digest" >> "$GITHUB_OUTPUT"
+          done
diff --git a/.hadolint.yaml b/.hadolint.yaml
new file mode 100644
index 0000000..890a22b
--- /dev/null
+++ b/.hadolint.yaml
@@ -0,0 +1,14 @@
+# hadolint policy for docker/Dockerfile and docker/sandbox/Dockerfile (P23-11).
+# Any warning fails the lint; each ignored rule below says why it does not apply to these images.
+failure-threshold: warning
+
+ignored:
+  # DL3008 (pin apt package versions): the base image is pinned by digest (docker/pins.json) and
+  # Debian's stable archive only carries security fixes; pinning each package would freeze those
+  # fixes out and break whenever the archive moves on.
+  - DL3008
+
+# Every base image comes from these registries only.
+trustedRegistries:
+  - docker.io
+  - ghcr.io
diff --git a/docker/Dockerfile b/docker/Dockerfile
new file mode 100644
index 0000000..9f1386c
--- /dev/null
+++ b/docker/Dockerfile
@@ -0,0 +1,138 @@
+# Indus Agent product image (P23-08).
+#
+#   docker build -f docker/Dockerfile -t indus-agent:local .
+#   docker build -f docker/Dockerfile --build-arg VARIANT=browser -t indus-agent:local-browser .
+#
+# Code and its interpreter live in /opt/indus (root-owned, never written at run time); everything a
+# user changes lives in the /opt/data volume (INDUS_HOME). s6-overlay is PID 1: it reaps stray
+# children, runs the optional gateway/dashboard services and then the container's command as its
+# main program (docker/entrypoint.sh, docker/main-wrapper.sh).
+#
+# Every download is pinned: the base image by digest (BASE_IMAGE below, rendered from
+# docker/pins.json by `scripts/docker/pins.py render`), uv by the installer's pins, s6-overlay and
+# Node by docker/pins.json, all verified by SHA-256 before use.
+
+ARG BASE_IMAGE=debian:trixie-slim
+ARG VARIANT=slim
+
+# ---- fetch: pinned downloads, verified before anything is unpacked ----------------------------
+FROM ${BASE_IMAGE} AS fetch
+ARG TARGETARCH
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends ca-certificates python3 xz-utils \
+    && rm -rf /var/lib/apt/lists/*
+WORKDIR /src
+COPY docker/pins.json docker/pins.json
+COPY scripts/install/pins.json scripts/install/pins.json
+COPY scripts/docker/pins.py scripts/docker/pins.py
+RUN python3 -I scripts/docker/pins.py --root /src fetch uv --arch "${TARGETARCH:-amd64}" --out /dl/uv \
+    && python3 -I scripts/docker/pins.py --root /src fetch s6-overlay --arch "${TARGETARCH:-amd64}" --out /dl/s6 \
+    && python3 -I scripts/docker/pins.py --root /src fetch node --arch "${TARGETARCH:-amd64}" --out /dl/node \
+    && mkdir -p /out/uv /out/s6root /out/node \
+    && tar -xzf /dl/uv/*.tar.gz -C /out/uv --strip-components=1 \
+    && for part in /dl/s6/s6-overlay-noarch.tar.xz /dl/s6/s6-overlay-symlinks-noarch.tar.xz; do \
+         tar -C /out/s6root -xJpf "$part"; done \
+    && for part in /dl/s6/s6-overlay-x86_64.tar.xz /dl/s6/s6-overlay-aarch64.tar.xz; do \
+         if [ -f "$part" ]; then tar -C /out/s6root -xJpf "$part"; fi; done \
+    && tar -xJf /dl/node/*.tar.xz -C /out/node --strip-components=1 \
+    && test -x /out/uv/uv && test -x /out/s6root/init && test -x /out/node/bin/node
+
+# ---- web: the dashboard pages, built with the pinned Node -----------------------------------
+FROM ${BASE_IMAGE} AS web
+COPY --from=fetch /out/node /opt/node
+ENV PATH=/opt/node/bin:${PATH} \
+    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
+    CI=1
+WORKDIR /src
+COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
+COPY apps/ apps/
+COPY packages/ packages/
+RUN corepack enable \
+    && pnpm install --frozen-lockfile --filter "@indus/web..." \
+    && pnpm --filter @indus/web build \
+    && test -f apps/web/dist/index.html
+
+# ---- build: Python, the locked environment and the package --------------------------------
+FROM ${BASE_IMAGE} AS build
+ARG VARIANT
+ARG PYTHON_VERSION=3.14
+ARG INDUS_EXTRAS="dashboard pty web docs slack discord mattermost"
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends ca-certificates gcc libc6-dev \
+    && rm -rf /var/lib/apt/lists/*
+COPY --from=fetch /out/uv/uv /usr/local/bin/uv
+ENV UV_PYTHON_INSTALL_DIR=/opt/indus/python \
+    UV_PYTHON_PREFERENCE=only-managed \
+    UV_PROJECT_ENVIRONMENT=/opt/indus/.venv \
+    UV_COMPILE_BYTECODE=1 \
+    UV_LINK_MODE=copy \
+    UV_NO_CONFIG=1 \
+    UV_CACHE_DIR=/tmp/uv-cache
+WORKDIR /opt/indus
+RUN uv python install "${PYTHON_VERSION}"
+COPY pyproject.toml uv.lock README.md LICENSE ./
+# Dependencies first (cached until the lock changes), then the project itself (editable, so the
+# no-wheel build guard of P23-01 is not involved). The extras list is split into words on purpose.
+# hadolint ignore=SC2086
+RUN set -eu; \
+    extras="${INDUS_EXTRAS}"; \
+    if [ "${VARIANT}" = browser ]; then extras="${extras} browser"; fi; \
+    set --; for e in ${extras}; do set -- "$@" --extra "$e"; done; \
+    uv sync --frozen --no-dev --no-install-project --python "${PYTHON_VERSION}" "$@"
+COPY src/ src/
+COPY skills/ skills/
+COPY locales/ locales/
+# pyproject's build hooks (P23-01) live under scripts/.
+COPY scripts/ scripts/
+# hadolint ignore=SC2086
+RUN set -eu; \
+    extras="${INDUS_EXTRAS}"; \
+    if [ "${VARIANT}" = browser ]; then extras="${extras} browser"; fi; \
+    set --; for e in ${extras}; do set -- "$@" --extra "$e"; done; \
+    uv sync --frozen --no-dev --python "${PYTHON_VERSION}" "$@" \
+    && rm -rf /tmp/uv-cache
+COPY --from=web /src/apps/web/dist /tmp/web-dist
+RUN /opt/indus/.venv/bin/python -m indus.web.bundle publish --source /tmp/web-dist \
+    && rm -rf /tmp/web-dist \
+    && printf 'docker\n' > /opt/indus/.install_method \
+    && /opt/indus/.venv/bin/indus --version
+
+# ---- the image -----------------------------------------------------------------------------
+FROM ${BASE_IMAGE} AS product
+ARG VARIANT
+LABEL org.opencontainers.image.title="Indus Agent" \
+      org.opencontainers.image.description="Indus Agent: CLI, gateway and dashboard" \
+      org.opencontainers.image.licenses="MIT" \
+      org.opencontainers.image.source="https://github.com/indus-agent/indus-agent"
+RUN set -eu; \
+    apt-get update; \
+    apt-get install -y --no-install-recommends \
+        ca-certificates curl git openssh-client procps ripgrep xz-utils less; \
+    if [ "${VARIANT}" = browser ]; then \
+        apt-get install -y --no-install-recommends chromium fonts-liberation fonts-noto-color-emoji; \
+    elif [ "${VARIANT}" != slim ]; then \
+        echo "unknown VARIANT ${VARIANT} (slim or browser)" >&2; exit 1; \
+    fi; \
+    rm -rf /var/lib/apt/lists/*
+COPY --from=fetch /out/s6root/ /
+COPY --from=build /opt/indus /opt/indus
+COPY --chmod=0755 docker/entrypoint.sh docker/stage2.sh docker/main-wrapper.sh /opt/indus/docker/
+COPY --chmod=0755 docker/s6/ /etc/s6-overlay/s6-rc.d/
+RUN groupadd --gid 10000 indus \
+    && useradd --uid 10000 --gid indus --home-dir /opt/data --no-create-home --shell /bin/bash indus \
+    && mkdir -p /opt/data \
+    && chown indus:indus /opt/data \
+    && chmod -R go-w /opt/indus \
+    && if [ "${VARIANT}" = browser ]; then printf '/usr/bin/chromium\n' > /opt/indus/.image_chromium; fi
+ENV INDUS_HOME=/opt/data \
+    INDUS_IMAGE_VARIANT=${VARIANT} \
+    PYTHONUNBUFFERED=1 \
+    PYTHONDONTWRITEBYTECODE=1 \
+    PATH=/opt/indus/.venv/bin:${PATH} \
+    S6_KEEP_ENV=1 \
+    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
+    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0
+WORKDIR /opt/indus
+VOLUME ["/opt/data"]
+ENTRYPOINT ["/opt/indus/docker/entrypoint.sh"]
+CMD []
diff --git a/docker/compose.windows.yaml b/docker/compose.windows.yaml
new file mode 100644
index 0000000..a4e5aa4
--- /dev/null
+++ b/docker/compose.windows.yaml
@@ -0,0 +1,36 @@
+# Indus Agent on Windows (Docker Desktop) with Docker Compose (P23-11).
+#
+#   docker compose -f docker/compose.windows.yaml up -d
+#
+# Docker Desktop has no host networking, so the dashboard has to listen on the container's own
+# interface. That is not loopback, so the dashboard starts only once a login provider is set up in
+# the settings on the volume (a username and password, or OIDC; `indus dashboard` on a terminal
+# offers to set the password, the Docker page of the user guide shows both) — there is no switch
+# that skips the login. On this machine the port is published on 127.0.0.1 only.
+#
+# The data folder is %USERPROFILE%\.indus (INDUS_DATA_DIR overrides it), mounted at /opt/data.
+# INDUS_IMAGE picks another image.
+
+name: indus
+
+x-indus: &indus
+  image: ${INDUS_IMAGE:-ghcr.io/indus-agent/indus-agent:stable}
+  restart: unless-stopped
+  volumes:
+    - ${INDUS_DATA_DIR:-${USERPROFILE}/.indus}:/opt/data
+  environment:
+    INDUS_UID: ${INDUS_UID:-10000}
+    INDUS_GID: ${INDUS_GID:-10000}
+
+services:
+  gateway:
+    <<: *indus
+    command: ["gateway", "run"]
+
+  dashboard:
+    <<: *indus
+    depends_on:
+      - gateway
+    ports:
+      - "127.0.0.1:9119:9119"
+    command: ["dashboard", "--host", "0.0.0.0", "--port", "9119", "--no-open"]
