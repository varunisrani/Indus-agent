+# ins_install_setting DIR NAME: update.installs.<id>.<NAME> from <home>/config.yaml, read without
+# Python (the block YAML the settings writer produces); prints nothing when absent or unreadable.
+ins_install_setting() {
+    local config="$IN_HOME/config.yaml" id
+    [ -f "$config" ] || return 0
+    id="$(ins_install_id "$1")" || return 0
+    awk -v id="$id" -v want="$2" -v q="'" '
+        function clean(s,   f) {
+            sub(/^[ \t]+/, "", s)
+            sub(/[ \t]+#.*$/, "", s)
+            sub(/[ \t\r]+$/, "", s)
+            f = substr(s, 1, 1)
+            if (length(s) >= 2 && (f == "\"" || f == q) && substr(s, length(s), 1) == f) {
+                s = substr(s, 2, length(s) - 2)
+            }
+            return s
+        }
+        /^[ \t]*(#|\r?$)/ { next }
+        {
+            match($0, /^ */)
+            indent = RLENGTH
+            rest = substr($0, indent + 1)
+            colon = index(rest, ":")
+            if (colon == 0) next
+            while (depth > 0 && level[depth] >= indent) depth--
+            depth++
+            level[depth] = indent
+            name[depth] = clean(substr(rest, 1, colon - 1))
+            if (depth == 4 && name[1] == "update" && name[2] == "installs" && name[3] == id \
+                && name[4] == want) {
+                print clean(substr(rest, colon + 1))
+                exit
+            }
+        }' "$config"
+}
