+def _fake_venv(box: Sandbox) -> Path:
+    checkout = _checkout(box)
+    program = checkout / ".venv" / "bin" / "indus"
+    program.parent.mkdir(parents=True)
+    program.write_text('#!/bin/sh\nprintf \'%s\\n\' "$*" >>"$INDUS_FAKE_TOOLS_STATE/indus-calls"\n')
+    program.chmod(0o755)
+    return program
