+ins_stage_repository() {
+    local aside
+    if [ -e "$IN_DIR/.git" ] && ! git -C "$IN_DIR" rev-parse --verify -q HEAD >/dev/null 2>&1; then
+        aside="$IN_DIR.broken-$(ins_stamp)"
