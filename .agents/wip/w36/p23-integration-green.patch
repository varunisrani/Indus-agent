+def test_complete_writes_the_marker_and_saves_an_explicit_channel(box: Sandbox) -> None:
+    make_origin(box)
+    checkout = box.indus_home / "indus-agent"
+    box.git("clone", "-q", OFFICIAL_URL, str(checkout))
+    program = checkout / ".venv" / "bin" / "indus"
