diff --git a/.github/workflows/docker.yml b/.github/workflows/docker.yml
new file mode 100644
index 0000000..8c9d940
--- /dev/null
+++ b/.github/workflows/docker.yml
@@ -0,0 +1,307 @@
+# Container images (P23-12): the product image and the sandbox image, slim and browser, amd64 and
+# arm64 on native runners.
+#
+# - pull requests: lint, build and test every image; nothing is pushed;
+# - pushes to main: the same, then the tested images go to GHCR as :main / :main-browser (product)
+#   and :main-slim / :main-browser (sandbox);
+# - releases (called by the release workflow, P23-23): phase `test` builds and tests the admitted
+#   commit and keeps each image as an artifact; phase `publish` pushes those very archives (nothing
+#   is rebuilt) under the attempt ref and returns the manifest digests.
+#
+# Channel aliases (latest, stable, canary; with the variant suffix: `-browser` on the product,
+# `-slim` / `-browser` on the sandbox) are never written here: only the publication controller
+# (scripts/release/publish.py) moves them, from the digests a release receipt binds (R10.23).
+# Every job checks out `inputs.commit || github.sha` explicitly: in a release run the workflow's own
+# SHA is not the commit under test (R10.24).
+
+name: Docker
+
+on:
+  workflow_call:
+    inputs:
+      commit:
+        description: The admitted commit to build (full 40-hex SHA).
+        required: true
+        type: string
+      attempt_ref:
+        description: The attempt ref under release (rc.<N>-vX.Y.Z); the images are tagged with it.
+        required: true
+        type: string
+      phase:
+        description: "test: build, test and keep the images; publish: push the kept images."
+        required: true
+        type: string
+    outputs:
+      product-digest:
+        description: Digest of the product image index (slim).
+        value: ${{ jobs.digests.outputs.product-slim }}
+      product-browser-digest:
+        description: Digest of the product image index (browser).
+        value: ${{ jobs.digests.outputs.product-browser }}
+      sandbox-digest:
+        description: Digest of the sandbox image index (slim).
+        value: ${{ jobs.digests.outputs.sandbox-slim }}
+      sandbox-browser-digest:
+        description: Digest of the sandbox image index (browser).
+        value: ${{ jobs.digests.outputs.sandbox-browser }}
+  push:
+    branches: [main]
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: docker-${{ inputs.attempt_ref || github.ref }}-${{ inputs.phase || 'ci' }}
+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
+
+env:
+  COMMIT: ${{ inputs.commit || github.sha }}
+  ATTEMPT_REF: ${{ inputs.attempt_ref }}
+  PHASE: ${{ inputs.phase }}
+
+jobs:
+  lint:
+    name: Lint Dockerfiles, pins and workflows
+    if: ${{ inputs.phase != 'publish' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Check the release inputs
+        if: ${{ inputs.phase }}
+        run: |
+          [[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || { echo "commit must be a full SHA: $COMMIT" >&2; exit 1; }
+          [[ "$ATTEMPT_REF" =~ ^rc\.[0-9]+-v[0-9]+\.[0-9]+\.[0-9]+(-canary\.[0-9]{8}T[0-9]{6}Z)?$ ]] \
+            || { echo "not an attempt ref: $ATTEMPT_REF" >&2; exit 1; }
+          [[ "$PHASE" == test || "$PHASE" == publish ]] || { echo "unknown phase: $PHASE" >&2; exit 1; }
+
+      - name: Every pin filled and every Dockerfile on the pinned base
+        run: python3 scripts/docker/pins.py check --strict
+
+      - name: Fetch the pinned linters
+        run: |
+          python3 scripts/docker/pins.py fetch hadolint actionlint --arch amd64 --out "$RUNNER_TEMP/tools"
+          mkdir -p "$RUNNER_TEMP/bin"
+          install -m 0755 "$RUNNER_TEMP/tools/hadolint-Linux-x86_64" "$RUNNER_TEMP/bin/hadolint"
+          tar -xzf "$RUNNER_TEMP"/tools/actionlint_*_linux_amd64.tar.gz -C "$RUNNER_TEMP/bin" actionlint
+          echo "$RUNNER_TEMP/bin" >> "$GITHUB_PATH"
+
+      - name: hadolint
+        run: hadolint docker/Dockerfile docker/sandbox/Dockerfile
+
+      - name: actionlint
+        run: actionlint .github/workflows/*.yml
+
+  build:
+    name: Build and test ${{ matrix.image }}/${{ matrix.variant }}/${{ matrix.arch }}
+    if: ${{ inputs.phase != 'publish' }}
+    needs: lint
+    strategy:
+      fail-fast: false
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+        arch: [amd64, arm64]
+        include:
+          - arch: amd64
+            runner: ubuntu-24.04
+          - arch: arm64
+            runner: ubuntu-24.04-arm
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 60
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+      ARCH: ${{ matrix.arch }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Build
+        run: |
+          if [ "$IMAGE" = product ]; then
+            set -- -f docker/Dockerfile --target product --build-arg "VARIANT=$VARIANT"
+          else
+            set -- -f docker/sandbox/Dockerfile --target "$VARIANT"
+          fi
+          docker build --platform "linux/$ARCH" --pull "$@" \
+            --label "org.opencontainers.image.revision=$COMMIT" \
+            -t "indus-$IMAGE:test" .
+          mkdir -p "$RUNNER_TEMP/image"
+          docker save -o "$RUNNER_TEMP/image/image.tar" "indus-$IMAGE:test"
+          docker image inspect --format '{{.Id}}' "indus-$IMAGE:test" > "$RUNNER_TEMP/image/image.id"
+          (cd "$RUNNER_TEMP/image" && sha256sum image.tar > image.tar.sha256)
+
+      - name: Set up the pinned uv
+        run: |
+          python3 scripts/docker/pins.py fetch uv --arch "$ARCH" --out "$RUNNER_TEMP/uv-dl"
+          mkdir -p "$RUNNER_TEMP/uv"
+          tar -xzf "$RUNNER_TEMP"/uv-dl/*.tar.gz -C "$RUNNER_TEMP/uv" --strip-components=1
+          echo "$RUNNER_TEMP/uv" >> "$GITHUB_PATH"
+
+      - name: Image tests
+        run: |
+          uv sync --locked
+          if [ "$IMAGE" = product ]; then
+            export INDUS_TEST_IMAGE="indus-$IMAGE:test" INDUS_TEST_IMAGE_VARIANT="$VARIANT"
+          else
+            export INDUS_TEST_SANDBOX_IMAGE="indus-$IMAGE:test" INDUS_TEST_IMAGE_VARIANT="$VARIANT"
+          fi
+          uv run pytest -q -m docker tests/docker
+
+      - name: Keep the tested image
+        if: ${{ github.event_name == 'push' || inputs.phase == 'test' }}
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: image-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/image/
+          retention-days: 7
+          if-no-files-found: error
+
+  push:
+    name: Push ${{ matrix.image }}/${{ matrix.variant }}/${{ matrix.arch }} by digest
+    needs: build
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    permissions:
+      contents: read
+      packages: write
+    strategy:
+      fail-fast: true
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+        arch: [amd64, arm64]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+      ARCH: ${{ matrix.arch }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Fetch the tested image
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          name: image-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/image
+
+      - name: Push the tested bytes
+        env:
+          REGISTRY_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          cd "$RUNNER_TEMP/image"
+          sha256sum -c image.tar.sha256
+          repo="$(python3 "$GITHUB_WORKSPACE/scripts/docker/pins.py" image "$IMAGE")"
+          if [ -n "$ATTEMPT_REF" ]; then base="$ATTEMPT_REF"; else base=main; fi
+          if [ "$IMAGE" = sandbox ] || [ "$VARIANT" != slim ]; then base="$base-$VARIANT"; fi
+          tag="$base-$ARCH"
+          printf '%s' "$REGISTRY_TOKEN" | skopeo login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
+          skopeo copy --digestfile digest.txt "docker-archive:image.tar" "docker://$repo:$tag"
+          mkdir -p "$RUNNER_TEMP/out"
+          printf '%s@%s\n' "$repo" "$(cat digest.txt)" > "$RUNNER_TEMP/out/$IMAGE-$VARIANT-$ARCH"
+          echo "pushed $repo:$tag ($(cat digest.txt)) image id $(cat image.id)"
+
+      - name: Record the digest
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: pushed-${{ matrix.image }}-${{ matrix.variant }}-${{ matrix.arch }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/out/
+          retention-days: 7
+          if-no-files-found: error
+
+  manifest:
+    name: Multi-arch ${{ matrix.image }}/${{ matrix.variant }}
+    needs: push
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    permissions:
+      contents: read
+      packages: write
+    strategy:
+      fail-fast: true
+      matrix:
+        image: [product, sandbox]
+        variant: [slim, browser]
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    env:
+      IMAGE: ${{ matrix.image }}
+      VARIANT: ${{ matrix.variant }}
+    steps:
+      - name: Check out the commit under test
+        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          ref: ${{ inputs.commit || github.sha }}
+          persist-credentials: false
+
+      - name: Collect the per-arch digests
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          pattern: pushed-${{ matrix.image }}-${{ matrix.variant }}-*-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/pushed
+          merge-multiple: true
+
+      - name: Tag the multi-arch index
+        env:
+          REGISTRY_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          repo="$(python3 scripts/docker/pins.py image "$IMAGE")"
+          if [ -n "$ATTEMPT_REF" ]; then tag="$ATTEMPT_REF"; else tag=main; fi
+          if [ "$IMAGE" = sandbox ] || [ "$VARIANT" != slim ]; then tag="$tag-$VARIANT"; fi
+          printf '%s' "$REGISTRY_TOKEN" | docker login ghcr.io -u "$GITHUB_ACTOR" --password-stdin
+          docker buildx imagetools create -t "$repo:$tag" \
+            "$(cat "$RUNNER_TEMP/pushed/$IMAGE-$VARIANT-amd64")" \
+            "$(cat "$RUNNER_TEMP/pushed/$IMAGE-$VARIANT-arm64")"
+          digest="$(docker buildx imagetools inspect "$repo:$tag" --format '{{json .Manifest.Digest}}' | tr -d '"')"
+          mkdir -p "$RUNNER_TEMP/out"
+          printf '%s\n' "$digest" > "$RUNNER_TEMP/out/$IMAGE-$VARIANT"
+          echo "$repo:$tag -> $digest"
+
+      - name: Record the index digest
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: index-${{ matrix.image }}-${{ matrix.variant }}-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/out/
+          retention-days: 7
+          if-no-files-found: error
+
+  digests:
+    name: Digests for the publication controller
+    needs: manifest
+    if: ${{ !cancelled() && !failure() && (github.event_name == 'push' || inputs.phase == 'publish') }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 5
+    outputs:
+      product-slim: ${{ steps.read.outputs.product-slim }}
+      product-browser: ${{ steps.read.outputs.product-browser }}
+      sandbox-slim: ${{ steps.read.outputs.sandbox-slim }}
+      sandbox-browser: ${{ steps.read.outputs.sandbox-browser }}
+    steps:
+      - name: Collect the index digests
+        uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093 # v4.3.0
+        with:
+          pattern: index-*-${{ inputs.attempt_ref || 'main' }}
+          path: ${{ runner.temp }}/index
+          merge-multiple: true
+
+      - name: Read them
+        id: read
+        run: |
+          for name in product-slim product-browser sandbox-slim sandbox-browser; do
+            digest="$(cat "$RUNNER_TEMP/index/$name")"
+            [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]] || { echo "bad digest for $name: $digest" >&2; exit 1; }
+            echo "$name=$digest" >> "$GITHUB_OUTPUT"
+          done
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
new file mode 100644
index 0000000..b75cb2d
--- /dev/null
+++ b/.github/workflows/release.yml
@@ -0,0 +1,401 @@
+name: Release
+run-name: Release ${{ inputs.attempt_ref }}
+
+# P23-23. Started only by scripts/release/release.py, on the default branch, with the attempt ref
+# it pushed (rc.<N>-v<version>). The workflow and the release scripts come from the default branch;
+# the code under test is the commit the attempt ref claims. `github.sha` is the default branch's
+# tip, never that commit (R10.24): every job that builds or tests checks out
+# `needs.admit.outputs.commit` explicitly. Nothing is rebuilt for publication (R10.23): the gate
+# judges the jobs that built the artefacts and images; after it, `docker-publish` pushes the very
+# image archives the `docker` lane tested (docker.yml phase `publish`, tagged with the attempt ref)
+# and `publish` only re-points aliases at those digests.
+
+on:
+  workflow_dispatch:
+    inputs:
+      attempt_ref:
+        description: The attempt ref to admit (rc.<N>-v<version>)
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+concurrency:
+  group: release
+  cancel-in-progress: false
+
+env:
+  REF_REPOSITORY_URL: https://github.com/NousResearch/hermes-agent.git
+  REF_COMMIT: ab3fe9dffb0a89d534cb795e2a2940e5f6542056
+
+jobs:
+  admit:
+    name: Admit the attempt ref
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    outputs:
+      attempt-ref: ${{ steps.admit.outputs.attempt-ref }}
+      commit: ${{ steps.admit.outputs.commit }}
+      version: ${{ steps.admit.outputs.version }}
+      tag: ${{ steps.admit.outputs.tag }}
+      kind: ${{ steps.admit.outputs.kind }}
+      epoch: ${{ steps.admit.outputs.epoch }}
+      lanes: ${{ steps.admit.outputs.lanes }}
+      jobs: ${{ steps.admit.outputs.jobs }}
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Admit
+        id: admit
+        env:
+          ATTEMPT_REF: ${{ inputs.attempt_ref }}
+          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
+        run: >-
+          uv run --locked --no-dev python scripts/release/publish.py admit
+          --ref "$ATTEMPT_REF" --default-branch "$DEFAULT_BRANCH"
+
+  ci:
+    name: Full suite and guards
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['ci']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Fetch the pinned reference (outside the workspace)
+        working-directory: ${{ runner.temp }}
+        run: |
+          git init --quiet ref
+          git -C ref fetch --quiet --depth 1 "$REF_REPOSITORY_URL" "$REF_COMMIT"
+          git -C ref checkout --quiet --detach FETCH_HEAD
+          echo "INDUS_REF=${RUNNER_TEMP}/ref" >> "$GITHUB_ENV"
+      - name: Install
+        run: uv sync --locked
+      - name: Lint, format, layers, types
+        run: |
+          uv run ruff check .
+          uv run ruff format --check .
+          uv run lint-imports
+          uv run pyright
+      - name: Tests
+        run: uv run pytest -q -m "not perf"
+      - name: Perf bounds (serial, alone)
+        run: uv run pytest -q -m perf
+      - name: Repo guards
+        run: uv run python -m tooling.checks --require-ref
+
+  docker:
+    name: Images (built, tested, pushed by digest)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['docker']
+    permissions:
+      contents: read
+      packages: write
+    uses: ./.github/workflows/docker.yml
+    with:
+      commit: ${{ needs.admit.outputs.commit }}
+      attempt_ref: ${{ needs.admit.outputs.attempt-ref }}
+      phase: test
+
+  nix:
+    name: Nix flake check
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['nix']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Install Nix
+        uses: cachix/install-nix-action@630ae543ea3a38a9a4166f03376c02c50f408342 # v31.11.0
+      - name: Check
+        run: nix flake check -L
+      - name: Run the default package
+        run: nix run .#default -- --version
+
+  install-e2e:
+    name: Fresh install (${{ matrix.os }})
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['install-e2e']
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, macos-latest, windows-latest]
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 45
+    env:
+      COMMIT: ${{ needs.admit.outputs.commit }}
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: install.sh
+        if: runner.os != 'Windows'
+        run: |
+          bash scripts/install.sh --channel main --commit "$COMMIT" \
+            --dir "$RUNNER_TEMP/indus-agent" --indus-home "$RUNNER_TEMP/indus-home" \
+            --non-interactive --skip-browser --skip-computer-use
+          "$RUNNER_TEMP/indus-agent/.venv/bin/indus" --version
+      - name: install.ps1
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: |
+          ./scripts/install.ps1 -Channel main -Commit $env:COMMIT `
+            -InstallDir "$env:RUNNER_TEMP\indus-agent" -IndusHome "$env:RUNNER_TEMP\indus-home" `
+            -NonInteractive -SkipBrowser -SkipComputerUse
+
+  # Desktop lanes build with P20-38's packaging (`dist:unsigned`, output apps/desktop/build/release).
+  # Signing is P23-15 (macOS: APPLE_ID, APPLE_TEAM_ID, APPLE_APP_SPECIFIC_PASSWORD,
+  # MAC_CERTIFICATE, MAC_CERTIFICATE_PASSWORD) and P23-16 (Windows: WIN_CERTIFICATE,
+  # WIN_CERTIFICATE_PASSWORD), added with their hooks in the protected `release` environment; until
+  # then these lanes publish unsigned builds and pass no secret to the build.
+  desktop-mac:
+    name: Desktop (macOS)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-mac']
+    runs-on: macos-latest
+    timeout-minutes: 90
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+          INDUS_DESKTOP_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_DESKTOP_CHANNEL: ${{ needs.admit.outputs.kind }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:unsigned
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-mac
+          path: apps/desktop/build/release/*.*
+          if-no-files-found: error
+
+  desktop-win:
+    name: Desktop (Windows)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-win']
+    runs-on: windows-latest
+    timeout-minutes: 90
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+          INDUS_DESKTOP_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_DESKTOP_CHANNEL: ${{ needs.admit.outputs.kind }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:unsigned
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-win
+          path: apps/desktop/build/release/*.*
+          if-no-files-found: error
+
+  desktop-linux:
+    name: Desktop (Linux)
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['desktop-linux']
+    runs-on: ubuntu-latest
+    timeout-minutes: 60
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          persist-credentials: false
+      - name: Set up Node
+        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # 7.0.0
+        with:
+          node-version-file: .nvmrc
+      - name: Build
+        env:
+          INDUS_RELEASE_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_RELEASE_EPOCH: ${{ needs.admit.outputs.epoch }}
+          INDUS_DESKTOP_VERSION: ${{ needs.admit.outputs.version }}
+          INDUS_DESKTOP_CHANNEL: ${{ needs.admit.outputs.kind }}
+        run: |
+          corepack enable
+          pnpm install --frozen-lockfile
+          pnpm --filter @indus/desktop run dist:unsigned
+      - name: Keep the artefacts
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: desktop-linux
+          path: apps/desktop/build/release/*.*
+          if-no-files-found: error
+
+  upgrade:
+    name: Previous release → this commit
+    needs: admit
+    if: fromJSON(needs.admit.outputs.jobs)['upgrade']
+    runs-on: ubuntu-latest
+    timeout-minutes: 45
+    env:
+      COMMIT: ${{ needs.admit.outputs.commit }}
+      VERSION: ${{ needs.admit.outputs.version }}
+    steps:
+      - name: Check out the admitted commit
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ needs.admit.outputs.commit }}
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Install the previous release, then update it to this commit
+        run: |
+          previous="$(git tag --list 'v*' --sort=-version:refname --merged "$COMMIT" \
+            | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | head -n 1 || true)"
+          if [ -z "$previous" ]; then
+            echo "No earlier release: nothing to upgrade from."
+            exit 0
+          fi
+          home="$RUNNER_TEMP/indus-home"
+          checkout="$RUNNER_TEMP/indus-agent"
+          bash scripts/install.sh --channel stable --commit "$(git rev-parse "$previous^{commit}")" \
+            --dir "$checkout" --indus-home "$home" --non-interactive --skip-browser --skip-computer-use
+          git -C "$checkout" fetch --quiet origin "$COMMIT"
+          # The release is not published yet: a local tag makes it the newest stable it sees.
+          git -C "$checkout" tag "v$VERSION" "$COMMIT"
+          INDUS_HOME="$home" "$checkout/.venv/bin/indus" update -y --channel stable --no-gateway-restart
+          test "$(git -C "$checkout" rev-parse HEAD)" = "$COMMIT"
+          INDUS_HOME="$home" "$checkout/.venv/bin/indus" --version
+
+  upload:
+    name: Artefacts onto the draft (once)
+    needs: [admit, desktop-mac, desktop-win, desktop-linux]
+    if: ${{ !cancelled() && needs.admit.result == 'success' && !contains(needs.*.result, 'failure') }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    permissions:
+      contents: write
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Collect the tested artefacts
+        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          pattern: desktop-*
+          path: ${{ runner.temp }}/artefacts
+          merge-multiple: true
+      - name: Upload with the manifest
+        env:
+          GH_TOKEN: ${{ github.token }}
+          ATTEMPT_REF: ${{ needs.admit.outputs.attempt-ref }}
+        run: |
+          mkdir -p "$RUNNER_TEMP/artefacts"
+          uv run --locked --no-dev python scripts/release/publish.py upload \
+            --ref "$ATTEMPT_REF" --dir "$RUNNER_TEMP/artefacts"
+
+  gate:
+    name: Every selected job passed
+    if: always()
+    needs: [admit, ci, docker, nix, install-e2e, desktop-mac, desktop-win, desktop-linux, upgrade, upload]
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - name: Strict gate
+        env:
+          NEEDS: ${{ toJSON(needs) }}
+          LANES: ${{ needs.admit.outputs.lanes }}
+        run: python3 scripts/release/claims.py gate
+
+  docker-publish:
+    name: Images pushed by digest (the tested archives)
+    needs: [admit, gate]
+    if: ${{ success() && fromJSON(needs.admit.outputs.jobs)['docker'] }}
+    permissions:
+      contents: read
+      packages: write
+    uses: ./.github/workflows/docker.yml
+    with:
+      commit: ${{ needs.admit.outputs.commit }}
+      attempt_ref: ${{ needs.admit.outputs.attempt-ref }}
+      phase: publish
+
+  publish:
+    name: Publish (receipt, aliases, channel record, public last)
+    needs: [admit, gate, docker-publish]
+    # A red gate never publishes; the images must be pushed when the docker lane was on.
+    if: >-
+      ${{ !cancelled() && needs.gate.result == 'success'
+      && contains(fromJSON('["success", "skipped"]'), needs.docker-publish.result) }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    environment: release
+    permissions:
+      contents: write
+      packages: write
+      actions: read
+    concurrency:
+      group: release-publication
+      cancel-in-progress: false
+    steps:
+      - name: Check out the release scripts (default branch)
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+      - name: Set up uv
+        uses: astral-sh/setup-uv@fac544c07dec837d0ccb6301d7b5580bf5edae39 # 8.2.0
+      - name: Log in to GHCR
+        env:
+          GH_TOKEN: ${{ github.token }}
+          ACTOR: ${{ github.actor }}
+        run: printf '%s' "$GH_TOKEN" | docker login ghcr.io --username "$ACTOR" --password-stdin
+      - name: Resolve claims oldest first and publish what may go out
+        env:
+          GH_TOKEN: ${{ github.token }}
+          GIT_COMMITTER_NAME: indus-release
+          GIT_COMMITTER_EMAIL: ${{ github.actor_id }}+${{ github.actor }}@users.noreply.github.com
+        run: uv run --locked --no-dev python scripts/release/publish.py publish
