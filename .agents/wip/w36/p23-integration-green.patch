--- /dev/null
+++ b/tests/unit/ci/test_docker_workflow.py
@@ -0,0 +1,183 @@
+"""The image publishing workflow read statically (P23-12, R10.23, R10.24). It never runs here."""
+
+from __future__ import annotations
+
+import re
+import shutil
+import subprocess
+from typing import Any
+
+import pytest
+from ruamel.yaml import YAML
+
+from tests.unit.packaging.docker_files import ROOT, WORKFLOW
+
+COMMIT_REF = "${{ inputs.commit || github.sha }}"
+ALIASES = ("latest", "stable", "canary")
+
+
+def workflow() -> dict[str, Any]:
+    data = YAML(typ="safe").load(WORKFLOW.read_text(encoding="utf-8"))
+    assert isinstance(data, dict)
+    return data
+
+
+def jobs() -> dict[str, dict[str, Any]]:
+    return workflow()["jobs"]
+
+
+def steps(job: dict[str, Any]) -> list[dict[str, Any]]:
+    return job.get("steps", [])
+
+
+def all_steps() -> list[tuple[str, dict[str, Any]]]:
+    return [(name, step) for name, job in jobs().items() for step in steps(job)]
+
+
+def test_triggers_and_release_inputs() -> None:
+    on = workflow()["on"]
+    assert set(on) == {"pull_request", "push", "workflow_call"}
+    assert on["push"]["branches"] == ["main"]
+    inputs = on["workflow_call"]["inputs"]
+    for name in ("commit", "attempt_ref", "phase"):
+        assert inputs[name]["required"] is True and inputs[name]["type"] == "string"
+    outputs = on["workflow_call"]["outputs"]
+    assert set(outputs) == {
+        "product-digest",
+        "product-browser-digest",
+        "sandbox-digest",
+        "sandbox-browser-digest",
+    }
+
+
+def test_every_action_is_pinned_to_a_full_commit_sha() -> None:
+    uses = [step["uses"] for _, step in all_steps() if "uses" in step]
+    assert uses
+    for ref in uses:
+        assert re.fullmatch(r"[\w.-]+/[\w.-]+(/[\w./-]+)?@[0-9a-f]{40}", ref), ref
+
+
+def test_every_checkout_takes_the_commit_under_test() -> None:
+    """R10.24: in a release run the workflow's own SHA is not the admitted commit."""
+    checkouts = [
+        (name, step)
+        for name, step in all_steps()
+        if step.get("uses", "").startswith("actions/checkout@")
+    ]
+    assert {name for name, _ in checkouts} == {"lint", "build", "push", "manifest"}
+    for name, step in checkouts:
+        assert step["with"]["ref"] == COMMIT_REF, name
+        assert step["with"]["persist-credentials"] is False, name
+    assert workflow()["env"]["COMMIT"] == COMMIT_REF
+
+
+def test_release_inputs_are_validated_before_building() -> None:
+    lint = steps(jobs()["lint"])
+    check = next(s for s in lint if s.get("name") == "Check the release inputs")
+    assert check["if"] == "${{ inputs.phase }}"
+    assert "[0-9a-f]{40}" in check["run"] and "rc\\." in check["run"]
+    assert jobs()["build"]["needs"] == "lint"
+
+
+def test_no_job_moves_a_channel_alias() -> None:
+    """R10.23: latest / stable / canary (and the sandbox's slim / browser aliases) move only in
+    the publication controller, from a receipt-bound digest."""
+    text = WORKFLOW.read_text(encoding="utf-8")
+    runs = "\n".join(step.get("run", "") for _, step in all_steps())
+    for alias in ALIASES:
+        assert not re.search(rf":{alias}\b", text), alias
+        assert not re.search(rf"\btag=[\"']?{alias}\b", runs), alias
+    # every tag the workflow writes starts from `main` or the attempt ref
+    assignments = re.findall(r"\b(?:tag|base)=([^\n;]+)", runs)
+    assert len(assignments) >= 6
+    for value in assignments:
+        assert value.startswith(('"$ATTEMPT_REF"', "main", '"$base-', '"$tag-')), value
+
+
+def test_publishing_never_rebuilds() -> None:
+    for name in ("push", "manifest", "digests"):
+        runs = "\n".join(step.get("run", "") for step in steps(jobs()[name]))
+        assert not re.search(r"docker build(\s|$)|buildx build", runs), name
+    push = steps(jobs()["push"])
+    assert any(s.get("uses", "").startswith("actions/download-artifact@") for s in push)
+    pushing = next(s for s in push if s.get("name") == "Push the tested bytes")
+    assert "sha256sum -c image.tar.sha256" in pushing["run"]
+    assert "skopeo copy" in pushing["run"] and "docker-archive:image.tar" in pushing["run"]
+
+
+def test_release_publish_skips_build_and_lint() -> None:
+    assert jobs()["lint"]["if"] == "${{ inputs.phase != 'publish' }}"
+    assert jobs()["build"]["if"] == "${{ inputs.phase != 'publish' }}"
+    for name in ("push", "manifest", "digests"):
+        condition = jobs()[name]["if"]
+        assert "github.event_name == 'push' || inputs.phase == 'publish'" in condition
+        assert "!failure()" in condition and "!cancelled()" in condition
+
+
+def test_only_publishing_jobs_may_write_packages() -> None:
+    assert workflow()["permissions"] == {"contents": "read"}
+    for name, job in jobs().items():
+        perms = job.get("permissions", {})
+        if name in ("push", "manifest"):
+            assert perms == {"contents": "read", "packages": "write"}, name
+        else:
+            assert "packages" not in perms, name
+
+
+def test_pull_requests_never_log_in_or_push() -> None:
+    for name in ("lint", "build"):
+        runs = "\n".join(step.get("run", "") for step in steps(jobs()[name]))
+        assert "login" not in runs and "skopeo copy" not in runs and "docker push" not in runs
+    keep = next(s for s in steps(jobs()["build"]) if s.get("name") == "Keep the tested image")
+    assert keep["if"] == "${{ github.event_name == 'push' || inputs.phase == 'test' }}"
+
+
+def test_matrix_covers_every_image_variant_and_native_arch() -> None:
+    build = jobs()["build"]
+    matrix = build["strategy"]["matrix"]
+    assert matrix["image"] == ["product", "sandbox"]
+    assert matrix["variant"] == ["slim", "browser"]
+    assert matrix["arch"] == ["amd64", "arm64"]
+    runners = {entry["arch"]: entry["runner"] for entry in matrix["include"]}
+    assert runners == {"amd64": "ubuntu-24.04", "arm64": "ubuntu-24.04-arm"}
+    assert build["runs-on"] == "${{ matrix.runner }}"
+    text = WORKFLOW.read_text(encoding="utf-8")
+    assert "qemu" not in text.lower()
+    push = jobs()["push"]["strategy"]["matrix"]
+    assert (push["image"], push["variant"], push["arch"]) == (
+        matrix["image"],
+        matrix["variant"],
+        matrix["arch"],
+    )
+
+
+def test_image_tests_run_against_the_built_tag() -> None:
+    runs = "\n".join(step.get("run", "") for step in steps(jobs()["build"]))
+    assert "pytest -q -m docker tests/docker" in runs
+    assert "INDUS_TEST_IMAGE=" in runs and "INDUS_TEST_SANDBOX_IMAGE=" in runs
+    assert "scripts/docker/pins.py fetch uv" in runs
+
+
+def test_registry_coordinates_come_from_the_pins() -> None:
+    runs = "\n".join(step.get("run", "") for _, step in all_steps())
+    assert "ghcr.io/" not in runs
+    assert (
+        runs.count('scripts/docker/pins.py" image') + runs.count("scripts/docker/pins.py image")
+        == 2
+    )
+
+
+def test_release_concurrency_never_cancels() -> None:
+    concurrency = workflow()["concurrency"]
+    assert concurrency["cancel-in-progress"] == "${{ github.event_name == 'pull_request' }}"
+    assert "inputs.attempt_ref" in concurrency["group"] and "inputs.phase" in concurrency["group"]
+
+
+def test_actionlint_is_clean_when_installed() -> None:
+    actionlint = shutil.which("actionlint")
+    if actionlint is None:
+        pytest.skip("actionlint is not installed (the Docker workflow's lint job runs it)")
+    done = subprocess.run(
+        [actionlint, str(WORKFLOW)], capture_output=True, text=True, cwd=ROOT, check=False
+    )
+    assert done.returncode == 0, done.stdout + done.stderr
diff --git a/tests/unit/ci/test_release_workflow.py b/tests/unit/ci/test_release_workflow.py
new file mode 100644
index 0000000..f8e7d12
--- /dev/null
+++ b/tests/unit/ci/test_release_workflow.py
@@ -0,0 +1,190 @@
+"""P23-23: the shape of ``release.yml`` and ``canary.yml`` (R10.18, R10.23, R10.24).
+
+The workflows never run here; these tests read them as data. They pin what the release process
+relies on: dispatch only from the default branch, the admitted commit (not ``github.sha``)
+checked out by every job that builds or tests, a strict gate over every job, publication only
+after the gate, actions pinned by full SHA and no workflow input pasted into a shell script.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, cast
+
+import pytest
+
+from indus.foundation import yamlio
+from scripts.release.claims import JOB_LANES
+
+ROOT = Path(__file__).resolve().parents[3]
+RELEASE = ROOT / ".github/workflows/release.yml"
+CANARY = ROOT / ".github/workflows/canary.yml"
+ADMITTED = "${{ needs.admit.outputs.commit }}"
+SCRIPT_JOBS = {"admit", "upload", "gate", "publish"}
+"""Jobs that run only the release scripts (from the default branch) and build nothing."""
+AFTER_GATE = {"docker-publish"}
+"""Jobs that run after the gate: they push what the gated jobs built (nothing is rebuilt)."""
+
+
+def load(path: Path) -> dict[str, Any]:
+    data = yamlio.load_safe(path)
+    assert isinstance(data, dict)
+    return data
+
+
+def triggers(workflow: dict[str, Any]) -> dict[str, Any]:
+    raw = cast(dict[Any, Any], workflow)
+    found = raw["on"] if "on" in raw else raw.get(True)  # YAML 1.1 reads a bare `on` as true
+    assert isinstance(found, dict)
+    return found
+
+
+@pytest.fixture(scope="module")
+def release() -> dict[str, Any]:
+    return load(RELEASE)
+
+
+@pytest.fixture(scope="module")
+def jobs(release: dict[str, Any]) -> dict[str, dict[str, Any]]:
+    return release["jobs"]
+
+
+def checkout_refs(job: dict[str, Any]) -> list[str]:
+    return [
+        str((step.get("with") or {}).get("ref", ""))
+        for step in job.get("steps", [])
+        if str(step.get("uses", "")).startswith("actions/checkout@")
+    ]
+
+
+def test_release_is_dispatch_only_from_the_default_branch(release: dict[str, Any]) -> None:
+    on = triggers(release)
+    assert set(on) == {"workflow_dispatch"}
+    attempt = on["workflow_dispatch"]["inputs"]["attempt_ref"]
+    assert attempt["required"] is True and attempt["type"] == "string"
+    assert release["run-name"] == "Release ${{ inputs.attempt_ref }}"  # the controller reads it
+    assert release["concurrency"]["cancel-in-progress"] is False
+    assert release["permissions"] == {"contents": "read"}
+    admit = release["jobs"]["admit"]
+    step = next(s for s in admit["steps"] if s.get("id") == "admit")
+    assert "publish.py admit" in step["run"] and "--default-branch" in step["run"]
+    assert step["env"]["DEFAULT_BRANCH"] == "${{ github.event.repository.default_branch }}"
+
+
+def test_lane_jobs_match_the_lane_table(jobs: dict[str, dict[str, Any]]) -> None:
+    lane_jobs = set(jobs) - SCRIPT_JOBS - AFTER_GATE
+    assert lane_jobs | {"upload"} == set(JOB_LANES)
+    for name in lane_jobs:
+        job = jobs[name]
+        assert job["needs"] == "admit" or "admit" in job["needs"], name
+        assert job["if"] == f"fromJSON(needs.admit.outputs.jobs)['{name}']", name
+
+
+def test_every_build_job_uses_the_admitted_commit(jobs: dict[str, dict[str, Any]]) -> None:
+    for name, job in jobs.items():
+        if name in SCRIPT_JOBS:
+            continue
+        if "uses" in job:  # a called workflow gets the commit as an input
+            assert job["with"]["commit"] == ADMITTED, name
+            continue
+        refs = checkout_refs(job)
+        assert refs and all(ref == ADMITTED for ref in refs), name
+        assert "github.sha" not in str(job), name
+
+
+def test_script_jobs_never_build_the_default_branch(jobs: dict[str, dict[str, Any]]) -> None:
+    for name in SCRIPT_JOBS:
+        text = str(jobs[name])
+        assert "pnpm" not in text and "docker build" not in text and "pytest" not in text, name
+        assert all(ref == "${{ github.sha }}" for ref in checkout_refs(jobs[name])), name
+
+
+def test_gate_needs_every_job_and_always_runs(jobs: dict[str, dict[str, Any]]) -> None:
+    gate = jobs["gate"]
+    assert gate["if"] == "always()"
+    assert set(gate["needs"]) == set(jobs) - {"gate", "publish"} - AFTER_GATE
+    step = gate["steps"][-1]
+    assert step["run"] == "python3 scripts/release/claims.py gate"
+    assert step["env"] == {
+        "NEEDS": "${{ toJSON(needs) }}",
+        "LANES": "${{ needs.admit.outputs.lanes }}",
+    }
+
+
+def test_publication_comes_only_after_the_gate(jobs: dict[str, dict[str, Any]]) -> None:
+    publish = jobs["publish"]
+    assert set(publish["needs"]) == {"admit", "gate", "docker-publish"}
+    condition = " ".join(str(publish["if"]).split())
+    assert "!cancelled()" in condition and "needs.gate.result == 'success'" in condition
+    assert "needs.docker-publish.result" in condition and "failure" not in condition
+    pushed = jobs["docker-publish"]
+    assert set(pushed["needs"]) == {"admit", "gate"}
+    assert pushed["if"] == "${{ success() && fromJSON(needs.admit.outputs.jobs)['docker'] }}"
+    assert publish["environment"] == "release"
+    assert publish["concurrency"]["cancel-in-progress"] is False
+    assert "publish.py publish" in publish["steps"][-1]["run"]
+    upload = jobs["upload"]
+    assert "!contains(needs.*.result, 'failure')" in upload["if"]
+    assert "publish.py upload" in upload["steps"][-1]["run"]
+
+
+def test_docker_lane_tests_then_pushes_by_attempt_ref(jobs: dict[str, dict[str, Any]]) -> None:
+    """``docker.yml``'s release interface (P23-12): ``commit``, ``attempt_ref`` and ``phase`` —
+    ``test`` in the gated lane, ``publish`` (push the kept archives) after the gate."""
+    called = load(ROOT / ".github/workflows/docker.yml")
+    inputs = triggers(called)["workflow_call"]["inputs"]
+    for name, phase in (("docker", "test"), ("docker-publish", "publish")):
+        job = jobs[name]
+        assert job["uses"] == "./.github/workflows/docker.yml"
+        assert set(job["with"]) == set(inputs)
+        assert job["with"]["commit"] == ADMITTED
+        assert job["with"]["attempt_ref"] == "${{ needs.admit.outputs.attempt-ref }}"
+        assert job["with"]["phase"] == phase
+        assert "latest" not in str(job) and "stable" not in str(job)
+
+
+def test_desktop_lanes_use_the_packaging_scripts(jobs: dict[str, dict[str, Any]]) -> None:
+    """P20-38 packaging: ``dist:unsigned`` into ``apps/desktop/build/release``; no secret reaches an
+    unsigned build (signing arrives with P23-15/16)."""
+    for name in ("desktop-mac", "desktop-win", "desktop-linux"):
+        job = jobs[name]
+        build = next(s for s in job["steps"] if "pnpm" in str(s.get("run", "")))
+        assert "pnpm --filter @indus/desktop run dist:unsigned" in build["run"]
+        assert "secrets." not in str(job)
+        keep = job["steps"][-1]
+        assert keep["with"]["path"] == "apps/desktop/build/release/*.*"
+
+
+def _uses(workflow: dict[str, Any]) -> list[str]:
+    found: list[str] = []
+    for job in workflow["jobs"].values():
+        for step in job.get("steps", []):
+            if "uses" in step:
+                found.append(str(step["uses"]))
+    return found
+
+
+@pytest.mark.parametrize("path", [RELEASE, CANARY], ids=["release", "canary"])
+def test_actions_are_pinned_by_full_sha(path: Path) -> None:
+    for uses in _uses(load(path)):
+        assert re.fullmatch(r"[\w.-]+/[\w./-]+@[0-9a-f]{40}", uses), uses
+
+
+@pytest.mark.parametrize("path", [RELEASE, CANARY], ids=["release", "canary"])
+def test_no_expression_is_pasted_into_a_script(path: Path) -> None:
+    for job in load(path)["jobs"].values():
+        for step in job.get("steps", []):
+            assert "${{" not in str(step.get("run", "")), step.get("name")
+
+
+def test_canary_runs_daily_and_never_cancels() -> None:
+    canary = load(CANARY)
+    on = triggers(canary)
+    assert set(on) == {"schedule", "workflow_dispatch"}
+    assert on["schedule"] == [{"cron": "41 6 * * *"}]
+    assert canary["concurrency"]["cancel-in-progress"] is False
+    [job] = canary["jobs"].values()
+    assert job["if"] == "github.ref_name == github.event.repository.default_branch"
+    run = job["steps"][-1]["run"]
+    assert "release.py --canary --autopublish" in run and "--if-new" in run
