+def test_explicit_channel_beats_the_saved_one(box: Sandbox) -> None:
+    bare = make_origin(box, tags=("v0.1.0", "v0.2.0"))
+    checkout = _clone_existing(box, "v0.1.0")
+    _save_channel(box, checkout, "main")
