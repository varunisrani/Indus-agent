+    env_file.write_text("EXAMPLE_NAME=kept\n")
+    env_file.chmod(0o644)
+    code, _, out = _stage(box, "config")
+    assert code == 0, out
+    assert env_file.stat().st_mode & 0o777 == 0o600
+    assert env_file.read_text() == "EXAMPLE_NAME=kept\n"
