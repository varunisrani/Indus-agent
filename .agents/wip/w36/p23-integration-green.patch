new file mode 100644
index 0000000..6a02e9b
--- /dev/null
+++ b/src/indus/cli/update/apply.py
@@ -0,0 +1,491 @@
+"""Apply an update in the old process: snapshot, move, verify, rebuild, hand off (P23-18).
+
+Order (each step only after the one before succeeded; R04.24):
+
+1. snapshot — this profile's state through the backup code (``quick`` / ``full`` / ``off``); a
+   failure warns and is recorded, it never stops the update;
+2. stash — a dirty tree is stashed with untracked files under ``indus-update-autostash-<stamp>``;
+3. move — the checkout goes to exactly the target commit (``main``: the ``main`` branch is set to
+   it; releases: a detached checkout). A HEAD that would leave the history is kept on
+   ``refs/indus/update-backups/<stamp>`` first;
+4. syntax — the current interpreter compiles (never imports) the startup files of the new tree
+   into a temp dir; a failure puts the old commit back and exits 1 naming the file;
+5. venv — a relocatable ``.venv-next`` is built from the new lock (``uv sync --frozen``) and
+   proven by ``.venv-next/bin/python -m indus --version`` in a child; a failure removes it, puts
+   the old commit back and exits 1, the old venv untouched;
+6. swap — ``.venv`` → ``.venv-prev`` (the previous one removed first), ``.venv-next`` → ``.venv``;
+7. local edits go back on top of the new tree; a stash that does not apply stays in the stash list
+   and the run ends with exit 1 naming it (after the finish step, so the install is consistent);
+8. hand-off — a request file, then ``exec`` of ``<new venv python> -m indus update --finish``: the
+   old interpreter never runs a pulled module.
+
+Ctrl-C before the hand-off undoes the steps taken so far, in reverse, and exits 130.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import py_compile
+import shutil
+import subprocess
+import sys
+import tempfile
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Any, NoReturn
+
+from indus.cli.update import (
+    EXIT_INTERRUPTED,
+    REQUEST_SCHEMA,
+    Console,
+    Receipt,
+    UpdatePaths,
+    stamp_of,
+)
+from indus.cli.update.channels import ChannelChoice, Git, GitError, Target
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.versions import MAIN
+
+__all__ = [
+    "AUTOSTASH_PREFIX",
+    "BACKUP_REF_PREFIX",
+    "CRITICAL_FILES",
+    "ApplyHooks",
+    "ApplyRequest",
+    "apply_update",
+    "syntax_problem",
+    "venv_python",
+]
+
+AUTOSTASH_PREFIX = "indus-update-autostash-"
+BACKUP_REF_PREFIX = "refs/indus/update-backups/"
+CRITICAL_FILES: tuple[str, ...] = (
+    "src/indus/__init__.py",
+    "src/indus/__main__.py",
+    "src/indus/cli/__init__.py",
+    "src/indus/cli/entry.py",
+    "src/indus/cli/app.py",
+    "src/indus/cli/args.py",
+    "src/indus/cli/lazy.py",
+    "src/indus/cli/version.py",
+    "src/indus/cli/commands/update.py",
+    "src/indus/foundation/__init__.py",
+    "src/indus/foundation/bootstrap.py",
+    "src/indus/foundation/preparse.py",
+    "src/indus/foundation/home.py",
+    "src/indus/foundation/scope.py",
+    "src/indus/foundation/errors.py",
+    "src/indus/foundation/versions.py",
+)
+"""Every ``indus`` start imports these; with the update package (the finish step runs it) they
+are what the syntax check compiles."""
+_UPDATE_PACKAGE = "src/indus/cli/update"
+_VALIDATE_TIMEOUT_S = 120.0
+_UV_TIMEOUT_S = 1800.0
+
+type ChildRunner = Callable[..., subprocess.CompletedProcess[str]]
+
+
+def venv_python(venv: Path) -> Path:
+    if sys.platform == "win32":
+        return venv / "Scripts" / "python.exe"
+    return venv / "bin" / "python"
+
+
+def _default_exec(path: str, argv: Sequence[str], env: Mapping[str, str]) -> NoReturn:
+    sys.stdout.flush()
+    sys.stderr.flush()
+    os.execve(path, list(argv), dict(env))
+
+
+@dataclass
+class ApplyHooks:
+    """What the apply step needs from the outside world (tests replace each)."""
+
+    snapshot: Callable[[str], str]
+    """``mode`` (``quick``/``full``) → a description of what was saved; raises on failure."""
+    uv: str | None
+    """The ``uv`` executable, or None when there is none."""
+    run: ChildRunner = subprocess.run
+    execv: Callable[[str, Sequence[str], Mapping[str, str]], Any] = _default_exec
+
+
+@dataclass
+class ApplyRequest:
+    paths: UpdatePaths
+    profile_home: Path
+    choice: ChannelChoice
+    target: Target
+    env: Mapping[str, str]
+    now: Callable[[], datetime]
+    backup_mode: str = "quick"
+    backup_reason: str = ""
+    extras: Sequence[str] = ()
+    assume_yes: bool = False
+    no_gateway_restart: bool = False
+    finish_argv: Sequence[str] = field(default_factory=tuple[str, ...])
+    """Extra arguments passed through to ``--finish`` (``-y``, ``--no-gateway-restart``)."""
+
+
+class _Abort(Exception):
+    """A step failed; the message is what the person reads. The exit code is 1."""
+
+
+class _HandOffFailed(Exception):
+    """The update is in place but its finish step could not be started (exit 1)."""
+
+
+@dataclass
+class _Progress:
+    pre: str = ""
+    pre_branch: str | None = None
+    pre_main: str | None = None
+    stash: str | None = None
+    stash_label: str = ""
+    moved: bool = False
+    built: bool = False
+    swapped: bool = False
+    had_venv: bool = False
+
+
+def syntax_problem(tree: Path, files: Sequence[str] | None = None) -> tuple[str, str] | None:
+    """Compile the startup files of ``tree`` (into a temp dir, never ``__pycache__``) with the
+    running interpreter. ``(file, error)`` for the first failure (a missing file counts), else
+    None."""
+    names = list(CRITICAL_FILES if files is None else files)
+    package = tree / _UPDATE_PACKAGE
+    if files is None and package.is_dir():
+        names += sorted(p.relative_to(tree).as_posix() for p in package.glob("*.py"))
+    with tempfile.TemporaryDirectory(prefix="indus-syntax-") as scratch:
+        for index, name in enumerate(dict.fromkeys(names)):
+            source = tree / name
+            if not source.is_file():
+                return name, "the file is missing from the new release"
+            try:
+                py_compile.compile(
+                    str(source), cfile=str(Path(scratch) / f"{index}.pyc"), doraise=True
+                )
+            except py_compile.PyCompileError as exc:
+                return name, str(exc.msg).strip()
+            except (OSError, ValueError) as exc:
+                return name, f"could not read it: {exc}"
+    return None
+
+
+class _Applier:
+    def __init__(
+        self,
+        git: Git,
+        request: ApplyRequest,
+        hooks: ApplyHooks,
+        console: Console,
+        receipt: Receipt,
+    ) -> None:
+        self.git = git
+        self.req = request
+        self.hooks = hooks
+        self.out = console
+        self.receipt = receipt
+        self.p = _Progress()
+        self.stamp = stamp_of(request.now())
+
+    # -- steps -------------------------------------------------------------------------------------
+
+    def snapshot(self) -> None:
+        mode = self.req.backup_mode
+        if mode == "off":
+            reason = self.req.backup_reason or "updates.pre_update_backup is off"
+            self.receipt.phase("snapshot", "skipped", reason)
+            return
+        self.out.say(f"→ Saving a {mode} snapshot of this profile before the update...")
+        try:
+            saved = self.hooks.snapshot(mode)
+        except Exception as exc:  # a snapshot never stops an update
+            self.out.warn(f"⚠ Pre-update snapshot failed ({exc}); continuing without it.")
+            self.receipt.phase("snapshot", "failed", str(exc) or type(exc).__name__)
+            return
+        self.receipt.phase("snapshot", "ok", saved)
+
+    def stash(self) -> None:
+        if not self.git.dirty():
+            self.receipt.phase("stash", "skipped", "no local changes")
+            return
+        label = f"{AUTOSTASH_PREFIX}{self.stamp}"
+        self.git.run("stash", "push", "--include-untracked", "--message", label)
+        self.p.stash = self.git.out("rev-parse", "refs/stash")
+        self.p.stash_label = label
+        self.out.say(f"→ Local changes put aside as {label}")
+        self.receipt.phase("stash", "ok", label)
+
+    def move(self) -> None:
+        git, target = self.git, self.req.target
+        self.p.pre = git.head()
+        self.p.pre_branch = git.branch()
+        self.p.pre_main = git.resolve(f"refs/heads/{MAIN}")
+        if not git.is_ancestor(self.p.pre, target.commit):
+            ref = f"{BACKUP_REF_PREFIX}{self.stamp}"
+            git.run("update-ref", ref, self.p.pre)
+            self.out.say(f"→ Commits not in {target.label} are kept on {ref}")
+            self.receipt.phase("backup_ref", "ok", ref)
+        self.out.say(f"→ Moving the checkout to {target.label} ({target.commit[:10]})...")
+        self.p.moved = True
+        if target.channel == MAIN:
+            git.run("checkout", "--quiet", "-B", MAIN, target.commit)
+        else:
+            git.run("checkout", "--quiet", "--detach", target.commit)
+        landed = git.head()
+        if landed != target.commit:
+            raise _Abort(f"the checkout landed on {landed[:10]}, not {target.commit[:10]}")
+        self.receipt.phase("move", "ok", f"{self.p.pre[:10]} → {target.commit[:10]}")
+
+    def syntax(self) -> None:
+        problem = syntax_problem(self.req.paths.checkout)
+        if problem is None:
+            self.receipt.phase("syntax", "ok")
+            return
+        name, error = problem
+        self.receipt.phase("syntax", "failed", f"{name}: {error}")
+        raise _Abort(
+            f"{self.req.target.label} has a broken startup file, so it was not installed:\n"
+            f"  {name}\n    {error.splitlines()[0] if error else ''}"
+        )
+
+    def _child(self, argv: Sequence[str], *, env: Mapping[str, str], timeout: float) -> str:
+        """Run a child; return '' on success, else the tail of its output."""
+        try:
+            done = self.hooks.run(
+                list(argv),
+                cwd=str(self.req.paths.checkout),
+                env=dict(env),
+                timeout=timeout,
+                check=False,
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+            )
+        except subprocess.TimeoutExpired:
+            return f"{Path(argv[0]).name} did not finish within {timeout:g} s"
+        except OSError as exc:
+            return f"could not run {Path(argv[0]).name}: {exc}"
+        self.out.child_output(f"$ {' '.join(argv)}\n{done.stdout}{done.stderr}")
+        if done.returncode == 0:
+            return ""
+        lines = (done.stderr or done.stdout or "").strip().splitlines()
+        return "\n".join(lines[-5:]) or f"exit status {done.returncode}"
+
+    def _keeps_dev_group(self) -> bool:
+        venv = self.req.paths.venv
+        return any(venv.glob("lib/python*/site-packages/pytest-*.dist-info")) or any(
+            venv.glob("Lib/site-packages/pytest-*.dist-info")
+        )
+
+    def venv(self) -> None:
+        paths = self.req.paths
+        uv = self.hooks.uv
+        if uv is None:
+            self.receipt.phase("venv", "failed", "uv not found")
+            raise _Abort(
+                "uv was not found (on PATH or under <home>/tools), so no environment "
+                "could be built for the new code; the old one is kept."
+            )
+        shutil.rmtree(paths.venv_next, ignore_errors=True)
+        self.out.say("→ Building the new environment beside the current one...")
+        self.p.built = True
+        env = dict(self.req.env)
+        env["UV_PROJECT_ENVIRONMENT"] = str(paths.venv_next)
+        env.pop("VIRTUAL_ENV", None)
+        failed = self._child(
+            [uv, "venv", "--relocatable", "--quiet", str(paths.venv_next)],
+            env=env,
+            timeout=_UV_TIMEOUT_S,
+        )
+        if not failed:
+            sync = [uv, "sync", "--frozen", "--quiet"]
+            for extra in self.req.extras:
+                sync += ["--extra", extra]
+            if not self._keeps_dev_group():
+                sync.append("--no-dev")
+            failed = self._child(sync, env=env, timeout=_UV_TIMEOUT_S)
+        if not failed:
+            failed = self._child(
+                [str(venv_python(paths.venv_next)), "-m", "indus", "--version"],
+                env=self.req.env,
+                timeout=_VALIDATE_TIMEOUT_S,
+            )
+        if failed:
+            self.receipt.phase("venv", "failed", failed.splitlines()[-1])
+            raise _Abort(
+                "The new environment could not be built, so the update was rolled back and the "
+                f"current environment kept:\n  {failed.splitlines()[-1]}"
+            )
+        self.receipt.phase("venv", "ok", "built and checked")
+
+    def swap(self) -> None:
+        paths = self.req.paths
+        shutil.rmtree(paths.venv_prev, ignore_errors=True)
+        self.p.had_venv = paths.venv.exists()
+        if self.p.had_venv:
+            os.replace(paths.venv, paths.venv_prev)
+        try:
+            os.replace(paths.venv_next, paths.venv)
+        except OSError:
+            if self.p.had_venv:
+                os.replace(paths.venv_prev, paths.venv)
+            raise
+        self.p.swapped = True
+        self.p.built = False
+        self.receipt.phase("swap", "ok", ".venv-next → .venv (previous kept as .venv-prev)")
+
+    def reapply_stash(self) -> str | None:
+        """Put local edits back on the new tree. Returns the label when they would not apply."""
+        if self.p.stash is None:
+            return None
+        if self.git.ok("stash", "apply", self.p.stash):
+            self._drop_stash()
+            self.receipt.phase("restore_changes", "ok", self.p.stash_label)
+            return None
+        self.git.run("reset", "--quiet", "--hard", "HEAD", check=False)
+        label = self.p.stash_label
+        self.receipt.phase("restore_changes", "failed", f"kept in the stash as {label}")
+        self.p.stash = None
+        return label
+
+    def _drop_stash(self) -> None:
+        listed = self.git.run("stash", "list", "--format=%H", check=False).stdout.split()
+        if self.p.stash in listed:
+            self.git.run("stash", "drop", "--quiet", f"stash@{{{listed.index(self.p.stash)}}}")
+        self.p.stash = None
+
+    # -- undo --------------------------------------------------------------------------------------
+
+    def undo(self) -> None:
+        """Put back what the steps changed, newest first. Never raises."""
+        paths = self.req.paths
+        with contextlib.suppress(OSError):
+            if self.p.swapped:
+                shutil.rmtree(paths.venv_next, ignore_errors=True)
+                os.replace(paths.venv, paths.venv_next)
+                if self.p.had_venv:
+                    os.replace(paths.venv_prev, paths.venv)
+                self.p.swapped = False
+                self.p.built = True
+        if self.p.built:
+            shutil.rmtree(paths.venv_next, ignore_errors=True)
+            self.p.built = False
+        if self.p.moved:
+            self._restore_code()
+        if self.p.stash is not None:
+            if self.git.ok("stash", "apply", self.p.stash):
+                self._drop_stash()
+            else:
+                self.out.warn(
+                    f"⚠ Your local changes are kept in the stash as {self.p.stash_label} "
+                    "(git stash list; git stash apply)."
+                )
+
+    def _restore_code(self) -> None:
+        git, p = self.git, self.p
+        try:
+            if p.pre_branch == MAIN and p.pre_main is not None:
+                git.run("update-ref", f"refs/heads/{MAIN}", p.pre_main)
+            if p.pre_branch is not None:
+                git.run("checkout", "--quiet", "--force", p.pre_branch)
+            else:
+                git.run("checkout", "--quiet", "--force", "--detach", p.pre)
+            git.run("reset", "--quiet", "--hard", p.pre)
+            if p.pre_branch != MAIN:  # ``main`` was moved (or made) by the update: put it back
+                if p.pre_main is None:
+                    git.run("update-ref", "-d", f"refs/heads/{MAIN}", check=False)
+                else:
+                    git.run("update-ref", f"refs/heads/{MAIN}", p.pre_main, check=False)
+        except GitError as exc:
+            self.out.warn(
+                f"✗ Could not put the checkout back by itself ({exc.detail or exc}). "
+                f"Recover with: git -C {self.req.paths.checkout} reset --hard {p.pre}"
+            )
+            self.receipt.phase("rollback", "failed", p.pre)
+            return
+        p.moved = False
+        self.out.say(f"  ✓ Rolled back to {p.pre[:10]}; your install is unchanged.")
+        self.receipt.phase("rollback", "ok", p.pre[:10])
+
+    # -- hand-off ----------------------------------------------------------------------------------
+
+    def hand_off(self, stash_conflict: str | None) -> None:
+        req, paths = self.req, self.req.paths
+        target = req.target
+        self.receipt.phase("handoff", "ok", "exec --finish in the new code")
+        request: dict[str, Any] = {
+            "schema": REQUEST_SCHEMA,
+            "checkout": str(paths.checkout),
+            "root": str(paths.root),
+            "profile_home": str(req.profile_home),
+            "channel": req.choice.channel,
+            "channel_source": req.choice.source,
+            "from_commit": self.p.pre,
+            "to_commit": target.commit,
+            "to_version": None if target.version is None else str(target.version),
+            "assume_yes": req.assume_yes,
+            "no_gateway_restart": req.no_gateway_restart,
+            "stash_conflict": stash_conflict,
+            "receipt": self.receipt.to_json(),
+        }
+        paths.requests.mkdir(parents=True, exist_ok=True)
+        path = atomic_write_json(paths.requests / f"{self.stamp}.json", request)
+        python = str(venv_python(paths.venv))
+        argv = [python, "-m", "indus", "update", "--finish", str(path), *req.finish_argv]
+        self.out.say("→ Finishing on the new code...")
+        try:
+            self.hooks.execv(python, argv, dict(req.env))
+        except OSError as exc:  # the code and venv are in place; only the finish is missing
+            retry = f"{python} -m indus update --finish {path}"
+            self.receipt.owe("finish", f"could not start the new code: {exc}", retry=retry)
+            self.receipt.write(paths.receipts, finished=req.now(), outcome="finish_not_started")
+            raise _HandOffFailed(
+                f"Could not start the new code ({exc}). Finish with: {retry}"
+            ) from exc
+
+
+def apply_update(
+    git: Git,
+    request: ApplyRequest,
+    hooks: ApplyHooks,
+    console: Console,
+    receipt: Receipt,
+) -> int:
+    """Run the steps (see the module notes). Returns an exit code when it does not hand off;
+    after a successful hand-off it returns only when ``hooks.execv`` returns (tests)."""
+    step = _Applier(git, request, hooks, console, receipt)
+    receipt.from_commit = git.head()
+    receipt.to_commit = request.target.commit
+    receipt.to_version = "" if request.target.version is None else str(request.target.version)
+    try:
+        step.snapshot()
+        step.stash()
+        step.move()
+        step.syntax()
+        step.venv()
+        step.swap()
+        conflict = step.reapply_stash()
+    except KeyboardInterrupt:
+        console.warn("✗ Interrupted; putting everything back...")
+        step.undo()
+        receipt.phase("update", "interrupted")
+        receipt.write(request.paths.receipts, finished=request.now(), outcome="interrupted")
+        return EXIT_INTERRUPTED
+    except (_Abort, GitError, OSError) as exc:
+        detail = getattr(exc, "detail", "")
+        console.warn(f"✗ {exc}" + (f"\n  {detail}" if detail else ""))
+        step.undo()
+        receipt.write(request.paths.receipts, finished=request.now(), outcome="failed")
+        return 1
+    try:
+        step.hand_off(conflict)
+    except _HandOffFailed as exc:
+        console.warn(f"✗ {exc}")
+        return 1
+    return 0
diff --git a/src/indus/cli/update/channels.py b/src/indus/cli/update/channels.py
new file mode 100644
index 0000000..90089b7
--- /dev/null
+++ b/src/indus/cli/update/channels.py
@@ -0,0 +1,425 @@
+"""Where an update goes: channels, targets, the never-backwards rule and the plan (P23-17).
+
+Channels (words from ``indus.foundation.versions``):
+
+- ``stable``: the newest ``vX.Y.Z`` tag, checked out at its exact commit;
+- ``canary``: the newest ``vX.Y.Z-canary.<stamp>`` tag, or a newer stable when one exists (a
+  stable that a canary leads to sorts above it), so canary users are never stranded;
+- ``main``: the tip of ``origin/main``.
+
+The channel in force is, first match wins: ``--channel`` (one run), the install's saved choice
+``updates.installs.<id>.channel`` (``--set-channel``), then the default — ``stable`` for a clone
+of the official repository (``RELEASE_REPOSITORY``), ``main`` for a fork or mirror. Only the
+default is "no explicit choice": then a checkout whose HEAD is not an ancestor of the target is
+left where it is (``ahead``). An explicit choice may move back (``rollback``).
+
+Tags are read from the checkout's own ``origin`` (fetched first), never from our release host, so
+forks and mirrors work the same way. A target whose store schema (``SCHEMA_VERSION`` in its
+``src/indus/state/schema.py``) is older than any live store under the root is refused before
+anything moves: an older build cannot read a newer store.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import re
+import sqlite3
+import subprocess
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from datetime import datetime
+from pathlib import Path
+from typing import Any, Literal, cast
+
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.versions import (
+    CANARY,
+    CHANNELS,
+    MAIN,
+    RELEASE_REPOSITORY,
+    STABLE,
+    Version,
+    parse_tag,
+)
+
+__all__ = [
+    "INSTALLS_KEY",
+    "NETWORK_TIMEOUT_S",
+    "ChannelChoice",
+    "Decision",
+    "Git",
+    "GitError",
+    "Target",
+    "build_plan",
+    "choose_channel",
+    "current_version",
+    "decide",
+    "fetch",
+    "is_official",
+    "live_store_schema",
+    "release_tags",
+    "resolve_target",
+    "saved_channel",
+    "saved_extras",
+    "store_refusal",
+    "target_store_schema",
+    "write_check_cache",
+]
+
+INSTALLS_KEY = "updates.installs"
+"""Per-install settings: ``updates.installs.<id>.channel`` and ``.extras``."""
+NETWORK_TIMEOUT_S = 300.0
+_LOCAL_TIMEOUT_S = 120.0
+_SCHEMA_FILE = "src/indus/state/schema.py"
+_SCHEMA_LINE = re.compile(r"^SCHEMA_VERSION\s*=\s*(\d+)\s*$", re.MULTILINE)
+_STORE_NAME = "state.db"
+
+type Action = Literal["update", "rollback", "up_to_date", "ahead", "none"]
+
+
+class GitError(RuntimeError):
+    """A git command failed; ``detail`` is git's own last line."""
+
+    def __init__(self, message: str, detail: str = "") -> None:
+        super().__init__(message)
+        self.detail = detail
+
+
+type Runner = Callable[..., subprocess.CompletedProcess[str]]
+
+
+@dataclass
+class Git:
+    """git in one checkout. No prompts (an auth failure fails fast), C locale, bounded waits."""
+
+    root: Path
+    env: Mapping[str, str]
+    runner: Runner = subprocess.run
+    log: Callable[[str], None] | None = None
+
+    def _env(self) -> dict[str, str]:
+        env = dict(self.env)
+        env.update({"GIT_TERMINAL_PROMPT": "0", "LC_ALL": "C", "GIT_ASKPASS": ""})
+        return env
+
+    def run(
+        self, *args: str, check: bool = True, network: bool = False
+    ) -> subprocess.CompletedProcess[str]:
+        argv = ["git", *args]
+        try:
+            done = self.runner(
+                argv,
+                cwd=str(self.root),
+                env=self._env(),
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+                timeout=NETWORK_TIMEOUT_S if network else _LOCAL_TIMEOUT_S,
+                check=False,
+            )
+        except subprocess.TimeoutExpired as exc:
+            raise GitError(f"git {args[0]} timed out", str(exc)) from exc
+        except OSError as exc:
+            raise GitError(f"could not run git: {exc}") from exc
+        if self.log is not None:
+            self.log(f"$ {' '.join(argv)}\n{done.stdout}{done.stderr}")
+        if check and done.returncode != 0:
+            lines = (done.stderr or done.stdout or "").strip().splitlines()
+            raise GitError(f"git {args[0]} failed", lines[-1] if lines else "")
+        return done
+
+    def out(self, *args: str) -> str:
+        return self.run(*args).stdout.strip()
+
+    def ok(self, *args: str) -> bool:
+        return self.run(*args, check=False).returncode == 0
+
+    def head(self) -> str:
+        return self.out("rev-parse", "HEAD")
+
+    def resolve(self, ref: str) -> str | None:
+        done = self.run("rev-parse", "-q", "--verify", f"{ref}^{{commit}}", check=False)
+        sha = done.stdout.strip()
+        return sha if done.returncode == 0 and sha else None
+
+    def is_ancestor(self, older: str, newer: str) -> bool:
+        return self.ok("merge-base", "--is-ancestor", older, newer)
+
+    def dirty(self) -> bool:
+        return bool(self.out("status", "--porcelain", "--untracked-files=normal"))
+
+    def branch(self) -> str | None:
+        name = self.run("symbolic-ref", "-q", "--short", "HEAD", check=False).stdout.strip()
+        return name or None
+
+    def remote_url(self, name: str = "origin") -> str:
+        """The configured URL as written (``insteadOf`` rewrites not applied)."""
+        return self.run("config", "--get", f"remote.{name}.url", check=False).stdout.strip()
+
+    def show(self, commit: str, path: str) -> str | None:
+        done = self.run("show", f"{commit}:{path}", check=False)
+        return done.stdout if done.returncode == 0 else None
+
+
+# -- channels --------------------------------------------------------------------------------------
+
+
+_OFFICIAL = re.compile(
+    r"github\.com[:/]+" + re.escape(RELEASE_REPOSITORY) + r"(?:\.git)?/?$", re.IGNORECASE
+)
+
+
+def is_official(remote_url: str) -> bool:
+    """Is ``origin`` the official repository (https or ssh form, ``.git`` optional)?"""
+    return bool(_OFFICIAL.search(remote_url.strip()))
+
+
+@dataclass(frozen=True)
+class ChannelChoice:
+    channel: str
+    source: Literal["flag", "saved", "default"]
+
+    @property
+    def explicit(self) -> bool:
+        return self.source != "default"
+
+
+def choose_channel(flag: str | None, saved: object, *, official: bool) -> ChannelChoice:
+    """``--channel`` beats the saved choice, which beats the default (see the module notes)."""
+    if flag:
+        if flag not in CHANNELS:
+            raise ValueError(f"unknown channel {flag!r} (use {', '.join(CHANNELS)})")
+        return ChannelChoice(flag, "flag")
+    if isinstance(saved, str) and saved in CHANNELS:
+        return ChannelChoice(saved, "saved")
+    return ChannelChoice(STABLE if official else MAIN, "default")
+
+
+def _install_row(installs: object, iid: str) -> Mapping[str, object]:
+    """``updates.installs.<iid>`` as a mapping (empty when missing or malformed)."""
+    if not isinstance(installs, Mapping):
+        return {}
+    row = cast(Mapping[str, object], installs).get(iid)
+    return cast(Mapping[str, object], row) if isinstance(row, Mapping) else {}
+
+
+def saved_channel(installs: object, iid: str) -> str | None:
+    """``updates.installs.<iid>.channel`` from the ``updates.installs`` mapping."""
+    value = _install_row(installs, iid).get("channel")
+    return value if isinstance(value, str) and value in CHANNELS else None
+
+
+def saved_extras(installs: object, iid: str) -> list[str]:
+    """``updates.installs.<iid>.extras``: the optional extras this install was set up with."""
+    extras = _install_row(installs, iid).get("extras")
+    if not isinstance(extras, list):
+        return []
+    names = [str(x) for x in cast(list[object], extras) if isinstance(x, str)]
+    return [x for x in names if re.fullmatch(r"[a-z0-9-]+", x)]
+
+
+def fetch(git: Git) -> None:
+    """Fetch release tags and the main branch from ``origin`` (writes no file in the tree)."""
+    git.run(
+        "fetch",
+        "--quiet",
+        "--tags",
+        "origin",
+        f"+refs/heads/{MAIN}:refs/remotes/origin/{MAIN}",
+        network=True,
+    )
+
+
+def release_tags(git: Git) -> list[tuple[Version, str]]:
+    """Every well-formed release tag, oldest first (malformed tags are ignored)."""
+    found: list[tuple[Version, str]] = []
+    for name in git.out("tag", "--list", "v*").splitlines():
+        version = parse_tag(name.strip())
+        if version is not None:
+            found.append((version, name.strip()))
+    return sorted(found, key=lambda row: row[0].key)
+
+
+@dataclass(frozen=True)
+class Target:
+    channel: str
+    commit: str
+    version: Version | None = None
+    tag: str | None = None
+
+    @property
+    def label(self) -> str:
+        if self.version is not None:
+            return str(self.version)
+        return f"{MAIN}@{self.commit[:10]}"
+
+
+def resolve_target(git: Git, channel: str) -> Target | None:
+    """The commit ``channel`` points at now (after ``fetch``), or None when it has none yet."""
+    if channel == MAIN:
+        sha = git.resolve(f"refs/remotes/origin/{MAIN}")
+        return None if sha is None else Target(MAIN, sha)
+    tags = release_tags(git)
+    stables = [row for row in tags if not row[0].is_canary]
+    pool = stables if channel == STABLE else tags if channel == CANARY else []
+    if not pool:
+        return None
+    version, tag = pool[-1]
+    sha = git.resolve(f"refs/tags/{tag}")
+    if sha is None:
+        return None
+    return Target(channel, sha, version, tag)
+
+
+def current_version(git: Git, head: str) -> Version | None:
+    """The newest release tag on ``head`` itself, if any."""
+    on_head = [
+        version for version, tag in release_tags(git) if git.resolve(f"refs/tags/{tag}") == head
+    ]
+    return max(on_head, default=None)
+
+
+@dataclass(frozen=True)
+class Decision:
+    action: Action
+    head: str
+    target: Target | None
+    reason: str
+
+    @property
+    def moves(self) -> bool:
+        return self.action in ("update", "rollback")
+
+
+def decide(git: Git, choice: ChannelChoice, target: Target | None) -> Decision:
+    """What an update would do (see the never-backwards rule in the module notes)."""
+    head = git.head()
+    if target is None:
+        if choice.channel == MAIN:
+            reason = f"origin has no {MAIN} branch"
+        else:
+            reason = f"no {choice.channel} release has been published yet"
+        return Decision("none", head, None, reason)
+    if head == target.commit:
+        return Decision("up_to_date", head, target, f"already on {target.label}")
+    if git.is_ancestor(head, target.commit):
+        return Decision("update", head, target, f"{target.label} is newer")
+    if not choice.explicit:
+        return Decision(
+            "ahead",
+            head,
+            target,
+            f"this checkout is not behind {target.label}; it is left where it is",
+        )
+    if git.is_ancestor(target.commit, head):
+        return Decision("rollback", head, target, f"moving back to {target.label}")
+    return Decision("update", head, target, f"switching to {target.label} (history differs)")
+
+
+# -- store schema ----------------------------------------------------------------------------------
+
+
+def target_store_schema(git: Git, commit: str) -> int:
+    """``SCHEMA_VERSION`` of the store code at ``commit`` (1 when the file says nothing)."""
+    text = git.show(commit, _SCHEMA_FILE)
+    found = _SCHEMA_LINE.search(text or "")
+    return int(found.group(1)) if found else 1
+
+
+def _store_version(path: Path) -> int | None:
+    if not path.is_file():
+        return None
+    with contextlib.suppress(sqlite3.Error, ValueError):
+        conn = sqlite3.connect(f"{path.resolve().as_uri()}?mode=ro", uri=True, timeout=2.0)
+        try:
+            row = conn.execute("SELECT version FROM schema_version LIMIT 1").fetchone()
+        finally:
+            conn.close()
+        return None if row is None else int(row[0])
+    return None
+
+
+def live_store_schema(root: Path) -> int | None:
+    """The newest schema any store under ``root`` (default and named profiles) is at."""
+    stores = [root / _STORE_NAME, *sorted((root / "profiles").glob(f"*/{_STORE_NAME}"))]
+    found = [v for path in stores if (v := _store_version(path)) is not None]
+    return max(found, default=None)
+
+
+def store_refusal(git: Git, root: Path, target: Target) -> str | None:
+    """Why ``target`` must not be installed over the live stores, or None."""
+    live = live_store_schema(root)
+    if live is None:
+        return None
+    wanted = target_store_schema(git, target.commit)
+    if wanted >= live:
+        return None
+    return (
+        f"{target.label} reads store schema {wanted}, but your sessions are already stored at "
+        f"schema {live}; an older build cannot read them. Nothing was changed. To go back anyway, "
+        "restore a backup taken before the newer release (indus import)."
+    )
+
+
+# -- plan and check --------------------------------------------------------------------------------
+
+
+def build_plan(
+    *,
+    kind: str,
+    checkout: Path,
+    iid: str,
+    choice: ChannelChoice | None,
+    decision: Decision | None,
+    current: Version | None,
+    services: Sequence[Mapping[str, Any]],
+    refusal: str | None = None,
+) -> dict[str, Any]:
+    """The ``--plan`` JSON (schema 1)."""
+    target = decision.target if decision is not None else None
+    return {
+        "schema": 1,
+        "install_kind": kind,
+        "install_id": iid,
+        "install_dir": str(checkout),
+        "channel": None if choice is None else choice.channel,
+        "channel_source": None if choice is None else choice.source,
+        "action": "refused" if refusal else (decision.action if decision else "none"),
+        "reason": refusal or (decision.reason if decision else ""),
+        "from": {
+            "commit": decision.head if decision else None,
+            "version": None if current is None else str(current),
+        },
+        "to": None
+        if target is None
+        else {
+            "commit": target.commit,
+            "version": None if target.version is None else str(target.version),
+            "tag": target.tag,
+        },
+        "services": [dict(s) for s in services],
+    }
+
+
+def write_check_cache(
+    path: Path,
+    *,
+    decision: Decision,
+    channel: str,
+    notices: bool,
+    now: datetime,
+) -> None:
+    """What ``indus --version`` shows later (``cli.version`` reads it, stdlib only)."""
+    target = decision.target
+    data = {
+        "schema": 1,
+        "checked_at": now.isoformat(),
+        "channel": channel,
+        "available": decision.action == "update",
+        "target": None if target is None else target.label,
+        "notices": notices,
+    }
+    with contextlib.suppress(OSError):
+        path.parent.mkdir(parents=True, exist_ok=True)
+        atomic_write_json(path, data)
