+@pytest.mark.parametrize(
+    ("interpreter", "libc"),
+    [
+        ("/lib/ld-musl-x86_64.so.1", "musl"),
+        ("/lib/ld-musl-aarch64.so.1", "musl"),
+        ("/lib64/ld-linux-x86-64.so.2", "glibc"),
+        ("/lib/ld-linux-aarch64.so.1", "glibc"),
