+# ins_frame OK STAGE SKIPPED REASON: the result frame of one stage (P20-09 contract).
+ins_frame() {
+    local frame
+    frame="{\"ok\":$1,\"stage\":$(ins_json_string "$2"),\"skipped\":$3"
+    if [ -n "${4:-}" ]; then frame="$frame,\"reason\":$(ins_json_string "$4")"; fi
