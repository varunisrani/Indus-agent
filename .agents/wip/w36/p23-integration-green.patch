+            129) INS_SIGNAL="${INS_SIGNAL:-HUP}" ;;
+            130) INS_SIGNAL="${INS_SIGNAL:-INT}" ;;
+            143) INS_SIGNAL="${INS_SIGNAL:-TERM}" ;;
+        esac
