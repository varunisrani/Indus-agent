+        exit "$rc"
+    done
+    ins_receipt success
+    [ -z "$INS_RUN_DIR" ] || rm -rf "$INS_RUN_DIR"
+    if [ -n "$INS_SIGNAL" ]; then ins_die_interrupted complete; fi
+    trap - INT TERM HUP
