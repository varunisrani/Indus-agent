+# Indus Agent on Linux with Docker Compose (P23-11): the gateway and the dashboard from one image.
+#
+#   INDUS_UID="$(id -u)" INDUS_GID="$(id -g)" docker compose -f docker/compose.yaml up -d
+#
+# Both services share your ~/.indus folder (INDUS_DATA_DIR overrides it), mounted at /opt/data.
+# INDUS_UID / INDUS_GID give the container's `indus` user your ids, so the files it writes stay
+# yours. Host networking: the dashboard listens on 127.0.0.1:9119 of this machine only, which needs
+# no login; reach it from elsewhere through an SSH tunnel (`ssh -L 9119:127.0.0.1:9119 host`).
+# INDUS_IMAGE picks another image (a local build, a pinned digest).
+
+name: indus
+
+x-indus: &indus
+  image: ${INDUS_IMAGE:-ghcr.io/indusagi/indus-agent:stable}
+  restart: unless-stopped
+  network_mode: host
+  volumes:
+    - ${INDUS_DATA_DIR:-~/.indus}:/opt/data
+  environment:
+    INDUS_UID: ${INDUS_UID:-10000}
+    INDUS_GID: ${INDUS_GID:-10000}
+
+services:
+  gateway:
+    <<: *indus
+    command: ["gateway", "run"]
+
+  dashboard:
+    <<: *indus
+    depends_on:
+      - gateway
+    command: ["dashboard", "--host", "127.0.0.1", "--no-open"]
diff --git a/docker/entrypoint.sh b/docker/entrypoint.sh
new file mode 100755
index 0000000..20d6db3
--- /dev/null
+++ b/docker/entrypoint.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+# Container entry point (P23-10).
+#
+# As PID 1 it hands the container to s6-overlay's /init with docker/main-wrapper.sh as the main
+# program: /init runs the indus-prepare oneshot (docker/stage2.sh) and the enabled services, then
+# the wrapper with the container's arguments; the container ends when the wrapper's program ends.
+#
+# When something else is PID 1 (`docker run --init`, a platform's own init), /init cannot run, so
+# this script runs stage-2 itself and then the wrapper: the command still works, the supervised
+# gateway/dashboard services do not.
+#
+# Test seams (never set in the image): _INDUS_IMAGE_ROOT prefixes the fixed image paths and
+# _INDUS_ENTRY_PID stands in for this shell's pid.
+set -eu
+
+image_root="${_INDUS_IMAGE_ROOT:-}"
+docker_dir="$image_root/opt/indus/docker"
+
+# The wrapper returns here before running the command (the `docker run -w` directory).
+INDUS_START_DIR="${INDUS_START_DIR:-$PWD}"
+export INDUS_START_DIR
+
+if [ "${_INDUS_ENTRY_PID:-$$}" = 1 ]; then
+    # An interactive command (`docker run -it IMAGE chat`) owns the terminal: send the services'
+    # output to s6's own log instead of across the screen, unless the user chose otherwise.
+    if [ -t 0 ] && [ -t 1 ]; then
+        S6_LOGGING="${S6_LOGGING:-2}"
+        S6_CMD_USE_TERMINAL="${S6_CMD_USE_TERMINAL:-1}"
+        export S6_LOGGING S6_CMD_USE_TERMINAL
+    fi
+    exec "$image_root/init" "$docker_dir/main-wrapper.sh" "$@"
+fi
+
+echo "indus: the container's init is not this image's (PID 1 is another program);" \
+    "starting without the supervisor: the gateway and dashboard services are off," \
+    "the command still runs" >&2
+PATH="$image_root/command:$PATH"
+export PATH
+"$docker_dir/stage2.sh"
+exec "$docker_dir/main-wrapper.sh" "$@"
diff --git a/docker/main-wrapper.sh b/docker/main-wrapper.sh
new file mode 100755
index 0000000..e09fdef
--- /dev/null
+++ b/docker/main-wrapper.sh
@@ -0,0 +1,53 @@
+#!/bin/sh
+# The container's main program (P23-10): decides what the container's arguments mean and runs it
+# as the `indus` user.
+#
+#   (no arguments)            indus
+#   -x ... / --flag ...       indus -x ...   a leading dash is always an indus option, never a
+#                                            program to look up (`-p work gateway run`)
+#   PROGRAM ...               PROGRAM ...    when PROGRAM is an executable on PATH (bash, sleep)
+#   anything else             indus ARGS     (`gateway run`, `chat`, `dashboard ...`)
+#
+# Root drops to `indus` through s6-setuidgid; the `indus` user itself runs directly; any other
+# user (a `docker run --user` start) is refused by stage-2's check (R10.25).
+#
+# Test seam: _INDUS_IMAGE_ROOT prefixes the fixed image paths (never set in the image).
+set -eu
+
+image_root="${_INDUS_IMAGE_ROOT:-}"
+"$image_root/opt/indus/docker/stage2.sh" --check-user
+
+data="${INDUS_HOME:-/opt/data}"
+INDUS_HOME="$data"
+HOME="$data"
+export INDUS_HOME HOME
+
+start="${INDUS_START_DIR:-}"
+if [ -n "$start" ] && [ -d "$start" ]; then
+    cd "$start"
+elif [ -d "$data" ]; then
+    cd "$data"
+fi
+
+run_as_indus() {
+    if [ "$(id -u)" = 0 ]; then
+        exec s6-setuidgid indus "$@"
+    fi
+    exec "$@"
+}
+
+if [ "$#" -eq 0 ]; then
+    run_as_indus indus
+fi
+
+case "$1" in
+    -*) run_as_indus indus "$@" ;;
+esac
+
+# Only a program found on PATH counts (a path in the answer), never a shell builtin or function.
+found="$(command -v "$1" 2>/dev/null || true)"
+case "$found" in
+    */*) run_as_indus "$@" ;;
+esac
+
+run_as_indus indus "$@"
