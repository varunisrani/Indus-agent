+def test_a_release_never_moves_a_checkout_backwards(box: Sandbox) -> None:
+    make_origin(box, tags=("v0.1.0",))
+    checkout = _clone_existing(box)  # main's tip, ahead of v0.1.0
+    before = _head(box, checkout)
