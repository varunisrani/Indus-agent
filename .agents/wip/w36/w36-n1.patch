@@ -0,0 +1,123 @@
+# Task: NixOS and home-manager modules (P23-14) Phase: 23 Owner: wave-36 builder N1
+
+Read (reference @ `ab3fe9dffb0a89d534cb795e2a2940e5f6542056`): `nix/nixosModules.nix` (option
+declarations and the assertion list only), `nix/moduleCommon.nix` (option declarations and their
+descriptions). Closed before writing.
+Evidence: none (packaging task).
+
+What it does (own words): a NixOS host runs the Indus gateway as a service declared in its
+configuration; a home-manager user gets `indus` on PATH, a declared config and, if asked, the
+gateway as a per-user service. The configuration is declarative: the module writes `config.yaml`
+from a Nix attribute set and marks the home as managed (`<home>/.managed`), so `indus config set`,
+`indus setup` and the dashboard's config writes refuse with "this installation is managed"
+(already built in P01/P07/P18). Secrets never enter the Nix store: they come from runtime env
+files (sops-nix, agenix) that systemd reads as root before dropping privileges.
+
+Inputs → outputs:
+- `nix/module-common.nix` (`{ lib, defaultPackage }` → shared `options` + helpers): `enable`,
+  `package`, `workingDirectory` (written as `terminal.cwd`), `configFile` (a whole `config.yaml`,
+  used verbatim), `settings` (attribute set, deep-merged across modules, rendered to YAML),
+  `environmentFiles` (runtime paths as strings, never store paths), `environment` (non-secret),
+  `extraPackages` (on the service PATH), `extraPythonPackages` (on `PYTHONPATH` so the
+  `indus.plugins` entry points of extra packages are found), `mcpServers` (typed entries rendered
+  under `mcp_servers.<name>`), `extraArgs` (after `indus gateway run`), `restart` and
+  `restartSec`; read-only `renderedConfig` (what lands in `config.yaml`, inspected by the checks).
+- `nix/render.nix` (builtins only, testable with `nix-instantiate --eval`): render one MCP server
+  (drop unset fields, keep the free-form `extraConfig` keys), the full config (`settings` + the
+  config stamp + `terminal.cwd` + rendered `mcp_servers`, declared servers win by name), and the
+  problem lists the assertions report.
+- `nix/nixos-module.nix` (`services.indus-agent`): `user`/`group` (`indus-agent`), `createUser`,
+  `stateDir` (`/var/lib/indus-agent`, the `INDUS_HOME`), `addToSystemPackages`, `native.enable`
+  (default: on unless container mode), `container.{enable, backend (docker|podman), image,
+  extraOptions, extraVolumes}`. A oneshot `indus-agent-setup` unit writes `config.yaml` and the
+  managed marker before the gateway starts. Native: a hardened systemd unit
+  `indus-agent.service` running `indus gateway run`, `EnvironmentFile=` for secrets, the service
+  user lingers (so it has a user manager for per-user units and timers). Container: the same
+  gateway through `virtualisation.oci-containers` (host network, `stateDir` at `/opt/data`, the
+  image's own UID/GID remap from `INDUS_UID`/`INDUS_GID`).
+- `nix/home-manager-module.nix` (`programs.indus-agent`): `home` (`~/.indus`), `installPackage`,
+  `gateway.enable`; config and marker written by an activation step only when `settings`,
+  `mcpServers` or `configFile` are set (otherwise the home stays user-managed); the gateway as a
+  systemd user service on Linux and a launchd agent on macOS.
+- `nix/module-checks.nix`: evaluation cases under `checks.<linux system>`: native default
+  evaluates; container + native refused; container without an image refused; `configFile` with
+  `settings` refused; a server with both `command` and `url` refused; settings rendered (with the
+  stamp and `terminal.cwd`); MCP entries rendered; the home-manager module renders the same
+  config and declares the user service.
+
+Files: `nix/module-common.nix`, `nix/render.nix`, `nix/nixos-module.nix`,
+`nix/home-manager-module.nix`, `nix/module-checks.nix`, tests in
+`tests/unit/packaging/test_nix_files.py` (shared with P23-13), this note.
+
+Edge cases / failure modes:
+- both modes on → assertion "native and container mode are both enabled; pick one";
+  neither on while enabled → assertion (nothing would run);
+- container mode with `extraPackages`/`extraPythonPackages` → a warning (the image has its own
+  environment);
+- `configFile` and non-empty `settings`/`mcpServers` together → assertion (one source of truth);
+- an MCP server needs exactly one of `command` (stdio) or `url` (http/sse); `transport` only with
+  `url`;
+- env files are strings, so a secret is never copied into the world-readable store; `environment`
+  is documented as non-secret;
+- the home is owned by the service user, mode 0700 (tmpfiles); config written atomically (temp +
+  rename) so a crash never leaves half a file;
+- the native unit's PATH starts with bash, coreutils and git (what the agent's terminal tools
+  expect on any host), then `extraPackages`;
+- home-manager: a `.managed` marker written while settings were declared stays after the user
+  removes them (the module cannot tell its marker from one an administrator wrote); delete it by
+  hand;
+- home-manager on macOS: no `EnvironmentFile=`, so the launchd agent runs a small wrapper that
+  loads the env files (`set -a; . file`) and then execs the gateway.
+
+Our design differences / decisions:
+- Our names: `services.indus-agent` / `programs.indus-agent`, user `indus-agent`, home
+  `/var/lib/indus-agent`.
+- The module owns `config.yaml` outright and marks the home managed, instead of merging into a file
+  that runtime tools also edit: our config writer already refuses managed homes, so a merge would
+  only hide edits that are overwritten at the next start.
+- Secrets reach the process through systemd `EnvironmentFile=` (native) or the container's env
+  files, not by rewriting `<home>/.env`.
+- Two explicit mode switches (`native.enable`, `container.enable`) with an assertion, rather than
+  an enum, so a host that turns container mode on keeps working and a contradictory config is a
+  clear evaluation error.
+- No dashboard/backend service, documents, plugins-by-directory, OAuth seeding or host-user
+  passthrough options in 1.0 (see "Not taken").
+
+Tests we will write:
+- every `.nix` file parses; `render.nix` evaluated with `nix-instantiate` (skipped without Nix):
+  settings rendered with stamp and cwd, MCP entries rendered without unset fields, problem lists
+  for each assertion case;
+- every typed MCP field the module declares exists on `indus.mcp.config.McpServer`;
+- shared option names declared once in `module-common.nix` and used by both modules;
+- `nix/module-checks.nix` names one check per assertion case.
+
+## Decisions for the lead
+- `container.image` has no default: the GHCR owner is open (D-16.690 / P25-20). When it is fixed,
+  set the default from the same single constant the installers read (a generated value in
+  `nix/pins.json` is the place).
+- Rendering uses `builtins.toJSON` (JSON is YAML 1.2, which ruamel.yaml reads) so the renderer has
+  no nixpkgs dependency and is testable offline.
+- Lingering is on by default in native mode (`users.users.<user>.linger`), off in container mode.
+
+Compare checklist (filled after the rewrite; reopened the option declarations of
+`nix/nixosModules.nix` and `nix/moduleCommon.nix`):
+- [x] shared options present (package, working dir, config file, settings, env files, environment,
+  extra packages, extra python packages, MCP servers, restart policy) (test:
+  `test_nix_files.py::test_common_options_declared`)
+- [x] MCP server fields match our schema (test: `::test_mcp_fields_exist_in_schema`)
+- [x] container + native refused (test: `::test_render_problems_for_modes`; check
+  `module-container-and-native-refused`)
+- [x] settings and MCP entries rendered (tests: `::test_render_config`, `::test_render_mcp_server`)
+- [x] lingering only in native mode (check `module-native-default`)
+- Deliberate differences: the reference deep-merges declared keys into an on-disk file that runtime
+  tools edit, seeds `.env` from env files during activation, and has a dashboard/backend service
+  with network wait logic, document trees, directory plugins and OAuth file seeding; we own the
+  file and mark the home managed, pass secrets through systemd, and leave the rest out of 1.0.
+- Not taken: documents/home files, directory plugins, auth file seeding, container host-user
+  passthrough, backend (dashboard) unit — candidates for a later wave if users ask.
+
+## Status
+
+Partial (2026-10-21): modules, renderer and evaluation checks written; renderer evaluated offline
+with `nix-instantiate`; the module evaluation checks (ACC-S4-2) need nixpkgs and home-manager and
+run in the Nix lane.
diff --git a/flake.nix b/flake.nix
new file mode 100644
index 0000000..a6cd46b
--- /dev/null
+++ b/flake.nix
@@ -0,0 +1,61 @@
+{
+  description = "Indus Agent: a self-improving AI agent";
+
+  # Every input follows our nixpkgs, so one nixpkgs serves the packages, the modules and the
+  # checks. flake.lock is written by the Nix CI lane (`nix flake lock`).
+  inputs = {
+    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
+    flake-parts = {
+      url = "github:hercules-ci/flake-parts";
+      inputs.nixpkgs-lib.follows = "nixpkgs";
+    };
+    pyproject-nix = {
+      url = "github:pyproject-nix/pyproject.nix";
+      inputs.nixpkgs.follows = "nixpkgs";
+    };
+    uv2nix = {
+      url = "github:pyproject-nix/uv2nix";
+      inputs.nixpkgs.follows = "nixpkgs";
+      inputs.pyproject-nix.follows = "pyproject-nix";
+    };
+    pyproject-build-systems = {
+      url = "github:pyproject-nix/build-system-pkgs";
+      inputs.nixpkgs.follows = "nixpkgs";
+      inputs.pyproject-nix.follows = "pyproject-nix";
+      inputs.uv2nix.follows = "uv2nix";
+    };
+    # Only the module checks evaluate against it; users import the module into their own
+    # home-manager.
+    home-manager = {
+      url = "github:nix-community/home-manager";
+      inputs.nixpkgs.follows = "nixpkgs";
+    };
+  };
+
+  outputs =
+    inputs@{ self, flake-parts, ... }:
+    let
+      packagesFor = system: self.packages.${system} or { };
+    in
+    flake-parts.lib.mkFlake { inherit inputs; } {
+      systems = [
+        "x86_64-linux"
+        "aarch64-linux"
+        "aarch64-darwin"
+      ];
+
+      imports = [
+        ./nix/packages.nix
+        ./nix/checks.nix
+        ./nix/module-checks.nix
+      ];
+
+      flake = {
+        overlays.default = final: _prev: {
+          indus-agent = (packagesFor final.stdenv.hostPlatform.system).default;
+        };
+        nixosModules.default = import ./nix/nixos-module.nix { inherit packagesFor; };
+        homeManagerModules.default = import ./nix/home-manager-module.nix { inherit packagesFor; };
+      };
+    };
+}
diff --git a/nix/checks.nix b/nix/checks.nix
new file mode 100644
index 0000000..ea62cea
--- /dev/null
+++ b/nix/checks.nix
@@ -0,0 +1,57 @@
+# flake-parts module: `nix flake check` for the packages (P23-13). The module evaluation cases
+# live in nix/module-checks.nix.
+{ ... }:
+{
+  perSystem =
+    {
+      pkgs,
+      lib,
+      self',
+      ...
+    }:
+    let
+      pyproject = builtins.fromTOML (builtins.readFile ../pyproject.toml);
+      version = pyproject.project.version;
+      declaredExtras = builtins.attrNames (pyproject.project.optional-dependencies or { });
+      variants = import ./variants.nix;
+      unknownExtras = lib.subtractLists declaredExtras (
+        lib.unique (lib.concatLists (builtins.attrValues variants))
+      );
+
+      pass = name: pkgs.runCommand "indus-agent-check-${name}" { } "touch $out";
+    in
+    {
+      checks =
+        # Every package builds.
+        lib.mapAttrs' (name: drv: lib.nameValuePair "build-${name}" drv) self'.packages
+        // {
+          # The devshell's inputs build (a shell derivation itself is not meant to be built).
+          build-devshell = self'.devShells.default.inputDerivation;
+
+          # A variant naming an extra pyproject.toml does not declare fails evaluation here,
+          # with the names, instead of deep inside uv2nix.
+          variant-extras =
+            if unknownExtras == [ ] then
+              pass "variant-extras"
+            else
+              throw "nix/variants.nix names extras pyproject.toml does not declare: ${toString unknownExtras}";
+
+          # `indus --version` runs from the store and knows it is a Nix install (so the in-app
+          # updater refuses it and points at Nix).
+          version =
+            pkgs.runCommand "indus-agent-check-version"
+              {
+                nativeBuildInputs = [ self'.packages.default ];
+              }
+              ''
+                export HOME="$TMPDIR/home" INDUS_HOME="$TMPDIR/indus-home"
+                mkdir -p "$HOME"
+                indus --version > version.txt
+                cat version.txt
+                grep -F "Indus Agent ${version}" version.txt
+                grep -F "Install method: nix" version.txt
+                touch $out
+              '';
+        };
+    };
+}
diff --git a/nix/home-manager-module.nix b/nix/home-manager-module.nix
new file mode 100644
index 0000000..676a883
--- /dev/null
+++ b/nix/home-manager-module.nix
@@ -0,0 +1,141 @@
+# home-manager module: programs.indus-agent (P23-14).
+#
+# Puts `indus` on the user's PATH and, when settings, MCP servers or a config file are declared,
+# writes `<home>/config.yaml` and marks the home managed at activation. `gateway.enable` runs the
+# gateway as a per-user service: a systemd user unit on Linux, a launchd agent on macOS.
+#
+#   programs.indus-agent = {
+#     enable = true;
+#     settings.model.default = "provider/model-name";
+#     gateway.enable = true;
+#   };
+{ packagesFor }:
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  inherit (lib) mkOption types literalExpression;
+
+  optionPath = "programs.indus-agent";
+  cfg = config.programs.indus-agent;
+  system = pkgs.stdenv.hostPlatform.system;
+
+  common = import ./module-common.nix {
+    inherit lib pkgs;
+    defaultPackage =
+      (packagesFor system).default
+        or (throw "${optionPath}: this flake has no package for ${system}; set ${optionPath}.package");
+  };
+
+  defaultHome = "${config.home.homeDirectory}/.indus";
+  home = cfg.home;
+  workingDirectory = if cfg.workingDirectory != null then cfg.workingDirectory else home;
+  declarative = cfg.configFile != null || cfg.settings != { } || cfg.mcpServers != { };
+
+  environment = common.serviceEnvironment {
+    inherit cfg home;
+    managed = declarative;
+  };
+
+  # The gateway's entry: extra packages first on PATH, the env files loaded where the service
+  # manager cannot (launchd has no EnvironmentFile), then the gateway itself.
+  mkLauncher =
+    { loadEnvFiles }:
+    pkgs.writeShellScript "indus-agent-gateway" ''
+      set -eu
+      ${lib.optionalString (cfg.extraPackages != [ ]) ''
+        PATH=${lib.escapeShellArg (lib.makeBinPath cfg.extraPackages)}''${PATH:+:$PATH}
+        export PATH
+      ''}
+      ${lib.optionalString loadEnvFiles (
+        lib.concatMapStringsSep "\n" (file: ''
+          set -a
+          . ${lib.escapeShellArg file}
+          set +a
+        '') cfg.environmentFiles
+      )}
+      exec ${lib.escapeShellArgs (common.gatewayCommand cfg)}
+    '';
+in
+{
+  options.programs.indus-agent = common.options // {
+    home = mkOption {
+      type = types.str;
+      default = defaultHome;
+      defaultText = literalExpression ''"''${config.home.homeDirectory}/.indus"'';
+      description = "The agent's home (`INDUS_HOME`).";
+    };
+
+    installPackage = mkOption {
+      type = types.bool;
+      default = true;
+      description = "Put `indus` on the user's PATH (home.packages).";
+    };
+
+    gateway.enable = lib.mkEnableOption "the gateway as a per-user service (systemd on Linux, launchd on macOS)";
+  };
+
+  config = lib.mkIf cfg.enable (
+    lib.mkMerge [
+      {
+        assertions = common.assertionsFor { inherit cfg optionPath; };
+
+        programs.indus-agent.renderedConfig = common.renderConfig cfg;
+
+        home.packages = lib.mkIf cfg.installPackage [ cfg.package ];
+
+        home.sessionVariables = lib.mkIf (home != defaultHome) { INDUS_HOME = home; };
+
+        # The home (and its logs folder, where launchd writes) exists before any service starts.
+        home.activation.indusAgentHome = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
+          run ${pkgs.coreutils}/bin/install -d -m 0700 ${lib.escapeShellArg home} ${lib.escapeShellArg "${home}/logs"}
+        '';
+
+        home.activation.indusAgentConfig = lib.mkIf declarative (
+          lib.hm.dag.entryAfter [ "indusAgentHome" ] (
+            common.installConfigScript {
+              inherit cfg home;
+              run = "run";
+            }
+          )
+        );
+      }
+
+      (lib.mkIf (cfg.gateway.enable && pkgs.stdenv.hostPlatform.isLinux) {
+        systemd.user.services.indus-agent = {
+          Unit = {
+            Description = "Indus Agent gateway";
+            After = [ "network-online.target" ];
+          };
+          Service = {
+            ExecStart = "${mkLauncher { loadEnvFiles = false; }}";
+            Environment = lib.mapAttrsToList (name: value: "${name}=${value}") environment;
+            EnvironmentFile = cfg.environmentFiles;
+            WorkingDirectory = workingDirectory;
+            Restart = cfg.restart;
+            RestartSec = cfg.restartSec;
+          };
+          Install.WantedBy = [ "default.target" ];
+        };
+      })
+
+      (lib.mkIf (cfg.gateway.enable && pkgs.stdenv.hostPlatform.isDarwin) {
+        launchd.agents.indus-agent = {
+          enable = true;
+          config = {
+            ProgramArguments = [ "${mkLauncher { loadEnvFiles = true; }}" ];
+            EnvironmentVariables = environment;
+            WorkingDirectory = workingDirectory;
+            RunAtLoad = true;
+            KeepAlive = true;
+            StandardOutPath = "${home}/logs/gateway.launchd.log";
+            StandardErrorPath = "${home}/logs/gateway.launchd.log";
+          };
+        };
+      })
+    ]
+  );
+}
diff --git a/nix/module-checks.nix b/nix/module-checks.nix
new file mode 100644
index 0000000..3d9c786
--- /dev/null
+++ b/nix/module-checks.nix
@@ -0,0 +1,206 @@
+# flake-parts module: evaluation cases for the NixOS and home-manager modules (P23-14).
+#
+# Each case evaluates a small configuration and either yields a trivial derivation or fails
+# `nix flake check` with the reason. Nothing is built: the modules get a stub package. Linux only
+# (the NixOS module is Linux-only; the home-manager cases use the Linux service path).
+{ inputs, self, ... }:
+{
+  perSystem =
+    {
+      pkgs,
+      lib,
+      system,
+      ...
+    }:
+    let
+      pins = lib.importJSON ./pins.json;
+      stub = pkgs.writeShellScriptBin "indus" "exit 0";
+      image = "registry.invalid/indus-agent:check";
+
+      evalNixos =
+        settings:
+        (inputs.nixpkgs.lib.nixosSystem {
+          inherit system;
+          modules = [
+            self.nixosModules.default
+            {
+              boot.isContainer = true;
+              system.stateVersion = "25.11";
+              services.indus-agent = {
+                enable = true;
+                package = stub;
+              };
+            }
+            { services.indus-agent = settings; }
+          ];
+        }).config;
+
+      evalHome =
+        settings:
+        (inputs.home-manager.lib.homeManagerConfiguration {
+          inherit pkgs;
+          modules = [
+            self.homeManagerModules.default
+            {
+              home.username = "tester";
+              home.homeDirectory = "/home/tester";
+              home.stateVersion = "25.11";
+              programs.indus-agent = {
+                enable = true;
+                package = stub;
+              };
+            }
+            { programs.indus-agent = settings; }
+          ];
+        }).config;
+
+      # Our failed assertion messages (other modules' assertions are not ours to judge).
+      ours =
+        config:
+        map (a: a.message) (
+          builtins.filter (a: !a.assertion && lib.hasInfix "indus-agent" a.message) config.assertions
+        );
+
+      expect =
+        name: ok: detail:
+        if ok then
+          pkgs.runCommand "indus-agent-module-${name}" { } "touch $out"
+        else
+          throw "module check ${name} failed: ${detail}";
+
+      refused =
+        name: config: needle:
+        let
+          messages = ours config;
+        in
+        expect name (builtins.any (lib.hasInfix needle) messages)
+          "expected an assertion containing '${needle}', got: ${builtins.toJSON messages}";
+
+      native = evalNixos { workingDirectory = "/srv/indus"; };
+      nativeUnit = native.systemd.services.indus-agent;
+
+      containerOnly = evalNixos {
+        container = {
+          enable = true;
+          image = image;
+        };
+      };
+
+      rendered = evalNixos {
+        workingDirectory = "/srv/indus";
+        settings = {
+          model.default = "provider/model-name";
+          terminal.backend = "local";
+        };
+        mcpServers = {
+          files = {
+            command = "mcp-files";
+            args = [
+              "--root"
+              "/srv/shared"
+            ];
+          };
+          tracker = {
+            url = "https://mcp.example.invalid/mcp";
+            transport = "http";
+            auth = "oauth";
+            extraConfig.timeout = 30;
+          };
+        };
+      };
+      renderedConfig = rendered.services.indus-agent.renderedConfig;
+
+      home = evalHome {
+        gateway.enable = true;
+        settings.model.default = "provider/model-name";
+        mcpServers.files.command = "mcp-files";
+      };
+    in
+    {
+      checks = lib.optionalAttrs (lib.hasSuffix "-linux" system) {
+        module-native-default = expect "native-default" (
+          ours native == [ ]
+          && lib.hasInfix "gateway run" nativeUnit.serviceConfig.ExecStart
+          && nativeUnit.environment.INDUS_MANAGED == "1"
+          && native.users.users.indus-agent.linger
+          && !(native.virtualisation.oci-containers.containers ? indus-agent)
+        ) "native mode: ${builtins.toJSON (ours native)}";
+
+        module-container-mode = expect "container-mode" (
+          ours containerOnly == [ ]
+          && containerOnly.virtualisation.oci-containers.containers.indus-agent.cmd == [
+            "gateway"
+            "run"
+          ]
+          && !(containerOnly.systemd.services ? indus-agent)
+          && !containerOnly.users.users.indus-agent.linger
+        ) "container mode: ${builtins.toJSON (ours containerOnly)}";
+
+        module-container-and-native-refused = refused "container-and-native-refused" (evalNixos {
+          native.enable = true;
+          container = {
+            enable = true;
+            image = image;
+          };
+        }) "both enabled";
+
+        module-neither-mode-refused = refused "neither-mode-refused" (evalNixos {
+          native.enable = false;
+        }) "nothing would run";
+
+        module-container-needs-image = refused "container-needs-image" (evalNixos {
+          container.enable = true;
+        }) "needs container.image";
+
+        module-config-file-and-settings-refused =
+          refused "config-file-and-settings-refused"
+            (evalNixos {
+              configFile = pkgs.writeText "config.yaml" "{}";
+              settings.model.default = "provider/model-name";
+            })
+            "do not also set settings";
+
+        module-mcp-command-and-url-refused = refused "mcp-command-and-url-refused" (evalNixos {
+          mcpServers.both = {
+            command = "mcp-files";
+            url = "https://mcp.example.invalid/mcp";
+          };
+        }) "not both";
+
+        module-settings-rendered = expect "settings-rendered" (
+          renderedConfig.model.default == "provider/model-name"
+          && renderedConfig.terminal == {
+            backend = "local";
+            cwd = "/srv/indus";
+          }
+          && renderedConfig._config_version == pins.configVersion
+        ) "rendered: ${builtins.toJSON renderedConfig}";
+
+        module-mcp-rendered = expect "mcp-rendered" (
+          renderedConfig.mcp_servers == {
+            files = {
+              command = "mcp-files";
+              args = [
+                "--root"
+                "/srv/shared"
+              ];
+            };
+            tracker = {
+              url = "https://mcp.example.invalid/mcp";
+              transport = "http";
+              auth = "oauth";
+              timeout = 30;
+            };
+          }
+        ) "rendered: ${builtins.toJSON renderedConfig.mcp_servers}";
+
+        module-home-manager = expect "home-manager" (
+          ours home == [ ]
+          && home.programs.indus-agent.renderedConfig.mcp_servers.files.command == "mcp-files"
+          && home.programs.indus-agent.renderedConfig.model.default == "provider/model-name"
+          && home.systemd.user.services ? indus-agent
+          && home.home.activation ? indusAgentConfig
+        ) "home-manager: ${builtins.toJSON (ours home)}";
+      };
+    };
+}
diff --git a/nix/module-common.nix b/nix/module-common.nix
new file mode 100644
index 0000000..e290a0e
--- /dev/null
+++ b/nix/module-common.nix
@@ -0,0 +1,315 @@
+# Options and helpers shared by the NixOS module (services.indus-agent) and the home-manager
+# module (programs.indus-agent). Each module adds the options only it has (users, container mode,
+# per-user home and so on) and decides how the gateway runs.
+{
+  lib,
+  pkgs,
+  # The package used when `package` is not set (this flake's default for the host system).
+  defaultPackage,
+  # Default and its documentation text for `workingDirectory` (null: the folder indus starts in).
+  defaultWorkingDirectory ? null,
+  defaultWorkingDirectoryText ? null,
+}:
+let
+  inherit (lib) mkOption types literalExpression;
+
+  render = import ./render.nix;
+  pins = lib.importJSON ./pins.json;
+
+  # JSON-shaped values that merge deeply across module definitions.
+  settingsFormat = pkgs.formats.json { };
+
+  # `python313` → `lib/python3.13/site-packages`, for packages that carry no interpreter.
+  pinnedSitePackages =
+    let
+      digits = lib.removePrefix "python" pins.python;
+    in
+    "lib/python${builtins.substring 0 1 digits}.${builtins.substring 1 (-1) digits}/site-packages";
+
+  mcpServerType = types.submodule {
+    options = {
+      command = mkOption {
+        type = types.nullOr types.str;
+        default = null;
+        description = "Program to start for a stdio server. Set this or `url`, not both.";
+      };
+      args = mkOption {
+        type = types.listOf types.str;
+        default = [ ];
+        description = "Arguments of `command`.";
+      };
+      env = mkOption {
+        type = types.attrsOf types.str;
+        default = { };
+        description = ''
+          Extra environment of a stdio server. Values land in the Nix store, which every user
+          can read: name secrets with `''${NAME}` placeholders and supply them through
+          `environmentFiles`.
+        '';
+      };
+      cwd = mkOption {
+        type = types.nullOr types.str;
+        default = null;
+        description = "Working directory of a stdio server.";
+      };
+      url = mkOption {
+        type = types.nullOr types.str;
+        default = null;
+        description = "Endpoint of a remote (HTTP or SSE) server. Set this or `command`, not both.";
+      };
+      transport = mkOption {
+        type = types.nullOr (
+          types.enum [
+            "http"
+            "sse"
+          ]
+        );
+        default = null;
+        description = "Remote transport; unset lets the client choose. Only with `url`.";
+      };
+      headers = mkOption {
+        type = types.attrsOf types.str;
+        default = { };
+        description = "HTTP headers of a remote server (use `\${NAME}` placeholders for secrets).";
+      };
+      auth = mkOption {
+        type = types.nullOr (types.enum [ "oauth" ]);
+        default = null;
+        description = "`oauth` makes the client sign in to a remote server.";
+      };
+      enabled = mkOption {
+        type = types.bool;
+        default = true;
+        description = "Whether the client connects to this server.";
+      };
+      extraConfig = mkOption {
+        inherit (settingsFormat) type;
+        default = { };
+        description = ''
+          Other keys of the `mcp_servers.<name>` entry (for example `timeout`, `tools`, `trust`,
+          `sampling`), written as given. Typed options above win over keys repeated here.
+        '';
+      };
+    };
+  };
+in
+rec {
+  inherit render pins settingsFormat;
+
+  # Options both modules declare under their own path.
+  options = {
+    enable = lib.mkEnableOption "the Indus Agent";
+
+    package = mkOption {
+      type = types.package;
+      default = defaultPackage;
+      defaultText = literalExpression "indus-agent.packages.\${system}.default";
+      description = "The Indus Agent package (the flake also has `minimal` and `messaging`).";
+    };
+
+    workingDirectory = mkOption {
+      type = types.nullOr types.str;
+      default = defaultWorkingDirectory;
+      defaultText = defaultWorkingDirectoryText;
+      description = ''
+        Folder the agent's terminal and file tools start in; written to `config.yaml` as
+        `terminal.cwd`. Null leaves `terminal.cwd` to `settings`.
+      '';
+    };
+
+    configFile = mkOption {
+      type = types.nullOr types.path;
+      default = null;
+      description = ''
+        A complete `config.yaml` to install as it is, instead of rendering `settings` and
+        `mcpServers` (setting both is an evaluation error).
+      '';
+    };
+
+    settings = mkOption {
+      inherit (settingsFormat) type;
+      default = { };
+      description = ''
+        The agent's configuration as an attribute set, rendered to `config.yaml`. Definitions from
+        several modules merge deeply. The rendered file belongs to Nix: the home is marked
+        managed, so `indus config set`, `indus setup` and the dashboard refuse to change it.
+      '';
+      example = literalExpression ''
+        {
+          model.default = "provider/model-name";
+          terminal.backend = "local";
+        }
+      '';
+    };
+
+    environmentFiles = mkOption {
+      type = types.listOf types.str;
+      default = [ ];
+      description = ''
+        Runtime paths of `NAME=value` files holding secrets (API keys, bot tokens), for example
+        from sops-nix or agenix. Strings, not Nix paths, so a secret is never copied into the
+        world-readable store.
+      '';
+      example = literalExpression ''[ config.sops.secrets."indus-agent/env".path ]'';
+    };
+
+    environment = mkOption {
+      type = types.attrsOf types.str;
+      default = { };
+      description = "Environment of the gateway. Not for secrets: the values land in the Nix store.";
+    };
+
+    extraPackages = mkOption {
+      type = types.listOf types.package;
+      default = [ ];
+      description = "Packages on the gateway's PATH, so the agent's tools can run them.";
+    };
+
+    extraPythonPackages = mkOption {
+      type = types.listOf types.package;
+      default = [ ];
+      description = ''
+        Python packages put on the gateway's PYTHONPATH, so plugins advertising the
+        `indus.plugins` entry point are found. Build them with the package's interpreter
+        (`config.<this module>.package.python.pkgs`).
+      '';
+    };
+
+    mcpServers = mkOption {
+      type = types.attrsOf mcpServerType;
+      default = { };
+      description = "MCP servers, rendered under `mcp_servers.<name>` in `config.yaml`.";
+      example = literalExpression ''
+        {
+          files = { command = "mcp-files"; args = [ "--root" "/srv/shared" ]; };
+          tracker = { url = "https://mcp.example.com/mcp"; auth = "oauth"; };
+        }
+      '';
+    };
+
+    extraArgs = mkOption {
+      type = types.listOf types.str;
+      default = [ ];
+      description = "Extra arguments after `indus gateway run`.";
+    };
+
+    restart = mkOption {
+      type = types.enum [
+        "no"
+        "on-success"
+        "on-failure"
+        "on-abnormal"
+        "on-abort"
+        "always"
+      ];
+      default = "always";
+      description = "systemd `Restart=` of the gateway (launchd keeps the agent alive instead).";
+    };
+
+    restartSec = mkOption {
+      type = types.ints.unsigned;
+      default = 5;
+      description = "systemd `RestartSec=` of the gateway, in seconds.";
+    };
+
+    renderedConfig = mkOption {
+      type = types.attrs;
+      default = { };
+      readOnly = true;
+      internal = true;
+      description = "What the module writes to `config.yaml` (inspected by the flake checks).";
+    };
+  };
+
+  # The `config.yaml` content of a module instance.
+  renderConfig =
+    cfg:
+    render.renderConfig {
+      inherit (cfg) settings workingDirectory;
+      mcpServers = cfg.mcpServers;
+      configVersion = pins.configVersion;
+    };
+
+  # The file installed as `config.yaml`: the user's own file, or the rendered settings. JSON is
+  # valid YAML 1.2, which the config loader reads.
+  configSource =
+    cfg:
+    if cfg.configFile != null then
+      cfg.configFile
+    else
+      pkgs.writeText "indus-agent-config.yaml" (builtins.toJSON cfg.renderedConfig);
+
+  # Shell lines that install the config and the managed marker into `home` (atomic replace).
+  # `run` is the command prefix (home-manager's `run` helper, or empty).
+  installConfigScript =
+    {
+      cfg,
+      home,
+      run ? "",
+    }:
+    let
+      dir = lib.escapeShellArg home;
+    in
+    ''
+      ${run} ${pkgs.coreutils}/bin/install -d -m 0700 ${dir}
+      ${run} ${pkgs.coreutils}/bin/install -m 0600 ${configSource cfg} ${dir}/config.yaml.nix-tmp
+      ${run} ${pkgs.coreutils}/bin/mv -f ${dir}/config.yaml.nix-tmp ${dir}/config.yaml
+      ${run} ${pkgs.coreutils}/bin/touch ${dir}/.managed
+    '';
+
+  sitePackagesOf = cfg: cfg.package.passthru.sitePackages or pinnedSitePackages;
+
+  # Environment of the gateway: home, managed flag, extra Python packages, the user's values.
+  # `managed` is off only for a home-manager home whose config the user keeps.
+  serviceEnvironment =
+    {
+      cfg,
+      home,
+      managed ? true,
+    }:
+    {
+      INDUS_HOME = home;
+    }
+    // lib.optionalAttrs managed { INDUS_MANAGED = "1"; }
+    // lib.optionalAttrs (cfg.extraPythonPackages != [ ]) {
+      PYTHONPATH = lib.makeSearchPath (sitePackagesOf cfg) cfg.extraPythonPackages;
+    }
+    // cfg.environment;
+
+  gatewayCommand = cfg: [
+    (lib.getExe' cfg.package "indus")
+    "gateway"
+    "run"
+  ] ++ cfg.extraArgs;
+
+  # Assertions of a module instance from the renderer's problem list.
+  assertionsFor =
+    {
+      cfg,
+      optionPath,
+      native ? true,
+      container ? false,
+      containerImage ? null,
+    }:
+    map
+      (message: {
+        assertion = false;
+        inherit message;
+      })
+      (
+        render.problems {
+          inherit
+            optionPath
+            native
+            container
+            containerImage
+            ;
+          inherit (cfg)
+            enable
+            configFile
+            settings
+            mcpServers
+            ;
+        }
+      );
+}
diff --git a/nix/nixos-module.nix b/nix/nixos-module.nix
new file mode 100644
index 0000000..4781df3
--- /dev/null
+++ b/nix/nixos-module.nix
@@ -0,0 +1,248 @@
+# NixOS module: services.indus-agent (P23-14).
+#
+# Runs the Indus Agent gateway either natively (a hardened systemd unit) or as an OCI container
+# (docker or podman through virtualisation.oci-containers), never both. A oneshot setup unit
+# writes config.yaml and the managed marker into the state directory before either starts.
+#
+#   services.indus-agent = {
+#     enable = true;
+#     settings.model.default = "provider/model-name";
+#     environmentFiles = [ config.sops.secrets."indus-agent/env".path ];
+#   };
+{ packagesFor }:
+{
+  config,
+  lib,
+  pkgs,
+  ...
+}:
+let
+  inherit (lib) mkOption types literalExpression;
+
+  optionPath = "services.indus-agent";
+  cfg = config.services.indus-agent;
+  system = pkgs.stdenv.hostPlatform.system;
+
+  common = import ./module-common.nix {
+    inherit lib pkgs;
+    defaultPackage =
+      (packagesFor system).default
+        or (throw "${optionPath}: this flake has no package for ${system}; set ${optionPath}.package");
+    defaultWorkingDirectory = "${cfg.stateDir}/workspace";
+    defaultWorkingDirectoryText = literalExpression ''"''${config.${optionPath}.stateDir}/workspace"'';
+  };
+
+  home = cfg.stateDir;
+  nativeMode = cfg.native.enable && !cfg.container.enable;
+  containerMode = cfg.container.enable && !cfg.native.enable;
+  serviceUser = config.users.users.${cfg.user} or { };
+  containerUnit = "${cfg.container.backend}-indus-agent";
+in
+{
+  options.services.indus-agent = common.options // {
+    user = mkOption {
+      type = types.str;
+      default = "indus-agent";
+      description = "User the gateway runs as (and owner of the state directory).";
+    };
+
+    group = mkOption {
+      type = types.str;
+      default = "indus-agent";
+      description = "Group of the gateway user.";
+    };
+
+    createUser = mkOption {
+      type = types.bool;
+      default = true;
+      description = "Create `user` and `group` as system accounts. Off: declare them yourself.";
+    };
+
+    stateDir = mkOption {
+      type = types.str;
+      default = "/var/lib/indus-agent";
+      description = "The agent's home (`INDUS_HOME`): config, sessions, logs. Mounted at /opt/data in container mode.";
+    };
+
+    addToSystemPackages = mkOption {
+      type = types.bool;
+      default = false;
+      description = "Also put `indus` on every user's PATH (environment.systemPackages).";
+    };
+
+    native.enable = mkOption {
+      type = types.bool;
+      default = !cfg.container.enable;
+      defaultText = literalExpression "!config.${optionPath}.container.enable";
+      description = "Run the gateway as a native systemd service.";
+    };
+
+    container = {
+      enable = lib.mkEnableOption "running the gateway from the Indus Agent OCI image instead of natively";
+
+      backend = mkOption {
+        type = types.enum [
+          "docker"
+          "podman"
+        ];
+        default = "podman";
+        description = "Container engine (virtualisation.oci-containers.backend).";
+      };
+
+      image = mkOption {
+        type = types.nullOr types.str;
+        default = null;
+        example = "ghcr.io/OWNER/indus-agent:stable";
+        description = "Image to run; required in container mode.";
+      };
+
+      extraOptions = mkOption {
+        type = types.listOf types.str;
+        default = [ ];
+        description = "Extra arguments for the container engine's `run`.";
+      };
+
+      extraVolumes = mkOption {
+        type = types.listOf types.str;
+        default = [ ];
+        example = [ "/srv/projects:/srv/projects" ];
+        description = "Extra `host:container[:options]` volumes.";
+      };
+    };
+  };
+
+  config = lib.mkIf cfg.enable (
+    lib.mkMerge [
+      {
+        assertions = common.assertionsFor {
+          inherit cfg optionPath;
+          native = cfg.native.enable;
+          container = cfg.container.enable;
+          containerImage = cfg.container.image;
+        };
+
+        warnings =
+          lib.optional (cfg.container.enable && (cfg.extraPackages != [ ] || cfg.extraPythonPackages != [ ]))
+            "${optionPath}: extraPackages and extraPythonPackages do not reach container mode; the image carries its own environment.";
+
+        services.indus-agent.renderedConfig = common.renderConfig cfg;
+
+        users.users = lib.mkIf cfg.createUser {
+          ${cfg.user} = {
+            isSystemUser = true;
+            group = cfg.group;
+            home = home;
+            description = "Indus Agent gateway";
+            # A user manager for this account (per-user units and timers) without a login session.
+            linger = lib.mkDefault nativeMode;
+          };
+        };
+        users.groups = lib.mkIf cfg.createUser { ${cfg.group} = { }; };
+
+        environment.systemPackages = lib.mkIf cfg.addToSystemPackages [ cfg.package ];
+
+        systemd.tmpfiles.rules = [
+          "d ${home} 0700 ${cfg.user} ${cfg.group} - -"
+        ]
+        ++ lib.optional (
+          cfg.workingDirectory != null
+        ) "d ${cfg.workingDirectory} 0750 ${cfg.user} ${cfg.group} - -";
+
+        systemd.services.indus-agent-setup = {
+          description = "Write the Indus Agent configuration";
+          wantedBy = [ "multi-user.target" ];
+          after = [ "systemd-tmpfiles-setup.service" ];
+          restartTriggers = [ (common.configSource cfg) ];
+          serviceConfig = {
+            Type = "oneshot";
+            RemainAfterExit = true;
+            User = cfg.user;
+            Group = cfg.group;
+            UMask = "0077";
+          };
+          script = common.installConfigScript { inherit cfg home; };
+        };
+      }
+
+      (lib.mkIf nativeMode {
+        systemd.services.indus-agent = {
+          description = "Indus Agent gateway";
+          wantedBy = [ "multi-user.target" ];
+          wants = [ "network-online.target" ];
+          requires = [ "indus-agent-setup.service" ];
+          after = [
+            "network-online.target"
+            "indus-agent-setup.service"
+          ];
+          # What the agent's terminal tools expect on any host, then the user's extras.
+          path = [
+            pkgs.bash
+            pkgs.coreutils
+            pkgs.git
+          ]
+          ++ cfg.extraPackages;
+          environment = common.serviceEnvironment { inherit cfg home; };
+          restartTriggers = [ (common.configSource cfg) ];
+          serviceConfig = {
+            User = cfg.user;
+            Group = cfg.group;
+            WorkingDirectory = if cfg.workingDirectory != null then cfg.workingDirectory else home;
+            ExecStart = lib.escapeShellArgs (common.gatewayCommand cfg);
+            EnvironmentFile = cfg.environmentFiles;
+            Restart = cfg.restart;
+            RestartSec = cfg.restartSec;
+            UMask = "0077";
+            NoNewPrivileges = true;
+            PrivateTmp = true;
+            ProtectSystem = "full";
+            ProtectKernelTunables = true;
+            ProtectKernelModules = true;
+            ProtectControlGroups = true;
+            RestrictSUIDSGID = true;
+            LockPersonality = true;
+          };
+        };
+      })
+
+      (lib.mkIf containerMode {
+        virtualisation.oci-containers.backend = cfg.container.backend;
+        virtualisation.oci-containers.containers.indus-agent = {
+          image = cfg.container.image;
+          autoStart = true;
+          cmd = [
+            "gateway"
+            "run"
+          ]
+          ++ cfg.extraArgs;
+          volumes = [
+            "${home}:/opt/data"
+          ]
+          ++ lib.optional (
+            cfg.workingDirectory != null
+          ) "${cfg.workingDirectory}:${cfg.workingDirectory}"
+          ++ cfg.container.extraVolumes;
+          # The image's stage-2 remaps its user to these ids (P23-10) so /opt/data stays ours.
+          environment =
+            {
+              INDUS_MANAGED = "1";
+            }
+            // lib.optionalAttrs ((serviceUser.uid or null) != null) {
+              INDUS_UID = toString serviceUser.uid;
+            }
+            // lib.optionalAttrs ((config.users.groups.${cfg.group}.gid or null) != null) {
+              INDUS_GID = toString config.users.groups.${cfg.group}.gid;
+            }
+            // cfg.environment;
+          environmentFiles = cfg.environmentFiles;
+          extraOptions = [ "--network=host" ] ++ cfg.container.extraOptions;
+        };
+
+        systemd.services.${containerUnit} = {
+          requires = [ "indus-agent-setup.service" ];
+          after = [ "indus-agent-setup.service" ];
+          restartTriggers = [ (common.configSource cfg) ];
+        };
+      })
+    ]
+  );
+}
diff --git a/nix/packages.nix b/nix/packages.nix
new file mode 100644
index 0000000..7349d22
--- /dev/null
+++ b/nix/packages.nix
@@ -0,0 +1,226 @@
+# flake-parts module: the Indus Agent packages and the devshell (P23-13).
+#
+# The Python closure comes from uv.lock through uv2nix (the same pins as every other install
+# method; no PyPI resolution at build time). The wheel build guard (P23-01) refuses to build
+# unless INDUS_NIX_BUILD=1, which only our own package gets here. The two frontends are built
+# from pnpm-lock.yaml; the dashboard pages go inside the Python package (where the dashboard looks
+# for them), the full-screen renderer is found through INDUS_TUI_DIR.
+#
+#   nix run .#default -- --version     nix profile install .#messaging     nix develop
+{ inputs, ... }:
+{
+  perSystem =
+    { pkgs, lib, ... }:
+    let
+      pins = lib.importJSON ./pins.json;
+      variants = import ./variants.nix;
+      pyproject = builtins.fromTOML (builtins.readFile ../pyproject.toml);
+      version = pyproject.project.version;
+
+      python = pkgs.${pins.python};
+      nodejs = pkgs.${pins.nodejs};
+      pnpm =
+        pkgs.${pins.pnpm}
+          or (throw "nixpkgs has no ${pins.pnpm} (package.json packageManager); update the nixpkgs input or the pin");
+
+      # -- frontends (apps/tui, apps/web) ---------------------------------------------------------
+
+      frontendSrc = lib.fileset.toSource {
+        root = ../.;
+        fileset = lib.fileset.unions [
+          ../package.json
+          ../pnpm-lock.yaml
+          ../pnpm-workspace.yaml
+          ../tsconfig.base.json
+          ../apps
+          ../packages
+        ];
+      };
+
+      pnpmWorkspaces = [
+        "@indus/tui..."
+        "@indus/web..."
+      ];
+
+      # One fixed-output fetch of the pnpm store for both frontends. The hash needs network to
+      # compute: until the Nix lane records it in pins.json, a fake hash makes the build fail
+      # with the real one in the message (scripts/nix/pins.py --pnpm-hash records it).
+      pnpmDepsArgs = {
+        pname = "indus-agent-frontends";
+        inherit version pnpmWorkspaces;
+        src = frontendSrc;
+        fetcherVersion = 2;
+        hash = if pins.pnpmDepsHash != null then pins.pnpmDepsHash else lib.fakeHash;
+      };
+      pnpmDeps =
+        if pkgs ? fetchPnpmDeps then
+          pkgs.fetchPnpmDeps (pnpmDepsArgs // { inherit pnpm; })
+        else
+          pnpm.fetchDeps pnpmDepsArgs;
+      pnpmConfigHook = pkgs.pnpmConfigHook or pnpm.configHook;
+
+      buildFrontend =
+        {
+          pname,
+          workspace,
+          installPhase,
+        }:
+        pkgs.stdenvNoCC.mkDerivation {
+          inherit
+            pname
+            version
+            pnpmDeps
+            pnpmWorkspaces
+            installPhase
+            ;
+          src = frontendSrc;
+          nativeBuildInputs = [
+            nodejs
+            pnpm
+            pnpmConfigHook
+          ];
+          # Real directories in one node_modules tree, so the renderer's runtime imports can be
+          # shipped next to its bundle.
+          pnpmInstallFlags = [ "--config.node-linker=hoisted" ];
+          buildPhase = ''
+            runHook preBuild
+            pnpm --filter ${workspace} run build
+            runHook postBuild
+          '';
+        };
+
+      # The dashboard pages: apps/web/dist.
+      web = buildFrontend {
+        pname = "indus-agent-web";
+        workspace = "@indus/web";
+        installPhase = ''
+          runHook preInstall
+          test -f apps/web/dist/index.html
+          cp -r apps/web/dist $out
+          runHook postInstall
+        '';
+      };
+
+      # The full-screen renderer: dist/entry.js plus the packages it imports at run time (the SSR
+      # bundle keeps npm dependencies external; workspace packages are bundled, so their links go).
+      tui = buildFrontend {
+        pname = "indus-agent-tui";
+        workspace = "@indus/tui";
+        installPhase = ''
+          runHook preInstall
+          test -f apps/tui/dist/entry.js
+          mkdir -p $out
+          cp -r apps/tui/dist apps/tui/package.json $out/
+          cp -r node_modules $out/node_modules
+          rm -rf $out/node_modules/@indus $out/node_modules/.cache
+          runHook postInstall
+        '';
+      };
+
+      # -- Python ---------------------------------------------------------------------------------
+
+      workspace = inputs.uv2nix.lib.workspace.loadWorkspace { workspaceRoot = ../.; };
+      lockOverlay = workspace.mkPyprojectOverlay { sourcePreference = "wheel"; };
+      buildSystems =
+        inputs.pyproject-build-systems.overlays.wheel or inputs.pyproject-build-systems.overlays.default;
+
+      ourPackage = _final: prev: {
+        indus-agent = prev.indus-agent.overrideAttrs (old: {
+          # The wheel build guard (scripts/build_hooks/no_wheel.py) lets only Nix build a wheel.
+          env = (old.env or { }) // {
+            INDUS_NIX_BUILD = "1";
+          };
+          # The dashboard pages are git-ignored, so a flake source never carries them.
+          preBuild = (old.preBuild or "") + ''
+            mkdir -p src/indus/web/static
+            cp -r ${web}/. src/indus/web/static/
+            chmod -R u+w src/indus/web/static
+          '';
+        });
+      };
+
+      pythonSet =
+        (pkgs.callPackage inputs.pyproject-nix.build.packages { inherit python; }).overrideScope
+          (
+            lib.composeManyExtensions [
+              buildSystems
+              lockOverlay
+              ourPackage
+            ]
+          );
+
+      # One sealed virtualenv per variant, wrapped so `indus` finds the renderer and Node.
+      mkVariant =
+        { name, withTui }:
+        let
+          extras = variants.${name};
+          venv = pythonSet.mkVirtualEnv "indus-agent-${name}-env" { indus-agent = extras; };
+        in
+        pkgs.runCommand "indus-agent-${name}-${version}"
+          {
+            nativeBuildInputs = [ pkgs.makeWrapper ];
+            passthru = {
+              inherit python venv extras;
+              inherit (python) sitePackages;
+            };
+            meta = {
+              description = "Indus Agent (${name} variant)";
+              license = lib.licenses.mit;
+              mainProgram = "indus";
+            };
+          }
+          ''
+            mkdir -p $out/bin
+            makeWrapper ${venv}/bin/indus $out/bin/indus ${
+              lib.optionalString withTui (
+                lib.escapeShellArgs [
+                  "--set-default"
+                  "INDUS_TUI_DIR"
+                  "${tui}"
+                  "--suffix"
+                  "PATH"
+                  ":"
+                  (lib.makeBinPath [ nodejs ])
+                ]
+              )
+            }
+          '';
+    in
+    {
+      # packages:begin (names read by tests/unit/packaging/test_nix_files.py)
+      packages = {
+        default = mkVariant {
+          name = "default";
+          withTui = true;
+        };
+        minimal = mkVariant {
+          name = "minimal";
+          withTui = false;
+        };
+        messaging = mkVariant {
+          name = "messaging";
+          withTui = false;
+        };
+        tui = tui;
+        web = web;
+      };
+      # packages:end
+
+      devShells.default = pkgs.mkShell {
+        packages = [
+          python
+          pkgs.uv
+          nodejs
+          pnpm
+        ];
+        env = {
+          # uv uses the Nix interpreter and never downloads one.
+          UV_PYTHON = python.interpreter;
+          UV_PYTHON_DOWNLOADS = "never";
+        };
+        shellHook = ''
+          unset PYTHONPATH
+        '';
+      };
+    };
+}
