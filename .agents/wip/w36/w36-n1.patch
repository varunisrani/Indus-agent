diff --git a/nix/render.nix b/nix/render.nix
new file mode 100644
index 0000000..4631c26
--- /dev/null
+++ b/nix/render.nix
@@ -0,0 +1,134 @@
+# What the NixOS and home-manager modules write, and the problems their assertions report.
+#
+# Builtins only (no nixpkgs `lib`), so `nix-instantiate --eval` can test it with nothing fetched;
+# the modules import it and wrap the problem lists in assertions.
+let
+  # MCP server fields the modules declare as typed options; every other key of an entry goes
+  # through `extraConfig` unchanged. The names are those of `indus.mcp.config.McpServer`.
+  mcpTypedFields = [
+    "command"
+    "args"
+    "env"
+    "cwd"
+    "url"
+    "transport"
+    "headers"
+    "auth"
+    "enabled"
+  ];
+
+  isUnset = value: value == null || value == [ ] || value == { };
+
+  # Deep merge of two attribute sets; values of `right` win, nested sets merge.
+  merge =
+    left: right:
+    left
+    // builtins.mapAttrs (
+      name: value:
+      if builtins.isAttrs value && builtins.isAttrs (left.${name} or null) then
+        merge left.${name} value
+      else
+        value
+    ) right;
+
+  pick = names: set: builtins.listToAttrs (map (name: {
+    inherit name;
+    value = set.${name};
+  }) (builtins.filter (name: set ? ${name} && !isUnset set.${name}) names));
+
+  # One `mcp_servers.<name>` entry: unset typed fields dropped, `enabled` written only when off
+  # (the loader's default is on), free-form keys kept; typed fields win over free-form ones.
+  renderMcpServer =
+    server:
+    let
+      typed = pick (builtins.filter (n: n != "enabled") mcpTypedFields) server;
+      switch = if (server.enabled or true) then { } else { enabled = false; };
+    in
+    (server.extraConfig or { }) // typed // switch;
+
+  mcpServerProblems =
+    optionPath: name: server:
+    let
+      where = "${optionPath}.mcpServers.${name}";
+      hasCommand = (server.command or null) != null;
+      hasUrl = (server.url or null) != null;
+    in
+    (if hasCommand && hasUrl then
+      [ "${where}: set either command (stdio) or url (http/sse), not both" ]
+    else if !hasCommand && !hasUrl then
+      [ "${where}: set command (stdio) or url (http/sse)" ]
+    else
+      [ ])
+    ++ (if (server.transport or null) != null && !hasUrl then
+      [ "${where}: transport applies to url servers only" ]
+    else
+      [ ]);
+
+  # The whole `config.yaml`: declared settings, the config stamp unless the settings carry one,
+  # the working directory as `terminal.cwd`, declared MCP servers over same-named settings entries.
+  renderConfig =
+    {
+      settings ? { },
+      workingDirectory ? null,
+      mcpServers ? { },
+      configVersion,
+    }:
+    let
+      stamped = { _config_version = configVersion; } // settings;
+      withCwd =
+        if workingDirectory == null then
+          stamped
+        else
+          merge stamped { terminal.cwd = workingDirectory; };
+      servers = builtins.mapAttrs (_: renderMcpServer) mcpServers;
+    in
+    if servers == { } then withCwd else merge withCwd { mcp_servers = servers; };
+
+  # Problems of one module instance; an empty list means the assertions pass.
+  problems =
+    {
+      optionPath,
+      enable ? true,
+      native ? true,
+      container ? false,
+      containerImage ? null,
+      configFile ? null,
+      settings ? { },
+      mcpServers ? { },
+    }:
+    if !enable then
+      [ ]
+    else
+      (if native && container then
+        [
+          "${optionPath}: native and container mode are both enabled; pick one (set native.enable = false or container.enable = false)"
+        ]
+      else if !native && !container then
+        [
+          "${optionPath}: enabled, but neither native.enable nor container.enable is set, so nothing would run"
+        ]
+      else
+        [ ])
+      ++ (if container && containerImage == null then
+        [ "${optionPath}: container.enable needs container.image (the image to run)" ]
+      else
+        [ ])
+      ++ (if configFile != null && (settings != { } || mcpServers != { }) then
+        [
+          "${optionPath}: configFile replaces the whole config.yaml; do not also set settings or mcpServers"
+        ]
+      else
+        [ ])
+      ++ builtins.concatLists (
+        builtins.attrValues (builtins.mapAttrs (mcpServerProblems optionPath) mcpServers)
+      );
+in
+{
+  inherit
+    mcpTypedFields
+    merge
+    renderMcpServer
+    renderConfig
+    problems
+    ;
+}
diff --git a/nix/variants.nix b/nix/variants.nix
new file mode 100644
index 0000000..d55a335
--- /dev/null
+++ b/nix/variants.nix
@@ -0,0 +1,41 @@
+# The optional extras (pyproject.toml [project.optional-dependencies]) baked into each Python
+# variant of the package. The Nix store is read-only, so nothing can be installed lazily later:
+# a variant carries everything it will ever import.
+#
+# Plain data on purpose: nix/packages.nix and nix/checks.nix import it, and the Python tests read
+# it without nixpkgs. Keep the shape `name = [ "..." ];` or `name = other ++ [ "..." ];`.
+let
+  # Messaging adapters whose clients are not in the base dependencies (Telegram, Matrix without
+  # encryption, Signal, email and the webhook platforms need only the base set).
+  messaging = [
+    "discord"
+    "slack"
+    "mattermost"
+    "google-chat"
+    "qqbot"
+    "dingtalk"
+    "wecom"
+    "feishu"
+    "simplex"
+    "buzz"
+    "weixin"
+    "yuanbao"
+  ];
+in
+{
+  minimal = [ ];
+
+  inherit messaging;
+
+  # Everything portable that a desktop or server user expects to just work. Left out until the Nix
+  # lane shows they build: extras whose wheels bundle foreign binaries (browser, voice, research,
+  # the cloud sandbox SDKs, discord-voice) and matrix-e2ee (Linux only, python-olm builds from its
+  # sdist with cmake). The modules' extraPythonPackages covers them meanwhile.
+  default = messaging ++ [
+    "web"
+    "docs"
+    "pty"
+    "dashboard"
+    "acp"
+  ];
+}
diff --git a/scripts/nix/pins.py b/scripts/nix/pins.py
new file mode 100644
index 0000000..94c3b38
--- /dev/null
+++ b/scripts/nix/pins.py
@@ -0,0 +1,154 @@
+"""Render ``nix/pins.json``: the toolchain names the Nix files take from the repository (P23-13).
+
+The flake must build with the same interpreter, Node.js and pnpm major the rest of the repository
+pins, and the modules stamp the same config version the config loader expects. Those values live
+in repository files; this script copies them into one JSON file the Nix code imports
+(``lib.importJSON``), so Nix never parses TOML, YAML or Python to find them.
+
+Derived values (rewritten on every run):
+
+- ``python``: the nixpkgs interpreter attribute for ``.python-version`` (``3.13`` → ``python313``);
+- ``nodejs``: ``nodejs_<major>`` from the lower bound of ``package.json`` ``engines.node``;
+- ``pnpm``: ``pnpm_<major>`` from ``package.json`` ``packageManager``;
+- ``configVersion``: ``CURRENT_VERSION`` in ``src/indus/foundation/config/schema.py``.
+
+Kept by hand (carried over unchanged): ``pnpmDepsHash``, the fixed-output hash of the pnpm store
+for ``apps/tui`` and ``apps/web``. It needs network to compute, so the Nix lane fills it in
+(``--pnpm-hash sha256-…``); ``null`` makes the build use a fake hash and print the real one.
+
+``python scripts/nix/pins.py`` rewrites the file; ``--check`` exits 1 when it is stale.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from collections.abc import Sequence
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[2]
+PINS_PATH = Path("nix") / "pins.json"
+HAND_KEPT = ("pnpmDepsHash",)
+COMMENT = (
+    "Generated by scripts/nix/pins.py from the repository (do not edit by hand); only "
+    "pnpmDepsHash is kept by hand and filled in by the Nix lane."
+)
+
+_PYTHON_VERSION = re.compile(r"^(\d+)\.(\d+)(?:\.\d+)?$")
+_NODE_RANGE = re.compile(r">=\s*(\d+)(?:\.\d+){0,2}")
+_PACKAGE_MANAGER = re.compile(r"^pnpm@(\d+)\.\d+\.\d+(?:[+-].*)?$")
+_CONFIG_VERSION = re.compile(r"^CURRENT_VERSION\s*=\s*(\d+)\s*$", re.MULTILINE)
+_SRI_SHA256 = re.compile(r"^sha256-[A-Za-z0-9+/]{43}=$")
+
+
+class PinsError(Exception):
+    """A repository file does not say what the pins need."""
+
+
+def python_attr(root: Path) -> str:
+    text = (root / ".python-version").read_text(encoding="utf-8").strip()
+    match = _PYTHON_VERSION.match(text)
+    if match is None:
+        raise PinsError(f".python-version holds {text!r}, not MAJOR.MINOR")
+    return f"python{match.group(1)}{match.group(2)}"
+
+
+def _package_json(root: Path) -> dict[str, Any]:
+    data = json.loads((root / "package.json").read_text(encoding="utf-8"))
+    if not isinstance(data, dict):
+        raise PinsError("package.json is not a JSON object")
+    return dict(data)  # pyright: ignore[reportUnknownArgumentType]
+
+
+def nodejs_attr(root: Path) -> str:
+    engines = _package_json(root).get("engines")
+    wanted = engines.get("node") if isinstance(engines, dict) else None
+    match = _NODE_RANGE.search(wanted) if isinstance(wanted, str) else None
+    if match is None:
+        raise PinsError("package.json engines.node has no '>=MAJOR' lower bound")
+    return f"nodejs_{match.group(1)}"
+
+
+def pnpm_attr(root: Path) -> str:
+    manager = _package_json(root).get("packageManager")
+    match = _PACKAGE_MANAGER.match(manager) if isinstance(manager, str) else None
+    if match is None:
+        raise PinsError("package.json packageManager is not 'pnpm@X.Y.Z'")
+    return f"pnpm_{match.group(1)}"
+
+
+def config_version(root: Path) -> int:
+    schema = root / "src" / "indus" / "foundation" / "config" / "schema.py"
+    match = _CONFIG_VERSION.search(schema.read_text(encoding="utf-8"))
+    if match is None:
+        raise PinsError(f"{schema.relative_to(root)} has no 'CURRENT_VERSION = N' line")
+    return int(match.group(1))
+
+
+def valid_hash(value: object) -> bool:
+    return value is None or (isinstance(value, str) and _SRI_SHA256.match(value) is not None)
+
+
+def read_current(root: Path) -> dict[str, Any] | None:
+    try:
+        data = json.loads((root / PINS_PATH).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return dict(data) if isinstance(data, dict) else None  # pyright: ignore[reportUnknownArgumentType]
+
+
+def expected(root: Path, current: dict[str, Any] | None = None) -> dict[str, Any]:
+    """The file's content: derived values now, hand-kept values carried over from ``current``."""
+    kept = {key: (current or {}).get(key) for key in HAND_KEPT}
+    for key, value in kept.items():
+        if not valid_hash(value):
+            raise PinsError(f"{PINS_PATH}: {key} must be null or an SRI sha256 hash")
+    return {
+        "_comment": COMMENT,
+        "configVersion": config_version(root),
+        "nodejs": nodejs_attr(root),
+        "pnpm": pnpm_attr(root),
+        "python": python_attr(root),
+        **kept,
+    }
+
+
+def render(data: dict[str, Any]) -> str:
+    return json.dumps(data, indent=2, sort_keys=True) + "\n"
+
+
+def main(argv: Sequence[str] | None = None, *, root: Path = ROOT) -> int:
+    parser = argparse.ArgumentParser(description="Render nix/pins.json from the repository.")
+    parser.add_argument("--check", action="store_true", help="exit 1 when the file is stale")
+    parser.add_argument("--pnpm-hash", help="record the pnpm store hash the Nix lane printed")
+    args = parser.parse_args(argv)
+    current = read_current(root)
+    try:
+        if args.pnpm_hash is not None:
+            if not valid_hash(args.pnpm_hash):
+                raise PinsError("--pnpm-hash must look like sha256-<44 base64 characters>")
+            current = {**(current or {}), "pnpmDepsHash": args.pnpm_hash}
+        want = render(expected(root, current))
+    except (OSError, ValueError, PinsError) as exc:
+        print(f"nix pins: {exc}", file=sys.stderr)
+        return 2
+    path = root / PINS_PATH
+    have = path.read_text(encoding="utf-8") if path.is_file() else None
+    if args.check:
+        if have != want:
+            print(f"{PINS_PATH} is stale; run: uv run python scripts/nix/pins.py", file=sys.stderr)
+            return 1
+        return 0
+    if have != want:
+        tmp = path.with_name(path.name + ".tmp")
+        tmp.write_text(want, encoding="utf-8")
+        tmp.replace(path)
+        print(f"wrote {PINS_PATH}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
