+# ---------------------------------------------------------------------------------------------
+# Embedded tables
+# ---------------------------------------------------------------------------------------------
+
+function Get-IndusStageDef([string]$Name) {
+    foreach ($def in @($script:IndusStages.stages)) {
+        if ($def.name -ceq $Name) { return $def }
+    }
+    return $null
+}
+
+function Get-IndusManifestJson {
+    $list = @()
+    foreach ($def in @($script:IndusStages.stages)) {
+        $title = [string]$def.title
+        if ($script:IndusOpts.IncludeDesktop -and $def.title_with_desktop) { $title = [string]$def.title_with_desktop }
+        $list += [ordered]@{
+            name             = [string]$def.name
+            title            = $title
+            category         = [string]$def.category
+            needs_user_input = [bool]$def.needs_user_input
+        }
+    }
+    $manifest = [ordered]@{ protocol_version = [int]$script:IndusStages.protocol_version; stages = $list }
+    return ($manifest | ConvertTo-Json -Depth 5 -Compress)
+}
+
+# The release origin (owner decision D-16.690 pending): the one constant is pins.json
+# release.repository ("owner/name"); clone, API, release and shim URLs all derive from it.
+function Get-IndusRepository {
+    $pins = $script:IndusPinsJson | ConvertFrom-Json
+    $named = ([string]$pins.release.repository).Trim().TrimEnd('/')
+    if ($named.StartsWith('https://')) { return $named }
+    return 'https://github.com/' + $named
+}
+
+function Get-IndusCloneUrl {
+    if ($env:INDUS_REPO_URL) { return [string]$env:INDUS_REPO_URL }
+    return (Get-IndusRepository) + '.git'
+}
+
+# ---------------------------------------------------------------------------------------------
+# Failures, frames and the receipt
+# ---------------------------------------------------------------------------------------------
+
+# Throws; the entry points own reporting and the exit code. $Class is the receipt's closed
+# failure class.
+function Stop-IndusStage([string]$Message, [string]$Class = 'other') {
+    $script:IndusFailureClass = $Class
+    throw $Message
+}
+
+# The class for a ladder stage that threw. A native child that Ctrl-C ended (130, or Windows
+# STATUS_CONTROL_C_EXIT) is an interruption whatever the stage said.
+function Get-IndusFailureClass {
+    if ($global:LASTEXITCODE -in @(130, -1073741510, 3221225786)) { return 'interrupted' }
+    if ($script:IndusFailureClass) { return $script:IndusFailureClass }
+    return 'other'
+}
+
+function Write-IndusFrame([bool]$Ok, [string]$Name, [bool]$Skipped, [string]$Reason = '') {
+    $frame = [ordered]@{ ok = $Ok; stage = $Name; skipped = $Skipped }
+    if ($Reason) { $frame.reason = $Reason }
+    Write-IndusJsonLine ($frame | ConvertTo-Json -Compress)
+}
+
+# One local receipt per full-ladder run; never uploaded. The first writer wins: a second call in
+# this process (the finally block's 'interrupted') and an existing receipt file are both no-ops.
+# Best effort: a receipt that cannot be written never fails the install. Returns $true when written.
+function Write-IndusReceipt([string]$Outcome, [string]$FailedStage = '', [string]$FailureClass = '') {
+    if ($script:IndusReceiptWritten) { return $false }
+    $script:IndusReceiptWritten = $true
+    $tmpFile = $null
+    try {
+        if (-not $script:IndusRunId) { $script:IndusRunId = [guid]::NewGuid().ToString('N') }
+        if (-not $script:IndusStartedAt) { $script:IndusStartedAt = Get-IndusUtcStamp }
+        $receiptDir = Join-Path (Join-Path $script:IndusPaths.Home 'logs') 'install_receipts'
+        New-Item -ItemType Directory -Force -Path $receiptDir | Out-Null
+        $final = Join-Path $receiptDir ($script:IndusRunId + '.json')
+        if (Test-Path -LiteralPath $final) { return $false }
+        $record = [ordered]@{ id = $script:IndusRunId; installer = 'ps1'; outcome = $Outcome }
+        if ($FailedStage) { $record.failed_stage = $FailedStage }
+        if ($FailureClass) { $record.failure_class = $FailureClass }
+        $record.started_at = $script:IndusStartedAt
+        $record.finished_at = Get-IndusUtcStamp
+        $tmpFile = Join-Path $receiptDir ('.' + $script:IndusRunId + '.tmp')
+        [IO.File]::WriteAllText($tmpFile, ($record | ConvertTo-Json -Compress), (New-Object System.Text.UTF8Encoding($false)))
+        Move-Item -LiteralPath $tmpFile -Destination $final -ErrorAction Stop
+        $tmpFile = $null
+        return $true
+    } catch {
+        if ($tmpFile) { Remove-Item -LiteralPath $tmpFile -Force -ErrorAction SilentlyContinue }
+        return $false
+    }
+}
+
+# ---------------------------------------------------------------------------------------------
+# Native commands. Windows PowerShell 5.1 turns a native tool's redirected stderr into an error
+# record that 'Stop' makes fatal; native calls run with the preference relaxed here, and the
+# caller judges $LASTEXITCODE. The helpers below use unusual local names because the blocks they
+# run resolve variables through their scope first.
+# ---------------------------------------------------------------------------------------------
+
+function Invoke-IndusNative {
+    param([scriptblock]$IndusNativeBlock, [switch]$Utf8)
+    $ErrorActionPreference = 'Continue'
+    if (-not $Utf8) {
+        & $IndusNativeBlock
+        return
+    }
+    $nvPrevious = [Console]::OutputEncoding
+    try {
+        [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false)
+        & $IndusNativeBlock
+    } finally {
+        [Console]::OutputEncoding = $nvPrevious
+    }
+}
+
+# The cause line of a failed command: the first "fatal:"/"error:" line, else the last line.
+function Select-IndusErrorLine($Lines) {
+    $slPick = $null
+    $slLast = $null
+    foreach ($slRaw in @($Lines)) {
+        $slLine = ("$slRaw" -split "`r")[-1].Trim()
+        if (-not $slLine) { continue }
+        $slLast = $slLine
+        if (-not $slPick -and $slLine -match '(^|\s)(fatal|error): ') { $slPick = $slLine }
+    }
+    if (-not $slPick) { $slPick = $slLast }
+    if ($slPick -and $slPick.Length -gt 240) { $slPick = $slPick.Substring(0, 240) }
+    return $slPick
+}
+
+function Get-IndusNativeDetail {
+    if ($script:IndusNativeError) { return ": $($script:IndusNativeError)" }
+    return ''
+}
+
+# Runs a native block with one status line; its output goes to <home>\logs\install.log, and to the
+# console too with -Verbose, in CI, when stdout is redirected (the desktop app reads it) or when the
+# log cannot be opened. $LASTEXITCODE stays the caller's.
+function Invoke-IndusLogged {
+    param([string]$LoggedLabel, [scriptblock]$LoggedBlock, [switch]$MayFail)
+    $script:IndusNativeError = ''
+    Write-IndusInfo $LoggedLabel
+    $lgWriter = $null
+    try {
+        $lgLog = Get-IndusLogPath
+        $lgDir = Split-Path -Parent $lgLog
+        if (-not (Test-Path -LiteralPath $lgDir)) { New-Item -ItemType Directory -Force -Path $lgDir | Out-Null }
+        $lgWriter = New-Object System.IO.StreamWriter($lgLog, $true, (New-Object System.Text.UTF8Encoding($false)))
+        $lgWriter.WriteLine("==> $LoggedLabel ($(Get-IndusUtcStamp))")
+    } catch {
+        $lgWriter = $null
+    }
+    $lgStream = [bool]$script:IndusOpts.Verbose -or [bool]$env:CI -or -not $lgWriter
+    if (-not $lgStream) {
+        try { $lgStream = [Console]::IsOutputRedirected } catch { $lgStream = $true }
+    }
+    $lgTail = New-Object 'System.Collections.Generic.List[string]'
+    $lgCode = 0
+    try {
+        $global:LASTEXITCODE = 0
+        Invoke-IndusNative { & $LoggedBlock 2>&1 } | ForEach-Object {
+            $lgLine = "$_".TrimEnd("`r")
+            if ($lgWriter) { $lgWriter.WriteLine($lgLine) }
+            if ($lgStream) { Write-Host "    $lgLine" }
+            $lgTail.Add($lgLine)
+            if ($lgTail.Count -gt 20) { $lgTail.RemoveAt(0) }
+        }
+        $lgCode = $global:LASTEXITCODE
+    } finally {
+        if ($lgWriter) { $lgWriter.Dispose() }
+    }
+    if ($lgCode) {
+        $script:IndusNativeError = Select-IndusErrorLine $lgTail
+        if (-not $MayFail) {
+            Write-IndusWarn "$LoggedLabel failed (exit $lgCode). Last output:"
+            foreach ($lgShown in $lgTail) { Write-Host "    $lgShown" }
+            Write-Host "    full log: $(Get-IndusLogPath)"
+        }
+    }
+    $global:LASTEXITCODE = $lgCode
+}
+
+# ---------------------------------------------------------------------------------------------
+# Windows bootstrap: pinned tools (portable Git, uv) verified by SHA-256, the desktop app check
+# and its Start menu entry.
+#
+# Seams (script-scope scriptblocks a test replaces after dot-sourcing this file):
+#   IndusDownload      param($Uri, $OutFile)       fetch one URL to a file; throws on failure
+#   IndusStartProcess  param($FilePath, $ArgLine)  start a process; returns an object with
+#                                                  Id, HasExited, ExitCode and WaitForExit(ms)
+#   IndusKillTree      param($ProcessId)           kill a process and its children by pid
+#   IndusNow           (no arguments)              the current time as a [DateTime]
+#   IndusSleep         param($Milliseconds)        wait
+# ---------------------------------------------------------------------------------------------
+
+$script:IndusGitExtractLimitSeconds = 600
+$script:IndusPollMilliseconds = 200
+
+$script:IndusDownload = {
+    param($Uri, $OutFile)
+    $ProgressPreference = 'SilentlyContinue'
+    Invoke-WebRequest -Uri $Uri -OutFile $OutFile -UseBasicParsing -ErrorAction Stop
+}
+$script:IndusStartProcess = {
+    param($FilePath, $ArgLine)
+    [System.Diagnostics.Process]::Start($FilePath, $ArgLine)
+}
+$script:IndusKillTree = {
+    param($ProcessId)
+    Invoke-IndusNative { taskkill.exe /T /F /PID $ProcessId 2>&1 } | Out-Null
+}
+$script:IndusNow = { [DateTime]::UtcNow }
+$script:IndusSleep = {
+    param($Milliseconds)
+    Start-Sleep -Milliseconds $Milliseconds
+}
+
+# The machine's architecture (an x64 PowerShell on Windows on Arm must still fetch arm64 tools).
+function Get-IndusArch {
+    $machine = ''
+    try {
+        $machine = [string](Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment' -ErrorAction Stop).PROCESSOR_ARCHITECTURE
+    } catch {
+        $machine = [string]$env:PROCESSOR_ARCHITECTURE
+    }
+    if ($machine -eq 'ARM64') { return 'arm64' }
+    if ($machine -eq 'AMD64' -or $machine -eq 'x86' -or $machine -eq '') { return 'x64' }
+    return $machine.ToLowerInvariant()
+}
+
+function Get-IndusTarget {
+    return 'windows-' + (Get-IndusArch)
+}
+
+function Get-IndusPins {
+    if (-not $script:IndusPinsData) { $script:IndusPinsData = $script:IndusPinsJson | ConvertFrom-Json }
+    return $script:IndusPinsData
+}
+
+# The one reader of the pins table: @{ Version; Url; MirrorUrl; Sha256 } for a tool and target,
+# or $null when the tool has no pin for that target.
+function Get-IndusPin([string]$Tool, [string]$Target) {
+    $pins = Get-IndusPins
+    $entry = $pins.$Tool
+    if (-not $entry) { return $null }
+    $file = $entry.targets.$Target
+    if (-not $file) { return $null }
+    $mirror = [string]$file.mirror
+    if (-not $mirror) { $mirror = [string]$file.mirror_url }
+    return @{
+        Version   = [string]$entry.version
+        Url       = [string]$file.url
+        MirrorUrl = $mirror
+        Sha256    = ([string]$file.sha256).ToLowerInvariant()
+    }
+}
+
+function Get-IndusFileSha256([string]$Path) {
+    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
+}
+
+function Get-IndusTempDir([string]$Label) {
+    return (Join-Path ([IO.Path]::GetTempPath()) ('indus-' + $Label + '-' + $PID + '-' + (Get-Random)))
+}
+
+# What kind of failure a download raised: 'network' (DNS, connect, timeout, reset, or an HTTP
+# error status: the cases curl reports as 5, 6, 7, 18, 22, 28, 52, 55, 56), 'tls' (a trust or
+# handshake failure: never a routing problem) or 'other'. Only 'network' may try the mirror.
+function Get-IndusDownloadFailureKind($ErrorRecord) {
+    $ex = $ErrorRecord
+    if ($ErrorRecord -is [System.Management.Automation.ErrorRecord]) { $ex = $ErrorRecord.Exception }
+    $seen = 0
+    while ($ex -and $seen -lt 6) {
+        $typeName = $ex.GetType().FullName
+        if ($typeName -eq 'System.Security.Authentication.AuthenticationException') { return 'tls' }
+        if ($ex -is [System.Net.WebException]) {
+            $status = [string]$ex.Status
+            if ($status -in @('TrustFailure', 'SecureChannelFailure')) { return 'tls' }
+            if ($status -in @('NameResolutionFailure', 'ProxyNameResolutionFailure', 'ConnectFailure',
+                    'Timeout', 'ConnectionClosed', 'KeepAliveFailure', 'ReceiveFailure', 'SendFailure',
+                    'PipelineFailure', 'ProtocolError', 'RequestCanceled')) { return 'network' }
+            return 'other'
+        }
+        if ($typeName -eq 'Microsoft.PowerShell.Commands.HttpResponseException') { return 'network' }
+        if ($typeName -eq 'System.Net.Http.HttpRequestException') {
+            if ($ex.InnerException -and $ex.InnerException.GetType().FullName -eq 'System.Security.Authentication.AuthenticationException') { return 'tls' }
+            return 'network'
+        }
+        if ($typeName -in @('System.Net.Sockets.SocketException', 'System.TimeoutException',
+                'System.Threading.Tasks.TaskCanceledException')) { return 'network' }
+        $ex = $ex.InnerException
+        $seen += 1
+    }
+    return 'other'
+}
+
+# Downloads a pinned file. The mirror is tried only after a network-class failure of the upstream
+# URL; whichever origin answered, the bytes must match the pinned SHA-256 or the file is removed
+# and the install stops (download_digest_mismatch) without trying anything else.
+function Invoke-IndusVerifiedDownload {
+    param([string]$Url, [string]$MirrorUrl, [string]$Sha256, [string]$OutFile)
+    if ($Sha256 -notmatch '^[0-9a-fA-F]{64}$') {
+        Stop-IndusStage "no SHA-256 is pinned for $Url; refusing to download it" 'download_failed'
+    }
+    $candidates = @($Url)
+    if ($MirrorUrl -and $MirrorUrl -ne $Url) { $candidates += $MirrorUrl }
+    $lastProblem = ''
+    foreach ($candidate in $candidates) {
+        if (-not $candidate.StartsWith('https://')) {
+            Stop-IndusStage "refusing a download that is not https: $candidate" 'download_failed'
+        }
+        if (Test-Path -LiteralPath $OutFile) { Remove-Item -LiteralPath $OutFile -Force }
+        try {
+            & $script:IndusDownload $candidate $OutFile
+        } catch {
+            $kind = Get-IndusDownloadFailureKind $_
+            if ($kind -ne 'network') {
+                Stop-IndusStage "download of $candidate failed: $($_.Exception.Message)" 'download_failed'
+            }
+            $lastProblem = $_.Exception.Message
+            Write-IndusWarn "could not reach $candidate ($lastProblem)"
+            continue
+        }
+        if (-not (Test-Path -LiteralPath $OutFile)) {
+            $lastProblem = 'no file was written'
+            continue
+        }
+        $digest = Get-IndusFileSha256 $OutFile
+        if ($digest -eq $Sha256.ToLowerInvariant()) { return }
+        Remove-Item -LiteralPath $OutFile -Force -ErrorAction SilentlyContinue
+        Stop-IndusStage "download digest mismatch for $candidate (expected $Sha256, got $digest)" 'download_digest_mismatch'
+    }
+    Stop-IndusStage ("could not download " + ($candidates -join ' or ') + $(if ($lastProblem) { ": $lastProblem" } else { '' })) 'download_failed'
+}
+
+# Runs a program with a time limit, polling on the injectable clock. Returns @{ TimedOut;
+# ExitCode }. On overrun the program and its children are killed by pid.
+function Invoke-IndusBoundedProcess {
+    param([string]$FilePath, [string]$ArgLine, [int]$LimitSeconds)
+    $proc = & $script:IndusStartProcess $FilePath $ArgLine
+    if (-not $proc) { return @{ TimedOut = $false; ExitCode = -1 } }
+    $started = & $script:IndusNow
+    while (-not $proc.HasExited) {
+        $elapsed = ((& $script:IndusNow) - $started).TotalSeconds
+        if ($elapsed -ge $LimitSeconds) {
+            & $script:IndusKillTree $proc.Id | Out-Null
+            try { [void]$proc.WaitForExit(10000) } catch { }
+            return @{ TimedOut = $true; ExitCode = $null }
+        }
+        & $script:IndusSleep $script:IndusPollMilliseconds | Out-Null
+    }
+    return @{ TimedOut = $false; ExitCode = $proc.ExitCode }
+}
+
+function Get-IndusToolsDir {
+    return (Join-Path $script:IndusPaths.Home 'tools')
+}
+
+# Pinned portable Git for this machine: <home>\tools\git-<version>\cmd\git.exe. Downloaded,
+# verified, extracted by its own self-extractor under the 600 s limit into a temp dir, and moved
+# into place only when complete.
+function Get-IndusGit {
+    $target = Get-IndusTarget
+    $pin = Get-IndusPin 'git_for_windows' $target
+    if (-not $pin) { Stop-IndusStage "no pinned Git for $target; this machine is not supported" 'unsupported_platform' }
+    $entry = Join-Path (Get-IndusToolsDir) ('git-' + $pin.Version)
+    $gitExe = Join-Path (Join-Path $entry 'cmd') 'git.exe'
+    if (Test-Path -LiteralPath $gitExe) { return $gitExe }
+    Write-IndusInfo "Installing Git $($pin.Version) ($target)"
+    $work = Get-IndusTempDir 'git'
+    try {
+        New-Item -ItemType Directory -Force -Path $work | Out-Null
+        $archive = Join-Path $work 'portable-git.7z.exe'
+        Invoke-IndusVerifiedDownload -Url $pin.Url -MirrorUrl $pin.MirrorUrl -Sha256 $pin.Sha256 -OutFile $archive
+        $unpacked = Join-Path $work 'unpacked'
+        New-Item -ItemType Directory -Force -Path $unpacked | Out-Null
+        Unblock-File -LiteralPath $archive -ErrorAction SilentlyContinue
+        $run = Invoke-IndusBoundedProcess -FilePath $archive -ArgLine ('-o"' + $unpacked + '" -y') -LimitSeconds $script:IndusGitExtractLimitSeconds
+        if ($run.TimedOut) {
+            Stop-IndusStage "the Git self-extractor did not finish within $($script:IndusGitExtractLimitSeconds) s and was stopped" 'git_extract_failed'
+        }
+        if ($run.ExitCode) {
+            Stop-IndusStage "the Git self-extractor exited $($run.ExitCode) (a full disk, a path that is too long or an antivirus lock are the usual causes)" 'git_extract_failed'
+        }
+        if (-not (Test-Path -LiteralPath (Join-Path (Join-Path $unpacked 'cmd') 'git.exe'))) {
+            Stop-IndusStage 'git.exe is missing from the extracted Git' 'git_extract_failed'
+        }
+        if (Test-Path -LiteralPath $entry) { Remove-Item -LiteralPath $entry -Recurse -Force }
+        New-Item -ItemType Directory -Force -Path (Split-Path -Parent $entry) | Out-Null
+        Move-Item -LiteralPath $unpacked -Destination $entry
+    } finally {
+        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
+    }
+    return $gitExe
+}
+
+# Puts the pinned Git first on this process's PATH (never the user PATH). Every -Stage run is a
+# new process, so each stage that runs git calls this.
+function Use-IndusGit {
+    $gitExe = Get-IndusGit
+    $cmdDir = Split-Path -Parent $gitExe
+    $entries = @($env:Path -split ';' | Where-Object { $_ })
+    $present = $false
+    foreach ($item in $entries) { if (Test-IndusSamePath $item $cmdDir) { $present = $true } }
+    if (-not $present) { $env:Path = $cmdDir + ';' + $env:Path }
+    return $gitExe
+}
+
+function Test-IndusUvRuns([string]$Path) {
+    $global:LASTEXITCODE = 0
+    $said = Invoke-IndusNative { & $Path --version 2>$null }
+    return (-not $LASTEXITCODE) -and [bool]$said
+}
+
+# Pinned uv for this machine: <home>\tools\uv-<version>-<target>\uv.exe, verified and run once.
+function Get-IndusUv {
+    $target = Get-IndusTarget
+    $pin = Get-IndusPin 'uv' $target
+    if (-not $pin) { Stop-IndusStage "no pinned uv for $target; this machine is not supported" 'unsupported_platform' }
+    $entry = Join-Path (Get-IndusToolsDir) ('uv-' + $pin.Version + '-' + $target)
+    $uvExe = Join-Path $entry 'uv.exe'
+    if (Test-Path -LiteralPath $uvExe) {
+        if (Test-IndusUvRuns $uvExe) { return $uvExe }
+        Write-IndusWarn 'the cached uv does not run; fetching it again'
+        Remove-Item -LiteralPath $uvExe -Force
+    }
+    Write-IndusInfo "Installing uv $($pin.Version) ($target)"
+    $work = Get-IndusTempDir 'uv'
+    try {
+        New-Item -ItemType Directory -Force -Path $work | Out-Null
+        $zip = Join-Path $work 'uv.zip'
+        Invoke-IndusVerifiedDownload -Url $pin.Url -MirrorUrl $pin.MirrorUrl -Sha256 $pin.Sha256 -OutFile $zip
+        $unpacked = Join-Path $work 'unpacked'
+        Expand-Archive -LiteralPath $zip -DestinationPath $unpacked -Force
+        $found = Get-ChildItem -LiteralPath $unpacked -Filter 'uv.exe' -Recurse | Select-Object -First 1
+        if (-not $found) { Stop-IndusStage 'uv.exe is missing from the downloaded archive' 'uv_unusable' }
+        New-Item -ItemType Directory -Force -Path $entry | Out-Null
+        Move-Item -LiteralPath $found.FullName -Destination $uvExe -Force
+        $companion = Get-ChildItem -LiteralPath $unpacked -Filter 'uvx.exe' -Recurse | Select-Object -First 1
+        if ($companion) { Move-Item -LiteralPath $companion.FullName -Destination (Join-Path $entry 'uvx.exe') -Force }
+    } finally {
+        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
+    }
+    if (-not (Test-IndusUvRuns $uvExe)) { Stop-IndusStage 'the pinned uv was installed but does not run on this machine' 'uv_unusable' }
+    return $uvExe
+}
+
+# Windows refuses paths over 260 characters unless long paths are switched on; git checkouts
+# get core.longpaths, and a long install path without the system switch gets a warning.
+function Test-IndusLongPathsEnabled {
+    try {
+        $value = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem' -ErrorAction Stop).LongPathsEnabled
+        return ($value -eq 1)
+    } catch {
+        return $false
+    }
+}
+
+function Write-IndusLongPathAdvice {
+    $codeDir = [string]$script:IndusPaths.InstallDir
+    if ($codeDir.Length -gt 80 -and -not (Test-IndusLongPathsEnabled)) {
+        Write-IndusWarn 'Windows long paths are off and the install path is long; some files may fail to unpack.'
+        Write-IndusWarn 'Turn them on (as administrator): Set-ItemProperty HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem LongPathsEnabled 1'
+    }
+}
+
+# The desktop app built in this checkout, or $null.
+function Find-IndusDesktopApp {
+    $release = Join-Path (Join-Path (Join-Path $script:IndusPaths.InstallDir 'apps') 'desktop') 'release'
+    foreach ($folder in @('win-unpacked', 'win-arm64-unpacked')) {
+        $candidate = Join-Path (Join-Path $release $folder) 'Indus.exe'
+        if (Test-Path -LiteralPath $candidate) { return $candidate }
+    }
+    return $null
+}
+
+# Best effort: a shortcut that cannot be made only warns.
+function New-IndusStartMenuShortcut([string]$TargetExe) {
+    try {
+        $programs = [Environment]::GetFolderPath('Programs')
+        if (-not $programs) { Write-IndusWarn 'no Start menu folder; skipping the shortcut'; return }
+        if (-not (Test-Path -LiteralPath $programs)) { New-Item -ItemType Directory -Force -Path $programs | Out-Null }
+        $link = Join-Path $programs 'Indus.lnk'
+        $shell = New-Object -ComObject WScript.Shell
+        $shortcut = $shell.CreateShortcut($link)
+        $shortcut.TargetPath = $TargetExe
+        $shortcut.WorkingDirectory = Split-Path -Parent $TargetExe
+        $shortcut.Description = 'Indus Agent'
+        $shortcut.Save()
+        Write-IndusOk "Start menu entry: $link"
+    } catch {
+        Write-IndusWarn "could not create the Start menu entry: $($_.Exception.Message)"
+    }
+}
+
+# -IncludeDesktop (and -Stage desktop): the desktop build must exist; then the Start menu entry.
+function Invoke-IndusDesktop {
+    $app = Find-IndusDesktopApp
+    if (-not $app) {
+        Stop-IndusStage "no desktop app under $($script:IndusPaths.InstallDir)\apps\desktop\release (win-unpacked or win-arm64-unpacked); build it first" 'products_build_failed'
+    }
+    Write-IndusOk "Desktop app: $app"
+    New-IndusStartMenuShortcut $app
+}
+
+# ---------------------------------------------------------------------------------------------
+# Stages. Same names, order and meaning as install.sh (the shared table is stages.json).
+# ---------------------------------------------------------------------------------------------
+
+$script:IndusStableTag = '^v[0-9]{1,3}\.[0-9]+\.[0-9]+$'
+$script:IndusCanaryTag = '^v[0-9]{1,3}\.[0-9]+\.[0-9]+-canary\.[0-9]{8}T[0-9]{6}Z$'
+$script:IndusBinWasOnPath = $null
+$script:IndusPython = $null
+
+function Get-IndusBranch {
+    if ($script:IndusOpts.Branch) { return [string]$script:IndusOpts.Branch }
+    return 'main'
+}
+
+function Get-IndusVenvIndus {
+    return (Join-Path (Join-Path (Join-Path $script:IndusPaths.InstallDir '.venv') 'Scripts') 'indus.exe')
+}
+
+function Test-IndusEmptyDir([string]$Path) {
+    $item = Get-Item -LiteralPath $Path -Force
+    if (-not $item.PSIsContainer) { return $false }
+    if ($item.LinkType) { return $false }
+    return -not (Get-ChildItem -LiteralPath $Path -Force | Select-Object -First 1)
+}
+
+# -- prerequisites ------------------------------------------------------------------------------
+
+function Invoke-IndusPrerequisites {
+    if (-not (Test-IndusWindows)) {
+        Stop-IndusStage 'install.ps1 installs on Windows; on Linux and macOS run install.sh' 'unsupported_platform'
+    }
+    if ($PSVersionTable.PSVersion.Major -lt 5) {
+        Stop-IndusStage 'Windows PowerShell 5.1 or PowerShell 7 is needed' 'unsupported_platform'
+    }
+    Write-IndusLongPathAdvice
+    Use-IndusGit | Out-Null
+    Write-IndusOk 'prerequisites ready (pinned Git)'
+}
+
+# -- channels -----------------------------------------------------------------------------------
+
+function ConvertFrom-IndusYamlScalar([string]$Text) {
+    $value = ($Text -replace '\s+#.*$', '').Trim()
+    if ($value.Length -ge 2 -and ($value[0] -eq '"' -or $value[0] -eq "'") -and $value[-1] -eq $value[0]) {
+        $value = $value.Substring(1, $value.Length - 2)
+    }
+    return $value
+}
+
+# The install id the updater keys its records by: the first 16 hex digits of the SHA-256 of the
+# checkout's full path.
+function Get-IndusInstallId([string]$CodeDir) {
+    $full = (Get-Item -LiteralPath $CodeDir -Force).FullName.TrimEnd('\', '/')
+    $hasher = [Security.Cryptography.SHA256]::Create()
+    try {
+        $digest = $hasher.ComputeHash([Text.Encoding]::UTF8.GetBytes($full))
+    } finally {
+        $hasher.Dispose()
+    }
+    return (-join ($digest | ForEach-Object { $_.ToString('x2') })).Substring(0, 16)
+}
+
+# update.installs.<id>.<Name> from the home's config.yaml, or ''. A small reader of the block YAML
+# the settings writer produces; anything it cannot read counts as not set.
+function Get-IndusInstallSetting([string]$CodeDir, [string]$Name) {
+    $config = Join-Path $script:IndusPaths.Home 'config.yaml'
+    if (-not (Test-Path -LiteralPath $config)) { return '' }
+    try {
+        $id = Get-IndusInstallId $CodeDir
+        $lines = [IO.File]::ReadAllLines($config)
+    } catch {
+        return ''
+    }
+    $stack = New-Object 'System.Collections.Generic.List[object]'
+    foreach ($line in $lines) {
+        if ($line -match '^\s*(#|$)') { continue }
+        if ($line -notmatch '^( *)([^:#]+):(.*)$') { continue }
+        $indent = $Matches[1].Length
+        $key = ConvertFrom-IndusYamlScalar $Matches[2]
+        $value = ConvertFrom-IndusYamlScalar $Matches[3]
+        while ($stack.Count -gt 0 -and $stack[$stack.Count - 1].Indent -ge $indent) { $stack.RemoveAt($stack.Count - 1) }
+        $stack.Add([pscustomobject]@{ Indent = $indent; Key = $key })
+        if ($stack.Count -eq 4 -and $stack[0].Key -ceq 'update' -and $stack[1].Key -ceq 'installs' -and
+            $stack[2].Key -ceq $id -and $key -ceq $Name) {
+            return $value
+        }
+    }
+    return ''
+}
+
+# The channel saved for this checkout (update.installs.<id>.channel), or ''.
+function Get-IndusSavedChannel([string]$CodeDir) {
+    $value = Get-IndusInstallSetting $CodeDir 'channel'
+    if ($script:IndusChannels -ccontains $value) { return $value }
+    return ''
+}
+
+function Test-IndusOfficialOrigin([string]$Origin) {
+    $official = (Get-IndusRepository) -replace '\.git$', ''
+    $given = ($Origin.Trim().TrimEnd('/')) -replace '\.git$', ''
+    return [string]::Equals($given, $official, [StringComparison]::OrdinalIgnoreCase)
+}
+
+# Stable for the official repository's main line; main for forks, other branches and pins.
+function Get-IndusDefaultChannel([string]$Origin) {
+    if ($script:IndusOpts.Commit) { return 'main' }
+    if ((Get-IndusBranch) -ne 'main') { return 'main' }
+    if (Test-IndusOfficialOrigin $Origin) { return 'stable' }
+    return 'main'
+}
+
+# -Channel, else the checkout's saved choice (an existing checkout keeps it), else the default.
+function Get-IndusEffectiveChannel([string]$CodeDir, [string]$Origin) {
+    if ($script:IndusOpts.Channel) { return [string]$script:IndusOpts.Channel }
+    if (-not $script:IndusOpts.Commit -and (Test-Path -LiteralPath (Join-Path $CodeDir '.git'))) {
+        $saved = Get-IndusSavedChannel $CodeDir
+        if ($saved) { return $saved }
+    }
+    return (Get-IndusDefaultChannel $Origin)
+}
+
+# A sortable key for vX.Y.Z and vX.Y.Z-canary.<stamp>: a canary sorts below its own release.
+function Get-IndusTagKey([string]$Tag) {
+    $core = $Tag.Substring(1)
+    $stamp = ''
+    $release = '1'
+    $dash = $core.IndexOf('-')
+    if ($dash -ge 0) {
+        $stamp = $core.Substring($dash + 1)
+        $core = $core.Substring(0, $dash)
+        $release = '0'
+    }
+    $parts = $core.Split('.')
+    return ('{0:D6}.{1:D9}.{2:D9}.{3}.{4}' -f [int]$parts[0], [long]$parts[1], [long]$parts[2], $release, $stamp)
+}
+
+function Get-IndusRemoteTags([string]$Origin) {
+    $tags = @()
+    foreach ($line in @(Invoke-IndusNative { git ls-remote --tags --refs $Origin 'refs/tags/v*' 2>$null })) {
+        $name = ("$line" -replace '^.*refs/tags/', '').Trim()
+        if ($name) { $tags += $name }
+    }
+    return $tags
+}
+
+function Select-IndusNewestTag([string[]]$Tags) {
+    $best = ''
+    $bestKey = ''
+    foreach ($tag in $Tags) {
+        $tagKey = Get-IndusTagKey $tag
+        if (-not $best -or [string]::CompareOrdinal($tagKey, $bestKey) -gt 0) {
+            $best = $tag
+            $bestKey = $tagKey
+        }
+    }
+    return $best
+}
+
+# The newest published vX.Y.Z: the GitHub API, then the releases/latest redirect, then the
+# remote's tags. '' when none answers.
+function Get-IndusLatestStable([string]$Origin) {
+    $tag = ''
+    if (Test-IndusOfficialOrigin $Origin) {
+        $repository = Get-IndusRepository
+        $slug = $repository -replace '^https://github\.com/', ''
+        try {
+            $answer = Invoke-RestMethod -Uri "https://api.github.com/repos/$slug/releases/latest" -TimeoutSec 20 `
+                -Headers @{ Accept = 'application/vnd.github+json'; 'User-Agent' = 'indus-installer' }
+            $tag = [string]$answer.tag_name
+        } catch {
+            $tag = ''
+        }
+        if ($tag -cnotmatch $script:IndusStableTag) {
+            $tag = ''
+            try {
+                $request = [Net.HttpWebRequest]::Create("$repository/releases/latest")
+                $request.Method = 'HEAD'
+                $request.AllowAutoRedirect = $false
+                $request.Timeout = 20000
+                $request.UserAgent = 'indus-installer'
+                $response = $request.GetResponse()
+                try {
+                    if ([string]$response.Headers['Location'] -match '/releases/tag/([^/]+)$') { $tag = $Matches[1] }
+                } finally {
+                    $response.Close()
+                }
+            } catch {
+                $tag = ''
+            }
+        }
+    }
+    if ($tag -cnotmatch $script:IndusStableTag) {
+        $tag = Select-IndusNewestTag @(Get-IndusRemoteTags $Origin | Where-Object { $_ -cmatch $script:IndusStableTag })
+    }
+    if ($tag -cmatch $script:IndusStableTag) { return $tag }
+    return ''
+}
+
+# The newest canary, or a newer stable when one exists (canary users are never stranded).
+function Get-IndusLatestCanary([string]$Origin) {
+    $tags = @(Get-IndusRemoteTags $Origin | Where-Object { $_ -cmatch $script:IndusCanaryTag -or $_ -cmatch $script:IndusStableTag })
+    return (Select-IndusNewestTag $tags)
+}
+
+# '' = follow the branch; a tag = install that release; '-' = a release applies but none answered.
+function Resolve-IndusRelease([string]$Origin, [string]$ChosenChannel) {
+    if ($script:IndusOpts.Commit -or $ChosenChannel -eq 'main') { return '' }
+    if ($ChosenChannel -eq 'canary') {
+        $tag = Get-IndusLatestCanary $Origin
+    } else {
+        $tag = Get-IndusLatestStable $Origin
+    }
+    if ($tag) { return $tag }
+    return '-'
+}
+
+# -- repository ---------------------------------------------------------------------------------
+
+function Invoke-IndusRepository {
+    $codeDir = $script:IndusPaths.InstallDir
+    $gitDir = Join-Path $codeDir '.git'
+    if ((Test-Path -LiteralPath $codeDir) -and -not (Test-Path -LiteralPath $gitDir)) {
+        if (-not (Test-IndusEmptyDir $codeDir)) {
+            Stop-IndusStage "$codeDir exists and is not an Indus Agent checkout; move it aside, or install elsewhere with -InstallDir <path>" 'dir_not_checkout'
+        }
+    }
+    Use-IndusGit | Out-Null
+    if (Test-Path -LiteralPath $gitDir) {
+        Invoke-IndusNative { git -C $codeDir rev-parse --verify HEAD 2>$null } | Out-Null
+        if ($LASTEXITCODE) {
+            $aside = $codeDir + '.broken-' + (Get-IndusCompactStamp)
+            Write-IndusWarn "$codeDir has no commits (an interrupted clone); moving it aside to $aside"
+            Move-Item -LiteralPath $codeDir -Destination $aside
+        }
+    }
+    if (Test-Path -LiteralPath $gitDir) {
+        Update-IndusCheckout $codeDir
+    } else {
+        New-IndusCheckout $codeDir
+    }
+}
+
+function Receive-IndusTag([string]$Tree, [string]$Tag) {
+    Invoke-IndusLogged "Fetching $Tag" { git -C $Tree fetch origin "+refs/tags/${Tag}:refs/tags/${Tag}" } -MayFail
+    return (-not $LASTEXITCODE)
+}
+
+# A fresh install: clone into a sibling staging dir and move it into place only when the files
+# are checked out, so an interrupted clone never leaves a half checkout behind.
+function New-IndusCheckout([string]$CodeDir) {
+    if (Test-Path -LiteralPath $CodeDir) { Remove-Item -LiteralPath $CodeDir -Force }
+    $parentDir = Split-Path -Parent $CodeDir
+    New-Item -ItemType Directory -Force -Path $parentDir | Out-Null
+    $url = Get-IndusCloneUrl
+    $branch = Get-IndusBranch
+    $pin = [string]$script:IndusOpts.Commit
+    $chosen = Get-IndusEffectiveChannel $CodeDir $url
+    $release = Resolve-IndusRelease $url $chosen
+    if ($release -eq '-') {
+        Stop-IndusStage "could not look up the latest $chosen release; rerun to retry, or pass -Channel main to install the branch tip" 'git_fetch_failed'
+    }
+    if ($release) { Write-IndusInfo "Installing $release ($chosen channel)" }
+    $staging = Join-Path $parentDir ('.indus-clone-' + $PID + '-' + (Get-Random))
+    $tree = Join-Path $staging 'tree'
+    $noCheckout = @()
+    if ($pin -or $release) { $noCheckout = @('--no-checkout') }
+    New-Item -ItemType Directory -Force -Path $staging | Out-Null
+    try {
+        $cloned = $false
+        $deferred = $false
+        foreach ($attempt in 1..3) {
+            Invoke-IndusLogged "Cloning $url ($branch), attempt $attempt of 3" {
+                git clone --config core.longpaths=true --filter=blob:none @noCheckout --branch $branch $url $tree
+            } -MayFail
+            if (-not $LASTEXITCODE) { $cloned = $true; break }
+            Remove-Item -LiteralPath $tree -Recurse -Force -ErrorAction SilentlyContinue
+            if ($attempt -lt 3) { & $script:IndusSleep ($attempt * 5000) | Out-Null }
+        }
+        if (-not $cloned) {
+            Write-IndusWarn 'the clone failed three times; trying once more without checking out files'
+            Invoke-IndusLogged 'Cloning the history only' {
+                git clone --config core.longpaths=true --filter=blob:none --no-checkout --branch $branch $url $tree
+            } -MayFail
+            if (-not $LASTEXITCODE) { $cloned = $true; $deferred = $true }
+        }
+        if (-not $cloned) { Stop-IndusStage "git clone failed; nothing was installed$(Get-IndusNativeDetail)" 'git_clone_failed' }
+        if ($pin) {
+            Invoke-IndusNative { git -C $tree merge-base --is-ancestor $pin "origin/$branch" 2>$null } | Out-Null
+            if ($LASTEXITCODE) { Stop-IndusStage "commit $pin is not on branch $branch" 'commit_not_on_branch' }
+        }
+        if ($release -and -not (Receive-IndusTag $tree $release)) {
+            Stop-IndusStage "could not fetch $release$(Get-IndusNativeDetail)" 'git_fetch_failed'
+        }
+        if ($pin -or $release -or $deferred) {
+            $detachAt = $pin
+            if (-not $detachAt) { $detachAt = $release }
+            $materialised = $false
+            foreach ($attempt in 1..2) {
+                if ($detachAt) {
+                    Invoke-IndusLogged "Checking out $detachAt" { git -C $tree checkout --force --detach $detachAt } -MayFail
+                } else {
+                    Invoke-IndusLogged 'Checking out the files' { git -C $tree reset --hard HEAD } -MayFail
+                }
+                if (-not $LASTEXITCODE) { $materialised = $true; break }
+                if ($attempt -lt 2) { & $script:IndusSleep 5000 | Out-Null }
+            }
+            if (-not $materialised) {
+                Stop-IndusStage "could not check out the files; nothing was installed$(Get-IndusNativeDetail)" 'git_checkout_failed'
+            }
+        }
+        Move-Item -LiteralPath $tree -Destination $CodeDir
+        Write-IndusOk "Indus Agent cloned into $CodeDir"
+    } finally {
+        Remove-Item -LiteralPath $staging -Recurse -Force -ErrorAction SilentlyContinue
+    }
+}
+
+# Parks local work before anything moves: unmerged index entries are cleared first (stash refuses
+# them), then everything goes into a stash with a findable label.
+function Save-IndusLocalChanges([string]$CodeDir, [string]$Stamp) {
+    $dirty = Invoke-IndusNative { git -C $CodeDir status --porcelain 2>$null }
+    if (-not $dirty) { return }
+    $unmerged = Invoke-IndusNative { git -C $CodeDir ls-files --unmerged 2>$null }
+    if ($unmerged) {
+        Write-IndusWarn 'clearing unmerged index entries left by an earlier conflict'
+        Invoke-IndusNative { git -C $CodeDir reset -q 2>&1 } | Out-Null
+        if ($LASTEXITCODE) { Stop-IndusStage "could not clear the unmerged index in $CodeDir" 'local_changes_blocked' }
+    }
+    $label = 'indus-install-autostash-' + $Stamp
+    Invoke-IndusLogged 'Stashing local changes' { git -C $CodeDir stash push --include-untracked -m $label } -MayFail
+    if ($LASTEXITCODE) {
+        Stop-IndusStage "could not stash the local changes in $CodeDir; commit or move them, then rerun" 'local_changes_blocked'
+    }
+    Write-IndusWarn "local changes stashed as $label (see: git stash list)"
+}
+
+# An existing checkout: a release channel only moves forward onto its newest release (any other
+# move is `indus update`'s); main fast-forwards, and a diverged history is reset only after its
+# commits are saved under refs/indus/install-backups/<stamp>.
+function Update-IndusCheckout([string]$CodeDir) {
+    Invoke-IndusNative { git -C $CodeDir config core.longpaths true 2>&1 } | Out-Null
+    if ($env:INDUS_REPO_URL) {
+        $cloneUrl = Get-IndusCloneUrl
+        Invoke-IndusNative { git -C $CodeDir remote set-url origin $cloneUrl 2>&1 } | Out-Null
+        if ($LASTEXITCODE) { Stop-IndusStage "could not point origin at $cloneUrl" 'git_fetch_failed' }
+    }
+    $origin = ([string](Invoke-IndusNative { git -C $CodeDir config --get remote.origin.url 2>$null })).Trim()
+    $asked = [string]$script:IndusOpts.Channel
+    $chosen = Get-IndusEffectiveChannel $CodeDir $origin
+    $branch = Get-IndusBranch
+    $pin = [string]$script:IndusOpts.Commit
+    $stamp = Get-IndusCompactStamp
+    $release = Resolve-IndusRelease $origin $chosen
+    if ($release -eq '-') {
+        if (-not $asked) {
+            Write-IndusWarn "could not look up the latest $chosen release; keeping the checkout where it is"
+            return
+        }
+        Stop-IndusStage "could not look up the latest $chosen release; rerun to retry, or pass -Channel main" 'git_fetch_failed'
+    }
+    if ($release) {
+        if (-not (Receive-IndusTag $CodeDir $release)) {
+            if (-not $asked) { Write-IndusWarn "could not fetch $release; keeping the checkout where it is"; return }
+            Stop-IndusStage "could not fetch $release$(Get-IndusNativeDetail)" 'git_fetch_failed'
+        }
+        Invoke-IndusNative { git -C $CodeDir merge-base --is-ancestor $release HEAD 2>$null } | Out-Null
+        if (-not $LASTEXITCODE) {
+            Write-IndusInfo "Keeping the checkout: it already has $release (indus update moves it on)"
+            return
+        }
+        Invoke-IndusNative { git -C $CodeDir merge-base --is-ancestor HEAD $release 2>$null } | Out-Null
+        if ($LASTEXITCODE) {
+            Write-IndusInfo "Keeping the checkout: $release does not descend from it (indus update decides that move)"
+            return
+        }
+        Save-IndusLocalChanges $CodeDir $stamp
+        Invoke-IndusLogged "Checking out $release" { git -C $CodeDir checkout --detach $release }
+        if ($LASTEXITCODE) { Stop-IndusStage "git checkout failed$(Get-IndusNativeDetail)" 'git_checkout_failed' }
+        return
+    }
+    Invoke-IndusLogged "Fetching origin/$branch" { git -C $CodeDir fetch origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" }
+    if ($LASTEXITCODE) { Stop-IndusStage "git fetch failed$(Get-IndusNativeDetail)" 'git_fetch_failed' }
+    Save-IndusLocalChanges $CodeDir $stamp
+    Invoke-IndusNative { git -C $CodeDir show-ref --verify --quiet "refs/heads/$branch" 2>$null } | Out-Null
+    if ($LASTEXITCODE) {
+        Invoke-IndusLogged "Checking out $branch" { git -C $CodeDir checkout -b $branch "origin/$branch" }
+    } else {
+        Invoke-IndusLogged "Checking out $branch" { git -C $CodeDir checkout $branch }
+    }
+    if ($LASTEXITCODE) { Stop-IndusStage "git checkout failed$(Get-IndusNativeDetail)" 'git_checkout_failed' }
+    Invoke-IndusLogged "Fast-forwarding to origin/$branch" { git -C $CodeDir merge --ff-only --no-stat "origin/$branch" } -MayFail
+    if ($LASTEXITCODE) {
+        $ahead = ([string](Invoke-IndusNative { git -C $CodeDir rev-list --count "origin/$branch..HEAD" 2>$null })).Trim()
+        if ($LASTEXITCODE -or $ahead -notmatch '^[0-9]+$') { Stop-IndusStage 'could not count the local commits before the reset' 'git_reset_failed' }
+        if ([int]$ahead -gt 0) {
+            $backup = 'refs/indus/install-backups/' + $stamp
+            Invoke-IndusNative { git -C $CodeDir update-ref $backup HEAD 2>&1 } | Out-Null
+            if ($LASTEXITCODE) { Stop-IndusStage "could not save $ahead local commit(s); refusing to reset" 'git_reset_failed' }
+            Write-IndusWarn "$ahead commit(s) not on origin/$branch saved as $backup"
+        }
+        Invoke-IndusLogged "Resetting to origin/$branch" { git -C $CodeDir reset --hard "origin/$branch" }
+        if ($LASTEXITCODE) { Stop-IndusStage "git reset failed$(Get-IndusNativeDetail)" 'git_reset_failed' }
+        Write-IndusWarn "the checkout could not fast-forward; it now matches origin/$branch"
+    }
+    if ($pin) {
+        Invoke-IndusNative { git -C $CodeDir merge-base --is-ancestor $pin "origin/$branch" 2>$null } | Out-Null
+        if ($LASTEXITCODE) { Stop-IndusStage "commit $pin is not on branch $branch" 'commit_not_on_branch' }
+        Invoke-IndusLogged "Pinning $pin" { git -C $CodeDir checkout --detach $pin }
+        if ($LASTEXITCODE) { Stop-IndusStage "could not check out $pin$(Get-IndusNativeDetail)" 'git_checkout_failed' }
+    }
+}
+
+# -- runtime and dependencies -------------------------------------------------------------------
+
+# Python from uv: an existing 3.13/3.14 is accepted, else the pinned minor is downloaded.
+function Get-IndusPython {
+    if ($script:IndusPython) { return $script:IndusPython }
+    $uv = Get-IndusUv
+    $pins = Get-IndusPins
+    $minor = '3.14'
+    $floor = '3.13'
+    if ($pins.python -and $pins.python.provision) { $minor = [string]$pins.python.provision }
+    if ($pins.python -and $pins.python.minor) { $minor = [string]$pins.python.minor }
+    if ($pins.python -and $pins.python.floor) { $floor = [string]$pins.python.floor }
+    $minorParts = $minor.Split('.')
+    $ceiling = $minorParts[0] + '.' + ([int]$minorParts[1] + 1)
+    $wanted = ">=$floor,<$ceiling"
+    $found = (Invoke-IndusNative -Utf8 { & $uv python find --no-project $wanted 2>$null }) -join ''
+    if ($LASTEXITCODE -or -not $found) {
+        $request = $minor
+        if ((Get-IndusArch) -eq 'arm64') { $request = "cpython-$minor-windows-aarch64-none" }
+        Invoke-IndusLogged "Downloading Python $minor" { & $uv python install $request }
+        if ($LASTEXITCODE) { Stop-IndusStage "Python $minor could not be installed$(Get-IndusNativeDetail)" 'python_install_failed' }
+        $found = (Invoke-IndusNative -Utf8 { & $uv python find --no-project $request 2>$null }) -join ''
+    }
+    if ($LASTEXITCODE -or -not $found) { Stop-IndusStage 'uv found no usable Python' 'python_install_failed' }
+    $script:IndusPython = $found.Trim()
+    return $script:IndusPython
+}
+
+function Invoke-IndusRuntime {
+    $uv = Get-IndusUv
+    $python = Get-IndusPython
+    Write-IndusOk "uv ($uv) and Python ($python) ready"
+}
+
+# The tools left out: this run's skip flags plus the ones saved by earlier runs
+# (update.installs.<id>.skip, words "browser" and "computer-use", comma separated).
+function Get-IndusChoices {
+    $saved = ''
+    if (Test-Path -LiteralPath (Join-Path $script:IndusPaths.InstallDir '.git')) {
+        $saved = Get-IndusInstallSetting $script:IndusPaths.InstallDir 'skip'
+    }
+    $words = @($saved -split '[,\s]+' | Where-Object { $_ })
+    return @{
+        skip_browser      = [bool]$script:IndusOpts.SkipBrowser -or ($words -ccontains 'browser')
+        skip_computer_use = [bool]$script:IndusOpts.SkipComputerUse -or ($words -ccontains 'computer-use')
+    }
+}
+
+function Get-IndusSkipWords($Choices) {
+    $words = @()
+    if ($Choices.skip_browser) { $words += 'browser' }
+    if ($Choices.skip_computer_use) { $words += 'computer-use' }
+    return ($words -join ',')
+}
+
+function Get-IndusExtras($Choices) {
+    $table = $script:IndusStages.extras
+    $extras = @($table.always)
+    if (-not $Choices.skip_browser) { $extras += @($table.unless_skip_browser) }
+    if (-not $Choices.skip_computer_use) { $extras += @($table.unless_skip_computer_use) }
+    return @($extras | Where-Object { $_ })
+}
+
+function Get-IndusVenvPython {
+    return (Join-Path (Join-Path (Join-Path $script:IndusPaths.InstallDir '.venv') 'Scripts') 'python.exe')
+}
+
+function Invoke-IndusDependencies {
+    if (-not (Test-Path -LiteralPath (Join-Path $script:IndusPaths.InstallDir 'uv.lock'))) {
+        Stop-IndusStage "$($script:IndusPaths.InstallDir) has no uv.lock; run the repository stage first" 'deps_install_failed'
+    }
+    $uv = Get-IndusUv
+    $python = Get-IndusPython
+    $choices = Get-IndusChoices
+    $syncArgs = @('sync', '--frozen', '--no-dev', '--python', $python)
+    foreach ($extra in (Get-IndusExtras $choices)) { $syncArgs += @('--extra', $extra) }
+    Push-Location -LiteralPath $script:IndusPaths.InstallDir
+    try {
+        Invoke-IndusLogged 'Installing Python dependencies (locked)' { & $uv @syncArgs }
+        $code = $LASTEXITCODE
+    } finally {
+        Pop-Location
+    }
+    if ($code) { Stop-IndusStage "dependency install failed$(Get-IndusNativeDetail)" 'deps_install_failed' }
+    if (-not (Test-Path -LiteralPath (Get-IndusVenvIndus))) {
+        Stop-IndusStage 'the indus command is missing after the install' 'deps_install_failed'
+    }
+    $skipped = Get-IndusSkipWords $choices
+    if ($skipped) { Write-IndusInfo "left out: $skipped" }
+    Write-IndusOk 'dependencies installed'
+}
+
+# -- config -------------------------------------------------------------------------------------
+
+# The installed package makes the home skeleton and seeds config.yaml itself (the same writer
+# `indus config edit` uses), so the installer never duplicates the layout.
+$script:IndusSeedPy = @'
+import sys
+from pathlib import Path
+
+from indus.cli.commands.config_read import seed_config
+from indus.foundation.layout import ensure_home
+from indus.foundation.scope import make_scope
+
+scope = make_scope(Path(sys.argv[1]))
+ensure_home(scope)
+seed_config(scope)
+'@
+
+function Invoke-IndusConfig {
+    $homeDir = $script:IndusPaths.Home
+    $python = Get-IndusVenvPython
+    if (-not (Test-Path -LiteralPath $python)) {
+        Stop-IndusStage 'the Python environment is missing; run the dependencies stage first' 'deps_install_failed'
+    }
+    $seed = $script:IndusSeedPy
+    Invoke-IndusLogged "Preparing $homeDir" { & $python -I -c $seed $homeDir }
+    if ($LASTEXITCODE) { Stop-IndusStage "could not prepare $homeDir$(Get-IndusNativeDetail)" 'config_failed' }
+    $envFile = Join-Path $homeDir '.env'
+    try {
+        if (-not (Test-Path -LiteralPath $envFile)) { New-Item -ItemType File -Path $envFile | Out-Null }
+    } catch {
+        Stop-IndusStage "could not create $envFile" 'config_failed'
+    }
+    if ($script:IndusOpts.SkipBrowser -or $script:IndusOpts.SkipComputerUse) {
+        $skipped = Get-IndusSkipWords (Get-IndusChoices)
+        $id = Get-IndusInstallId $script:IndusPaths.InstallDir
+        $indusExe = Get-IndusVenvIndus
+        Invoke-IndusLogged "Saving update.installs.$id.skip" { & $indusExe config set --force "update.installs.$id.skip" $skipped } -MayFail
+        if ($LASTEXITCODE) { Write-IndusWarn "could not save the skip choices ($skipped); later updates may install them" }
+    }
+    Write-IndusOk "settings ready in $homeDir"
+}
+
+# -- products -----------------------------------------------------------------------------------
+
+function Add-IndusUserPath([string]$Dir) {
+    $key = $null
+    try {
+        $key = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
+    } catch {
+        $key = $null
+    }
+    if (-not $key) {
+        Write-IndusWarn "could not open the user environment; add $Dir to PATH yourself"
+    } else {
+        try {
+            $raw = [string]$key.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
+            $parts = @($raw -split ';' | Where-Object { $_ })
+            $present = $false
+            foreach ($part in $parts) {
+                if (Test-IndusSamePath ([Environment]::ExpandEnvironmentVariables($part)) $Dir) { $present = $true }
+            }
+            if (-not $present) {
+                $kind = [Microsoft.Win32.RegistryValueKind]::ExpandString
+                try { $kind = $key.GetValueKind('Path') } catch { $kind = [Microsoft.Win32.RegistryValueKind]::ExpandString }
+                $key.SetValue('Path', ((@($Dir) + $parts) -join ';'), $kind)
+                # Unsetting an unused name announces the change to windows started from now on.
+                [Environment]::SetEnvironmentVariable('INDUS_PATH_REFRESH', $null, 'User')
+                Write-IndusOk "added $Dir to your user PATH (new terminals pick it up)"
+            }
+        } finally {
+            $key.Close()
+        }
+    }
+    $onPath = $false
+    foreach ($item in @($env:Path -split ';' | Where-Object { $_ })) { if (Test-IndusSamePath $item $Dir) { $onPath = $true } }
+    if ($null -eq $script:IndusBinWasOnPath) { $script:IndusBinWasOnPath = $onPath }
+    if (-not $onPath) { $env:Path = $Dir + ';' + $env:Path }
+}
+
+# <home>\bin\indus.cmd runs the environment's indus.exe; the uninstaller recognises it by the path
+# it names.
+function Publish-IndusLauncher {
+    $target = Get-IndusVenvIndus
+    if (-not (Test-Path -LiteralPath $target)) {
+        Stop-IndusStage "the environment has no indus command ($target); run the dependencies stage first" 'products_build_failed'
+    }
+    $binDir = Join-Path $script:IndusPaths.Home 'bin'
+    New-Item -ItemType Directory -Force -Path $binDir | Out-Null
+    $launcher = Join-Path $binDir 'indus.cmd'
+    $text = "@echo off`r`nrem indus launcher written by install.ps1 for $target`r`n`"$target`" %*`r`n"
+    $encoding = [Text.Encoding]::ASCII
+    try { $encoding = [Text.Encoding]::GetEncoding([Globalization.CultureInfo]::CurrentCulture.TextInfo.OEMCodePage) } catch { $encoding = [Text.Encoding]::ASCII }
+    [IO.File]::WriteAllText($launcher, $text, $encoding)
+    Add-IndusUserPath $binDir
+    Write-IndusOk "indus command: $launcher"
+}
+
+function Invoke-IndusProducts {
+    Publish-IndusLauncher
+    if ($script:IndusOpts.IncludeDesktop) { Invoke-IndusDesktop }
+}
+
+# -- setup and gateway --------------------------------------------------------------------------
+
+function Invoke-IndusSetup {
+    if (-not (Test-IndusConsole)) {
+        Write-IndusInfo 'No console to answer questions; run `indus setup` later.'
+        return
+    }
+    $indusExe = Get-IndusVenvIndus
+    Invoke-IndusNative { & $indusExe setup }
+    if ($LASTEXITCODE) { Stop-IndusStage "indus setup failed (exit $LASTEXITCODE)" 'setup_failed' }
+}
+
+function Write-IndusWslNote {
+    Write-IndusInfo 'On Windows this install runs the desktop app. The indus CLI, TUI and the messaging gateway are'
+    Write-IndusInfo 'supported through WSL2: open a WSL terminal and run the install.sh command there.'
+}
+
+# Native Windows has no gateway service in 1.0; the gateway runs under WSL2.
+function Invoke-IndusGateway {
+    Write-IndusInfo 'The messaging gateway runs under WSL2 on Windows; nothing to set up here.'
+}
+
+# -- complete -----------------------------------------------------------------------------------
+
+function Invoke-IndusComplete {
+    Use-IndusGit | Out-Null
+    $codeDir = $script:IndusPaths.InstallDir
+    $head = ([string](Invoke-IndusNative { git -C $codeDir rev-parse HEAD 2>$null })).Trim()
+    if ($LASTEXITCODE -or -not $head) { Stop-IndusStage "could not read the installed commit in $codeDir" 'other' }
+    $origin = ([string](Invoke-IndusNative { git -C $codeDir config --get remote.origin.url 2>$null })).Trim()
+    $record = [ordered]@{
+        schema       = 1
+        commit       = $head
+        branch       = Get-IndusBranch
+        channel      = Get-IndusEffectiveChannel $codeDir $origin
+        completed_at = Get-IndusUtcStamp
+    }
+    $marker = Join-Path $codeDir '.indus-bootstrap.json'
+    $tmpFile = $marker + '.tmp'
+    [IO.File]::WriteAllText($tmpFile, ($record | ConvertTo-Json -Compress), (New-Object System.Text.UTF8Encoding($false)))
+    Move-Item -LiteralPath $tmpFile -Destination $marker -Force
+    Write-IndusOk "Indus Agent installed at $codeDir ($head)"
+    Write-IndusWslNote
+}
+
+function Invoke-IndusStage([string]$Name) {
+    switch -CaseSensitive ($Name) {
+        'prerequisites' { Invoke-IndusPrerequisites }
+        'repository' { Invoke-IndusRepository }
+        'runtime' { Invoke-IndusRuntime }
+        'dependencies' { Invoke-IndusDependencies }
+        'config' { Invoke-IndusConfig }
+        'products' { Invoke-IndusProducts }
+        'setup' { Invoke-IndusSetup }
+        'gateway' { Invoke-IndusGateway }
+        'complete' { Invoke-IndusComplete }
+        'desktop' { Invoke-IndusDesktop }
+        default { Stop-IndusStage "unknown stage: $Name" 'other' }
+    }
+}
+
+# ---------------------------------------------------------------------------------------------
+# Entry: one stage, the manifest, the resolved paths, or the whole ladder.
+# ---------------------------------------------------------------------------------------------
+
+function Invoke-IndusSingleStage([string]$Name) {
+    $def = Get-IndusStageDef $Name
+    $known = [bool]$def -or (@($script:IndusStages.dispatch_only) -ccontains $Name)
+    $asJson = [bool]$script:IndusOpts.Json
+    if (-not $known) {
+        if ($asJson) { Write-IndusFrame $false $Name $false "unknown stage: $Name" } else { Write-IndusError "unknown stage: $Name" }
+        return 2
+    }
+    if ($def -and $def.needs_user_input -and (Test-IndusNonInteractive)) {
+        if ($asJson) { Write-IndusFrame $true $Name $true 'needs user input' } else { Write-IndusInfo "Skipping ${Name}: needs user input" }
+        return 0
+    }
+    try {
+        Assert-IndusLayout
+        Invoke-IndusStage $Name | Out-Null
+    } catch {
+        Write-IndusError "$_"
+        if ($asJson) { Write-IndusFrame $false $Name $false "$_" }
+        return 1
+    }
+    if ($asJson) { Write-IndusFrame $true $Name $false }
+    return 0
+}
+
+function Write-IndusClosingNotes {
+    if ($script:IndusRunAsFile -and $script:IndusBinWasOnPath -eq $false) {
+        Write-IndusInfo 'Open a new terminal to use indus (this window keeps the PATH it started with).'
+    }
+}
+
+# The full ladder, with exactly one receipt: success, failed (with the stage and its class), or
+# interrupted from the finally block when Ctrl-C stopped the run (a no-op after an outcome).
+function Invoke-IndusLadder {
+    $script:IndusRunId = [guid]::NewGuid().ToString('N')
+    $script:IndusStartedAt = Get-IndusUtcStamp
+    $script:IndusReceiptWritten = $false
+    $script:IndusCurrentStage = 'prerequisites'
+    $outcome = 1
+    try {
+        Assert-IndusLayout
+        Write-Host ''
+        Write-Host 'Indus Agent installer'
+        Write-Host ''
+        foreach ($def in @($script:IndusStages.stages)) {
+            $script:IndusCurrentStage = [string]$def.name
+            $script:IndusFailureClass = ''
+            if ($def.needs_user_input -and (Test-IndusNonInteractive)) {
+                Write-IndusInfo "Skipping $($def.name): needs user input"
+                continue
+            }
+            Invoke-IndusStage ([string]$def.name) | Out-Null
+        }
+        Write-IndusReceipt 'success' | Out-Null
+        Write-IndusClosingNotes
+        $outcome = 0
+    } catch {
+        Write-IndusReceipt 'failed' $script:IndusCurrentStage (Get-IndusFailureClass) | Out-Null
+        Write-IndusError "$_"
+        $outcome = 1
+    } finally {
+        Write-IndusReceipt 'failed' $script:IndusCurrentStage 'interrupted' | Out-Null
+    }
+    return $outcome
+}
+
+function Invoke-IndusEntry {
+    $ErrorActionPreference = 'Stop'
+    $problem = ConvertFrom-IndusArgs $script:IndusRest
+    if ($problem) {
+        Write-IndusError $problem.Message
+        Write-IndusError 'run with -h for the options'
+        $script:IndusExitCode = [int]$problem.Code
+        return
+    }
+    if ($script:IndusOpts.Help) {
+        Write-IndusUsage
+        $script:IndusExitCode = 0
+        return
+    }
+    $channelProblem = Resolve-IndusChannel
+    if ($channelProblem) {
+        Write-IndusError $channelProblem
+        $script:IndusExitCode = 2
+        return
+    }
+    if ($script:IndusOpts.Manifest) {
+        Write-IndusJsonLine (Get-IndusManifestJson)
+        $script:IndusExitCode = 0
+        return
+    }
+    Initialize-IndusPaths
+    if ($script:IndusOpts.ShowResolvedPaths) {
+        Write-IndusJsonLine ($script:IndusPaths.Report | ConvertTo-Json -Depth 5 -Compress)
+        $script:IndusExitCode = 0
+        return
+    }
+    $env:UV_NO_CONFIG = '1'
+    if ($script:IndusOpts.Verbose) { $env:INDUS_INSTALL_VERBOSE = '1' }
+    try {
+        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
+    } catch {
+        Write-Verbose 'TLS 1.2 is already the default here'
+    }
+    if ($script:IndusOpts.Stage) {
+        $script:IndusExitCode = [int](@(Invoke-IndusSingleStage ([string]$script:IndusOpts.Stage)) | Select-Object -Last 1)
+        return
+    }
+    $script:IndusExitCode = [int](@(Invoke-IndusLadder) | Select-Object -Last 1)
+}
+
+# Dot-sourced: definitions only. A script file exits with the code; text run through iex or a
+# scriptblock leaves it in $LASTEXITCODE so the person's window stays open.
+if (-not $script:IndusDotSourced) {
+    Invoke-IndusEntry | Out-Null
+    if ($script:IndusRunAsFile) { exit $script:IndusExitCode }
+    $global:LASTEXITCODE = $script:IndusExitCode
+}
diff --git a/scripts/install/ps/00-core.ps1 b/scripts/install/ps/00-core.ps1
new file mode 100644
index 0000000..eb4c8e1
--- /dev/null
+++ b/scripts/install/ps/00-core.ps1
@@ -0,0 +1,578 @@
+# Indus Agent installer for Windows (Windows PowerShell 5.1 and PowerShell 7).
+#
+# From PowerShell:      irm <release>/install.ps1 | iex
+# With options:         & ([scriptblock]::Create((irm <release>/install.ps1))) -Channel canary
+# From Command Prompt:  install.cmd (runs this script through PowerShell)
+#
+# Installs the runtime the desktop app uses: a git checkout, pinned uv and Python, the locked
+# environment and the `indus` command on the user PATH. On Windows the CLI, TUI and gateway are
+# supported through WSL2; run install.sh inside WSL for those.
+#
+# Stage protocol (shared with install.sh and driven by the desktop app):
+#   -Manifest               print the stage list as one JSON line
+#   -Stage NAME [-Json]     run one stage; with -Json print one result frame
+#   -NonInteractive         skip the stages that need a person (alias -SkipSetup)
+# POSIX spellings (--stage, --indus-home, --non-interactive, --dir, ...) are accepted too.
+#
+# This file is generated from scripts/install/ps/*.ps1, stages.json and pins.json. Edit those.
+# Dot-sourcing it (. .\install.ps1) defines the functions and runs nothing.
+[CmdletBinding(PositionalBinding = $false)]
+param(
+    [string]$Branch = "",
+    [string]$Commit = "",
+    [string]$Channel = "",
+    [string]$IndusHome = "",
+    [string]$InstallDir = "",
+    [switch]$Manifest,
+    [string]$Stage = "",
+    [switch]$Json,
+    [switch]$NonInteractive,
+    [switch]$SkipSetup,
+    [switch]$IncludeDesktop,
+    [switch]$SkipBrowser,
+    [switch]$SkipComputerUse,
+    [switch]$ShowResolvedPaths,
+    [Parameter(ValueFromRemainingArguments = $true)]
+    [string[]]$PosixArgs
+)
+
+# A dot-source sees InvocationName '.'; only the definitions below may enter the caller's session.
+$script:IndusDotSourced = ($MyInvocation.InvocationName -eq '.')
+# Only a script file owns its process and may `exit`; text run through iex or a scriptblock runs
+# inside the caller's session, where `exit` would close the person's window.
+$script:IndusRunAsFile = [bool]{}.File
+
+# The options every function reads. Parameters bind in the script's own scope, which is not the
+# `script:` scope when this text runs as a scriptblock, so they are copied here once.
+$script:IndusOpts = @{
+    Branch            = $Branch
+    Commit            = $Commit
+    Channel           = $Channel
+    IndusHome         = $IndusHome
+    InstallDir        = $InstallDir
+    Manifest          = [bool]$Manifest
+    Stage             = $Stage
+    Json              = [bool]$Json
+    NonInteractive    = ([bool]$NonInteractive -or [bool]$SkipSetup)
+    IncludeDesktop    = [bool]$IncludeDesktop
+    SkipBrowser       = [bool]$SkipBrowser
+    SkipComputerUse   = [bool]$SkipComputerUse
+    ShowResolvedPaths = [bool]$ShowResolvedPaths
+    Verbose           = ($VerbosePreference -ne 'SilentlyContinue')
+    Help              = $false
+}
+$script:IndusRest = @($PosixArgs | Where-Object { $null -ne $_ })
+
+# @@INDUS_EMBED@@
+
+$script:IndusStages = $script:IndusStagesJson | ConvertFrom-Json
+$script:IndusPinsData = $null
+$script:IndusPaths = $null
+$script:IndusReceiptWritten = $false
+$script:IndusRunId = ''
+$script:IndusStartedAt = ''
+$script:IndusCurrentStage = ''
+$script:IndusFailureClass = ''
+$script:IndusNativeError = ''
+$script:IndusLongProfileRoot = $null
+$script:IndusLastResolver = 'none'
+$script:IndusRewrites = @{}
+$script:IndusExitCode = 1
+
+$script:IndusChannels = @('stable', 'canary', 'main')
+$script:IndusValueFlags = @{
+    branch     = 'Branch'
+    commit     = 'Commit'
+    channel    = 'Channel'
+    dir        = 'InstallDir'
+    installdir = 'InstallDir'
+    indushome  = 'IndusHome'
+    stage      = 'Stage'
+}
+$script:IndusSwitchFlags = @{
+    manifest          = 'Manifest'
+    json              = 'Json'
+    noninteractive    = 'NonInteractive'
+    skipsetup         = 'NonInteractive'
+    includedesktop    = 'IncludeDesktop'
+    skipbrowser       = 'SkipBrowser'
+    skipcomputeruse   = 'SkipComputerUse'
+    showresolvedpaths = 'ShowResolvedPaths'
+    verbose           = 'Verbose'
+    h                 = 'Help'
+    help              = 'Help'
+}
+
+# ---------------------------------------------------------------------------------------------
+# Output. Machine output (manifest, frames, resolved paths) goes straight to the process's stdout,
+# never into the PowerShell pipeline. ASCII only: Windows PowerShell 5.1 reads a file without a
+# byte order mark in the ANSI code page.
+# ---------------------------------------------------------------------------------------------
+
+function Write-IndusJsonLine([string]$Text) {
+    [Console]::Out.WriteLine($Text)
+    [Console]::Out.Flush()
+}
+
+function Write-IndusInfo([string]$Message) { Write-Host "-> $Message" }
+function Write-IndusOk([string]$Message) { Write-Host "[ok] $Message" }
+function Write-IndusWarn([string]$Message) { Write-Host "[!] $Message" }
+function Write-IndusError([string]$Message) { [Console]::Error.WriteLine("[x] $Message") }
+
+function Write-IndusUsage {
+    $lines = @(
+        'Usage: install.ps1 [options]',
+        '  -Channel stable|canary|main   which line to install (env INDUS_INSTALL_CHANNEL)',
+        '  -Branch NAME                  branch for the main channel (default main)',
+        '  -Commit SHA                   pin a commit on that branch',
+        '  -IndusHome PATH               the Indus home (default %LOCALAPPDATA%\indus)',
+        '  -InstallDir PATH              where the code goes (default <home>\indus-agent)',
+        '  -Manifest                     print the stage list as JSON',
+        '  -Stage NAME [-Json]           run one stage',
+        '  -NonInteractive, -SkipSetup   skip the stages that need a person',
+        '  -IncludeDesktop               also check the desktop app and add a Start menu entry',
+        '  -SkipBrowser                  leave out the browser tools',
+        '  -SkipComputerUse              leave out the computer-use tools',
+        '  -ShowResolvedPaths            print the paths this install would use, as JSON',
+        'POSIX spellings such as --stage, --indus-home and --non-interactive work too.'
+    )
+    foreach ($line in $lines) { Write-Host $line }
+}
+
+function Get-IndusUtcStamp {
+    return (Get-Date).ToUniversalTime().ToString("yyyy-MM-dd'T'HH':'mm':'ss'Z'", [Globalization.CultureInfo]::InvariantCulture)
+}
+
+function Get-IndusCompactStamp {
+    return (Get-Date).ToUniversalTime().ToString("yyyyMMdd'T'HHmmss'Z'", [Globalization.CultureInfo]::InvariantCulture)
+}
+
+function Test-IndusWindows {
+    return [Environment]::OSVersion.Platform -eq [PlatformID]::Win32NT
+}
+
+# ---------------------------------------------------------------------------------------------
+# Arguments
+# ---------------------------------------------------------------------------------------------
+
+# Applies the POSIX (and stray PowerShell-style) spellings onto the options. Returns $null, or
+# @{ Code; Message } for a usage problem: 2 when a value is missing, 1 for an unknown flag.
+function ConvertFrom-IndusArgs {
+    param([string[]]$Tokens)
+    $list = @($Tokens | Where-Object { $null -ne $_ })
+    $at = 0
+    while ($at -lt $list.Count) {
+        $token = [string]$list[$at]
+        if (-not $token.StartsWith('-')) {
+            return @{ Code = 1; Message = "unexpected argument: $token" }
+        }
+        $body = $token.TrimStart('-')
+        $inline = $null
+        $eq = $body.IndexOf('=')
+        if ($eq -ge 0) {
+            $inline = $body.Substring($eq + 1)
+            $body = $body.Substring(0, $eq)
+        }
+        $body = $body.TrimEnd(':')
+        $key = ($body -replace '[-_]', '').ToLowerInvariant()
+        if ($script:IndusValueFlags.ContainsKey($key)) {
+            $value = $inline
+            if ($null -eq $value) {
+                if (($at + 1) -ge $list.Count -or ([string]$list[$at + 1]).StartsWith('-')) {
+                    return @{ Code = 2; Message = "$token needs a value" }
+                }
+                $value = [string]$list[$at + 1]
+                $at += 1
+            }
+            $script:IndusOpts[$script:IndusValueFlags[$key]] = $value
+        } elseif ($script:IndusSwitchFlags.ContainsKey($key) -and $null -eq $inline) {
+            $script:IndusOpts[$script:IndusSwitchFlags[$key]] = $true
+        } else {
+            return @{ Code = 1; Message = "unknown option: $token" }
+        }
+        $at += 1
+    }
+    return $null
+}
+
+# The channel this run was asked for ('' when none): -Channel, else INDUS_INSTALL_CHANNEL.
+# Returns an error message for a channel that does not exist.
+function Resolve-IndusChannel {
+    $asked = [string]$script:IndusOpts.Channel
+    if (-not $asked -and $env:INDUS_INSTALL_CHANNEL) { $asked = [string]$env:INDUS_INSTALL_CHANNEL }
+    $asked = $asked.Trim()
+    if ($asked -and ($script:IndusChannels -cnotcontains $asked)) {
+        return "the channel must be stable, canary or main, not '$asked'"
+    }
+    $script:IndusOpts.Channel = $asked
+    return $null
+}
+
+function Test-IndusNonInteractive {
+    return [bool]$script:IndusOpts.NonInteractive
+}
+
+# A person can answer questions: not -NonInteractive and the console input is not redirected.
+function Test-IndusConsole {
+    if (Test-IndusNonInteractive) { return $false }
+    try { return -not [Console]::IsInputRedirected } catch { return $false }
+}
+
+# ---------------------------------------------------------------------------------------------
+# Paths. Windows can expose a profile folder through an 8.3 alias (C:\Users\FIRST~1.LAS) in TEMP,
+# LOCALAPPDATA and the rest; several cmdlets then fail to find paths below it. Every
+# profile-rooted variable is expanded to its long form before anything reads it.
+# ---------------------------------------------------------------------------------------------
+
+function Get-IndusLongProfileRoot {
+    if ($null -ne $script:IndusLongProfileRoot) { return $script:IndusLongProfileRoot }
+    $script:IndusLongProfileRoot = ''
+    $candidates = @(
+        [Environment]::GetEnvironmentVariable('USERPROFILE'),
+        [Environment]::GetFolderPath('UserProfile')
+    )
+    foreach ($anchor in @($candidates)) {
+        if ($anchor -and $env:USERNAME) {
+            $parentDir = Split-Path -Parent $anchor.TrimEnd('\', '/')
+            if ($parentDir) { $candidates += (Join-Path $parentDir $env:USERNAME) }
+        }
+    }
+    foreach ($candidate in $candidates) {
+        if ([string]::IsNullOrWhiteSpace($candidate)) { continue }
+        $trimmed = $candidate.TrimEnd('\', '/')
+        if (-not $trimmed -or $trimmed -match '~\d') { continue }
+        try {
+            if (Test-Path -LiteralPath $trimmed -PathType Container) {
+                $script:IndusLongProfileRoot = $trimmed
+                break
+            }
+        } catch {
+            continue
+        }
+    }
+    return $script:IndusLongProfileRoot
+}
+
+# Rebuilds $Path on the long profile root when its aliased component is the profile folder itself;
+# any other path (a short name on another volume) comes back unchanged.
+function Expand-IndusShortProfileRoot([string]$Path) {
+    $longRoot = Get-IndusLongProfileRoot
+    if (-not $longRoot) { return $Path }
+    $usersDir = Split-Path -Parent $longRoot
+    if (-not $usersDir) { return $Path }
+    $node = $Path
+    $tail = ''
+    while ($node -and ($node -match '~\d')) {
+        $leaf = Split-Path -Leaf $node
+        $above = Split-Path -Parent $node
+        if (-not $above) { return $Path }
+        if ($leaf -match '~\d') {
+            if ($above -ne $usersDir) { return $Path }
+            if ($tail) { return (Join-Path $longRoot $tail) }
+            return $longRoot
+        }
+        if ($tail) { $tail = Join-Path $leaf $tail } else { $tail = $leaf }
+        $node = $above
+    }
+    return $Path
+}
+
+function ConvertTo-IndusLongPath([string]$Path) {
+    if ([string]::IsNullOrWhiteSpace($Path)) { return $Path }
+    if ($Path -notmatch '~\d') { return $Path }
+    try {
+        if (-not ('IndusInstall.LongPath' -as [type])) {
+            Add-Type -Namespace 'IndusInstall' -Name 'LongPath' -MemberDefinition @'
+[DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+public static extern int GetLongPathNameW(string shortPath, System.Text.StringBuilder longPath, int size);
+'@
+        }
+        $buffer = New-Object System.Text.StringBuilder 4096
+        $length = [IndusInstall.LongPath]::GetLongPathNameW($Path, $buffer, $buffer.Capacity)
+        if ($length -gt $buffer.Capacity) {
+            $buffer = New-Object System.Text.StringBuilder $length
+            $length = [IndusInstall.LongPath]::GetLongPathNameW($Path, $buffer, $buffer.Capacity)
+        }
+        if ($length -gt 0) {
+            $expanded = $buffer.ToString()
+            if ($expanded -and $expanded -notmatch '~\d') {
+                $script:IndusLastResolver = 'kernel32'
+                return $expanded
+            }
+        }
+    } catch {
+        # Not Windows, or P/Invoke refused by policy: rebuild from the profile root instead.
+    }
+    $rebuilt = Expand-IndusShortProfileRoot $Path
+    if ($rebuilt -ne $Path) { $script:IndusLastResolver = 'profile-root' } else { $script:IndusLastResolver = 'none' }
+    return $rebuilt
+}
+
+function Set-IndusLongEnvPaths {
+    $script:IndusRewrites = @{}
+    foreach ($name in @('TEMP', 'TMP', 'LOCALAPPDATA', 'APPDATA', 'USERPROFILE')) {
+        $current = [Environment]::GetEnvironmentVariable($name)
+        if (-not $current) { continue }
+        $expanded = ConvertTo-IndusLongPath $current
+        if ($expanded -and $expanded -ne $current) {
+            Set-Item -Path "Env:$name" -Value $expanded
+            $script:IndusRewrites[$name] = $expanded
+        }
+    }
+}
+
+function Get-IndusDefaultHome {
+    if ($env:INDUS_HOME) { return [string]$env:INDUS_HOME }
+    $local = [string]$env:LOCALAPPDATA
+    if (-not $local) {
+        $profileDir = [Environment]::GetFolderPath('UserProfile')
+        $local = Join-Path (Join-Path $profileDir 'AppData') 'Local'
+    }
+    return (Join-Path $local 'indus')
+}
+
+# Resolves the home and the install dir once (after the env is long-form) and keeps the report
+# -ShowResolvedPaths prints. Touches nothing on disk.
+function Initialize-IndusPaths {
+    Set-IndusLongEnvPaths
+    if ($script:IndusOpts.IndusHome) {
+        $homeDir = ConvertTo-IndusLongPath ([string]$script:IndusOpts.IndusHome)
+    } else {
+        $homeDir = ConvertTo-IndusLongPath (Get-IndusDefaultHome)
+    }
+    if ($script:IndusOpts.InstallDir) {
+        $codeDir = ConvertTo-IndusLongPath ([string]$script:IndusOpts.InstallDir)
+    } else {
+        $codeDir = Join-Path $homeDir 'indus-agent'
+    }
+    $env:INDUS_HOME = $homeDir
+    $script:IndusPaths = @{
+        Home       = $homeDir
+        InstallDir = $codeDir
+        Report     = [ordered]@{
+            long_profile_root = (Get-IndusLongProfileRoot)
+            normalized        = $script:IndusRewrites
+            resolver          = $script:IndusLastResolver
+            temp              = [string]$env:TEMP
+            indus_home        = $homeDir
+            install_dir       = $codeDir
+        }
+    }
+}
+
+function Test-IndusSamePath([string]$Left, [string]$Right) {
+    $a = $Left.TrimEnd('\', '/')
+    $b = $Right.TrimEnd('\', '/')
+    return [string]::Equals($a, $b, [StringComparison]::OrdinalIgnoreCase)
+}
+
+function Test-IndusPathInside([string]$Inner, [string]$Outer) {
+    $in = $Inner.TrimEnd('\', '/')
+    $out = $Outer.TrimEnd('\', '/')
+    if ([string]::Equals($in, $out, [StringComparison]::OrdinalIgnoreCase)) { return $true }
+    foreach ($separator in @('\', '/')) {
+        if ($in.StartsWith($out + $separator, [StringComparison]::OrdinalIgnoreCase)) { return $true }
+    }
+    return $false
+}
+
+# A home equal to or inside the install dir would put <home>\tools inside the checkout: refused
+# before anything downloads.
+function Assert-IndusLayout {
+    if (-not $script:IndusPaths) { Initialize-IndusPaths }
+    $homeDir = $script:IndusPaths.Home
+    $codeDir = $script:IndusPaths.InstallDir
+    if (Test-IndusPathInside $homeDir $codeDir) {
+        Stop-IndusStage "the Indus home ($homeDir) cannot be the install directory or live inside it ($codeDir); pass a separate -IndusHome or -InstallDir" 'filesystem_error'
+    }
+}
+
+function Get-IndusLogPath {
+    return (Join-Path (Join-Path $script:IndusPaths.Home 'logs') 'install.log')
+}
+
+# ---------------------------------------------------------------------------------------------
+# Embedded tables
+# ---------------------------------------------------------------------------------------------
+
+function Get-IndusStageDef([string]$Name) {
+    foreach ($def in @($script:IndusStages.stages)) {
+        if ($def.name -ceq $Name) { return $def }
+    }
+    return $null
+}
+
+function Get-IndusManifestJson {
+    $list = @()
+    foreach ($def in @($script:IndusStages.stages)) {
+        $title = [string]$def.title
+        if ($script:IndusOpts.IncludeDesktop -and $def.title_with_desktop) { $title = [string]$def.title_with_desktop }
+        $list += [ordered]@{
+            name             = [string]$def.name
+            title            = $title
+            category         = [string]$def.category
+            needs_user_input = [bool]$def.needs_user_input
+        }
+    }
+    $manifest = [ordered]@{ protocol_version = [int]$script:IndusStages.protocol_version; stages = $list }
+    return ($manifest | ConvertTo-Json -Depth 5 -Compress)
+}
+
+# The release origin (owner decision D-16.690 pending): the one constant is pins.json
+# release.repository ("owner/name"); clone, API, release and shim URLs all derive from it.
+function Get-IndusRepository {
+    $pins = $script:IndusPinsJson | ConvertFrom-Json
+    $named = ([string]$pins.release.repository).Trim().TrimEnd('/')
+    if ($named.StartsWith('https://')) { return $named }
+    return 'https://github.com/' + $named
+}
+
+function Get-IndusCloneUrl {
+    if ($env:INDUS_REPO_URL) { return [string]$env:INDUS_REPO_URL }
+    return (Get-IndusRepository) + '.git'
+}
+
+# ---------------------------------------------------------------------------------------------
+# Failures, frames and the receipt
+# ---------------------------------------------------------------------------------------------
+
+# Throws; the entry points own reporting and the exit code. $Class is the receipt's closed
+# failure class.
+function Stop-IndusStage([string]$Message, [string]$Class = 'other') {
+    $script:IndusFailureClass = $Class
+    throw $Message
+}
+
+# The class for a ladder stage that threw. A native child that Ctrl-C ended (130, or Windows
+# STATUS_CONTROL_C_EXIT) is an interruption whatever the stage said.
+function Get-IndusFailureClass {
+    if ($global:LASTEXITCODE -in @(130, -1073741510, 3221225786)) { return 'interrupted' }
+    if ($script:IndusFailureClass) { return $script:IndusFailureClass }
+    return 'other'
+}
+
+function Write-IndusFrame([bool]$Ok, [string]$Name, [bool]$Skipped, [string]$Reason = '') {
+    $frame = [ordered]@{ ok = $Ok; stage = $Name; skipped = $Skipped }
+    if ($Reason) { $frame.reason = $Reason }
+    Write-IndusJsonLine ($frame | ConvertTo-Json -Compress)
+}
+
+# One local receipt per full-ladder run; never uploaded. The first writer wins: a second call in
+# this process (the finally block's 'interrupted') and an existing receipt file are both no-ops.
+# Best effort: a receipt that cannot be written never fails the install. Returns $true when written.
+function Write-IndusReceipt([string]$Outcome, [string]$FailedStage = '', [string]$FailureClass = '') {
+    if ($script:IndusReceiptWritten) { return $false }
+    $script:IndusReceiptWritten = $true
+    $tmpFile = $null
+    try {
+        if (-not $script:IndusRunId) { $script:IndusRunId = [guid]::NewGuid().ToString('N') }
+        if (-not $script:IndusStartedAt) { $script:IndusStartedAt = Get-IndusUtcStamp }
+        $receiptDir = Join-Path (Join-Path $script:IndusPaths.Home 'logs') 'install_receipts'
+        New-Item -ItemType Directory -Force -Path $receiptDir | Out-Null
+        $final = Join-Path $receiptDir ($script:IndusRunId + '.json')
+        if (Test-Path -LiteralPath $final) { return $false }
+        $record = [ordered]@{ id = $script:IndusRunId; installer = 'ps1'; outcome = $Outcome }
+        if ($FailedStage) { $record.failed_stage = $FailedStage }
+        if ($FailureClass) { $record.failure_class = $FailureClass }
+        $record.started_at = $script:IndusStartedAt
+        $record.finished_at = Get-IndusUtcStamp
+        $tmpFile = Join-Path $receiptDir ('.' + $script:IndusRunId + '.tmp')
+        [IO.File]::WriteAllText($tmpFile, ($record | ConvertTo-Json -Compress), (New-Object System.Text.UTF8Encoding($false)))
+        Move-Item -LiteralPath $tmpFile -Destination $final -ErrorAction Stop
+        $tmpFile = $null
+        return $true
+    } catch {
+        if ($tmpFile) { Remove-Item -LiteralPath $tmpFile -Force -ErrorAction SilentlyContinue }
+        return $false
+    }
+}
+
+# ---------------------------------------------------------------------------------------------
+# Native commands. Windows PowerShell 5.1 turns a native tool's redirected stderr into an error
+# record that 'Stop' makes fatal; native calls run with the preference relaxed here, and the
+# caller judges $LASTEXITCODE. The helpers below use unusual local names because the blocks they
+# run resolve variables through their scope first.
+# ---------------------------------------------------------------------------------------------
+
+function Invoke-IndusNative {
+    param([scriptblock]$IndusNativeBlock, [switch]$Utf8)
+    $ErrorActionPreference = 'Continue'
+    if (-not $Utf8) {
+        & $IndusNativeBlock
+        return
+    }
+    $nvPrevious = [Console]::OutputEncoding
+    try {
+        [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding($false)
+        & $IndusNativeBlock
+    } finally {
+        [Console]::OutputEncoding = $nvPrevious
+    }
+}
+
+# The cause line of a failed command: the first "fatal:"/"error:" line, else the last line.
+function Select-IndusErrorLine($Lines) {
+    $slPick = $null
+    $slLast = $null
+    foreach ($slRaw in @($Lines)) {
+        $slLine = ("$slRaw" -split "`r")[-1].Trim()
+        if (-not $slLine) { continue }
+        $slLast = $slLine
+        if (-not $slPick -and $slLine -match '(^|\s)(fatal|error): ') { $slPick = $slLine }
+    }
+    if (-not $slPick) { $slPick = $slLast }
+    if ($slPick -and $slPick.Length -gt 240) { $slPick = $slPick.Substring(0, 240) }
+    return $slPick
+}
+
+function Get-IndusNativeDetail {
+    if ($script:IndusNativeError) { return ": $($script:IndusNativeError)" }
+    return ''
+}
+
+# Runs a native block with one status line; its output goes to <home>\logs\install.log, and to the
+# console too with -Verbose, in CI, when stdout is redirected (the desktop app reads it) or when the
+# log cannot be opened. $LASTEXITCODE stays the caller's.
+function Invoke-IndusLogged {
+    param([string]$LoggedLabel, [scriptblock]$LoggedBlock, [switch]$MayFail)
+    $script:IndusNativeError = ''
+    Write-IndusInfo $LoggedLabel
+    $lgWriter = $null
+    try {
+        $lgLog = Get-IndusLogPath
+        $lgDir = Split-Path -Parent $lgLog
+        if (-not (Test-Path -LiteralPath $lgDir)) { New-Item -ItemType Directory -Force -Path $lgDir | Out-Null }
+        $lgWriter = New-Object System.IO.StreamWriter($lgLog, $true, (New-Object System.Text.UTF8Encoding($false)))
+        $lgWriter.WriteLine("==> $LoggedLabel ($(Get-IndusUtcStamp))")
+    } catch {
+        $lgWriter = $null
+    }
+    $lgStream = [bool]$script:IndusOpts.Verbose -or [bool]$env:CI -or -not $lgWriter
+    if (-not $lgStream) {
+        try { $lgStream = [Console]::IsOutputRedirected } catch { $lgStream = $true }
+    }
+    $lgTail = New-Object 'System.Collections.Generic.List[string]'
+    $lgCode = 0
+    try {
+        $global:LASTEXITCODE = 0
+        Invoke-IndusNative { & $LoggedBlock 2>&1 } | ForEach-Object {
+            $lgLine = "$_".TrimEnd("`r")
+            if ($lgWriter) { $lgWriter.WriteLine($lgLine) }
+            if ($lgStream) { Write-Host "    $lgLine" }
+            $lgTail.Add($lgLine)
+            if ($lgTail.Count -gt 20) { $lgTail.RemoveAt(0) }
+        }
+        $lgCode = $global:LASTEXITCODE
+    } finally {
+        if ($lgWriter) { $lgWriter.Dispose() }
+    }
+    if ($lgCode) {
+        $script:IndusNativeError = Select-IndusErrorLine $lgTail
+        if (-not $MayFail) {
+            Write-IndusWarn "$LoggedLabel failed (exit $lgCode). Last output:"
+            foreach ($lgShown in $lgTail) { Write-Host "    $lgShown" }
+            Write-Host "    full log: $(Get-IndusLogPath)"
+        }
+    }
+    $global:LASTEXITCODE = $lgCode
+}
