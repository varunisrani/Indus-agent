@@ -0,0 +1,148 @@
+# STAND-IN: removed at integration
+"""Stand-ins for slice I1's pieces that slice I2 (P23-06/07) builds on.
+
+Assumed interfaces (move into I1's files at integration):
+
+- ``scripts/install/build.py`` gains the PowerShell half: ``render_ps1(root, pins_text)`` here. The
+  built ``scripts/install.ps1`` is a header comment, then ``ps/00-core.ps1`` with its
+  ``# @@INDUS_EMBED@@`` line replaced by two single-quoted here-strings (``$script:IndusStagesJson``
+  = compact ``stages.json``, ``$script:IndusPinsJson`` = compact ``pins.json``), then the other
+  ``ps/*.ps1`` fragments in name order. ``build.py --check`` compares it with the file.
+- ``scripts/install/pins.json`` (P23-02) has, at least (slice I1's shape)::
+
+      {"release": {"repository": "owner/name"},
+       "uv": {"version": V, "targets": {"windows-x64": {"url", "mirror", "sha256"}, ...}},
+       "git_for_windows": {"version": V, "targets": {"windows-x64": {...}, "windows-arm64": {...}}},
+       "python": {"provision": "3.14", "floor": "3.13"}}
+
+  ``STAND_IN_PINS`` below has that shape with made-up digests; the committed ``install.ps1``
+  embeds it until the real pins replace it. A ``sha256`` of null makes the script refuse that
+  download.
+
+Run ``python -m tests.integration.install._stubs_i2`` to rebuild ``scripts/install.ps1``.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+from pathlib import Path
+from typing import Any
+
+ROOT = Path(__file__).resolve().parents[3]
+INSTALL_DIR = ROOT / "scripts" / "install"
+PS_DIR = INSTALL_DIR / "ps"
+STAGES_JSON = INSTALL_DIR / "stages.json"
+BUILT_PS1 = ROOT / "scripts" / "install.ps1"
+CMD_SHIM = ROOT / "scripts" / "install.cmd"
+EMBED_LINE = "# @@INDUS_EMBED@@"
+HEADER = (
+    "# Generated by scripts/install/build.py from scripts/install/ps/*.ps1, stages.json and\n"
+    "# pins.json. Do not edit; change the fragments and rebuild.\n"
+)
+
+
+def _fake_digest(label: str) -> str:
+    return hashlib.sha256(f"indus stand-in pin {label}".encode()).hexdigest()
+
+
+_MIRROR = "https://github.com/indusagi/indus-agent/releases/download/bootstrap-mirror/"
+
+
+def _target(url: str) -> dict[str, str]:
+    name = url.rsplit("/", 1)[1]
+    return {"url": url, "mirror": _MIRROR + name, "sha256": _fake_digest(url)}
+
+
+_UV = "https://github.com/astral-sh/uv/releases/download/0.11.32/"
+_GIT = "https://github.com/git-for-windows/git/releases/download/v2.51.0.windows.1/"
+
+STAND_IN_PINS: dict[str, Any] = {
+    "schema": 1,
+    "release": {"repository": "indusagi/indus-agent", "mirror_tag": "bootstrap-mirror"},
+    "python": {"provision": "3.14", "floor": "3.13"},
+    "uv": {
+        "version": "0.11.32",
+        "targets": {
+            "windows-x64": _target(_UV + "uv-x86_64-pc-windows-msvc.zip"),
+            "windows-arm64": _target(_UV + "uv-aarch64-pc-windows-msvc.zip"),
+        },
+    },
+    "git_for_windows": {
+        "version": "2.51.0.windows.1",
+        "targets": {
+            "windows-x64": _target(_GIT + "PortableGit-2.51.0-64-bit.7z.exe"),
+            "windows-arm64": _target(_GIT + "PortableGit-2.51.0-arm64.7z.exe"),
+        },
+    },
+}
+
+
+def compact(data: object) -> str:
+    return json.dumps(data, separators=(",", ":"), sort_keys=False, ensure_ascii=True)
+
+
+def pins_text() -> str:
+    """The pins the build embeds: I1's ``pins.json`` when it exists, else the stand-in."""
+    real = INSTALL_DIR / "pins.json"
+    if real.is_file():
+        return compact(json.loads(real.read_text(encoding="utf-8")))
+    return compact(STAND_IN_PINS)
+
+
+def render_ps1(root: Path = ROOT, pins: str | None = None) -> str:
+    ps_dir = root / "scripts" / "install" / "ps"
+    stages = json.loads((root / "scripts" / "install" / "stages.json").read_text(encoding="utf-8"))
+    embedded = pins if pins is not None else pins_text()
+    for text in (compact(stages), embedded):
+        if "\n" in text or "'@" in text:
+            raise ValueError("embedded JSON must be one line without a here-string terminator")
+    embed = (
+        "$script:IndusStagesJson = @'\n"
+        f"{compact(stages)}\n"
+        "'@\n"
+        "$script:IndusPinsJson = @'\n"
+        f"{embedded}\n"
+        "'@"
+    )
+    fragments = sorted(ps_dir.glob("*.ps1"))
+    if not fragments or fragments[0].name != "00-core.ps1":
+        raise ValueError("ps/00-core.ps1 must be the first fragment (it holds the param block)")
+    parts: list[str] = []
+    for index, fragment in enumerate(fragments):
+        text = fragment.read_text(encoding="utf-8")
+        if index == 0:
+            if text.count(EMBED_LINE) != 1:
+                raise ValueError(f"{fragment.name} must hold exactly one {EMBED_LINE} line")
+            text = text.replace(EMBED_LINE, embed)
+        parts.append(text.rstrip("\n") + "\n")
+    return HEADER + "".join(parts)
+
+
+def latest_asset_url(repository: str, name: str) -> str:
+    """The latest release's asset, derived from the one release constant."""
+    return f"{repository.rstrip('/')}/releases/latest/download/{name}"
+
+
+def repository() -> str:
+    """The release origin: ``pins.json`` ``release.repository`` (D-16.690, owner pending)."""
+    data: dict[str, Any] = json.loads(pins_text())
+    named = str(data["release"]["repository"]).strip().rstrip("/")
+    return named if named.startswith("https://") else f"https://github.com/{named}"
+
+
+def main(argv: list[str]) -> int:
+    built = render_ps1()
+    if "--check" in argv:
+        current = BUILT_PS1.read_text(encoding="utf-8") if BUILT_PS1.is_file() else ""
+        if current != built:
+            print("scripts/install.ps1 is stale; rebuild it", file=sys.stderr)
+            return 1
+        return 0
+    BUILT_PS1.write_text(built, encoding="utf-8", newline="\n")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
