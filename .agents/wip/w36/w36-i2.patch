+USER_LINES = (
+    "# my settings\n"
+    'export PATH="$HOME/.local/bin:$PATH"\n'
+    "# indus is installed under ~/.indus\n"
+    "# >>> indus >>> (my own note)\n"
+    "alias ll='ls -l'\n"
+)
+BLOCK = '# >>> indus >>>\nexport PATH="$HOME/.local/bin:$PATH"\n# <<< indus <<<\n'
