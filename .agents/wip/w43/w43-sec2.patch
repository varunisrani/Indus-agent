+def test_lock_parsers_read_both_ecosystems(tree: Path) -> None:
+    uv = read_uv_lock(tree / "uv.lock")
+    assert [(p.name, p.version, p.hashed) for p in uv] == [
+        ("jinja2", "2.4.1", True),
+        ("tinylib", "1.2.3", True),
