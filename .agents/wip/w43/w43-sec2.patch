+def test_allow_listed_with_a_future_expiry_passes(tree: Path) -> None:
+    snapshot(tree)
+    allow(tree, [entry()])
+    result = check(tree)
+    assert result.code == 0, result.violations
+    assert any(n.startswith("allowed until 2099-01-01") for n in result.notes)
