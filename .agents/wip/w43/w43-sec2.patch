+    assert [(p.name, p.version) for p in npm] == [
+        ("@demo/scoped", "2.0.0"),
+        ("lodash", "4.17.0"),
+        ("pnpm", "12.9.1"),
+    ]  # both YAML documents, scoped names, no snapshot duplicates
+    assert all(p.source == "registry" and p.hashed for p in npm)
