+"""Lookalikes that must stay quiet: os.system and yaml.load in prose, ?token= in a docstring."""
+
+import subprocess
+import tarfile
+
+import yaml
+
+
+def fine(argv: list[str], env: dict[str, str], token_count: int, max_tokens: int) -> object:
+    subprocess.run(argv, shell=False, env=env, check=False)
+    data = yaml.load("a: 1", Loader=yaml.SafeLoader)
+    safe = yaml.safe_load("a: 1")
+    with tarfile.open("x.tar") as tar:
+        tar.extractall("dest", filter="data")
+    note = "os.system is mentioned in a string"
+    return data, safe, note, token_count, max_tokens
+
+
+def evaluate(expression: object) -> object:
+    return expression.eval()
+
+
+def png(data: bytes, chunks: object) -> object:
+    return chunks(data, verify=False)
