--- /dev/null
+++ b/src/indus/learning/skills/prompt_index.py
@@ -0,0 +1,278 @@
+"""The skills index in the system prompt, and the mid-session change note (R07.29).
+
+The index is a compact block in the prompt's volatile tier::
+
+    ## Skills
+    <guidance>
+
+    <skills_index>
+    ### <category>[ — <category label>]
+    - <name>: <description clipped to 60 characters, "…" when clipped>
+    [names only] <category>: a, b, c
+    </skills_index>
+
+It is built once per prompt build (``SkillsIndexBuilder`` wraps the P04 builder) and frozen with
+the prompt. Each turn ``stage_index_delta`` compares the rows the prompt carries with the rows the
+session would build now and stages one note on the turn's note channel when that difference
+changed; the prompt itself only changes at the next compaction rebuild.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from collections.abc import Callable, Iterable
+from dataclasses import dataclass, replace
+from typing import Protocol
+
+from indus.core.prompt.builder import BuildContext, PromptParts
+from indus.foundation.scope import Scope
+from indus.learning.skills.format import VisibilityContext
+from indus.learning.skills.resolver import SkillCatalog, SkillRecord, load_catalog
+
+__all__ = [
+    "BLOCK_END",
+    "BLOCK_START",
+    "DESCRIPTION_CLIP",
+    "IndexDeltaTracker",
+    "IndexOptions",
+    "SkillsIndexBuilder",
+    "build_index",
+    "catalog_index_source",
+    "clip_description",
+    "index_rows",
+    "render_delta_note",
+    "stage_index_delta",
+]
+
+DESCRIPTION_CLIP = 60
+CLIP_MARK = "…"
+BLOCK_START = "<skills_index>"
+BLOCK_END = "</skills_index>"
+GENERAL = "general"
+NAMES_ONLY = "[names only]"
+VIEW_TOOL = "skill_view"
+
+HEADING = "## Skills"
+GUIDANCE = (
+    "Skills are saved, tested procedures for recurring kinds of work. When the request matches a "
+    "skill below, open it with skill_view(name) first and follow it rather than improvising. "
+    f"Descriptions are cut at {DESCRIPTION_CLIP} characters; a row ending in {CLIP_MARK} has "
+    "more to say once viewed. Rows marked [names only] list skills by name; view one to see it."
+)
+
+NOTE_HEAD = (
+    "[Note: the skills available in this conversation changed after the system prompt was written."
+)
+NOTE_ADDED = "Added (open with skill_view(name) when relevant):"
+NOTE_REMOVED = "No longer available:"
+NOTE_CURRENT = (
+    " The skills list in the system prompt is accurate again; ignore earlier skill notes."
+)
+
+_SPACES = re.compile(r"\s+")
+
+
+class _Notes(Protocol):
+    def stage_skills_delta(self, text: str) -> None: ...
+
+
+class _Builder(Protocol):
+    async def build(self, ctx: BuildContext) -> PromptParts: ...
+
+
+def clip_description(text: str, limit: int = DESCRIPTION_CLIP) -> str:
+    """One line, at most ``limit`` characters; a clipped text ends in ``…``."""
+    flat = _SPACES.sub(" ", text).strip()
+    if len(flat) <= limit:
+        return flat
+    return flat[: limit - 1].rstrip() + CLIP_MARK
+
+
+@dataclass(frozen=True)
+class IndexOptions:
+    """What shapes one index: visibility inputs and the categories shown as names only."""
+
+    tools: frozenset[str] = frozenset()
+    toolsets: frozenset[str] = frozenset()
+    platform: str | None = None
+    compact_categories: frozenset[str] = frozenset()
+
+    def visibility(self) -> VisibilityContext:
+        return VisibilityContext(
+            toolsets=self.toolsets, tools=self.tools, session_platform=self.platform or None
+        )
+
+
+def _row(rec: SkillRecord) -> str:
+    return f"- {rec.name}: {clip_description(rec.description)}"
+
+
+def build_index(catalog: SkillCatalog, options: IndexOptions) -> str:
+    """The whole block, or "" when nothing is visible."""
+    shown = catalog.visible(options.visibility())
+    ambiguous = catalog.ambiguous_names()
+    groups: dict[str, list[SkillRecord]] = {}
+    for rec in shown:
+        groups.setdefault(rec.category or GENERAL, []).append(rec)
+    if not groups:
+        return ""
+    lines: list[str] = []
+    for category in sorted(groups, key=lambda c: (c != GENERAL, c)):
+        members = sorted(groups[category], key=lambda r: (r.name, r.relative_path))
+        if category in options.compact_categories:
+            names = sorted({r.name for r in members})
+            lines.append(f"{NAMES_ONLY} {category}: {', '.join(names)}")
+            continue
+        label = catalog.category_labels.get(category, "")
+        lines.append(f"### {category}" + (f" — {clip_description(label)}" if label else ""))
+        noted: set[str] = set()
+        for rec in members:
+            if rec.name in ambiguous:
+                if rec.name in noted:
+                    continue
+                noted.add(rec.name)
+                paths = sorted(r.load_name or str(r.skill_dir) for r in ambiguous[rec.name])
+                lines.append(
+                    f"- {rec.name}: [{len(paths)} skills share this name; view one by path "
+                    f"({', '.join(paths)}) and rename the other]"
+                )
+                continue
+            lines.append(_row(rec))
+    return "\n".join([HEADING, GUIDANCE, "", BLOCK_START, *lines, BLOCK_END])
+
+
+def index_rows(text: str) -> dict[str, str]:
+    """``{name: row}`` for the index block inside ``text`` (names-only names map to "")."""
+    start = text.find(BLOCK_START)
+    end = text.find(BLOCK_END, start + 1)
+    if start < 0 or end < 0:
+        return {}
+    rows: dict[str, str] = {}
+    for line in text[start + len(BLOCK_START) : end].splitlines():
+        if line.startswith("- "):
+            name = line[2:].split(": ", 1)[0].strip()
+            if name:
+                rows.setdefault(name, line)
+        elif line.startswith(NAMES_ONLY):
+            _, _, names = line[len(NAMES_ONLY) :].partition(": ")
+            for name in (n.strip() for n in names.split(",")):
+                if name:
+                    rows.setdefault(name, "")
+    return rows
+
+
+def render_delta_note(added: dict[str, str], removed: Iterable[str]) -> str:
+    gone = sorted(removed)
+    if not added and not gone:
+        return NOTE_HEAD + NOTE_CURRENT + "]"
+    parts = [NOTE_HEAD]
+    if added:
+        parts.append(NOTE_ADDED)
+        parts.extend(added[name] or f"- {name}" for name in sorted(added))
+    if gone:
+        parts.append(f"{NOTE_REMOVED} {', '.join(gone)}")
+    return "\n".join(parts) + "]"
+
+
+def _digest(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+class IndexDeltaTracker:
+    """Remembers what the session was last told so each difference is announced once."""
+
+    def __init__(self) -> None:
+        self._told: tuple[frozenset[str], frozenset[str]] = (frozenset(), frozenset())
+        self._prompt_digest = ""
+
+    def note(self, prompt_text: str, current_index: str) -> str | None:
+        """The note to send with the next user message, or None."""
+        in_prompt = index_rows(prompt_text)
+        now = index_rows(current_index)
+        added = {name: row for name, row in now.items() if name not in in_prompt}
+        removed = {name for name in in_prompt if name not in now}
+        delta = (frozenset(added), frozenset(removed))
+        digest = _digest(prompt_text)
+        rebuilt = bool(self._prompt_digest) and digest != self._prompt_digest
+        self._prompt_digest = digest
+        if delta == self._told:
+            return None
+        self._told = delta
+        if not added and not removed and rebuilt:
+            return None  # a rebuilt prompt already carries the change
+        return render_delta_note(added, removed)
+
+
+def stage_index_delta(
+    notes: _Notes, tracker: IndexDeltaTracker, prompt_text: str | None, current_index: str
+) -> str | None:
+    """Stage the change note on ``notes`` (the turn's note channel); return what was staged."""
+    if prompt_text is None:
+        return None
+    note = tracker.note(prompt_text, current_index)
+    if note is not None:
+        notes.stage_skills_delta(note)
+    return note
+
+
+IndexSource = Callable[[BuildContext], str]
+
+
+def catalog_index_source(
+    scope: Scope,
+    *,
+    toolsets: frozenset[str] = frozenset(),
+    compact_categories: frozenset[str] = frozenset(),
+    catalog_factory: Callable[[Scope, str | None], SkillCatalog] | None = None,
+) -> IndexSource:
+    """An ``IndexSource`` that rescans the scope's skills on every call."""
+
+    def source(ctx: BuildContext) -> str:
+        if VIEW_TOOL not in ctx.tool_names:
+            return ""
+        platform = ctx.platform or None
+        catalog = (
+            catalog_factory(scope, platform)
+            if catalog_factory is not None
+            else load_catalog(scope, platform=platform)
+        )
+        options = IndexOptions(
+            tools=ctx.tool_names,
+            toolsets=toolsets,
+            platform=platform,
+            compact_categories=compact_categories,
+        )
+        return build_index(catalog, options)
+
+    return source
+
+
+class SkillsIndexBuilder:
+    """A P04 ``Builder`` that fills ``skills_index`` (plus any extra blocks) before building.
+
+    The agent calls ``build`` only for a new prompt or a compaction rebuild, so the index is
+    frozen with the prompt by construction.
+    """
+
+    def __init__(
+        self,
+        inner: _Builder,
+        source: IndexSource,
+        *,
+        extra_blocks: Iterable[IndexSource] = (),
+    ) -> None:
+        self._inner = inner
+        self._source = source
+        self._extra = tuple(extra_blocks)
+        self.last_index = ""
+
+    def current_index(self, ctx: BuildContext) -> str:
+        return self._source(ctx)
+
+    async def build(self, ctx: BuildContext) -> PromptParts:
+        index = self._source(ctx)
+        self.last_index = index
+        blocks = [index, *(block(ctx) for block in self._extra)]
+        text = "\n\n".join(b.strip() for b in blocks if b and b.strip())
+        return await self._inner.build(replace(ctx, skills_index=text))
diff --git a/src/indus/learning/skills/resolver.py b/src/indus/learning/skills/resolver.py
new file mode 100644
index 0000000..f28203d
--- /dev/null
+++ b/src/indus/learning/skills/resolver.py
@@ -0,0 +1,504 @@
+"""Skill discovery and resolution: one catalog that every consumer asks (R07.27).
+
+Roots are scanned in tier order, highest first:
+
+1. project (reserved for P13; always empty here),
+2. the profile's ``<home>/skills/`` (the source of truth),
+3. ``skills.create_dir`` (where agent-created skills go when set),
+4. each ``skills.external_dirs`` entry (``~`` and ``${VAR}`` expanded; missing folders skipped).
+
+A skill in a higher tier hides same-named skills below it (each hidden copy is logged once per
+process). Inside the winning tier, two different skills with one name are both listed under their
+paths relative to their root, and the bare name refuses to load ("ambiguous skill name"). Copies
+that are provably one skill — one real file reached through a symlink, or byte-identical files —
+are not a conflict: the shallowest path wins. ``skills.disabled`` and
+``skills.platform_disabled.<surface>`` hide a skill and make ``resolve`` refuse it. Plugin skills
+are named ``plugin:skill`` and live outside the tiers.
+
+External folders are read and written in place; they are a convenience, not a protection boundary.
+
+Parsing is cached per ``SKILL.md`` by ``(path, mtime_ns, size)``, so a rescan only re-reads files
+that changed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+import os
+import threading
+from collections.abc import Iterable, Mapping, Sequence
+from dataclasses import dataclass, field, replace
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.foundation.config import loader
+from indus.foundation.config.schema import default_for
+from indus.foundation.home import expand_path_text
+from indus.foundation.scope import Scope
+from indus.learning.skills.format import (
+    CATEGORY_FILE,
+    SKILL_FILE,
+    SkillFormatError,
+    SkillFrontmatter,
+    VisibilityContext,
+    parse_skill,
+    split_frontmatter,
+    visible,
+)
+
+__all__ = [
+    "TIER_CREATE_DIR",
+    "TIER_EXTERNAL",
+    "TIER_LOCAL",
+    "TIER_PLUGIN",
+    "TIER_PROJECT",
+    "AmbiguousSkill",
+    "SkillBroken",
+    "SkillCatalog",
+    "SkillDisabled",
+    "SkillError",
+    "SkillNotFound",
+    "SkillRecord",
+    "SkillsSettings",
+    "clear_scan_cache",
+    "load_catalog",
+    "skills_setting",
+]
+
+log = logging.getLogger(__name__)
+
+TIER_PROJECT = 0
+TIER_LOCAL = 1
+TIER_CREATE_DIR = 2
+TIER_EXTERNAL = 3
+TIER_PLUGIN = 9
+
+TIER_NAMES = {
+    TIER_PROJECT: "project",
+    TIER_LOCAL: "local",
+    TIER_CREATE_DIR: "create_dir",
+    TIER_EXTERNAL: "external",
+    TIER_PLUGIN: "plugin",
+}
+
+# Folder names never scanned for skills (plus every name starting with a dot).
+SKIP_DIRS = frozenset({"node_modules", "__pycache__", "venv", "site-packages", "dist", "build"})
+
+Status = Literal["unique", "ambiguous", "shadowed", "broken"]
+
+
+class SkillError(LookupError):
+    """A skill lookup failed; ``str()`` is the text a tool result shows."""
+
+
+class SkillNotFound(SkillError):
+    pass
+
+
+class AmbiguousSkill(SkillError):
+    def __init__(self, name: str, choices: Sequence[str]) -> None:
+        self.name = name
+        self.choices = tuple(choices)
+        listed = ", ".join(self.choices)
+        super().__init__(f"ambiguous skill name {name!r}, use one of: {listed}")
+
+
+class SkillDisabled(SkillError):
+    pass
+
+
+class SkillBroken(SkillError):
+    pass
+
+
+# -- settings -----------------------------------------------------------------------------------
+
+
+def skills_setting(scope: Scope, key: str) -> Any:
+    """``key`` from the scope's config (re-read when the file changed), else the default."""
+    config: Any = scope.config
+    try:
+        if isinstance(config, loader.ConfigView) and config.path == loader.config_path(scope):
+            config = loader.load(scope)
+        value = config.get(key) if config is not None else None
+    except Exception:
+        log.debug("config read failed for %s", key, exc_info=True)
+        value = None
+    return default_for(key) if value is None else value
+
+
+def _str_list(value: object) -> list[str]:
+    if isinstance(value, str):
+        return [value] if value.strip() else []
+    if isinstance(value, list | tuple):
+        return [str(v).strip() for v in value if str(v).strip()]  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+    return []
+
+
+@dataclass(frozen=True)
+class SkillsSettings:
+    """The skill settings of one profile, read once per catalog build."""
+
+    local_root: Path
+    create_dir: Path | None = None
+    external_dirs: tuple[Path, ...] = ()
+    disabled: frozenset[str] = frozenset()
+    project_dirs: tuple[Path, ...] = ()
+    plugin_roots: Mapping[str, Path] = field(default_factory=dict[str, Path])
+
+    @property
+    def write_root(self) -> Path:
+        """Where a new agent-created skill goes."""
+        return self.create_dir if self.create_dir is not None else self.local_root
+
+    @classmethod
+    def from_scope(cls, scope: Scope, *, platform: str | None = None) -> SkillsSettings:
+        env = dict(scope.env)
+        home_dir = Path(env.get("HOME") or Path.home())
+
+        def expand(raw: str) -> Path:
+            return expand_path_text(raw, env, lambda: home_dir)
+
+        create_raw = skills_setting(scope, "skills.create_dir")
+        create_dir = expand(create_raw) if isinstance(create_raw, str) and create_raw else None
+        externals = tuple(
+            expand(raw) for raw in _str_list(skills_setting(scope, "skills.external_dirs"))
+        )
+        disabled = set(_str_list(skills_setting(scope, "skills.disabled")))
+        if platform:
+            per = skills_setting(scope, "skills.platform_disabled")
+            if isinstance(per, Mapping):
+                disabled.update(_str_list(per.get(platform)))  # pyright: ignore[reportUnknownMemberType, reportUnknownArgumentType]
+        return cls(
+            local_root=scope.home / "skills",
+            create_dir=create_dir,
+            external_dirs=externals,
+            disabled=frozenset(disabled),
+        )
+
+    def roots(self) -> list[tuple[int, Path]]:
+        """``(tier, folder)`` in precedence order, each folder once (missing ones included)."""
+        listed: list[tuple[int, Path]] = [(TIER_PROJECT, d) for d in self.project_dirs]
+        listed.append((TIER_LOCAL, self.local_root))
+        if self.create_dir is not None:
+            listed.append((TIER_CREATE_DIR, self.create_dir))
+        listed.extend((TIER_EXTERNAL, d) for d in self.external_dirs)
+        seen: set[str] = set()
+        out: list[tuple[int, Path]] = []
+        for tier, folder in listed:
+            key = os.path.normcase(os.path.abspath(folder))
+            if key in seen:
+                continue
+            seen.add(key)
+            out.append((tier, folder))
+        return out
+
+
+# -- records ------------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class SkillRecord:
+    name: str
+    tier: int
+    root: Path
+    skill_dir: Path
+    relative_path: str
+    frontmatter: SkillFrontmatter | None
+    error: str | None = None
+    status: Status = "unique"
+    load_name: str | None = None
+    disabled: bool = False
+    plugin: str | None = None
+
+    @property
+    def skill_md(self) -> Path:
+        return self.skill_dir / SKILL_FILE
+
+    @property
+    def description(self) -> str:
+        return self.frontmatter.description.strip() if self.frontmatter is not None else ""
+
+    @property
+    def category(self) -> str | None:
+        if self.frontmatter is not None and self.frontmatter.indus.category:
+            return self.frontmatter.indus.category
+        parent = Path(self.relative_path).parent.as_posix()
+        return None if parent in ("", ".") else parent
+
+    @property
+    def tier_name(self) -> str:
+        return TIER_NAMES.get(self.tier, str(self.tier))
+
+
+@dataclass(frozen=True)
+class _Parsed:
+    name: str
+    frontmatter: SkillFrontmatter | None
+    error: str | None
+
+
+_CACHE: dict[str, tuple[int, int, _Parsed]] = {}
+_CACHE_LOCK = threading.Lock()
+_SHADOW_LOGGED: set[tuple[str, str]] = set()
+
+
+def clear_scan_cache() -> None:
+    with _CACHE_LOCK:
+        _CACHE.clear()
+        _SHADOW_LOGGED.clear()
+
+
+def _parse_cached(skill_md: Path, folder_name: str) -> _Parsed:
+    try:
+        st = skill_md.stat()
+    except OSError as exc:
+        return _Parsed(folder_name, None, f"cannot read SKILL.md: {exc.strerror or exc}")
+    key = str(skill_md)
+    with _CACHE_LOCK:
+        hit = _CACHE.get(key)
+        if hit is not None and hit[0] == st.st_mtime_ns and hit[1] == st.st_size:
+            return hit[2]
+    try:
+        parsed_skill = parse_skill(skill_md.read_text(encoding="utf-8"))
+        parsed = _Parsed(parsed_skill.frontmatter.name.strip(), parsed_skill.frontmatter, None)
+    except (OSError, UnicodeDecodeError) as exc:
+        parsed = _Parsed(folder_name, None, f"cannot read SKILL.md: {exc}")
+    except SkillFormatError as exc:
+        parsed = _Parsed(folder_name, None, str(exc))
+    with _CACHE_LOCK:
+        _CACHE[key] = (st.st_mtime_ns, st.st_size, parsed)
+    return parsed
+
+
+def _scan_root(
+    tier: int, root: Path, plugin: str | None = None
+) -> tuple[list[SkillRecord], dict[str, str]]:
+    """Records under ``root`` and the category labels found there (category path → text)."""
+    records: list[SkillRecord] = []
+    labels: dict[str, str] = {}
+    if not root.is_dir():
+        log.debug("skill folder %s is missing; skipped", root)
+        return records, labels
+    # Symlinked folders are followed (a symlink view of a skill is one skill); the real paths
+    # on the way down are tracked so a link back to an ancestor cannot loop.
+    chains: dict[str, frozenset[str]] = {}
+    for current, dirs, files in os.walk(root, followlinks=True):
+        real = os.path.realpath(current)
+        above = chains.get(os.path.dirname(current), frozenset())
+        if real in above:
+            dirs[:] = []
+            continue
+        chains[current] = above | {real}
+        here = Path(current)
+        rel = here.relative_to(root).as_posix()
+        if SKILL_FILE in files and here != root:
+            dirs[:] = []
+            parsed = _parse_cached(here / SKILL_FILE, here.name)
+            name = f"{plugin}:{parsed.name}" if plugin else parsed.name
+            records.append(
+                SkillRecord(
+                    name=name,
+                    tier=tier,
+                    root=root,
+                    skill_dir=here,
+                    relative_path=rel,
+                    frontmatter=parsed.frontmatter,
+                    error=parsed.error,
+                    status="broken" if parsed.error else "unique",
+                    load_name=None if parsed.error else name,
+                    plugin=plugin,
+                )
+            )
+            continue
+        if CATEGORY_FILE in files and here != root:
+            label = _category_label(here / CATEGORY_FILE)
+            if label:
+                labels[rel] = label
+        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and d not in SKIP_DIRS)
+    return records, labels
+
+
+def _category_label(path: Path) -> str:
+    try:
+        raw, _ = split_frontmatter(path.read_text(encoding="utf-8"))
+    except (OSError, UnicodeDecodeError, SkillFormatError):
+        return ""
+    value = raw.get("description")
+    return value.strip() if isinstance(value, str) else ""
+
+
+def _same_skill(paths: Iterable[Path]) -> bool:
+    items = list(paths)
+    try:
+        if len({os.path.realpath(p) for p in items}) == 1:
+            return True
+        return len({hashlib.sha256(p.read_bytes()).hexdigest() for p in items}) == 1
+    except OSError:
+        return False
+
+
+def _depth(record: SkillRecord) -> tuple[int, str]:
+    return (len(Path(record.relative_path).parts), record.relative_path)
+
+
+def _resolve_statuses(records: list[SkillRecord]) -> list[SkillRecord]:
+    out = list(records)
+    groups: dict[str, list[int]] = {}
+    for i, rec in enumerate(out):
+        if rec.status != "broken":
+            groups.setdefault(rec.name, []).append(i)
+    rel_owners: dict[tuple[int, str], int] = {}
+    for rec in out:
+        key = (rec.tier, rec.relative_path)
+        rel_owners[key] = rel_owners.get(key, 0) + 1
+    for name, idxs in groups.items():
+        top = min(out[i].tier for i in idxs)
+        contenders = sorted((i for i in idxs if out[i].tier == top), key=lambda i: _depth(out[i]))
+        if len(contenders) == 1 or _same_skill(out[i].skill_md for i in contenders):
+            winner = contenders[0]
+            out[winner] = replace(out[winner], status="unique", load_name=name)
+            for i in contenders[1:]:
+                out[i] = replace(out[i], status="shadowed", load_name=None)
+        else:
+            for i in contenders:
+                rec = out[i]
+                path_free = rel_owners[(rec.tier, rec.relative_path)] == 1
+                out[i] = replace(
+                    rec, status="ambiguous", load_name=rec.relative_path if path_free else None
+                )
+            winner = None
+        for i in idxs:
+            rec = out[i]
+            if rec.tier == top:
+                continue
+            out[i] = replace(rec, status="shadowed", load_name=None)
+            owner = out[winner].skill_md if winner is not None else None
+            key = (str(rec.skill_md), name)
+            if key in _SHADOW_LOGGED:
+                continue
+            _SHADOW_LOGGED.add(key)
+            if owner is not None and _same_skill([rec.skill_md, owner]):
+                continue
+            log.warning(
+                "skill %r at %s is hidden by a copy in a higher tier (%s)",
+                name,
+                rec.skill_dir,
+                TIER_NAMES.get(top, top),
+            )
+    return out
+
+
+# -- the catalog --------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class SkillCatalog:
+    """Every scanned skill with its resolution status. Build with ``load_catalog``."""
+
+    settings: SkillsSettings
+    records: tuple[SkillRecord, ...]
+    category_labels: Mapping[str, str] = field(default_factory=dict[str, str])
+
+    def loadable(self) -> list[SkillRecord]:
+        """Unique and ambiguous skills, disabled ones included (sorted by category, name)."""
+        rows = [r for r in self.records if r.status in ("unique", "ambiguous")]
+        return sorted(rows, key=lambda r: (r.category or "", r.name, r.relative_path))
+
+    def visible(self, ctx: VisibilityContext | None = None) -> list[SkillRecord]:
+        """What a session is offered: loadable, not disabled, passing the visibility rules."""
+        rows: list[SkillRecord] = []
+        for rec in self.loadable():
+            if rec.disabled or rec.frontmatter is None:
+                continue
+            if ctx is not None and not visible(rec.frontmatter, ctx):
+                continue
+            rows.append(rec)
+        return rows
+
+    def ambiguous_names(self) -> dict[str, list[SkillRecord]]:
+        out: dict[str, list[SkillRecord]] = {}
+        for rec in self.loadable():
+            if rec.status == "ambiguous" and not rec.disabled:
+                out.setdefault(rec.name, []).append(rec)
+        return out
+
+    def _match(self, identifier: str) -> list[SkillRecord]:
+        ident = identifier.strip().strip("/")
+        live = [r for r in self.records if r.status != "shadowed"]
+        by_name = [r for r in live if r.name == ident]
+        if by_name:
+            return by_name
+        by_path = [r for r in live if r.relative_path == ident]
+        if by_path:
+            return by_path
+        candidate = Path(identifier).expanduser()
+        if candidate.is_absolute():
+            real = os.path.realpath(candidate)
+            return [
+                r
+                for r in live
+                if os.path.realpath(r.skill_dir) == real or os.path.realpath(r.skill_md) == real
+            ]
+        return []
+
+    def resolve(self, identifier: str) -> SkillRecord:
+        """The one skill ``identifier`` (name, relative path or absolute path) names."""
+        found = self._match(identifier)
+        healthy = [r for r in found if r.status != "broken"]
+        if not found:
+            raise SkillNotFound(f"no skill named {identifier!r}")
+        if not healthy:
+            raise SkillBroken(f"skill {identifier!r} cannot be loaded: {found[0].error}")
+        if len(healthy) > 1:
+            choices = [r.load_name or str(r.skill_dir) for r in healthy]
+            raise AmbiguousSkill(identifier.strip(), choices)
+        rec = healthy[0]
+        if rec.status == "ambiguous" and identifier.strip() == rec.name:
+            raise AmbiguousSkill(rec.name, [rec.load_name or str(rec.skill_dir)])
+        if rec.disabled:
+            raise SkillDisabled(
+                f"skill {rec.name!r} is disabled in this profile (skills.disabled); enable it "
+                "with `indus config` before using it"
+            )
+        return rec
+
+    def find(self, identifier: str) -> SkillRecord | None:
+        try:
+            return self.resolve(identifier)
+        except SkillError:
+            return None
+
+
+def load_catalog(
+    scope: Scope | None = None,
+    *,
+    platform: str | None = None,
+    settings: SkillsSettings | None = None,
+) -> SkillCatalog:
+    """Scan every root of ``settings`` (default: read from ``scope``) and resolve names."""
+    if settings is None:
+        if scope is None:
+            raise ValueError("load_catalog needs a scope or settings")
+        settings = SkillsSettings.from_scope(scope, platform=platform)
+    records: list[SkillRecord] = []
+    labels: dict[str, str] = {}
+    for tier, root in settings.roots():
+        found, root_labels = _scan_root(tier, root)
+        records.extend(found)
+        for key, text in root_labels.items():
+            labels.setdefault(key, text)
+    resolved = _resolve_statuses(records)
+    for plugin, root in sorted(settings.plugin_roots.items()):
+        found, _ = _scan_root(TIER_PLUGIN, root, plugin=plugin)
+        resolved.extend(found)
+    disabled = settings.disabled
+    if disabled:
+        resolved = [
+            replace(r, disabled=True)
+            if r.name in disabled or (r.load_name is not None and r.load_name in disabled)
+            else r
+            for r in resolved
+        ]
+    return SkillCatalog(settings=settings, records=tuple(resolved), category_labels=labels)
