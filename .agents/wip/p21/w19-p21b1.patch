new file mode 100644
index 0000000..17aecb2
--- /dev/null
+++ b/tests/fakes/backend/fake_modal.py
@@ -0,0 +1,572 @@
+"""A fake of the Modal SDK's sync API, the parts the Modal backend calls (P21-15).
+
+``FakeModal(cloud).module`` stands in for ``modal`` (``install(monkeypatch)`` also registers it in
+``sys.modules`` as ``modal`` and ``modal.exception``). Names and argument names follow modal 1.6.1
+(``tests/fakes/backend/sdk_surfaces.json``); see ``docs/notes/P21/fake-sdks.md`` for the surface.
+
+Behaviour: ``Sandbox.create`` resets the cloud's file tree to the image (a registry image is
+empty, an image from ``snapshot_filesystem`` restores its tree, an unknown ``im-`` id fails with
+``NotFoundError``). ``exec`` starts a real process at once (``Cloud.start``); stdin bytes reach it
+on ``drain()``, ``write_eof()`` closes it; ``stdout.read()`` waits for the end. Errors scripted by
+status carry ``.status`` as a gRPC-style enum, like the real ones.
+"""
+
+from __future__ import annotations
+
+import enum
+import subprocess
+import sys
+import threading
+import types
+from collections.abc import Collection, Mapping, Sequence
+from typing import Any
+
+import pytest
+
+from tests.fakes.backend.sdk_kit import Cloud
+
+DEFAULT_TIMEOUT_S = 300
+
+
+class FakeGrpcStatus(enum.IntEnum):
+    OK = 0
+    INVALID_ARGUMENT = 3
+    DEADLINE_EXCEEDED = 4
+    NOT_FOUND = 5
+    ALREADY_EXISTS = 6
+    PERMISSION_DENIED = 7
+    RESOURCE_EXHAUSTED = 8
+    FAILED_PRECONDITION = 9
+    INTERNAL = 13
+    UNAVAILABLE = 14
+    UNAUTHENTICATED = 16
+
+
+_STATUS_FOR_HTTP: dict[int, FakeGrpcStatus] = {
+    400: FakeGrpcStatus.INVALID_ARGUMENT,
+    401: FakeGrpcStatus.UNAUTHENTICATED,
+    403: FakeGrpcStatus.PERMISSION_DENIED,
+    404: FakeGrpcStatus.NOT_FOUND,
+    409: FakeGrpcStatus.ALREADY_EXISTS,
+    429: FakeGrpcStatus.RESOURCE_EXHAUSTED,
+    500: FakeGrpcStatus.INTERNAL,
+    503: FakeGrpcStatus.UNAVAILABLE,
+    504: FakeGrpcStatus.DEADLINE_EXCEEDED,
+}
+
+
+# -- modal.exception -------------------------------------------------------------------------------
+
+
+class Error(Exception):
+    def __init__(self, message: str = "", status: FakeGrpcStatus | None = None) -> None:
+        super().__init__(message)
+        self.status = status
+
+
+class NotFoundError(Error): ...
+
+
+class InvalidError(Error): ...
+
+
+class AuthError(Error): ...
+
+
+class ConnectionError(Error): ...  # noqa: A001 - the vendor's name
+
+
+class ServiceError(Error): ...
+
+
+class ResourceExhaustedError(Error): ...
+
+
+class InternalError(Error): ...
+
+
+class TimeoutError(Error): ...  # noqa: A001 - the vendor's name
+
+
+class SandboxTimeoutError(TimeoutError): ...
+
+
+class ExecTimeoutError(TimeoutError): ...
+
+
+class SandboxTerminatedError(Error): ...
+
+
+_CLASS_FOR_STATUS: dict[FakeGrpcStatus, type[Error]] = {
+    FakeGrpcStatus.NOT_FOUND: NotFoundError,
+    FakeGrpcStatus.INVALID_ARGUMENT: InvalidError,
+    FakeGrpcStatus.UNAUTHENTICATED: AuthError,
+    FakeGrpcStatus.PERMISSION_DENIED: AuthError,
+    FakeGrpcStatus.RESOURCE_EXHAUSTED: ResourceExhaustedError,
+    FakeGrpcStatus.INTERNAL: InternalError,
+    FakeGrpcStatus.UNAVAILABLE: ServiceError,
+    FakeGrpcStatus.DEADLINE_EXCEEDED: TimeoutError,
+}
+
+
+def error_for(status: int, message: str) -> Error:
+    grpc = _STATUS_FOR_HTTP.get(status, FakeGrpcStatus.INTERNAL)
+    return _CLASS_FOR_STATUS.get(grpc, Error)(message, status=grpc)
+
+
+# -- objects --------------------------------------------------------------------------------------
+
+
+class FakeApp:
+    def __init__(self, name: str, app_id: str) -> None:
+        self.name = name
+        self.app_id = app_id
+
+
+class FakeClient:
+    def __init__(self, token_id: str, token_secret: str) -> None:
+        self.token_id = token_id
+        self.token_secret = token_secret
+
+
+class FakeImage:
+    def __init__(self, object_id: str, *, tag: str | None = None) -> None:
+        self.object_id = object_id
+        self.tag = tag
+
+
+class FakeStreamReader:
+    def __init__(self, process: FakeContainerProcess, which: str) -> None:
+        self._process = process
+        self._which = which
+
+    def read(self) -> Any:
+        self._process._record("StreamReader.read")
+        out, err = self._process._collect()
+        data = out if self._which == "stdout" else err
+        return data.decode("utf-8", "replace") if self._process.text else data
+
+
+class FakeStreamWriter:
+    def __init__(self, process: FakeContainerProcess) -> None:
+        self._process = process
+        self._buffer = bytearray()
+        self.chunks: list[bytes] = []
+        self.eof = False
+
+    def write(self, data: bytes | bytearray | memoryview | str) -> None:
+        self._process._record("StreamWriter.write", len(data))
+        if self.eof:
+            raise ValueError("stdin is closed")
+        raw = data.encode("utf-8") if isinstance(data, str) else bytes(data)
+        self._buffer += raw
+        self.chunks.append(raw)
+
+    def write_eof(self) -> None:
+        self._process._record("StreamWriter.write_eof")
+        self.eof = True
+
+    def drain(self) -> None:
+        self._process._record("StreamWriter.drain")
+        self._process._feed(bytes(self._buffer), close=self.eof)
+        self._buffer.clear()
+
+
+class FakeContainerProcess:
+    def __init__(
+        self,
+        sandbox: FakeModalSandbox,
+        argv: Sequence[str],
+        *,
+        workdir: str | None,
+        env: Mapping[str, str | None] | None,
+        timeout: int | None,
+        text: bool,
+    ) -> None:
+        self.sandbox = sandbox
+        self.argv = list(argv)
+        self.text = text
+        self.timeout = timeout
+        cloud = sandbox.fake.cloud
+        clean = {k: v for k, v in (env or {}).items() if v is not None}
+        self._popen: subprocess.Popen[bytes] | None = None
+        self._scripted = cloud.scripted(self.argv)
+        if self._scripted is None:
+            self._popen = cloud.start(self.argv, cwd=workdir, env=clean)
+        self._out: bytes | None = None
+        self._err: bytes | None = None
+        self._lock = threading.Lock()
+        self.stdout = FakeStreamReader(self, "stdout")
+        self.stderr = FakeStreamReader(self, "stderr")
+        self.stdin = FakeStreamWriter(self)
+        self._returncode: int | None = None
+
+    def _record(self, method: str, *args: Any) -> None:
+        self.sandbox.fake.cloud.enter(method, args, {}, error_for)
+
+    def _feed(self, data: bytes, *, close: bool) -> None:
+        popen = self._popen
+        if popen is None or popen.stdin is None or popen.stdin.closed:
+            return
+        try:
+            if data:
+                popen.stdin.write(data)
+                popen.stdin.flush()
+            if close:
+                popen.stdin.close()
+        except BrokenPipeError:
+            pass
+
+    def _collect(self) -> tuple[bytes, bytes]:
+        with self._lock:
+            if self._out is not None and self._err is not None:
+                return self._out, self._err
+            if self._scripted is not None:
+                self._out, self._err = self._scripted.stdout, self._scripted.stderr
+                self._returncode = self._scripted.returncode
+                return self._out, self._err
+            popen = self._popen
+            assert popen is not None
+            if popen.stdin is not None and not popen.stdin.closed and self.stdin.eof:
+                popen.stdin.close()
+            try:
+                out, err = popen.communicate(timeout=self.timeout)
+            except subprocess.TimeoutExpired:
+                popen.kill()
+                out, err = popen.communicate()
+            self._out, self._err = out or b"", err or b""
+            self._returncode = popen.returncode if popen.returncode >= 0 else 137
+            return self._out, self._err
+
+    @property
+    def returncode(self) -> int:
+        if self._returncode is None:
+            raise InvalidError("the process has not finished; call wait() first")
+        return self._returncode
+
+    def poll(self) -> int | None:
+        self._record("ContainerProcess.poll")
+        if self._returncode is not None:
+            return self._returncode
+        if self._popen is not None and self._popen.poll() is None:
+            return None
+        self._collect()
+        return self._returncode
+
+    def wait(self) -> int:
+        self._record("ContainerProcess.wait")
+        self._collect()
+        assert self._returncode is not None
+        return self._returncode
+
+
+class FakeModalSandbox:
+    def __init__(
+        self,
+        fake: FakeModal,
+        object_id: str,
+        *,
+        app: FakeApp | None,
+        name: str | None,
+        image: FakeImage | None,
+        env: Mapping[str, str | None],
+        timeout: int,
+        workdir: str | None,
+        cpu: Any,
+        memory: Any,
+        tags: Mapping[str, str],
+    ) -> None:
+        self.fake = fake
+        self.object_id = object_id
+        self.app = app
+        self.name = name
+        self.image = image
+        self.env = dict(env)
+        self.timeout = timeout
+        self.workdir = workdir
+        self.cpu = cpu
+        self.memory = memory
+        self.tags = dict(tags)
+        self.terminated = False
+        self._returncode: int | None = None
+        self.processes: list[FakeContainerProcess] = []
+
+    def _enter(self, method: str, *args: Any, **kwargs: Any) -> None:
+        self.fake.cloud.enter(f"Sandbox.{method}", args, kwargs, error_for)
+        if self.terminated and method not in ("terminate", "poll", "wait", "get_tags", "detach"):
+            raise SandboxTerminatedError(f"sandbox {self.object_id} was terminated")
+
+    @property
+    def returncode(self) -> int | None:
+        return self._returncode
+
+    def exec(
+        self,
+        *args: str,
+        stdout: Any = None,
+        stderr: Any = None,
+        timeout: int | None = None,
+        workdir: str | None = None,
+        env: Mapping[str, str | None] | None = None,
+        secrets: Collection[Any] | None = None,
+        text: bool = True,
+        bufsize: int = -1,
+        pty: bool = False,
+    ) -> FakeContainerProcess:
+        self._enter("exec", *args, timeout=timeout, workdir=workdir, env=env, text=text)
+        process = FakeContainerProcess(
+            self,
+            args,
+            workdir=workdir or self.workdir,
+            env={**self.env, **(env or {})},
+            timeout=timeout,
+            text=text,
+        )
+        self.processes.append(process)
+        return process
+
+    def snapshot_filesystem(
+        self, timeout: int = 55, *, ttl: int | None = 30 * 24 * 3600
+    ) -> FakeImage:
+        self._enter("snapshot_filesystem", timeout=timeout, ttl=ttl)
+        image_id = self.fake.cloud.next_id("im-snap")
+        self.fake.cloud.snapshots[image_id] = self.fake.cloud.fs.capture()
+        return FakeImage(image_id)
+
+    def terminate(self, *, wait: bool = False) -> int | None:
+        self._enter("terminate", wait=wait)
+        self.terminated = True
+        self._returncode = self._returncode if self._returncode is not None else 0
+        return self._returncode if wait else None
+
+    def poll(self) -> int | None:
+        self._enter("poll")
+        return self._returncode
+
+    def wait(self, raise_on_termination: bool = True) -> None:
+        self._enter("wait", raise_on_termination=raise_on_termination)
+        if self.terminated and raise_on_termination:
+            raise SandboxTerminatedError(f"sandbox {self.object_id} was terminated")
+
+    def get_tags(self) -> dict[str, str]:
+        self._enter("get_tags")
+        return dict(self.tags)
+
+    def set_tags(self, tags: dict[str, str], *, client: FakeClient | None = None) -> None:
+        self._enter("set_tags", tags)
+        self.tags = dict(tags)
+
+    def detach(self) -> None:
+        self._enter("detach")
+
+
+# -- the class-level API (what the backend reaches as modal.App / modal.Sandbox / …) --------------
+
+
+class _AppApi:
+    def __init__(self, fake: FakeModal) -> None:
+        self._fake = fake
+
+    def lookup(
+        self,
+        name: str,
+        *,
+        client: FakeClient | None = None,
+        environment_name: str | None = None,
+        create_if_missing: bool = False,
+    ) -> FakeApp:
+        self._fake.record("App.lookup", name, create_if_missing=create_if_missing, client=client)
+        app = self._fake.apps.get(name)
+        if app is None:
+            if not create_if_missing:
+                raise NotFoundError(f"app {name!r} not found", status=FakeGrpcStatus.NOT_FOUND)
+            app = FakeApp(name, self._fake.cloud.next_id("ap-"))
+            self._fake.apps[name] = app
+        return app
+
+
+class _ClientApi:
+    def __init__(self, fake: FakeModal) -> None:
+        self._fake = fake
+
+    def from_credentials(self, token_id: str, token_secret: str) -> FakeClient:
+        self._fake.record("Client.from_credentials", "<id>", "<secret>")
+        expected = self._fake.tokens
+        if expected is not None and (token_id, token_secret) != expected:
+            raise AuthError("token rejected", status=FakeGrpcStatus.UNAUTHENTICATED)
+        return FakeClient(token_id, token_secret)
+
+
+class _ImageApi:
+    def __init__(self, fake: FakeModal) -> None:
+        self._fake = fake
+
+    def from_registry(
+        self,
+        tag: str,
+        secret: Any = None,
+        *,
+        setup_dockerfile_commands: Sequence[str] = (),
+        force_build: bool = False,
+        add_python: str | None = None,
+        **kwargs: Any,
+    ) -> FakeImage:
+        self._fake.record("Image.from_registry", tag, setup=list(setup_dockerfile_commands))
+        return FakeImage(f"im-registry-{tag}", tag=tag)
+
+    def from_id(self, image_id: str, client: FakeClient | None = None) -> FakeImage:
+        self._fake.record("Image.from_id", image_id)
+        return FakeImage(image_id)
+
+
+class _SandboxApi:
+    def __init__(self, fake: FakeModal) -> None:
+        self._fake = fake
+
+    def create(
+        self,
+        *args: str,
+        app: FakeApp | None = None,
+        name: str | None = None,
+        tags: dict[str, str] | None = None,
+        image: FakeImage | None = None,
+        env: dict[str, str | None] | None = None,
+        secrets: Collection[Any] | None = None,
+        timeout: int = DEFAULT_TIMEOUT_S,
+        idle_timeout: int | None = None,
+        workdir: str | None = None,
+        cpu: Any = None,
+        memory: Any = None,
+        block_network: bool = False,
+        verbose: bool = False,
+        client: FakeClient | None = None,
+        **kwargs: Any,
+    ) -> FakeModalSandbox:
+        fake = self._fake
+        fake.record(
+            "Sandbox.create",
+            *args,
+            app=app,
+            name=name,
+            image=image,
+            env=env,
+            timeout=timeout,
+            workdir=workdir,
+            cpu=cpu,
+            memory=memory,
+            client=client,
+        )
+        if app is None:
+            raise InvalidError("app is required", status=FakeGrpcStatus.INVALID_ARGUMENT)
+        cloud = fake.cloud
+        if image is not None and image.object_id.startswith("im-") and image.tag is None:
+            data = cloud.snapshots.get(image.object_id)
+            if data is None:
+                raise NotFoundError(
+                    f"image {image.object_id} not found", status=FakeGrpcStatus.NOT_FOUND
+                )
+            cloud.fs.restore(data)
+        else:
+            cloud.fs.wipe()
+            tag = image.tag if image is not None and image.tag is not None else ""
+            for path, content in cloud.images.get(tag, {}).items():
+                cloud.fs.write(path, content)
+        sandbox = FakeModalSandbox(
+            fake,
+            cloud.next_id("sb-"),
+            app=app,
+            name=name,
+            image=image,
+            env=env or {},
+            timeout=timeout,
+            workdir=workdir,
+            cpu=cpu,
+            memory=memory,
+            tags=tags or {},
+        )
+        fake.sandboxes[sandbox.object_id] = sandbox
+        return sandbox
+
+    def from_id(self, sandbox_id: str, client: FakeClient | None = None) -> FakeModalSandbox:
+        self._fake.record("Sandbox.from_id", sandbox_id)
+        found = self._fake.sandboxes.get(sandbox_id)
+        if found is None:
+            raise NotFoundError(f"sandbox {sandbox_id} not found", status=FakeGrpcStatus.NOT_FOUND)
+        return found
+
+    def from_name(
+        self,
+        app_name: str,
+        name: str,
+        *,
+        environment_name: str | None = None,
+        client: FakeClient | None = None,
+    ) -> FakeModalSandbox:
+        self._fake.record("Sandbox.from_name", app_name, name)
+        for sandbox in self._fake.sandboxes.values():
+            app = sandbox.app
+            same_app = app is not None and app.name == app_name
+            if sandbox.name == name and same_app and not sandbox.terminated:
+                return sandbox
+        raise NotFoundError(f"sandbox {name} not found", status=FakeGrpcStatus.NOT_FOUND)
+
+
+class FakeModal:
+    """The fake ``modal`` package bound to one ``Cloud`` (see the module notes)."""
+
+    def __init__(self, cloud: Cloud, *, tokens: tuple[str, str] | None = None) -> None:
+        self.cloud = cloud
+        self.tokens = tokens
+        self.apps: dict[str, FakeApp] = {}
+        self.sandboxes: dict[str, FakeModalSandbox] = {}
+        exception = types.ModuleType("modal.exception")
+        for cls in (
+            Error,
+            NotFoundError,
+            InvalidError,
+            AuthError,
+            ConnectionError,
+            ServiceError,
+            ResourceExhaustedError,
+            InternalError,
+            TimeoutError,
+            SandboxTimeoutError,
+            ExecTimeoutError,
+            SandboxTerminatedError,
+        ):
+            setattr(exception, cls.__name__, cls)
+        module = types.ModuleType("modal")
+        members: dict[str, object] = {
+            "App": _AppApi(self),
+            "Client": _ClientApi(self),
+            "Image": _ImageApi(self),
+            "Sandbox": _SandboxApi(self),
+            "exception": exception,
+            "__version__": "1.6.1",
+        }
+        for key, value in members.items():
+            setattr(module, key, value)
+        self.module = module
+        self.exception = exception
+
+    def record(self, method: str, *args: Any, **kwargs: Any) -> None:
+        self.cloud.enter(method, args, kwargs, error_for)
+
+    def install(self, monkeypatch: pytest.MonkeyPatch) -> types.ModuleType:
+        monkeypatch.setitem(sys.modules, "modal", self.module)
+        monkeypatch.setitem(sys.modules, "modal.exception", self.exception)
+        return self.module
+
+
+# Fake classes and the vendor classes their public names are checked against
+# (tests/unit/fakes/test_fake_sdks.py, sdk_surfaces.json).
+SURFACE: dict[str, type] = {
+    "modal.App": _AppApi,
+    "modal.Client": _ClientApi,
+    "modal.Image": _ImageApi,
+    "modal.Sandbox": _SandboxApi,
+    "modal.Sandbox#instance": FakeModalSandbox,
+    "modal.container_process.ContainerProcess": FakeContainerProcess,
+    "modal.io_streams.StreamReader": FakeStreamReader,
+    "modal.io_streams.StreamWriter": FakeStreamWriter,
+}
diff --git a/tests/fakes/backend/fake_vercel.py b/tests/fakes/backend/fake_vercel.py
new file mode 100644
index 0000000..028c957
--- /dev/null
+++ b/tests/fakes/backend/fake_vercel.py
@@ -0,0 +1,679 @@
+"""A fake of the Vercel Sandbox SDK's sync API, the parts the Vercel backend calls (P21-15).
+
+``FakeVercel(cloud).sync_module`` stands in for ``vercel.sandbox.sync`` and ``.module`` for
+``vercel.sandbox`` (``install(monkeypatch)`` registers ``vercel``, ``vercel.sandbox`` and
+``vercel.sandbox.sync``). Names and argument names follow vercel-sandbox 0.7.0
+(``tests/fakes/backend/sdk_surfaces.json``); see ``docs/notes/P21/fake-sdks.md``.
+
+Behaviour: sandboxes are named; ``create_sandbox`` makes a running one over the cloud's file tree
+(reset to the image's files, or restored from a ``SnapshotSource``). ``snapshot()`` captures the
+tree and leaves the sandbox stopped (as the vendor does); ``stop()`` keeps the tree; a stopped
+sandbox resumes on the next process or file call. Processes take ``command`` + ``args`` (no shell
+of their own); stdin is not supported, as in the SDK.
+"""
+
+from __future__ import annotations
+
+import enum
+import sys
+import types
+from collections.abc import Callable, Mapping, Sequence
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Any
+
+import pytest
+
+from tests.fakes.backend.sdk_kit import Cloud
+
+WORKSPACE = "/vercel/sandbox"
+
+
+# -- errors ----------------------------------------------------------------------------------------
+
+
+class SandboxError(Exception): ...
+
+
+class SandboxApiError(SandboxError):
+    class _Response:
+        def __init__(self, status_code: int) -> None:
+            self.status_code = status_code
+
+    def __init__(self, message: str, status_code: int) -> None:
+        super().__init__(message)
+        self.status_code = status_code
+        self.response = self._Response(status_code)
+
+
+class SandboxCredentialsError(SandboxError): ...
+
+
+class SandboxTimeoutError(SandboxError): ...
+
+
+class SandboxResponseError(SandboxError): ...
+
+
+class SandboxFilesystemError(SandboxError): ...
+
+
+class SandboxPathNotFoundError(SandboxFilesystemError): ...
+
+
+class SandboxFilesystemWriteError(SandboxFilesystemError): ...
+
+
+class SandboxFilesystemCommandError(SandboxFilesystemError): ...
+
+
+class SandboxTerminalStateError(SandboxError): ...
+
+
+def error_for(status: int, message: str) -> SandboxApiError:
+    return SandboxApiError(message, status)
+
+
+# -- models ----------------------------------------------------------------------------------------
+
+
+class SandboxStatus(enum.StrEnum):
+    """The vendor's lifecycle states (alphabetical here)."""
+
+    ABORTED = "aborted"
+    FAILED = "failed"
+    PENDING = "pending"
+    RUNNING = "running"
+    SNAPSHOTTING = "snapshotting"
+    STOPPED = "stopped"
+    STOPPING = "stopping"
+
+
+@dataclass(frozen=True)
+class SandboxCredentials:
+    token: str
+    team_id: str
+    project_id: str
+
+
+class SyncSandboxServiceOptions:
+    def __init__(
+        self,
+        *,
+        base_url: str | None = None,
+        credentials_factory: Callable[[], SandboxCredentials] | None = None,
+        file_transfer_timeout: timedelta | None = None,
+        region: str | None = None,
+    ) -> None:
+        self.base_url = base_url or "https://vercel.com/api"
+        self.credentials_factory = credentials_factory
+        self.file_transfer_timeout = file_transfer_timeout
+        self.region = region
+
+
+@dataclass(frozen=True)
+class SnapshotSource:
+    snapshot_id: str
+    type: str = "snapshot"
+
+
+@dataclass(frozen=True)
+class SandboxResources:
+    vcpus: int | None = None
+    memory: int | None = None
+
+
+@dataclass
+class CompletedProcess:
+    id: str
+    name: str
+    args: tuple[str, ...]
+    cwd: str
+    session_id: str
+    started_at: int
+    returncode: int
+    stdout: str | None
+    stderr: str | None
+
+    def check_returncode(self) -> None:
+        if self.returncode != 0:
+            raise SandboxError(f"process exited with {self.returncode}")
+
+
+# -- the sandbox -----------------------------------------------------------------------------------
+
+
+class SyncTextReader:
+    def __init__(self, text: str) -> None:
+        self._text = text
+
+    def read(self) -> str:
+        text, self._text = self._text, ""
+        return text
+
+
+class SyncProcess:
+    def __init__(
+        self,
+        sandbox: FakeVercelSandbox,
+        process_id: str,
+        argv: list[str],
+        cwd: str,
+        returncode: int,
+        stdout: str,
+        stderr: str,
+    ) -> None:
+        self._sandbox = sandbox
+        self.id = process_id
+        self.name = argv[0]
+        self.args = argv[1:]
+        self.cwd = cwd
+        self.signals: list[int] = []
+        self._returncode = returncode
+        self.stdout = SyncTextReader(stdout)
+        self.stderr = SyncTextReader(stderr)
+
+    @property
+    def returncode(self) -> int | None:
+        return self._returncode
+
+    def refresh(self) -> SyncProcess:
+        self._sandbox._enter("Process.refresh", self.id)
+        return self
+
+    def wait(self) -> int:
+        self._sandbox._enter("Process.wait", self.id)
+        return self._returncode
+
+    def send_signal(self, signal: int | str) -> None:
+        self._sandbox._enter("Process.send_signal", self.id, signal)
+        self.signals.append(int(signal) if isinstance(signal, int) else 15)
+
+    def terminate(self) -> None:
+        self.send_signal(15)
+
+    def kill(self) -> None:
+        self.send_signal(9)
+
+
+class SyncSnapshot:
+    def __init__(self, fake: FakeVercel, snapshot_id: str) -> None:
+        self._fake = fake
+        self.id = snapshot_id
+        self.status = "created"
+
+    def delete(self) -> SyncSnapshot:
+        self._fake.cloud.enter("Snapshot.delete", (self.id,), {}, error_for)
+        self._fake.cloud.snapshots.pop(self.id, None)
+        self.status = "deleted"
+        return self
+
+
+class SyncSandboxFilesystem:
+    def __init__(self, sandbox: FakeVercelSandbox) -> None:
+        self._sandbox = sandbox
+
+    def _path(self, method: str, path: str, cwd: str | None, **kwargs: Any) -> str:
+        self._sandbox._enter(f"Filesystem.{method}", path, cwd=cwd, **kwargs)
+        self._sandbox._ensure_running()
+        if path.startswith("/"):
+            return path
+        return f"{(cwd or self._sandbox.cwd).rstrip('/')}/{path}"
+
+    def read_bytes(self, path: str, *, cwd: str | None = None) -> bytes:
+        full = self._path("read_bytes", path, cwd)
+        fs = self._sandbox.fake.cloud.fs
+        if not fs.exists(full) or fs.is_dir(full):
+            raise SandboxPathNotFoundError(f"{full} not found")
+        return fs.read(full)
+
+    def read_text(self, path: str, *, cwd: str | None = None, encoding: str = "utf-8") -> str:
+        return self.read_bytes(path, cwd=cwd).decode(encoding)
+
+    def write_bytes(
+        self, path: str, data: bytes, *, cwd: str | None = None, mode: int | None = None
+    ) -> None:
+        full = self._path("write_bytes", path, cwd, size=len(data), mode=mode)
+        self._sandbox.fake.cloud.fs.write(full, data, mode=mode if mode is not None else 0o644)
+
+    def write_text(
+        self,
+        path: str,
+        text: str,
+        *,
+        cwd: str | None = None,
+        mode: int | None = None,
+        encoding: str = "utf-8",
+    ) -> None:
+        full = self._path("write_text", path, cwd, mode=mode)
+        self._sandbox.fake.cloud.fs.write(full, text.encode(encoding), mode=mode or 0o644)
+
+    def exists(self, path: str, *, cwd: str | None = None) -> bool:
+        return self._sandbox.fake.cloud.fs.exists(self._path("exists", path, cwd))
+
+    def is_file(self, path: str, *, cwd: str | None = None) -> bool:
+        full = self._path("is_file", path, cwd)
+        fs = self._sandbox.fake.cloud.fs
+        return fs.exists(full) and not fs.is_dir(full)
+
+    def is_dir(self, path: str, *, cwd: str | None = None) -> bool:
+        return self._sandbox.fake.cloud.fs.is_dir(self._path("is_dir", path, cwd))
+
+    def mkdir(self, path: str, *, cwd: str | None = None, recursive: bool = True) -> None:
+        self._sandbox.fake.cloud.fs.mkdir(self._path("mkdir", path, cwd, recursive=recursive))
+
+    def listdir(self, path: str, *, cwd: str | None = None) -> list[str]:
+        return self._sandbox.fake.cloud.fs.listdir(self._path("listdir", path, cwd))
+
+    def remove(
+        self,
+        path: str,
+        *,
+        cwd: str | None = None,
+        recursive: bool = False,
+        missing_ok: bool = False,
+    ) -> None:
+        full = self._path("remove", path, cwd, recursive=recursive, missing_ok=missing_ok)
+        fs = self._sandbox.fake.cloud.fs
+        if not fs.exists(full):
+            if missing_ok:
+                return
+            raise SandboxFilesystemCommandError(f"{full}: no such file or directory")
+        fs.remove(full, recursive=recursive)
+
+    def rename(self, source: str, destination: str, *, cwd: str | None = None) -> None:
+        full = self._path("rename", source, cwd, destination=destination)
+        dest = (
+            destination
+            if destination.startswith("/")
+            else f"{cwd or self._sandbox.cwd}/{destination}"
+        )
+        self._sandbox.fake.cloud.fs.rename(full, dest)
+
+
+class FakeVercelSandbox:
+    def __init__(
+        self,
+        fake: FakeVercel,
+        name: str,
+        *,
+        image: str | None,
+        persistent: bool | None,
+        env: Mapping[str, str],
+        resources: SandboxResources | None,
+        execution_time_limit: Any,
+        tags: Mapping[str, str],
+    ) -> None:
+        self.fake = fake
+        self._name = name
+        self._image = image
+        self._persistent = persistent
+        self.env = dict(env)
+        self.resources = resources
+        self.execution_time_limit = execution_time_limit
+        self.tags = dict(tags)
+        self._status = SandboxStatus.RUNNING
+        self._snapshot_id: str | None = None
+        self.destroyed = False
+        self._session = fake.cloud.next_id("ses_")
+        self.processes: list[SyncProcess] = []
+        self.fs = SyncSandboxFilesystem(self)
+
+    # -- state
+
+    def _enter(self, method: str, *args: Any, **kwargs: Any) -> None:
+        self.fake.cloud.enter(method, args, kwargs, error_for)
+        if self.destroyed:
+            raise SandboxTerminalStateError(f"sandbox {self._name} was destroyed")
+
+    def _ensure_running(self) -> None:
+        if self._status != SandboxStatus.RUNNING:
+            self.fake.resumes += 1
+            self._status = SandboxStatus.RUNNING
+            self._session = self.fake.cloud.next_id("ses_")
+
+    @property
+    def name(self) -> str:
+        return self._name
+
+    @property
+    def status(self) -> SandboxStatus:
+        return self._status
+
+    @property
+    def persistent(self) -> bool | None:
+        return self._persistent
+
+    @property
+    def current_snapshot_id(self) -> str | None:
+        return self._snapshot_id
+
+    @property
+    def current_session_id(self) -> str:
+        return self._session
+
+    @property
+    def image(self) -> str | None:
+        return self._image
+
+    @property
+    def cwd(self) -> str:
+        return WORKSPACE
+
+    # -- processes
+
+    def _run(
+        self,
+        command: str,
+        args: Sequence[str] | None,
+        cwd: str | None,
+        env: Mapping[str, str] | None,
+    ) -> tuple[list[str], str, int, str, str]:
+        self._ensure_running()
+        argv = [command, *(args or [])]
+        workdir = cwd or WORKSPACE
+        result = self.fake.cloud.run(argv, cwd=workdir, env={**self.env, **(env or {})})
+        out = result.stdout.decode("utf-8", "replace")
+        err = result.stderr.decode("utf-8", "replace")
+        return argv, workdir, result.returncode, out, err
+
+    def run_process(
+        self,
+        command: str,
+        args: Sequence[str] | None = None,
+        *,
+        cwd: str | None = None,
+        env: Mapping[str, str] | None = None,
+        sudo: bool = False,
+        kill_after: float | timedelta | None = None,
+        check: bool = False,
+        stdout: Any = None,
+        stderr: Any = None,
+        capture_output: bool = False,
+    ) -> CompletedProcess:
+        self._enter(
+            "Sandbox.run_process", command, args=list(args or []), cwd=cwd, env=env, sudo=sudo
+        )
+        argv, workdir, code, out, err = self._run(command, args, cwd, env)
+        done = CompletedProcess(
+            id=self.fake.cloud.next_id("cmd_"),
+            name=command,
+            args=tuple(argv),
+            cwd=workdir,
+            session_id=self._session,
+            started_at=0,
+            returncode=code,
+            stdout=out,
+            stderr=err,
+        )
+        if check:
+            done.check_returncode()
+        return done
+
+    def create_process(
+        self,
+        command: str,
+        args: Sequence[str] | None = None,
+        *,
+        cwd: str | None = None,
+        env: Mapping[str, str] | None = None,
+        sudo: bool = False,
+        kill_after: float | timedelta | None = None,
+        stdout: int = -1,
+        stderr: int = -1,
+    ) -> SyncProcess:
+        self._enter("Sandbox.create_process", command, args=list(args or []), cwd=cwd, env=env)
+        argv, workdir, code, out, err = self._run(command, args, cwd, env)
+        process = SyncProcess(self, self.fake.cloud.next_id("cmd_"), argv, workdir, code, out, err)
+        self.processes.append(process)
+        return process
+
+    # -- lifecycle
+
+    def snapshot(self, *, expiration: Any = None) -> SyncSnapshot:
+        self._enter("Sandbox.snapshot", expiration=expiration)
+        self._ensure_running()
+        snapshot_id = self.fake.cloud.next_id("snap_")
+        self.fake.cloud.snapshots[snapshot_id] = self.fake.cloud.fs.capture()
+        self._snapshot_id = snapshot_id
+        self._status = SandboxStatus.STOPPED
+        return SyncSnapshot(self.fake, snapshot_id)
+
+    def stop(self) -> FakeVercelSandbox:
+        self._enter("Sandbox.stop")
+        self._status = SandboxStatus.STOPPED
+        return self
+
+    def destroy(self, *, delete_orphan_snapshots: bool = False) -> FakeVercelSandbox:
+        self._enter("Sandbox.destroy", delete_orphan_snapshots=delete_orphan_snapshots)
+        self.destroyed = True
+        self._status = SandboxStatus.STOPPED
+        self.fake.sandboxes.pop(self._name, None)
+        return self
+
+    def extend_execution_time_limit(self, duration: Any) -> None:
+        self._enter("Sandbox.extend_execution_time_limit", duration)
+
+    def session(self) -> FakeVercelSandbox:
+        self._enter("Sandbox.session")
+        self._ensure_running()
+        return self
+
+
+class SyncSandboxClient:
+    def __init__(self, fake: FakeVercel, options: SyncSandboxServiceOptions | None) -> None:
+        self._fake = fake
+        self._options = options
+        self._credentials: SandboxCredentials | None = None
+        self.closed = False
+
+    @classmethod
+    def create(
+        cls, *, options: SyncSandboxServiceOptions | None = None, httpx_client_factory: Any = None
+    ) -> SyncSandboxClient:
+        raise RuntimeError("bound by FakeVercel; use fake.sync_module.SyncSandboxClient.create")
+
+    def _enter(self, method: str, *args: Any, **kwargs: Any) -> None:
+        fake = self._fake
+        fake.cloud.enter(f"SandboxClient.{method}", args, kwargs, error_for)
+        if self._credentials is None:
+            factory = self._options.credentials_factory if self._options else None
+            if factory is None:
+                raise SandboxCredentialsError("no credentials")
+            try:
+                self._credentials = factory()
+            except Exception as exc:
+                raise SandboxCredentialsError(str(exc)) from exc
+            if fake.token is not None and self._credentials.token != fake.token:
+                raise SandboxApiError("token rejected", 401)
+
+    def create_sandbox(
+        self,
+        *,
+        name: str | None = None,
+        image: str | None = None,
+        source: SnapshotSource | None = None,
+        ports: list[int] | None = None,
+        execution_time_limit: Any = None,
+        resources: SandboxResources | None = None,
+        persistent: bool | None = None,
+        network_policy: Any = None,
+        network_id: str | None = None,
+        env: Mapping[str, str] | None = None,
+        tags: Mapping[str, str] | None = None,
+        mounts: Any = None,
+        snapshot_expiration: Any = None,
+        snapshot_retention: Any = None,
+        region: str | None = None,
+        failover_regions: Any = None,
+        destroy: bool = True,
+        **private: Any,
+    ) -> FakeVercelSandbox:
+        self._enter(
+            "create_sandbox",
+            name=name,
+            image=image,
+            source=source,
+            resources=resources,
+            persistent=persistent,
+            env=env,
+            execution_time_limit=execution_time_limit,
+        )
+        fake = self._fake
+        cloud = fake.cloud
+        name = name or cloud.next_id("sbx_")
+        if name in fake.sandboxes:
+            raise SandboxApiError(f"sandbox {name} already exists", 409)
+        if source is not None:
+            data = cloud.snapshots.get(source.snapshot_id)
+            if data is None:
+                raise SandboxApiError(f"snapshot {source.snapshot_id} not found", 404)
+            cloud.fs.restore(data)
+        else:
+            cloud.fs.wipe()
+            for path, content in cloud.images.get(image or "", {}).items():
+                cloud.fs.write(path, content)
+        cloud.fs.mkdir(WORKSPACE)
+        sandbox = FakeVercelSandbox(
+            fake,
+            name,
+            image=image,
+            persistent=persistent,
+            env=env or {},
+            resources=resources,
+            execution_time_limit=execution_time_limit,
+            tags=tags or {},
+        )
+        if fake.start_status is not None:
+            sandbox._status = fake.start_status  # noqa: SLF001
+        fake.sandboxes[name] = sandbox
+        return sandbox
+
+    def get_sandbox(
+        self, *, name: str, include_system_routes: bool | None = None
+    ) -> FakeVercelSandbox:
+        self._enter("get_sandbox", name=name)
+        found = self._fake.sandboxes.get(name)
+        if found is None:
+            raise SandboxApiError(f"sandbox {name} not found", 404)
+        return found
+
+    def get_or_create_sandbox(
+        self, *, name: str, resume: bool = True, **kwargs: Any
+    ) -> tuple[FakeVercelSandbox, bool]:
+        self._enter("get_or_create_sandbox", name=name, resume=resume)
+        found = self._fake.sandboxes.get(name)
+        if found is not None:
+            if resume:
+                found._ensure_running()  # noqa: SLF001
+            return found, False
+        return self.create_sandbox(name=name, **kwargs), True
+
+    def resume_sandbox(
+        self, *, name: str, include_system_routes: bool | None = None
+    ) -> FakeVercelSandbox:
+        self._enter("resume_sandbox", name=name)
+        found = self._fake.sandboxes.get(name)
+        if found is None:
+            raise SandboxApiError(f"sandbox {name} not found", 404)
+        found._ensure_running()  # noqa: SLF001
+        return found
+
+    def get_snapshot(self, *, snapshot_id: str) -> SyncSnapshot:
+        self._enter("get_snapshot", snapshot_id=snapshot_id)
+        if snapshot_id not in self._fake.cloud.snapshots:
+            raise SandboxApiError(f"snapshot {snapshot_id} not found", 404)
+        return SyncSnapshot(self._fake, snapshot_id)
+
+    def close(self) -> None:
+        self._fake.cloud.enter("SandboxClient.close", (), {}, error_for)
+        self.closed = True
+
+
+class FakeVercel:
+    """The fake ``vercel.sandbox`` package bound to one ``Cloud`` (see the module notes)."""
+
+    def __init__(self, cloud: Cloud, *, token: str | None = None) -> None:
+        self.cloud = cloud
+        self.token = token
+        self.sandboxes: dict[str, FakeVercelSandbox] = {}
+        self.clients: list[SyncSandboxClient] = []
+        self.resumes = 0
+        # A status new sandboxes report first (``PENDING`` for wait-until-running tests).
+        self.start_status: SandboxStatus | None = None
+        fake = self
+
+        class _Client(SyncSandboxClient):
+            @classmethod
+            def create(
+                cls,
+                *,
+                options: SyncSandboxServiceOptions | None = None,
+                httpx_client_factory: Any = None,
+            ) -> SyncSandboxClient:
+                fake.cloud.enter("SandboxClient.create", (), {"options": options}, error_for)
+                client = SyncSandboxClient(fake, options)
+                fake.clients.append(client)
+                return client
+
+        names: dict[str, Any] = {
+            "SyncSandboxClient": _Client,
+            "SandboxServiceOptions": SyncSandboxServiceOptions,
+            "SyncSandboxServiceOptions": SyncSandboxServiceOptions,
+            "SandboxCredentials": SandboxCredentials,
+            "SyncSandbox": FakeVercelSandbox,
+            "SyncProcess": SyncProcess,
+            "SyncSnapshot": SyncSnapshot,
+            "SyncSandboxFilesystem": SyncSandboxFilesystem,
+            "SyncTextReader": SyncTextReader,
+            "CompletedProcess": CompletedProcess,
+            "SnapshotSource": SnapshotSource,
+            "SandboxResources": SandboxResources,
+            "SandboxStatus": SandboxStatus,
+            "SandboxError": SandboxError,
+            "SandboxApiError": SandboxApiError,
+            "SandboxCredentialsError": SandboxCredentialsError,
+            "SandboxTimeoutError": SandboxTimeoutError,
+            "SandboxResponseError": SandboxResponseError,
+            "SandboxFilesystemError": SandboxFilesystemError,
+            "SandboxPathNotFoundError": SandboxPathNotFoundError,
+            "SandboxFilesystemWriteError": SandboxFilesystemWriteError,
+            "SandboxFilesystemCommandError": SandboxFilesystemCommandError,
+            "SandboxTerminalStateError": SandboxTerminalStateError,
+        }
+        self.sync_module = types.ModuleType("vercel.sandbox.sync")
+        self.module = types.ModuleType("vercel.sandbox")
+        for key, value in names.items():
+            setattr(self.sync_module, key, value)
+            if not key.startswith("Sync") or key == "SyncSandboxServiceOptions":
+                setattr(self.module, key, value)
+        setattr(self.module, "sync", self.sync_module)  # noqa: B010 - a module object
+        self.package = types.ModuleType("vercel")
+        setattr(self.package, "sandbox", self.module)  # noqa: B010 - a module object
+
+    def credentials(
+        self, token: str = "", team_id: str = "team_x", project_id: str = "prj_x"
+    ) -> Callable[[], SandboxCredentials]:
+        """A credentials factory for ``SandboxServiceOptions`` (tests build tokens at run time)."""
+        return lambda: SandboxCredentials(token=token, team_id=team_id, project_id=project_id)
+
+    def install(self, monkeypatch: pytest.MonkeyPatch) -> types.ModuleType:
+        monkeypatch.setitem(sys.modules, "vercel", self.package)
+        monkeypatch.setitem(sys.modules, "vercel.sandbox", self.module)
+        monkeypatch.setitem(sys.modules, "vercel.sandbox.sync", self.sync_module)
+        return self.sync_module
+
+
+SURFACE: dict[str, type] = {
+    "vercel.sandbox.sync.SyncSandboxClient": SyncSandboxClient,
+    "vercel.sandbox.sync.SyncSandbox": FakeVercelSandbox,
+    "vercel.sandbox.sync.SyncProcess": SyncProcess,
+    "vercel.sandbox.sync.SyncSnapshot": SyncSnapshot,
+    "vercel.sandbox.sync.SyncSandboxFilesystem": SyncSandboxFilesystem,
+    "vercel.sandbox.sync.SyncTextReader": SyncTextReader,
+    "vercel.sandbox.sync.SandboxServiceOptions": SyncSandboxServiceOptions,
+    "vercel.sandbox.sync.SandboxCredentials": SandboxCredentials,
+    "vercel.sandbox.sync.CompletedProcess": CompletedProcess,
+    "vercel.sandbox.sync.SnapshotSource": SnapshotSource,
+    "vercel.sandbox.sync.SandboxResources": SandboxResources,
+}
