+"""Vercel Sandbox: auth, disk refusal, create retries, wait, snapshot, stop (P21-08)."""
+
+from __future__ import annotations
+
+import os
+import shutil
+from collections.abc import Iterator
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.backends.contract import BackendUnavailable, EnvironmentConnectionError
+from indus.backends.vercel.exec import VercelEnvironment, open_vercel
+from indus.backends.vercel.lifecycle import (
+    VercelAuth,
+    VercelSandbox,
+    auth_from,
+    requirement_reason,
+    settings_from,
+)
+from indus.foundation.clock import Clock
+from indus.foundation.config.schema import validate
+from indus.foundation.scope import Scope
+from tests.fakes.clock import FakeClock
+from tests.fakes.terminal import terminal_scope
+from tests.unit.backends._aio import aio
+from tests.unit.backends._stubs_b2 import FakeVercel, HttpError, LocalBox, StubRecords, StubSupport
+from tests.unit.backends.conftest import drive
+
+pytestmark = pytest.mark.skipif(
+    shutil.which("bash") is None or shutil.which("timeout") is None, reason="needs bash, timeout"
+)
+
+
+def trio() -> dict[str, str]:
+    return {
+        "VERCEL_TOKEN": "vt" + os.urandom(8).hex(),
+        "VERCEL_PROJECT_ID": "prj_" + os.urandom(4).hex(),
+        "VERCEL_TEAM_ID": "team_" + os.urandom(4).hex(),
+    }
+
+
+def vercel_scope(
+    tmp_path: Path,
+    *,
+    persistent: bool = True,
+    secrets: dict[str, str] | None = None,
+    **config: Any,
+) -> Scope:
+    terminal = {"container_persistent": persistent, **config}
+    return terminal_scope(
+        tmp_path, {"terminal": terminal}, secrets=trio() if secrets is None else secrets
+    )
+
+
+@pytest.fixture
+def box(tmp_path: Path) -> Iterator[LocalBox]:
+    made = LocalBox(tmp_path / "box")
+    yield made
+    made.release()
+
+
+async def open_env(
+    scope: Scope,
+    box: LocalBox,
+    *,
+    fake: FakeVercel | None = None,
+    records: StubRecords | None = None,
+    clock: Clock | None = None,
+) -> tuple[VercelEnvironment, FakeVercel, StubSupport, StubRecords]:
+    fake = fake or FakeVercel(box)
+    support = StubSupport(clock)
+    records = records if records is not None else StubRecords()
+    env = await open_vercel(
+        scope,
+        support=support,
+        records=records,
+        sdk=fake,
+        clock=clock,
+        temp_dir=str(box.tmp),
+    )
+    return env, fake, support, records
+
+
+@aio
+async def test_bad_disk_is_refused_with_zero_api_calls(tmp_path: Path, box: LocalBox) -> None:
+    scope = vercel_scope(tmp_path, container_disk_mb=10240)
+    assert "51200" in (requirement_reason(scope) or "")
+    fake = FakeVercel(box)
+    with pytest.raises(BackendUnavailable, match="container_disk_mb"):
+        await open_vercel(scope, support=StubSupport(), records=StubRecords(), sdk=fake)
+    assert fake.log == []
+    for ok in (0, 51200):
+        assert requirement_reason(vercel_scope(tmp_path, container_disk_mb=ok)) is None
+
+
+@aio
+async def test_429_then_success_on_create(tmp_path: Path, box: LocalBox) -> None:
+    fake = FakeVercel(box)
+    fake.create_errors = [HttpError(429, "slow down")]
+    env, fake, support, _ = await open_env(vercel_scope(tmp_path), box, fake=fake)
+    try:
+        assert fake.names().count("create") == 2 and support.retry_sleeps == [0.5]
+        create = next(c for c in support.calls if c.op == "create")
+        assert create.idempotent and create.timeout == 300.0
+        sandbox = env.lifecycle.sandbox
+        assert sandbox.kwargs["execution_time_limit"] == timedelta(seconds=300)
+        assert sandbox.kwargs["image"] is None  # the vendor's default image
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_400_on_create_is_not_retried(tmp_path: Path, box: LocalBox) -> None:
+    fake = FakeVercel(box)
+    fake.create_errors = [HttpError(400, "bad request")]
+    with pytest.raises(EnvironmentConnectionError):
+        await open_env(vercel_scope(tmp_path), box, fake=fake)
+    assert fake.names().count("create") == 1
+
+
+@aio
+async def test_wait_for_running_gives_up_at_30s(tmp_path: Path, box: LocalBox) -> None:
+    clock = FakeClock(datetime(2026, 10, 19, tzinfo=UTC))
+    fake = FakeVercel(box)
+    fake.start_status = "pending"
+    fake.status_script = ["pending"] * 200
+    settings = settings_from(vercel_scope(tmp_path))
+    lifecycle = VercelSandbox(
+        fake, StubSupport(clock), StubRecords(), settings, VercelAuth(), clock
+    )
+    start = clock.monotonic()
+    with pytest.raises(EnvironmentConnectionError, match="within 30s"):
+        await drive(clock, lifecycle.open(), step=0.05)
+    assert 30 <= clock.monotonic() - start < 32
+    polls = fake.names().count("get")
+    assert 40 <= polls <= 61  # every 0.5 s (a slow worker thread may let the clock run ahead)
+
+
+@aio
+async def test_terminal_state_while_starting_fails_at_once(tmp_path: Path, box: LocalBox) -> None:
+    fake = FakeVercel(box)
+    fake.start_status = "pending"
+    fake.status_script = ["failed"]
+    with pytest.raises(EnvironmentConnectionError):
+        await open_env(vercel_scope(tmp_path), box, fake=fake)
+
+
+@aio
+async def test_persistent_cleanup_order_is_sync_back_snapshot_stop(
+    tmp_path: Path, box: LocalBox
+) -> None:
+    scope = vercel_scope(tmp_path)
+    skill = scope.home / "skills" / "x" / "SKILL.md"
+    skill.parent.mkdir(parents=True)
+    skill.write_text("v1\n")
+    env, fake, _, records = await open_env(scope, box)
+    remote = Path(env.remote_base, "skills", "x", "SKILL.md")
+    await env.execute(f"echo v2 > {remote}")
+    await env.cleanup()
+    assert skill.read_text() == "v2\n"
+    names = fake.names()
+    last_read = max(i for i, n in enumerate(names) if n == "read")
+    assert last_read < names.index("snapshot") < names.index("stop") < names.index("close")
+    assert records.data["default"]["snapshot_id"].startswith("snap-")
+
+
+@aio
+async def test_restore_from_record_and_fallback(tmp_path: Path, box: LocalBox) -> None:
+    records = StubRecords({"default": {"snapshot_id": "snap-77"}})
+    env, fake, _, _ = await open_env(vercel_scope(tmp_path), box, records=records)
+    try:
+        assert [e[1] for e in fake.log if e[0] == "create"] == ["snap-77"]
+        assert not (await env.execute("true")).environment_recreated
+    finally:
+        await env.cleanup()
+
+    fake = FakeVercel(box)
+    fake.gone_snapshots.add("snap-gone")
+    records = StubRecords({"default": {"snapshot_id": "snap-gone"}})
+    env, fake, _, records = await open_env(
+        vercel_scope(tmp_path, persistent=False), box, fake=fake, records=records
+    )
+    try:
+        assert [e[1] for e in fake.log if e[0] == "create"] == [None]  # not persistent: no restore
+    finally:
+        await env.cleanup()
+
+    fake = FakeVercel(box)
+    fake.gone_snapshots.add("snap-gone")
+    env, fake, _, records = await open_env(
+        vercel_scope(tmp_path),
+        box,
+        fake=fake,
+        records=StubRecords({"default": {"snapshot_id": "snap-gone"}}),
+    )
+    try:
+        assert [e[1] for e in fake.log if e[0] == "create"] == ["snap-gone", None]
+        assert (await env.execute("true")).environment_recreated
+    finally:
+        await env.cleanup()
+    assert records.data["default"]["snapshot_id"] != "snap-gone"
+
+
+def test_unknown_runtime_is_rejected_by_config_validation() -> None:
+    assert validate({"terminal": {"vercel_runtime": "ruby3"}})
+    assert validate({"terminal": {"vercel_runtime": "node24"}}) == []
+
+
+def test_runtime_replaces_the_image(tmp_path: Path) -> None:
+    assert settings_from(vercel_scope(tmp_path, vercel_runtime="python3.13")).image == "python3.13"
+    assert settings_from(vercel_scope(tmp_path)).image is None
+
+
+def test_auth_needs_the_whole_trio_or_an_oidc_token(tmp_path: Path) -> None:
+    full = auth_from(vercel_scope(tmp_path))
+    assert isinstance(full, VercelAuth) and not full.oidc
+    partial = auth_from(vercel_scope(tmp_path, secrets={"VERCEL_TOKEN": "vt1"}))
+    assert (
+        isinstance(partial, str) and "VERCEL_PROJECT_ID" in partial and "VERCEL_TEAM_ID" in partial
+    )
+    oidc = auth_from(vercel_scope(tmp_path, secrets={"VERCEL_OIDC_TOKEN": "x.y.z"}))
+    assert isinstance(oidc, VercelAuth) and oidc.oidc
+    none = auth_from(vercel_scope(tmp_path, secrets={}))
+    assert isinstance(none, str) and "VERCEL_OIDC_TOKEN" in none
+
+
+@aio
+async def test_credentials_go_through_the_sdk_factory_only(tmp_path: Path, box: LocalBox) -> None:
+    secrets = trio()
+    env, fake, _, _ = await open_env(vercel_scope(tmp_path, secrets=secrets), box)
+    try:
+        made = fake.options[0].credentials_factory()
+        assert made.token == secrets["VERCEL_TOKEN"]
+        assert made.project_id == secrets["VERCEL_PROJECT_ID"]
+        await env.execute("env")
+        assert all(v not in "\n".join(box.scripts) for v in secrets.values())
+    finally:
+        await env.cleanup()
