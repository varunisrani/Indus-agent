+"""Modal direct mode: exec, interrupt, deadline, file transport (P21-06) over the fake SDK."""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import shutil
+import tarfile
+import threading
+from collections.abc import Iterator
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.backends.contract import BackendError, EnvironmentConnectionError
+from indus.backends.modal.exec import ModalEnvironment, ModalTransport, open_modal
+from indus.foundation.clock import Clock
+from tests.fakes.clock import FakeClock
+from tests.unit.backends._aio import aio
+from tests.unit.backends._stubs_b2 import (
+    FakeModal,
+    HttpError,
+    LocalBox,
+    StubDeadline,
+    StubRecords,
+    StubSupport,
+)
+from tests.unit.backends.conftest import drive
+from tests.unit.backends.modal.test_lifecycle import modal_scope
+
+pytestmark = pytest.mark.skipif(
+    shutil.which("bash") is None or shutil.which("timeout") is None, reason="needs bash, timeout"
+)
+
+
+@pytest.fixture
+def box(tmp_path: Path) -> Iterator[LocalBox]:
+    made = LocalBox(tmp_path / "box")
+    yield made
+    made.release()
+
+
+async def open_env(
+    tmp_path: Path, box: LocalBox, clock: Clock | None = None, **config: Any
+) -> tuple[ModalEnvironment, FakeModal, StubSupport]:
+    fake = FakeModal(box)
+    support = StubSupport(clock)
+    env = await open_modal(
+        modal_scope(tmp_path, persistent=False, **config),
+        support=support,
+        records=StubRecords(),
+        sdk=fake,
+        clock=clock,
+        temp_dir=str(box.tmp),
+    )
+    return env, fake, support
+
+
+@aio
+async def test_commands_keep_cwd_and_exports(tmp_path: Path, box: LocalBox) -> None:
+    env, fake, _ = await open_env(tmp_path, box)
+    try:
+        assert env.cwd == str(box.home)  # "~" follows the detected home
+        first = await env.execute("mkdir -p sub && cd sub && export GREETING=hello")
+        assert first.returncode == 0 and first.cwd_observed == str(box.home / "sub")
+        second = await env.execute('echo "$GREETING from $(pwd)"; echo oops >&2; exit 3')
+        assert second.returncode == 3
+        assert f"hello from {box.home / 'sub'}" in second.output and "oops" in second.output
+        assert env.cwd == str(box.home / "sub")
+        guarded = [s for s in box.scripts if s.startswith("timeout -k 2 182 ")]
+        assert guarded, "every command runs under the shell timeout guard"
+        assert 184 in fake.exec_timeouts  # the vendor's own bound sits just past the guard
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_interrupt_signals_the_command_and_returns_130(tmp_path: Path, box: LocalBox) -> None:
+    env, _, _ = await open_env(tmp_path, box)
+    marker = box.root / "still-running"
+    try:
+        cancel = threading.Event()
+        threading.Timer(0.5, cancel.set).start()
+        result = await env.execute(f"sleep 30; touch {marker}", cancel=cancel, timeout=60)
+        assert result.returncode == 130 and result.interrupted
+        assert any("kill -TERM" in s for s in box.scripts)
+        assert not marker.exists()
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_never_returning_exec_gives_124_at_the_deadline(
+    tmp_path: Path, box: LocalBox
+) -> None:
+    clock = FakeClock(datetime(2026, 10, 19, tzinfo=UTC))
+    env, _, support = await drive(clock, open_env(tmp_path, box, clock), step=0.01)
+    try:
+        box.hang.add("HANG-FOREVER")
+        start = clock.monotonic()
+        result = await drive(clock, env.execute("echo HANG-FOREVER", timeout=5))
+        assert result.returncode == 124 and result.timed_out
+        assert 5 <= clock.monotonic() - start < 8
+        assert any("kill -KILL" in s for s in box.scripts)
+        exec_calls = [c for c in support.calls if c.op == "exec" and c.timeout == 15.0]
+        assert exec_calls and not exec_calls[-1].idempotent  # timeout + 10 s, never retried
+    finally:
+        box.release()
+        await drive(clock, env.cleanup())
+
+
+@aio
+async def test_stdin_is_streamed_in_64k_chunks(tmp_path: Path, box: LocalBox) -> None:
+    env, fake, _ = await open_env(tmp_path, box)
+    try:
+        payload = "x" * (200 * 1024)
+        result = await env.execute("wc -c", stdin=payload)
+        assert result.output.strip() == str(len(payload))
+        assert fake.stdin_writes[-4:] == [65536, 65536, 65536, 8192]
+        broken = await env.execute("echo ran; wc -c", stdin="bad \ud800 text")
+        assert broken.stdin_error and "ran" in broken.output
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_vendor_failure_is_a_connection_error(tmp_path: Path, box: LocalBox) -> None:
+    env, fake, _ = await open_env(tmp_path, box)
+    try:
+        fake.exec_error = HttpError(503, "upstream gone")
+        with pytest.raises(EnvironmentConnectionError, match="upstream gone"):
+            await env.execute("echo hi")
+    finally:
+        fake.exec_error = None
+        await env.cleanup()
+
+
+@aio
+async def test_transport_round_trip_and_limits(tmp_path: Path, box: LocalBox) -> None:
+    env, _, support = await open_env(tmp_path, box)
+    transport = env.transport()
+    assert isinstance(transport, ModalTransport)
+    try:
+        local = tmp_path / "one.bin"
+        local.write_bytes(os.urandom(100_000))
+        dest = f"{env.remote_base}/cache/documents/one.bin"
+        await transport.upload_one(str(local), dest)
+        assert Path(dest).read_bytes() == local.read_bytes()
+
+        tar_path = tmp_path / "many.tar"
+        with tarfile.open(tar_path, "w") as archive:
+            for name in ("skills/a.md", "skills/b.md"):
+                src = tmp_path / name.replace("/", "_")
+                src.write_text(name)
+                archive.add(src, arcname=name)
+        await transport.upload_bulk(str(tar_path))
+        assert Path(env.remote_base, "skills", "b.md").read_text() == "skills/b.md"
+
+        await transport.delete([dest])
+        assert not Path(dest).exists()
+        ops = support.ops()
+        assert ("file", 30.0) in ops and ("bulk", 120.0) in ops and ("delete", 15.0) in ops
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_twenty_mib_download_is_not_truncated(tmp_path: Path, box: LocalBox) -> None:
+    env, _, _ = await open_env(tmp_path, box)
+    try:
+        big = Path(env.remote_base, "cache", "documents", "big.bin")
+        big.parent.mkdir(parents=True, exist_ok=True)
+        data = os.urandom(20 * 1024 * 1024)
+        big.write_bytes(data)
+        dest = tmp_path / "down.tar"
+        await env.transport().download_bulk(env.remote_base, str(dest))
+        with tarfile.open(dest) as archive:
+            member = next(m for m in archive.getmembers() if m.name.endswith("big.bin"))
+            got = archive.extractfile(member)
+            assert got is not None
+            assert hashlib.sha256(got.read()).digest() == hashlib.sha256(data).digest()
+    finally:
+        await env.cleanup()
+
+
+@aio
+async def test_upload_byte_count_mismatch_is_an_error(tmp_path: Path, box: LocalBox) -> None:
+    env, fake, _ = await open_env(tmp_path, box)
+    try:
+        local = tmp_path / "one.bin"
+        local.write_bytes(b"0123456789")
+        dest = Path(env.remote_base, "cache", "documents", "one.bin")
+        fake.stdin_limit = 8  # the stream loses everything after 8 base64 characters
+        with pytest.raises(BackendError, match="copied 6 of 10 bytes"):
+            await env.transport().upload_one(str(local), str(dest))
+    finally:
+        fake.stdin_limit = None
+        await env.cleanup()
+
+
+@aio
+async def test_hung_bulk_upload_gives_up_at_120s(tmp_path: Path, box: LocalBox) -> None:
+    clock = FakeClock(datetime(2026, 10, 19, tzinfo=UTC))
+    env, _, support = await drive(clock, open_env(tmp_path, box, clock), step=0.01)
+    try:
+        box.hang.add("tar -xf -")
+        tar_path = tmp_path / "x.tar"
+        with tarfile.open(tar_path, "w"):
+            pass
+        start = clock.monotonic()
+        with pytest.raises(EnvironmentConnectionError):
+            await drive(clock, env.transport().upload_bulk(str(tar_path)), step=1.0)
+        assert 120 <= clock.monotonic() - start < 125
+        assert support.deadlines >= 1
+    finally:
+        box.release()
+        await drive(clock, env.cleanup())
+
+
+def test_stub_deadline_is_a_backend_error() -> None:
+    assert issubclass(StubDeadline, BackendError)
