index 0000000..6b605fb
--- /dev/null
+++ b/src/indus/backends/vercel/exec.py
@@ -0,0 +1,275 @@
+# pyright: strict
+"""Vercel Sandbox: running commands and moving files (P21-09).
+
+The workspace root is ``/vercel/sandbox`` (or the sandbox's own cwd when it reports an absolute
+one); commands start there unless ``terminal.cwd`` says otherwise (``~`` = the detected home).
+Commands use the shared SDK shell flow over ``create_process("bash", ["-c", <guarded script>])``:
+the process is waited for and its output read; stdin is staged as a file (``payload``, P21-03).
+Stopping a command kills the vendor process and signals its process group.
+
+File writes (staged stdin, uploads) are retried ``WRITE_ATTEMPTS`` times with a ``WRITE_STEP_S``
+step (0.1 s, then 0.2 s). The transport is ``FileApiTransport``: single files by a write with a
+byte-count check, many as one tar unpacked in the sandbox, downloads as a tar fetched in full
+(R02.2), deletes by ``rm -f``.
+
+Before each command the sandbox status is read; a sandbox found stopped, failed or aborted (or
+that cannot be read) is replaced by a fresh one (restored from the recorded snapshot when there is
+one). ``recreations`` counts replacements, so background jobs of the old sandbox are reported lost
+by P11's remote job flow: a detached process never survives a stop or a restart. The next result
+says ``environment_recreated`` once.
+
+Cleanup: sync-back (P21-10) → snapshot when persistent → stop → close the client.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+from collections.abc import Mapping
+from typing import Any
+
+from indus.backends.capture import DEFAULT_MAX_CHARS
+from indus.backends.contract import (
+    BackendError,
+    BackendFlags,
+    BackendUnavailable,
+    EnvironmentConnectionError,
+)
+from indus.backends.remote_sync import SyncTransport
+from indus.backends.sdk_shell import (
+    FILE_TIMEOUT_S,
+    OP_FILE,
+    FileApiTransport,
+    SandboxRecords,
+    SdkEnvironment,
+    SdkProcess,
+    SdkSupport,
+    config_value,
+)
+from indus.backends.vercel import load_sdk
+from indus.backends.vercel.lifecycle import (
+    TERMINAL_STATES,
+    WORKSPACE_ROOT,
+    VercelAuth,
+    VercelSandbox,
+    VercelSettings,
+    auth_from,
+    disk_problem,
+    settings_from,
+)
+from indus.foundation.clock import Clock, SystemClock
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "VERCEL_FLAGS",
+    "WRITE_ATTEMPTS",
+    "WRITE_STEP_S",
+    "VercelEnvironment",
+    "open_vercel",
+]
+
+log = logging.getLogger(__name__)
+
+VERCEL_FLAGS = BackendFlags(
+    isolated=True, container_paths=True, stdin_mode="payload", host_local=False
+)
+WRITE_ATTEMPTS = 3
+WRITE_STEP_S = 0.1
+REMOTE_TEMP = "/tmp"
+
+
+class VercelEnvironment(SdkEnvironment):
+    """Commands in a Vercel sandbox (see the module notes)."""
+
+    backend_name = "vercel_sandbox"
+
+    def __init__(
+        self,
+        scope: Scope,
+        support: SdkSupport,
+        lifecycle: VercelSandbox,
+        settings: VercelSettings,
+        *,
+        session_id: str | None = None,
+        clock: Clock | None = None,
+        max_chars: int = DEFAULT_MAX_CHARS,
+        temp_dir: str = REMOTE_TEMP,
+        sync_files: bool = True,
+    ) -> None:
+        super().__init__(
+            scope,
+            support,
+            cwd=settings.cwd,
+            timeout=settings.timeout,
+            temp_dir=temp_dir,
+            flags=VERCEL_FLAGS,
+            session_id=session_id,
+            clock=clock,
+            max_chars=max_chars,
+            persist_env=bool(config_value(scope, "terminal.persistent_shell")),
+            sync_files=sync_files,
+        )
+        self.lifecycle = lifecycle
+        self.settings = settings
+        self.workspace_root = WORKSPACE_ROOT
+        self._take_workspace()
+        if lifecycle.recreated:
+            self.mark_recreated()
+
+    def _take_workspace(self) -> None:
+        reported = str(getattr(self.lifecycle.sandbox, "cwd", "") or "")
+        self.workspace_root = reported if reported.startswith("/") else WORKSPACE_ROOT
+        self.remote_home = self.workspace_root
+
+    def _adopt_home(self, home: str) -> None:
+        if self._cwd == "~":
+            self._cwd = home
+        elif self._cwd in ("", "."):
+            self._cwd = self.workspace_root
+
+    def describe(self) -> str:
+        return f"vercel sandbox, cwd {self._cwd}"
+
+    # -- vendor calls ----------------------------------------------------------------------------
+
+    def _vendor_exec(
+        self, argv: list[str], proc: SdkProcess, stdin_chunks: list[bytes] | None, timeout: float
+    ) -> int:
+        sandbox = self.lifecycle.sandbox
+        if sandbox is None:
+            raise BackendError("the vercel sandbox is gone")
+        process = sandbox.create_process(argv[0], argv[1:], cwd=self.workspace_root)
+        proc.vendor = process
+        code = process.wait()
+        reader = getattr(process, "stdout", None)
+        if reader is not None:
+            proc.feed(reader.read() or "")
+        return int(code if code is not None else 1)
+
+    def _vendor_cancel(self, proc: SdkProcess) -> None:
+        process = proc.vendor
+        if process is not None:
+            process.kill()
+
+    async def write_file(self, path: str, data: bytes, mode: int | None = 0o600) -> None:
+        sandbox = self.lifecycle.sandbox
+        for attempt in range(1, WRITE_ATTEMPTS + 1):
+            try:
+                await self.support.call(
+                    OP_FILE,
+                    lambda: sandbox.fs.write_bytes(path, data, mode=mode),
+                    timeout=FILE_TIMEOUT_S,
+                )
+                return
+            except EnvironmentConnectionError:
+                raise
+            except Exception as exc:
+                if attempt >= WRITE_ATTEMPTS:
+                    raise
+                log.debug("vercel: write %d/%d failed (%s)", attempt, WRITE_ATTEMPTS, exc)
+                await self.clock.sleep(WRITE_STEP_S * attempt)
+
+    async def put_file(self, local_path: str, remote_path: str, timeout: float) -> None:
+        with open(local_path, "rb") as handle:
+            data = handle.read()
+        await self.write_file(remote_path, data, mode=None)
+
+    async def get_file(self, remote_path: str, local_path: str, timeout: float) -> None:
+        sandbox = self.lifecycle.sandbox
+        data = await self.support.call(
+            OP_FILE, lambda: sandbox.fs.read_bytes(remote_path), timeout=timeout, idempotent=True
+        )
+        with open(local_path, "wb") as out:
+            out.write(data)
+
+    def transport(self) -> SyncTransport:
+        return FileApiTransport(self)
+
+    # -- lifecycle -------------------------------------------------------------------------------
+
+    async def _ensure_ready(self) -> None:
+        try:
+            status = await self.lifecycle.refresh()
+        except Exception as exc:
+            log.warning("vercel: reading the sandbox failed (%s); replacing it", type(exc).__name__)
+            status = "unreadable"
+        if status not in TERMINAL_STATES and status != "unreadable":
+            if status not in ("", "running"):
+                await self.lifecycle.wait_running()
+            return
+        log.warning("vercel: the sandbox is %s; starting a fresh one", status)
+        with contextlib.suppress(Exception):
+            await self.lifecycle.close_client()
+        try:
+            await self.lifecycle.open()
+        except (BackendUnavailable, EnvironmentConnectionError):
+            raise
+        except Exception as exc:
+            raise self.connection_error(exc, "replacing the sandbox") from exc
+        self._take_workspace()
+        await self.reopen()
+
+    async def _teardown(self) -> None:
+        try:
+            await self.lifecycle.snapshot()
+            await self.lifecycle.stop()
+        finally:
+            await self.lifecycle.close_client()
+
+
+async def open_vercel(
+    scope: Scope,
+    *,
+    support: SdkSupport,
+    records: SandboxRecords,
+    sdk: Any = None,
+    session_id: str | None = None,
+    task_key: str = "default",
+    overrides: Mapping[str, Any] | None = None,
+    clock: Clock | None = None,
+    temp_dir: str = REMOTE_TEMP,
+    sync_files: bool = True,
+) -> VercelEnvironment:
+    """A ready Vercel Sandbox environment for ``scope`` (see the module notes). A bad disk
+    setting or missing auth is refused before any API call."""
+    problem = disk_problem(scope)
+    if problem:
+        raise BackendUnavailable(problem)
+    auth = auth_from(scope)
+    if not isinstance(auth, VercelAuth):
+        raise BackendUnavailable(auth)
+    settings = settings_from(scope, task_key=task_key, overrides=overrides)
+    module = sdk if sdk is not None else load_sdk()
+    the_clock: Clock = clock if clock is not None else SystemClock()
+    lifecycle = VercelSandbox(module, support, records, settings, auth, the_clock)
+    try:
+        await lifecycle.open()
+    except (BackendUnavailable, EnvironmentConnectionError):
+        await lifecycle.close_client()
+        raise
+    except Exception as exc:
+        with contextlib.suppress(Exception):
+            await lifecycle.stop()
+        await lifecycle.close_client()
+        raise EnvironmentConnectionError(
+            f"creating the vercel sandbox failed: {type(exc).__name__}",
+            retry_hint="Check your Vercel token, project and team and Vercel's status, then retry.",
+        ) from exc
+    env = VercelEnvironment(
+        scope,
+        support,
+        lifecycle,
+        settings,
+        session_id=session_id,
+        clock=the_clock,
+        max_chars=int(config_value(scope, "tool_output.max_chars")),
+        temp_dir=temp_dir,
+        sync_files=sync_files,
+    )
+    try:
+        await env.connect()
+    except BaseException:
+        with contextlib.suppress(Exception):
+            await env.cleanup()
+        raise
+    return env
diff --git a/src/indus/backends/vercel/lifecycle.py b/src/indus/backends/vercel/lifecycle.py
new file mode 100644
index 0000000..73ab25c
--- /dev/null
+++ b/src/indus/backends/vercel/lifecycle.py
@@ -0,0 +1,328 @@
+# pyright: strict
+"""Vercel Sandbox: settings, auth, create / restore / wait / snapshot / stop (P21-08).
+
+Auth (vendor-standard names, D-16.22, from the secret store or the scope env): ``VERCEL_TOKEN`` +
+``VERCEL_PROJECT_ID`` + ``VERCEL_TEAM_ID`` together, handed to the SDK through its credentials
+factory; or a short-lived ``VERCEL_OIDC_TOKEN``, which the SDK reads itself from the process
+environment (it carries the project and team). Anything else is a requirement reason that names
+what is missing.
+
+Refused before any API call: ``terminal.container_disk_mb`` other than the default 51200 or 0
+(Vercel sizes the disk itself). ``terminal.vercel_runtime`` (one of the vendor's documented names,
+checked by config validation) replaces the image; without it the vendor's default image is used.
+
+Create: from the snapshot recorded for the task key when the profile is persistent, else from the
+image; a failed restore drops that record (only while it still names that snapshot) and creates
+from the image with ``recreated`` set (R02.19). Create is retried on transient errors by the call
+wrapper. The sandbox time limit is the command timeout, at least ``MIN_LIFETIME_S``. Then wait for
+``running``: at most ``RUNNING_WAIT_S``, polling every ``POLL_S``; a terminal state ends the wait
+at once. Snapshot (persistent cleanup): its id is recorded (a snapshot holds files, never
+processes). Stop: within ``STOP_TIMEOUT_S``, polling ``POLL_S`` until the sandbox reports stopped.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+from datetime import timedelta
+from typing import Any
+
+from indus.backends.contract import BackendError, EnvironmentConnectionError
+from indus.backends.sdk_shell import (
+    CREATE_TIMEOUT_S,
+    OP_CREATE,
+    OP_GET,
+    OP_SNAPSHOT,
+    OP_STOP,
+    SNAPSHOT_OP_TIMEOUT_S,
+    STOP_TIMEOUT_S,
+    SandboxRecords,
+    SdkSupport,
+    config_value,
+    credential,
+)
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "DEFAULT_DISK_MB",
+    "MIN_LIFETIME_S",
+    "OIDC_TOKEN",
+    "POLL_S",
+    "PROJECT_ID",
+    "RUNNING_WAIT_S",
+    "TEAM_ID",
+    "TERMINAL_STATES",
+    "TOKEN",
+    "WORKSPACE_ROOT",
+    "VercelAuth",
+    "VercelSandbox",
+    "VercelSettings",
+    "auth_from",
+    "disk_problem",
+    "requirement_reason",
+    "settings_from",
+    "status_of",
+]
+
+log = logging.getLogger(__name__)
+
+TOKEN = "VERCEL_TOKEN"
+PROJECT_ID = "VERCEL_PROJECT_ID"
+TEAM_ID = "VERCEL_TEAM_ID"
+OIDC_TOKEN = "VERCEL_OIDC_TOKEN"
+DEFAULT_DISK_MB = 51200
+MIN_LIFETIME_S = 300
+RUNNING_WAIT_S = 30.0
+POLL_S = 0.5
+GET_TIMEOUT_S = 30.0
+WORKSPACE_ROOT = "/vercel/sandbox"
+
+RUNNING = "running"
+STOPPED = "stopped"
+TERMINAL_STATES = frozenset({"stopped", "failed", "aborted"})
+
+
+@dataclass(frozen=True, slots=True)
+class VercelAuth:
+    token: str | None = None
+    project_id: str | None = None
+    team_id: str | None = None
+
+    @property
+    def oidc(self) -> bool:
+        return self.token is None
+
+
+@dataclass(frozen=True, slots=True)
+class VercelSettings:
+    image: str | None
+    vcpus: int | None
+    memory_mb: int | None
+    persistent: bool
+    timeout: float
+    cwd: str
+    task_key: str = "default"
+
+    @property
+    def lifetime_s(self) -> int:
+        return max(MIN_LIFETIME_S, math.ceil(self.timeout))
+
+
+def disk_problem(scope: Scope) -> str | None:
+    disk = int(config_value(scope, "terminal.container_disk_mb"))
+    if disk in (0, DEFAULT_DISK_MB):
+        return None
+    return (
+        f"Vercel Sandbox sizes its disk itself: terminal.container_disk_mb is {disk}, but the "
+        f"vercel_sandbox backend accepts only the default ({DEFAULT_DISK_MB}) or 0"
+    )
+
+
+def auth_from(scope: Scope) -> VercelAuth | str:
+    """The credentials to use, or the reason there are none."""
+    trio = {name: credential(scope, name) for name in (TOKEN, PROJECT_ID, TEAM_ID)}
+    if all(trio.values()):
+        return VercelAuth(trio[TOKEN], trio[PROJECT_ID], trio[TEAM_ID])
+    if credential(scope, OIDC_TOKEN) is not None:
+        return VercelAuth()
+    missing = [name for name, value in trio.items() if not value]
+    if len(missing) < len(trio):
+        return (
+            f"the vercel_sandbox backend uses {TOKEN}, {PROJECT_ID} and {TEAM_ID} together; "
+            f"missing: {', '.join(missing)}"
+        )
+    return (
+        f"the vercel_sandbox backend needs {TOKEN}, {PROJECT_ID} and {TEAM_ID} in this profile's "
+        f"secret store (or {OIDC_TOKEN} for short local runs)"
+    )
+
+
+def requirement_reason(scope: Scope) -> str | None:
+    """Why Vercel Sandbox cannot run for ``scope``, or None (no network, no import)."""
+    problem = disk_problem(scope)
+    if problem:
+        return problem
+    auth = auth_from(scope)
+    return auth if isinstance(auth, str) else None
+
+
+def settings_from(
+    scope: Scope, *, task_key: str = "default", overrides: Mapping[str, Any] | None = None
+) -> VercelSettings:
+    over = overrides or {}
+    runtime = str(config_value(scope, "terminal.vercel_runtime") or "").strip()
+    image = str(over.get("image") or "").strip() or runtime or None
+    cpu = float(config_value(scope, "terminal.container_cpu"))
+    memory = int(config_value(scope, "terminal.container_memory_mb"))
+    raw_cwd = str(over.get("cwd") or config_value(scope, "terminal.cwd") or "").strip()
+    return VercelSettings(
+        image=image,
+        vcpus=math.floor(cpu) if cpu >= 1 else None,
+        memory_mb=memory if memory > 0 else None,
+        persistent=bool(config_value(scope, "terminal.container_persistent")),
+        timeout=float(config_value(scope, "terminal.timeout")),
+        cwd="" if raw_cwd in (".", WORKSPACE_ROOT) else raw_cwd,
+        task_key=task_key,
+    )
+
+
+def status_of(sandbox: Any) -> str:
+    value: Any = getattr(sandbox, "status", None)
+    return str(getattr(value, "value", value) or "").lower()
+
+
+class VercelSandbox:
+    """One Vercel sandbox's lifecycle (see the module notes). ``sdk`` is the synchronous sandbox
+    SDK module (or a fake with the same surface)."""
+
+    def __init__(
+        self,
+        sdk: Any,
+        support: SdkSupport,
+        records: SandboxRecords,
+        settings: VercelSettings,
+        auth: VercelAuth,
+        clock: Clock,
+    ) -> None:
+        self.sdk = sdk
+        self.support = support
+        self.records = records
+        self.settings = settings
+        self.auth = auth
+        self.clock = clock
+        self.client: Any = None
+        self.sandbox: Any = None
+        self.recreated = False
+
+    def _make_client(self) -> Any:
+        sdk = self.sdk
+        auth = self.auth
+        if auth.oidc:
+            return sdk.SyncSandboxClient.create()
+        token, team, project = auth.token, auth.team_id, auth.project_id
+
+        def credentials() -> Any:
+            return sdk.SandboxCredentials(token=token, team_id=team, project_id=project)
+
+        options = sdk.SandboxServiceOptions(credentials_factory=credentials)
+        return sdk.SyncSandboxClient.create(options=options)
+
+    async def open(self) -> None:
+        self.client = await self.support.call(
+            OP_GET, self._make_client, timeout=GET_TIMEOUT_S, idempotent=True
+        )
+        await self.attach()
+
+    async def attach(self) -> None:
+        """A fresh sandbox (restored when there is a record), running."""
+        self.sandbox = None
+        snapshot_id = self._restore_candidate()
+        if snapshot_id is not None:
+            try:
+                source = self.sdk.SnapshotSource(snapshot_id=snapshot_id)
+                self.sandbox = await self._create(source=source)
+                log.info("vercel: restored the sandbox from snapshot %s", snapshot_id)
+            except Exception as exc:
+                log.warning(
+                    "vercel: restoring snapshot %s failed (%s); starting from the image",
+                    snapshot_id,
+                    type(exc).__name__,
+                )
+                self.records.drop(self.settings.task_key, expect={"snapshot_id": snapshot_id})
+                self.recreated = True
+        if self.sandbox is None:
+            self.sandbox = await self._create(image=self.settings.image)
+        await self.wait_running()
+
+    def _restore_candidate(self) -> str | None:
+        if not self.settings.persistent:
+            return None
+        record = self.records.load(self.settings.task_key) or {}
+        value = record.get("snapshot_id")
+        return value if isinstance(value, str) and value else None
+
+    async def _create(self, **source: Any) -> Any:
+        sdk = self.sdk
+        settings = self.settings
+        client = self.client
+        resources = None
+        if settings.vcpus is not None or settings.memory_mb is not None:
+            resources = sdk.SandboxResources(vcpus=settings.vcpus, memory=settings.memory_mb)
+
+        def make() -> Any:
+            return client.create_sandbox(
+                execution_time_limit=timedelta(seconds=settings.lifetime_s),
+                resources=resources,
+                **source,
+            )
+
+        return await self.support.call(OP_CREATE, make, timeout=CREATE_TIMEOUT_S, idempotent=True)
+
+    async def refresh(self) -> str:
+        """Re-read the sandbox (a new handle) and return its status."""
+        client = self.client
+        name = getattr(self.sandbox, "name", None)
+        self.sandbox = await self.support.call(
+            OP_GET, lambda: client.get_sandbox(name=name), timeout=GET_TIMEOUT_S, idempotent=True
+        )
+        return status_of(self.sandbox)
+
+    async def wait_running(self, limit_s: float = RUNNING_WAIT_S) -> None:
+        status = status_of(self.sandbox)
+        deadline = self.clock.monotonic() + limit_s
+        while status not in ("", RUNNING):
+            if status in TERMINAL_STATES:
+                raise BackendError(f"the vercel sandbox ended up {status} while starting")
+            if self.clock.monotonic() >= deadline:
+                raise EnvironmentConnectionError(
+                    f"the vercel sandbox did not start within {limit_s:g}s (last status {status})",
+                    retry_hint="Vercel may be busy; run the command again in a moment.",
+                )
+            await self.clock.sleep(POLL_S)
+            status = await self.refresh()
+
+    async def snapshot(self) -> None:
+        """Persistent profiles: snapshot the filesystem and record the id."""
+        if not self.settings.persistent or self.sandbox is None:
+            return
+        sandbox = self.sandbox
+        try:
+            snap = await self.support.call(
+                OP_SNAPSHOT, sandbox.snapshot, timeout=SNAPSHOT_OP_TIMEOUT_S
+            )
+        except Exception as exc:
+            log.warning("vercel: filesystem snapshot failed (%s)", type(exc).__name__)
+            return
+        snapshot_id = str(getattr(snap, "id", "") or "")
+        if not snapshot_id:
+            log.warning("vercel: the snapshot came back without an id; nothing recorded")
+            return
+        self.records.save(self.settings.task_key, {"snapshot_id": snapshot_id})
+        log.info("vercel: saved snapshot %s", snapshot_id)
+
+    async def stop(self) -> None:
+        """Stop the sandbox and wait (bounded) until it says so."""
+        sandbox = self.sandbox
+        if sandbox is None:
+            return
+        deadline = self.clock.monotonic() + STOP_TIMEOUT_S
+        try:
+            await self.support.call(OP_STOP, sandbox.stop, timeout=STOP_TIMEOUT_S, idempotent=True)
+            while status_of(self.sandbox) not in TERMINAL_STATES:
+                if self.clock.monotonic() >= deadline:
+                    log.warning("vercel: the sandbox did not report stopped in time")
+                    break
+                await self.clock.sleep(POLL_S)
+                await self.refresh()
+        except Exception as exc:
+            log.warning("vercel: stopping the sandbox failed (%s)", type(exc).__name__)
+
+    async def close_client(self) -> None:
+        client, self.client = self.client, None
+        if client is not None:
+            with contextlib.suppress(Exception):
+                await self.support.call(OP_STOP, client.close, timeout=STOP_TIMEOUT_S)
