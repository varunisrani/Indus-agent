index 0000000..3c88f78
--- /dev/null
+++ b/tests/unit/backends/_stubs_b2.py
@@ -0,0 +1,657 @@
+# STAND-IN: removed at integration
+"""Test-only stand-ins for slice B2 of P21 until B1's modules land.
+
+- ``StubSupport``: the ``SdkSupport`` port (call wrapper with a deadline on the given clock and
+  retries of idempotent calls on 408/425/429/5xx, the shell guard, stdin staging and chunking).
+- ``StubRecords``: the ``SandboxRecords`` port (a dict).
+- ``LocalBox``: a fake sandbox whose commands run in the real ``bash`` of this machine with
+  ``HOME`` inside the test's tmp dir; its files are real paths under that dir.
+- ``FakeModal``, ``FakeDaytona``, ``FakeVercel``: the parts of the vendor SDK surfaces the
+  backends call (checked against modal 1.6.1, daytona 0.220.0, vercel-sandbox 0.7.0), over a
+  ``LocalBox``, with a call log and scripted failures.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import itertools
+import os
+import shlex
+import subprocess
+import threading
+from collections.abc import Callable, Iterator, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+from indus.backends.contract import BackendError
+from indus.backends.sdk_shell import FileSize, StagedStdin, WriteFile
+from indus.foundation.clock import Clock, SystemClock
+
+TRANSIENT = frozenset({408, 425, 429, 500, 502, 503, 504})
+CHUNK = 64 * 1024
+
+
+class StubDeadline(BackendError):
+    default_code = "backend.deadline"
+
+
+class HttpError(Exception):
+    def __init__(self, status_code: int, message: str = "") -> None:
+        super().__init__(message or f"HTTP {status_code}")
+        self.status_code = status_code
+
+
+@dataclass
+class CallRecord:
+    op: str
+    timeout: float
+    idempotent: bool
+
+
+class StubSupport:
+    def __init__(self, clock: Clock | None = None) -> None:
+        self.clock: Clock = clock if clock is not None else SystemClock()
+        self.calls: list[CallRecord] = []
+        self.deadlines = 0
+        self.retry_sleeps: list[float] = []
+
+    async def call[T](
+        self,
+        op: str,
+        fn: Callable[[], T],
+        *,
+        timeout: float,
+        idempotent: bool = False,
+        on_deadline: Callable[[], None] | None = None,
+    ) -> T:
+        self.calls.append(CallRecord(op, timeout, idempotent))
+        attempts = 3 if idempotent else 1
+        for attempt in range(attempts):
+            try:
+                return await self._once(fn, timeout, on_deadline)
+            except StubDeadline:
+                raise
+            except Exception as exc:
+                code = getattr(exc, "status_code", None)
+                if attempt + 1 >= attempts or code not in TRANSIENT:
+                    raise
+                delay = 0.5 * 2**attempt
+                self.retry_sleeps.append(delay)
+                await self.clock.sleep(delay)
+        raise AssertionError("unreachable")
+
+    async def _once[T](
+        self, fn: Callable[[], T], timeout: float, on_deadline: Callable[[], None] | None
+    ) -> T:
+        loop = asyncio.get_running_loop()
+        future: asyncio.Future[T] = loop.create_future()
+
+        def work() -> None:
+            try:
+                value = fn()
+            except BaseException as exc:  # noqa: BLE001 - handed to the waiting task
+                error = exc
+                loop.call_soon_threadsafe(lambda: future.done() or future.set_exception(error))
+                return
+            loop.call_soon_threadsafe(lambda: future.done() or future.set_result(value))
+
+        threading.Thread(target=work, daemon=True).start()
+        timer = asyncio.ensure_future(self.clock.sleep(timeout))
+        try:
+            await asyncio.wait({future, timer}, return_when=asyncio.FIRST_COMPLETED)
+        finally:
+            timer.cancel()
+        if future.done():
+            return future.result()
+        future.cancel()
+        self.deadlines += 1
+        if on_deadline is not None:
+            on_deadline()
+        raise StubDeadline(f"vendor call took longer than {timeout:g}s")
+
+    def ops(self) -> list[tuple[str, float]]:
+        return [(c.op, c.timeout) for c in self.calls]
+
+    def guard(self, script: str, seconds: float) -> str:
+        return f"timeout -k 2 {int(seconds)} bash -c {shlex.quote(script)}"
+
+    async def stage_stdin(
+        self, data: str, *, temp_dir: str, write: WriteFile, size: FileSize
+    ) -> StagedStdin:
+        try:
+            payload = data.encode("utf-8")
+        except UnicodeEncodeError as exc:
+            return StagedStdin(error=f"stdin is not valid UTF-8 ({exc.reason})")
+        path = f"{temp_dir}/indus-stdin-{os.urandom(6).hex()}"
+        await write(path, payload)
+        got = await size(path)
+        if got != len(payload):
+            return StagedStdin(error=f"staged {got} of {len(payload)} stdin bytes")
+        q = shlex.quote(path)
+        return StagedStdin(prefix=f"exec 0<{q}; rm -f -- {q};\n", path=path)
+
+    def stdin_chunks(self, data: str) -> list[bytes]:
+        payload = data.encode("utf-8")
+        return [payload[i : i + CHUNK] for i in range(0, len(payload), CHUNK)]
+
+
+class StubRecords:
+    def __init__(self, initial: Mapping[str, Mapping[str, Any]] | None = None) -> None:
+        self.data: dict[str, dict[str, Any]] = {k: dict(v) for k, v in (initial or {}).items()}
+
+    def load(self, task_key: str) -> Mapping[str, Any] | None:
+        return self.data.get(task_key)
+
+    def save(self, task_key: str, fields: Mapping[str, Any]) -> None:
+        self.data.setdefault(task_key, {}).update(fields)
+
+    def drop(self, task_key: str, *, expect: Mapping[str, Any] | None = None) -> None:
+        current = self.data.get(task_key)
+        if current is None:
+            return
+        if expect and any(current.get(k) != v for k, v in expect.items()):
+            return
+        del self.data[task_key]
+
+
+# -- a sandbox made of a tmp dir and the local bash ----------------------------------------------
+
+
+class LocalBox:
+    """See the module notes. ``hang`` holds substrings: an exec whose script contains one never
+    returns (its output stream blocks) until ``release()``."""
+
+    def __init__(self, root: Path) -> None:
+        self.root = root
+        self.home = root / "home"
+        self.tmp = root / "tmp"
+        self.workspace = root / "workspace"
+        for d in (self.home, self.tmp, self.workspace):
+            d.mkdir(parents=True, exist_ok=True)
+        self.scripts: list[str] = []
+        self.hang: set[str] = set()
+        self._released = threading.Event()
+        self.live: list[subprocess.Popen[bytes]] = []
+
+    def env(self) -> dict[str, str]:
+        return {
+            "HOME": str(self.home),
+            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+            "LANG": "C.UTF-8",
+            "TMPDIR": str(self.tmp),
+        }
+
+    def hangs(self, script: str) -> bool:
+        return any(token in script for token in self.hang)
+
+    def wait_released(self) -> None:
+        self._released.wait(60)
+
+    def release(self) -> None:
+        self._released.set()
+        for proc in self.live:
+            with contextlib.suppress(Exception):
+                proc.kill()
+
+    def spawn(self, argv: list[str], *, cwd: str | None = None) -> subprocess.Popen[bytes]:
+        self.scripts.append(argv[-1])
+        proc = subprocess.Popen(  # noqa: S603 - test fake
+            argv,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            env=self.env(),
+            cwd=cwd or str(self.home),
+            start_new_session=True,
+        )
+        self.live.append(proc)
+        return proc
+
+    def run(self, argv: list[str], *, cwd: str | None = None) -> tuple[int, bytes]:
+        """Run to the end with no stdin; (exit status, stdout)."""
+        if self.hangs(argv[-1]):
+            self.wait_released()
+            return -9, b""
+        proc = self.spawn(argv, cwd=cwd)
+        assert proc.stdin is not None
+        proc.stdin.close()
+        out, _ = proc.communicate()
+        return proc.returncode, out
+
+    def path(self, remote: str) -> Path:
+        return Path(remote)
+
+
+# -- Modal ---------------------------------------------------------------------------------------
+
+
+class _ModalStdin:
+    def __init__(self, proc: subprocess.Popen[bytes], log: list[int], limit: int | None) -> None:
+        self.proc = proc
+        self.log = log
+        self.left = limit  # bytes that get through (None: all); simulates a lossy stream
+
+    def write(self, data: bytes) -> None:
+        self.log.append(len(data))
+        assert self.proc.stdin is not None
+        if self.left is not None:
+            data, self.left = data[: self.left], max(0, self.left - len(data))
+        self.proc.stdin.write(data)
+
+    def drain(self) -> None:
+        assert self.proc.stdin is not None
+        if self.proc.stdin.closed:
+            return
+        with contextlib.suppress(BrokenPipeError):
+            self.proc.stdin.flush()
+
+    def write_eof(self) -> None:
+        assert self.proc.stdin is not None
+        with contextlib.suppress(BrokenPipeError):
+            self.proc.stdin.close()
+
+
+class _ModalProcess:
+    def __init__(
+        self, box: LocalBox, argv: list[str], stdin_log: list[int], limit: int | None
+    ) -> None:
+        self.box = box
+        self.hung = box.hangs(argv[-1])
+        self.proc = box.spawn(["bash", "-c", "cat >/dev/null"] if self.hung else argv)
+        self.stdin = _ModalStdin(self.proc, stdin_log, limit)
+
+    @property
+    def stdout(self) -> Iterator[bytes]:
+        if self.hung:
+            self.box.wait_released()
+            return iter(())
+        assert self.proc.stdout is not None
+        fd = self.proc.stdout.fileno()
+        return iter(lambda: os.read(fd, CHUNK), b"")
+
+    def wait(self) -> int:
+        return self.proc.wait()
+
+
+@dataclass
+class _ModalImage:
+    object_id: str
+    registry: str | None = None
+
+
+class _ModalSandbox:
+    def __init__(self, fake: FakeModal, image: _ModalImage, kwargs: dict[str, Any]) -> None:
+        self.fake = fake
+        self.image = image
+        self.kwargs = kwargs
+        self.terminated = False
+
+    def exec(self, *argv: str, text: bool = True, timeout: int | None = None) -> _ModalProcess:
+        self.fake.log.append(("exec", argv[-1][:80]))
+        self.fake.exec_timeouts.append(timeout)
+        if self.fake.exec_error is not None:
+            raise self.fake.exec_error
+        return _ModalProcess(
+            self.fake.box, list(argv), self.fake.stdin_writes, self.fake.stdin_limit
+        )
+
+    def snapshot_filesystem(self, timeout: int = 55, *, ttl: int | None = 0) -> _ModalImage:
+        self.fake.log.append(("snapshot", ttl))
+        if self.fake.snapshot_error is not None:
+            raise self.fake.snapshot_error
+        return _ModalImage(f"im-snap-{next(self.fake.ids)}")
+
+    def terminate(self) -> None:
+        self.fake.log.append(("terminate",))
+        self.terminated = True
+
+
+class FakeModal:
+    """The ``modal`` surface the backend uses."""
+
+    def __init__(self, box: LocalBox) -> None:
+        self.box = box
+        self.log: list[tuple[Any, ...]] = []
+        self.ids = itertools.count(1)
+        self.gone_images: set[str] = set()
+        self.exec_error: BaseException | None = None
+        self.snapshot_error: BaseException | None = None
+        self.stdin_writes: list[int] = []
+        self.stdin_limit: int | None = None
+        self.exec_timeouts: list[int | None] = []
+        self.sandboxes: list[_ModalSandbox] = []
+        self.Client = SimpleNamespace(from_credentials=self._from_credentials)
+        self.App = SimpleNamespace(lookup=self._lookup)
+        self.Image = SimpleNamespace(from_id=self._from_id, from_registry=self._from_registry)
+        self.Sandbox = SimpleNamespace(create=self._create)
+
+    def _from_credentials(self, token_id: str, token_secret: str) -> object:
+        self.log.append(("client", len(token_id) > 0 and len(token_secret) > 0))
+        return object()
+
+    def _lookup(self, name: str, *, create_if_missing: bool = False, client: Any = None) -> object:
+        self.log.append(("app", name, create_if_missing))
+        return SimpleNamespace(name=name)
+
+    def _from_id(self, image_id: str, client: Any = None) -> _ModalImage:
+        return _ModalImage(image_id)
+
+    def _from_registry(self, tag: str, **_: Any) -> _ModalImage:
+        return _ModalImage(f"im-reg-{tag}", registry=tag)
+
+    def _create(self, *args: str, image: _ModalImage, **kwargs: Any) -> _ModalSandbox:
+        self.log.append(("create", image.registry or image.object_id, args, kwargs.get("timeout")))
+        if image.object_id in self.gone_images:
+            raise HttpError(404, f"image {image.object_id} not found")
+        sandbox = _ModalSandbox(self, image, kwargs)
+        self.sandboxes.append(sandbox)
+        return sandbox
+
+    def names(self) -> list[str]:
+        return [str(entry[0]) for entry in self.log]
+
+
+# -- Daytona -------------------------------------------------------------------------------------
+
+
+class DaytonaNotFoundError(Exception):
+    pass
+
+
+@dataclass
+class _DaytonaResponse:
+    exit_code: int
+    result: str
+
+
+class _DaytonaProcess:
+    def __init__(self, sandbox: _DaytonaSandbox) -> None:
+        self.sandbox = sandbox
+
+    def exec(self, command: str, cwd: str | None = None, env: Any = None, timeout: Any = None):
+        self.sandbox.fake.log.append(("exec", timeout))
+        self.sandbox.fake.commands.append(command)
+        if self.sandbox.fake.fail_guarded and "timeout -k" in command:
+            self.sandbox.fake.fail_guarded -= 1
+            raise HttpError(503, "exec endpoint unavailable")
+        code, out = self.sandbox.fake.box.run(["bash", "-c", command], cwd=cwd)
+        return _DaytonaResponse(code, out.decode("utf-8", "replace"))
+
+
+class _DaytonaFs:
+    def __init__(self, sandbox: _DaytonaSandbox) -> None:
+        self.sandbox = sandbox
+
+    def upload_file(self, src: bytes | str, remote: str, timeout: int = 1800) -> None:
+        self.sandbox.fake.log.append(("upload", remote))
+        data = src if isinstance(src, bytes) else Path(src).read_bytes()
+        target = Path(remote)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+
+    def download_file(self, remote: str, local: str, timeout: int = 1800) -> None:
+        self.sandbox.fake.log.append(("download", remote))
+        Path(local).write_bytes(Path(remote).read_bytes())
+
+    def get_file_info(self, path: str) -> Any:
+        return SimpleNamespace(size=Path(path).stat().st_size)
+
+    def delete_file(self, path: str) -> None:
+        Path(path).unlink(missing_ok=True)
+
+
+class _DaytonaSandbox:
+    def __init__(self, fake: FakeDaytona, name: str, params: Any = None) -> None:
+        self.fake = fake
+        self.name = name
+        self.params = params
+        self.state = SimpleNamespace(value="started")
+        self.process = _DaytonaProcess(self)
+        self.fs = _DaytonaFs(self)
+
+    def refresh_data(self) -> None:
+        self.fake.log.append(("refresh", self.name))
+
+    def start(self, timeout: float | None = 60) -> None:
+        self.fake.log.append(("start", self.name))
+        self.state = SimpleNamespace(value="started")
+
+    def stop(self, timeout: float | None = 60, force: bool = False) -> None:
+        self.fake.log.append(("stop", self.name))
+        self.state = SimpleNamespace(value="stopped")
+
+
+class _DaytonaClient:
+    def __init__(self, fake: FakeDaytona, config: Any) -> None:
+        self.fake = fake
+        self.config = config
+
+    def get(self, name: str) -> _DaytonaSandbox:
+        self.fake.log.append(("get", name))
+        found = self.fake.sandboxes.get(name)
+        if found is None:
+            raise DaytonaNotFoundError(name)
+        return found
+
+    def create(self, params: Any, *, timeout: float = 60) -> _DaytonaSandbox:
+        self.fake.log.append(("create", params.name))
+        sandbox = _DaytonaSandbox(self.fake, params.name, params)
+        self.fake.sandboxes[params.name] = sandbox
+        return sandbox
+
+    def delete(self, sandbox: _DaytonaSandbox, timeout: float = 60, wait: bool = False) -> None:
+        self.fake.log.append(("delete", sandbox.name))
+        self.fake.sandboxes.pop(sandbox.name, None)
+
+
+class FakeDaytona:
+    """The ``daytona`` surface the backend uses."""
+
+    DaytonaNotFoundError = DaytonaNotFoundError
+
+    def __init__(self, box: LocalBox) -> None:
+        self.box = box
+        self.log: list[tuple[Any, ...]] = []
+        self.commands: list[str] = []
+        self.sandboxes: dict[str, _DaytonaSandbox] = {}
+        self.configs: list[Any] = []
+        self.fail_guarded = 0  # the next N guarded command execs raise 503
+
+    def Daytona(self, config: Any) -> _DaytonaClient:  # noqa: N802 - vendor name
+        self.configs.append(config)
+        return _DaytonaClient(self, config)
+
+    @staticmethod
+    def DaytonaConfig(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    @staticmethod
+    def CreateSandboxFromImageParams(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    @staticmethod
+    def Resources(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    def add(self, name: str, state: str = "stopped") -> _DaytonaSandbox:
+        sandbox = _DaytonaSandbox(self, name)
+        sandbox.state = SimpleNamespace(value=state)
+        self.sandboxes[name] = sandbox
+        return sandbox
+
+    def names(self) -> list[str]:
+        return [str(entry[0]) for entry in self.log]
+
+
+# -- Vercel --------------------------------------------------------------------------------------
+
+
+class _VercelReader:
+    def __init__(self, data: bytes) -> None:
+        self.data = data
+
+    def read(self) -> str:
+        return self.data.decode("utf-8", "replace")
+
+
+class _VercelProcess:
+    def __init__(self, box: LocalBox, argv: list[str], cwd: str | None) -> None:
+        self.box = box
+        self.argv = argv
+        self.cwd = cwd
+        self.killed = 0
+        self.stdout: _VercelReader | None = None
+        self.hung = box.hangs(argv[-1])
+        self.proc = None if self.hung else box.spawn(argv, cwd=cwd)
+
+    def wait(self) -> int:
+        if self.proc is None:
+            self.box.wait_released()
+            self.stdout = _VercelReader(b"")
+            return -9
+        assert self.proc.stdin is not None
+        self.proc.stdin.close()
+        out, _ = self.proc.communicate()
+        self.stdout = _VercelReader(out)
+        return self.proc.returncode
+
+    def kill(self) -> None:
+        self.killed += 1
+        if self.proc is not None:
+            with contextlib.suppress(Exception):
+                self.proc.kill()
+
+
+class _VercelFs:
+    def __init__(self, fake: FakeVercel) -> None:
+        self.fake = fake
+
+    def write_bytes(self, path: str, data: bytes, *, cwd: Any = None, mode: int | None = None):
+        self.fake.log.append(("write", path))
+        if self.fake.write_failures > 0:
+            self.fake.write_failures -= 1
+            raise HttpError(503, "write failed")
+        target = Path(path)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+        if mode is not None:
+            os.chmod(target, mode)
+
+    def read_bytes(self, path: str, *, cwd: Any = None) -> bytes:
+        self.fake.log.append(("read", path))
+        return Path(path).read_bytes()
+
+
+class _VercelSandbox:
+    def __init__(self, fake: FakeVercel, name: str, kwargs: dict[str, Any]) -> None:
+        self.fake = fake
+        self.name = name
+        self.kwargs = kwargs
+        self.status = SimpleNamespace(value="running")
+        self.cwd = str(fake.box.workspace)
+        self.fs = _VercelFs(fake)
+        self.processes: list[_VercelProcess] = []
+
+    def create_process(
+        self, command: str, args: list[str] | None = None, *, cwd: str | None = None, **_: Any
+    ) -> _VercelProcess:
+        self.fake.log.append(("process", self.name))
+        process = _VercelProcess(self.fake.box, [command, *(args or [])], cwd)
+        self.processes.append(process)
+        return process
+
+    def snapshot(self, *, expiration: Any = None) -> Any:
+        self.fake.log.append(("snapshot", self.name))
+        if self.fake.snapshot_error is not None:
+            raise self.fake.snapshot_error
+        return SimpleNamespace(id=f"snap-{next(self.fake.ids)}")
+
+    def stop(self) -> _VercelSandbox:
+        self.fake.log.append(("stop", self.name))
+        self.status = SimpleNamespace(value="stopped")
+        return self
+
+
+class _VercelClient:
+    def __init__(self, fake: FakeVercel, options: Any) -> None:
+        self.fake = fake
+        self.options = options
+
+    def create_sandbox(self, **kwargs: Any) -> _VercelSandbox:
+        source = kwargs.get("source")
+        self.fake.log.append(
+            ("create", getattr(source, "snapshot_id", None) or kwargs.get("image"))
+        )
+        if self.fake.create_errors:
+            raise self.fake.create_errors.pop(0)
+        if source is not None and source.snapshot_id in self.fake.gone_snapshots:
+            raise HttpError(404, "snapshot not found")
+        sandbox = _VercelSandbox(self.fake, f"sbx-{next(self.fake.ids)}", kwargs)
+        if self.fake.start_status is not None:
+            sandbox.status = SimpleNamespace(value=self.fake.start_status)
+        self.fake.sandboxes[sandbox.name] = sandbox
+        return sandbox
+
+    def get_sandbox(self, *, name: str, **_: Any) -> _VercelSandbox:
+        self.fake.log.append(("get", name))
+        sandbox = self.fake.sandboxes[name]
+        if self.fake.status_script:
+            sandbox.status = SimpleNamespace(value=self.fake.status_script.pop(0))
+        return sandbox
+
+    def close(self) -> None:
+        self.fake.log.append(("close",))
+
+
+class FakeVercel:
+    """The ``vercel.sandbox.sync`` surface the backend uses."""
+
+    def __init__(self, box: LocalBox) -> None:
+        self.box = box
+        self.log: list[tuple[Any, ...]] = []
+        self.ids = itertools.count(1)
+        self.sandboxes: dict[str, _VercelSandbox] = {}
+        self.create_errors: list[BaseException] = []
+        self.gone_snapshots: set[str] = set()
+        self.write_failures = 0
+        self.snapshot_error: BaseException | None = None
+        self.start_status: str | None = None
+        self.status_script: list[str] = []
+        self.options: list[Any] = []
+        self.SyncSandboxClient = SimpleNamespace(create=self._client)
+
+    def _client(self, *, options: Any = None, **_: Any) -> _VercelClient:
+        self.log.append(("client",))
+        self.options.append(options)
+        return _VercelClient(self, options)
+
+    @staticmethod
+    def SandboxServiceOptions(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    @staticmethod
+    def SandboxCredentials(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    @staticmethod
+    def SnapshotSource(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    @staticmethod
+    def SandboxResources(**kwargs: Any) -> Any:  # noqa: N802 - vendor name
+        return SimpleNamespace(**kwargs)
+
+    def names(self) -> list[str]:
+        return [str(entry[0]) for entry in self.log]
+
+
+@dataclass
+class Fixture:
+    """What most SDK backend tests need at once."""
+
+    box: LocalBox
+    support: StubSupport
+    records: StubRecords = field(default_factory=StubRecords)
