new file mode 100644
index 0000000..b328d22
--- /dev/null
+++ b/apps/desktop/testing/seeded.ts
@@ -0,0 +1,12 @@
+// A small seeded generator (mulberry32) so jittered delays are repeatable in tests.
+
+export function seeded(seed: number): () => number {
+  let state = seed >>> 0;
+  return () => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let t = state;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4_294_967_296;
+  };
+}
