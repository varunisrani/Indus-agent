index 0000000..5fdef75
--- /dev/null
+++ b/apps/desktop/src/gateway/serverRequests.test.ts
@@ -0,0 +1,187 @@
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import type { ApprovalRequest, ServerRequestAnswer } from "@indus/protocol";
+import { describe, expect, it } from "vitest";
+import { harness, settle } from "./testSupport.ts";
+import { RECONNECT_CAP_MS } from "./timing.ts";
+
+function approval(id: string, sessionId = "s1"): ApprovalRequest {
+  return {
+    request_id: id,
+    session_id: sessionId,
+    kind: "approval",
+    command: "rm -rf build",
+    description: "deletes a folder",
+  };
+}
+
+function offer(request: ApprovalRequest, replayed: boolean) {
+  return {
+    jsonrpc: "2.0",
+    method: "server_request",
+    params: { request, replayed, generation: 1 },
+  };
+}
+
+async function open(capabilities: string[] = []) {
+  const h = harness();
+  h.server.handle("server_request.answer", () => ({ accepted: true }));
+  h.server.handle("server_request.decline", () => ({ accepted: true }));
+  h.connection.start();
+  await settle();
+  h.ready(capabilities);
+  await settle();
+  await h.connection.watchSession("s1");
+  return h;
+}
+
+interface RequestFixture {
+  frames: Array<
+    | { op: "offer"; request: ApprovalRequest; replayed: boolean; generation: number }
+    | { op: "reconnect" }
+    | { op: "answer"; request_id: string; answer: ServerRequestAnswer }
+  >;
+  expect: { cards_max: number; answers_on_wire: number; answer: ServerRequestAnswer };
+}
+
+const FIXTURE = path.resolve(
+  path.dirname(fileURLToPath(import.meta.url)),
+  "../../testing/fixtures/streams/replayed-requests.json",
+);
+
+describe("ServerRequestStore", () => {
+  it("replays the replayed-requests fixture: one card, one answer on the wire", async () => {
+    const fixture = JSON.parse(fs.readFileSync(FIXTURE, "utf8")) as RequestFixture;
+    const h = await open();
+    const requests = h.connection.serverRequests;
+    let most = 0;
+    for (const frame of fixture.frames) {
+      if (frame.op === "offer") {
+        h.server.sendRaw({
+          jsonrpc: "2.0",
+          method: "server_request",
+          params: {
+            request: frame.request,
+            replayed: frame.replayed,
+            generation: frame.generation,
+          },
+        });
+      } else if (frame.op === "reconnect") {
+        h.server.die("cut");
+        await settle();
+        await h.advance(RECONNECT_CAP_MS);
+        h.ready();
+      } else {
+        requests.answer(frame.request_id, frame.answer);
+      }
+      await settle();
+      most = Math.max(most, requests.list().length);
+    }
+    expect(most).toBe(fixture.expect.cards_max);
+    const answers = h.server.calls("server_request.answer");
+    expect(answers).toHaveLength(fixture.expect.answers_on_wire);
+    expect(answers[0]?.params).toMatchObject({ answer: fixture.expect.answer, generation: 1 });
+  });
+
+  it("a re-offered approval stays one card and is answered once on the wire", async () => {
+    const h = await open();
+    const requests = h.connection.serverRequests;
+    h.server.sendRaw(offer(approval("srq-1"), false));
+    await settle();
+    expect(requests.list("s1").map((card) => card.id)).toEqual(["srq-1"]);
+    expect(requests.list("s1")[0]?.replayed).toBe(false);
+
+    h.server.die("cut");
+    await settle();
+    await h.advance(RECONNECT_CAP_MS);
+    h.ready();
+    await settle();
+    // The daemon offers it again after the reconnect, marked replayed.
+    h.server.sendRaw(offer(approval("srq-1"), true));
+    await settle();
+    expect(requests.list()).toHaveLength(1);
+
+    expect(requests.answer("srq-1", { kind: "approval", choice: "once" })).toBe(true);
+    expect(requests.answer("srq-1", { kind: "approval", choice: "deny" })).toBe(false);
+    await settle();
+    // A late third delivery after the answer shows nothing.
+    h.server.sendRaw(offer(approval("srq-1"), true));
+    await settle();
+    expect(requests.list()).toHaveLength(0);
+    const answers = h.server.calls("server_request.answer");
+    expect(answers).toHaveLength(1);
+    expect(answers[0]?.params).toMatchObject({
+      request_id: "srq-1",
+      answer: { kind: "approval", choice: "once" },
+    });
+    expect(requests.isAnswered("srq-1")).toBe(true);
+  });
+
+  it("a card first seen through a replay says so", async () => {
+    const h = await open();
+    h.server.sendRaw(offer(approval("srq-2"), true));
+    await settle();
+    expect(h.connection.serverRequests.get("srq-2")?.replayed).toBe(true);
+  });
+
+  it("withdrawn requests close their card", async () => {
+    const h = await open();
+    const requests = h.connection.serverRequests;
+    h.server.sendRaw(offer(approval("srq-3"), false));
+    h.server.sendRaw(offer(approval("srq-4"), false));
+    await settle();
+    expect(requests.list()).toHaveLength(2);
+    h.emit("s1", {
+      type: "request.settled",
+      request_id: "srq-3",
+      kind: "approval",
+      outcome: "answered",
+    });
+    await settle();
+    expect(requests.list().map((card) => card.id)).toEqual(["srq-4"]);
+    expect(requests.answer("srq-3", { kind: "approval", choice: "once" })).toBe(false);
+  });
+
+  it("sends a decline frame only to a daemon that counts declines", async () => {
+    const counting = await open(["request.decline"]);
+    counting.server.sendRaw(offer(approval("srq-5"), false));
+    await settle();
+    expect(counting.connection.serverRequests.decline("srq-5")).toBe(true);
+    expect(counting.connection.serverRequests.decline("srq-5")).toBe(false);
+    await settle();
+    expect(counting.server.calls("server_request.decline")).toHaveLength(1);
+    expect(counting.server.calls("server_request.answer")).toHaveLength(0);
+
+    const plain = await open([]);
+    plain.server.sendRaw(offer(approval("srq-6"), false));
+    await settle();
+    expect(plain.connection.serverRequests.decline("srq-6")).toBe(true);
+    await settle();
+    expect(plain.server.calls("server_request.decline")).toHaveLength(0);
+    // The refusal every daemon understands: an error frame under the request's id.
+    const refusals = plain.server.received.filter((frame) => frame.id === "srq-6");
+    expect(refusals).toHaveLength(1);
+    expect(refusals[0]).toHaveProperty("error");
+    expect(plain.server.calls("server_request.answer")).toHaveLength(0);
+  });
+
+  it("refuses an answer of the wrong kind and keeps the card", async () => {
+    const h = await open();
+    h.server.sendRaw(offer(approval("srq-7"), false));
+    await settle();
+    expect(h.connection.serverRequests.answer("srq-7", { kind: "sudo", password: null })).toBe(
+      false,
+    );
+    expect(h.connection.serverRequests.list()).toHaveLength(1);
+  });
+
+  it("keeps the list stable between changes (safe for useSyncExternalStore)", async () => {
+    const h = await open();
+    const requests = h.connection.serverRequests;
+    h.server.sendRaw(offer(approval("srq-8"), false));
+    await settle();
+    expect(requests.list("s1")).toBe(requests.list("s1"));
+    expect(requests.list()).toBe(requests.list());
+  });
+});
diff --git a/apps/desktop/src/gateway/serverRequests.ts b/apps/desktop/src/gateway/serverRequests.ts
new file mode 100644
index 0000000..0d32ff2
--- /dev/null
+++ b/apps/desktop/src/gateway/serverRequests.ts
@@ -0,0 +1,157 @@
+// Open server requests of one connection (approval, clarify, sudo, secret), as cards the renderer
+// shows. The channel hands each request to a handler that waits for the person; this store keeps
+// those waits by id. First answer wins (R08.19): a second answer, a double click or a card the
+// daemon re-offered after a reconnect never produces a second frame on the wire.
+
+import {
+  declineAnswer,
+  type IncomingRequest,
+  type RpcChannel,
+  type ServerRequestHandlers,
+} from "@indus/client";
+import type { ServerRequest, ServerRequestAnswer, ServerRequestKind } from "@indus/protocol";
+
+export interface PendingServerRequest {
+  /** The request's `request_id`. */
+  readonly id: string;
+  readonly kind: ServerRequestKind;
+  readonly sessionId: string;
+  /** The typed payload (`ApprovalRequest`, `ClarifyRequest`, ...). */
+  readonly request: ServerRequest;
+  /** Re-offered after a reconnect (or a resume) rather than first asked on this link. */
+  readonly replayed: boolean;
+  readonly receivedAt: number;
+}
+
+interface Waiting {
+  readonly card: PendingServerRequest;
+  readonly settle: (answer: ServerRequestAnswer) => void;
+}
+
+/** Ids remembered after their card closed, so a late repeat is still recognised. */
+const SETTLED_MEMORY = 512;
+
+const KINDS: readonly ServerRequestKind[] = ["approval", "clarify", "sudo", "secret"];
+
+export interface ServerRequestStoreOptions {
+  now?: () => number;
+  /** The channel whose `decline` sends the "not shown here" refusal. */
+  channel?: () => Pick<RpcChannel, "decline"> | null;
+}
+
+export class ServerRequestStore {
+  private readonly waiting = new Map<string, Waiting>();
+  private readonly settled = new Set<string>();
+  private readonly listeners = new Set<() => void>();
+  private readonly options: ServerRequestStoreOptions;
+  private snapshot: readonly PendingServerRequest[] = [];
+  private readonly bySession = new Map<string, readonly PendingServerRequest[]>();
+
+  constructor(options: ServerRequestStoreOptions = {}) {
+    this.options = options;
+  }
+
+  /** Open requests in arrival order, all or one session's. The array is stable between changes. */
+  list(sessionId?: string): readonly PendingServerRequest[] {
+    if (sessionId === undefined) return this.snapshot;
+    let cached = this.bySession.get(sessionId);
+    if (cached === undefined) {
+      cached = this.snapshot.filter((card) => card.sessionId === sessionId);
+      this.bySession.set(sessionId, cached);
+    }
+    return cached;
+  }
+
+  get(id: string): PendingServerRequest | undefined {
+    return this.waiting.get(id)?.card;
+  }
+
+  isAnswered(id: string): boolean {
+    return this.settled.has(id);
+  }
+
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  }
+
+  /** Answer an open request. False when it was already answered, withdrawn or never seen. */
+  answer(id: string, answer: ServerRequestAnswer): boolean {
+    const entry = this.waiting.get(id);
+    if (entry === undefined || this.settled.has(id)) return false;
+    if (answer.kind !== entry.card.kind) return false;
+    this.close(id);
+    entry.settle(answer);
+    return true;
+  }
+
+  /**
+   * "Not shown here": the channel sends `server_request.decline` only to a daemon that counts
+   * declines, and the plain refusal otherwise. False when already answered or unknown.
+   */
+  decline(id: string): boolean {
+    const entry = this.waiting.get(id);
+    if (entry === undefined || this.settled.has(id)) return false;
+    this.close(id);
+    // The channel finishes the id first (its decline frame or refusal); the wait then settles
+    // with the kind's decline answer, which the channel drops as a second answer. Without a
+    // channel that answer is the refusal itself.
+    this.options.channel?.()?.decline(id);
+    entry.settle(declineAnswer(entry.card.request));
+    return true;
+  }
+
+  /** The handler table for `IndusClient.handle({ serverRequests })`. */
+  handlers(): ServerRequestHandlers {
+    const table: Record<string, (request: ServerRequest, meta: IncomingRequest) => unknown> = {};
+    for (const kind of KINDS) {
+      table[kind] = (request, meta) => this.accept(request, meta);
+    }
+    return table as ServerRequestHandlers;
+  }
+
+  /** Drop every card (the connection is gone for good). Waits are left to the channel. */
+  clear(): void {
+    if (this.waiting.size === 0) return;
+    for (const id of [...this.waiting.keys()]) this.close(id);
+  }
+
+  private accept(request: ServerRequest, meta: IncomingRequest): Promise<ServerRequestAnswer> {
+    return new Promise<ServerRequestAnswer>((resolve) => {
+      const id = request.request_id;
+      if (this.waiting.has(id) || this.settled.has(id)) {
+        // The channel already drops repeats; a second wait for the same id never shows a card.
+        return;
+      }
+      const card: PendingServerRequest = {
+        id,
+        kind: request.kind,
+        sessionId: request.session_id,
+        request,
+        replayed: meta.replayed,
+        receivedAt: (this.options.now ?? Date.now)(),
+      };
+      this.waiting.set(id, { card, settle: resolve });
+      meta.signal.addEventListener("abort", () => this.close(id), { once: true });
+      this.changed();
+    });
+  }
+
+  private close(id: string): void {
+    if (!this.waiting.delete(id)) return;
+    this.settled.add(id);
+    if (this.settled.size > SETTLED_MEMORY) {
+      const oldest = this.settled.values().next().value;
+      if (oldest !== undefined) this.settled.delete(oldest);
+    }
+    this.changed();
+  }
+
+  private changed(): void {
+    this.snapshot = [...this.waiting.values()].map((entry) => entry.card);
+    this.bySession.clear();
+    for (const listener of [...this.listeners]) listener();
+  }
+}
diff --git a/apps/desktop/src/gateway/testSupport.ts b/apps/desktop/src/gateway/testSupport.ts
new file mode 100644
index 0000000..e415e4c
--- /dev/null
+++ b/apps/desktop/src/gateway/testSupport.ts
@@ -0,0 +1,151 @@
+// Test harness for the connection store: a fake bridge (descriptor + ticket mint), the in-memory
+// FakeServer as the daemon, and a deterministic clock. No sockets, no Electron.
+
+import type { Clock, Transport } from "@indus/client";
+import { FakeServer } from "@indus/client/testing";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import type { IndusConnectionDescriptor } from "../global.d.ts";
+import {
+  type ConnectionBridge,
+  ConnectionStore,
+  type DialRequest,
+  type GatewayConnection,
+} from "./connectionStore.ts";
+
+export const EPOCH = "epoch-1";
+
+export function descriptor(instanceId = "inst-1"): IndusConnectionDescriptor {
+  return {
+    mode: "local",
+    profile: null,
+    profileId: "p1",
+    instanceId,
+    codeVersion: "0.20.0",
+    wsUrl: "ws://127.0.0.1:4100/ws",
+  };
+}
+
+/** Let queued microtasks and the FakeServer's hops run. */
+export async function settle(rounds = 8): Promise<void> {
+  for (let i = 0; i < rounds; i += 1) await new Promise((resolve) => setImmediate(resolve));
+}
+
+export interface Harness {
+  timers: FakeTimers;
+  clock: Clock;
+  server: FakeServer;
+  store: ConnectionStore;
+  connection: GatewayConnection;
+  dials: DialRequest[];
+  tickets: number;
+  changed: Array<(payload: IndusConnectionDescriptor | null) => void>;
+  /** Number of `connection.ticket` calls that should fail before minting again. */
+  failTickets: number;
+  /** Events the daemon has sent per session, for replays. */
+  log: Map<string, Array<Record<string, unknown>>>;
+  /** Send ready on the current link. */
+  ready(capabilities?: string[]): void;
+  /** Emit a session event (seq per session) and remember it for replays. */
+  emit(sessionId: string, event: { type: string } & Record<string, unknown>): void;
+  /** Advance fake time and let async work settle. */
+  advance(ms: number): Promise<void>;
+}
+
+export function harness(options: { random?: () => number } = {}): Harness {
+  const timers = new FakeTimers();
+  const clock: Clock = {
+    now: () => timers.now,
+    setTimeout: (run, ms) => timers.setTimeout(run, ms),
+    clearTimeout: (handle) => timers.clearTimeout(handle),
+  };
+  const server = new FakeServer();
+  const log = new Map<string, Array<Record<string, unknown>>>();
+  const seqs = new Map<string, number>();
+  const h = {
+    timers,
+    clock,
+    server,
+    dials: [] as DialRequest[],
+    tickets: 0,
+    changed: [] as Array<(payload: IndusConnectionDescriptor | null) => void>,
+    failTickets: 0,
+    log,
+  } as Harness;
+  const bridge: ConnectionBridge = {
+    get: async () => descriptor(),
+    ticket: async () => {
+      if (h.failTickets > 0) {
+        h.failTickets -= 1;
+        throw new Error("internal: stale socket");
+      }
+      h.tickets += 1;
+      return {
+        wsUrl: "ws://127.0.0.1:4100/ws",
+        protocols: ["indus-gateway-v1", `indus-gateway-ticket.tk${h.tickets}`],
+        expiresInMs: 30_000,
+      };
+    },
+    onChanged: (listener) => {
+      h.changed.push(listener);
+      return () => undefined;
+    },
+  };
+  h.store = new ConnectionStore({
+    bridge,
+    clock,
+    random: options.random ?? (() => 0.5),
+    transport: (dial): Transport => {
+      h.dials.push(dial);
+      return server.connect();
+    },
+  });
+  h.connection = h.store.primary();
+  h.ready = (capabilities = []) => {
+    server.sendRaw({
+      jsonrpc: "2.0",
+      method: "gateway.ready",
+      params: {
+        type: "gateway.ready",
+        protocol_version: 1,
+        replay_epoch: EPOCH,
+        capabilities,
+      },
+    });
+  };
+  h.emit = (sessionId, event) => {
+    const seq = (seqs.get(sessionId) ?? 0) + 1;
+    seqs.set(sessionId, seq);
+    const params = { session_id: sessionId, seq, replay_epoch: EPOCH, ...event };
+    const list = log.get(sessionId) ?? [];
+    list.push(params);
+    log.set(sessionId, list);
+    server.sendRaw({ jsonrpc: "2.0", method: event.type, params });
+  };
+  h.advance = async (ms) => {
+    timers.advance(ms);
+    await settle();
+  };
+  // The daemon's subscribe: replay what came after the cursor, then answer.
+  server.handle("session.subscribe", (params) => {
+    const sessionId = String(params.session_id);
+    const cursor = typeof params.cursor === "number" ? params.cursor : null;
+    const events = log.get(sessionId) ?? [];
+    let replayed = 0;
+    if (cursor !== null) {
+      for (const event of events) {
+        if ((event.seq as number) > cursor) {
+          server.sendRaw({ jsonrpc: "2.0", method: String(event.type), params: event });
+          replayed += 1;
+        }
+      }
+    }
+    return {
+      session_id: sessionId,
+      replay_epoch: EPOCH,
+      last_seq: seqs.get(sessionId) ?? 0,
+      replayed,
+    };
+  });
+  server.handle("session.unsubscribe", () => ({ ok: true }));
+  return h;
+}
