index 0000000..74dab20
--- /dev/null
+++ b/apps/desktop/src/boot/bootRetry.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import { seeded } from "../../testing/seeded.ts";
+import {
+  BOOT_RETRY_BASE_MS,
+  BOOT_RETRY_CAP_MS,
+  BOOT_RETRY_MAX_ATTEMPTS,
+  BootRetry,
+  bootRetryDelay,
+} from "./bootRetry.ts";
+
+function clockOf(timers: FakeTimers) {
+  return {
+    now: () => timers.now,
+    setTimeout: (run: () => void, ms: number) => timers.setTimeout(run, ms),
+    clearTimeout: (handle: unknown) => timers.clearTimeout(handle),
+  };
+}
+
+describe("boot retry", () => {
+  it("keeps every delay inside the full-jitter bounds (seeded)", () => {
+    for (let seed = 1; seed <= 50; seed += 1) {
+      const random = seeded(seed);
+      for (let attempt = 1; attempt <= BOOT_RETRY_MAX_ATTEMPTS; attempt += 1) {
+        const step = Math.min(BOOT_RETRY_CAP_MS, BOOT_RETRY_BASE_MS * 2 ** (attempt - 1));
+        const delay = bootRetryDelay(attempt, random);
+        expect(delay).toBeGreaterThanOrEqual(0);
+        expect(delay).toBeLessThan(step);
+      }
+    }
+  });
+
+  it("makes at most five attempts, each after its delay; the sixth is never made", () => {
+    const timers = new FakeTimers();
+    const retry = new BootRetry({ clock: clockOf(timers), random: seeded(7) });
+    let runs = 0;
+    for (let i = 0; i < BOOT_RETRY_MAX_ATTEMPTS; i += 1) {
+      const delay = retry.schedule(() => {
+        runs += 1;
+      });
+      expect(delay).not.toBeNull();
+      expect(retry.schedule(() => undefined)).toBeNull();
+      timers.advance(Math.max(0, (delay ?? 0) - 1));
+      expect(runs).toBe(i);
+      timers.advance(1);
+      expect(runs).toBe(i + 1);
+    }
+    expect(retry.exhausted).toBe(true);
+    expect(retry.schedule(() => undefined)).toBeNull();
+    timers.advance(10 * BOOT_RETRY_CAP_MS);
+    expect(runs).toBe(BOOT_RETRY_MAX_ATTEMPTS);
+    retry.reset();
+    expect(retry.exhausted).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/boot/bootRetry.ts b/apps/desktop/src/boot/bootRetry.ts
new file mode 100644
index 0000000..fbade9d
--- /dev/null
+++ b/apps/desktop/src/boot/bootRetry.ts
@@ -0,0 +1,90 @@
+// The renderer's own retry of a retryable boot failure (P20-16): full jitter in
+// [0, base · 2^(n−1)), base 2,000 ms, at most 5 attempts; then the failure overlay stays.
+// Latching (whether retrying can help at all) is main's verdict (P20-12), not decided here.
+
+import { backoffDelay, type Clock, systemClock } from "@indus/client";
+
+export const BOOT_RETRY_BASE_MS = 2_000;
+export const BOOT_RETRY_MAX_ATTEMPTS = 5;
+export const BOOT_RETRY_CAP_MS = 60_000;
+
+export interface BootRetryOptions {
+  clock?: Clock;
+  random?: () => number;
+  maxAttempts?: number;
+  baseMs?: number;
+}
+
+export function bootRetryDelay(attempt: number, random: () => number = Math.random): number {
+  return backoffDelay(attempt, {
+    baseMs: BOOT_RETRY_BASE_MS,
+    capMs: BOOT_RETRY_CAP_MS,
+    jitter: "full",
+    random,
+  });
+}
+
+export class BootRetry {
+  private readonly clock: Clock;
+  private readonly random: () => number;
+  private readonly maxAttempts: number;
+  private readonly baseMs: number;
+  private timer: unknown;
+  private used = 0;
+  /** When the pending attempt fires (ms on the clock), null when none is pending. */
+  dueAt: number | null = null;
+
+  constructor(options: BootRetryOptions = {}) {
+    this.clock = options.clock ?? systemClock;
+    this.random = options.random ?? Math.random;
+    this.maxAttempts = options.maxAttempts ?? BOOT_RETRY_MAX_ATTEMPTS;
+    this.baseMs = options.baseMs ?? BOOT_RETRY_BASE_MS;
+  }
+
+  get attempts(): number {
+    return this.used;
+  }
+
+  get max(): number {
+    return this.maxAttempts;
+  }
+
+  get pending(): boolean {
+    return this.timer !== undefined;
+  }
+
+  get exhausted(): boolean {
+    return this.used >= this.maxAttempts;
+  }
+
+  /** Schedule the next attempt; returns its delay, or null when none is left (or one waits). */
+  schedule(run: () => void): number | null {
+    if (this.timer !== undefined || this.exhausted) return null;
+    this.used += 1;
+    const delay = backoffDelay(this.used, {
+      baseMs: this.baseMs,
+      capMs: BOOT_RETRY_CAP_MS,
+      jitter: "full",
+      random: this.random,
+    });
+    this.dueAt = this.clock.now() + delay;
+    this.timer = this.clock.setTimeout(() => {
+      this.timer = undefined;
+      this.dueAt = null;
+      run();
+    }, delay);
+    return delay;
+  }
+
+  cancel(): void {
+    if (this.timer !== undefined) this.clock.clearTimeout(this.timer);
+    this.timer = undefined;
+    this.dueAt = null;
+  }
+
+  /** A manual retry or a successful boot starts a fresh ladder. */
+  reset(): void {
+    this.cancel();
+    this.used = 0;
+  }
+}
diff --git a/apps/desktop/src/boot/bootState.ts b/apps/desktop/src/boot/bootState.ts
new file mode 100644
index 0000000..0730027
--- /dev/null
+++ b/apps/desktop/src/boot/bootState.ts
@@ -0,0 +1,115 @@
+// From main's boot snapshot and the installer's events to the one view the overlay shows.
+
+import type { IndusBootProgress, IndusInstallerEvent } from "../global.d.ts";
+
+export type StageState = "pending" | "running" | "succeeded" | "skipped" | "failed";
+
+export interface InstallStage {
+  readonly name: string;
+  readonly title: string;
+  readonly state: StageState;
+  readonly error: string | null;
+}
+
+export interface InstallerState {
+  readonly stages: readonly InstallStage[];
+  readonly log: readonly string[];
+  /** A manifest arrived and neither completion nor failure since. */
+  readonly active: boolean;
+  readonly failed: string | null;
+  readonly complete: boolean;
+}
+
+/** Installer lines kept; the view shows the tail. */
+export const INSTALL_LOG_KEEP = 200;
+export const INSTALL_LOG_SHOWN = 12;
+
+export const EMPTY_INSTALLER: InstallerState = {
+  stages: [],
+  log: [],
+  active: false,
+  failed: null,
+  complete: false,
+};
+
+export function reduceInstaller(state: InstallerState, event: IndusInstallerEvent): InstallerState {
+  switch (event.type) {
+    case "manifest":
+      return {
+        stages: event.stages.map((stage) => ({
+          name: stage.name,
+          title: stage.title,
+          state: "pending",
+          error: null,
+        })),
+        log: [],
+        active: true,
+        failed: null,
+        complete: false,
+      };
+    case "log": {
+      const log = [...state.log, event.line];
+      return { ...state, log: log.length > INSTALL_LOG_KEEP ? log.slice(-INSTALL_LOG_KEEP) : log };
+    }
+    case "stage": {
+      const known = state.stages.some((stage) => stage.name === event.name);
+      const stages = known
+        ? state.stages.map((stage) =>
+            stage.name === event.name
+              ? { ...stage, state: event.state, error: event.error ?? null }
+              : stage,
+          )
+        : [
+            ...state.stages,
+            { name: event.name, title: event.name, state: event.state, error: event.error ?? null },
+          ];
+      return { ...state, stages };
+    }
+    case "complete":
+      return { ...state, active: false, complete: true };
+    case "failed":
+      return { ...state, active: false, failed: event.error };
+  }
+}
+
+export type BootView =
+  | { readonly kind: "ready" }
+  | {
+      readonly kind: "connecting";
+      readonly phase: IndusBootProgress["phase"];
+      readonly message: string;
+      readonly progress: number;
+    }
+  | { readonly kind: "install"; readonly installer: InstallerState; readonly message: string }
+  | { readonly kind: "first-run" }
+  | {
+      readonly kind: "failure";
+      readonly message: string;
+      readonly retryable: boolean;
+      readonly latched: boolean;
+    }
+  | { readonly kind: "reauth"; readonly message: string };
+
+export function bootView(progress: IndusBootProgress | null, installer: InstallerState): BootView {
+  if (progress === null) return { kind: "connecting", phase: "resolve", message: "", progress: 0 };
+  if (progress.phase === "ready") return { kind: "ready" };
+  if (progress.phase === "error") {
+    const message = progress.error ?? progress.message;
+    if (progress.statusCode === 401 || progress.statusCode === 403)
+      return { kind: "reauth", message };
+    return {
+      kind: "failure",
+      message,
+      retryable: progress.retryable === true,
+      latched: progress.latched === true,
+    };
+  }
+  if (installer.active) return { kind: "install", installer, message: progress.message };
+  if (progress.phase === "first-run") return { kind: "first-run" };
+  return {
+    kind: "connecting",
+    phase: progress.phase,
+    message: progress.message,
+    progress: progress.progress,
+  };
+}
diff --git a/apps/desktop/src/chat/ChatView.tsx b/apps/desktop/src/chat/ChatView.tsx
