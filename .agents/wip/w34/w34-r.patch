--- /dev/null
+++ b/apps/desktop/src/chat/ErrorCard.tsx
@@ -0,0 +1,69 @@
+// A failed turn: which layer broke, the failure sentence, and that layer's actions.
+
+import { AlertTriangle } from "lucide-react";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+import { type FailureAction, type FailureLayer, failureActions } from "./failure.ts";
+import type { ErrorItem } from "./messageStream.ts";
+
+const REASON_KEYS: Readonly<Record<string, MessageKey>> = {
+  max_iterations: "failure.reason.max_iterations",
+  budget_exhausted: "failure.reason.budget_exhausted",
+  invalid_tool_strikes: "failure.reason.invalid_tool_strikes",
+  compression_exhausted: "failure.reason.compression_exhausted",
+  guardrail_halt: "failure.reason.guardrail_halt",
+  persistence_failed: "failure.reason.persistence_failed",
+  provider_failed: "failure.reason.provider_failed",
+};
+
+const LAYER_KEYS: Readonly<Record<FailureLayer, MessageKey>> = {
+  provider: "failure.layer.provider",
+  endpoint: "failure.layer.endpoint",
+  streaming: "failure.layer.streaming",
+  auth: "failure.layer.auth",
+  daemon: "failure.layer.daemon",
+  runtime: "failure.layer.runtime",
+  disk: "failure.layer.disk",
+};
+
+const ACTION_KEYS: Readonly<Record<FailureAction, MessageKey>> = {
+  retry: "failure.action.retry",
+  "choose-model": "failure.action.choose-model",
+  "open-settings": "failure.action.open-settings",
+  "sign-in": "failure.action.sign-in",
+  reconnect: "failure.action.reconnect",
+  "open-logs": "failure.action.open-logs",
+  "new-session": "failure.action.new-session",
+};
+
+export function ErrorCard(props: {
+  item: ErrorItem;
+  onAction?: ((action: FailureAction, item: ErrorItem) => void) | undefined;
+}) {
+  const { item } = props;
+  const t = useT();
+  const text = item.message || t(REASON_KEYS[item.reason] ?? "failure.reason.default");
+  return (
+    <div className="error-card" role="alert" data-layer={item.layer}>
+      <AlertTriangle aria-hidden="true" size={16} className="error-icon" />
+      <div className="error-body">
+        <p className="error-title">{t(LAYER_KEYS[item.layer])}</p>
+        <p className="error-text">{text}</p>
+        {item.resetsAt !== null && (
+          <p className="error-text">{t("failure.resetsAt", { time: item.resetsAt })}</p>
+        )}
+        <div className="error-actions">
+          {failureActions(item.layer, item.retryable).map((action) => (
+            <button
+              key={action}
+              type="button"
+              className="button button-secondary"
+              onClick={() => props.onAction?.(action, item)}
+            >
+              {t(ACTION_KEYS[action])}
+            </button>
+          ))}
+        </div>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/Markdown.tsx b/apps/desktop/src/chat/Markdown.tsx
new file mode 100644
index 0000000..8138b22
--- /dev/null
+++ b/apps/desktop/src/chat/Markdown.tsx
@@ -0,0 +1,144 @@
+// Model text as React elements (no raw HTML). Links never navigate: a click asks main's audited
+// opener, which only opens http(s) after a real user click (D-16.20).
+
+import { Fragment, type ReactNode } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import { useT } from "../i18n/index.tsx";
+import { type Inline, parseBlocks, parseInline } from "./markdown.ts";
+import { CodeBlock, DiagramBlock, MathBlock } from "./RichBlocks.tsx";
+
+function openLink(url: string): void {
+  void desktopBridge()?.external.open({ url });
+}
+
+function Inlines(props: { runs: readonly Inline[] }) {
+  const t = useT();
+  return (
+    <>
+      {props.runs.map((run, index) => {
+        const key = `${run.type}-${index}`;
+        switch (run.type) {
+          case "text":
+            return <Fragment key={key}>{run.text}</Fragment>;
+          case "break":
+            return <br key={key} />;
+          case "code":
+            return <code key={key}>{run.text}</code>;
+          case "math":
+            return <MathBlock key={key} tex={run.tex} display={false} />;
+          case "strong":
+            return (
+              <strong key={key}>
+                <Inlines runs={run.children} />
+              </strong>
+            );
+          case "em":
+            return (
+              <em key={key}>
+                <Inlines runs={run.children} />
+              </em>
+            );
+          case "strike":
+            return (
+              <s key={key}>
+                <Inlines runs={run.children} />
+              </s>
+            );
+          case "link":
+            return (
+              <button
+                key={key}
+                type="button"
+                className="md-link"
+                title={t("link.open", { url: run.href })}
+                onClick={() => openLink(run.href)}
+              >
+                {run.text}
+              </button>
+            );
+        }
+        return null;
+      })}
+    </>
+  );
+}
+
+function inline(text: string): ReactNode {
+  return <Inlines runs={parseInline(text)} />;
+}
+
+export function Markdown(props: { text: string }) {
+  const blocks = parseBlocks(props.text);
+  return (
+    <div className="md">
+      {blocks.map((block, index) => {
+        const key = `${block.type}-${index}`;
+        switch (block.type) {
+          case "paragraph":
+            return <p key={key}>{inline(block.text)}</p>;
+          case "heading": {
+            const level = Math.min(6, Math.max(3, block.level + 2));
+            const Tag = `h${level}` as "h3" | "h4" | "h5" | "h6";
+            return <Tag key={key}>{inline(block.text)}</Tag>;
+          }
+          case "code":
+            return block.lang === "mermaid" ? (
+              <DiagramBlock key={key} source={block.code} closed={block.closed} />
+            ) : (
+              <CodeBlock key={key} code={block.code} lang={block.lang} closed={block.closed} />
+            );
+          case "math":
+            return <MathBlock key={key} tex={block.tex} display closed={block.closed} />;
+          case "list": {
+            const items = block.items.map((item, i) => (
+              // biome-ignore lint/suspicious/noArrayIndexKey: list items have no identity of their own
+              <li key={i}>{inline(item)}</li>
+            ));
+            return block.ordered ? (
+              <ol key={key} start={block.start}>
+                {items}
+              </ol>
+            ) : (
+              <ul key={key}>{items}</ul>
+            );
+          }
+          case "quote":
+            return (
+              <blockquote key={key}>
+                <Markdown text={block.text} />
+              </blockquote>
+            );
+          case "rule":
+            return <hr key={key} />;
+          case "table":
+            return (
+              <div key={key} className="md-table">
+                <table>
+                  <thead>
+                    <tr>
+                      {block.header.map((cell, i) => (
+                        // biome-ignore lint/suspicious/noArrayIndexKey: columns are positional
+                        <th key={i}>{inline(cell)}</th>
+                      ))}
+                    </tr>
+                  </thead>
+                  <tbody>
+                    {block.rows.map((row, r) => (
+                      // biome-ignore lint/suspicious/noArrayIndexKey: rows are positional
+                      <tr key={r}>
+                        {row.map((cell, c) => (
+                          // biome-ignore lint/suspicious/noArrayIndexKey: columns are positional
+                          <td key={c}>{inline(cell)}</td>
+                        ))}
+                      </tr>
+                    ))}
+                  </tbody>
+                </table>
+              </div>
+            );
+        }
+        return null;
+      })}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/RichBlocks.tsx b/apps/desktop/src/chat/RichBlocks.tsx
new file mode 100644
index 0000000..80d6c3e
--- /dev/null
+++ b/apps/desktop/src/chat/RichBlocks.tsx
@@ -0,0 +1,155 @@
+// Code highlighting (Shiki), math (KaTeX) and diagrams (Mermaid), each loaded on first use. Until
+// a renderer has loaded — or when it fails — the plain text shows, so nothing is ever blank.
+// Shiki runs on its JavaScript regex engine: the CSP allows no `wasm-unsafe-eval`. Mermaid runs
+// with `securityLevel: "strict"`. The HTML these libraries return is their own escaped output.
+
+import { useEffect, useId, useRef, useState } from "react";
+
+export interface RichLoaders {
+  highlight(code: string, lang: string): Promise<string | null>;
+  math(tex: string, display: boolean): Promise<string | null>;
+  diagram(id: string, source: string, dark: boolean): Promise<string | null>;
+}
+
+type ShikiHighlighter = {
+  getLoadedLanguages(): string[];
+  loadLanguage(...langs: string[]): Promise<void>;
+  codeToHtml(code: string, options: Record<string, unknown>): string;
+};
+
+let shiki: Promise<{ highlighter: ShikiHighlighter; known: Set<string> }> | null = null;
+
+function loadShiki() {
+  shiki ??= import("shiki").then(async (module) => {
+    const highlighter = (await module.createHighlighter({
+      themes: ["github-light", "github-dark"],
+      langs: [],
+      engine: module.createJavaScriptRegexEngine(),
+    })) as unknown as ShikiHighlighter;
+    return { highlighter, known: new Set(Object.keys(module.bundledLanguages)) };
+  });
+  return shiki;
+}
+
+let katexCss: Promise<unknown> | null = null;
+
+/** The real loaders; tests swap them with `setRichLoaders`. */
+export const defaultLoaders: RichLoaders = {
+  async highlight(code, lang) {
+    const { highlighter, known } = await loadShiki();
+    const language = known.has(lang) ? lang : "text";
+    if (language !== "text" && !highlighter.getLoadedLanguages().includes(language)) {
+      await highlighter.loadLanguage(language);
+    }
+    return highlighter.codeToHtml(code, {
+      lang: language,
+      themes: { light: "github-light", dark: "github-dark" },
+      defaultColor: false,
+    });
+  },
+  async math(tex, display) {
+    katexCss ??= import("katex/dist/katex.min.css");
+    const [{ default: katex }] = await Promise.all([import("katex"), katexCss]);
+    return katex.renderToString(tex, {
+      displayMode: display,
+      throwOnError: false,
+      trust: false,
+      strict: "ignore",
+    });
+  },
+  async diagram(id, source, dark) {
+    const { default: mermaid } = await import("mermaid");
+    mermaid.initialize({
+      startOnLoad: false,
+      securityLevel: "strict",
+      theme: dark ? "dark" : "default",
+    });
+    const { svg } = await mermaid.render(id, source);
+    return svg;
+  },
+};
+
+let loaders: RichLoaders = defaultLoaders;
+
+export function setRichLoaders(next: RichLoaders | null): void {
+  loaders = next ?? defaultLoaders;
+}
+
+/** Run `make` when `key` changes; the latest answer wins, a failure leaves the plain text. */
+function useRendered(key: string, make: (() => Promise<string | null>) | null): string | null {
+  const [html, setHtml] = useState<string | null>(null);
+  const maker = useRef(make);
+  maker.current = make;
+  useEffect(() => {
+    const run = maker.current;
+    if (run === null || key === "") return;
+    let live = true;
+    run().then(
+      (value) => {
+        if (live) setHtml(value);
+      },
+      () => {
+        if (live) setHtml(null);
+      },
+    );
+    return () => {
+      live = false;
+    };
+  }, [key]);
+  return html;
+}
+
+function isDark(): boolean {
+  return document.documentElement.dataset.theme === "indus-dark";
+}
+
+/** The one place library HTML enters the DOM: Shiki's escaped code, KaTeX with trust off,
+ * Mermaid's SVG in strict mode. */
+function LibraryHtml(props: { tag: "div" | "span"; className: string; html: string }) {
+  const Tag = props.tag;
+  // biome-ignore lint/security/noDangerouslySetInnerHtml: output of the libraries named above
+  return <Tag className={props.className} dangerouslySetInnerHTML={{ __html: props.html }} />;
+}
+
+export function CodeBlock(props: { code: string; lang: string; closed: boolean }) {
+  const { code, lang, closed } = props;
+  // Highlight once the fence is closed: a streaming block stays plain (no re-highlight per delta).
+  const html = useRendered(
+    closed ? `${lang}\u0000${code}` : "",
+    closed ? () => loaders.highlight(code, lang) : null,
+  );
+  if (html !== null) return <LibraryHtml tag="div" className="md-code" html={html} />;
+  return (
+    <pre className="md-code" data-lang={lang}>
+      <code>{code}</code>
+    </pre>
+  );
+}
+
+export function MathBlock(props: { tex: string; display: boolean; closed?: boolean }) {
+  const { tex, display, closed = true } = props;
+  const html = useRendered(
+    closed ? `${display}\u0000${tex}` : "",
+    closed ? () => loaders.math(tex, display) : null,
+  );
+  const className = display ? "md-math" : "md-math-inline";
+  if (html !== null)
+    return <LibraryHtml tag={display ? "div" : "span"} className={className} html={html} />;
+  const Tag = display ? "div" : "span";
+  return <Tag className={`${className} md-plain`}>{tex}</Tag>;
+}
+
+export function DiagramBlock(props: { source: string; closed: boolean }) {
+  const { source, closed } = props;
+  const id = `mmd-${useId().replace(/[^a-zA-Z0-9]/g, "")}`;
+  const html = useRendered(
+    closed ? source : "",
+    closed ? () => loaders.diagram(id, source, isDark()) : null,
+  );
+  if (html !== null) return <LibraryHtml tag="div" className="md-diagram" html={html} />;
+  return (
+    <pre className="md-code" data-lang="mermaid">
+      <code>{source}</code>
+    </pre>
+  );
+}
diff --git a/apps/desktop/src/chat/Timeline.tsx b/apps/desktop/src/chat/Timeline.tsx
new file mode 100644
index 0000000..4697f37
--- /dev/null
+++ b/apps/desktop/src/chat/Timeline.tsx
@@ -0,0 +1,32 @@
+// The timeline rail: one marker per prompt; a click jumps to that turn.
+
+import { useT } from "../i18n/index.tsx";
+import type { UserItem } from "./messageStream.ts";
+
+const LABEL_MAX = 60;
+
+function label(text: string): string {
+  const line = text.replace(/\s+/g, " ").trim();
+  return line.length > LABEL_MAX ? `${line.slice(0, LABEL_MAX - 1)}…` : line;
+}
+
+export function Timeline(props: { prompts: readonly UserItem[]; onJump: (key: string) => void }) {
+  const t = useT();
+  if (props.prompts.length < 2) return null;
+  return (
+    <nav className="timeline" aria-label={t("transcript.timeline")}>
+      <ol>
+        {props.prompts.map((prompt) => (
+          <li key={prompt.key}>
+            <button
+              type="button"
+              className="timeline-marker"
+              aria-label={t("transcript.jumpTo", { text: label(prompt.text) })}
+              onClick={() => props.onJump(prompt.key)}
+            />
+          </li>
+        ))}
+      </ol>
+    </nav>
+  );
+}
diff --git a/apps/desktop/src/chat/ToolRow.tsx b/apps/desktop/src/chat/ToolRow.tsx
new file mode 100644
index 0000000..39f1559
--- /dev/null
+++ b/apps/desktop/src/chat/ToolRow.tsx
@@ -0,0 +1,106 @@
+// One tool call: a summary line (verb + target, state, duration) that expands to its arguments,
+// output and images. Red only for an explicit failure (see toolOutcome).
+
+import { CheckCircle2, ChevronRight, CircleDashed, CircleSlash, XCircle } from "lucide-react";
+import { useState } from "react";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+import type { ToolPart } from "./messageStream.ts";
+import { type ToolVerb, toolImages, toolSummary } from "./toolSummary.ts";
+
+const OUTPUT_PREVIEW = 4_000;
+
+const VERB_KEYS: Readonly<Record<ToolVerb, MessageKey>> = {
+  run: "tool.verb.run",
+  read: "tool.verb.read",
+  write: "tool.verb.write",
+  edit: "tool.verb.edit",
+  search: "tool.verb.search",
+  fetch: "tool.verb.fetch",
+  use: "tool.verb.use",
+};
+
+const STATE_KEYS: Readonly<Record<ToolPart["state"], MessageKey>> = {
+  running: "tool.state.running",
+  ok: "tool.state.ok",
+  failed: "tool.state.failed",
+  neutral: "tool.state.neutral",
+};
+
+function StateIcon(props: { state: ToolPart["state"] }) {
+  switch (props.state) {
+    case "running":
+      return <CircleDashed aria-hidden="true" className="tool-icon tool-spin" size={14} />;
+    case "ok":
+      return <CheckCircle2 aria-hidden="true" className="tool-icon" size={14} />;
+    case "failed":
+      return <XCircle aria-hidden="true" className="tool-icon" size={14} />;
+    case "neutral":
+      return <CircleSlash aria-hidden="true" className="tool-icon" size={14} />;
+  }
+}
+
+export function ToolRow(props: { part: ToolPart }) {
+  const { part } = props;
+  const t = useT();
+  const [open, setOpen] = useState(false);
+  const [all, setAll] = useState(false);
+  const summary = toolSummary(part.name, part.args);
+  const result = part.result ?? "";
+  const images = open ? toolImages(part.result) : [];
+  const shown = all || result.length <= OUTPUT_PREVIEW ? result : result.slice(0, OUTPUT_PREVIEW);
+  return (
+    <div className="tool-row" data-state={part.state}>
+      <button
+        type="button"
+        className="tool-summary"
+        aria-expanded={open}
+        onClick={() => setOpen((value) => !value)}
+      >
+        <ChevronRight aria-hidden="true" size={14} className="tool-chevron" />
+        <StateIcon state={part.state} />
+        <span className="tool-verb">{t(VERB_KEYS[summary.verb], { name: part.name })}</span>
+        {summary.target !== "" && <code className="tool-target">{summary.target}</code>}
+        <span className="sr-only">{t(STATE_KEYS[part.state])}</span>
+        {part.state === "running" && part.progress !== null && (
+          <span className="tool-progress">{part.progress}</span>
+        )}
+        {part.durationMs !== null && part.state !== "running" && (
+          <span className="tool-duration">
+            {t("tool.duration", { seconds: (part.durationMs / 1000).toFixed(1) })}
+          </span>
+        )}
+      </button>
+      {open && (
+        <div className="tool-detail">
+          {part.args !== null && Object.keys(part.args).length > 0 && (
+            <section>
+              <h4>{t("tool.arguments")}</h4>
+              <pre>{JSON.stringify(part.args, null, 2)}</pre>
+            </section>
+          )}
+          <section>
+            <h4>{t("tool.output")}</h4>
+            {result === "" ? (
+              <p className="tool-empty">{t("tool.noOutput")}</p>
+            ) : (
+              <pre>{shown}</pre>
+            )}
+            {shown.length < result.length && (
+              <button type="button" className="text-button" onClick={() => setAll(true)}>
+                {t("tool.showAll")}
+              </button>
+            )}
+          </section>
+          {images.map((src) => (
+            <img
+              key={src}
+              src={src}
+              alt={t("tool.image", { name: part.name })}
+              className="tool-image"
+            />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/Transcript.test.tsx b/apps/desktop/src/chat/Transcript.test.tsx
new file mode 100644
index 0000000..bcdfba3
--- /dev/null
+++ b/apps/desktop/src/chat/Transcript.test.tsx
@@ -0,0 +1,231 @@
+// @vitest-environment jsdom
+import type { ClientEvent, Clock } from "@indus/client";
+import type { HistoryMessage } from "@indus/protocol";
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { setRichLoaders } from "./RichBlocks.tsx";
+import { resetReadingPositions, TRANSCRIPT_PAGE, Transcript } from "./Transcript.tsx";
+import { TranscriptStoreProvider } from "./transcriptReact.tsx";
+import { type TranscriptSource, TranscriptStore } from "./transcriptStore.ts";
+
+/** Timers fire at once: every notification is synchronous in these tests. */
+const immediate: Clock = {
+  now: () => 0,
+  setTimeout: (run) => {
+    run();
+    return 0;
+  },
+  clearTimeout: () => undefined,
+};
+
+function fakeSource(rows: HistoryMessage[]) {
+  const listeners = new Set<(event: ClientEvent) => void>();
+  let seq = 0;
+  const source: TranscriptSource & {
+    emit(event: Record<string, unknown>): void;
+    rows: HistoryMessage[];
+  } = {
+    rows,
+    onEvent: (listener) => {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    request: (async () => ({ messages: source.rows })) as unknown as TranscriptSource["request"],
+    watchSession: async () => undefined,
+    unwatchSession: () => undefined,
+    emit: (event) => {
+      seq += 1;
+      for (const listener of listeners) {
+        listener({ session_id: "s1", seq, ...event } as unknown as ClientEvent);
+      }
+    },
+  };
+  return source;
+}
+
+function conversation(turns: number): HistoryMessage[] {
+  const rows: HistoryMessage[] = [];
+  for (let i = 0; i < turns; i += 1) {
+    rows.push({ role: "user", text: `question ${i}`, row_id: i * 2 + 1 });
+    rows.push({ role: "assistant", text: `answer ${i}`, row_id: i * 2 + 2 });
+  }
+  return rows;
+}
+
+async function show(rows: HistoryMessage[], extra: Partial<Parameters<typeof Transcript>[0]> = {}) {
+  const source = fakeSource(rows);
+  const store = new TranscriptStore(source, { clock: immediate });
+  await act(async () => {
+    await store.open("s1");
+  });
+  const view = render(
+    <TranscriptStoreProvider store={store}>
+      <Transcript sessionId="s1" {...extra} />
+    </TranscriptStoreProvider>,
+  );
+  return { source, store, view };
+}
+
+function sizeScroller(scroller: HTMLElement, height: number, client: number) {
+  Object.defineProperty(scroller, "scrollHeight", { configurable: true, value: height });
+  Object.defineProperty(scroller, "clientHeight", { configurable: true, value: client });
+}
+
+beforeEach(() => {
+  resetReadingPositions();
+  setRichLoaders({
+    highlight: async () => null,
+    math: async () => null,
+    diagram: async () => null,
+  });
+});
+
+afterEach(() => {
+  setRichLoaders(null);
+  delete (globalThis as { indusDesktop?: unknown }).indusDesktop;
+});
+
+describe("Transcript", () => {
+  it("renders only a window of a 2,000-message session and pages older ones in", async () => {
+    const { view } = await show(conversation(1_000));
+    const rendered = () => view.container.querySelectorAll(".msg").length;
+    expect(rendered()).toBe(TRANSCRIPT_PAGE);
+    fireEvent.click(screen.getByRole("button", { name: "Show earlier messages" }));
+    expect(rendered()).toBe(TRANSCRIPT_PAGE * 2);
+    expect(screen.getByText("answer 999")).toBeTruthy();
+  });
+
+  it("the timeline has one marker per prompt and jumps outside the window", async () => {
+    const { view } = await show(conversation(100));
+    const markers = screen.getAllByRole("button", { name: /^Go to prompt:/ });
+    expect(markers).toHaveLength(100);
+    expect(view.container.querySelector('[data-key="row:1"]')).toBeNull();
+    fireEvent.click(markers[0] as HTMLElement);
+    expect(view.container.querySelector('[data-key="row:1"]')).not.toBeNull();
+  });
+
+  it("stops following when the reader scrolls up and resumes with Scroll to bottom", async () => {
+    const { view } = await show(conversation(3));
+    const scroller = view.container.querySelector(".transcript-scroll") as HTMLElement;
+    sizeScroller(scroller, 1_000, 100);
+    scroller.scrollTop = 200;
+    fireEvent.scroll(scroller);
+    const button = screen.getByRole("button", { name: "Scroll to bottom" });
+    fireEvent.click(button);
+    expect(scroller.scrollTop).toBe(1_000);
+    expect(screen.queryByRole("button", { name: "Scroll to bottom" })).toBeNull();
+  });
+
+  it("restores the reading position when the session is shown again", async () => {
+    const { store, view } = await show(conversation(3));
+    const scroller = view.container.querySelector(".transcript-scroll") as HTMLElement;
+    sizeScroller(scroller, 1_000, 100);
+    scroller.scrollTop = 300;
+    fireEvent.scroll(scroller);
+    view.unmount();
+    const again = render(
+      <TranscriptStoreProvider store={store}>
+        <Transcript sessionId="s1" />
+      </TranscriptStoreProvider>,
+    );
+    const next = again.container.querySelector(".transcript-scroll") as HTMLElement;
+    expect(next.scrollTop).toBe(300);
+    expect(screen.getByRole("button", { name: "Scroll to bottom" })).toBeTruthy();
+  });
+
+  it("streams deltas into one reply and shows reasoning only when enabled (live toggle)", async () => {
+    const { source, store, view } = await show([]);
+    act(() => {
+      source.emit({ type: "turn.started", turn_id: "t1", generation: 1 });
+      source.emit({ type: "reasoning.delta", turn_id: "t1", text: "pondering" });
+      source.emit({ type: "message.delta", turn_id: "t1", text: "Hello " });
+      source.emit({ type: "message.delta", turn_id: "t1", text: "there" });
+    });
+    expect(view.container.querySelectorAll(".msg-assistant")).toHaveLength(1);
+    expect(screen.getByText("Hello there")).toBeTruthy();
+    expect(screen.queryByText("Thinking")).toBeNull();
+    act(() => store.setShowReasoning(true));
+    expect(screen.getByText("Thinking")).toBeTruthy();
+    expect(screen.getByText("pondering")).toBeTruthy();
+    act(() => store.setShowReasoning(false));
+    expect(screen.queryByText("pondering")).toBeNull();
+  });
+
+  it("puts each prompt first in its turn (the sticky row)", async () => {
+    const { view } = await show(conversation(2));
+    const turns = view.container.querySelectorAll("section.turn");
+    expect(turns).toHaveLength(2);
+    expect(turns[0]?.firstElementChild?.classList.contains("msg-user")).toBe(true);
+  });
+
+  it("colours tool rows: red only for an explicit failure", async () => {
+    const { source, view } = await show([]);
+    act(() => {
+      source.emit({ type: "turn.started", turn_id: "t1", generation: 1 });
+      for (const [callId, result] of [
+        ["c1", "exit code 1"],
+        ["c2", "Error: permission denied"],
+      ] as const) {
+        source.emit({
+          type: "tool.started",
+          turn_id: "t1",
+          call_id: callId,
+          name: "terminal",
+          arguments: { command: "grep x" },
+        });
+        source.emit({
+          type: "tool.completed",
+          turn_id: "t1",
+          call_id: callId,
+          name: "terminal",
+          ok: false,
+          duration_ms: 5,
+          result,
+        });
+      }
+    });
+    const rows = [...view.container.querySelectorAll(".tool-row")].map((row) =>
+      row.getAttribute("data-state"),
+    );
+    expect(rows).toEqual(["neutral", "failed"]);
+    fireEvent.click(screen.getAllByRole("button", { name: /Ran/ })[0] as HTMLElement);
+    expect(screen.getByText("exit code 1")).toBeTruthy();
+  });
+
+  it("a failed turn ends in an error card whose actions are reported", async () => {
+    const onFailureAction = vi.fn();
+    const { source } = await show([], { onFailureAction });
+    act(() => {
+      source.emit({ type: "turn.started", turn_id: "t1", generation: 1 });
+      source.emit({
+        type: "turn.done",
+        turn_id: "t1",
+        reason: "provider_failed",
+        failure: { reason: "rate limit reached", retryable: true },
+      });
+    });
+    expect(screen.getByRole("alert").textContent).toContain("The model provider failed");
+    fireEvent.click(screen.getByRole("button", { name: "Retry" }));
+    expect(onFailureAction).toHaveBeenCalledWith(
+      "retry",
+      expect.objectContaining({ layer: "provider" }),
+    );
+  });
+
+  it("links never navigate: a click asks main's opener", async () => {
+    const open = vi.fn(async () => ({ ok: true }));
+    (globalThis as { indusDesktop?: unknown }).indusDesktop = { external: { open } };
+    const { view } = await show([
+      { role: "user", text: "where?", row_id: 1 },
+      {
+        role: "assistant",
+        text: "See [the docs](https://example.com/docs) or [this](file:///etc/passwd).",
+        row_id: 2,
+      },
+    ]);
+    expect(view.container.querySelector("a[href]")).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "the docs" }));
+    expect(open).toHaveBeenCalledWith({ url: "https://example.com/docs" });
+    expect(screen.queryByRole("button", { name: "this" })).toBeNull();
+  });
+});
diff --git a/apps/desktop/src/chat/Transcript.tsx b/apps/desktop/src/chat/Transcript.tsx
new file mode 100644
index 0000000..79c063f
--- /dev/null
+++ b/apps/desktop/src/chat/Transcript.tsx
@@ -0,0 +1,288 @@
+// The transcript of one session (P20-18). Only a window of the newest items is in the DOM; older
+// ones page in when the reader scrolls to the top (or presses "Show earlier"). While the reader
+// is at the bottom the view follows the stream; scrolling up stops following and shows "Scroll
+// to bottom". Each session's reading position is kept for when it is shown again.
+
+import { ArrowDown } from "lucide-react";
+import {
+  type ReactNode,
+  type UIEvent,
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+} from "react";
+import { Loader } from "../app/Loader.tsx";
+import { useT } from "../i18n/index.tsx";
+import { ErrorCard } from "./ErrorCard.tsx";
+import type { FailureAction } from "./failure.ts";
+import { Markdown } from "./Markdown.tsx";
+import type {
+  AssistantItem,
+  AsyncItem,
+  ErrorItem,
+  NoticeItem,
+  TranscriptItem,
+  UserItem,
+} from "./messageStream.ts";
+import { Timeline } from "./Timeline.tsx";
+import { ToolRow } from "./ToolRow.tsx";
+import { useShowReasoning, useTranscript } from "./transcriptReact.tsx";
+
+/** Items rendered at first, and added per page. */
+export const TRANSCRIPT_PAGE = 60;
+/** Within this many pixels of the end counts as "at the bottom". */
+const BOTTOM_SLACK = 32;
+/** Within this many pixels of the top pages older items in. */
+const TOP_SLACK = 48;
+
+interface ReadingPosition {
+  windowSize: number;
+  following: boolean;
+  scrollTop: number;
+}
+
+const positions = new Map<string, ReadingPosition>();
+
+/** Forget saved reading positions (tests). */
+export function resetReadingPositions(): void {
+  positions.clear();
+}
+
+export interface TranscriptProps {
+  sessionId: string;
+  onFailureAction?: (action: FailureAction, item: ErrorItem) => void;
+  /** Rendered after the last item, inside the scroll area (the card stack host). */
+  footer?: ReactNode;
+}
+
+function UserRow(props: { item: UserItem }) {
+  const t = useT();
+  return (
+    <div className="msg msg-user" data-key={props.item.key} data-persisted={props.item.persisted}>
+      <span className="sr-only">{t("transcript.you")}</span>
+      <div className="msg-bubble">{props.item.text}</div>
+    </div>
+  );
+}
+
+function AssistantRow(props: { item: AssistantItem; showReasoning: boolean }) {
+  const { item, showReasoning } = props;
+  const t = useT();
+  const lastTool = item.parts.findLastIndex((part) => part.type === "tool");
+  const visible = item.parts.filter((part) => part.type !== "reasoning" || showReasoning);
+  return (
+    <div className="msg msg-assistant" data-key={item.key} data-streaming={item.streaming}>
+      <span className="sr-only">{t("transcript.assistant")}</span>
+      {item.parts.map((part, index) => {
+        const key = part.type === "tool" ? `tool-${part.callId}` : `${part.type}-${index}`;
+        if (part.type === "tool") return <ToolRow key={key} part={part} />;
+        if (part.type === "reasoning") {
+          if (!showReasoning) return null;
+          return (
+            <details
+              key={key}
+              className="reasoning"
+              open={item.streaming && index === item.parts.length - 1}
+            >
+              <summary>{t("transcript.reasoning")}</summary>
+              <p>{part.text}</p>
+            </details>
+          );
+        }
+        return (
+          <div key={key} className={index < lastTool ? "msg-text msg-interim" : "msg-text"}>
+            <Markdown text={part.text} />
+          </div>
+        );
+      })}
+      {item.streaming && visible.length === 0 && <Loader size="sm" />}
+      {item.interrupted && <p className="msg-note">{t("transcript.interrupted")}</p>}
+    </div>
+  );
+}
+
+function AsyncRow(props: { item: AsyncItem }) {
+  const t = useT();
+  const title =
+    props.item.title === "review" ? t("transcript.async.review") : t("transcript.async.heartbeat");
+  return (
+    <details className="msg msg-async" data-key={props.item.key}>
+      <summary>{title}</summary>
+      <ul>
+        {props.item.lines.map((line, index) => (
+          // biome-ignore lint/suspicious/noArrayIndexKey: summary lines are positional
+          <li key={index}>{line}</li>
+        ))}
+      </ul>
+    </details>
+  );
+}
+
+function NoticeRow(props: { item: NoticeItem }) {
+  return (
+    <p className="msg msg-notice" data-level={props.item.level} data-key={props.item.key}>
+      {props.item.text}
+    </p>
+  );
+}
+
+function Row(props: {
+  item: TranscriptItem;
+  showReasoning: boolean;
+  onFailureAction?: ((action: FailureAction, item: ErrorItem) => void) | undefined;
+}) {
+  const { item } = props;
+  switch (item.kind) {
+    case "user":
+      return <UserRow item={item} />;
+    case "assistant":
+      return <AssistantRow item={item} showReasoning={props.showReasoning} />;
+    case "error":
+      return <ErrorCard item={item} onAction={props.onFailureAction} />;
+    case "async":
+      return <AsyncRow item={item} />;
+    case "notice":
+      return <NoticeRow item={item} />;
+  }
+}
+
+/** Group items into turns so the prompt row can stick to the top while its answer scrolls. */
+function turns(items: readonly TranscriptItem[]): TranscriptItem[][] {
+  const groups: TranscriptItem[][] = [];
+  for (const item of items) {
+    if (item.kind === "user" || groups.length === 0) groups.push([item]);
+    else groups[groups.length - 1]?.push(item);
+  }
+  return groups;
+}
+
+export function Transcript(props: TranscriptProps) {
+  const { sessionId } = props;
+  const t = useT();
+  const transcript = useTranscript(sessionId);
+  const showReasoning = useShowReasoning();
+  const saved = positions.get(sessionId);
+  const [windowSize, setWindowSize] = useState(saved?.windowSize ?? TRANSCRIPT_PAGE);
+  const [following, setFollowing] = useState(saved?.following ?? true);
+  const [jumpTo, setJumpTo] = useState<string | null>(null);
+  const scroller = useRef<HTMLDivElement>(null);
+  const keepOffset = useRef<number | null>(null);
+  const state = useRef({ windowSize, following, scrollTop: saved?.scrollTop ?? 0 });
+  state.current.windowSize = windowSize;
+  state.current.following = following;
+
+  const items = transcript.items;
+  const start = Math.max(0, items.length - windowSize);
+  const visible = items.slice(start);
+  const prompts = items.filter((item): item is UserItem => item.kind === "user");
+
+  // Restore this session's reading position once; save it when the view goes away.
+  // biome-ignore lint/correctness/useExhaustiveDependencies: restore on mount only
+  useLayoutEffect(() => {
+    const element = scroller.current;
+    if (element !== null && saved !== undefined && !saved.following) {
+      element.scrollTop = saved.scrollTop;
+    }
+    return () => {
+      positions.set(sessionId, { ...state.current });
+    };
+  }, [sessionId]);
+
+  // Follow the stream, or keep the reader's place when older items were paged in above.
+  useLayoutEffect(() => {
+    const element = scroller.current;
+    if (element === null) return;
+    if (keepOffset.current !== null) {
+      element.scrollTop = element.scrollHeight - keepOffset.current;
+      keepOffset.current = null;
+      return;
+    }
+    if (following) element.scrollTop = element.scrollHeight;
+  });
+
+  useEffect(() => {
+    if (jumpTo === null) return;
+    const rows = scroller.current?.querySelectorAll<HTMLElement>("[data-key]") ?? [];
+    const element = [...rows].find((row) => row.dataset.key === jumpTo);
+    if (element !== undefined) {
+      element.scrollIntoView({ block: "start" });
+      setJumpTo(null);
+    }
+  }, [jumpTo]);
+
+  const showEarlier = useCallback(() => {
+    const element = scroller.current;
+    if (element !== null) keepOffset.current = element.scrollHeight - element.scrollTop;
+    setWindowSize((size) => size + TRANSCRIPT_PAGE);
+  }, []);
+
+  const onScroll = (event: UIEvent<HTMLDivElement>) => {
+    const element = event.currentTarget;
+    state.current.scrollTop = element.scrollTop;
+    const atBottom =
+      element.scrollHeight - element.scrollTop - element.clientHeight <= BOTTOM_SLACK;
+    if (atBottom !== following) setFollowing(atBottom);
+    if (element.scrollTop <= TOP_SLACK && start > 0 && keepOffset.current === null) showEarlier();
+  };
+
+  const jump = (key: string) => {
+    const index = items.findIndex((item) => item.key === key);
+    if (index < 0) return;
+    if (index < start) setWindowSize(items.length - index);
+    setFollowing(false);
+    setJumpTo(key);
+  };
+
+  const toBottom = () => {
+    setFollowing(true);
+    const element = scroller.current;
+    if (element !== null) element.scrollTop = element.scrollHeight;
+  };
+
+  return (
+    <div className="transcript">
+      <div
+        ref={scroller}
+        className="transcript-scroll"
+        role="log"
+        aria-label={t("transcript.label")}
+        aria-live="polite"
+        aria-relevant="additions"
+        onScroll={onScroll}
+        tabIndex={-1}
+      >
+        {start > 0 && (
+          <button type="button" className="text-button transcript-earlier" onClick={showEarlier}>
+            {t("transcript.showEarlier")}
+          </button>
+        )}
+        {turns(visible).map((group) => (
+          <section key={group[0]?.key} className="turn">
+            {group.map((item) => (
+              <Row
+                key={item.key}
+                item={item}
+                showReasoning={showReasoning}
+                onFailureAction={props.onFailureAction}
+              />
+            ))}
+          </section>
+        ))}
+        {props.footer}
+      </div>
+      <Timeline prompts={prompts} onJump={jump} />
+      {!following && (
+        <button
+          type="button"
+          className="button button-floating transcript-bottom"
+          onClick={toBottom}
+        >
+          <ArrowDown aria-hidden="true" size={14} />
+          {t("transcript.scrollToBottom")}
+        </button>
+      )}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/failure.ts b/apps/desktop/src/chat/failure.ts
new file mode 100644
index 0000000..18b295e
--- /dev/null
+++ b/apps/desktop/src/chat/failure.ts
@@ -0,0 +1,88 @@
+// Which layer a failed turn broke in, and what the error card offers for it (P20-18). Our
+// protocol carries the turn's exit reason and a failure sentence, not a structured surface, so
+// the layer is read from both; the connection layer ("daemon") comes from the socket state.
+
+export const FAILURE_LAYERS = [
+  "provider",
+  "endpoint",
+  "streaming",
+  "auth",
+  "daemon",
+  "runtime",
+  "disk",
+] as const;
+
+export type FailureLayer = (typeof FAILURE_LAYERS)[number];
+
+export type FailureAction =
+  | "retry"
+  | "choose-model"
+  | "open-settings"
+  | "sign-in"
+  | "reconnect"
+  | "open-logs"
+  | "new-session";
+
+/** Exit reasons that end a turn without an answer even when no failure text came with them. */
+export const FAILED_EXITS: ReadonlySet<string> = new Set([
+  "budget_exhausted",
+  "max_iterations",
+  "invalid_tool_strikes",
+  "persistence_failed",
+  "provider_failed",
+  "compression_exhausted",
+  "guardrail_halt",
+]);
+
+const RULES: ReadonlyArray<readonly [FailureLayer, RegExp]> = [
+  [
+    "disk",
+    /\b(disk|no space|enospc|read-only file|quota exceeded on device|database is locked)\b/i,
+  ],
+  [
+    "auth",
+    /\b(401|403|unauthori[sz]ed|forbidden|api[ _-]?key|invalid key|credential|sign[ -]?in|oauth|token expired)\b/i,
+  ],
+  [
+    "streaming",
+    /\b(stream|connection reset|incomplete (read|chunked)|chunk|server-sent|unexpected eof)\b/i,
+  ],
+  [
+    "endpoint",
+    /\b(endpoint|base[ _]?url|404|dns|econnrefused|unreachable|name resolution|certificate|ssl|tls|timed out|timeout)\b/i,
+  ],
+  [
+    "provider",
+    /\b(rate[ -]?limit|429|overloaded|quota|model|provider|50[0-9]|bad gateway|service unavailable)\b/i,
+  ],
+  ["daemon", /\b(daemon|gateway|socket|disconnected)\b/i],
+];
+
+/** The layer for a turn's exit reason and failure text. */
+export function classifyFailure(reason: string, text: string): FailureLayer {
+  if (reason === "persistence_failed") return "disk";
+  for (const [layer, pattern] of RULES) if (pattern.test(text)) return layer;
+  if (reason === "provider_failed") return "provider";
+  return "runtime";
+}
+
+/** What the card offers, most useful first. */
+export function failureActions(layer: FailureLayer, retryable: boolean): FailureAction[] {
+  const retry: FailureAction[] = retryable ? ["retry"] : [];
+  switch (layer) {
+    case "provider":
+      return [...retry, "choose-model", "open-settings"];
+    case "endpoint":
+      return [...retry, "open-settings"];
+    case "streaming":
+      return ["retry"];
+    case "auth":
+      return ["sign-in", "open-settings"];
+    case "daemon":
+      return ["reconnect", "open-logs"];
+    case "disk":
+      return [...retry, "open-logs"];
+    case "runtime":
+      return [...retry, "open-logs", "new-session"];
+  }
+}
diff --git a/apps/desktop/src/chat/markdown.ts b/apps/desktop/src/chat/markdown.ts
new file mode 100644
index 0000000..6a175b3
--- /dev/null
+++ b/apps/desktop/src/chat/markdown.ts
@@ -0,0 +1,289 @@
+// A small Markdown reader for model replies (P20-18). It turns text into blocks and inline runs
+// that React renders as elements — never raw HTML. It is streaming-safe: an unclosed code fence
+// or math block is reported as open (`closed: false`) instead of falling back to plain text, so
+// the view does not flicker while a reply arrives.
+
+export type Block =
+  | { readonly type: "paragraph"; readonly text: string }
+  | { readonly type: "heading"; readonly level: number; readonly text: string }
+  | {
+      readonly type: "code";
+      readonly lang: string;
+      readonly code: string;
+      readonly closed: boolean;
+    }
+  | { readonly type: "math"; readonly tex: string; readonly closed: boolean }
+  | {
+      readonly type: "list";
+      readonly ordered: boolean;
+      readonly start: number;
+      readonly items: readonly string[];
+    }
+  | { readonly type: "quote"; readonly text: string }
+  | { readonly type: "rule" }
+  | {
+      readonly type: "table";
+      readonly header: readonly string[];
+      readonly rows: readonly (readonly string[])[];
+    };
+
+export type Inline =
+  | { readonly type: "text"; readonly text: string }
+  | { readonly type: "code"; readonly text: string }
+  | { readonly type: "math"; readonly tex: string }
+  | { readonly type: "strong"; readonly children: readonly Inline[] }
+  | { readonly type: "em"; readonly children: readonly Inline[] }
+  | { readonly type: "strike"; readonly children: readonly Inline[] }
+  | { readonly type: "link"; readonly text: string; readonly href: string }
+  | { readonly type: "break" };
+
+const FENCE = /^(\s{0,3})(`{3,}|~{3,})\s*([\w+#.-]*)/;
+const HEADING = /^\s{0,3}(#{1,6})\s+(.*?)\s*#*\s*$/;
+const RULE = /^\s{0,3}([-*_])(\s*\1){2,}\s*$/;
+const BULLET = /^\s{0,3}[-*+]\s+(.*)$/;
+const ORDERED = /^\s{0,3}(\d{1,9})[.)]\s+(.*)$/;
+const QUOTE = /^\s{0,3}>\s?(.*)$/;
+const TABLE_RULE = /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$/;
+
+/** A line of only the opening fence's character, at least as many of them. */
+function closesFence(line: string, marker: string): boolean {
+  const trimmed = line.trim();
+  const char = marker[0] ?? "`";
+  return trimmed.length >= marker.length && [...trimmed].every((c) => c === char);
+}
+
+function cells(line: string): string[] {
+  const trimmed = line.trim().replace(/^\|/, "").replace(/\|$/, "");
+  return trimmed.split("|").map((cell) => cell.trim());
+}
+
+function startsBlock(line: string, next: string | undefined): boolean {
+  return (
+    FENCE.test(line) ||
+    HEADING.test(line) ||
+    RULE.test(line) ||
+    BULLET.test(line) ||
+    ORDERED.test(line) ||
+    QUOTE.test(line) ||
+    line.trim().startsWith("$$") ||
+    (line.includes("|") && next !== undefined && TABLE_RULE.test(next))
+  );
+}
+
+export function parseBlocks(source: string): Block[] {
+  const lines = source.replace(/\r\n?/g, "\n").split("\n");
+  const blocks: Block[] = [];
+  let i = 0;
+  while (i < lines.length) {
+    const line = lines[i] ?? "";
+    if (line.trim() === "") {
+      i += 1;
+      continue;
+    }
+    const fence = FENCE.exec(line);
+    if (fence) {
+      const marker = fence[2] ?? "```";
+      const lang = (fence[3] ?? "").toLowerCase();
+      const body: string[] = [];
+      i += 1;
+      let closed = false;
+      while (i < lines.length) {
+        const current = lines[i] ?? "";
+        if (closesFence(current, marker)) {
+          closed = true;
+          i += 1;
+          break;
+        }
+        body.push(current);
+        i += 1;
+      }
+      blocks.push({ type: "code", lang, code: body.join("\n"), closed });
+      continue;
+    }
+    if (line.trim().startsWith("$$")) {
+      const first = line.trim().slice(2);
+      if (first.endsWith("$$") && first.length >= 2) {
+        blocks.push({ type: "math", tex: first.slice(0, -2).trim(), closed: true });
+        i += 1;
+        continue;
+      }
+      const body: string[] = first === "" ? [] : [first];
+      i += 1;
+      let closed = false;
+      while (i < lines.length) {
+        const current = lines[i] ?? "";
+        if (current.trim().endsWith("$$")) {
+          const rest = current.trim().slice(0, -2);
+          if (rest !== "") body.push(rest);
+          closed = true;
+          i += 1;
+          break;
+        }
+        body.push(current);
+        i += 1;
+      }
+      blocks.push({ type: "math", tex: body.join("\n").trim(), closed });
+      continue;
+    }
+    const heading = HEADING.exec(line);
+    if (heading) {
+      blocks.push({ type: "heading", level: heading[1]?.length ?? 1, text: heading[2] ?? "" });
+      i += 1;
+      continue;
+    }
+    if (RULE.test(line)) {
+      blocks.push({ type: "rule" });
+      i += 1;
+      continue;
+    }
+    if (line.includes("|") && TABLE_RULE.test(lines[i + 1] ?? "")) {
+      const header = cells(line);
+      const rows: string[][] = [];
+      i += 2;
+      while (i < lines.length && (lines[i] ?? "").includes("|") && (lines[i] ?? "").trim() !== "") {
+        rows.push(cells(lines[i] ?? ""));
+        i += 1;
+      }
+      blocks.push({ type: "table", header, rows });
+      continue;
+    }
+    if (QUOTE.test(line)) {
+      const body: string[] = [];
+      while (i < lines.length) {
+        const match = QUOTE.exec(lines[i] ?? "");
+        if (!match) break;
+        body.push(match[1] ?? "");
+        i += 1;
+      }
+      blocks.push({ type: "quote", text: body.join("\n") });
+      continue;
+    }
+    const bullet = BULLET.exec(line);
+    const ordered = ORDERED.exec(line);
+    if (bullet || ordered) {
+      const isOrdered = ordered !== null;
+      const pattern = isOrdered ? ORDERED : BULLET;
+      const items: string[] = [];
+      const start = isOrdered ? Number(ordered?.[1] ?? 1) : 1;
+      while (i < lines.length) {
+        const current = lines[i] ?? "";
+        const match = pattern.exec(current);
+        if (match) {
+          items.push((isOrdered ? match[2] : match[1]) ?? "");
+          i += 1;
+          continue;
+        }
+        // An indented continuation line belongs to the item above.
+        if (current.trim() !== "" && /^\s{2,}/.test(current) && items.length > 0) {
+          items[items.length - 1] = `${items[items.length - 1]}\n${current.trim()}`;
+          i += 1;
+          continue;
+        }
+        break;
+      }
+      blocks.push({ type: "list", ordered: isOrdered, start, items });
+      continue;
+    }
+    const body: string[] = [line];
+    i += 1;
+    while (i < lines.length) {
+      const current = lines[i] ?? "";
+      if (current.trim() === "" || startsBlock(current, lines[i + 1])) break;
+      body.push(current);
+      i += 1;
+    }
+    blocks.push({ type: "paragraph", text: body.join("\n") });
+  }
+  return blocks;
+}
+
+const SAFE_LINK = /^https?:\/\//i;
+
+/** Inline runs of one block's text. */
+export function parseInline(source: string): Inline[] {
+  const out: Inline[] = [];
+  let text = "";
+  const flush = (): void => {
+    if (text !== "") out.push({ type: "text", text });
+    text = "";
+  };
+  let i = 0;
+  while (i < source.length) {
+    const rest = source.slice(i);
+    const ch = source[i] ?? "";
+    if (
+      ch === "\\" &&
+      i + 1 < source.length &&
+      /[\\`*_{}[\]()#+\-.!$~|>]/.test(source[i + 1] ?? "")
+    ) {
+      text += source[i + 1];
+      i += 2;
+      continue;
+    }
+    if (ch === "\n") {
+      flush();
+      out.push({ type: "break" });
+      i += 1;
+      continue;
+    }
+    if (ch === "`") {
+      const ticks = /^`+/.exec(rest)?.[0] ?? "`";
+      const end = source.indexOf(ticks, i + ticks.length);
+      if (end > 0) {
+        flush();
+        out.push({ type: "code", text: source.slice(i + ticks.length, end).trim() });
+        i = end + ticks.length;
+        continue;
+      }
+    }
+    if (ch === "$" && source[i + 1] !== "$" && source[i + 1] !== " ") {
+      const end = source.indexOf("$", i + 1);
+      if (end > i + 1 && source[end - 1] !== " " && !/\d/.test(source[end + 1] ?? "")) {
+        flush();
+        out.push({ type: "math", tex: source.slice(i + 1, end) });
+        i = end + 1;
+        continue;
+      }
+    }
+    if (ch === "[") {
+      const link = /^\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/.exec(rest);
+      if (link) {
+        flush();
+        const href = link[2] ?? "";
+        const label = link[1] || href;
+        out.push(
+          SAFE_LINK.test(href)
+            ? { type: "link", text: label, href }
+            : { type: "text", text: label },
+        );
+        i += link[0].length;
+        continue;
+      }
+    }
+    const strong = /^(\*\*|__)(?=\S)([\s\S]*?\S)\1/.exec(rest);
+    if (strong) {
+      flush();
+      out.push({ type: "strong", children: parseInline(strong[2] ?? "") });
+      i += strong[0].length;
+      continue;
+    }
+    const strike = /^~~(?=\S)([\s\S]*?\S)~~/.exec(rest);
+    if (strike) {
+      flush();
+      out.push({ type: "strike", children: parseInline(strike[1] ?? "") });
+      i += strike[0].length;
+      continue;
+    }
+    const em = /^(\*|_)(?=\S)([\s\S]*?\S)\1(?![*_\w])/.exec(rest);
+    if (em && (ch === "*" || i === 0 || !/\w/.test(source[i - 1] ?? ""))) {
+      flush();
+      out.push({ type: "em", children: parseInline(em[2] ?? "") });
+      i += em[0].length;
+      continue;
+    }
+    text += ch;
+    i += 1;
+  }
+  flush();
+  return out;
+}
diff --git a/apps/desktop/src/chat/messageStream.test.ts b/apps/desktop/src/chat/messageStream.test.ts
