--- /dev/null
+++ b/apps/desktop/src/chat/transcriptReact.tsx
@@ -0,0 +1,33 @@
+// React access to the transcript store (one per connection, provided at the root).
+
+import { createContext, type ReactNode, useContext, useSyncExternalStore } from "react";
+import type { SessionTranscript } from "./messageStream.ts";
+import type { TranscriptStore } from "./transcriptStore.ts";
+
+const StoreContext = createContext<TranscriptStore | null>(null);
+
+export function TranscriptStoreProvider(props: { store: TranscriptStore; children: ReactNode }) {
+  return <StoreContext.Provider value={props.store}>{props.children}</StoreContext.Provider>;
+}
+
+export function useTranscriptStore(): TranscriptStore {
+  const store = useContext(StoreContext);
+  if (store === null) throw new Error("useTranscriptStore outside TranscriptStoreProvider");
+  return store;
+}
+
+export function useTranscript(sessionId: string): SessionTranscript {
+  const store = useTranscriptStore();
+  return useSyncExternalStore(
+    (listener) => store.subscribe(sessionId, listener),
+    () => store.get(sessionId),
+  );
+}
+
+export function useShowReasoning(): boolean {
+  const store = useTranscriptStore();
+  return useSyncExternalStore(
+    (listener) => store.subscribeSettings(listener),
+    () => store.showReasoning,
+  );
+}
diff --git a/apps/desktop/src/chat/transcriptStore.ts b/apps/desktop/src/chat/transcriptStore.ts
new file mode 100644
index 0000000..a949e24
--- /dev/null
+++ b/apps/desktop/src/chat/transcriptStore.ts
@@ -0,0 +1,183 @@
+// Per-session transcripts of one connection (P20-18). Events are applied as they arrive;
+// listeners hear about them in batches (every 33 ms) so a fast stream does not render per delta.
+// Local actions (a submitted row) notify at once. History loads are generation-fenced: a load
+// that was asked earlier but answers later than a newer one is ignored (R08.19).
+
+import { type ClientEvent, type Clock, systemClock } from "@indus/client";
+import type { GatewayConnection } from "../gateway/connectionStore.ts";
+import {
+  addLocalUser,
+  applyEvent,
+  applyHistory,
+  bindLocalUser,
+  dropLocalUser,
+  emptyTranscript,
+  type SessionTranscript,
+} from "./messageStream.ts";
+
+export const TRANSCRIPT_FLUSH_MS = 33;
+
+interface Entry {
+  state: SessionTranscript;
+  listeners: Set<() => void>;
+  opened: number;
+  flushTimer: unknown;
+  hydrating: boolean;
+}
+
+export interface TranscriptStoreOptions {
+  clock?: Clock;
+  flushMs?: number;
+}
+
+/** The part of a connection the store uses (tests pass a fake). */
+export type TranscriptSource = Pick<
+  GatewayConnection,
+  "onEvent" | "request" | "watchSession" | "unwatchSession"
+>;
+
+export class TranscriptStore {
+  private readonly connection: TranscriptSource;
+  private readonly clock: Clock;
+  private readonly flushMs: number;
+  private readonly entries = new Map<string, Entry>();
+  private readonly settingsListeners = new Set<() => void>();
+  private historySerial = 0;
+  private localSerial = 0;
+  private reasoning = false;
+  private readonly unsubscribe: () => void;
+
+  constructor(connection: TranscriptSource, options: TranscriptStoreOptions = {}) {
+    this.connection = connection;
+    this.clock = options.clock ?? systemClock;
+    this.flushMs = options.flushMs ?? TRANSCRIPT_FLUSH_MS;
+    this.unsubscribe = connection.onEvent((event) => this.onEvent(event));
+  }
+
+  get(sessionId: string): SessionTranscript {
+    return this.entry(sessionId).state;
+  }
+
+  subscribe(sessionId: string, listener: () => void): () => void {
+    const entry = this.entry(sessionId);
+    entry.listeners.add(listener);
+    return () => {
+      entry.listeners.delete(listener);
+    };
+  }
+
+  /** Show a session: watch its events (kept across reconnects) and load its history. */
+  async open(sessionId: string): Promise<void> {
+    const entry = this.entry(sessionId);
+    entry.opened += 1;
+    if (entry.opened > 1) return;
+    await Promise.allSettled([this.connection.watchSession(sessionId), this.hydrate(sessionId)]);
+  }
+
+  close(sessionId: string): void {
+    const entry = this.entries.get(sessionId);
+    if (entry === undefined || entry.opened === 0) return;
+    entry.opened -= 1;
+    if (entry.opened === 0) this.connection.unwatchSession(sessionId);
+  }
+
+  /** Load the stored conversation; older loads that answer late change nothing. */
+  async hydrate(sessionId: string): Promise<void> {
+    const entry = this.entry(sessionId);
+    this.historySerial += 1;
+    const generation = this.historySerial;
+    entry.hydrating = true;
+    try {
+      const result = await this.connection.request("session.history", { session_id: sessionId });
+      this.set(sessionId, applyHistory(entry.state, result.messages, generation), true);
+    } finally {
+      if (generation === this.historySerial) entry.hydrating = false;
+    }
+  }
+
+  /** The optimistic row for a prompt being submitted; returns its local id. */
+  addLocalUser(sessionId: string, text: string): string {
+    this.localSerial += 1;
+    const localId = `l${this.localSerial}`;
+    this.set(sessionId, addLocalUser(this.entry(sessionId).state, localId, text), true);
+    return localId;
+  }
+
+  bindLocalUser(sessionId: string, localId: string, turnId: string): void {
+    this.set(sessionId, bindLocalUser(this.entry(sessionId).state, localId, turnId), true);
+  }
+
+  dropLocalUser(sessionId: string, localId: string): void {
+    this.set(sessionId, dropLocalUser(this.entry(sessionId).state, localId), true);
+  }
+
+  get showReasoning(): boolean {
+    return this.reasoning;
+  }
+
+  /** `display.show_reasoning`, toggled live. */
+  setShowReasoning(show: boolean): void {
+    if (this.reasoning === show) return;
+    this.reasoning = show;
+    for (const listener of [...this.settingsListeners]) listener();
+  }
+
+  subscribeSettings(listener: () => void): () => void {
+    this.settingsListeners.add(listener);
+    return () => {
+      this.settingsListeners.delete(listener);
+    };
+  }
+
+  dispose(): void {
+    this.unsubscribe();
+    for (const entry of this.entries.values()) {
+      if (entry.flushTimer !== undefined) this.clock.clearTimeout(entry.flushTimer);
+    }
+  }
+
+  private onEvent(event: ClientEvent): void {
+    const sessionId = (event as { session_id?: unknown }).session_id;
+    if (typeof sessionId !== "string") return;
+    const entry = this.entries.get(sessionId);
+    if (entry === undefined) return;
+    const next = applyEvent(entry.state, event);
+    if (next === entry.state) return;
+    this.set(sessionId, next, false);
+    if (next.needsSnapshot && !entry.hydrating) void this.hydrate(sessionId).catch(() => undefined);
+  }
+
+  private entry(sessionId: string): Entry {
+    let entry = this.entries.get(sessionId);
+    if (entry === undefined) {
+      entry = {
+        state: emptyTranscript(sessionId),
+        listeners: new Set(),
+        opened: 0,
+        flushTimer: undefined,
+        hydrating: false,
+      };
+      this.entries.set(sessionId, entry);
+    }
+    return entry;
+  }
+
+  private set(sessionId: string, state: SessionTranscript, now: boolean): void {
+    const entry = this.entry(sessionId);
+    if (state === entry.state) return;
+    entry.state = state;
+    if (now) {
+      this.flush(entry);
+      return;
+    }
+    if (entry.flushTimer === undefined) {
+      entry.flushTimer = this.clock.setTimeout(() => this.flush(entry), this.flushMs);
+    }
+  }
+
+  private flush(entry: Entry): void {
+    if (entry.flushTimer !== undefined) this.clock.clearTimeout(entry.flushTimer);
+    entry.flushTimer = undefined;
+    for (const listener of [...entry.listeners]) listener();
+  }
+}
diff --git a/apps/desktop/src/gateway/connectionStore.test.ts b/apps/desktop/src/gateway/connectionStore.test.ts
new file mode 100644
index 0000000..cbfa3d4
--- /dev/null
+++ b/apps/desktop/src/gateway/connectionStore.test.ts
@@ -0,0 +1,361 @@
+import type { ClientEvent } from "@indus/client";
+import { describe, expect, it } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import { ConnectionStore } from "./connectionStore.ts";
+import { descriptor, EPOCH, harness, settle } from "./testSupport.ts";
+import {
+  RECONNECT_CAP_MS,
+  RECONNECT_RESET_AFTER_OPEN_MS,
+  RECONNECT_WARNING_AFTER_MS,
+  RPC_STARTUP_TIMEOUT_MS,
+  TURN_WATCHDOG_SILENCE_MS,
+} from "./timing.ts";
+
+function seqs(events: ClientEvent[]): number[] {
+  return events
+    .map((event) => (event as { seq?: unknown }).seq)
+    .filter((seq): seq is number => typeof seq === "number");
+}
+
+describe("GatewayConnection", () => {
+  it("dials with a fresh single-use ticket offered only as a subprotocol", async () => {
+    const h = harness();
+    h.connection.start();
+    await settle();
+    expect(h.dials).toHaveLength(1);
+    const dial = h.dials[0];
+    expect(dial?.url).toBe("ws://127.0.0.1:4100/ws");
+    expect(dial?.url).not.toContain("tk1");
+    expect(dial?.protocols).toEqual(["indus-gateway-v1", "indus-gateway-ticket.tk1"]);
+    h.ready(["request.decline"]);
+    await settle();
+    const state = h.connection.getState();
+    expect(state.phase).toBe("open");
+    expect(state.ready).toBe(true);
+    expect(state.countsDeclines).toBe(true);
+    expect(JSON.stringify(state)).not.toContain("tk1");
+  });
+
+  it("after a drop, resubscribes since the cursor and passes each event on once", async () => {
+    const h = harness();
+    const seen: ClientEvent[] = [];
+    h.connection.onSessionEvent("s1", (event) => seen.push(event));
+    h.connection.start();
+    await settle();
+    h.ready();
+    await settle();
+    await h.connection.watchSession("s1");
+    for (const text of ["a", "b", "c"])
+      h.emit("s1", { type: "message.delta", turn_id: "t1", text });
+    await settle();
+    expect(seqs(seen)).toEqual([1, 2, 3]);
+
+    h.server.die("cut");
+    await settle();
+    expect(h.connection.getState().phase).toBe("reconnecting");
+    // Missed while the link was down.
+    h.emit("s1", { type: "message.delta", turn_id: "t1", text: "d" });
+    h.emit("s1", { type: "message.delta", turn_id: "t1", text: "e" });
+    await h.advance(RECONNECT_CAP_MS);
+    expect(h.dials).toHaveLength(2);
+    expect(h.dials[1]?.protocols[1]).toBe("indus-gateway-ticket.tk2");
+    h.ready();
+    await settle();
+    const subscribes = h.server.calls("session.subscribe");
+    expect(subscribes.at(-1)?.params).toEqual({ session_id: "s1", epoch: EPOCH, cursor: 3 });
+    expect(seqs(seen)).toEqual([1, 2, 3, 4, 5]);
+    // A second replay of the same window adds nothing.
+    for (const event of h.log.get("s1") ?? []) {
+      h.server.sendRaw({ jsonrpc: "2.0", method: String(event.type), params: event });
+    }
+    await settle();
+    expect(seqs(seen)).toEqual([1, 2, 3, 4, 5]);
+  });
+
+  it("resets the ladder only after a socket stayed open 5 s", async () => {
+    const h = harness({ random: () => 0.999 });
+    h.connection.start();
+    await settle();
+    // Three flaps: open, ready, drop at once.
+    for (let i = 0; i < 3; i += 1) {
+      h.ready();
+      await settle();
+      h.server.die("flap");
+      await settle();
+      await h.advance(RECONNECT_CAP_MS);
+    }
+    expect(h.connection.getState().attempt).toBe(3);
+    h.ready();
+    await settle();
+    await h.advance(RECONNECT_RESET_AFTER_OPEN_MS - 1);
+    expect(h.connection.getState().attempt).toBe(3);
+    await h.advance(1);
+    expect(h.connection.getState().attempt).toBe(0);
+    expect(h.connection.getState().failingSince).toBeNull();
+  });
+
+  it("backs off with full jitter inside [0, min(cap, 300·2^(n−1)))", async () => {
+    const h = harness({ random: () => 0.999 });
+    h.connection.start();
+    await settle();
+    const delays: number[] = [];
+    for (let attempt = 1; attempt <= 8; attempt += 1) {
+      h.server.die("down");
+      await settle();
+      const before = h.dials.length;
+      const step = Math.min(RECONNECT_CAP_MS, 300 * 2 ** (attempt - 1));
+      await h.advance(Math.floor(0.999 * step) - 1);
+      expect(h.dials.length).toBe(before);
+      await h.advance(1);
+      expect(h.dials.length).toBe(before + 1);
+      delays.push(step);
+    }
+    expect(delays.at(-1)).toBe(RECONNECT_CAP_MS);
+  });
+
+  it("raises the warning only after 300 s of continuous failure", async () => {
+    const h = harness();
+    h.failTickets = 10_000;
+    h.connection.start();
+    await settle();
+    expect(h.connection.getState().attempt).toBe(1);
+    await h.advance(RECONNECT_WARNING_AFTER_MS - 1_000);
+    expect(h.connection.getState().warning).toBe(false);
+    await h.advance(1_000);
+    expect(h.connection.getState().warning).toBe(true);
+    expect(h.connection.getState().phase).toBe("connecting");
+    h.failTickets = 0;
+    await h.advance(RECONNECT_CAP_MS);
+    h.ready();
+    await settle();
+    expect(h.connection.getState().warning).toBe(true);
+    await h.advance(RECONNECT_RESET_AFTER_OPEN_MS);
+    expect(h.connection.getState().warning).toBe(false);
+  });
+
+  it("closes a link that never gets ready within the startup deadline", async () => {
+    const h = harness();
+    h.connection.start();
+    await settle();
+    await h.advance(RPC_STARTUP_TIMEOUT_MS);
+    expect(h.connection.getState().attempt).toBe(1);
+    expect(h.connection.getState().lastError).toBeTruthy();
+  });
+
+  it("drops a replay result that belongs to an older connection", async () => {
+    const h = harness();
