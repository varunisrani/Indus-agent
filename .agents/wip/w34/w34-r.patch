@@ -0,0 +1,229 @@
+// @vitest-environment jsdom
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter, useLocation } from "react-router";
+import { describe, expect, it, vi } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import { seeded } from "../../testing/seeded.ts";
+import type { IndusBootProgress, IndusInstallerEvent } from "../global.d.ts";
+import { type BackendNotice, type BootBridge, BootOverlay } from "./BootOverlay.tsx";
+import { BOOT_RETRY_CAP_MS, BOOT_RETRY_MAX_ATTEMPTS } from "./bootRetry.ts";
+
+function progress(phase: IndusBootProgress["phase"], extra: Partial<IndusBootProgress> = {}) {
+  return { phase, message: "", progress: 0.5, running: true, ...extra } as IndusBootProgress;
+}
+
+function fakeBoot(initial: IndusBootProgress) {
+  let onProgress: ((p: IndusBootProgress) => void) | null = null;
+  let onInstaller: ((e: IndusInstallerEvent) => void) | null = null;
+  const bridge = {
+    get: vi.fn(async () => initial),
+    onProgress: (listener: (p: IndusBootProgress) => void) => {
+      onProgress = listener;
+      return () => undefined;
+    },
+    onInstaller: (listener: (e: IndusInstallerEvent) => void) => {
+      onInstaller = listener;
+      return () => undefined;
+    },
+    retry: vi.fn(async () => ({ accepted: true })),
+    choose: vi.fn(async () => ({ accepted: true })),
+    cancelInstall: vi.fn(async () => ({ accepted: true })),
+  };
+  return {
+    bridge: bridge as unknown as BootBridge & typeof bridge,
+    push: (p: IndusBootProgress) => act(() => onProgress?.(p)),
+    install: (e: IndusInstallerEvent) => act(() => onInstaller?.(e)),
+  };
+}
+
+function Where() {
+  return <span data-testid="where">{useLocation().pathname}</span>;
+}
+
+async function mount(initial: IndusBootProgress, options: { timers?: FakeTimers } = {}) {
+  const boot = fakeBoot(initial);
+  const onReady = vi.fn();
+  const timers = options.timers ?? new FakeTimers();
+  const clock = {
+    now: () => timers.now,
+    setTimeout: (run: () => void, ms: number) => timers.setTimeout(run, ms),
+    clearTimeout: (handle: unknown) => timers.clearTimeout(handle),
+  };
+  const random = seeded(3);
+  render(
+    <MemoryRouter initialEntries={["/"]}>
+      <BootOverlay bridge={boot.bridge} onReady={onReady} clock={clock} random={random} />
+      <Where />
+    </MemoryRouter>,
+  );
+  await act(async () => {
+    await Promise.resolve();
+  });
+  return { ...boot, onReady, timers };
+}
+
+describe("BootOverlay", () => {
+  it.each([
+    ["resolve", "Looking for Indus on this computer"],
+    ["runtime", "Starting Indus"],
+    ["remote-connect", "Connecting to your Indus"],
+    ["update-wait", "Waiting for an update to finish"],
+  ] as const)("renders the %s phase", async (phase, text) => {
+    await mount(progress(phase));
+    expect(screen.getByRole("heading", { name: text })).toBeTruthy();
+    expect(screen.getByRole("dialog")).toBeTruthy();
+  });
+
+  it("goes away at ready and reports it once", async () => {
+    const boot = await mount(progress("runtime"));
+    boot.push(progress("ready", { running: false }));
+    expect(screen.queryByRole("dialog")).toBeNull();
+    boot.push(progress("ready", { running: false, message: "again" }));
+    expect(boot.onReady).toHaveBeenCalledTimes(1);
+  });
+
+  it("shows the installer's stages and the log tail", async () => {
+    const boot = await mount(progress("runtime"));
+    boot.install({
+      type: "manifest",
+      stages: [
+        { name: "python", title: "Python runtime", category: "core", needsUserInput: false },
+        { name: "indus", title: "Indus package", category: "core", needsUserInput: false },
+      ],
+    });
+    boot.install({ type: "stage", name: "python", state: "succeeded" });
+    boot.install({ type: "stage", name: "indus", state: "running" });
+    for (let i = 0; i < 20; i += 1)
+      boot.install({ type: "log", line: `line ${i}`, stream: "stdout" });
+    expect(screen.getByRole("heading", { name: "Installing Indus" })).toBeTruthy();
+    const stages = screen.getAllByRole("listitem");
+    expect(stages.map((li) => li.getAttribute("data-state"))).toEqual(["succeeded", "running"]);
+    expect(screen.getByText(/line 19/)).toBeTruthy();
+    expect(screen.queryByText(/line 7$/m)).toBeNull();
+    fireEvent.keyDown(screen.getByRole("dialog"), { key: "Escape" });
+    expect(screen.getByRole("heading", { name: "Installing Indus" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Cancel install" }));
+    expect(boot.bridge.cancelInstall).toHaveBeenCalledTimes(1);
+  });
+
+  it("first run offers both choices, ignores Escape and sends the choice", async () => {
+    const boot = await mount(progress("first-run"));
+    fireEvent.keyDown(screen.getByRole("dialog"), { key: "Escape" });
+    expect(screen.getByRole("heading", { name: "How do you want to use Indus?" })).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: /Install on this computer/ }));
+    expect(boot.bridge.choose).toHaveBeenCalledWith({ choice: "install-local" });
+    expect(screen.getByRole("button", { name: /Connect to an existing Indus/ })).toBeTruthy();
+  });
+
+  it("retries a retryable failure itself, at most five times, then shows the overlay", async () => {
+    const failure = progress("error", { error: "dial failed", retryable: true, running: false });
+    const boot = await mount(failure);
+    for (let attempt = 1; attempt <= BOOT_RETRY_MAX_ATTEMPTS; attempt += 1) {
+      expect(screen.queryByRole("heading", { name: "Indus could not start" })).toBeNull();
+      expect(screen.getByText(new RegExp(`attempt ${attempt} of 5`))).toBeTruthy();
+      act(() => boot.timers.advance(BOOT_RETRY_CAP_MS));
+      await act(async () => {
+        await Promise.resolve();
+      });
+      expect(boot.bridge.retry).toHaveBeenCalledTimes(attempt);
+      // Main reports the same failure again after each attempt.
+      boot.push({ ...failure, message: `after ${attempt}` });
+    }
+    expect(screen.getByRole("heading", { name: "Indus could not start" })).toBeTruthy();
+    act(() => boot.timers.advance(10 * BOOT_RETRY_CAP_MS));
+    expect(boot.bridge.retry).toHaveBeenCalledTimes(BOOT_RETRY_MAX_ATTEMPTS);
+    fireEvent.click(screen.getByRole("button", { name: "Retry" }));
+    expect(boot.bridge.retry).toHaveBeenLastCalledWith({ action: "retry" });
+  });
+
+  it("a latched failure shows Repair at once and is not retried automatically", async () => {
+    const boot = await mount(
+      progress("error", {
+        error: "runtime missing",
+        retryable: true,
+        latched: true,
+        running: false,
+      }),
+    );
+    expect(screen.getByRole("heading", { name: "Indus could not start" })).toBeTruthy();
+    expect(screen.queryByRole("button", { name: "Retry" })).toBeNull();
+    act(() => boot.timers.advance(10 * BOOT_RETRY_CAP_MS));
+    expect(boot.bridge.retry).not.toHaveBeenCalled();
+    fireEvent.click(screen.getByRole("button", { name: "Repair" }));
+    expect(boot.bridge.retry).toHaveBeenCalledWith({ action: "repair" });
+  });
+
+  it("Settings opens the settings overlay and gives it the window", async () => {
+    await mount(progress("error", { error: "no runtime", retryable: false, running: false }));
+    fireEvent.click(screen.getByRole("button", { name: "Settings" }));
+    expect(screen.getByTestId("where").textContent).toBe("/settings");
+    expect(screen.queryByRole("dialog")).toBeNull();
+  });
+
+  it("shows a crashing backend's notice with its last output on the failure view", async () => {
+    let push: ((notice: BackendNotice) => void) | null = null;
+    const boot = fakeBoot(progress("error", { error: "backend stopped", running: false }));
+    render(
+      <MemoryRouter>
+        <BootOverlay
+          bridge={boot.bridge}
+          notices={(listener) => {
+            push = listener;
+            return () => undefined;
+          }}
+        />
+      </MemoryRouter>,
+    );
+    await act(async () => {
+      await Promise.resolve();
+    });
+    act(() =>
+      push?.({
+        kind: "crashing",
+        message: "Indus keeps stopping",
+        exitCode: 3,
+        recentOutput: ["first", "Traceback: boom"],
+      }),
+    );
+    expect(screen.getByText("Indus keeps stopping (exit code 3)")).toBeTruthy();
+    expect(screen.getByText(/Traceback: boom/)).toBeTruthy();
+  });
+
+  it("a refused credential (401) asks to sign in again", async () => {
+    await mount(progress("error", { error: "unauthorized", statusCode: 401, running: false }));
+    expect(screen.getByRole("heading", { name: "Sign in again" })).toBeTruthy();
+  });
+
+  it("a newer progress event wins over a late boot.get answer", async () => {
+    const boot = fakeBoot(progress("resolve"));
+    let answer: (p: IndusBootProgress) => void = () => undefined;
+    boot.bridge.get.mockImplementation(
+      () =>
+        new Promise<IndusBootProgress>((resolve) => {
+          answer = resolve;
+        }),
+    );
+    render(
+      <MemoryRouter>
+        <BootOverlay bridge={boot.bridge} />
+      </MemoryRouter>,
+    );
+    boot.push(progress("remote-connect"));
+    await act(async () => {
+      answer(progress("resolve"));
+      await Promise.resolve();
+    });
+    expect(screen.getByRole("heading", { name: "Connecting to your Indus" })).toBeTruthy();
+  });
+
+  it("without a main process boot is treated as ready", async () => {
+    const onReady = vi.fn();
+    render(
+      <MemoryRouter>
+        <BootOverlay bridge={null} onReady={onReady} />
+      </MemoryRouter>,
+    );
+    expect(screen.queryByRole("dialog")).toBeNull();
+    expect(onReady).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/apps/desktop/src/boot/BootOverlay.tsx b/apps/desktop/src/boot/BootOverlay.tsx
new file mode 100644
index 0000000..c7fb738
--- /dev/null
+++ b/apps/desktop/src/boot/BootOverlay.tsx
@@ -0,0 +1,369 @@
+// The boot overlay (P20-16): main's boot snapshot (`boot.get` + `boot.onProgress`) and the
+// installer's events become one of: connecting, install, first run, failure, reauth. A
+// retryable, unlatched failure is retried here (bootRetry.ts) before the failure view shows.
+// The overlay is modal: Escape never dismisses it, focus stays inside.
+
+import { type Clock, systemClock } from "@indus/client";
+import { AlertTriangle, KeyRound } from "lucide-react";
+import {
+  type KeyboardEvent,
+  type ReactNode,
+  useEffect,
+  useMemo,
+  useReducer,
+  useRef,
+  useState,
+} from "react";
+import { useLocation, useNavigate } from "react-router";
+import { desktopBridge } from "../app/bridge.ts";
+import { Loader } from "../app/Loader.tsx";
+import { classifyPath, overlayPath, overlayStateFrom } from "../app/routes.ts";
+import type { IndusBootProgress, IndusDesktopBoot } from "../global.d.ts";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+import { BootRetry } from "./bootRetry.ts";
+import {
+  bootView,
+  EMPTY_INSTALLER,
+  INSTALL_LOG_SHOWN,
+  type InstallerState,
+  reduceInstaller,
+  type StageState,
+} from "./bootState.ts";
+import { type FirstRunChoice, FirstRunChooser } from "./FirstRunChooser.tsx";
+
+export type BootBridge = Pick<
+  IndusDesktopBoot,
+  "get" | "onProgress" | "retry" | "choose" | "onInstaller" | "cancelInstall"
+>;
+
+/** `indus:backend:notice` (slice M): the supervised backend restarted, or keeps crashing. */
+export type BackendNotice =
+  | { kind: "restarted"; message: string }
+  | {
+      kind: "crashing";
+      message: string;
+      exitCode?: number | null;
+      recentOutput?: string[] | string;
+    };
+
+export type NoticeSource = (listener: (notice: BackendNotice) => void) => () => void;
+
+/** Where the bridge carries the notice event (its group lands with slice M's table rows). */
+function defaultNotices(): NoticeSource | null {
+  const host = desktopBridge() as unknown as {
+    backend?: { onNotice?: NoticeSource };
+    boot?: { onBackendNotice?: NoticeSource };
+  } | null;
+  const source = host?.backend?.onNotice ?? host?.boot?.onBackendNotice;
+  return typeof source === "function" ? source : null;
+}
+
+export interface BootOverlayProps {
+  /** Default: `window.indusDesktop.boot`; null means no main process (treated as ready). */
+  bridge?: BootBridge | null;
+  onReady?: () => void;
+  /** Default: the bridge's backend notice event; null for none. */
+  notices?: NoticeSource | null;
+  clock?: Clock;
+  random?: () => number;
+}
+
+const PHASE_KEYS: Readonly<Record<IndusBootProgress["phase"], MessageKey>> = {
+  resolve: "boot.phase.resolve",
+  runtime: "boot.phase.runtime",
+  "remote-connect": "boot.phase.remote-connect",
+  "update-wait": "boot.phase.update-wait",
+  "first-run": "boot.phase.first-run",
+  ready: "boot.phase.ready",
+  error: "boot.phase.error",
+};
+
+const STAGE_KEYS: Readonly<Record<StageState, MessageKey>> = {
+  pending: "boot.stage.pending",
+  running: "boot.stage.running",
+  succeeded: "boot.stage.succeeded",
+  skipped: "boot.stage.skipped",
+  failed: "boot.stage.failed",
+};
+
+const READY: IndusBootProgress = {
+  phase: "ready",
+  message: "",
+  progress: 1,
+  running: false,
+};
+
+function useBootProgress(bridge: BootBridge | null): IndusBootProgress | null {
+  const [progress, setProgress] = useState<IndusBootProgress | null>(
+    bridge === null ? READY : null,
+  );
+  useEffect(() => {
+    if (bridge === null) return;
+    let live = true;
+    let pushed = false;
+    const off = bridge.onProgress((next) => {
+      pushed = true;
+      if (live) setProgress(next);
+    });
+    bridge.get().then(
+      (snapshot) => {
+        // An event that arrived meanwhile is newer than this answer.
+        if (live && !pushed) setProgress(snapshot);
+      },
+      (error: unknown) => {
+        const text = error instanceof Error ? error.message : String(error);
+        // No boot handler in main yet (dev without the orchestrator): nothing to wait for.
+        if (live && !pushed && text.startsWith("not-available")) setProgress(READY);
+      },
+    );
+    return () => {
+      live = false;
+      off();
+    };
+  }, [bridge]);
+  return progress;
+}
+
+function useInstaller(bridge: BootBridge | null): InstallerState {
+  const [state, dispatch] = useReducer(reduceInstaller, EMPTY_INSTALLER);
+  useEffect(() => {
+    if (bridge === null) return;
+    return bridge.onInstaller(dispatch);
+  }, [bridge]);
+  return state;
+}
+
+function InstallView(props: { installer: InstallerState; onCancel: () => void }) {
+  const t = useT();
+  const tail = props.installer.log.slice(-INSTALL_LOG_SHOWN);
+  return (
+    <div className="boot-install">
+      <h1 id="boot-title">{t("boot.install.title")}</h1>
+      <h2 className="boot-subtitle">{t("boot.install.stages")}</h2>
+      <ol className="boot-stages">
+        {props.installer.stages.map((stage) => (
+          <li key={stage.name} data-state={stage.state}>
+            {stage.state === "running" ? (
+              <Loader size="sm" />
+            ) : (
+              <span className="stage-dot" aria-hidden="true" />
+            )}
+            <span className="stage-title">{stage.title}</span>
+            <span className="stage-state">{t(STAGE_KEYS[stage.state])}</span>
+            {stage.error !== null && <span className="stage-error">{stage.error}</span>}
+          </li>
+        ))}
+      </ol>
+      {tail.length > 0 && (
+        <section aria-label={t("boot.install.log")}>
+          <pre className="log-view">{tail.join("\n")}</pre>
+        </section>
+      )}
+      <button type="button" className="text-button" onClick={props.onCancel}>
+        {t("boot.install.cancel")}
+      </button>
+    </div>
+  );
+}
+
+function CrashNotice(props: { notice: Extract<BackendNotice, { kind: "crashing" }> }) {
+  const t = useT();
+  const { notice } = props;
+  const output = Array.isArray(notice.recentOutput)
+    ? notice.recentOutput
+    : (notice.recentOutput ?? "").split("\n");
+  const tail = output.filter((line) => line.trim() !== "").slice(-INSTALL_LOG_SHOWN);
+  return (
+    <section aria-label={t("boot.crash.title")}>
+      <p>
+        {notice.exitCode === undefined || notice.exitCode === null
+          ? notice.message
+          : t("boot.crash.exit", { message: notice.message, code: notice.exitCode })}
+      </p>
+      {tail.length > 0 && <pre className="log-view">{tail.join("\n")}</pre>}
+    </section>
+  );
+}
+
+export function BootOverlay(props: BootOverlayProps) {
+  const t = useT();
+  const navigate = useNavigate();
+  const location = useLocation();
+  const bridge = props.bridge === undefined ? (desktopBridge()?.boot ?? null) : props.bridge;
+  const progress = useBootProgress(bridge);
+  const installer = useInstaller(bridge);
+  const notices = props.notices === undefined ? defaultNotices() : props.notices;
+  const [notice, setNotice] = useState<BackendNotice | null>(null);
+  useEffect(() => (notices === null ? undefined : notices(setNotice)), [notices]);
+  const view = bootView(progress, installer);
+  const clock = props.clock ?? systemClock;
+  const random = props.random;
+  const retry = useMemo(
+    () => new BootRetry({ clock, ...(random === undefined ? {} : { random }) }),
+    [clock, random],
+  );
+  const [, tick] = useReducer((n: number) => n + 1, 0);
+  const [busy, setBusy] = useState(false);
+  const readyFired = useRef(false);
+  const root = useRef<HTMLDivElement>(null);
+  const onReady = props.onReady;
+
+  useEffect(() => {
+    if (view.kind !== "ready") {
+      readyFired.current = false;
+      return;
+    }
+    retry.reset();
+    if (!readyFired.current) {
+      readyFired.current = true;
+      onReady?.();
+    }
+  }, [view.kind, retry, onReady]);
+
+  const autoRetrying =
+    view.kind === "failure" &&
+    view.retryable &&
+    !view.latched &&
+    (!retry.exhausted || retry.pending);
+
+  // Each new failure snapshot may schedule the next attempt (one waits at a time).
+  // biome-ignore lint/correctness/useExhaustiveDependencies: `progress` marks a new snapshot
+  useEffect(() => {
+    if (!autoRetrying || bridge === null || retry.pending) return;
+    retry.schedule(() => {
+      tick();
+      void bridge.retry({ action: "retry" }).catch(() => undefined);
+    });
+    tick();
+  }, [autoRetrying, bridge, retry, progress]);
+
+  useEffect(() => () => retry.cancel(), [retry]);
+
+  useEffect(() => {
+    if (view.kind !== "ready") root.current?.focus();
+  }, [view.kind]);
+
+  if (view.kind === "ready") return null;
+  // The Settings button opens the settings overlay above everything; give it the window.
+  const route = classifyPath(location.pathname);
+  if (route.kind === "overlay" && route.overlay === "settings") return null;
+
+  const act = (run: () => Promise<unknown>) => {
+    setBusy(true);
+    run()
+      .catch(() => undefined)
+      .finally(() => setBusy(false));
+  };
+  const manualRetry = (action: "retry" | "repair") => {
+    if (bridge === null) return;
+    retry.reset();
+    act(() => bridge.retry({ action }));
+  };
+  const openSettings = () =>
+    navigate(overlayPath("settings"), {
+      state: overlayStateFrom(location.pathname, location.state),
+    });
+  const choose = (choice: FirstRunChoice) => {
+    if (bridge !== null) act(() => bridge.choose({ choice }));
+  };
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    if (event.key === "Escape") {
+      event.preventDefault();
+      event.stopPropagation();
+    }
+  };
+
+  let body: ReactNode;
+  if (view.kind === "install") {
+    body = (
+      <InstallView
+        installer={view.installer}
+        onCancel={() => {
+          if (bridge !== null) act(() => bridge.cancelInstall());
+        }}
+      />
+    );
+  } else if (view.kind === "first-run") {
+    body = <FirstRunChooser onChoose={choose} busy={busy} />;
+  } else if (view.kind === "reauth") {
+    body = (
+      <div className="boot-failure">
+        <KeyRound aria-hidden="true" size={20} />
+        <h1 id="boot-title">{t("boot.reauth.title")}</h1>
+        <p>{t("boot.reauth.body")}</p>
+        {view.message !== "" && <pre className="log-view">{view.message}</pre>}
+        <button type="button" className="button button-primary" onClick={openSettings}>
+          {t("boot.reauth.action")}
+        </button>
+      </div>
+    );
+  } else if (view.kind === "failure" && !autoRetrying) {
+    body = (
+      <div className="boot-failure">
+        <AlertTriangle aria-hidden="true" size={20} />
+        <h1 id="boot-title">{t("boot.failure.title")}</h1>
+        {view.message !== "" && <pre className="log-view">{view.message}</pre>}
+        {view.latched && <p>{t("boot.failure.latched")}</p>}
+        {notice?.kind === "crashing" && <CrashNotice notice={notice} />}
+        <div className="boot-actions">
+          {!view.latched && (
+            <button
+              type="button"
+              className="button button-primary"
+              disabled={busy}
+              onClick={() => manualRetry("retry")}
+            >
+              {t("boot.failure.retry")}
+            </button>
+          )}
+          <button
+            type="button"
+            className={view.latched ? "button button-primary" : "button button-secondary"}
+            disabled={busy}
+            onClick={() => manualRetry("repair")}
+          >
+            {t("boot.failure.repair")}
+          </button>
+          <button type="button" className="button button-secondary" onClick={openSettings}>
+            {t("boot.failure.settings")}
+          </button>
+        </div>
+      </div>
+    );
+  } else {
+    const phase = view.kind === "connecting" ? view.phase : "runtime";
+    const due = retry.dueAt;
+    body = (
+      <div className="boot-connecting">
+        <Loader label={t(PHASE_KEYS[phase])} />
+        <h1 id="boot-title">{t(PHASE_KEYS[phase])}</h1>
+        {view.kind === "connecting" && view.message !== "" && <p>{view.message}</p>}
+        {notice?.kind === "restarted" && <p className="boot-note">{notice.message}</p>}
+        {view.kind === "failure" && due !== null && (
+          <p>
+            {t("boot.failure.retrying", {
+              seconds: Math.max(1, Math.ceil((due - clock.now()) / 1000)),
+              attempt: retry.attempts,
+              max: retry.max,
+            })}
+          </p>
+        )}
+      </div>
+    );
+  }
+
+  return (
+    <div
+      ref={root}
+      className="boot-overlay"
+      role="dialog"
+      aria-modal="true"
+      aria-labelledby="boot-title"
+      data-view={view.kind}
+      tabIndex={-1}
+      onKeyDown={onKeyDown}
+    >
+      <div className="boot-card">{body}</div>
+    </div>
+  );
+}
