+import fs from "node:fs";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import {
+  cleanupFakes,
+  posix,
+  tempDir,
+  writeFakeIndus,
+  writeScript,
+} from "../../testing/fakeIndus.ts";
+import { runCommand } from "./process.ts";
+import {
+  launcherTarget,
+  parseVersionOutput,
+  type ResolverFs,
+  type ResolverOptions,
+  resolveBackend,
+  unwrapWindowsVenvLauncher,
+  versionProbe,
+} from "./resolver.ts";
+
+afterAll(cleanupFakes);
+
+/** A checkout with a venv whose `indus` is the fake backend. */
+function checkout(root: string, scenario?: string): string {
+  fs.mkdirSync(path.join(root, "src", "indus"), { recursive: true });
+  fs.writeFileSync(path.join(root, "pyproject.toml"), '[project]\nname = "indus-agent"\n');
+  fs.writeFileSync(path.join(root, "src", "indus", "__init__.py"), "");
+  writeFakeIndus(path.join(root, ".venv", "bin", "indus"), scenario);
+  return root;
+}
+
+interface Layout {
+  base: string;
+  home: string;
+  homeDir: string;
+  sourceRoot: string;
+  devRoot: string;
+  command: string;
+  options: (over?: Partial<ResolverOptions>) => ResolverOptions;
+}
+
+/** Every rung populated with a working fake; tests remove rungs to see the next one win. */
+function layout(): Layout {
+  const base = tempDir();
+  const home = path.join(base, "home", ".indus");
+  const homeDir = path.join(base, "home");
+  const sourceRoot = checkout(path.join(base, "src-root"));
+  const devRoot = checkout(path.join(base, "dev-root"));
+  const command = writeFakeIndus(path.join(base, "nix", "bin", "indus"));
+  checkout(path.join(home, "indus-agent"));
+  const other = checkout(path.join(base, "elsewhere"));
+  fs.mkdirSync(path.join(homeDir, ".local", "bin"), { recursive: true });
+  fs.symlinkSync(
+    path.join(other, ".venv", "bin", "indus"),
+    path.join(homeDir, ".local", "bin", "indus"),
+  );
+  // An `indus` on PATH that must never be adopted.
+  const pathDir = path.join(base, "pathbin");
+  writeFakeIndus(path.join(pathDir, "indus"));
+  const options = (over: Partial<ResolverOptions> = {}): ResolverOptions => ({
+    env: {
+      INDUS_DESKTOP_INDUS_ROOT: sourceRoot,
+      INDUS_DESKTOP_INDUS: command,
+      PATH: `${pathDir}:/usr/bin:/bin`,
+      INDUS_HOME: home,
+    },
+    argv: [],
+    platform: process.platform,
+    packaged: false,
+    home,
+    homeDir,
+    devCheckoutRoot: devRoot,
+    appExecPath: process.execPath,
+    isWsl: false,
+    ...over,
+  });
+  return { base, home, homeDir, sourceRoot, devRoot, command, options };
+}
+
+describe.skipIf(!posix)("backend resolution ladder", () => {
+  it("precedence table: each rung wins over every lower one", async () => {
+    const l = layout();
+    const env = l.options().env;
+    const expectRung = async (over: Partial<ResolverOptions>, rung: string | null) => {
+      const result = await resolveBackend(l.options(over));
+      if (rung === null) expect(result.kind).toBe("bootstrap-needed");
+      else {
+        expect(result.kind).toBe("found");
+        if (result.kind === "found") {
+          expect(result.backend.rung).toBe(rung);
+          expect(result.version).toBe("0.20.0");
+        }
+      }
+    };
+    await expectRung({}, "source-root");
+    await expectRung({ env: { ...env, INDUS_DESKTOP_INDUS_ROOT: "" } }, "dev-checkout");
+    // packaged apps never use their own checkout
+    await expectRung({ env: { ...env, INDUS_DESKTOP_INDUS_ROOT: "" }, packaged: true }, "command");
+    const noOverrides = { ...env, INDUS_DESKTOP_INDUS_ROOT: "", INDUS_DESKTOP_INDUS: "" };
+    // the managed install has no bootstrap marker and still wins
+    expect(fs.existsSync(path.join(l.home, ".indus-bootstrap-complete"))).toBe(false);
+    await expectRung({ env: noOverrides, packaged: true }, "managed");
+    fs.rmSync(path.join(l.home, "indus-agent"), { recursive: true });
+    await expectRung({ env: noOverrides, packaged: true }, "launcher");
+    fs.rmSync(path.join(l.homeDir, ".local", "bin", "indus"));
+    // only an `indus` on PATH is left: never adopted
+    await expectRung({ env: noOverrides, packaged: true }, null);
+  });
+
+  it("the sentinel carries install hints", async () => {
+    const l = layout();
+    const result = await resolveBackend(
+      l.options({
+        env: { PATH: l.options().env.PATH },
+        packaged: true,
+        homeDir: path.join(l.base, "nobody"),
+        home: path.join(l.base, "empty-home"),
+      }),
+    );
+    expect(result).toEqual({
+      kind: "bootstrap-needed",
+      hints: {
+        installDir: path.join(l.base, "empty-home", "indus-agent"),
+        platform: process.platform,
+        packaged: true,
+      },
+    });
+  });
+
+  it("a failing or hanging probe skips the rung", async () => {
+    const l = layout();
+    const lines: string[] = [];
+    // rung 1 exits 3; rung 2 hangs past the probe deadline; rung 3 answers
+    checkout(l.sourceRoot, "version-probe-fails");
+    checkout(l.devRoot, "version-probe-hangs");
+    const quick = versionProbe((spec, args, options) =>
+      runCommand(spec, args, { ...options, timeoutMs: 400 }),
+    );
+    const started = Date.now();
+    const result = await resolveBackend(
+      l.options({ probe: quick, log: (line) => lines.push(line) }),
+    );
+    expect(result.kind === "found" && result.backend.rung).toBe("command");
+    expect(Date.now() - started).toBeLessThan(5_000);
+    expect(lines.filter((line) => line.includes("version probe failed"))).toHaveLength(2);
+  });
+
+  it("ignore-existing and repair skip the installed rungs, not the explicit ones", async () => {
+    const l = layout();
+    const noOverrides = {
+      ...l.options().env,
+      INDUS_DESKTOP_INDUS_ROOT: "",
+      INDUS_DESKTOP_INDUS: "",
+    };
+    for (const over of [
+      { env: { ...noOverrides, INDUS_DESKTOP_IGNORE_EXISTING: "1" } },
+      { env: noOverrides, argv: ["--ignore-existing"] },
+      { env: noOverrides, repair: true },
+    ]) {
+      const result = await resolveBackend(l.options({ ...over, packaged: true }));
+      expect(result.kind).toBe("bootstrap-needed");
+    }
+    const explicit = await resolveBackend(l.options({ repair: true }));
+    expect(explicit.kind === "found" && explicit.backend.rung).toBe("source-root");
+  });
+
+  it("refuses the app's own binary and a Windows path under WSL", async () => {
+    const l = layout();
+    const base = { ...l.options().env, INDUS_DESKTOP_INDUS_ROOT: "" };
+    const self = await resolveBackend(
+      l.options({ env: base, packaged: true, appExecPath: l.command }),
+    );
+    expect(self.kind === "found" && self.backend.rung).toBe("managed");
+    const wsl = await resolveBackend(
+      l.options({
+        env: { ...base, INDUS_DESKTOP_INDUS: "C:\\Program Files\\Indus\\indus.exe" },
+        packaged: true,
+        isWsl: true,
+      }),
+    );
+    expect(wsl.kind === "found" && wsl.backend.rung).toBe("managed");
+  });
+
+  it("a bare INDUS_DESKTOP_INDUS name is looked up on PATH (the person named it)", async () => {
+    const l = layout();
+    const result = await resolveBackend(
+      l.options({
+        env: { ...l.options().env, INDUS_DESKTOP_INDUS_ROOT: "", INDUS_DESKTOP_INDUS: "indus" },
+        packaged: true,
+      }),
+    );
+    expect(result.kind === "found" && result.backend.command).toBe(
+      path.join(l.base, "pathbin", "indus"),
+    );
+  });
+
+  it("a checkout without a venv is skipped", async () => {
+    const l = layout();
+    fs.rmSync(path.join(l.sourceRoot, ".venv"), { recursive: true });
+    const lines: string[] = [];
+    const result = await resolveBackend(l.options({ log: (line) => lines.push(line) }));
+    expect(result.kind === "found" && result.backend.rung).toBe("dev-checkout");
+    expect(lines.some((line) => line.includes("no .venv"))).toBe(true);
+  });
+
+  it("a launcher script is read for the program it execs", () => {
+    const base = tempDir();
+    const program = writeFakeIndus(path.join(base, "inst", ".venv", "bin", "indus"));
+    const launcher = writeScript(
+      path.join(base, "bin", "indus"),
+      `# published by the installer\nexec "${program}" "$@"`,
+    );
+    expect(launcherTarget(launcher)).toBe(program);
+    const broken = writeScript(path.join(base, "bin2", "indus"), "echo nothing");
+    expect(launcherTarget(broken)).toBeNull();
+    fs.symlinkSync(path.join(base, "missing"), path.join(base, "dangling"));
+    expect(launcherTarget(path.join(base, "dangling"))).toBeNull();
+  });
+});
+
+describe("resolver pieces", () => {
+  it("parses the version line", () => {
+    expect(parseVersionOutput("indus 0.20.0\n")).toBe("0.20.0");
+    expect(parseVersionOutput("Indus Agent 0.0.1\nInstall method: git\n")).toBe("0.0.1");
+    expect(parseVersionOutput("indus 1.2.3 (managed)\nmore")).toBeNull();
+    expect(parseVersionOutput("indus v1.2.3-rc.1\n")).toBe("1.2.3-rc.1");
+    expect(parseVersionOutput("python 3.13\n")).toBeNull();
+    expect(parseVersionOutput("")).toBeNull();
+  });
+
+  it("unwraps a Windows venv launcher to the venv's interpreter", () => {
+    const present = new Set([
+      "C:\\u\\inst\\.venv\\pyvenv.cfg",
+      "C:\\u\\inst\\.venv\\Scripts\\python.exe",
+    ]);
+    const files: ResolverFs = {
+      isFile: (file) => present.has(file),
+      isDir: () => false,
+      isSymlink: () => false,
+      realpath: (file) => file,
+      readHead: () => null,
+    };
+    expect(unwrapWindowsVenvLauncher("C:\\u\\inst\\.venv\\Scripts\\indus.exe", files)).toEqual({
+      command: "C:\\u\\inst\\.venv\\Scripts\\python.exe",
+      args: ["-m", "indus"],
+    });
+    expect(unwrapWindowsVenvLauncher("C:\\tools\\indus.exe", files)).toBeNull();
+  });
+});
diff --git a/apps/desktop/electron/backend/resolver.ts b/apps/desktop/electron/backend/resolver.ts
new file mode 100644
index 0000000..2d39905
--- /dev/null
+++ b/apps/desktop/electron/backend/resolver.ts
@@ -0,0 +1,349 @@
+// Which `indus` the desktop runs (P20-08). One ladder, top rung first; a candidate counts only
+// after `indus --version` answers within 5 s. PATH is never a rung and a system Python is never
+// adopted. Nothing usable is a value (`bootstrap-needed`), not an error: the boot orchestrator
+// offers the installer then. No bundled-payload rung in 1.0 (D-16.82).
+//
+//   1  INDUS_DESKTOP_INDUS_ROOT   a developer checkout (its own venv)
+//   2  the app's own checkout     unpackaged runs only
+//   3  INDUS_DESKTOP_INDUS        an explicit command (packagers); not this app, not C:\ under WSL
+//   4  <home>/indus-agent         the managed install; skipped by ignore-existing and repair
+//   5  ~/.local/bin/indus         the launcher an install published (POSIX); skipped like 4
+//   6  bootstrap-needed
+
+import fs from "node:fs";
+import path from "node:path";
+import { type CommandRunner, type CommandSpec, runCommand } from "./process.ts";
+
+export const VERSION_PROBE_TIMEOUT_MS = 5_000;
+export const MANAGED_INSTALL_DIR = "indus-agent";
+export const IGNORE_EXISTING_FLAG = "--ignore-existing";
+const LAUNCHER_READ_BYTES = 4 * 1024;
+
+export type Rung = "source-root" | "dev-checkout" | "command" | "managed" | "launcher";
+
+export interface IndusCommand extends CommandSpec {
+  readonly label: string;
+  readonly rung: Rung;
+  /** The install or checkout behind the command, when known. */
+  readonly root: string | null;
+}
+
+export interface BootstrapHints {
+  installDir: string;
+  platform: string;
+  packaged: boolean;
+}
+
+export type Resolution =
+  | { kind: "found"; backend: IndusCommand; version: string }
+  | { kind: "bootstrap-needed"; hints: BootstrapHints };
+
+export interface ResolverFs {
+  isFile(file: string): boolean;
+  isDir(dir: string): boolean;
+  isSymlink(file: string): boolean;
+  realpath(file: string): string | null;
+  readHead(file: string, bytes: number): string | null;
+}
+
+export const nodeResolverFs: ResolverFs = {
+  isFile: (file) => {
+    try {
+      return fs.statSync(file).isFile();
+    } catch {
+      return false;
+    }
+  },
+  isDir: (dir) => {
+    try {
+      return fs.statSync(dir).isDirectory();
+    } catch {
+      return false;
+    }
+  },
+  isSymlink: (file) => {
+    try {
+      return fs.lstatSync(file).isSymbolicLink();
+    } catch {
+      return false;
+    }
+  },
+  realpath: (file) => {
+    try {
+      return fs.realpathSync(file);
+    } catch {
+      return null;
+    }
+  },
+  readHead: (file, bytes) => {
+    let fd: number | null = null;
+    try {
+      fd = fs.openSync(file, "r");
+      const buffer = Buffer.alloc(bytes);
+      const read = fs.readSync(fd, buffer, 0, bytes, 0);
+      return buffer.subarray(0, read).toString("utf8");
+    } catch {
+      return null;
+    } finally {
+      if (fd !== null) fs.closeSync(fd);
+    }
+  },
+};
+
+export interface ResolverOptions {
+  env: Readonly<Record<string, string | undefined>>;
+  argv: readonly string[];
+  platform: string;
+  packaged: boolean;
+  /** The Indus home (`~/.indus` or INDUS_HOME). */
+  home: string;
+  /** The user's home directory (for `~/.local/bin`). */
+  homeDir: string;
+  /** The repository the unpackaged app runs from, or null. */
+  devCheckoutRoot: string | null;
+  /** This app's executable, which rung 3 must never pick. */
+  appExecPath: string;
+  isWsl: boolean;
+  /** A repair was requested: skip the installed runtimes so the installer runs again. */
+  repair?: boolean;
+  /** `indus --version` → the version, or null. Default: run it with a 5 s deadline. */
+  probe?: (command: CommandSpec) => Promise<string | null>;
+  fs?: ResolverFs;
+  log?: (line: string) => void;
+}
+
+/** `Indus Agent 0.20.0` or `indus 0.20.0` (first line) → `0.20.0`. */
+export function parseVersionOutput(stdout: string): string | null {
+  const first = stdout.split(/\r?\n/, 1)[0]?.trim() ?? "";
+  const match = /^indus(?:\s+agent)?\s+v?(\d[0-9A-Za-z.+-]*)$/i.exec(first);
+  return match?.[1] ?? null;
+}
+
+export function versionProbe(
+  run: CommandRunner = runCommand,
+  env?: Record<string, string | undefined>,
+): (command: CommandSpec) => Promise<string | null> {
+  return async (command) => {
+    const result = await run(command, ["--version"], {
+      timeoutMs: VERSION_PROBE_TIMEOUT_MS,
+      ...(env === undefined ? {} : { env }),
+    });
+    if (result.timedOut || result.code !== 0) return null;
+    return parseVersionOutput(result.stdout);
+  };
+}
+
+/** A checkout of this project: `pyproject.toml` beside `src/indus/__init__.py`. */
+export function isSourceRoot(root: string, files: ResolverFs = nodeResolverFs): boolean {
+  return (
+    files.isFile(path.join(root, "pyproject.toml")) &&
+    files.isFile(path.join(root, "src", "indus", "__init__.py"))
+  );
+}
+
+/**
+ * The command a venv under `root` runs `indus` with. On Windows the venv's `indus.exe` is a
+ * redirector the packaged interpreter refuses, so the venv's `python.exe -m indus` is used.
+ */
+export function venvCommand(
+  root: string,
+  platform: string,
+  files: ResolverFs = nodeResolverFs,
+): CommandSpec | null {
+  const venv = path.join(root, ".venv");
+  if (platform === "win32") {
+    const python = path.win32.join(venv, "Scripts", "python.exe");
+    return files.isFile(python) ? { command: python, args: ["-m", "indus"] } : null;
+  }
+  const indus = path.join(venv, "bin", "indus");
+  return files.isFile(indus) ? { command: indus, args: [] } : null;
+}
+
+/** On Windows, `<venv>\Scripts\indus.exe` → `<venv>\Scripts\python.exe -m indus`. */
+export function unwrapWindowsVenvLauncher(
+  command: string,
+  files: ResolverFs = nodeResolverFs,
+): CommandSpec | null {
+  const parsed = path.win32.parse(command);
+  if (parsed.name.toLowerCase() !== "indus" || path.win32.basename(parsed.dir) !== "Scripts") {
+    return null;
+  }
+  const venv = path.win32.dirname(parsed.dir);
+  const python = path.win32.join(parsed.dir, "python.exe");
+  if (!files.isFile(path.win32.join(venv, "pyvenv.cfg")) || !files.isFile(python)) return null;
+  return { command: python, args: ["-m", "indus"] };
+}
+
+function looksLikeWindowsPath(value: string): boolean {
+  return /^[A-Za-z]:[\\/]/.test(value) || value.startsWith("\\\\") || /\.exe$/i.test(value);
+}
+
+function findOnPath(
+  name: string,
+  env: Readonly<Record<string, string | undefined>>,
+  platform: string,
+  files: ResolverFs,
+): string | null {
+  const delimiter = platform === "win32" ? ";" : ":";
+  const exts = platform === "win32" ? ["", ".exe", ".cmd", ".bat"] : [""];
+  for (const dir of (env.PATH ?? env.Path ?? "").split(delimiter)) {
+    if (dir === "") continue;
+    for (const ext of exts) {
+      const candidate = path.join(dir, `${name}${ext}`);
+      if (files.isFile(candidate)) return candidate;
+    }
+  }
+  return null;
+}
+
+/**
+ * The program a published launcher runs: a symlink's target, or the first absolute path a small
+ * launcher script execs (`exec "/x/.venv/bin/indus" "$@"`).
+ */
+export function launcherTarget(
+  launcher: string,
+  files: ResolverFs = nodeResolverFs,
+): string | null {
+  if (files.isSymlink(launcher)) {
+    const target = files.realpath(launcher);
+    return target !== null && files.isFile(target) ? target : null;
+  }
+  if (!files.isFile(launcher)) return null;
+  const head = files.readHead(launcher, LAUNCHER_READ_BYTES);
+  if (head === null) return null;
+  for (const line of head.split(/\r?\n/)) {
+    const match = /^\s*exec\s+["']?(\/[^"'\s]+)["']?/.exec(line);
+    if (match?.[1] !== undefined && files.isFile(match[1])) return match[1];
+  }
+  return null;
+}
+
+function rootOfVenvProgram(program: string): string | null {
+  const parts = program.split(path.sep);
+  const at = parts.lastIndexOf(".venv");
+  return at > 0 ? parts.slice(0, at).join(path.sep) : null;
+}
+
+export async function resolveBackend(options: ResolverOptions): Promise<Resolution> {
+  const files = options.fs ?? nodeResolverFs;
+  const probe = options.probe ?? versionProbe(runCommand, { ...options.env });
+  const log = options.log ?? (() => {});
+  const { env, platform } = options;
+
+  const accept = async (
+    rung: Rung,
+    spec: CommandSpec,
+    label: string,
+    root: string | null,
+  ): Promise<Resolution | null> => {
+    const version = await probe(spec);
+    if (version === null) {
+      log(`[resolver] ${label}: the version probe failed; skipping`);
+      return null;
+    }
+    log(`[resolver] using ${label} (indus ${version})`);
+    return { kind: "found", backend: { ...spec, label, rung, root }, version };
+  };
+
+  const fromCheckout = async (rung: Rung, root: string, what: string) => {
+    if (!isSourceRoot(root, files)) {
+      log(`[resolver] ${what} ${root} is not an Indus checkout; skipping`);
+      return null;
+    }
+    const spec = venvCommand(root, platform, files);
+    if (spec === null) {
+      log(`[resolver] ${what} ${root} has no .venv (run \`uv sync\` there); skipping`);
+      return null;
+    }
+    return accept(rung, spec, `${what} ${root}`, root);
+  };
+
+  // 1. explicit source root
+  const overrideRoot = (env.INDUS_DESKTOP_INDUS_ROOT ?? "").trim();
+  if (overrideRoot !== "") {
+    if (!path.isAbsolute(overrideRoot)) {
+      log("[resolver] INDUS_DESKTOP_INDUS_ROOT is not an absolute path; skipping");
+    } else {
+      const found = await fromCheckout("source-root", path.resolve(overrideRoot), "checkout");
+      if (found !== null) return found;
+    }
+  }
+
+  // 2. the checkout an unpackaged app runs from
+  if (!options.packaged && options.devCheckoutRoot !== null) {
+    const found = await fromCheckout("dev-checkout", options.devCheckoutRoot, "dev checkout");
+    if (found !== null) return found;
+  }
+
+  // 3. explicit command
+  const override = (env.INDUS_DESKTOP_INDUS ?? "").trim();
+  if (override !== "") {
+    const found = await fromOverride(override);
+    if (found !== null) return found;
+  }
+
+  const skipInstalled =
+    options.repair === true ||
+    env.INDUS_DESKTOP_IGNORE_EXISTING === "1" ||
+    options.argv.includes(IGNORE_EXISTING_FLAG);
+  const installDir = path.join(options.home, MANAGED_INSTALL_DIR);
+
+  if (skipInstalled) {
+    log(
+      `[resolver] ${options.repair === true ? "repair requested" : "ignore-existing"}: skipping installed runtimes`,
+    );
+  } else {
+    // 4. the managed install (usable without the bootstrap marker)
+    const managed = venvCommand(installDir, platform, files);
+    if (managed !== null) {
+      const found = await accept("managed", managed, `managed install ${installDir}`, installDir);
+      if (found !== null) return found;
+    }
+    // 5. an install found through its published launcher
+    if (platform !== "win32") {
+      const launcher = path.join(options.homeDir, ".local", "bin", "indus");
+      const target = launcherTarget(launcher, files);
+      if (target !== null) {
+        const found = await accept(
+          "launcher",
+          { command: target, args: [] },
+          `install behind ${launcher}`,
+          rootOfVenvProgram(target),
+        );
+        if (found !== null) return found;
+      }
+    }
+  }
+
+  // 6. nothing usable
+  log("[resolver] no usable Indus runtime; bootstrap needed");
+  return {
+    kind: "bootstrap-needed",
+    hints: { installDir, platform, packaged: options.packaged },
+  };
+
+  async function fromOverride(value: string): Promise<Resolution | null> {
+    if (options.isWsl && looksLikeWindowsPath(value)) {
+      log("[resolver] INDUS_DESKTOP_INDUS names a Windows program under WSL; skipping");
+      return null;
+    }
+    const program =
+      path.isAbsolute(value) || value.includes("/") || value.includes("\\")
+        ? value
+        : findOnPath(value, env, platform, files);
+    if (program === null || !files.isFile(program)) {
+      log("[resolver] INDUS_DESKTOP_INDUS does not name a program; skipping");
+      return null;
+    }
+    const real = files.realpath(program) ?? program;
+    const self = files.realpath(options.appExecPath) ?? options.appExecPath;
+    if (real === self) {
+      log("[resolver] INDUS_DESKTOP_INDUS names this desktop app; skipping");
+      return null;
+    }
+    const spec =
+      (platform === "win32" ? unwrapWindowsVenvLauncher(program, files) : null) ??
+      ({ command: program, args: [] } satisfies CommandSpec);
+    return accept("command", spec, `command ${program}`, rootOfVenvProgram(real));
+  }
+}
