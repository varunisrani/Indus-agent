index 0000000..26f2d3c
--- /dev/null
+++ b/apps/desktop/electron/api/proxy.ts
@@ -0,0 +1,193 @@
+// The REST proxy in main (P20-14). The renderer asks `api.request({method, path, body?, profile?,
+// timeoutMs?})`; main sends it to the current connection's REST origin with the credential only
+// main holds (the launch's `indus serve` session token locally, the saved token for a remote) and
+// answers `{kind: "response", status, body}` or, for a 404, the value `{kind: "not-found", ...}`.
+// See docs/notes/P20/rest-proxy.md.
+
+import { SESSION_TOKEN_HEADER } from "../backend/localAttach.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import { isSensitivePath } from "../security/sensitiveFiles.ts";
+
+export const DEFAULT_TIMEOUT_MS = 30_000;
+export const STARTUP_TIMEOUT_MS = 60_000;
+export const MAX_BODY_BYTES = 256 * 1024 * 1024;
+export const STARTUP_PATHS: ReadonlySet<string> = new Set([
+  "/api/status",
+  "/api/health",
+  "/api/config",
+  "/api/config/schema",
+  "/api/profiles",
+]);
+/** Routes whose answer would put a credential in the renderer's hands. */
+export const REFUSED_PATHS: ReadonlySet<string> = new Set([
+  "/api/files/download-ticket",
+  "/api/auth/ws-ticket",
+]);
+
+export interface ApiRequest {
+  method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
+  path: string;
+  body?: unknown;
+  profile?: string | undefined;
+  timeoutMs?: number | undefined;
+}
+
+export type ApiResult =
+  | { kind: "response"; status: number; body: unknown }
+  | { kind: "not-found"; status: 404; body: unknown };
+
+export interface ProxyTarget {
+  /** `http://127.0.0.1:PORT` or the remote base (a path prefix allowed). */
+  origin: string;
+  token: string;
+  /** The connection's profile, used when the request names none. */
+  profile: string | null;
+}
+
+export interface Timers {
+  setTimeout(fn: () => void, ms: number): unknown;
+  clearTimeout(handle: unknown): void;
+}
+
+export interface ProxyDeps {
+  target(): ProxyTarget | null;
+  fetch?: typeof fetch;
+  timers?: Timers;
+  log(line: string): void;
+}
+
+const realTimers: Timers = {
+  setTimeout: (fn, ms) => setTimeout(fn, ms),
+  clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+};
+
+/**
+ * The URL for `rawPath` on `base`: only a path under `/api/` (no scheme, no `//`, no backslash,
+ * no `..` or `.` segment, no fragment), and the result keeps the base's origin.
+ */
+export function buildApiUrl(base: string, rawPath: string, profile: string | null): URL {
+  if (!rawPath.startsWith("/api/") || rawPath.startsWith("//") || /[\\#\s]/.test(rawPath)) {
+    throw new IpcError("bad-request", "only paths under /api/ on the current connection");
+  }
+  const cut = rawPath.indexOf("?");
+  const pathname = cut < 0 ? rawPath : rawPath.slice(0, cut);
+  const query = cut < 0 ? "" : rawPath.slice(cut + 1);
+  let decoded: string;
+  try {
+    decoded = decodeURIComponent(pathname);
+  } catch {
+    throw new IpcError("bad-request", "the path is not well encoded");
+  }
+  if (
+    decoded.split("/").some((segment) => segment === ".." || segment === ".") ||
+    decoded.includes("//")
+  ) {
+    throw new IpcError("bad-request", "the path may not walk out of /api/");
+  }
+  const root = new URL(base);
+  const prefix = root.pathname.replace(/\/+$/, "");
+  const url = new URL(`${root.origin}${prefix}${pathname}${query === "" ? "" : `?${query}`}`);
+  if (url.origin !== root.origin || !url.pathname.startsWith(`${prefix}/api/`)) {
+    throw new IpcError("bad-request", "only paths under /api/ on the current connection");
+  }
+  if (profile !== null && profile !== "" && !url.searchParams.has("profile")) {
+    url.searchParams.set("profile", profile);
+  }
+  return url;
+}
+
+function pathsIn(value: unknown): string[] {
+  if (value === null || typeof value !== "object") return [];
+  const record = value as Record<string, unknown>;
+  const found: string[] = [];
+  for (const key of ["path", "src", "dest", "target", "source"]) {
+    if (typeof record[key] === "string") found.push(record[key] as string);
+  }
+  if (Array.isArray(record.paths))
+    for (const p of record.paths) if (typeof p === "string") found.push(p);
+  return found;
+}
+
+export class ApiProxy {
+  private readonly deps: ProxyDeps;
+  private readonly timers: Timers;
+
+  constructor(deps: ProxyDeps) {
+    this.deps = deps;
+    this.timers = deps.timers ?? realTimers;
+  }
+
+  async request(request: ApiRequest): Promise<ApiResult> {
+    const target = this.deps.target();
+    if (target === null) throw new IpcError("not-connected", "Indus is not connected yet");
+    const url = buildApiUrl(target.origin, request.path, request.profile ?? target.profile);
+    const route = url.pathname.slice(new URL(target.origin).pathname.replace(/\/+$/, "").length);
+    if (REFUSED_PATHS.has(route)) {
+      throw new IpcError("forbidden", "that route is not available to the app window");
+    }
+    if (route.startsWith("/api/files")) {
+      const named = [...url.searchParams.getAll("path"), ...pathsIn(request.body)];
+      if (named.some(isSensitivePath)) {
+        throw new IpcError("forbidden", "files that hold secrets are not available here");
+      }
+    }
+    let body: string | undefined;
+    if (request.body !== undefined && request.method !== "GET") {
+      body = JSON.stringify(request.body);
+      if (Buffer.byteLength(body) > MAX_BODY_BYTES) {
+        throw new IpcError("too-large", "the request is larger than 256 MiB");
+      }
+    }
+    const timeoutMs =
+      request.timeoutMs ?? (STARTUP_PATHS.has(route) ? STARTUP_TIMEOUT_MS : DEFAULT_TIMEOUT_MS);
+    const controller = new AbortController();
+    const timer = this.timers.setTimeout(() => controller.abort(), timeoutMs);
+    let response: Response;
+    try {
+      response = await (this.deps.fetch ?? fetch)(url, {
+        method: request.method,
+        headers: {
+          Accept: "application/json",
+          [SESSION_TOKEN_HEADER]: target.token,
+          ...(body === undefined ? {} : { "Content-Type": "application/json" }),
+        },
+        ...(body === undefined ? {} : { body }),
+        signal: controller.signal,
+        redirect: "manual",
+      });
+    } catch {
+      this.timers.clearTimeout(timer);
+      if (controller.signal.aborted) {
+        throw new IpcError(
+          "timeout",
+          `the request took longer than ${Math.round(timeoutMs / 1000)} s`,
+        );
+      }
+      throw new IpcError("unreachable", "the Indus server did not answer");
+    }
+    let text: string;
+    try {
+      text = await response.text();
+    } catch {
+      this.timers.clearTimeout(timer);
+      if (controller.signal.aborted) {
+        throw new IpcError(
+          "timeout",
+          `the request took longer than ${Math.round(timeoutMs / 1000)} s`,
+        );
+      }
+      throw new IpcError("unreachable", "the answer was cut off");
+    }
+    this.timers.clearTimeout(timer);
+    let parsed: unknown = text;
+    if (text !== "") {
+      try {
+        parsed = JSON.parse(text);
+      } catch {
+        parsed = text;
+      }
+    } else parsed = null;
+    if (response.status === 404) return { kind: "not-found", status: 404, body: parsed };
+    return { kind: "response", status: response.status, body: parsed };
+  }
+}
diff --git a/apps/desktop/electron/backend/control.ts b/apps/desktop/electron/backend/control.ts
new file mode 100644
index 0000000..3e29354
--- /dev/null
+++ b/apps/desktop/electron/backend/control.ts
@@ -0,0 +1,250 @@
+// Client for the profile daemon's owner-only control socket (P15-27 wire, P17-11 verbs), the
+// Node twin of `indus.service.gateway_control`. One exchange per connection: one JSON line
+// `{protocol: 1, verb, id, params?}` out, one line `{ok, protocol, id, result | error, detail?}`
+// back. The socket is `<profile home>/gateway.sock`; when that path is too long for a Unix socket
+// the daemon binds in a private directory and leaves `<home>/gateway.sock.path`, which is followed
+// only when the pointer is our own regular file with no group/other bits and its target's
+// directory is ours with mode 0700. A home other users can write to is refused before connecting
+// (they could swap the socket). Windows has no control socket (D-16.55).
+
+import fs from "node:fs";
+import net from "node:net";
+import path from "node:path";
+
+export const SOCKET_FILE = "gateway.sock";
+export const POINTER_FILE = "gateway.sock.path";
+export const MAX_SOCKET_PATH = 100;
+export const CONTROL_TIMEOUT_MS = 2_000;
+export const TICKET_TIMEOUT_MS = 5_000;
+export const WS_INTERACTIVE = "ws-interactive";
+const MAX_ANSWER_BYTES = 512 * 1024;
+
+export interface ControlReply {
+  ok: boolean;
+  result?: Record<string, unknown>;
+  /** `unsafe_home`, `no_socket`, `unreachable`, `timeout`, `bad_response`, or the daemon's code. */
+  error?: string;
+  detail?: string;
+}
+
+export interface MintedTicket {
+  ticket: string;
+  wsUrl: string;
+  profileId: string;
+  instanceId: string;
+  expiresInMs: number;
+}
+
+export type MintReply =
+  | ({ ok: true } & MintedTicket)
+  | { ok: false; error: string; detail: string };
+
+function uid(): number | null {
+  return typeof process.getuid === "function" ? process.getuid() : null;
+}
+
+function ownedPrivate(info: fs.Stats, kind: "file" | "dir"): boolean {
+  const me = uid();
+  const right = kind === "file" ? info.isFile() : info.isDirectory();
+  return right && (me === null || info.uid === me) && (info.mode & 0o077) === 0;
+}
+
+/** We own `home` and nobody else may write to it. */
+export function homeIsSafe(home: string): boolean {
+  let info: fs.Stats;
+  try {
+    info = fs.statSync(home);
+  } catch {
+    return false;
+  }
+  const me = uid();
+  if (!info.isDirectory() || (me !== null && info.uid !== me)) return false;
+  return (info.mode & 0o022) === 0;
+}
+
+/** Where to connect for `home`: the direct socket, a trusted pointer's target, or null. */
+export function socketPathFor(home: string): string | null {
+  const direct = path.join(home, SOCKET_FILE);
+  try {
+    if (fs.lstatSync(direct).isSocket()) return direct;
+  } catch {
+    // no direct socket; try the pointer
+  }
+  const pointer = path.join(home, POINTER_FILE);
+  try {
+    if (!ownedPrivate(fs.lstatSync(pointer), "file")) return null;
+    const target = fs.readFileSync(pointer, "utf8").trim();
+    if (!path.isAbsolute(target)) return null;
+    if (!ownedPrivate(fs.lstatSync(path.dirname(target)), "dir")) return null;
+    return fs.lstatSync(target).isSocket() ? target : null;
+  } catch {
+    return null;
+  }
+}
+
+function connect(file: string): net.Socket {
+  if (Buffer.byteLength(file) <= MAX_SOCKET_PATH) return net.connect(file);
+  // A direct socket in a long home (the test fake binds like this): connect by a relative name
+  // from its directory, switching the working directory for the one synchronous connect call.
+  const before = process.cwd();
+  process.chdir(path.dirname(file));
+  try {
+    return net.connect(path.basename(file));
+  } finally {
+    process.chdir(before);
+  }
+}
+
+let ids = 0;
+
+/** Ask the daemon serving `home`. Never throws: local problems come back as error codes. */
+export function controlQuery(
+  home: string,
+  verb: string,
+  params?: Record<string, unknown>,
+  timeoutMs = CONTROL_TIMEOUT_MS,
+): Promise<ControlReply> {
+  if (process.platform === "win32") {
+    return Promise.resolve({
+      ok: false,
+      error: "unsupported",
+      detail: "no control socket on Windows",
+    });
+  }
+  if (!homeIsSafe(home)) return Promise.resolve({ ok: false, error: "unsafe_home" });
+  const file = socketPathFor(home);
+  if (file === null) return Promise.resolve({ ok: false, error: "no_socket" });
+  return new Promise((resolve) => {
+    let data = "";
+    let done = false;
+    let socket: net.Socket;
+    const finish = (reply: ControlReply) => {
+      if (done) return;
+      done = true;
+      clearTimeout(timer);
+      socket?.destroy();
+      resolve(reply);
+    };
+    const timer = setTimeout(() => finish({ ok: false, error: "timeout" }), timeoutMs);
+    try {
+      socket = connect(file);
+    } catch {
+      finish({ ok: false, error: "unreachable" });
+      return;
+    }
+    socket.setEncoding("utf8");
+    socket.on("connect", () => {
+      ids += 1;
+      const request: Record<string, unknown> = { protocol: 1, verb, id: `d${ids}` };
+      if (params !== undefined) request.params = params;
+      socket.write(`${JSON.stringify(request)}\n`);
+    });
+    socket.on("data", (chunk: string) => {
+      data += chunk;
+      if (data.length > MAX_ANSWER_BYTES) {
+        finish({ ok: false, error: "bad_response", detail: "the answer is too long" });
+        return;
+      }
+      const newline = data.indexOf("\n");
+      if (newline >= 0) finish(decode(data.slice(0, newline)));
+    });
+    socket.on("error", () => finish({ ok: false, error: "unreachable" }));
+    socket.on("close", () =>
+      finish(data.trim() === "" ? { ok: false, error: "unreachable" } : decode(data)),
+    );
+  });
+}
+
+function decode(line: string): ControlReply {
+  let answer: unknown;
+  try {
+    answer = JSON.parse(line);
+  } catch {
+    return { ok: false, error: "bad_response", detail: "the answer is not JSON" };
+  }
+  if (answer === null || typeof answer !== "object") return { ok: false, error: "bad_response" };
+  const record = answer as Record<string, unknown>;
+  if (record.ok === true) {
+    const result = record.result;
+    if (result === null || typeof result !== "object") return { ok: false, error: "bad_response" };
+    return { ok: true, result: result as Record<string, unknown> };
+  }
+  return {
+    ok: false,
+    error: typeof record.error === "string" && record.error !== "" ? record.error : "failed",
+    detail: typeof record.detail === "string" ? record.detail : "",
+  };
+}
+
+const LOOPBACK = new Set(["127.0.0.1", "[::1]", "localhost"]);
+
+/** `ws://` on a loopback address with a port, no user-info, query or fragment. */
+export function wsUrlIsSafe(url: unknown): url is string {
+  if (typeof url !== "string" || url === "") return false;
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return false;
+  }
+  return (
+    (parsed.protocol === "ws:" || parsed.protocol === "wss:") &&
+    LOOPBACK.has(parsed.hostname) &&
+    parsed.port !== "" &&
+    parsed.username === "" &&
+    parsed.password === "" &&
+    parsed.search === "" &&
+    parsed.hash === ""
+  );
+}
+
+export function looksLikeTicket(value: unknown): value is string {
+  return typeof value === "string" && /^[A-Za-z0-9_-]{43}$/.test(value);
+}
+
+/** A live daemon's identity (an answer IS liveness), or null. */
+export async function identify(home: string, timeoutMs = CONTROL_TIMEOUT_MS) {
+  const reply = await controlQuery(home, "identify", undefined, timeoutMs);
+  if (!reply.ok || reply.result === undefined) return null;
+  const pid = reply.result.pid;
+  return typeof pid === "number" && Number.isInteger(pid) && pid > 0 ? reply.result : null;
+}
+
+/** Mint one `ws-interactive` ticket; the answer must name the profile and instance we expect. */
+export async function mintTicket(
+  home: string,
+  expect: { profileId?: string; instanceId?: string },
+  query: typeof controlQuery = controlQuery,
+): Promise<MintReply> {
+  const params: Record<string, unknown> = { purpose: WS_INTERACTIVE };
+  if (expect.profileId !== undefined) params.profile_id = expect.profileId;
+  if (expect.instanceId !== undefined) params.instance_id = expect.instanceId;
+  const reply = await query(home, "session-ticket", params, TICKET_TIMEOUT_MS);
+  if (!reply.ok || reply.result === undefined) {
+    return { ok: false, error: reply.error ?? "failed", detail: reply.detail ?? "" };
+  }
+  const r = reply.result;
+  if (!looksLikeTicket(r.ticket)) return { ok: false, error: "bad_response", detail: "no ticket" };
+  if (!wsUrlIsSafe(r.ws_url)) {
+    return { ok: false, error: "bad_response", detail: "the ws_url is not a loopback URL" };
+  }
+  if (typeof r.profile_id !== "string" || typeof r.instance_id !== "string") {
+    return { ok: false, error: "bad_response", detail: "the answer names no profile" };
+  }
+  if (expect.profileId !== undefined && r.profile_id !== expect.profileId) {
+    return { ok: false, error: "profile_mismatch", detail: "another profile answered" };
+  }
+  if (expect.instanceId !== undefined && r.instance_id !== expect.instanceId) {
+    return { ok: false, error: "stale_instance", detail: "the daemon restarted" };
+  }
+  const seconds =
+    typeof r.expires_in === "number" && Number.isFinite(r.expires_in) ? r.expires_in : 30;
+  return {
+    ok: true,
+    ticket: r.ticket,
+    wsUrl: r.ws_url,
+    profileId: r.profile_id,
+    instanceId: r.instance_id,
+    expiresInMs: Math.round(seconds * 1000),
+  };
+}
