new file mode 100644
index 0000000..195d2db
--- /dev/null
+++ b/apps/desktop/electron/backend/remote.test.ts
@@ -0,0 +1,186 @@
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import http from "node:http";
+import type net from "node:net";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { cleanupFakes, tempDir } from "../../testing/fakeIndus.ts";
+import {
+  classifyStatus,
+  normalizeRemoteUrl,
+  REMOTE_FILE,
+  REMOTE_TOKEN_SECRET,
+  RemoteStore,
+  RemoteUrlError,
+  remoteWsUrl,
+} from "./remote.ts";
+
+const servers: http.Server[] = [];
+afterAll(() => {
+  for (const server of servers) server.close();
+  cleanupFakes();
+});
+
+const TOKEN = ["remote", "test", "credential", "value"].join("-");
+
+interface ServerOptions {
+  authRequired?: boolean;
+  configStatus?: number;
+  /** close code for the WS leg, or 0 to send a ready frame */
+  wsClose?: number;
+  wsAcceptToken?: string;
+}
+
+function frame(opcode: number, payload: Buffer): Buffer {
+  return Buffer.concat([Buffer.from([0x80 | opcode, payload.length]), payload]);
+}
+
+async function server(options: ServerOptions = {}): Promise<{ url: string; seen: string[] }> {
+  const seen: string[] = [];
+  const srv = http.createServer((request, response) => {
+    seen.push(
+      `${request.method} ${request.url} token=${String(request.headers["x-indus-session-token"] ?? "")}`,
+    );
+    response.setHeader("content-type", "application/json");
+    if (request.url === "/api/status") {
+      response.end(JSON.stringify({ status: "ok", auth_required: options.authRequired === true }));
+      return;
+    }
+    if (request.headers["x-indus-session-token"] !== TOKEN) {
+      response.writeHead(401).end('{"error": "unauthenticated"}');
+      return;
+    }
+    response.writeHead(options.configStatus ?? 200).end("{}");
+  });
+  srv.on("upgrade", (request, socket: net.Socket) => {
+    const offered = String(request.headers["sec-websocket-protocol"] ?? "")
+      .split(",")
+      .map((p) => p.trim());
+    seen.push(`WS ${request.url} ${offered.join(" ")}`);
+    const accept = createHash("sha1")
+      .update(`${String(request.headers["sec-websocket-key"])}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`)
+      .digest("base64");
+    socket.write(
+      `HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\nSec-WebSocket-Protocol: indus-dashboard-v1\r\n\r\n`,
+    );
+    const good = offered.includes(`indus-dashboard-token.${options.wsAcceptToken ?? TOKEN}`);
+    const code = options.wsClose ?? (good ? 0 : 4401);
+    if (code === 0) socket.write(frame(0x1, Buffer.from('{"jsonrpc":"2.0","method":"ready"}')));
+    else {
+      const payload = Buffer.alloc(2);
+      payload.writeUInt16BE(code, 0);
+      socket.end(frame(0x8, payload));
+    }
+    socket.on("error", () => {});
+  });
+  await new Promise<void>((resolve) => srv.listen(0, "127.0.0.1", resolve));
+  servers.push(srv);
+  return { url: `http://127.0.0.1:${(srv.address() as net.AddressInfo).port}`, seen };
+}
+
+function store() {
+  const userData = tempDir();
+  const secrets = new Map<string, string>();
+  const lines: string[] = [];
+  const remote = new RemoteStore({
+    userData,
+    secrets: {
+      get: (name) => secrets.get(name) ?? null,
+      put: (name, value) => secrets.set(name, value),
+      delete: (name) => secrets.delete(name),
+    },
+    log: (line) => lines.push(line),
+    settleMs: 100,
+    timeoutMs: 3_000,
+  });
+  return { remote, secrets, userData, lines };
+}
+
+describe("remote connection", () => {
+  it("both legs pass → saved; the token goes to the secrets store, not the file", async () => {
+    const s = await server();
+    const { remote, secrets, userData, lines } = store();
+    const result = await remote.save({ url: `${s.url}/`, token: TOKEN });
+    expect(result).toEqual({ ok: true, http: "ok", ws: "ok", saved: true });
+    expect(secrets.get(REMOTE_TOKEN_SECRET)).toBe(TOKEN);
+    const file = fs.readFileSync(path.join(userData, REMOTE_FILE), "utf8");
+    expect(file).not.toContain(TOKEN);
+    expect(JSON.parse(file)).toEqual({ v: 1, url: s.url });
+    expect(fs.statSync(path.join(userData, REMOTE_FILE)).mode & 0o777).toBe(0o600);
+    expect(remote.get()).toEqual({ url: s.url, hasToken: true });
+    expect(remote.saved()).toEqual({ url: s.url, token: TOKEN });
+    expect(lines.join("\n")).not.toContain(TOKEN);
+    // the WS leg offered the dashboard subprotocols with the credential, the URL carried none
+    expect(s.seen).toContain(`WS /api/ws indus-dashboard-v1 indus-dashboard-token.${TOKEN}`);
+  });
+
+  it("HTTP ok + WS 4401 → not saved, error shown", async () => {
+    const s = await server({ wsAcceptToken: "something-else" });
+    const { remote, secrets, userData } = store();
+    const result = await remote.save({ url: s.url, token: TOKEN });
+    expect(result).toMatchObject({ ok: false, http: "ok", ws: "unauthorized", saved: false });
+    expect(result.message).toBe("the server refused this token");
+    expect(secrets.size).toBe(0);
+    expect(fs.existsSync(path.join(userData, REMOTE_FILE))).toBe(false);
+  });
+
+  it("a wrong token is unauthorized on both legs", async () => {
+    const s = await server();
+    const { remote } = store();
+    expect(await remote.test({ url: s.url, token: "wrong-token-value" })).toMatchObject({
+      ok: false,
+      http: "unauthorized",
+      ws: "unauthorized",
+    });
+  });
+
+  it("503 is connectivity, not reauth", async () => {
+    const s = await server({ configStatus: 503 });
+    const { remote } = store();
+    const result = await remote.test({ url: s.url, token: TOKEN });
+    expect(result).toMatchObject({ ok: false, http: "error", ws: "ok" });
+    expect(classifyStatus(503)).toBe("error");
+    expect(classifyStatus(401)).toBe("unauthorized");
+    expect(classifyStatus(403)).toBe("unauthorized");
+    expect(classifyStatus(404)).toBe("ok");
+  });
+
+  it("an unreachable server is unreachable, not unauthorized", async () => {
+    const { remote } = store();
+    expect(await remote.test({ url: "http://127.0.0.1:9", token: TOKEN })).toMatchObject({
+      ok: false,
+      http: "unreachable",
+    });
+  });
+
+  it("a server that wants a sign-in is reported, not saved", async () => {
+    const s = await server({ authRequired: true });
+    const { remote } = store();
+    const result = await remote.save({ url: s.url, token: TOKEN });
+    expect(result.saved).toBe(false);
+    expect(result.message).toContain("sign-in");
+  });
+
+  it("forget clears the URL and the token", async () => {
+    const s = await server();
+    const { remote, secrets } = store();
+    await remote.save({ url: s.url, token: TOKEN });
+    remote.forget();
+    expect(remote.get()).toEqual({ url: null, hasToken: false });
+    expect(secrets.size).toBe(0);
+  });
+
+  it("normalises URLs", () => {
+    expect(normalizeRemoteUrl(" 100.64.0.1:9119 ")).toBe("http://100.64.0.1:9119");
+    expect(normalizeRemoteUrl("https://agent.example.test/indus/")).toBe(
+      "https://agent.example.test/indus",
+    );
+    for (const bad of ["", "ftp://x", "http://u:p@x", "http://x/?a=1", "http://x/#f"]) {
+      expect(() => normalizeRemoteUrl(bad)).toThrow(RemoteUrlError);
+    }
+    expect(remoteWsUrl("https://agent.example.test/indus")).toBe(
+      "wss://agent.example.test/indus/api/ws",
+    );
+    expect(remoteWsUrl("http://127.0.0.1:9119")).toBe("ws://127.0.0.1:9119/api/ws");
+  });
+});
diff --git a/apps/desktop/electron/backend/remote.ts b/apps/desktop/electron/backend/remote.ts
new file mode 100644
index 0000000..b2ec7a2
--- /dev/null
+++ b/apps/desktop/electron/backend/remote.ts
@@ -0,0 +1,251 @@
+// One saved remote connection (P20-11): a URL and a token for an Indus server running elsewhere.
+// Saving needs both legs to pass with the real credential (R08.5): an HTTP call and a WebSocket.
+// Only a confirmed 401/403 (or a 4401/4403 close) means "unauthorized"; timeouts, refused
+// connections and 5xx are connectivity and never ask for a new token (R08.4). The URL lives in
+// `<userData>/remote-connection.json`; the token in the secrets store (P20-07), never in a file in
+// plaintext when the keychain works, never in a log line, never across the bridge.
+
+import fs from "node:fs";
+import path from "node:path";
+import { readJsonFile, writeFileAtomic } from "../fsSecure.ts";
+import { SESSION_TOKEN_HEADER } from "./localAttach.ts";
+import { REMOTE_PROBE_TIMEOUT_MS } from "./remoteLiveness.ts";
+import { DASHBOARD_SUBPROTOCOL, DASHBOARD_TOKEN_PREFIX } from "./tickets.ts";
+
+export const REMOTE_FILE = "remote-connection.json";
+export const REMOTE_TOKEN_SECRET = "remote-connection-token";
+/** How long an opened test socket must stay open (or answer) to count as accepted. */
+export const WS_SETTLE_MS = 1_500;
+
+export type Leg = "ok" | "unauthorized" | "unreachable" | "error";
+
+export interface RemoteTestResult {
+  ok: boolean;
+  http: Leg;
+  ws: Leg;
+  message?: string;
+}
+
+export class RemoteUrlError extends Error {}
+
+/** Trimmed, scheme added to a bare `host:port`, http/https only, no credentials, query or fragment. */
+export function normalizeRemoteUrl(raw: string): string {
+  let value = raw.trim();
+  if (value === "") throw new RemoteUrlError("enter the server's address");
+  if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(value)) value = `http://${value}`;
+  let url: URL;
+  try {
+    url = new URL(value);
+  } catch {
+    throw new RemoteUrlError("that is not a web address");
+  }
+  if (url.protocol !== "http:" && url.protocol !== "https:") {
+    throw new RemoteUrlError("the address must start with http:// or https://");
+  }
+  if (url.username !== "" || url.password !== "") {
+    throw new RemoteUrlError("put the token in the token field, not in the address");
+  }
+  if (url.search !== "" || url.hash !== "") {
+    throw new RemoteUrlError("the address must not carry a query or a fragment");
+  }
+  return `${url.origin}${url.pathname.replace(/\/+$/, "")}`;
+}
+
+/** The server's WebSocket endpoint for a base URL (a path prefix is kept). */
+export function remoteWsUrl(base: string): string {
+  const url = new URL(base);
+  url.protocol = url.protocol === "https:" ? "wss:" : "ws:";
+  url.pathname = `${url.pathname.replace(/\/+$/, "")}/api/ws`;
+  return url.toString();
+}
+
+export function classifyStatus(status: number): Leg {
+  if (status === 401 || status === 403) return "unauthorized";
+  if (status >= 200 && status < 300) return "ok";
+  // the gate answers 401 before routing, so a 404 behind it means the credential passed
+  if (status === 404) return "ok";
+  return "error";
+}
+
+export function isReauth(leg: Leg): boolean {
+  return leg === "unauthorized";
+}
+
+export interface WebSocketLike {
+  addEventListener(
+    type: "open" | "message" | "close" | "error",
+    listener: (event: unknown) => void,
+  ): void;
+  close(): void;
+}
+
+export interface RemoteDeps {
+  userData: string;
+  secrets: {
+    get(name: string): string | null;
+    put(name: string, value: string): void;
+    delete(name: string): void;
+  };
+  fetch?: typeof fetch;
+  webSocket?: (url: string, protocols: string[]) => WebSocketLike;
+  log: (line: string) => void;
+  timeoutMs?: number;
+  settleMs?: number;
+}
+
+export interface SavedRemote {
+  url: string;
+  token: string;
+}
+
+export class RemoteStore {
+  private readonly deps: RemoteDeps;
+
+  constructor(deps: RemoteDeps) {
+    this.deps = deps;
+  }
+
+  private file(): string {
+    return path.join(this.deps.userData, REMOTE_FILE);
+  }
+
+  private savedUrl(): string | null {
+    const data = readJsonFile(this.file()) as { url?: unknown } | null;
+    return data !== null && typeof data.url === "string" ? data.url : null;
+  }
+
+  get(): { url: string | null; hasToken: boolean } {
+    return { url: this.savedUrl(), hasToken: this.deps.secrets.get(REMOTE_TOKEN_SECRET) !== null };
+  }
+
+  /** The saved remote with its token (main only), or null. */
+  saved(): SavedRemote | null {
+    const url = this.savedUrl();
+    const token = this.deps.secrets.get(REMOTE_TOKEN_SECRET);
+    return url === null || token === null ? null : { url, token };
+  }
+
+  async test(input: { url: string; token: string }): Promise<RemoteTestResult> {
+    const base = normalizeRemoteUrl(input.url);
+    const timeout = this.deps.timeoutMs ?? REMOTE_PROBE_TIMEOUT_MS;
+    const get = (route: string, headers: Record<string, string> = {}) =>
+      (this.deps.fetch ?? fetch)(`${base}${route}`, {
+        headers: { Accept: "application/json", ...headers },
+        signal: AbortSignal.timeout(timeout),
+        redirect: "error",
+      });
+
+    // the public status says how this server authenticates
+    let status: Response;
+    try {
+      status = await get("/api/status");
+    } catch {
+      return { ok: false, http: "unreachable", ws: "error", message: "the server did not answer" };
+    }
+    if (status.status !== 200) {
+      await status.body?.cancel();
+      return {
+        ok: false,
+        http: classifyStatus(status.status) === "ok" ? "error" : classifyStatus(status.status),
+        ws: "error",
+        message: `the server's status page answered ${status.status}`,
+      };
+    }
+    const body = (await status.json().catch(() => null)) as { auth_required?: unknown } | null;
+    if (body?.auth_required === true) {
+      return {
+        ok: false,
+        http: "unauthorized",
+        ws: "error",
+        message: "this server asks for a sign-in, which this version of the app cannot do yet",
+      };
+    }
+
+    let http: Leg;
+    try {
+      const response = await get("/api/config", { [SESSION_TOKEN_HEADER]: input.token });
+      await response.body?.cancel();
+      http = classifyStatus(response.status);
+    } catch {
+      http = "unreachable";
+    }
+    const ws = await this.wsLeg(base, input.token, timeout);
+    const ok = http === "ok" && ws === "ok";
+    const result: RemoteTestResult = { ok, http, ws };
+    if (!ok) result.message = describe(http, ws);
+    return result;
+  }
+
+  private wsLeg(base: string, token: string, timeout: number): Promise<Leg> {
+    const settle = this.deps.settleMs ?? WS_SETTLE_MS;
+    return new Promise((resolve) => {
+      let opened = false;
+      let done = false;
+      let socket: WebSocketLike;
+      const finish = (leg: Leg) => {
+        if (done) return;
+        done = true;
+        clearTimeout(deadline);
+        clearTimeout(settled);
+        try {
+          socket.close();
+        } catch {
+          // already closed
+        }
+        resolve(leg);
+      };
+      let settled: ReturnType<typeof setTimeout> | undefined;
+      const deadline = setTimeout(() => finish(opened ? "ok" : "unreachable"), timeout);
+      try {
+        socket = (this.deps.webSocket ?? ((url, protocols) => new WebSocket(url, protocols)))(
+          remoteWsUrl(base),
+          [DASHBOARD_SUBPROTOCOL, `${DASHBOARD_TOKEN_PREFIX}${token}`],
+        );
+      } catch {
+        finish("error");
+        return;
+      }
+      socket.addEventListener("open", () => {
+        opened = true;
+        settled = setTimeout(() => finish("ok"), settle);
+      });
+      socket.addEventListener("message", () => finish("ok"));
+      socket.addEventListener("close", (event) => {
+        const code = (event as { code?: number }).code ?? 0;
+        if (code === 4401 || code === 4403) finish("unauthorized");
+        else finish(opened && code === 1000 ? "ok" : opened ? "error" : "unreachable");
+      });
+      socket.addEventListener("error", () => {
+        if (!opened) finish("unreachable");
+      });
+    });
+  }
+
+  /** Test, and save only when both legs pass. */
+  async save(input: {
+    url: string;
+    token: string;
+  }): Promise<RemoteTestResult & { saved: boolean }> {
+    const result = await this.test(input);
+    if (!result.ok) return { ...result, saved: false };
+    const url = normalizeRemoteUrl(input.url);
+    this.deps.secrets.put(REMOTE_TOKEN_SECRET, input.token);
+    fs.mkdirSync(this.deps.userData, { recursive: true });
+    writeFileAtomic(this.file(), `${JSON.stringify({ v: 1, url })}\n`, { mode: 0o600 });
+    this.deps.log(`[remote] saved the remote connection to ${new URL(url).host}`);
+    return { ...result, saved: true };
+  }
+
+  forget(): void {
+    this.deps.secrets.delete(REMOTE_TOKEN_SECRET);
+    fs.rmSync(this.file(), { force: true });
+    this.deps.log("[remote] forgot the remote connection");
+  }
+}
+
+function describe(http: Leg, ws: Leg): string {
+  if (http === "unauthorized" || ws === "unauthorized") return "the server refused this token";
+  if (http === "unreachable" || ws === "unreachable") return "the server could not be reached";
+  if (http === "ok") return "the server answered over HTTP, but its WebSocket did not work";
+  return "the server answered with an error";
+}
diff --git a/apps/desktop/electron/backend/remoteLiveness.test.ts b/apps/desktop/electron/backend/remoteLiveness.test.ts
new file mode 100644
index 0000000..ef0e556
--- /dev/null
+++ b/apps/desktop/electron/backend/remoteLiveness.test.ts
@@ -0,0 +1,89 @@
+import { describe, expect, it } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import {
+  LivenessTracker,
+  REMOTE_FAILURE_WINDOW_MS,
+  REMOTE_PROBE_TIMEOUT_MS,
+  RESUME_REVALIDATION_HOLD_MS,
+  ResumeGate,
+} from "./remoteLiveness.ts";
+
+const tick = () => new Promise((resolve) => setTimeout(resolve, 0));
+
+describe("remote liveness", () => {
+  it("constants", () => {
+    expect(REMOTE_PROBE_TIMEOUT_MS).toBe(10_000);
+    expect(REMOTE_FAILURE_WINDOW_MS).toBe(60_000);
+    expect(RESUME_REVALIDATION_HOLD_MS).toBe(15_000);
+  });
+
+  it("the 3rd failure within 60 s marks the route dead (fake clock)", () => {
+    const timers = new FakeTimers();
+    const tracker = new LivenessTracker(timers.clock);
+    expect(tracker.recordFailure("r")).toEqual({ failures: 1, dead: false });
+    timers.advance(20_000);
+    expect(tracker.recordFailure("r")).toEqual({ failures: 2, dead: false });
+    timers.advance(20_000);
+    expect(tracker.recordFailure("r")).toEqual({ failures: 3, dead: true });
+    // counting starts over after a dead verdict
+    expect(tracker.recordFailure("r")).toEqual({ failures: 1, dead: false });
+  });
+
+  it("failures spread wider than 60 s, or a success between them, do not kill the route", () => {
+    const timers = new FakeTimers();
+    const tracker = new LivenessTracker(timers.clock);
+    tracker.recordFailure("r");
+    timers.advance(REMOTE_FAILURE_WINDOW_MS + 1);
+    expect(tracker.recordFailure("r").failures).toBe(1);
+    tracker.recordFailure("r");
+    tracker.recordSuccess("r");
+    expect(tracker.recordFailure("r")).toEqual({ failures: 1, dead: false });
+    // routes are counted apart
+    expect(tracker.recordFailure("other").failures).toBe(1);
+  });
+
+  it("a resume holds revalidation 15 s and coalesces each window's requests", async () => {
+    const timers = new FakeTimers();
+    const gate = new ResumeGate(timers, timers.clock);
+    const runs: string[] = [];
+    gate.noteResume();
+    const a1 = gate.request("win-1", async () => {
+      runs.push("win-1 first");
+    });
+    const a2 = gate.request("win-1", async () => {
+      runs.push("win-1 second");
+    });
+    const b = gate.request("win-2", async () => {
+      runs.push("win-2");
+    });
+    timers.advance(RESUME_REVALIDATION_HOLD_MS - 1);
+    await tick();
+    expect(runs).toEqual([]);
+    timers.advance(1);
+    await Promise.all([a1, a2, b]);
+    // one run per window, the latest request's work
+    expect(runs.sort()).toEqual(["win-1 second", "win-2"]);
+  });
+
+  it("without a hold, a request joins the run already in flight for its window", async () => {
+    const timers = new FakeTimers();
+    const gate = new ResumeGate(timers, timers.clock);
+    let calls = 0;
+    let release: () => void = () => {};
+    const run = () =>
+      new Promise<void>((resolve) => {
+        calls += 1;
+        release = resolve;
+      });
+    const first = gate.request("w", run);
+    const second = gate.request("w", run);
+    await tick();
+    expect(calls).toBe(1);
+    release();
+    await Promise.all([first, second]);
+    await gate.request("w", async () => {
+      calls += 1;
+    });
+    expect(calls).toBe(2);
+  });
+});
diff --git a/apps/desktop/electron/backend/remoteLiveness.ts b/apps/desktop/electron/backend/remoteLiveness.ts
new file mode 100644
index 0000000..e9491b9
--- /dev/null
+++ b/apps/desktop/electron/backend/remoteLiveness.ts
@@ -0,0 +1,109 @@
+// Liveness of the saved remote (P20-11). A probe gets 10,000 ms; 3 failures within 60,000 ms mark
+// the route dead (the orchestrator then reconnects); a success clears the count. After a power
+// resume, revalidation is held for 15,000 ms (networks come back slowly) and every window's
+// requests during the hold coalesce into one run per window.
+
+export const REMOTE_PROBE_TIMEOUT_MS = 10_000;
+export const REMOTE_FAILURE_LIMIT = 3;
+export const REMOTE_FAILURE_WINDOW_MS = 60_000;
+export const RESUME_REVALIDATION_HOLD_MS = 15_000;
+
+export interface Timers {
+  setTimeout(fn: () => void, ms: number): unknown;
+  clearTimeout(handle: unknown): void;
+}
+
+export class LivenessTracker {
+  private readonly failures = new Map<string, { count: number; last: number }>();
+  private readonly now: () => number;
+
+  constructor(now: () => number = Date.now) {
+    this.now = now;
+  }
+
+  recordSuccess(key: string): void {
+    this.failures.delete(key);
+  }
+
+  /** Count one failed probe; `dead` once the 3rd lands within 60 s of the previous one. */
+  recordFailure(key: string): { failures: number; dead: boolean } {
+    const now = this.now();
+    const previous = this.failures.get(key);
+    const count =
+      previous !== undefined && now - previous.last <= REMOTE_FAILURE_WINDOW_MS
+        ? previous.count + 1
+        : 1;
+    const dead = count >= REMOTE_FAILURE_LIMIT;
+    if (dead) this.failures.delete(key);
+    else this.failures.set(key, { count, last: now });
+    return { failures: count, dead };
+  }
+}
+
+/** Holds revalidation after a resume and coalesces requests per window. */
+export class ResumeGate {
+  private readonly timers: Timers;
+  private readonly now: () => number;
+  private holdUntil = 0;
+  private holdTimer: unknown = null;
+  private readonly waiting = new Map<
+    string,
+    { run: () => Promise<void>; done: Array<() => void> }
+  >();
+  private readonly inFlight = new Map<string, Promise<void>>();
+
+  constructor(timers: Timers, now: () => number = Date.now) {
+    this.timers = timers;
+    this.now = now;
+  }
+
+  holding(): boolean {
+    return this.now() < this.holdUntil;
+  }
+
+  /** The machine woke up: hold revalidation for 15 s from now. */
+  noteResume(): void {
+    this.holdUntil = this.now() + RESUME_REVALIDATION_HOLD_MS;
+    if (this.holdTimer !== null) this.timers.clearTimeout(this.holdTimer);
+    this.holdTimer = this.timers.setTimeout(() => this.release(), RESUME_REVALIDATION_HOLD_MS);
+  }
+
+  /**
+   * Revalidate for `key` (a window): during a hold the request waits for the hold to end and
+   * joins any earlier request of the same window; otherwise it joins a run already in flight.
+   */
+  request(key: string, run: () => Promise<void>): Promise<void> {
+    if (this.holding()) {
+      return new Promise((resolve) => {
+        const entry = this.waiting.get(key);
+        if (entry !== undefined) {
+          entry.run = run;
+          entry.done.push(resolve);
+        } else this.waiting.set(key, { run, done: [resolve] });
+      });
+    }
+    return this.start(key, run);
+  }
+
+  private start(key: string, run: () => Promise<void>): Promise<void> {
+    const existing = this.inFlight.get(key);
+    if (existing !== undefined) return existing;
+    const pending = Promise.resolve()
+      .then(run)
+      .catch(() => {})
+      .finally(() => this.inFlight.delete(key));
+    this.inFlight.set(key, pending);
+    return pending;
+  }
+
+  private release(): void {
+    this.holdTimer = null;
+    const entries = [...this.waiting.entries()];
+    this.waiting.clear();
+    for (const [key, entry] of entries) {
+      void this.start(key, entry.run).then(() => {
+        for (const done of entry.done) done();
+      });
+    }
+  }
+}
