+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { describe, expect, it, vi } from "vitest";
+// @ts-expect-error -- plain JS module without types
+import { renderCatalog as renderUntyped } from "../../scripts/dump-slash-catalog.mjs";
+import {
+  completeSlash,
+  curateCatalog,
+  curateCompletions,
+  isHiddenCommand,
+  isSlashLine,
+  localCommandFor,
+  OFFLINE_CATALOG,
+  offlineCompletions,
+  runSlash,
+  type SlashHost,
+} from "./slash.ts";
+import { FakeConnection, rpcError } from "./testFakes.ts";
+
+const renderCatalog = renderUntyped as (rows: unknown[]) => string;
+
+function host(connection: FakeConnection | null, sessionId: string | null = "s1") {
+  const lines: string[] = [];
+  const submitted: Array<{ text: string; display: string }> = [];
+  const prefilled: string[] = [];
+  const local = {
+    new: vi.fn(),
+    model: vi.fn(),
+    details: vi.fn(),
+    reasoning: vi.fn(),
+    help: vi.fn(),
+  };
+  const value: SlashHost = {
+    request: connection?.request ?? null,
+    sessionId,
+    local,
+    submit: (text, display) => submitted.push({ text, display }),
+    prefill: (text) => prefilled.push(text),
+    show: (text) => lines.push(text),
+  };
+  return { value, lines, submitted, prefilled, local };
+}
+
+describe("slash curation", () => {
+  it("hides only known built-ins without a desktop surface", () => {
+    expect(isHiddenCommand("/clear")).toBe(true); // terminal only
+    expect(isHiddenCommand("quit")).toBe(true);
+    expect(isHiddenCommand("exit")).toBe(true); // alias of a hidden one
+    expect(isHiddenCommand("/sethome")).toBe(true); // messaging only
+    expect(isHiddenCommand("/mouse")).toBe(true); // TUI display toggle
+    expect(isHiddenCommand("/usage")).toBe(false);
+    expect(isHiddenCommand("/details")).toBe(false); // desktop-owned
+    expect(isHiddenCommand("/gif-search")).toBe(false); // unknown: a skill
+    expect(isHiddenCommand("/my-quick-cmd")).toBe(false);
+  });
+
+  it("a new skill command appears in both completion paths", () => {
+    const live = curateCompletions([
+      { text: "/clear", display: "/clear" },
+      { text: "/gif-search", display: "/gif-search", meta: "skill" },
+      { text: "/usage", display: "/usage" },
+    ]);
+    expect(live.map((item) => item.text)).toEqual(["/gif-search", "/usage"]);
+    const catalog = curateCatalog([
+      { name: "quit", description: "x", category: "exit", kind: "builtin", runs: "client" },
+      { name: "gif-search", description: "y", category: "custom", kind: "skill", runs: "server" },
+    ]);
+    expect(catalog.map((entry) => entry.name)).toEqual(["gif-search"]);
+  });
+
+  it("desktop-owned built-ins and their aliases resolve locally", () => {
+    expect(localCommandFor("/reset")).toBe("new");
+    expect(localCommandFor("model")).toBe("model");
+    expect(localCommandFor("/details")).toBe("details");
+    expect(localCommandFor("/usage")).toBeNull();
+  });
+
+  it("offline completion lists desktop commands and the local ones", () => {
+    const items = offlineCompletions("/de").map((item) => item.text);
+    expect(items).toContain("/details");
+    expect(offlineCompletions("/cl").map((item) => item.text)).not.toContain("/clear");
+    expect(offlineCompletions("/he").map((item) => item.text)).toContain("/help");
+    expect(offlineCompletions("not slash")).toEqual([]);
+  });
+
+  it("paths are not command lines", () => {
+    expect(isSlashLine("/help")).toBe(true);
+    expect(isSlashLine("/usr/bin/env python")).toBe(false);
+    expect(isSlashLine("/")).toBe(false);
+  });
+});
+
+describe("running slash commands", () => {
+  it("local built-ins never reach the daemon", async () => {
+    const connection = new FakeConnection();
+    const h = host(connection);
+    expect(await runSlash("/reset", h.value)).toBe("local");
+    expect(await runSlash("/reasoning hide", h.value)).toBe("local");
+    expect(h.local.new).toHaveBeenCalledWith("");
+    expect(h.local.reasoning).toHaveBeenCalledWith("hide");
+    expect(connection.calls).toEqual([]);
+  });
+
+  it("a hidden built-in typed in full is refused without a call", async () => {
+    const connection = new FakeConnection();
+    const h = host(connection);
+    expect(await runSlash("/quit", h.value)).toBe("hidden");
+    expect(h.lines[0]).toContain("not available in the desktop app");
+    expect(connection.calls).toEqual([]);
+  });
+
+  it("a new skill command runs: slash.exec, not owned, command.dispatch, submitted", async () => {
+    const connection = new FakeConnection()
+      .on("slash.exec", () => {
+        throw rpcError("SLASH_NOT_OWNED", "the bridge does not run it");
+      })
+      .on("command.dispatch", () => ({ kind: "skill", message: "Search for a gif of a cat" }));
+    const h = host(connection);
+    expect(await runSlash("/gif-search cat", h.value)).toBe("submitted");
+    expect(connection.calls.map((call) => call.method)).toEqual(["slash.exec", "command.dispatch"]);
+    expect(connection.calls[1]?.params).toEqual({
+      session_id: "s1",
+      name: "gif-search",
+      arg: "cat",
+    });
+    expect(h.submitted).toEqual([
+      { text: "Search for a gif of a cat", display: "/gif-search cat" },
+    ]);
+  });
+
+  it("dispatch only after a not-owned refusal", async () => {
+    const connection = new FakeConnection()
+      .on("slash.exec", () => ({ output: "42 calls so far" }))
+      .on("command.dispatch", () => ({ kind: "exec", output: "never" }));
+    const h = host(connection);
+    expect(await runSlash("/usage", h.value)).toBe("output");
+    expect(connection.called("command.dispatch")).toHaveLength(0);
+    expect(h.lines).toEqual(["42 calls so far"]);
+  });
+
+  it("a worker timeout is shown as itself", async () => {
+    const connection = new FakeConnection().on("slash.exec", () => {
+      throw rpcError("SLASH_WORKER_FAILED", "the command did not answer within 30 s");
+    });
+    const h = host(connection);
+    expect(await runSlash("/curator", h.value)).toBe("failed");
+    expect(h.lines[0]).toBe(
+      "/curator failed or did not answer in time: the command did not answer within 30 s",
+    );
+    expect(connection.called("command.dispatch")).toHaveLength(0);
+  });
+
+  it("an unknown name is reported as unknown", async () => {
+    const connection = new FakeConnection()
+      .on("slash.exec", () => {
+        throw rpcError("SLASH_NOT_OWNED");
+      })
+      .on("command.dispatch", () => {
+        throw rpcError("UNSUPPORTED_COMMAND");
+      });
+    const h = host(connection);
+    expect(await runSlash("/nope", h.value)).toBe("unknown");
+  });
+
+  it("prefill and alias answers", async () => {
+    const connection = new FakeConnection()
+      .on("slash.exec", (params) => {
+        if (params.command === "old") throw rpcError("SLASH_NOT_OWNED");
+        return { prefill: "draft text" };
+      })
+      .on("command.dispatch", () => ({ kind: "alias", target: "/newer" }));
+    const h = host(connection);
+    expect(await runSlash("/old", h.value)).toBe("prefilled");
+    expect(connection.called("slash.exec").map((call) => call.params.command)).toEqual([
+      "old",
+      "newer",
+    ]);
+    expect(h.prefilled).toEqual(["draft text"]);
+  });
+
+  it("server commands need a session", async () => {
+    const h = host(new FakeConnection(), null);
+    expect(await runSlash("/usage", h.value)).toBe("no-session");
+  });
+
+  it("late results after a session switch are dropped", async () => {
+    let current = true;
+    const connection = new FakeConnection().on("slash.exec", () => {
+      current = false;
+      return { output: "late" };
+    });
+    const h = host(connection);
+    const outcome = await runSlash("/usage", { ...h.value, isCurrent: () => current });
+    expect(outcome).toBe("stale");
+    expect(h.lines).toEqual([]);
+  });
+});
+
+describe("slash completion", () => {
+  it("live completion is curated", async () => {
+    const connection = new FakeConnection().on("complete.slash", () => ({
+      items: [
+        { text: "/clear", display: "/clear" },
+        { text: "/codex", display: "/codex", meta: "skill" },
+      ],
+    }));
+    const items = await completeSlash("/c", connection.request, "s1");
+    expect(items.map((item) => item.text)).toEqual(["/codex"]);
+  });
+
+  it("falls back to the offline catalogue when the daemon is unreachable", async () => {
+    const down = new FakeConnection().on("complete.slash", () => {
+      throw new Error("not connected");
+    });
+    const items = await completeSlash("/us", down.request, "s1");
+    expect(items.map((item) => item.text)).toContain("/usage");
+    expect((await completeSlash("/us", null, null)).map((item) => item.text)).toContain("/usage");
+  });
+});
+
+describe("the offline catalogue", () => {
+  it("carries every registry built-in with its desktop flag", () => {
+    const names = OFFLINE_CATALOG.map((command) => command.name);
+    expect(names).toContain("new");
+    expect(OFFLINE_CATALOG.find((command) => command.name === "clear")?.desktop).toBe(false);
+    expect(OFFLINE_CATALOG.find((command) => command.name === "usage")?.desktop).toBe(true);
+  });
+
+  it("the committed JSON matches the renderer of the dump script", () => {
+    const here = path.dirname(fileURLToPath(import.meta.url));
+    const file = path.join(here, "slashCatalog.json");
+    const committed = fs.readFileSync(file, "utf8");
+    const parsed = JSON.parse(committed) as { commands: unknown[] };
+    expect(renderCatalog(parsed.commands)).toBe(committed);
+  });
+
+  it("the dump script --check agrees with the Python registry", () => {
+    const here = path.dirname(fileURLToPath(import.meta.url));
+    const script = path.resolve(here, "..", "..", "scripts", "dump-slash-catalog.mjs");
+    let hasUv = true;
+    try {
+      execFileSync("uv", ["--version"], { stdio: "ignore" });
+    } catch {
+      hasUv = false;
+    }
+    if (!hasUv) return;
+    const out = execFileSync("node", [script, "--check"], { encoding: "utf8" });
+    expect(out).toContain("up to date");
+  }, 120_000);
+});
diff --git a/apps/desktop/src/chat/slash.ts b/apps/desktop/src/chat/slash.ts
new file mode 100644
index 0000000..213ea15
--- /dev/null
+++ b/apps/desktop/src/chat/slash.ts
@@ -0,0 +1,370 @@
+// Slash commands in the desktop (P20-24).
+//
+// Curation hides a KNOWN list only: the built-ins the Python registry does not offer on the
+// `desktop` surface (from the generated `slashCatalog.json`) plus a few terminal display toggles
+// the TUI keeps to itself. Every other name — skill, quick and plugin commands, a built-in added
+// later — passes both completion paths and runs when typed (R08.12).
+//
+// Running a line: a desktop-owned built-in runs locally; anything else goes to `slash.exec`, and
+// only a "not owned" refusal falls back to `command.dispatch` (P12-24's order). A skill or `send`
+// result is a prompt the host submits the normal way.
+
+import type {
+  CatalogEntry,
+  CommandDispatchResult,
+  CompletionItem,
+  MethodName,
+  MethodTypes,
+  SlashExecResult,
+} from "@indus/protocol";
+import type { RequestOptions } from "../gateway/connectionStore.ts";
+import { t } from "../i18n/index.tsx";
+import { errorMessage, errorName } from "./rpcErrors.ts";
+import catalogFile from "./slashCatalog.json" with { type: "json" };
+
+export interface OfflineCommand {
+  readonly name: string;
+  readonly aliases: readonly string[];
+  readonly description: string;
+  readonly category: string;
+  readonly argsHint: string;
+  /** Whether the registry offers it on the desktop surface. */
+  readonly desktop: boolean;
+}
+
+/** Every registry built-in, generated at build time (`scripts/dump-slash-catalog.mjs`). */
+export const OFFLINE_CATALOG: readonly OfflineCommand[] = catalogFile.commands;
+
+/** Built-ins the desktop runs itself, never sending them to the daemon. */
+export const DESKTOP_LOCAL_COMMANDS = ["new", "model", "details", "reasoning", "help"] as const;
+export type LocalCommandName = (typeof DESKTOP_LOCAL_COMMANDS)[number];
+
+/** TUI-local commands that are not registry entries and mean nothing in the desktop. */
+export const EXTRA_HIDDEN: readonly string[] = [
+  "busy",
+  "copy",
+  "image",
+  "logs",
+  "mouse",
+  "paste",
+  "prompt",
+  "redraw",
+  "reload",
+  "statusbar",
+  "theme",
+  "update",
+];
+
+export const MAX_ALIAS_HOPS = 4;
+
+export function normalizeName(word: string): string {
+  return word.trim().replace(/^\//, "").toLowerCase();
+}
+
+const BY_KEY = new Map<string, OfflineCommand>();
+for (const command of OFFLINE_CATALOG) {
+  for (const key of [command.name, ...command.aliases]) BY_KEY.set(key, command);
+}
+const LOCAL = new Set<string>(DESKTOP_LOCAL_COMMANDS);
+const EXTRA = new Set(EXTRA_HIDDEN);
+
+/** The canonical registry name for a name or alias (unknown names come back normalized). */
+export function canonicalName(word: string): string {
+  const name = normalizeName(word);
+  return BY_KEY.get(name)?.name ?? name;
+}
+
+/** The desktop-owned built-in a name or alias names (`/reset` → `new`), or null. */
+export function localCommandFor(word: string): LocalCommandName | null {
+  const name = canonicalName(word);
+  return LOCAL.has(name) ? (name as LocalCommandName) : null;
+}
+
+/** True only for a known built-in with no desktop surface. Unknown names are never hidden. */
+export function isHiddenCommand(word: string): boolean {
+  const name = normalizeName(word);
+  if (name === "") return false;
+  if (localCommandFor(name) !== null) return false;
+  if (EXTRA.has(name)) return true;
+  const known = BY_KEY.get(name);
+  return known !== undefined && !known.desktop;
+}
+
+/** `complete.slash` answers with hidden built-ins removed (first word only). */
+export function curateCompletions(items: readonly CompletionItem[]): CompletionItem[] {
+  return items.filter((item) => {
+    const word = item.text.trim();
+    if (word.includes(" ")) return true;
+    return !isHiddenCommand(word);
+  });
+}
+
+/** `commands.catalog` entries with hidden built-ins removed. */
+export function curateCatalog(entries: readonly CatalogEntry[]): CatalogEntry[] {
+  return entries.filter((entry) => !isHiddenCommand(entry.name));
+}
+
+/** Completion from the generated catalogue, for when the daemon cannot be reached. */
+export function offlineCompletions(text: string): CompletionItem[] {
+  if (!text.startsWith("/") || text.includes(" ")) return [];
+  const typed = normalizeName(text);
+  const items: CompletionItem[] = [];
+  for (const command of OFFLINE_CATALOG) {
+    if (isHiddenCommand(command.name)) continue;
+    if (!command.name.startsWith(typed)) continue;
+    items.push({
+      text: `/${command.name}`,
+      display: `/${command.name}`,
+      meta: command.description,
+    });
+  }
+  for (const name of DESKTOP_LOCAL_COMMANDS) {
+    if (BY_KEY.has(name) || !name.startsWith(typed)) continue;
+    items.push({ text: `/${name}`, display: `/${name}`, meta: t("slash.localMeta") });
+  }
+  return items.sort((a, b) => a.text.localeCompare(b.text));
+}
+
+/** A command line, not a path such as `/usr/bin/env` and not a lone `/`. */
+export function isSlashLine(text: string): boolean {
+  const trimmed = text.trim();
+  if (!trimmed.startsWith("/") || trimmed.length < 2) return false;
+  const first = trimmed.split(/\s/, 1)[0] ?? "";
+  return !first.slice(1).includes("/");
+}
+
+export interface ParsedSlash {
+  readonly name: string;
+  readonly arg: string;
+}
+
+export function parseSlash(line: string): ParsedSlash {
+  const body = line.trim().replace(/^\//, "");
+  const space = body.search(/\s/);
+  if (space < 0) return { name: body.toLowerCase(), arg: "" };
+  return { name: body.slice(0, space).toLowerCase(), arg: body.slice(space + 1).trim() };
+}
+
+type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+export interface SlashHost {
+  /** The connection's call, or null when there is none. */
+  readonly request: Request | null;
+  /** The session commands act on, or null for a fresh draft. */
+  readonly sessionId: string | null;
+  /** The five desktop-owned built-ins. */
+  readonly local: Readonly<Record<LocalCommandName, (arg: string) => void | Promise<void>>>;
+  /** Send `text` as an ordinary prompt; `display` is what the transcript shows. */
+  submit(text: string, display: string): void;
+  /** Put `text` into the composer. */
+  prefill(text: string): void;
+  /** A system line in the conversation. */
+  show(text: string): void;
+  switchSession?(sessionId: string): void;
+  /** False once the person moved to another session: late results are dropped. */
+  isCurrent?(): boolean;
+}
+
+export type SlashOutcome =
+  | "local"
+  | "hidden"
+  | "output"
+  | "submitted"
+  | "prefilled"
+  | "switched"
+  | "unknown"
+  | "failed"
+  | "no-session"
+  | "stale";
+
+/** Run one typed line. */
+export async function runSlash(line: string, host: SlashHost): Promise<SlashOutcome> {
+  return route(parseSlash(line), host, 0);
+}
+
+async function route(parsed: ParsedSlash, host: SlashHost, hops: number): Promise<SlashOutcome> {
+  const { name, arg } = parsed;
+  if (name === "") {
+    host.show(t("slash.empty"));
+    return "unknown";
+  }
+  const local = localCommandFor(name);
+  if (local !== null) {
+    try {
+      await host.local[local](arg);
+    } catch (error) {
+      host.show(t("slash.failed", { name: local, message: errorMessage(error) }));
+      return "failed";
+    }
+    return "local";
+  }
+  if (isHiddenCommand(name)) {
+    host.show(t("slash.notInDesktop", { name }));
+    return "hidden";
+  }
+  if (host.request === null || host.sessionId === null) {
+    host.show(t("slash.needsSession", { name }));
+    return "no-session";
+  }
+  const stale = () => host.isCurrent !== undefined && !host.isCurrent();
+  const command = arg ? `${name} ${arg}` : name;
+  let exec: SlashExecResult & Partial<CommandDispatchResult>;
+  try {
+    exec = await host.request("slash.exec", { session_id: host.sessionId, command });
+  } catch (error) {
+    if (stale()) return "stale";
+    const code = errorName(error);
+    if (code === "SLASH_NOT_OWNED") return dispatch(parsed, host, hops, errorMessage(error));
+    return reportFailure(name, error, host);
+  }
+  if (stale()) return "stale";
+  if (typeof exec.kind === "string") {
+    return settleDispatch(exec as CommandDispatchResult, parsed, host, hops);
+  }
+  let outcome: SlashOutcome | null = null;
+  if (exec.output) {
+    host.show(exec.output);
+    outcome = "output";
+  }
+  if (exec.prefill) {
+    host.prefill(exec.prefill);
+    outcome = "prefilled";
+  }
+  if (exec.submit) {
+    host.submit(exec.submit, `/${command}`);
+    outcome = "submitted";
+  }
+  if (exec.switch_to) {
+    if (host.switchSession) host.switchSession(exec.switch_to);
+    else host.show(t("slash.switchAsked", { name, session: exec.switch_to }));
+    outcome = "switched";
+  }
+  if (outcome === null) {
+    host.show(t("slash.done", { name }));
+    return "output";
+  }
+  return outcome;
+}
+
+function reportFailure(name: string, error: unknown, host: SlashHost): SlashOutcome {
+  const code = errorName(error);
+  if (code === "UNSUPPORTED_COMMAND") {
+    host.show(t("slash.unknown", { name }));
+    return "unknown";
+  }
+  if (code === "SLASH_WORKER_FAILED") {
+    // A crash or timeout of the command's worker is reported as exactly that.
+    host.show(t("slash.workerFailed", { name, message: errorMessage(error) }));
+    return "failed";
+  }
+  host.show(t("slash.failed", { name, message: errorMessage(error) }));
+  return "failed";
+}
+
+async function dispatch(
+  parsed: ParsedSlash,
+  host: SlashHost,
+  hops: number,
+  refusal: string,
+): Promise<SlashOutcome> {
+  const { name, arg } = parsed;
+  const request = host.request;
+  const sessionId = host.sessionId;
+  if (request === null || sessionId === null) return "no-session";
+  let result: CommandDispatchResult;
+  try {
+    result = await request("command.dispatch", { session_id: sessionId, name, arg });
+  } catch (error) {
+    if (host.isCurrent !== undefined && !host.isCurrent()) return "stale";
+    if (errorName(error) === "UNSUPPORTED_COMMAND") {
+      host.show(t("slash.unknownWithReason", { name, message: refusal }));
+      return "unknown";
+    }
+    return reportFailure(name, error, host);
+  }
+  if (host.isCurrent !== undefined && !host.isCurrent()) return "stale";
+  return settleDispatch(result, parsed, host, hops);
+}
+
+async function settleDispatch(
+  result: CommandDispatchResult,
+  parsed: ParsedSlash,
+  host: SlashHost,
+  hops: number,
+): Promise<SlashOutcome> {
+  const { name, arg } = parsed;
+  const typed = `/${name}${arg ? ` ${arg}` : ""}`;
+  const message = result.message ?? "";
+  switch (result.kind) {
+    case "exec":
+    case "plugin":
+      host.show(result.output || t("slash.done", { name }));
+      return "output";
+    case "alias":
+      if (!result.target || hops >= MAX_ALIAS_HOPS) {
+        host.show(t("slash.aliasLoop", { name }));
+        return "failed";
+      }
+      return route({ name: normalizeName(result.target), arg }, host, hops + 1);
+    case "skill":
+    case "send":
+      if (!message.trim()) {
+        host.show(t("slash.nothingToSend", { name }));
+        return "failed";
+      }
+      host.submit(message, typed);
+      return "submitted";
+    case "prefill":
+      host.prefill(message);
+      return "prefilled";
+    default:
+      host.show(t("slash.strangeAnswer", { name }));
+      return "failed";
+  }
+}
+
+/**
+ * Slash completion for the composer: the daemon's `complete.slash` (curated), else the offline
+ * catalogue when there is no connection or the call fails.
+ */
+export async function completeSlash(
+  text: string,
+  request: Request | null,
+  sessionId: string | null,
+  signal?: AbortSignal,
+): Promise<CompletionItem[]> {
+  if (request === null) return offlineCompletions(text);
+  try {
+    const answer = await request(
+      "complete.slash",
+      { text, session_id: sessionId },
+      signal === undefined ? { timeoutMs: 10_000 } : { timeoutMs: 10_000, signal },
+    );
+    return curateCompletions(answer.items);
+  } catch (error) {
+    if (signal?.aborted) return [];
+    if (errorName(error) !== undefined && errorName(error) !== "METHOD_NOT_FOUND") return [];
+    return offlineCompletions(text);
+  }
+}
+
+/** Lines for `/help`: the curated catalogue, grouped by category in its order. */
+export function helpLines(entries: readonly CatalogEntry[]): string[] {
+  const groups = new Map<string, string[]>();
+  for (const entry of curateCatalog(entries)) {
+    const rows = groups.get(entry.category) ?? [];
+    rows.push(
+      `/${entry.name}${entry.args_hint ? ` ${entry.args_hint}` : ""} — ${entry.description}`,
+    );
+    groups.set(entry.category, rows);
+  }
+  const lines: string[] = [];
+  for (const [category, rows] of groups) {
+    lines.push(`${category}:`, ...rows.map((row) => `  ${row}`));
+  }
+  return lines;
+}
