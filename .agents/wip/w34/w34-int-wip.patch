+    render(
+      <CardStack
+        sessionId="s1"
+        requests={[open("sudo", { request_id: "u1", reason }, answers)]}
+        connection={null}
+      />,
+    );
+    expect(screen.getByTestId("sudo-reason").textContent).toBe(reason);
+    expect(screen.getByTestId("sudo-reason").className).toContain("select-text");
+    const backdrop = document.querySelector("[data-backdrop]") as HTMLElement;
+    expect(backdrop.className).not.toMatch(/blur/);
+    fireEvent.change(screen.getByLabelText("Password"), { target: { value: "pw" } });
+    fireEvent.click(screen.getByRole("button", { name: "Continue" }));
+    expect(answers).toEqual([{ kind: "sudo", password: "pw" }]);
+  });
+
+  it("secret dialog writes only through the answer, never to storage", () => {
+    const answers: ServerRequestAnswer[] = [];
+    localStorage.clear();
+    sessionStorage.clear();
+    render(
+      <CardStack
+        sessionId="s1"
+        requests={[
+          open("secret", { request_id: "k1", name: "SERVICE_TOKEN", prompt: "Paste it" }, answers),
+        ]}
+        connection={null}
+      />,
+    );
+    const value = ["v", "a", "l", "u", "e"].join("");
+    fireEvent.change(screen.getByLabelText("Value for SERVICE_TOKEN"), { target: { value } });
+    fireEvent.click(screen.getByRole("button", { name: "Save" }));
+    expect(answers).toEqual([{ kind: "secret", value }]);
+    expect(localStorage.length).toBe(0);
+    expect(sessionStorage.length).toBe(0);
+  });
+});
+
+/** A transport whose frames the test reads and whose inbound side the test drives. */
+class TestTransport implements Transport {
+  readonly sent: OutboundFrame[] = [];
+  private onMessage: ((frame: unknown) => void) | null = null;
+  send(frame: OutboundFrame): void {
+    this.sent.push(frame);
+  }
+  close(): void {}
+  onFrame(listener: (frame: unknown) => void) {
+    this.onMessage = listener;
+    return () => {
+      this.onMessage = null;
+    };
+  }
+  onClose() {
+    return () => {};
+  }
+  deliver(frame: unknown) {
+    this.onMessage?.(frame);
+  }
+}
+
+describe("server requests through the client channel", () => {
+  it("handles exactly the four card kinds", () => {
+    expect(Object.keys(new ServerRequestStore().handlers()).sort()).toEqual([...CARD_KINDS].sort());
+  });
+
+  it("an unknown kind is refused with -32601 at once", async () => {
+    const store = new ServerRequestStore();
+    const transport = new TestTransport();
+    const channel = new RpcChannel();
+    channel.setHandlers({ serverRequests: store.handlers() });
+    channel.attach(transport as never);
+    transport.deliver({
+      jsonrpc: "2.0",
+      method: "server_request",
+      params: {
+        request: { request_id: "p1", session_id: "s1", kind: "preview.act" },
+        replayed: false,
+        generation: 2,
+      },
+    });
+    await Promise.resolve();
+    expect(transport.sent).toContainEqual(
+      expect.objectContaining({ id: "p1", error: expect.objectContaining({ code: -32601 }) }),
+    );
+    expect(store.list("s1")).toEqual([]);
+  });
+
+  it("a request settled from another surface closes its card", async () => {
+    const store = new ServerRequestStore();
+    const transport = new TestTransport();
+    const channel = new RpcChannel();
+    channel.setHandlers({ serverRequests: store.handlers() });
+    channel.attach(transport as never);
+    render(
+      <ServerRequestStoreProvider value={store}>
+        <CardStack sessionId="s1" connection={null} armMs={0} />
+      </ServerRequestStoreProvider>,
+    );
+    await act(async () => {
+      transport.deliver({
+        jsonrpc: "2.0",
+        method: "server_request",
+        params: {
+          request: {
+            request_id: "r9",
+            session_id: "s1",
+            kind: "approval",
+            command: "make deploy",
+            description: "Deploys",
+            choices: ["once", "deny"],
+          },
+          replayed: false,
+          generation: 5,
+        },
+      });
+    });
+    expect(screen.getByText("make deploy")).toBeTruthy();
+    await act(async () => {
+      transport.deliver({
+        jsonrpc: "2.0",
+        method: "request.settled",
+        params: {
+          type: "request.settled",
+          session_id: "s1",
+          seq: 1,
+          request_id: "r9",
+          kind: "approval",
+          outcome: "answered",
+        },
+      });
+    });
+    expect(screen.queryByText("make deploy")).toBeNull();
+  });
+});
diff --git a/apps/desktop/src/chat/cards/CardStack.tsx b/apps/desktop/src/chat/cards/CardStack.tsx
new file mode 100644
index 0000000..a1df5ca
--- /dev/null
+++ b/apps/desktop/src/chat/cards/CardStack.tsx
@@ -0,0 +1,93 @@
+// The transcript-level card stack (P20-22): the ONE host for a session's open server requests.
+// The transcript mounts it once, after its rows, so a request that arrives before its tool row and
+// the tool row that appears later never remount a card: each card is keyed by its request id in a
+// container whose own position in the tree does not change.
+//
+// Kinds the 1.0 app does not implement have no handler in the server-request store, so the client
+// channel answers them `-32601` at once and the daemon offers them elsewhere.
+
+import { useMemo } from "react";
+import { type ChatConnection, REQUEST_TIMEOUTS } from "../../gateway/connectionStore.ts";
+import { useGatewayConnection, useOpenServerRequests } from "../../gateway/react.tsx";
+import type { OpenServerRequest } from "../../gateway/serverRequests.ts";
+import { useT } from "../../i18n/index.tsx";
+import { ApprovalCard } from "./ApprovalCard.tsx";
+import { ClarifyCard, type ClarifyLock } from "./ClarifyCard.tsx";
+import { SecretDialog, SudoDialog } from "./SecretDialog.tsx";
+
+/** The server-request kinds this app answers; every other kind is refused by the channel. */
+export const CARD_KINDS = ["approval", "clarify", "sudo", "secret"] as const;
+
+export interface CardStackProps {
+  sessionId: string;
+  /** Open requests; defaults to the server-request store's list for the session. */
+  requests?: readonly OpenServerRequest[];
+  /** The connection used for clarify locks; defaults to the active one. */
+  connection?: ChatConnection | null;
+  /** Arming delay for explicit activations (tests pass 0). */
+  armMs?: number;
+}
+
+function lockFor(connection: ChatConnection | null, open: OpenServerRequest): ClarifyLock | null {
+  if (connection === null) return null;
+  return async (questionId, answer) => {
+    const result = await connection.request(
+      "clarify.lock",
+      {
+        session_id: open.sessionId,
+        request_id: open.id,
+        question_id: questionId,
+        answer,
+      },
+      { timeoutMs: REQUEST_TIMEOUTS.approvalRespond },
+    );
+    return result.remaining;
+  };
+}
+
+export function CardStack(props: CardStackProps) {
+  const t = useT();
+  const fromStore = useOpenServerRequests(props.requests === undefined ? props.sessionId : null);
+  const active = useGatewayConnection();
+  const connection = props.connection === undefined ? active : props.connection;
+  const requests = props.requests ?? fromStore;
+  const cards = useMemo(
+    () => requests.filter((open) => open.sessionId === props.sessionId),
+    [requests, props.sessionId],
+  );
+
+  return (
+    <section
+      data-card-stack={props.sessionId}
+      aria-live="polite"
+      aria-label={t("cards.label")}
+      className="space-y-2"
+    >
+      {cards.map((open) => {
+        switch (open.kind) {
+          case "approval":
+            return <ApprovalCard key={open.id} open={open} {...armProps(props.armMs)} />;
+          case "clarify":
+            return (
+              <ClarifyCard
+                key={open.id}
+                open={open}
+                lock={lockFor(connection, open)}
+                {...armProps(props.armMs)}
+              />
+            );
+          case "sudo":
+            return <SudoDialog key={open.id} open={open} />;
+          case "secret":
+            return <SecretDialog key={open.id} open={open} />;
+          default:
+            return null;
+        }
+      })}
+    </section>
+  );
+}
+
+function armProps(armMs: number | undefined): { armMs?: number } {
+  return armMs === undefined ? {} : { armMs };
+}
diff --git a/apps/desktop/src/chat/cards/ClarifyCard.tsx b/apps/desktop/src/chat/cards/ClarifyCard.tsx
new file mode 100644
index 0000000..a6a3717
--- /dev/null
+++ b/apps/desktop/src/chat/cards/ClarifyCard.tsx
@@ -0,0 +1,165 @@
+// A clarify batch (P20-22): one card for every question, each answered and locked on its own with
+// `clarify.lock`. A locked question is read-only; once the daemon answers that none remain, the
+// request is complete and settles from the daemon's side (the store then drops the card). Without
+// a connection to lock through, the whole batch is answered at once when the last question is set.
+
+import type { ClarifyQuestion, ClarifyRequest } from "@indus/protocol";
+import { useState } from "react";
+import type { OpenServerRequest } from "../../gateway/serverRequests.ts";
+import { useT } from "../../i18n/index.tsx";
+import { errorMessage } from "../rpcErrors.ts";
+import { useArmed, useExplicitPress } from "./ApprovalCard.tsx";
+
+/** Lock one answer; resolves with the question ids still open. */
+export type ClarifyLock = (questionId: string, answer: string[]) => Promise<string[]>;
+
+function QuestionRow(props: {
+  question: ClarifyQuestion;
+  locked: string[] | undefined;
+  armed: boolean;
+  onLock: (answer: string[]) => void;
+}) {
+  const t = useT();
+  const { question, locked } = props;
+  const [picked, setPicked] = useState<string[]>([]);
+  const [text, setText] = useState("");
+  const choices = question.choices ?? [];
+  const multi = question.multi_select === true;
+  const answer =
+    choices.length > 0
+      ? [...picked, ...(text.trim() ? [text.trim()] : [])]
+      : [text.trim()].filter(Boolean);
+  const send = useExplicitPress(() => props.onLock(answer), props.armed);
+  const skip = useExplicitPress(() => props.onLock([]), props.armed);
+
+  if (locked !== undefined) {
+    return (
+      <li data-question={question.id} data-locked="true" className="text-sm">
+        <div className="font-medium">{question.text}</div>
+        <div className="text-muted">
+          {locked.length > 0 ? locked.join(", ") : t("clarify.skipped")}
+        </div>
+      </li>
+    );
+  }
+
+  const toggle = (choice: string) => {
+    if (multi) {
+      setPicked((now) =>
+        now.includes(choice) ? now.filter((c) => c !== choice) : [...now, choice],
+      );
+    } else {
+      setPicked((now) => (now[0] === choice ? [] : [choice]));
+    }
+  };
+
+  return (
+    <li data-question={question.id} className="space-y-1 text-sm">
+      <div className="font-medium">{question.text}</div>
+      {choices.length > 0 ? (
+        <fieldset className="m-0 flex flex-wrap gap-1 border-0 p-0" aria-label={question.text}>
+          {choices.map((choice) => (
+            <button
+              key={choice}
+              type="button"
+              aria-pressed={picked.includes(choice)}
+              className={`rounded border px-2 py-0.5 ${
+                picked.includes(choice) ? "border-accent bg-accent text-accent-fg" : "border-line"
+              }`}
+              onClick={() => toggle(choice)}
+            >
+              {choice}
+            </button>
+          ))}
+        </fieldset>
+      ) : null}
+      <input
+        type="text"
+        aria-label={t("clarify.answerFor", { question: question.text })}
+        placeholder={choices.length > 0 ? t("clarify.other") : t("clarify.answer")}
+        className="w-full rounded border border-line bg-bg px-2 py-1"
+        value={text}
+        onChange={(event) => setText(event.target.value)}
+      />
+      <div className="flex gap-2">
+        <button
+          type="button"
+          className="rounded border border-line px-2 py-0.5"
+          disabled={answer.length === 0}
+          {...send}
+        >
+          {t("clarify.send")}
+        </button>
+        <button type="button" className="rounded border border-line px-2 py-0.5" {...skip}>
+          {t("clarify.skip")}
+        </button>
+      </div>
+    </li>
+  );
+}
+
+export function ClarifyCard(props: {
+  open: OpenServerRequest;
+  lock: ClarifyLock | null;
+  armMs?: number;
+}) {
+  const t = useT();
+  const request = props.open.request as ClarifyRequest;
+  const armed = useArmed(props.armMs ?? 250);
+  const [locked, setLocked] = useState<Record<string, string[]>>({});
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState<Set<string>>(new Set());
+
+  const lockOne = async (questionId: string, answer: string[]) => {
+    if (busy.has(questionId)) return;
+    setError(null);
+    if (props.lock === null) {
+      const next = { ...locked, [questionId]: answer };
+      setLocked(next);
+      if (request.questions.every((q) => q.id in next)) {
+        props.open.answer({ kind: "clarify", answers: next });
+      }
+      return;
+    }
+    setBusy((now) => new Set(now).add(questionId));
+    try {
+      await props.lock(questionId, answer);
+      setLocked((now) => ({ ...now, [questionId]: answer }));
+    } catch (failure) {
+      setError(errorMessage(failure));
+    } finally {
+      setBusy((now) => {
+        const next = new Set(now);
+        next.delete(questionId);
+        return next;
+      });
+    }
+  };
+
+  return (
+    <section
+      aria-label={t("clarify.title")}
+      data-card="clarify"
+      data-request-id={props.open.id}
+      className="rounded-lg border border-accent bg-raised p-3 space-y-2"
+    >
+      <header className="text-sm font-semibold">{t("clarify.title")}</header>
+      <ol className="space-y-3 list-none p-0 m-0">
+        {request.questions.map((question) => (
+          <QuestionRow
+            key={question.id}
+            question={question}
+            locked={locked[question.id]}
+            armed={armed}
+            onLock={(answer) => void lockOne(question.id, answer)}
+          />
+        ))}
+      </ol>
+      {error !== null ? (
+        <p role="alert" className="text-xs text-danger">
+          {error}
+        </p>
+      ) : null}
+    </section>
+  );
+}
diff --git a/apps/desktop/src/chat/cards/SecretDialog.tsx b/apps/desktop/src/chat/cards/SecretDialog.tsx
new file mode 100644
index 0000000..22b40d3
--- /dev/null
+++ b/apps/desktop/src/chat/cards/SecretDialog.tsx
@@ -0,0 +1,127 @@
+// The two masked-input requests (P20-22). Both are dialogs over an UNBLURRED backdrop, so the
+// conversation behind stays readable.
+// - Sudo: shows in full, selectable, what the password is for; the password goes only into the
+//   answer.
+// - Secret: names the variable and the agent's prompt; the value goes only into the answer (the
+//   backend stores it in the profile's secret store). Nothing is kept here or in any storage.
+
+import type { SecretRequest, SudoRequest } from "@indus/protocol";
+import { type FormEvent, useState } from "react";
+import type { OpenServerRequest } from "../../gateway/serverRequests.ts";
+import { useT } from "../../i18n/index.tsx";
+
+function Backdrop(props: { label: string; kind: string; id: string; children: React.ReactNode }) {
+  return (
+    // No backdrop-filter: the transcript behind stays sharp (the reference blurs; we do not).
+    <div className="fixed inset-0 z-40 flex items-center justify-center bg-black/30" data-backdrop>
+      <div
+        role="dialog"
+        aria-modal="true"
+        aria-label={props.label}
+        data-card={props.kind}
+        data-request-id={props.id}
+        className="w-[min(32rem,calc(100vw-2rem))] rounded-lg border border-line bg-raised p-4 space-y-3 shadow-lg"
+      >
+        {props.children}
+      </div>
+    </div>
+  );
+}
+
+export function SudoDialog(props: { open: OpenServerRequest }) {
+  const t = useT();
+  const request = props.open.request as SudoRequest;
+  const [password, setPassword] = useState("");
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    props.open.answer({ kind: "sudo", password });
+    setPassword("");
+  };
+
+  return (
+    <Backdrop label={t("sudo.title")} kind="sudo" id={props.open.id}>
+      <form onSubmit={submit} className="space-y-3">
+        <header className="text-sm font-semibold">{t("sudo.title")}</header>
+        <pre
+          data-testid="sudo-reason"
+          className="font-mono text-xs whitespace-pre-wrap break-all select-text bg-code rounded p-2"
+        >
+          {request.reason}
+        </pre>
+        <input
+          type="password"
+          autoComplete="off"
+          aria-label={t("sudo.password")}
+          className="w-full rounded border border-line bg-bg px-2 py-1"
+          value={password}
+          onChange={(event) => setPassword(event.target.value)}
+          // biome-ignore lint/a11y/noAutofocus: the dialog exists to take this one value
+          autoFocus
+        />
+        <div className="flex justify-end gap-2">
+          <button
+            type="button"
+            className="rounded border border-line px-3 py-1 text-sm"
+            onClick={() => props.open.answer({ kind: "sudo" })}
+          >
+            {t("sudo.cancel")}
+          </button>
+          <button type="submit" className="rounded bg-accent text-accent-fg px-3 py-1 text-sm">
+            {t("sudo.submit")}
+          </button>
+        </div>
+      </form>
+    </Backdrop>
+  );
+}
+
+export function SecretDialog(props: { open: OpenServerRequest }) {
+  const t = useT();
+  const request = props.open.request as SecretRequest;
+  const [value, setValue] = useState("");
+
+  const submit = (event: FormEvent) => {
+    event.preventDefault();
+    props.open.answer({ kind: "secret", value });
+    setValue("");
+  };
+
+  return (
+    <Backdrop label={t("secret.title", { name: request.name })} kind="secret" id={props.open.id}>
+      <form onSubmit={submit} className="space-y-3">
+        <header className="text-sm font-semibold">
+          {t("secret.title", { name: request.name })}
+        </header>
+        <p className="text-sm text-muted select-text">{request.prompt}</p>
+        <input
+          type="password"
+          autoComplete="off"
+          aria-label={t("secret.value", { name: request.name })}
+          className="w-full rounded border border-line bg-bg px-2 py-1 font-mono"
+          value={value}
+          onChange={(event) => setValue(event.target.value)}
+          // biome-ignore lint/a11y/noAutofocus: the dialog exists to take this one value
+          autoFocus
+        />
+        <p className="text-xs text-muted">{t("secret.where")}</p>
+        <div className="flex justify-end gap-2">
+          <button
+            type="button"
+            className="rounded border border-line px-3 py-1 text-sm"
+            onClick={() => props.open.answer({ kind: "secret" })}
+          >
+            {t("secret.skip")}
+          </button>
+          <button
+            type="submit"
+            disabled={value === ""}
+            className="rounded bg-accent text-accent-fg px-3 py-1 text-sm"
+          >
+            {t("secret.save")}
+          </button>
+        </div>
+      </form>
+    </Backdrop>
+  );
+}
diff --git a/apps/desktop/src/chat/composer/Composer.test.tsx b/apps/desktop/src/chat/composer/Composer.test.tsx
new file mode 100644
index 0000000..02223bd
--- /dev/null
+++ b/apps/desktop/src/chat/composer/Composer.test.tsx
@@ -0,0 +1,270 @@
+// @vitest-environment jsdom
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ModelPrefs } from "../ModelPicker.tsx";
+import { FakeConnection, MemoryStorage, rpcError } from "../testFakes.ts";
+import {
+  attachmentFromPath,
+  MAX_ATTACHMENT_BYTES,
+  stageAttachment,
+  transportFor,
+} from "./attachments.ts";
+import { Composer, type ComposerProps } from "./Composer.tsx";
+import { PromptHistory } from "./completion.ts";
+import { DraftStore } from "./goneSession.ts";
+
+afterEach(cleanup);
+
+function chatDaemon(mode: "local" | "remote" = "local") {
+  return new FakeConnection({ mode })
+    .on("prompt.submit", () => ({ turn_id: "adm-1", generation: 4, status: "streaming" }))
+    .on("image.attach", (params) => ({ name: "x", path: params.path, attached: 1 }))
+    .on("session.interrupt", () => ({ interrupted: true }))
+    .on("model.options", () => ({ provider: "", model: "", providers: [] }));
+}
+
+function mount(connection: FakeConnection, extra: Partial<ComposerProps> = {}) {
+  const drafts = extra.drafts ?? new DraftStore();
+  const props: ComposerProps = {
+    sessionId: "s1",
+    connection,
+    journal: null,
+    drafts,
+    history: new PromptHistory(),
+    prefs: new ModelPrefs(new MemoryStorage()),
+    completionDebounceMs: 0,
+    ...extra,
+  };
+  const view = render(<Composer {...props} />);
+  const box = screen.getByLabelText("Message") as HTMLTextAreaElement;
+  return { view, box, drafts, props };
+}
+
+function type(box: HTMLTextAreaElement, value: string) {
+  fireEvent.change(box, { target: { value } });
+}
+
+describe("composer", () => {
+  it("Enter sends through prompt.submit and clears the draft", async () => {
+    const connection = chatDaemon();
+    const { box } = mount(connection);
+    type(box, "hello there");
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(connection.called("prompt.submit")[0]?.params).toMatchObject({
+      session_id: "s1",
+      text: "hello there",
+    });
+    expect(box.value).toBe("");
+  });
+
+  it("history recall works only in an empty composer", async () => {
+    const connection = chatDaemon();
+    const history = new PromptHistory();
+    history.push("first prompt");
+    history.push("second prompt");
+    const { box } = mount(connection, { history });
+    type(box, "typing");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
+    expect(box.value).toBe("typing");
+    type(box, "");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
+    expect(box.value).toBe("second prompt");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
+    expect(box.value).toBe("first prompt");
+    fireEvent.keyDown(box, { key: "ArrowDown" });
+    expect(box.value).toBe("second prompt");
+    // an edited recall is the person's text now: arrows leave it alone
+    type(box, "second prompt, edited");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
+    expect(box.value).toBe("second prompt, edited");
+  });
+
+  it("slash completion comes from the daemon, curated, and Tab takes it", async () => {
+    const connection = chatDaemon().on("complete.slash", () => ({
+      items: [
+        { text: "/quit", display: "/quit" },
+        { text: "/usage", display: "/usage", meta: "token use" },
+      ],
+    }));
+    const { box } = mount(connection);
+    await act(async () => {
+      type(box, "/u");
+    });
+    const options = await screen.findAllByRole("option");
+    expect(options.map((o) => o.textContent)).toEqual(["/usagetoken use"]);
+    fireEvent.keyDown(box, { key: "Tab" });
+    expect(box.value).toBe("/usage ");
+  });
+
+  it("a slow answer for an older word never replaces the newer list", async () => {
+    const releases: Array<() => void> = [];
+    const connection = chatDaemon().on(
+      "complete.path",
+      (params) =>
+        new Promise((resolve) => {
+          releases.push(() =>
+            resolve({ items: [{ text: `${params.word}-match`, display: `${params.word}-match` }] }),
+          );
+        }),
+    );
+    const { box } = mount(connection);
+    await act(async () => {
+      type(box, "look at @sr");
+    });
+    await act(async () => {
+      type(box, "look at @src");
+    });
+    // the newer answer first, then the stale one
+    await act(async () => releases[1]?.());
+    await act(async () => releases[0]?.());
+    const options = screen.getAllByRole("option").map((o) => o.textContent);
+    expect(options).toEqual(["src-match"]);
+  });
+
+  it("while a turn runs: Stop interrupts the exact generation, Esc too", async () => {
+    const connection = chatDaemon();
+    const { box } = mount(connection);
+    act(() => {
+      connection.emit("s1", { type: "turn.started", turn_id: "adm-1", generation: 4 });
+    });
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Stop" }));
+    });
+    expect(connection.called("session.interrupt")[0]?.params).toEqual({
+      session_id: "s1",
+      generation: 4,
+    });
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Escape" });
+    });
+    expect(connection.called("session.interrupt")).toHaveLength(2);
+  });
+
+  it("remote mode uploads bytes: no client path reaches the remote host", async () => {
+    const connection = chatDaemon("remote");
+    const uploadBytes = vi.fn(async (target: string) => `/remote${target}`);
+    const readLocalBytes = vi.fn(async () => new Uint8Array([1, 2, 3]));
+    const guardLocalPath = vi.fn(async () => {});
+    const { box } = mount(connection, {
+      cwd: "/srv/work",
+      pickFiles: async () => ["/Users/me/Desktop/shot.png"],
+      attachmentDeps: { uploadBytes, readLocalBytes, guardLocalPath },
+    });
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Attach" }));
+    });
+    // and one pasted file (never has a path)
+    const pasted = new File([new Uint8Array([9, 9])], "notes.txt", { type: "text/plain" });
+    fireEvent.paste(box, { clipboardData: { files: [pasted] } });
+    type(box, "see these");
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(readLocalBytes).toHaveBeenCalledWith("/Users/me/Desktop/shot.png");
+    expect(guardLocalPath).not.toHaveBeenCalled();
+    expect(uploadBytes).toHaveBeenCalledTimes(2);
+    const attachedPath = String(connection.called("image.attach")[0]?.params.path);
+    expect(attachedPath.startsWith("/remote/srv/work/.indus/attachments/")).toBe(true);
+    const sent = String(connection.called("prompt.submit")[0]?.params.text);
+    expect(sent).toContain("see these");
+    expect(sent).toContain("@/remote/srv/work/.indus/attachments/");
+    for (const call of connection.calls) {
+      expect(JSON.stringify(call.params)).not.toContain("/Users/me");
+    }
+  });
+
+  it("local mode passes a picked path after main's guard, without an upload", async () => {
+    const connection = chatDaemon("local");
+    const uploadBytes = vi.fn(async (target: string) => target);
+    const guardLocalPath = vi.fn(async () => {});
+    const { box } = mount(connection, {
+      pickFiles: async () => ["/home/me/shot.png"],
+      attachmentDeps: { uploadBytes, guardLocalPath, readLocalBytes: async () => new Uint8Array() },
+    });
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Attach" }));
+    });
+    type(box, "this one");
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(guardLocalPath).toHaveBeenCalledWith("/home/me/shot.png");
+    expect(uploadBytes).not.toHaveBeenCalled();
+    expect(connection.called("image.attach")[0]?.params.path).toBe("/home/me/shot.png");
+  });
+
+  it("a refused attachment keeps the message unsent", async () => {
+    const connection = chatDaemon("local");
+    const { box } = mount(connection, {
+      pickFiles: async () => ["/home/me/.env"],
+      attachmentDeps: {
+        guardLocalPath: async () => {
+          throw new Error("refused: key store or .env file");
+        },
+      },
+    });
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Attach" }));
+    });
+    type(box, "secret stuff");
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(screen.getByRole("alert").textContent).toContain("refused");
+    expect(connection.called("prompt.submit")).toHaveLength(0);
+    expect(box.value).toBe("secret stuff");
+  });
+
+  it("a session that vanished hands its text to the fresh draft once, with Undo", async () => {
+    const connection = chatDaemon()
+      .on("prompt.submit", () => {
+        throw rpcError("SESSION_NOT_FOUND");
+      })
+      .on("session.history", () => {
+        throw rpcError("SESSION_NOT_FOUND");
+      });
+    const onSessionGone = vi.fn();
+    const drafts = new DraftStore();
+    const { box, view, props } = mount(connection, { drafts, onSessionGone });
+    type(box, "my unsent words");
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    await waitFor(() => expect(onSessionGone).toHaveBeenCalledWith("s1"));
+    // the route shows the fresh draft
+    view.rerender(<Composer {...props} sessionId={null} />);
+    const fresh = screen.getByLabelText("Message") as HTMLTextAreaElement;
+    expect(fresh.value).toBe("my unsent words");
+    expect(screen.getByRole("status").textContent).toContain("moved here");
+    expect(document.activeElement).not.toBe(fresh);
+    fireEvent.click(screen.getByRole("button", { name: "Undo" }));
+    expect(fresh.value).toBe("");
+  });
+});
+
+describe("attachment transport", () => {
+  it("bytes unless local mode with a known path", () => {
+    const picked = attachmentFromPath("/a/b.png");
+    expect(transportFor(picked, "local")).toBe("path");
+    expect(transportFor(picked, "remote")).toBe("bytes");
+  });
+
+  it("refuses an attachment over 256 MiB before reading it", async () => {
+    const huge = attachmentFromPath("/a/big.bin", MAX_ATTACHMENT_BYTES + 1);
+    const readLocalBytes = vi.fn(async () => new Uint8Array());
+    await expect(
+      stageAttachment(huge, {
+        mode: "remote",
+        sessionId: "s1",
+        cwd: null,
+        request: (async () => ({})) as never,
+        guardLocalPath: async () => {},
+        readLocalBytes,
+        uploadBytes: async (target) => target,
+      }),
+    ).rejects.toThrow(/256 MiB/);
+    expect(readLocalBytes).not.toHaveBeenCalled();
+  });
+});
diff --git a/apps/desktop/src/chat/composer/Composer.tsx b/apps/desktop/src/chat/composer/Composer.tsx
new file mode 100644
index 0000000..a96bdd8
--- /dev/null
+++ b/apps/desktop/src/chat/composer/Composer.tsx
@@ -0,0 +1,720 @@
+// The composer (P20-19): where the next message is written.
+//
+// - completion: `/` at the start (slash, curated by P20-24) and `@word` (paths), arrows to move,
+//   Tab/Enter to take, Esc to close; answers that arrive after a newer question are dropped;
+// - attachments: dropped/pasted files travel as bytes; picker paths go as paths only in local mode
+//   (R08.23, see `attachments.ts`);
+// - Up/Down recall earlier prompts only while the composer is empty (or shows a recalled entry);
+// - a per-conversation status stack (todos, the queue) above the editor, hidden by a ridge;
+// - the model + effort pill (P20-23); Stop / Steer / Queue while a turn runs (P20-21);
+// - a vanished session hands its unsent text to the fresh draft once, with an undoable strip.
+
+import type { TodoItem } from "@indus/protocol";
+import {
+  type ChangeEvent,
+  type ClipboardEvent,
+  type DragEvent,
+  type KeyboardEvent,
+  useCallback,
+  useEffect,
+  useId,
+  useMemo,
+  useRef,
+  useState,
+  useSyncExternalStore,
+} from "react";
+import type { ChatConnection } from "../../gateway/connectionStore.ts";
+import { useGatewayConnection } from "../../gateway/react.tsx";
+import { useT } from "../../i18n/index.tsx";
+import {
+  ChatActions,
+  type PreparedJournalPort,
+  type Request,
+  sharedActions,
+} from "../busyActions.ts";
+import type { InflightJournal } from "../inflightJournal.ts";
+import { type LocalRows, sendShown } from "../localEcho.ts";
+import { ModelPicker, ModelPrefs, modelKey } from "../ModelPicker.tsx";
+import { QueuePanel, useBusySnapshot } from "../QueuePanel.tsx";
+import { errorMessage, isUncertain } from "../rpcErrors.ts";
+import { helpLines, isSlashLine, type LocalCommandName, runSlash } from "../slash.ts";
+import {
+  type Attachment,
+  AttachmentError,
+  attachmentFromPath,
+  attachmentsFromFiles,
+  bridgeGuardLocalPath,
+  bridgeReadLocalBytes,
+  bridgeUploadBytes,
+  isImage,
+  type StageDeps,
+  type StagedAttachment,
+  stageAttachment,
+  withFileReferences,
+} from "./attachments.ts";
+import {
+  applyCompletion,
+  CompletionSource,
+  type CompletionState,
+  EMPTY_COMPLETION,
+  PromptHistory,
+} from "./completion.ts";
+import {
+  adoptGoneDraft,
+  type DraftStore,
+  dismissRestore,
+  draftOf,
+  FRESH,
+  setDraft,
+  undoRestore,
+  verifySessionGone,
+  windowDrafts,
+} from "./goneSession.ts";
+
+export interface ComposerProps {
+  /** The session written to, or null for the window's fresh draft. */
+  sessionId: string | null;
+  profile?: string | null;
+  connection?: ChatConnection | null;
+  /** Tests inject; otherwise one per session is made over the connection. */
+  actions?: ChatActions | null;
+  journal?: PreparedJournalPort | null;
+  inflight?: InflightJournal | null;
+  drafts?: DraftStore;
+  history?: PromptHistory;
+  prefs?: ModelPrefs;
+  /** The transcript's optimistic rows (the person's message shows before the daemon stores it). */
+  localRows?: LocalRows | null;
+  /** The session's folder (uploads land below it). */
+  cwd?: string | null;
+  /** The fresh draft became a session. */
+  onSessionCreated?(sessionId: string): void;
+  /** The daemon confirmed the session is gone: show the fresh draft. */
+  onSessionGone?(sessionId: string): void;
+  /** `/new`. */
+  onNewChat?(): void;
+  /** `/reasoning show|hide` flips the transcript live. */
+  onReasoningDisplay?(show: boolean): void;
+  /** A system line in the conversation (slash output, notices). */
+  onSystemLine?(text: string): void;
+  /** The native file picker; resolves with chosen paths. */
+  pickFiles?(): Promise<string[]>;
+  attachmentDeps?: Partial<Pick<StageDeps, "guardLocalPath" | "readLocalBytes" | "uploadBytes">>;
+  completionDebounceMs?: number;
+}
+
+const history = new PromptHistory();
+const BUTTON =
+  "rounded px-3 py-1 text-sm border border-line hover:bg-raised disabled:opacity-50 focus-visible:outline-2 focus-visible:outline-focus";
+
+function newKey(): string {
+  return typeof crypto !== "undefined" && "randomUUID" in crypto
+    ? crypto.randomUUID()
+    : `draft-${Date.now()}-${Math.random()}`;
+}
+
+function useDrafts(store: DraftStore) {
+  return useSyncExternalStore(store.subscribe, store.snapshot, store.snapshot);
+}
+
+function TodoList({ todos }: { todos: readonly TodoItem[] }) {
+  const t = useT();
+  if (todos.length === 0) return null;
+  return (
+    <section aria-label={t("composer.todos")} className="px-3 py-2">
+      <ul className="list-none m-0 p-0 text-sm">
+        {todos.map((todo) => (
+          <li key={todo.id} data-status={todo.status} className="flex gap-2">
+            <span aria-hidden="true">
+              {todo.status === "completed" ? "✓" : todo.status === "in_progress" ? "▸" : "○"}
+            </span>
+            <span className={todo.status === "completed" ? "line-through text-muted" : ""}>
+              {todo.content}
+            </span>
+          </li>
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+/** Actions for a real session, wired to its events and journal. */
+function useSessionActions(
+  props: ComposerProps,
+  connection: ChatConnection | null,
+): ChatActions | null {
+  const { sessionId, journal, inflight } = props;
+  const made = useMemo(() => {
+    if (props.actions !== undefined) return props.actions;
+    if (connection === null || sessionId === null) return null;
+    return sharedActions(
+      connection,
+      sessionId,
+      () =>
+        new ChatActions({
+          sessionId,
+          request: connection.request.bind(connection) as Request,
+          ...(journal === undefined ? {} : { journal }),
+          ...(inflight === undefined ? {} : { inflight }),
+        }),
+    );
+  }, [props.actions, connection, sessionId, journal, inflight]);
+  useEffect(() => {
+    if (made === null || connection === null) return;
+    const stop = connection.onSessionEvent(made.sessionId, (event) => made.handleEvent(event));
+    void made.recoverPrepared();
+    return stop;
+  }, [made, connection]);
+  return made;
+}
+
+const IDLE_ACTIONS = new ChatActions({
+  sessionId: "",
+  request: (() => Promise.reject(new Error("no session"))) as Request,
+  journal: null,
+});
+
+export function Composer(props: ComposerProps) {
+  const t = useT();
+  const active = useGatewayConnection();
+  const connection = props.connection === undefined ? active : props.connection;
+  const store = props.drafts ?? windowDrafts;
+  const drafts = useDrafts(store);
+  const recall = props.history ?? history;
+  const prefs = useMemo(() => props.prefs ?? new ModelPrefs(), [props.prefs]);
+  const actions = useSessionActions(props, connection);
+  const busy = useBusySnapshot(actions ?? IDLE_ACTIONS);
+  const key = props.sessionId ?? FRESH;
+  const text = draftOf(drafts, key);
+  const [attachments, setAttachments] = useState<Attachment[]>([]);
+  const [problem, setProblem] = useState<string | null>(null);
+  const [sending, setSending] = useState(false);
+  const [stackHidden, setStackHidden] = useState(false);
+  const [pickerOpen, setPickerOpen] = useState(false);
+  const [todos, setTodos] = useState<readonly TodoItem[]>([]);
+  const [completion, setCompletion] = useState<CompletionState>(EMPTY_COMPLETION);
+  const [imageDraft, setImageDraft] = useState(() =>
+    props.sessionId === null ? null : (props.inflight?.imageDraft(props.sessionId) ?? null),
+  );
+  const textarea = useRef<HTMLTextAreaElement>(null);
+  const listId = useId();
+  const composing = useRef(false);
+  /** The fresh draft's create key: kept until the daemon answers definitely. */
+  const createKey = useRef<string>(newKey());
+
+  const request = useMemo(
+    () => (connection === null ? null : (connection.request.bind(connection) as Request)),
+    [connection],
+  );
+
+  const source = useMemo(
+    () =>
+      new CompletionSource({
+        request,
+        sessionId: props.sessionId,
+        onChange: setCompletion,
+        ...(props.completionDebounceMs === undefined
