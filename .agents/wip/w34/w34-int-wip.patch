@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { ChatActions, type Request } from "./busyActions.ts";
+import { type LocalRows, sendShown } from "./localEcho.ts";
+import { rpcError } from "./testFakes.ts";
+
+function rows() {
+  const log: string[] = [];
+  const port: LocalRows = {
+    addLocalUser: (sessionId, text) => {
+      log.push(`add ${sessionId} ${text}`);
+      return "l1";
+    },
+    bindLocalUser: (sessionId, localId, turnId) =>
+      log.push(`bind ${sessionId} ${localId} ${turnId}`),
+    dropLocalUser: (sessionId, localId) => log.push(`drop ${sessionId} ${localId}`),
+  };
+  return { log, port };
+}
+
+function actions(answer: () => unknown): ChatActions {
+  const request = (async () => answer()) as unknown as Request;
+  return new ChatActions({ sessionId: "s1", request, journal: null });
+}
+
+describe("the person's own message on screen", () => {
+  it("shows the row at once and binds it to the turn that started", async () => {
+    const { log, port } = rows();
+    const run = actions(() => ({ turn_id: "t1", generation: 1, status: "started" }));
+    expect(await sendShown(run, port, "hi @file", "hi")).toBe("started");
+    expect(log).toEqual(["add s1 hi", "bind s1 l1 t1"]);
+  });
+
+  it("removes the row when the input was queued or refused", async () => {
+    const queued = rows();
+    const run = actions(() => ({ turn_id: "a1", status: "queued" }));
+    expect(await sendShown(run, queued.port, "later", "later")).toBe("queued");
+    expect(queued.log).toEqual(["add s1 later", "drop s1 l1"]);
+
+    const refused = rows();
+    const failing = actions(() => {
+      throw rpcError("SESSION_NOT_FOUND");
+    });
+    expect(await sendShown(failing, refused.port, "gone", "gone")).toBe("rejected");
+    expect(refused.log).toEqual(["add s1 gone", "drop s1 l1"]);
+  });
+
+  it("an empty message or no transcript sends as before", async () => {
+    const { log, port } = rows();
+    expect(
+      await sendShown(
+        actions(() => ({})),
+        port,
+        "  ",
+        "  ",
+      ),
+    ).toBe("empty");
+    expect(log).toEqual([]);
+  });
+});
diff --git a/apps/desktop/src/chat/localEcho.ts b/apps/desktop/src/chat/localEcho.ts
new file mode 100644
index 0000000..25e5d37
--- /dev/null
+++ b/apps/desktop/src/chat/localEcho.ts
@@ -0,0 +1,37 @@
+// The person's own message on screen at once (merge of P20-18 and P20-19). The daemon sends no
+// event that carries a prompt's text, so the composer adds an optimistic row to the transcript
+// before `prompt.submit` and settles it with the answer: bound to its turn when the turn started
+// (the stored row replaces it on the next history load), removed otherwise — a queued input is
+// shown by the queue panel, steering joins the running turn, a refused or uncertain one stays in
+// the composer's own strip.
+
+import type { ChatActions, SendOptions, SendOutcome } from "./busyActions.ts";
+
+/** The transcript store's local-row calls (`TranscriptStore` implements them). */
+export interface LocalRows {
+  addLocalUser(sessionId: string, text: string): string;
+  bindLocalUser(sessionId: string, localId: string, turnId: string): void;
+  dropLocalUser(sessionId: string, localId: string): void;
+}
+
+/** `actions.send` with the optimistic row; `display` is what the person typed. */
+export async function sendShown(
+  actions: ChatActions,
+  rows: LocalRows | null,
+  text: string,
+  display: string,
+  options: SendOptions = {},
+): Promise<SendOutcome> {
+  if (rows === null || text.trim() === "") return actions.send(text, options);
+  const sessionId = actions.sessionId;
+  const localId = rows.addLocalUser(sessionId, display);
+  let outcome: SendOutcome = "rejected";
+  try {
+    outcome = await actions.send(text, options);
+  } finally {
+    const turnId = actions.snapshot().turnId;
+    if (outcome === "started" && turnId !== null) rows.bindLocalUser(sessionId, localId, turnId);
+    else rows.dropLocalUser(sessionId, localId);
+  }
+  return outcome;
+}
