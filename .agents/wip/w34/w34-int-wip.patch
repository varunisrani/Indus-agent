diff --git a/apps/desktop/scripts/dump-slash-catalog.mjs b/apps/desktop/scripts/dump-slash-catalog.mjs
new file mode 100644
index 0000000..77dffa1
--- /dev/null
+++ b/apps/desktop/scripts/dump-slash-catalog.mjs
@@ -0,0 +1,77 @@
+#!/usr/bin/env node
+// Writes the offline slash catalogue (`src/chat/slashCatalog.json`) from the Python command
+// registry (`src/indus/service/commands/registry.py`): every built-in with its aliases, one-line
+// description, category, argument hint and whether the registry offers it on the desktop surface.
+// The desktop uses it when the daemon cannot be reached, and its `desktop: false` rows are the
+// known list the slash curation hides (P20-24).
+//
+//   node scripts/dump-slash-catalog.mjs           regenerate
+//   node scripts/dump-slash-catalog.mjs --check   exit 1 when the committed file is stale
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const desktop = path.resolve(here, "..");
+const repo = path.resolve(desktop, "..", "..");
+const target = path.join(desktop, "src", "chat", "slashCatalog.json");
+
+const PROGRAM = `
+import json
+from indus.service.commands.registry import REGISTRY
+rows = [
+    {
+        "name": c.name,
+        "aliases": list(c.aliases),
+        "description": c.description,
+        "category": c.category,
+        "argsHint": c.args_hint,
+        "desktop": c.offered_on("desktop"),
+    }
+    for c in REGISTRY
+]
+print(json.dumps(rows))
+`;
+
+/** Pretty JSON exactly as the repository formatter (Biome) leaves it. */
+export function renderCatalog(rows) {
+  const body = {
+    source: "src/indus/service/commands/registry.py via scripts/dump-slash-catalog.mjs",
+    commands: rows,
+  };
+  // Biome keeps arrays of plain strings on one line when they fit.
+  return `${JSON.stringify(body, null, 2).replace(
+    /\[\n\s*((?:"[^"\n]*",?\s*)*)\]/g,
+    (_, items) => `[${items.trim().split(/,\s*/).filter(Boolean).join(", ")}]`,
+  )}\n`;
+}
+
+function readRegistry() {
+  const out = execFileSync("uv", ["run", "--frozen", "--quiet", "python", "-c", PROGRAM], {
+    cwd: repo,
+    encoding: "utf8",
+    stdio: ["ignore", "pipe", "inherit"],
+  });
+  return JSON.parse(out.trim().split("\n").at(-1) ?? "[]");
+}
+
+function main() {
+  const text = renderCatalog(readRegistry());
+  if (process.argv.includes("--check")) {
+    const current = fs.existsSync(target) ? fs.readFileSync(target, "utf8") : "";
+    if (current !== text) {
+      process.stderr.write(
+        `${path.relative(repo, target)} is stale: run node apps/desktop/scripts/dump-slash-catalog.mjs\n`,
+      );
+      process.exit(1);
+    }
+    process.stdout.write("slash catalogue up to date\n");
+    return;
+  }
+  fs.writeFileSync(target, text);
+  process.stdout.write(`wrote ${path.relative(repo, target)}\n`);
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) main();
diff --git a/apps/desktop/scripts/viteConfig.test.ts b/apps/desktop/scripts/viteConfig.test.ts
new file mode 100644
index 0000000..13febe6
--- /dev/null
+++ b/apps/desktop/scripts/viteConfig.test.ts
@@ -0,0 +1,62 @@
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import type { ResolvedConfig } from "vite";
+import { describe, expect, it } from "vitest";
+import {
+  cspMetaPlugin,
+  DEV_ORIGIN,
+  RUNTIME_CONNECT_SOURCES,
+  rendererMetaCsp,
+} from "../vite.config.ts";
+
+const APP = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+
+function directive(policy: string, name: string): string[] {
+  const found = policy.split("; ").find((part) => part.startsWith(`${name} `));
+  return found === undefined ? [] : found.split(" ").slice(1);
+}
+
+function transform(command: "serve" | "build", html: string): string {
+  const plugin = cspMetaPlugin();
+  (plugin.configResolved as (config: ResolvedConfig) => void)({ command } as ResolvedConfig);
+  const hook = plugin.transformIndexHtml as { handler: (html: string) => string };
+  return hook.handler(html);
+}
+
+describe("renderer CSP meta", () => {
+  it("allows no inline or eval'd script, in dev or build", () => {
+    for (const policy of [
+      rendererMetaCsp({ dev: false }),
+      rendererMetaCsp({ dev: true, devServerOrigin: DEV_ORIGIN }),
+    ]) {
+      expect(policy).not.toContain("unsafe-eval");
+      expect(directive(policy, "script-src")).not.toContain("'unsafe-inline'");
+      expect(directive(policy, "object-src")).toEqual(["'none'"]);
+      expect(directive(policy, "frame-src")).toEqual(["'none'"]);
+      for (const source of RUNTIME_CONNECT_SOURCES) {
+        expect(directive(policy, "connect-src")).toContain(source);
+      }
+    }
+    expect(directive(rendererMetaCsp({ dev: false }), "script-src")).toEqual(["'self'"]);
+    expect(
+      directive(rendererMetaCsp({ dev: true, devServerOrigin: DEV_ORIGIN }), "script-src"),
+    ).toEqual(["'self'", DEV_ORIGIN]);
+  });
+
+  it("is the first tag in <head> of the page, and the page has no inline script", () => {
+    const html = fs.readFileSync(path.join(APP, "index.html"), "utf8");
+    const scripts = [...html.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/g)];
+    expect(scripts.length).toBeGreaterThan(0);
+    for (const script of scripts) {
+      expect(script[1]).toContain("src=");
+      expect((script[2] ?? "").trim()).toBe("");
+    }
+    for (const command of ["serve", "build"] as const) {
+      const out = transform(command, html);
+      const head = out.slice(out.indexOf("<head>") + "<head>".length).trimStart();
+      expect(head.startsWith('<meta http-equiv="Content-Security-Policy"')).toBe(true);
+      expect(out.match(/Content-Security-Policy/g)).toHaveLength(1);
+    }
+  });
+});
