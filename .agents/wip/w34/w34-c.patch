+
+  it("slash completion comes from the daemon, curated, and Tab takes it", async () => {
+    const connection = chatDaemon().on("complete.slash", () => ({
+      items: [
+        { text: "/quit", display: "/quit" },
+        { text: "/usage", display: "/usage", meta: "token use" },
