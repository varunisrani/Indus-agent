+    const { box } = mount(connection, { history });
+    type(box, "typing");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
+    expect(box.value).toBe("typing");
+    type(box, "");
+    fireEvent.keyDown(box, { key: "ArrowUp" });
