+// WAVE34 STAND-IN (owner: slice R) — the lead drops this file at merge
+// Only the names slice C codes against; slice R's real i18n (P20-15) provides them.
+
+import { en } from "./en.ts";
+
+export type MessageKey = keyof typeof en;
+export type MessageVars = Readonly<Record<string, string | number>>;
+export type Translate = (key: MessageKey, vars?: MessageVars) => string;
+
+/** The English text for `key` with `{name}` placeholders filled. */
+export const t: Translate = (key, vars) => {
+  const text: string = en[key];
+  if (vars === undefined) return text;
+  return text.replace(/\{(\w+)\}/g, (whole, name: string) =>
+    name in vars ? String(vars[name]) : whole,
+  );
+};
+
+/** The translate function for components. */
+export function useT(): Translate {
+  return t;
+}
