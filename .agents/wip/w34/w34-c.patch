@@ -0,0 +1,52 @@
+// WAVE34 STAND-IN (owner: slice R) — the lead drops this file at merge
+// Only the names slice C codes against; slice R's real connection store (P20-17) provides them.
+
+import type { EventTypes, MethodName, MethodTypes } from "@indus/protocol";
+import { createContext, createElement, type ReactNode, useContext } from "react";
+
+/** Call deadlines (P20-17 row). */
+export const REQUEST_TIMEOUTS = {
+  default: 120_000,
+  startup: 60_000,
+  promptSubmit: 1_800_000,
+  approvalRespond: 330_000,
+} as const;
+
+export interface RequestOptions {
+  timeoutMs?: number;
+  signal?: AbortSignal;
+}
+
+export type SessionEvent = EventTypes[keyof EventTypes];
+
+export type ConnectionMode = "local" | "remote";
+
+/** One live (connection, profile) socket. */
+export interface GatewayConnection {
+  readonly mode: ConnectionMode;
+  /** The daemon's code version (from the connection descriptor). */
+  readonly codeVersion: string;
+  request<M extends MethodName>(
+    method: M,
+    params: MethodTypes[M]["params"],
+    options?: RequestOptions,
+  ): Promise<MethodTypes[M]["result"]>;
+  /** Events of one session, in stream order; returns an unsubscribe. */
+  onSessionEvent(sessionId: string, listener: (event: SessionEvent) => void): () => void;
+  /** Drop and redial the socket now. */
+  reconnect(): void;
+}
+
+const ConnectionContext = createContext<GatewayConnection | null>(null);
+
+export function GatewayConnectionProvider(props: {
+  value: GatewayConnection | null;
+  children?: ReactNode;
+}) {
+  return createElement(ConnectionContext.Provider, { value: props.value }, props.children);
+}
+
+/** The active profile's connection, or null before boot finishes. */
+export function useGatewayConnection(): GatewayConnection | null {
+  return useContext(ConnectionContext);
+}
