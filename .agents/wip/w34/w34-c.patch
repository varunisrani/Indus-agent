+// Composer attachments (P20-19, R08.23).
+//
+// A sandboxed renderer never sees the path of a dropped or pasted `File`, so those always travel as
+// bytes: uploaded through main's REST proxy (`POST /api/files/upload`) into the session's folder on
+// whichever host runs the session, and the agent gets that host's path. A file picked in the native
+// dialog has a client path: in local mode main's fs guard checks it and the path goes as is; in
+// remote mode its bytes are read (through the same guard) and uploaded — a client path never
+// reaches a remote host. Images then go to `image.attach`; other files become an `@path`
+// reference in the message.
+
+import type { MethodName, MethodTypes } from "@indus/protocol";
+import type { ConnectionMode, RequestOptions } from "../../gateway/connectionStore.ts";
+
+/** Attachments larger than this are refused before anything is read (P20-14's cap). */
+export const MAX_ATTACHMENT_BYTES = 256 * 1024 * 1024;
+/** Where uploads land, relative to the session's folder. */
+export const UPLOAD_DIR = ".indus/attachments";
+
+export type AttachmentSource =
+  | { readonly kind: "path"; readonly path: string }
+  | { readonly kind: "bytes"; read(): Promise<Uint8Array> };
+
+export interface Attachment {
+  readonly id: string;
+  readonly name: string;
+  readonly size: number;
+  readonly mimeType: string;
+  readonly source: AttachmentSource;
+}
+
+export interface StagedAttachment {
+  readonly attachment: Attachment;
+  /** The path on the host that runs the session. */
+  readonly hostPath: string;
+  readonly image: boolean;
+}
+
+export class AttachmentError extends Error {
+  readonly attachment: Attachment;
+  constructor(attachment: Attachment, message: string) {
+    super(message);
+    this.name = "AttachmentError";
+    this.attachment = attachment;
+  }
+}
+
+type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+export interface StageDeps {
+  readonly mode: ConnectionMode;
+  readonly sessionId: string;
+  /** The session's folder on its host (uploads go below it); null uses the host's default. */
+  readonly cwd: string | null;
+  readonly request: Request;
+  /** Throws when main's fs guard refuses a local path. */
+  guardLocalPath(path: string): Promise<void>;
+  /** Bytes of a client path, read through main's guard. */
+  readLocalBytes(path: string): Promise<Uint8Array>;
+  /** Upload bytes; resolves with the stored path on the session's host. */
+  uploadBytes(target: string, name: string, mimeType: string, bytes: Uint8Array): Promise<string>;
+}
+
+export function isImage(attachment: Attachment): boolean {
+  return attachment.mimeType.startsWith("image/");
+}
+
+/** How an attachment travels: its client path (local mode, known path) or its bytes. */
+export function transportFor(attachment: Attachment, mode: ConnectionMode): "path" | "bytes" {
+  return attachment.source.kind === "path" && mode === "local" ? "path" : "bytes";
+}
+
+function safeName(name: string): string {
+  const base = name.split(/[\\/]/).pop() ?? "file";
+  const cleaned = base.replace(/[^\w.\- ]+/g, "_").replace(/^\.+/, "");
+  return cleaned === "" ? "file" : cleaned.slice(0, 120);
+}
+
+function joinHost(cwd: string | null, relative: string): string {
+  if (cwd === null || cwd === "") return relative;
+  const sep = cwd.includes("\\") && !cwd.includes("/") ? "\\" : "/";
+  return `${cwd.replace(/[\\/]+$/, "")}${sep}${relative.replaceAll("/", sep)}`;
+}
+
+/** Make one attachment available to the session's host. */
+export async function stageAttachment(
+  attachment: Attachment,
+  deps: StageDeps,
+): Promise<StagedAttachment> {
+  if (attachment.size > MAX_ATTACHMENT_BYTES) {
+    throw new AttachmentError(attachment, "larger than 256 MiB");
+  }
+  const image = isImage(attachment);
+  let hostPath: string;
+  if (transportFor(attachment, deps.mode) === "path" && attachment.source.kind === "path") {
+    await deps.guardLocalPath(attachment.source.path);
+    hostPath = attachment.source.path;
+  } else {
+    const bytes =
+      attachment.source.kind === "path"
+        ? await deps.readLocalBytes(attachment.source.path)
+        : await attachment.source.read();
+    if (bytes.byteLength > MAX_ATTACHMENT_BYTES) {
+      throw new AttachmentError(attachment, "larger than 256 MiB");
+    }
+    const target = joinHost(
+      deps.cwd,
+      `${UPLOAD_DIR}/${attachment.id}-${safeName(attachment.name)}`,
+    );
+    hostPath = await deps.uploadBytes(
+      target,
+      safeName(attachment.name),
+      attachment.mimeType,
+      bytes,
+    );
+  }
+  if (image) {
+    await deps.request("image.attach", { session_id: deps.sessionId, path: hostPath });
+  }
+  return { attachment, hostPath, image };
+}
+
+/** The message text with `@path` references for the staged non-image files. */
+export function withFileReferences(text: string, staged: readonly StagedAttachment[]): string {
+  const refs = staged.filter((item) => !item.image).map((item) => `@${item.hostPath}`);
+  if (refs.length === 0) return text;
+  return text.trim() === "" ? refs.join(" ") : `${text.trimEnd()}\n${refs.join(" ")}`;
+}
+
+let counter = 0;
+function nextId(): string {
+  counter += 1;
+  const random =
+    typeof crypto !== "undefined" && "randomUUID" in crypto
+      ? crypto.randomUUID().slice(0, 8)
+      : String(Date.now());
+  return `${random}${counter}`;
+}
+
+/** Attachments from dropped or pasted files: always bytes (no path in a sandboxed renderer). */
+export function attachmentsFromFiles(files: Iterable<File>): Attachment[] {
+  return [...files].map((file) => ({
+    id: nextId(),
+    name: file.name || "pasted",
+    size: file.size,
+    mimeType: file.type || "application/octet-stream",
+    source: { kind: "bytes", read: async () => new Uint8Array(await file.arrayBuffer()) },
+  }));
+}
+
+/** An attachment for a path chosen in the native picker. */
+export function attachmentFromPath(path: string, size = 0, mimeType = guessMime(path)): Attachment {
+  return {
+    id: nextId(),
+    name: path.split(/[\\/]/).pop() ?? path,
+    size,
+    mimeType,
+    source: { kind: "path", path },
+  };
+}
+
+const IMAGE_TYPES: Readonly<Record<string, string>> = {
+  png: "image/png",
+  jpg: "image/jpeg",
+  jpeg: "image/jpeg",
+  gif: "image/gif",
+  webp: "image/webp",
+  bmp: "image/bmp",
+};
+
+export function guessMime(path: string): string {
+  const ext = path.split(".").pop()?.toLowerCase() ?? "";
+  return IMAGE_TYPES[ext] ?? "application/octet-stream";
+}
+
+// -- the desktop's default helpers, over the preload bridge -------------------------------------------
+
+interface BridgeSubset {
+  fs: {
+    readText(payload: { path: string; maxBytes?: number }): Promise<unknown>;
+    readDataUrl(payload: {
+      path: string;
+      purpose: "preview" | "attach";
+    }): Promise<{ dataUrl: string }>;
+  };
+  api: {
+    request(payload: {
+      method: "POST";
+      path: string;
+      body?: unknown;
+      timeoutMs?: number;
+    }): Promise<{ kind: string; status: number; body: unknown }>;
+  };
+}
+
+function bridge(): BridgeSubset {
+  const found = (globalThis as { indusDesktop?: BridgeSubset }).indusDesktop;
+  if (found === undefined) throw new Error("the desktop bridge is not available");
+  return found;
+}
+
+function toBase64(bytes: Uint8Array): string {
+  let binary = "";
+  const chunk = 0x8000;
+  for (let at = 0; at < bytes.length; at += chunk) {
+    binary += String.fromCharCode(...bytes.subarray(at, at + chunk));
+  }
+  return btoa(binary);
+}
+
+function fromDataUrl(dataUrl: string): Uint8Array {
+  const comma = dataUrl.indexOf(",");
+  const binary = atob(dataUrl.slice(comma + 1));
+  const bytes = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
+  return bytes;
+}
+
+/** Main's fs guard accepts the path when a one-byte read through it succeeds. */
+export async function bridgeGuardLocalPath(path: string): Promise<void> {
+  await bridge().fs.readText({ path, maxBytes: 1 });
+}
+
+export async function bridgeReadLocalBytes(path: string): Promise<Uint8Array> {
+  const { dataUrl } = await bridge().fs.readDataUrl({ path, purpose: "attach" });
+  return fromDataUrl(dataUrl);
+}
+
+/** Upload through main's REST proxy; main encodes the multipart body and adds the credential. */
+export async function bridgeUploadBytes(
+  target: string,
+  name: string,
+  mimeType: string,
+  bytes: Uint8Array,
+): Promise<string> {
+  const answer = await bridge().api.request({
+    method: "POST",
+    path: "/api/files/upload",
+    body: {
+      multipart: {
+        path: target,
+        overwrite: false,
+        file: { name, type: mimeType, base64: toBase64(bytes) },
+      },
+    },
+    timeoutMs: 120_000,
+  });
+  if (answer.kind !== "response" || answer.status >= 400) {
+    throw new Error(`upload failed (${answer.status})`);
+  }
+  const stored = (answer.body as { path?: unknown } | null)?.path;
+  return typeof stored === "string" && stored !== "" ? stored : target;
+}
diff --git a/apps/desktop/src/chat/composer/completion.ts b/apps/desktop/src/chat/composer/completion.ts
new file mode 100644
index 0000000..0e0993f
--- /dev/null
+++ b/apps/desktop/src/chat/composer/completion.ts
@@ -0,0 +1,217 @@
+// Composer completion (P20-19): which trigger the caret is in, asking the daemon for candidates,
+// dropping answers that arrive after a newer question, and applying a picked candidate.
+//
+// Triggers: `/` at the very start of the text (slash commands, curated by P20-24) and `@word`
+// anywhere after whitespace (paths, `complete.path`).
+
+import type { CompletionItem, MethodName, MethodTypes } from "@indus/protocol";
+import type { RequestOptions } from "../../gateway/connectionStore.ts";
+import { completeSlash } from "../slash.ts";
+
+export type TriggerKind = "slash" | "mention";
+
+export interface Trigger {
+  readonly kind: TriggerKind;
+  /** Where the replaced word starts (the `/` or `@`). */
+  readonly start: number;
+  /** Where it ends (the caret). */
+  readonly end: number;
+  /** The word typed so far, trigger character included. */
+  readonly word: string;
+}
+
+/** The trigger under the caret, or null. */
+export function findTrigger(text: string, caret: number): Trigger | null {
+  const before = text.slice(0, caret);
+  if (before.startsWith("/") && !/\s/.test(before)) {
+    return { kind: "slash", start: 0, end: caret, word: before };
+  }
+  const match = /(^|\s)(@[^\s@]*)$/.exec(before);
+  if (match?.[2] !== undefined) {
+    const word = match[2];
+    return { kind: "mention", start: caret - word.length, end: caret, word };
+  }
+  return null;
+}
+
+/** The text and caret after taking `item` for `trigger`. */
+export function applyCompletion(
+  text: string,
+  trigger: Trigger,
+  item: CompletionItem,
+): { text: string; caret: number } {
+  let insert = item.text;
+  if (trigger.kind === "mention" && !insert.startsWith("@")) insert = `@${insert}`;
+  const after = text.slice(trigger.end);
+  // A finished command or file reference gets a space; a folder keeps the caret inside it.
+  const space = !insert.endsWith("/") && !after.startsWith(" ") ? " " : "";
+  const next = `${text.slice(0, trigger.start)}${insert}${space}${after}`;
+  return { text: next, caret: trigger.start + insert.length + space.length };
+}
+
+type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+export interface CompletionState {
+  readonly trigger: Trigger | null;
+  readonly items: readonly CompletionItem[];
+  readonly selected: number;
+}
+
+export const EMPTY_COMPLETION: CompletionState = { trigger: null, items: [], selected: 0 };
+
+/** Debounce for asking the daemon while the person types. */
+export const COMPLETION_DEBOUNCE_MS = 60;
+
+export interface CompletionSourceOptions {
+  request: Request | null;
+  sessionId: string | null;
+  onChange: (state: CompletionState) => void;
+  debounceMs?: number;
+}
+
+/**
+ * Asks for candidates as the text changes. Each question gets a generation; an answer for an
+ * older generation (the person kept typing) is dropped, so a slow answer never replaces a newer
+ * list.
+ */
+export class CompletionSource {
+  private readonly options: CompletionSourceOptions;
+  private generation = 0;
+  private timer: ReturnType<typeof setTimeout> | null = null;
+  private controller: AbortController | null = null;
+  private state: CompletionState = EMPTY_COMPLETION;
+
+  constructor(options: CompletionSourceOptions) {
+    this.options = options;
+  }
+
+  get current(): CompletionState {
+    return this.state;
+  }
+
+  private publish(state: CompletionState): void {
+    this.state = state;
+    this.options.onChange(state);
+  }
+
+  /** The text or caret changed. */
+  update(text: string, caret: number): void {
+    const trigger = findTrigger(text, caret);
+    this.generation += 1;
+    const mine = this.generation;
+    if (this.timer !== null) clearTimeout(this.timer);
+    this.controller?.abort();
+    this.controller = null;
+    if (trigger === null) {
+      if (this.state.trigger !== null) this.publish(EMPTY_COMPLETION);
+      return;
+    }
+    const ask = () => {
+      this.timer = null;
+      void this.ask(trigger, mine);
+    };
+    const wait = this.options.debounceMs ?? COMPLETION_DEBOUNCE_MS;
+    if (wait <= 0) ask();
+    else this.timer = setTimeout(ask, wait);
+  }
+
+  private async ask(trigger: Trigger, mine: number): Promise<void> {
+    const controller = new AbortController();
+    this.controller = controller;
+    let items: CompletionItem[];
+    try {
+      items = await this.fetch(trigger, controller.signal);
+    } catch {
+      items = [];
+    }
+    if (mine !== this.generation) return;
+    this.publish({ trigger, items, selected: 0 });
+  }
+
+  private async fetch(trigger: Trigger, signal: AbortSignal): Promise<CompletionItem[]> {
+    const { request, sessionId } = this.options;
+    if (trigger.kind === "slash") return completeSlash(trigger.word, request, sessionId, signal);
+    if (request === null) return [];
+    const answer = await request(
+      "complete.path",
+      { word: trigger.word.slice(1), session_id: sessionId },
+      { timeoutMs: 10_000, signal },
+    );
+    return answer.items;
+  }
+
+  /** Move the highlight (wraps). */
+  move(delta: number): void {
+    const count = this.state.items.length;
+    if (count === 0) return;
+    const selected = (this.state.selected + delta + count) % count;
+    this.publish({ ...this.state, selected });
+  }
+
+  close(): void {
+    this.generation += 1;
+    if (this.timer !== null) clearTimeout(this.timer);
+    this.controller?.abort();
+    this.publish(EMPTY_COMPLETION);
+  }
+
+  dispose(): void {
+    this.generation += 1;
+    if (this.timer !== null) clearTimeout(this.timer);
+    this.controller?.abort();
+  }
+}
+
+/**
+ * Recall of earlier prompts with Up/Down. It only moves while the composer is empty or still shows
+ * the entry it recalled, so arrows inside typed text are left to the editor.
+ */
+export class PromptHistory {
+  private readonly entries: string[] = [];
+  private cursor: number | null = null;
+  private readonly limit: number;
+
+  constructor(limit = 200) {
+    this.limit = limit;
+  }
+
+  push(text: string): void {
+    const trimmed = text.trim();
+    if (trimmed === "") return;
+    if (this.entries.at(-1) !== trimmed) this.entries.push(trimmed);
+    if (this.entries.length > this.limit) this.entries.shift();
+    this.cursor = null;
+  }
+
+  /** True when an arrow should recall instead of moving the caret. */
+  canRecall(current: string): boolean {
+    if (current === "") return true;
+    return this.cursor !== null && this.entries[this.cursor] === current;
+  }
+
+  /** The entry one step older (`-1`) or newer (`+1`); null when nothing changes. */
+  step(direction: -1 | 1, current: string): string | null {
+    if (!this.canRecall(current) || this.entries.length === 0) return null;
+    if (this.cursor === null) {
+      if (direction === 1) return null;
+      this.cursor = this.entries.length - 1;
+      return this.entries[this.cursor] ?? null;
+    }
+    const next = this.cursor + direction;
+    if (next < 0) return null;
+    if (next >= this.entries.length) {
+      this.cursor = null;
+      return "";
+    }
+    this.cursor = next;
+    return this.entries[next] ?? null;
+  }
+
+  reset(): void {
+    this.cursor = null;
+  }
+}
diff --git a/apps/desktop/src/chat/composer/goneSession.test.ts b/apps/desktop/src/chat/composer/goneSession.test.ts
new file mode 100644
index 0000000..55d9b34
--- /dev/null
+++ b/apps/desktop/src/chat/composer/goneSession.test.ts
@@ -0,0 +1,89 @@
+import { GatewayRpcError, RpcTimeout } from "@indus/client";
+import { ERROR_CODES } from "@indus/protocol";
+import { describe, expect, it } from "vitest";
+import {
+  adoptGoneDraft,
+  DraftStore,
+  dismissRestore,
+  draftOf,
+  EMPTY_DRAFTS,
+  FRESH,
+  setDraft,
+  undoRestore,
+  verifySessionGone,
+} from "./goneSession.ts";
+
+describe("gone-session draft", () => {
+  it("adopts the unsent text into an empty fresh draft and shows the strip", () => {
+    const state = setDraft(EMPTY_DRAFTS, "s1", "half a thought");
+    const next = adoptGoneDraft(state, "s1");
+    expect(draftOf(next, FRESH)).toBe("half a thought");
+    expect(draftOf(next, "s1")).toBe("");
+    expect(next.restored).toEqual({
+      fromSessionId: "s1",
+      text: "half a thought",
+      adopted: true,
+      previousFresh: "",
+    });
+  });
+
+  it("never overwrites a non-empty fresh draft", () => {
+    let state = setDraft(EMPTY_DRAFTS, "s1", "old text");
+    state = setDraft(state, FRESH, "new text");
+    const next = adoptGoneDraft(state, "s1");
+    expect(draftOf(next, FRESH)).toBe("new text");
+    expect(next.restored).toMatchObject({ adopted: false, text: "old text" });
+  });
+
+  it("adopts once: a second gone signal changes nothing", () => {
+    const once = adoptGoneDraft(setDraft(EMPTY_DRAFTS, "s1", "text"), "s1");
+    const cleared = setDraft(dismissRestore(once), FRESH, "");
+    const input = setDraft(cleared, "s1", "late write");
+    const again = adoptGoneDraft(input, "s1");
+    expect(again).toBe(input);
+    expect(draftOf(again, FRESH)).toBe("");
+    expect(again.restored).toBeNull();
+  });
+
+  it("an empty unsent text shows no strip", () => {
+    const next = adoptGoneDraft(setDraft(EMPTY_DRAFTS, "s1", "  "), "s1");
+    expect(next.restored).toBeNull();
+    expect(draftOf(next, FRESH)).toBe("");
+  });
+
+  it("undo puts the fresh draft back", () => {
+    const adopted = adoptGoneDraft(setDraft(EMPTY_DRAFTS, "s1", "text"), "s1");
+    const undone = undoRestore(adopted);
+    expect(draftOf(undone, FRESH)).toBe("");
+    expect(undone.restored).toBeNull();
+    expect(undoRestore(undone)).toBe(undone);
+  });
+
+  it("the store notifies only on a real change", () => {
+    const store = new DraftStore();
+    let calls = 0;
+    store.subscribe(() => {
+      calls += 1;
+    });
+    store.update((s) => setDraft(s, "s1", "a"));
+    store.update((s) => setDraft(s, "s1", "a"));
+    expect(calls).toBe(1);
+  });
+
+  it("only a confirmed miss counts as gone", async () => {
+    const failing = (error: unknown) =>
+      (async () => {
+        throw error;
+      }) as never;
+    const notFound = new GatewayRpcError(ERROR_CODES.SESSION_NOT_FOUND.code, "no session");
+    const refused = new GatewayRpcError(ERROR_CODES.SESSION_REFUSED.code, "deleted");
+    const internal = new GatewayRpcError(ERROR_CODES.INTERNAL_ERROR.code, "boom");
+    expect(await verifySessionGone(failing(notFound), "s1")).toBe(true);
+    expect(await verifySessionGone(failing(refused), "s1")).toBe(true);
+    expect(await verifySessionGone(failing(internal), "s1")).toBe(false);
+    expect(await verifySessionGone(failing(new RpcTimeout("session.history", 1)), "s1")).toBe(
+      false,
+    );
+    expect(await verifySessionGone((async () => ({ messages: [] })) as never, "s1")).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/chat/composer/goneSession.ts b/apps/desktop/src/chat/composer/goneSession.ts
new file mode 100644
index 0000000..240eff4
--- /dev/null
+++ b/apps/desktop/src/chat/composer/goneSession.ts
@@ -0,0 +1,114 @@
+// A session that vanished under the composer (P20-19). When the daemon confirms the session is
+// gone (deleted, or continued elsewhere), the window drops to a fresh draft that adopts the unsent
+// text ONCE and shows an inline "restored" strip with Undo. No toast, no navigation of its own, no
+// focus change; a fresh draft that already has text is never overwritten (the old text is then
+// only offered on the strip).
+
+import type { MethodName, MethodTypes } from "@indus/protocol";
+import type { RequestOptions } from "../../gateway/connectionStore.ts";
+import { errorName } from "../rpcErrors.ts";
+
+/** The draft key of the window's fresh (not yet created) conversation. */
+export const FRESH = "";
+
+export interface RestoredStrip {
+  readonly fromSessionId: string;
+  readonly text: string;
+  /** True when the text went into the fresh draft (Undo puts the fresh draft back). */
+  readonly adopted: boolean;
+  /** The fresh draft before the adoption. */
+  readonly previousFresh: string;
+}
+
+export interface DraftState {
+  /** Unsent text per session id (`FRESH` for the new-chat draft). */
+  readonly drafts: Readonly<Record<string, string>>;
+  /** Sessions whose text was already handled. */
+  readonly handled: readonly string[];
+  readonly restored: RestoredStrip | null;
+}
+
+export const EMPTY_DRAFTS: DraftState = { drafts: {}, handled: [], restored: null };
+
+export function draftOf(state: DraftState, key: string): string {
+  return state.drafts[key] ?? "";
+}
+
+export function setDraft(state: DraftState, key: string, text: string): DraftState {
+  if (draftOf(state, key) === text) return state;
+  return { ...state, drafts: { ...state.drafts, [key]: text } };
+}
+
+/** Move the unsent text of a gone session to the fresh draft, once. */
+export function adoptGoneDraft(state: DraftState, goneSessionId: string): DraftState {
+  if (goneSessionId === FRESH || state.handled.includes(goneSessionId)) return state;
+  const text = draftOf(state, goneSessionId);
+  const drafts = { ...state.drafts };
+  delete drafts[goneSessionId];
+  const handled = [...state.handled, goneSessionId];
+  if (text.trim() === "") return { ...state, drafts, handled };
+  const fresh = draftOf(state, FRESH);
+  const adopted = fresh.trim() === "";
+  if (adopted) drafts[FRESH] = text;
+  return {
+    drafts,
+    handled,
+    restored: { fromSessionId: goneSessionId, text, adopted, previousFresh: fresh },
+  };
+}
+
+/** Undo the strip: the fresh draft goes back to what it was before the adoption. */
+export function undoRestore(state: DraftState): DraftState {
+  const strip = state.restored;
+  if (strip === null) return state;
+  const drafts = { ...state.drafts };
+  if (strip.adopted) drafts[FRESH] = strip.previousFresh;
+  return { ...state, drafts, restored: null };
+}
+
+export function dismissRestore(state: DraftState): DraftState {
+  return state.restored === null ? state : { ...state, restored: null };
+}
+
+/** A small store the composer and the route share. */
+export class DraftStore {
+  private state: DraftState = EMPTY_DRAFTS;
+  private readonly listeners = new Set<() => void>();
+
+  snapshot = (): DraftState => this.state;
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  };
+
+  update(change: (state: DraftState) => DraftState): void {
+    const next = change(this.state);
+    if (next === this.state) return;
+    this.state = next;
+    for (const listener of this.listeners) listener();
+  }
+}
+
+/** One store per window. */
+export const windowDrafts = new DraftStore();
+
+type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+/**
+ * True only when the daemon confirms the session is gone (`SESSION_NOT_FOUND`, or refused as
+ * deleted / continued elsewhere). A timeout or a dropped link proves nothing.
+ */
+export async function verifySessionGone(request: Request, sessionId: string): Promise<boolean> {
+  try {
+    await request("session.history", { session_id: sessionId }, { timeoutMs: 15_000 });
+    return false;
+  } catch (error) {
+    const name = errorName(error);
+    return name === "SESSION_NOT_FOUND" || name === "SESSION_REFUSED";
+  }
+}
diff --git a/apps/desktop/src/chat/inflightJournal.test.ts b/apps/desktop/src/chat/inflightJournal.test.ts
new file mode 100644
index 0000000..652dca8
--- /dev/null
+++ b/apps/desktop/src/chat/inflightJournal.test.ts
@@ -0,0 +1,196 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  IMAGE_DRAFTS_KEY,
+  InflightJournal,
+  type JournalMessage,
+  MAX_AGE_MS,
+  MAX_ATTACHMENT_REFS,
+  MAX_ENTRY_CHARS,
+  MAX_MESSAGES,
+  MAX_TEXT_PART_CHARS,
+  STORE_KEY,
+  type StorageLike,
+  shapeEntry,
+  WRITE_THROTTLE_MS,
+} from "./inflightJournal.ts";
+
+class MemoryStorage implements StorageLike {
+  readonly data = new Map<string, string>();
+  writes = 0;
+  getItem(key: string): string | null {
+    return this.data.get(key) ?? null;
+  }
+  setItem(key: string, value: string): void {
+    this.writes += 1;
+    this.data.set(key, value);
+  }
+  removeItem(key: string): void {
+    this.data.delete(key);
+  }
+}
+
+const KIB = 1024;
+
+function message(id: string, text: string, extra: Partial<JournalMessage> = {}): JournalMessage {
+  return { id, role: "assistant", parts: [{ type: "text", text }], ...extra };
+}
+
+const snapshot = (messages: JournalMessage[]) => ({ turnId: "t1", startedAt: 1, messages });
+
+describe("in-flight turn journal", () => {
+  let now = 1_000;
+  let storage: MemoryStorage;
+  let journal: InflightJournal;
+
+  beforeEach(() => {
+    vi.useFakeTimers();
+    now = 1_000;
+    storage = new MemoryStorage();
+    journal = new InflightJournal({ storage, now: () => now });
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+  });
+
+  it("throttles writes to one per 400 ms (trailing edge)", () => {
+    journal.record("s1", snapshot([message("m1", "a")]));
+    journal.record("s1", snapshot([message("m1", "ab")]));
+    journal.record("s1", snapshot([message("m1", "abc")]));
+    expect(storage.writes).toBe(0);
+    vi.advanceTimersByTime(WRITE_THROTTLE_MS - 1);
+    expect(storage.writes).toBe(0);
+    vi.advanceTimersByTime(1);
+    expect(storage.writes).toBe(1);
+    expect(journal.read("s1")?.messages[0]?.parts[0]?.text).toBe("abc");
+    journal.record("s1", snapshot([message("m1", "abcd")]));
+    vi.advanceTimersByTime(WRITE_THROTTLE_MS);
+    expect(storage.writes).toBe(2);
+  });
+
+  it("rejects a 161 KiB entry and keeps the previous one", () => {
+    journal.record("s1", snapshot([message("m1", "small")]));
+    journal.flush();
+    // 161 KiB of text spread over parts each under the part cap
+    const parts = Array.from({ length: 3 }, () => ({
+      type: "text" as const,
+      text: "y".repeat(Math.ceil((161 * KIB) / 3)),
+    }));
+    const big: JournalMessage = { id: "m2", role: "assistant", parts };
+    expect(shapeEntry("s1", snapshot([big]), now)).toEqual({ ok: false, reason: "too-large" });
+    journal.record("s1", snapshot([big]));
+    journal.flush();
+    expect(journal.read("s1")?.messages.map((m) => m.id)).toEqual(["m1"]);
+    const fits = shapeEntry("s1", snapshot([message("m3", "z".repeat(100 * KIB))]), now);
+    expect(fits.ok && fits.chars <= MAX_ENTRY_CHARS).toBe(true);
+  });
+
+  it("prunes an 8-day-old entry", () => {
+    journal.record("old", snapshot([message("m1", "a")]));
+    journal.flush();
+    now += 8 * 24 * 60 * 60 * 1000;
+    expect(journal.read("old")).toBeNull();
+    expect(journal.prune()).toBe(1);
+    expect(storage.getItem(STORE_KEY)).toBeNull();
+  });
+
+  it("keeps an entry younger than 7 days", () => {
+    journal.record("s1", snapshot([message("m1", "a")]));
+    journal.flush();
+    now += MAX_AGE_MS - 1;
+    expect(journal.prune()).toBe(0);
+    expect(journal.read("s1")).not.toBeNull();
+  });
+
+  it("caps messages, text parts, metadata and attachment refs", () => {
+    const many = Array.from({ length: MAX_MESSAGES + 6 }, (_, i) => message(`m${i}`, "t"));
+    const shaped = shapeEntry("s1", snapshot(many), now);
+    expect(shaped.ok && shaped.entry.messages.length).toBe(MAX_MESSAGES);
+    expect(shaped.ok && shaped.entry.messages[0]?.id).toBe("m6");
+
+    const long = shapeEntry(
+      "s1",
+      snapshot([message("m", "q".repeat(MAX_TEXT_PART_CHARS + 10))]),
+      now,
+    );
+    expect(long.ok && long.entry.messages[0]?.parts[0]).toMatchObject({ clipped: true });
+    expect(long.ok && long.entry.messages[0]?.parts[0]?.text.length).toBe(MAX_TEXT_PART_CHARS);
+
+    const meta = shapeEntry(
+      "s1",
+      snapshot([
+        message("a", "t", { metadata: { tool: "terminal" } }),
+        message("b", "t", { metadata: { blob: "m".repeat(3 * KIB) } }),
+      ]),
+      now,
+    );
+    expect(meta.ok && meta.entry.messages[0]?.metadata).toEqual({ tool: "terminal" });
+    expect(meta.ok && meta.entry.messages[1]?.metadata).toBeUndefined();
+
+    const refs = Array.from({ length: MAX_ATTACHMENT_REFS + 4 }, (_, i) => `ref-${i}`);
+    const withRefs = shapeEntry("s1", snapshot([message("u", "t", { attachments: refs })]), now);
+    expect(withRefs.ok && withRefs.entry.messages[0]?.attachments?.length).toBe(
+      MAX_ATTACHMENT_REFS,
+    );
+  });
+
+  it("evicts the oldest sessions to stay within 4 MiB", () => {
+    const chunk = "w".repeat(60 * KIB);
+    const twoParts = (id: string): JournalMessage => ({
+      id,
+      role: "assistant",
+      parts: [
+        { type: "text", text: chunk },
+        { type: "text", text: chunk },
+      ],
+    });
+    for (let i = 0; i < 40; i += 1) {
+      now += 1;
+      journal.record(`s${i}`, snapshot([twoParts(`m${i}`)]));
+      journal.flush();
+    }
+    const raw = storage.getItem(STORE_KEY) ?? "";
+    expect(raw.length).toBeLessThanOrEqual(4 * 1024 * 1024);
+    expect(journal.read("s0")).toBeNull();
+    expect(journal.read("s39")).not.toBeNull();
+  });
+
+  it("clear removes a session's entry and its pending write", () => {
+    journal.record("s1", snapshot([message("m1", "a")]));
+    journal.clear("s1");
+    vi.advanceTimersByTime(WRITE_THROTTLE_MS);
+    expect(journal.read("s1")).toBeNull();
+  });
+
+  it("broken storage never throws", () => {
+    const broken: StorageLike = {
+      getItem: () => {
+        throw new Error("denied");
+      },
+      setItem: () => {
+        throw new Error("quota");
+      },
+      removeItem: () => {
+        throw new Error("denied");
+      },
+    };
+    const safe = new InflightJournal({ storage: broken });
+    expect(() => {
+      safe.record("s1", snapshot([message("m1", "a")]));
+      safe.flush();
+      safe.read("s1");
+      safe.saveImageDraft("s1", { requestId: "r", text: "x", attachments: [] });
+    }).not.toThrow();
+  });
+
+  it("an image draft survives a restart and is cleared by its acknowledgement only", () => {
+    journal.saveImageDraft("s1", { requestId: "r1", text: "look", attachments: ["a.png"] });
+    const reopened = new InflightJournal({ storage, now: () => now });
+    expect(reopened.imageDraft("s1")).toMatchObject({ requestId: "r1", text: "look" });
+    reopened.clearImageDraft("s1", "other");
+    expect(reopened.imageDraft("s1")).not.toBeNull();
+    reopened.clearImageDraft("s1", "r1");
+    expect(reopened.imageDraft("s1")).toBeNull();
+    expect(storage.getItem(IMAGE_DRAFTS_KEY)).toBeNull();
+  });
+});
diff --git a/apps/desktop/src/chat/inflightJournal.ts b/apps/desktop/src/chat/inflightJournal.ts
new file mode 100644
index 0000000..38254f2
--- /dev/null
+++ b/apps/desktop/src/chat/inflightJournal.ts
@@ -0,0 +1,300 @@
+// The renderer's in-flight turn journal and image drafts (P20-20).
+//
+// While a turn streams, the visible tail of that turn (the person's message and the rows after it)
+// is copied to localStorage, so a renderer or app crash does not lose streamed progress; the
+// transcript (P20-18) folds a surviving entry back in on resume and clears it once the stored
+// history covers it. Best effort: storage that throws or is full never disturbs the chat.
+//
+// Sizes are counted in UTF-16 code units, the unit browsers charge localStorage in.
+//
+// Image drafts: a message with images is saved when sent and cleared on its acknowledgement; one
+// that survives a restart is offered back ("Restore image draft") and never sent on its own.
+
+export const JOURNAL_VERSION = 1;
+export const STORE_KEY = "indus.desktop.inflight.v1";
+export const IMAGE_DRAFTS_KEY = "indus.desktop.image-drafts.v1";
+
+export const MAX_STORE_CHARS = 4 * 1024 * 1024;
+export const MAX_ENTRY_CHARS = 160 * 1024;
+export const MAX_MESSAGES = 24;
+export const MAX_TEXT_PART_CHARS = 64 * 1024;
+export const MAX_METADATA_CHARS = 2 * 1024;
+export const MAX_ATTACHMENT_REFS = 256;
+export const MAX_AGE_MS = 7 * 24 * 60 * 60 * 1000;
+export const WRITE_THROTTLE_MS = 400;
+
+export interface JournalPart {
+  readonly type: "text" | "reasoning" | "tool";
+  readonly text: string;
+  /** Set when the text was cut to `MAX_TEXT_PART_CHARS`. */
+  readonly clipped?: true;
+}
+
+export interface JournalMessage {
+  readonly id: string;
+  readonly role: "user" | "assistant" | "tool";
+  readonly parts: readonly JournalPart[];
+  /** Attachment references (paths or upload ids), at most `MAX_ATTACHMENT_REFS`. */
+  readonly attachments?: readonly string[];
+  /** Small extra facts (tool name, status); dropped when over `MAX_METADATA_CHARS`. */
+  readonly metadata?: Readonly<Record<string, unknown>>;
+}
+
+export interface TurnSnapshot {
+  readonly turnId: string | null;
+  readonly startedAt: number | null;
+  readonly messages: readonly JournalMessage[];
+}
+
+export interface InflightEntry extends TurnSnapshot {
+  readonly sessionId: string;
+  readonly updatedAt: number;
+}
+
+interface Store {
+  version: typeof JOURNAL_VERSION;
+  entries: Record<string, InflightEntry>;
+}
+
+export interface StorageLike {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+}
+
+export type ShapeResult =
+  | { readonly ok: true; readonly entry: InflightEntry; readonly chars: number }
+  | { readonly ok: false; readonly reason: "too-large" };
+
+function clipPart(part: JournalPart): JournalPart {
+  if (part.text.length <= MAX_TEXT_PART_CHARS) return part;
+  return { type: part.type, text: part.text.slice(0, MAX_TEXT_PART_CHARS), clipped: true };
+}
+
+function shapeMessage(message: JournalMessage): JournalMessage {
+  const shaped: {
+    id: string;
+    role: JournalMessage["role"];
+    parts: JournalPart[];
+    attachments?: string[];
+    metadata?: Record<string, unknown>;
+  } = { id: message.id, role: message.role, parts: message.parts.map(clipPart) };
+  if (message.attachments && message.attachments.length > 0) {
+    shaped.attachments = message.attachments.slice(0, MAX_ATTACHMENT_REFS);
+  }
+  if (message.metadata !== undefined) {
+    let size = Number.POSITIVE_INFINITY;
+    try {
+      size = JSON.stringify(message.metadata).length;
+    } catch {
+      // not serializable: dropped
+    }
+    if (size <= MAX_METADATA_CHARS) shaped.metadata = { ...message.metadata };
+  }
+  return shaped;
+}
+
+/** Apply the per-entry limits; an entry still over `MAX_ENTRY_CHARS` is refused. */
+export function shapeEntry(sessionId: string, snapshot: TurnSnapshot, now: number): ShapeResult {
+  const messages = snapshot.messages.slice(-MAX_MESSAGES).map(shapeMessage);
+  const entry: InflightEntry = {
+    sessionId,
+    turnId: snapshot.turnId,
+    startedAt: snapshot.startedAt,
+    updatedAt: now,
+    messages,
+  };
+  const chars = JSON.stringify(entry).length;
+  if (chars > MAX_ENTRY_CHARS) return { ok: false, reason: "too-large" };
+  return { ok: true, entry, chars };
+}
+
+function defaultStorage(): StorageLike | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+export interface InflightJournalOptions {
+  storage?: StorageLike | null;
+  now?: () => number;
+}
+
+export interface ImageDraft {
+  readonly requestId: string;
+  readonly text: string;
+  readonly attachments: readonly string[];
+  readonly savedAt: number;
+}
+
+export class InflightJournal {
+  private readonly storage: StorageLike | null;
+  private readonly now: () => number;
+  private readonly pending = new Map<string, TurnSnapshot>();
+  private timer: ReturnType<typeof setTimeout> | null = null;
+
+  constructor(options: InflightJournalOptions = {}) {
+    this.storage = options.storage === undefined ? defaultStorage() : options.storage;
+    this.now = options.now ?? Date.now;
+  }
+
+  // -- store -------------------------------------------------------------------------------------
+
+  private load(): Store {
+    const empty: Store = { version: JOURNAL_VERSION, entries: {} };
+    if (this.storage === null) return empty;
+    try {
+      const raw = this.storage.getItem(STORE_KEY);
+      if (raw === null) return empty;
+      const parsed = JSON.parse(raw) as Partial<Store>;
+      if (parsed.version !== JOURNAL_VERSION || typeof parsed.entries !== "object") return empty;
+      return { version: JOURNAL_VERSION, entries: parsed.entries ?? {} };
+    } catch {
+      return empty;
+    }
+  }
+
+  private save(store: Store): void {
+    if (this.storage === null) return;
+    try {
+      if (Object.keys(store.entries).length === 0) this.storage.removeItem(STORE_KEY);
+      else this.storage.setItem(STORE_KEY, JSON.stringify(store));
+    } catch {
+      // full or blocked storage: the journal is best effort
+    }
+  }
+
+  // -- in-flight turns ---------------------------------------------------------------------------
+
+  /** Note the latest tail of a running turn; written at most every `WRITE_THROTTLE_MS`. */
+  record(sessionId: string, snapshot: TurnSnapshot): void {
+    this.pending.set(sessionId, snapshot);
+    if (this.timer !== null) return;
+    this.timer = setTimeout(() => {
+      this.timer = null;
+      this.flush();
+    }, WRITE_THROTTLE_MS);
+  }
+
+  /** Write every pending snapshot now (also used on unload). */
+  flush(): void {
+    if (this.timer !== null) {
+      clearTimeout(this.timer);
+      this.timer = null;
+    }
+    if (this.pending.size === 0) return;
+    const store = this.load();
+    const now = this.now();
+    for (const [sessionId, snapshot] of this.pending) {
+      const shaped = shapeEntry(sessionId, snapshot, now);
+      // A refused entry leaves the session's previous entry as it was.
+      if (shaped.ok) store.entries[sessionId] = shaped.entry;
+    }
+    this.pending.clear();
+    this.dropExpired(store, now);
+    this.fit(store);
+    this.save(store);
+  }
+
+  /** The surviving entry of a session (null when none or older than `MAX_AGE_MS`). */
+  read(sessionId: string): InflightEntry | null {
+    const entry = this.load().entries[sessionId];
+    if (entry === undefined || this.now() - entry.updatedAt > MAX_AGE_MS) return null;
+    return entry;
+  }
+
+  /** The turn ended or the stored history covers it. */
+  clear(sessionId: string): void {
+    this.pending.delete(sessionId);
+    const store = this.load();
+    if (!(sessionId in store.entries)) return;
+    delete store.entries[sessionId];
+    this.save(store);
+  }
+
+  /** Drop entries older than `MAX_AGE_MS`; returns how many went. */
+  prune(): number {
+    const store = this.load();
+    const removed = this.dropExpired(store, this.now());
+    if (removed > 0) this.save(store);
+    return removed;
+  }
+
+  private dropExpired(store: Store, now: number): number {
+    let removed = 0;
+    for (const [sessionId, entry] of Object.entries(store.entries)) {
+      if (now - entry.updatedAt > MAX_AGE_MS) {
+        delete store.entries[sessionId];
+        removed += 1;
+      }
+    }
+    return removed;
+  }
+
+  /** Evict the oldest entries until the store fits `MAX_STORE_CHARS`. */
+  private fit(store: Store): void {
+    const byAge = Object.values(store.entries).sort((a, b) => a.updatedAt - b.updatedAt);
+    let size = JSON.stringify(store).length;
+    for (const entry of byAge) {
+      if (size <= MAX_STORE_CHARS) return;
+      delete store.entries[entry.sessionId];
+      size = JSON.stringify(store).length;
+    }
+  }
+
+  // -- image drafts ------------------------------------------------------------------------------
+
+  private loadDrafts(): Record<string, ImageDraft> {
+    if (this.storage === null) return {};
+    try {
+      const raw = this.storage.getItem(IMAGE_DRAFTS_KEY);
+      const parsed: unknown = raw === null ? {} : JSON.parse(raw);
+      return typeof parsed === "object" && parsed !== null
+        ? (parsed as Record<string, ImageDraft>)
+        : {};
+    } catch {
+      return {};
+    }
+  }
+
+  private saveDrafts(drafts: Record<string, ImageDraft>): void {
+    if (this.storage === null) return;
+    try {
+      if (Object.keys(drafts).length === 0) this.storage.removeItem(IMAGE_DRAFTS_KEY);
+      else this.storage.setItem(IMAGE_DRAFTS_KEY, JSON.stringify(drafts));
+    } catch {
+      // best effort
+    }
+  }
+
+  /** Remember an image message until its acknowledgement. */
+  saveImageDraft(sessionId: string, draft: Omit<ImageDraft, "savedAt">): void {
+    const drafts = this.loadDrafts();
+    drafts[sessionId] = {
+      requestId: draft.requestId,
+      text: draft.text.slice(0, MAX_TEXT_PART_CHARS),
+      attachments: draft.attachments.slice(0, MAX_ATTACHMENT_REFS),
+      savedAt: this.now(),
+    };
+    this.saveDrafts(drafts);
+  }
+
+  /** The image draft to offer for a session, if one survived (never sent from here). */
+  imageDraft(sessionId: string): ImageDraft | null {
+    const draft = this.loadDrafts()[sessionId];
+    if (draft === undefined || this.now() - draft.savedAt > MAX_AGE_MS) return null;
+    return draft;
+  }
+
+  /** The message was acknowledged (or the person dismissed or restored the draft). */
+  clearImageDraft(sessionId: string, requestId?: string): void {
+    const drafts = this.loadDrafts();
+    const draft = drafts[sessionId];
+    if (draft === undefined) return;
+    if (requestId !== undefined && draft.requestId !== requestId) return;
+    delete drafts[sessionId];
+    this.saveDrafts(drafts);
+  }
+}
