+      const next = recall.step(event.key === "ArrowUp" ? -1 : 1, text);
+      if (next !== null) {
+        event.preventDefault();
+        store.update((state) => setDraft(state, key, next));
+      }
+      return;
+    }
+    if (event.key === "Enter" && !event.shiftKey) {
+      event.preventDefault();
+      void submit();
+    }
+  };
