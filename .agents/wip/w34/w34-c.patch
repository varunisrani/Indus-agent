+          <button
+            type="button"
+            aria-expanded={!stackHidden}
+            aria-label={t(stackHidden ? "composer.showStack" : "composer.hideStack")}
+            className="block h-2 w-full hover:bg-raised"
+            onClick={() => setStackHidden(!stackHidden)}
+          />
