+        {problem !== null ? (
+          <p role="alert" className="text-xs text-danger">
+            {problem}
+          </p>
+        ) : null}
+        <div className="mt-1 flex items-center gap-2">
+          <ModelPicker
+            sessionId={props.sessionId}
+            profile={props.profile ?? null}
+            connection={connection}
+            prefs={prefs}
+            open={pickerOpen}
+            onOpenChange={setPickerOpen}
+          />
+          {props.pickFiles !== undefined ? (
+            <button type="button" className={BUTTON} onClick={() => void pick()}>
+              {t("composer.attach")}
+            </button>
+          ) : null}
+          <span className="flex-1" />
+          {busy.running ? (
+            <>
+              <button type="button" className={BUTTON} onClick={() => void actions?.stop()}>
+                {t("composer.stop")}
+              </button>
+              <button
+                type="button"
+                className={BUTTON}
+                disabled={text.trim() === ""}
+                onClick={() => void steer()}
+              >
+                {t("composer.steer")}
+              </button>
+              <button
+                type="button"
+                className={BUTTON}
+                disabled={text.trim() === "" || sending}
+                onClick={() => void submit()}
+              >
+                {t("composer.queue")}
+              </button>
+            </>
+          ) : (
+            <button
+              type="button"
+              className={BUTTON}
+              disabled={(text.trim() === "" && attachments.length === 0) || sending}
+              onClick={() => void submit()}
+            >
+              {t("composer.send")}
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+function isGoneName(name: string | null): boolean {
+  return name === "SESSION_NOT_FOUND" || name === "SESSION_REFUSED";
+}
