+// The composer's model picker (P20-23).
+//
+// A pick applies to the session and becomes this device's sticky choice for the profile, which new
+// chats follow. It never writes the profile default, except the very first pick on a profile that
+// has none. Each model keeps its own effort and fast presets, applied with it. Favourites sort
+// first. Search ignores case and separators (`gpt4o` finds `gpt-4o`). A risky switch — another
+// provider in a session that already has messages, or the daemon's `CONFIRM_REQUIRED` — asks first.
+
+import type { MethodName, MethodTypes, ModelOptionsResult } from "@indus/protocol";
+import { useCallback, useEffect, useId, useMemo, useRef, useState } from "react";
+import {
+  type GatewayConnection,
+  type RequestOptions,
+  useGatewayConnection,
+} from "../gateway/connectionStore.ts";
+import { useT } from "../i18n/index.ts";
+import type { StorageLike } from "./inflightJournal.ts";
+import { errorMessage, errorName } from "./rpcErrors.ts";
+
+export interface ModelEntry {
+  readonly provider: string;
+  readonly providerName: string;
+  readonly model: string;
+  readonly authenticated: boolean;
+}
+
+export interface ModelChoice {
+  readonly provider: string;
+  readonly model: string;
+}
+
+export interface ModelPreset {
+  readonly effort?: string;
+  readonly fast?: boolean;
+}
+
+export const EFFORTS = ["minimal", "low", "medium", "high", "xhigh", "none"] as const;
+
+export const STICKY_PREFIX = "indus.desktop.model.";
+export const PRESETS_KEY = "indus.desktop.model-presets";
+export const FAVOURITES_KEY = "indus.desktop.model-favourites";
+export const DEFAULT_CHECKED_PREFIX = "indus.desktop.model-default-checked.";
+
+export const modelKey = (choice: ModelChoice): string => `${choice.provider}:${choice.model}`;
+
+/** Lower case with every separator (space, dash, underscore, dot, slash, colon) removed. */
+export function searchKey(text: string): string {
+  return text.toLowerCase().replace(/[\s\-_./:]+/g, "");
+}
+
+/**
+ * Entries matching `query`: the whole query with separators removed inside the model id
+ * (`gpt4o` → `gpt-4o`), or every word of it somewhere in provider and model (`anthropic haiku`).
+ */
+export function searchModels(entries: readonly ModelEntry[], query: string): ModelEntry[] {
+  const whole = searchKey(query);
+  if (whole === "") return [...entries];
+  const words = query
+    .split(/\s+/)
+    .map(searchKey)
+    .filter((word) => word !== "");
+  return entries.filter((entry) => {
+    if (searchKey(entry.model).includes(whole)) return true;
+    const haystack = searchKey(`${entry.providerName} ${entry.provider} ${entry.model}`);
+    return words.every((word) => haystack.includes(word));
+  });
+}
+
+/** Model rows from `model.options` (a provider may carry its known `models`). */
+export function entriesFrom(options: ModelOptionsResult): ModelEntry[] {
+  const rows: ModelEntry[] = [];
+  for (const provider of options.providers) {
+    const models = (provider as { models?: unknown }).models;
+    const list = Array.isArray(models)
+      ? models.filter((m): m is string => typeof m === "string" && m !== "")
+      : [];
+    if (provider.slug === options.provider && options.model && !list.includes(options.model)) {
+      list.unshift(options.model);
+    }
+    for (const model of list) {
+      rows.push({
+        provider: provider.slug,
+        providerName: provider.name,
+        model,
+        authenticated: provider.authenticated,
+      });
+    }
+  }
+  return rows;
+}
+
+/** Favourites first, then the catalogue order. */
+export function orderEntries(entries: readonly ModelEntry[], favourites: ReadonlySet<string>) {
+  const fav = entries.filter((entry) => favourites.has(modelKey(entry)));
+  const rest = entries.filter((entry) => !favourites.has(modelKey(entry)));
+  return [...fav, ...rest];
+}
+
+// -- per-device preferences ----------------------------------------------------------------------
+
+function defaultStorage(): StorageLike | null {
+  try {
+    return typeof window === "undefined" ? null : window.localStorage;
+  } catch {
+    return null;
+  }
+}
+
+function readJson<V>(storage: StorageLike | null, key: string, fallback: V): V {
+  if (storage === null) return fallback;
+  try {
+    const raw = storage.getItem(key);
+    return raw === null ? fallback : (JSON.parse(raw) as V);
+  } catch {
+    return fallback;
+  }
+}
+
+function writeJson(storage: StorageLike | null, key: string, value: unknown): void {
+  try {
+    storage?.setItem(key, JSON.stringify(value));
+  } catch {
+    // per-device conveniences are best effort
+  }
+}
+
+export class ModelPrefs {
+  private readonly storage: StorageLike | null;
+
+  constructor(storage: StorageLike | null = defaultStorage()) {
+    this.storage = storage;
+  }
+
+  private profileKey(profile: string | null): string {
+    return profile ?? "default";
+  }
+
+  sticky(profile: string | null): ModelChoice | null {
+    return readJson<ModelChoice | null>(
+      this.storage,
+      STICKY_PREFIX + this.profileKey(profile),
+      null,
+    );
+  }
+
+  setSticky(profile: string | null, choice: ModelChoice): void {
+    writeJson(this.storage, STICKY_PREFIX + this.profileKey(profile), choice);
+  }
+
+  favourites(): Set<string> {
+    return new Set(readJson<string[]>(this.storage, FAVOURITES_KEY, []));
+  }
+
+  toggleFavourite(key: string): Set<string> {
+    const now = this.favourites();
+    if (now.has(key)) now.delete(key);
+    else now.add(key);
+    writeJson(this.storage, FAVOURITES_KEY, [...now]);
+    return now;
+  }
+
+  preset(key: string): ModelPreset {
+    return readJson<Record<string, ModelPreset>>(this.storage, PRESETS_KEY, {})[key] ?? {};
+  }
+
+  setPreset(key: string, preset: ModelPreset): void {
+    const all = readJson<Record<string, ModelPreset>>(this.storage, PRESETS_KEY, {});
+    all[key] = preset;
+    writeJson(this.storage, PRESETS_KEY, all);
+  }
+
+  defaultChecked(profile: string | null): boolean {
+    return readJson(this.storage, DEFAULT_CHECKED_PREFIX + this.profileKey(profile), false);
+  }
+
+  markDefaultChecked(profile: string | null): void {
+    writeJson(this.storage, DEFAULT_CHECKED_PREFIX + this.profileKey(profile), true);
+  }
+}
+
+// -- applying a pick -----------------------------------------------------------------------------
+
+type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+export interface ApplyPick {
+  readonly request: Request;
+  readonly sessionId: string | null;
+  readonly profile: string | null;
+  readonly choice: ModelChoice;
+  /** The session's model now, if known. */
+  readonly current: ModelChoice | null;
+  /** The session already has messages. */
+  readonly hasHistory: boolean;
+  readonly prefs: ModelPrefs;
+  /** Ask the person; resolves true to go ahead. */
+  confirm(message: string): Promise<boolean>;
+}
+
+export type ApplyOutcome = "applied" | "deferred" | "sticky" | "cancelled" | "failed";
+
+function isEmptyDefault(value: unknown): boolean {
+  if (value === null || value === undefined) return true;
+  if (typeof value === "string") return value.trim() === "";
+  if (typeof value === "object") {
+    const inner =
+      (value as { default?: unknown; model?: unknown }).default ??
+      (value as { model?: unknown }).model;
+    return inner === undefined || inner === null || String(inner).trim() === "";
+  }
+  return false;
+}
+
+/** The first pick on a profile without a default writes it, once; later picks never do. */
+async function writeDefaultIfNone(pick: ApplyPick, value: string): Promise<void> {
+  if (pick.prefs.defaultChecked(pick.profile)) return;
+  let empty = false;
+  try {
+    const current = await pick.request("config.get", { key: "model.default" });
+    empty = isEmptyDefault(current.value);
+  } catch {
+    return; // unknown: try again on the next pick
+  }
+  if (empty) {
+    try {
+      await pick.request("config.set", { key: "model", value });
+    } catch {
+      return;
+    }
+  }
+  pick.prefs.markDefaultChecked(pick.profile);
+}
+
+export async function applyModelPick(
+  pick: ApplyPick,
+): Promise<{ outcome: ApplyOutcome; error?: string }> {
+  const { choice, sessionId, request } = pick;
+  const value = modelKey(choice);
+  const crossesProvider =
+    pick.current !== null &&
+    pick.current.provider !== "" &&
+    pick.current.provider !== choice.provider;
+  if (sessionId !== null && pick.hasHistory && crossesProvider) {
+    if (!(await pick.confirm("provider"))) return { outcome: "cancelled" };
+  }
+  pick.prefs.setSticky(pick.profile, choice);
+  if (sessionId === null) {
+    await writeDefaultIfNone(pick, value);
+    return { outcome: "sticky" };
+  }
+  const params = { key: "model" as const, value, session_id: sessionId };
+  let applied: string;
+  try {
+    applied = (await request("config.set", params)).applied;
+  } catch (error) {
+    if (errorName(error) !== "CONFIRM_REQUIRED")
+      return { outcome: "failed", error: errorMessage(error) };
+    if (!(await pick.confirm(errorMessage(error)))) return { outcome: "cancelled" };
+    try {
+      applied = (await request("config.set", { ...params, confirm: true })).applied;
+    } catch (again) {
+      return { outcome: "failed", error: errorMessage(again) };
+    }
+  }
+  const preset = pick.prefs.preset(value);
+  if (preset.effort !== undefined) {
+    await request("config.set", {
+      key: "reasoning",
+      value: preset.effort,
+      session_id: sessionId,
+    }).catch(() => {});
+  }
+  if (preset.fast !== undefined) {
+    await request("config.set", { key: "fast", value: preset.fast, session_id: sessionId }).catch(
+      () => {},
+    );
+  }
+  await writeDefaultIfNone(pick, value);
+  return { outcome: applied === "deferred" ? "deferred" : "applied" };
+}
+
+// -- the component -------------------------------------------------------------------------------
+
+export interface ModelPickerProps {
+  sessionId: string | null;
+  profile: string | null;
+  connection?: GatewayConnection | null;
+  /** The session's model and effort now (from `session.info`). */
+  current?: (ModelChoice & { effort?: string | null }) | null;
+  hasHistory?: boolean;
+  prefs?: ModelPrefs;
+  /** Opened from outside (the `/model` command). */
+  open?: boolean;
+  onOpenChange?: (open: boolean) => void;
+}
+
+type Confirming = { message: string; resolve: (ok: boolean) => void };
+
+export function ModelPicker(props: ModelPickerProps) {
+  const t = useT();
+  const active = useGatewayConnection();
+  const connection = props.connection === undefined ? active : props.connection;
+  const prefs = useMemo(() => props.prefs ?? new ModelPrefs(), [props.prefs]);
+  const [openState, setOpenState] = useState(false);
+  const open = props.open ?? openState;
+  const setOpen = useCallback(
+    (next: boolean) => {
+      setOpenState(next);
+      props.onOpenChange?.(next);
+    },
+    [props.onOpenChange],
+  );
+  const [options, setOptions] = useState<ModelOptionsResult | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [query, setQuery] = useState("");
+  const [favourites, setFavourites] = useState<Set<string>>(() => prefs.favourites());
+  const [confirming, setConfirming] = useState<Confirming | null>(null);
+  const [note, setNote] = useState<string | null>(null);
+  const [chosen, setChosen] = useState<ModelChoice | null>(null);
+  const [focusKey, setFocusKey] = useState<string | null>(null);
+  const [, setPresetVersion] = useState(0);
+  const bumpPresets = () => setPresetVersion((v) => v + 1);
+  const listId = useId();
+  const searchRef = useRef<HTMLInputElement>(null);
+
+  const load = useCallback(async () => {
+    if (connection === null) return;
+    setLoadError(null);
+    try {
+      setOptions(await connection.request("model.options", { session_id: props.sessionId }));
+    } catch (error) {
+      setLoadError(errorMessage(error));
+    }
+  }, [connection, props.sessionId]);
+
+  useEffect(() => {
+    if (open) {
+      void load();
+      searchRef.current?.focus();
+    }
+  }, [open, load]);
+
+  const current: ModelChoice | null =
+    chosen ??
+    props.current ??
+    (options ? { provider: options.provider, model: options.model } : null) ??
+    prefs.sticky(props.profile);
+  const entries = useMemo(
+    () => orderEntries(searchModels(options ? entriesFrom(options) : [], query), favourites),
+    [options, query, favourites],
+  );
+
+  const pick = async (entry: ModelEntry) => {
+    if (connection === null) return;
+    setNote(null);
+    const choice = { provider: entry.provider, model: entry.model };
+    const result = await applyModelPick({
+      request: connection.request.bind(connection) as Request,
+      sessionId: props.sessionId,
+      profile: props.profile,
+      choice,
+      current,
+      hasHistory: props.hasHistory ?? false,
+      prefs,
+      confirm: (message) =>
+        new Promise<boolean>((resolve) => {
+          setConfirming({
+            message:
+              message === "provider" ? t("model.confirmProvider", { model: entry.model }) : message,
+            resolve,
+          });
+        }),
+    });
+    setConfirming(null);
+    if (result.outcome === "failed") {
+      setNote(t("model.failed", { message: result.error ?? "" }));
+      return;
+    }
+    if (result.outcome === "cancelled") return;
+    setChosen(choice);
+    if (result.outcome === "deferred") setNote(t("model.deferred", { model: entry.model }));
+    setOpen(false);
+  };
+
+  const effort =
+    props.current?.effort ?? (current ? prefs.preset(modelKey(current)).effort : undefined);
+  const focused = entries.find((entry) => modelKey(entry) === focusKey) ?? null;
+  const focusedPreset = focused ? prefs.preset(modelKey(focused)) : {};
+
+  return (
+    <div className="relative inline-block" data-testid="model-picker">
+      <button
+        type="button"
+        aria-haspopup="dialog"
+        aria-expanded={open}
+        className="rounded-full border border-line px-2 py-0.5 text-xs hover:bg-raised"
+        onClick={() => setOpen(!open)}
+      >
+        {current ? current.model : t("model.none")}
+        {effort ? ` · ${effort}` : ""}
+      </button>
+      {note !== null ? <span className="ml-2 text-xs text-muted">{note}</span> : null}
+      {open ? (
+        <div
+          role="dialog"
+          aria-label={t("model.title")}
+          className="absolute bottom-full z-30 mb-1 w-80 rounded-lg border border-line bg-raised p-2 shadow-lg"
+          onKeyDown={(event) => {
+            if (event.key === "Escape") setOpen(false);
+          }}
+        >
+          <input
+            ref={searchRef}
+            type="search"
+            aria-label={t("model.search")}
+            aria-controls={listId}
+            placeholder={t("model.search")}
+            className="mb-2 w-full rounded border border-line bg-bg px-2 py-1 text-sm"
+            value={query}
+            onChange={(event) => setQuery(event.target.value)}
+          />
+          {loadError !== null ? (
+            <p role="alert" className="text-xs text-danger">
+              {t("model.loadFailed", { message: loadError })}{" "}
+              <button type="button" className="underline" onClick={() => void load()}>
+                {t("model.retry")}
+              </button>
+            </p>
+          ) : null}
+          <ul id={listId} aria-label={t("model.title")} className="max-h-64 overflow-auto">
+            {entries.map((entry) => {
+              const key = modelKey(entry);
+              const selected = current !== null && modelKey(current) === key;
+              return (
+                <li
+                  key={key}
+                  data-model={key}
+                  className="flex items-center gap-2 rounded px-1 text-sm hover:bg-bg"
+                >
+                  <button
+                    type="button"
+                    aria-label={t(favourites.has(key) ? "model.unfavourite" : "model.favourite", {
+                      model: entry.model,
+                    })}
+                    aria-pressed={favourites.has(key)}
+                    className="text-xs"
+                    onClick={() => setFavourites(prefs.toggleFavourite(key))}
+                  >
+                    {favourites.has(key) ? "★" : "☆"}
+                  </button>
+                  <button
+                    type="button"
+                    className="flex-1 truncate text-left py-1"
+                    aria-current={selected ? "true" : undefined}
+                    onFocus={() => setFocusKey(key)}
+                    onMouseEnter={() => setFocusKey(key)}
+                    onClick={() => void pick(entry)}
+                  >
+                    {entry.model}
+                    <span className="ml-2 text-xs text-muted">{entry.providerName}</span>
+                  </button>
+                </li>
+              );
+            })}
+            {options !== null && entries.length === 0 ? (
+              <li className="px-1 py-1 text-xs text-muted">{t("model.noMatch")}</li>
+            ) : null}
+          </ul>
+          {focused !== null ? (
+            <div className="mt-2 flex items-center gap-2 border-t border-line pt-2 text-xs">
+              <label className="flex items-center gap-1">
+                {t("model.effort")}
+                <select
+                  aria-label={t("model.effortFor", { model: focused.model })}
+                  value={focusedPreset.effort ?? ""}
+                  onChange={(event) => {
+                    const { effort: _previous, ...rest } = focusedPreset;
+                    const value = event.target.value;
+                    prefs.setPreset(
+                      modelKey(focused),
+                      value === "" ? rest : { ...rest, effort: value },
+                    );
+                    bumpPresets();
+                  }}
+                >
+                  <option value="">{t("model.effortKeep")}</option>
+                  {EFFORTS.map((level) => (
+                    <option key={level} value={level}>
+                      {level}
+                    </option>
+                  ))}
+                </select>
+              </label>
+              <label className="flex items-center gap-1">
+                <input
+                  type="checkbox"
+                  aria-label={t("model.fastFor", { model: focused.model })}
+                  checked={focusedPreset.fast === true}
+                  onChange={(event) => {
+                    prefs.setPreset(modelKey(focused), {
+                      ...focusedPreset,
+                      fast: event.target.checked,
+                    });
+                    bumpPresets();
+                  }}
+                />
+                {t("model.fast")}
+              </label>
+            </div>
+          ) : null}
+          {confirming !== null ? (
+            <div
+              role="alertdialog"
+              aria-label={t("model.confirmTitle")}
+              className="mt-2 rounded border border-warn p-2 text-xs"
+            >
+              <p>{confirming.message}</p>
+              <div className="mt-1 flex justify-end gap-2">
+                <button type="button" onClick={() => confirming.resolve(false)}>
+                  {t("model.keep")}
+                </button>
+                <button
+                  type="button"
+                  className="rounded bg-accent px-2 text-accent-fg"
+                  onClick={() => confirming.resolve(true)}
+                >
+                  {t("model.switch")}
+                </button>
+              </div>
+            </div>
+          ) : null}
+        </div>
+      ) : null}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/chat/QueuePanel.tsx b/apps/desktop/src/chat/QueuePanel.tsx
new file mode 100644
index 0000000..584a560
--- /dev/null
+++ b/apps/desktop/src/chat/QueuePanel.tsx
@@ -0,0 +1,103 @@
+// The queue section of the composer's status stack (P20-21): the daemon's queued inputs, the
+// inputs this window holds while the queue is paused, a lost turn's single Discard, and journaled
+// inputs whose last send had no definite answer.
+
+import { useSyncExternalStore } from "react";
+import { useT } from "../i18n/index.ts";
+import type { BusySnapshot, ChatActions } from "./busyActions.ts";
+
+export function useBusySnapshot(actions: ChatActions): BusySnapshot {
+  return useSyncExternalStore(actions.subscribe, actions.snapshot, actions.snapshot);
+}
+
+const ROW = "flex items-center gap-2 py-1 text-sm";
+const BUTTON =
+  "rounded px-2 py-0.5 text-xs border border-line hover:bg-raised focus-visible:outline-2 focus-visible:outline-focus";
+
+export function QueuePanel({ actions }: { actions: ChatActions }) {
+  const t = useT();
+  const state = useBusySnapshot(actions);
+  const waiting = state.queue.length + state.held.length;
+  if (waiting === 0 && state.lost === null && state.uncertain.length === 0) return null;
+
+  const header =
+    state.lost !== null
+      ? t("queue.blocked", { count: waiting })
+      : state.paused
+        ? t("queue.paused", { count: waiting })
+        : t("queue.waiting", { count: waiting });
+
+  return (
+    <section aria-label={t("queue.label")} className="px-3 py-2" data-testid="queue-panel">
+      <div className="flex items-center gap-2 text-xs text-muted">
+        <span>{header}</span>
+        {state.paused && state.lost === null ? (
+          <button type="button" className={BUTTON} onClick={() => void actions.resume()}>
+            {t("queue.resume")}
+          </button>
+        ) : null}
+      </div>
+
+      {state.lost !== null ? (
+        <div className={ROW} role="alert">
+          <span className="flex-1">{t("queue.lostTurn")}</span>
+          <button type="button" className={BUTTON} onClick={() => void actions.discard()}>
+            {t("queue.discard")}
+          </button>
+        </div>
+      ) : null}
+
+      <ol className="list-none p-0 m-0">
+        {state.queue.map((entry) => (
+          <li key={entry.admissionId} className={ROW} data-state="queued">
+            <span className="flex-1 truncate">{entry.text ?? t("queue.otherSurface")}</span>
+            {entry.mine ? (
+              <button
+                type="button"
+                className={BUTTON}
+                aria-label={t("queue.removeItem")}
+                onClick={() => void actions.cancelQueued(entry.admissionId)}
+              >
+                {t("queue.remove")}
+              </button>
+            ) : null}
+          </li>
+        ))}
+        {state.held.map((item) => (
+          <li key={item.requestId} className={ROW} data-state={item.failed ? "failed" : "held"}>
+            <span className="flex-1 truncate">{item.text}</span>
+            {item.failed ? <span className="text-danger text-xs">{t("queue.gaveUp")}</span> : null}
+            <button
+              type="button"
+              className={BUTTON}
+              aria-label={t("queue.removeItem")}
+              onClick={() => actions.removeHeld(item.requestId)}
+            >
+              {t("queue.remove")}
+            </button>
+          </li>
+        ))}
+      </ol>
+
+      {state.uncertain.map((item) => (
+        <div key={item.requestId} className={ROW} data-state="uncertain">
+          <span className="flex-1 truncate">{t("queue.uncertain", { text: item.text })}</span>
+          <button
+            type="button"
+            className={BUTTON}
+            onClick={() => void actions.retryUncertain(item.requestId)}
+          >
+            {t("queue.retry")}
+          </button>
+          <button
+            type="button"
+            className={BUTTON}
+            onClick={() => void actions.dismissUncertain(item.requestId)}
+          >
+            {t("queue.dismiss")}
+          </button>
+        </div>
+      ))}
+    </section>
+  );
+}
diff --git a/apps/desktop/src/chat/busyActions.test.ts b/apps/desktop/src/chat/busyActions.test.ts
new file mode 100644
index 0000000..ca19d64
--- /dev/null
+++ b/apps/desktop/src/chat/busyActions.test.ts
@@ -0,0 +1,336 @@
+import { GatewayRpcError, RpcTimeout } from "@indus/client";
+import { ERROR_CODES, type ErrorName } from "@indus/protocol";
+import { describe, expect, it } from "vitest";
+import type { SessionEvent } from "../gateway/connectionStore.ts";
+import {
+  ChatActions,
+  MAX_AUTO_DRAIN_ATTEMPTS,
+  type PreparedJournalPort,
+  type Request,
+} from "./busyActions.ts";
+
+const SID = "s1";
+
+function rpcError(name: ErrorName, message = name): GatewayRpcError {
+  return new GatewayRpcError(ERROR_CODES[name].code, message);
+}
+
+type Handler = (params: Record<string, unknown>) => unknown;
+
+/** A scripted daemon: answers calls, records them, emits events into the actions. */
+class FakeDaemon {
+  readonly calls: Array<{ method: string; params: Record<string, unknown> }> = [];
+  readonly handlers = new Map<string, Handler>();
+  private seq = 0;
+  private admissions = 0;
+  actions: ChatActions | null = null;
+
+  request: Request = (async (method: string, params: unknown) => {
+    const p = params as Record<string, unknown>;
+    this.calls.push({ method, params: p });
+    const handler = this.handlers.get(method);
+    if (handler === undefined) throw rpcError("METHOD_NOT_FOUND");
+    return handler(p);
+  }) as Request;
+
+  emit(event: Record<string, unknown>): void {
+    this.seq += 1;
+    this.actions?.handleEvent({ session_id: SID, seq: this.seq, ...event } as SessionEvent);
+  }
+
+  nextAdmission(): string {
+    this.admissions += 1;
+    return `adm-${this.admissions}`;
+  }
+
+  called(method: string) {
+    return this.calls.filter((call) => call.method === method);
+  }
+}
+
+class MemoryJournal implements PreparedJournalPort {
+  readonly entries = new Map<string, { sessionId: string; state: string; payload: unknown }>();
+  readonly log: string[] = [];
+  async prepare(entry: { requestId: string; sessionId: string; payload: unknown }) {
+    this.log.push(`prepare ${entry.requestId}`);
+    this.entries.set(entry.requestId, { ...entry, state: "prepared" });
+    return { ok: true };
+  }
+  async retire(entry: { requestId: string; receipt: { outcome: string } }) {
+    this.log.push(`retire ${entry.requestId} ${entry.receipt.outcome}`);
+    const found = this.entries.get(entry.requestId);
+    if (found === undefined) return { retired: false };
+    if (entry.receipt.outcome === "unknown") {
+      found.state = "uncertain";
+      return { retired: false };
+    }
+    this.entries.delete(entry.requestId);
+    return { retired: true };
+  }
+  async list() {
+    return {
+      entries: [...this.entries].map(([requestId, entry]) => ({ requestId, ...entry })),
+    };
+  }
+}
+
+function setup(options: { journal?: PreparedJournalPort | null } = {}) {
+  const daemon = new FakeDaemon();
+  let ids = 0;
+  const actions = new ChatActions({
+    sessionId: SID,
+    request: daemon.request,
+    journal: options.journal ?? null,
+    newId: () => {
+      ids += 1;
+      return `req-${ids}`;
+    },
+    sleep: async () => {},
+  });
+  daemon.actions = actions;
+  // A daemon that runs the first input and queues the rest while it runs.
+  let running = false;
+  daemon.handlers.set("prompt.submit", (params) => {
+    const admission = daemon.nextAdmission();
+    if (running || params.when_busy === "queue") {
+      const position = actions.snapshot().queue.length + 1;
+      daemon.emit({ type: "admission.state", admission_id: admission, state: "queued", position });
+      return { turn_id: admission, status: "queued" };
+    }
+    running = true;
+    return { turn_id: admission, generation: 7, status: "streaming" };
+  });
+  daemon.handlers.set("session.interrupt", () => ({ interrupted: true }));
+  daemon.handlers.set("admission.cancel", (params) => {
+    daemon.emit({
+      type: "admission.state",
+      admission_id: params.admission_id,
+      state: "terminal",
+      outcome: "cancelled",
+    });
+    return { cancelled: true };
+  });
+  return { daemon, actions, setRunning: (value: boolean) => (running = value) };
+}
+
+describe("busy actions", () => {
+  it("stop carries the generation of the running turn", async () => {
+    const { daemon, actions } = setup();
+    expect(await actions.send("hello")).toBe("started");
+    daemon.emit({ type: "turn.started", turn_id: "adm-1", generation: 7 });
+    expect(await actions.stop()).toBe(true);
+    expect(daemon.called("session.interrupt")[0]?.params).toEqual({
+      session_id: SID,
+      generation: 7,
+    });
+  });
+
+  it("stop waits for the submit answer instead of interrupting blindly", async () => {
+    const { daemon, actions } = setup();
+    let release: () => void = () => {};
+    daemon.handlers.set(
+      "prompt.submit",
+      () =>
+        new Promise((resolve) => {
+          release = () => resolve({ turn_id: "adm-9", generation: 3, status: "streaming" });
+        }),
+    );
+    const sending = actions.send("go");
+    const stopping = actions.stop();
+    await Promise.resolve();
+    expect(daemon.called("session.interrupt")).toHaveLength(0);
+    release();
+    await sending;
+    await stopping;
+    expect(daemon.called("session.interrupt")[0]?.params.generation).toBe(3);
+  });
+
+  it("stop with a queue pauses it and Resume sends the items back in order", async () => {
+    const { daemon, actions, setRunning } = setup();
+    await actions.send("first");
+    daemon.emit({ type: "turn.started", turn_id: "adm-1", generation: 7 });
+    expect(await actions.send("second")).toBe("queued");
+    expect(await actions.queue("third")).toBe("queued");
+    expect(actions.snapshot().queue.map((entry) => entry.text)).toEqual(["second", "third"]);
+
+    await actions.stop();
+    const paused = actions.snapshot();
+    expect(paused.paused).toBe(true);
+    expect(paused.queue).toEqual([]);
+    expect(paused.held.map((item) => item.text)).toEqual(["second", "third"]);
+    expect(daemon.called("admission.cancel").map((call) => call.params.admission_id)).toEqual([
+      "adm-2",
+      "adm-3",
+    ]);
+
+    daemon.emit({ type: "turn.done", turn_id: "adm-1", reason: "interrupted" });
+    setRunning(false);
+    const before = daemon.called("prompt.submit").length;
+    await actions.resume();
+    const resent = daemon.called("prompt.submit").slice(before);
+    expect(resent.map((call) => call.params.text)).toEqual(["second", "third"]);
+    expect(resent.every((call) => call.params.when_busy === "queue")).toBe(true);
+    expect(actions.snapshot().held).toEqual([]);
+    expect(actions.snapshot().paused).toBe(false);
+  });
+
+  it("an unknown turn shows one Discard, blocks the queue and is never resubmitted", async () => {
+    const { daemon, actions } = setup();
+    daemon.handlers.set("admission.discard", () => ({ discarded: true }));
+    daemon.emit({
+      type: "admission.state",
+      admission_id: "adm-lost",
+      state: "unknown",
+      generation: 4,
+    });
+    const blocked = actions.snapshot();
+    expect(blocked.lost).toEqual({ admissionId: "adm-lost", generation: 4 });
+    // resume is blocked while the lost turn is unresolved
+    await actions.resume();
+    expect(daemon.called("prompt.submit")).toHaveLength(0);
+    expect(await actions.discard()).toBe(true);
+    expect(daemon.called("admission.discard")[0]?.params).toEqual({
+      session_id: SID,
+      admission_id: "adm-lost",
+      generation: 4,
+    });
+    expect(actions.snapshot().lost).toBeNull();
+    expect(daemon.called("prompt.submit")).toHaveLength(0);
+  });
+
+  it("a lost turn without a generation asks the receipt for it", async () => {
+    const { daemon, actions } = setup();
+    daemon.handlers.set("admission.receipt", () => ({
+      admission_id: "adm-lost",
+      session_id: SID,
+      state: "unknown",
+      generation: 9,
+    }));
+    daemon.handlers.set("admission.discard", () => ({}));
+    daemon.emit({ type: "admission.state", admission_id: "adm-lost", state: "unknown" });
+    await actions.discard();
+    expect(daemon.called("admission.discard")[0]?.params.generation).toBe(9);
+  });
+
+  it("the fifth drain failure is not attempted", async () => {
+    const { daemon, actions } = setup();
+    await actions.send("first");
+    daemon.emit({ type: "turn.started", turn_id: "adm-1", generation: 7 });
+    await actions.queue("waiting");
+    await actions.stop();
+    daemon.handlers.set("prompt.submit", () => {
+      throw rpcError("QUEUE_FULL");
+    });
+    const before = daemon.called("prompt.submit").length;
+    await actions.resume();
+    expect(daemon.called("prompt.submit").length - before).toBe(MAX_AUTO_DRAIN_ATTEMPTS);
+    const [item] = actions.snapshot().held;
+    expect(item).toMatchObject({ text: "waiting", failures: 4, failed: true });
+    expect(actions.snapshot().paused).toBe(true);
+    // a manual Resume starts a fresh round
+    await actions.resume();
+    expect(daemon.called("prompt.submit").length - before).toBe(2 * MAX_AUTO_DRAIN_ATTEMPTS);
+  });
+
+  it("steer goes to the running turn with its generation; a refused steer becomes a prompt", async () => {
+    const { daemon, actions, setRunning } = setup();
+    await actions.send("first");
+    daemon.emit({ type: "turn.started", turn_id: "adm-1", generation: 7 });
+    daemon.handlers.set("session.steer", () => ({ queued: true, ticket: "t" }));
+    expect(await actions.steer("focus on tests")).toBe("steered");
+    expect(daemon.called("session.steer")[0]?.params).toEqual({
+      session_id: SID,
+      text: "focus on tests",
+      generation: 7,
+    });
+    daemon.handlers.set("session.steer", () => ({ queued: false }));
+    setRunning(false);
+    expect(await actions.steer("late guidance")).toBe("started");
+    expect(daemon.called("prompt.submit").at(-1)?.params.text).toBe("late guidance");
+  });
+
+  it("a busy refusal on an idle-looking session queues the same input", async () => {
+    const { daemon, actions } = setup();
+    let first = true;
+    daemon.handlers.set("prompt.submit", (params) => {
+      if (first) {
+        first = false;
+        throw rpcError("SESSION_BUSY");
+      }
+      return { turn_id: "adm-5", status: params.when_busy === "queue" ? "queued" : "streaming" };
+    });
+    expect(await actions.send("hi")).toBe("queued");
+    const [a, b] = daemon.called("prompt.submit");
+    expect(a?.params.request_id).toBe(b?.params.request_id);
+    expect(b?.params.when_busy).toBe("queue");
+  });
+
+  it("journals every submit: prepare, then retire with the receipt", async () => {
+    const journal = new MemoryJournal();
+    const { daemon, actions } = setup({ journal });
+    await actions.send("hello");
+    expect(journal.log).toEqual(["prepare req-1", "retire req-1 accepted"]);
+    expect(daemon.called("prompt.submit")[0]?.params.request_id).toBe("req-1");
+    expect(journal.entries.size).toBe(0);
+  });
+
+  it("an uncertain answer keeps the entry and a retry reuses the request id", async () => {
+    const journal = new MemoryJournal();
+    const { daemon, actions } = setup({ journal });
+    daemon.handlers.set("prompt.submit", () => {
+      throw new RpcTimeout("prompt.submit", 1);
+    });
+    expect(await actions.send("maybe")).toBe("uncertain");
+    expect(journal.entries.get("req-1")?.state).toBe("uncertain");
+    expect(actions.snapshot().uncertain).toEqual([{ requestId: "req-1", text: "maybe" }]);
+    daemon.handlers.set("prompt.submit", () => ({
+      turn_id: "adm-1",
+      generation: 1,
+      status: "streaming",
+    }));
+    expect(await actions.retryUncertain("req-1")).toBe("started");
+    expect(daemon.called("prompt.submit").map((call) => call.params.request_id)).toEqual([
+      "req-1",
+      "req-1",
+    ]);
+    expect(journal.entries.size).toBe(0);
+    expect(actions.snapshot().uncertain).toEqual([]);
+  });
+
+  it("offers prepared entries after a restart, for this session only", async () => {
+    const journal = new MemoryJournal();
+    await journal.prepare({ requestId: "old-1", sessionId: SID, payload: { text: "left over" } });
+    await journal.prepare({
+      requestId: "old-2",
+      sessionId: "other",
+      payload: { text: "not mine" },
+    });
+    const { actions, daemon } = setup({ journal });
+    expect(await actions.recoverPrepared()).toEqual([{ requestId: "old-1", text: "left over" }]);
+    // never sent on its own
+    expect(daemon.called("prompt.submit")).toHaveLength(0);
+    await actions.dismissUncertain("old-1");
+    expect(journal.entries.has("old-1")).toBe(false);
+  });
+
+  it("a journal that refuses means nothing is sent", async () => {
+    const journal = new MemoryJournal();
+    journal.prepare = async () => {
+      throw new Error("too-large: the input is too big");
+    };
+    const { daemon, actions } = setup({ journal });
+    expect(await actions.send("x")).toBe("rejected");
+    expect(daemon.called("prompt.submit")).toHaveLength(0);
+    expect(actions.snapshot().error).toContain("too-large");
+  });
+
+  it("a definite rejection retires the entry as rejected", async () => {
+    const journal = new MemoryJournal();
+    const { daemon, actions } = setup({ journal });
+    daemon.handlers.set("prompt.submit", () => {
+      throw rpcError("TEXT_EMPTY");
+    });
+    expect(await actions.send("   x")).toBe("rejected");
+    expect(journal.log.at(-1)).toBe("retire req-1 rejected");
+  });
+});
diff --git a/apps/desktop/src/chat/busyActions.ts b/apps/desktop/src/chat/busyActions.ts
new file mode 100644
index 0000000..c22414c
--- /dev/null
+++ b/apps/desktop/src/chat/busyActions.ts
@@ -0,0 +1,577 @@
+// Sending, and what the person can do while a turn runs (P20-21): Stop, Steer, Queue.
+//
+// The queue lives on the daemon: `prompt.submit { when_busy: "queue" }` puts an input in the
+// session's durable FIFO, shared by every window and surface; `admission.state` events tell us
+// where it stands. Stop interrupts exactly the running turn (its generation, never "the latest").
+// With inputs waiting, Stop also pauses the queue: the daemon has no pause, so the inputs THIS
+// window queued are withdrawn (`admission.cancel`) and held here, in order, until Resume. Resume
+// (the drain) sends them back one at a time and gives up on an item after
+// `MAX_AUTO_DRAIN_ATTEMPTS` failures. A turn whose outcome is unknown after a daemon restart
+// blocks the queue and offers one Discard; nothing is ever resubmitted on its own (R03.21).
+//
+// Every input goes through the prepared-submission journal (P20-20): prepare → submit with the
+// journal's request id → retire with the receipt. An uncertain answer keeps the entry; the person
+// retries (same request id: the daemon runs it at most once) or dismisses it.
+
+import type { MethodName, MethodTypes, PromptSubmitResult } from "@indus/protocol";
+import {
+  REQUEST_TIMEOUTS,
+  type RequestOptions,
+  type SessionEvent,
+} from "../gateway/connectionStore.ts";
+import type { InflightJournal } from "./inflightJournal.ts";
+import { errorMessage, errorName, isUncertain } from "./rpcErrors.ts";
+
+export const MAX_AUTO_DRAIN_ATTEMPTS = 4;
+/** Pause between drain attempts of the same item (times the attempt number). */
+export const DRAIN_RETRY_MS = 500;
+
+export type Request = <M extends MethodName>(
+  method: M,
+  params: MethodTypes[M]["params"],
+  options?: RequestOptions,
+) => Promise<MethodTypes[M]["result"]>;
+
+/** An input waiting in the daemon's FIFO. */
+export interface QueueEntry {
+  readonly admissionId: string;
+  readonly position: number | null;
+  /** The text, when this window queued it. */
+  readonly text: string | null;
+  readonly mine: boolean;
+}
+
+/** An input held in this window while the queue is paused. */
+export interface HeldItem {
+  readonly requestId: string;
+  readonly text: string;
+  readonly failures: number;
+  /** The drain gave up on it after `MAX_AUTO_DRAIN_ATTEMPTS`. */
+  readonly failed: boolean;
+}
+
+/** A turn lost to a daemon restart. */
+export interface LostTurn {
+  readonly admissionId: string;
+  readonly generation: number | null;
+}
+
+/** A journaled input whose last send had no definite answer. */
+export interface UncertainSubmission {
+  readonly requestId: string;
+  readonly text: string;
+}
+
+export interface BusySnapshot {
+  readonly running: boolean;
+  readonly turnId: string | null;
+  readonly generation: number | null;
+  readonly queue: readonly QueueEntry[];
+  readonly held: readonly HeldItem[];
+  /** Held items wait for Resume. */
+  readonly paused: boolean;
+  readonly draining: boolean;
+  readonly lost: LostTurn | null;
+  readonly uncertain: readonly UncertainSubmission[];
+  readonly error: string | null;
+  /** The protocol name of the last failure (`SESSION_NOT_FOUND`, …), when it had one. */
+  readonly errorName: string | null;
+}
+
+export interface PreparedJournalPort {
+  prepare(entry: { requestId: string; sessionId: string; payload: unknown }): Promise<unknown>;
+  retire(entry: {
+    requestId: string;
+    receipt: { outcome: "accepted" | "rejected" | "unknown"; admissionId?: string };
+  }): Promise<unknown>;
+  list(): Promise<{
+    entries: Array<{ requestId: string; sessionId: string; state: string; payload: unknown }>;
+  }>;
+}
+
+export interface SendOptions {
+  /** Image references in the message: kept as an image draft until acknowledged. */
+  readonly images?: readonly string[];
+}
+
+export type SendOutcome =
+  | "started"
+  | "queued"
+  | "steered"
+  | "uncertain"
+  | "rejected"
+  | "blocked"
+  | "empty";
+
+export interface ChatActionsOptions {
+  sessionId: string;
+  request: Request;
+  /** Defaults to the desktop bridge's journal; null runs without one (tests, browsers). */
+  journal?: PreparedJournalPort | null;
+  inflight?: InflightJournal | null;
+  newId?: () => string;
+  /** Waits between drain attempts; tests pass an instant one. */
+  sleep?: (ms: number) => Promise<void>;
+}
+
+interface Mine {
+  readonly requestId: string;
+  readonly text: string;
+}
+
+function bridgeJournal(): PreparedJournalPort | null {
+  const bridge = (globalThis as { indusDesktop?: { journal?: PreparedJournalPort } }).indusDesktop;
+  return bridge?.journal ?? null;
+}
+
+function textOf(payload: unknown): string {
+  const text = (payload as { text?: unknown } | null)?.text;
+  return typeof text === "string" ? text : "";
+}
+
+const realSleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));
+
+export class ChatActions {
+  readonly sessionId: string;
+  private readonly request: Request;
+  private readonly journal: PreparedJournalPort | null;
+  private readonly inflight: InflightJournal | null;
+  private readonly newId: () => string;
+  private readonly sleep: (ms: number) => Promise<void>;
+  private readonly listeners = new Set<() => void>();
+  /** Admission id → what this window sent under it. */
+  private readonly mine = new Map<string, Mine>();
+  private pendingSubmit: Promise<unknown> | null = null;
+  private state: BusySnapshot = {
+    running: false,
+    turnId: null,
+    generation: null,
+    queue: [],
+    held: [],
+    paused: false,
+    draining: false,
+    lost: null,
+    uncertain: [],
+    error: null,
+    errorName: null,
+  };
+
+  constructor(options: ChatActionsOptions) {
+    this.sessionId = options.sessionId;
+    this.request = options.request;
+    this.journal = options.journal === undefined ? bridgeJournal() : options.journal;
+    this.inflight = options.inflight ?? null;
+    this.newId = options.newId ?? (() => crypto.randomUUID());
+    this.sleep = options.sleep ?? realSleep;
+  }
+
+  // -- state ---------------------------------------------------------------------------------------
+
+  snapshot = (): BusySnapshot => this.state;
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  };
+
+  private fail(error: unknown): void {
+    this.set({ error: errorMessage(error), errorName: errorName(error) ?? null });
+  }
+
+  private set(patch: Partial<BusySnapshot>): void {
+    const next = { ...this.state, ...patch };
+    next.paused = next.held.length > 0 && !next.draining;
+    this.state = next;
+    for (const listener of this.listeners) listener();
+  }
+
+  /** Feed the session's events (`GatewayConnection.onSessionEvent`). */
+  handleEvent(event: SessionEvent): void {
+    if (event.session_id !== this.sessionId) return;
+    switch (event.type) {
+      case "turn.started":
+        this.set({ running: true, turnId: event.turn_id, generation: event.generation });
+        return;
+      case "turn.done":
+        if (this.state.turnId === null || this.state.turnId === event.turn_id) {
+          this.set({ running: false, turnId: null, generation: null });
+        }
+        return;
+      case "session.info":
+        if (event.running === false && this.state.running) {
+          this.set({ running: false, turnId: null, generation: null });
+        }
+        return;
+      case "admission.state":
+        this.onAdmission(event.admission_id, event.state, event.generation, event.position);
+        return;
+      default:
+        return;
+    }
+  }
+
+  private onAdmission(
+    admissionId: string,
+    state: string,
+    generation: number | null | undefined,
+    position: number | null | undefined,
+  ): void {
+    const others = this.state.queue.filter((entry) => entry.admissionId !== admissionId);
+    if (state === "queued") {
+      const known = this.mine.get(admissionId);
+      const entry: QueueEntry = {
+        admissionId,
+        position: position ?? null,
+        text: known?.text ?? null,
+        mine: known !== undefined,
+      };
+      this.set({ queue: sortQueue([...others, entry]) });
+      return;
+    }
+    if (state === "unknown") {
+      this.set({
+        queue: others,
+        lost: { admissionId, generation: generation ?? null },
+      });
+      return;
+    }
+    // started or terminal: it left the queue
+    const patch: { -readonly [K in keyof BusySnapshot]?: BusySnapshot[K] } = { queue: others };
+    if (state === "terminal" && this.state.lost?.admissionId === admissionId) patch.lost = null;
+    if (state === "started" && typeof generation === "number") {
+      patch.running = true;
+      patch.generation = generation;
+      patch.turnId = admissionId;
+    }
+    this.set(patch);
+  }
+
+  // -- sending -------------------------------------------------------------------------------------
+
+  /** Enter in the composer: a new turn when idle, the queue while a turn runs. */
+  send(text: string, options: SendOptions = {}): Promise<SendOutcome> {
+    return this.submit(text, this.state.running ? "queue" : null, options);
+  }
+
+  /** Queue explicitly. */
+  queue(text: string): Promise<SendOutcome> {
+    return this.submit(text, "queue", {});
+  }
+
+  private async submit(
+    text: string,
+    whenBusy: "queue" | null,
+    options: SendOptions,
+    requestId: string = this.newId(),
+  ): Promise<SendOutcome> {
+    if (text.trim() === "") return "empty";
+    const run = this.submitOnce(text, whenBusy, options, requestId);
+    this.pendingSubmit = run;
+    try {
+      return await run;
+    } finally {
+      if (this.pendingSubmit === run) this.pendingSubmit = null;
+    }
+  }
+
+  private async submitOnce(
+    text: string,
+    whenBusy: "queue" | null,
+    options: SendOptions,
+    requestId: string,
+    offerRetry = true,
+  ): Promise<SendOutcome> {
+    if (this.journal !== null) {
+      try {
+        await this.journal.prepare({ requestId, sessionId: this.sessionId, payload: { text } });
+      } catch (error) {
+        // Never send what could not be journaled: the text stays in the composer.
+        this.fail(error);
+        return "rejected";
+      }
+    }
+    const images = options.images ?? [];
+    if (images.length > 0) {
+      this.inflight?.saveImageDraft(this.sessionId, { requestId, text, attachments: images });
+    }
+    let result: PromptSubmitResult;
+    try {
+      result = await this.request(
+        "prompt.submit",
+        {
+          session_id: this.sessionId,
+          text,
+          request_id: requestId,
+          ...(whenBusy === null ? {} : { when_busy: whenBusy }),
+        },
+        { timeoutMs: REQUEST_TIMEOUTS.promptSubmit },
+      );
+    } catch (error) {
+      if (errorName(error) === "SESSION_BUSY" && whenBusy === null) {
+        // The turn started elsewhere a moment ago: the same input goes to the queue.
+        return this.submitOnce(text, "queue", options, requestId, offerRetry);
+      }
+      if (isUncertain(error)) {
+        await this.retire(requestId, "unknown");
+        if (offerRetry) this.addUncertain({ requestId, text });
+        this.fail(error);
+        return "uncertain";
+      }
+      await this.retire(requestId, "rejected");
+      this.inflight?.clearImageDraft(this.sessionId, requestId);
+      this.fail(error);
+      return "rejected";
+    }
+    await this.retire(requestId, "accepted", result.turn_id);
+    this.inflight?.clearImageDraft(this.sessionId, requestId);
+    this.dropUncertain(requestId);
+    this.set({ error: null, errorName: null });
+    if (result.status === "queued") {
+      this.mine.set(result.turn_id, { requestId, text });
+      const listed = this.state.queue.find((entry) => entry.admissionId === result.turn_id);
+      if (listed === undefined) {
+        this.set({
+          queue: sortQueue([
+            ...this.state.queue,
+            { admissionId: result.turn_id, position: null, text, mine: true },
+          ]),
+        });
+      } else if (!listed.mine) {
+        this.set({
+          queue: this.state.queue.map((entry) =>
+            entry.admissionId === result.turn_id ? { ...entry, text, mine: true } : entry,
+          ),
+        });
+      }
+      return "queued";
+    }
+    if (result.status === "steered" || result.status === "redirected") return "steered";
+    this.set({
+      running: true,
+      turnId: result.turn_id,
+      generation: typeof result.generation === "number" ? result.generation : this.state.generation,
+    });
+    return "started";
+  }
+
+  private async retire(
+    requestId: string,
+    outcome: "accepted" | "rejected" | "unknown",
+    admissionId?: string,
+  ): Promise<void> {
+    if (this.journal === null) return;
+    try {
+      await this.journal.retire({
+        requestId,
+        receipt: admissionId === undefined ? { outcome } : { outcome, admissionId },
+      });
+    } catch {
+      // an entry that could not be retired is offered again later; the request id dedupes it
+    }
+  }
+
+  private addUncertain(item: UncertainSubmission): void {
+    const rest = this.state.uncertain.filter((entry) => entry.requestId !== item.requestId);
+    this.set({ uncertain: [...rest, item] });
+  }
+
+  private dropUncertain(requestId: string): void {
+    if (!this.state.uncertain.some((entry) => entry.requestId === requestId)) return;
+    this.set({ uncertain: this.state.uncertain.filter((entry) => entry.requestId !== requestId) });
+  }
+
+  /** Offer this session's journaled inputs left from an earlier run (or another window). */
+  async recoverPrepared(): Promise<readonly UncertainSubmission[]> {
+    if (this.journal === null) return [];
+    let entries: Awaited<ReturnType<PreparedJournalPort["list"]>>["entries"];
+    try {
+      entries = (await this.journal.list()).entries;
+    } catch {
+      return [];
+    }
+    for (const entry of entries) {
+      if (entry.sessionId !== this.sessionId) continue;
+      this.addUncertain({ requestId: entry.requestId, text: textOf(entry.payload) });
+    }
+    return this.state.uncertain;
+  }
+
+  /** Send a journaled input again under its own request id (never runs twice). */
+  retryUncertain(requestId: string): Promise<SendOutcome> {
+    const item = this.state.uncertain.find((entry) => entry.requestId === requestId);
+    if (item === undefined) return Promise.resolve("empty");
+    return this.submit(item.text, this.state.running ? "queue" : null, {}, item.requestId);
+  }
+
+  /** The person gave up on a journaled input. */
+  async dismissUncertain(requestId: string): Promise<void> {
+    await this.retire(requestId, "rejected");
+    this.dropUncertain(requestId);
+  }
+
+  // -- while a turn runs ---------------------------------------------------------------------------
+
+  /** Guidance for the running turn; sent as a new prompt when no turn takes it. */
+  async steer(text: string): Promise<SendOutcome> {
+    if (text.trim() === "") return "empty";
+    if (!this.state.running) return this.send(text);
+    try {
+      const answer = await this.request("session.steer", {
+        session_id: this.sessionId,
+        text,
+        generation: this.state.generation,
+      });
+      if (answer.queued) return "steered";
+    } catch (error) {
+      if (errorName(error) !== "SESSION_NOT_FOUND" && errorName(error) !== "STALE_GENERATION") {
+        this.fail(error);
+        return "rejected";
+      }
+    }
+    return this.submit(text, null, {});
+  }
+
+  /** Stop the running turn (Stop button, Esc); with inputs waiting, also pause the queue. */
+  async stop(): Promise<boolean> {
+    if (this.state.generation === null && this.pendingSubmit !== null) {
+      // The submit's answer names the generation: wait for it, never interrupt blindly.
+      await this.pendingSubmit.catch(() => {});
+    }
+    const generation = this.state.generation;
+    let interrupted = false;
+    if (generation !== null) {
+      try {
+        const answer = await this.request("session.interrupt", {
+          session_id: this.sessionId,
+          generation,
+        });
+        interrupted = answer.interrupted;
+      } catch (error) {
+        if (errorName(error) !== "STALE_GENERATION") this.fail(error);
+      }
+    }
+    await this.pause();
+    return interrupted;
+  }
+
+  /** Withdraw this window's queued inputs from the daemon and hold them until Resume. */
+  private async pause(): Promise<void> {
+    const own = this.state.queue.filter((entry) => entry.mine && entry.text !== null);
+    if (own.length === 0) return;
+    const held: HeldItem[] = [...this.state.held];
+    for (const entry of own) {
+      try {
+        await this.request("admission.cancel", {
+          session_id: this.sessionId,
+          admission_id: entry.admissionId,
+        });
+      } catch {
+        // it started meanwhile (or is gone): leave it where it is
+        continue;
+      }
+      this.mine.delete(entry.admissionId);
+      held.push({ requestId: this.newId(), text: entry.text ?? "", failures: 0, failed: false });
+      this.set({
+        queue: this.state.queue.filter((other) => other.admissionId !== entry.admissionId),
+        held,
+        draining: false,
+      });
+    }
+  }
+
+  /** Resume a paused queue: send the held inputs back in order. */
+  async resume(): Promise<void> {
+    if (this.state.lost !== null || this.state.draining) return;
+    this.set({
+      draining: true,
+      held: this.state.held.map((item) =>
+        item.failed ? { ...item, failed: false, failures: 0 } : item,
+      ),
+    });
+    try {
+      await this.drain();
+    } finally {
+      this.set({ draining: false });
+    }
+  }
+
+  private async drain(): Promise<void> {
+    while (this.state.held.length > 0 && this.state.lost === null) {
+      const [head] = this.state.held;
+      if (head === undefined || head.failed) return;
+      const outcome = await this.submitOnce(head.text, "queue", {}, head.requestId, false);
+      if (outcome === "queued" || outcome === "started" || outcome === "steered") {
+        this.dropUncertain(head.requestId);
+        this.set({ held: this.state.held.slice(1) });
+        continue;
+      }
+      const failures = head.failures + 1;
+      const failed = failures >= MAX_AUTO_DRAIN_ATTEMPTS;
+      this.set({ held: [{ ...head, failures, failed }, ...this.state.held.slice(1)] });
+      if (failed) return;
+      await this.sleep(DRAIN_RETRY_MS * failures);
+    }
+  }
+
+  /** Drop a held item. */
+  removeHeld(requestId: string): void {
+    this.set({ held: this.state.held.filter((item) => item.requestId !== requestId) });
+  }
+
+  /** Withdraw one of the daemon's queued inputs. */
+  async cancelQueued(admissionId: string): Promise<boolean> {
+    try {
+      await this.request("admission.cancel", {
+        session_id: this.sessionId,
+        admission_id: admissionId,
+      });
+    } catch (error) {
+      this.fail(error);
+      return false;
+    }
+    this.mine.delete(admissionId);
+    this.set({ queue: this.state.queue.filter((entry) => entry.admissionId !== admissionId) });
+    return true;
+  }
+
+  /** Resolve a lost turn: its transcript closes it, the queue behind it goes on. */
+  async discard(): Promise<boolean> {
+    const lost = this.state.lost;
+    if (lost === null) return false;
+    let generation = lost.generation;
+    if (generation === null) {
+      try {
+        const receipt = await this.request("admission.receipt", {
+          session_id: this.sessionId,
+          admission_id: lost.admissionId,
+        });
+        generation = receipt.generation ?? null;
+      } catch (error) {
+        this.fail(error);
+        return false;
+      }
+    }
+    if (generation === null) {
+      this.set({ error: "the lost turn has no generation" });
+      return false;
+    }
+    try {
+      await this.request("admission.discard", {
+        session_id: this.sessionId,
+        admission_id: lost.admissionId,
+        generation,
+      });
+    } catch (error) {
+      this.fail(error);
+      return false;
+    }
+    this.set({ lost: null, error: null, errorName: null });
+    return true;
+  }
+}
+
+function sortQueue(entries: QueueEntry[]): QueueEntry[] {
+  return [...entries].sort(
+    (a, b) => (a.position ?? Number.MAX_SAFE_INTEGER) - (b.position ?? Number.MAX_SAFE_INTEGER),
+  );
+}
