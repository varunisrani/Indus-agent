+
+  it("a slow answer for an older word never replaces the newer list", async () => {
+    const releases: Array<() => void> = [];
+    const connection = chatDaemon().on(
+      "complete.path",
+      (params) =>
+        new Promise((resolve) => {
+          releases.push(() =>
+            resolve({ items: [{ text: `${params.word}-match`, display: `${params.word}-match` }] }),
+          );
+        }),
