@@ -0,0 +1,120 @@
+// WAVE34 STAND-IN (owner: slice R) — the lead drops this file at merge
+// Only the names slice C codes against; slice R's real server-request store (P20-17) provides them.
+
+import type { ServerRequestHandlers } from "@indus/client";
+import type {
+  ServerRequest,
+  ServerRequestAnswer,
+  ServerRequestKind,
+  ServerRequestTypes,
+} from "@indus/protocol";
+import {
+  createContext,
+  createElement,
+  type ReactNode,
+  useCallback,
+  useContext,
+  useSyncExternalStore,
+} from "react";
+
+/** A server request still waiting for this window's answer. */
+export interface OpenServerRequest {
+  readonly id: string;
+  readonly sessionId: string;
+  readonly kind: ServerRequestKind;
+  readonly request: ServerRequest;
+  readonly replayed: boolean;
+  readonly generation: number | undefined;
+  /** First answer wins: false when it was already answered or withdrawn. */
+  answer(answer: ServerRequestAnswer): boolean;
+}
+
+const KINDS: readonly ServerRequestKind[] = ["approval", "clarify", "sudo", "secret"];
+
+export class ServerRequestStore {
+  private readonly open = new Map<string, OpenServerRequest>();
+  private readonly listeners = new Set<() => void>();
+  private version = 0;
+  private readonly lists = new Map<string, { version: number; items: OpenServerRequest[] }>();
+
+  /** The handler table for `RpcChannel.setHandlers({ serverRequests })`. */
+  handlers(): ServerRequestHandlers {
+    const table: Record<string, unknown> = {};
+    for (const kind of KINDS) {
+      table[kind] = (
+        request: ServerRequestTypes[typeof kind]["request"],
+        meta: { replayed: boolean; signal: AbortSignal; generation?: number },
+      ) =>
+        new Promise<ServerRequestAnswer>((resolve) => {
+          let done = false;
+          const entry: OpenServerRequest = {
+            id: request.request_id,
+            sessionId: request.session_id,
+            kind,
+            request,
+            replayed: meta.replayed,
+            generation: meta.generation,
+            answer: (answer) => {
+              if (done) return false;
+              done = true;
+              this.remove(entry.id);
+              resolve(answer);
+              return true;
+            },
+          };
+          meta.signal.addEventListener("abort", () => {
+            done = true;
+            this.remove(entry.id);
+          });
+          if (meta.signal.aborted) return;
+          this.open.set(entry.id, entry);
+          this.changed();
+        });
+    }
+    return table as ServerRequestHandlers;
+  }
+
+  list(sessionId: string): readonly OpenServerRequest[] {
+    const cached = this.lists.get(sessionId);
+    if (cached !== undefined && cached.version === this.version) return cached.items;
+    const items = [...this.open.values()].filter((entry) => entry.sessionId === sessionId);
+    this.lists.set(sessionId, { version: this.version, items });
+    return items;
+  }
+
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  };
+
+  private remove(id: string): void {
+    if (this.open.delete(id)) this.changed();
+  }
+
+  private changed(): void {
+    this.version += 1;
+    for (const listener of this.listeners) listener();
+  }
+}
+
+const StoreContext = createContext<ServerRequestStore | null>(null);
+
+export function ServerRequestStoreProvider(props: {
+  value: ServerRequestStore;
+  children?: ReactNode;
+}) {
+  return createElement(StoreContext.Provider, { value: props.value }, props.children);
+}
+
+const NONE: readonly OpenServerRequest[] = [];
+const noSubscribe = () => () => {};
+
+/** Open requests of one session, re-rendering on change. */
+export function useOpenServerRequests(sessionId: string | null): readonly OpenServerRequest[] {
+  const store = useContext(StoreContext);
+  const read = useCallback(
+    () => (store === null || sessionId === null ? NONE : store.list(sessionId)),
+    [store, sessionId],
+  );
+  return useSyncExternalStore(store?.subscribe ?? noSubscribe, read, read);
+}
