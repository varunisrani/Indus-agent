+function chatDaemon(mode: "local" | "remote" = "local") {
+  return new FakeConnection({ mode })
+    .on("prompt.submit", () => ({ turn_id: "adm-1", generation: 4, status: "streaming" }))
+    .on("image.attach", (params) => ({ name: "x", path: params.path, attached: 1 }))
