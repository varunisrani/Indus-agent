diff --git a/apps/desktop/electron/journal/preparedSubmissions.test.ts b/apps/desktop/electron/journal/preparedSubmissions.test.ts
new file mode 100644
index 0000000..a98a5e7
--- /dev/null
+++ b/apps/desktop/electron/journal/preparedSubmissions.test.ts
@@ -0,0 +1,120 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { IpcError } from "../ipc/envelope.ts";
+import { MAX_ENTRIES, MAX_PAYLOAD_BYTES, PreparedSubmissions } from "./preparedSubmissions.ts";
+
+const dirs: string[] = [];
+
+function tempDir(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "indus-journal-"));
+  dirs.push(dir);
+  return path.join(dir, "prepared-submissions");
+}
+
+afterEach(() => {
+  for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+const posix = process.platform !== "win32";
+
+describe("prepared-submission journal", () => {
+  it("writes private files (0600 in a 0700 directory)", () => {
+    const dir = tempDir();
+    const journal = new PreparedSubmissions({ dir });
+    journal.prepare("req-1", "s1", { text: "hello" });
+    const [name] = fs.readdirSync(dir);
+    expect(name).toMatch(/^[0-9a-f]{64}\.json$/);
+    if (posix) {
+      expect(fs.statSync(dir).mode & 0o777).toBe(0o700);
+      expect(fs.statSync(path.join(dir, name as string)).mode & 0o777).toBe(0o600);
+    }
+    // no temp file left behind
+    expect(fs.readdirSync(dir)).toHaveLength(1);
+  });
+
+  it("survives a restart between the write and the receipt", () => {
+    const dir = tempDir();
+    new PreparedSubmissions({ dir, now: () => 10 }).prepare("req-1", "s1", { text: "kept" });
+    // a new process: nothing in memory, only the files
+    const reopened = new PreparedSubmissions({ dir });
+    expect(reopened.list()).toEqual([
+      {
+        requestId: "req-1",
+        sessionId: "s1",
+        createdAt: 10,
+        updatedAt: 10,
+        state: "prepared",
+        payload: { text: "kept" },
+      },
+    ]);
+  });
+
+  it("an accepted receipt retires the entry", () => {
+    const journal = new PreparedSubmissions({ dir: tempDir() });
+    journal.prepare("req-1", "s1", { text: "a" });
+    expect(journal.retire("req-1", "accepted", "adm-1")).toBe(true);
+    expect(journal.list()).toEqual([]);
+    expect(journal.retire("req-1", "accepted")).toBe(false);
+  });
+
+  it("an unknown receipt keeps the entry, marked uncertain", () => {
+    let now = 1;
+    const journal = new PreparedSubmissions({ dir: tempDir(), now: () => now });
+    journal.prepare("req-1", "s1", { text: "a" });
+    now = 5;
+    expect(journal.retire("req-1", "unknown")).toBe(false);
+    const [entry] = journal.list();
+    expect(entry).toMatchObject({
+      requestId: "req-1",
+      state: "uncertain",
+      createdAt: 1,
+      updatedAt: 5,
+    });
+    // a later retry that is accepted retires it
+    journal.prepare("req-1", "s1", { text: "a" });
+    expect(journal.retire("req-1", "accepted")).toBe(true);
+    expect(journal.list()).toEqual([]);
+  });
+
+  it("a rejected receipt removes the entry (its text goes back to the composer)", () => {
+    const journal = new PreparedSubmissions({ dir: tempDir() });
+    journal.prepare("req-1", "s1", { text: "a" });
+    expect(journal.retire("req-1", "rejected")).toBe(true);
+    expect(journal.list()).toEqual([]);
+  });
+
+  it("a corrupt entry is moved aside and does not block later sends", () => {
+    const dir = tempDir();
+    const lines: string[] = [];
+    const journal = new PreparedSubmissions({ dir, now: () => 42, log: (l) => lines.push(l) });
+    journal.prepare("req-1", "s1", { text: "a" });
+    const [name] = fs.readdirSync(dir);
+    fs.writeFileSync(path.join(dir, name as string), "{ torn");
+    expect(journal.list()).toEqual([]);
+    expect(fs.readdirSync(dir)).toEqual([`${name}.corrupt-42`]);
+    expect(lines.join("\n")).toContain("moved unreadable entry aside");
+    journal.prepare("req-2", "s1", { text: "b" });
+    expect(journal.list().map((e) => e.requestId)).toEqual(["req-2"]);
+  });
+
+  it("refuses an oversized payload and a full journal", () => {
+    const journal = new PreparedSubmissions({ dir: tempDir() });
+    const big = "x".repeat(MAX_PAYLOAD_BYTES + 1);
+    expect(() => journal.prepare("req-big", "s1", big)).toThrow(IpcError);
+    for (let i = 0; i < MAX_ENTRIES; i += 1) journal.prepare(`req-${i}`, "s1", i);
+    expect(() => journal.prepare("one-more", "s1", 0)).toThrow(/still waiting/);
+    // re-preparing an existing entry is still allowed
+    expect(() => journal.prepare("req-0", "s1", 0)).not.toThrow();
+  });
+
+  it("lists entries oldest first", () => {
+    let now = 3;
+    const journal = new PreparedSubmissions({ dir: tempDir(), now: () => now });
+    journal.prepare("late", "s1", 1);
+    now = 1;
+    journal.prepare("early", "s1", 2);
+    expect(journal.list().map((e) => e.requestId)).toEqual(["early", "late"]);
+  });
+});
diff --git a/apps/desktop/electron/journal/preparedSubmissions.ts b/apps/desktop/electron/journal/preparedSubmissions.ts
new file mode 100644
index 0000000..d70e919
--- /dev/null
+++ b/apps/desktop/electron/journal/preparedSubmissions.ts
@@ -0,0 +1,188 @@
+// The prepared-submission journal (P20-20): before the renderer hands an input to the daemon, main
+// records it in a private file, so a crash between "sent" and "receipt" cannot lose it.
+//
+// One file per input under `<userData>/prepared-submissions/` (0700), named by the SHA-256 of the
+// client's request id and written 0600 through a temp file, fsync and rename. The request id is the
+// `request_id` the renderer puts on `prompt.submit`; the daemon answers a repeated id with the
+// first admission, so retrying an entry can never run the input twice. An entry is retired by an
+// accepted receipt (or a definite rejection, whose text the renderer puts back in the composer);
+// an unknown outcome keeps it, marked `uncertain`, for an explicit Retry or Dismiss. Nothing here
+// resends anything.
+
+import { createHash } from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { ensurePrivateDir, readRegularFile, writePrivateFile } from "../fsSecure.ts";
+import { IpcError } from "../ipc/envelope.ts";
+import type { IpcRegistry } from "../ipc/registry.ts";
+
+/** Largest serialized payload one entry may hold. */
+export const MAX_PAYLOAD_BYTES = 256 * 1024;
+/** Live entries at most; a renderer that leaks entries hits this instead of filling the disk. */
+export const MAX_ENTRIES = 200;
+
+export type EntryState = "prepared" | "uncertain";
+export type ReceiptOutcome = "accepted" | "rejected" | "unknown";
+
+export interface JournalEntry {
+  requestId: string;
+  sessionId: string;
+  createdAt: number;
+  updatedAt: number;
+  state: EntryState;
+  /** The daemon's admission id once an answer named one. */
+  admissionId?: string;
+  payload: unknown;
+}
+
+export interface JournalOptions {
+  dir: string;
+  now?: () => number;
+  platform?: string;
+  log?: (line: string) => void;
+}
+
+const FILE_SUFFIX = ".json";
+
+function isEntry(value: unknown): value is JournalEntry {
+  if (typeof value !== "object" || value === null) return false;
+  const entry = value as Record<string, unknown>;
+  return (
+    typeof entry.requestId === "string" &&
+    typeof entry.sessionId === "string" &&
+    typeof entry.createdAt === "number" &&
+    typeof entry.updatedAt === "number" &&
+    (entry.state === "prepared" || entry.state === "uncertain") &&
+    "payload" in entry
+  );
+}
+
+export class PreparedSubmissions {
+  private readonly dir: string;
+  private readonly now: () => number;
+  private readonly platform: string;
+  private readonly log: (line: string) => void;
+
+  constructor(options: JournalOptions) {
+    this.dir = options.dir;
+    this.now = options.now ?? Date.now;
+    this.platform = options.platform ?? process.platform;
+    this.log = options.log ?? (() => {});
+  }
+
+  private fileFor(requestId: string): string {
+    const digest = createHash("sha256").update(requestId, "utf8").digest("hex");
+    return path.join(this.dir, `${digest}${FILE_SUFFIX}`);
+  }
+
+  private files(): string[] {
+    let names: string[];
+    try {
+      names = fs.readdirSync(this.dir);
+    } catch {
+      return [];
+    }
+    return names
+      .filter((name) => name.endsWith(FILE_SUFFIX) && !name.startsWith("."))
+      .map((name) => path.join(this.dir, name));
+  }
+
+  private read(file: string): JournalEntry | null {
+    let text: string | null;
+    try {
+      text = readRegularFile(file);
+    } catch {
+      return null;
+    }
+    if (text === null) return null;
+    try {
+      const parsed: unknown = JSON.parse(text);
+      if (isEntry(parsed)) return parsed;
+    } catch {
+      // quarantined below
+    }
+    // A torn or garbled entry cannot be trusted; keep its bytes for diagnosis, out of the way.
+    const aside = `${file}.corrupt-${this.now()}`;
+    try {
+      fs.renameSync(file, aside);
+      this.log(`prepared-submissions: moved unreadable entry aside (${path.basename(aside)})`);
+    } catch {
+      // another window moved it first
+    }
+    return null;
+  }
+
+  private write(entry: JournalEntry): void {
+    ensurePrivateDir(this.dir, this.platform);
+    writePrivateFile(this.fileFor(entry.requestId), JSON.stringify(entry), this.platform);
+  }
+
+  /** Every live entry, oldest first. */
+  list(): JournalEntry[] {
+    const entries: JournalEntry[] = [];
+    for (const file of this.files()) {
+      const entry = this.read(file);
+      if (entry !== null) entries.push(entry);
+    }
+    return entries.sort((a, b) => a.createdAt - b.createdAt);
+  }
+
+  /** Record an input before it is sent; preparing the same request id again refreshes it. */
+  prepare(requestId: string, sessionId: string, payload: unknown): JournalEntry {
+    const size = Buffer.byteLength(JSON.stringify(payload ?? null), "utf8");
+    if (size > MAX_PAYLOAD_BYTES) {
+      throw new IpcError(
+        "too-large",
+        `the input is ${size} bytes; the journal takes at most ${MAX_PAYLOAD_BYTES}`,
+      );
+    }
+    const existing = this.read(this.fileFor(requestId));
+    if (existing === null && this.files().length >= MAX_ENTRIES) {
+      throw new IpcError("journal-full", `${MAX_ENTRIES} inputs are still waiting for a receipt`);
+    }
+    const at = this.now();
+    const entry: JournalEntry = {
+      requestId,
+      sessionId,
+      createdAt: existing?.createdAt ?? at,
+      updatedAt: at,
+      state: "prepared",
+      payload,
+    };
+    this.write(entry);
+    return entry;
+  }
+
+  /**
+   * Settle an entry with the receipt the daemon gave (or did not give). Accepted and rejected
+   * remove it; unknown keeps it as `uncertain`. False when no entry has this request id.
+   */
+  retire(requestId: string, outcome: ReceiptOutcome, admissionId?: string): boolean {
+    const file = this.fileFor(requestId);
+    const entry = this.read(file);
+    if (entry === null) return false;
+    if (outcome === "unknown") {
+      this.write({
+        ...entry,
+        state: "uncertain",
+        updatedAt: this.now(),
+        ...(admissionId === undefined ? {} : { admissionId }),
+      });
+      return false;
+    }
+    fs.rmSync(file, { force: true });
+    return true;
+  }
+}
+
+/** The `indus:journal:*` handlers (P20-20). */
+export function installJournalIpc(registry: IpcRegistry, journal: PreparedSubmissions): void {
+  registry.handle("indus:journal:list", () => ({ entries: journal.list() }));
+  registry.handle("indus:journal:prepare", ({ requestId, sessionId, payload }) => {
+    journal.prepare(requestId, sessionId, payload);
+    return { ok: true as const };
+  });
+  registry.handle("indus:journal:retire", ({ requestId, receipt }) => ({
+    retired: journal.retire(requestId, receipt.outcome, receipt.admissionId),
+  }));
+}
