+
+.pane-bodies {
+  position: relative;
+  display: flex;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+  transition: filter var(--indus-duration-quick) var(--indus-easing-standard);
+}
+
+/* Unfocused zones lose 20 % saturation (only when there is more than one zone to tell apart). */
+.pane-split .pane-zone[data-focused="false"] .pane-bodies {
+  filter: saturate(0.8);
+}
+
+.pane-body {
+  display: flex;
+  flex-direction: column;
+  flex: 1;
+  min-width: 0;
+  min-height: 0;
+}
+
+.pane-drop {
+  position: absolute;
+  pointer-events: none;
+  background: var(--indus-color-accent);
+  opacity: 0.18;
+  inset: 28px 0 0 0;
+}
+
+.pane-drop[data-edge="left"] {
+  right: 50%;
+}
+
+.pane-drop[data-edge="right"] {
+  left: 50%;
+}
+
+.pane-drop[data-edge="top"] {
+  bottom: 50%;
+}
+
+.pane-drop[data-edge="bottom"] {
+  top: calc(50% + 14px);
+}
+
+/* Simple mode: the technical tool view and inline diffs are hidden, thinking stays collapsed. */
+[data-interface-mode="simple"] .tool-detail,
+[data-interface-mode="simple"] .inline-diff {
+  display: none;
+}
+
+[data-interface-mode="simple"] details.reasoning[open] > :not(summary) {
+  display: none;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .pane-bodies {
+    transition: none;
+  }
+}
