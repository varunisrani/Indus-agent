+  });
+
+  it("a running turn shows the working dot", async () => {
+    let emit: (event: { type: string; session_id: string }) => void = () => undefined;
+    const events: EventSource = {
+      onEvent: (listener) => {
+        emit = listener;
+        return () => undefined;
+      },
+    };
+    mount({ events });
