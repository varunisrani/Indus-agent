+    last_active: NOW - 30,
+  },
+];
+
+function fakeApi(sessions: SessionInfo[] = SESSIONS) {
+  return vi.fn<ApiRequest>(async (request) => {
+    if (request.method === "PATCH") return { kind: "response", status: 200, body: {} };
+    if (request.path.startsWith("/api/sessions/search")) {
