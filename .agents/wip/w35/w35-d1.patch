+  font-size: 12px;
+  padding: 0 var(--indus-space-2);
+  border: 1px solid var(--indus-color-border);
+  border-radius: var(--indus-radius-md);
+  background: var(--indus-color-bg-raised);
+  color: var(--indus-color-fg);
