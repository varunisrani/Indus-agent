+
+.pane-slot {
+  display: inline-grid;
+  place-items: center;
+  min-width: 16px;
+  height: 16px;
+  border-radius: var(--indus-radius-sm);
+  background: var(--indus-color-accent);
+  color: var(--indus-color-accent-fg);
+  font-size: 10px;
+}
+
+.pane-zone-actions {
+  display: flex;
+  gap: 2px;
