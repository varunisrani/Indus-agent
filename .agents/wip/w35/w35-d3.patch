+/* Settings overlay (P20-32). Tokens only (`--indus-*`); no raw colours. */
+
+:root {
+  /* The chat text size the Appearance page sets (110 % by default). */
+  --indus-chat-text-scale: 1.1;
+}
+
+.transcript {
+  font-size: calc(1em * var(--indus-chat-text-scale));
+}
+
+.settings-overlay {
+  position: fixed;
+  z-index: var(--z-overlay);
+  inset: 6% 6%;
+  display: grid;
+  grid-template-columns: minmax(180px, 240px) 1fr;
+  overflow: hidden;
+  border: 1px solid var(--indus-color-border);
+  border-radius: var(--indus-radius-lg);
+  background: var(--indus-color-bg-raised);
+  box-shadow: var(--indus-shadow-high);
+}
+
+.settings-nav {
+  display: flex;
+  flex-direction: column;
+  gap: var(--indus-space-2);
+  padding: var(--indus-space-3);
+  overflow-y: auto;
+  border-right: 1px solid var(--indus-color-border);
+}
+
+.settings-search {
+  display: flex;
+  align-items: center;
+  gap: var(--indus-space-1);
+  padding: var(--indus-space-1) var(--indus-space-2);
+  border: 1px solid var(--indus-color-border);
+  border-radius: var(--indus-radius-md);
+  color: var(--indus-color-fg-muted);
+}
+
+.settings-search input {
+  flex: 1;
+  min-width: 0;
+  border: 0;
+  background: transparent;
+  color: var(--indus-color-fg);
+  font: inherit;
+}
+
+.settings-views,
+.settings-pages,
+.settings-hits {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+}
+
+.settings-pages {
+  padding-left: var(--indus-space-3);
+}
+
+.settings-view,
+.settings-page-link,
+.settings-hit {
+  display: block;
+  width: 100%;
+  padding: var(--indus-space-1) var(--indus-space-2);
+  border: 0;
+  border-radius: var(--indus-radius-md);
+  background: transparent;
+  color: var(--indus-color-fg);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+}
+
+.settings-page-link {
+  color: var(--indus-color-fg-muted);
+}
+
+.settings-view[aria-current="page"],
+.settings-page-link[aria-current="page"] {
+  background: var(--indus-color-code-bg);
+  color: var(--indus-color-fg);
+}
+
+.settings-hit-label {
+  display: block;
+}
+
+.settings-hit-context {
+  display: block;
+  font-size: 12px;
+  color: var(--indus-color-fg-muted);
+}
+
+.settings-main {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  overflow: hidden;
+}
+
+.settings-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: var(--indus-space-3) var(--indus-space-4);
+  border-bottom: 1px solid var(--indus-color-border);
+}
+
+.settings-breadcrumb {
+  display: flex;
+  align-items: center;
+  gap: var(--indus-space-1);
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-size: 14px;
+  font-weight: var(--indus-font-weight-semibold);
+}
