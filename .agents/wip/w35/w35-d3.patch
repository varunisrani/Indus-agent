+
+  function remote(fetchImpl: typeof fetch) {
+    return createMediaHandler({
+      roots: new MediaRoots([]),
+      target: () => ({ mode: "remote", origin: "https://box.example/indus", token, profile: null }),
+      fetch: fetchImpl,
