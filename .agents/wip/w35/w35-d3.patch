+    expect((await local()(get(path.join(dir, ".ssh", "photo.png")))).status).toBe(403);
+    expect((await local()(get(path.join(dir, "notes.txt")))).status).toBe(415);
+    expect((await local()(get(path.join(dir, "draw.svg")))).status).toBe(415);
