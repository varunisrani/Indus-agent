+// A config-backed settings page (P20-32): the fields a page owns, read from the backend's schema
+// and form tree, each with the control its type asks for. A change is written at once as a
+// one-field patch (`PUT /api/config`, additive), for the profile the "Applies to" chips name.
+
+import { Eye, EyeOff } from "lucide-react";
+import { type KeyboardEvent, type ReactNode, useEffect, useId, useRef, useState } from "react";
+import { useT } from "../i18n/index.tsx";
+import { fieldsOnPage, type PageDef } from "./pages.ts";
+import { fieldLabel, type SchemaField, type SchemaFields } from "./search.ts";
+import { patchFor, type RestLike, rest, SECRET_PLACEHOLDER, valueAt } from "./settingsApi.ts";
+
+type RowState =
+  | { kind: "idle" }
+  | { kind: "saving" }
+  | { kind: "saved" }
+  | { kind: "error"; message: string };
+
+/** The value to send for `text` typed into a field of `type`, or an error key. */
+export function parseInput(
+  field: SchemaField,
+  text: string,
+  current: unknown,
+): { ok: true; value: unknown } | { ok: false } {
+  const trimmed = text.trim();
+  switch (field.type) {
+    case "integer":
+      if (trimmed === "") return { ok: true, value: null };
+      return /^-?\d+$/.test(trimmed) ? { ok: true, value: Number(trimmed) } : { ok: false };
+    case "number": {
+      if (trimmed === "") return { ok: true, value: null };
+      const value = Number(trimmed);
+      return Number.isFinite(value) ? { ok: true, value } : { ok: false };
+    }
+    case "list": {
+      const structured = Array.isArray(current) && current.some((v) => typeof v !== "string");
+      if (structured || trimmed.startsWith("[")) {
+        try {
+          const value: unknown = JSON.parse(trimmed === "" ? "[]" : trimmed);
+          return Array.isArray(value) ? { ok: true, value } : { ok: false };
+        } catch {
+          return { ok: false };
+        }
+      }
+      return {
+        ok: true,
+        value: text
+          .split("\n")
+          .map((line) => line.trim())
+          .filter((line) => line !== ""),
+      };
+    }
+    default:
+      return { ok: true, value: text };
+  }
+}
+
+function listText(value: unknown): string {
+  if (!Array.isArray(value)) return "";
+  if (value.every((v) => typeof v === "string")) return value.join("\n");
+  return JSON.stringify(value, null, 2);
+}
+
+function inputText(value: unknown): string {
+  if (value === null || value === undefined) return "";
+  return typeof value === "string" ? value : String(value);
+}
+
+export interface FieldRowProps {
+  fieldKey: string;
+  field: SchemaField;
+  value: unknown;
+  disabled: boolean;
+  highlighted: boolean;
+  onSave: (key: string, value: unknown) => Promise<string | null>;
+}
+
+/** One setting: label, description and its control; saves itself. */
+export function FieldRow(props: FieldRowProps) {
+  const t = useT();
+  const { fieldKey, field, value } = props;
+  const id = useId();
+  const secret = value === SECRET_PLACEHOLDER;
+  const initial = secret ? "" : field.type === "list" ? listText(value) : inputText(value);
+  const [draft, setDraft] = useState(initial);
+  const [state, setState] = useState<RowState>({ kind: "idle" });
+  const [revealed, setRevealed] = useState(false);
+  const [invalid, setInvalid] = useState(false);
+  const ref = useRef<HTMLDivElement | null>(null);
+
+  useEffect(() => setDraft(initial), [initial]);
+  useEffect(() => {
+    if (props.highlighted) ref.current?.scrollIntoView?.({ block: "center" });
+  }, [props.highlighted]);
+
+  const save = async (next: unknown) => {
+    setState({ kind: "saving" });
+    const failure = await props.onSave(fieldKey, next);
+    setState(failure === null ? { kind: "saved" } : { kind: "error", message: failure });
+  };
+
+  const commitText = () => {
+    if (secret && draft.trim() === "") return; // an untouched secret is never re-sent
+    const before = field.type === "list" ? listText(value) : inputText(value);
+    if (!secret && draft === before) return;
+    const parsed = parseInput(field, draft, value);
+    if (!parsed.ok) {
+      setInvalid(true);
+      return;
+    }
+    setInvalid(false);
+    void save(parsed.value);
+  };
+
+  const onKey = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === "Enter") commitText();
+  };
+
+  let control: ReactNode;
+  if (field.type === "boolean") {
+    control = (
+      <input
+        id={id}
+        type="checkbox"
+        role="switch"
+        className="settings-switch"
+        checked={value === true}
+        aria-checked={value === true}
+        disabled={props.disabled}
+        onChange={(event) => void save(event.currentTarget.checked)}
+      />
+    );
+  } else if (field.type === "enum") {
+    const options = field.options ?? [];
+    const current = inputText(value);
+    control = (
+      <select
+        id={id}
+        className="settings-input"
+        value={current}
+        disabled={props.disabled}
+        onChange={(event) => void save(event.currentTarget.value)}
+      >
+        {!options.includes(current) && <option value={current}>{current}</option>}
+        {options.map((option) => (
+          <option key={option} value={option}>
+            {option === "" ? t("settings.field.none") : option}
+          </option>
+        ))}
+      </select>
+    );
+  } else if (field.type === "list") {
+    control = (
+      <textarea
+        id={id}
+        className="settings-input settings-textarea"
+        value={draft}
+        rows={Math.min(8, Math.max(2, draft.split("\n").length))}
+        disabled={props.disabled}
+        aria-invalid={invalid}
+        placeholder={t("settings.field.listHint")}
+        onChange={(event) => setDraft(event.currentTarget.value)}
+        onBlur={commitText}
+      />
+    );
+  } else {
+    const numeric = field.type === "integer" || field.type === "number";
+    control = (
+      <span className="settings-inline">
+        <input
+          id={id}
+          className="settings-input"
+          type={secret && !revealed ? "password" : "text"}
+          inputMode={numeric ? "decimal" : undefined}
+          value={draft}
+          disabled={props.disabled}
+          aria-invalid={invalid}
+          placeholder={secret ? t("settings.field.secretStored") : ""}
+          autoComplete="off"
+          spellCheck={false}
+          onChange={(event) => setDraft(event.currentTarget.value)}
+          onBlur={commitText}
+          onKeyDown={onKey}
+        />
+        {secret && (
+          <button
+            type="button"
+            className="icon-button"
+            aria-label={t(revealed ? "settings.field.hide" : "settings.field.reveal")}
+            onClick={() => setRevealed((now) => !now)}
+          >
+            {revealed ? (
+              <EyeOff aria-hidden="true" size={14} />
+            ) : (
+              <Eye aria-hidden="true" size={14} />
+            )}
+          </button>
+        )}
+      </span>
+    );
+  }
+
+  return (
+    <div
+      ref={ref}
+      className="settings-row"
+      data-field={fieldKey}
+      data-highlighted={props.highlighted ? "true" : undefined}
+    >
+      <div className="settings-row-text">
+        <label htmlFor={id} className="settings-row-label">
+          {fieldLabel(fieldKey)}
+        </label>
+        {field.description !== "" && <p className="settings-row-desc">{field.description}</p>}
+        <code className="settings-row-key">{fieldKey}</code>
+      </div>
+      <div className="settings-row-control">
+        {control}
+        {invalid && <span className="settings-row-error">{t("settings.field.invalid")}</span>}
+        {state.kind === "saving" && (
+          <span className="settings-row-note">{t("settings.saving")}</span>
+        )}
+        {state.kind === "saved" && <span className="settings-row-note">{t("settings.saved")}</span>}
+        {state.kind === "error" && <span className="settings-row-error">{state.message}</span>}
+      </div>
+    </div>
+  );
+}
+
+export interface SchemaPageProps {
+  page: PageDef;
+  schema: SchemaFields;
+  /** `GET /api/config` (the form tree). */
+  config: unknown;
+  api: RestLike | null;
+  /** The "Applies to" choice; null = the connection's own profile. */
+  profile: string | null;
+  focusField: string | null;
+  /** The saved value, so the overlay's copy of the form tree stays current. */
+  onSaved?: (key: string, value: unknown) => void;
+}
+
+export function SchemaPage(props: SchemaPageProps) {
+  const t = useT();
+  const [managed, setManaged] = useState<string | null>(null);
+  const keys = fieldsOnPage(props.page, Object.keys(props.schema));
+  if (keys.length === 0) {
+    return <p className="settings-empty">{t("settings.page.nothing")}</p>;
+  }
+  const save = async (key: string, value: unknown): Promise<string | null> => {
+    const answer = await rest<{ ok: boolean }>(props.api, "PUT", "/api/config", {
+      body: { config: patchFor(key, value) },
+      profile: props.profile,
+    });
+    if (answer.ok) {
+      props.onSaved?.(key, value);
+      return null;
+    }
+    if (answer.code === "config_managed") setManaged(answer.message);
+    return answer.message || t("settings.saveFailed");
+  };
+  return (
+    <div className="settings-rows">
+      {managed !== null && (
+        <p className="settings-banner" role="status">
+          {managed}
+        </p>
+      )}
+      {keys.map((key) => (
+        <FieldRow
+          key={`${props.profile ?? ""}:${key}`}
+          fieldKey={key}
+          field={props.schema[key] as SchemaField}
+          value={valueAt(props.config, key)}
+          disabled={managed !== null}
+          highlighted={props.focusField === key}
+          onSave={save}
+        />
+      ))}
+    </div>
+  );
+}
diff --git a/apps/desktop/src/settings/search.test.ts b/apps/desktop/src/settings/search.test.ts
new file mode 100644
index 0000000..b7e3fdd
--- /dev/null
+++ b/apps/desktop/src/settings/search.test.ts
@@ -0,0 +1,154 @@
+import { describe, expect, it } from "vitest";
+import { translate } from "../i18n/index.tsx";
+import { fieldsOnPage, pageForField, resolveTarget, targetQuery, VIEWS } from "./pages.ts";
+import { buildEntries, type SchemaFields, search } from "./search.ts";
+
+const SCHEMA: SchemaFields = {
+  "model.default": {
+    type: "string",
+    description: "model id used when nothing else picks one",
+    category: "model",
+  },
+  "approvals.mode": {
+    type: "enum",
+    options: ["manual", "smart", "off"],
+    description: "manual asks before risky commands",
+    category: "approvals",
+  },
+  "security.fake_ip_ranges": {
+    type: "list",
+    description: "CIDR blocks a local TUN proxy answers DNS with (dialable, not private)",
+    category: "security",
+  },
+  "terminal.cwd": {
+    type: "string",
+    description: "working directory for commands",
+    category: "terminal",
+  },
+  "terminal.docker_image": {
+    type: "string",
+    description: "image the Docker sandbox runs",
+    category: "terminal",
+  },
+  "memory.notes_enabled": {
+    type: "boolean",
+    description: "keep the agent's own notes",
+    category: "memory",
+  },
+  "platforms.telegram.enabled": { type: "boolean", description: "Telegram", category: "platforms" },
+};
+
+describe("settings pages", () => {
+  it("has the 1.0 views with child pages", () => {
+    expect(VIEWS.map((v) => v.id)).toEqual([
+      "model",
+      "chat",
+      "appearance",
+      "workspace",
+      "safety",
+      "memory",
+      "advanced",
+      "providers",
+      "gateways",
+      "keyboard",
+      "notifications",
+      "sessions",
+      "about",
+    ]);
+    for (const view of VIEWS) expect(view.pages.length).toBeGreaterThan(0);
+  });
+
+  it("a field belongs to the first page that claims it, and only that page renders it", () => {
+    expect(pageForField("terminal.cwd")?.page.id).toBe("projects");
+    expect(pageForField("terminal.docker_image")?.page.id).toBe("terminal");
+    expect(pageForField("platforms.telegram.enabled")).toBeNull();
+    const workspace = VIEWS.find((v) => v.id === "workspace")?.pages[0];
+    const advanced = VIEWS.find((v) => v.id === "advanced")?.pages.find((p) => p.id === "terminal");
+    const keys = Object.keys(SCHEMA);
+    expect(workspace && fieldsOnPage(workspace, keys)).toEqual(["terminal.cwd"]);
+    expect(advanced && fieldsOnPage(advanced, keys)).toEqual(["terminal.docker_image"]);
+    // a page may also show a field owned elsewhere
+    const directory = VIEWS.find((v) => v.id === "sessions")?.pages.find(
+      (p) => p.id === "directory",
+    );
+    expect(directory && fieldsOnPage(directory, keys)).toEqual(["terminal.cwd"]);
+  });
+});
+
+describe("settings links", () => {
+  it("a link naming only a field lands on the owning child page", () => {
+    expect(resolveTarget("field=security.fake_ip_ranges")).toEqual({
+      view: "safety",
+      page: "privacy",
+      field: "security.fake_ip_ranges",
+      row: null,
+    });
+  });
+
+  it("a view without a page, an unknown page or an unknown view land on a first page", () => {
+    expect(resolveTarget("view=safety")).toMatchObject({ view: "safety", page: "approvals" });
+    expect(resolveTarget("view=safety&page=nope")).toMatchObject({
+      view: "safety",
+      page: "approvals",
+    });
+    expect(resolveTarget("view=billing")).toMatchObject({ view: "model", page: "main" });
+    expect(resolveTarget("")).toMatchObject({ view: "model", page: "main" });
+  });
+
+  it("a hand-built row link finds its page; the query round-trips", () => {
+    expect(resolveTarget("row=tray")).toMatchObject({
+      view: "appearance",
+      page: "window",
+      row: "tray",
+    });
+    const query = targetQuery({ view: "memory", page: "context", field: "compression.enabled" });
+    expect(resolveTarget(query)).toMatchObject({
+      view: "memory",
+      page: "context",
+      field: "compression.enabled",
+    });
+  });
+});
+
+describe("settings search", () => {
+  const entries = buildEntries(SCHEMA, translate);
+
+  it('"proxy" lands on the child page that owns the proxy setting', () => {
+    const [first] = search(entries, "proxy");
+    expect(first?.target).toEqual({
+      view: "safety",
+      page: "privacy",
+      field: "security.fake_ip_ranges",
+      row: null,
+    });
+    expect(first?.context).toBe("Safety › Privacy and network");
+  });
+
+  it("finds hand-built rows by their keywords and labels", () => {
+    expect(search(entries, "tray")[0]?.target).toMatchObject({
+      view: "appearance",
+      page: "window",
+      row: "tray",
+    });
+    expect(search(entries, "keychain")[0]?.target).toMatchObject({
+      view: "gateways",
+      page: "storage",
+    });
+    expect(search(entries, "canary")[0]?.target).toMatchObject({
+      view: "advanced",
+      page: "desktop",
+    });
+  });
+
+  it("ranks a label match above a description match, and matches every word", () => {
+    const hits = search(entries, "notes enabled");
+    expect(hits[0]?.target.field).toBe("memory.notes_enabled");
+    expect(search(entries, "approvals smart")[0]?.target.field).toBe("approvals.mode");
+    expect(search(entries, "zzzz")).toEqual([]);
+    expect(search(entries, "   ")).toEqual([]);
+  });
+
+  it("fields no page shows are not offered", () => {
+    expect(search(entries, "telegram")).toEqual([]);
+  });
+});
diff --git a/apps/desktop/src/settings/search.ts b/apps/desktop/src/settings/search.ts
new file mode 100644
index 0000000..b852583
--- /dev/null
+++ b/apps/desktop/src/settings/search.ts
@@ -0,0 +1,105 @@
+// Settings search (P20-32): every schema field the backend describes and every hand-built row,
+// matched by words, each hit carrying the target of the child page that owns it.
+
+import type { MessageKey, Translate } from "../i18n/index.tsx";
+import { MANIFEST, pageForField, type SettingsTarget, type ViewId, viewDef } from "./pages.ts";
+
+/** One field of `GET /api/config/schema`. */
+export interface SchemaField {
+  readonly type: "boolean" | "enum" | "string" | "integer" | "number" | "list";
+  readonly description: string;
+  readonly category: string;
+  readonly options?: readonly string[];
+}
+
+export type SchemaFields = Readonly<Record<string, SchemaField>>;
+
+export interface SearchEntry {
+  readonly id: string;
+  readonly label: string;
+  /** "View › Page" */
+  readonly context: string;
+  readonly description: string;
+  readonly keywords: readonly string[];
+  readonly target: SettingsTarget;
+}
+
+/** `memory.notes_char_limit` → "Notes char limit". */
+export function fieldLabel(key: string): string {
+  const last = key.split(".").pop() ?? key;
+  const words = last.replace(/[_-]+/g, " ").trim();
+  return words === "" ? key : words.charAt(0).toUpperCase() + words.slice(1);
+}
+
+function contextOf(t: Translate, view: ViewId, page: string): string {
+  const def = viewDef(view);
+  const pageDef = def?.pages.find((p) => p.id === page);
+  if (def === null || pageDef === undefined) return "";
+  return `${t(def.label)} › ${t(pageDef.label)}`;
+}
+
+/** The searchable entries: schema fields with an owning page, then the hand-built rows. */
+export function buildEntries(schema: SchemaFields | null, t: Translate): SearchEntry[] {
+  const entries: SearchEntry[] = [];
+  for (const [key, field] of Object.entries(schema ?? {})) {
+    const owner = pageForField(key);
+    if (owner === null) continue;
+    entries.push({
+      id: `field:${key}`,
+      label: fieldLabel(key),
+      context: contextOf(t, owner.view.id, owner.page.id),
+      description: field.description,
+      keywords: [key, ...key.split(/[._]/), field.category, ...(field.options ?? [])],
+      target: { view: owner.view.id, page: owner.page.id, field: key, row: null },
+    });
+  }
+  for (const row of MANIFEST) {
+    entries.push({
+      id: `row:${row.id}`,
+      label: t(row.label),
+      context: contextOf(t, row.view, row.page),
+      description: row.description === undefined ? "" : t(row.description as MessageKey),
+      keywords: row.keywords,
+      target: { view: row.view, page: row.page, field: null, row: row.id },
+    });
+  }
+  return entries;
+}
+
+function fold(text: string): string {
+  return text
+    .normalize("NFKD")
+    .replace(/[̀-ͯ]/g, "")
+    .toLowerCase()
+    .replace(/[_.\-/]+/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** 0 = no match; higher = better (label before context before description and keywords). */
+export function score(entry: SearchEntry, query: string): number {
+  const needle = fold(query);
+  if (needle === "") return 0;
+  const label = fold(entry.label);
+  const context = fold(entry.context);
+  const rest = fold([entry.description, ...entry.keywords].join(" "));
+  const all = `${label} ${context} ${rest}`;
+  const words = needle.split(" ");
+  if (!words.every((word) => all.includes(word))) return 0;
+  if (label === needle) return 6;
+  if (label.startsWith(needle)) return 5;
+  if (words.every((word) => label.includes(word))) return 4;
+  if (words.every((word) => context.includes(word) || label.includes(word))) return 3;
+  if (entry.keywords.some((k) => fold(k) === needle)) return 2;
+  return 1;
+}
+
+/** Matching entries, best first (table order breaks ties). */
+export function search(entries: readonly SearchEntry[], query: string, limit = 40): SearchEntry[] {
+  return entries
+    .map((entry, index) => ({ entry, index, value: score(entry, query) }))
+    .filter((hit) => hit.value > 0)
+    .sort((a, b) => b.value - a.value || a.index - b.index)
+    .slice(0, limit)
+    .map((hit) => hit.entry);
+}
