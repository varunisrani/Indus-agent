diff --git a/apps/desktop/electron/main.ts b/apps/desktop/electron/main.ts
index e19f563..82c0d19 100644
--- a/apps/desktop/electron/main.ts
+++ b/apps/desktop/electron/main.ts
@@ -32,12 +32,15 @@ import { appMenuTemplate } from "./appMenu.ts";
 import { type AppOrigin, devServerOrigin, fileAppOrigin } from "./appOrigin.ts";
 import { type ElectronHooks, installBackend } from "./backend/install.ts";
 import type { MainContext } from "./context.ts";
