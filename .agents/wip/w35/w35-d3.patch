+          <h2 id="onboarding-title">{t("onboarding.title")}</h2>
+          {state.manual && (
+            <button
+              type="button"
+              className="icon-button"
+              aria-label={t("common.close")}
+              onClick={() => send({ type: "close" })}
+            >
+              <X aria-hidden="true" size={16} />
+            </button>
+          )}
