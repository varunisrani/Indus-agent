+            value={key}
+            onChange={setKey}
+          />
+          <span className="settings-inline">
+            <button
+              type="button"
+              className="button button-secondary"
+              disabled={!/^https?:\/\//i.test(url.trim()) || busy}
+              onClick={async () => {
+                setBusy(true);
+                setResult(
+                  await testEndpoint(
+                    api,
