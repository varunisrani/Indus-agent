+      ]);
+      if (verified.code !== 0) continue;
+      const base = await this.git(root, ["merge-base", "HEAD", verified.stdout.trim()]);
+      if (base.code === 0 && base.stdout.trim() !== "") return base.stdout.trim();
+    }
+    return null;
+  }
