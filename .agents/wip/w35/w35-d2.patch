+// @vitest-environment jsdom
+import { act, render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { type PaneContext, paneDefinition, paneDefinitions } from "./_stubs_d2.ts";
+import { previewTargets, registerWorkingPanes } from "./d2Panes.tsx";
+
+const context: PaneContext = {
+  sessionId: null,
+  workspace: null,
+  mode: "local",
+  hidden: false,
+  connection: null,
+};
+
+describe("working panes registration", () => {
+  it("registers preview, files, review and terminal; preview and terminal are stateful", () => {
+    registerWorkingPanes();
+    registerWorkingPanes();
+    expect(paneDefinitions().map((d) => [d.kind, d.stateful])).toEqual([
+      ["preview", true],
+      ["files", false],
+      ["review", false],
+      ["terminal", true],
+    ]);
+  });
+
+  it("each pane renders from the shell's context (no bridge in a plain page)", () => {
+    registerWorkingPanes();
+    for (const kind of ["files", "review"] as const) {
+      const view = render(<div>{paneDefinition(kind)?.render(context)}</div>);
+      expect(screen.getByText("This conversation has no working folder yet.")).toBeTruthy();
+      view.unmount();
+    }
+    render(<div>{paneDefinition("terminal")?.render({ ...context, mode: "remote" })}</div>);
+    expect(screen.getByText(/connected to a remote Indus/)).toBeTruthy();
+  });
+
+  it("the preview follows the shared target when the shell has no store of its own", () => {
+    registerWorkingPanes();
+    render(<div>{paneDefinition("preview")?.render(context)}</div>);
+    expect(screen.getByText(/Nothing to preview yet/)).toBeTruthy();
+    act(() => previewTargets.set({ kind: "file", path: "/srv/remote.txt" }));
+    expect((screen.getByRole("textbox", { name: "Address" }) as HTMLInputElement).value).toBe(
+      "/srv/remote.txt",
+    );
+    act(() => previewTargets.set(null));
+  });
+});
diff --git a/apps/desktop/src/panes/d2Panes.tsx b/apps/desktop/src/panes/d2Panes.tsx
new file mode 100644
index 0000000..301ada3
--- /dev/null
+++ b/apps/desktop/src/panes/d2Panes.tsx
@@ -0,0 +1,142 @@
+// The working panes of slice D2 (P20-28 preview, P20-29 files, P20-30 git review, P20-31 terminal),
+// registered with the pane shell. Each definition turns the shell's `PaneContext` into the pane's
+// props; the shell decides where and when they show. `registerWorkingPanes()` runs once at start.
+
+import { useEffect, useState, useSyncExternalStore } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import type { IndusDesktopBridge } from "../global.d.ts";
+import { useT } from "../i18n/index.tsx";
+import { type PaneContext, type PaneDefinition, registerPane } from "./_stubs_d2.ts";
+import { FilesPane } from "./files/FilesPane.tsx";
+import { PreviewPane } from "./preview/PreviewPane.tsx";
+import type { PreviewTarget } from "./preview/target.ts";
+import { draftWithAgent, trackTurnBase } from "./review/agentDraft.ts";
+import { ReviewPane } from "./review/ReviewPane.tsx";
+import { TerminalPane } from "./terminal/TerminalPane.tsx";
+
+/** What the preview pane shows when the shell has no target store of its own. */
+class PreviewTargets {
+  private target: PreviewTarget | null = null;
+  private readonly listeners = new Set<() => void>();
+  get = (): PreviewTarget | null => this.target;
+  set = (target: PreviewTarget | null): void => {
+    this.target = target;
+    for (const listener of [...this.listeners]) listener();
+  };
+  subscribe = (listener: () => void): (() => void) => {
+    this.listeners.add(listener);
+    return () => this.listeners.delete(listener);
+  };
+}
+
+export const previewTargets = new PreviewTargets();
+
+function openPreview(context: PaneContext, target: PreviewTarget): void {
+  if (context.openPreview !== undefined) context.openPreview(target);
+  else previewTargets.set(target);
+}
+
+function PreviewHost(props: { context: PaneContext }) {
+  const target = useSyncExternalStore(
+    previewTargets.subscribe,
+    previewTargets.get,
+    previewTargets.get,
+  );
+  const { context } = props;
+  return (
+    <PreviewPane
+      target={target}
+      mode={context.mode}
+      hidden={context.hidden}
+      onNavigate={previewTargets.set}
+    />
+  );
+}
+
+function ReviewHost(props: { context: PaneContext }) {
+  const t = useT();
+  const { context } = props;
+  const [base, setBase] = useState<string | null>(null);
+  const { connection, sessionId, workspace } = context;
+
+  useEffect(() => {
+    setBase(null);
+    const git = (desktopBridge() as IndusDesktopBridge | null)?.git;
+    if (connection === null || sessionId === null || workspace === null || git === undefined)
+      return;
+    return trackTurnBase(
+      connection,
+      sessionId,
+      async () => (await git.status({ repo: workspace })).head,
+      setBase,
+    );
+  }, [connection, sessionId, workspace]);
+
+  if (context.mode === "remote")
+    return <p className="p-3 text-sm text-muted">{t("pane.unavailable")}</p>;
+  return (
+    <ReviewPane
+      repo={workspace}
+      hidden={context.hidden}
+      lastTurnBase={base}
+      {...(connection === null || sessionId === null
+        ? {}
+        : { draftMessage: (prompt: string) => draftWithAgent(connection, sessionId, prompt) })}
+      {...(context.addToChat === undefined
+        ? {}
+        : { askAgent: (prompt: string) => context.addToChat?.(prompt) })}
+    />
+  );
+}
+
+export const WORKING_PANES: readonly PaneDefinition[] = [
+  {
+    kind: "preview",
+    titleKey: "pane.preview",
+    stateful: true,
+    render: (context) => <PreviewHost context={context} />,
+  },
+  {
+    kind: "files",
+    titleKey: "pane.files",
+    stateful: false,
+    render: (context) => (
+      <FilesPane
+        workspace={context.workspace}
+        mode={context.mode}
+        hidden={context.hidden}
+        onPreview={(path) => openPreview(context, { kind: "file", path })}
+      />
+    ),
+  },
+  {
+    kind: "review",
+    titleKey: "pane.review",
+    stateful: false,
+    render: (context) => <ReviewHost context={context} />,
+  },
+  {
+    kind: "terminal",
+    titleKey: "pane.terminal",
+    stateful: true,
+    render: (context) => (
+      <TerminalPane
+        cwd={context.workspace}
+        mode={context.mode}
+        hidden={context.hidden}
+        {...(context.addToChat === undefined
+          ? {}
+          : { onAddToChat: (text: string) => context.addToChat?.(text) })}
+      />
+    ),
+  },
+];
+
+let registered = false;
+
+/** Register the four panes with the pane shell (once). */
+export function registerWorkingPanes(): void {
+  if (registered) return;
+  registered = true;
+  for (const definition of WORKING_PANES) registerPane(definition);
+}
