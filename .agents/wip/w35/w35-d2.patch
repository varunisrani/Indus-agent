@@ -0,0 +1,59 @@
+// STAND-IN: removed at integration
+//
+// Slice D2 (P20-28..31) mounts its panes into slice D1's pane shell (P20-27). Until that lands,
+// this file stands in for the shell's pane registry with the interface D2 assumed:
+//
+//   registerPane(definition)   one entry per pane kind; the shell lists them, makes tabs, and
+//                              renders `definition.render(context)` inside a zone.
+//   PaneContext                what the shell hands each pane: the route's session id, the
+//                              session's working folder, the connection mode, whether the pane is
+//                              hidden (Hide keeps the body mounted and inert — stateful panes keep
+//                              their webview / shells), the chat connection, and two hand-offs: open
+//                              something in the preview pane, add text to the composer.
+//   stateful                   true for preview and terminal: the shell offers Hide, not minimise,
+//                              and Close releases them.
+//
+// At integration: replace this module with D1's registry and adapt `src/panes/d2Panes.tsx` (the
+// only importer) to its names.
+
+import type { ReactNode } from "react";
+import type { ChatConnection } from "../gateway/connectionStore.ts";
+import type { MessageKey } from "../i18n/index.tsx";
+import type { PreviewTarget } from "./preview/target.ts";
+
+export type PaneKind = "preview" | "files" | "review" | "terminal";
+
+export interface PaneContext {
+  readonly sessionId: string | null;
+  /** The session's working folder (local path in local mode, remote path in remote mode). */
+  readonly workspace: string | null;
+  readonly mode: "local" | "remote" | null;
+  /** Hidden by the shell: the body stays mounted but must not take focus or input. */
+  readonly hidden: boolean;
+  readonly connection: ChatConnection | null;
+  /** Show something in the preview pane (focusing it). */
+  openPreview?(target: PreviewTarget): void;
+  /** Put text into the composer of the current conversation. */
+  addToChat?(text: string): void;
+}
+
+export interface PaneDefinition {
+  readonly kind: PaneKind;
+  readonly titleKey: MessageKey;
+  readonly stateful: boolean;
+  render(context: PaneContext): ReactNode;
+}
+
+const REGISTRY = new Map<PaneKind, PaneDefinition>();
+
+export function registerPane(definition: PaneDefinition): void {
+  REGISTRY.set(definition.kind, definition);
+}
+
+export function paneDefinition(kind: PaneKind): PaneDefinition | undefined {
+  return REGISTRY.get(kind);
+}
+
+export function paneDefinitions(): PaneDefinition[] {
+  return [...REGISTRY.values()];
+}
