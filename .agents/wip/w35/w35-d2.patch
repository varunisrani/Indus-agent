+    ).toEqual({ command: "/usr/bin/zsh", args: ["-il"], name: "zsh" });
+    expect(
+      chooseShell({
+        platform: "darwin",
+        env: { SHELL: "/missing" },
+        isExecutable: exists(["/bin/bash"]),
+        findOnPath: () => null,
+      }),
+    ).toEqual({ command: "/bin/bash", args: ["-il"], name: "bash" });
+  });
+  it("Windows: pwsh, Windows PowerShell, then COMSPEC; $SHELL ignored", () => {
+    expect(
+      chooseShell({
