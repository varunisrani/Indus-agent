+// The ambient and update steps through the real IPC registry (P20-35..37 together): every channel
+// they own has a handler; quick entry reaches the last-active session of the right window and
+// answers; the HUD opens on that session and every window hears it; a bare-key shortcut is refused;
+// notifications and settings round-trip; updates answer without touching the network.
+
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { FakeScreen, FakeWindow } from "../../testing/fakeFloating.ts";
+import { fileAppOrigin } from "../appOrigin.ts";
+import type { MainContext } from "../context.ts";
+import { CHANNELS } from "../ipc/channels.ts";
+import type { Envelope } from "../ipc/envelope.ts";
+import { type IpcMainLike, IpcRegistry } from "../ipc/registry.ts";
+import type { FrameLike, IpcEventLike } from "../ipc/senderCheck.ts";
+import { QuitGuard } from "../quitGuard.ts";
+import { createUpdateGate, installUpdates } from "../updates/install.ts";
+import type { WindowKind } from "../windows/factory.ts";
+import { type AmbientElectron, installAmbient } from "./install.ts";
+
+const APP_URL = "file:///opt/Indus/app/dist/index.html";
+const OWNED = ["P20-35", "P20-36", "P20-37"];
+type Listener = (event: IpcEventLike, ...args: unknown[]) => unknown;
+
+class FakeManager {
+  readonly all: Array<{ win: FakeWindow; kind: WindowKind; profile: string | null }> = [];
+  private readonly created: Array<(win: FakeWindow, kind: WindowKind) => void> = [];
+  raised: Array<[FakeWindow, string]> = [];
+
+  add(kind: WindowKind, profile: string | null = null): FakeWindow {
+    const win = new FakeWindow();
+    win.visible = kind !== "hud" && kind !== "quick";
+    this.all.push({ win, kind, profile });
+    for (const listener of this.created) listener(win, kind);
+    return win;
+  }
+  onWindowCreated(listener: (win: FakeWindow, kind: WindowKind) => void) {
+    this.created.push(listener);
+    return () => {};
+  }
+  windows() {
+    return this.all.filter((w) => !w.win.destroyed).map((w) => w.win);
+  }
+  mainWindow() {
+    return this.all.find((w) => w.kind === "main" && !w.win.destroyed)?.win ?? null;
+  }
+  openMain() {
+    return this.add("main");
+  }
+  openHud() {
+    return this.add("hud");
+  }
+  openQuick() {
+    return this.add("quick");
+  }
+  private entry(id: number) {
+    return this.all.find((w) => w.win.webContents.id === id && !w.win.destroyed);
+  }
+  kindOf(id: number) {
+    return this.entry(id)?.kind ?? null;
+  }
+  windowOf(id: number) {
+    return this.entry(id)?.win ?? null;
+  }
+  isKnownWebContents = (id: number) => this.entry(id) !== undefined;
+  describe(id: number) {
+    const entry = this.entry(id);
+    return entry === undefined ? null : { kind: entry.kind, watch: false, profile: entry.profile };
+  }
+  raise(win: FakeWindow, reason: string) {
+    this.raised.push([win, reason]);
+  }
+}
+
+const dirs: string[] = [];
+afterEach(() => {
+  for (const dir of dirs.splice(0)) fs.rmSync(dir, { recursive: true, force: true });
+  delete process.env.INDUS_DESKTOP_NO_UPDATE_CHECK;
+});
+
+function rig() {
+  const base = fs.mkdtempSync(path.join(os.tmpdir(), "ambient-"));
+  dirs.push(base);
+  const handles = new Map<string, Listener>();
+  const ons = new Map<string, Listener>();
+  const ipc: IpcMainLike = {
+    handle: (channel, listener) => {
+      handles.set(channel, listener as Listener);
+    },
+    on: (channel, listener) => {
+      ons.set(channel, listener as Listener);
+      return ipc;
+    },
+  };
+  const appOrigin = fileAppOrigin("/opt/Indus/app/dist/index.html", "linux");
+  const windows = new FakeManager();
+  const registry = new IpcRegistry({
+    ipc,
+    policy: { appOrigin, isKnownWebContents: (id) => windows.isKnownWebContents(id) },
+    log: () => {},
+  });
+  const lines: string[] = [];
+  const context = {
+    registry,
+    windows,
+    log: { write: (line: string) => lines.push(line) },
+    paths: { home: path.join(base, "home"), userData: path.join(base, "userData") },
+    appOrigin,
+    dev: false,
+    packaged: false,
+    platform: "darwin",
+    appVersion: "1.0.0",
+  } as unknown as MainContext;
+  fs.mkdirSync(path.join(base, "userData"), { recursive: true });
+  fs.mkdirSync(path.join(base, "home"), { recursive: true });
+
+  const registered = new Map<string, () => void>();
+  const appListeners = new Map<string, (...args: never[]) => void>();
+  const notifications: unknown[] = [];
+  const screen = new FakeScreen();
+  const electron: AmbientElectron = {
+    app: {
+      on: ((event: string, listener: (...args: never[]) => void) => {
+        appListeners.set(event, listener);
+        return undefined;
+      }) as AmbientElectron["app"]["on"],
+      quit: () => {},
+      dock: undefined,
+    },
+    globalShortcut: {
+      register: (accelerator, callback) => {
+        registered.set(accelerator, callback);
+        return true;
+      },
+      unregister: (accelerator) => {
+        registered.delete(accelerator);
+      },
+      isRegistered: (accelerator) => registered.has(accelerator),
+    },
+    screen,
+    powerSaveBlocker: { start: () => 1, stop: () => {}, isStarted: () => false },
+    powerMonitor: { on: () => undefined, getSystemIdleTime: () => 0 },
+    createTray: () => {
+      throw new Error("no tray in tests");
+    },
+    buildMenu: (items) => items,
+    notification: {
+      isSupported: () => true,
+      create: (options) => {
+        notifications.push(options);
+        return { show() {}, close() {}, on: () => undefined };
+      },
+    },
+    createLinkWindow: () => {
+      throw new Error("no windows in tests");
+    },
+    fetch: () => Promise.reject(new Error("no network in tests")),
+  };
+  const quitGuard = new QuitGuard();
+  process.env.INDUS_DESKTOP_NO_UPDATE_CHECK = "1";
+  const gate = createUpdateGate(context);
+  const ambient = installAmbient(context, electron, { quitGuard });
+  const updates = installUpdates(
+    context,
+    {
+      app: {
+        getAppPath: () => base,
+        on: ((event: string, listener: () => void) => {
+          appListeners.set(`updates:${event}`, listener as never);
+          return undefined;
+        }) as never,
+      },
+      fetch: () => Promise.reject(new Error("no network in tests")),
+      runtimeVersion: () => null,
+    },
+    { gate, stopAppWork: async () => {} },
+  );
+  registry.seal();
+
+  const eventFor = (win: FakeWindow): IpcEventLike => {
+    const frame: FrameLike = {
+      url: `${APP_URL}#/`,
+      processId: 1,
+      routingId: win.webContents.id,
+      frameTreeNodeId: 1,
+    };
+    return {
+      sender: { id: win.webContents.id, mainFrame: frame, getType: () => "window" },
+      senderFrame: frame,
+    };
+  };
+  const invoke = async (win: FakeWindow, channel: string, payload?: unknown) => {
+    const listener = handles.get(channel);
+    if (listener === undefined) throw new Error(`no handler for ${channel}`);
+    return (await listener(
+      eventFor(win),
+      ...(payload === undefined ? [] : [payload]),
+    )) as Envelope<unknown>;
+  };
+  const send = (win: FakeWindow, channel: string, payload?: unknown) =>
+    ons.get(channel)?.(eventFor(win), ...(payload === undefined ? [] : [payload]));
+  const stop = () => {
+    updates.gate.stop();
+    updates.updater.stop();
+  };
+  return {
+    handles,
+    ons,
+    windows,
+    invoke,
+    send,
+    registered,
+    notifications,
+    ambient,
+    screen,
+    stop,
+    lines,
+  };
+}
+
+describe("ambient and updates through the registry", () => {
+  it("every channel P20-35..37 owns has a handler (none answers not-available)", async () => {
+    const r = rig();
+    const main = r.windows.add("main");
+    for (const def of CHANNELS) {
+      if (!OWNED.includes(def.owner) || def.kind === "event") continue;
+      expect(r.handles.has(def.name) || r.ons.has(def.name), def.name).toBe(true);
+    }
+    const status = await r.invoke(main, "indus:updates:status");
+    expect(status).toMatchObject({ ok: true, value: { owner: "manual", currentVersion: "1.0.0" } });
+    r.stop();
+  });
+
+  it("quick entry submits into the last-active session of the window used last", async () => {
+    const r = rig();
+    const main = r.windows.add("main");
+    const second = r.windows.add("secondary");
+    r.send(main, "indus:session:active", { sessionId: "s-main" });
+    r.send(second, "indus:session:active", { sessionId: "s-second" });
+    second.emit("blur");
+    main.emit("focus"); // the person went back to the main window
+
+    r.registered.get("CommandOrControl+Shift+Space")?.(); // the global chord
+    const quick = r.windows.all.find((w) => w.kind === "quick")?.win as FakeWindow;
+    quick.show();
+    const pending = r.invoke(quick, "indus:quick:submit", { text: "summarise the log" });
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    const delivered = main.webContents.sent.find(([channel]) => channel === "indus:quick:deliver");
+    expect(delivered?.[1]).toMatchObject({ text: "summarise the log", sessionId: "s-main" });
+    expect(second.webContents.sent.some(([c]) => c === "indus:quick:deliver")).toBe(false);
+    const requestId = (delivered as [string, { requestId: string }])[1].requestId;
+    r.send(main, "indus:quick:ack", { requestId, ok: true, sessionId: "s-main" });
+    expect(await pending).toEqual({ ok: true, value: { ok: true, sessionId: "s-main" } });
+    expect(quick.visible).toBe(false);
+    expect(r.windows.raised.at(-1)).toEqual([main, "open-request"]);
+    r.stop();
+  });
+
+  it("a quick submit from an app window is refused", async () => {
+    const r = rig();
+    const main = r.windows.add("main");
+    expect(await r.invoke(main, "indus:quick:submit", { text: "x" })).toMatchObject({
+      ok: true,
+      value: { ok: false, code: "failed" },
+    });
+    r.stop();
+  });
+
+  it("the HUD toggle opens the last-active session; every window hears it; snap is held only meanwhile", async () => {
+    const r = rig();
+    const main = r.windows.add("main", "work");
+    r.send(main, "indus:session:active", { sessionId: "s-9" });
+    expect(r.registered.has("CommandOrControl+Shift+G")).toBe(false);
+    r.registered.get("CommandOrControl+Shift+H")?.();
+    expect(r.ambient.hud.state()).toEqual({ open: true, sessionId: "s-9", profile: "work" });
+    expect(main.webContents.sent).toContainEqual([
+      "indus:hud:changed",
+      { open: true, sessionId: "s-9", profile: "work" },
+    ]);
+    expect(r.registered.has("CommandOrControl+Shift+G")).toBe(true);
+    expect(await r.invoke(main, "indus:hud:close")).toMatchObject({
+      ok: true,
+      value: { open: false },
+    });
+    expect(r.registered.has("CommandOrControl+Shift+G")).toBe(false);
+    r.stop();
+  });
+
+  it("a bare-key shortcut is refused with its reason and nothing is saved", async () => {
+    const r = rig();
+    const main = r.windows.add("main");
+    const refused = await r.invoke(main, "indus:shortcuts:set", {
+      action: "quick-entry",
+      accelerator: "G",
+    });
+    expect(refused).toMatchObject({
+      ok: true,
+      value: { rejected: { action: "quick-entry", reason: "no-modifier" } },
+    });
+    expect(r.registered.has("CommandOrControl+Shift+Space")).toBe(true);
+    const moved = await r.invoke(main, "indus:shortcuts:set", {
+      action: "quick-entry",
+      accelerator: "ctrl+alt+k",
+    });
+    expect(moved.ok).toBe(true);
+    expect(r.registered.has("Control+Alt+K")).toBe(true);
+    expect(r.registered.has("CommandOrControl+Shift+Space")).toBe(false);
+    r.stop();
+  });
+
+  it("settings and notifications round-trip; a tray that cannot be made reads unavailable", async () => {
+    const r = rig();
+    const main = r.windows.add("main");
+    const set = await r.invoke(main, "indus:ambient:set", { minimizeToTray: true, sounds: false });
+    expect(set).toMatchObject({
+      ok: true,
+      value: {
+        tray: { enabled: true, available: false },
+        sounds: false,
+        keepAwake: "while-working",
+      },
+    });
+    expect(await r.invoke(main, "indus:ambient:set", { keepAwake: "sometimes" })).toMatchObject({
+      ok: false,
+      code: "bad-request",
+    });
+    const shown = await r.invoke(main, "indus:notify", { title: "Reply ready", tag: "turn:s1" });
+    expect(shown).toEqual({ ok: true, value: { shown: true } });
+    expect(r.notifications).toEqual([{ title: "Reply ready", body: "", silent: true }]);
+    expect(
+      await r.invoke(main, "indus:notify", {
+        title: "x",
+        actions: [1, 2, 3, 4, 5].map((n) => ({ id: `a${n}`, label: "A" })),
+      }),
+    ).toMatchObject({ ok: false, code: "bad-request" });
+    r.stop();
+  });
+
+  it("an unknown window is refused before any handler runs", async () => {
+    const r = rig();
+    const stranger = new FakeWindow();
+    expect(await r.invoke(stranger, "indus:hud:open", {})).toMatchObject({
+      ok: false,
+      code: "sender-rejected",
+    });
+    expect(r.ambient.hud.state().open).toBe(false);
+    r.stop();
+  });
+});
diff --git a/apps/desktop/electron/ambient/install.ts b/apps/desktop/electron/ambient/install.ts
new file mode 100644
index 0000000..53bbfc6
--- /dev/null
+++ b/apps/desktop/electron/ambient/install.ts
@@ -0,0 +1,368 @@
+// Main's ambient side (P20-35, P20-36): the HUD, quick entry and the global shortcuts, the tray,
+// keep awake, notifications and link previews, wired into the IPC registry. `main.ts` calls
+// `installAmbient(context, electron, { quitGuard })` once, after `installBackend` (so its quit hook
+// sees whether the quit guard stopped a quit).
+
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+import type { MainContext } from "../context.ts";
+import type { EventChannel } from "../ipc/channels.ts";
+import type { EventTarget } from "../ipc/registry.ts";
+import type { PayloadOf } from "../ipc/schemas.ts";
+import type { QuitGuard } from "../quitGuard.ts";
+import type { WindowKind } from "../windows/factory.ts";
+import type { BrowserWindowLike } from "../windows/manager.ts";
+import { ActiveSessions } from "./activeSession.ts";
+import { GdbusClient } from "./dbus.ts";
+import { type FloatingWindow, HudController, type ScreenLike } from "./hud.ts";
+import { KeepAwake, type PowerSaveBlockerLike } from "./keepAwake.ts";
+import { type LinkPreviewDeps, LinkPreviewer, type LinkWindowLike } from "./linkPreview.ts";
+import {
+  type ElectronNotificationLike,
+  type ElectronNotificationOptions,
+  NotificationCenter,
+} from "./notifications.ts";
+import { QuickEntryController } from "./quickEntry.ts";
+import { AmbientSettingsStore } from "./settings.ts";
+import {
+  type AcceleratorRefusal,
+  type GlobalShortcutLike,
+  parseAccelerator,
+  readShortcutSettings,
+  type ShortcutAction,
+  ShortcutBoard,
+  type ShortcutSettings,
+  writeShortcutSettings,
+} from "./shortcuts.ts";
+import { type MenuItem, TrayController, type TrayLike, type TrayWindow } from "./tray.ts";
+
+/** The Electron pieces this step uses (passed by main.ts so the module stays testable). */
+export interface AmbientElectron {
+  app: {
+    on(event: "before-quit", listener: (event: { defaultPrevented?: boolean }) => void): unknown;
+    on(event: "will-quit", listener: () => void): unknown;
+    quit(): void;
+    dock?: { hide(): void; show(): void } | undefined;
+  };
+  globalShortcut: GlobalShortcutLike;
+  screen: ScreenLike;
+  powerSaveBlocker: PowerSaveBlockerLike;
+  powerMonitor: {
+    on(event: "suspend" | "resume", listener: () => void): unknown;
+    getSystemIdleTime(): number;
+  };
+  /** A tray with our glyph (or the packaged icon); throws when the platform has none. */
+  createTray(): TrayLike;
+  buildMenu(items: MenuItem[]): unknown;
+  notification: {
+    isSupported(): boolean;
+    create(options: ElectronNotificationOptions): ElectronNotificationLike;
+  };
+  /** `new BrowserWindow(options)` for the hidden link-preview window. */
+  createLinkWindow(options: Record<string, unknown>): LinkWindowLike;
+  /** Fetch for link previews (main's network stack, the link partition). */
+  fetch: LinkPreviewDeps["fetch"];
+}
+
+export interface AmbientHandle {
+  hud: HudController;
+  quick: QuickEntryController;
+  shortcuts: ShortcutBoard;
+  tray: TrayController;
+  keepAwake: KeepAwake;
+  notifications: NotificationCenter;
+  links: LinkPreviewer;
+  activeSessions: ActiveSessions;
+}
+
+const APP_WINDOW_KINDS: ReadonlySet<WindowKind> = new Set(["main", "secondary", "instance"]);
+
+export function installAmbient(
+  context: MainContext,
+  electron: AmbientElectron,
+  backend: { quitGuard: QuitGuard },
+): AmbientHandle {
+  const { registry, windows, paths, log } = context;
+  const line = (text: string) => log.write(text);
+  const timers = {
+    setTimeout: (fn: () => void, ms: number) => setTimeout(fn, ms),
+    clearTimeout: (handle: unknown) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+  };
+  const broadcast = <N extends EventChannel>(name: N, payload: PayloadOf<N>) => {
+    for (const win of windows.windows())
+      registry.emit(win.webContents as EventTarget, name, payload);
+  };
+  const emitTo = <N extends EventChannel>(
+    win: BrowserWindowLike,
+    name: N,
+    payload: PayloadOf<N>,
+  ): boolean => registry.emit(win.webContents as EventTarget, name, payload);
+
+  // -- last-active session ----------------------------------------------------------------------
+
+  const activeSessions = new ActiveSessions();
+  const isAppWindow = (contentsId: number) => {
+    const kind = windows.kindOf(contentsId);
+    return kind !== null && APP_WINDOW_KINDS.has(kind) && windows.isKnownWebContents(contentsId);
+  };
+  const lastActive = () => {
+    const report = activeSessions.latest(isAppWindow);
+    if (report === null) return null;
+    const win = windows.windowOf(report.contentsId);
+    return win === null ? null : { ...report, window: win };
+  };
+
+  // -- settings ---------------------------------------------------------------------------------
+
+  const settings = new AmbientSettingsStore(path.join(paths.userData, "ambient.json"), line);
+  const shortcutsFile = path.join(paths.userData, "shortcuts.json");
+  let shortcutSettings: ShortcutSettings = readShortcutSettings(shortcutsFile);
+
+  // -- HUD, quick entry, shortcuts ---------------------------------------------------------------
+
+  let hud: HudController;
+  let quick: QuickEntryController;
+  const board = new ShortcutBoard({
+    globalShortcut: electron.globalShortcut,
+    handlers: {
+      "hud-toggle": () =>
+        hud.toggle(() => {
+          const active = lastActive();
+          return {
+            sessionId: active?.sessionId ?? null,
+            profile:
+              active === null ? null : (windows.describe(active.contentsId)?.profile ?? null),
+          };
+        }),
+      "hud-snap": () => hud.snapToPointer(),
+      "quick-entry": () => quick.toggle(),
+    },
+    log: line,
+  });
+  const applyShortcuts = () =>
+    board.apply(shortcutSettings, (action) => action !== "hud-snap" || hud.state().open);
+
+  hud = new HudController({
+    create: (options, bounds) => windows.openHud(options, bounds) as FloatingWindow,
+    mainWindow: () => windows.mainWindow() as (BrowserWindowLike & { hide(): void }) | null,
+    screen: electron.screen,
+    statePath: path.join(paths.userData, "hud-state.json"),
+    timers,
+    now: Date.now,
+    broadcast: (state) => broadcast("indus:hud:changed", state),
+    onOpenChanged: () => applyShortcuts(),
+    log: line,
+    platform: context.platform,
+  });
+
+  quick = new QuickEntryController({
+    create: (bounds) => windows.openQuick(bounds) as FloatingWindow,
+    screen: electron.screen,
+    target: () => {
+      const active = lastActive();
+      if (active !== null)
+        return {
+          contentsId: active.contentsId,
+          sessionId: active.sessionId,
+          window: active.window,
+        };
+      const main = windows.mainWindow();
+      return main === null
+        ? null
+        : { contentsId: main.webContents.id, sessionId: null, window: main };
+    },
+    deliver: (target, payload) => emitTo(target.window, "indus:quick:deliver", payload),
+    shown: (win) => emitTo(win, "indus:quick:shown", {}),
+    raise: (win) => windows.raise(win, "open-request"),
+    timers,
+    newId: () => randomUUID(),
+    log: line,
+    platform: context.platform,
+  });
+
+  const shortcutsView = (rejected?: { action: ShortcutAction; reason: AcceleratorRefusal }) => ({
+    shortcuts: board.current(),
+    ...(rejected === undefined ? {} : { rejected }),
+  });
+
+  registry.handle("indus:hud:open", ({ sessionId, profile }, { senderId }) => {
+    const from = windows.describe(senderId);
+    return hud.open(sessionId ?? null, profile ?? from?.profile ?? null);
+  });
+  registry.handle("indus:hud:close", () => hud.close());
+  registry.handle("indus:hud:reset-layout", () => ({ reset: hud.resetLayout() }));
+  registry.on("indus:hud:drag", ({ phase, mode }, { senderId }) =>
+    hud.dragFrom(senderId, phase, mode),
+  );
+
+  registry.handle("indus:quick:submit", ({ text }, { senderId }) => quick.submit(senderId, text));
+  registry.on("indus:quick:dismiss", (_payload, { senderId }) => {
+    if (quick.isQuick(senderId)) quick.hide();
+  });
+  registry.on("indus:quick:ack", (answer, { senderId }) => quick.ack(senderId, answer));
+
+  registry.handle("indus:shortcuts:get", () => shortcutsView());
+  registry.handle("indus:shortcuts:set", ({ action, accelerator, enabled }) => {
+    const next: ShortcutSettings = {
+      ...shortcutSettings,
+      [action]: { ...shortcutSettings[action] },
+    };
+    if (accelerator !== undefined) {
+      const parsed = parseAccelerator(accelerator);
+      if (!parsed.ok) return shortcutsView({ action, reason: parsed.reason });
+      next[action].accelerator = parsed.accelerator;
+    }
+    if (enabled !== undefined) next[action].enabled = enabled;
+    shortcutSettings = next;
+    try {
+      writeShortcutSettings(shortcutsFile, shortcutSettings);
+    } catch {
+      line("[shortcuts] could not save the shortcuts; they apply until the app quits");
+    }
+    applyShortcuts();
+    if (action === "quick-entry" && !shortcutSettings["quick-entry"].enabled) quick.close();
+    return shortcutsView();
+  });
+
+  registry.on("indus:session:active", ({ sessionId }, { senderId }) => {
+    if (isAppWindow(senderId)) activeSessions.report(senderId, sessionId);
+  });
+
+  // -- tray --------------------------------------------------------------------------------------
+
+  const dbus = context.platform === "linux" ? new GdbusClient() : null;
+  const ambientView = () => {
+    const now = settings.get();
+    return {
+      tray: tray.status(),
+      keepAwake: now.keepAwake,
+      notifications: now.notifications,
+      sounds: now.sounds,
+    };
+  };
+  const tray: TrayController = new TrayController({
+    platform: context.platform,
+    createTray: electron.createTray,
+    buildMenu: electron.buildMenu,
+    hostCheck: async () => (dbus === null ? { ok: true as const } : dbus.statusNotifierHost()),
+    quit: () => electron.app.quit(),
+    ensureMainWindow: () => {
+      const main = windows.mainWindow();
+      if (main === null) windows.openMain();
+      else windows.raise(main, "app-activate");
+    },
+    dock: electron.app.dock,
+    timers,
+    log: line,
+    onChange: () => broadcast("indus:ambient:changed", ambientView()),
+    labels: { show: "Show Indus", quit: "Quit Indus", tooltip: "Indus" },
+  });
+
+  windows.onWindowCreated((win, kind) => {
+    if (!APP_WINDOW_KINDS.has(kind)) return;
+    const id = win.webContents.id;
+    tray.register(win as TrayWindow, { closeToTray: kind === "main" });
+    win.on("focus", () => activeSessions.touch(id));
+    win.on("closed", () => activeSessions.forget(id));
+  });
+
+  // -- keep awake --------------------------------------------------------------------------------
+
+  const keepAwake = new KeepAwake({
+    blocker: electron.powerSaveBlocker,
+    mode: () => settings.get().keepAwake,
+    offered: () => settings.get().keepAwakeOffered,
+    markOffered: () => {
+      settings.update({ keepAwakeOffered: true });
+    },
+    offer: () => {
+      const main = windows.mainWindow();
+      return main !== null && emitTo(main, "indus:keep-awake:offer", {});
+    },
+    log: line,
+  });
+  backend.quitGuard.subscribe(() => keepAwake.setWorking(backend.quitGuard.work().length > 0));
+  keepAwake.reconcile();
+  electron.powerMonitor.on("suspend", () => {
+    let idle = 0;
+    try {
+      idle = electron.powerMonitor.getSystemIdleTime();
+    } catch {
+      idle = 0;
+    }
+    keepAwake.noteSuspend(idle);
+  });
+  electron.powerMonitor.on("resume", () => keepAwake.noteResume());
+
+  // -- notifications and link previews -----------------------------------------------------------
+
+  const notifications = new NotificationCenter({
+    platform: context.platform,
+    appName: "Indus",
+    isSupported: () => electron.notification.isSupported(),
+    create: (options) => electron.notification.create(options),
+    dbus,
+    enabled: () => settings.get().notifications,
+    activate: (senderId, tag, actionId) => {
+      let win = windows.windowOf(senderId) ?? windows.mainWindow();
+      if (win === null) win = windows.openMain();
+      windows.raise(win, "notification-click");
+      emitTo(win, "indus:notification:action", { tag, actionId });
+    },
+    log: line,
+  });
+  registry.handle("indus:notify", (request, { senderId }) => notifications.show(senderId, request));
+
+  const links = new LinkPreviewer({
+    fetch: electron.fetch,
+    createWindow: electron.createLinkWindow,
+    timers,
+    now: Date.now,
+    log: line,
+  });
+  registry.handle("indus:links:preview", ({ url }) => links.preview(url));
+
+  // -- ambient settings --------------------------------------------------------------------------
+
+  registry.handle("indus:ambient:get", () => ambientView());
+  registry.handle("indus:ambient:set", async (patch) => {
+    const update: Parameters<AmbientSettingsStore["update"]>[0] = {};
+    if (patch.minimizeToTray !== undefined) update.minimizeToTray = patch.minimizeToTray;
+    if (patch.keepAwake !== undefined) update.keepAwake = patch.keepAwake;
+    if (patch.notifications !== undefined) update.notifications = patch.notifications;
+    if (patch.sounds !== undefined) update.sounds = patch.sounds;
+    settings.update(update);
+    if (patch.keepAwake !== undefined) keepAwake.reconcile();
+    if (patch.minimizeToTray !== undefined) await tray.setEnabled(patch.minimizeToTray);
+    const view = ambientView();
+    broadcast("indus:ambient:changed", view);
+    return view;
+  });
+
+  // -- start and stop ----------------------------------------------------------------------------
+
+  applyShortcuts();
+  void tray.setEnabled(settings.get().minimizeToTray);
+
+  electron.app.on("before-quit", (event) => {
+    // Only a quit the quit guard let through stops tray hiding (a cancelled one keeps it).
+    if (event.defaultPrevented !== true) tray.beginQuit();
+  });
+  electron.app.on("will-quit", () => {
+    board.dispose();
+    keepAwake.dispose();
+    notifications.dispose();
+    tray.dispose();
+  });
+
+  return {
+    hud,
+    quick,
+    shortcuts: board,
+    tray,
+    keepAwake,
+    notifications,
+    links,
+    activeSessions,
+  };
+}
diff --git a/apps/desktop/electron/ambient/keepAwake.test.ts b/apps/desktop/electron/ambient/keepAwake.test.ts
new file mode 100644
index 0000000..e503cfe
--- /dev/null
+++ b/apps/desktop/electron/ambient/keepAwake.test.ts
@@ -0,0 +1,194 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import { QuitGuard } from "../quitGuard.ts";
+import {
+  blockerWanted,
+  KeepAwake,
+  type PowerSaveBlockerLike,
+  TIMED_SLEEP_IDLE_SECONDS,
+} from "./keepAwake.ts";
+import {
+  AmbientSettingsStore,
+  defaultAmbientSettings,
+  type KeepAwakeMode,
+  sanitizeAmbientSettings,
+} from "./settings.ts";
+
+class FakeBlocker implements PowerSaveBlockerLike {
+  starts = 0;
+  stops = 0;
+  private live = new Set<number>();
+  private next = 1;
+  start(): number {
+    this.starts += 1;
+    const id = this.next++;
+    this.live.add(id);
+    return id;
+  }
+  stop(id: number): void {
+    this.stops += 1;
+    this.live.delete(id);
+  }
+  isStarted(id: number): boolean {
+    return this.live.has(id);
+  }
+  /** The OS dropped it behind our back. */
+  dropAll(): void {
+    this.live.clear();
+  }
+}
+
+function setup(mode: KeepAwakeMode = "while-working") {
+  const blocker = new FakeBlocker();
+  const state = { mode, offered: false, offers: 0, canShow: true };
+  const keepAwake = new KeepAwake({
+    blocker,
+    mode: () => state.mode,
+    offered: () => state.offered,
+    markOffered: () => {
+      state.offered = true;
+    },
+    offer: () => {
+      if (!state.canShow) return false;
+      state.offers += 1;
+      return true;
+    },
+    log: () => {},
+  });
+  return { blocker, state, keepAwake };
+}
+
+describe("keep awake", () => {
+  it("mode table", () => {
+    expect(blockerWanted("never", true)).toBe(false);
+    expect(blockerWanted("while-working", false)).toBe(false);
+    expect(blockerWanted("while-working", true)).toBe(true);
+    expect(blockerWanted("always", false)).toBe(true);
+  });
+
+  it("while working: started once per working period and released at the end", () => {
+    const { blocker, keepAwake } = setup();
+    keepAwake.reconcile();
+    expect(blocker.starts).toBe(0);
+    keepAwake.setWorking(true);
+    keepAwake.setWorking(true);
+    keepAwake.setWorking(true);
+    expect(blocker.starts).toBe(1);
+    expect(keepAwake.active()).toBe(true);
+    keepAwake.setWorking(false);
+    expect(blocker.stops).toBe(1);
+    expect(keepAwake.active()).toBe(false);
+    keepAwake.setWorking(true);
+    expect(blocker.starts).toBe(2);
+  });
+
+  it("follows the quit guard's work picture across windows", () => {
+    const { blocker, keepAwake } = setup();
+    const guard = new QuitGuard();
+    guard.subscribe(() => keepAwake.setWorking(guard.work().length > 0));
+    guard.report(1, [{ id: "s1", label: "" }]);
+    guard.report(2, [{ id: "s1", label: "" }]);
+    guard.report(1, []);
+    expect(blocker.starts).toBe(1);
+    expect(keepAwake.active()).toBe(true);
+    guard.forget(2);
+    expect(keepAwake.active()).toBe(false);
+  });
+
+  it("always / never and a mode change while working", () => {
+    const { blocker, state, keepAwake } = setup("always");
+    keepAwake.reconcile();
+    expect(keepAwake.active()).toBe(true);
+    keepAwake.setWorking(true);
+    state.mode = "while-working";
+    keepAwake.reconcile();
+    expect(blocker.starts).toBe(1); // kept, not restarted
+    state.mode = "never";
+    keepAwake.reconcile();
+    expect(keepAwake.active()).toBe(false);
+  });
+
+  it("a blocker the OS dropped is started again on the next reconcile", () => {
+    const { blocker, keepAwake } = setup("always");
+    keepAwake.reconcile();
+    blocker.dropAll();
+    keepAwake.reconcile();
+    expect(blocker.starts).toBe(2);
+    keepAwake.dispose();
+    expect(keepAwake.active()).toBe(false);
+  });
+
+  it("offers once after a timed sleep interrupted a turn while off", () => {
+    const { state, keepAwake } = setup("never");
+    keepAwake.setWorking(true);
+    keepAwake.noteSuspend(TIMED_SLEEP_IDLE_SECONDS);
+    keepAwake.noteResume();
+    expect(state.offers).toBe(1);
+    expect(state.offered).toBe(true);
+    keepAwake.noteSuspend(600);
+    keepAwake.noteResume();
+    expect(state.offers).toBe(1);
+  });
+
+  it("no offer: short idle (a closed lid), not working, keep awake on", () => {
+    for (const [mode, working, idle] of [
+      ["never", true, TIMED_SLEEP_IDLE_SECONDS - 1],
+      ["never", false, 600],
+      ["while-working", true, 600],
+      ["always", true, 600],
+    ] as const) {
+      const { state, keepAwake } = setup(mode);
+      keepAwake.setWorking(working);
+      keepAwake.noteSuspend(idle);
+      keepAwake.noteResume();
+      expect(state.offers).toBe(0);
+    }
+  });
+
+  it("no window to show it: kept for the next wake", () => {
+    const { state, keepAwake } = setup("never");
+    keepAwake.setWorking(true);
+    keepAwake.noteSuspend(120);
+    state.canShow = false;
+    keepAwake.noteResume();
+    expect(state.offered).toBe(false);
+    state.canShow = true;
+    keepAwake.noteResume();
+    expect(state.offers).toBe(1);
+  });
+});
+
+describe("ambient settings", () => {
+  it("defaults and sanitising", () => {
+    expect(defaultAmbientSettings()).toEqual({
+      minimizeToTray: false,
+      keepAwake: "while-working",
+      keepAwakeOffered: false,
+      notifications: true,
+      sounds: true,
+    });
+    expect(sanitizeAmbientSettings({ keepAwake: "sometimes", minimizeToTray: "yes" })).toEqual(
+      defaultAmbientSettings(),
+    );
+    expect(sanitizeAmbientSettings({ keepAwake: "always", sounds: false })).toMatchObject({
+      keepAwake: "always",
+      sounds: false,
+    });
+  });
+
+  it("persists per device and survives a corrupt file", () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "amb-"));
+    const file = path.join(dir, "ambient.json");
+    const store = new AmbientSettingsStore(file, () => {});
+    store.update({ minimizeToTray: true, keepAwake: "never" });
+    expect(new AmbientSettingsStore(file, () => {}).get()).toMatchObject({
+      minimizeToTray: true,
+      keepAwake: "never",
+    });
+    fs.writeFileSync(file, "garbage");
+    expect(new AmbientSettingsStore(file, () => {}).get()).toEqual(defaultAmbientSettings());
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+});
diff --git a/apps/desktop/electron/ambient/keepAwake.ts b/apps/desktop/electron/ambient/keepAwake.ts
new file mode 100644
index 0000000..5838b93
--- /dev/null
+++ b/apps/desktop/electron/ambient/keepAwake.ts
@@ -0,0 +1,110 @@
+// Keep awake (P20-36). Main owns one power-save blocker (`prevent-app-suspension`: the computer
+// does not go to sleep, the display may still dim). Modes: never, while working (the default) and
+// always. "While working" holds the blocker exactly while some window reports a running turn and
+// lets go when the last one ends — one start per working period.
+//
+// The one-time offer: when the machine went to sleep after at least 55 s without input (a timed
+// sleep, the kind keep awake prevents — a closed lid is not) while a turn ran and keep awake was
+// off, the next wake offers "keep awake while working", once per device.
+
+import type { KeepAwakeMode } from "./settings.ts";
+
+/** A sleep after at least this much idle time is a timed sleep. */
+export const TIMED_SLEEP_IDLE_SECONDS = 55;
+
+export interface PowerSaveBlockerLike {
+  start(type: "prevent-app-suspension" | "prevent-display-sleep"): number;
+  stop(id: number): void;
+  isStarted(id: number): boolean;
+}
+
+export interface KeepAwakeDeps {
+  blocker: PowerSaveBlockerLike;
+  mode(): KeepAwakeMode;
+  offered(): boolean;
+  markOffered(): void;
+  /** Show the offer in a main window; false when none can show it now. */
+  offer(): boolean;
+  log(line: string): void;
+}
+
+export function blockerWanted(mode: KeepAwakeMode, working: boolean): boolean {
+  return mode === "always" || (mode === "while-working" && working);
+}
+
+export class KeepAwake {
+  private readonly deps: KeepAwakeDeps;
+  private id: number | null = null;
+  private working = false;
+  private sleptMidTurn = false;
+
+  constructor(deps: KeepAwakeDeps) {
+    this.deps = deps;
+  }
+
+  /** The blocker is held right now. */
+  active(): boolean {
+    return this.id !== null && this.deps.blocker.isStarted(this.id);
+  }
+
+  /** The windows' merged work picture changed. */
+  setWorking(working: boolean): void {
+    this.working = working;
+    this.reconcile();
+  }
+
+  /** The mode changed (settings) or the app just started. */
+  reconcile(): void {
+    const wanted = blockerWanted(this.deps.mode(), this.working);
+    if (wanted && !this.active()) {
+      try {
+        this.id = this.deps.blocker.start("prevent-app-suspension");
+        this.deps.log("[keep-awake] holding the computer awake");
+      } catch {
+        this.id = null;
+        this.deps.log("[keep-awake] the power-save blocker could not start");
+      }
+    } else if (!wanted && this.id !== null) {
+      const id = this.id;
+      this.id = null;
+      try {
+        if (this.deps.blocker.isStarted(id)) this.deps.blocker.stop(id);
+      } catch {
+        // Already gone.
+      }
+      this.deps.log("[keep-awake] released");
+    }
+  }
+
+  /** The system is about to sleep after `idleSeconds` without input. */
+  noteSuspend(idleSeconds: number): void {
+    this.sleptMidTurn =
+      this.deps.mode() === "never" && this.working && idleSeconds >= TIMED_SLEEP_IDLE_SECONDS;
+  }
+
+  /** The system woke up: make the one-time offer when a timed sleep interrupted a turn. */
+  noteResume(): void {
+    if (this.sleptMidTurn && !this.deps.offered() && this.deps.mode() === "never") {
+      if (this.deps.offer()) {
+        this.deps.markOffered();
+        this.sleptMidTurn = false;
+        this.deps.log("[keep-awake] offered keeping the computer awake while working");
+      }
+      // No window could show it: keep the flag for the next wake.
+      return;
+    }
+    this.sleptMidTurn = false;
+  }
+
+  dispose(): void {
+    this.working = false;
+    if (this.id !== null) {
+      try {
+        if (this.deps.blocker.isStarted(this.id)) this.deps.blocker.stop(this.id);
+      } catch {
+        // Already gone.
+      }
+      this.id = null;
+    }
+  }
+}
