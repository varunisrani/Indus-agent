+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  appBehindRuntime,
+  BUILD_STAMP_FILE,
+  mixedGenerations,
+  readStamp,
+  sanitizeStamp,
+  stampLocations,
+} from "./skew.ts";
+import { compareVersions, isNewer, parseReleaseTag, parseVersion } from "./version.ts";
+
+describe("versions", () => {
+  it("orders stable, canary and source suffixes", () => {
+    expect(compareVersions("1.2.3", "1.2.3")).toBe(0);
+    expect(isNewer("1.2.4", "1.2.3")).toBe(true);
+    expect(isNewer("1.10.0", "1.9.9")).toBe(true);
+    // a canary sorts above the stable before it and below its own stable
+    expect(isNewer("1.2.4-canary.20261001T000000Z", "1.2.3")).toBe(true);
+    expect(isNewer("1.2.4", "1.2.4-canary.20261001T000000Z")).toBe(true);
+    expect(isNewer("1.2.4-canary.20261002T000000Z", "1.2.4-canary.20261001T000000Z")).toBe(true);
+    expect(isNewer("0.1.0", "0.1.0.dev3")).toBe(true);
+    expect(compareVersions("x", "1.0.0")).toBeNull();
+    expect(isNewer("garbage", "1.0.0")).toBe(false);
+    expect(parseVersion("v2.0.1")).toEqual({ major: 2, minor: 0, patch: 1, pre: null });
+  });
+
+  it("release tags: only ours", () => {
+    expect(parseReleaseTag("v1.0.0")?.canary).toBe(false);
+    expect(parseReleaseTag("v1.0.1-canary.20261021T101010Z")?.canary).toBe(true);
+    expect(parseReleaseTag("v1.0.1-nightly.1")).toBeNull();
+    expect(parseReleaseTag("v1.0.1-canary.yesterday")).toBeNull();
+  });
+});
+
+describe("build stamp and generation skew", () => {
+  it("a stamp names its owner; anything else is no stamp", () => {
+    expect(
+      sanitizeStamp({
+        version: "1.0.0",
+        commit: "abc1234",
+        channel: "canary",
+        updateOwner: "manual",
+      }),
+    ).toEqual({ version: "1.0.0", commit: "abc1234", channel: "canary", updateOwner: "manual" });
+    expect(sanitizeStamp({ version: "1.0.0", update_owner: "electron-updater" })).toMatchObject({
+      channel: "stable",
+      commit: null,
+    });
+    expect(sanitizeStamp({ version: "1.0.0", updateOwner: "store" })).toBeNull();
+    expect(sanitizeStamp({ version: "one", updateOwner: "manual" })).toBeNull();
+    expect(sanitizeStamp(null)).toBeNull();
+  });
+
+  it("finds the asar and unpacked copies", () => {
+    expect(stampLocations("/opt/Indus/resources/app.asar")).toEqual({
+      inside: path.join("/opt/Indus/resources/app.asar", BUILD_STAMP_FILE),
+      unpacked: path.join("/opt/Indus/resources/app.asar.unpacked", BUILD_STAMP_FILE),
+    });
+    expect(stampLocations("/src/apps/desktop").unpacked).toBeNull();
+  });
+
+  it("mixed asar/unpacked generations after a broken update → offer reinstall", () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "stamp-"));
+    const app = path.join(dir, "app.asar");
+    fs.mkdirSync(app);
+    fs.mkdirSync(`${app}.unpacked`);
+    const where = stampLocations(app);
+    const write = (file: string, version: string, commit: string) =>
+      fs.writeFileSync(file, JSON.stringify({ version, commit, updateOwner: "electron-updater" }));
+    write(where.inside, "1.1.0", "bbbbbbb");
+    write(where.unpacked as string, "1.0.0", "aaaaaaa");
+    const skew = mixedGenerations(readStamp(where.inside), readStamp(where.unpacked as string));
+    expect(skew?.kind).toBe("mixed-generations");
+    write(where.unpacked as string, "1.1.0", "bbbbbbb");
+    expect(
+      mixedGenerations(readStamp(where.inside), readStamp(where.unpacked as string)),
+    ).toBeNull();
+    expect(mixedGenerations(readStamp(where.inside), null)).toBeNull();
+    fs.rmSync(dir, { recursive: true, force: true });
+  });
+
+  it("an app behind the runtime it attached to → offer the app update", () => {
+    expect(appBehindRuntime("1.0.0", "1.1.0")?.kind).toBe("app-behind-runtime");
+    expect(appBehindRuntime("1.1.0", "1.1.0")).toBeNull();
+    expect(appBehindRuntime("1.1.0", "unknown")).toBeNull();
+  });
+});
diff --git a/apps/desktop/electron/updates/skew.ts b/apps/desktop/electron/updates/skew.ts
new file mode 100644
index 0000000..d7c49ce
--- /dev/null
+++ b/apps/desktop/electron/updates/skew.ts
@@ -0,0 +1,87 @@
+// Build stamp and generation skew (P20-37, R08.14).
+//
+// The build stamp (`desktop-build-stamp.json`, written by P20-38) is the one place that names the
+// update owner, the channel the build came from, its version and commit. Two checks use it:
+//
+// - mixed generations: the copy inside `app.asar` and the one in `app.asar.unpacked` disagree (a
+//   broken or half-applied update replaced one but not the other) → offer reinstall instead of
+//   crashing later on a native module or a lazy chunk from the other generation;
+// - app behind runtime: the runtime the app attached to is newer than the app (a backend update
+//   ran) → offer the app update.
+//
+// The renderer's own check (a lazy chunk that 404s) lives in `src/updates/skew.ts`.
+
+import path from "node:path";
+import { readJsonFile } from "../fsSecure.ts";
+import type { UpdateChannel } from "./feed.ts";
+import { isNewer, parseVersion } from "./version.ts";
+
+export const BUILD_STAMP_FILE = "desktop-build-stamp.json";
+
+export type UpdateOwner = "electron-updater" | "manual";
+
+export interface BuildStamp {
+  version: string;
+  commit: string | null;
+  channel: UpdateChannel;
+  updateOwner: UpdateOwner;
+}
+
+export interface SkewNotice {
+  kind: "mixed-generations" | "app-behind-runtime" | "renderer-stale";
+  detail: string;
+}
+
+/** A usable stamp, or null (missing fields, unknown owner, not a version). */
+export function sanitizeStamp(raw: unknown): BuildStamp | null {
+  if (raw === null || typeof raw !== "object") return null;
+  const record = raw as Record<string, unknown>;
+  const version = typeof record.version === "string" ? record.version.trim() : "";
+  if (parseVersion(version) === null) return null;
+  const owner = record.updateOwner ?? record.update_owner;
+  if (owner !== "electron-updater" && owner !== "manual") return null;
+  const channel = record.channel === "canary" ? "canary" : "stable";
+  const commit =
+    typeof record.commit === "string" && /^[0-9a-f]{7,64}$/i.test(record.commit)
+      ? record.commit
+      : null;
+  return { version, commit, channel, updateOwner: owner };
+}
+
+export function readStamp(file: string): BuildStamp | null {
+  return sanitizeStamp(readJsonFile(file));
+}
+
+/** Where the stamps live for an app path (`…/app.asar` → its `.unpacked` sibling too). */
+export function stampLocations(appPath: string): { inside: string; unpacked: string | null } {
+  const inside = path.join(appPath, BUILD_STAMP_FILE);
+  return {
+    inside,
+    unpacked: appPath.endsWith(".asar") ? path.join(`${appPath}.unpacked`, BUILD_STAMP_FILE) : null,
+  };
+}
+
+/** Both copies exist and name different builds. */
+export function mixedGenerations(
+  inside: BuildStamp | null,
+  unpacked: BuildStamp | null,
+): SkewNotice | null {
+  if (inside === null || unpacked === null) return null;
+  const same =
+    inside.version === unpacked.version &&
+    (inside.commit === null || unpacked.commit === null || inside.commit === unpacked.commit);
+  if (same) return null;
+  return {
+    kind: "mixed-generations",
+    detail: `This app has files from two builds (${inside.version} and ${unpacked.version}). Reinstall or update Indus.`,
+  };
+}
+
+/** The runtime is newer than this (packaged) app. */
+export function appBehindRuntime(appVersion: string, runtimeVersion: string): SkewNotice | null {
+  if (!isNewer(runtimeVersion, appVersion)) return null;
+  return {
+    kind: "app-behind-runtime",
+    detail: `Indus ${runtimeVersion} is running, but this app is ${appVersion}. Update the app to match.`,
+  };
+}
