diff --git a/apps/desktop/src/ambient/turnNotices.test.ts b/apps/desktop/src/ambient/turnNotices.test.ts
new file mode 100644
index 0000000..e79aba2
--- /dev/null
+++ b/apps/desktop/src/ambient/turnNotices.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from "vitest";
+import { translate } from "../i18n/index.tsx";
+import { CHIME_NOTES, playChime } from "./sound.ts";
+import { requestNotice, tagSession, turnNotice, WorkTracker } from "./turnNotices.ts";
+
+describe("work tracker", () => {
+  it("one item per running session; ends only with its own turn", () => {
+    const work = new WorkTracker();
+    expect(work.onEvent({ type: "turn.started", session_id: "s1", turn_id: "t1" })).toBe(true);
+    expect(work.onEvent({ type: "turn.started", session_id: "s1", turn_id: "t2" })).toBe(false);
+    expect(work.onEvent({ type: "turn.done", session_id: "s1", turn_id: "t1" })).toBe(false);
+    expect(work.items()).toEqual([{ id: "s1", label: "" }]);
+    expect(work.onEvent({ type: "turn.done", session_id: "s1", turn_id: "t2" })).toBe(true);
+    expect(work.items()).toEqual([]);
+    expect(work.onEvent({ type: "message.delta", session_id: "s1" })).toBe(false);
+  });
+});
+
+describe("notices", () => {
+  it("a finished turn notifies only while the window is not focused", () => {
+    const done = { type: "turn.done", session_id: "s1", reason: "completed" };
+    expect(turnNotice(done, true, translate)).toBeNull();
+    expect(turnNotice(done, false, translate)).toMatchObject({
+      title: "Reply ready",
+      tag: "turn:s1",
+      actions: [{ id: "open", label: "Open" }],
+    });
+    expect(turnNotice({ ...done, reason: "interrupted_by_user" }, false, translate)).toBeNull();
+    expect(
+      turnNotice(
+        { ...done, reason: "provider_failed", failure: { reason: "rate limited" } },
+        false,
+        translate,
+      ),
+    ).toMatchObject({ title: "Indus stopped", body: "rate limited" });
+  });
+
+  it("a waiting question notifies with its kind", () => {
+    expect(requestNotice("approval", "s2", false, translate)?.body).toBe(
+      "A command is waiting for your approval.",
+    );
+    expect(requestNotice("clarify", "s2", false, translate)?.tag).toBe("ask:s2");
+    expect(requestNotice("clarify", "s2", true, translate)).toBeNull();
+  });
+
+  it("tags lead back to their session", () => {
+    expect(tagSession("turn:abc")).toBe("abc");
+    expect(tagSession("ask:x:y")).toBe("x:y");
+    expect(tagSession("other")).toBeNull();
+    expect(tagSession(null)).toBeNull();
+  });
+});
+
+describe("completion chime", () => {
+  it("is synthesised (no sound file): two notes, quiet", () => {
+    const made: string[] = [];
+    const context = {
+      currentTime: 0,
+      destination: {},
+      createOscillator: () => ({
+        type: "",
+        frequency: { setValueAtTime: (value: number) => made.push(`f${value}`) },
+        connect: () => undefined,
+        start: () => made.push("start"),
+        stop: () => undefined,
+      }),
+      createGain: () => ({
+        gain: {
+          setValueAtTime: () => undefined,
+          linearRampToValueAtTime: (value: number) => made.push(`peak${value}`),
+          exponentialRampToValueAtTime: () => undefined,
+        },
+        connect: () => undefined,
+      }),
+    };
+    expect(playChime(context)).toBe(true);
+    expect(made.filter((m) => m === "start")).toHaveLength(CHIME_NOTES.length);
+    expect(made.filter((m) => m.startsWith("peak")).every((m) => Number(m.slice(4)) <= 0.1)).toBe(
+      true,
+    );
+    expect(playChime(null)).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/ambient/turnNotices.ts b/apps/desktop/src/ambient/turnNotices.ts
new file mode 100644
index 0000000..ea7d0c6
--- /dev/null
+++ b/apps/desktop/src/ambient/turnNotices.ts
@@ -0,0 +1,105 @@
+// What an app window tells main and the person about running work (P20-36):
+//
+// - `WorkTracker` follows `turn.started` / `turn.done` and gives the list of running turns this
+//   window sees; the window reports it (`work.report`) — the quit guard and keep awake read it.
+// - `turnNotice` / `requestNotice` decide the OS notification for a finished turn or a question
+//   waiting for the person, only while the window is not focused. Tags carry the session so a
+//   click can open it (`tagSession`).
+
+import type { MessageKey, Translate } from "../i18n/index.tsx";
+
+export interface WorkItem {
+  id: string;
+  label: string;
+}
+
+interface TurnEvent {
+  type: string;
+  session_id?: string;
+  turn_id?: string;
+}
+
+export class WorkTracker {
+  private readonly running = new Map<string, string>();
+
+  /** Feed an event; true when the running list changed. */
+  onEvent(event: TurnEvent): boolean {
+    const sessionId = event.session_id;
+    if (typeof sessionId !== "string") return false;
+    if (event.type === "turn.started" && typeof event.turn_id === "string") {
+      const had = this.running.get(sessionId);
+      this.running.set(sessionId, event.turn_id);
+      return had === undefined;
+    }
+    if (event.type === "turn.done") {
+      const had = this.running.get(sessionId);
+      if (had === undefined) return false;
+      if (typeof event.turn_id === "string" && event.turn_id !== had) return false;
+      this.running.delete(sessionId);
+      return true;
+    }
+    return false;
+  }
+
+  /** Forget everything (the connection went away for good). */
+  clear(): boolean {
+    const had = this.running.size > 0;
+    this.running.clear();
+    return had;
+  }
+
+  items(): WorkItem[] {
+    // No title is known here; the quit guard shows "Untitled chat" for an empty label.
+    return [...this.running.keys()].map((id) => ({ id, label: "" }));
+  }
+}
+
+export interface NoticeRequest {
+  title: string;
+  body: string;
+  tag: string;
+  actions: Array<{ id: string; label: string }>;
+}
+
+export function tagSession(tag: string | null): string | null {
+  if (tag === null) return null;
+  const match = /^(?:turn|ask):(.+)$/.exec(tag);
+  return match === null ? null : (match[1] ?? null);
+}
+
+interface DoneEvent {
+  type: string;
+  session_id?: string;
+  reason?: string;
+  failure?: { reason?: string } | null;
+}
+
+/** The notification for a finished turn, or null (still running, stopped by the person, focused). */
+export function turnNotice(event: DoneEvent, focused: boolean, t: Translate): NoticeRequest | null {
+  if (focused || event.type !== "turn.done" || typeof event.session_id !== "string") return null;
+  if (event.reason === "interrupted_by_user") return null;
+  const actions = [{ id: "open", label: t("notify.open") }];
+  const tag = `turn:${event.session_id}`;
+  if (event.reason === "completed" && (event.failure ?? null) === null) {
+    return { title: t("notify.turnDone.title"), body: t("notify.turnDone.body"), tag, actions };
+  }
+  const reason = (event.failure?.reason ?? "").trim() || (event.reason ?? "").replace(/_/g, " ");
+  return { title: t("notify.turnFailed.title"), body: reason, tag, actions };
+}
+
+/** The notification for a question the backend asks (approval, clarify, sudo, secret). */
+export function requestNotice(
+  kind: string,
+  sessionId: string,
+  focused: boolean,
+  t: Translate,
+): NoticeRequest | null {
+  if (focused) return null;
+  const body: MessageKey = kind === "approval" ? "notify.ask.approval" : "notify.ask.other";
+  return {
+    title: t("notify.ask.title"),
+    body: t(body),
+    tag: `ask:${sessionId}`,
+    actions: [{ id: "open", label: t("notify.open") }],
+  };
+}
