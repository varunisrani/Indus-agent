+      engine.calls.push("stop-app-work");
+    },
+    channelFile: path.join(dir, "updates.json"),
+    emit: (status) => events.push(status),
+    timers: new FakeTimers(),
+    now: () => 1234,
+    log: () => {},
+  });
+  return { updater, engine, events, order, gateState, feedCalls, dir };
