--- /dev/null
+++ b/apps/desktop/electron/updates/feed.ts
@@ -0,0 +1,163 @@
+// The release lookup behind "check for updates" (P20-37). It asks the releases API (GitHub's
+// shape: `[{ tag_name, draft, prerelease, html_url }]`) for the newest release of a channel:
+// stable takes the newest `vX.Y.Z`; canary the newest of `vX.Y.Z-canary.<stamp>` and `vX.Y.Z`
+// (a canary user is never stranded below a newer stable). Drafts and other tags are ignored.
+//
+// Token: the environment (`INDUS_DESKTOP_UPDATE_TOKEN`, then the vendor names `GH_TOKEN`,
+// `GITHUB_TOKEN`), else the GitHub CLI's login (`gh auth token`), else none. A token the API
+// rejects (401) is logged once by its source — never its value — and the lookup runs again
+// without it. A token is only sent over https (or to a loopback test feed), and only to the
+// configured API.
+
+import { execFile } from "node:child_process";
+import type { Timers } from "../ambient/hud.ts";
+import { compareVersions, parseReleaseTag, plainVersion } from "./version.ts";
+
+export const DEFAULT_RELEASES_API = "https://api.github.com/repos/varunisrani/indus-agent/releases";
+export const FEED_TIMEOUT_MS = 15_000;
+export const GH_CLI_TIMEOUT_MS = 3_000;
+export const TOKEN_ENV_NAMES = ["INDUS_DESKTOP_UPDATE_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"] as const;
+
+export type UpdateChannel = "stable" | "canary";
+export type TokenSource = (typeof TOKEN_ENV_NAMES)[number] | "gh-cli";
+
+export interface ReleaseInfo {
+  version: string;
+  tag: string;
+  url: string | null;
+  canary: boolean;
+}
+
+export class FeedError extends Error {}
+
+/** The newest release of `channel` among the API's answer, or null. */
+export function pickRelease(releases: unknown, channel: UpdateChannel): ReleaseInfo | null {
+  if (!Array.isArray(releases)) throw new FeedError("the releases feed answered something else");
+  let best: ReleaseInfo | null = null;
+  for (const entry of releases) {
+    if (entry === null || typeof entry !== "object") continue;
+    const record = entry as Record<string, unknown>;
+    if (record.draft === true || typeof record.tag_name !== "string") continue;
+    const parsed = parseReleaseTag(record.tag_name);
+    if (parsed === null) continue;
+    if (parsed.canary && channel === "stable") continue;
+    const info: ReleaseInfo = {
+      version: plainVersion(record.tag_name),
+      tag: record.tag_name,
+      url:
+        typeof record.html_url === "string" && /^https:\/\//.test(record.html_url)
+          ? record.html_url
+          : null,
+      canary: parsed.canary,
+    };
+    if (best === null || (compareVersions(info.version, best.version) ?? 0) > 0) best = info;
+  }
+  return best;
+}
+
+/** May a token go to `apiUrl`? https anywhere, plain http only to a loopback test feed. */
+export function tokenAllowed(apiUrl: string): boolean {
+  try {
+    const url = new URL(apiUrl);
+    if (url.protocol === "https:") return true;
+    return url.protocol === "http:" && ["127.0.0.1", "localhost", "[::1]"].includes(url.hostname);
+  } catch {
+    return false;
+  }
+}
+
+/** `gh auth token` through the CLI (no shell, bounded), or null. */
+export function ghCliToken(timeoutMs: number = GH_CLI_TIMEOUT_MS): Promise<string | null> {
+  return new Promise((resolve) => {
+    try {
+      execFile(
+        "gh",
+        ["auth", "token"],
+        { timeout: timeoutMs, windowsHide: true, encoding: "utf8" },
+        (error, stdout) => {
+          const token = error === null ? String(stdout).trim() : "";
+          resolve(token === "" || /\s/.test(token) ? null : token);
+        },
+      );
+    } catch {
+      resolve(null);
+    }
+  });
+}
+
+type FetchLike = (
+  url: string,
+  init: { headers: Record<string, string>; signal: AbortSignal },
+) => Promise<Response>;
+
+export interface ReleaseFeedDeps {
+  apiUrl: string;
+  env: Readonly<Record<string, string | undefined>>;
+  /** The GitHub CLI's token (or null); called at most once per process. */
+  cliToken(): Promise<string | null>;
+  fetch: FetchLike;
+  timers: Timers;
+  log(line: string): void;
+}
+
+export class ReleaseFeed {
+  private readonly deps: ReleaseFeedDeps;
+  private readonly rejected = new Set<TokenSource>();
+  private cli: Promise<string | null> | null = null;
+
+  constructor(deps: ReleaseFeedDeps) {
+    this.deps = deps;
+  }
+
+  /** The newest release of `channel`, or null when the feed lists none. */
+  async latest(channel: UpdateChannel): Promise<ReleaseInfo | null> {
+    const credential = tokenAllowed(this.deps.apiUrl) ? await this.token() : null;
+    let response = await this.get(credential?.token ?? null);
+    if (credential !== null && response.status === 401) {
+      this.rejected.add(credential.source);
+      this.deps.log(
+        `[updates] the token from ${credential.source} was rejected; checking without it`,
+      );
+      await response.body?.cancel().catch(() => {});
+      response = await this.get(null);
+    }
+    if (!response.ok) {
+      await response.body?.cancel().catch(() => {});
+      throw new FeedError(`the releases feed answered ${response.status}`);
+    }
+    let body: unknown;
+    try {
+      body = await response.json();
+    } catch {
+      throw new FeedError("the releases feed answered something that is not JSON");
+    }
+    return pickRelease(body, channel);
+  }
+
+  private async token(): Promise<{ token: string; source: TokenSource } | null> {
+    for (const name of TOKEN_ENV_NAMES) {
+      const value = (this.deps.env[name] ?? "").trim();
+      if (value !== "" && !this.rejected.has(name)) return { token: value, source: name };
+    }
+    if (this.rejected.has("gh-cli")) return null;
+    if (this.cli === null) this.cli = this.deps.cliToken().catch(() => null);
+    const token = await this.cli;
+    return token === null ? null : { token, source: "gh-cli" };
+  }
+
+  private async get(token: string | null): Promise<Response> {
+    const url = new URL(this.deps.apiUrl);
+    if (!url.searchParams.has("per_page")) url.searchParams.set("per_page", "30");
+    const headers: Record<string, string> = { accept: "application/vnd.github+json" };
+    if (token !== null) headers.authorization = `Bearer ${token}`;
+    const controller = new AbortController();
+    const timer = this.deps.timers.setTimeout(() => controller.abort(), FEED_TIMEOUT_MS);
+    try {
+      return await this.deps.fetch(url.toString(), { headers, signal: controller.signal });
+    } catch {
+      throw new FeedError("the releases feed could not be reached");
+    } finally {
+      this.deps.timers.clearTimeout(timer);
+    }
+  }
+}
diff --git a/apps/desktop/electron/updates/install.ts b/apps/desktop/electron/updates/install.ts
new file mode 100644
index 0000000..705f81a
--- /dev/null
+++ b/apps/desktop/electron/updates/install.ts
@@ -0,0 +1,166 @@
+// Main's update side (P20-37), in two steps because the boot needs the gate before the backend
+// is installed and the updater needs the backend's installer:
+//
+//   const updateGate = createUpdateGate(context);                    // before installBackend
+//   installBackend(context, { ..., updateGate: gateHooks(updateGate) });
+//   installUpdates(context, electron, { gate: updateGate, stopAppWork }); // after it
+//
+// Background checks run only in a packaged build or against an explicit feed
+// (`INDUS_DESKTOP_UPDATE_FEED`), and never with `INDUS_DESKTOP_NO_UPDATE_CHECK=1`.
+
+import path from "node:path";
+import type { MainContext } from "../context.ts";
+import type { EventChannel } from "../ipc/channels.ts";
+import type { EventTarget } from "../ipc/registry.ts";
+import type { PayloadOf } from "../ipc/schemas.ts";
+import { ElectronUpdaterEngine, loadElectronUpdater, type UpdateEngine } from "./engine.ts";
+import { DEFAULT_RELEASES_API, ghCliToken, ReleaseFeed } from "./feed.ts";
+import { nodeProcessFacts, UpdateGate } from "./marker.ts";
+import {
+  appBehindRuntime,
+  mixedGenerations,
+  readStamp,
+  type SkewNotice,
+  stampLocations,
+} from "./skew.ts";
+import { Updater } from "./updater.ts";
+
+const timers = {
+  setTimeout: (fn: () => void, ms: number) => setTimeout(fn, ms),
+  clearTimeout: (handle: unknown) => clearTimeout(handle as ReturnType<typeof setTimeout>),
+};
+
+export function createUpdateGate(context: MainContext): UpdateGate {
+  const gate = new UpdateGate({
+    home: context.paths.home,
+    facts: nodeProcessFacts(context.platform),
+    timers,
+    now: Date.now,
+    log: (line) => context.log.write(line),
+  });
+  gate.watch();
+  return gate;
+}
+
+/** The two hooks P20-12's boot orchestrator takes (`waitForUpdate`, `updateRunning`). */
+export function gateHooks(gate: UpdateGate): {
+  waitForUpdate(): Promise<void>;
+  updateRunning(): boolean;
+} {
+  return {
+    waitForUpdate: async () => {
+      await gate.waitUntilClear();
+    },
+    updateRunning: () => gate.isRunning(),
+  };
+}
+
+export interface UpdatesElectron {
+  app: { getAppPath(): string; on(event: "will-quit", listener: () => void): unknown };
+  fetch: typeof fetch;
+  /** The runtime version the app is attached to now (the daemon's `code_version`), or null. */
+  runtimeVersion(): string | null;
+}
+
+export interface UpdatesHandle {
+  gate: UpdateGate;
+  updater: Updater;
+}
+
+export function installUpdates(
+  context: MainContext,
+  electron: UpdatesElectron,
+  deps: { gate: UpdateGate; stopAppWork(): Promise<void> },
+): UpdatesHandle {
+  const { registry, windows, paths, log } = context;
+  const line = (text: string) => log.write(text);
+  const broadcast = <N extends EventChannel>(name: N, payload: PayloadOf<N>) => {
+    for (const win of windows.windows())
+      registry.emit(win.webContents as EventTarget, name, payload);
+  };
+
+  const locations = stampLocations(electron.app.getAppPath());
+  const stamp = readStamp(locations.inside);
+  const skews: SkewNotice[] = [];
+  const mixed = mixedGenerations(
+    stamp,
+    locations.unpacked === null ? null : readStamp(locations.unpacked),
+  );
+  if (mixed !== null) {
+    skews.push(mixed);
+    line("[updates] this app holds files from two builds; offering a reinstall");
+  }
+
+  const feedUrl = (process.env.INDUS_DESKTOP_UPDATE_FEED ?? "").trim();
+  const feed = new ReleaseFeed({
+    apiUrl: feedUrl === "" ? DEFAULT_RELEASES_API : feedUrl,
+    env: process.env,
+    cliToken: () => ghCliToken(),
+    fetch: (url, init) => electron.fetch(url, init),
+    timers,
+    log: line,
+  });
+
+  let engine: UpdateEngine | null = null;
+  const updater = new Updater({
+    stamp,
+    appVersion: context.appVersion,
+    packaged: context.packaged,
+    platform: context.platform,
+    env: process.env,
+    feed,
+    engine: async () => {
+      if (engine === null) engine = new ElectronUpdaterEngine(await loadElectronUpdater(), timers);
+      return engine;
+    },
+    gate: {
+      setInFlight: (on) => deps.gate.setInFlight(on),
+      inFlightNow: () => deps.gate.inFlightNow(),
+      liveMarker: async () => (await deps.gate.refresh()).state === "live",
+    },
+    stopAppWork: deps.stopAppWork,
+    channelFile: path.join(paths.userData, "updates.json"),
+    emit: (status) => broadcast("indus:updates:progress", status),
+    timers,
+    now: Date.now,
+    log: line,
+  });
+
+  registry.handle("indus:updates:status", () => updater.status());
+  registry.handle("indus:updates:check", () => updater.check());
+  registry.handle("indus:updates:apply", async () => ({
+    accepted: (await updater.apply()).accepted,
+  }));
+  registry.handle("indus:updates:set-channel", ({ channel }) => updater.setChannel(channel));
+
+  // A window that loads (or reloads) hears every skew main knows about.
+  windows.onWindowCreated((win) => {
+    win.webContents.on("did-finish-load", () => {
+      for (const skew of skews)
+        registry.emit(win.webContents as EventTarget, "indus:updates:skew", skew);
+    });
+  });
+
+  // A runtime update just finished: is the app now behind it?
+  deps.gate.onCleared(() => {
+    const runtime = electron.runtimeVersion();
+    if (context.packaged && runtime !== null) {
+      const behind = appBehindRuntime(context.appVersion, runtime);
+      if (behind !== null && !skews.some((s) => s.kind === behind.kind)) {
+        skews.push(behind);
+        broadcast("indus:updates:skew", behind);
+      }
+    }
+    void updater.check();
+  });
+
+  const backgroundAllowed =
+    process.env.INDUS_DESKTOP_NO_UPDATE_CHECK !== "1" && (context.packaged || feedUrl !== "");
+  if (backgroundAllowed) updater.startBackgroundChecks();
+  electron.app.on("will-quit", () => {
+    updater.stop();
+    deps.gate.stop();
+  });
+
+  return { gate: deps.gate, updater };
+}
diff --git a/apps/desktop/electron/updates/marker.test.ts b/apps/desktop/electron/updates/marker.test.ts
new file mode 100644
index 0000000..f6311ab
--- /dev/null
+++ b/apps/desktop/electron/updates/marker.test.ts
@@ -0,0 +1,223 @@
+import { type ChildProcess, spawn } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import {
+  EMPTY_MARKER_GRACE_MS,
+  GATE_POLL_MS,
+  IN_FLIGHT_WAIT_MAX_MS,
+  inspectMarker,
+  judgeMarker,
+  linuxStartSeconds,
+  markerPath,
+  nodeProcessFacts,
+  type ProcessFacts,
+  parseLstartUtc,
+  UNVERIFIED_MARKER_CEILING_MS,
+  UpdateGate,
+} from "./marker.ts";
+
+const NOW_S = 1_800_000_000;
+const NOW_MS = NOW_S * 1000;
+
+function facts(
+  table: Record<number, { start: number | null; zombie?: boolean }>,
+  self = 1,
+): ProcessFacts {
+  return {
+    selfPid: self,
+    alive: (pid) => pid in table,
+    zombie: (pid) => table[pid]?.zombie === true,
+    startTime: async (pid) => table[pid]?.start ?? null,
+  };
+}
+
+const body = (pid: number, start: number | null, created = NOW_S - 10) =>
+  JSON.stringify({
+    format: 1,
+    owner: "indus-update",
+    pid,
+    process_start: start,
+    created_at: created,
+  });
+
+describe("marker judgement", () => {
+  it("absent, live, ours, stale", async () => {
+    const f = facts({ 50: { start: NOW_S - 100 }, 1: { start: NOW_S - 999 } });
+    expect(await judgeMarker(null, 0, NOW_MS, f)).toEqual({ state: "absent" });
+    expect(await judgeMarker(body(50, NOW_S - 99), 1000, NOW_MS, f)).toMatchObject({
+      state: "live",
+      pid: 50,
+      owner: "indus-update",
+    });
+    expect(await judgeMarker(body(1, NOW_S - 999), 1000, NOW_MS, f)).toEqual({
+      state: "ours",
+      pid: 1,
+    });
+    // pid reused by another process: its start time differs by more than 2 s
+    expect(await judgeMarker(body(50, NOW_S - 500), 1000, NOW_MS, f)).toMatchObject({
+      state: "stale",
+      reason: "its process id now belongs to another process",
+    });
+    expect(await judgeMarker(body(77, NOW_S - 5), 1000, NOW_MS, f)).toMatchObject({
+      state: "stale",
+      reason: "its process has ended",
+    });
+  });
+
+  it("a zombie owner is not live", async () => {
+    const f = facts({ 60: { start: NOW_S - 5, zombie: true } });
+    expect((await judgeMarker(body(60, NOW_S - 5), 1000, NOW_MS, f)).state).toBe("stale");
+  });
+
+  it("no comparable start time: live only for 20 minutes from creation", async () => {
+    const f = facts({ 70: { start: null } });
+    expect((await judgeMarker(body(70, null, NOW_S - 60), 0, NOW_MS, f)).state).toBe("live");
+    const old = NOW_S - UNVERIFIED_MARKER_CEILING_MS / 1000 - 1;
+    expect((await judgeMarker(body(70, null, old), 0, NOW_MS, f)).state).toBe("stale");
+    // The writer recorded a start time but this machine cannot read one: same ceiling.
+    expect((await judgeMarker(body(70, NOW_S - 30, NOW_S - 60), 0, NOW_MS, f)).state).toBe("live");
+  });
+
+  it("an empty marker is a claim being written for 5 s; garbage is stale", async () => {
+    const f = facts({});
+    expect((await judgeMarker("", EMPTY_MARKER_GRACE_MS - 1, NOW_MS, f)).state).toBe("live");
+    expect((await judgeMarker("", EMPTY_MARKER_GRACE_MS, NOW_MS, f)).state).toBe("stale");
+    expect((await judgeMarker("{not json", 0, NOW_MS, f)).state).toBe("stale");
+    expect((await judgeMarker('{"pid": -1, "created_at": 1}', 0, NOW_MS, f)).state).toBe("stale");
+  });
+
+  it("start-time readers", () => {
+    expect(parseLstartUtc("Mon Oct 21 03:45:00 2026")).toBe(Date.UTC(2026, 9, 21, 3, 45, 0) / 1000);
+    expect(parseLstartUtc("garbage")).toBeNull();
+    const stat = `123 (my (odd) name) S ${Array.from({ length: 18 }, (_, i) => i).join(" ")} 5000 rest`;
+    expect(linuxStartSeconds(stat, "cpu 1\nbtime 1700000000\n", 100)).toBe(1_700_000_050);
+  });
+});
+
+describe("marker on disk", () => {
+  let home: string;
+  const children: ChildProcess[] = [];
+
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "marker-"));
+  });
+
+  afterEach(() => {
+    for (const child of children.splice(0)) if (child.exitCode === null) child.kill("SIGKILL");
+    fs.rmSync(home, { recursive: true, force: true });
+  });
+
+  it("is only read: a stale marker is left byte for byte", async () => {
+    const text = body(999_999_7, NOW_S - 5);
+    fs.writeFileSync(markerPath(home), text);
+    const judged = await inspectMarker(home, facts({}), NOW_MS);
+    expect(judged.state).toBe("stale");
+    expect(fs.readFileSync(markerPath(home), "utf8")).toBe(text);
+  });
+
+  it.runIf(process.platform === "linux")(
+    "real processes: a live owner is live, the same pid with another start time is stale",
+    async () => {
+      const child = spawn(process.execPath, ["-e", "setTimeout(() => {}, 30000)"], {
+        stdio: "ignore",
+      });
+      children.push(child);
+      const pid = child.pid as number;
+      const real = nodeProcessFacts("linux");
+      const start = (await real.startTime(pid)) as number;
+      expect(typeof start).toBe("number");
+      expect(Math.abs(start - Date.now() / 1000)).toBeLessThan(60);
+
+      fs.writeFileSync(markerPath(home), body(pid, start, Date.now() / 1000));
+      expect((await inspectMarker(home, real)).state).toBe("live");
+      fs.writeFileSync(markerPath(home), body(pid, start - 3600, Date.now() / 1000));
+      expect((await inspectMarker(home, real)).state).toBe("stale");
+      fs.writeFileSync(
+        markerPath(home),
+        body(process.pid, (await real.startTime(process.pid)) as number),
+      );
+      expect((await inspectMarker(home, real)).state).toBe("ours");
+    },
+  );
+});
+
+describe("update gate", () => {
+  let home: string;
+  let timers: FakeTimers;
+  let table: Record<number, { start: number | null }>;
+  let gate: UpdateGate;
+
+  beforeEach(() => {
+    home = fs.mkdtempSync(path.join(os.tmpdir(), "gate-"));
+    timers = new FakeTimers();
+    timers.now = NOW_MS;
+    table = { 42: { start: NOW_S - 50 } };
+    gate = new UpdateGate({
+      home,
+      facts: facts(table),
+      timers,
+      now: () => timers.now,
+      log: () => {},
+    });
+  });
+
+  afterEach(() => fs.rmSync(home, { recursive: true, force: true }));
+
+  async function tick(ms: number): Promise<void> {
+    for (let i = 0; i < 10; i += 1) await Promise.resolve();
+    timers.advance(ms);
+    for (let i = 0; i < 10; i += 1) await Promise.resolve();
+  }
+
+  it("clear at once when nothing holds the runtime", async () => {
+    expect(await gate.waitUntilClear()).toBe("clear");
+    expect(gate.isRunning()).toBe(false);
+  });
+
+  it("a live owner holds backend starts until its marker goes; the clear is announced", async () => {
+    fs.writeFileSync(markerPath(home), body(42, NOW_S - 50));
+    let cleared = 0;
+    gate.onCleared(() => {
+      cleared += 1;
+    });
+    let outcome: string | null = null;
+    const waits: string[] = [];
+    void gate
+      .waitUntilClear((reason) => waits.push(reason))
+      .then((value) => {
+        outcome = value;
+      });
+    // Far beyond any in-process ceiling: a live marker has no deadline.
+    for (let i = 0; i < 5; i += 1) await tick(IN_FLIGHT_WAIT_MAX_MS);
+    expect(outcome).toBeNull();
+    expect(gate.isRunning()).toBe(true);
+    fs.rmSync(markerPath(home));
+    await tick(GATE_POLL_MS);
+    expect(outcome).toBe("finished");
+    expect(cleared).toBe(1);
+    expect(waits.length).toBeGreaterThan(0);
+  });
+
+  it("a stale marker (pid reused) does not hold anything and stays on disk", async () => {
+    const text = body(42, NOW_S - 9000);
+    fs.writeFileSync(markerPath(home), text);
+    expect(await gate.waitUntilClear()).toBe("clear");
+    expect(fs.readFileSync(markerPath(home), "utf8")).toBe(text);
+  });
+
+  it("the in-process flag holds starts too, at most 20 minutes", async () => {
+    gate.setInFlight(true);
+    expect(gate.isRunning()).toBe(true);
+    let outcome: string | null = null;
+    void gate.waitUntilClear().then((value) => {
+      outcome = value;
+    });
+    await tick(GATE_POLL_MS);
+    expect(outcome).toBeNull();
+    for (let i = 0; i <= IN_FLIGHT_WAIT_MAX_MS / GATE_POLL_MS; i += 1) await tick(GATE_POLL_MS);
+    expect(outcome).toBe("timeout");
+  });
+});
diff --git a/apps/desktop/electron/updates/marker.ts b/apps/desktop/electron/updates/marker.ts
new file mode 100644
index 0000000..12a62e8
--- /dev/null
+++ b/apps/desktop/electron/updates/marker.ts
@@ -0,0 +1,357 @@
+// The shared update marker and the update gate (P20-37, R08.13).
+//
+// `<home>/.indus-update-in-progress` says "an update owns the runtime right now". Whoever runs the
+// update (`indus update`, P23) creates it with its pid and that process's start time and removes it
+// when done. This app only ever reads it:
+//
+//   - live:  the pid runs, is not a zombie, and started when the marker says (± 2 s) — or, when no
+//            comparable start time exists, the marker is younger than 20 minutes; an empty file
+//            younger than 5 s is a claim being written;
+//   - stale: anything else (dead pid, zombie, a pid the OS gave to another process, garbage).
+//
+// A stale marker is ignored and left exactly as it is: never deleted, never rewritten (another
+// tool reclaims it under its own lock). While a marker is live the app starts no backend from the
+// runtime under replacement and starts no update of its own. The gate also honours an in-process
+// flag, because an apply stops things before any marker would say so.
+
+import { execFile } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import type { Timers } from "../ambient/hud.ts";
+
+export const MARKER_FILE = ".indus-update-in-progress";
+export const MARKER_FORMAT = 1;
+export const START_TIME_TOLERANCE_S = 2;
+export const EMPTY_MARKER_GRACE_MS = 5_000;
+export const UNVERIFIED_MARKER_CEILING_MS = 20 * 60_000;
+export const GATE_POLL_MS = 1_000;
+/** The in-process flag is waited out at most this long (a live marker has no deadline). */
+export const IN_FLIGHT_WAIT_MAX_MS = 20 * 60_000;
+/** Background refresh of the cached judgement (the boot's synchronous question). */
+export const GATE_WATCH_MS = 10_000;
+
+export interface MarkerBody {
+  format: number;
+  owner: string;
+  pid: number;
+  /** Unix seconds when `pid` started, or null when the writer could not tell. */
+  processStart: number | null;
+  /** Unix seconds when the marker was written. */
+  createdAt: number;
+}
+
+export type MarkerJudgement =
+  | { state: "absent" }
+  | { state: "live"; owner: string; pid: number; reason: string }
+  | { state: "ours"; pid: number }
+  | { state: "stale"; reason: string };
+
+/** What the judge needs to know about processes (fakes in tests). */
+export interface ProcessFacts {
+  selfPid: number;
+  alive(pid: number): boolean;
+  /** True for a zombie (exited, not reaped): it answers signal 0 like a live one. */
+  zombie(pid: number): boolean;
+  /** Unix seconds when `pid` started, or null when it cannot be read. */
+  startTime(pid: number): Promise<number | null>;
+}
+
+export function markerPath(home: string): string {
+  return path.join(home, MARKER_FILE);
+}
+
+/** The marker's body, or null when it is not one. */
+export function parseMarker(text: string): MarkerBody | null {
+  let raw: unknown;
+  try {
+    raw = JSON.parse(text);
+  } catch {
+    return null;
+  }
+  if (raw === null || typeof raw !== "object") return null;
+  const record = raw as Record<string, unknown>;
+  const pid = record.pid;
+  const created = record.created_at;
+  if (typeof pid !== "number" || !Number.isInteger(pid) || pid <= 0) return null;
+  if (typeof created !== "number" || !Number.isFinite(created)) return null;
+  const start = record.process_start;
+  return {
+    format: typeof record.format === "number" ? record.format : 0,
+    owner: typeof record.owner === "string" ? record.owner.slice(0, 64) : "unknown",
+    pid,
+    processStart: typeof start === "number" && Number.isFinite(start) ? start : null,
+    createdAt: created,
+  };
+}
+
+/**
+ * Judge a marker's text. `text` null: no file. `ageMs`: how old the file is (its mtime), used only
+ * for an empty claim being written.
+ */
+export async function judgeMarker(
+  text: string | null,
+  ageMs: number,
+  nowMs: number,
+  facts: ProcessFacts,
+): Promise<MarkerJudgement> {
+  if (text === null) return { state: "absent" };
+  if (text.trim() === "") {
+    return ageMs < EMPTY_MARKER_GRACE_MS
+      ? { state: "live", owner: "unknown", pid: 0, reason: "a claim is being written" }
+      : { state: "stale", reason: "an empty marker" };
+  }
+  const body = parseMarker(text);
+  if (body === null) return { state: "stale", reason: "not a marker this app can read" };
+  if (!facts.alive(body.pid)) return { state: "stale", reason: "its process has ended" };
+  if (facts.zombie(body.pid)) return { state: "stale", reason: "its process has exited" };
+  const started = body.processStart === null ? null : await facts.startTime(body.pid);
+  if (body.processStart !== null && started !== null) {
+    if (Math.abs(started - body.processStart) > START_TIME_TOLERANCE_S) {
+      return { state: "stale", reason: "its process id now belongs to another process" };
+    }
+    if (body.pid === facts.selfPid) return { state: "ours", pid: body.pid };
+    return { state: "live", owner: body.owner, pid: body.pid, reason: "its process is running" };
+  }
+  // No comparable start time: trust the claim only for a bounded time.
+  if (nowMs - body.createdAt * 1000 < UNVERIFIED_MARKER_CEILING_MS) {
+    return {
+      state: "live",
+      owner: body.owner,
+      pid: body.pid,
+      reason: "its process is running (start time not verifiable)",
+    };
+  }
+  return { state: "stale", reason: "older than 20 minutes and not verifiable" };
+}
+
+/** Read the marker (never writes, never follows a symlink) and judge it. */
+export async function inspectMarker(
+  home: string,
+  facts: ProcessFacts,
+  nowMs: number = Date.now(),
+): Promise<MarkerJudgement> {
+  const file = markerPath(home);
+  let info: fs.Stats;
+  try {
+    info = fs.lstatSync(file);
+  } catch {
+    return { state: "absent" };
+  }
+  if (!info.isFile()) return { state: "stale", reason: "not a regular file" };
+  let text: string;
+  try {
+    text = fs.readFileSync(file, "utf8");
+  } catch {
+    return { state: "stale", reason: "unreadable" };
+  }
+  return judgeMarker(text, Math.max(0, nowMs - info.mtimeMs), nowMs, facts);
+}
+
+// -- process facts on this machine ---------------------------------------------------------------
+
+function run(file: string, args: string[], env?: NodeJS.ProcessEnv): Promise<string | null> {
+  return new Promise((resolve) => {
+    try {
+      execFile(
+        file,
+        args,
+        {
+          timeout: 2_000,
+          windowsHide: true,
+          encoding: "utf8",
+          ...(env === undefined ? {} : { env }),
+        },
+        (error, stdout) => resolve(error === null ? String(stdout) : null),
+      );
+    } catch {
+      resolve(null);
+    }
+  });
+}
+
+const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
+
+/** `ps -o lstart=` printed in UTC (`Mon Oct 21 03:45:00 2026`) → unix seconds. */
+export function parseLstartUtc(text: string): number | null {
+  const match = /^\s*\w{3}\s+(\w{3})\s+(\d{1,2})\s+(\d{2}):(\d{2}):(\d{2})\s+(\d{4})\s*$/.exec(
+    text,
+  );
+  if (match === null) return null;
+  const month = MONTHS.indexOf((match[1] ?? "").toLowerCase());
+  if (month < 0) return null;
+  const ms = Date.UTC(
+    Number(match[6]),
+    month,
+    Number(match[2]),
+    Number(match[3]),
+    Number(match[4]),
+    Number(match[5]),
+  );
+  return Number.isFinite(ms) ? ms / 1000 : null;
+}
+
+/** Linux `/proc/<pid>/stat` start ticks + boot time → unix seconds. */
+export function linuxStartSeconds(
+  stat: string,
+  procStat: string,
+  ticksPerSecond: number,
+): number | null {
+  const fields = stat.slice(stat.lastIndexOf(")") + 2).split(" ");
+  const ticks = Number(fields[19]);
+  const btime = Number(/^btime\s+(\d+)/m.exec(procStat)?.[1]);
+  if (!Number.isFinite(ticks) || !Number.isFinite(btime)) return null;
+  return btime + ticks / ticksPerSecond;
+}
+
+export function nodeProcessFacts(platform: string = process.platform): ProcessFacts {
+  let ticks: number | null = null;
+  const linuxState = (pid: number): string | null => {
+    try {
+      const stat = fs.readFileSync(`/proc/${pid}/stat`, "utf8");
+      return stat.slice(stat.lastIndexOf(")") + 2, stat.lastIndexOf(")") + 3) || null;
+    } catch {
+      return null;
+    }
+  };
+  return {
+    selfPid: process.pid,
+    alive: (pid) => {
+      try {
+        process.kill(pid, 0);
+        return true;
+      } catch (error) {
+        return (error as NodeJS.ErrnoException)?.code === "EPERM";
+      }
+    },
+    zombie: (pid) => platform === "linux" && linuxState(pid) === "Z",
+    startTime: async (pid) => {
+      if (platform === "linux") {
+        if (ticks === null) ticks = Number((await run("getconf", ["CLK_TCK"]))?.trim()) || 100;
+        try {
+          return linuxStartSeconds(
+            fs.readFileSync(`/proc/${pid}/stat`, "utf8"),
+            fs.readFileSync("/proc/stat", "utf8"),
+            ticks,
+          );
+        } catch {
+          return null;
+        }
+      }
+      if (platform === "darwin") {
+        const out = await run("ps", ["-o", "lstart=", "-p", String(pid)], {
+          ...process.env,
+          TZ: "UTC",
+          LC_ALL: "C",
+        });
+        return out === null ? null : parseLstartUtc(out);
+      }
+      return null; // Windows: no cheap reader; the 20-minute ceiling applies
+    },
+  };
+}
+
+// -- the gate ------------------------------------------------------------------------------------
+
+export interface UpdateGateDeps {
+  home: string;
+  facts: ProcessFacts;
+  timers: Timers;
+  now(): number;
+  log(line: string): void;
+}
+
+export type ClearOutcome = "clear" | "finished" | "timeout";
+
+export class UpdateGate {
+  private readonly deps: UpdateGateDeps;
+  private inFlight = false;
+  private lastLive = false;
+  private readonly clearedListeners = new Set<() => void>();
+  private watchTimer: unknown = null;
+  private watching = false;
+  private readonly loggedStale = new Set<string>();
+
+  constructor(deps: UpdateGateDeps) {
+    this.deps = deps;
+  }
+
+  /** This process is inside an update apply. */
+  setInFlight(on: boolean): void {
+    this.inFlight = on;
+  }
+
+  inFlightNow(): boolean {
+    return this.inFlight;
+  }
+
+  /** Synchronous answer (the cached marker judgement + the in-process flag). */
+  isRunning(): boolean {
+    return this.inFlight || this.lastLive;
+  }
+
+  /** Judge the marker now; note a live → gone transition (a backend update finished). */
+  async refresh(): Promise<MarkerJudgement> {
+    const judgement = await inspectMarker(this.deps.home, this.deps.facts, this.deps.now());
+    const live = judgement.state === "live";
+    if (judgement.state === "stale" && !this.loggedStale.has(judgement.reason)) {
+      this.loggedStale.add(judgement.reason);
+      this.deps.log(
+        `[updates] ignoring a stale update marker (${judgement.reason}); left as it is`,
+      );
+    }
+    if (this.lastLive && !live) {
+      this.lastLive = false;
+      for (const listener of this.clearedListeners) listener();
+    }
+    this.lastLive = live;
+    return judgement;
+  }
+
+  /** A live marker went away (a runtime update ended). */
+  onCleared(listener: () => void): () => void {
+    this.clearedListeners.add(listener);
+    return () => {
+      this.clearedListeners.delete(listener);
+    };
+  }
+
+  /**
+   * Wait until no update owns the runtime. A live marker is waited out with no deadline (its
+   * owner's liveness decides); the in-process flag at most 20 minutes.
+   */
+  async waitUntilClear(onWait?: (reason: string) => void): Promise<ClearOutcome> {
+    let judgement = await this.refresh();
+    if (judgement.state !== "live" && !this.inFlight) return "clear";
+    const started = this.deps.now();
+    for (;;) {
+      if (judgement.state === "live") onWait?.(judgement.reason);
+      else if (this.inFlight) {
+        if (this.deps.now() - started >= IN_FLIGHT_WAIT_MAX_MS) return "timeout";
+        onWait?.("an update in this app is running");
+      } else {
+        return "finished";
+      }
+      await new Promise<void>((resolve) => this.deps.timers.setTimeout(resolve, GATE_POLL_MS));
+      judgement = await this.refresh();
+    }
+  }
+
+  /** Keep the cached judgement fresh (and notice transitions) in the background. */
+  watch(): void {
+    if (this.watching) return;
+    this.watching = true;
+    const tick = () => {
+      this.watchTimer = null;
+      void this.refresh().finally(() => {
+        if (this.watching) this.watchTimer = this.deps.timers.setTimeout(tick, GATE_WATCH_MS);
+      });
+    };
+    tick();
+  }
+
+  stop(): void {
+    this.watching = false;
+    if (this.watchTimer !== null) this.deps.timers.clearTimeout(this.watchTimer);
+    this.watchTimer = null;
+  }
+}
