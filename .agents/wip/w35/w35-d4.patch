+import { beforeEach, describe, expect, it } from "vitest";
+import { FakeScreen, FakeWindow } from "../../testing/fakeFloating.ts";
+import { FakeTimers } from "../../testing/fakeTimers.ts";
+import { ActiveSessions } from "./activeSession.ts";
+import {
+  QUICK_RELAY_TIMEOUT_MS,
+  QuickEntryController,
+  type QuickTarget,
+  quickBounds,
+} from "./quickEntry.ts";
+
+describe("quick entry bounds", () => {
+  it("centred a quarter down the pointer's display, inside it", () => {
+    expect(quickBounds({ x: 0, y: 0, width: 1920, height: 1080 })).toEqual({
+      x: 650,
+      y: 270,
+      width: 620,
+      height: 150,
+    });
+    expect(quickBounds({ x: 1920, y: 0, width: 500, height: 100 })).toEqual({
+      x: 1920,
+      y: 0,
+      width: 500,
+      height: 100,
+    });
+  });
+});
+
+describe("quick entry controller", () => {
+  let timers: FakeTimers;
+  let screen: FakeScreen;
+  let created: FakeWindow[];
+  let app: FakeWindow;
+  let target: QuickTarget | null;
+  let delivered: Array<{ requestId: string; text: string; sessionId: string | null }>;
+  let deliverOk: boolean;
+  let raised: FakeWindow[];
+  let shown: number;
+  let logs: string[];
+  let quick: QuickEntryController;
+  let ids: number;
+
+  beforeEach(() => {
+    timers = new FakeTimers();
+    screen = new FakeScreen([
+      { workArea: { x: 0, y: 0, width: 1920, height: 1080 } },
+      { workArea: { x: 1920, y: 0, width: 1280, height: 1024 } },
+    ]);
+    created = [];
+    app = new FakeWindow();
+    target = { contentsId: app.webContents.id, sessionId: "s-last", window: app };
+    delivered = [];
+    deliverOk = true;
+    raised = [];
+    shown = 0;
+    logs = [];
+    ids = 0;
+    quick = new QuickEntryController({
+      create: (bounds) => {
+        const win = new FakeWindow(bounds);
+        created.push(win);
+        return win;
+      },
+      screen,
+      target: () => target,
+      deliver: (_target, payload) => {
+        delivered.push(payload);
+        return deliverOk;
+      },
+      shown: () => {
+        shown += 1;
+      },
+      raise: (win) => raised.push(win as FakeWindow),
+      timers,
+      newId: () => `r${++ids}`,
+      log: (line) => logs.push(line),
+    });
+  });
+
+  function openQuick(): FakeWindow {
+    quick.show();
+    const win = created.at(-1) as FakeWindow;
+    win.show(); // the manager reveals it on paint
+    return win;
+  }
+
+  it("toggles; the window takes focus when shown; blur hides it", () => {
+    const win = openQuick();
+    expect(win.focused).toBe(1);
+    quick.toggle();
+    expect(win.visible).toBe(false);
+    screen.cursor = { x: 2500, y: 500 };
+    quick.toggle();
+    expect(created).toHaveLength(1);
+    expect(win.visible).toBe(true);
+    expect(win.getBounds().x).toBeGreaterThanOrEqual(1920); // moved to the pointer's display
+    expect(shown).toBe(1);
+    win.emit("blur");
+    expect(win.visible).toBe(false);
+  });
+
+  it("delivers to the last-active window and answers when it acknowledges", async () => {
+    const win = openQuick();
+    const result = quick.submit(win.webContents.id, "  hello  ");
+    expect(delivered).toEqual([{ requestId: "r1", text: "hello", sessionId: "s-last" }]);
+    quick.ack(app.webContents.id, { requestId: "r1", ok: true, sessionId: "s-last" });
+    await expect(result).resolves.toEqual({ ok: true, sessionId: "s-last" });
+    expect(win.visible).toBe(false);
+    expect(raised).toEqual([app]);
+  });
+
+  it("refuses other senders, empty text, and a second send while one is waiting", async () => {
+    const win = openQuick();
+    await expect(quick.submit(app.webContents.id, "x")).resolves.toMatchObject({
+      ok: false,
+      code: "failed",
+    });
+    await expect(quick.submit(win.webContents.id, "   ")).resolves.toMatchObject({
+      ok: false,
+      code: "empty",
+    });
+    void quick.submit(win.webContents.id, "one");
+    await expect(quick.submit(win.webContents.id, "two")).resolves.toMatchObject({
+      ok: false,
+      code: "busy",
+    });
+    expect(delivered).toHaveLength(1);
+  });
+
+  it("no app window → no-target, and the composer keeps its text (still visible)", async () => {
+    target = null;
+    const win = openQuick();
+    await expect(quick.submit(win.webContents.id, "hi")).resolves.toMatchObject({
+      ok: false,
+      code: "no-target",
+    });
+    expect(win.visible).toBe(true);
+    target = { contentsId: app.webContents.id, sessionId: null, window: app };
+    deliverOk = false;
+    await expect(quick.submit(win.webContents.id, "hi")).resolves.toMatchObject({
+      code: "no-target",
+    });
+  });
+
+  it("no answer in 15 s → unconfirmed (never failed); a late answer is only logged", async () => {
+    const win = openQuick();
+    const result = quick.submit(win.webContents.id, "slow");
+    timers.advance(QUICK_RELAY_TIMEOUT_MS);
+    await expect(result).resolves.toMatchObject({ ok: false, code: "unconfirmed" });
+    quick.ack(app.webContents.id, { requestId: "r1", ok: true });
+    expect(logs.join("\n")).toMatch(/late answer/);
+    expect(raised).toEqual([]);
+    expect(win.visible).toBe(true);
+  });
+
+  it("an answer from a window that was not asked is ignored; a failure keeps the text", async () => {
+    const win = openQuick();
+    const result = quick.submit(win.webContents.id, "x");
+    quick.ack(win.webContents.id, { requestId: "r1", ok: true });
+    quick.ack(app.webContents.id, { requestId: "r1", ok: false, error: "refused" });
+    await expect(result).resolves.toEqual({ ok: false, code: "failed", message: "refused" });
+    expect(win.visible).toBe(true);
+  });
+
+  it("close (feature off) closes the window", () => {
+    const win = openQuick();
+    quick.close();
+    expect(win.destroyed).toBe(true);
+    expect(quick.isQuick(win.webContents.id)).toBe(false);
+  });
+});
+
+describe("last-active session", () => {
+  it("the newest report from a live window wins; focus moves a window to the front", () => {
+    const active = new ActiveSessions();
+    const live = new Set([1, 2, 3]);
+    active.report(1, "a");
+    active.report(2, "b");
+    expect(active.latest((id) => live.has(id))).toMatchObject({ contentsId: 2, sessionId: "b" });
+    active.touch(1);
+    expect(active.latest((id) => live.has(id))).toMatchObject({ contentsId: 1, sessionId: "a" });
+    active.touch(3);
+    expect(active.latest((id) => live.has(id))).toMatchObject({ contentsId: 3, sessionId: null });
+    live.delete(3);
+    expect(active.latest((id) => live.has(id))?.contentsId).toBe(1);
+    active.forget(1);
+    expect(active.latest((id) => live.has(id))?.contentsId).toBe(2);
+    expect(new ActiveSessions().latest(() => true)).toBeNull();
+  });
+});
diff --git a/apps/desktop/electron/ambient/quickEntry.ts b/apps/desktop/electron/ambient/quickEntry.ts
new file mode 100644
index 0000000..80d288b
--- /dev/null
+++ b/apps/desktop/electron/ambient/quickEntry.ts
@@ -0,0 +1,249 @@
+// Quick entry (P20-35): a global chord toggles a small composer that floats over every app. It has
+// no backend connection of its own. Its text goes to main, main hands it to the app window the
+// person used last, that window submits it into its last-active session through the normal send
+// path and answers. Main owns the waiting: the composer keeps its text until the answer, and an
+// answer that does not come within 15 s is "not confirmed yet" (the prompt may still land), never
+// a failure to retry.
+
+import type { BrowserWindowLike } from "../windows/manager.ts";
+import type { Rect } from "../windows/windowState.ts";
+import { type FloatingWindow, floatAbove, type ScreenLike, type Timers } from "./hud.ts";
+
+export const QUICK_SIZE = { width: 620, height: 150 } as const;
+/** How far down the display the composer sits (fraction of the work area's height). */
+export const QUICK_TOP_FRACTION = 0.25;
+export const QUICK_RELAY_TIMEOUT_MS = 15_000;
+/** Answers we waited for but gave up on, kept so a late one is recognised (and logged). */
+const LATE_MEMORY = 32;
+
+export type QuickResult =
+  | { ok: true; sessionId: string | null }
+  | {
+      ok: false;
+      code: "empty" | "no-target" | "unconfirmed" | "failed" | "busy";
+      message: string;
+    };
+
+export interface QuickTarget {
+  /** The receiving app window's web contents id. */
+  contentsId: number;
+  /** Its last-active session (null: a new chat). */
+  sessionId: string | null;
+  window: BrowserWindowLike;
+}
+
+export interface QuickEntryDeps {
+  /** `windows.openQuick`. */
+  create(bounds: Rect): FloatingWindow;
+  screen: ScreenLike;
+  /** The app window used last, or null when there is none. */
+  target(): QuickTarget | null;
+  /** Send `indus:quick:deliver` to the target; false when it could not be sent. */
+  deliver(
+    target: QuickTarget,
+    payload: { requestId: string; text: string; sessionId: string | null },
+  ): boolean;
+  /** Tell a re-summoned composer to clear and refocus (`indus:quick:shown`). */
+  shown(win: FloatingWindow): void;
+  /** Bring the receiving window forward after a delivery (a user action). */
+  raise(win: BrowserWindowLike): void;
+  timers: Timers;
+  newId(): string;
+  log(line: string): void;
+  platform?: string;
+}
+
+/** Where the composer opens on a work area: centred, a quarter down, inside the area. */
+export function quickBounds(area: Rect): Rect {
+  const width = Math.min(QUICK_SIZE.width, area.width);
+  const height = Math.min(QUICK_SIZE.height, area.height);
+  const y = Math.round(area.y + area.height * QUICK_TOP_FRACTION);
+  return {
+    width,
+    height,
+    x: Math.round(area.x + (area.width - width) / 2),
+    y: Math.min(Math.max(y, area.y), area.y + area.height - height),
+  };
+}
+
+interface Pending {
+  resolve(result: QuickResult): void;
+  timer: unknown;
+  contentsId: number;
+  window: BrowserWindowLike;
+}
+
+export class QuickEntryController {
+  private readonly deps: QuickEntryDeps;
+  private win: FloatingWindow | null = null;
+  private readonly pending = new Map<string, Pending>();
+  private readonly late: string[] = [];
+
+  constructor(deps: QuickEntryDeps) {
+    this.deps = deps;
+  }
+
+  isQuick(contentsId: number): boolean {
+    return this.live()?.webContents.id === contentsId;
+  }
+
+  isVisible(): boolean {
+    return this.live()?.isVisible() === true;
+  }
+
+  /** The chord: put it away when it is up, else show it on the pointer's display. */
+  toggle(): void {
+    if (this.isVisible()) this.hide();
+    else this.show();
+  }
+
+  show(): void {
+    const bounds = this.boundsHere();
+    const existing = this.live();
+    if (existing === null) {
+      const win = this.deps.create(bounds);
+      this.win = win;
+      floatAbove(win, this.deps.platform ?? process.platform);
+      // The manager shows it on its first paint; the person summoned it, so it takes the keys.
+      win.on("show", () => {
+        if (!win.isDestroyed()) win.focus();
+      });
+      // Losing focus is the quietest way out (it never holds the keyboard captive).
+      win.on("blur", () => {
+        if (!win.isDestroyed() && win.isVisible()) win.hide();
+      });
+      win.on("closed", () => {
+        if (this.win === win) this.win = null;
+      });
+      return;
+    }
+    try {
+      existing.setBounds(bounds);
+    } catch {
+      this.deps.log("[quick] could not move the composer to this display");
+    }
+    existing.show();
+    existing.focus();
+    this.deps.shown(existing);
+  }
+
+  hide(): void {
+    const win = this.live();
+    if (win?.isVisible()) win.hide();
+  }
+
+  /** Turning the feature off closes the window. */
+  close(): void {
+    const win = this.live();
+    this.win = null;
+    if (win !== null) win.close();
+  }
+
+  /** `indus:quick:submit` from the composer. */
+  submit(senderId: number, rawText: string): Promise<QuickResult> {
+    if (!this.isQuick(senderId)) {
+      return Promise.resolve({
+        ok: false,
+        code: "failed",
+        message: "Only the quick entry window can send from here.",
+      });
+    }
+    const text = rawText.trim();
+    if (text === "") {
+      return Promise.resolve({ ok: false, code: "empty", message: "Type a message first." });
+    }
+    if (this.pending.size > 0) {
+      return Promise.resolve({
+        ok: false,
+        code: "busy",
+        message: "The previous message is still on its way.",
+      });
+    }
+    const target = this.deps.target();
+    if (target === null || target.window.isDestroyed()) {
+      return Promise.resolve({
+        ok: false,
+        code: "no-target",
+        message: "Open an Indus window first; your text is kept.",
+      });
+    }
+    const requestId = this.deps.newId();
+    return new Promise<QuickResult>((resolve) => {
+      const timer = this.deps.timers.setTimeout(() => {
+        if (!this.pending.delete(requestId)) return;
+        this.remember(requestId);
+        resolve({
+          ok: false,
+          code: "unconfirmed",
+          message:
+            "Indus has not confirmed the message yet. It may still arrive; check the chat before sending it again.",
+        });
+      }, QUICK_RELAY_TIMEOUT_MS);
+      this.pending.set(requestId, {
+        resolve,
+        timer,
+        contentsId: target.contentsId,
+        window: target.window,
+      });
+      const sent = this.deps.deliver(target, { requestId, text, sessionId: target.sessionId });
+      if (!sent) {
+        this.pending.delete(requestId);
+        this.deps.timers.clearTimeout(timer);
+        resolve({
+          ok: false,
+          code: "no-target",
+          message: "Open an Indus window first; your text is kept.",
+        });
+      }
+    });
+  }
+
+  /** `indus:quick:ack` from the receiving window. */
+  ack(
+    senderId: number,
+    answer: {
+      requestId: string;
+      ok: boolean;
+      sessionId?: string | null | undefined;
+      error?: string | undefined;
+    },
+  ): void {
+    const pending = this.pending.get(answer.requestId);
+    if (pending === undefined) {
+      if (this.late.includes(answer.requestId)) {
+        this.deps.log(
+          `[quick] a late answer arrived (${answer.ok ? "delivered" : "not delivered"})`,
+        );
+      }
+      return;
+    }
+    if (pending.contentsId !== senderId) return; // only the window we asked may answer
+    this.pending.delete(answer.requestId);
+    this.deps.timers.clearTimeout(pending.timer);
+    if (answer.ok) {
+      pending.resolve({ ok: true, sessionId: answer.sessionId ?? null });
+      this.hide();
+      if (!pending.window.isDestroyed()) this.deps.raise(pending.window);
+    } else {
+      pending.resolve({
+        ok: false,
+        code: "failed",
+        message: (answer.error ?? "").trim() || "Indus could not send that message.",
+      });
+    }
+  }
+
+  private remember(requestId: string): void {
+    this.late.push(requestId);
+    if (this.late.length > LATE_MEMORY) this.late.shift();
+  }
+
+  private boundsHere(): Rect {
+    const pointer = this.deps.screen.getCursorScreenPoint();
+    return quickBounds(this.deps.screen.getDisplayNearestPoint(pointer).workArea);
+  }
+
+  private live(): FloatingWindow | null {
+    return this.win !== null && !this.win.isDestroyed() ? this.win : null;
+  }
+}
