+// @vitest-environment jsdom
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { I18nProvider } from "../i18n/index.tsx";
+import { UpdateNotice } from "../updates/UpdateNotice.tsx";
+import { QuickEntry } from "./QuickEntry.tsx";
+
+type Result = { ok: true; sessionId: string | null } | { ok: false; code: string; message: string };
+
+function install(answers: Result[]) {
+  const bridge = {
+    quick: {
+      submit: vi.fn(async () => answers.shift() as Result),
+      dismiss: vi.fn(),
+      onShown: () => () => undefined,
+    },
+    updates: { check: vi.fn(async () => ({})), apply: vi.fn(async () => ({ accepted: true })) },
+    external: { open: vi.fn(async () => ({ ok: true })) },
+  };
+  (globalThis as { indusDesktop?: unknown }).indusDesktop = bridge;
+  return bridge;
+}
+
+afterEach(() => {
+  delete (globalThis as { indusDesktop?: unknown }).indusDesktop;
+});
+
+function renderQuick() {
+  render(
+    <I18nProvider>
+      <QuickEntry />
+    </I18nProvider>,
+  );
+  return screen.getByRole("textbox") as HTMLTextAreaElement;
+}
+
+describe("quick entry window", () => {
+  it("Enter sends; a delivered message clears the box; the window is transparent", async () => {
+    const bridge = install([{ ok: true, sessionId: "s1" }]);
+    const box = renderQuick();
+    expect(document.documentElement.dataset.window).toBe("quick");
+    fireEvent.change(box, { target: { value: "hello" } });
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(bridge.quick.submit).toHaveBeenCalledWith({ text: "hello" });
+    expect(box.value).toBe("");
+  });
+
+  it("not confirmed yet: the text stays and the message says not to resend blindly", async () => {
+    install([{ ok: false, code: "unconfirmed", message: "x" }]);
+    const box = renderQuick();
+    fireEvent.change(box, { target: { value: "keep me" } });
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(box.value).toBe("keep me");
+    expect(screen.getByRole("alert").textContent).toMatch(/not confirmed/);
+  });
+
+  it("Shift+Enter is a new line; Esc dismisses; an empty box is not sent", async () => {
+    const bridge = install([]);
+    const box = renderQuick();
+    fireEvent.keyDown(box, { key: "Enter", shiftKey: true });
+    await act(async () => {
+      fireEvent.keyDown(box, { key: "Enter" });
+    });
+    expect(bridge.quick.submit).not.toHaveBeenCalled();
+    expect(screen.getByRole("alert").textContent).toMatch(/Type a message/);
+    fireEvent.keyDown(box, { key: "Escape" });
+    expect(bridge.quick.dismiss).toHaveBeenCalled();
+  });
+});
+
+describe("update notice", () => {
+  const status = (state: string, extra: Record<string, unknown> = {}) =>
+    ({
+      owner: "electron-updater",
+      channel: "stable",
+      state,
+      currentVersion: "1.0.0",
+      ...extra,
+    }) as never;
+
+  it("a stale renderer (lazy chunk 404) offers a reload instead of crashing", () => {
+    install([]);
+    render(
+      <I18nProvider>
+        <UpdateNotice
+          status={null}
+          skew={{ kind: "renderer-stale", detail: "" }}
+          onDismissSkew={() => {}}
+        />
+      </I18nProvider>,
+    );
+    expect(screen.getByRole("alert").textContent).toMatch(/could not load/);
+    expect(screen.getByRole("button", { name: "Reload window" })).toBeTruthy();
+  });
+
+  it("an available update applies on the person's click; the manual owner opens the page", () => {
+    const bridge = install([]);
+    const { rerender } = render(
+      <I18nProvider>
+        <UpdateNotice
+          status={status("available", { version: "1.1.0" })}
+          skew={null}
+          onDismissSkew={() => {}}
+        />
+      </I18nProvider>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "Update and restart" }));
+    expect(bridge.updates.apply).toHaveBeenCalled();
+    rerender(
+      <I18nProvider>
+        <UpdateNotice
+          status={status("manual", {
+            owner: "manual",
+            version: "1.1.0",
+            downloadUrl: "https://example.invalid/r",
+          })}
+          skew={null}
+          onDismissSkew={() => {}}
+        />
+      </I18nProvider>,
+    );
+    expect(screen.queryByRole("button", { name: "Update and restart" })).toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Open download page" }));
+    expect(bridge.external.open).toHaveBeenCalledWith({ url: "https://example.invalid/r" });
+    fireEvent.click(screen.getByRole("button", { name: "Later" }));
+    expect(screen.queryByRole("status")).toBeNull();
+  });
+});
diff --git a/apps/desktop/src/quick/QuickEntry.tsx b/apps/desktop/src/quick/QuickEntry.tsx
new file mode 100644
index 0000000..69b5312
--- /dev/null
+++ b/apps/desktop/src/quick/QuickEntry.tsx
@@ -0,0 +1,95 @@
+// The quick-entry window (P20-35): a one-box composer over every app. It has no connection: the
+// text goes to main, which hands it to the app window used last and answers with the outcome. The
+// text stays until delivery is confirmed; "not confirmed yet" never invites a blind resend.
+
+import "../ambient/ambient.css";
+import { type KeyboardEvent, useEffect, useRef, useState } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+
+const ERROR_TEXT: Readonly<Record<string, MessageKey>> = {
+  empty: "quick.error.empty",
+  "no-target": "quick.error.noTarget",
+  unconfirmed: "quick.error.unconfirmed",
+  failed: "quick.error.failed",
+  busy: "quick.error.busy",
+};
+
+export function QuickEntry() {
+  const t = useT();
+  const bridge = desktopBridge();
+  const [text, setText] = useState("");
+  const [sending, setSending] = useState(false);
+  const [problem, setProblem] = useState<MessageKey | null>(null);
+  const box = useRef<HTMLTextAreaElement>(null);
+
+  useEffect(() => {
+    document.documentElement.dataset.window = "quick";
+    box.current?.focus();
+    if (bridge === null) return;
+    return bridge.quick.onShown(() => {
+      setProblem(null);
+      box.current?.focus();
+      box.current?.select();
+    });
+  }, [bridge]);
+
+  const send = async () => {
+    if (bridge === null || sending) return;
+    if (text.trim() === "") {
+      setProblem("quick.error.empty");
+      return;
+    }
+    setSending(true);
+    setProblem(null);
+    try {
+      const result = await bridge.quick.submit({ text });
+      if (result.ok) setText("");
+      else setProblem(ERROR_TEXT[result.code] ?? "quick.error.failed");
+    } catch {
+      setProblem("quick.error.failed");
+    } finally {
+      setSending(false);
+    }
+  };
+
+  const onKeyDown = (event: KeyboardEvent<HTMLTextAreaElement>) => {
+    if (event.key === "Escape") {
+      event.preventDefault();
+      bridge?.quick.dismiss();
+    } else if (event.key === "Enter" && !event.shiftKey && !event.nativeEvent.isComposing) {
+      event.preventDefault();
+      void send();
+    }
+  };
+
+  return (
+    <main className="quick" aria-label={t("quick.label")}>
+      <textarea
+        ref={box}
+        value={text}
+        rows={2}
+        placeholder={t("quick.placeholder")}
+        aria-label={t("quick.label")}
+        onChange={(event) => setText(event.target.value)}
+        onKeyDown={onKeyDown}
+      />
+      {problem !== null && (
+        <p className="quick-error" role="alert">
+          {t(problem)}
+        </p>
+      )}
+      <div className="quick-footer">
+        <span className="quick-hint">{sending ? t("quick.sending") : t("quick.hint")}</span>
+        <button
+          type="button"
+          className="button button-primary"
+          disabled={sending}
+          onClick={() => void send()}
+        >
+          {t("quick.send")}
+        </button>
+      </div>
+    </main>
+  );
+}
diff --git a/apps/desktop/src/quick/deliver.test.ts b/apps/desktop/src/quick/deliver.test.ts
new file mode 100644
index 0000000..d9c3ce9
--- /dev/null
+++ b/apps/desktop/src/quick/deliver.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, it } from "vitest";
+import type { ChatActions, SendOutcome } from "../chat/busyActions.ts";
+import type { LocalRows } from "../chat/localEcho.ts";
+import type { ChatConnection } from "../gateway/connectionStore.ts";
+import { type DeliverDeps, deliverQuickText } from "./deliver.ts";
+
+function actions(sessionId: string, outcome: SendOutcome, sent: string[]): ChatActions {
+  return {
+    sessionId,
+    send: async (text: string) => {
+      sent.push(`${sessionId}:${text}`);
+      return outcome;
+    },
+    snapshot: () => ({ turnId: outcome === "started" ? "t1" : null }),
+  } as unknown as ChatActions;
+}
+
+function deps(outcome: SendOutcome, created: string | Error = "s-new") {
+  const sent: string[] = [];
+  const calls: Array<[string, unknown]> = [];
+  const rows: string[] = [];
+  const opened: string[] = [];
+  const connection = {
+    request: async (method: string, params: unknown) => {
+      calls.push([method, params]);
+      if (created instanceof Error) throw created;
+      return { session_id: created };
+    },
+  } as unknown as ChatConnection;
+  const localRows: LocalRows = {
+    addLocalUser: (sessionId, text) => {
+      rows.push(`add ${sessionId} ${text}`);
+      return "local-1";
+    },
+    bindLocalUser: (sessionId) => rows.push(`bind ${sessionId}`),
+    dropLocalUser: (sessionId) => rows.push(`drop ${sessionId}`),
+  };
+  const d: DeliverDeps = {
+    connection,
+    rows: localRows,
+    actionsFor: (id) => actions(id, outcome, sent),
+    newKey: () => "key-1",
+    onSessionCreated: (id) => opened.push(id),
+  };
+  return { d, sent, calls, rows, opened };
+}
+
+describe("quick-entry delivery", () => {
+  it("submits into the reported session through the composer's send path (optimistic row)", async () => {
+    const { d, sent, calls, rows } = deps("started");
+    const result = await deliverQuickText(d, {
+      requestId: "r1",
+      text: " hi ",
+      sessionId: "s-last",
+    });
+    expect(result).toEqual({ ok: true, sessionId: "s-last" });
+    expect(sent).toEqual(["s-last:hi"]);
+    expect(calls).toEqual([]);
+    expect(rows).toEqual(["add s-last hi", "bind s-last"]);
+  });
+
+  it("no session → a new chat first, which the window then shows", async () => {
+    const { d, sent, calls, opened } = deps("queued");
+    const result = await deliverQuickText(d, { requestId: "r1", text: "go", sessionId: null });
+    expect(result).toEqual({ ok: true, sessionId: "s-new" });
+    expect(calls).toEqual([["session.create", { idempotency_key: "key-1" }]]);
+    expect(sent).toEqual(["s-new:go"]);
+    expect(opened).toEqual(["s-new"]);
+  });
+
+  it("refused, blocked or unconfirmed sends answer not ok (the quick window keeps the text)", async () => {
+    for (const outcome of ["rejected", "blocked", "uncertain"] as const) {
+      const { d } = deps(outcome);
+      const result = await deliverQuickText(d, { requestId: "r", text: "x", sessionId: "s" });
+      expect(result.ok).toBe(false);
+    }
+    const failing = deps("started", new Error("daemon unreachable"));
+    expect(
+      await deliverQuickText(failing.d, { requestId: "r", text: "x", sessionId: null }),
+    ).toEqual({ ok: false, sessionId: null, error: "daemon unreachable" });
+    const empty = deps("started");
+    expect(
+      (await deliverQuickText(empty.d, { requestId: "r", text: "  ", sessionId: "s" })).ok,
+    ).toBe(false);
+    expect(empty.sent).toEqual([]);
+  });
+});
diff --git a/apps/desktop/src/quick/deliver.ts b/apps/desktop/src/quick/deliver.ts
new file mode 100644
index 0000000..5c91693
--- /dev/null
+++ b/apps/desktop/src/quick/deliver.ts
@@ -0,0 +1,73 @@
+// The receiving end of quick entry (P20-35): main hands an app window `{ requestId, text,
+// sessionId }`; the window submits the text into that session (a new chat when null) through the
+// same send path the composer uses — the session's shared `ChatActions` and the optimistic row —
+// and answers main with the outcome.
+
+import type { ChatActions, SendOutcome } from "../chat/busyActions.ts";
+import { type LocalRows, sendShown } from "../chat/localEcho.ts";
+import type { ChatConnection } from "../gateway/connectionStore.ts";
+
+export interface QuickDelivery {
+  requestId: string;
+  text: string;
+  sessionId: string | null;
+}
+
+export type DeliveryResult =
+  | { ok: true; sessionId: string }
+  | { ok: false; sessionId: string | null; error: string };
+
+export interface DeliverDeps {
+  connection: ChatConnection;
+  rows: LocalRows | null;
+  /** The session's one `ChatActions` (shared with its composer). */
+  actionsFor(sessionId: string): ChatActions;
+  newKey(): string;
+  /** A new chat was made for the text (the window may show it). */
+  onSessionCreated?(sessionId: string): void;
+}
+
+const ACCEPTED: ReadonlySet<SendOutcome> = new Set(["started", "queued", "steered"]);
+
+const PROBLEM: Readonly<Partial<Record<SendOutcome, string>>> = {
+  uncertain: "the message was sent but Indus has not confirmed it yet",
+  rejected: "Indus refused the message",
+  blocked: "the chat is waiting on a lost turn; open it to decide what to do",
+  empty: "the message was empty",
+};
+
+export async function deliverQuickText(
+  deps: DeliverDeps,
+  delivery: QuickDelivery,
+): Promise<DeliveryResult> {
+  const text = delivery.text.trim();
+  if (text === "") return { ok: false, sessionId: delivery.sessionId, error: PROBLEM.empty ?? "" };
+  let sessionId = delivery.sessionId;
+  if (sessionId === null) {
+    try {
+      const created = await deps.connection.request("session.create", {
+        idempotency_key: deps.newKey(),
+      });
+      sessionId = created.session_id;
+      deps.onSessionCreated?.(sessionId);
+    } catch (error) {
+      return {
+        ok: false,
+        sessionId: null,
+        error: error instanceof Error ? error.message : "a new chat could not be started",
+      };
+    }
+  }
+  let outcome: SendOutcome;
+  try {
+    outcome = await sendShown(deps.actionsFor(sessionId), deps.rows, text, text);
+  } catch (error) {
+    return {
+      ok: false,
+      sessionId,
+      error: error instanceof Error ? error.message : "the message could not be sent",
+    };
+  }
+  if (ACCEPTED.has(outcome)) return { ok: true, sessionId };
+  return { ok: false, sessionId, error: PROBLEM[outcome] ?? "the message could not be sent" };
+}
diff --git a/apps/desktop/src/updates/UpdateNotice.tsx b/apps/desktop/src/updates/UpdateNotice.tsx
new file mode 100644
index 0000000..43adeae
--- /dev/null
+++ b/apps/desktop/src/updates/UpdateNotice.tsx
@@ -0,0 +1,139 @@
+// The update and skew notices of an app window (P20-37). An update the person can apply shows
+// "Update and restart"; the manual owner shows the command or a download page (opened through the
+// audited external opener on this click); a skew (two builds mixed, app behind its runtime, a lazy
+// chunk gone) offers reload / update instead of a crash. Settings › About (P20-32) owns the full
+// controls; this is the passive surface.
+
+import { useState } from "react";
+import { desktopBridge } from "../app/bridge.ts";
+import type { IndusUpdateSkew, IndusUpdateStatus } from "../global.d.ts";
+import { type MessageKey, useT } from "../i18n/index.tsx";
+
+const SKEW_TEXT: Readonly<Record<IndusUpdateSkew["kind"], MessageKey>> = {
+  "mixed-generations": "skew.mixed",
+  "app-behind-runtime": "skew.behind",
+  "renderer-stale": "skew.stale",
+};
+
+export interface UpdateNoticeProps {
+  status: IndusUpdateStatus | null;
+  skew: IndusUpdateSkew | null;
+  onDismissSkew(): void;
+}
+
+export function UpdateNotice(props: UpdateNoticeProps) {
+  const t = useT();
+  const bridge = desktopBridge();
+  const [dismissed, setDismissed] = useState<string | null>(null);
+  const [applied, setApplied] = useState(false);
+  const { status, skew } = props;
+
+  if (skew !== null) {
+    return (
+      <div className="toast ambient-toast" role="alert">
+        <p>{t(SKEW_TEXT[skew.kind])}</p>
+        <div className="ambient-actions">
+          {skew.kind === "renderer-stale" ? (
+            <button
+              type="button"
+              className="button button-primary"
+              onClick={() => window.location.reload()}
+            >
+              {t("skew.reload")}
+            </button>
+          ) : (
+            <button
+              type="button"
+              className="button button-primary"
+              onClick={() => void bridge?.updates.check().catch(() => {})}
+            >
+              {t("skew.check")}
+            </button>
+          )}
+          <button type="button" className="button button-secondary" onClick={props.onDismissSkew}>
+            {t("update.later")}
+          </button>
+        </div>
+      </div>
+    );
+  }
+
+  if (status === null) return null;
+  if (status.state === "downloading") {
+    return (
+      <div className="toast ambient-toast" role="status">
+        <p>{t("update.downloading", { progress: status.progress ?? 0 })}</p>
+        <progress max={100} value={status.progress ?? 0} />
+      </div>
+    );
+  }
+  if (status.state === "ready" || status.state === "installing") {
+    return (
+      <div className="toast ambient-toast" role="status">
+        <p>{t("update.restarting")}</p>
+      </div>
+    );
+  }
+  if (status.state === "error" && applied) {
+    return (
+      <div className="toast ambient-toast" role="alert">
+        <p>{t("update.failed", { error: status.error ?? "" })}</p>
+        <div className="ambient-actions">
+          <button
+            type="button"
+            className="button button-secondary"
+            onClick={() => setApplied(false)}
+          >
+            {t("update.later")}
+          </button>
+        </div>
+      </div>
+    );
+  }
+  const version = status.version ?? "";
+  if ((status.state !== "available" && status.state !== "manual") || dismissed === version)
+    return null;
+
+  const manual = status.state === "manual";
+  return (
+    <div className="toast ambient-toast" role="status">
+      <p>
+        {manual && status.manualHint !== undefined
+          ? t("update.manualCommand", { version, command: status.manualHint })
+          : t("update.available", { version })}
+      </p>
+      <div className="ambient-actions">
+        {!manual && (
+          <button
+            type="button"
+            className="button button-primary"
+            onClick={() => {
+              setApplied(true);
+              void bridge?.updates.apply().catch(() => {});
+            }}
+          >
+            {t("update.install")}
+          </button>
+        )}
+        {manual && status.downloadUrl !== undefined && (
+          <button
+            type="button"
+            className="button button-primary"
+            onClick={() =>
+              void bridge?.external.open({ url: status.downloadUrl ?? "" }).catch(() => {})
+            }
+          >
+            {t("update.download")}
+          </button>
+        )}
+        <button
+          type="button"
+          className="button button-secondary"
+          onClick={() => setDismissed(version)}
+        >
+          {t("update.later")}
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/apps/desktop/src/updates/skew.test.ts b/apps/desktop/src/updates/skew.test.ts
new file mode 100644
index 0000000..3722e72
--- /dev/null
+++ b/apps/desktop/src/updates/skew.test.ts
@@ -0,0 +1,56 @@
+// @vitest-environment jsdom
+import { describe, expect, it } from "vitest";
+import { isChunkLoadFailure, runtimeAhead, watchChunkFailures } from "./skew.ts";
+
+describe("renderer skew", () => {
+  it("recognises a missing lazy chunk and nothing else", () => {
+    expect(
+      isChunkLoadFailure(
+        new TypeError("Failed to fetch dynamically imported module: file:///x.js"),
+      ),
+    ).toBe(true);
+    expect(isChunkLoadFailure({ name: "ChunkLoadError", message: "" })).toBe(true);
+    expect(isChunkLoadFailure("Importing a module script failed.")).toBe(true);
+    expect(isChunkLoadFailure(new Error("Cannot read properties of undefined"))).toBe(false);
+    expect(isChunkLoadFailure(null)).toBe(false);
+  });
+
+  it("a lazy-chunk 404 (Vite's preload error) → one skew notice, the error consumed", () => {
+    let notices = 0;
+    const stop = watchChunkFailures(window, () => {
+      notices += 1;
+    });
+    const preload = new Event("vite:preloadError", { cancelable: true });
+    window.dispatchEvent(preload);
+    expect(preload.defaultPrevented).toBe(true);
+    window.dispatchEvent(new Event("vite:preloadError", { cancelable: true }));
+    expect(notices).toBe(1);
+    stop();
+  });
+
+  it("an unhandled chunk rejection is a notice; another rejection is left alone", () => {
+    let notices = 0;
+    const stop = watchChunkFailures(window, () => {
+      notices += 1;
+    });
+    const other = new Event("unhandledrejection", { cancelable: true }) as PromiseRejectionEvent;
+    Object.defineProperty(other, "reason", { value: new Error("boom") });
+    window.dispatchEvent(other);
+    expect(other.defaultPrevented).toBe(false);
+    const chunk = new Event("unhandledrejection", { cancelable: true }) as PromiseRejectionEvent;
+    Object.defineProperty(chunk, "reason", {
+      value: new TypeError("error loading dynamically imported module"),
+    });
+    window.dispatchEvent(chunk);
+    expect(chunk.defaultPrevented).toBe(true);
+    expect(notices).toBe(1);
+    stop();
+  });
+
+  it("app behind runtime only for a packaged app", () => {
+    expect(runtimeAhead("1.0.0", "1.1.0", true)).toBe(true);
+    expect(runtimeAhead("1.0.0", "1.1.0", false)).toBe(false);
+    expect(runtimeAhead("1.1.0", "1.1.0", true)).toBe(false);
+    expect(runtimeAhead("1.0.0", null, true)).toBe(false);
+  });
+});
diff --git a/apps/desktop/src/updates/skew.ts b/apps/desktop/src/updates/skew.ts
new file mode 100644
index 0000000..d7bfef8
--- /dev/null
+++ b/apps/desktop/src/updates/skew.ts
@@ -0,0 +1,66 @@
+// Renderer-side skew (P20-37, R08.14): a lazily loaded chunk that is gone (a 404 after the app or
+// its bundle was replaced underneath this window) must become a notice offering reload / update,
+// not a crash on the first lazy import. Vite reports a failed dynamic import preload as the
+// `vite:preloadError` window event; browsers report the import itself with a few wordings.
+
+import { isNewer } from "../../electron/updates/version.ts";
+
+const CHUNK_FAILURE = [
+  /failed to fetch dynamically imported module/i,
+  /error loading dynamically imported module/i,
+  /importing a module script failed/i,
+  /unable to preload css/i,
+  /loading (css )?chunk [\w-]+ failed/i,
+];
+
+/** True for an error that means "a lazy chunk of this build is missing". */
+export function isChunkLoadFailure(error: unknown): boolean {
+  if (error === null || error === undefined) return false;
+  const name = (error as { name?: unknown }).name;
+  if (name === "ChunkLoadError") return true;
+  const message =
+    typeof error === "string" ? error : String((error as { message?: unknown }).message ?? "");
+  return CHUNK_FAILURE.some((pattern) => pattern.test(message));
+}
+
+/** A packaged app older than the runtime it attached to. */
+export function runtimeAhead(
+  appVersion: string,
+  runtimeVersion: string | null,
+  packaged: boolean,
+): boolean {
+  return packaged && runtimeVersion !== null && isNewer(runtimeVersion, appVersion);
+}
+
+/**
+ * Watch this window for missing chunks: `onSkew` once per window; Vite's preload error is
+ * consumed (no uncaught error) once reported. Returns the unsubscribe.
+ */
+export function watchChunkFailures(target: Window, onSkew: () => void): () => void {
+  let reported = false;
+  const report = () => {
+    if (reported) return;
+    reported = true;
+    onSkew();
+  };
+  const onPreload = (event: Event) => {
+    event.preventDefault();
+    report();
+  };
+  const onRejection = (event: PromiseRejectionEvent) => {
+    if (!isChunkLoadFailure(event.reason)) return;
+    event.preventDefault();
+    report();
+  };
+  const onError = (event: ErrorEvent) => {
+    if (isChunkLoadFailure(event.error ?? event.message)) report();
+  };
+  target.addEventListener("vite:preloadError", onPreload);
+  target.addEventListener("unhandledrejection", onRejection);
+  target.addEventListener("error", onError);
+  return () => {
+    target.removeEventListener("vite:preloadError", onPreload);
+    target.removeEventListener("unhandledrejection", onRejection);
+    target.removeEventListener("error", onError);
+  };
+}
diff --git a/apps/desktop/testing/fakeFeed.ts b/apps/desktop/testing/fakeFeed.ts
new file mode 100644
index 0000000..7501378
--- /dev/null
+++ b/apps/desktop/testing/fakeFeed.ts
@@ -0,0 +1,65 @@
+// A loopback releases feed for the update tests (P20-37): answers GET <base>/releases with a
+// GitHub-shaped JSON list, records what each request carried, and can refuse a token. No real
+// network is ever touched.
+
+import http from "node:http";
+import type { AddressInfo } from "node:net";
+
+export interface FakeRelease {
+  tag_name: string;
+  draft?: boolean;
+  prerelease?: boolean;
+  html_url?: string;
+}
+
+export interface FeedRequest {
+  path: string;
+  authorization: string | null;
+}
+
+export class FakeFeed {
+  releases: FakeRelease[] = [];
+  /** Authorization values answered with 401. */
+  readonly rejected = new Set<string>();
+  /** Answer every request with this status (e.g. 503). */
+  status: number | null = null;
+  readonly requests: FeedRequest[] = [];
+  private server: http.Server | null = null;
+  url = "";
+
+  async start(): Promise<string> {
+    this.server = http.createServer((request, response) => {
+      const authorization = request.headers.authorization ?? null;
+      this.requests.push({ path: request.url ?? "", authorization });
+      if (this.status !== null) {
+        response.writeHead(this.status).end("{}");
+        return;
+      }
+      if (authorization !== null && this.rejected.has(authorization)) {
+        response
+          .writeHead(401, { "content-type": "application/json" })
+          .end('{"message":"Bad credentials"}');
+        return;
+      }
+      if (!(request.url ?? "").startsWith("/releases")) {
+        response.writeHead(404).end();
+        return;
+      }
+      response
+        .writeHead(200, { "content-type": "application/json" })
+        .end(JSON.stringify(this.releases));
+    });
+    await new Promise<void>((resolve) => this.server?.listen(0, "127.0.0.1", resolve));
+    const { port } = this.server.address() as AddressInfo;
+    this.url = `http://127.0.0.1:${port}/releases`;
+    return this.url;
+  }
+
+  async stop(): Promise<void> {
+    const server = this.server;
+    this.server = null;
+    if (server === null) return;
+    server.closeAllConnections?.();
+    await new Promise<void>((resolve) => server.close(() => resolve()));
+  }
+}
diff --git a/apps/desktop/testing/fakeFloating.ts b/apps/desktop/testing/fakeFloating.ts
new file mode 100644
index 0000000..4b6085f
--- /dev/null
+++ b/apps/desktop/testing/fakeFloating.ts
@@ -0,0 +1,182 @@
+// Fake windows and screen for the ambient (P20-35, P20-36) main-process tests.
+
+import type { Point } from "../electron/ambient/hud.ts";
+import type { DisplayLike, Rect } from "../electron/windows/windowState.ts";
+
+let nextId = 100;
+
+export class FakeWindow {
+  readonly webContents: {
+    id: number;
+    sent: Array<[string, unknown]>;
+    on(): void;
+    reload(): void;
+    getURL(): string;
+    getZoomLevel(): number;
+    setZoomLevel(): void;
+    isDestroyed(): boolean;
+    send(channel: string, payload: unknown): void;
+  };
+  bounds: Rect;
+  visible = false;
+  minimized = false;
+  destroyed = false;
+  focused = 0;
+  skipTaskbar: boolean | null = null;
+  resizable = false;
+  calls: string[] = [];
+  private readonly listeners = new Map<string, Array<(...args: unknown[]) => void>>();
+
+  constructor(bounds: Rect = { x: 0, y: 0, width: 800, height: 600 }) {
+    this.bounds = { ...bounds };
+    this.webContents = {
+      id: nextId++,
+      sent: [],
+      on() {},
+      reload() {},
+      getURL: () => "file:///app/index.html",
+      getZoomLevel: () => 0,
+      setZoomLevel() {},
+      isDestroyed: () => this.destroyed,
+      send(channel, payload) {
+        this.sent.push([channel, payload]);
+      },
+    };
+  }
+
+  on(event: string, listener: (...args: never[]) => void): this {
+    const list = this.listeners.get(event) ?? [];
+    list.push(listener as (...args: unknown[]) => void);
+    this.listeners.set(event, list);
+    return this;
+  }
+
+  emit(event: string, ...args: unknown[]): void {
+    for (const listener of [...(this.listeners.get(event) ?? [])]) listener(...args);
+  }
+
+  /** Emit a preventable event; true when a listener prevented it. */
+  emitPreventable(event: string): boolean {
+    let prevented = false;
+    this.emit(event, { preventDefault: () => (prevented = true) });
+    return prevented;
+  }
+
+  loadURL(): Promise<void> {
+    return Promise.resolve();
+  }
+  show(): void {
+    this.calls.push("show");
+    this.visible = true;
+    this.minimized = false;
+    this.emit("show");
+  }
+  showInactive(): void {
+    this.calls.push("showInactive");
+    this.visible = true;
+    this.emit("show");
+  }
+  hide(): void {
+    this.calls.push("hide");
+    this.visible = false;
+  }
+  focus(): void {
+    this.focused += 1;
+    this.calls.push("focus");
+  }
+  blur(): void {
+    this.calls.push("blur");
+  }
+  restore(): void {
+    this.calls.push("restore");
+    this.minimized = false;
+    this.emit("restore");
+  }
+  minimize(): void {
+    this.calls.push("minimize");
+    this.minimized = true;
+    this.emit("minimize");
+  }
+  maximize(): void {}
+  unmaximize(): void {}
+  close(): void {
+    this.calls.push("close");
+    if (this.emitPreventable("close")) return;
+    this.destroy();
+  }
+  destroy(): void {
+    if (this.destroyed) return;
+    this.destroyed = true;
+    this.visible = false;
+    this.emit("closed");
+  }
+  isDestroyed(): boolean {
+    return this.destroyed;
+  }
+  isVisible(): boolean {
+    return this.visible;
+  }
+  isMinimized(): boolean {
+    return this.minimized;
+  }
+  isMaximized(): boolean {
+    return false;
+  }
+  isFullScreen(): boolean {
+    return false;
+  }
+  isFocused(): boolean {
+    return false;
+  }
+  getNormalBounds(): Rect {
+    return { ...this.bounds };
+  }
+  getBounds(): Rect {
+    return { ...this.bounds };
+  }
+  setBounds(bounds: Rect): void {
+    if (
+      !this.resizable &&
+      (bounds.width !== this.bounds.width || bounds.height !== this.bounds.height)
+    )
+      throw new Error("not resizable");
+    this.bounds = { ...bounds };
+    this.emit("move");
+  }
+  setResizable(on: boolean): void {
+    this.resizable = on;
+  }
+  setSkipTaskbar(skip: boolean): void {
+    this.skipTaskbar = skip;
+  }
+}
+
+export class FakeScreen {
+  cursor: Point = { x: 100, y: 100 };
+  displays: DisplayLike[];
+
+  constructor(displays: DisplayLike[] = [{ workArea: { x: 0, y: 0, width: 1920, height: 1080 } }]) {
+    this.displays = displays;
+  }
+
+  getAllDisplays(): DisplayLike[] {
+    return this.displays;
+  }
+  getPrimaryDisplay(): DisplayLike {
+    return this.displays[0] as DisplayLike;
+  }
+  getCursorScreenPoint(): Point {
+    return { ...this.cursor };
+  }
+  getDisplayNearestPoint(point: Point): DisplayLike {
+    return (
+      this.displays.find(
+        (d) =>
+          point.x >= d.workArea.x &&
+          point.x < d.workArea.x + d.workArea.width &&
+          point.y >= d.workArea.y &&
+          point.y < d.workArea.y + d.workArea.height,
+      ) ?? (this.displays[0] as DisplayLike)
+    );
+  }
+}
