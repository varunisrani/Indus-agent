+  it("a failed download or a missing acceptance rejects (nothing installed)", async () => {
+    const failing = new FakeNative();
+    failing.downloadBehaviour = "fail";
+    await expect(
+      new ElectronUpdaterEngine(failing, new FakeTimers()).download(() => {}),
