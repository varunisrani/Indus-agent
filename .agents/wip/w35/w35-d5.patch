@@ -0,0 +1,148 @@
+// @vitest-environment jsdom
+import { act, fireEvent, render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { I18nProvider } from "../i18n/index.tsx";
+import { FindBar, isFindKey } from "./FindBar.tsx";
+import {
+  findRanges,
+  HIGHLIGHT_ACTIVE,
+  HIGHLIGHT_ALL,
+  type HighlightRegistry,
+  TranscriptFinder,
+} from "./findInTranscript.ts";
+
+function transcript(html: string): HTMLElement {
+  const root = document.createElement("div");
+  root.className = "transcript";
+  root.innerHTML = html;
+  document.body.appendChild(root);
+  return root;
+}
+
+const FIXTURE = `
+  <div class="msg msg-user"><span class="sr-only">You</span><div class="msg-bubble">Hello there, hello again</div></div>
+  <div class="msg msg-assistant"><span class="sr-only">Assistant</span><p>Say <b>HELLO</b> back.</p></div>
+  <div data-find-skip><input value="hello" /><span>hello in my own UI</span></div>
+`;
+
+function recorder() {
+  const sets: Array<[string, number]> = [];
+  const deletes: string[] = [];
+  const registry: HighlightRegistry = {
+    set: (name, ranges) => sets.push([name, ranges.length]),
+    delete: (name) => deletes.push(name),
+  };
+  return { registry, sets, deletes };
+}
+
+describe("findRanges", () => {
+  it("finds every visible match, ignoring case, hidden labels and skipped UI", () => {
+    const root = transcript(FIXTURE);
+    const ranges = findRanges(root, "hello");
+    expect(ranges.map((r) => r.toString())).toEqual(["Hello", "hello", "HELLO"]);
+    expect(findRanges(root, "you")).toEqual([]);
+    expect(findRanges(root, "Hello", { matchCase: true })).toHaveLength(1);
+    expect(findRanges(root, "   ")).toEqual([]);
+    root.remove();
+  });
+});
+
+describe("TranscriptFinder", () => {
+  it("counts, steps with wrap-around, paints and clears", () => {
+    const root = transcript(FIXTURE);
+    const { registry, sets, deletes } = recorder();
+    const finder = new TranscriptFinder({ root: () => root, highlights: registry });
+    expect(finder.search("hello")).toEqual({ query: "hello", total: 3, current: 1 });
+    expect(sets).toEqual([
+      [HIGHLIGHT_ALL, 3],
+      [HIGHLIGHT_ACTIVE, 1],
+    ]);
+    expect(finder.next().current).toBe(2);
+    expect(finder.next().current).toBe(3);
+    expect(finder.next().current).toBe(1);
+    expect(finder.previous().current).toBe(3);
+    finder.clear();
+    expect(deletes).toEqual([HIGHLIGHT_ALL, HIGHLIGHT_ACTIVE]);
+    root.remove();
+  });
+
+  it("refresh keeps the active match while new rows stream in", () => {
+    const root = transcript(FIXTURE);
+    const finder = new TranscriptFinder({ root: () => root, highlights: null });
+    finder.search("hello");
+    finder.next();
+    const row = document.createElement("p");
+    row.textContent = "and hello once more";
+    root.appendChild(row);
+    expect(finder.refresh()).toEqual({ query: "hello", total: 4, current: 2 });
+    root.remove();
+  });
+});
+
+describe("FindBar", () => {
+  it("opens on Ctrl/Cmd+F only", () => {
+    const base = { ctrlKey: false, metaKey: false, altKey: false, shiftKey: false };
+    expect(isFindKey({ ...base, key: "f", ctrlKey: true })).toBe(true);
+    expect(isFindKey({ ...base, key: "F", metaKey: true })).toBe(true);
+    expect(isFindKey({ ...base, key: "f" })).toBe(false);
+    expect(isFindKey({ ...base, key: "f", ctrlKey: true, shiftKey: true })).toBe(false);
+  });
+
+  it("highlights the count, steps with Enter / Shift+Enter and closes with Esc", async () => {
+    const root = transcript(FIXTURE);
+    const { registry, sets, deletes } = recorder();
+    render(
+      <I18nProvider>
+        <FindBar root={() => root} highlights={registry} bridge={null} />
+      </I18nProvider>,
+    );
+    expect(screen.queryByRole("searchbox")).toBeNull();
+    fireEvent.keyDown(window, { key: "f", ctrlKey: true });
+    const input = await screen.findByRole("searchbox", { name: "Find in conversation" });
+    expect(document.activeElement).toBe(input);
+
+    fireEvent.change(input, { target: { value: "hello" } });
+    expect(screen.getByText("1 of 3")).toBeTruthy();
+    expect(sets).toContainEqual([HIGHLIGHT_ALL, 3]);
+    fireEvent.keyDown(input, { key: "Enter" });
+    expect(screen.getByText("2 of 3")).toBeTruthy();
+    fireEvent.keyDown(input, { key: "Enter", shiftKey: true });
+    fireEvent.keyDown(input, { key: "Enter", shiftKey: true });
+    expect(screen.getByText("3 of 3")).toBeTruthy();
+    fireEvent.click(screen.getByRole("button", { name: "Next match" }));
+    expect(screen.getByText("1 of 3")).toBeTruthy();
+
+    fireEvent.change(input, { target: { value: "nowhere" } });
+    expect(screen.getByText("No results")).toBeTruthy();
+    expect((screen.getByRole("button", { name: "Next match" }) as HTMLButtonElement).disabled).toBe(
+      true,
+    );
+
+    fireEvent.keyDown(input, { key: "Escape" });
+    expect(screen.queryByRole("searchbox")).toBeNull();
+    expect(deletes).toContain(HIGHLIGHT_ALL);
+    root.remove();
+  });
+
+  it("opens when main forwards the Linux shortcut", async () => {
+    let open: ((payload: Record<string, never>) => void) | null = null;
+    const bridge = {
+      find: {
+        onOpen: (listener: (payload: Record<string, never>) => void) => {
+          open = listener;
+          return () => {
+            open = null;
+          };
+        },
+      },
+    };
+    render(
+      <I18nProvider>
+        <FindBar root={() => null} highlights={null} bridge={bridge} />
+      </I18nProvider>,
+    );
+    expect(open).not.toBeNull();
+    act(() => (open as ((payload: Record<string, never>) => void) | null)?.({}));
+    expect(await screen.findByRole("searchbox")).toBeTruthy();
+  });
+});
diff --git a/apps/desktop/src/app/FindBar.tsx b/apps/desktop/src/app/FindBar.tsx
new file mode 100644
index 0000000..251dcd2
--- /dev/null
+++ b/apps/desktop/src/app/FindBar.tsx
@@ -0,0 +1,192 @@
+// The find bar (P20-39): Ctrl/Cmd+F opens it over the chat (on Linux main claims Ctrl+F and sends
+// `find.onOpen`), typing searches the rendered transcript, Enter / Shift+Enter step through the
+// matches, Esc closes it and clears the highlights. Rows streaming in re-run the search.
+
+import { ChevronDown, ChevronUp, X } from "lucide-react";
+import {
+  type KeyboardEvent,
+  StrictMode,
+  useCallback,
+  useEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+import { createRoot } from "react-dom/client";
+import type { IndusDesktopBridge } from "../global.d.ts";
+import { I18nProvider, useT } from "../i18n/index.tsx";
+import { desktopBridge } from "./bridge.ts";
+import {
+  cssHighlights,
+  EMPTY_FIND,
+  type FindState,
+  type HighlightRegistry,
+  TranscriptFinder,
+} from "./findInTranscript.ts";
+
+/** Debounce for re-searching while the transcript changes. */
+export const FIND_REFRESH_MS = 150;
+
+export const defaultFindRoot = (): Element | null => document.querySelector(".transcript");
+
+export interface FindBarProps {
+  root?: () => Element | null;
+  highlights?: HighlightRegistry | null;
+  bridge?: Pick<IndusDesktopBridge, "find"> | null;
+}
+
+export function isFindKey(
+  event: Pick<globalThis.KeyboardEvent, "key" | "ctrlKey" | "metaKey" | "altKey" | "shiftKey">,
+): boolean {
+  return (
+    (event.ctrlKey || event.metaKey) &&
+    !event.altKey &&
+    !event.shiftKey &&
+    event.key.toLowerCase() === "f"
+  );
+}
+
+export function FindBar(props: FindBarProps) {
+  const t = useT();
+  const root = props.root ?? defaultFindRoot;
+  const finder = useMemo(
+    () =>
+      new TranscriptFinder({
+        root,
+        highlights: props.highlights === undefined ? cssHighlights() : props.highlights,
+      }),
+    [root, props.highlights],
+  );
+  const [open, setOpen] = useState(false);
+  const [query, setQuery] = useState("");
+  const [state, setState] = useState<FindState>(EMPTY_FIND);
+  const input = useRef<HTMLInputElement | null>(null);
+
+  // Each open request (also while already open) focuses and selects the query.
+  const [focusRequest, setFocusRequest] = useState(0);
+  const show = useCallback(() => {
+    setOpen(true);
+    setFocusRequest((n) => n + 1);
+  }, []);
+
+  useEffect(() => {
+    if (!open || focusRequest === 0) return;
+    input.current?.focus();
+    input.current?.select();
+  }, [open, focusRequest]);
+
+  const close = useCallback(() => {
+    setOpen(false);
+    setState(finder.clear());
+  }, [finder]);
+
+  useEffect(() => {
+    const onKey = (event: globalThis.KeyboardEvent) => {
+      if (!isFindKey(event)) return;
+      event.preventDefault();
+      show();
+    };
+    window.addEventListener("keydown", onKey);
+    const bridge = props.bridge === undefined ? desktopBridge() : props.bridge;
+    const unsubscribe = bridge?.find?.onOpen(() => show());
+    return () => {
+      window.removeEventListener("keydown", onKey);
+      unsubscribe?.();
+    };
+  }, [show, props.bridge]);
+
+  // Streaming rows: search again (debounced) while the bar is open.
+  useEffect(() => {
+    if (!open) return;
+    const target = root();
+    if (target === null || typeof MutationObserver === "undefined") return;
+    let timer: ReturnType<typeof setTimeout> | null = null;
+    const observer = new MutationObserver(() => {
+      if (timer !== null) clearTimeout(timer);
+      timer = setTimeout(() => setState(finder.refresh()), FIND_REFRESH_MS);
+    });
+    observer.observe(target, { childList: true, subtree: true, characterData: true });
+    return () => {
+      observer.disconnect();
+      if (timer !== null) clearTimeout(timer);
+    };
+  }, [open, root, finder]);
+
+  useEffect(() => () => void finder.clear(), [finder]);
+
+  if (!open) return null;
+
+  const onKeyDown = (event: KeyboardEvent<HTMLInputElement>) => {
+    if (event.key === "Escape") {
+      event.preventDefault();
+      close();
+    } else if (event.key === "Enter") {
+      event.preventDefault();
+      setState(event.shiftKey ? finder.previous() : finder.next());
+    }
+  };
+
+  const count =
+    state.query === ""
+      ? ""
+      : state.total === 0
+        ? t("find.none")
+        : t("find.count", { current: state.current, total: state.total });
+
+  return (
+    <search className="find-bar" data-find-skip="">
+      <input
+        ref={input}
+        className="find-input"
+        type="search"
+        aria-label={t("find.label")}
+        placeholder={t("find.placeholder")}
+        value={query}
+        spellCheck={false}
+        onChange={(event) => {
+          setQuery(event.target.value);
+          setState(finder.search(event.target.value));
+        }}
+        onKeyDown={onKeyDown}
+      />
+      <span className="find-count" aria-live="polite">
+        {count}
+      </span>
+      <button
+        type="button"
+        className="icon-button"
+        aria-label={t("find.previous")}
+        disabled={state.total === 0}
+        onClick={() => setState(finder.previous())}
+      >
+        <ChevronUp aria-hidden="true" size={16} />
+      </button>
+      <button
+        type="button"
+        className="icon-button"
+        aria-label={t("find.next")}
+        disabled={state.total === 0}
+        onClick={() => setState(finder.next())}
+      >
+        <ChevronDown aria-hidden="true" size={16} />
+      </button>
+      <button type="button" className="icon-button" aria-label={t("common.close")} onClick={close}>
+        <X aria-hidden="true" size={16} />
+      </button>
+    </search>
+  );
+}
+
+/** Mount the find bar in its own root (shell windows; called once from `main.tsx`). */
+export function mountFindBar(host: HTMLElement = document.body): void {
+  const element = document.createElement("div");
+  element.className = "find-root";
+  host.appendChild(element);
+  createRoot(element).render(
+    <StrictMode>
+      <I18nProvider>
+        <FindBar />
+      </I18nProvider>
+    </StrictMode>,
+  );
+}
