+const dirs: string[] = [];
+afterAll(() => {
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function resources(entries: Entries, options: { stamp?: unknown; unpacked?: string[] } = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "indus-asar-"));
+  dirs.push(root);
+  const dir = path.join(root, "linux-unpacked", "resources");
+  fs.mkdirSync(dir, { recursive: true });
+  fs.writeFileSync(path.join(dir, "app.asar"), build(entries));
+  for (const file of options.unpacked ?? []) {
+    const onDisk = path.join(dir, "app.asar.unpacked", ...file.split("/"));
+    fs.mkdirSync(path.dirname(onDisk), { recursive: true });
+    fs.writeFileSync(onDisk, "binary");
+  }
+  if (options.stamp !== null) {
+    fs.writeFileSync(
+      path.join(dir, "desktop-build-stamp.json"),
+      JSON.stringify(options.stamp ?? STAMP),
+    );
+  }
+  return { root, dir };
+}
+
+describe("asar header", () => {
+  it("round-trips a hand-built archive and marks unpacked files", () => {
+    const buffer = build({ "a/b.txt": "hi", "a/c.node": { unpacked: true } });
+    const entries = list(parseAsarHeader(buffer));
+    expect(entries).toEqual([
+      { path: "a/b.txt", kind: "file", unpacked: false },
+      { path: "a/c.node", kind: "file", unpacked: true },
+    ]);
+    expect(() => parseAsarHeader(Buffer.alloc(20))).toThrow(/bad size pickle/);
+  });
+});
+
+describe("packaged contents check", () => {
+  it("passes a clean app without node-pty", () => {
+    const { dir } = resources(BASE);
+    const result = check(dir);
+    expect(result.problems).toEqual([]);
+    expect(result.summary).toContain("node-pty absent");
+    expect(result.summary).toContain("stamp 0.0.1 canary electron-updater");
+  });
+
+  it("fails on TypeScript sources and source maps in the archive", () => {
+    const { dir } = resources({
+      ...BASE,
+      "electron/main.ts": "x",
+      "src/App.tsx": "x",
+      "dist/assets/index.js.map": "{}",
+    });
+    const { problems } = check(dir);
+    expect(problems).toContain("TypeScript source in app.asar: electron/main.ts");
+    expect(problems).toContain("TypeScript source in app.asar: src/App.tsx");
+    expect(problems).toContain("source map in app.asar: dist/assets/index.js.map");
+  });
+
+  it("passes node-pty unpacked with its binding on disk", () => {
+    const binding = "node_modules/node-pty/build/Release/pty.node";
+    const { dir } = resources(
+      {
+        ...BASE,
+        "node_modules/node-pty/package.json": { unpacked: true },
+        "node_modules/node-pty/lib/index.js": { unpacked: true },
+        [binding]: { unpacked: true },
+      },
+      { unpacked: [binding] },
+    );
+    const result = check(dir);
+    expect(result.problems).toEqual([]);
+    expect(result.summary).toContain("node-pty unpacked");
+  });
+
+  it("fails when node-pty or a .node file is packed inside the archive", () => {
+    const { dir } = resources({
+      ...BASE,
+      "node_modules/node-pty/lib/index.js": "x",
+      "node_modules/node-pty/build/Release/pty.node": "x",
+    });
+    const { problems } = check(dir);
+    expect(problems).toContain(
+      "native module packed inside app.asar: node_modules/node-pty/build/Release/pty.node",
+    );
+    expect(problems).toContain("node-pty file not unpacked: node_modules/node-pty/lib/index.js");
+  });
+
+  it("fails when an entry file or the stamp is missing", () => {
+    const { "dist-electron/preload.cjs": _drop, ...rest } = BASE;
+    const { dir } = resources(rest, { stamp: null });
+    const { problems } = check(dir);
+    expect(problems).toContain("missing dist-electron/preload.cjs in app.asar");
+    expect(problems.some((p) => p.startsWith("desktop-build-stamp.json"))).toBe(true);
+    const bad = resources(BASE, { stamp: { ...STAMP, updateOwner: "guess" } });
+    expect(check(bad.dir).problems.join("\n")).toMatch(/updateOwner/);
+  });
+
+  it("finds resources folders for macOS, Windows and Linux layouts", () => {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), "indus-release-"));
+    dirs.push(root);
+    const layouts = [
+      ["mac-arm64", "Indus.app", "Contents", "Resources"],
+      ["win-unpacked", "resources"],
+      ["linux-unpacked", "resources"],
+    ];
+    for (const parts of layouts) {
+      const dir = path.join(root, ...parts);
+      fs.mkdirSync(dir, { recursive: true });
+      fs.writeFileSync(path.join(dir, "app.asar"), build(BASE));
+    }
+    expect(
+      findDirs(root)
+        .map((d) => path.relative(root, d))
+        .sort(),
+    ).toEqual(layouts.map((parts) => path.join(...parts)).sort());
+  });
+
+  it("the CLI exits 0 on a clean release, 1 on a problem, 2 without arguments", () => {
+    const clean = resources(BASE);
+    expect(targets([clean.root]).ok).toBe(true);
+    const run = spawnSync(process.execPath, [SCRIPT, clean.root], { encoding: "utf8" });
+    expect(run.status, run.stdout + run.stderr).toBe(0);
+    const dirty = resources({ ...BASE, "x.ts": "x" });
+    expect(spawnSync(process.execPath, [SCRIPT, dirty.root]).status).toBe(1);
+    expect(spawnSync(process.execPath, [SCRIPT]).status).toBe(2);
+    const empty = fs.mkdtempSync(path.join(os.tmpdir(), "indus-empty-"));
+    dirs.push(empty);
+    expect(targets([empty]).ok).toBe(false);
+  });
+});
diff --git a/apps/desktop/scripts/dist-unsigned.mjs b/apps/desktop/scripts/dist-unsigned.mjs
new file mode 100644
index 0000000..52d4885
--- /dev/null
+++ b/apps/desktop/scripts/dist-unsigned.mjs
@@ -0,0 +1,127 @@
+// Unsigned desktop artefacts for the host OS (P20-38). Steps: renderer build (Vite → dist/),
+// main + preload build (dist-electron/), build stamp, staged app (build/app/), electron-builder
+// with publishing off and every signing variable removed from its environment. The afterPack hook
+// in electron-builder.config.cjs flips the fuses and checks the archive.
+//
+//   node scripts/dist-unsigned.mjs [--dir] [--skip-build] [--channel stable|canary]
+//
+//   --dir         unpacked app only (no DMG/ZIP/NSIS/AppImage), fastest local check
+//   --skip-build  reuse dist/ and dist-electron/ from an earlier build
+//
+// Output: build/release/. Signing and notarisation are P23; nothing here uploads anything.
+
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { APP_DIR, stageApp } from "./stage-app.mjs";
+import { STAMP_FILE, writeBuildStamp } from "./write-build-stamp.mjs";
+
+const require = createRequire(import.meta.url);
+
+/** Variables that would let electron-builder sign, notarise or publish. Removed, never read. */
+export const SIGNING_ENV = Object.freeze([
+  "CSC_LINK",
+  "CSC_KEY_PASSWORD",
+  "CSC_NAME",
+  "CSC_KEYCHAIN",
+  "WIN_CSC_LINK",
+  "WIN_CSC_KEY_PASSWORD",
+  "APPLE_ID",
+  "APPLE_APP_SPECIFIC_PASSWORD",
+  "APPLE_TEAM_ID",
+  "APPLE_API_KEY",
+  "APPLE_API_KEY_ID",
+  "APPLE_API_ISSUER",
+  "APPLE_KEYCHAIN",
+  "APPLE_KEYCHAIN_PROFILE",
+  "GH_TOKEN",
+  "GITHUB_TOKEN",
+  "EP_GH_IGNORE_TIME",
+]);
+const SIGNING_PREFIXES = ["AZURE_", "CSC_", "WIN_CSC_", "APPLE_"];
+
+/** A copy of `env` without signing / publishing variables, with certificate discovery off. */
+export function unsignedEnv(env) {
+  const out = {};
+  for (const [key, value] of Object.entries(env)) {
+    if (SIGNING_ENV.includes(key)) continue;
+    if (SIGNING_PREFIXES.some((prefix) => key.startsWith(prefix))) continue;
+    out[key] = value;
+  }
+  out.CSC_IDENTITY_AUTO_DISCOVERY = "false";
+  return out;
+}
+
+/** electron-builder targets for the host platform (`--dir` → unpacked only). */
+export function targetsFor(platform, { dir = false } = {}) {
+  if (platform === "darwin") return { mac: dir ? ["dir"] : ["dmg", "zip"] };
+  if (platform === "win32") return { win: dir ? ["dir"] : ["nsis", "zip"] };
+  if (platform === "linux") return { linux: dir ? ["dir"] : ["AppImage"] };
+  throw new Error(`no desktop build for platform ${platform}`);
+}
+
+export function parseFlags(argv) {
+  const flags = { dir: false, skipBuild: false, channel: undefined };
+  for (let i = 0; i < argv.length; i += 1) {
+    const arg = argv[i];
+    if (arg === "--dir") flags.dir = true;
+    else if (arg === "--skip-build") flags.skipBuild = true;
+    else if (arg === "--channel") {
+      flags.channel = argv[i + 1];
+      i += 1;
+      if (flags.channel === undefined) throw new Error("--channel needs a value");
+    } else throw new Error(`unknown argument ${arg}`);
+  }
+  return flags;
+}
+
+async function buildBundles() {
+  const { build } = await import("vite");
+  await build({
+    root: APP_DIR,
+    configFile: path.join(APP_DIR, "vite.config.ts"),
+    logLevel: "warn",
+  });
+  const { buildElectron } = await import("./build-electron.mjs");
+  await buildElectron();
+}
+
+export async function distUnsigned(flags) {
+  if (!flags.skipBuild) await buildBundles();
+  const stamp = writeBuildStamp(path.join(APP_DIR, "build", STAMP_FILE), {
+    ...(flags.channel === undefined ? {} : { channel: flags.channel }),
+  });
+  const staged = stageApp({ stamp });
+  process.stdout.write(
+    `[stage] ${staged.outDir} (${stamp.version}, ${stamp.channel}, owner ${stamp.updateOwner}` +
+      `${staged.natives.length > 0 ? `, native: ${staged.natives.map((n) => n.name).join(", ")}` : ""})\n`,
+  );
+
+  fs.rmSync(path.join(APP_DIR, "build", "release"), { recursive: true, force: true });
+  const clean = unsignedEnv(process.env);
+  for (const key of Object.keys(process.env)) if (!(key in clean)) delete process.env[key];
+  process.env.CSC_IDENTITY_AUTO_DISCOVERY = "false";
+
+  const builder = require("electron-builder");
+  const config = require(path.join(APP_DIR, "electron-builder.config.cjs"));
+  const artefacts = await builder.build({
+    projectDir: APP_DIR,
+    config,
+    publish: "never",
+    ...targetsFor(process.platform, { dir: flags.dir }),
+  });
+  for (const file of artefacts) process.stdout.write(`[artefact] ${file}\n`);
+  return artefacts;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    await distUnsigned(parseFlags(process.argv.slice(2)));
+  } catch (error) {
+    process.stderr.write(
+      `${error instanceof Error ? (error.stack ?? error.message) : String(error)}\n`,
+    );
+    process.exit(1);
+  }
+}
diff --git a/apps/desktop/scripts/make-icons.mjs b/apps/desktop/scripts/make-icons.mjs
new file mode 100644
index 0000000..8e79a31
--- /dev/null
+++ b/apps/desktop/scripts/make-icons.mjs
@@ -0,0 +1,181 @@
+// Draw the app icon (P20-38, N27: our own artwork). A rounded tile in the accent teal with three
+// white river waves, painted from signed-distance shapes with supersampling and written as PNGs
+// by a tiny encoder (no image library):
+//
+//   resources/icons/icon.png            1024 × 1024 (macOS, Windows; electron-builder converts)
+//   resources/icons/png/<n>x<n>.png     16 … 512 (Linux AppImage, the runtime launcher entry)
+//
+//   node scripts/make-icons.mjs [--out DIR]
+
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import zlib from "node:zlib";
+
+const APP_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+export const LINUX_SIZES = Object.freeze([16, 32, 48, 64, 128, 256, 512]);
+
+// @indus/ui accent (light and dark themes) and the white mark.
+const TOP = [0x00, 0x7c, 0x9a];
+const BOTTOM = [0x3d, 0xb6, 0xda];
+
+// -- PNG -------------------------------------------------------------------------------------------
+
+const CRC_TABLE = (() => {
+  const table = new Uint32Array(256);
+  for (let n = 0; n < 256; n += 1) {
+    let c = n;
+    for (let k = 0; k < 8; k += 1) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;
+    table[n] = c >>> 0;
+  }
+  return table;
+})();
+
+function crc32(bytes) {
+  let c = 0xffffffff;
+  for (const byte of bytes) c = CRC_TABLE[(c ^ byte) & 0xff] ^ (c >>> 8);
+  return (c ^ 0xffffffff) >>> 0;
+}
+
+function chunk(type, data) {
+  const head = Buffer.alloc(8);
+  head.writeUInt32BE(data.length, 0);
+  head.write(type, 4, "ascii");
+  const crc = Buffer.alloc(4);
+  crc.writeUInt32BE(crc32(Buffer.concat([head.subarray(4), data])), 0);
+  return Buffer.concat([head, data, crc]);
+}
+
+/** Encode RGBA pixels (`Uint8Array`, width × height × 4) as a PNG. */
+export function encodePng(width, height, rgba) {
+  const raw = Buffer.alloc((width * 4 + 1) * height);
+  for (let y = 0; y < height; y += 1) {
+    raw[y * (width * 4 + 1)] = 0; // filter: none
+    Buffer.from(rgba.buffer, rgba.byteOffset + y * width * 4, width * 4).copy(
+      raw,
+      y * (width * 4 + 1) + 1,
+    );
+  }
+  const ihdr = Buffer.alloc(13);
+  ihdr.writeUInt32BE(width, 0);
+  ihdr.writeUInt32BE(height, 4);
+  ihdr[8] = 8; // bit depth
+  ihdr[9] = 6; // RGBA
+  return Buffer.concat([
+    Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
+    chunk("IHDR", ihdr),
+    chunk("IDAT", zlib.deflateSync(raw, { level: 9 })),
+    chunk("IEND", Buffer.alloc(0)),
+  ]);
+}
+
+/** Width and height from a PNG's IHDR, or null when the bytes are not a PNG. */
+export function pngSize(bytes) {
+  if (bytes.length < 24 || bytes.readUInt32BE(0) !== 0x89504e47) return null;
+  return { width: bytes.readUInt32BE(16), height: bytes.readUInt32BE(20) };
+}
+
+// -- shapes (in a 1024-unit design space) ----------------------------------------------------------
+
+function roundedRect(x, y) {
+  const half = 412; // tile 824 wide, centred
+  const radius = 184;
+  const qx = Math.abs(x - 512) - (half - radius);
+  const qy = Math.abs(y - 512) - (half - radius);
+  const outside = Math.hypot(Math.max(qx, 0), Math.max(qy, 0));
+  return outside + Math.min(Math.max(qx, qy), 0) - radius;
+}
+
+const WAVES = [
+  { y: 392, alpha: 1 },
+  { y: 512, alpha: 0.86 },
+  { y: 632, alpha: 0.72 },
+];
+const WAVE_FROM = 286;
+const WAVE_TO = 738;
+const AMPLITUDE = 34;
+const WAVELENGTH = 226;
+const STROKE = 30; // half-width
+
+// Both ends sit on a crest (flat), so the round caps meet the stroke without a bulge.
+const phase = (x) => ((x - WAVE_FROM) / WAVELENGTH) * 2 * Math.PI;
+
+function waveY(baseY, x) {
+  return baseY + AMPLITUDE * Math.cos(phase(x));
+}
+
+/** Distance from (x, y) to one wave stroke with round caps (negative inside). */
+function wave(baseY, x, y) {
+  const cx = Math.min(Math.max(x, WAVE_FROM), WAVE_TO);
+  const fy = waveY(baseY, cx);
+  if (cx !== x) return Math.hypot(x - cx, y - fy) - STROKE;
+  const slope = -AMPLITUDE * ((2 * Math.PI) / WAVELENGTH) * Math.sin(phase(x));
+  return Math.abs(y - fy) / Math.sqrt(1 + slope * slope) - STROKE;
+}
+
+/** Colour of one design-space point: [r, g, b, a] in 0..1. */
+function shade(x, y, pixel) {
+  const tile = roundedRect(x, y);
+  if (tile > pixel) return [0, 0, 0, 0];
+  const t = Math.min(Math.max((y - 100) / 824, 0), 1);
+  let rgb = TOP.map((c, i) => (c + (BOTTOM[i] - c) * t) / 255);
+  for (const w of WAVES) {
+    const d = wave(w.y, x, y);
+    const cover = Math.min(Math.max(0.5 - d / pixel, 0), 1) * w.alpha;
+    if (cover > 0) rgb = rgb.map((c) => c + (1 - c) * cover);
+  }
+  const edge = Math.min(Math.max(0.5 - tile / pixel, 0), 1);
+  return [rgb[0], rgb[1], rgb[2], edge];
+}
+
+/** Render the icon at `size` px with `samples`² supersampling. */
+export function renderIcon(size, samples = 4) {
+  const out = new Uint8Array(size * size * 4);
+  const scale = 1024 / size;
+  for (let py = 0; py < size; py += 1) {
+    for (let px = 0; px < size; px += 1) {
+      let r = 0;
+      let g = 0;
+      let b = 0;
+      let a = 0;
+      for (let sy = 0; sy < samples; sy += 1) {
+        for (let sx = 0; sx < samples; sx += 1) {
+          const x = (px + (sx + 0.5) / samples) * scale;
+          const y = (py + (sy + 0.5) / samples) * scale;
+          const [cr, cg, cb, ca] = shade(x, y, scale / samples);
+          r += cr * ca;
+          g += cg * ca;
+          b += cb * ca;
+          a += ca;
+        }
+      }
+      const i = (py * size + px) * 4;
+      const n = samples * samples;
+      out[i + 3] = Math.round((a / n) * 255);
+      if (a > 0) {
+        out[i] = Math.round((r / a) * 255);
+        out[i + 1] = Math.round((g / a) * 255);
+        out[i + 2] = Math.round((b / a) * 255);
+      }
+    }
+  }
+  return out;
+}
+
+export function writeIcons(outDir = path.join(APP_DIR, "resources", "icons")) {
+  fs.mkdirSync(path.join(outDir, "png"), { recursive: true });
+  const written = [];
+  const put = (file, size) => {
+    fs.writeFileSync(file, encodePng(size, size, renderIcon(size)));
+    written.push(file);
+  };
+  put(path.join(outDir, "icon.png"), 1024);
+  for (const size of LINUX_SIZES) put(path.join(outDir, "png", `${size}x${size}.png`), size);
+  return written;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const at = process.argv.indexOf("--out");
+  const written = writeIcons(at > 0 ? path.resolve(process.argv[at + 1] ?? "") : undefined);
+  for (const file of written) process.stdout.write(`wrote ${path.relative(process.cwd(), file)}\n`);
+}
diff --git a/apps/desktop/scripts/stage-app.mjs b/apps/desktop/scripts/stage-app.mjs
new file mode 100644
index 0000000..1bc6f67
--- /dev/null
+++ b/apps/desktop/scripts/stage-app.mjs
@@ -0,0 +1,178 @@
+// Stage the folder electron-builder packs (P20-38): only what the packaged app runs.
+//
+//   build/app/
+//     package.json        generated: name, product name, version, main, native modules only
+//     dist/               the renderer bundle (Vite), no source maps
+//     dist-electron/      main.js + preload.cjs, no source maps
+//     node_modules/<m>/   each native module the desktop declares (node-pty, P20-31) with its
+//                         compiled binding / prebuilds for the target platform and its runtime
+//                         dependencies; never its C++ sources
+//
+// The renderer and main bundles already inline every JavaScript dependency, so nothing else from
+// the pnpm workspace's node_modules enters the archive.
+
+import fs from "node:fs";
+import { createRequire } from "node:module";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+export const APP_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+/** Packages with a compiled binding the main process loads at run time. */
+export const NATIVE_MODULES = Object.freeze(["node-pty"]);
+/** The Linux/Windows app id; also the desktop entry's file name on Linux. */
+export const APP_ID = "ai.indus.desktop";
+export const PACKAGE_NAME = "indus-desktop";
+
+/** Parts of a native module's folder that never ship (sources, build scripts, typings). */
+const SKIP_IN_MODULE = new Set([
+  "src",
+  "deps",
+  "third_party",
+  "scripts",
+  "typings",
+  "binding.gyp",
+  "node_modules",
+  "test",
+  "tests",
+]);
+
+function copyTree(from, to, keep = () => true) {
+  fs.mkdirSync(to, { recursive: true });
+  for (const entry of fs.readdirSync(from, { withFileTypes: true })) {
+    const source = path.join(from, entry.name);
+    const target = path.join(to, entry.name);
+    if (!keep(source, entry)) continue;
+    if (entry.isDirectory()) copyTree(source, target, keep);
+    else if (entry.isFile()) {
+      fs.copyFileSync(source, target);
+      fs.chmodSync(target, fs.statSync(source).mode & 0o777);
+    }
+  }
+}
+
+const noMaps = (_source, entry) => !(entry.isFile() && entry.name.endsWith(".map"));
+
+function listFiles(dir) {
+  const out = [];
+  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+    const full = path.join(dir, entry.name);
+    if (entry.isDirectory()) out.push(...listFiles(full));
+    else out.push(full);
+  }
+  return out;
+}
+
+/**
+ * Copy one native module for `platform`: package.json, licence, readme, `lib/`, the files directly
+ * in `build/Release/` (the binding and helpers such as `spawn-helper`), and `prebuilds/<platform>-*`.
+ */
+export function copyNativeModule(moduleDir, target, platform) {
+  copyTree(moduleDir, target, (source, entry) => {
+    const rel = path.relative(moduleDir, source).split(path.sep);
+    const top = rel[0] ?? "";
+    if (rel.length === 1 && SKIP_IN_MODULE.has(top)) return false;
+    if (entry.isFile() && /\.(?:ts|tsx|mts|cts|map|cc|cpp|h|gyp|gypi)$/.test(entry.name)) {
+      return false; // sources, typings and maps (`.d.ts` included)
+    }
+    if (entry.isFile() && /\.test\.js$/.test(entry.name)) return false;
+    if (top === "build") {
+      // build/ and build/Release/ only; the object files and makefiles under it never ship
+      if (rel.length === 1) return entry.isDirectory();
+      if (rel.length === 2) return rel[1] === "Release";
+      if (rel.length === 3) return rel[1] === "Release" && entry.isFile();
+      return false;
+    }
+    if (top === "prebuilds" && rel.length >= 2) return (rel[1] ?? "").startsWith(`${platform}-`);
+    return true;
+  });
+  const bindings = listFiles(target).filter((file) => file.endsWith(".node"));
+  if (bindings.length === 0) {
+    throw new Error(
+      `stage: ${path.basename(moduleDir)} has no compiled binding for ${platform} ` +
+        "(build it first: pnpm install with a C++ toolchain, or add a prebuild)",
+    );
+  }
+  return bindings;
+}
+
+/** A package's runtime dependencies resolved from its own folder (names → folders). */
+function runtimeDependencies(moduleDir) {
+  const pkg = JSON.parse(fs.readFileSync(path.join(moduleDir, "package.json"), "utf8"));
+  const resolver = createRequire(path.join(moduleDir, "package.json"));
+  const out = [];
+  for (const name of Object.keys(pkg.dependencies ?? {})) {
+    out.push([name, path.dirname(resolver.resolve(`${name}/package.json`))]);
+  }
+  return out;
+}
+
+/**
+ * Stage `appDir`'s build into `outDir`. `stamp` gives the version; `platform` picks prebuilds.
+ * Returns `{ outDir, packageJson, natives }`.
+ */
+export function stageApp({
+  appDir = APP_DIR,
+  outDir = path.join(APP_DIR, "build", "app"),
+  stamp,
+  platform = process.platform,
+}) {
+  if (stamp === undefined || typeof stamp.version !== "string") {
+    throw new Error("stage: a build stamp (with a version) is required");
+  }
+  const desktop = JSON.parse(fs.readFileSync(path.join(appDir, "package.json"), "utf8"));
+  for (const built of ["dist/index.html", "dist-electron/main.js", "dist-electron/preload.cjs"]) {
+    if (!fs.existsSync(path.join(appDir, built))) {
+      throw new Error(`stage: ${built} is missing (run the renderer and main builds first)`);
+    }
+  }
+
+  fs.rmSync(outDir, { recursive: true, force: true });
+  fs.mkdirSync(outDir, { recursive: true });
+  copyTree(path.join(appDir, "dist"), path.join(outDir, "dist"), noMaps);
+  copyTree(path.join(appDir, "dist-electron"), path.join(outDir, "dist-electron"), noMaps);
+
+  const resolver = createRequire(path.join(appDir, "package.json"));
+  const declared = { ...(desktop.dependencies ?? {}), ...(desktop.optionalDependencies ?? {}) };
+  const dependencies = {};
+  const natives = [];
+  for (const name of NATIVE_MODULES) {
+    if (!(name in declared)) continue;
+    const moduleDir = path.dirname(resolver.resolve(`${name}/package.json`));
+    const version = JSON.parse(
+      fs.readFileSync(path.join(moduleDir, "package.json"), "utf8"),
+    ).version;
+    dependencies[name] = version;
+    const bindings = copyNativeModule(moduleDir, path.join(outDir, "node_modules", name), platform);
+    natives.push({ name, version, bindings: bindings.map((b) => path.relative(outDir, b)) });
+    const queue = runtimeDependencies(moduleDir);
+    const seen = new Set([name]);
+    while (queue.length > 0) {
+      const [dep, depDir] = queue.shift();
+      if (seen.has(dep)) continue;
+      seen.add(dep);
+      copyTree(depDir, path.join(outDir, "node_modules", dep), (_s, entry) => {
+        return !(entry.isDirectory() && entry.name === "node_modules");
+      });
+      queue.push(...runtimeDependencies(depDir));
+    }
+  }
+
+  const packageJson = {
+    name: PACKAGE_NAME,
+    productName: desktop.productName ?? "Indus",
+    version: stamp.version,
+    description: desktop.description ?? "Indus Agent desktop app",
+    author: { name: "Indus Agent contributors" },
+    license: "MIT",
+    type: "module",
+    main: "dist-electron/main.js",
+    desktopName: `${APP_ID}.desktop`,
+    dependencies,
+  };
+  fs.writeFileSync(
+    path.join(outDir, "package.json"),
+    `${JSON.stringify(packageJson, null, 2)}\n`,
+    "utf8",
+  );
+  return { outDir, packageJson, natives };
+}
