diff --git a/apps/desktop/electron/linuxLauncher.test.ts b/apps/desktop/electron/linuxLauncher.test.ts
new file mode 100644
index 0000000..65480ed
--- /dev/null
+++ b/apps/desktop/electron/linuxLauncher.test.ts
@@ -0,0 +1,129 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import {
+  desktopEntry,
+  installLinuxLauncher,
+  type LauncherDeps,
+  quoteExecArg,
+  writeLinuxLauncher,
+} from "./linuxLauncher.ts";
+
+const dirs: string[] = [];
+afterAll(() => {
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function setup(overrides: Partial<LauncherDeps> = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "indus-launcher-"));
+  dirs.push(root);
+  const resources = path.join(root, "resources");
+  fs.mkdirSync(path.join(resources, "icons"), { recursive: true });
+  fs.writeFileSync(path.join(resources, "icons", "indus.png"), "png");
+  const lines: string[] = [];
+  const deps: LauncherDeps = {
+    platform: "linux",
+    packaged: true,
+    env: { APPIMAGE: path.join(root, "Apps", "Indus 0.1.AppImage") },
+    homeDir: path.join(root, "home"),
+    resourcesPath: resources,
+    scheme: "indus",
+    log: (line) => lines.push(line),
+    ...overrides,
+  };
+  const entry = path.join(
+    root,
+    "home",
+    ".local",
+    "share",
+    "applications",
+    "ai.indus.desktop.desktop",
+  );
+  return { root, deps, lines, entry };
+}
+
+describe("Linux launcher entry", () => {
+  it("quotes the AppImage path for the Exec line", () => {
+    expect(quoteExecArg("/opt/Indus.AppImage")).toBe("/opt/Indus.AppImage");
+    expect(quoteExecArg('/home/a b/$x"`\\.AppImage')).toBe('"/home/a b/\\$x\\"\\`\\\\.AppImage"');
+    expect(quoteExecArg("/tmp/100%")).toBe("/tmp/100%%");
+  });
+
+  it("registers the deep-link scheme and passes links with %U", () => {
+    const text = desktopEntry({ execPath: "/opt/Indus.AppImage", scheme: "indus" });
+    expect(text).toContain("Exec=/opt/Indus.AppImage %U\n");
+    expect(text).toContain("MimeType=x-scheme-handler/indus;\n");
+    expect(text).toContain("Icon=ai.indus.desktop\n");
+    expect(text.startsWith("[Desktop Entry]\nType=Application\n")).toBe(true);
+  });
+
+  it("writes the entry and the icon once, and does not rewrite an unchanged entry", () => {
+    const { deps, entry, root } = setup();
+    expect(writeLinuxLauncher(deps)).toEqual({ written: true, file: entry });
+    expect(fs.readFileSync(entry, "utf8")).toContain('Exec="');
+    const icon = path.join(
+      root,
+      "home/.local/share/icons/hicolor/256x256/apps/ai.indus.desktop.png",
+    );
+    expect(fs.readFileSync(icon, "utf8")).toBe("png");
+    expect(writeLinuxLauncher(deps)).toEqual({ written: false, reason: "unchanged" });
+  });
+
+  it("honours XDG_DATA_HOME", () => {
+    const { deps, root } = setup();
+    const data = path.join(root, "data");
+    const out = writeLinuxLauncher({ ...deps, env: { ...deps.env, XDG_DATA_HOME: data } });
+    expect(out).toEqual({
+      written: true,
+      file: path.join(data, "applications", "ai.indus.desktop.desktop"),
+    });
+  });
+
+  it("does nothing outside a packaged Linux AppImage", () => {
+    expect(writeLinuxLauncher(setup({ platform: "darwin" }).deps)).toEqual({
+      written: false,
+      reason: "not-linux",
+    });
+    expect(writeLinuxLauncher(setup({ packaged: false }).deps).written).toBe(false);
+    expect(writeLinuxLauncher(setup({ env: {} }).deps)).toEqual({
+      written: false,
+      reason: "not-appimage",
+    });
+  });
+
+  it("a write failure is logged, never thrown", () => {
+    const { deps, lines } = setup({
+      fs: {
+        readFile: () => null,
+        exists: () => true,
+        copyFile: () => {},
+        writeFileAtomic: () => {
+          throw new Error("read-only file system");
+        },
+      },
+    });
+    expect(writeLinuxLauncher(deps)).toEqual({ written: false, reason: "failed" });
+    expect(lines.join("\n")).toContain("read-only file system");
+  });
+
+  it("waits for the window to be shown", () => {
+    const { deps, entry } = setup();
+    let show: (() => void) | null = null;
+    installLinuxLauncher(
+      {
+        isVisible: () => false,
+        on: (_event: string, listener: () => void) => {
+          show = listener;
+        },
+      },
+      deps,
+    );
+    expect(fs.existsSync(entry)).toBe(false);
+    (show as (() => void) | null)?.();
+    expect(fs.existsSync(entry)).toBe(true);
+    fs.rmSync(entry);
+    (show as (() => void) | null)?.(); // a later show does not write again
+    expect(fs.existsSync(entry)).toBe(false);
+  });
+});
diff --git a/apps/desktop/electron/linuxLauncher.ts b/apps/desktop/electron/linuxLauncher.ts
new file mode 100644
index 0000000..6f37496
--- /dev/null
+++ b/apps/desktop/electron/linuxLauncher.ts
@@ -0,0 +1,146 @@
+// Linux launcher entry for the AppImage build (P20-38). An AppImage installs nothing, so the app
+// adds itself to the desktop's application menu: once the main window is first visible it writes
+// `<data home>/applications/ai.indus.desktop.desktop` (Exec = the AppImage file, with `%U` so
+// `indus://` links reach it) and copies its icon into the hicolor theme. Only for a packaged
+// AppImage, only when the content changed, never fatal.
+
+import fs from "node:fs";
+import path from "node:path";
+
+export const LAUNCHER_ID = "ai.indus.desktop";
+export const LAUNCHER_ICON_SIZE = 256;
+
+export interface LauncherInput {
+  /** The AppImage file (`APPIMAGE`); quoted for the Exec line. */
+  execPath: string;
+  /** The deep-link scheme the app registered (`indus`, or `indus-dev` in dev). */
+  scheme: string;
+  name?: string;
+}
+
+/** Quote one argument for a desktop entry Exec line (spec: double quotes, escape `"`, `` ` ``, `$`, `\`). */
+export function quoteExecArg(arg: string): string {
+  if (/^[A-Za-z0-9_@%+=:,./-]+$/.test(arg)) return arg.replaceAll("%", "%%");
+  return `"${arg.replace(/(["`$\\])/g, "\\$1").replaceAll("%", "%%")}"`;
+}
+
+/** The desktop entry text. */
+export function desktopEntry(input: LauncherInput): string {
+  const name = input.name ?? "Indus";
+  return [
+    "[Desktop Entry]",
+    "Type=Application",
+    `Name=${name}`,
+    "Comment=Desktop app for Indus Agent",
+    `Exec=${quoteExecArg(input.execPath)} %U`,
+    `Icon=${LAUNCHER_ID}`,
+    "Terminal=false",
+    "Categories=Development;",
+    `MimeType=x-scheme-handler/${input.scheme};`,
+    `StartupWMClass=${name}`,
+    "X-Indus-Managed=true",
+    "",
+  ].join("\n");
+}
+
+export interface LauncherFs {
+  readFile(file: string): string | null;
+  writeFileAtomic(file: string, data: string | Buffer): void;
+  copyFile(from: string, to: string): void;
+  exists(file: string): boolean;
+}
+
+export const nodeLauncherFs: LauncherFs = {
+  readFile: (file) => {
+    try {
+      return fs.readFileSync(file, "utf8");
+    } catch {
+      return null;
+    }
+  },
+  writeFileAtomic: (file, data) => {
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    const temp = `${file}.${process.pid}.tmp`;
+    fs.writeFileSync(temp, data, { mode: 0o644 });
+    fs.renameSync(temp, file);
+  },
+  copyFile: (from, to) => {
+    fs.mkdirSync(path.dirname(to), { recursive: true });
+    fs.copyFileSync(from, to);
+  },
+  exists: (file) => fs.existsSync(file),
+};
+
+export interface LauncherDeps {
+  platform: string;
+  packaged: boolean;
+  env: Readonly<Record<string, string | undefined>>;
+  homeDir: string;
+  /** `process.resourcesPath` (the icon ships as `icons/indus.png` beside the archive). */
+  resourcesPath: string;
+  scheme: string;
+  log: (line: string) => void;
+  fs?: LauncherFs;
+}
+
+export type LauncherOutcome =
+  | { written: true; file: string }
+  | {
+      written: false;
+      reason: "not-linux" | "not-packaged" | "not-appimage" | "unchanged" | "failed";
+    };
+
+/** Write (or refresh) the launcher entry now. */
+export function writeLinuxLauncher(deps: LauncherDeps): LauncherOutcome {
+  if (deps.platform !== "linux") return { written: false, reason: "not-linux" };
+  if (!deps.packaged) return { written: false, reason: "not-packaged" };
+  const appImage = (deps.env.APPIMAGE ?? "").trim();
+  if (appImage === "" || !path.isAbsolute(appImage))
+    return { written: false, reason: "not-appimage" };
+  const files = deps.fs ?? nodeLauncherFs;
+  const dataHome =
+    deps.env.XDG_DATA_HOME !== undefined && path.isAbsolute(deps.env.XDG_DATA_HOME)
+      ? deps.env.XDG_DATA_HOME
+      : path.join(deps.homeDir, ".local", "share");
+  const file = path.join(dataHome, "applications", `${LAUNCHER_ID}.desktop`);
+  const icon = path.join(
+    dataHome,
+    "icons",
+    "hicolor",
+    `${LAUNCHER_ICON_SIZE}x${LAUNCHER_ICON_SIZE}`,
+    "apps",
+    `${LAUNCHER_ID}.png`,
+  );
+  const text = desktopEntry({ execPath: appImage, scheme: deps.scheme });
+  try {
+    if (!files.exists(icon))
+      files.copyFile(path.join(deps.resourcesPath, "icons", "indus.png"), icon);
+    if (files.readFile(file) === text) return { written: false, reason: "unchanged" };
+    files.writeFileAtomic(file, text);
+    deps.log(`[launcher] desktop entry written (${file})`);
+    return { written: true, file };
+  } catch (error) {
+    deps.log(
+      `[launcher] desktop entry not written: ${error instanceof Error ? error.message : String(error)}`,
+    );
+    return { written: false, reason: "failed" };
+  }
+}
+
+export interface ShownWindow {
+  isVisible(): boolean;
+  on(event: string, listener: (...args: never[]) => void): unknown;
+}
+
+/** Write the launcher entry after `win` is first visible (now, when it already is). */
+export function installLinuxLauncher(win: ShownWindow, deps: LauncherDeps): void {
+  if (deps.platform !== "linux" || !deps.packaged) return;
+  let done = false;
+  const run = () => {
+    if (done) return;
+    done = true;
+    writeLinuxLauncher(deps);
+  };
+  if (win.isVisible()) run();
+  else win.on("show", run);
+}
