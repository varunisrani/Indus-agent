diff --git a/apps/desktop/electron/contextMenu.test.ts b/apps/desktop/electron/contextMenu.test.ts
new file mode 100644
index 0000000..69dfb00
--- /dev/null
+++ b/apps/desktop/electron/contextMenu.test.ts
@@ -0,0 +1,239 @@
+import { describe, expect, it, vi } from "vitest";
+import type { MenuItem } from "./appMenu.ts";
+import {
+  type ContextMenuParamsLike,
+  contextMenuTemplate,
+  installContextMenus,
+  isLinuxFindShortcut,
+  type KeyInputLike,
+  type MenuContentsLike,
+} from "./contextMenu.ts";
+
+type Listener = (...args: unknown[]) => void;
+
+function fakeContents(id = 1) {
+  const listeners = new Map<string, Listener[]>();
+  const calls: string[] = [];
+  const contents = {
+    id,
+    on: (event: string, listener: Listener) => {
+      listeners.set(event, [...(listeners.get(event) ?? []), listener]);
+    },
+    replaceMisspelling: (word: string) => calls.push(`replace:${word}`),
+    cut: () => calls.push("cut"),
+    copy: () => calls.push("copy"),
+    paste: () => calls.push("paste"),
+    selectAll: () => calls.push("selectAll"),
+    copyImageAt: (x: number, y: number) => calls.push(`copyImage:${x},${y}`),
+    inspectElement: (x: number, y: number) => calls.push(`inspect:${x},${y}`),
+    isDestroyed: () => false,
+    session: {
+      addWordToSpellCheckerDictionary: (word: string) => {
+        calls.push(`learn:${word}`);
+        return true;
+      },
+    },
+  };
+  const fire = (event: string, ...args: unknown[]) => {
+    for (const listener of listeners.get(event) ?? []) listener(...args);
+  };
+  return { contents: contents as unknown as MenuContentsLike, calls, fire };
+}
+
+function params(overrides: Partial<ContextMenuParamsLike> = {}): ContextMenuParamsLike {
+  return {
+    x: 10,
+    y: 20,
+    isEditable: false,
+    misspelledWord: "",
+    dictionarySuggestions: [],
+    selectionText: "",
+    linkURL: "",
+    mediaType: "none",
+    editFlags: { canCut: false, canCopy: false, canPaste: false, canSelectAll: false },
+    ...overrides,
+  };
+}
+
+const labels = (menu: MenuItem[]) => menu.map((item) => item.label ?? `-${item.type}`);
+const click = (menu: MenuItem[], label: string) => menu.find((i) => i.label === label)?.click?.();
+
+describe("context menu", () => {
+  it("offers spelling suggestions (at most five) and Add to Dictionary in an editable field", () => {
+    const { contents, calls } = fakeContents();
+    const menu = contextMenuTemplate(
+      params({
+        isEditable: true,
+        misspelledWord: "teh",
+        dictionarySuggestions: ["the", "ten", "tea", "tech", "eh", "heh"],
+        editFlags: { canCut: true, canCopy: true, canPaste: true, canSelectAll: true },
+      }),
+      contents,
+      { dev: false, writeText: () => {} },
+    );
+    expect(labels(menu)).toEqual([
+      "the",
+      "ten",
+      "tea",
+      "tech",
+      "eh",
+      "Add to Dictionary",
+      "-separator",
+      "Cut",
+      "Copy",
+      "Paste",
+      "Select All",
+    ]);
+    click(menu, "tea");
+    click(menu, "Add to Dictionary");
+    click(menu, "Paste");
+    expect(calls).toEqual(["replace:tea", "learn:teh", "paste"]);
+  });
+
+  it("says so when Chromium has no suggestion", () => {
+    const { contents } = fakeContents();
+    const menu = contextMenuTemplate(
+      params({ isEditable: true, misspelledWord: "zzqx" }),
+      contents,
+      { dev: false, writeText: () => {} },
+    );
+    expect(menu[0]).toEqual({ label: "No Spelling Suggestions", enabled: false });
+  });
+
+  it("offers Copy for selected read-only text and nothing for an empty spot", () => {
+    const { contents } = fakeContents();
+    const options = { dev: false, writeText: () => {} };
+    const flags = { canCut: true, canCopy: true, canPaste: true, canSelectAll: true };
+    expect(
+      labels(
+        contextMenuTemplate(params({ selectionText: "hi", editFlags: flags }), contents, options),
+      ),
+    ).toEqual(["Copy"]);
+    expect(contextMenuTemplate(params(), contents, options)).toEqual([]);
+  });
+
+  it("copies http, https and mailto links as text and never offers to open one", () => {
+    const { contents } = fakeContents();
+    const writeText = vi.fn();
+    for (const link of ["https://example.com/a", "http://x.test", "mailto:a@example.com"]) {
+      const menu = contextMenuTemplate(params({ linkURL: link }), contents, {
+        dev: false,
+        writeText,
+      });
+      expect(labels(menu)).toEqual(["Copy Link"]);
+      click(menu, "Copy Link");
+    }
+    expect(writeText.mock.calls.map((c) => c[0])).toEqual([
+      "https://example.com/a",
+      "http://x.test",
+      "mailto:a@example.com",
+    ]);
+    for (const link of ["javascript:alert(1)", "file:///etc/passwd", "indus://open/x"]) {
+      expect(
+        contextMenuTemplate(params({ linkURL: link }), contents, { dev: false, writeText }),
+      ).toEqual([]);
+    }
+  });
+
+  it("copies an image at the click point; Inspect Element only in dev", () => {
+    const { contents, calls } = fakeContents();
+    const menu = contextMenuTemplate(params({ mediaType: "image" }), contents, {
+      dev: true,
+      writeText: () => {},
+    });
+    expect(labels(menu)).toEqual(["Copy Image", "-separator", "Inspect Element"]);
+    click(menu, "Copy Image");
+    click(menu, "Inspect Element");
+    expect(calls).toEqual(["copyImage:10,20", "inspect:10,20"]);
+    expect(
+      labels(
+        contextMenuTemplate(params({ mediaType: "image" }), contents, {
+          dev: false,
+          writeText: () => {},
+        }),
+      ),
+    ).toEqual(["Copy Image"]);
+  });
+});
+
+function key(overrides: Partial<KeyInputLike> = {}): KeyInputLike {
+  return {
+    type: "keyDown",
+    key: "f",
+    control: true,
+    meta: false,
+    alt: false,
+    shift: false,
+    ...overrides,
+  };
+}
+
+describe("Linux find shortcut", () => {
+  it("is Ctrl+F alone on Linux only", () => {
+    expect(isLinuxFindShortcut(key(), "linux")).toBe(true);
+    expect(isLinuxFindShortcut(key({ key: "F" }), "linux")).toBe(true);
+    expect(isLinuxFindShortcut(key(), "darwin")).toBe(false);
+    expect(isLinuxFindShortcut(key(), "win32")).toBe(false);
+    expect(isLinuxFindShortcut(key({ shift: true }), "linux")).toBe(false);
+    expect(isLinuxFindShortcut(key({ alt: true }), "linux")).toBe(false);
+    expect(isLinuxFindShortcut(key({ type: "keyUp" }), "linux")).toBe(false);
+    expect(isLinuxFindShortcut(key({ isAutoRepeat: true }), "linux")).toBe(false);
+  });
+
+  function install(platform: string, appWindow: boolean) {
+    const created: Array<(c: MenuContentsLike) => void> = [];
+    const opened: number[] = [];
+    const popups: string[][] = [];
+    installContextMenus({
+      dev: false,
+      platform,
+      onWebContentsCreated: (listener) => created.push(listener),
+      popup: (template) => popups.push(labels(template)),
+      writeText: () => {},
+      isAppWindow: () => appWindow,
+      emitFindOpen: (contents) => opened.push(contents.id),
+    });
+    const fake = fakeContents(9);
+    for (const listener of created) listener(fake.contents);
+    return { fake, opened, popups };
+  }
+
+  it("is claimed in app windows and opens that window's find bar", () => {
+    const { fake, opened } = install("linux", true);
+    const event = { preventDefault: vi.fn() };
+    fake.fire("before-input-event", event, key());
+    expect(event.preventDefault).toHaveBeenCalledOnce();
+    expect(opened).toEqual([9]);
+    const other = { preventDefault: vi.fn() };
+    fake.fire("before-input-event", other, key({ key: "g" }));
+    expect(other.preventDefault).not.toHaveBeenCalled();
+  });
+
+  it("is left alone in preview guests and on macOS/Windows", () => {
+    for (const [platform, appWindow] of [
+      ["linux", false],
+      ["darwin", true],
+      ["win32", true],
+    ] as const) {
+      const { fake, opened } = install(platform, appWindow);
+      const event = { preventDefault: vi.fn() };
+      fake.fire("before-input-event", event, key());
+      expect(event.preventDefault).not.toHaveBeenCalled();
+      expect(opened).toEqual([]);
+    }
+  });
+
+  it("every created web contents gets the context menu", () => {
+    const { fake, popups } = install("darwin", false);
+    fake.fire(
+      "context-menu",
+      {},
+      params({
+        selectionText: "x",
+        editFlags: { canCut: false, canCopy: true, canPaste: false, canSelectAll: false },
+      }),
+    );
+    fake.fire("context-menu", {}, params());
+    expect(popups).toEqual([["Copy"]]);
+  });
+});
diff --git a/apps/desktop/electron/contextMenu.ts b/apps/desktop/electron/contextMenu.ts
new file mode 100644
index 0000000..87e5c17
--- /dev/null
+++ b/apps/desktop/electron/contextMenu.ts
@@ -0,0 +1,198 @@
+// The native context menu and the Linux find shortcut (P20-39).
+//
+// Right-click anywhere (app windows and preview guests alike) builds a menu from what Chromium
+// reports: spelling suggestions and "Add to Dictionary" for a misspelled word in an editable
+// field, the edit actions its flags allow, "Copy Link" for http/https/mailto links (copied as text;
+// no menu item ever opens a link, D-16.20), "Copy Image", and "Inspect Element" in dev builds.
+//
+// On Linux some desktops take Ctrl+F before the page sees it, so main claims it for app windows
+// and tells that window to open its find bar (`indus:find:open`); macOS and Windows leave the key
+// to the renderer.
+
+import type { MenuItem } from "./appMenu.ts";
+
+export const MAX_SPELLING_SUGGESTIONS = 5;
+const COPYABLE_LINK = /^(?:https?:|mailto:)/i;
+
+export interface ContextMenuParamsLike {
+  x: number;
+  y: number;
+  isEditable: boolean;
+  misspelledWord: string;
+  dictionarySuggestions: string[];
+  selectionText: string;
+  linkURL: string;
+  mediaType: string;
+  hasImageContents?: boolean;
+  editFlags: {
+    canCut: boolean;
+    canCopy: boolean;
+    canPaste: boolean;
+    canSelectAll: boolean;
+  };
+}
+
+export interface MenuContentsLike {
+  readonly id: number;
+  on(event: string, listener: (...args: never[]) => void): unknown;
+  replaceMisspelling(word: string): void;
+  cut(): void;
+  copy(): void;
+  paste(): void;
+  selectAll(): void;
+  copyImageAt(x: number, y: number): void;
+  inspectElement(x: number, y: number): void;
+  isDestroyed(): boolean;
+  readonly session: { addWordToSpellCheckerDictionary(word: string): boolean };
+}
+
+export interface ContextMenuOptions {
+  dev: boolean;
+  writeText: (text: string) => void;
+}
+
+const separator: MenuItem = { type: "separator" };
+
+/** The menu for one right-click; empty when there is nothing to offer. */
+export function contextMenuTemplate(
+  params: ContextMenuParamsLike,
+  contents: MenuContentsLike,
+  options: ContextMenuOptions,
+): MenuItem[] {
+  const groups: MenuItem[][] = [];
+
+  if (params.isEditable && params.misspelledWord.trim() !== "") {
+    const suggestions = params.dictionarySuggestions.slice(0, MAX_SPELLING_SUGGESTIONS);
+    const word = params.misspelledWord;
+    groups.push([
+      ...(suggestions.length === 0
+        ? [{ label: "No Spelling Suggestions", enabled: false } as MenuItem]
+        : suggestions.map((suggestion) => ({
+            label: suggestion,
+            click: () => contents.replaceMisspelling(suggestion),
+          }))),
+      {
+        label: "Add to Dictionary",
+        click: () => {
+          contents.session.addWordToSpellCheckerDictionary(word);
+        },
+      },
+    ]);
+  }
+
+  const edit: MenuItem[] = [];
+  const flags = params.editFlags;
+  if (params.isEditable && flags.canCut) edit.push({ label: "Cut", click: () => contents.cut() });
+  if (flags.canCopy && (params.isEditable || params.selectionText.trim() !== "")) {
+    edit.push({ label: "Copy", click: () => contents.copy() });
+  }
+  if (params.isEditable && flags.canPaste) {
+    edit.push({ label: "Paste", click: () => contents.paste() });
+  }
+  if (flags.canSelectAll && params.isEditable) {
+    edit.push({ label: "Select All", click: () => contents.selectAll() });
+  }
+  if (edit.length > 0) groups.push(edit);
+
+  const extra: MenuItem[] = [];
+  const link = params.linkURL.trim();
+  if (link !== "" && COPYABLE_LINK.test(link)) {
+    extra.push({ label: "Copy Link", click: () => options.writeText(link) });
+  }
+  if (params.mediaType === "image" && params.hasImageContents !== false) {
+    extra.push({ label: "Copy Image", click: () => contents.copyImageAt(params.x, params.y) });
+  }
+  if (extra.length > 0) groups.push(extra);
+
+  if (options.dev) {
+    groups.push([
+      { label: "Inspect Element", click: () => contents.inspectElement(params.x, params.y) },
+    ]);
+  }
+
+  const menu: MenuItem[] = [];
+  for (const group of groups) {
+    if (menu.length > 0) menu.push(separator);
+    menu.push(...group);
+  }
+  return menu;
+}
+
+export interface ContextMenuDeps extends ContextMenuOptions {
+  /** Show a template as a native popup over `contents` (`Menu.buildFromTemplate(…).popup`). */
+  popup(template: MenuItem[], contents: MenuContentsLike): void;
+}
+
+/** Attach the context menu to one web contents. */
+export function installContextMenu(contents: MenuContentsLike, deps: ContextMenuDeps): void {
+  contents.on("context-menu", ((_event: unknown, params: ContextMenuParamsLike) => {
+    if (contents.isDestroyed()) return;
+    const template = contextMenuTemplate(params, contents, deps);
+    if (template.length > 0) deps.popup(template, contents);
+  }) as (...args: never[]) => void);
+}
+
+export interface KeyInputLike {
+  type: string;
+  key: string;
+  control: boolean;
+  meta: boolean;
+  alt: boolean;
+  shift: boolean;
+  isAutoRepeat?: boolean;
+}
+
+/** Ctrl+F (no other modifier) on Linux; nothing elsewhere. */
+export function isLinuxFindShortcut(input: KeyInputLike, platform: string): boolean {
+  return (
+    platform === "linux" &&
+    input.type === "keyDown" &&
+    input.isAutoRepeat !== true &&
+    input.control &&
+    !input.alt &&
+    !input.meta &&
+    !input.shift &&
+    input.key.toLowerCase() === "f"
+  );
+}
+
+export interface FindShortcutDeps {
+  platform: string;
+  /** Only windows the window manager made (not preview guests). */
+  isAppWindow(contentsId: number): boolean;
+  openFind(contents: MenuContentsLike): void;
+}
+
+/** Claim the Linux Ctrl+F for app windows and ask the window to open its find bar. */
+export function installFindShortcut(contents: MenuContentsLike, deps: FindShortcutDeps): void {
+  if (deps.platform !== "linux") return;
+  contents.on("before-input-event", ((event: { preventDefault(): void }, input: KeyInputLike) => {
+    if (!isLinuxFindShortcut(input, deps.platform) || !deps.isAppWindow(contents.id)) return;
+    event.preventDefault();
+    deps.openFind(contents);
+  }) as (...args: never[]) => void);
+}
+
+export interface ContextMenusInstall {
+  dev: boolean;
+  platform: string;
+  /** `app.on("web-contents-created", …)`. */
+  onWebContentsCreated(listener: (contents: MenuContentsLike) => void): void;
+  popup(template: MenuItem[], contents: MenuContentsLike): void;
+  writeText(text: string): void;
+  isAppWindow(contentsId: number): boolean;
+  /** Push `indus:find:open` to that window (the registry's emit). */
+  emitFindOpen(contents: MenuContentsLike): void;
+}
+
+/** One install step for main: context menus everywhere, the Linux find shortcut in app windows. */
+export function installContextMenus(deps: ContextMenusInstall): void {
+  deps.onWebContentsCreated((contents) => {
+    installContextMenu(contents, deps);
+    installFindShortcut(contents, {
+      platform: deps.platform,
+      isAppWindow: deps.isAppWindow,
+      openFind: deps.emitFindOpen,
+    });
+  });
+}
