+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+// @ts-expect-error -- plain JS module without types
+import { copyNativeModule, stageApp } from "./stage-app.mjs";
+
+interface Staged {
+  outDir: string;
+  packageJson: Record<string, unknown>;
+  natives: Array<{ name: string; version: string; bindings: string[] }>;
+}
+const stage = stageApp as (options: {
+  appDir: string;
+  outDir: string;
+  stamp?: { version: string };
+  platform?: string;
+}) => Staged;
+const copyNative = copyNativeModule as (from: string, to: string, platform: string) => string[];
+
+const dirs: string[] = [];
+afterAll(() => {
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function write(root: string, files: Record<string, string>) {
+  for (const [file, text] of Object.entries(files)) {
+    const full = path.join(root, ...file.split("/"));
+    fs.mkdirSync(path.dirname(full), { recursive: true });
+    fs.writeFileSync(full, text);
+  }
+}
+
+function files(root: string): string[] {
+  const out: string[] = [];
+  const walk = (dir: string) => {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const full = path.join(dir, entry.name);
+      if (entry.isDirectory()) walk(full);
+      else out.push(path.relative(root, full).split(path.sep).join("/"));
+    }
+  };
+  walk(root);
+  return out.sort();
+}
+
+const PTY_FILES = {
+  "node_modules/node-pty/package.json": JSON.stringify({
+    name: "node-pty",
+    version: "1.1.0",
+    main: "./lib/index.js",
+    dependencies: { "node-addon-api": "^7.1.0" },
+  }),
+  "node_modules/node-pty/LICENSE": "licence",
+  "node_modules/node-pty/lib/index.js": "module.exports = {}",
+  "node_modules/node-pty/lib/index.js.map": "{}",
+  "node_modules/node-pty/typings/node-pty.d.ts": "x",
+  "node_modules/node-pty/src/unix/pty.cc": "x",
+  "node_modules/node-pty/binding.gyp": "x",
+  "node_modules/node-pty/deps/winpty/x.h": "x",
+  "node_modules/node-pty/build/Makefile": "x",
+  "node_modules/node-pty/build/Release/pty.node": "elf",
+  "node_modules/node-pty/build/Release/obj.target/pty.o": "x",
+  "node_modules/node-pty/prebuilds/darwin-arm64/pty.node": "macho",
+  "node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper": "macho",
+  "node_modules/node-pty/prebuilds/win32-x64/conpty.dll": "pe",
+  "node_modules/node-addon-api/package.json": JSON.stringify({
+    name: "node-addon-api",
+    version: "7.1.1",
+  }),
+  "node_modules/node-addon-api/napi.h": "x",
+};
+
+function app(extra: Record<string, string> = {}, deps: Record<string, string> = {}) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "indus-stage-"));
+  dirs.push(root);
+  write(root, {
+    "package.json": JSON.stringify({
+      name: "@indus/desktop",
+      productName: "Indus",
+      version: "0.0.0",
+      description: "Indus Agent desktop app (Electron)",
+      dependencies: { react: "19.3.0", ...deps },
+    }),
+    "dist/index.html": "<!doctype html>",
+    "dist/assets/index-1.js": "x",
+    "dist/assets/index-1.js.map": "{}",
+    "dist-electron/main.js": "x",
+    "dist-electron/main.js.map": "{}",
+    "dist-electron/preload.cjs": "x",
+    "electron/main.ts": "x",
+    "src/main.tsx": "x",
+    ...extra,
+  });
+  return root;
+}
+
+describe("stage the packaged app", () => {
+  it("holds only the bundles and a generated package.json without dependencies", () => {
+    const root = app();
+    const out = path.join(root, "build", "app");
+    const staged = stage({ appDir: root, outDir: out, stamp: { version: "0.4.2" } });
+    expect(files(out)).toEqual([
+      "dist-electron/main.js",
+      "dist-electron/preload.cjs",
+      "dist/assets/index-1.js",
+      "dist/index.html",
+      "package.json",
+    ]);
+    expect(staged.packageJson).toMatchObject({
+      name: "indus-desktop",
+      productName: "Indus",
+      version: "0.4.2",
+      type: "module",
+      main: "dist-electron/main.js",
+      desktopName: "ai.indus.desktop.desktop",
+      dependencies: {},
+    });
+    expect(JSON.parse(fs.readFileSync(path.join(out, "package.json"), "utf8"))).toEqual(
+      staged.packageJson,
+    );
+  });
+
+  it("copies a declared node-pty with its binding, platform prebuilds and runtime deps only", () => {
+    const root = app(PTY_FILES, { "node-pty": "1.1.0" });
+    const out = path.join(root, "build", "app");
+    const staged = stage({
+      appDir: root,
+      outDir: out,
+      stamp: { version: "0.4.2" },
+      platform: "darwin",
+    });
+    const pty = files(out).filter((f) => f.startsWith("node_modules/"));
+    expect(pty).toEqual([
+      "node_modules/node-addon-api/napi.h",
+      "node_modules/node-addon-api/package.json",
+      "node_modules/node-pty/LICENSE",
+      "node_modules/node-pty/build/Release/pty.node",
+      "node_modules/node-pty/lib/index.js",
+      "node_modules/node-pty/package.json",
+      "node_modules/node-pty/prebuilds/darwin-arm64/pty.node",
+      "node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper",
+    ]);
+    expect(staged.packageJson.dependencies).toEqual({ "node-pty": "1.1.0" });
+    expect(staged.natives[0]?.bindings.length).toBe(2);
+  });
+
+  it("refuses a native module without a compiled binding for the platform", () => {
+    const root = app({
+      "node_modules/node-pty/package.json": JSON.stringify({ name: "node-pty", version: "1.1.0" }),
+      "node_modules/node-pty/lib/index.js": "x",
+      "node_modules/node-pty/prebuilds/win32-x64/pty.node": "pe",
+    });
+    expect(() =>
+      copyNative(path.join(root, "node_modules", "node-pty"), path.join(root, "out"), "linux"),
+    ).toThrow(/no compiled binding for linux/);
+  });
+
+  it("refuses to stage before the bundles are built or without a stamp", () => {
+    const root = app();
+    fs.rmSync(path.join(root, "dist-electron", "preload.cjs"));
+    const out = path.join(root, "build", "app");
+    expect(() => stage({ appDir: root, outDir: out, stamp: { version: "1.0.0" } })).toThrow(
+      /preload\.cjs is missing/,
+    );
+    expect(() => stage({ appDir: root, outDir: out })).toThrow(/build stamp/);
+  });
+});
diff --git a/apps/desktop/scripts/write-build-stamp.mjs b/apps/desktop/scripts/write-build-stamp.mjs
new file mode 100644
index 0000000..4a97f99
--- /dev/null
+++ b/apps/desktop/scripts/write-build-stamp.mjs
@@ -0,0 +1,179 @@
+// The build stamp (P20-38): `desktop-build-stamp.json`, shipped beside the app archive in the
+// packaged resources folder. It declares what this build is and who updates it; the runtime reads
+// it and never infers the update owner from anything else (P20-37).
+//
+//   node scripts/write-build-stamp.mjs --out FILE [--channel stable|canary] [--platform P]
+//        [--version V] [--commit SHA] [--update-owner electron-updater|manual]
+//
+// Fallbacks: INDUS_DESKTOP_CHANNEL, INDUS_DESKTOP_VERSION (else the root pyproject.toml version),
+// GITHUB_SHA (else `git rev-parse HEAD`, else "unknown"), SOURCE_DATE_EPOCH for the build time.
+
+import { spawnSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+export const STAMP_FILE = "desktop-build-stamp.json";
+export const STAMP_SCHEMA = 1;
+export const CHANNELS = Object.freeze(["stable", "canary"]);
+export const UPDATE_OWNERS = Object.freeze(["electron-updater", "manual"]);
+/** A build without an explicit channel is a test build, never stable by accident. */
+export const DEFAULT_CHANNEL = "canary";
+
+const APP_DIR = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const REPO_ROOT = path.resolve(APP_DIR, "..", "..");
+
+const SEMVER =
+  /^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/;
+const COMMIT = /^(?:[0-9a-f]{7,64}|unknown)$/;
+
+/**
+ * Who updates a build on `platform`: electron-updater for macOS (ZIP) and Linux (AppImage); the
+ * unsigned Windows build is updated by hand (signed NSIS feeds arrive with P23).
+ */
+export function updateOwnerFor(platform) {
+  if (platform === "darwin" || platform === "linux") return "electron-updater";
+  return "manual";
+}
+
+/** The `[project] version` of a pyproject.toml text, or null. */
+export function pyprojectVersion(text) {
+  let inProject = false;
+  for (const raw of text.split(/\r?\n/)) {
+    const line = raw.trim();
+    if (line.startsWith("[")) {
+      inProject = line === "[project]";
+      continue;
+    }
+    if (!inProject) continue;
+    const match = /^version\s*=\s*"([^"]+)"/.exec(line);
+    if (match) return match[1] ?? null;
+  }
+  return null;
+}
+
+function gitCommit(cwd) {
+  try {
+    const out = spawnSync("git", ["rev-parse", "HEAD"], {
+      cwd,
+      encoding: "utf8",
+      timeout: 5_000,
+      windowsHide: true,
+    });
+    const sha = (out.stdout ?? "").trim().toLowerCase();
+    return out.status === 0 && COMMIT.test(sha) ? sha : null;
+  } catch {
+    return null;
+  }
+}
+
+function fail(message) {
+  throw new Error(`build stamp: ${message}`);
+}
+
+/** Validate a stamp object; returns it unchanged or throws naming the bad field. */
+export function validateBuildStamp(stamp) {
+  if (stamp === null || typeof stamp !== "object") fail("not an object");
+  if (stamp.schema !== STAMP_SCHEMA) fail(`schema must be ${STAMP_SCHEMA}`);
+  if (typeof stamp.version !== "string" || !SEMVER.test(stamp.version))
+    fail(`version ${JSON.stringify(stamp.version)} is not SemVer`);
+  if (typeof stamp.commit !== "string" || !COMMIT.test(stamp.commit))
+    fail(`commit ${JSON.stringify(stamp.commit)} is not a hex SHA`);
+  if (!CHANNELS.includes(stamp.channel))
+    fail(`channel ${JSON.stringify(stamp.channel)} is not one of ${CHANNELS.join(", ")}`);
+  if (!UPDATE_OWNERS.includes(stamp.updateOwner))
+    fail(
+      `updateOwner ${JSON.stringify(stamp.updateOwner)} is not one of ${UPDATE_OWNERS.join(", ")}`,
+    );
+  if (typeof stamp.platform !== "string" || stamp.platform === "") fail("platform missing");
+  if (typeof stamp.builtAt !== "string" || Number.isNaN(Date.parse(stamp.builtAt)))
+    fail("builtAt is not an ISO time");
+  return stamp;
+}
+
+/**
+ * Build the stamp from explicit options, then the environment, then the checkout.
+ * `env`, `readText` and `commitOf` are injectable for tests.
+ */
+export function makeBuildStamp(options = {}, deps = {}) {
+  const env = deps.env ?? process.env;
+  const readText = deps.readText ?? ((file) => fs.readFileSync(file, "utf8"));
+  const commitOf = deps.commitOf ?? gitCommit;
+  const platform = options.platform ?? process.platform;
+
+  let version = options.version ?? (env.INDUS_DESKTOP_VERSION || null);
+  if (version === null) {
+    try {
+      version = pyprojectVersion(readText(path.join(REPO_ROOT, "pyproject.toml")));
+    } catch {
+      version = null;
+    }
+  }
+  if (version === null) fail("no version (pass --version or set INDUS_DESKTOP_VERSION)");
+
+  const commit = (
+    options.commit ??
+    (env.GITHUB_SHA || null) ??
+    commitOf(REPO_ROOT) ??
+    "unknown"
+  ).toLowerCase();
+
+  const epoch = env.SOURCE_DATE_EPOCH;
+  const builtAt =
+    options.builtAt ??
+    (epoch && /^\d+$/.test(epoch)
+      ? new Date(Number(epoch) * 1000).toISOString()
+      : new Date().toISOString());
+
+  return validateBuildStamp({
+    schema: STAMP_SCHEMA,
+    version,
+    commit,
+    channel: options.channel ?? (env.INDUS_DESKTOP_CHANNEL || DEFAULT_CHANNEL),
+    updateOwner: options.updateOwner ?? updateOwnerFor(platform),
+    platform,
+    builtAt,
+  });
+}
+
+/** Write the stamp as pretty JSON (creating the folder); returns the stamp. */
+export function writeBuildStamp(file, options = {}, deps = {}) {
+  const stamp = makeBuildStamp(options, deps);
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, `${JSON.stringify(stamp, null, 2)}\n`, "utf8");
+  return stamp;
+}
+
+const FLAGS = {
+  "--out": "out",
+  "--channel": "channel",
+  "--platform": "platform",
+  "--version": "version",
+  "--commit": "commit",
+  "--update-owner": "updateOwner",
+};
+
+/** `--flag value` pairs → options; throws on an unknown flag or a missing value. */
+export function parseArgs(argv) {
+  const out = {};
+  for (let i = 0; i < argv.length; i += 2) {
+    const key = FLAGS[argv[i]];
+    const value = argv[i + 1];
+    if (key === undefined) throw new Error(`unknown argument ${argv[i]}`);
+    if (value === undefined || value.startsWith("--")) throw new Error(`${argv[i]} needs a value`);
+    out[key] = value;
+  }
+  return out;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    const { out, ...options } = parseArgs(process.argv.slice(2));
+    if (out === undefined) throw new Error("--out FILE is required");
+    const stamp = writeBuildStamp(path.resolve(out), options);
+    process.stdout.write(`${JSON.stringify(stamp)}\n`);
+  } catch (error) {
+    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
+    process.exit(2);
+  }
+}
diff --git a/apps/desktop/scripts/write-build-stamp.test.ts b/apps/desktop/scripts/write-build-stamp.test.ts
