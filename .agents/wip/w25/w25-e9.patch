+    return {
+        "schema": "2.0",
+        "header": wire._header("im.message.receive_v1"),  # pyright: ignore[reportPrivateUsage]
+        "event": {
+            "sender": {"sender_id": {"open_id": sender, "union_id": "on_" + sender}},
+            "message": {
+                "message_id": mid,
+                "chat_id": chat_id,
+                "chat_type": "p2p" if chat_id.startswith("ou_") else "group",
