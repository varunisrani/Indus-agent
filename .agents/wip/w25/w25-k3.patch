+        if epoch != self.replay_epoch:
+            return ReplayGap(session_id, self.replay_epoch, last, "epoch_changed")
+        if cursor > last:
+            return ReplayGap(session_id, self.replay_epoch, last, "ahead")
+        kept = sink.since(None)
