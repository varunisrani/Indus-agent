+# STAND-IN: removed at integration
+"""Stand-in for the daemon session host of P17-08 (built by K3 in parallel), only as far as the
+attach verbs (P17-11) read it.
+
+Assumed interface of ``indus.service.daemon_host.DaemonSessionHost`` (or whatever object the
+daemon hands to ``AttachVerbs(host=)``):
+
+- ``creatable_sources() -> Sequence[str]``: the surface kinds a client may create sessions as
+  (``cli``, ``tui``, ``gui``, ``acp``, ``web``; not ``messaging``, which the gateway creates);
+- ``capabilities() -> Sequence[str]``: capability names offered to attached clients;
+- both are plain synchronous reads of state the host already holds: they never await a turn,
+  take the turn lease or touch the store, so ``describe`` answers while turns run.
+
+At integration the real host replaces ``StubHost`` in ``test_attach_verbs.py`` (a turn started
+through the host's ``submit`` with the fake model parked on an approval instead of ``run_turn``).
+"""
+
+from __future__ import annotations
+
+import asyncio
+from collections.abc import Sequence
+from dataclasses import dataclass, field
+
+
+@dataclass
+class StubHost:
+    sources: tuple[str, ...] = ("cli", "tui", "gui", "acp", "web")
+    caps: tuple[str, ...] = ("replay", "server-requests", "decline")
+    running: set[str] = field(default_factory=set[str])
+
+    def creatable_sources(self) -> Sequence[str]:
+        return self.sources
+
+    def capabilities(self) -> Sequence[str]:
+        return self.caps
+
+    async def run_turn(self, session_id: str, release: asyncio.Event) -> None:
+        """A turn that stays running on the loop until ``release`` is set."""
+        self.running.add(session_id)
+        try:
+            await release.wait()
+        finally:
+            self.running.discard(session_id)
