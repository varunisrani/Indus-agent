+    joined = await other.request("session.subscribe", {"session_id": sid})
+    assert joined["result"]["session_id"] == sid
+    caught = await other.request(
+        "events.since", {"session_id": sid, "epoch": r.host.replay_epoch, "cursor": 0}
+    )
