+def test_an_attachment_from_an_untrusted_host_is_never_fetched() -> None:
+    async def main() -> None:
+        rig = Rig()
+        await rig.connect()
+        for url in (
+            "https://evil.example/file",
+            "http://chat.googleapis.com/v1/media/x",
