+class _Seat:
+    def __init__(self) -> None:
+        self.fetchers: dict[str, Any] = {}
+
+    def register_fetcher(self, platform: str, fetcher: Any) -> Callable[[], None]:
+        self.fetchers[platform] = fetcher
+        return lambda: self.fetchers.pop(platform, None) and None
