+
+
+def _modules_cell(modules: Iterable[str], limit: int = 3) -> str:
+    ordered = sorted(modules)
+    shown = ", ".join(code(m) for m in ordered[:limit])
+    extra = len(ordered) - limit
+    return shown + (f" and {extra} more" if extra > 0 else "")
+
+
+def platform_env(entries: Iterable[Any]) -> dict[str, list[tuple[str, str]]]:
+    """``env name -> [(platform label, role)]`` from the gateway's platform registry."""
+    out: dict[str, list[tuple[str, str]]] = {}
+    for entry in entries:
+        for attr, role in PLATFORM_ROLES:
+            value = getattr(entry, attr, None)
+            names = (value,) if isinstance(value, str) else tuple(value or ())
+            for name in names:
+                if name:
+                    out.setdefault(name, []).append((entry.label, role))
+    return out
+
+
+def render_env(scan: EnvScan | None = None) -> str:
+    from indus.gateway.registry import builtin_entries
+    from indus.providers import bundled
+
+    found = scan or scan_env()
+    platforms = platform_env(builtin_entries())
+    provider_names: dict[str, list[str]] = {}
+    for profile in bundled.PROFILES:
+        for name in (*profile.env_vars, profile.base_url_env_var):
+            if name:
+                provider_names.setdefault(name, []).append(profile.display_name or profile.name)
+    tool_secrets: dict[str, list[str]] = {}
+    for tool_name, entry in sorted(scan_tools().entries.items()):
+        for secret in entry.requires_secrets:
+            tool_secrets.setdefault(secret, []).append(tool_name)
+
+    body: list[str] = [
+        "Variables can be set in the shell or in the profile's `.env` file (the shell wins). "
+        "Keys and tokens are better kept in the keychain (`indus auth`); a variable of the "
+        "same name still works.",
+        "",
+        "## Indus Agent variables",
+        "",
+    ]
+    indus_rows = [
+        (code(name), cell(ENV_NOTES.get(name, "")), _modules_cell(mods))
+        for name, mods in sorted(found.indus.items())
+        if name not in platforms
+    ]
+    indus_rows += [
+        (code(prefix + "*"), "a family of names sharing this prefix", _modules_cell(mods))
+        for prefix, mods in sorted(found.prefixes.items())
+    ]
+    body += table(("Variable", "Notes", "Used in"), indus_rows) + [""]
+    body += ["## Model provider keys", ""]
+    body += table(
+        ("Variable", "Providers"),
+        [(code(n), cell(", ".join(p))) for n, p in sorted(provider_names.items())],
+    ) + [""]
+    body += ["## Messaging platforms", ""]
+    body += table(
+        ("Variable", "Platform", "Holds"),
+        [
+            (code(n), cell(", ".join(sorted({p for p, _ in uses}))), cell(uses[0][1]))
+            for n, uses in sorted(platforms.items())
+        ],
+    ) + [""]
+    if tool_secrets:
+        body += ["## Tool services", ""]
+        body += table(
+            ("Variable", "Tools"),
+            [
+                (code(n), ", ".join(code(t) for t in tools))
+                for n, tools in sorted(tool_secrets.items())
+            ],
+        ) + [""]
+    others = {
+        n: m
+        for n, m in found.other.items()
+        if n not in provider_names and n not in platforms and n not in tool_secrets
+    }
+    if others:
+        body += ["## Other variables read", ""]
+        body += [
+            "Standard and vendor variables the program also reads (proxies, editors, cloud "
+            "SDK settings and the like).",
+            "",
+        ]
+        body += table(
+            ("Variable", "Used in"),
+            [(code(n), _modules_cell(m)) for n, m in sorted(others.items())],
+        ) + [""]
+    return page(
+        "Environment variables",
+        "Every environment variable Indus Agent reads, found in its source code.",
+        body,
+    )
+
+
+# -- protocol -----------------------------------------------------------------------------------
+
+
+def _field_rows(model: type[Any]) -> list[tuple[str, ...]]:
+    rows: list[tuple[str, ...]] = []
+    for name, info in model.model_fields.items():
+        rows.append(
+            (
+                code(info.alias or name),
+                cell(type_text(info.annotation)),
+                "yes" if info.is_required() else "no",
+                cell(info.description or ""),
+            )
+        )
+    return rows
+
+
+def _fields_block(title: str, model: type[Any]) -> list[str]:
+    rows = _field_rows(model)
+    if not rows:
+        return [f"{title}: none.", ""]
+    return [f"{title}:", ""] + table(("Field", "Type", "Required", "Meaning"), rows) + [""]
+
+
+def render_protocol() -> str:
+    from indus.protocol import errors, events, methods, server_requests
+
+    body: list[str] = [
+        "The JSON-RPC protocol between the agent host and its surfaces (TUI, desktop, "
+        "dashboard, editors attached through the daemon). "
+        f"Protocol version: {methods.PROTOCOL_VERSION}.",
+        "",
+        "## Methods",
+        "",
+    ]
+    body += table(
+        ("Method", "What it does"),
+        [(f"[`{n}`](#{slug(n)})", cell(spec.summary)) for n, spec in methods.METHODS.items()],
+    ) + [""]
+    for name, spec in methods.METHODS.items():
+        body += [f"### {name}", "", spec.summary, ""]
+        body += _fields_block("Parameters", spec.params)
+        body += _fields_block("Result", spec.result)
+        body += ["Errors: " + ", ".join(code(e.name) for e in spec.errors) + ".", ""]
+    body += ["## Notifications", ""]
+    body += table(
+        ("Method", "What it carries"),
+        [(code(n), cell(first_line(m.__doc__))) for n, m in methods.NOTIFICATIONS.items()],
+    ) + [""]
+    body += ["## Events", ""]
+    body += table(
+        ("Event", "What it means"),
+        [(f"[`{n}`](#{slug(n)})", cell(first_line(m.__doc__))) for n, m in events.EVENTS.items()],
+    ) + [""]
+    for name, model in events.EVENTS.items():
+        body += [f"### {name}", "", first_paragraph(model.__doc__), ""]
+        body += _fields_block("Fields", model)
+    body += ["## Server requests", ""]
+    body += [
+        f"The host asks the person something through `{server_requests.SERVER_REQUEST_METHOD}`; "
+        "the surface answers with `server_request.answer`.",
+        "",
+    ]
+    for kind, (request, answer) in server_requests.SERVER_REQUEST_KINDS.items():
+        body += [f"### {kind}", "", first_paragraph(request.__doc__), ""]
+        body += _fields_block("Request", request)
+        body += _fields_block("Answer", answer)
+    body += ["## Error codes", ""]
+    body += [
+        "Each code has one meaning across every method (D-16.27). The group decides the HTTP "
+        "status a code maps to over HTTP.",
+        "",
+    ]
+    body += table(
+        ("Code", "Name", "Group", "HTTP", "Meaning"),
+        [
+            (
+                str(e.code),
+                code(e.name),
+                code(str(e.group)),
+                str(errors.GROUP_STATUS.get(e.group, "")),
+                cell(e.meaning),
+            )
+            for e in errors.ERROR_TABLE
+        ],
+    ) + [""]
+    if errors.OUT_OF_BAND_ERRORS:
+        body += ["Codes that never answer a method call, and where they travel:", ""]
+        body += table(
+            ("Name", "Where"),
+            [(code(e.name), cell(where)) for e, where in errors.OUT_OF_BAND_ERRORS.items()],
+        ) + [""]
+    return page("Protocol", "Methods, events and error codes of the agent protocol.", body)
+
+
+# -- MCP serve ----------------------------------------------------------------------------------
+
+
+def mcp_serve_tools() -> list[Any]:
+    """The tools of a server built by the same registration functions ``indus mcp serve`` uses
+    (the parts behind the tools are never called, so stand-ins are enough)."""
+    from mcp.server import MCPServer
+
+    from indus.mcp_serve import server as serve_module
+
+    built = MCPServer(serve_module.SERVER_NAME, instructions=serve_module.INSTRUCTIONS)
+    register = cast(Callable[..., None], serve_module._register)  # pyright: ignore[reportPrivateUsage]
+    register_approvals = cast(
+        Callable[..., None],
+        serve_module._register_approvals,  # pyright: ignore[reportPrivateUsage]
+    )
+    register(built, None, None, None)
+    register_approvals(built, None)
+    return list(asyncio.run(built.list_tools()))
+
+
+def render_mcp_serve() -> str:
+    from indus.mcp_serve import server as serve_module
+
+    tools = mcp_serve_tools()
+    body: list[str] = [
+        "`indus mcp serve` runs an MCP server on stdio that gives another agent or editor the "
+        "chats this profile's gateway is connected to. Every tool answers one JSON text; a "
+        "problem is a JSON object with an `error` field.",
+        "",
+    ]
+    body += table(
+        ("Tool", "What it does"),
+        [(f"[`{t.name}`](#{slug(t.name)})", cell(first_paragraph(t.description))) for t in tools],
+    ) + [""]
+    for tool in tools:
+        body += [f"## {tool.name}", ""]
+        if tool.name in serve_module.APPROVAL_TOOLS:
+            body += ["Offered only when the running daemon has an approval queue.", ""]
+        text = inspect.cleandoc(tool.description or "")
+        body += [text.split("\nArgs:", 1)[0].strip(), ""]
+        rows = _parameter_rows(cast(Mapping[str, Any], tool.input_schema))
+        if rows:
+            body += table(("Argument", "Type", "Required", "Default", "Meaning"), rows) + [""]
+    return page("MCP server tools", "The tools `indus mcp serve` offers.", body)
+
+
+# -- skills -------------------------------------------------------------------------------------
+
+
+def starter_skills(skills_dir: Path = SKILLS_DIR) -> list[tuple[str, str, str]]:
+    """``(name, category, description)`` of each ``SKILL.md`` under ``skills_dir``, sorted."""
+    from indus.learning.skills.format import parse_skill
+
+    out: list[tuple[str, str, str]] = []
+    for path in sorted(skills_dir.rglob("SKILL.md")):
+        parsed = parse_skill(path.read_text(encoding="utf-8"))
+        meta = parsed.frontmatter
+        category = meta.indus.category or path.parent.parent.name
+        out.append((meta.name, category, meta.description))
+    return sorted(out, key=lambda row: (row[1], row[0]))
+
+
+def render_skills() -> str:
+    rows = starter_skills()
+    body = [
+        "These skills ship with Indus Agent and are copied into every new profile. "
+        "`indus skills list` shows what a profile has; `/skills` in a chat does the same.",
+        "",
+    ]
+    body += table(
+        ("Skill", "Category", "What it is for"),
+        [(code(n), code(c), cell(d)) for n, c, d in rows],
+    )
+    return page("Starter skills", f"The {len(rows)} skills bundled with Indus Agent.", body)
+
+
+# -- messaging platforms and providers ----------------------------------------------------------
+
+
+def render_platforms() -> str:
+    from indus.gateway.registry import builtin_entries
+
+    rows = []
+    for entry in builtin_entries():
+        rows.append(
+            (
+                code(entry.name),
+                cell(entry.label),
+                ", ".join(code(n) for n in entry.required_env) or "—",
+                str(entry.max_len) if entry.max_len else "—",
+                cell(entry.install_hint) or "—",
+            )
+        )
+    body = [
+        "Set a platform's credential (in `.env`, the keychain or through `indus gateway "
+        "setup`) and enable it; `indus gateway run` starts every enabled platform. "
+        "Per-platform policy variables are listed in [Environment variables]"
+        "(environment-variables.md#messaging-platforms).",
+        "",
+    ]
+    body += table(
+        ("Name", "Platform", "Credential", "Longest message", "Install"),
+        rows,
+    )
+    return page(
+        "Messaging platforms",
+        "The platforms the messaging gateway can run, from its registry.",
+        body,
+    )
+
+
+def render_providers() -> str:
+    from indus.providers import bundled
+    from indus.providers.registry import LOCAL_SERVERS
+
+    def rows_for(profiles: Iterable[Any]) -> list[tuple[str, ...]]:
+        return [
+            (
+                code(p.name),
+                cell(p.display_name or p.name),
+                ", ".join(code(a) for a in p.aliases),
+                ", ".join(code(e) for e in p.env_vars),
+                code(p.base_url_env_var) if p.base_url_env_var else "",
+                code(p.base_url) if p.base_url else "",
+            )
+            for p in profiles
+            if not p.hidden
+        ]
+
+    headers = ("Name", "Provider", "Aliases", "Key variables", "Endpoint variable", "Endpoint")
+    body = ["## Catalogue", ""]
+    body += table(headers, rows_for(bundled.PROFILES)) + [""]
+    body += ["## Local servers", ""]
+    body += [
+        "Model servers on this machine at their usual ports; no key needed.",
+        "",
+    ]
+    body += table(headers, rows_for(LOCAL_SERVERS)) + [""]
+    body += [
+        "Any other OpenAI-compatible endpoint is added under `providers:` in `config.yaml` "
+        "(see [Configuration keys](configuration.md)).",
+    ]
+    return page(
+        "Model providers",
+        "The providers Indus Agent knows without any setup. `indus model` picks one.",
+        body,
+    )
+
+
+# -- driver -------------------------------------------------------------------------------------
+
+RENDERERS: Mapping[str, Callable[[], str]] = {
+    "cli.md": render_cli,
+    "slash-commands.md": render_slash,
+    "configuration.md": render_config,
+    "environment-variables.md": render_env,
+    "tools.md": render_tools,
+    "protocol.md": render_protocol,
+    "mcp-serve-tools.md": render_mcp_serve,
+    "skills.md": render_skills,
+    "messaging-platforms.md": render_platforms,
+    "providers.md": render_providers,
+}
+"""Page file name → renderer, in navigation order."""
+
+
+def render_all() -> dict[str, str]:
+    return {name: render() for name, render in RENDERERS.items()}
+
+
+def is_generated(path: Path) -> bool:
+    try:
+        with path.open(encoding="utf-8") as handle:
+            return handle.readline().rstrip("\n") == MARKER
+    except OSError:
+        return False
+
+
+def stale_report(out_dir: Path, pages: Mapping[str, str]) -> list[str]:
+    """One line per page that differs, is missing, or is generated but no longer produced."""
+    problems: list[str] = []
+    for name, text in pages.items():
+        path = out_dir / name
+        if not path.is_file():
+            problems.append(f"{name}: missing")
+        elif path.read_text(encoding="utf-8") != text:
+            problems.append(f"{name}: stale")
+    for path in sorted(out_dir.glob("*.md")):
+        if path.name not in pages and is_generated(path):
+            problems.append(f"{path.name}: generated page no longer produced")
+    return problems
+
+
+def write_pages(out_dir: Path, pages: Mapping[str, str]) -> list[str]:
+    """Write changed pages and remove orphaned generated ones; the names touched."""
+    out_dir.mkdir(parents=True, exist_ok=True)
+    touched: list[str] = []
+    for name, text in pages.items():
+        path = out_dir / name
+        if not path.is_file() or path.read_text(encoding="utf-8") != text:
+            path.write_text(text, encoding="utf-8", newline="\n")
+            touched.append(name)
+    for path in sorted(out_dir.glob("*.md")):
+        if path.name not in pages and is_generated(path):
+            path.unlink()
+            touched.append(path.name)
+    return touched
+
+
+def _quiet_environment() -> None:
+    """Make rendering independent of the shell it runs in."""
+    for name in [n for n in os.environ if n.startswith("INDUS_")]:
+        del os.environ[name]
+    os.environ["NO_COLOR"] = "1"
+
+
+def main(argv: Sequence[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0] if __doc__ else None)
+    parser.add_argument("--check", action="store_true", help="report stale pages, write nothing")
+    parser.add_argument("--out", type=Path, default=OUT_DIR, help="target folder")
+    args = parser.parse_args(argv)
+    pages = render_all()
+    if args.check:
+        problems = stale_report(args.out, pages)
+        for line in problems:
+            print(f"{args.out.name}/{line}", file=sys.stderr)
+        if problems:
+            print(f"run `{COMMAND}` and commit the result", file=sys.stderr)
+            return 1
+        print(f"{len(pages)} generated reference pages are fresh")
+        return 0
+    touched = write_pages(args.out, pages)
+    print(
+        f"wrote {len(touched)} of {len(pages)} pages"
+        + (f": {', '.join(touched)}" if touched else "")
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    if str(SRC) not in sys.path:
+        sys.path.insert(0, str(SRC))
+    _quiet_environment()
+    raise SystemExit(main())
