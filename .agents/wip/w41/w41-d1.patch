@@ -0,0 +1,1115 @@
+"""Write the generated reference pages of the user docs from the code (P25-15).
+
+Every page under ``docs/user/reference/`` whose first line is ``MARKER`` belongs to this script;
+pages without it (``trajectory-format.md``) are hand-written and never touched. Each page is
+rendered from what the program itself declares, so nothing here lists commands, keys or tools:
+
+- ``cli.md``: the ``indus`` click tree (lazy commands resolved, hidden ones left out);
+- ``slash-commands.md``: the slash-command registry;
+- ``configuration.md``: the Pydantic config models behind the defaults table (D-16.32);
+- ``environment-variables.md``: ``INDUS_*`` names and other variables the source reads (an AST
+  scan of ``src/indus``), provider key names, messaging platform names and tool secrets;
+- ``tools.md``: every tool a ``register_tools(registry)`` function in ``src/indus`` registers,
+  and the toolsets;
+- ``protocol.md``: methods, notifications, events, server requests and error codes (D-16.27);
+- ``mcp-serve-tools.md``: the tools ``indus mcp serve`` offers;
+- ``skills.md``: the starter skills in ``skills/``;
+- ``messaging-platforms.md`` and ``providers.md``: the gateway and provider registries.
+
+Usage: ``python scripts/docs/gen_reference.py`` writes the pages (and removes generated pages no
+longer produced); ``--check`` writes nothing and exits 1 naming every stale, missing or orphaned
+page; ``--out DIR`` targets another folder. Output never depends on the machine: no timestamps,
+no paths outside the repository, ``INDUS_*`` variables cleared before anything is imported.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import asyncio
+import importlib
+import inspect
+import os
+import re
+import sys
+import types
+import typing
+from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any, cast
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / "src"
+PACKAGE_DIR = SRC / "indus"
+SKILLS_DIR = ROOT / "skills"
+OUT_DIR = ROOT / "docs" / "user" / "reference"
+MARKER = "<!-- Generated by scripts/docs/gen_reference.py. Do not edit: run the script. -->"
+COMMAND = "python scripts/docs/gen_reference.py"
+
+LONG_VALUE = 100
+"""Defaults longer than this many characters are summarised instead of printed."""
+
+
+# -- Markdown helpers ---------------------------------------------------------------------------
+
+
+def cell(value: object) -> str:
+    """Text safe inside one Markdown table cell: one line, pipes escaped."""
+    text = " ".join(str(value).split())
+    return text.replace("|", "\\|")
+
+
+def code(value: object) -> str:
+    """Inline code for a table cell; backticks inside widen the fence."""
+    text = cell(value)
+    if not text:
+        return ""
+    fence = "``" if "`" in text else "`"
+    pad = " " if fence == "``" else ""
+    return f"{fence}{pad}{text}{pad}{fence}"
+
+
+def table(headers: Sequence[str], rows: Iterable[Sequence[object]]) -> list[str]:
+    lines = ["| " + " | ".join(headers) + " |", "|" + "---|" * len(headers)]
+    for row in rows:
+        lines.append("| " + " | ".join(str(c) for c in row) + " |")
+    return lines
+
+
+def first_paragraph(text: str | None) -> str:
+    cleaned = inspect.cleandoc(text or "").strip()
+    return cleaned.split("\n\n", 1)[0].replace("\n", " ").strip()
+
+
+def first_line(text: str | None) -> str:
+    cleaned = inspect.cleandoc(text or "").strip()
+    return cleaned.splitlines()[0].strip() if cleaned else ""
+
+
+def page(title: str, intro: str, body: Iterable[str]) -> str:
+    lines = [MARKER, "", f"# {title}", "", intro, ""]
+    lines.extend(body)
+    while lines and not lines[-1]:
+        lines.pop()
+    return "\n".join(lines) + "\n"
+
+
+def show_value(value: object) -> str:
+    """A default as it would be written in YAML-like text, summarised when long."""
+    if value is None:
+        return "null"
+    if isinstance(value, bool):
+        return "true" if value else "false"
+    if isinstance(value, str):
+        return '""' if value == "" else value
+    if isinstance(value, Mapping):
+        mapping = cast(Mapping[str, object], value)
+        if not mapping:
+            return "{}"
+        text = "{" + ", ".join(f"{k}: {show_value(v)}" for k, v in mapping.items()) + "}"
+        return text if len(text) <= LONG_VALUE else f"(a mapping of {len(mapping)} entries)"
+    if isinstance(value, list | tuple | set | frozenset):
+        items = cast(Iterable[object], value)
+        seq = sorted(items, key=str) if isinstance(value, set | frozenset) else list(items)
+        if not seq:
+            return "[]"
+        text = "[" + ", ".join(show_value(v) for v in seq) + "]"
+        return text if len(text) <= LONG_VALUE else f"(a list of {len(seq)} items)"
+    return str(value)
+
+
+def type_text(annotation: object) -> str:
+    """A short readable name for a type annotation."""
+    origin = typing.get_origin(annotation)
+    args = typing.get_args(annotation)
+    if annotation is type(None):
+        return "null"
+    if origin is typing.Literal:
+        return " | ".join(repr(a) if isinstance(a, str) else str(a) for a in args)
+    if origin in (typing.Union, types.UnionType):
+        return " or ".join(type_text(a) for a in args)
+    if origin is typing.Annotated:
+        return type_text(args[0])
+    if origin is not None:
+        name = getattr(origin, "__name__", str(origin))
+        inner = ", ".join(type_text(a) for a in args if a is not Ellipsis)
+        return f"{name}[{inner}]" if inner else name
+    if isinstance(annotation, type):
+        return annotation.__name__
+    text = str(annotation)
+    return re.sub(r"\b(?:[a-z_][\w]*\.)+", "", text)
+
+
+# -- CLI ----------------------------------------------------------------------------------------
+
+
+def _help_text(cmd: Any) -> str:
+    text = inspect.cleandoc(cmd.help or "")
+    text = text.split("\f", 1)[0]
+    lines = [line for line in text.splitlines() if line.strip() != "\b"]
+    return "\n".join(lines).strip()
+
+
+def _option_names(param: Any) -> str:
+    names = ", ".join(param.opts)
+    if getattr(param, "secondary_opts", None):
+        names += " / " + ", ".join(param.secondary_opts)
+    return names
+
+
+def _option_value(param: Any) -> str:
+    import click
+
+    if getattr(param, "count", False):
+        kind = "count"
+    elif getattr(param, "is_flag", False):
+        kind = "flag"
+    elif isinstance(param.type, click.Choice):
+        kind = " | ".join(str(c) for c in param.type.choices)
+    else:
+        kind = param.type.name.upper()
+    if getattr(param, "multiple", False):
+        kind += " (repeatable)"
+    return kind
+
+
+def _option_default(param: Any) -> str:
+    default = param.default
+    if callable(default):
+        return "computed"
+    if default is None or default == () or type(default).__name__ == "Sentinel":
+        return ""
+    if getattr(param, "is_flag", False) and not getattr(param, "count", False):
+        if getattr(param, "secondary_opts", None):
+            return param.opts[0] if default else param.secondary_opts[0]
+        return "on" if default is True else ""
+    if getattr(param, "count", False) and not default:
+        return ""
+    return code(show_value(default))
+
+
+@dataclass
+class CliCommand:
+    path: str
+    command: Any
+    context: Any
+    children: list[CliCommand] = field(default_factory=list["CliCommand"])
+
+
+def walk_cli(command: Any, name: str, parent: Any = None) -> CliCommand:
+    """The visible command tree under ``command``, in each group's own listing order."""
+    import click
+
+    ctx = click.Context(command, info_name=name, parent=parent)
+    path = f"{parent.command_path} {name}" if parent is not None else name
+    node = CliCommand(path, command, ctx)
+    if isinstance(command, click.Group):
+        for sub_name in command.list_commands(ctx):
+            sub = command.get_command(ctx, sub_name)
+            if sub is None or sub.hidden:
+                continue
+            node.children.append(walk_cli(sub, sub_name, ctx))
+    return node
+
+
+def _flatten(node: CliCommand) -> Iterator[CliCommand]:
+    yield node
+    for child in node.children:
+        yield from _flatten(child)
+
+
+def _cli_section(node: CliCommand, level: int) -> list[str]:
+    import click
+
+    cmd = node.command
+    out = [f"{'#' * level} {node.path}", ""]
+    if cmd.deprecated:
+        out += ["*Deprecated.*", ""]
+    helptext = _help_text(cmd)
+    if helptext:
+        out += [helptext, ""]
+    pieces = cmd.collect_usage_pieces(node.context)
+    out += ["```text", " ".join([node.path, *pieces]).rstrip(), "```", ""]
+    arguments = [p for p in cmd.params if isinstance(p, click.Argument)]
+    if arguments:
+        rows = [
+            (
+                code(p.human_readable_name),
+                "yes" if p.required else "no",
+                "many" if p.nargs == -1 else str(p.nargs),
+            )
+            for p in arguments
+        ]
+        out += table(("Argument", "Required", "Count"), rows) + [""]
+    options = [
+        p
+        for p in cmd.params
+        if isinstance(p, click.Option) and not p.hidden and "--help" not in p.opts
+    ]
+    if options:
+        rows = [
+            (code(_option_names(p)), cell(_option_value(p)), _option_default(p), cell(p.help or ""))
+            for p in options
+        ]
+        out += table(("Option", "Value", "Default", "What it does"), rows) + [""]
+    if node.children:
+        rows = [
+            (f"[`{child.path}`](#{slug(child.path)})", cell(child.command.get_short_help_str(200)))
+            for child in node.children
+        ]
+        out += table(("Command", "What it does"), rows) + [""]
+    return out
+
+
+def slug(heading: str) -> str:
+    """The anchor MkDocs' table of contents gives a heading made of plain words."""
+    text = re.sub(r"[^\w\s-]", "", heading.lower()).strip()
+    return re.sub(r"[\s]+", "-", text)
+
+
+def render_cli(root: Any = None, name: str = "indus") -> str:
+    if root is None:
+        from indus.cli.app import cli as root
+    tree = walk_cli(root, name)
+    body: list[str] = [
+        "Every command also accepts `--help`, which prints the same text in the terminal.",
+        "",
+    ]
+    body += _cli_section(tree, 2)
+    for top in tree.children:
+        for node in _flatten(top):
+            body += _cli_section(node, 2 if node is top else 3)
+    return page(
+        "Command line",
+        "Every `indus` command with its arguments, options and subcommands.",
+        body,
+    )
+
+
+# -- slash commands -----------------------------------------------------------------------------
+
+SURFACE_LABELS = {
+    "cli": "classic CLI",
+    "tui": "TUI",
+    "gateway": "messaging",
+    "desktop": "desktop",
+}
+
+
+def render_slash() -> str:
+    from indus.service.commands.registry import CATEGORY_TITLES, REGISTRY, SURFACES
+
+    body: list[str] = []
+    for category, commands in REGISTRY.by_category().items():
+        body += [f"## {CATEGORY_TITLES[category]}", ""]
+        rows = []
+        for cmd in commands:
+            aliases = ", ".join(code("/" + a) for a in cmd.aliases)
+            args = cmd.args_hint
+            if cmd.subcommands:
+                args = (args + " " if args else "") + "(" + ", ".join(cmd.subcommands) + ")"
+            where = (
+                "everywhere"
+                if cmd.surfaces == SURFACES
+                else ", ".join(SURFACE_LABELS.get(s, s) for s in sorted(cmd.surfaces))
+            )
+            rows.append((code("/" + cmd.name), aliases, code(args), cell(cmd.description), where))
+        body += table(("Command", "Aliases", "Arguments", "What it does", "Offered in"), rows)
+        body.append("")
+    return page(
+        "Slash commands",
+        "Commands typed in a chat, starting with `/`. Names and aliases ignore case. "
+        "`/help` lists the ones the current surface offers.",
+        body,
+    )
+
+
+# -- configuration ------------------------------------------------------------------------------
+
+
+def _model_member(annotation: object) -> type[Any] | None:
+    from pydantic import BaseModel
+
+    members = typing.get_args(annotation) or (annotation,)
+    for member in members:
+        if isinstance(member, type) and issubclass(member, BaseModel):
+            return member
+    return None
+
+
+def config_rows(
+    model: type[Any], prefix: str, defaults: Mapping[str, Any]
+) -> list[tuple[str, ...]]:
+    """``(dotted key, type, default, description)`` for every leaf under ``model``."""
+    rows: list[tuple[str, ...]] = []
+    for name, info in model.model_fields.items():
+        key = info.alias or name
+        if key.startswith("_"):
+            continue
+        path = f"{prefix}{key}"
+        value = defaults.get(key) if isinstance(defaults, Mapping) else None
+        sub = _model_member(info.annotation)
+        description = info.description or ""
+        if sub is not None and sub is not info.annotation:
+            # a shorthand slot (``model: <id>``) that also takes the section's keys
+            rows.append((path, type_text(info.annotation), "", description))
+        if sub is not None:
+            inner = value if isinstance(value, Mapping) else {}
+            rows.extend(config_rows(sub, path + ".", cast(Mapping[str, Any], inner)))
+            continue
+        rows.append((path, type_text(info.annotation), show_value(value), description))
+    return rows
+
+
+def render_config() -> str:
+    from indus.foundation.config import schema
+
+    defaults = schema.DEFAULTS
+    body: list[str] = [
+        "Settings live in `config.yaml` in the profile home. `indus config show` prints the "
+        "file, `indus config set <key> <value>` changes one key. Keys are written here as "
+        "dotted paths: `agent.max_turns` is `max_turns` inside the `agent:` section.",
+        "",
+    ]
+    model = schema.ConfigModel
+    for name, info in model.model_fields.items():
+        key = info.alias or name
+        if key == schema.VERSION_KEY:
+            continue
+        body += [f"## {key}", ""]
+        if info.description:
+            body += [info.description[0].upper() + info.description[1:] + ".", ""]
+        sub = _model_member(info.annotation)
+        value = defaults.get(key)
+        if sub is None:
+            rows = [(key, type_text(info.annotation), show_value(value), info.description or "")]
+        else:
+            rows = config_rows(sub, key + ".", cast(Mapping[str, Any], value or {}))
+            if sub is not info.annotation:
+                rows.insert(0, (key, type_text(info.annotation), "", info.description or ""))
+        body += table(
+            ("Key", "Type", "Default", "Meaning"),
+            [(code(k), cell(t), code(d) if d else "", cell(m)) for k, t, d, m in rows],
+        )
+        body.append("")
+    return page(
+        "Configuration keys",
+        "Every key of `config.yaml` with its type and built-in value. A key you leave out keeps "
+        "following the built-in value, also when a later release changes it.",
+        body,
+    )
+
+
+# -- source scans -------------------------------------------------------------------------------
+
+INDUS_NAME = re.compile(r"^INDUS_[A-Z0-9_]*[A-Z0-9]$")
+INDUS_PREFIX = re.compile(r"^INDUS_[A-Z0-9_]*_$")
+ENV_NAME = re.compile(r"^[A-Z][A-Z0-9_]*$")
+ENV_RECEIVERS = ("environ", "env", "getenv")
+
+
+def source_modules(package_dir: Path = PACKAGE_DIR) -> Iterator[tuple[str, ast.Module]]:
+    """``(dotted module name, parsed tree)`` for every module under the package, sorted."""
+    base = package_dir.parent
+    for path in sorted(package_dir.rglob("*.py")):
+        parts = path.relative_to(base).with_suffix("").parts
+        name = ".".join(parts[:-1] if parts[-1] == "__init__" else parts)
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"))
+        except (SyntaxError, UnicodeDecodeError):
+            continue
+        yield name, tree
+
+
+def _receiver_reads_env(node: ast.expr) -> bool:
+    text = ast.unparse(node).lower()
+    return any(word in text for word in ENV_RECEIVERS)
+
+
+@dataclass
+class EnvScan:
+    indus: dict[str, set[str]] = field(default_factory=dict[str, set[str]])
+    prefixes: dict[str, set[str]] = field(default_factory=dict[str, set[str]])
+    other: dict[str, set[str]] = field(default_factory=dict[str, set[str]])
+
+
+def scan_env(package_dir: Path = PACKAGE_DIR) -> EnvScan:
+    """Names the source mentions: every ``INDUS_*`` string, and other upper-case names read
+    through an env mapping (``os.environ.get("X")``, ``env["X"]``, ``getenv("X")``)."""
+    found = EnvScan()
+    for module, tree in source_modules(package_dir):
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Constant) and isinstance(node.value, str):
+                if INDUS_NAME.match(node.value):
+                    found.indus.setdefault(node.value, set()).add(module)
+                elif INDUS_PREFIX.match(node.value):
+                    found.prefixes.setdefault(node.value, set()).add(module)
+            name: str | None = None
+            if isinstance(node, ast.Call) and node.args:
+                arg = node.args[0]
+                func = node.func
+                if isinstance(arg, ast.Constant) and isinstance(arg.value, str):
+                    if isinstance(func, ast.Attribute) and func.attr in ("get", "pop", "getenv"):
+                        if func.attr == "getenv" or _receiver_reads_env(func.value):
+                            name = arg.value
+                    elif isinstance(func, ast.Name) and func.id == "getenv":
+                        name = arg.value
+            elif isinstance(node, ast.Subscript) and _receiver_reads_env(node.value):
+                key = node.slice
+                if isinstance(key, ast.Constant) and isinstance(key.value, str):
+                    name = key.value
+            if name and ENV_NAME.match(name) and not name.startswith("INDUS_"):
+                found.other.setdefault(name, set()).add(module)
+    return found
+
+
+# -- tools --------------------------------------------------------------------------------------
+
+
+def tool_modules(package_dir: Path = PACKAGE_DIR) -> list[str]:
+    """Modules with a top-level ``register_tools(registry)`` (one required positional)."""
+    out: list[str] = []
+    for module, tree in source_modules(package_dir):
+        for node in tree.body:
+            if isinstance(node, ast.FunctionDef) and node.name == "register_tools":
+                required = len(node.args.args) - len(node.args.defaults)
+                keywords_optional = all(d is not None for d in node.args.kw_defaults)
+                if required == 1 and keywords_optional:
+                    out.append(module)
+    return out
+
+
+@dataclass
+class ToolScan:
+    entries: dict[str, Any]
+    modules: dict[str, str]
+    failed: dict[str, str]
+
+
+def scan_tools(modules: Sequence[str] | None = None) -> ToolScan:
+    """Register each module into its own registry; the first module to register a name wins."""
+    from indus.tools.registry import ToolRegistry
+
+    entries: dict[str, Any] = {}
+    owner: dict[str, str] = {}
+    failed: dict[str, str] = {}
+    for module in tool_modules() if modules is None else modules:
+        registry = ToolRegistry()
+        try:
+            importlib.import_module(module).register_tools(registry)
+        except Exception as exc:  # an optional extra missing: recorded, not fatal
+            failed[module] = type(exc).__name__
+            continue
+        for entry in registry.entries():
+            if entry.name not in entries:
+                entries[entry.name] = entry
+                owner[entry.name] = module
+    return ToolScan(entries, owner, failed)
+
+
+def _schema_type(schema: Mapping[str, Any]) -> str:
+    if "enum" in schema:
+        return " | ".join(repr(v) if isinstance(v, str) else str(v) for v in schema["enum"])
+    kind = schema.get("type")
+    if isinstance(kind, list):
+        return " or ".join(str(k) for k in cast(list[object], kind))
+    if kind == "array":
+        items = schema.get("items")
+        inner = _schema_type(cast(Mapping[str, Any], items)) if isinstance(items, Mapping) else ""
+        return f"array of {inner}" if inner else "array"
+    if kind:
+        return str(kind)
+    for key in ("anyOf", "oneOf"):
+        options = schema.get(key)
+        if isinstance(options, list):
+            return " or ".join(
+                _schema_type(cast(Mapping[str, Any], o))
+                for o in cast(list[object], options)
+                if isinstance(o, Mapping)
+            )
+    return "any"
+
+
+def _parameter_rows(parameters: Mapping[str, Any] | None) -> list[tuple[str, ...]]:
+    if not parameters:
+        return []
+    props = cast(Mapping[str, Any], parameters.get("properties") or {})
+    required = set(cast(list[str], parameters.get("required") or []))
+    rows: list[tuple[str, ...]] = []
+    for name, raw in props.items():
+        spec = cast(Mapping[str, Any], raw) if isinstance(raw, Mapping) else {}
+        default = show_value(spec["default"]) if "default" in spec else ""
+        rows.append(
+            (
+                code(name),
+                cell(_schema_type(spec)),
+                "yes" if name in required else "no",
+                code(default) if default else "",
+                cell(first_paragraph(str(spec.get("description", "")))),
+            )
+        )
+    return rows
+
+
+GROUP_AT = 4
+"""Tools sharing a ``prefix_`` are shown as one ``prefix_*`` entry from this many on."""
+
+
+def tool_list(names: Sequence[str]) -> str:
+    """Tool names for a table cell; a family of ``GROUP_AT`` or more names that share a prefix
+    (``browser_*``) is shown once with its size, in the place of its first member."""
+    families: dict[str, list[str]] = {}
+    for name in names:
+        head, sep, _ = name.partition("_")
+        if sep:
+            families.setdefault(head, []).append(name)
+    shown: list[str] = []
+    done: set[str] = set()
+    for name in names:
+        head, sep, _ = name.partition("_")
+        members = families.get(head, []) if sep else []
+        if len(members) >= GROUP_AT:
+            if head not in done:
+                done.add(head)
+                shown.append(f"{code(head + '_*')} ({len(members)} tools)")
+            continue
+        shown.append(code(name))
+    return ", ".join(shown)
+
+
+def render_tools(scan: ToolScan | None = None) -> str:
+    from indus.tools import toolsets
+
+    found = scan or scan_tools()
+    names = sorted(found.entries, key=lambda n: (found.entries[n].toolset, n))
+    body: list[str] = [
+        "Tools are what the model can call. A session gets the tools of its toolsets "
+        "(`indus tools` chooses them per platform); a tool whose service, key or library is "
+        "missing is left out of the session automatically.",
+        "",
+        "## All tools",
+        "",
+    ]
+    body += table(
+        ("Tool", "Toolset", "What it does"),
+        [
+            (
+                f"[`{n}`](#{slug(n)})",
+                code(found.entries[n].toolset),
+                cell(first_paragraph(found.entries[n].schema.get("description"))),
+            )
+            for n in names
+        ],
+    )
+    body.append("")
+    for name in names:
+        entry = found.entries[name]
+        body += [f"### {name}", ""]
+        body += [inspect.cleandoc(str(entry.schema.get("description") or "")).strip(), ""]
+        facts = [f"Toolset: `{entry.toolset}`."]
+        if entry.requires_secrets:
+            facts.append("Needs: " + ", ".join(code(s) for s in entry.requires_secrets) + ".")
+        body += [" ".join(facts), ""]
+        rows = _parameter_rows(entry.parameters)
+        if rows:
+            body += table(("Parameter", "Type", "Required", "Default", "Meaning"), rows) + [""]
+    body += ["## Toolsets", ""]
+    body += [
+        "A toolset names a group of tools and may include other toolsets. Platform bundles "
+        "(`indus-<platform>`) are what each surface starts from.",
+        "",
+    ]
+    rows = []
+    for name, toolset in sorted(toolsets.TOOLSETS.items()):
+        notes = []
+        if toolset.platforms:
+            notes.append("only on " + ", ".join(sorted(toolset.platforms)))
+        if toolset.posture:
+            notes.append("per session, never saved")
+        if not toolset.registry_members:
+            notes.append("fixed list")
+        rows.append(
+            (
+                code(name),
+                cell(toolset.description),
+                tool_list(toolset.tools),
+                ", ".join(code(t) for t in toolset.includes),
+                cell("; ".join(notes)),
+            )
+        )
+    body += table(("Toolset", "What it is for", "Tools", "Includes", "Notes"), rows) + [""]
+    if found.failed:
+        body += ["## Not listed", ""]
+        body += [
+            "These modules register tools but could not be loaded where this page was "
+            "generated: " + ", ".join(code(m) for m in sorted(found.failed)) + ".",
+            "",
+        ]
+    return page("Tools and toolsets", "Every tool Indus Agent ships, and the toolsets.", body)
+
