+def test_screen_follows_cursor_moves_erases_and_wraps() -> None:
+    screen = Screen(rows=5, cols=10)
+    screen.feed("hello\r\nworld")
+    screen.feed("\x1b[1;3HXY")  # absolute move, overwrite
