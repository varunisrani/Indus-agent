diff --git a/apps/web/scripts/check-bundle.mjs b/apps/web/scripts/check-bundle.mjs
new file mode 100644
index 0000000..1ba140b
--- /dev/null
+++ b/apps/web/scripts/check-bundle.mjs
@@ -0,0 +1,101 @@
+#!/usr/bin/env node
+// Web dashboard bundle budget (P25-13), checked on a production build:
+//   node apps/web/scripts/check-bundle.mjs [dist dir]      (default: apps/web/dist)
+// The initial JS (the module scripts and modulepreloads index.html loads) must stay within
+// `web.initial_js.limit_kb_gzip` in total, and every other JS chunk (routes, lazy pages) within
+// `web.route_chunk.limit_kb_gzip`; both numbers come from tooling/perf/budgets.toml. Sizes are
+// gzip level 9, 1 kB = 1,000 bytes. Exit 1 names every file over its budget; exit 2 when there is
+// no build to check.
+
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { join, relative, resolve, sep } from "node:path";
+import { fileURLToPath } from "node:url";
+import { gzipSync } from "node:zlib";
+import { readBudgets } from "../../../tooling/perf/read-budgets.mjs";
+
+const HERE = fileURLToPath(new URL(".", import.meta.url));
+export const DEFAULT_DIST = resolve(HERE, "..", "dist");
+
+const SCRIPT = /<script\b[^>]*\btype=["']module["'][^>]*\bsrc=["']([^"']+)["'][^>]*>/gi;
+const PRELOAD = /<link\b[^>]*\brel=["']modulepreload["'][^>]*\bhref=["']([^"']+)["'][^>]*>/gi;
+
+export function gzipKb(bytes) {
+  return gzipSync(bytes, { level: 9 }).byteLength / 1000;
+}
+
+function walk(dir) {
+  const out = [];
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name);
+    if (statSync(path).isDirectory()) out.push(...walk(path));
+    else out.push(path);
+  }
+  return out;
+}
+
+/** The dist-relative JS files index.html loads up front (base path prefixes ignored). */
+export function initialFiles(html, jsFiles) {
+  const wanted = [];
+  for (const re of [SCRIPT, PRELOAD]) {
+    for (const match of html.matchAll(re)) wanted.push(match[1].split(/[?#]/)[0]);
+  }
+  const found = new Set();
+  for (const href of wanted) {
+    if (/^[a-z]+:\/\//i.test(href)) continue; // never ours to size
+    const hit = jsFiles.find((file) => href.endsWith(`/${file}`) || href === file);
+    if (hit !== undefined) found.add(hit);
+  }
+  return [...found].sort();
+}
+
+export function checkBundle(dist = DEFAULT_DIST, budgets = readBudgets()) {
+  const index = join(dist, "index.html");
+  if (!existsSync(index)) {
+    return { setup: `no build at ${dist} (run \`pnpm --filter @indus/web build\` first)` };
+  }
+  const initialLimit = Number(budgets.web.initial_js.limit_kb_gzip);
+  const chunkLimit = Number(budgets.web.route_chunk.limit_kb_gzip);
+  const js = walk(dist)
+    .filter((path) => /\.(m?js)$/.test(path))
+    .map((path) => relative(dist, path).split(sep).join("/"));
+  const initial = initialFiles(readFileSync(index, "utf8"), js);
+  const sizes = Object.fromEntries(
+    js.map((file) => [file, gzipKb(readFileSync(join(dist, file)))]),
+  );
+  const initialKb = initial.reduce((sum, file) => sum + sizes[file], 0);
+  const problems = [];
+  if (initial.length === 0) problems.push("index.html loads no module script from the build");
+  if (initialKb > initialLimit) {
+    problems.push(
+      `initial JS ${initialKb.toFixed(1)} kB gzip is over the ${initialLimit} kB budget (web.initial_js): ${initial.join(", ")}`,
+    );
+  }
+  const routes = js.filter((file) => !initial.includes(file)).sort();
+  for (const file of routes) {
+    if (sizes[file] > chunkLimit) {
+      problems.push(
+        `${file}: ${sizes[file].toFixed(1)} kB gzip is over the ${chunkLimit} kB chunk budget (web.route_chunk)`,
+      );
+    }
+  }
+  return { initial, initialKb, routes, sizes, problems };
+}
+
+function main(argv) {
+  const dist = resolve(argv[0] ?? DEFAULT_DIST);
+  const result = checkBundle(dist);
+  if (result.setup) {
+    process.stderr.write(`check-bundle: ${result.setup}\n`);
+    return 2;
+  }
+  process.stdout.write(
+    `initial JS ${result.initialKb.toFixed(1)} kB gzip (${result.initial.length} files); ` +
+      `${result.routes.length} other chunks, largest ${Math.max(0, ...result.routes.map((f) => result.sizes[f])).toFixed(1)} kB gzip\n`,
+  );
+  for (const problem of result.problems) process.stderr.write(`check-bundle: ${problem}\n`);
+  return result.problems.length === 0 ? 0 : 1;
+}
+
+if (process.argv[1] !== undefined && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  process.exitCode = main(process.argv.slice(2));
+}
diff --git a/apps/web/scripts/check-bundle.test.mjs b/apps/web/scripts/check-bundle.test.mjs
new file mode 100644
index 0000000..4105129
--- /dev/null
+++ b/apps/web/scripts/check-bundle.test.mjs
@@ -0,0 +1,79 @@
+// @vitest-environment node
+// P25-13: the bundle budget check on synthetic builds (budgets from tooling/perf/budgets.toml).
+
+import { randomBytes } from "node:crypto";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { readBudgets } from "../../../tooling/perf/read-budgets.mjs";
+import { checkBundle, initialFiles } from "./check-bundle.mjs";
+
+const dirs = [];
+afterEach(() => {
+  for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+/** Incompressible JS of roughly `kb` kB gzip. */
+const noise = (kb) =>
+  `export const x = "${randomBytes(Math.round(kb * 1000)).toString("base64")}";\n`;
+
+function build(files, html) {
+  const dist = mkdtempSync(join(tmpdir(), "indus-bundle-"));
+  dirs.push(dist);
+  mkdirSync(join(dist, "assets"));
+  for (const [name, text] of Object.entries(files)) writeFileSync(join(dist, "assets", name), text);
+  writeFileSync(join(dist, "index.html"), html);
+  return dist;
+}
+
+const HTML = `<!doctype html><html><head>
+<script type="module" crossorigin src="/indus/assets/index-a1.js"></script>
+<link rel="modulepreload" crossorigin href="/indus/assets/react-b2.js">
+</head><body></body></html>`;
+
+describe("check-bundle", () => {
+  it("reads both budgets from the budgets file", () => {
+    const budgets = readBudgets();
+    expect(budgets.web.initial_js.limit_kb_gzip).toBe(350);
+    expect(budgets.web.route_chunk.limit_kb_gzip).toBe(200);
+  });
+
+  it("counts the entry script and its modulepreloads as initial, under a base path", () => {
+    const files = ["assets/index-a1.js", "assets/react-b2.js", "assets/SessionsPage-c3.js"];
+    expect(initialFiles(HTML, files)).toEqual(["assets/index-a1.js", "assets/react-b2.js"]);
+  });
+
+  it("passes a build within both budgets", () => {
+    const dist = build(
+      { "index-a1.js": noise(40), "react-b2.js": noise(60), "SessionsPage-c3.js": noise(20) },
+      HTML,
+    );
+    const result = checkBundle(dist);
+    expect(result.problems).toEqual([]);
+    expect(result.routes).toEqual(["assets/SessionsPage-c3.js"]);
+  });
+
+  it("fails an oversized route chunk and names it", () => {
+    const dist = build(
+      { "index-a1.js": noise(40), "react-b2.js": noise(60), "ChatPage-d4.js": noise(230) },
+      HTML,
+    );
+    const { problems } = checkBundle(dist);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/^assets\/ChatPage-d4\.js: \d+\.\d kB gzip is over the 200 kB/);
+  });
+
+  it("fails initial JS over its budget even when every file is small", () => {
+    const dist = build({ "index-a1.js": noise(190), "react-b2.js": noise(190) }, HTML);
+    const { problems } = checkBundle(dist);
+    expect(problems).toHaveLength(1);
+    expect(problems[0]).toMatch(/^initial JS \d+\.\d kB gzip is over the 350 kB budget/);
+  });
+
+  it("reports a missing build as a setup problem", () => {
+    const empty = mkdtempSync(join(tmpdir(), "indus-bundle-"));
+    dirs.push(empty);
+    expect(checkBundle(empty).setup).toMatch(/^no build at /);
+  });
+});
