index 0000000..08d0eab
--- /dev/null
+++ b/src/indus/service/event_log.py
@@ -0,0 +1,430 @@
+"""The daemon's event log: per-session sequence numbers, a replay epoch and bounded replay (P17-06).
+
+Every event the daemon sends for a session passes through ``EventLog.append``. The log numbers it
+(``seq``: 1, 2, 3 … per session, never reused while the daemon lives) and stamps the daemon's
+``replay_epoch``, a random token made once per daemon start. The newest events of each session are
+kept as frozen JSON so a client that lost its socket can ask ``since(session, epoch, cursor)`` and
+receive exactly the events after ``cursor``, in order. When that cannot be answered truthfully the
+answer is a ``ReplayGap`` and the client reloads a snapshot instead:
+
+- ``epoch_changed``: the client's epoch belongs to another daemon run (its counters restarted);
+- ``evicted``: some event after the cursor was dropped from memory (or was too big to keep);
+- ``ahead``: the cursor is past anything this daemon numbered.
+
+Memory bounds (``ReplayLimits``): per session at most 512 events and 4 MiB of payload, at most 64
+sessions, at most 64 MiB in the process. The process cap takes events from the session that has
+been quiet longest; a 65th session drops the quietest session's whole buffer. A session's counter
+and "evicted through" watermark outlive its buffer, so a returning session keeps counting up and a
+client holding an old cursor sees a gap, never a silent hole.
+
+Streaming text (``message.delta``, ``reasoning.delta``) is joined before numbering: pieces of the
+same kind and turn that arrive within ``coalesce_window`` (33 ms) of the first held piece become
+one event whose text is their concatenation. Any other event for the session flushes the held
+piece first, so order is kept. ``flush_due`` (driven by ``run_flusher`` in the daemon) flushes a
+held piece once its window is over.
+
+Listeners added with ``add_listener`` receive each numbered event (``LoggedEvent``) after it is
+kept; deliveries follow seq order when appends come from one thread (the daemon loop). A listener
+that raises is logged and skipped. Listeners must not append to the log.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import secrets
+import threading
+from collections import OrderedDict, deque
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from typing import Any, Literal
+
+from indus.foundation.clock import Clock
+from indus.protocol.events import EventBase
+
+__all__ = [
+    "COALESCE_WINDOW_S",
+    "STREAMING_TYPES",
+    "EventLog",
+    "LoggedEvent",
+    "Replay",
+    "ReplayGap",
+    "ReplayLimits",
+    "new_replay_epoch",
+]
+
+log = logging.getLogger(__name__)
+
+COALESCE_WINDOW_S = 0.033
+"""How long a streamed text piece may wait for the next one before it is numbered."""
+
+STREAMING_TYPES = frozenset({"message.delta", "reasoning.delta"})
+"""Event types whose consecutive pieces are joined."""
+
+_MIB = 1024 * 1024
+
+type GapReason = Literal["epoch_changed", "evicted", "ahead"]
+type LogListener = Callable[[LoggedEvent], object]
+
+
+def new_replay_epoch() -> str:
+    """A fresh opaque replay epoch (one per daemon start)."""
+    return secrets.token_hex(16)
+
+
+@dataclass(frozen=True, slots=True)
+class ReplayLimits:
+    """How much replay the daemon keeps in memory."""
+
+    events_per_session: int = 512
+    bytes_per_session: int = 4 * _MIB
+    sessions: int = 64
+    bytes_process: int = 64 * _MIB
+
+    def __post_init__(self) -> None:
+        for name in ("events_per_session", "bytes_per_session", "sessions", "bytes_process"):
+            if getattr(self, name) < 1:
+                raise ValueError(f"{name} must be at least 1")
+
+
+@dataclass(frozen=True, slots=True)
+class LoggedEvent:
+    """One numbered event as the log keeps it (payload frozen as JSON bytes)."""
+
+    session_id: str
+    seq: int
+    replay_epoch: str
+    payload: bytes = field(repr=False)
+
+    @property
+    def size(self) -> int:
+        """Bytes this event counts against the caps."""
+        return len(self.payload)
+
+    @property
+    def type(self) -> str:
+        return str(self.to_wire().get("type", ""))
+
+    def to_wire(self) -> dict[str, Any]:
+        """The event as a client receives it: its fields plus ``seq`` and ``replay_epoch``."""
+        event = _thaw(self.payload)
+        event["seq"] = self.seq
+        event["replay_epoch"] = self.replay_epoch
+        return event
+
+
+@dataclass(frozen=True, slots=True)
+class Replay:
+    """The events after a cursor, oldest first."""
+
+    session_id: str
+    replay_epoch: str
+    events: tuple[dict[str, Any], ...]
+    last_seq: int
+    """The newest seq the session has (the cursor to hold after applying ``events``)."""
+
+
+@dataclass(frozen=True, slots=True)
+class ReplayGap:
+    """The log cannot replay from the cursor; the client reloads a snapshot."""
+
+    session_id: str
+    replay_epoch: str
+    last_seq: int
+    reason: GapReason
+
+    def to_wire(self) -> dict[str, Any]:
+        return {
+            "type": "session.replay_gap",
+            "session_id": self.session_id,
+            "replay_epoch": self.replay_epoch,
+            "last_seq": self.last_seq,
+            "reason": self.reason,
+        }
+
+
+@dataclass(slots=True)
+class _Held:
+    """A streamed text piece waiting for its neighbours."""
+
+    type: str
+    turn_id: object
+    base: dict[str, Any]
+    parts: list[str]
+    started: float
+
+
+@dataclass(slots=True)
+class _Ring:
+    events: deque[LoggedEvent] = field(default_factory=deque[LoggedEvent])
+    bytes: int = 0
+
+
+def _freeze(event: Mapping[str, Any]) -> bytes:
+    return json.dumps(event, ensure_ascii=False, separators=(",", ":")).encode(
+        "utf-8", errors="surrogatepass"
+    )
+
+
+def _thaw(payload: bytes) -> dict[str, Any]:
+    value = json.loads(payload.decode("utf-8", errors="surrogatepass"))
+    assert isinstance(value, dict)
+    return dict(value)  # pyright: ignore[reportUnknownArgumentType]
+
+
+def _as_mapping(session_id: str, event: EventBase | Mapping[str, Any]) -> dict[str, Any]:
+    data = event.to_wire() if isinstance(event, EventBase) else dict(event)
+    if not isinstance(data.get("type"), str) or not data["type"]:
+        raise ValueError("an event needs a non-empty string 'type'")
+    data.pop("seq", None)  # the log numbers events itself
+    data.pop("replay_epoch", None)
+    data.setdefault("session_id", session_id)
+    return data
+
+
+class EventLog:
+    """Numbering, coalescing and bounded replay for every session of one daemon."""
+
+    def __init__(
+        self,
+        *,
+        clock: Clock,
+        epoch: str | None = None,
+        limits: ReplayLimits | None = None,
+        coalesce_window: float = COALESCE_WINDOW_S,
+    ) -> None:
+        if coalesce_window < 0:
+            raise ValueError("coalesce_window must be >= 0")
+        self._clock = clock
+        self.epoch = epoch or new_replay_epoch()
+        self.limits = limits or ReplayLimits()
+        self.coalesce_window = coalesce_window
+        self._lock = threading.Lock()
+        self._rings: OrderedDict[str, _Ring] = OrderedDict()  # least recently active first
+        self._last: dict[str, int] = {}
+        self._evicted: dict[str, int] = {}
+        self._held: dict[str, _Held] = {}
+        self._total = 0
+        self._listeners: list[LogListener] = []
+        self._wake: asyncio.Event | None = None
+        self._wake_loop: asyncio.AbstractEventLoop | None = None
+
+    # -- listeners ----------------------------------------------------------------------------
+
+    def add_listener(self, listener: LogListener) -> Callable[[], None]:
+        """Hear every numbered event; the returned callable removes the listener."""
+        self._listeners.append(listener)
+
+        def remove() -> None:
+            if listener in self._listeners:
+                self._listeners.remove(listener)
+
+        return remove
+
+    def _tell(self, entries: list[LoggedEvent]) -> None:
+        for entry in entries:
+            for listener in list(self._listeners):
+                try:
+                    listener(entry)
+                except Exception:
+                    log.warning(
+                        "an event-log listener failed on #%d of session %s",
+                        entry.seq,
+                        entry.session_id,
+                        exc_info=True,
+                    )
+
+    # -- appending ----------------------------------------------------------------------------
+
+    def append(self, session_id: str, event: EventBase | Mapping[str, Any]) -> list[LoggedEvent]:
+        """Number and keep ``event`` (a held text piece may wait; see the module notes).
+
+        Returns the events numbered by this call, oldest first: none when the piece is held, the
+        flushed held piece before this event when one was waiting.
+        """
+        if not session_id:
+            raise ValueError("session_id must not be empty")
+        data = _as_mapping(session_id, event)
+        kind = data["type"]
+        streaming = kind in STREAMING_TYPES and isinstance(data.get("text"), str)
+        payload = None if streaming else _freeze(data)  # encoded outside the lock
+        armed = False
+        with self._lock:
+            now = self._clock.monotonic()
+            done: list[LoggedEvent] = []
+            held = self._held.get(session_id)
+            if streaming:
+                text = str(data.pop("text"))
+                if (
+                    held is not None
+                    and held.type == kind
+                    and held.turn_id == data.get("turn_id")
+                    and now - held.started < self.coalesce_window
+                ):
+                    held.parts.append(text)
+                else:
+                    if held is not None:
+                        done.append(self._flush_held(session_id))
+                    self._held[session_id] = _Held(kind, data.get("turn_id"), data, [text], now)
+                    armed = True
+            else:
+                if held is not None:
+                    done.append(self._flush_held(session_id))
+                assert payload is not None
+                done.append(self._keep(session_id, payload))
+        if armed:
+            self._poke()
+        self._tell(done)
+        return done
+
+    def _flush_held(self, session_id: str) -> LoggedEvent:
+        held = self._held.pop(session_id)
+        data = dict(held.base)
+        data["text"] = "".join(held.parts)
+        return self._keep(session_id, _freeze(data))
+
+    def _keep(self, session_id: str, payload: bytes) -> LoggedEvent:
+        """Number ``payload`` and store it within the caps (lock held)."""
+        seq = self._last.get(session_id, 0) + 1
+        self._last[session_id] = seq
+        entry = LoggedEvent(session_id, seq, self.epoch, payload)
+        ring = self._ring(session_id)
+        limits = self.limits
+        if entry.size > limits.bytes_per_session or entry.size > limits.bytes_process:
+            self._evicted[session_id] = seq  # never kept: a cursor before it has a gap
+            return entry
+        ring.events.append(entry)
+        ring.bytes += entry.size
+        self._total += entry.size
+        while len(ring.events) > limits.events_per_session or ring.bytes > limits.bytes_per_session:
+            self._drop_oldest(session_id, ring)
+        while self._total > limits.bytes_process:
+            victim = next((sid for sid, r in self._rings.items() if r.events), None)
+            if victim is None:  # pragma: no cover - the total counts only kept events
+                break
+            self._drop_oldest(victim, self._rings[victim])
+        return entry
+
+    def _ring(self, session_id: str) -> _Ring:
+        ring = self._rings.get(session_id)
+        if ring is not None:
+            self._rings.move_to_end(session_id)
+            return ring
+        ring = self._rings[session_id] = _Ring()
+        while len(self._rings) > self.limits.sessions:
+            quiet, dropped = self._rings.popitem(last=False)
+            self._total -= dropped.bytes
+            self._evicted[quiet] = max(self._evicted.get(quiet, 0), self._last.get(quiet, 0))
+        return ring
+
+    def _drop_oldest(self, session_id: str, ring: _Ring) -> None:
+        entry = ring.events.popleft()
+        ring.bytes -= entry.size
+        self._total -= entry.size
+        self._evicted[session_id] = max(self._evicted.get(session_id, 0), entry.seq)
+
+    # -- flushing held text -------------------------------------------------------------------
+
+    def flush(self, session_id: str | None = None) -> list[LoggedEvent]:
+        """Number held text now (one session, or every session for ``None``)."""
+        with self._lock:
+            ids = [session_id] if session_id is not None else list(self._held)
+            done = [self._flush_held(sid) for sid in ids if sid in self._held]
+        self._tell(done)
+        return done
+
+    def flush_due(self) -> list[LoggedEvent]:
+        """Number every held piece whose coalescing window is over."""
+        with self._lock:
+            now = self._clock.monotonic()
+            due = [sid for sid, h in self._held.items() if now - h.started >= self.coalesce_window]
+            done = [self._flush_held(sid) for sid in due]
+        self._tell(done)
+        return done
+
+    def next_flush_at(self) -> float | None:
+        """The monotonic time the earliest held piece is due, or None when nothing is held."""
+        with self._lock:
+            if not self._held:
+                return None
+            return min(h.started for h in self._held.values()) + self.coalesce_window
+
+    async def run_flusher(self) -> None:
+        """Flush held text when its window ends; runs until cancelled (on the daemon loop)."""
+        self._wake = asyncio.Event()
+        self._wake_loop = asyncio.get_running_loop()
+        try:
+            while True:
+                due = self.next_flush_at()
+                if due is None:
+                    self._wake.clear()
+                    if self.next_flush_at() is None:
+                        await self._wake.wait()
+                    continue
+                delay = due - self._clock.monotonic()
+                if delay > 0:
+                    await self._clock.sleep(delay)
+                self.flush_due()
+        finally:
+            self._wake = None
+            self._wake_loop = None
+
+    def _poke(self) -> None:
+        wake, loop = self._wake, self._wake_loop
+        if wake is None or loop is None:
+            return
+        try:
+            running = asyncio.get_running_loop()
+        except RuntimeError:
+            running = None
+        if running is loop:
+            wake.set()
+        else:
+            loop.call_soon_threadsafe(wake.set)
+
+    # -- replay -------------------------------------------------------------------------------
+
+    def since(self, session_id: str, epoch: str | None, cursor: int) -> Replay | ReplayGap:
+        """The kept events of ``session_id`` after ``cursor`` (the last seq the client saw)."""
+        if cursor < 0:
+            raise ValueError("cursor must be >= 0")
+        with self._lock:
+            last = self._last.get(session_id, 0)
+            if epoch != self.epoch:
+                return ReplayGap(session_id, self.epoch, last, "epoch_changed")
+            if cursor > last:
+                return ReplayGap(session_id, self.epoch, last, "ahead")
+            if cursor < self._evicted.get(session_id, 0):
+                return ReplayGap(session_id, self.epoch, last, "evicted")
+            ring = self._rings.get(session_id)
+            kept = [e for e in ring.events if e.seq > cursor] if ring is not None else []
+        return Replay(session_id, self.epoch, tuple(e.to_wire() for e in kept), last)
+
+    def last_seq(self, session_id: str) -> int:
+        """The newest seq numbered for ``session_id`` (0 before the first)."""
+        with self._lock:
+            return self._last.get(session_id, 0)
+
+    def forget(self, session_id: str) -> None:
+        """Drop a session's buffer (held text is numbered first); its counter stays."""
+        done: list[LoggedEvent] = []
+        with self._lock:
+            if session_id in self._held:
+                done.append(self._flush_held(session_id))
+            ring = self._rings.pop(session_id, None)
+            if ring is not None:
+                self._total -= ring.bytes
+            if session_id in self._last:
+                self._evicted[session_id] = self._last[session_id]
+        self._tell(done)
+
+    def stats(self) -> dict[str, int]:
+        """Occupancy for diagnostics."""
+        with self._lock:
+            return {
+                "sessions": len(self._rings),
+                "events": sum(len(r.events) for r in self._rings.values()),
+                "bytes": self._total,
+                "held": len(self._held),
+            }
diff --git a/src/indus/service/fences.py b/src/indus/service/fences.py
new file mode 100644
index 0000000..d779287
--- /dev/null
+++ b/src/indus/service/fences.py
@@ -0,0 +1,410 @@
+"""Generation fences: every control names the turn it means (P17-05).
+
+Each turn of a session runs under a generation number that only grows. In the shared daemon a
+session has several viewers, so a control must say which turn it targets: ``interrupt`` and
+``steer`` name a generation, an approval or clarify answer names its request and generation,
+``stop`` names an admission. When the named generation is not the one running, the control is
+refused with ``StaleGeneration`` carrying the generation that does run (or None). A control is never
+re-aimed at "the latest turn", which may belong to another surface (R01.4).
+
+Turn bookkeeping is keyed by generation too (R06.2): ``begin`` records the claimed generation,
+``adopt`` attaches the running turn's controls, ``release`` clears the session only for the
+generation that is running, so a displaced turn finishing late cannot clear its successor.
+
+Between ``begin`` and ``adopt`` (the turn is claimed but its agent is not ready) an interrupt or a
+steer for that generation is latched and delivered at ``adopt`` (steers first, then the stop); it
+is dropped when that generation is released, and never reaches a later one. A ``stop`` for an
+admission whose claim has not reached the fence yet is kept for that generation's ``begin``.
+
+The fence holds the running generation in memory, fed by whoever claims turns (the admission
+worker); the durable copy is the runtime ledger. Decisions are taken under one lock; the turn's
+own methods are called outside it and receive the generation again, so a turn that ended in
+between ignores the call. Results are values: the RPC layer maps ``StaleGeneration`` to the
+protocol's ``stale_generation`` error with the running generation in its data.
+"""
+
+from __future__ import annotations
+
+import inspect
+import threading
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field
+from enum import StrEnum
+from typing import Any, ClassVar, Protocol, cast
+
+from indus.protocol.methods import ServerRequestAnswerResult
+from indus.protocol.requests_port import AnswerModel
+
+__all__ = [
+    "STALE_GENERATION",
+    "AdmissionPort",
+    "AdmissionReceipt",
+    "Answerer",
+    "ControlApplied",
+    "ControlStatus",
+    "GenerationFences",
+    "OpenRequestInfo",
+    "RequestLookup",
+    "RequestNotOpen",
+    "Responded",
+    "StaleGeneration",
+    "StopOutcome",
+    "StopResult",
+    "TurnControls",
+]
+
+STALE_GENERATION = "stale_generation"
+"""The refusal code of a control aimed at a generation that is not running."""
+
+
+# -- ports ------------------------------------------------------------------------------------
+
+
+class TurnControls(Protocol):
+    """What a running turn exposes to the fence (the agent, through a thin adapter)."""
+
+    def interrupt(self, generation: int, *, hard: bool = False, by_system: bool = False) -> bool:
+        """Stop the turn if it still is ``generation``; False when nothing was stopped."""
+        ...
+
+    def steer(self, text: str) -> bool:
+        """Hand guidance to the running turn; False when it no longer takes any."""
+        ...
+
+
+class OpenRequestInfo(Protocol):
+    """An open server request as the fence needs it."""
+
+    @property
+    def generation(self) -> int | None:
+        """The generation of the turn that asked (None when no turn asked)."""
+        ...
+
+
+class RequestLookup(Protocol):
+    """The session's open server requests (``RequestBook`` of P17-07)."""
+
+    def lookup(self, request_id: str) -> OpenRequestInfo | None: ...
+
+
+type Answerer = Callable[[str, Mapping[str, Any] | AnswerModel], ServerRequestAnswerResult]
+"""Hands an answer to the waiting request (``ServerRequestBroker.answer``)."""
+
+
+class AdmissionReceipt(Protocol):
+    """An admission's receipt (P17-02): state ``queued``/``started``/``terminal``/``unknown``."""
+
+    @property
+    def admission_id(self) -> str: ...
+
+    @property
+    def state(self) -> str: ...
+
+    @property
+    def generation(self) -> int | None: ...
+
+
+class AdmissionPort(Protocol):
+    """The admission service calls ``stop`` needs (plain or awaitable results)."""
+
+    def receipt(
+        self, admission_id: str
+    ) -> AdmissionReceipt | None | Awaitable[AdmissionReceipt | None]: ...
+
+    def cancel(self, admission_id: str) -> AdmissionReceipt | Awaitable[AdmissionReceipt]: ...
+
+
+# -- results ----------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True, slots=True)
+class StaleGeneration:
+    """The control named a generation that is not running; nothing was done."""
+
+    session_id: str
+    requested: int | None
+    current: int | None
+    """The generation running now, or None when the session is idle."""
+    code: ClassVar[str] = STALE_GENERATION
+
+    def to_data(self) -> dict[str, Any]:
+        """The ``error.data`` of the protocol refusal."""
+        data: dict[str, Any] = {"reason": self.code, "running": self.current is not None}
+        if self.current is not None:
+            data["generation"] = self.current
+        return data
+
+
+class ControlStatus(StrEnum):
+    """What happened to an accepted control."""
+
+    DELIVERED = "delivered"
+    """The running turn took it."""
+    LATCHED = "latched"
+    """The turn is claimed but not ready; it gets the control when it adopts its controls."""
+    REJECTED = "rejected"
+    """The turn is ending and took nothing."""
+
+
+@dataclass(frozen=True, slots=True)
+class ControlApplied:
+    """An interrupt or steer that reached (or is waiting for) its generation."""
+
+    session_id: str
+    generation: int
+    status: ControlStatus
+
+
+@dataclass(frozen=True, slots=True)
+class Responded:
+    """The answer reached its request."""
+
+    request_id: str
+    accepted: bool
+
+
+@dataclass(frozen=True, slots=True)
+class RequestNotOpen:
+    """The request was already answered, withdrawn or never sent: the answer did nothing."""
+
+    request_id: str
+
+
+class StopOutcome(StrEnum):
+    """What a ``stop(admission_id)`` did."""
+
+    CANCELLED = "cancelled"
+    """The admission was still queued and is now cancelled."""
+    INTERRUPTED = "interrupted"
+    """The admission's turn runs (or is claimed) and was told to stop."""
+    ALREADY_SETTLED = "already_settled"
+    """The admission's turn already ended."""
+    UNKNOWN = "unknown"
+    """The admission's outcome is unknown; only an operator discard resolves it."""
+    NOT_FOUND = "not_found"
+
+
+@dataclass(frozen=True, slots=True)
+class StopResult:
+    admission_id: str
+    outcome: StopOutcome
+    generation: int | None = None
+    status: ControlStatus | None = None
+
+
+# -- the fence --------------------------------------------------------------------------------
+
+
+@dataclass(slots=True)
+class _Stop:
+    hard: bool
+    by_system: bool
+
+
+@dataclass(slots=True)
+class _Session:
+    running: int | None = None
+    latest: int | None = None
+    controls: TurnControls | None = None
+    latched_stop: _Stop | None = None
+    latched_steers: list[str] = field(default_factory=list[str])
+    early_stop: int | None = None
+    requests: RequestLookup | None = None
+    answer: Answerer | None = None
+
+    def clear_turn(self) -> None:
+        self.running = None
+        self.controls = None
+        self.latched_stop = None
+        self.latched_steers.clear()
+
+
+async def _resolved[T](value: T | Awaitable[T]) -> T:
+    if inspect.isawaitable(value):
+        return cast(T, await value)
+    return cast(T, value)
+
+
+class GenerationFences:
+    """Generation checks for the controls of every session in one daemon."""
+
+    def __init__(self, *, admissions: AdmissionPort | None = None) -> None:
+        self._admissions = admissions
+        self._lock = threading.Lock()
+        self._sessions: dict[str, _Session] = {}
+
+    def _state(self, session_id: str) -> _Session:
+        state = self._sessions.get(session_id)
+        if state is None:
+            state = self._sessions[session_id] = _Session()
+        return state
+
+    # -- wiring -------------------------------------------------------------------------------
+
+    def bind_requests(self, session_id: str, requests: RequestLookup, answer: Answerer) -> None:
+        """Route approval/clarify answers of ``session_id`` to its request book and broker."""
+        with self._lock:
+            state = self._state(session_id)
+            state.requests = requests
+            state.answer = answer
+
+    def forget(self, session_id: str) -> None:
+        """Drop everything known about a closed session."""
+        with self._lock:
+            self._sessions.pop(session_id, None)
+
+    # -- turn lifecycle -----------------------------------------------------------------------
+
+    def begin(self, session_id: str, generation: int) -> None:
+        """``generation`` was claimed and now runs (a still-running older one is displaced)."""
+        with self._lock:
+            state = self._state(session_id)
+            if state.latest is not None and generation <= state.latest:
+                raise ValueError(
+                    f"generation {generation} of {session_id} is not above {state.latest}"
+                )
+            state.clear_turn()
+            state.running = state.latest = generation
+            if state.early_stop is not None and state.early_stop <= generation:
+                if state.early_stop == generation:
+                    state.latched_stop = _Stop(hard=True, by_system=False)
+                state.early_stop = None
+
+    def adopt(self, session_id: str, generation: int, controls: TurnControls) -> bool:
+        """The running turn attaches its controls; latched steers and stop are delivered now."""
+        with self._lock:
+            state = self._sessions.get(session_id)
+            if state is None or state.running != generation:
+                return False
+            state.controls = controls
+            steers, state.latched_steers = state.latched_steers, []
+            stop, state.latched_stop = state.latched_stop, None
+        for text in steers:
+            controls.steer(text)
+        if stop is not None:
+            controls.interrupt(generation, hard=stop.hard, by_system=stop.by_system)
+        return True
+
+    def release(self, session_id: str, generation: int) -> bool:
+        """The turn ``generation`` ended; only the running generation clears the session."""
+        with self._lock:
+            state = self._sessions.get(session_id)
+            if state is None or state.running != generation:
+                return False
+            state.clear_turn()
+            return True
+
+    def running(self, session_id: str) -> int | None:
+        """The generation running now, or None."""
+        with self._lock:
+            state = self._sessions.get(session_id)
+            return state.running if state is not None else None
+
+    def latest(self, session_id: str) -> int | None:
+        """The newest generation this fence has seen begin, or None."""
+        with self._lock:
+            state = self._sessions.get(session_id)
+            return state.latest if state is not None else None
+
+    # -- controls -----------------------------------------------------------------------------
+
+    def interrupt(
+        self, session_id: str, generation: int, *, hard: bool = False, by_system: bool = False
+    ) -> ControlApplied | StaleGeneration:
+        """Stop the turn ``generation`` of ``session_id``, and only that turn."""
+        with self._lock:
+            state = self._state(session_id)
+            if state.running is None or state.running != generation:
+                return StaleGeneration(session_id, generation, state.running)
+            controls = state.controls
+            if controls is None:
+                previous = state.latched_stop
+                state.latched_stop = _Stop(
+                    hard=hard or (previous is not None and previous.hard),
+                    by_system=by_system and (previous is None or previous.by_system),
+                )
+                return ControlApplied(session_id, generation, ControlStatus.LATCHED)
+        done = controls.interrupt(generation, hard=hard, by_system=by_system)
+        status = ControlStatus.DELIVERED if done else ControlStatus.REJECTED
+        return ControlApplied(session_id, generation, status)
+
+    def steer(
+        self, session_id: str, generation: int, text: str
+    ) -> ControlApplied | StaleGeneration:
+        """Hand ``text`` to the turn ``generation``; blank text is a caller error."""
+        if not text.strip():
+            raise ValueError("steer text must not be empty")
+        with self._lock:
+            state = self._state(session_id)
+            if state.running is None or state.running != generation:
+                return StaleGeneration(session_id, generation, state.running)
+            controls = state.controls
+            if controls is None:
+                state.latched_steers.append(text)
+                return ControlApplied(session_id, generation, ControlStatus.LATCHED)
+        done = controls.steer(text)
+        status = ControlStatus.DELIVERED if done else ControlStatus.REJECTED
+        return ControlApplied(session_id, generation, status)
+
+    def respond(
+        self,
+        session_id: str,
+        request_id: str,
+        generation: int,
+        answer: Mapping[str, Any] | AnswerModel,
+    ) -> Responded | RequestNotOpen | StaleGeneration:
+        """Answer an approval or clarify request asked by turn ``generation``.
+
+        A request that is no longer open (answered elsewhere, withdrawn, timed out) is a quiet
+        no-op. An open request answered with another generation, or whose turn no longer runs,
+        is stale. A malformed answer raises the broker's ``ProtocolError``.
+        """
+        with self._lock:
+            state = self._state(session_id)
+            requests, answer_fn, running = state.requests, state.answer, state.running
+        if requests is None or answer_fn is None:
+            return RequestNotOpen(request_id)
+        info = requests.lookup(request_id)
+        if info is None:
+            return RequestNotOpen(request_id)
+        asked_by = info.generation
+        if asked_by is not None and (asked_by != generation or running != generation):
+            return StaleGeneration(session_id, generation, running)
+        result = answer_fn(request_id, answer)
+        return Responded(request_id, result.accepted)
+
+    async def stop(self, session_id: str, admission_id: str) -> StopResult:
+        """Stop one admission: cancel it while queued, else interrupt exactly its generation."""
+        if self._admissions is None:
+            raise RuntimeError("stop needs the admission service")
+        receipt = await _resolved(self._admissions.receipt(admission_id))
+        if receipt is None:
+            return StopResult(admission_id, StopOutcome.NOT_FOUND)
+        if receipt.state == "queued":
+            receipt = await _resolved(self._admissions.cancel(admission_id))
+            if receipt.state == "terminal":
+                return StopResult(admission_id, StopOutcome.CANCELLED, receipt.generation)
+            if receipt.state == "queued":
+                raise RuntimeError(f"admission {admission_id} stayed queued after cancel")
+            # Claimed between our read and the cancel: stop that exact claim below.
+        if receipt.state == "unknown":
+            return StopResult(admission_id, StopOutcome.UNKNOWN, receipt.generation)
+        if receipt.state != "started" or receipt.generation is None:
+            return StopResult(admission_id, StopOutcome.ALREADY_SETTLED, receipt.generation)
+        return self._stop_generation(session_id, admission_id, receipt.generation)
+
+    def _stop_generation(self, session_id: str, admission_id: str, generation: int) -> StopResult:
+        with self._lock:
+            state = self._state(session_id)
+            if state.running != generation:
+                if state.latest is None or generation > state.latest:
+                    # The claim has not reached the fence yet: stop it when it begins.
+                    state.early_stop = generation
+                    return StopResult(
+                        admission_id, StopOutcome.INTERRUPTED, generation, ControlStatus.LATCHED
+                    )
+                return StopResult(admission_id, StopOutcome.ALREADY_SETTLED, generation)
+        applied = self.interrupt(session_id, generation, hard=True)
+        if isinstance(applied, StaleGeneration):  # released in between
+            return StopResult(admission_id, StopOutcome.ALREADY_SETTLED, generation)
+        return StopResult(admission_id, StopOutcome.INTERRUPTED, generation, applied.status)
diff --git a/src/indus/service/request_redelivery.py b/src/indus/service/request_redelivery.py
new file mode 100644
index 0000000..8398873
--- /dev/null
+++ b/src/indus/service/request_redelivery.py
@@ -0,0 +1,318 @@
+"""Server requests that outlive viewer connections: offer, re-offer, settle once (P17-07).
+
+In the daemon a session may be watched by several viewers (CLI, TUI, desktop …). When the agent
+asks a person something, the session's ``RequestBook`` offers the request to every attached viewer
+that can render its kind and keeps it open until it is settled. Ids are ``srq-<12 hex>`` (strings,
+so they never collide with the client's integer request ids).
+
+- Re-offer: a viewer that attaches again, or that catches up through ``events.since``, is offered
+  every still-open request it can render once more, with ``replayed: True`` and the same id. An
+  answer from any copy of a card therefore names the same request, and the first answer wins.
+- Settlement: ``settle`` removes the request and announces it once with a ``request.settled``
+  event (``answered``, ``withdrawn`` or ``undeliverable``) so every other card closes. A second
+  settlement of the same id does nothing.
+- Refusals (R05.3): a viewer that cannot render the kind it was sent answers ``-32601`` at once;
+  a viewer that advertised the decline capability may answer ``4404`` ("not shown here"); any
+  other error a viewer answers with counts like ``-32601``. Each leaves the request to the other
+  viewers. When no attached viewer that could answer is left, the
+  request is settled ``undeliverable`` right away, never by waiting out a timeout; the broker then
+  fails the asker with ``RequestUnsupported`` (R02.5: distinct from a timeout or a denial). A
+  ``4404`` from a viewer without the capability is ignored.
+- A viewer that detaches does not refuse anything: its open requests wait for it (or another
+  viewer) until the asker's own deadline.
+
+The book lives in memory for the daemon's life; after a restart the turn that asked is
+``unknown`` (R03.21) and its requests are gone with it. Every method runs on the session's event
+loop, like the broker.
+"""
+
+from __future__ import annotations
+
+import logging
+import secrets
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass, field
+from enum import StrEnum
+from typing import Any
+
+from indus.protocol.envelope import ErrorObject
+from indus.protocol.errors import METHOD_NOT_FOUND, SERVER_REQUEST_UNSUPPORTED, make_error
+from indus.protocol.server_requests import (
+    SERVER_REQUEST_KINDS,
+    ApprovalRequest,
+    ClarifyRequest,
+    SecretRequest,
+    SudoRequest,
+)
+
+__all__ = [
+    "NOT_SHOWN_CODE",
+    "REQUEST_ID_PREFIX",
+    "SETTLED_EVENT",
+    "UNRENDERABLE_CODE",
+    "Offer",
+    "OpenRequest",
+    "RequestBook",
+    "RequestViewer",
+    "SettleOutcome",
+    "new_request_id",
+]
+
+log = logging.getLogger(__name__)
+
+REQUEST_ID_PREFIX = "srq-"
+NOT_SHOWN_CODE = 4404
+"""A viewer's "this request is not shown here" answer (only with the decline capability)."""
+UNRENDERABLE_CODE = METHOD_NOT_FOUND.code
+"""A viewer's "I cannot render this kind" answer (JSON-RPC method not found, -32601)."""
+SETTLED_EVENT = "request.settled"
+
+type OfferedRequest = ApprovalRequest | ClarifyRequest | SudoRequest | SecretRequest
+type SettledEmitter = Callable[[Mapping[str, Any]], object]
+type UndeliverableHook = Callable[[str, ErrorObject], object]
+
+
+def new_request_id() -> str:
+    """A fresh server-request id: ``srq-`` and 12 lowercase hex digits."""
+    return REQUEST_ID_PREFIX + secrets.token_hex(6)
+
+
+class SettleOutcome(StrEnum):
+    """How an open request ended."""
+
+    ANSWERED = "answered"
+    WITHDRAWN = "withdrawn"
+    UNDELIVERABLE = "undeliverable"
+
+
+@dataclass(frozen=True, slots=True)
+class Offer:
+    """One request as sent to one viewer."""
+
+    request: OfferedRequest
+    generation: int | None
+    """The generation of the turn that asked (named again in the viewer's answer)."""
+    replayed: bool
+    """True when this is a repeat of an earlier offer (reattach or catch-up)."""
+
+    def to_wire(self) -> dict[str, Any]:
+        body: dict[str, Any] = {"request": self.request.to_wire(), "replayed": self.replayed}
+        if self.generation is not None:
+            body["generation"] = self.generation
+        return body
+
+
+@dataclass(frozen=True, slots=True)
+class RequestViewer:
+    """An attached viewer as the book sees it."""
+
+    viewer_id: str
+    kinds: frozenset[str]
+    """Request kinds the viewer can render."""
+    send: Callable[[Offer], object]
+    can_decline: bool = False
+    """Whether the viewer advertised the 4404 decline capability."""
+
+    @classmethod
+    def of(
+        cls,
+        viewer_id: str,
+        kinds: Iterable[str],
+        send: Callable[[Offer], object],
+        *,
+        can_decline: bool = False,
+    ) -> RequestViewer:
+        known = frozenset(k for k in kinds if k in SERVER_REQUEST_KINDS)
+        return cls(viewer_id, known, send, can_decline)
+
+
+@dataclass(slots=True)
+class OpenRequest:
+    """A request waiting for its first answer."""
+
+    request: OfferedRequest
+    generation: int | None
+    offered: set[str] = field(default_factory=set[str])
+    """Viewer ids it was sent to."""
+    refused: dict[str, int] = field(default_factory=dict[str, int])
+    """Viewer id → the code it refused with (-32601 or 4404)."""
+
+    @property
+    def request_id(self) -> str:
+        return self.request.request_id
+
+    @property
+    def kind(self) -> str:
+        return self.request.kind
+
+
+class RequestBook:
+    """The open server requests of one session and the viewers they go to."""
+
+    def __init__(
+        self,
+        session_id: str,
+        *,
+        emit: SettledEmitter,
+        generation: Callable[[], int | None] = lambda: None,
+    ) -> None:
+        self.session_id = session_id
+        self._emit = emit
+        self._generation = generation
+        self._viewers: dict[str, RequestViewer] = {}
+        self._open: dict[str, OpenRequest] = {}
+        self._undeliverable: UndeliverableHook | None = None
+
+    def bind_undeliverable(self, hook: UndeliverableHook | None) -> None:
+        """Called with ``(request_id, error)`` when a request is settled undeliverable."""
+        self._undeliverable = hook
+
+    # -- viewers ------------------------------------------------------------------------------
+
+    def attach(self, viewer: RequestViewer) -> int:
+        """Add (or replace) a viewer and offer it every open request it can render."""
+        self._viewers[viewer.viewer_id] = viewer
+        return self.reoffer(viewer.viewer_id)
+
+    def detach(self, viewer_id: str) -> bool:
+        """Remove a viewer; its open requests stay open."""
+        return self._viewers.pop(viewer_id, None) is not None
+
+    def viewers(self) -> list[str]:
+        return list(self._viewers)
+
+    def can_render(self, kind: str) -> bool:
+        """Whether any attached viewer can render ``kind``."""
+        return any(kind in v.kinds for v in self._viewers.values())
+
+    def answerable_kinds(self) -> frozenset[str]:
+        """Every kind at least one attached viewer can render."""
+        kinds: set[str] = set()
+        for viewer in self._viewers.values():
+            kinds |= viewer.kinds
+        return frozenset(kinds)
+
+    # -- offering -----------------------------------------------------------------------------
+
+    def offer(self, request: OfferedRequest) -> OpenRequest | None:
+        """Open ``request`` and send it to every viewer that can render it.
+
+        Returns the open entry, or None when nobody could take it (then it was settled
+        undeliverable at once).
+        """
+        if request.request_id in self._open:
+            raise ValueError(f"server request {request.request_id} is already open")
+        entry = OpenRequest(request, self._generation())
+        self._open[request.request_id] = entry
+        targets = [v for v in self._viewers.values() if request.kind in v.kinds]
+        if not targets:
+            self._give_up(entry)
+            return None
+        for viewer in targets:
+            self._send(viewer, entry, replayed=False)
+        return entry if request.request_id in self._open else None
+
+    def reoffer(self, viewer_id: str) -> int:
+        """Offer ``viewer_id`` every open request it can render again (``replayed``)."""
+        viewer = self._viewers.get(viewer_id)
+        if viewer is None:
+            return 0
+        count = 0
+        for entry in list(self._open.values()):
+            if entry.kind not in viewer.kinds or viewer_id in entry.refused:
+                continue
+            if entry.request_id not in self._open:  # settled by an earlier send in this loop
+                continue
+            self._send(viewer, entry, replayed=True)
+            count += 1
+        return count
+
+    def _send(self, viewer: RequestViewer, entry: OpenRequest, *, replayed: bool) -> None:
+        entry.offered.add(viewer.viewer_id)
+        try:
+            viewer.send(Offer(entry.request, entry.generation, replayed))
+        except Exception:
+            log.warning(
+                "could not offer server request %s to viewer %s",
+                entry.request_id,
+                viewer.viewer_id,
+                exc_info=True,
+            )
+
+    # -- refusals -----------------------------------------------------------------------------
+
+    def refuse(self, viewer_id: str, request_id: str, code: int) -> bool:
+        """A viewer answered ``request_id`` with an error instead of an answer.
+
+        ``-32601`` (cannot render) and any other error code count as that viewer refusing;
+        ``4404`` counts only from a viewer with the decline capability. Returns True when the
+        refusal was recorded. When it leaves no attached viewer that could answer, the request is
+        settled undeliverable at once.
+        """
+        entry = self._open.get(request_id)
+        if entry is None:
+            return False
+        viewer = self._viewers.get(viewer_id)
+        if code == NOT_SHOWN_CODE and (viewer is None or not viewer.can_decline):
+            log.warning(
+                "viewer %s declined %s without the decline capability; ignored",
+                viewer_id,
+                request_id,
+            )
+            return False
+        entry.refused[viewer_id] = code
+        if not any(
+            entry.kind in v.kinds and v.viewer_id not in entry.refused
+            for v in self._viewers.values()
+        ):
+            self._give_up(entry)
+        return True
+
+    def _give_up(self, entry: OpenRequest) -> None:
+        codes = set(entry.refused.values())
+        reason = "not_shown" if codes == {NOT_SHOWN_CODE} else "unsupported"
+        self.settle(entry.request_id, SettleOutcome.UNDELIVERABLE, reason)
+
+    # -- settling -----------------------------------------------------------------------------
+
+    def settle(self, request_id: str, outcome: SettleOutcome, reason: str | None = None) -> bool:
+        """Close ``request_id`` with ``outcome``; only the first settlement counts."""
+        entry = self._open.pop(request_id, None)
+        if entry is None:
+            return False
+        event: dict[str, Any] = {
+            "type": SETTLED_EVENT,
+            "session_id": self.session_id,
+            "request_id": request_id,
+            "kind": entry.kind,
+            "outcome": outcome.value,
+        }
+        if reason:
+            event["reason"] = reason
+        try:
+            self._emit(event)
+        except Exception:
+            log.warning("could not announce settlement of %s", request_id, exc_info=True)
+        if outcome is SettleOutcome.UNDELIVERABLE and self._undeliverable is not None:
+            why = (
+                "every attached viewer declined it (not shown there)"
+                if reason == "not_shown"
+                else "no attached viewer can answer it"
+            )
+            error = make_error(
+                SERVER_REQUEST_UNSUPPORTED,
+                f"the {entry.kind} request could not be delivered: {why}",
+                retryable=False,
+            )
+            self._undeliverable(request_id, error)
+        return True
+
+    # -- reading ------------------------------------------------------------------------------
+
+    def lookup(self, request_id: str) -> OpenRequest | None:
+        """The open request ``request_id``, or None once settled (or never opened)."""
+        return self._open.get(request_id)
+
+    def open_requests(self) -> list[OpenRequest]:
+        """Open requests, oldest first."""
+        return list(self._open.values())
