+# STAND-IN: removed at integration
+"""Stand-in for K1's admission service (P17-02) as P17-05's ``stop`` uses it.
+
+Assumed interface (the integrator reconciles it with ``indus.service.admissions``):
+
+- ``receipt(admission_id) -> Receipt | None`` (may be async): ``Receipt`` has ``admission_id``,
+  ``state`` (``queued`` / ``started`` / ``terminal`` / ``unknown``) and ``generation``
+  (set once started).
+- ``cancel(admission_id) -> Receipt`` (may be async): a queued admission becomes ``terminal``
+  (cancelled); an admission the worker already claimed comes back ``started`` with its generation,
+  unchanged; terminal and unknown admissions come back unchanged.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable
+from dataclasses import dataclass, replace
+
+
+@dataclass(frozen=True, slots=True)
+class Receipt:
+    admission_id: str
+    state: str
+    generation: int | None = None
+    terminal_kind: str | None = None
+
+
+class FakeAdmissions:
+    """An in-memory admission table with an optional race hook before cancel commits."""
+
+    def __init__(self) -> None:
+        self.rows: dict[str, Receipt] = {}
+        self.before_cancel: Callable[[str], None] | None = None
+        self.calls: list[tuple[str, str]] = []
+
+    def add(self, admission_id: str, state: str, generation: int | None = None) -> None:
+        self.rows[admission_id] = Receipt(admission_id, state, generation)
+
+    def claim(self, admission_id: str, generation: int) -> None:
+        self.rows[admission_id] = replace(
+            self.rows[admission_id], state="started", generation=generation
+        )
+
+    async def receipt(self, admission_id: str) -> Receipt | None:
+        self.calls.append(("receipt", admission_id))
+        return self.rows.get(admission_id)
+
+    async def cancel(self, admission_id: str) -> Receipt:
+        self.calls.append(("cancel", admission_id))
+        if self.before_cancel is not None:
+            self.before_cancel(admission_id)
+        row = self.rows[admission_id]
+        if row.state == "queued":
+            row = self.rows[admission_id] = replace(
+                row, state="terminal", terminal_kind="cancelled"
+            )
+        return row
+
+
+class SyncAdmissions(FakeAdmissions):
+    """The same table with plain (non-async) methods."""
+
+    def receipt(self, admission_id: str) -> Receipt | None:  # type: ignore[override]
+        self.calls.append(("receipt", admission_id))
+        return self.rows.get(admission_id)
+
+    def cancel(self, admission_id: str) -> Receipt:  # type: ignore[override]
+        self.calls.append(("cancel", admission_id))
+        row = self.rows[admission_id]
+        if row.state == "queued":
+            row = self.rows[admission_id] = replace(
+                row, state="terminal", terminal_kind="cancelled"
+            )
+        return row
