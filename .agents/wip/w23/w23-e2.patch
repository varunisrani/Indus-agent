+        rig.clock.advance(10.0)  # sent ten seconds before the listener starts
+        await rig.connect()
+        rig.wire.platform.group(ROOM, ANA, "fresh", mention=True)
+        await pump(rig.clock)
+        assert [e.text for e in rig.events] == ["fresh"]
+        await rig.close()
