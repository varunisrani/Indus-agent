+def test_dump_json_arrays_fold_to_the_line_width_counting_the_comma() -> None:
+    # ``  "k": `` is 7 columns; ["a…", "b"] adds 9 around the first string, the comma 1 more.
+    fits = 100 - 7 - 9 - 1
+    data = {"k": ["a" * fits, "b"], "z": []}
+    assert notices.dump_json(data) == '{\n  "k": ["' + "a" * fits + '", "b"],\n  "z": []\n}\n'
