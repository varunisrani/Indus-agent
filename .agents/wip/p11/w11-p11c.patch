index 0000000..3fd4dfc
--- /dev/null
+++ b/src/indus/backends/checkpoints/prune.py
@@ -0,0 +1,284 @@
+"""Keeping the checkpoint store bounded (P11-18).
+
+- ``apply_plan(store, plan)``: the ``CheckpointStore.prune`` the ``indus checkpoints prune``
+  command calls — delete the planned projects in order (orphans, stale, oversize), then reclaim
+  space with ``git gc --prune=now``. Failures are counted, never raised.
+- ``trim_history(store, key, keep)``: the snapshot path's per-project cap (``max_snapshots``):
+  rebuild the newest ``keep`` checkpoints as a fresh chain (same trees, messages and dates) and
+  leave the gc to the next prune (marked by ``.gc-pending``).
+- ``fit_size(store, cap)``: gc, then drop the globally oldest checkpoint (never a project's
+  newest) and gc again until the store fits ``cap``; bounded number of drops.
+- ``prune_store(...)``: the full order — orphans (unless kept), stale projects, gc, size pass.
+- ``auto_prune(...)``: ``prune_store`` at most once per ``min_interval_hours``, throttled by
+  ``<base>/.last_prune``; the marker is written before the work starts so a prune that dies costs
+  one interval, not a gc on every start. The automatic prune never deletes orphans: a missing
+  folder may be a drive that is not mounted right now.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+from dataclasses import dataclass, replace
+
+from indus.backends.checkpoint_api import PrunePlan, PruneResult, plan_prune
+from indus.backends.checkpoints.store import GitError, ShadowStore
+
+__all__ = [
+    "GC_PENDING",
+    "MAX_SIZE_DROPS",
+    "PRUNE_MARKER",
+    "AutoPrune",
+    "StorePrune",
+    "apply_plan",
+    "auto_prune",
+    "delete_project",
+    "fit_size",
+    "gc",
+    "prune_store",
+    "rewrite_history",
+    "trim_history",
+]
+
+log = logging.getLogger(__name__)
+
+PRUNE_MARKER = ".last_prune"
+GC_PENDING = ".gc-pending"
+MAX_SIZE_DROPS = 200
+HOUR = 3600.0
+MB = 1024 * 1024
+
+
+@dataclass(frozen=True)
+class StorePrune:
+    """What a full prune did: the project deletions, checkpoints dropped for size, and whether
+    the store fits its cap now."""
+
+    result: PruneResult
+    dropped_checkpoints: int = 0
+    fits: bool = True
+
+
+@dataclass(frozen=True)
+class AutoPrune:
+    ran: bool
+    outcome: StorePrune | None = None
+    reason: str = ""
+
+
+def gc(store: ShadowStore) -> None:
+    """Reclaim unreachable objects now. Raises ``GitError``."""
+    store.must(["reflog", "expire", "--expire=now", "--all"])
+    store.must(["gc", "--prune=now", "--quiet"], timeout=store.timeout * 4)
+    with contextlib.suppress(OSError):
+        (store.store_dir / GC_PENDING).unlink()
+
+
+def _mark_gc_pending(store: ShadowStore) -> None:
+    with contextlib.suppress(OSError):
+        (store.store_dir / GC_PENDING).touch()
+
+
+def delete_project(store: ShadowStore, key: str) -> bool:
+    """Drop one project's ref, index, metadata and ledger; False when the ref could not go."""
+    if store.tip(key) is not None and not store.git(["update-ref", "-d", store.ref(key)]).ok:
+        return False
+    for path in (store.index_path(key), store.meta_path(key), store.ledger_path(key)):
+        with contextlib.suppress(OSError):
+            path.unlink()
+    return True
+
+
+def apply_plan(store: ShadowStore, plan: PrunePlan) -> PruneResult:
+    """Delete the planned projects in order, then gc (see the module notes)."""
+    if not store.exists():
+        return PruneResult()
+    try:
+        with store.lock():
+            before = store.size()
+            scanned = len(store.project_keys())
+            counts = {"orphan": 0, "stale": 0, "oversize": 0}
+            errors = 0
+            for group, keys in (
+                ("orphan", plan.orphans),
+                ("stale", plan.stale),
+                ("oversize", plan.oversize),
+            ):
+                for key in keys:
+                    if delete_project(store, key):
+                        counts[group] += 1
+                    else:
+                        errors += 1
+            if sum(counts.values()) or (store.store_dir / GC_PENDING).exists():
+                try:
+                    gc(store)
+                except GitError as exc:
+                    log.warning("checkpoint gc failed: %s", exc)
+                    errors += 1
+            freed = max(0, before - store.size())
+    except (GitError, OSError) as exc:
+        log.warning("checkpoint prune stopped: %s", exc)
+        return PruneResult(errors=1)
+    return PruneResult(
+        scanned=scanned,
+        deleted_orphan=counts["orphan"],
+        deleted_stale=counts["stale"],
+        deleted_oversize=counts["oversize"],
+        errors=errors,
+        bytes_freed=freed,
+    )
+
+
+def rewrite_history(store: ShadowStore, key: str, keep: list[str]) -> str:
+    """Make ``keep`` (oldest first, a tail of the project's history) the whole history: each
+    commit is recreated with its tree, message and dates on top of the previous one. The ref
+    moves only if nobody moved it meanwhile. Returns the new tip; raises ``GitError``."""
+    if not keep:
+        raise GitError("a project keeps at least one checkpoint")
+    old_tip = store.tip(key)
+    if old_tip is None:
+        raise GitError(f"checkpoint project {key} has no history")
+    parent: str | None = None
+    for sha in keep:
+        shown = store.must(["log", "-1", "--format=%T%x00%at%x00%ct%x00%B", sha])
+        fields = shown.out.decode("utf-8", "surrogateescape").split("\0", 3)
+        if len(fields) != 4:
+            raise GitError(f"checkpoint {sha[:8]} could not be read")
+        tree, authored, committed, message = fields
+        args = ["commit-tree", tree, "--no-gpg-sign", "-F", "-"]
+        if parent is not None:
+            args += ["-p", parent]
+        dates = {
+            "GIT_AUTHOR_DATE": f"@{authored.strip()} +0000",
+            "GIT_COMMITTER_DATE": f"@{committed.strip()} +0000",
+        }
+        parent = store.must(
+            args, input=message.rstrip("\n").encode("utf-8", "surrogateescape") + b"\n", env=dates
+        ).text
+    assert parent is not None
+    store.must(["update-ref", store.ref(key), parent, old_tip])
+    return parent
+
+
+def trim_history(store: ShadowStore, key: str, keep: int) -> int:
+    """Keep the newest ``keep`` (at least one) checkpoints of a project; returns how many were
+    dropped. The objects are reclaimed by the next prune."""
+    commits = store.commits(key)
+    keep = max(1, keep)
+    if len(commits) <= keep:
+        return 0
+    rewrite_history(store, key, commits[-keep:])
+    _mark_gc_pending(store)
+    return len(commits) - keep
+
+
+def fit_size(
+    store: ShadowStore, cap_bytes: int, *, max_drops: int = MAX_SIZE_DROPS
+) -> tuple[int, bool]:
+    """gc, then drop the oldest checkpoint of the whole store (a project's newest is never
+    dropped) and gc again until the store fits; returns ``(dropped, fits)``."""
+    if cap_bytes <= 0:
+        return 0, True
+    gc(store)
+    dropped = 0
+    while store.size() > cap_bytes:
+        if dropped >= max_drops:
+            return dropped, False
+        oldest: tuple[float, str, list[str]] | None = None
+        for key in store.project_keys():
+            commits = store.commits(key)
+            if len(commits) < 2:
+                continue
+            when = store.must(["log", "-1", "--format=%ct", commits[0]]).text
+            try:
+                stamp = float(when)
+            except ValueError:
+                stamp = 0.0
+            if oldest is None or (stamp, key) < (oldest[0], oldest[1]):
+                oldest = (stamp, key, commits)
+        if oldest is None:
+            return dropped, False
+        rewrite_history(store, oldest[1], oldest[2][1:])
+        dropped += 1
+        gc(store)
+    return dropped, True
+
+
+def prune_store(
+    store: ShadowStore,
+    *,
+    now: float,
+    retention_days: float = 7,
+    max_total_size_mb: int = 500,
+    delete_orphans: bool = True,
+) -> StorePrune:
+    """The full prune order (see the module notes). Never raises."""
+    if not store.exists():
+        return StorePrune(PruneResult())
+    projects = store.list_projects()
+    plan = plan_prune(
+        projects,
+        now=now,
+        retention_days=retention_days,
+        max_size_bytes=2**62,  # sizes are trimmed per checkpoint below, not per project
+        delete_orphans=delete_orphans,
+    )
+    result = apply_plan(store, plan)
+    try:
+        with store.lock():
+            before = store.size()
+            dropped, fits = fit_size(store, max(0, max_total_size_mb) * MB)
+            freed = max(0, before - store.size())
+    except (GitError, OSError) as exc:
+        log.warning("checkpoint size pass stopped: %s", exc)
+        return StorePrune(replace(result, errors=result.errors + 1), 0, False)
+    if not fits:
+        log.warning(
+            "the checkpoint store is still over %d MB; every project keeps its newest checkpoint",
+            max_total_size_mb,
+        )
+    result = replace(result, bytes_freed=result.bytes_freed + freed)
+    return StorePrune(result, dropped, fits)
+
+
+def _last_prune(store: ShadowStore) -> float | None:
+    try:
+        return float((store.base / PRUNE_MARKER).read_text(encoding="utf-8").strip())
+    except (OSError, ValueError):
+        return None
+
+
+def auto_prune(
+    store: ShadowStore,
+    *,
+    now: float,
+    retention_days: float = 7,
+    max_total_size_mb: int = 500,
+    min_interval_hours: float = 24,
+) -> AutoPrune:
+    """``prune_store`` without orphan deletion, at most once per ``min_interval_hours``."""
+    if not store.exists():
+        return AutoPrune(False, reason="no checkpoint store yet")
+    last = _last_prune(store)
+    if last is not None and 0 <= now - last < max(min_interval_hours, 0) * HOUR:
+        return AutoPrune(False, reason="pruned recently")
+    try:
+        (store.base / PRUNE_MARKER).write_text(repr(now), encoding="utf-8")
+    except OSError as exc:
+        log.debug("checkpoint prune marker not written: %s", exc)
+    outcome = prune_store(
+        store,
+        now=now,
+        retention_days=retention_days,
+        max_total_size_mb=max_total_size_mb,
+        delete_orphans=False,
+    )
+    removed = outcome.result.deleted_stale + outcome.result.deleted_orphan
+    if removed or outcome.dropped_checkpoints:
+        log.info(
+            "checkpoint prune: %d project(s) and %d checkpoint(s) removed, %d bytes freed",
+            removed,
+            outcome.dropped_checkpoints,
+            outcome.result.bytes_freed,
+        )
+    return AutoPrune(True, outcome)
diff --git a/src/indus/backends/checkpoints/rollback.py b/src/indus/backends/checkpoints/rollback.py
new file mode 100644
index 0000000..b5c4406
--- /dev/null
+++ b/src/indus/backends/checkpoints/rollback.py
@@ -0,0 +1,265 @@
+"""Listing, diffing and restoring checkpoints (P11-17).
+
+Checkpoints of a folder are numbered newest first from 1. Every restore first snapshots the files
+as they are now ("before rollback to <id>"), so a rollback can itself be rolled back; the restore
+is refused when that safety snapshot fails (an unchanged tree is fine: it is already captured).
+
+- ``list_checkpoints(store, folder)``: ``Checkpoint`` rows (time, reason, session/turn, files
+  changed against the checkpoint before).
+- ``diff(store, folder, n)``: the unified diff from checkpoint ``n`` to the files on disk now (only
+  what the store would capture: excluded and oversize files are left out).
+- ``restore(store, folder, n)``: write every captured file of checkpoint ``n`` back, and delete
+  files that exist now, would be captured, and were not in checkpoint ``n``. Excluded paths
+  (``node_modules``, ``.env``, oversize files, nested repositories) are never touched.
+- ``restore_file(store, folder, n, path)``: the same for one relative path held by the
+  checkpoint.
+
+All work runs on throwaway index files, so a project's own staging index is never disturbed.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+from dataclasses import dataclass
+from pathlib import Path
+
+from indus.backends.checkpoints.store import (
+    GitError,
+    ShadowStore,
+    Skipped,
+    check_commit,
+    check_relpath,
+    parse_trailers,
+    project_key,
+)
+
+__all__ = [
+    "Checkpoint",
+    "RestoreResult",
+    "RollbackError",
+    "diff",
+    "list_all",
+    "list_checkpoints",
+    "resolve",
+    "restore",
+    "restore_file",
+]
+
+_LIST_LIMIT = 200
+
+
+class RollbackError(ValueError):
+    """A rollback request that cannot be carried out; the message is for the person."""
+
+
+@dataclass(frozen=True)
+class Checkpoint:
+    number: int
+    commit: str
+    at: float
+    reason: str
+    session_id: str | None
+    turn_id: str | None
+    files_changed: int
+
+    @property
+    def short(self) -> str:
+        return self.commit[:8]
+
+
+@dataclass(frozen=True)
+class RestoreResult:
+    restored_to: str
+    safety: str | None
+    written: int
+    removed: tuple[str, ...] = ()
+    not_captured: tuple[str, ...] = ()
+    file: str | None = None
+
+
+def _folder(workdir: str | Path) -> Path:
+    folder = Path(workdir).expanduser()
+    with contextlib.suppress(OSError):
+        folder = folder.resolve()
+    return folder
+
+
+def list_checkpoints(
+    store: ShadowStore, workdir: str | Path, *, limit: int = _LIST_LIMIT
+) -> list[Checkpoint]:
+    """The folder's checkpoints, newest first (see the module notes)."""
+    if not store.exists():
+        return []
+    key = project_key(_folder(workdir))
+    if store.tip(key) is None:
+        return []
+    shown = store.must(
+        ["log", f"--max-count={max(limit, 1)}", "--format=%H%x1f%ct%x1f%B%x1e", store.ref(key)]
+    )
+    rows: list[Checkpoint] = []
+    for record in shown.out.decode("utf-8", "surrogateescape").split("\x1e"):
+        parts = record.strip("\n").split("\x1f", 2)
+        if len(parts) != 3:
+            continue
+        commit, stamp, message = parts
+        subject, _, body = message.partition("\n")
+        trailers = parse_trailers(body)
+        changed = store.must(
+            ["diff-tree", "--root", "-r", "-z", "--name-only", "--no-commit-id", commit]
+        ).fields()
+        try:
+            at = float(stamp)
+        except ValueError:
+            at = 0.0
+        rows.append(
+            Checkpoint(
+                number=len(rows) + 1,
+                commit=commit,
+                at=at,
+                reason=subject.strip(),
+                session_id=trailers.get("Indus-Session"),
+                turn_id=trailers.get("Indus-Turn"),
+                files_changed=len(changed),
+            )
+        )
+    return rows
+
+
+def list_all(store: ShadowStore) -> list[tuple[str, Checkpoint]]:
+    """Every project's checkpoints as ``(folder, checkpoint)``, newest first."""
+    out: list[tuple[str, Checkpoint]] = []
+    for key in store.project_keys():
+        meta = store.read_meta(key) or {}
+        folder = meta.get("workdir")
+        if isinstance(folder, str) and folder:
+            out.extend((folder, cp) for cp in list_checkpoints(store, folder))
+    out.sort(key=lambda item: item[1].at, reverse=True)
+    return out
+
+
+def resolve(store: ShadowStore, workdir: str | Path, number: int) -> Checkpoint:
+    """Checkpoint ``number`` (1 = newest) of the folder, or ``RollbackError``."""
+    rows = list_checkpoints(store, workdir)
+    if not rows:
+        raise RollbackError(f"there are no checkpoints for {_folder(workdir)}")
+    if not 1 <= number <= len(rows):
+        raise RollbackError(f"choose a checkpoint from 1 to {len(rows)} (got {number})")
+    check_commit(rows[number - 1].commit)
+    return rows[number - 1]
+
+
+def diff(store: ShadowStore, workdir: str | Path, number: int) -> str:
+    """Unified diff from checkpoint ``number`` to the folder now ("" when they match)."""
+    folder = _folder(workdir)
+    checkpoint = resolve(store, folder, number)
+    with store.lock(), store.temp_index() as index:
+        store.stage(folder, index)
+        shown = store.must(
+            ["diff", "--cached", "--no-color", "--no-ext-diff", "--no-renames", checkpoint.commit],
+            workdir=folder,
+            index=index,
+        )
+    return shown.out.decode("utf-8", "surrogateescape")
+
+
+def _safety(
+    store: ShadowStore, folder: Path, checkpoint: Checkpoint, session_id: str | None
+) -> str | None:
+    taken = store.snapshot(folder, f"before rollback to {checkpoint.short}", session_id=session_id)
+    if isinstance(taken, Skipped):
+        if taken.kind in ("unchanged", "empty"):
+            return None
+        raise RollbackError(f"nothing was restored: the safety checkpoint failed ({taken.reason})")
+    return taken.commit
+
+
+def _remove(folder: Path, rel: str) -> bool:
+    target = folder / rel
+    try:
+        target.parent.resolve().relative_to(folder)
+    except (OSError, ValueError):
+        return False
+    try:
+        target.unlink()
+    except OSError:
+        return False
+    parent = target.parent
+    while parent != folder:
+        try:
+            parent.rmdir()
+        except OSError:
+            break
+        parent = parent.parent
+    return True
+
+
+def restore(
+    store: ShadowStore, workdir: str | Path, number: int, *, session_id: str | None = None
+) -> RestoreResult:
+    """Put the folder back to checkpoint ``number`` (see the module notes)."""
+    folder = _folder(workdir)
+    checkpoint = resolve(store, folder, number)
+    try:
+        with store.lock():
+            safety = _safety(store, folder, checkpoint, session_id)
+            entries = store.tree_entries(checkpoint.commit)
+            nested = tuple(path for mode, path in entries if mode == "160000")
+            captured = {path for mode, path in entries if mode != "160000"}
+            with store.temp_index() as now_index:
+                store.stage(folder, now_index)
+                present = store.must(
+                    ["ls-files", "-z", "--cached"], workdir=folder, index=now_index
+                ).fields()
+            removed: list[str] = []
+            for rel in sorted(set(present) - captured):
+                if any(rel == repo or rel.startswith(repo + "/") for repo in nested):
+                    continue
+                if store.oversize(folder / rel):
+                    continue
+                if _remove(folder, rel):
+                    removed.append(rel)
+            with store.temp_index() as target:
+                store.must(["read-tree", checkpoint.commit], workdir=folder, index=target)
+                store.must(["checkout-index", "-a", "-f"], workdir=folder, index=target)
+    except GitError as exc:
+        raise RollbackError(f"the restore failed: {exc}") from None
+    return RestoreResult(
+        restored_to=checkpoint.short,
+        safety=safety,
+        written=len(captured),
+        removed=tuple(removed),
+        not_captured=nested,
+    )
+
+
+def restore_file(
+    store: ShadowStore,
+    workdir: str | Path,
+    number: int,
+    path: str,
+    *,
+    session_id: str | None = None,
+) -> RestoreResult:
+    """Put one file back as checkpoint ``number`` holds it; other files are not touched."""
+    folder = _folder(workdir)
+    try:
+        rel = check_relpath(path, folder)
+    except ValueError as exc:
+        raise RollbackError(str(exc)) from None
+    checkpoint = resolve(store, folder, number)
+    held = store.git(["cat-file", "-e", f"{checkpoint.commit}:{rel}"])
+    if not held.ok:
+        raise RollbackError(f"checkpoint {number} ({checkpoint.short}) does not hold {rel}")
+    try:
+        with store.lock():
+            safety = _safety(store, folder, checkpoint, session_id)
+            with store.temp_index() as target:
+                store.must(["read-tree", checkpoint.commit], workdir=folder, index=target)
+                parent = (folder / rel).parent
+                if parent.exists() and not parent.is_dir():
+                    raise RollbackError(f"{os.path.dirname(rel)} is not a folder now")
+                store.must(["checkout-index", "-f", "--", rel], workdir=folder, index=target)
+    except GitError as exc:
+        raise RollbackError(f"the restore failed: {exc}") from None
+    return RestoreResult(restored_to=checkpoint.short, safety=safety, written=1, file=rel)
