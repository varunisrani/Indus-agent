+
+def test_flag_rewrite() -> None:
+    known = ["chat", "worktree"]
+    assert rewrite_session_flags(["-w"], known) == [f"--worktree={AUTO_WORKTREE}"]
+    assert rewrite_session_flags(["-w", "chat"], known) == [f"--worktree={AUTO_WORKTREE}", "chat"]
