index 0000000..387b9c6
--- /dev/null
+++ b/src/indus/backends/docker/recovery.py
@@ -0,0 +1,173 @@
+# pyright: strict
+"""When the container goes away, and how isolated the backend is (P11-06).
+
+A container can vanish under a running session (``docker rm``, a prune, an OOM kill, a daemon
+restart). The client then answers before the command ever starts, with an error that opens its
+output: "No such container" or "container … is not running" (Podman: "no container with name or
+ID"). ``container_gone`` matches only there, so a command that merely prints those words is not
+mistaken for it. With ``docker_persist_across_processes`` the environment recovers: a reusable
+labelled container (another process may have made one) or a fresh one, a new snapshot, and the
+command once more; that result carries ``environment_recreated`` so the tool warns that
+background processes and unsaved files may be gone (R02.19). Jobs the old container ran are
+reported to the lost handlers (``register_lost_handler``), which mark them ``lost``.
+
+``daemon_gone`` spots a client that cannot reach its daemon at all; the environment turns that
+into a connection error, so the registry answers "degraded" and evicts it.
+
+Isolation (R02.6): the environment is ``isolated`` only when no host path is bound
+(``MountPlan.host_paths_mounted``). Approval prompts are skipped only then; the hardline floor
+and the user's deny rules still apply (R02.4).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import threading
+from collections.abc import Callable
+from typing import TYPE_CHECKING
+
+from indus.backends.contract import BackendFlags
+
+if TYPE_CHECKING:
+    from indus.backends.docker.environment import DockerEnvironment
+    from indus.backends.processes import ProcessRegistry
+
+__all__ = [
+    "LOST_SOURCE",
+    "container_gone",
+    "daemon_gone",
+    "isolated_flags",
+    "mark_lost",
+    "notify_lost",
+    "recover",
+    "register_lost_handler",
+    "unregister_lost_handler",
+]
+
+log = logging.getLogger(__name__)
+
+CONTAINER_GONE = ("no such container", "is not running", "no container with name or id")
+DAEMON_GONE = (
+    "cannot connect to the docker daemon",
+    "is the docker daemon running",
+    "error during connect",
+    "cannot connect to podman",
+    "unable to connect to podman",
+)
+LOST_SOURCE = "the sandbox container was replaced"
+
+type LostHandler = Callable[[str], object]
+
+_handlers_lock = threading.Lock()
+_handlers: list[LostHandler] = []
+
+
+def _first_line(output: str) -> str:
+    text = output.lstrip()
+    return text.split("\n", 1)[0][:500].lower()
+
+
+def container_gone(output: str, returncode: int) -> bool:
+    """The client said the container does not exist or is stopped (see the module notes)."""
+    if returncode == 0:
+        return False
+    line = _first_line(output)
+    return line.startswith("error") and any(p in line for p in CONTAINER_GONE)
+
+
+def daemon_gone(output: str, returncode: int) -> bool:
+    """The client could not reach its daemon."""
+    if returncode == 0:
+        return False
+    line = _first_line(output)
+    return any(p in line for p in DAEMON_GONE)
+
+
+def isolated_flags(host_paths_mounted: bool) -> BackendFlags:
+    """The flags of a Docker environment: isolated only without host binds."""
+    return BackendFlags(
+        isolated=not host_paths_mounted,
+        container_paths=True,
+        stdin_mode="pipe",
+        host_local=False,
+    )
+
+
+# -- lost background jobs -----------------------------------------------------------------------
+
+
+def register_lost_handler(handler: LostHandler) -> None:
+    """Called with the environment key whose container was replaced."""
+    with _handlers_lock:
+        if handler not in _handlers:
+            _handlers.append(handler)
+
+
+def unregister_lost_handler(handler: LostHandler) -> None:
+    with _handlers_lock:
+        if handler in _handlers:
+            _handlers.remove(handler)
+
+
+def notify_lost(env_key: str) -> None:
+    with _handlers_lock:
+        handlers = list(_handlers)
+    for handler in handlers:
+        try:
+            handler(env_key)
+        except Exception:
+            log.warning("a lost-job handler failed for %s", env_key, exc_info=True)
+
+
+def mark_lost(registry: ProcessRegistry, env_key: str, *, source: str = LOST_SOURCE) -> list[str]:
+    """End every running job of ``env_key`` in ``registry`` as ``lost``; returns their ids.
+
+    Their output so far is kept and a job that asked for a completion message still gets one."""
+    ended: list[str] = []
+    for record in registry.running():
+        if record.env_key != env_key:
+            continue
+        handle = record.handle
+        if handle is not None:
+            with contextlib.suppress(Exception):
+                handle.force_stop()
+        record.reason = "lost"
+        record.source = source
+        registry.notice_exit(record)
+        ended.append(record.id)
+    return ended
+
+
+# -- recovery -----------------------------------------------------------------------------------
+
+
+async def recover(env: DockerEnvironment) -> bool:
+    """Put a working container behind ``env`` (see the module notes); False when that failed,
+    so the caller returns the original result."""
+    old = env.container_id or ""
+    log.warning("sandbox container %s is gone; recovering", old[:12] or "(none)")
+    env.forget_container()
+    try:
+        found = await env.lifecycle.find_reusable()
+        container: str | None = None
+        if found is not None:
+            cid, state = found
+            if state == "running" or await env.lifecycle.start(cid):
+                container = cid
+        if container is None:
+            container = await env.lifecycle.create()
+    except Exception as exc:
+        log.error("could not replace the sandbox container: %s", exc)
+        return False
+    env.adopt_container(container)
+    try:
+        await env.restart_snapshot()
+    except Exception as exc:
+        log.error("the new sandbox container did not take a snapshot: %s", exc)
+        return False
+    env.recreations += 1
+    notify_lost(env.env_key)  # jobs are ended as lost here, not left to the one-shot flag
+    env.mark_recreated()
+    log.info("sandbox container replaced by %s", container[:12])
+    return True
diff --git a/src/indus/backends/docker/settings.py b/src/indus/backends/docker/settings.py
new file mode 100644
index 0000000..2becda0
--- /dev/null
+++ b/src/indus/backends/docker/settings.py
@@ -0,0 +1,141 @@
+# pyright: strict
+"""Every Docker setting of a profile, read once from its scope (P11-01..05).
+
+``terminal.docker_*`` and ``terminal.container_*`` come from the scope's config with the schema
+defaults behind them (one defaults table). Odd values are normalised here, so the argument
+builders below work on plain, typed data and stay pure.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, field
+from typing import Any, cast
+
+from indus.backends.contract import BackendError
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+__all__ = ["DockerConfigError", "DockerSettings", "settings_for"]
+
+log = logging.getLogger(__name__)
+
+DIGEST_MARK = "@sha256:"
+
+
+class DockerConfigError(BackendError):
+    """The Docker settings contradict each other; nothing was started."""
+
+    default_code = "backend.docker.config"
+
+
+@dataclass(frozen=True, slots=True)
+class DockerSettings:
+    image: str
+    image_pinned: bool = False
+    binary: str = ""
+    forward_env: tuple[str, ...] = ()
+    env: Mapping[str, str] = field(default_factory=lambda: {})
+    volumes: tuple[str, ...] = ()
+    extra_args: tuple[str, ...] = ()
+    shm_size: str = "1g"
+    network: bool = True
+    run_as_host_user: bool = False
+    snap_compat: bool = False
+    mount_cwd_to_workspace: bool = False
+    persist_across_processes: bool = True
+    shared_key: str = ""
+    orphan_reaper: bool = True
+    cpu: float = 1.0
+    memory_mb: int = 5120
+    disk_mb: int = 51200
+    persistent: bool = True
+
+
+def _value(scope: Scope, key: str) -> Any:
+    raw = scope.config.get(key) if scope.config is not None else None
+    return default_for(key) if raw is None else raw
+
+
+def _strings(raw: object, key: str) -> tuple[str, ...]:
+    if isinstance(raw, str):
+        raw = [raw]
+    if not isinstance(raw, Iterable):
+        log.warning("%s should be a list; ignored", key)
+        return ()
+    out: list[str] = []
+    for item in cast(Iterable[object], raw):
+        if isinstance(item, str):
+            out.append(item)
+        else:
+            log.warning("%s: ignoring a non-text entry (%s)", key, type(item).__name__)
+    return tuple(out)
+
+
+def _mapping(raw: object, key: str) -> dict[str, str]:
+    if not isinstance(raw, Mapping):
+        if raw not in (None, ""):
+            log.warning("%s should be a mapping; ignored", key)
+        return {}
+    out: dict[str, str] = {}
+    for name, value in cast(Mapping[object, object], raw).items():
+        if not isinstance(name, str):
+            continue
+        if isinstance(value, bool):
+            out[name] = "true" if value else "false"
+        elif isinstance(value, str | int | float):
+            out[name] = str(value)
+        else:
+            log.warning("%s.%s: only text and numbers can be set; ignored", key, name)
+    return out
+
+
+def _number(raw: object, fallback: float) -> float:
+    try:
+        return max(0.0, float(cast(Any, raw)))
+    except (TypeError, ValueError):
+        return fallback
+
+
+def _flag(raw: object) -> bool:
+    if isinstance(raw, str):
+        return raw.strip().lower() in ("1", "true", "yes", "on")
+    return bool(raw)
+
+
+def settings_for(scope: Scope) -> DockerSettings:
+    """The profile's Docker settings; raises ``DockerConfigError`` for a pinned image without a
+    digest."""
+    t = "terminal."
+    image = str(_value(scope, t + "docker_image") or "").strip() or str(
+        default_for(t + "docker_image")
+    )
+    pinned = _flag(_value(scope, t + "docker_image_pinned"))
+    if pinned and DIGEST_MARK not in image:
+        raise DockerConfigError(
+            f"terminal.docker_image_pinned is on but {image!r} names no digest",
+            hint="use an image reference ending in @sha256:<digest>, or turn the pin off",
+        )
+    shm = _value(scope, t + "docker_shm_size")
+    return DockerSettings(
+        image=image,
+        image_pinned=pinned,
+        binary=str(_value(scope, t + "docker_binary") or "").strip(),
+        forward_env=_strings(_value(scope, t + "docker_forward_env"), t + "docker_forward_env"),
+        env=_mapping(_value(scope, t + "docker_env"), t + "docker_env"),
+        volumes=_strings(_value(scope, t + "docker_volumes"), t + "docker_volumes"),
+        extra_args=_strings(_value(scope, t + "docker_extra_args"), t + "docker_extra_args"),
+        shm_size="" if shm is None else str(shm).strip(),
+        network=_flag(_value(scope, t + "docker_network")),
+        run_as_host_user=_flag(_value(scope, t + "docker_run_as_host_user")),
+        snap_compat=_flag(_value(scope, t + "docker_snap_compat")),
+        mount_cwd_to_workspace=_flag(_value(scope, t + "docker_mount_cwd_to_workspace")),
+        persist_across_processes=_flag(_value(scope, t + "docker_persist_across_processes")),
+        shared_key=str(_value(scope, t + "docker_shared_key") or "").strip(),
+        orphan_reaper=_flag(_value(scope, t + "docker_orphan_reaper")),
+        cpu=_number(_value(scope, t + "container_cpu"), 1.0),
+        memory_mb=int(_number(_value(scope, t + "container_memory_mb"), 5120)),
+        disk_mb=int(_number(_value(scope, t + "container_disk_mb"), 51200)),
+        persistent=_flag(_value(scope, t + "container_persistent")),
+    )
