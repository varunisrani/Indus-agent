+    async def execute(
+        self,
+        command: str,
+        *,
+        timeout: float | None = None,
+        cwd: str | None = None,
+        stdin: str | None = None,
+        bounded: bool = True,
+        on_activity: ActivityCallback | None = None,
+        cancel: CancelSignal | None = None,
+    ) -> ExecResult:
+        if not self._closed:
+            if self.home_retry_due():
+                await self.detect_home()
+            if self.sync is not None:
+                await self.sync.sync()
+        return await super().execute(
+            command,
+            timeout=timeout,
+            cwd=cwd,
+            stdin=stdin,
+            bounded=bounded,
+            on_activity=on_activity,
+            cancel=cancel,
+        )
+
+    async def _run_script(
+        self,
+        script: str,
+        *,
+        login: bool,
+        timeout: float,
+        stdin: str | None,
+        bounded: bool,
+        on_activity: ActivityCallback | None = None,
+        cancel: CancelSignal | None = None,
+    ) -> ExecResult:
+        result = await super()._run_script(
+            script,
+            login=login,
+            timeout=timeout,
+            stdin=stdin,
+            bounded=bounded,
+            on_activity=on_activity,
+            cancel=cancel,
+        )
+        if (
+            result.returncode == SSH_LOST_RC
+            and not result.timed_out
+            and not result.interrupted
+            and connection_problem(result.output, self.target) is not None
+        ):
+            raise self._connection_error(result.output)
+        return result
