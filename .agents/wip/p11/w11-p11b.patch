+def request(scope: Scope, env: Any, command: str = "make test", **kw: Any) -> SpawnRequest:
+    values: dict[str, Any] = {
+        "command": command,
+        "scope": scope,
+        "session_id": "s1",
+        "env_key": "k-remote",
+        "cwd": "/workspace",
+        "env": {},
+        "environment": env,
+    }
+    values.update(kw)
+    return SpawnRequest(**values)
+
