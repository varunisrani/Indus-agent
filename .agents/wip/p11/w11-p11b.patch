+def job(record: ProcessRecord) -> RemoteJob:
+    assert isinstance(record.handle, RemoteJob)
+    return record.handle
+
+
+async def one_round(record: ProcessRecord) -> None:
+    poller = job(record).poller
+    assert poller is not None
+    await poller.round()
