@@ -0,0 +1,50 @@
+# STAND-IN: removed at integration
+"""Stand-in for P17-15's ensure (slice K6), as ``gateway_grant`` assumes it.
+
+Assumed interface (``indus.cli.commands.gateway_ensure``):
+
+- ``ensure_endpoint(scope, *, start: bool, timeout: float) -> Mapping[str, Any]`` — the
+  credential-free endpoint descriptor ``{ws_url, profile_id, instance_id, code_version}`` of the
+  daemon serving ``scope.home``; with ``start`` it starts a detached daemon when none answers
+  (honouring the planned-stop record and the version-skew restart), without it it only discovers;
+- on failure it raises an exception with ``code: str`` and ``terminal: bool`` attributes
+  (``EnsureFailed`` below); ``terminal`` is true when no retry can help.
+
+This stand-in only discovers through the control socket's ``describe`` and records its calls.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+from indus.foundation.scope import Scope
+from indus.service import gateway_control
+
+
+class EnsureFailed(Exception):
+    def __init__(self, code: str, message: str, *, terminal: bool = False) -> None:
+        super().__init__(message)
+        self.code = code
+        self.terminal = terminal
+
+
+@dataclass
+class EnsureStandIn:
+    """``ensure_endpoint`` over ``describe``; ``fail`` makes every call raise it."""
+
+    fail: Exception | None = None
+    override: Mapping[str, Any] | None = None
+    calls: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+
+    def __call__(self, scope: Scope, *, start: bool, timeout: float) -> Mapping[str, Any]:
+        self.calls.append({"env": dict(scope.env.to_dict()), "start": start, "timeout": timeout})
+        if self.fail is not None:
+            raise self.fail
+        if self.override is not None:
+            return self.override
+        found = gateway_control.describe(scope.home, timeout=timeout)
+        if found is None:
+            raise EnsureFailed("not_running", "no daemon answers")
+        return {key: found[key] for key in ("ws_url", "profile_id", "instance_id", "code_version")}
