+# STAND-IN: removed at integration
+"""Rows slice E14 (P16-21, P16-22, P16-30) needs in P15/P05 core tables, as stand-ins.
+
+The lead lands them in the core files (the exact rows are in the E14 report); tests patch them
+in through `install_rows` until then. Interfaces assumed:
+
+- ``gateway/registry.py``: ``BUILTIN_NAMES`` gains ``"yuanbao"`` and ``"raft"`` after ``"buzz"``;
+  ``builtin_entries()`` gains `YUANBAO_ENTRY` and `RAFT_ENTRY` (written there with
+  ``_chat_entry`` / ``replace`` like the other rows);
+- ``gateway/config.py``: ``BUILTIN_CREDENTIALS["yuanbao"] = ("YUANBAO_APP_ID",
+  "YUANBAO_APP_SECRET")``; ``BUILTIN_PUBLIC_ENV["raft"] = ("RAFT_PROFILE",)``;
+- ``tools/toolsets.py``: `TOOLSET_ROWS` (and ``"indus-yuanbao"`` in ``indus-gateway``'s
+  includes); ``core/untrusted.py``: ``"yuanbao_"`` in ``UNTRUSTED_PREFIXES``;
+- ``gateway/daemon/process.py``: ``gateway_tool_registry`` also calls
+  ``indus.gateway.adapters.yuanbao.tools.register_tools(tools)``;
+- ``cron/targets.py``: ``"yuanbao"`` in ``KNOWN_PLATFORMS``; ``gateway/delivery/send_command.py``
+  and ``gateway/delivery/directory.py``: ``"raft"`` in ``_NOT_TARGETS``.
+"""
+
+from __future__ import annotations
+
+import importlib
+from typing import Any
+
+import pytest
+
+from indus.core import untrusted
+from indus.gateway.registry import PlatformEntry, modules_installed, policy_env_name
+from indus.tools import toolsets
+from indus.tools.toolsets import CORE, Toolset
+
+
+def _factory(target: str) -> Any:
+    module_name, _, attr = target.partition(":")
+
+    def build(config: Any) -> Any:
+        return getattr(importlib.import_module(module_name), attr)(config)
+
+    return build
+
+
+YUANBAO_ENTRY = PlatformEntry(
+    name="yuanbao",
+    label="Yuanbao",
+    factory=_factory("indus.gateway.adapters.yuanbao:create_adapter"),
+    # HTTP on httpx; the bot socket needs httpx-ws (the ``yuanbao`` extra).
+    check_fn=modules_installed("httpx_ws"),
+    required_env=("YUANBAO_APP_ID", "YUANBAO_APP_SECRET"),
+    install_hint="pip install 'indus-agent[yuanbao]'",
+    allowlist_env=policy_env_name("yuanbao", "ALLOWED_USERS"),
+    allow_all_env=policy_env_name("yuanbao", "ALLOW_ALL_USERS"),
+    allow_bots_env=policy_env_name("yuanbao", "ALLOW_BOTS"),
+    home_env=policy_env_name("yuanbao", "HOME_CHANNEL"),
+    max_len=4000,
+    dm_is_private=True,
+    platform_hint=(
+        "You are talking through Tencent Yuanbao. Markdown renders (code blocks, tables, bold). "
+        "To send a sticker, find one with yuanbao_search_sticker and send it with "
+        "yuanbao_send_sticker; a plain emoji is not a sticker."
+    ),
+    # One bot (App ID) answers in one gateway; a new App Secret is the same bot.
+    lock_env=("YUANBAO_APP_ID",),
+)
+
+RAFT_ENTRY = PlatformEntry(
+    name="raft",
+    label="Raft",
+    factory=_factory("indus.gateway.adapters.raft:create_adapter"),
+    # The wake endpoint runs on the P16-01 listener kit (uvicorn, a base dependency).
+    check_fn=modules_installed("uvicorn"),
+    required_env=("RAFT_PROFILE",),
+    install_hint=(
+        "pip install indus-agent (Raft needs no extra); install the Raft CLI and run "
+        "`raft agent bridge` against the URL in <profile home>/platforms/raft/bridge.json"
+    ),
+    # Every chat reads as a DM but is the bridge, never a person (R06.24).
+    dm_is_private=False,
+    platform_hint=(
+        "You are a Raft external agent. Wake notices only say that Raft messages may be waiting: "
+        "read and answer them with the raft command-line tool, passing --profile with your "
+        "Raft profile on every call. Your replies in this chat go nowhere."
+    ),
+    # One Raft agent profile is served by one gateway.
+    lock_env=("RAFT_PROFILE",),
+)
+
+# Platforms with a target rule / setup steps whose registry rows are not landed yet: the two
+# invariant tests (``test_targets.py``, ``test_gateway_setup.py``) leave them out until then.
+PENDING_PLATFORMS: frozenset[str] = frozenset({"yuanbao", "raft"})
+
+CREDENTIAL_ROWS: dict[str, tuple[str, ...]] = {"yuanbao": ("YUANBAO_APP_ID", "YUANBAO_APP_SECRET")}
+PUBLIC_ENV_ROWS: dict[str, tuple[str, ...]] = {"raft": ("RAFT_PROFILE",)}
+
+TOOLSET_ROWS: dict[str, Toolset] = {
+    # P16-22: the Yuanbao group, DM and sticker tools (registered by the gateway daemon) belong to
+    # Yuanbao sessions only, even in a session that selects every toolset (R02.25).
+    "yuanbao": Toolset(
+        "Yuanbao groups, direct messages and stickers", platforms=frozenset({"yuanbao"})
+    ),
+    "indus-yuanbao": Toolset("Yuanbao chats", includes=(CORE, "yuanbao")),
+}
+
+
+def install_rows(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Patch the toolset rows, the gateway bundle and the untrusted prefix in for one test."""
+    for name, row in TOOLSET_ROWS.items():
+        monkeypatch.setitem(toolsets.TOOLSETS, name, row)
+    gateway = toolsets.TOOLSETS["indus-gateway"]
+    if "indus-yuanbao" not in gateway.includes:
+        widened = Toolset(
+            gateway.description,
+            gateway.tools,
+            (*gateway.includes, "indus-yuanbao"),
+            gateway.platforms,
+            gateway.posture,
+            gateway.registry_members,
+        )
+        monkeypatch.setitem(toolsets.TOOLSETS, "indus-gateway", widened)
+    if "yuanbao_" not in untrusted.UNTRUSTED_PREFIXES:
+        monkeypatch.setattr(
+            untrusted, "UNTRUSTED_PREFIXES", (*untrusted.UNTRUSTED_PREFIXES, "yuanbao_")
+        )
+    toolsets.clear_memo()
