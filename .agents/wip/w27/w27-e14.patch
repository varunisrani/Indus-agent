+def _png(width: int, height: int) -> bytes:
+    header = b"\x89PNG\r\n\x1a\n" + struct.pack(">I", 13) + b"IHDR"
+    return header + struct.pack(">II", width, height) + b"\x08\x02\x00\x00\x00" + b"\x00" * 16
