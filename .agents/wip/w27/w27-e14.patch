+_YUANBAO_FORMS = "group:<group code> or direct:<account>"
+_YUANBAO_ID: Final = re.compile(r"[A-Za-z0-9_.@=+-]{1,128}")
+
+
+def _yuanbao_split(address: str) -> Address:
