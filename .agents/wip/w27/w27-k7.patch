index 0000000..f8b612c
--- /dev/null
+++ b/tests/integration/state/multiprocess_worker.py
@@ -0,0 +1,255 @@
+"""One process of the P17-21 multi-process run; the parent is ``test_multiprocess_daemon.py``.
+
+Run as ``python multiprocess_worker.py <role> <home> <out.json> <options-json>``. The worker builds
+a scope for the temp ``home``, prints ``ready <journal mode or ->``, reads one JSON line
+``{"start": t, "deadline": t}`` (wall-clock seconds) from stdin, works until the deadline and
+writes its result to ``out.json``. Roles:
+
+- ``daemon``: holds the profile ownership lock (``gateway.lock``) as the gateway daemon does and
+  writes turns until the deadline: ``threads`` threads, each creating a session per turn and
+  appending a user and an assistant message through the P02 writer. At the window's midpoint it
+  runs a WAL checkpoint on its writer connection.
+- ``cli``: what `indus sessions list` and a transcript read do, once per loop: open the store
+  read-only (``read_view``), list sessions, read the newest session's messages, close.
+- ``dashboard``: one long-lived read-only connection (a dashboard keeps one), searching and
+  counting in a loop.
+- ``maint``: at the midpoint, runs `indus sessions prune -y` through the app's dispatch; with the
+  daemon owning the profile the gate must refuse it.
+
+Every reader samples the store file's header (bytes 18-19: 1 = rollback journal, 2 = WAL) and the
+journal mode its connection reports, so the parent can tell whether the mode ever changed live.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import sqlite3
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.clock import SystemClock
+from indus.foundation.scope import EnvView, Scope, make_scope
+from indus.state import journal, listing, messages, registry, search, sessions
+from indus.state.registry import StoreHandle
+
+PINNED_SQLITE = (3, 51, 3)
+MAX_KEPT_ERRORS = 50
+WORDS = ("amber", "basalt", "cobalt", "delta", "ember", "fjord")
+
+
+def _until(moment: float) -> None:
+    gate = threading.Event()
+    while (left := moment - time.time()) > 0:
+        gate.wait(left)
+
+
+class Errors:
+    def __init__(self) -> None:
+        self.lock = threading.Lock()
+        self.count = 0
+        self.kept: list[dict[str, Any]] = []
+
+    def add(self, where: str, exc: BaseException) -> None:
+        with self.lock:
+            self.count += 1
+            if len(self.kept) < MAX_KEPT_ERRORS:
+                self.kept.append({"where": where, "type": type(exc).__name__, "text": str(exc)})
+
+    def as_dict(self) -> dict[str, Any]:
+        return {"error_count": self.count, "errors": self.kept}
+
+
+def _scope(home: Path) -> Scope:
+    env = EnvView.from_process().with_overlay({"INDUS_HOME": str(home)})
+    return make_scope(home, env=env, clock=SystemClock())
+
+
+def header_mode(db: Path) -> int | None:
+    """Bytes 18-19 of the file header: 1 rollback journal, 2 WAL (None when unreadable)."""
+    try:
+        with db.open("rb") as raw:
+            head = raw.read(20)
+    except OSError:
+        return None
+    if len(head) < 20 or head[18] != head[19]:
+        return None
+    return head[18]
+
+
+def run_daemon(scope: Scope, opts: dict[str, Any], window: dict[str, float]) -> dict[str, Any]:
+    from indus.service.maintenance_gate import OwnershipLock
+
+    lock = OwnershipLock(scope.home)
+    if not lock.try_acquire():
+        raise SystemExit("the daemon could not take the ownership lock")
+    store = registry.open_unshared(scope)
+    threads = int(opts.get("threads", 4))
+    turns: dict[str, list[list[int]]] = {f"t{j}": [] for j in range(threads)}
+    errors = Errors()
+    checkpoint: dict[str, Any] = {}
+    deadline = window["deadline"]
+    midpoint = window["start"] + (deadline - window["start"]) / 2
+
+    def work(thread: int) -> None:
+        name = f"t{thread}"
+        n = 0
+        while time.time() < deadline:
+            sid = f"turn-{name}-{n:05d}"
+            try:
+                sessions.create(store, sid, "cli")
+                ids: list[int] = []
+                for role in ("user", "assistant"):
+                    text = f"{sid} {role} {WORDS[n % len(WORDS)]} " + "words " * (n % 40)
+                    ids.append(messages.append(store, sid, {"role": role, "content": text}))
+                turns[name].append(ids)
+            except Exception as exc:  # judged by the parent
+                errors.add(sid, exc)
+            n += 1
+
+    def checkpointer() -> None:
+        _until(midpoint)
+        try:
+            with store.writer.borrow() as conn:
+                row = conn.execute("PRAGMA wal_checkpoint(RESTART)").fetchone()
+            checkpoint.update(ran=True, at=time.time(), row=list(row) if row else None)
+        except Exception as exc:
+            errors.add("checkpoint", exc)
+            checkpoint["ran"] = False
+
+    workers = [threading.Thread(target=work, args=(j,)) for j in range(threads)]
+    workers.append(threading.Thread(target=checkpointer))
+    for t in workers:
+        t.start()
+    for t in workers:
+        t.join()
+    mode = store.journal_mode
+    store.close()
+    lock.release()
+    return {
+        "role": "daemon",
+        "turns": turns,
+        "count": sum(len(v) for v in turns.values()),
+        "checkpoint": checkpoint,
+        "mode": mode,
+        **errors.as_dict(),
+    }
+
+
+def _sample(db: Path, conn: sqlite3.Connection, seen: dict[str, set[Any]]) -> None:
+    seen["header"].add(header_mode(db))
+    seen["pragma"].add(str(conn.execute("PRAGMA journal_mode").fetchone()[0]).lower())
+
+
+def run_cli(scope: Scope, opts: dict[str, Any], window: dict[str, float]) -> dict[str, Any]:
+    from indus.cli.commands.sessions import read_view
+
+    errors = Errors()
+    seen: dict[str, set[Any]] = {"header": set(), "pragma": set()}
+    loops = rows = 0
+    db = Path(opts["db"])
+    while time.time() < window["deadline"]:
+        loops += 1
+        try:
+            with read_view(scope) as view:
+                assert view is not None
+                found = listing.list_sessions(view.as_handle(), limit=20)
+                with view.read() as conn:
+                    _sample(db, conn, seen)
+                    if found:
+                        rows += len(
+                            conn.execute(
+                                "SELECT id FROM messages WHERE session_id = ? ORDER BY id",
+                                (found[0].id,),
+                            ).fetchall()
+                        )
+        except Exception as exc:
+            errors.add(f"loop {loops}", exc)
+    return {
+        "role": "cli",
+        "loops": loops,
+        "rows": rows,
+        "header": sorted(x for x in seen["header"] if x is not None),
+        "pragma": sorted(seen["pragma"]),
+        **errors.as_dict(),
+    }
+
+
+def run_dashboard(scope: Scope, opts: dict[str, Any], window: dict[str, float]) -> dict[str, Any]:
+    from indus.cli.commands.sessions import ReadView
+    from indus.state import browse
+
+    errors = Errors()
+    seen: dict[str, set[Any]] = {"header": set(), "pragma": set()}
+    loops = hits = 0
+    db = Path(opts["db"])
+    store = browse.open_readonly(scope)
+    view = ReadView(scope, store)
+    try:
+        while time.time() < window["deadline"]:
+            loops += 1
+            word = WORDS[loops % len(WORDS)]
+            try:
+                hits += len(search.search(view.as_handle(), word, limit=20))
+                with view.read() as conn:
+                    conn.execute("SELECT COUNT(*) FROM sessions").fetchone()
+                    _sample(db, conn, seen)
+            except Exception as exc:
+                errors.add(f"loop {loops}", exc)
+    finally:
+        store.close()
+    return {
+        "role": "dashboard",
+        "loops": loops,
+        "hits": hits,
+        "header": sorted(x for x in seen["header"] if x is not None),
+        "pragma": sorted(seen["pragma"]),
+        **errors.as_dict(),
+    }
+
+
+def run_maint(scope: Scope, opts: dict[str, Any], window: dict[str, float]) -> dict[str, Any]:
+    from click.testing import CliRunner
+
+    from indus.cli import app as app_mod
+    from indus.cli.args import CliState
+
+    _until(window["start"] + (window["deadline"] - window["start"]) / 2)
+    state = CliState(scope=scope, stdin_isatty=lambda: False, stdout_isatty=lambda: False)
+    with CliRunner().isolation() as (out, err, _mixed):
+        code = app_mod.dispatch(["sessions", "prune", "-y"], state)
+    return {
+        "role": "maint",
+        "code": code,
+        "out": out.getvalue().decode(),
+        "err": err.getvalue().decode(),
+        "error_count": 0,
+    }
+
+
+def main(argv: list[str]) -> int:
+    role, home, out = argv[1], Path(argv[2]), Path(argv[3])
+    opts: dict[str, Any] = json.loads(argv[4]) if len(argv) > 4 else {}
+    logging.basicConfig(level=logging.WARNING, stream=sys.stderr)
+    if opts.get("pin_sqlite"):
+        journal.linked_sqlite_version = lambda: PINNED_SQLITE  # same override as the unit tests
+    scope = _scope(home)
+    store: StoreHandle | None = None
+    mode = "-"
+    if role == "daemon":
+        store = registry.open_unshared(scope)
+        mode = store.journal_mode
+        store.close()
+    print(f"ready {mode}", flush=True)
+    window = json.loads(sys.stdin.readline())
+    runners = {"daemon": run_daemon, "cli": run_cli, "dashboard": run_dashboard, "maint": run_maint}
+    result = runners[role](scope, opts, window)
+    out.write_text(json.dumps(result), encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tests/integration/state/test_multiprocess_daemon.py b/tests/integration/state/test_multiprocess_daemon.py
new file mode 100644
index 0000000..2a85f97
--- /dev/null
+++ b/tests/integration/state/test_multiprocess_daemon.py
@@ -0,0 +1,220 @@
+"""P17-21: a daemon writing turns beside CLI and dashboard readers, for ``INDUS_STRESS_SECONDS``.
+
+Five processes share one store (``multiprocess_worker.py``): the "daemon" holds the profile
+ownership lock and writes turns (a session and a user and an assistant message each) with four
+threads, running a WAL checkpoint at the midpoint; two CLI-style readers open the store read-only
+per loop (`indus sessions list` plus a transcript read); a dashboard-style reader keeps one
+read-only connection and searches; a maintenance process runs `indus sessions prune -y` at the
+midpoint. Afterwards:
+
+- every message the daemon was told was stored is stored exactly once, in its turn's order, and
+  each turn's session counts its two messages (no lost rows);
+- no process saw "database is locked" or any other error;
+- the journal mode never changed live: every process saw the mode the store was created with,
+  in the PRAGMA and in the file header (R03.1);
+- the prune was refused by the maintenance gate (the daemon owns the profile) and the old
+  sessions it would have deleted are still there (R09.21);
+- the file passes its integrity check.
+
+The run is in WAL mode: when the host SQLite is one whose WAL could be reset, the linked version
+is pinned as the unit tests do so the store still opens in WAL.
+"""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+import time
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.foundation.clock import SystemClock
+from indus.foundation.scope import EnvView, make_scope
+from indus.state import guards, journal, readpool, registry
+from indus.state.registry import StoreHandle
+from tests.conftest import STRESS_SECONDS
+
+pytestmark = pytest.mark.slow
+
+WORKER = Path(__file__).with_name("multiprocess_worker.py")
+PINNED_SQLITE = (3, 51, 3)
+HEADER_WAL = 2
+OLD = ("old-a", "old-b", "old-c")
+
+
+@pytest.fixture
+def home(isolated_home: Path) -> Iterator[Path]:
+    guards.reset_health()
+    readpool.reset_fd_cache()
+    journal.reset_once_logs()
+    path = isolated_home / "profiles" / "work"
+    path.mkdir(parents=True, exist_ok=True)
+    (path / "profile.yaml").touch()
+    yield path
+    registry.close_all()
+    guards.reset_health()
+    readpool.reset_fd_cache()
+
+
+def _open(home: Path) -> StoreHandle:
+    env = EnvView.from_process().with_overlay({"INDUS_HOME": str(home)})
+    return registry.open_unshared(make_scope(home, env=env, clock=SystemClock()))
+
+
+def _seed_old(store: StoreHandle) -> None:
+    """Sessions a bare prune would delete (ended 100 days ago)."""
+    from tests.unit.state._helpers_d import DAY, add_message, add_session
+
+    at = store.scope.clock.now().timestamp() - 100 * DAY
+    for sid in OLD:
+        add_session(store, sid, started_at=at, end_reason="cli_close", ended_at=at, message_count=1)
+        add_message(store, sid, "an old conversation", timestamp=at)
+
+
+def _run(home: Path, db: Path, logs: Path, pin: bool) -> dict[str, dict[str, Any]]:
+    plan = [
+        ("daemon", "daemon"),
+        ("cli1", "cli"),
+        ("cli2", "cli"),
+        ("dashboard", "dashboard"),
+        ("maint", "maint"),
+    ]
+    logs.mkdir(parents=True, exist_ok=True)
+    procs: dict[str, subprocess.Popen[str]] = {}
+    results: dict[str, dict[str, Any]] = {}
+    root = str(Path(__file__).resolve().parents[3])
+    opts = json.dumps({"pin_sqlite": pin, "db": str(db), "threads": 4})
+    try:
+        for name, role in plan:
+            err = (logs / f"{name}.stderr").open("w", encoding="utf-8")
+            procs[name] = subprocess.Popen(
+                [sys.executable, str(WORKER), role, str(home), str(logs / f"{name}.json"), opts],
+                stdin=subprocess.PIPE,
+                stdout=subprocess.PIPE,
+                stderr=err,
+                text=True,
+                cwd=root,
+            )
+            assert procs[name].stdout is not None
+            line = procs[name].stdout.readline().split()  # type: ignore[union-attr]
+            stderr = (logs / f"{name}.stderr").read_text(encoding="utf-8")[-3000:]
+            assert line[:1] == ["ready"], f"{name} did not start:\n{stderr}"
+        start = time.time()
+        window = {"start": start, "deadline": start + STRESS_SECONDS}
+        for proc in procs.values():
+            assert proc.stdin is not None
+            proc.stdin.write(json.dumps(window) + "\n")
+            proc.stdin.close()
+        for name, proc in procs.items():
+            code = proc.wait(timeout=STRESS_SECONDS + 120)
+            stderr = (logs / f"{name}.stderr").read_text(encoding="utf-8")[-3000:]
+            assert code == 0, f"{name} exited {code}:\n{stderr}"
+            results[name] = json.loads((logs / f"{name}.json").read_text(encoding="utf-8"))
+    finally:
+        for proc in procs.values():
+            if proc.poll() is None:
+                proc.kill()
+                proc.wait(timeout=30)
+    return results
+
+
+def _problems(results: dict[str, dict[str, Any]], store: StoreHandle, mode: str) -> list[str]:
+    found: list[str] = []
+    for name, result in sorted(results.items()):
+        if result.get("error_count"):
+            kinds = sorted({e["type"] for e in result.get("errors", [])})
+            found.append(f"{name}: {result['error_count']} errors reached callers {kinds}")
+        for err in result.get("errors", []):
+            if "database is locked" in err["text"].lower():
+                found.append(f"{name}: 'database is locked' surfaced at {err['where']}")
+                break
+    daemon = results["daemon"]
+    if daemon["count"] < 10:
+        found.append(f"the daemon wrote only {daemon['count']} turns")
+    if not daemon["checkpoint"].get("ran"):
+        found.append("the midpoint checkpoint did not run")
+    if daemon["mode"] != mode:
+        found.append(f"the daemon ended in {daemon['mode']}, created in {mode}")
+    for name in ("cli1", "cli2", "dashboard"):
+        result = results[name]
+        if not result["loops"]:
+            found.append(f"{name} made no progress")
+        if result["pragma"] != [mode]:
+            found.append(f"{name} saw journal modes {result['pragma']}, not only {mode}")
+        if mode == "wal" and result["header"] != [HEADER_WAL]:
+            found.append(f"{name} saw file header modes {result['header']}")
+    if not results["dashboard"]["hits"]:
+        found.append("the dashboard search found nothing")
+    maint = results["maint"]
+    if maint["code"] != 1 or "Try again in a moment" not in maint["err"]:
+        found.append(f"the prune was not refused by the gate: {maint}")
+    with store.read() as conn:
+        stored: dict[str, list[int]] = {}
+        for row in conn.execute(
+            "SELECT id, session_id FROM messages WHERE session_id LIKE 'turn-%' ORDER BY id"
+        ):
+            stored.setdefault(str(row[1]), []).append(int(row[0]))
+        counts = {
+            str(r[0]): int(r[1])
+            for r in conn.execute(
+                "SELECT id, message_count FROM sessions WHERE id LIKE 'turn-%'"
+            ).fetchall()
+        }
+        old = {
+            str(r[0])
+            for r in conn.execute(
+                f"SELECT id FROM sessions WHERE id IN ({', '.join('?' for _ in OLD)})", OLD
+            )
+        }
+        check = [str(r[0]) for r in conn.execute("PRAGMA integrity_check").fetchall()]
+    told = 0
+    for thread, turns in daemon["turns"].items():
+        for n, ids in enumerate(turns):
+            told += len(ids)
+            sid_rows = [sid for sid, rows in stored.items() if rows == ids]
+            if len(sid_rows) != 1:
+                found.append(f"{thread} turn {n}: its messages {ids} are not stored as one turn")
+    if told != sum(len(v) for v in stored.values()):
+        found.append(f"{told} messages reported, {sum(len(v) for v in stored.values())} stored")
+    wrong = [sid for sid, rows in stored.items() if counts.get(sid) != len(rows)]
+    if wrong:
+        found.append(f"{len(wrong)} sessions' message_count differs from their rows")
+    if old != set(OLD):
+        found.append(f"the refused prune deleted {set(OLD) - old}")
+    if check != ["ok"]:
+        found.append(f"integrity_check: {check[:5]}")
+    return found
+
+
+def test_daemon_writer_and_readers_share_the_store(
+    home: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    pin = journal.wal_reset_vulnerable(journal.linked_sqlite_version())
+    if pin:
+        monkeypatch.setattr(journal, "linked_sqlite_version", lambda: PINNED_SQLITE)
+    store = _open(home)
+    try:
+        mode = store.journal_mode
+        db = store.path
+        _seed_old(store)
+    finally:
+        store.close()
+    assert mode == "wal", "the store did not open in WAL"
+    results = _run(home, db, tmp_path / "logs", pin)
+    summary = {
+        "seconds": STRESS_SECONDS,
+        "turns": results["daemon"]["count"],
+        "cli_loops": [results["cli1"]["loops"], results["cli2"]["loops"]],
+        "dashboard_loops": results["dashboard"]["loops"],
+        "checkpoint": results["daemon"]["checkpoint"].get("row"),
+    }
+    print("multiprocess:", json.dumps(summary))
+    store = _open(home)
+    try:
+        assert _problems(results, store, mode) == []
+    finally:
+        store.close()
