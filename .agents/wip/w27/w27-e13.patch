+    wa.deliver({ id: "1" }, { id: "2" }, { id: "3" }, { id: "4" });
+    const first = await session.events(0, session.epoch, 0);
+    expect(first.events.map((e) => e.id)).toEqual(["2", "3", "4"]);
+    const next = await session.events(first.cursor, session.epoch, 0);
