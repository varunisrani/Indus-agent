+    await session.stop();
+  });
+
+  it("asks for pairing only in pair mode, by code when a phone is given", async () => {
+    const serve = await started();
+    serve.wa.qr();
+    expect(serve.session.status).toBe("pairing");
+    expect(serve.notes.at(-1)).toEqual({ event: "pairing_required" });
+
+    const wa = new FakeWa();
