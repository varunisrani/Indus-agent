+import { describe, expect, it } from "vitest";
+import {
+  baileysError,
+  bindBaileys,
+  type ConnectionUpdate,
+  providerFrom,
+  type RawMessage,
+  readBaileysMessage,
+} from "./provider.ts";
+
+const ANA = "15550000200@s.whatsapp.net";
+const GROUP = "120363000000000300@g.us";
+const nothing = async (): Promise<Uint8Array> => new Uint8Array();
+
+function read(message: unknown): RawMessage | null {
+  return readBaileysMessage(message, nothing);
+}
+
+describe("reading library messages", () => {
+  it("reads text, mentions, quotes and the sender's other address", () => {
+    const raw = read({
+      key: {
+        remoteJid: GROUP,
+        id: "M1",
+        participant: "15550000200:3@s.whatsapp.net",
+        participantLid: "777@lid",
+      },
+      pushName: "Ana",
+      messageTimestamp: { toNumber: () => 1_767_258_000 },
+      message: {
+        extendedTextMessage: {
+          text: "hi @bot",
+          contextInfo: {
+            mentionedJid: ["999@lid", 5],
+            stanzaId: "Q1",
+            participant: "15550000999@s.whatsapp.net",
+            quotedMessage: { conversation: "earlier" },
+          },
+        },
+      },
+    });
+    expect(raw).toMatchObject({
+      id: "M1",
+      chat: GROUP,
+      participant: "15550000200:3@s.whatsapp.net",
+      senderAlt: "777@lid",
+      text: "hi @bot",
+      timestamp: 1_767_258_000,
+      mentions: ["999@lid"],
+      quoted: { id: "Q1", participant: "15550000999@s.whatsapp.net", text: "earlier" },
+      editOf: null,
+    });
+    const dm = read({
+      key: { remoteJid: ANA, id: "M2", senderLid: "777@lid" },
+      message: { conversation: "yo" },
+    });
+    expect(dm).toMatchObject({ participant: null, senderAlt: "777@lid", text: "yo" });
+  });
+
+  it("reads media inside wrappers, voice notes and documents", () => {
+    const voice = read({
+      key: { remoteJid: ANA, id: "V" },
+      message: {
+        ephemeralMessage: { message: { audioMessage: { ptt: true, mimetype: "audio/ogg" } } },
+      },
+    });
+    expect(voice?.media).toMatchObject({ kind: "voice", mime: "audio/ogg" });
+    const doc = read({
+      key: { remoteJid: ANA, id: "D" },
+      message: {
+        documentWithCaptionMessage: {
+          message: {
+            documentMessage: {
+              caption: "notes",
+              fileName: "a.txt",
+              mimetype: "text/plain",
+              fileLength: "12",
+            },
+          },
+        },
+      },
+    });
+    expect(doc).toMatchObject({
+      text: "notes",
+      media: { kind: "document", name: "a.txt", size: 12 },
+    });
+    const photo = read({
+      key: { remoteJid: ANA, id: "P" },
+      message: { imageMessage: { caption: "look" } },
+    });
+    expect(photo).toMatchObject({ text: "look", media: { kind: "image" } });
+  });
+
+  it("reads edits and drops other protocol messages and empty ones", () => {
+    const edit = read({
+      key: { remoteJid: ANA, id: "E" },
+      message: {
+        protocolMessage: { type: 14, key: { id: "M0" }, editedMessage: { conversation: "fixed" } },
+      },
+    });
+    expect(edit).toMatchObject({ text: "fixed", editOf: "M0" });
+    expect(
+      read({ key: { remoteJid: ANA, id: "R" }, message: { protocolMessage: { type: 0 } } }),
+    ).toBeNull();
+    expect(read({ key: { remoteJid: ANA, id: "X" }, message: {} })).toBeNull();
+    expect(read({ key: { id: "X" }, message: { conversation: "no chat" } })).toBeNull();
+  });
+});
+
+describe("errors", () => {
+  it("reads the library's status codes", () => {
+    expect(baileysError({ output: { statusCode: 429 } }).code).toBe("rate_limited");
+    expect(baileysError({ output: { statusCode: 403 } }).code).toBe("forbidden");
+    expect(baileysError({ output: { statusCode: 428 } }).code).toBe("not_connected");
+    expect(baileysError(new Error("boom")).code).toBe("failed");
+  });
+});
+
+function fakeLibrary() {
+  const listeners = new Map<string, (value: unknown) => void>();
+  const sent: unknown[][] = [];
+  let saved = 0;
+  const socket = {
+    ev: { on: (name: string, fn: (value: unknown) => void) => listeners.set(name, fn) },
+    user: { id: "15550000999:4@s.whatsapp.net", lid: "999:4@lid" },
+    sendMessage: async (...args: unknown[]) => {
+      sent.push(["sendMessage", ...args]);
+      const content = args[1] as Record<string, unknown>;
+      if (content.text === "limit") throw { output: { statusCode: 429 } };
+      return { key: { id: `OUT${sent.length}` } };
+    },
+    sendPresenceUpdate: async (...args: unknown[]) => sent.push(["presence", ...args]),
+    readMessages: async (...args: unknown[]) => sent.push(["read", ...args]),
+    requestPairingCode: async (phone: string) => `CODE-${phone}`,
+    end: () => sent.push(["end"]),
+  };
+  const lib = {
+    useMultiFileAuthState: async (folder: string) => ({
+      state: { folder },
+      saveCreds: async () => {
+        saved += 1;
+      },
+    }),
+    makeWASocket: (config: Record<string, unknown>) => {
+      sent.push(["make", (config.auth as { folder: string }).folder, config.printQRInTerminal]);
+      return socket;
+    },
+    DisconnectReason: { loggedOut: 401 },
+    downloadMediaMessage: async () => new Uint8Array([1, 2]),
+  };
+  return { lib, listeners, sent, saved: () => saved };
+}
+
+describe("the Baileys binding", () => {
+  it("maps connection updates, live messages and outbound calls", async () => {
+    const { lib, listeners, sent, saved } = fakeLibrary();
+    const updates: ConnectionUpdate[] = [];
+    const inbound: RawMessage[] = [];
+    const socket = await bindBaileys(lib, {
+      authDir: "/state/auth",
+      handlers: { onUpdate: (u) => updates.push(u), onMessages: (m) => inbound.push(...m) },
+    });
+    expect(sent[0]).toEqual(["make", "/state/auth", false]);
+    listeners.get("creds.update")?.({});
+    expect(saved()).toBe(1);
+    listeners.get("connection.update")?.({ qr: "2@qr" });
+    listeners.get("connection.update")?.({ connection: "open" });
+    listeners.get("connection.update")?.({
+      connection: "close",
+      lastDisconnect: { error: { output: { statusCode: 401 } } },
+    });
+    expect(updates).toEqual([
+      { state: "qr", qr: "2@qr" },
+      { state: "open", self: { jid: "15550000999@s.whatsapp.net", lid: "999@lid" } },
+      { state: "closed", loggedOut: true, reason: "status 401" },
+    ]);
+    const message = {
+      key: { remoteJid: ANA, id: "IN1" },
+      message: { imageMessage: { mimetype: "image/jpeg" } },
+    };
+    listeners.get("messages.upsert")?.({ type: "append", messages: [message] });
+    listeners.get("messages.upsert")?.({ type: "notify", messages: [message] });
+    const own = {
+      key: { remoteJid: ANA, id: "OWN1", fromMe: true },
+      message: { conversation: "me" },
+    };
+    listeners.get("messages.upsert")?.({ type: "append", messages: [own] });
+    listeners.get("messages.upsert")?.({ type: "history", messages: [own] });
+    expect(inbound.map((m) => m.id)).toEqual(["IN1", "OWN1"]);
+    expect(await inbound[0]?.media?.download()).toEqual(new Uint8Array([1, 2]));
+
+    expect(
+      await socket.sendText(ANA, "hi", { id: "IN1", fromMe: false, participant: null }),
+    ).toMatch(/^OUT/);
+    expect(sent.at(-1)?.[3]).toEqual({ quoted: message });
+    await socket.sendMedia(ANA, { kind: "voice", path: "/tmp/v.ogg" });
+    expect(sent.at(-1)?.[2]).toEqual({
+      audio: { url: "/tmp/v.ogg" },
+      ptt: true,
+      mimetype: "audio/ogg; codecs=opus",
+    });
+    await socket.sendMedia(ANA, {
+      kind: "document",
+      path: "/tmp/a.pdf",
+      fileName: "a.pdf",
+      caption: "c",
+    });
+    expect(sent.at(-1)?.[2]).toEqual({
+      document: { url: "/tmp/a.pdf" },
+      mimetype: "application/octet-stream",
+      fileName: "a.pdf",
+      caption: "c",
+    });
+    await expect(socket.sendText(ANA, "limit")).rejects.toMatchObject({ code: "rate_limited" });
+    await socket.presence(ANA, "composing");
+    await socket.markRead(GROUP, { id: "G1", fromMe: false, participant: ANA });
+    expect(sent.at(-1)).toEqual([
+      "read",
+      [{ remoteJid: GROUP, id: "G1", fromMe: false, participant: ANA }],
+    ]);
+    expect(await socket.requestPairingCode("+1 555 0000999")).toBe("CODE-15550000999");
+    await socket.close();
+    expect(sent.at(-1)).toEqual(["end"]);
+  });
+
+  it("prefers a provider's own createWaSocket and refuses modules with neither", () => {
+    const own = async () => {
+      throw new Error("unused");
+    };
+    expect(providerFrom({ createWaSocket: own })).toBe(own);
+    expect(typeof providerFrom(fakeLibrary().lib)).toBe("function");
+    expect(() => providerFrom({})).toThrow(/neither/);
+  });
+});
diff --git a/apps/whatsapp-bridge/src/provider.ts b/apps/whatsapp-bridge/src/provider.ts
new file mode 100644
index 0000000..6986143
--- /dev/null
+++ b/apps/whatsapp-bridge/src/provider.ts
@@ -0,0 +1,455 @@
+// The one seam between the bridge and a WhatsApp Web library.
+//
+// The session (session.ts) talks only to `WaSocket`; a provider builds one. The library is never a
+// build-time dependency of this package: the operator installs it and names it with
+// INDUS_WA_PROVIDER (a module path, a package name, or a folder whose node_modules holds the
+// library). A module that exports `createWaSocket` is used as it is; a module with Baileys' API
+// (`useMultiFileAuthState` plus `makeWASocket` or a default export) goes through `bindBaileys`.
+
+import { statSync } from "node:fs";
+import { createRequire } from "node:module";
+import { isAbsolute, join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { isGroup, stripDevice } from "./jid.ts";
+
+export type MediaKind = "image" | "video" | "audio" | "voice" | "document" | "sticker";
+export type OutboundKind = "image" | "video" | "audio" | "voice" | "document";
+
+export interface SelfIds {
+  jid: string;
+  lid: string | null;
+}
+
+export type ConnectionUpdate =
+  | { state: "connecting" }
+  | { state: "open"; self: SelfIds }
+  | { state: "qr"; qr: string }
+  | { state: "closed"; loggedOut: boolean; reason: string };
+
+export interface RawMedia {
+  kind: MediaKind;
+  mime: string;
+  name: string;
+  size: number | null;
+  download(): Promise<Uint8Array>;
+}
+
+/** One message as the library delivered it, reduced to what the bridge reads. */
+export interface RawMessage {
+  id: string;
+  chat: string;
+  fromMe: boolean;
+  /** The sender inside a group (null in a direct chat). */
+  participant: string | null;
+  /** The sender's other address (phone JID ↔ LID) when the library knows it. */
+  senderAlt: string | null;
+  pushName: string;
+  text: string;
+  /** Seconds since the epoch. */
+  timestamp: number;
+  mentions: string[];
+  quoted: { id: string; participant: string | null; text: string } | null;
+  media: RawMedia | null;
+  /** Set when this message edits an earlier one. */
+  editOf: string | null;
+}
+
+export interface MessageRef {
+  id: string;
+  fromMe: boolean;
+  participant: string | null;
+}
+
+export interface OutboundMedia {
+  kind: OutboundKind;
+  path: string;
+  caption?: string;
+  fileName?: string;
+  mime?: string;
+}
+
+export interface WaSocket {
+  /** Returns the new message's id. */
+  sendText(chat: string, text: string, quoted?: MessageRef): Promise<string>;
+  sendMedia(chat: string, media: OutboundMedia, quoted?: MessageRef): Promise<string>;
+  presence(chat: string, state: "composing" | "paused"): Promise<void>;
+  react(chat: string, target: MessageRef, emoji: string): Promise<void>;
+  markRead(chat: string, target: MessageRef): Promise<void>;
+  requestPairingCode(phone: string): Promise<string>;
+  close(): Promise<void>;
+}
+
+export interface SocketHandlers {
+  onUpdate(update: ConnectionUpdate): void;
+  onMessages(messages: RawMessage[]): void;
+}
+
+export interface ProviderOptions {
+  authDir: string;
+  handlers: SocketHandlers;
+}
+
+export type WaProvider = (options: ProviderOptions) => Promise<WaSocket>;
+
+export type WaErrorCode =
+  | "not_connected"
+  | "chat_not_found"
+  | "message_not_found"
+  | "forbidden"
+  | "rate_limited"
+  | "too_large"
+  | "timeout"
+  | "bad_request"
+  | "failed";
+
+/** A library failure with our code; `detail` never holds message text or a number. */
+export class WaError extends Error {
+  readonly code: WaErrorCode;
+  readonly retryAfter: number | null;
+
+  constructor(code: WaErrorCode, detail = "", retryAfter: number | null = null) {
+    super(detail || code);
+    this.name = "WaError";
+    this.code = code;
+    this.retryAfter = retryAfter;
+  }
+}
+
+// -- loading -----------------------------------------------------------------------------------
+
+type Loaded = Record<string, unknown>;
+
+function isDirectory(path: string): boolean {
+  try {
+    return statSync(path).isDirectory();
+  } catch {
+    return false;
+  }
+}
+
+/** The module URL or name to import for `spec` (see the file notes). */
+export function resolveProvider(spec: string): string {
+  const text = spec.trim();
+  if (!text) throw new Error("no provider named (INDUS_WA_PROVIDER)");
+  if (isAbsolute(text) && isDirectory(text)) {
+    const found = createRequire(join(text, "package.json")).resolve("@whiskeysockets/baileys");
+    return pathToFileURL(found).href;
+  }
+  return isAbsolute(text) ? pathToFileURL(text).href : text;
+}
+
+export async function loadProvider(spec: string): Promise<WaProvider> {
+  const loaded = (await import(resolveProvider(spec))) as Loaded;
+  return providerFrom(loaded);
+}
+
+export function providerFrom(loaded: Loaded): WaProvider {
+  const own = loaded.createWaSocket;
+  if (typeof own === "function") return own as WaProvider;
+  if (typeof loaded.useMultiFileAuthState === "function") {
+    return (options) => bindBaileys(loaded, options);
+  }
+  throw new Error("the provider module has neither createWaSocket nor a WhatsApp Web library API");
+}
+
+// -- the Baileys binding ---------------------------------------------------------------------------
+// Everything below reads the library structurally: names as the vendor's typings spell them
+// (makeWASocket, useMultiFileAuthState, downloadMediaMessage, DisconnectReason, socket.ev,
+// sendMessage, sendPresenceUpdate, readMessages, requestPairingCode, end, user).
+
+type Fn = (...args: unknown[]) => unknown;
+type Obj = Record<string, unknown>;
+
+function obj(value: unknown): Obj {
+  return typeof value === "object" && value !== null ? (value as Obj) : {};
+}
+
+function str(value: unknown): string {
+  return typeof value === "string" ? value : "";
+}
+
+function num(value: unknown): number | null {
+  if (typeof value === "number" && Number.isFinite(value)) return value;
+  if (typeof value === "string" && /^\d+$/.test(value)) return Number(value);
+  const toNumber = obj(value).toNumber;
+  if (typeof toNumber === "function") {
+    const n = (toNumber as Fn).call(value);
+    return typeof n === "number" && Number.isFinite(n) ? n : null;
+  }
+  return null;
+}
+
+const SILENT_LOGGER = {
+  level: "silent",
+  child() {
+    return SILENT_LOGGER;
+  },
+  trace() {},
+  debug() {},
+  info() {},
+  warn() {},
+  error() {},
+  fatal() {},
+};
+
+const WRAPPERS = [
+  "ephemeralMessage",
+  "viewOnceMessage",
+  "viewOnceMessageV2",
+  "viewOnceMessageV2Extension",
+  "documentWithCaptionMessage",
+  "editedMessage",
+];
+const MESSAGE_EDIT = 14;
+
+function unwrap(content: Obj): Obj {
+  let current = content;
+  for (let depth = 0; depth < 5; depth += 1) {
+    const inner = WRAPPERS.map((name) => obj(obj(current[name]).message)).find(
+      (m) => Object.keys(m).length > 0,
+    );
+    if (inner === undefined) return current;
+    current = inner;
+  }
+  return current;
+}
+
+const MEDIA_FIELDS: ReadonlyArray<[string, MediaKind]> = [
+  ["imageMessage", "image"],
+  ["videoMessage", "video"],
+  ["audioMessage", "audio"],
+  ["documentMessage", "document"],
+  ["stickerMessage", "sticker"],
+];
+
+function otherForm(primary: string, ...candidates: unknown[]): string | null {
+  for (const candidate of candidates) {
+    const text = str(candidate);
+    if (text && stripDevice(text) !== stripDevice(primary)) return text;
+  }
+  return null;
+}
+
+/** One library message as a `RawMessage`, or null when it carries nothing to read. */
+export function readBaileysMessage(
+  message: unknown,
+  download: (message: unknown) => Promise<Uint8Array>,
+): RawMessage | null {
+  const msg = obj(message);
+  const key = obj(msg.key);
+  const chat = str(key.remoteJid);
+  const id = str(key.id);
+  if (!chat || !id) return null;
+  let content = unwrap(obj(msg.message));
+  let editOf: string | null = null;
+  const protocol = obj(content.protocolMessage);
+  if (Object.keys(protocol).length > 0) {
+    if (num(protocol.type) !== MESSAGE_EDIT) return null;
+    editOf = str(obj(protocol.key).id) || null;
+    content = unwrap(obj(protocol.editedMessage));
+  }
+  const extended = obj(content.extendedTextMessage);
+  let text = str(content.conversation) || str(extended.text);
+  let context = obj(extended.contextInfo);
+  let media: RawMedia | null = null;
+  for (const [field, kind] of MEDIA_FIELDS) {
+    const part = obj(content[field]);
+    if (Object.keys(part).length === 0) continue;
+    text = text || str(part.caption);
+    context = Object.keys(context).length > 0 ? context : obj(part.contextInfo);
+    media = {
+      kind: kind === "audio" && part.ptt === true ? "voice" : kind,
+      mime: str(part.mimetype),
+      name: str(part.fileName),
+      size: num(part.fileLength),
+      download: () => download(message),
+    };
+    break;
+  }
+  if (!text && media === null) return null;
+  const participant = str(key.participant) || null;
+  const primary = participant ?? chat;
+  const quotedId = str(context.stanzaId);
+  const quotedContent = unwrap(obj(context.quotedMessage));
+  const quotedText =
+    str(quotedContent.conversation) ||
+    str(obj(quotedContent.extendedTextMessage).text) ||
+    str(obj(quotedContent.imageMessage).caption);
+  const mentions = Array.isArray(context.mentionedJid)
+    ? context.mentionedJid.filter((m): m is string => typeof m === "string")
+    : [];
+  return {
+    id,
+    chat,
+    fromMe: key.fromMe === true,
+    participant: isGroup(chat) ? participant : null,
+    senderAlt: isGroup(chat)
+      ? otherForm(primary, key.participantAlt, key.participantPn, key.participantLid)
+      : otherForm(chat, key.remoteJidAlt, key.senderPn, key.senderLid),
+    pushName: str(msg.pushName),
+    text,
+    timestamp: num(msg.messageTimestamp) ?? Math.floor(Date.now() / 1000),
+    mentions,
+    quoted: quotedId
+      ? { id: quotedId, participant: str(context.participant) || null, text: quotedText }
+      : null,
+    media,
+    editOf,
+  };
+}
+
+/** A library failure as a `WaError` (Boom errors carry an HTTP-like status). */
+export function baileysError(error: unknown): WaError {
+  if (error instanceof WaError) return error;
+  const status = num(obj(obj(error).output).statusCode);
+  switch (status) {
+    case 429:
+      return new WaError("rate_limited", "rate limited by WhatsApp", null);
+    case 404:
+      return new WaError("chat_not_found", "chat not found");
+    case 401:
+    case 403:
+      return new WaError("forbidden", "forbidden");
+    case 408:
+    case 428:
+    case 440:
+    case 500:
+    case 503:
+    case 515:
+      return new WaError("not_connected", "connection closed");
+    default:
+      return new WaError("failed", status === null ? "library error" : `library error ${status}`);
+  }
+}
+
+const QUOTE_KEEP = 500;
+
+export async function bindBaileys(lib: Loaded, options: ProviderOptions): Promise<WaSocket> {
+  const makeSocket = (lib.makeWASocket ?? lib.default) as Fn | undefined;
+  const useAuth = lib.useMultiFileAuthState as Fn;
+  const downloader = lib.downloadMediaMessage as Fn | undefined;
+  if (typeof makeSocket !== "function") throw new Error("the library has no makeWASocket");
+  const loggedOutCode = num(obj(lib.DisconnectReason).loggedOut) ?? 401;
+  const auth = obj(await useAuth(options.authDir));
+  const sock = obj(
+    makeSocket({ auth: auth.state, logger: SILENT_LOGGER, printQRInTerminal: false }),
+  );
+  const ev = obj(sock.ev);
+  const on = ev.on as Fn;
+  const recent = new Map<string, unknown>();
+
+  const download = async (message: unknown): Promise<Uint8Array> => {
+    if (typeof downloader !== "function") throw new WaError("failed", "no media download");
+    const data = await downloader(message, "buffer", {});
+    if (!(data instanceof Uint8Array)) throw new WaError("failed", "media download failed");
+    return data;
+  };
+
+  on.call(ev, "creds.update", auth.saveCreds);
+  on.call(ev, "connection.update", (update: unknown) => {
+    const u = obj(update);
+    const qr = str(u.qr);
+    if (qr) options.handlers.onUpdate({ state: "qr", qr });
+    if (u.connection === "connecting") options.handlers.onUpdate({ state: "connecting" });
+    if (u.connection === "open") {
+      const user = obj(sock.user);
+      options.handlers.onUpdate({
+        state: "open",
+        self: {
+          jid: stripDevice(str(user.id)),
+          lid: str(user.lid) ? stripDevice(str(user.lid)) : null,
+        },
+      });
+    }
+    if (u.connection === "close") {
+      const status = num(obj(obj(obj(u.lastDisconnect).error).output).statusCode);
+      options.handlers.onUpdate({
+        state: "closed",
+        loggedOut: status === loggedOutCode,
+        reason: status === null ? "closed" : `status ${status}`,
+      });
+    }
+  });
+  on.call(ev, "messages.upsert", (upsert: unknown) => {
+    const u = obj(upsert);
+    // Live messages are "notify"; the owner's own messages (self-chat) often come as "append",
+    // which also carries history, so from "append" only our own messages are taken.
+    if ((u.type !== "notify" && u.type !== "append") || !Array.isArray(u.messages)) return;
+    const out: RawMessage[] = [];
+    for (const message of u.messages) {
+      const raw = readBaileysMessage(message, download);
+      if (raw === null || (u.type === "append" && !raw.fromMe)) continue;
+      recent.set(raw.id, message);
+      if (recent.size > QUOTE_KEEP) recent.delete(recent.keys().next().value as string);
+      out.push(raw);
+    }
+    if (out.length > 0) options.handlers.onMessages(out);
+  });
+
+  const call = async (name: string, ...args: unknown[]): Promise<unknown> => {
+    const method = sock[name];
+    if (typeof method !== "function") throw new WaError("failed", `the library has no ${name}`);
+    try {
+      return await (method as Fn).apply(sock, args);
+    } catch (error) {
+      throw baileysError(error);
+    }
+  };
+  const keyOf = (chat: string, ref: MessageRef): Obj => ({
+    remoteJid: chat,
+    id: ref.id,
+    fromMe: ref.fromMe,
+    ...(ref.participant ? { participant: ref.participant } : {}),
+  });
+  const quoteOf = (chat: string, ref: MessageRef | undefined): Obj | undefined => {
+    if (ref === undefined) return undefined;
+    const known = recent.get(ref.id);
+    return { quoted: known ?? { key: keyOf(chat, ref), message: { conversation: "" } } };
+  };
+  const sentId = (result: unknown): string => {
+    const id = str(obj(obj(result).key).id);
+    if (!id) throw new WaError("failed", "the library returned no message id");
+    return id;
+  };
+
+  return {
+    async sendText(chat, text, quoted) {
+      return sentId(await call("sendMessage", chat, { text }, quoteOf(chat, quoted)));
+    },
+    async sendMedia(chat, media, quoted) {
+      const upload = { url: media.path };
+      const caption = media.caption ? { caption: media.caption } : {};
+      let content: Obj;
+      if (media.kind === "image") content = { image: upload, ...caption };
+      else if (media.kind === "video") content = { video: upload, ...caption };
+      else if (media.kind === "voice")
+        content = { audio: upload, ptt: true, mimetype: media.mime || "audio/ogg; codecs=opus" };
+      else if (media.kind === "audio")
+        content = { audio: upload, mimetype: media.mime || "audio/mpeg" };
+      else
+        content = {
+          document: upload,
+          mimetype: media.mime || "application/octet-stream",
+          ...(media.fileName ? { fileName: media.fileName } : {}),
+          ...caption,
+        };
+      return sentId(await call("sendMessage", chat, content, quoteOf(chat, quoted)));
+    },
+    async presence(chat, state) {
+      await call("sendPresenceUpdate", state, chat);
+    },
+    async react(chat, target, emoji) {
+      await call("sendMessage", chat, { react: { text: emoji, key: keyOf(chat, target) } });
+    },
+    async markRead(chat, target) {
+      await call("readMessages", [keyOf(chat, target)]);
+    },
+    async requestPairingCode(phone) {
+      return str(await call("requestPairingCode", phone.replace(/\D/g, "")));
+    },
+    async close() {
+      const end = sock.end;
+      if (typeof end === "function") (end as Fn).call(sock, undefined);
+    },
+  };
+}
diff --git a/apps/whatsapp-bridge/src/session.test.ts b/apps/whatsapp-bridge/src/session.test.ts
new file mode 100644
index 0000000..bee3c30
--- /dev/null
+++ b/apps/whatsapp-bridge/src/session.test.ts
@@ -0,0 +1,316 @@
+import { mkdirSync, mkdtempSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { mask, stripDevice } from "./jid.ts";
+import { WaError } from "./provider.ts";
+import { type LifecycleEvent, OutboundIds, Session, type SessionOptions } from "./session.ts";
+import { FakeWa, OWN } from "./testing/fakeSocket.ts";
+
+const ANA = "15550000200@s.whatsapp.net";
+const GROUP = "120363000000000300@g.us";
+
+let dir: string;
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), "wa-session-"));
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  rmSync(dir, { recursive: true, force: true });
+});
+
+async function started(options: Partial<SessionOptions> = {}): Promise<{
+  wa: FakeWa;
+  session: Session;
+  notes: LifecycleEvent[];
+}> {
+  const wa = new FakeWa();
+  const notes: LifecycleEvent[] = [];
+  const session = new Session({
+    provider: wa.provider,
+    authDir: join(dir, "auth"),
+    notify: (e) => notes.push(e),
+    ...options,
+  });
+  await session.start();
+  await Promise.resolve();
+  return { wa, session, notes };
+}
+
+async function drain(
+  session: Session,
+): Promise<ReturnType<Session["events"]> extends Promise<infer P> ? P : never> {
+  return session.events(0, session.epoch, 0);
+}
+
+describe("OutboundIds", () => {
+  it("keeps the newest ids and drops the oldest first", () => {
+    const ids = new OutboundIds(2);
+    ids.remember("a");
+    ids.remember("b");
+    ids.remember("a");
+    ids.remember("c");
+    expect(ids.has("a")).toBe(false);
+    expect(ids.has("b")).toBe(true);
+    expect(ids.has("c")).toBe(true);
+    expect(ids.size).toBe(2);
+    expect(ids.has("")).toBe(false);
+    expect(() => new OutboundIds(0)).toThrow(RangeError);
+  });
+});
+
+describe("jid helpers", () => {
+  it("strips device suffixes and masks numbers", () => {
+    expect(stripDevice("15550000200:12@s.whatsapp.net")).toBe(ANA);
+    expect(stripDevice(GROUP)).toBe(GROUP);
+    expect(mask(ANA)).toBe("*******0200@s.whatsapp.net");
+  });
+});
+
+describe("inbound filtering", () => {
+  it("drops our own outbound messages when they come back", async () => {
+    const { wa, session } = await started({ selfChat: true });
+    const id = await session.sendText(OWN.jid, "reply");
+    wa.deliver({ id, chat: OWN.jid, fromMe: true, text: "reply" });
+    wa.deliver({ id: "TYPED", chat: OWN.jid, fromMe: true, text: "note to self" });
+    const page = await drain(session);
+    expect(page.events.map((e) => e.text)).toEqual(["note to self"]);
+    expect(page.events[0]?.fromMe).toBe(true);
+    expect(page.events[0]?.sender).toBe(OWN.jid);
+  });
+
+  it("decides on an own message only after a send in flight returned its id", async () => {
+    const { wa, session } = await started({ selfChat: true });
+    const release = wa.holdSends();
+    const sending = session.sendText(OWN.jid, "reply");
+    await Promise.resolve();
+    wa.deliver({ id: "OUT1", chat: OWN.jid, fromMe: true, text: "reply" });
+    expect((await drain(session)).events).toEqual([]);
+    release();
+    expect(await sending).toBe("OUT1");
+    expect((await drain(session)).events).toEqual([]);
+  });
+
+  it("drops what the owner types unless self-chat is on and it is their own chat", async () => {
+    const off = await started();
+    off.wa.deliver({ id: "A", chat: OWN.jid, fromMe: true }, { id: "B", chat: ANA, fromMe: true });
+    expect((await drain(off.session)).events).toEqual([]);
+    const on = await started({ selfChat: true });
+    on.wa.deliver(
+      { id: "C", chat: ANA, fromMe: true, text: "owner to Ana" },
+      { id: "D", chat: OWN.lid ?? "", fromMe: true, text: "own lid chat" },
+    );
+    expect((await drain(on.session)).events.map((e) => e.id)).toEqual(["D"]);
+  });
+
+  it("never forwards status updates, broadcast lists or channels", async () => {
+    const { wa, session } = await started();
+    wa.deliver(
+      { id: "S", chat: "status@broadcast", participant: ANA },
+      { id: "N", chat: "1203630000@newsletter" },
+      { id: "L", chat: "1700000000@broadcast" },
+      { id: "OK", chat: ANA },
+    );
+    expect((await drain(session)).events.map((e) => e.id)).toEqual(["OK"]);
+  });
+
+  it("normalises groups, devices, mentions, quotes and edits", async () => {
+    const { wa, session } = await started();
+    wa.deliver(
+      {
+        id: "G1",
+        chat: GROUP,
+        participant: "15550000200:7@s.whatsapp.net",
+        senderAlt: "77700000200:7@lid",
+        text: "@88800000999 look",
+        mentions: ["88800000999:3@lid"],
+        quoted: { id: "OUT9", participant: `${OWN.jid}`, text: "earlier" },
+      },
+      { id: "E1", chat: ANA, text: "fixed", editOf: "IN0" },
+      { id: "EMPTY", chat: ANA, text: "" },
+    );
+    const [group, edit, ...rest] = (await drain(session)).events;
+    expect(rest).toEqual([]);
+    expect(group).toMatchObject({
+      chat: GROUP,
+      group: true,
+      sender: ANA,
+      senderAlt: "77700000200@lid",
+      mentions: ["88800000999@lid"],
+      mentionsMe: true,
+      quoted: { id: "OUT9", sender: OWN.jid, text: "earlier", fromMe: true },
+      edited: false,
+    });
+    expect(edit).toMatchObject({
+      id: "IN0",
+      edited: true,
+      text: "fixed",
+      group: false,
+      sender: ANA,
+    });
+  });
+
+  it("hands out media refs and downloads only when asked", async () => {
+    const { wa, session } = await started();
+    let downloads = 0;
+    const media = {
+      kind: "voice" as const,
+      mime: "audio/ogg",
+      name: "",
+      size: 4,
+      download: async () => {
+        downloads += 1;
