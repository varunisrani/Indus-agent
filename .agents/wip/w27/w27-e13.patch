+    wa.qr();
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    expect(wa.calls.filter((c) => c.op === "pair")).toHaveLength(1);
+    expect(notes).toContainEqual({ event: "pairing_code", code: "ABCD1234" });
+    wa.open();
+    await paired;
+    expect(notes.at(-1)).toEqual({ event: "connected" });
