+  });
+
+  it("answers a waiting poll at once when the session stops", async () => {
+    const { session } = await started();
+    const waiting = session.events(0, session.epoch, 10_000);
+    await session.stop();
+    expect((await waiting).events).toEqual([]);
+  });
+});
+
+describe("connection", () => {
