+// The small icon in front of a session: a prompt for terminals, a globe for the web, a clock for
+// schedules, a speech bubble for messaging apps.
+
+import { Clock, Globe, HelpCircle, MessageCircle, SquareTerminal } from "lucide-react";
+import { type SourceKind, sourceKind } from "./sources.ts";
+
+const ICONS: Record<SourceKind, typeof Clock> = {
+  terminal: SquareTerminal,
+  web: Globe,
+  automation: Clock,
+  messaging: MessageCircle,
+  unknown: HelpCircle,
+};
+
+export function SourceIcon({ source, className }: { source: string | null; className?: string }) {
+  const Icon = ICONS[sourceKind(source)];
+  return <Icon aria-hidden="true" className={className ?? "size-3.5"} />;
+}
diff --git a/apps/web/src/pages/sessions/sources.ts b/apps/web/src/pages/sessions/sources.ts
index 599407c..77afd4d 100644
--- a/apps/web/src/pages/sessions/sources.ts
+++ b/apps/web/src/pages/sessions/sources.ts
@@ -45,3 +45,31 @@ export function conflictMessage(error: unknown): string {
   }
   return error instanceof Error ? error.message : "The request failed.";
 }
+
+/** Sources that are chat apps rather than a terminal or a schedule. */
+const TERMINAL_SOURCES = ["cli", "tui", "desktop", "acp"] as const;
+
+export type SourceKind = "terminal" | "web" | "automation" | "messaging" | "unknown";
+
+/** What kind of place a session came from, for its icon. */
+export function sourceKind(source: string | null): SourceKind {
+  if (!source) return "unknown";
+  if ((TERMINAL_SOURCES as readonly string[]).includes(source)) return "terminal";
+  if (source === "web") return "web";
+  if (isAutomation(source)) return "automation";
+  return "messaging";
+}
+
+/** Display name for a source: short ids are shouted ("CLI"), names are capitalised ("Telegram"). */
+export function sourceLabel(source: string | null): string {
+  if (!source) return "Unknown";
+  if (source.length <= 3) return source.toUpperCase();
+  return source.charAt(0).toUpperCase() + source.slice(1).replaceAll("_", " ");
+}
+
+/** The placeholder of the source picker for a tab. */
+export function anySourceLabel(tab: SessionTab): string {
+  if (tab === "chats") return "Any chat source";
+  if (tab === "automation") return "Any automation source";
+  return "Any source";
+}
