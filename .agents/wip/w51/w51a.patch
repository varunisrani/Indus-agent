+import { Badge, Button, IconButton, inputClass } from "../../ui/controls.tsx";
+import { SessionDetail } from "./SessionDetail.tsx";
+import { SourceIcon } from "./SourceIcon.tsx";
+import { conflictMessage, sourceLabel } from "./sources.ts";
+
+export function sessionLabel(session: {
+  title: string | null;
+  preview?: string | null;
+  id: string;
+}): string {
+  return session.title || session.preview || session.id;
+}
+
+function SourceBadge({ source }: { source: string | null }) {
+  return <Badge icon={<SourceIcon source={source} />}>{sourceLabel(source)}</Badge>;
+}
+
+/** "model · 4 msgs · 3h ago" with the model in mono. */
+function MetaLine({ session, dotted }: { session: SessionInfo; dotted: boolean }) {
+  const parts = [
+    `${session.message_count} msgs`,
+    ...(session.tool_call_count > 0 && !dotted ? [`${session.tool_call_count} tools`] : []),
+    relativeTime(session.last_active),
+  ];
+  return (
+    <p className="m-0 flex flex-wrap items-baseline gap-x-3.5 text-[0.75rem] text-ink-muted">
+      {dotted ? (
+        <span>
+          {session.model ? <span className="type-data text-[0.75rem]">{session.model}</span> : null}
+          {session.model ? " · " : ""}
+          {parts.join(" · ")}
+        </span>
+      ) : (
+        <>
+          {session.model ? <span>{session.model}</span> : null}
+          {parts.map((part) => (
+            <span key={part}>{part}</span>
+          ))}
+        </>
+      )}
+    </p>
+  );
+}
+
+/** Overview card. Clicking the title opens the session in History. */
+export function RecentCard({ session, onOpen }: { session: SessionInfo; onOpen: () => void }) {
+  return (
+    <li
+      className="flex items-center gap-3 border border-line px-3 py-3"
+      data-testid={`recent-${session.id}`}
+    >
+      <div className="flex min-w-0 flex-1 flex-col gap-1">
+        <button
+          type="button"
+          onClick={onOpen}
+          className="type-serif self-start truncate text-left text-[0.875rem] text-ink hover:underline"
+        >
+          {sessionLabel(session)}
+        </button>
+        <MetaLine session={session} dotted />
+        {session.title && session.preview && session.preview !== session.title ? (
+          <p className="type-serif m-0 truncate text-[0.75rem] text-ink-soft">{session.preview}</p>
+        ) : null}
+      </div>
+      <div className="flex shrink-0 items-center gap-1.5">
+        {session.is_active ? <Badge tone="ok">active</Badge> : null}
+        <SourceBadge source={session.source} />
+      </div>
+    </li>
+  );
+}
+
+/** History row with its actions; the transcript opens underneath when expanded. */
+export function SessionRow({
+  session,
+  expanded,
+  highlight,
+  onToggle,
+  onDelete,
+}: {
+  session: SessionInfo;
+  expanded: boolean;
+  highlight: string;
+  onToggle: () => void;
+  onDelete: () => void;
+}) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const navigate = useNavigate();
+  const { selected } = useProfileScope();
+  const [editing, setEditing] = useState(false);
+  const [title, setTitle] = useState(session.title ?? "");
+  const label = sessionLabel(session);
+
+  const rename = useMutation({
+    mutationFn: (next: string) => api.sessions.rename(session.id, next),
+    onSuccess: () => {
+      setEditing(false);
+      void client.invalidateQueries({ queryKey: ["sessions"] });
+    },
+    onError: (error) => toast.show(conflictMessage(error), "error"),
+  });
+
+  const exportJson = async () => {
+    try {
+      saveJson(await api.sessions.exportJson(session.id), `session-${session.id}.json`);
+    } catch (error) {
+      toast.show(errorText(error), "error");
+    }
+  };
+
+  const resume = () => {
+    const query = new URLSearchParams({ resume: session.id });
+    if (selected) query.set("profile", selected);
+    navigate(`/chat?${query.toString()}`);
+  };
+
+  const submitRename = (event: FormEvent) => {
+    event.preventDefault();
+    const next = title.trim();
+    if (next) rename.mutate(next);
+  };
+
+  return (
+    <li className="border border-line" data-testid={`session-${session.id}`}>
+      <div className="flex items-start gap-3 px-3 py-2.5">
+        <SourceIcon source={session.source} className="mt-1 size-4 shrink-0 text-ink" />
+        <div className="flex min-w-0 flex-1 flex-col gap-0.5">
+          {editing ? (
+            <form className="flex flex-wrap gap-2" onSubmit={submitRename}>
+              <input
+                aria-label="Session title"
+                className={`${inputClass} min-w-48 flex-1`}
+                value={title}
+                onChange={(event) => setTitle(event.currentTarget.value)}
+              />
+              <Button type="submit" tone="primary" disabled={rename.isPending}>
+                Save
+              </Button>
+              <Button onClick={() => setEditing(false)}>Cancel</Button>
+            </form>
+          ) : (
+            <button
+              type="button"
+              className="type-serif self-start truncate text-left text-[0.875rem] text-ink hover:underline"
+              onClick={onToggle}
+              aria-expanded={expanded}
+            >
+              {label}
+            </button>
+          )}
+          <MetaLine session={session} dotted={false} />
+        </div>
+        <div className="flex shrink-0 items-center gap-1">
+          {session.is_active ? <Badge tone="ok">active</Badge> : null}
+          <SourceBadge source={session.source} />
+          <span className="w-2" />
+          <IconButton label={`Resume ${label} in Chat`} onClick={resume}>
+            <Play />
+          </IconButton>
+          <IconButton label="Rename" onClick={() => setEditing(true)}>
+            <Pencil />
+          </IconButton>
+          <IconButton label="Export JSON" onClick={() => void exportJson()}>
+            <Download />
+          </IconButton>
+          <IconButton label="Delete" tone="danger" onClick={onDelete}>
+            <Trash2 />
+          </IconButton>
+        </div>
+      </div>
+      {expanded ? <SessionDetail sessionId={session.id} highlight={highlight} /> : null}
+    </li>
+  );
+}
