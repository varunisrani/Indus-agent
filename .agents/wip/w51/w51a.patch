@@ -0,0 +1,108 @@
+// "Prune old sessions": a day count, a dry run that says how many would go, then the real prune.
+
+import { useMutation, useQueryClient } from "@tanstack/react-query";
+import { useState } from "react";
+import { api } from "../../lib/api.ts";
+import type { PruneResponse } from "../../lib/restTypes.ts";
+import { useToast } from "../../shell/Toasts.tsx";
+import { Button, inputClass, Notice } from "../../ui/controls.tsx";
+import { DialogActions, Modal } from "../../ui/Dialog.tsx";
+import { conflictMessage } from "./sources.ts";
+
+export function PruneDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
+  const toast = useToast();
+  const client = useQueryClient();
+  const [days, setDays] = useState("90");
+  const [preview, setPreview] = useState<PruneResponse | null>(null);
+  const [problem, setProblem] = useState("");
+  const parsed = Number.parseInt(days, 10);
+  const valid = /^\d+$/.test(days.trim()) && Number.isFinite(parsed) && parsed >= 0;
+
+  const close = () => {
+    setPreview(null);
+    setProblem("");
+    onClose();
+  };
+
+  const dryRun = useMutation({
+    mutationFn: () => api.sessions.prune(parsed, true),
+    onSuccess: (result) => {
+      setPreview(result);
+      setProblem("");
+    },
+    onError: (error) => setProblem(conflictMessage(error)),
+  });
+  const prune = useMutation({
+    mutationFn: () => api.sessions.prune(parsed, false),
+    onSuccess: (result) => {
+      toast.show(`Removed ${result.count} session${result.count === 1 ? "" : "s"}.`, "success");
+      void client.invalidateQueries({ queryKey: ["sessions"] });
+      close();
+    },
+    onError: (error) => setProblem(conflictMessage(error)),
+  });
+
+  return (
+    <Modal
+      open={open}
+      size="sm"
+      onOpenChange={(next) => (next ? undefined : close())}
+      title="Prune old sessions"
+      description="Deletes ended sessions whose last activity is older than the number of days below. Open sessions always stay."
+    >
+      <form
+        className="flex flex-col gap-1.5"
+        onSubmit={(event) => {
+          event.preventDefault();
+          if (valid) dryRun.mutate();
+        }}
+      >
+        <label htmlFor="prune-days" className="text-[0.75rem] text-ink-muted">
+          Older than (days)
+        </label>
+        <div className="flex gap-2">
+          <input
+            id="prune-days"
+            className={`${inputClass} flex-1`}
+            inputMode="numeric"
+            value={days}
+            onChange={(event) => {
+              setDays(event.currentTarget.value);
+              setPreview(null);
+            }}
+          />
+          <Button type="submit" disabled={!valid || dryRun.isPending}>
+            Check
+          </Button>
+        </div>
+      </form>
+      {!valid ? (
+        <p className="m-0 mt-2 text-[0.75rem] text-danger">Enter a whole number of days.</p>
+      ) : null}
+      {preview ? (
+        <p className="m-0 mt-3 text-[0.8125rem] text-ink" data-testid="prune-preview">
+          {preview.count} session{preview.count === 1 ? "" : "s"} would be removed
+          {preview.skipped_open ? ` (${preview.skipped_open} open sessions kept)` : ""}.
+        </p>
+      ) : null}
+      {problem ? (
+        <div className="mt-3">
+          <Notice tone="danger">{problem}</Notice>
+        </div>
+      ) : null}
+      <DialogActions>
+        <Button size="lg" onClick={close}>
+          Cancel
+        </Button>
+        <Button
+          size="lg"
+          tone="danger"
+          disabled={!preview || preview.count === 0 || prune.isPending}
+          onClick={() => prune.mutate()}
+        >
+          Prune {preview ? preview.count : ""}
+        </Button>
+      </DialogActions>
+    </Modal>
+  );
+}
