diff --git a/apps/desktop/src/chat/EffortChip.tsx b/apps/desktop/src/chat/EffortChip.tsx
new file mode 100644
index 0000000..f133cf6
--- /dev/null
+++ b/apps/desktop/src/chat/EffortChip.tsx
@@ -0,0 +1,79 @@
+// The composer's reasoning-effort chip (W51-b-6): shows the current model's effort preset and
+// sets it from a short menu. The caller applies the choice (preset store, `config.set reasoning`).
+
+import { Check } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+import type { MessageKey } from "../i18n/index.tsx";
+import { useT } from "../i18n/index.tsx";
+import { Chip } from "../ui/components.tsx";
+
+const LEVELS: ReadonlyArray<{ value: string | null; short: MessageKey; long: MessageKey }> = [
+  { value: null, short: "effort.auto", long: "effort.autoLong" },
+  { value: "none", short: "effort.none", long: "effort.noneLong" },
+  { value: "minimal", short: "effort.minimal", long: "effort.minimalLong" },
+  { value: "low", short: "effort.low", long: "effort.lowLong" },
+  { value: "medium", short: "effort.medium", long: "effort.mediumLong" },
+  { value: "high", short: "effort.high", long: "effort.highLong" },
+  { value: "xhigh", short: "effort.xhigh", long: "effort.xhighLong" },
+];
+
+export function effortShort(value: string | null): MessageKey {
+  return LEVELS.find((level) => level.value === value)?.short ?? "effort.auto";
+}
+
+export function EffortChip(props: {
+  effort: string | null;
+  onPick: (value: string | null) => void;
+}) {
+  const t = useT();
+  const [open, setOpen] = useState(false);
+  const root = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    if (!open) return;
+    const away = (event: PointerEvent) => {
+      if (!root.current?.contains(event.target as Node)) setOpen(false);
+    };
+    document.addEventListener("pointerdown", away);
+    return () => document.removeEventListener("pointerdown", away);
+  }, [open]);
+  return (
+    <div className="desk-menu-root" ref={root}>
+      <Chip
+        aria-haspopup="menu"
+        aria-expanded={open}
+        aria-label={t("effort.label", { level: t(effortShort(props.effort)) })}
+        onClick={() => setOpen(!open)}
+      >
+        {t(effortShort(props.effort))}
+      </Chip>
+      {open && (
+        <div className="desk-menu" data-side="up" data-align="end">
+          <div
+            role="menu"
+            aria-label={t("effort.title")}
+            onKeyDown={(event) => {
+              if (event.key === "Escape") setOpen(false);
+            }}
+          >
+            {LEVELS.map((level) => (
+              <button
+                key={level.value ?? "auto"}
+                type="button"
+                role="menuitemradio"
+                aria-checked={level.value === props.effort}
+                className="desk-menu-item"
+                onClick={() => {
+                  setOpen(false);
+                  props.onPick(level.value);
+                }}
+              >
+                <span className="desk-menu-item-label">{t(level.long)}</span>
+                {level.value === props.effort && <Check aria-hidden="true" />}
+              </button>
+            ))}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
