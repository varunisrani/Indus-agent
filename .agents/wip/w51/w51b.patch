@@ -0,0 +1,481 @@
+/* Core desktop components (W51-b) on the `--desk-*` tokens. Flat: a hairline or a soft fill,
+   never a box in a box. Text buttons size by padding; icon buttons are square. */
+
+/* -- buttons -------------------------------------------------------------------------------- */
+
+.desk-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 6px;
+  padding: 4px 10px;
+  border: 1px solid transparent;
+  border-radius: var(--desk-radius-control);
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+  line-height: 18px;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background-color var(--indus-duration-quick) var(--indus-easing-standard);
+}
+
+.desk-btn[data-size="sm"] {
+  padding: 2px 8px;
+  font-size: var(--desk-text-small);
+}
+
+.desk-btn:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
+.desk-btn[data-variant="primary"] {
+  background: var(--desk-accent);
+  color: var(--desk-accent-fg);
+}
+
+.desk-btn[data-variant="primary"]:hover:not(:disabled) {
+  background: color-mix(in srgb, var(--desk-accent) 88%, black);
+}
+
+.desk-btn[data-variant="secondary"] {
+  background: var(--desk-row-hover);
+}
+
+.desk-btn[data-variant="secondary"]:hover:not(:disabled),
+.desk-btn[data-variant="ghost"]:hover:not(:disabled),
+.desk-btn[data-variant="outline"]:hover:not(:disabled) {
+  background: var(--desk-row-active-soft);
+}
+
+.desk-btn[data-variant="outline"] {
+  border-color: var(--desk-stroke-3);
+}
+
+.desk-btn[data-variant="text"] {
+  padding-inline: 0;
+  color: var(--desk-fg-2);
+}
+
+.desk-btn[data-variant="text"]:hover:not(:disabled) {
+  color: var(--desk-fg-1);
+}
+
+.desk-btn[data-variant="danger"] {
+  border-color: color-mix(in srgb, var(--desk-danger) 45%, transparent);
+  color: var(--desk-danger);
+}
+
+.desk-icon-btn {
+  display: inline-grid;
+  place-items: center;
+  width: 24px;
+  height: 24px;
+  padding: 0;
+  border: 0;
+  border-radius: var(--desk-radius-control);
+  background: transparent;
+  color: var(--desk-fg-3);
+  cursor: pointer;
+  transition:
+    background-color var(--indus-duration-quick) var(--indus-easing-standard),
+    color var(--indus-duration-quick) var(--indus-easing-standard);
+}
+
+.desk-icon-btn[data-size="sm"] {
+  width: 20px;
+  height: 20px;
+}
+
+.desk-icon-btn[data-size="band"] {
+  width: 22px;
+  height: 22px;
+}
+
+.desk-icon-btn > svg {
+  width: 15px;
+  height: 15px;
+}
+
+.desk-icon-btn[data-size="sm"] > svg {
+  width: 13px;
+  height: 13px;
+}
+
+.desk-icon-btn:hover:not(:disabled),
+.desk-icon-btn[aria-expanded="true"] {
+  background: var(--desk-row-hover);
+  color: var(--desk-fg-1);
+}
+
+.desk-icon-btn[data-active="true"],
+.desk-icon-btn[aria-pressed="true"],
+.desk-icon-btn[aria-checked="true"] {
+  background: var(--desk-row-active);
+  color: var(--desk-fg-1);
+}
+
+.desk-icon-btn:disabled {
+  opacity: 0.4;
+  cursor: default;
+}
+
+/* -- keys, chips, labels -------------------------------------------------------------------- */
+
+.desk-key-hint {
+  display: inline-flex;
+  gap: 3px;
+  margin-left: auto;
+}
+
+.desk-kbd {
+  display: inline-grid;
+  place-items: center;
+  min-width: 18px;
+  height: 18px;
+  padding: 0 4px;
+  border: 1px solid var(--desk-stroke-1);
+  border-radius: 3px;
+  background: var(--desk-bg-kbd);
+  color: var(--desk-fg-4);
+  font-family: var(--desk-font-ui);
+  font-size: 10px;
+  line-height: 1;
+}
+
+.desk-kbd[data-key]::before {
+  content: attr(data-key);
+}
+
+.desk-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  max-width: 220px;
+  padding: 2px 6px;
+  border: 0;
+  border-radius: var(--desk-radius-control);
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+  cursor: pointer;
+}
+
+.desk-chip:hover,
+.desk-chip[aria-expanded="true"] {
+  background: var(--desk-row-hover);
+  color: var(--desk-fg-1);
+}
+
+.desk-chip-label {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.desk-chip-caret {
+  flex: none;
+  opacity: 0.7;
+}
+
+.desk-section-label {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 24px;
+  padding: 0 8px;
+  color: var(--desk-accent);
+  font-size: var(--desk-text-micro);
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+
+.desk-section-label h2,
+.desk-section-label-text {
+  margin: 0;
+  font: inherit;
+  flex: 1;
+}
+
+.desk-section-label-actions {
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  color: var(--desk-fg-3);
+  letter-spacing: 0;
+  text-transform: none;
+}
+
+.desk-group-glyph {
+  width: 9px;
+  height: 9px;
+  flex: none;
+  fill: currentColor;
+}
+
+/* -- wordmark and empty states -------------------------------------------------------------- */
+
+.desk-wordmark-block {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 18px;
+  width: 100%;
+}
+
+.desk-wordmark {
+  margin: 0;
+  color: var(--desk-wordmark);
+  font-family: var(--desk-font-display);
+  font-weight: 400;
+  font-size: clamp(56px, 11.1vw, 180px);
+  line-height: 0.9;
+  letter-spacing: 0.005em;
+  white-space: nowrap;
+  transform: scaleX(0.85);
+  user-select: none;
+}
+
+.desk-wordmark-caption {
+  max-width: 560px;
+  margin: 0;
+  color: var(--desk-fg-3);
+  font-size: 14px;
+  line-height: 20px;
+  text-align: center;
+}
+
+.desk-empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6px;
+  padding: 24px 12px;
+  color: var(--desk-fg-3);
+  text-align: center;
+}
+
+.desk-empty-icon {
+  color: var(--desk-fg-4);
+}
+
+.desk-empty-title {
+  margin: 0;
+  font-size: var(--desk-text-ui);
+}
+
+/* -- menus ---------------------------------------------------------------------------------- */
+
+.desk-menu-root {
+  position: relative;
+  display: inline-flex;
+}
+
+.desk-menu {
+  position: absolute;
+  z-index: var(--z-overlay);
+  min-width: 200px;
+  max-width: 320px;
+  padding: 4px;
+  border: 1px solid var(--desk-stroke-1);
+  border-radius: var(--desk-radius-card);
+  background: var(--desk-bg-raised);
+  box-shadow: var(--desk-shadow-menu);
+  color: var(--desk-fg-1);
+}
+
+.desk-menu[data-side="down"] {
+  top: calc(100% + 4px);
+}
+
+.desk-menu[data-side="up"] {
+  bottom: calc(100% + 4px);
+}
+
+.desk-menu[data-align="start"] {
+  left: 0;
+}
+
+.desk-menu[data-align="end"] {
+  right: 0;
+}
+
+.desk-menu-item {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  padding: 5px 8px;
+  border: 0;
+  border-radius: var(--desk-radius-control);
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+  text-align: left;
+  cursor: pointer;
+}
+
+.desk-menu-item > svg {
+  width: 14px;
+  height: 14px;
+  color: var(--desk-fg-3);
+  flex: none;
+}
+
+.desk-menu-item:hover,
+.desk-menu-item:focus-visible {
+  outline: none;
+  background: var(--desk-row-hover);
+}
+
+.desk-menu-item-label {
+  flex: 1;
+}
+
+.desk-menu-hint {
+  color: var(--desk-fg-4);
+  font-size: var(--desk-text-small);
+}
+
+.desk-menu-footer {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-top: 4px;
+  padding: 6px 8px 2px;
+  border-top: 1px solid var(--desk-stroke-1);
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-small);
+}
+
+/* -- form controls -------------------------------------------------------------------------- */
+
+.desk-input,
+.desk-select {
+  min-height: var(--desk-control-height);
+  padding: 4px 10px;
+  border: 1px solid var(--desk-stroke-1);
+  border-radius: var(--desk-radius-control);
+  background: var(--desk-bg-canvas);
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+}
+
+.desk-input::placeholder {
+  color: var(--desk-fg-4);
+}
+
+.desk-input:focus-visible,
+.desk-select:focus-visible {
+  outline: none;
+  border-color: var(--desk-accent);
+}
+
+.desk-search {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 0 10px;
+  color: var(--desk-fg-4);
+}
+
+.desk-search input {
+  flex: 1;
+  min-width: 0;
+  padding: 4px 0;
+  border: 0;
+  border-bottom: 1px solid transparent;
+  background: transparent;
+  color: var(--desk-fg-1);
+  font: inherit;
+  font-size: var(--desk-text-ui);
+}
+
+.desk-search input::placeholder {
+  color: var(--desk-fg-4);
+}
+
+.desk-search input:focus-visible {
+  outline: none;
+  border-bottom-color: var(--desk-stroke-3);
+}
+
+/* one clear button: ours, never the engine's search cancel glyph */
+.desk-search input::-webkit-search-cancel-button,
+input[type="search"]::-webkit-search-cancel-button {
+  -webkit-appearance: none;
+  appearance: none;
+  display: none;
+}
+
+/* -- tabs (uppercase strip under the band) -------------------------------------------------- */
+
+.desk-tabs {
+  display: flex;
+  align-items: stretch;
+  gap: 0;
+  min-height: 26px;
+}
+
+.desk-tab {
+  position: relative;
+  padding: 4px 8px;
+  border: 0;
+  background: transparent;
+  color: var(--desk-fg-3);
+  font: inherit;
+  font-size: var(--desk-text-micro);
+  font-weight: 500;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  cursor: pointer;
+}
+
+.desk-tab:hover {
+  color: var(--desk-fg-1);
+}
+
+.desk-tab[aria-current="page"],
+.desk-tab[aria-selected="true"] {
+  color: var(--desk-fg-1);
+}
+
+.desk-tab[aria-current="page"]::after,
+.desk-tab[aria-selected="true"]::after {
+  content: "";
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  height: 2px;
+  background: var(--desk-accent);
+}
+
+/* -- breadcrumbs ---------------------------------------------------------------------------- */
+
+.desk-breadcrumb {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  color: var(--desk-fg-3);
+  font-size: var(--desk-text-ui);
+}
+
+.desk-breadcrumb [aria-current="page"] {
+  color: var(--desk-fg-1);
+}
+
+.desk-breadcrumb svg {
+  width: 12px;
+  height: 12px;
+  color: var(--desk-fg-4);
+}
