@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import type { CronBlueprintField } from "../../lib/restTypes.ts";
+import {
+  fillTemplate,
+  missingSlots,
+  openPlaceholders,
+  planSlots,
+  startValues,
+} from "./blueprintSlots.ts";
+
+function slot(field: Partial<CronBlueprintField> & Pick<CronBlueprintField, "name" | "kind">) {
+  return { label: field.name, default: null, optional: false, help: "", ...field };
+}
+
+const time = slot({ name: "time", kind: "time", default: "16:30" });
+const style = slot({ name: "style", kind: "choice", default: "brief", options: ["brief", "full"] });
+const target = slot({ name: "target", kind: "text", label: "What to check", max: 200 });
+const extra = slot({ name: "extra", kind: "text", optional: true });
+
+describe("blueprint prompt slots", () => {
+  it("places a defaulted slot where its default appears once, and keeps timing slots out", () => {
+    const plan = planSlots({ prompt: "Review the week. Style: brief.", fields: [time, style] });
+    expect(plan.template).toBe("Review the week. Style: {style}.");
+    expect(plan.slots.map((f) => f.name)).toEqual(["style"]);
+    expect(fillTemplate(plan.template, plan.slots, { style: "full" })).toBe(
+      "Review the week. Style: full.",
+    );
+  });
+
+  it("uses a slot left as {name} by the server as its place", () => {
+    const plan = planSlots({ prompt: "Check {target}. Report changes.", fields: [target] });
+    expect(plan.template).toBe("Check {target}. Report changes.");
+    const values = startValues(plan.slots);
+    expect(values).toEqual({ target: "" });
+    expect(missingSlots(plan.slots, values)).toEqual(["What to check"]);
+    expect(fillTemplate(plan.template, plan.slots, values)).toBe("Check {target}. Report changes.");
+    expect(fillTemplate(plan.template, plan.slots, { target: " the build page " })).toBe(
+      "Check the build page. Report changes.",
+    );
+  });
+
+  it("gives no input to a slot whose place is ambiguous or gone", () => {
+    // "brief" twice: which one is the slot cannot be told.
+    expect(planSlots({ prompt: "A brief note. Style: brief.", fields: [style] }).slots).toEqual([]);
+    // An optional slot with no default was filled with nothing: no trace left in the prompt.
+    expect(planSlots({ prompt: "Wrap up my day.", fields: [extra] }).slots).toEqual([]);
+    expect(planSlots({ prompt: null, fields: [style] })).toEqual({ template: "", slots: [] });
+  });
+
+  it("drops an optional slot left empty and never re-reads a value as a placeholder", () => {
+    const plan = planSlots({ prompt: "Wrap up. {extra}", fields: [extra] });
+    expect(fillTemplate(plan.template, plan.slots, { extra: "" })).toBe("Wrap up.");
+    expect(fillTemplate(plan.template, plan.slots, { extra: "{extra} stays" })).toBe(
+      "Wrap up. {extra} stays",
+    );
+    expect(missingSlots(plan.slots, { extra: "" })).toEqual([]);
+  });
+
+  it("starts a choice without a default on its first option", () => {
+    const pick = slot({ name: "pick", kind: "choice", options: ["a", "b"] });
+    expect(startValues([pick])).toEqual({ pick: "a" });
+  });
+
+  it("names the slots still written as {name} in a prompt", () => {
+    expect(openPlaceholders("Check {target} and {other}.", [target, style])).toEqual(["target"]);
+  });
+});
diff --git a/apps/web/src/pages/cron/blueprintSlots.ts b/apps/web/src/pages/cron/blueprintSlots.ts
new file mode 100644
index 0000000..e068c75
--- /dev/null
+++ b/apps/web/src/pages/cron/blueprintSlots.ts
@@ -0,0 +1,97 @@
+// A blueprint's prompt slots as form inputs (W56-G2-3). `GET /api/cron/blueprints` sends each
+// blueprint's prompt already filled from its slot defaults, with a slot that has no default left as
+// `{name}`, plus the slots themselves (`fields`). The form turns that back into a template it can
+// fill again: a `{name}` still in the prompt is the slot's place, and a defaulted slot's place is
+// where its default appears, when it appears exactly once. A slot whose place cannot be found that
+// way gets no input; the person edits the prompt text instead.
+//
+// Only `text` and `choice` slots become inputs here: `time`, `weekdays` and `interval` slots set
+// the schedule, which the schedule picker already edits.
+
+import type { CronBlueprint, CronBlueprintField } from "../../lib/restTypes.ts";
+
+export interface SlotPlan {
+  /** The prompt with `{name}` at each placed slot. */
+  template: string;
+  /** The slots that got an input, in the blueprint's order. */
+  slots: CronBlueprintField[];
+}
+
+const PROMPT_KINDS: ReadonlySet<CronBlueprintField["kind"]> = new Set(["text", "choice"]);
+
+function occurrences(text: string, part: string): number[] {
+  const found: number[] = [];
+  if (!part) return found;
+  for (let at = text.indexOf(part); at !== -1; at = text.indexOf(part, at + 1)) found.push(at);
+  return found;
+}
+
+export function planSlots(blueprint: Pick<CronBlueprint, "prompt" | "fields">): SlotPlan {
+  const prompt = blueprint.prompt ?? "";
+  const spans: { start: number; end: number; field: CronBlueprintField }[] = [];
+  const placed = new Set<string>();
+  for (const field of blueprint.fields) {
+    if (!PROMPT_KINDS.has(field.kind)) continue;
+    const token = `{${field.name}}`;
+    const open = occurrences(prompt, token);
+    const fromDefault =
+      open.length === 0 && field.default ? occurrences(prompt, field.default) : [];
+    const hits = open.length > 0 ? open : fromDefault.length === 1 ? fromDefault : [];
+    const length = open.length > 0 ? token.length : (field.default ?? "").length;
+    const fresh = hits
+      .map((start) => ({ start, end: start + length, field }))
+      .filter((span) => !spans.some((s) => span.start < s.end && s.start < span.end));
+    if (fresh.length === 0 || fresh.length !== hits.length) continue;
+    spans.push(...fresh);
+    placed.add(field.name);
+  }
+  spans.sort((a, b) => a.start - b.start);
+  let template = "";
+  let at = 0;
+  for (const span of spans) {
+    template += `${prompt.slice(at, span.start)}{${span.field.name}}`;
+    at = span.end;
+  }
+  template += prompt.slice(at);
+  return { template, slots: blueprint.fields.filter((f) => placed.has(f.name)) };
+}
+
+/** Each slot's starting value: its default, else empty (a choice falls back to its first option). */
+export function startValues(slots: readonly CronBlueprintField[]): Record<string, string> {
+  return Object.fromEntries(
+    slots.map((f) => [f.name, f.default ?? (f.kind === "choice" ? (f.options?.[0] ?? "") : "")]),
+  );
+}
+
+/**
+ * The prompt with the slots' values in place. An optional slot left empty drops out; a required one
+ * left empty stays `{name}` (`missingSlots` names it). Names that are not slots stay as written.
+ */
+export function fillTemplate(
+  template: string,
+  slots: readonly CronBlueprintField[],
+  values: Readonly<Record<string, string>>,
+): string {
+  const byName = new Map(slots.map((f) => [f.name, f]));
+  return template
+    .replace(/\{([^{}\s]+)\}/g, (token, name: string) => {
+      const field = byName.get(name);
+      if (!field) return token;
+      const value = (values[name] ?? "").trim();
+      return value || (field.optional ? "" : token);
+    })
+    .trim();
+}
+
+/** Labels of the required slots still empty. */
+export function missingSlots(
+  slots: readonly CronBlueprintField[],
+  values: Readonly<Record<string, string>>,
+): string[] {
+  return slots.filter((f) => !f.optional && !(values[f.name] ?? "").trim()).map((f) => f.label);
+}
+
+/** Slot names of `fields` still written as `{name}` in a prompt (any kind). */
+export function openPlaceholders(prompt: string, fields: readonly CronBlueprintField[]): string[] {
+  return fields.filter((f) => prompt.includes(`{${f.name}}`)).map((f) => f.name);
+}
