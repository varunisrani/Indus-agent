+def _route(token: str | None = None) -> RuntimeRoute:
+    return RuntimeRoute(
+        provider=PROFILE.name,
+        model="gpt-5.5",
+        api_mode=PROFILE.api_mode,
+        base_url=BASE,
+        api_key=Secret(token or fake.fake_jwt()),
+        headers={"User-Agent": USER_AGENT, **PROFILE.default_headers},
+        profile=PROFILE,
+    )
