+# path. Our listener still binds 127.0.0.1 only; ``localhost`` is just the string in the URI.
+CALLBACK_HOST: Final = "localhost"
+CALLBACK_PORT: Final = 1455
+CALLBACK_PATH: Final = "/auth/callback"
