+                    if isinstance(row, dict) and cast(dict[str, Any], row).get("id") == entry_id:
+                        cast(dict[str, Any], row)["expires_at"] = expires
+    except Exception as exc:
+        log.debug("could not note the renewed %s sign-in's expiry: %s", provider, exc)
