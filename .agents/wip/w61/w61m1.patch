+    expires = tokens.expires_at.isoformat() if tokens.expires_at else None
+    try:
+        with AuthStore(home).transaction() as doc:
+            rows = cast(dict[str, Any], doc.get("pool") or {}).get(provider)
+            if isinstance(rows, list):
