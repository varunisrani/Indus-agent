index 0000000..2fa59d6
--- /dev/null
+++ b/apps/desktop/electron/passwordManagers.test.ts
@@ -0,0 +1,95 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import { detectManagers, findProgram, installPasswordManagersIpc } from "./passwordManagers.ts";
+
+const dirs: string[] = [];
+afterAll(() => {
+  for (const dir of dirs) fs.rmSync(dir, { recursive: true, force: true });
+});
+
+function folder(): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "indus-pm-detect-"));
+  dirs.push(dir);
+  return dir;
+}
+
+function program(dir: string, name: string, mode: number): void {
+  fs.writeFileSync(path.join(dir, name), "#!/bin/sh\n");
+  fs.chmodSync(path.join(dir, name), mode);
+}
+
+describe("password manager detection (W54-D2-1)", () => {
+  it("nothing installed: both managers read as not there", () => {
+    const empty = folder();
+    expect(detectManagers({ env: { PATH: empty }, platform: "linux" }, false)).toEqual({
+      checked: true,
+      onepassword: false,
+      bitwarden: false,
+    });
+  });
+
+  it("finds an executable on any PATH folder; a non-executable file does not count", () => {
+    const first = folder();
+    const second = folder();
+    program(first, "bw", 0o644);
+    program(second, "op", 0o755);
+    const lookup = { env: { PATH: `${first}:${second}` }, platform: "linux" };
+    expect(findProgram("op", lookup)).toBe(path.join(second, "op"));
+    expect(findProgram("bw", lookup)).toBeNull();
+    expect(detectManagers(lookup, false)).toEqual({
+      checked: true,
+      onepassword: true,
+      bitwarden: false,
+    });
+  });
+
+  it("Windows tries the PATHEXT extensions", () => {
+    const seen: string[] = [];
+    const found = findProgram("bw", {
+      env: { Path: "C:\\tools;D:\\bin", PATHEXT: ".EXE;.CMD" },
+      platform: "win32",
+      isExecutable: (file) => {
+        seen.push(file);
+        return file === "D:\\bin\\bw.CMD";
+      },
+    });
+    expect(found).toBe("D:\\bin\\bw.CMD");
+    expect(seen).toEqual([
+      "C:\\tools\\bw.EXE",
+      "C:\\tools\\bw.CMD",
+      "D:\\bin\\bw.EXE",
+      "D:\\bin\\bw.CMD",
+    ]);
+  });
+
+  it("a remote backend: nothing is looked up here", () => {
+    const dir = folder();
+    program(dir, "op", 0o755);
+    expect(detectManagers({ env: { PATH: dir }, platform: "linux" }, true)).toEqual({
+      checked: false,
+      onepassword: false,
+      bitwarden: false,
+    });
+  });
+
+  it("the bridge channel answers from the current lookup and connection", async () => {
+    const handlers = new Map<string, () => unknown>();
+    const registry = { handle: (name: string, fn: () => unknown) => handlers.set(name, fn) };
+    const dir = folder();
+    program(dir, "bw", 0o755);
+    let remote = false;
+    installPasswordManagersIpc(registry as never, {
+      lookup: () => ({ env: { PATH: dir }, platform: "linux" }),
+      remote: () => remote,
+    });
+    expect(await handlers.get("indus:vault:detect")?.()).toEqual({
+      checked: true,
+      onepassword: false,
+      bitwarden: true,
+    });
+    remote = true;
+    expect(await handlers.get("indus:vault:detect")?.()).toMatchObject({ checked: false });
+  });
+});
diff --git a/apps/desktop/electron/passwordManagers.ts b/apps/desktop/electron/passwordManagers.ts
new file mode 100644
index 0000000..16c501e
--- /dev/null
+++ b/apps/desktop/electron/passwordManagers.ts
@@ -0,0 +1,72 @@
+// Settings › Passwords & Logins › Password managers (W54-D2): which manager command-line tools
+// this computer has. The agent's vault tool finds 1Password's `op` and Bitwarden's `bw` on the
+// backend's PATH; a local backend inherits main's PATH (merged with the login shell's at ready,
+// `shellPath.ts`), so main looks the same programs up on that PATH. Nothing is run: a program
+// counts when an executable file of that name sits in a PATH folder (Windows: with one of the
+// PATHEXT extensions). With a remote backend the tools that matter live on the other machine, so
+// nothing is looked up and the answer says so (`checked: false`).
+
+import fs from "node:fs";
+import path from "node:path";
+import type { IpcRegistry } from "./ipc/registry.ts";
+
+/** The program each manager's command-line tool installs. */
+export const MANAGER_PROGRAMS = { onepassword: "op", bitwarden: "bw" } as const;
+
+export interface ProgramLookup {
+  env: Readonly<Record<string, string | undefined>>;
+  platform: NodeJS.Platform | string;
+  /** True when `file` is an executable regular file (injected in tests). */
+  isExecutable?: (file: string) => boolean;
+}
+
+function executableFile(file: string): boolean {
+  try {
+    if (!fs.statSync(file).isFile()) return false;
+    fs.accessSync(file, fs.constants.X_OK);
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** The first executable named `program` on the PATH, or null. */
+export function findProgram(program: string, lookup: ProgramLookup): string | null {
+  const windows = lookup.platform === "win32";
+  const pathText = lookup.env.PATH ?? lookup.env.Path ?? "";
+  const folders = pathText.split(windows ? ";" : ":").filter((dir) => dir.trim() !== "");
+  const extensions = windows
+    ? (lookup.env.PATHEXT ?? ".COM;.EXE;.BAT;.CMD").split(";").filter((ext) => ext !== "")
+    : [""];
+  const check = lookup.isExecutable ?? executableFile;
+  const join = windows ? path.win32.join : path.posix.join;
+  for (const dir of folders) {
+    for (const ext of extensions) {
+      const file = join(dir, `${program}${ext}`);
+      if (check(file)) return file;
+    }
+  }
+  return null;
+}
+
+export interface ManagerDetection {
+  checked: boolean;
+  onepassword: boolean;
+  bitwarden: boolean;
+}
+
+export function detectManagers(lookup: ProgramLookup, remote: boolean): ManagerDetection {
+  if (remote) return { checked: false, onepassword: false, bitwarden: false };
+  return {
+    checked: true,
+    onepassword: findProgram(MANAGER_PROGRAMS.onepassword, lookup) !== null,
+    bitwarden: findProgram(MANAGER_PROGRAMS.bitwarden, lookup) !== null,
+  };
+}
+
+export function installPasswordManagersIpc(
+  registry: IpcRegistry,
+  deps: { lookup: () => ProgramLookup; remote: () => boolean },
+): void {
+  registry.handle("indus:vault:detect", () => detectManagers(deps.lookup(), deps.remote()));
+}
