+    const text = first?.kind === "user" ? first.text.trim().split("\n")[0]?.trim() : "";
+    return text === undefined || text === "" ? null : text;
+  }, [store, sessionId]);
+  return useSyncExternalStore(subscribe, read, read);
+}
