new file mode 100644
index 0000000..24acb85
--- /dev/null
+++ b/src/indus/mcp/reload.py
@@ -0,0 +1,384 @@
+"""Reload, config watch and ``notifications/tools/list_changed`` (P13-08).
+
+- ``reconcile(host)``: compare the configured servers with the running ones. Added → started;
+  removed or disabled → closed, tools and alias deregistered; changed (any setting of the entry)
+  → closed and started again; unchanged → kept (a parked one is nudged unless it is parked on
+  refused credentials, P13-07). Bounded by 30 s; servers still connecting then go on in the
+  background and register themselves when they come up.
+- ``reload_mcp(host, ask=…)`` is ``/reload-mcp``: read the config again, ask first while
+  ``approvals.mcp_reload_confirm`` is on (once / always — which writes the switch off — / cancel),
+  reconcile. The running session keeps its stored tool array and system prompt (R01.1, R07.23);
+  the host's listeners get ``ToolSurfaceChanged`` so the provider prompt cache is dropped and the
+  array is rebuilt for the next session or compression. ``reload(scope)`` is the TUI bridge entry
+  (the client's request is the confirmation).
+- ``ConfigWatcher`` (CLI; on unless ``mcp.auto_reload_on_config_change`` is off) polls the config
+  file's signature, waits for it to settle (debounce), and reconciles when ``mcp_servers``
+  actually changed. The gateway (P15) calls ``reconcile`` itself.
+- ``ListChangedRefresher``: the first ``tools/list_changed`` of a server opens a 2 s window that
+  folds every further one in, then one re-fetch runs (one at a time per server); notifications
+  that arrive during a re-fetch cause exactly one more. Prompt and resource change notifications
+  are received and ignored (``discovery.ServerHandle``).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+import copy
+import logging
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Literal
+
+from indus.foundation.blocking import run_blocking
+from indus.foundation.config import loader, writer
+from indus.foundation.scope import Scope
+from indus.mcp.config import ServerTable, load_servers, load_settings
+from indus.mcp.connect import clock_timeout
+from indus.mcp.discovery import DiscoveryReport, McpHost, host_for
+from indus.safety.approvals.decision import setting
+
+if TYPE_CHECKING:
+    from indus.mcp.discovery import ServerHandle
+
+__all__ = [
+    "COALESCE_S",
+    "CONFIRM_KEY",
+    "RECONCILE_TIMEOUT_S",
+    "WATCH_DEBOUNCE_S",
+    "WATCH_INTERVAL_S",
+    "ConfigWatcher",
+    "ListChangedRefresher",
+    "ReconcileReport",
+    "ReloadChoice",
+    "ReloadOutcome",
+    "ToolSurfaceChanged",
+    "fresh_scope",
+    "reconcile",
+    "reload",
+    "reload_mcp",
+]
+
+log = logging.getLogger(__name__)
+
+COALESCE_S = 2.0
+RECONCILE_TIMEOUT_S = 30.0
+WATCH_INTERVAL_S = 2.0
+WATCH_DEBOUNCE_S = 1.0
+CONFIRM_KEY = "approvals.mcp_reload_confirm"
+
+ReloadChoice = Literal["once", "always", "cancel"]
+Ask = Callable[[str], Awaitable[ReloadChoice]]
+
+
+@dataclass(frozen=True)
+class ToolSurfaceChanged:
+    """The MCP tools of a profile changed: drop the provider prompt cache; rebuild the stored
+    tool array for the next session or compression (never mid-session)."""
+
+    profile: str
+    reason: str
+    generation: int
+    added: tuple[str, ...] = ()
+    removed: tuple[str, ...] = ()
+
+
+@dataclass
+class ReconcileReport:
+    added: list[str] = field(default_factory=list[str])
+    removed: list[str] = field(default_factory=list[str])
+    restarted: list[str] = field(default_factory=list[str])
+    kept: list[str] = field(default_factory=list[str])
+    discovery: DiscoveryReport | None = None
+    timed_out: bool = False
+
+    @property
+    def changed(self) -> bool:
+        return bool(self.added or self.removed or self.restarted)
+
+    def summary(self) -> str:
+        parts = [
+            f"{label}: {', '.join(sorted(names))}"
+            for label, names in (
+                ("added", self.added),
+                ("removed", self.removed),
+                ("restarted", self.restarted),
+            )
+            if names
+        ]
+        text = "; ".join(parts) if parts else "no server changes"
+        if self.discovery is not None:
+            text += f". {self.discovery.summary()}"
+        if self.timed_out:
+            text += f". Still connecting after {RECONCILE_TIMEOUT_S:g} s (in the background)."
+        return text
+
+
+@dataclass(frozen=True)
+class ReloadOutcome:
+    reloaded: bool
+    message: str
+    report: ReconcileReport | None = None
+
+
+# -- reconcile ----------------------------------------------------------------------------------
+
+
+def _same(a: Any, b: Any) -> bool:
+    return a.model_dump(mode="json") == b.model_dump(mode="json")
+
+
+def fresh_scope(scope: Scope) -> Scope:
+    """``scope`` with its config read again from disk (an unreadable file keeps the old view)."""
+    try:
+        view = loader.load(scope)
+    except Exception as exc:
+        log.warning("could not read the config again (%s); keeping the loaded one", exc)
+        return scope
+    if view.failed:
+        log.warning("the config file could not be read; MCP servers left as they are")
+        return scope
+    return scope.with_config(view)
+
+
+async def reconcile(
+    host: McpHost,
+    table: ServerTable | None = None,
+    *,
+    scope: Scope | None = None,
+    reason: str = "reload",
+    timeout: float = RECONCILE_TIMEOUT_S,
+) -> ReconcileReport:
+    """Bring the running servers in line with ``table`` (default: the host scope's config)."""
+    if scope is not None:
+        host.scope = scope
+    table = table if table is not None else load_servers(host.scope)
+    before = {name: set(h.specs) for name, h in host.handles.items()}
+    generation = host.registry.generation
+    wanted = {name: cfg for name, cfg in table.servers.items() if cfg.enabled}
+    report = ReconcileReport()
+    for name in list(host.handles):
+        current = host.handles[name]
+        if name not in wanted:
+            await host.remove(name)
+            report.removed.append(name)
+        elif not _same(current.config, wanted[name]):
+            await host.remove(name)
+            report.restarted.append(name)
+        else:
+            report.kept.append(name)
+    report.added = [n for n in wanted if n not in before]
+    try:
+        async with clock_timeout(host.clock, timeout):
+            report.discovery = await host.discover(table)
+    except TimeoutError:
+        report.timed_out = True
+        log.warning("MCP reconcile: servers still connecting after %.0f s", timeout)
+    after = {name for h in host.handles.values() for name in h.specs}
+    old = {name for names in before.values() for name in names}
+    if host.registry.generation != generation or report.changed:
+        host.emit(
+            ToolSurfaceChanged(
+                host.profile,
+                reason,
+                host.registry.generation,
+                tuple(sorted(after - old)),
+                tuple(sorted(old - after)),
+            )
+        )
+    log.info("MCP reconcile (%s): %s", reason, report.summary())
+    return report
+
+
+# -- /reload-mcp --------------------------------------------------------------------------------
+
+_QUESTION = (
+    "Reload the MCP servers? Their tools change, so the provider's prompt cache starts over; "
+    "this session keeps its current tools until the next session or compression."
+)
+
+
+def confirm_on(scope: Scope) -> bool:
+    raw = setting(scope, CONFIRM_KEY)
+    if isinstance(raw, str):
+        return raw.strip().lower() not in ("false", "no", "off", "0")
+    return bool(raw) if raw is not None else True
+
+
+async def reload_mcp(host: McpHost, *, ask: Ask | None = None) -> ReloadOutcome:
+    """``/reload-mcp``. ``ask`` is the confirmation prompt; None means the request itself is the
+    confirmation (the TUI bridge, the API)."""
+    scope = fresh_scope(host.scope)
+    if ask is not None and confirm_on(scope):
+        choice = await ask(_QUESTION)
+        if choice == "cancel":
+            return ReloadOutcome(False, "MCP reload cancelled; nothing changed.")
+        if choice == "always":
+            try:
+                await run_blocking(
+                    writer.save,
+                    scope,
+                    {"approvals": {"mcp_reload_confirm": False}},
+                    pool="io",
+                    label="mcp reload confirm",
+                )
+            except Exception as exc:
+                log.warning("could not save %s: false (%s)", CONFIRM_KEY, exc)
+    report = await reconcile(host, scope=scope, reason="reload")
+    return ReloadOutcome(True, f"MCP servers reloaded: {report.summary()}", report)
+
+
+async def reload(scope: Scope) -> ReloadOutcome:
+    """The bridge's ``reload.mcp``: reload the profile's servers without asking."""
+    host = host_for(scope)
+    if host is None:
+        return ReloadOutcome(False, "No MCP servers are running for this profile.")
+    return await reload_mcp(host)
+
+
+# -- the config watcher -------------------------------------------------------------------------
+
+
+def _signature(scope: Scope) -> tuple[int, int] | None:
+    try:
+        info = loader.config_path(scope).stat()
+    except OSError:
+        return None
+    return (info.st_mtime_ns, info.st_size)
+
+
+def _servers_raw(scope: Scope) -> Any:
+    config = scope.config
+    raw = config.get("mcp_servers") if config is not None else None
+    return copy.deepcopy(dict(raw)) if isinstance(raw, Mapping) else raw
+
+
+class ConfigWatcher:
+    """Reconciles ``host`` when ``mcp_servers`` changes on disk (see the module notes)."""
+
+    def __init__(
+        self,
+        host: McpHost,
+        *,
+        interval: float = WATCH_INTERVAL_S,
+        debounce: float = WATCH_DEBOUNCE_S,
+        timeout: float = RECONCILE_TIMEOUT_S,
+    ) -> None:
+        self.host = host
+        self.interval = interval
+        self.debounce = debounce
+        self.timeout = timeout
+        self.checks = 0
+        self.runs = 0
+        self._task: asyncio.Task[None] | None = None
+        self._signature = _signature(host.scope)
+        self._servers = _servers_raw(host.scope)
+
+    def start(self) -> None:
+        if self._task is None:
+            self._task = asyncio.ensure_future(self._run())
+
+    async def close(self) -> None:
+        task, self._task = self._task, None
+        if task is not None:
+            task.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await task
+
+    async def _run(self) -> None:
+        clock = self.host.clock
+        while True:
+            await clock.sleep(self.interval)
+            seen = await run_blocking(_signature, self.host.scope, pool="io", label="mcp watch")
+            if seen == self._signature:
+                continue
+            while True:  # wait for the writer to finish
+                await clock.sleep(self.debounce)
+                again = await run_blocking(
+                    _signature, self.host.scope, pool="io", label="mcp watch"
+                )
+                if again == seen:
+                    break
+                seen = again
+            self._signature = seen
+            try:
+                await self.check()
+            except Exception:
+                log.exception("MCP config watch: reconcile failed")
+
+    async def check(self) -> ReconcileReport | None:
+        """Reconcile when ``mcp_servers`` differs from the last state seen and auto reload is on."""
+        self.checks += 1
+        scope = await run_blocking(fresh_scope, self.host.scope, pool="io", label="mcp watch")
+        servers = _servers_raw(scope)
+        if servers == self._servers:
+            return None
+        if not load_settings(scope).auto_reload_on_config_change:
+            log.info("mcp_servers changed on disk; auto reload is off (use /reload-mcp)")
+            self._servers = servers
+            return None
+        self._servers = servers
+        self.runs += 1
+        log.info("mcp_servers changed on disk; reconciling")
+        return await reconcile(self.host, scope=scope, reason="config_change", timeout=self.timeout)
+
+
+# -- tools/list_changed -------------------------------------------------------------------------
+
+
+class ListChangedRefresher:
+    """Coalesces one server's ``tools/list_changed`` storms into few re-fetches."""
+
+    def __init__(self, handle: ServerHandle, *, window: float = COALESCE_S) -> None:
+        self.handle = handle
+        self.window = window
+        self.fetches = 0
+        self._phase: Literal["idle", "waiting", "fetching"] = "idle"
+        self._again = False
+        self._task: asyncio.Task[None] | None = None
+
+    def poke(self) -> None:
+        if self._phase == "idle":
+            self._phase = "waiting"
+            self._task = asyncio.ensure_future(self._run())
+        elif self._phase == "fetching":
+            self._again = True
+        # waiting: folded into the coming re-fetch
+
+    async def _run(self) -> None:
+        handle = self.handle
+        try:
+            while True:
+                self._phase = "waiting"
+                await handle.clock.sleep(self.window)
+                self._phase = "fetching"
+                self._again = False
+                generation = handle.host.registry.generation
+                before = set(handle.specs)
+                try:
+                    await handle.refetch()
+                except Exception as exc:
+                    log.warning("MCP server %r: tool re-fetch failed: %s", handle.name, exc)
+                self.fetches += 1
+                if handle.host.registry.generation != generation:
+                    after = set(handle.specs)
+                    handle.host.emit(
+                        ToolSurfaceChanged(
+                            handle.host.profile,
+                            "list_changed",
+                            handle.host.registry.generation,
+                            tuple(sorted(after - before)),
+                            tuple(sorted(before - after)),
+                        )
+                    )
+                if not self._again or handle.closed:
+                    return
+        finally:
+            self._phase = "idle"
+
+    async def close(self) -> None:
+        task, self._task = self._task, None
+        if task is not None and not task.done():
+            task.cancel()
+            with contextlib.suppress(asyncio.CancelledError):
+                await task
diff --git a/src/indus/mcp/schema_cache.py b/src/indus/mcp/schema_cache.py
new file mode 100644
index 0000000..0ae7358
--- /dev/null
+++ b/src/indus/mcp/schema_cache.py
@@ -0,0 +1,156 @@
+# pyright: strict
+"""The per-server tool schema cache that lets a ``lazy`` server register without starting (P13-05).
+
+``<home>/cache/mcp/<server>.json`` holds ``{version, fingerprint, written_at, tools, utilities}``:
+each tool as the server listed it (``name``, ``description``, ``inputSchema``) plus its raw
+``readOnlyHint``, and the utility tool kinds that were offered. It is written after every live
+listing. An entry counts only for the same fingerprint (the connection-defining settings): an
+edited server connects eagerly once and rewrites it. The file is 0600 (it feeds registration).
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import re
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation.fsio import atomic_write_json
+from indus.mcp.config import McpServer
+
+__all__ = ["CACHE_VERSION", "CachedTool", "SchemaCache", "SchemaEntry", "fingerprint"]
+
+log = logging.getLogger(__name__)
+
+CACHE_VERSION = 1
+_UNSAFE = re.compile(r"[^A-Za-z0-9_.-]")
+
+
+def fingerprint(server: McpServer) -> str:
+    """A short hash of what decides which server we talk to and which tools register."""
+    payload = {
+        "command": server.command,
+        "args": list(server.args),
+        "url": server.url,
+        "transport": server.transport,
+        "include": sorted(server.tools.include) if server.tools.include is not None else None,
+        "exclude": sorted(server.tools.exclude or []),
+        "resources": server.tools.resources,
+        "prompts": server.tools.prompts,
+    }
+    text = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:16]
+
+
+@dataclass(frozen=True)
+class CachedTool:
+    name: str
+    description: str | None
+    input_schema: Mapping[str, Any]
+    raw_read_only: object = None
+
+    def as_json(self) -> dict[str, Any]:
+        return {
+            "name": self.name,
+            "description": self.description,
+            "inputSchema": dict(self.input_schema),
+            "readOnlyHint": self.raw_read_only,
+        }
+
+
+@dataclass(frozen=True)
+class SchemaEntry:
+    fingerprint: str
+    tools: tuple[CachedTool, ...]
+    utilities: tuple[str, ...]
+    written_at: float = 0.0
+
+
+def _tool_of(raw: object) -> CachedTool | None:
+    if not isinstance(raw, Mapping):
+        return None
+    data = cast(Mapping[str, Any], raw)
+    name = data.get("name")
+    schema = data.get("inputSchema")
+    if not isinstance(name, str) or not name:
+        return None
+    description = data.get("description")
+    return CachedTool(
+        name=name,
+        description=description if isinstance(description, str) else None,
+        input_schema=cast(Mapping[str, Any], schema) if isinstance(schema, Mapping) else {},
+        raw_read_only=data.get("readOnlyHint"),
+    )
+
+
+class SchemaCache:
+    """Reads and writes the cache files of one home."""
+
+    def __init__(self, home: Path) -> None:
+        self.folder = home / "cache" / "mcp"
+
+    def path(self, server: str) -> Path:
+        return self.folder / f"{_UNSAFE.sub('_', server) or '_'}.json"
+
+    def read(self, server: str, want: str) -> SchemaEntry | None:
+        """The entry for ``server`` when its fingerprint is ``want``; None otherwise."""
+        path = self.path(server)
+        try:
+            data: object = json.loads(path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return None
+        except (OSError, ValueError) as exc:
+            log.debug("MCP schema cache %s unreadable: %s", path, exc)
+            return None
+        if not isinstance(data, Mapping):
+            return None
+        body = cast(Mapping[str, Any], data)
+        if body.get("version") != CACHE_VERSION or body.get("fingerprint") != want:
+            return None
+        listed = body.get("tools")
+        if not isinstance(listed, list):
+            return None
+        tools = tuple(t for t in map(_tool_of, cast(list[object], listed)) if t is not None)
+        utilities = body.get("utilities")
+        kinds = (
+            tuple(u for u in cast(list[object], utilities) if isinstance(u, str))
+            if isinstance(utilities, list)
+            else ()
+        )
+        written = body.get("written_at")
+        return SchemaEntry(
+            want, tools, kinds, float(written) if isinstance(written, int | float) else 0.0
+        )
+
+    def write(
+        self,
+        server: str,
+        print_: str,
+        tools: Sequence[CachedTool],
+        utilities: Sequence[str],
+        *,
+        now: float,
+    ) -> None:
+        """Store the listing (failures are logged, never raised: the cache is an optimisation)."""
+        body = {
+            "version": CACHE_VERSION,
+            "fingerprint": print_,
+            "written_at": now,
+            "tools": [t.as_json() for t in tools],
+            "utilities": list(utilities),
+        }
+        try:
+            self.folder.mkdir(parents=True, exist_ok=True)
+            atomic_write_json(self.path(server), body, mode=0o600)
+        except (OSError, TypeError, ValueError) as exc:
+            log.warning("could not write the MCP schema cache for %s: %s", server, exc)
+
+    def remove(self, server: str) -> None:
+        try:
+            self.path(server).unlink(missing_ok=True)
+        except OSError as exc:
+            log.debug("could not remove the MCP schema cache for %s: %s", server, exc)
diff --git a/src/indus/mcp/trust.py b/src/indus/mcp/trust.py
new file mode 100644
index 0000000..1160618
--- /dev/null
+++ b/src/indus/mcp/trust.py
@@ -0,0 +1,338 @@
+# pyright: strict
+"""The trust tier, the per-server circuit breaker and OAuth parking (P13-07).
+
+Trust: a server with ``trust: untrusted`` (P13-01 parses any unrecognised value as untrusted; a
+missing one is ``full``) gets a person's approval before every call to a tool whose discovered
+``readOnlyHint`` is not exactly JSON ``true``. The hint is the wire value
+(``LiveSession.raw_hints``: the SDK would read ``"yes"`` as true), captured at discovery and
+frozen until the next listing; anything else, a missing hint included, counts as write-capable
+(fail closed, R07.25). The ask is the P05 per-tool gate (``safety.approvals.tool_gate``).
+
+Breaker, per (profile, server): 3 failures in a row open it for 60 s, and calls get a plain
+"unreachable, retry later" result without touching the server; after the 60 s one probe call is
+let through (half-open): success closes it, failure opens it for another 60 s.
+
+OAuth (R07.24): discovery, reconcile and reload never log in interactively — the OAuth layer asks
+``interactive_auth_allowed()`` before it opens a browser, and only code inside
+``allow_interactive_auth()`` (``indus mcp login``) gets ``True``. A connect the server refuses with
+401/403 parks the server (P13-04 treats it as permanent); ``AuthParking`` remembers the credential
+stamp it failed with, so later discovery passes (new sessions) leave it alone until the stamp
+changes; only the lifecycle's own timed probe retries the token meanwhile.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import logging
+from collections.abc import Callable, Generator
+from contextlib import contextmanager
+from dataclasses import dataclass
+from enum import StrEnum
+from typing import Any
+
+import httpx2
+
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.mcp.connect import McpConnectFailed, first_cause
+from indus.protocol.requests_port import ServerRequestPort
+from indus.safety.approvals.decision import ApprovalState
+from indus.safety.approvals.tool_gate import approve_tool_call
+
+__all__ = [
+    "BREAKER_COOLDOWN_S",
+    "BREAKER_THRESHOLD",
+    "AuthParking",
+    "BreakerBook",
+    "BreakerState",
+    "CircuitBreaker",
+    "CredentialStamp",
+    "allow_interactive_auth",
+    "background_auth",
+    "gate_call",
+    "interactive_auth_allowed",
+    "is_auth_failure",
+    "needs_approval",
+    "pattern_key",
+    "read_only",
+]
+
+log = logging.getLogger(__name__)
+
+BREAKER_THRESHOLD = 3
+BREAKER_COOLDOWN_S = 60.0
+
+
+# -- the trust tier -----------------------------------------------------------------------------
+
+
+def read_only(raw_hint: object) -> bool:
+    """True only for a hint that was exactly JSON ``true`` on the wire."""
+    return raw_hint is True
+
+
+def needs_approval(trust: str, is_read_only: bool) -> bool:
+    """Whether a call needs a person first: any tier but ``full`` gates write-capable tools."""
+    return trust != "full" and not is_read_only
+
+
+def pattern_key(server: str, tool: str) -> str:
+    """The session-approval key of one server tool."""
+    return f"mcp:{server}:{tool}"
+
+
+async def gate_call(
+    server: str,
+    tool: str,
+    *,
+    trust: str,
+    is_read_only: bool,
+    scope: Scope | None,
+    session_id: str | None = None,
+    turn_id: str | None = None,
+    broker: ServerRequestPort | None = None,
+    run_context: object = None,
+    judge: Any = None,
+    state: ApprovalState | None = None,
+) -> str | None:
+    """None when the call may go to the server; otherwise the refusal text for the model."""
+    if not needs_approval(trust, is_read_only):
+        return None
+    verdict = await approve_tool_call(
+        f"MCP tool {tool} on the untrusted server {server}",
+        f"the server {server} is marked untrusted and {tool} does not declare itself read-only, "
+        "so it may change things outside this machine",
+        pattern_key(server, tool),
+        scope=scope,
+        session_id=session_id,
+        turn_id=turn_id,
+        broker=broker,
+        run_context=run_context,
+        judge=judge,
+        state=state,
+    )
+    if verdict.approved:
+        return None
+    log.info("MCP tool %s on untrusted server %s not run (%s)", tool, server, verdict.outcome)
+    return verdict.message or (
+        f"BLOCKED: {tool} on the untrusted MCP server {server} was not approved, so it did not run."
+    )
+
+
+# -- the breaker --------------------------------------------------------------------------------
+
+
+class BreakerState(StrEnum):
+    CLOSED = "closed"
+    OPEN = "open"
+    HALF_OPEN = "half_open"
+
+
+class CircuitBreaker:
+    """Consecutive failures of one server's calls (see the module notes).
+
+    Use: ``refusal = breaker.check()``; when None, run the call and report it with
+    ``record(True)`` / ``record(False, application=...)``, or ``record(None)`` when it never
+    reached an outcome (cancelled), so a half-open probe slot is given back.
+    """
+
+    def __init__(
+        self,
+        name: str,
+        clock: Clock,
+        *,
+        threshold: int = BREAKER_THRESHOLD,
+        cooldown: float = BREAKER_COOLDOWN_S,
+    ) -> None:
+        self.name = name
+        self.clock = clock
+        self.threshold = threshold
+        self.cooldown = cooldown
+        self.failures = 0
+        self._opened_at: float | None = None
+        self._probing = False
+        self._all_application = True
+
+    @property
+    def state(self) -> BreakerState:
+        if self._opened_at is None:
+            return BreakerState.CLOSED
+        if self.clock.monotonic() - self._opened_at < self.cooldown:
+            return BreakerState.OPEN
+        return BreakerState.HALF_OPEN
+
+    def retry_in(self) -> float:
+        if self._opened_at is None:
+            return 0.0
+        return max(0.0, self.cooldown - (self.clock.monotonic() - self._opened_at))
+
+    def check(self) -> str | None:
+        """None when a call may go ahead (taking the probe slot when half-open)."""
+        state = self.state
+        if state is BreakerState.CLOSED:
+            return None
+        if state is BreakerState.HALF_OPEN and not self._probing:
+            self._probing = True
+            return None
+        wait = max(1, round(self.retry_in())) if state is BreakerState.OPEN else 1
+        if self._all_application:
+            return (
+                f"MCP server {self.name} rejected the last {self.failures} calls (it answers, but "
+                f"each call came back as an error). Calls to it are paused for about {wait} s. "
+                "Do not repeat the same call: change the arguments or take another approach."
+            )
+        return (
+            f"MCP server {self.name} is unreachable after {self.failures} failed calls in a row; "
+            f"retry later (in about {wait} s). Do not call its tools until then: use another "
+            "approach or ask the user to check the server."
+        )
+
+    def record(self, ok: bool | None, *, application: bool = False) -> None:
+        probing, self._probing = self._probing, False
+        if ok is None:
+            return
+        if ok:
+            if self.failures or self._opened_at is not None:
+                log.info("MCP server %s: calls succeed again; breaker closed", self.name)
+            self.failures = 0
+            self._opened_at = None
+            self._all_application = True
+            return
+        self.failures += 1
+        self._all_application = application and (self.failures == 1 or self._all_application)
+        if probing or self.failures >= self.threshold:
+            if self._opened_at is None or probing:
+                log.warning(
+                    "MCP server %s: %d failed calls in a row; pausing its calls for %.0f s",
+                    self.name,
+                    self.failures,
+                    self.cooldown,
+                )
+            self._opened_at = self.clock.monotonic()
+
+    def reset(self) -> None:
+        self.failures = 0
+        self._opened_at = None
+        self._probing = False
+        self._all_application = True
+
+
+class BreakerBook:
+    """One breaker per (profile, server)."""
+
+    def __init__(self, clock: Clock) -> None:
+        self.clock = clock
+        self._breakers: dict[tuple[str, str], CircuitBreaker] = {}
+
+    def get(self, profile: str, server: str) -> CircuitBreaker:
+        key = (profile, server)
+        found = self._breakers.get(key)
+        if found is None:
+            found = self._breakers[key] = CircuitBreaker(server, self.clock)
+        return found
+
+    def drop(self, profile: str, server: str) -> None:
+        self._breakers.pop((profile, server), None)
+
+
+# -- OAuth in the background --------------------------------------------------------------------
+
+_interactive: contextvars.ContextVar[bool] = contextvars.ContextVar(
+    "indus_mcp_interactive_auth", default=False
+)
+
+
+def interactive_auth_allowed() -> bool:
+    """True only inside ``allow_interactive_auth()``: may the OAuth layer open a browser or
+    prompt? Background work (discovery, reconcile, reload, cron) never may."""
+    return _interactive.get()
+
+
+@contextmanager
+def allow_interactive_auth() -> Generator[None]:
+    """Mark the code inside as a person's own login (``indus mcp login``)."""
+    token = _interactive.set(True)
+    try:
+        yield
+    finally:
+        _interactive.reset(token)
+
+
+@contextmanager
+def background_auth() -> Generator[None]:
+    """The code inside never logs in interactively, whatever its caller allowed. Server runner
+    tasks are started inside it, so their later reconnects stay background work."""
+    token = _interactive.set(False)
+    try:
+        yield
+    finally:
+        _interactive.reset(token)
+
+
+def is_auth_failure(exc: BaseException) -> bool:
+    """The server refused the credentials (HTTP 401 or 403), however the SDK wrapped it."""
+    root = first_cause(exc)
+    seen = 0
+    while isinstance(root, McpConnectFailed) and root.cause is not None and seen < 8:
+        root = first_cause(root.cause)
+        seen += 1
+    return isinstance(root, httpx2.HTTPStatusError) and root.response.status_code in (401, 403)
+
+
+CredentialStamp = Callable[[str], object]
+"""Server name → something that changes when its stored credentials change (P13-09 supplies it:
+e.g. the token record's revision). ``None`` means no credentials are stored."""
+
+
+def _no_stamp(server: str) -> object:
+    return None
+
+
+@dataclass
+class _Park:
+    stamp: object
+    reason: str
+
+
+class AuthParking:
+    """Servers parked because their credentials were refused, and the stamp they failed with."""
+
+    def __init__(self, stamp: CredentialStamp | None = None) -> None:
+        self._stamp = stamp or _no_stamp
+        self._parked: dict[str, _Park] = {}
+
+    def note(self, server: str, exc: BaseException) -> bool:
+        """Record ``exc`` when it is an auth refusal (one warning per park); True if recorded."""
+        if not is_auth_failure(exc):
+            return False
+        stamp = self._safe_stamp(server)
+        current = self._parked.get(server)
+        if current is None or current.stamp != stamp:
+            log.warning(
+                "MCP server %s refused its credentials; parked until the user signs in again "
+                "(indus mcp login %s). No browser is opened from background work.",
+                server,
+                server,
+            )
+        self._parked[server] = _Park(stamp, str(first_cause(exc)))
+        return True
+
+    def clear(self, server: str) -> None:
+        self._parked.pop(server, None)
+
+    def parked(self, server: str) -> bool:
+        return server in self._parked
+
+    def may_retry(self, server: str) -> bool:
+        """False while the server is auth-parked and its credentials are unchanged."""
+        park = self._parked.get(server)
+        if park is None:
+            return True
+        return self._safe_stamp(server) != park.stamp
+
+    def _safe_stamp(self, server: str) -> object:
+        try:
+            return self._stamp(server)
+        except Exception as exc:
+            log.debug("credential stamp for %s failed: %s", server, type(exc).__name__)
+            return None
