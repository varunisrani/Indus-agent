+        asyncio.run(checker.preflight("files", "npx", ["-y", "evil-pkg@1.2.3"]))
+    assert "MAL-2026-1234" in str(caught.value) and caught.value.advisories == ("MAL-2026-1234",)
+    assert is_permanent(caught.value)
