+++ b/tests/unit/plugins/test_consent.py
@@ -0,0 +1,159 @@
+"""P13-22: capability, dependency and env consent (R07.19)."""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.foundation.scope import Scope
+from indus.plugins import consent
+from indus.plugins.context import PluginHost
+from indus.plugins.hooks import HookBus
+from indus.plugins.manifest import EnvRequirement, PluginManifest
+from indus.tools.registry import ToolRegistry
+from tests.fakes.agent import DictConfig
+
+NOW = "2026-10-19T10:00:00+00:00"
+
+
+def manifest(*caps: str, **fields: Any) -> PluginManifest:
+    return PluginManifest(name="hello", capabilities=caps, source="user", **fields)
+
+
+def has(scope: Scope, tree: Mapping[str, Any], plugin: PluginManifest, cap: str) -> bool:
+    configured = scope.with_config(DictConfig(tree))
+    host = PluginHost(configured, ToolRegistry(), HookBus())
+    return host.context(plugin).has_capability(cap)
+
+
+def test_interactive_grant_stored_with_hash(scope: Scope) -> None:
+    plugin = manifest("tools.override", "llm.model")
+    tree: dict[str, Any] = {}
+    shown: list[str] = []
+
+    def ask(text: str) -> bool:
+        shown.append(text)
+        return True
+
+    result = consent.consent_capabilities(tree, plugin, ask=ask, now=NOW)
+    assert result.asked and result.granted == ["tools.override", "llm.model"]
+    assert "not a sandbox" in shown[0] and consent.CAPABILITIES["llm.model"] in shown[0]
+    entry = tree["plugins"]["entries"]["hello"]
+    assert entry[consent.GRANTED_KEY] == [
+        {"name": "tools.override", "granted_at": NOW},
+        {"name": "llm.model", "granted_at": NOW},
+    ]
+    assert entry[consent.CONSENT_KEY] == {
+        "hash": consent.declared_hash(["llm.model", "tools.override"]),
+        "declared": ["llm.model", "tools.override"],
+        "at": NOW,
+    }
+    assert has(scope, tree, plugin, "llm.model")
+    # Asked once: the same declared set is not asked again.
+    again = consent.consent_capabilities(tree, plugin, ask=lambda t: pytest.fail("asked twice"))
+    assert not again.asked
+
+
+def test_refusal_is_recorded_and_capability_stays_off(scope: Scope) -> None:
+    plugin = manifest("llm.provider")
+    tree: dict[str, Any] = {}
+    result = consent.consent_capabilities(tree, plugin, ask=lambda text: False, now=NOW)
+    assert result.refused == ["llm.provider"] and result.granted == []
+    assert tree["plugins"]["entries"]["hello"][consent.GRANTED_KEY] == []
+    assert not has(scope, tree, plugin, "llm.provider")
+    assert consent.new_capabilities(tree, "hello", ["llm.provider"]) == []
+
+
+def test_update_adding_capability_stays_off_until_granted(scope: Scope) -> None:
+    tree: dict[str, Any] = {}
+    consent.consent_capabilities(tree, manifest("tools.override"), ask=lambda t: True, now=NOW)
+    newer = manifest("tools.override", "llm.model")
+    waiting = consent.consent_capabilities(tree, newer, ask=None)
+    assert waiting.waiting == ["llm.model"] and not waiting.asked
+    assert has(scope, tree, newer, "tools.override") and not has(scope, tree, newer, "llm.model")
+    shown: list[str] = []
+    consent.consent_capabilities(tree, newer, ask=lambda t: shown.append(t) is None)
+    assert "llm.model" in shown[0] and "tools.override" not in shown[0]
+    assert has(scope, tree, newer, "llm.model")
+
+
+def test_unknown_capabilities_dropped(caplog: pytest.LogCaptureFixture) -> None:
+    with caplog.at_level(logging.WARNING):
+        found = consent.declared_capabilities(manifest("nope", "tools.override", "tools.override"))
+    assert found == ["tools.override"]
+    assert "unknown capability 'nope'" in caplog.text
+
+
+def test_non_tty_grants_nothing() -> None:
+    tree: dict[str, Any] = {}
+    result = consent.consent_capabilities(tree, manifest("platform.actions"), ask=None)
+    assert result.waiting == ["platform.actions"] and result.granted == []
+    assert tree == {}  # nothing recorded: the question comes again on a terminal
+
+
+def test_revoke_and_set_grants_keep_times() -> None:
+    tree: dict[str, Any] = {}
+    consent.set_grants(tree, "hello", ["llm.model"], ["llm.model", "llm.task"], now=NOW)
+    later = "2026-10-20T00:00:00+00:00"
+    consent.set_grants(tree, "hello", ["llm.task"], ["llm.model", "llm.task"], now=later)
+    entry = tree["plugins"]["entries"]["hello"]
+    assert entry[consent.GRANTED_KEY] == [
+        {"name": "llm.model", "granted_at": NOW},
+        {"name": "llm.task", "granted_at": later},
+    ]
+    assert consent.revoke_capabilities(tree, "hello", ["llm.model"]) == ["llm.model"]
+    assert consent.granted_capabilities(tree, "hello") == ["llm.task"]
+    # The old plain-string form still reads.
+    old = {"plugins": {"entries": {"hello": {"granted_capabilities": ["llm.agent", "bogus"]}}}}
+    assert consent.granted_capabilities(old, "hello") == ["llm.agent"]
+
+
+def test_pinned_requirements() -> None:
+    ok = manifest(python_dependencies=("requests==2.32.3", "rich[jupyter]==13.9.4"))
+    assert consent.pinned_requirements(ok) == ["requests==2.32.3", "rich[jupyter]==13.9.4"]
+    loose = manifest(python_dependencies=("requests>=2", "rich"))
+    with pytest.raises(consent.ConsentError, match="not pinned exactly: requests>=2, rich"):
+        consent.pinned_requirements(loose)
+
+
+def test_install_dependencies(scope: Scope, monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr(consent, "which", lambda name, path=None: None)
+    ok, why = consent.install_dependencies(scope, ["requests==2.32.3"])
+    assert not ok and "uv is not on PATH" in why
+    monkeypatch.setattr(consent, "which", lambda name, path=None: "/opt/uv")
+    seen: list[Sequence[str]] = []
+
+    def runner(
+        argv: Sequence[str], cwd: Path, env: Mapping[str, str], timeout: float
+    ) -> tuple[int, str]:
+        seen.append(argv)
+        return 0, "installed"
+
+    assert consent.install_dependencies(scope, ["requests==2.32.3"], runner=runner) == (
+        True,
+        "installed",
+    )
+    assert seen[0][:4] == ["/opt/uv", "pip", "install", "--python"]
+    assert seen[0][-1] == "requests==2.32.3"
+    assert consent.install_dependencies(scope, []) == (True, "")
+
+
+def test_missing_env(scope: Scope) -> None:
+    plugin = manifest(
+        requires_env=("PLAIN_SET", EnvRequirement(name="SERVICE_TOKEN", secret=True), "ABSENT")
+    )
+    scoped = scope.with_env(scope.env.with_overlay({"PLAIN_SET": "x"}))
+    assert [m.name for m in consent.missing_env(scoped, plugin)] == ["SERVICE_TOKEN", "ABSENT"]
+    assert scoped.secrets is not None
+    scoped.secrets.set("SERVICE_TOKEN", "value-" + "for-test")  # type: ignore[attr-defined]
+    assert [m.name for m in consent.missing_env(scoped, plugin)] == ["ABSENT"]
+
+
+def test_memory_provider_kind() -> None:
+    assert consent.is_memory_provider(manifest(kind="exclusive"))
+    assert consent.is_memory_provider(manifest(category="memory"))
+    assert not consent.is_memory_provider(manifest())
diff --git a/tests/unit/plugins/test_install.py b/tests/unit/plugins/test_install.py
new file mode 100644
index 0000000..a47a6bc
--- /dev/null
+++ b/tests/unit/plugins/test_install.py
@@ -0,0 +1,375 @@
+"""P13-21: plugin install / update / remove from local bare git repos (R07.19)."""
+
+from __future__ import annotations
+
+import json
+import os
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.foundation.scope import Scope
+from indus.plugins import install as inst
+from indus.plugins.install import GitResult, InstallBlocked, Installer, InstallError
+from tests.fakes.agent import DictConfig
+from tests.unit.plugins._git_repos import (
+    CAUTION_INIT,
+    DANGEROUS_INIT,
+    PluginRepo,
+    git_scope,
+    plugin_files,
+)
+
+
+@pytest.fixture
+def repo(tmp_path: Path) -> PluginRepo:
+    return PluginRepo(tmp_path / "src")
+
+
+@pytest.fixture
+def gscope(scope: Scope, tmp_path: Path) -> Scope:
+    return git_scope(scope, tmp_path)
+
+
+def installer(scope: Scope, **git: Any) -> Installer:
+    return Installer(scope, git=inst.Git(scope, **git)) if git else Installer(scope)
+
+
+# -- identifiers ---------------------------------------------------------------------------------
+
+
+def test_ref_must_be_full_sha() -> None:
+    for bad in ("abc1234", "v1.0.0", "main", "g" * 40, "a" * 39):
+        with pytest.raises(InstallError, match="full 40-character commit SHA"):
+            inst.full_sha(bad)
+    assert inst.full_sha("A" * 40) == "a" * 40
+
+
+def test_parse_source(tmp_path: Path) -> None:
+    src = inst.parse_source("someone/indus-hello")
+    assert (src.kind, src.url, src.subdir) == (
+        "github",
+        "https://github.com/someone/indus-hello.git",
+        "",
+    )
+    deep = inst.parse_source("someone/mono/plugins/hello")
+    assert deep.url == "https://github.com/someone/mono.git" and deep.subdir == "plugins/hello"
+    custom = inst.parse_source("https://git.example.com/team/p.git#sub/dir")
+    assert custom.custom and custom.subdir == "sub/dir"
+    assert inst.parse_source("git@example.com:team/p.git").kind == "git"
+    local = tmp_path / "mine"
+    local.mkdir()
+    assert inst.parse_source("./mine", cwd=tmp_path).kind == "local"
+    with pytest.raises(InstallError, match="leaves the repository"):
+        inst.parse_source("https://h/r.git#../../etc")
+    with pytest.raises(InstallError):
+        inst.parse_source("not a thing at all")
+
+
+def test_scrub_url() -> None:
+    secret = "pa" + "ss"
+    assert inst.scrub_url(f"https://user:{secret}@host.example:8443/x.git?q=1#f") == (
+        "https://host.example:8443/x.git"
+    )
+    assert inst.scrub_url("ssh://git@host/x.git") == "ssh://git@host/x.git"
+
+
+# -- install ------------------------------------------------------------------------------------
+
+
+def test_pin_installs_the_exact_commit(gscope: Scope, repo: PluginRepo) -> None:
+    first = repo.commit(plugin_files(init="def register(ctx):\n    pass  # v1\n"))
+    repo.commit({"__init__.py": "def register(ctx):\n    pass  # v2\n"})
+    result = installer(gscope).install(repo.url, ref=first.upper())
+    assert result.name == "hello"
+    assert "# v1" in (result.target / "__init__.py").read_text(encoding="utf-8")
+    record = Installer(gscope).record("hello")
+    assert record is not None and record["pinned"] is True and record["revision"] == first
+    assert record["kind"] == "git" and record["scan"]["verdict"] == "safe"
+    assert not any(p.name.startswith(".staging-") for p in (gscope.home / "plugins").iterdir())
+
+
+def test_pin_mismatch_refused(
+    gscope: Scope, repo: PluginRepo, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    first = repo.commit(plugin_files())
+    monkeypatch.setattr(inst.Git, "head", lambda self, path: "f" * 40)
+    with pytest.raises(InstallError, match="not the pinned commit"):
+        installer(gscope).install(repo.url, ref=first)
+    assert not (gscope.home / "plugins" / "hello").exists()
+    assert Installer(gscope).records() == {}
+
+
+def test_pinned_update_refused(gscope: Scope, repo: PluginRepo) -> None:
+    first = repo.commit(plugin_files())
+    repo.commit({"extra.txt": "more\n"})
+    tool = installer(gscope)
+    tool.install(repo.url, ref=first)
+    with pytest.raises(InstallError, match="pinned"):
+        tool.update("hello")
+    # A reinstall without --ref stays on the pin; moving it takes an explicit --ref.
+    kept = tool.install(repo.url, force=True)
+    assert kept.record["pinned"] is True and kept.record["revision"] == first
+    assert not (kept.target / "extra.txt").exists()
+    tool.remove("hello")
+    again = tool.install(repo.url)  # the record is gone with the plugin: a fresh install
+    assert again.record["pinned"] is False and (again.target / "extra.txt").exists()
+    tool.install(repo.url, force=True, ref=first)
+    moved = tool.install(repo.url, force=True, ref=repo.git(repo.work, "rev-parse", "HEAD"))
+    assert (moved.target / "extra.txt").exists()
+
+
+def test_existing_plugin_needs_force(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    tool = installer(gscope)
+    tool.install(repo.url)
+    with pytest.raises(InstallError, match="already installed"):
+        tool.install(repo.url)
+
+
+def header_of(env: Mapping[str, str]) -> tuple[str, str] | None:
+    for key, value in env.items():
+        if key.startswith("GIT_CONFIG_KEY_") and value.endswith(".extraHeader"):
+            return value, env.get(key.replace("_KEY_", "_VALUE_"), "")
+    return None
+
+
+class Recorder:
+    """A git runner that refuses anonymous access to the GitHub URL, then serves it from the local
+    bare repo; every call's argv and env are kept."""
+
+    def __init__(self, local_url: str) -> None:
+        self.local_url = local_url
+        self.calls: list[tuple[list[str], dict[str, str]]] = []
+
+    def __call__(
+        self,
+        argv: Sequence[str],
+        cwd: Path,
+        env: Mapping[str, str],
+        timeout: float,
+        stdin: str | None,
+    ) -> GitResult:
+        self.calls.append((list(argv), dict(env)))
+        remote = "https://github.com/someone/hello.git"
+        if remote in argv and argv[1] == "clone":
+            if not header_of(env):
+                return GitResult(128, "", f"fatal: Authentication failed for '{remote}'")
+            argv = [self.local_url if a == remote else a for a in argv]
+        return inst.run_process(argv, cwd, env, timeout, stdin)
+
+
+def test_token_only_in_one_command_env(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    token = "tok" + "en-for-test-123"
+    scoped = gscope.with_env(gscope.env.with_overlay({"GITHUB_TOKEN": token}))
+    recorder = Recorder(repo.url)
+    result = Installer(scoped, git=inst.Git(scoped, runner=recorder)).install("someone/hello")
+    with_header = [(argv, header_of(env)) for argv, env in recorder.calls if header_of(env)]
+    assert len(with_header) == 1
+    argv, header = with_header[0]
+    assert "clone" in argv and header is not None
+    assert header[0] == "http.https://github.com/.extraHeader"
+    assert header[1].startswith("Authorization: Basic ")
+    for argv, _env in recorder.calls:
+        assert not any(token in a for a in argv)  # never on a command line
+    config = (result.target / ".git" / "config").read_text(encoding="utf-8")
+    assert token not in config and "extraHeader" not in config and "Authorization" not in config
+    assert token not in (gscope.home / "plugins" / inst.METADATA_FILE).read_text(encoding="utf-8")
+
+
+def test_dangerous_blocked_even_with_force(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files(init=DANGEROUS_INIT))
+    with pytest.raises(InstallBlocked, match="dangerous") as caught:
+        installer(gscope).install(repo.url, force=True, confirm=lambda report: True)
+    assert caught.value.report is not None and caught.value.report.verdict == "dangerous"
+    assert not (gscope.home / "plugins" / "hello").exists()
+    assert Installer(gscope).records() == {}
+
+
+def test_caution_needs_confirm(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files(init=CAUTION_INIT))
+    tool = installer(gscope)
+    with pytest.raises(InstallBlocked, match="caution"):
+        tool.install(repo.url)
+    seen: list[str] = []
+    with pytest.raises(InstallBlocked):
+        tool.install(repo.url, confirm=lambda report: seen.append(report.verdict) is not None)
+    assert seen == ["caution"]
+    assert tool.install(repo.url, confirm=lambda report: True).report.verdict == "caution"
+    assert tool.install(repo.url, force=True).replaced
+
+
+def test_crash_between_staging_and_rename(
+    gscope: Scope, repo: PluginRepo, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    repo.commit(plugin_files())
+
+    def crash(self: Installer, tree: Path, target: Path) -> None:
+        raise KeyboardInterrupt
+
+    monkeypatch.setattr(Installer, "_publish", crash)
+    with pytest.raises(KeyboardInterrupt):
+        installer(gscope).install(repo.url)
+    plugins = gscope.home / "plugins"
+    assert not (plugins / "hello").exists() and Installer(gscope).records() == {}
+    # A process that died mid-way leaves only dot-folders; the next install sweeps them.
+    (plugins / ".staging-leftover").mkdir()
+    monkeypatch.undo()
+    installer(gscope).install(repo.url)
+    assert (plugins / "hello" / "plugin.yaml").is_file()
+    assert sorted(p.name for p in plugins.iterdir() if p.name.startswith(".s")) == []
+
+
+def test_subdirectory_install_publishes_only_that_folder(gscope: Scope, repo: PluginRepo) -> None:
+    files = {f"plugins/hello/{k}": v for k, v in plugin_files().items()}
+    files["other/big.txt"] = "unrelated\n"
+    repo.commit(files)
+    result = installer(gscope).install(f"{repo.url}#plugins/hello")
+    assert sorted(p.name for p in result.target.iterdir()) == ["__init__.py", "plugin.yaml"]
+    assert Installer(gscope).record("hello")["subdir"] == "plugins/hello"  # type: ignore[index]
+
+
+def test_local_folder_install(gscope: Scope, tmp_path: Path) -> None:
+    folder = tmp_path / "mine"
+    folder.mkdir()
+    for rel, text in plugin_files("mine").items():
+        (folder / rel).write_text(text, encoding="utf-8")
+    (folder / ".git").mkdir()
+    tool = installer(gscope)
+    result = tool.install(str(folder))
+    assert result.name == "mine" and not (result.target / ".git").exists()
+    with pytest.raises(InstallError, match="reinstall"):
+        tool.update("mine")
+
+
+# -- update -------------------------------------------------------------------------------------
+
+
+def test_update_reapplies_local_edits(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    tool = installer(gscope)
+    target = tool.install(repo.url).target
+    init = target / "__init__.py"
+    init.write_text(init.read_text(encoding="utf-8") + "# my local tweak\n", encoding="utf-8")
+    new = repo.commit({"README.md": "now documented\n"})
+    result = tool.update("hello")
+    assert result.changed and result.new == new and not result.blocked
+    assert "# my local tweak" in init.read_text(encoding="utf-8")
+    assert (target / "README.md").is_file()
+    assert "re-applied" in result.note
+    assert tool.record("hello")["revision"] == new  # type: ignore[index]
+    again = tool.update("hello")
+    assert not again.changed
+
+
+def test_dangerous_update_restores_and_disables(gscope: Scope, repo: PluginRepo) -> None:
+    first = repo.commit(plugin_files())
+    tool = installer(gscope)
+    target = tool.install(repo.url).target
+    repo.commit({"__init__.py": DANGEROUS_INIT})
+    result = tool.update("hello", force=True)
+    assert result.blocked and result.disable and not result.changed
+    assert inst.Git(gscope).head(target) == first
+    assert "rm -rf" not in (target / "__init__.py").read_text(encoding="utf-8")
+    assert tool.record("hello")["revision"] == first  # type: ignore[index]
+
+
+def test_update_url_change_needs_trust(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    tool = installer(gscope)
+    tool.install(repo.url)
+    repo.commit(plugin_files(update_url="https://updates.example.com/hello"))
+    stopped = tool.update("hello")
+    assert "update_url changed" in stopped.blocked and not stopped.changed
+    trusted = tool.update("hello", trust_update_url=True)
+    assert trusted.changed
+    assert tool.record("hello")["update_url"] == "https://updates.example.com/hello"  # type: ignore[index]
+
+
+def test_force_reinstall_backs_up_edits(gscope: Scope, repo: PluginRepo) -> None:
+    first = repo.commit(plugin_files())
+    tool = installer(gscope)
+    target = tool.install(repo.url).target
+    (target / "__init__.py").write_text("# edited by hand\n", encoding="utf-8")
+    result = tool.install(repo.url, force=True)
+    assert result.backup == gscope.home / "plugins-backup" / f"hello-{first[:7]}"
+    assert result.backup is not None
+    assert (result.backup / "__init__.py").read_text(encoding="utf-8") == "# edited by hand\n"
+    assert "register" in (target / "__init__.py").read_text(encoding="utf-8")
+
+
+def test_check_updates(gscope: Scope, repo: PluginRepo, tmp_path: Path) -> None:
+    repo.commit(plugin_files())
+    tool = installer(gscope)
+    tool.install(repo.url)
+    other = PluginRepo(tmp_path / "pinned", "pinned")
+    pin = other.commit(plugin_files("pinned"))
+    tool.install(other.url, ref=pin)
+    assert [(s.name, s.available) for s in tool.check_updates()] == [
+        ("hello", False),
+        ("pinned", False),
+    ]
+    new = repo.commit({"x.txt": "x\n"})
+    statuses = {s.name: s for s in tool.check_updates()}
+    assert statuses["hello"].available and statuses["hello"].latest == new
+    assert statuses["pinned"].note == "pinned"
+    assert tool.last_check()["available"] == {"hello": new}
+
+
+def test_maybe_check_updates_honours_the_interval(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    installer(gscope).install(repo.url)
+    off = gscope.with_config(DictConfig({"plugins": {"auto_update_check_hours": 0}}))
+    assert Installer(off).maybe_check_updates() is None
+    tool = installer(gscope)
+    assert tool.maybe_check_updates(now=1_000_000.0) == []  # checked, not applied
+    assert tool.maybe_check_updates(now=1_000_000.0 + 3600) is None  # not due yet
+    repo.commit({"x.txt": "x\n"})
+    auto = gscope.with_config(DictConfig({"plugins": {"auto_apply": True}}))
+    applied = Installer(auto).maybe_check_updates(now=2_000_000.0 + 10**6)
+    assert applied is not None and [a.changed for a in applied] == [True]
+
+
+# -- remove -------------------------------------------------------------------------------------
+
+
+def test_remove_and_forget(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    tool = installer(gscope)
+    tool.install(repo.url)
+    assert tool.remove("hello")
+    assert not (gscope.home / "plugins" / "hello").exists() and tool.records() == {}
+    assert not tool.remove("hello")
+    tree: dict[str, Any] = {
+        "plugins": {
+            "enabled": ["hello", "other"],
+            "disabled": ["hello"],
+            "entries": {"hello": {"granted_capabilities": []}, "other": {}},
+        },
+        "memory": {"provider": "hello"},
+    }
+    changed = inst.forget_plugin(tree, "hello")
+    assert tree["plugins"] == {"enabled": ["other"], "disabled": [], "entries": {"other": {}}}
+    assert tree["memory"]["provider"] == ""
+    assert "memory.provider" in changed
+
+
+def test_metadata_holds_no_secrets_or_grants(gscope: Scope, repo: PluginRepo) -> None:
+    repo.commit(plugin_files())
+    installer(gscope).install(repo.url)
+    data = json.loads((gscope.home / "plugins" / inst.METADATA_FILE).read_text(encoding="utf-8"))
+    assert set(data["hello"]) == {
+        "source",
+        "kind",
+        "identifier",
+        "subdir",
+        "revision",
+        "pinned",
+        "installed_at",
+        "update_url",
+        "scan",
+    }
+    assert os.stat(gscope.home / "plugins" / inst.METADATA_FILE).st_mode & 0o077 == 0
diff --git a/tests/unit/plugins/test_pre_llm_call_turn.py b/tests/unit/plugins/test_pre_llm_call_turn.py
new file mode 100644
index 0000000..2c6dd9a
--- /dev/null
+++ b/tests/unit/plugins/test_pre_llm_call_turn.py
@@ -0,0 +1,134 @@
+"""``pre_llm_call`` through a real turn: plugin and shell-hook context rides the user message that
+is sent (and stored as its ``api_content``), never the system prompt (R07.18, R01.1)."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+from collections.abc import Iterator
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.core.agent import Agent
+from indus.core.persist import MemoryStore
+from indus.foundation.blocking import BlockingPool
+from indus.foundation.scope import Scope
+from indus.plugins.hooks import HookBus
+from indus.plugins.session import plugin_options
+from indus.plugins.shell_hooks import register_shell_hooks
+from tests.fakes.agent import DictConfig, fake_options, run_driven
+from tests.fakes.clock import FakeClock
+from tests.fakes.model import FakeModelServer, fake_route, script_of, text_turn
+
+
+@pytest.fixture
+def pool() -> Iterator[BlockingPool]:
+    made = BlockingPool("pre-llm-test", 4)
+    yield made
+    made.shutdown()
+
+
+def messages(server: FakeModelServer, index: int) -> list[dict[str, Any]]:
+    return server.model_requests[index].body["messages"]
+
+
+async def two_turns(
+    scope: Scope, clock: FakeClock, bus: HookBus | None, store: MemoryStore
+) -> tuple[FakeModelServer, Agent]:
+    server = FakeModelServer(script_of(text_turn("one"), text_turn("two")), clock=clock)
+    options = fake_options(server, store=store)
+    if bus is not None:
+        options = plugin_options(options, bus, session_id="s1")
+    agent = await Agent.start(scope, fake_route(server), [], options, None)
+    await run_driven(agent.run_turn("hi"), clock)
+    await run_driven(agent.run_turn("again"), clock)
+    await agent.close()
+    return server, agent
+
+
+def test_plugin_context_rides_the_user_message(
+    scope: Scope, fake_clock: FakeClock, pool: BlockingPool
+) -> None:
+    seen: list[dict[str, Any]] = []
+
+    def context(**payload: Any) -> dict[str, str]:
+        seen.append(payload)
+        return {"context": f"weather for turn {len(seen)}: sunny"}
+
+    bus = HookBus(clock=fake_clock, pool=pool)
+    bus.register("pre_llm_call", context, owner="weather")
+    bus.register("pre_llm_call", lambda **_: "second plugin says hello", owner="other")
+
+    async def main() -> tuple[FakeModelServer, FakeModelServer, MemoryStore]:
+        store = MemoryStore()
+        hooked, _ = await two_turns(scope, fake_clock, bus, store)
+        plain, _ = await two_turns(scope, fake_clock, None, MemoryStore())
+        return hooked, plain, store
+
+    hooked, plain, store = asyncio.run(main())
+    first = messages(hooked, 0)
+    assert first[-1] == {
+        "role": "user",
+        "content": "hi\n\nweather for turn 1: sunny\n\nsecond plugin says hello",
+    }
+    # The system prompt bytes are exactly those of a session without hooks.
+    assert first[0] == messages(plain, 0)[0]
+    assert messages(hooked, 1)[0] == messages(plain, 1)[0]
+    # Turn two replays turn one's user message with the same bytes (stored api_content).
+    second = messages(hooked, 1)
+    assert second[1] == first[-1]
+    assert second[-1]["content"].startswith("again\n\nweather for turn 2: sunny")
+    # What the person typed is stored as typed; the context is the sidecar.
+    rows = asyncio.run(store.load("s1"))
+    user_rows = [r for r in rows if r.role == "user"]
+    assert [r.content for r in user_rows] == ["hi", "again"]
+    assert user_rows[0].api_content is not None and "sunny" in user_rows[0].api_content
+    # The payload the hook got.
+    assert seen[0]["user_message"] == "hi" and seen[0]["is_first_turn"] is True
+    assert seen[1]["is_first_turn"] is False and seen[1]["session_id"] == "s1"
+    assert [m["role"] for m in seen[1]["conversation_history"]] == ["user", "assistant"]
+
+
+def test_a_failing_hook_never_fails_the_turn(
+    scope: Scope, fake_clock: FakeClock, pool: BlockingPool
+) -> None:
+    def broken(**_: Any) -> str:
+        raise RuntimeError("plugin bug")
+
+    bus = HookBus(clock=fake_clock, pool=pool)
+    bus.register("pre_llm_call", broken, owner="bad")
+
+    async def main() -> FakeModelServer:
+        server, _ = await two_turns(scope, fake_clock, bus, MemoryStore())
+        return server
+
+    server = asyncio.run(main())
+    assert messages(server, 0)[-1] == {"role": "user", "content": "hi"}
+
+
+def test_shell_hook_context_through_a_turn(
+    scope: Scope, fake_clock: FakeClock, pool: BlockingPool, tmp_path: Path
+) -> None:
+    script = tmp_path / "context.py"
+    script.write_text(
+        "import json, sys\n"
+        "payload = json.load(sys.stdin)\n"
+        "print(json.dumps({'hookSpecificOutput': {'additionalContext': "
+        "'shell saw: ' + payload['prompt']}}))\n",
+        encoding="utf-8",
+    )
+    command = f"{json.dumps(sys.executable)} {json.dumps(str(script))}"
+    configured = scope.with_config(DictConfig({"hooks": {"pre_llm_call": [{"command": command}]}}))
+    bus = HookBus(clock=None, pool=pool)
+    report = register_shell_hooks(bus, configured, interactive=False, accept=True)
+    assert len(report.registered) == 1
+
+    async def main() -> FakeModelServer:
+        server, _ = await two_turns(configured, fake_clock, bus, MemoryStore())
+        return server
+
+    server = asyncio.run(main())
+    assert messages(server, 0)[-1]["content"] == "hi\n\nshell saw: hi"
diff --git a/tests/unit/plugins/test_prompt_sections.py b/tests/unit/plugins/test_prompt_sections.py
new file mode 100644
index 0000000..cee9e3a
--- /dev/null
+++ b/tests/unit/plugins/test_prompt_sections.py
@@ -0,0 +1,247 @@
+"""P13-18: plugin system-prompt sections — limits, skipping rules, freezing and restore (R07.20)."""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import threading
+from collections.abc import Callable, Mapping
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.core.prompt.builder import BuildContext, PromptBuilder, RuntimeInfo
+from indus.core.prompt.lifecycle import PromptLifecycle, StoredPrompt
+from indus.foundation.blocking import BlockingPool
+from indus.foundation.scope import Scope
+from indus.plugins import prompt_sections as ps
+from indus.plugins.context import PromptSectionEntry
+from tests.fakes.agent import DictConfig, eventually
+from tests.fakes.clock import FakeClock
+
+
+class MemoryPrompts:
+    def __init__(self) -> None:
+        self.rows: dict[str, StoredPrompt] = {}
+
+    async def load(self, session_id: str) -> StoredPrompt:
+        return self.rows.get(session_id, StoredPrompt("missing"))
+
+    async def save(self, session_id: str, text: str) -> None:
+        self.rows[session_id] = StoredPrompt("present", text)
+
+
+def entry(
+    section_id: str, render: str | Callable[[Mapping[str, Any]], Any], plugin: str = "p"
+) -> PromptSectionEntry:
+    return PromptSectionEntry(section_id, render, "after_memory", plugin)  # type: ignore[arg-type]
+
+
+def ctx(scope: Scope, cwd: Path, **fields: Any) -> BuildContext:
+    base: dict[str, Any] = {
+        "scope": scope.with_config(DictConfig({"timezone": "UTC"})),
+        "model": "test-model",
+        "provider": "fake",
+        "platform": "cli",
+        "session_id": "s1",
+        "cwd": cwd,
+        "context_files": False,
+        "runtime": RuntimeInfo(host="Linux", home="/home/t", cwd=str(cwd)),
+    }
+    base.update(fields)
+    return BuildContext(**base)
+
+
+def render(*entries: PromptSectionEntry, info: Mapping[str, Any] | None = None) -> list[str]:
+    found = asyncio.run(ps.render_sections(entries, info or {}))
+    return [s.id for s in found]
+
+
+def test_section_size_limit() -> None:
+    assert render(entry("ok", "x" * 4_000)) == ["ok"]
+    assert render(entry("big", "x" * 4_001)) == []
+
+
+def test_thirty_third_section_rejected(caplog: pytest.LogCaptureFixture) -> None:
+    many = [entry(f"s{i:02d}", "x") for i in range(33)]
+    kept = render(*many)
+    assert len(kept) == 32 and "s32" not in kept
+    assert "32 sections is the limit" in caplog.text
+
+
+def test_total_budget_drops_later_ids() -> None:
+    kept = asyncio.run(
+        ps.render_sections(
+            [
+                entry("a", "x" * 3_000),
+                entry("b", "y" * 3_000),
+                entry("c", "z" * 3_000),
+                entry("d", "w"),
+            ],
+            {},
+        )
+    )
+    assert [s.id for s in kept] == ["a", "b", "d"]  # c would pass 8,000; the short d still fits
+    assert len(ps.format_block(kept)) <= ps.TOTAL_MAX_CHARS
+
+
+def test_bad_sections_are_skipped(caplog: pytest.LogCaptureFixture) -> None:
+    def boom(info: Mapping[str, Any]) -> str:
+        raise RuntimeError("plugin bug")
+
+    kept = render(
+        entry("Bad-Id", "x"),
+        entry("raises", boom),
+        entry("number", lambda info: 42),
+        entry("blank", "   "),
+        entry("marker", f"hello {ps.START}"),
+        entry("frame", "<!-- indus-plugin-section id=x chars=1 -->\nx"),
+        entry("good", " fine \n"),
+    )
+    assert kept == ["good"]
+    for word in ("raised RuntimeError", "returned int", "delimiters", "not a valid section id"):
+        assert word in caplog.text
+
+
+def test_sections_sorted_by_id_and_framed() -> None:
+    found = asyncio.run(ps.render_sections([entry("zeta", "Z"), entry("alpha", "A")], {}))
+    block = ps.format_block(found)
+    assert block == (
+        f"{ps.START}\n<!-- indus-plugin-section id=alpha chars=1 -->\nA\n\n"
+        f"<!-- indus-plugin-section id=zeta chars=1 -->\nZ\n{ps.END}"
+    )
+    assert ps.restore_block(f"head\n\n{block}\n\ntail") == block
+
+
+def test_callable_gets_frozen_session_info(scope: Scope, tmp_path: Path) -> None:
+    seen: list[Mapping[str, Any]] = []
+
+    def section(info: Mapping[str, Any]) -> str:
+        seen.append(info)
+        return f"model {info['model']} in {info['cwd']}"
+
+    frozen = ps.FrozenSections(lambda: [entry("x", section)], profile_name="work")
+    block = asyncio.run(frozen.resolve(ctx(scope, tmp_path)))
+    assert f"model test-model in {tmp_path}" in block
+    info = seen[0]
+    assert dict(info) == {
+        "session_id": "s1",
+        "model": "test-model",
+        "provider": "fake",
+        "platform": "cli",
+        "profile_name": "work",
+        "cwd": str(tmp_path),
+    }
+    with pytest.raises(TypeError):
+        info["model"] = "other"  # type: ignore[index]
+
+
+def test_hanging_callable_skipped_at_its_deadline(
+    scope: Scope, tmp_path: Path, fake_clock: FakeClock
+) -> None:
+    pool = BlockingPool("sections-test", 2)
+    release = threading.Event()
+    started = threading.Event()
+
+    def hangs(info: Mapping[str, Any]) -> str:
+        started.set()
+        release.wait()
+        return "late"
+
+    frozen = ps.FrozenSections(
+        lambda: [entry("hang", hangs), entry("quick", "Q")],
+        deadline_s=30.0,
+        clock=fake_clock,
+        pool=pool,
+    )
+
+    async def main() -> str:
+        task = asyncio.ensure_future(frozen.resolve(ctx(scope, tmp_path)))
+        await eventually(lambda: started.is_set() and fake_clock.pending >= 1)
+        fake_clock.advance(30.0)
+        return await task
+
+    try:
+        block = asyncio.run(main())
+    finally:
+        release.set()
+        pool.shutdown()
+    assert "quick" in block and "hang" not in block
+
+
+def test_compaction_rebuild_reuses_the_frozen_block(scope: Scope, tmp_path: Path) -> None:
+    text = {"value": "first"}
+    frozen = ps.FrozenSections(lambda: [entry("x", lambda info: text["value"])])
+    store = MemoryPrompts()
+    lifecycle = PromptLifecycle(
+        ps.PluginSectionsBuilder(PromptBuilder(install=None), frozen), store=store
+    )
+    context = ctx(scope, tmp_path)
+
+    async def main() -> tuple[str, str]:
+        first = await lifecycle.restore_or_build(context)
+        text["value"] = "second"
+        lifecycle.invalidate("compaction")
+        again = await lifecycle.restore_or_build(
+            context, history=[{"role": "user", "content": "x"}]
+        )
+        return first, again
+
+    first, again = asyncio.run(main())
+    assert "first" in first and "second" not in again
+    assert again == first
+
+
+def test_resume_restores_stored_bytes(scope: Scope, tmp_path: Path) -> None:
+    calls: list[str] = []
+
+    def changing(info: Mapping[str, Any]) -> str:
+        calls.append("called")
+        return "now different"
+
+    original = ps.format_block([ps.RenderedSection("x", "as it was")])
+    store = MemoryPrompts()
+    store.rows["s1"] = StoredPrompt("present", f"identity\n\nmemory\n\n{original}\n\ndate")
+    frozen = ps.FrozenSections(lambda: [entry("x", changing)], prompts=store, session_ids=("s1",))
+    block = asyncio.run(frozen.resolve(ctx(scope, tmp_path)))
+    assert block == original and frozen.source == "stored:s1"
+    assert calls == []  # plugin code never runs for a resumed conversation
+
+
