+def _cdn(handler: Callable[[httpx.Request], httpx.Response]) -> DiscordAdapter:
+    clock = FakeClock(START)
+    return DiscordAdapter(
+        clock=clock, settings=settings(), fetch_transport=httpx.MockTransport(handler)
+    )
+
