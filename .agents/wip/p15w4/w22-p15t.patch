+def test_the_client_can_be_reused_after_close() -> None:
+    wire = Wire(lambda request: ok(me()))
+
+    async def main() -> None:
+        api = wire.client()
+        await api.get_me()
+        await api.aclose()
+        await api.aclose()
+        await api.get_me()
+        await api.aclose()
+
+    run(main())
+    assert len(wire.seen) == 2
+
