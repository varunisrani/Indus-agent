diff --git a/apps/tui/src/commands/wakeHandOff.test.ts b/apps/tui/src/commands/wakeHandOff.test.ts
new file mode 100644
index 0000000..4ecdfc3
--- /dev/null
+++ b/apps/tui/src/commands/wakeHandOff.test.ts
@@ -0,0 +1,135 @@
+// The wake word's hand-off in the terminal (P24-20 wiring): `wake.detected` → one voice take →
+// the user's next prompt → listening again.
+import { afterEach, describe, expect, it } from "vitest";
+import { type RuntimeRig, runtimeRig, settle } from "../app/testRuntime.ts";
+import { transcriptStore } from "../state/transcriptStore.ts";
+import { uiStore } from "../state/uiStore.ts";
+import {
+  type HandOffDeps,
+  VOICE_LISTEN_TIMEOUT_MS,
+  WAKE_DETECTED,
+  WakeHandOff,
+} from "./wakeHandOff.ts";
+
+let rig: RuntimeRig | null = null;
+afterEach(() => {
+  rig?.runtime.dispose();
+  rig = null;
+});
+
+const lines = (): string[] =>
+  transcriptStore.getState().messages.map((m) => `${m.role}: ${m.text}`);
+
+describe("wake word hand-off", () => {
+  it("a detection records one take, sends it as the user's prompt and listens again", async () => {
+    const order: string[] = [];
+    const r = runtimeRig({
+      handlers: {
+        "voice.listen": () => {
+          order.push("voice.listen");
+          expect(uiStore.getState().statusText).toBe("listening…");
+          return { text: "what is on my calendar", reason: "spoke" };
+        },
+        "prompt.submit": () => {
+          order.push("prompt.submit");
+          return { accepted: true };
+        },
+        "wake.resume": () => {
+          order.push("wake.resume");
+          return { ok: true };
+        },
+      },
+    });
+    rig = r;
+    await r.ready();
+    const sid = uiStore.getState().sid;
+    r.server.emit({ type: WAKE_DETECTED, phrase: "hey indus", surface: "tui" });
+    await settle(40);
+    expect(r.calls("voice.listen")).toEqual([{ session_id: sid }]);
+    expect(r.calls("prompt.submit").map((p) => p.text)).toEqual(["what is on my calendar"]);
+    // the take first; then the prompt goes out and the listener listens again
+    expect(order[0]).toBe("voice.listen");
+    expect([...order].sort()).toEqual(["prompt.submit", "voice.listen", "wake.resume"]);
+    expect(lines()).toContain("system: Heard “hey indus”. Speak now; a pause sends it.");
+    expect(lines()).toContain("user: what is on my calendar");
+    expect(uiStore.getState().statusText).not.toBe("listening…");
+  });
+
+  it("nothing said sends nothing; the listener still listens again", async () => {
+    const r = runtimeRig({
+      handlers: {
+        "voice.listen": () => ({ text: "", reason: "no_speech" }),
+        "wake.resume": () => ({ ok: true }),
+      },
+    });
+    rig = r;
+    await r.ready();
+    r.server.emit({ type: WAKE_DETECTED, phrase: "hey indus" });
+    await settle(40);
+    expect(r.calls("prompt.submit")).toEqual([]);
+    expect(lines()).toContain("system: Nothing was heard, so nothing was sent.");
+    expect(r.calls("wake.resume")).toHaveLength(1);
+  });
+});
+
+function deps(overrides: Partial<HandOffDeps> = {}) {
+  const calls: Array<{ method: string; params: unknown; timeoutMs?: number | undefined }> = [];
+  const said: string[] = [];
+  const sent: string[] = [];
+  const answers: Record<string, () => unknown> = {
+    "voice.listen": () => ({ text: "hello", reason: "spoke" }),
+    "wake.resume": () => ({ ok: true }),
+  };
+  const made: HandOffDeps = {
+    rpc: {
+      call: async (method, params, options) => {
+        calls.push({ method, params, timeoutMs: options?.timeoutMs });
+        const answer = answers[method];
+        if (answer === undefined) throw new Error(`no ${method}`);
+        return answer();
+      },
+    },
+    system: (text) => said.push(text),
+    send: (text) => sent.push(text),
+    status: () => undefined,
+    questionOpen: () => false,
+    sessionId: () => "s-1",
+    ...overrides,
+  };
+  return { made, calls, said, sent, answers };
+}
+
+describe("WakeHandOff", () => {
+  it("the take gets its own long deadline; a second detection meanwhile is ignored", async () => {
+    const { made, calls, sent } = deps();
+    const handOff = new WakeHandOff(made);
+    const first = handOff.detected({ phrase: "hey indus" });
+    expect(handOff.capturing).toBe(true);
+    await handOff.detected({ phrase: "hey indus" });
+    await first;
+    expect(calls.map((c) => c.method)).toEqual(["voice.listen", "wake.resume"]);
+    expect(calls[0]?.timeoutMs).toBe(VOICE_LISTEN_TIMEOUT_MS);
+    expect(calls[0]?.params).toEqual({ session_id: "s-1" });
+    expect(sent).toEqual(["hello"]);
+  });
+
+  it("an open question card is never recorded over", async () => {
+    const { made, calls, said, sent } = deps({ questionOpen: () => true });
+    await new WakeHandOff(made).detected({ phrase: "hey indus" });
+    expect(calls.map((c) => c.method)).toEqual(["wake.resume"]);
+    expect(said[0]).toContain("a question is waiting");
+    expect(sent).toEqual([]);
+  });
+
+  it("a failed take is reported and the listener is asked to listen again", async () => {
+    const { made, calls, said, answers } = deps();
+    answers["voice.listen"] = () => {
+      throw new Error("the microphone could not record: busy");
+    };
+    answers["wake.resume"] = () => ({ ok: false, reason: "not_owner" });
+    await new WakeHandOff(made).detected({});
+    expect(said).toContain("Voice input failed: the microphone could not record: busy");
+    expect(said.at(-1)).toBe("The wake word stopped listening; /wake on starts it again.");
+    expect(calls.at(-1)?.method).toBe("wake.resume");
+  });
+});
diff --git a/apps/tui/src/commands/wakeHandOff.ts b/apps/tui/src/commands/wakeHandOff.ts
new file mode 100644
index 0000000..ebc28b8
--- /dev/null
+++ b/apps/tui/src/commands/wakeHandOff.ts
@@ -0,0 +1,110 @@
+// The wake word's hand-off in the terminal (P24-20 wiring, D-16.799): `wake.detected` → one voice
+// take → a user turn.
+//
+// The bridge (or the attached daemon) owns the microphone the wake word listens on; a detection
+// already paused that listener. Here the renderer:
+//   1. says it heard the phrase and shows "listening…" in the status rule;
+//   2. asks for one take on that same microphone (`voice.listen`: a pause after speech ends it,
+//      silence gives up) — unless a question card is open: nothing is recorded over a question;
+//   3. sends the transcript as the user's next prompt, exactly as if typed (queued while a reply
+//      runs), or says why nothing was sent;
+//   4. always asks the listener to listen again (`wake.resume`).
+// A second detection while a take runs is ignored (the listener is paused then anyway).
+
+import { errorText, type RpcLike } from "../cards/rpcLike.ts";
+
+export const WAKE_DETECTED = "wake.detected";
+/** `wake.start` may load a model: the server allows 180 s, the call a little more. */
+export const WAKE_START_TIMEOUT_MS = 190_000;
+/** `voice.listen`: the longest take `voice.max_seconds` allows, then the transcription. */
+export const VOICE_LISTEN_TIMEOUT_MS = 3_910_000;
+
+export interface TimedRpc extends RpcLike {
+  call(method: string, params: unknown, options?: { timeoutMs?: number }): Promise<unknown>;
+}
+
+export interface HandOffDeps {
+  rpc: TimedRpc;
+  /** A system line in the transcript. */
+  system(text: string): void;
+  /** Send `text` as the user's prompt (as typed). */
+  send(text: string): void;
+  /** The status rule's text while listening (null: back to normal). */
+  status(text: string | null): void;
+  /** A question card (approval, clarify, secret) is open. */
+  questionOpen(): boolean;
+  /** The session the take is for. */
+  sessionId(): string | null;
+}
+
+interface ListenAnswer {
+  text?: unknown;
+  reason?: unknown;
+}
+
+const NOTHING: Readonly<Record<string, string>> = {
+  no_speech: "Nothing was heard, so nothing was sent.",
+  inaudible: "No words could be made out, so nothing was sent.",
+  cancel: "The recording stopped before anything was said.",
+};
+
+export class WakeHandOff {
+  private running = false;
+  private readonly deps: HandOffDeps;
+
+  constructor(deps: HandOffDeps) {
+    this.deps = deps;
+  }
+
+  get capturing(): boolean {
+    return this.running;
+  }
+
+  /** Handle one `wake.detected`; resolves once the listener was asked to listen again. */
+  async detected(event: { phrase?: unknown }): Promise<void> {
+    if (this.running) return;
+    this.running = true;
+    const { deps } = this;
+    const phrase = typeof event.phrase === "string" && event.phrase ? event.phrase : "hey indus";
+    try {
+      if (deps.questionOpen()) {
+        deps.system(`Heard “${phrase}”, but a question is waiting: answer it first.`);
+        return;
+      }
+      deps.system(`Heard “${phrase}”. Speak now; a pause sends it.`);
+      deps.status("listening…");
+      const sid = deps.sessionId();
+      let answer: ListenAnswer;
+      try {
+        answer = ((await deps.rpc.call("voice.listen", sid === null ? {} : { session_id: sid }, {
+          timeoutMs: VOICE_LISTEN_TIMEOUT_MS,
+        })) ?? {}) as ListenAnswer;
+      } catch (error) {
+        deps.system(`Voice input failed: ${errorText(error)}`);
+        return;
+      } finally {
+        deps.status(null);
+      }
+      const text = typeof answer.text === "string" ? answer.text.trim() : "";
+      if (text === "") {
+        deps.system(NOTHING[String(answer.reason)] ?? NOTHING.no_speech ?? "");
+        return;
+      }
+      deps.send(text);
+    } finally {
+      this.running = false;
+      await this.resume();
+    }
+  }
+
+  private async resume(): Promise<void> {
+    try {
+      const answer = (await this.deps.rpc.call("wake.resume", {})) as { ok?: unknown } | null;
+      if (answer?.ok === false) {
+        this.deps.system("The wake word stopped listening; /wake on starts it again.");
+      }
+    } catch (error) {
+      this.deps.system(`The wake word could not listen again: ${errorText(error)}`);
+    }
+  }
+}
