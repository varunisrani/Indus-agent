diff --git a/tests/unit/service/test_lsp_host.py b/tests/unit/service/test_lsp_host.py
new file mode 100644
index 0000000..ebdea5f
--- /dev/null
+++ b/tests/unit/service/test_lsp_host.py
@@ -0,0 +1,149 @@
+"""The host side of language servers (P24-15/16 wiring) and the project a new session joins
+(P24-14 wiring): what ``SessionService`` does with ``lsp`` and a create ``cwd``."""
+
+from __future__ import annotations
+
+import asyncio
+from pathlib import Path
+
+from indus.foundation.scope import Scope
+from indus.protocol.methods import SessionCreateParams
+from indus.service.lsp_host import LspUpkeep
+from indus.service.session_service import SessionService
+from indus.state.projects import ProjectStore
+from indus.tools.lsp import diagnostics
+from indus.tools.lsp.manager import LspSettings
+from tests.fakes.agent import fake_options
+from tests.fakes.clock import FakeClock
+from tests.fakes.model import FakeModelServer, fake_route, script_of
+
+ON = LspSettings()  # the defaults: on (the test suite turns hosts' own settings off)
+
+
+def test_services_of_one_process_share_one_tier(scope: Scope) -> None:
+    async def main() -> None:
+        first, second = LspUpkeep(scope, settings=ON), LspUpkeep(scope, settings=ON)
+        first.start()
+        checker = diagnostics.active()
+        assert checker is not None and first.manager is checker.manager
+        second.start()
+        second.start()  # once per upkeep
+        assert diagnostics.active() is checker and second.manager is first.manager
+        await first.shutdown()
+        assert diagnostics.active() is checker  # the other service still uses it
+        await first.shutdown()  # a second leave changes nothing
+        assert diagnostics.active() is checker
+        await second.shutdown()
+        assert diagnostics.active() is None and second.manager is None
+
+    asyncio.run(main())
+
+
+def test_hosts_in_tests_get_no_tier_and_lsp_off_installs_nothing(scope: Scope) -> None:
+    async def main() -> None:
+        LspUpkeep(scope).start()  # the suite's guard: settings from the scope are "off"
+        assert diagnostics.active() is None
+        upkeep = LspUpkeep(scope, settings=LspSettings(enabled=False))
+        upkeep.start()
+        upkeep.trust("/anywhere")
+        assert diagnostics.active() is None and upkeep.manager is None
+        assert await upkeep.release("/anywhere") == 0
+        await upkeep.shutdown()
+
+    asyncio.run(main())
+
+
+def test_a_session_folder_is_trusted_by_its_work_tree(scope: Scope, tmp_path: Path) -> None:
+    repo = tmp_path / "repo"
+    (repo / ".git").mkdir(parents=True)
+    (repo / "src").mkdir()
+    loose = tmp_path / "loose"
+    loose.mkdir()
+
+    async def main() -> None:
+        upkeep = LspUpkeep(scope, settings=ON)
+        upkeep.start()
+        manager = upkeep.manager
+        assert manager is not None
+        upkeep.trust(repo / "src")
+        upkeep.trust(loose)
+        assert manager.trusted(str(repo / "lib")) and manager.trusted(str(loose))
+        assert not manager.trusted(str(tmp_path / "other"))
+        await upkeep.shutdown()
+
+    asyncio.run(main())
+
+
+def test_the_service_joins_the_tier_trusts_the_folder_and_leaves_at_close(
+    scope: Scope, fake_clock: FakeClock, tmp_path: Path
+) -> None:
+    repo = tmp_path / "repo"
+    (repo / ".git").mkdir(parents=True)
+    server = FakeModelServer(script_of(), clock=fake_clock)
+    upkeep = LspUpkeep(scope, settings=ON)
+
+    async def main() -> None:
+        svc = SessionService(
+            scope,
+            fake_route(server),
+            toolsets=[],
+            options=fake_options(server, session_id=None),
+            lsp=upkeep,
+        )
+        assert diagnostics.active() is None  # nothing until a session is attached
+        await svc.create(SessionCreateParams(cwd=str(repo / "pkg")))
+        manager = upkeep.manager
+        assert manager is not None and diagnostics.active() is not None
+        assert manager.trusted(str(repo / "other"))
+        await svc.aclose()
+        assert diagnostics.active() is None
+
+    asyncio.run(main())
+
+
+def test_a_session_created_in_a_project_folder_joins_it(
+    scope: Scope, fake_clock: FakeClock, tmp_path: Path
+) -> None:
+    app = tmp_path / "app"
+    (app / "src").mkdir(parents=True)
+    store = ProjectStore(scope)
+    try:
+        made = store.create("app", folders=[app])
+    finally:
+        store.close()
+    server = FakeModelServer(script_of(), clock=fake_clock)
+
+    async def main() -> tuple[str, str, str]:
+        svc = SessionService(
+            scope, fake_route(server), toolsets=[], options=fake_options(server, session_id=None)
+        )
+        inside = await svc.create(SessionCreateParams(cwd=str(app / "src")))
+        outside = await svc.create(SessionCreateParams(cwd=str(tmp_path)))
+        bare = await svc.create(SessionCreateParams())
+        await svc.aclose()
+        return inside.session_id, outside.session_id, bare.session_id
+
+    inside, outside, bare = asyncio.run(main())
+    store = ProjectStore(scope)
+    try:
+        joined = store.session_project(inside)
+        assert joined is not None and joined.id == made.id
+        assert store.session_project(outside) is None and store.session_project(bare) is None
+    finally:
+        store.close()
+
+
+def test_a_profile_without_projects_gets_no_projects_file(
+    scope: Scope, fake_clock: FakeClock, tmp_path: Path
+) -> None:
+    server = FakeModelServer(script_of(), clock=fake_clock)
+
+    async def main() -> None:
+        svc = SessionService(
+            scope, fake_route(server), toolsets=[], options=fake_options(server, session_id=None)
+        )
+        await svc.create(SessionCreateParams(cwd=str(tmp_path)))
+        await svc.aclose()
+
+    asyncio.run(main())
+    assert not (scope.home / "projects.db").exists()
diff --git a/tests/unit/service/test_preview_requests.py b/tests/unit/service/test_preview_requests.py
new file mode 100644
index 0000000..0df63fa
--- /dev/null
+++ b/tests/unit/service/test_preview_requests.py
@@ -0,0 +1,212 @@
+"""Preview automation through server requests (P24-25 wiring, D-16.799): ``drive_preview`` and
+``annotate_preview`` ask ``preview.act`` / ``preview.read`` through the session's broker; the
+daemon's request book offers them to the desktop windows that render those kinds; the window
+showing the preview answers, the others decline (4404) and an all-decline is ``not_shown``. Only a
+session a desktop window created gets the tools."""
+
+from __future__ import annotations
+
+import asyncio
+import itertools
+import json
+from collections.abc import Callable
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+from indus.core.agent import AgentOptions
+from indus.core.persist import StateStore
+from indus.foundation.scope import Scope
+from indus.protocol.methods import SessionCreateParams
+from indus.protocol.server_requests import (
+    PERSON_REQUEST_KINDS,
+    PREVIEW_REQUEST_KINDS,
+    SERVER_REQUEST_KINDS,
+    PreviewActRequest,
+)
+from indus.service.broker import ServerRequestBroker
+from indus.service.daemon_host import DaemonSessionHost
+from indus.service.request_redelivery import (
+    NOT_SHOWN_CODE,
+    UNRENDERABLE_CODE,
+    Offer,
+    RequestBook,
+    RequestViewer,
+)
+from indus.service.session_mutations import with_preview
+from indus.service.session_service import SessionService
+from indus.service.subscriptions import capabilities_from
+from indus.service.viewers import Viewer
+from indus.state import registry
+from indus.tools import toolsets
+from indus.tools.builtin import load_builtins
+from indus.tools.builtin.preview import PREVIEW_TOOLSET, drive_preview
+from indus.tools.registry import ToolRegistry
+from indus.tools.session_registry import SessionRegistry
+from tests.fakes.agent import fake_options
+from tests.fakes.clock import FakeClock
+from tests.fakes.model import FakeModelServer, fake_route, script_of
+from tests.unit.backends._aio import aio
+
+
+async def _inline[T](fn: Callable[[], T]) -> T:
+    return fn()
+
+
+class Rig:
+    def __init__(self) -> None:
+        self.clock = FakeClock(datetime(2026, 10, 21, 9, 0, tzinfo=UTC))
+        self.book = RequestBook("s1", emit=lambda _event: None, generation=lambda: 3)
+        seqs = itertools.count(1)
+        self.broker = ServerRequestBroker(
+            session_id="s1",
+            deliver=lambda _request: None,
+            emit=lambda _event: None,
+            next_seq=lambda: next(seqs),
+            clock=self.clock,
+            book=self.book,
+        )
+        self.offers: dict[str, list[Offer]] = {}
+
+    def window(self, name: str, kinds: tuple[str, ...] = tuple(PREVIEW_REQUEST_KINDS)) -> None:
+        got = self.offers.setdefault(name, [])
+        self.book.attach(RequestViewer.of(name, kinds, got.append, can_decline=True))
+
+
+def test_kinds_a_person_answers_and_the_preview_kinds() -> None:
+    assert set(PREVIEW_REQUEST_KINDS) <= set(SERVER_REQUEST_KINDS)
+    assert set(PERSON_REQUEST_KINDS) == {"approval", "clarify", "sudo", "secret"}
+    # "server_requests" means the person kinds; a desktop window names the preview kinds itself
+    assert capabilities_from(["server_requests"]) == frozenset(PERSON_REQUEST_KINDS)
+    desktop = capabilities_from(
+        ["server_requests", "server_requests.preview.act", "server_requests.preview.read"]
+    )
+    assert desktop == frozenset(SERVER_REQUEST_KINDS)
+
+
+def test_the_window_showing_the_preview_answers() -> None:
+    async def main() -> tuple[str, Any]:
+        rig = Rig()
+        rig.window("w1")
+        rig.window("w2")
+        task = asyncio.ensure_future(
+            drive_preview(
+                {"action": "click", "selector": "button#go"}, broker=rig.broker, turn_id="t1"
+            )
+        )
+        await rig.clock.run_until_idle()
+        offered = rig.offers["w1"][0].request
+        assert isinstance(offered, PreviewActRequest)
+        assert (offered.action, offered.selector, offered.turn_id) == ("click", "button#go", "t1")
+        rig.book.refuse("w1", offered.request_id, NOT_SHOWN_CODE)  # w1 shows another session
+        rig.broker.answer(
+            offered.request_id,
+            {"kind": "preview.act", "ok": True, "result": {"detail": "clicked"}},
+        )
+        return await task, offered
+
+    out, _ = asyncio.run(main())
+    assert json.loads(out) == {"detail": "clicked", "ok": True}
+
+
+def test_a_snapshot_reads_and_a_refusal_comes_back_as_an_error() -> None:
+    async def main() -> list[str]:
+        rig = Rig()
+        rig.window("w1")
+        read = asyncio.ensure_future(drive_preview({"action": "snapshot"}, broker=rig.broker))
+        await rig.clock.run_until_idle()
+        first = rig.offers["w1"][0].request
+        assert first.kind == "preview.read"
+        rig.broker.answer(first.request_id, {"kind": "preview.read", "ok": True, "result": {}})
+        act = asyncio.ensure_future(
+            drive_preview({"action": "scroll", "dy": 300}, broker=rig.broker)
+        )
+        await rig.clock.run_until_idle()
+        second = rig.offers["w1"][1].request
+        rig.broker.answer(
+            second.request_id, {"kind": "preview.act", "ok": False, "error": "no page loaded"}
+        )
+        return [await read, await act]
+
+    snapshot, refused = asyncio.run(main())
+    assert json.loads(snapshot) == {"ok": True}
+    assert "no page loaded" in refused
+
+
+def test_every_window_declining_is_not_shown_and_no_window_is_undelivered() -> None:
+    async def main() -> list[str]:
+        rig = Rig()
+        rig.window("w1")
+        rig.window("w2")
+        task = asyncio.ensure_future(drive_preview({"action": "snapshot"}, broker=rig.broker))
+        await rig.clock.run_until_idle()
+        request_id = rig.offers["w1"][0].request.request_id
+        rig.book.refuse("w1", request_id, NOT_SHOWN_CODE)
+        rig.book.refuse("w2", request_id, NOT_SHOWN_CODE)
+        declined = await task
+        terminal_only = Rig()
+        terminal_only.window("tui", tuple(PERSON_REQUEST_KINDS))
+        nobody = await drive_preview({"action": "snapshot"}, broker=terminal_only.broker)
+        cannot = Rig()
+        cannot.window("w9")
+        task = asyncio.ensure_future(drive_preview({"action": "snapshot"}, broker=cannot.broker))
+        await cannot.clock.run_until_idle()
+        cannot.book.refuse("w9", cannot.offers["w9"][0].request.request_id, UNRENDERABLE_CODE)
+        return [declined, nobody, await task]
+
+    declined, nobody, cannot = asyncio.run(main())
+    assert "not open in a desktop window" in declined
+    assert "No desktop window is attached" in nobody
+    assert "No desktop window is attached" in cannot
+
+
+def test_a_desktop_session_gets_the_preview_tools_and_no_other_session_does() -> None:
+    shared = ToolRegistry()
+    load_builtins(shared)
+    options = AgentOptions(registry=shared)
+    shaped, chosen = with_preview(options, ["indus-gateway"])
+    own = shaped.registry
+    assert isinstance(own, SessionRegistry) and own.base is shared
+    assert own.get("drive_preview") is not None and own.get("annotate_preview") is not None
+    assert shared.get("drive_preview") is None  # never in the shared registry
+    assert chosen == ["indus-gateway", PREVIEW_TOOLSET]
+    every = toolsets.select(None, registry=own, platform="gateway").tools
+    assert {"drive_preview", "annotate_preview"} <= every
+    assert "drive_preview" not in toolsets.select(None, registry=shared, platform="gateway").tools
+    again, kept = with_preview(shaped, None)  # a rebuild keeps one copy
+    assert again.registry is own and kept is None
+
+
+@aio
+async def test_the_daemon_gives_only_window_sessions_the_preview_tools(
+    scope: Scope, tmp_path: Path
+) -> None:
+    store = registry.open_unshared(scope)
+    server = FakeModelServer(script_of(), clock=scope.clock)
+    shared = ToolRegistry()
+    load_builtins(shared)
+    service = SessionService(
+        scope,
+        fake_route(server),
+        toolsets=None,
+        options=fake_options(server, session_id=None, registry=shared),
+        store=StateStore(store),
+        lock_dir=tmp_path / "locks",
+    )
+    host = await DaemonSessionHost.open(service, store, instance_id="daemon-1", offload=_inline)
+    try:
+        made = {}
+        for source in ("gui", "tui"):
+            viewer = Viewer.of(f"v-{source}", source, send=lambda _frame: None)
+            created = await host.create(SessionCreateParams(), source=source, viewer=viewer)
+            made[source] = created.session_id
+        window = service.agent(made["gui"]).tool_names
+        terminal = service.agent(made["tui"]).tool_names
+        assert {"drive_preview", "annotate_preview"} <= set(window)
+        assert "drive_preview" not in terminal
+        # a reload (the stored row says gui) keeps them
+        await service.reload(made["gui"])
+        assert "drive_preview" in service.agent(made["gui"]).tool_names
+    finally:
+        await host.aclose()
+        store.close()
diff --git a/tests/unit/service/test_review_offers.py b/tests/unit/service/test_review_offers.py
new file mode 100644
index 0000000..8fbb361
--- /dev/null
+++ b/tests/unit/service/test_review_offers.py
@@ -0,0 +1,117 @@
+"""Suggested jobs from the background review (P24-46 wiring, D-16.799): a skill the review wrote
+that declares a blueprint becomes one pending ``usage`` suggestion; nothing is scheduled."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from typing import Any
+
+from indus.core.transcript import TranscriptRow
+from indus.cron.suggestions import SuggestionStore
+from indus.foundation.scope import Scope
+from indus.learning.review.fork import ReviewOutcome, ReviewRunner
+from indus.learning.review.summary import written_skills
+from indus.service import review_offers
+
+PING = (
+    'blueprint: {key: ping, title: Ping the service, schedule: "every {interval}m", '
+    'prompt: "Ping the service and report.", slots: [{name: every, kind: interval, default: 30}]}\n'
+)
+NEEDS_INPUT = (
+    'blueprint: {key: digest, title: Repo digest, schedule: "every 60m", '
+    'prompt: "Digest {repo}.", slots: [{name: repo, kind: text}]}\n'
+)
+
+
+def skill(scope: Scope, name: str, frontmatter: str) -> None:
+    folder = scope.home / "skills" / name
+    folder.mkdir(parents=True, exist_ok=True)
+    text = f"---\nname: {name}\ndescription: d\n{frontmatter}---\n\n# {name}\n"
+    (folder / "SKILL.md").write_text(text, encoding="utf-8")
+
+
+def call_rows(*calls: tuple[dict[str, Any], dict[str, Any]]) -> tuple[TranscriptRow, ...]:
+    """One assistant row per ``skill_manage`` call and its result row."""
+    rows: list[TranscriptRow] = []
+    for index, (args, body) in enumerate(calls):
+        ident = f"c{index}"
+        rows.append(
+            TranscriptRow(
+                role="assistant",
+                tool_calls=[
+                    {
+                        "id": ident,
+                        "type": "function",
+                        "function": {"name": "skill_manage", "arguments": json.dumps(args)},
+                    }
+                ],
+            )
+        )
+        rows.append(TranscriptRow(role="tool", tool_call_id=ident, content=json.dumps(body)))
+    return tuple(rows)
+
+
+def done(*calls: tuple[dict[str, Any], dict[str, Any]], status: str = "done") -> ReviewOutcome:
+    return ReviewOutcome(status, frozenset({"skills"}), rows=call_rows(*calls))
+
+
+def test_written_skills_counts_only_applied_writes() -> None:
+    rows = call_rows(
+        ({"action": "create", "name": "pinger"}, {"success": True}),
+        ({"action": "patch", "name": "staged"}, {"success": True, "staged": True}),
+        ({"action": "edit", "name": "failed"}, {"success": False}),
+        ({"action": "delete", "name": "gone"}, {"success": True}),
+        (
+            {
+                "operations": [
+                    {"action": "edit", "name": "batch-a"},
+                    {"action": "create", "name": "batch-b"},
+                ]
+            },
+            {"success": True, "results": [{"success": True}, {"success": True, "staged": True}]},
+        ),
+    )
+    assert written_skills(rows) == ["pinger", "batch-a"]
+
+
+def test_a_skill_the_review_wrote_offers_its_blueprint_once(scope: Scope) -> None:
+    skill(scope, "pinger", PING)
+    skill(scope, "digester", NEEDS_INPUT)
+    skill(scope, "untouched", PING.replace("key: ping", "key: other"))
+    wrote = done(
+        ({"action": "create", "name": "pinger"}, {"success": True}),
+        ({"action": "edit", "name": "digester"}, {"success": True}),
+    )
+
+    first = asyncio.run(review_offers.offer_from_review(scope, wrote))
+    again = asyncio.run(review_offers.offer_from_review(scope, wrote))
+
+    assert [(s.title, s.source) for s in first] == [("Ping the service", "usage")]
+    assert again == []  # the dedup key holds it
+    store = SuggestionStore(scope)
+    pending = store.pending()
+    assert [s.dedup_key for s in pending] == ["blueprint:pinger:ping"]
+    assert pending[0].spec["schedule"] == "every 30m"
+    store.dismiss("1")
+    assert asyncio.run(review_offers.offer_from_review(scope, wrote)) == []
+    assert store.pending() == []
+
+
+def test_nothing_is_offered_without_a_finished_skill_write(scope: Scope) -> None:
+    skill(scope, "pinger", PING)
+    create = ({"action": "create", "name": "pinger"}, {"success": True})
+    staged = ({"action": "create", "name": "pinger"}, {"success": True, "staged": True})
+    for outcome in (done(create, status="cancelled"), done(staged), done()):
+        assert asyncio.run(review_offers.offer_from_review(scope, outcome)) == []
+    assert SuggestionStore(scope).all() == []
+
+
+def test_listen_hangs_the_offer_on_the_runner(scope: Scope) -> None:
+    skill(scope, "pinger", PING)
+    runner = ReviewRunner.__new__(ReviewRunner)
+    runner.listeners = []
+    review_offers.listen(runner, scope)
+    outcome = done(({"action": "create", "name": "pinger"}, {"success": True}))
+    asyncio.run(runner._tell(outcome))  # pyright: ignore[reportPrivateUsage]
+    assert [s.source for s in SuggestionStore(scope).pending()] == ["usage"]
