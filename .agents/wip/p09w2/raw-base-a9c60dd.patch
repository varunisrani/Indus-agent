+    findings = threat_scan.scan(entry, scope="memory")
+    if not findings:
+        return entry
+    log.warning(
+        "a saved entry in %s matched %s; it is hidden in the prompt",
+        FILE_NAMES[target],
+        ", ".join(findings),
+    )
+    return placeholder(target, findings)
