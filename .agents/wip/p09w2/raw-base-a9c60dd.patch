new file mode 100644
index 0000000..2896997
--- /dev/null
+++ b/src/indus/learning/skills/bundles.py
@@ -0,0 +1,243 @@
+"""Skill bundles: ``<home>/skill-bundles/<slug>.yaml`` files that load several skills at once.
+
+File shape::
+
+    name: release-day          # optional; default = file stem; slugified into the command
+    description: Ship a release
+    skills: [git-workflow, test-first]
+    instruction: Work through the release checklist.   # optional, sent first
+
+``/<slug> [text]`` loads every listed skill in one user message, the bundle's instruction first,
+then the user's text. Missing skills are skipped and named. A bundle beats a same-slug skill.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+import threading
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation import yamlio
+from indus.foundation.fsio import atomic_write_text
+from indus.foundation.scope import Scope
+from indus.learning.skills.invoke import Expansion, ShellRunner, expand_skills
+from indus.learning.skills.resolver import SkillCatalog
+
+__all__ = [
+    "BUNDLES_DIR",
+    "Bundle",
+    "BundleError",
+    "bundle_expanders",
+    "bundles_dir",
+    "delete_bundle",
+    "expand_bundle",
+    "load_bundle",
+    "reload_bundles",
+    "save_bundle",
+    "scan_bundles",
+    "slugify",
+]
+
+log = logging.getLogger(__name__)
+
+BUNDLES_DIR = "skill-bundles"
+SUFFIXES = (".yaml", ".yml")
+FRAME = "[The user ran the /{slug} skill bundle: {names}. They are loaded in full below.]"
+BUNDLE_INSTRUCTION = "Bundle instruction: {text}"
+
+_NOT_SLUG = re.compile(r"[^a-z0-9._-]+")
+
+
+class BundleError(ValueError):
+    pass
+
+
+@dataclass(frozen=True)
+class Bundle:
+    slug: str
+    skills: tuple[str, ...]
+    description: str = ""
+    instruction: str = ""
+    path: Path | None = None
+
+
+def slugify(text: str) -> str:
+    return _NOT_SLUG.sub("-", text.strip().lower()).strip("-._")
+
+
+def bundles_dir(home: Path) -> Path:
+    return home / BUNDLES_DIR
+
+
+def _text(value: object, what: str) -> str:
+    if value is None:
+        return ""
+    if not isinstance(value, str):
+        raise BundleError(f"{what} must be text")
+    return value.strip()
+
+
+def parse_bundle(data: object, *, stem: str, path: Path | None = None) -> Bundle:
+    if not isinstance(data, Mapping):
+        raise BundleError("a bundle file must be a mapping with a 'skills' list")
+    body = cast(Mapping[str, Any], data)
+    raw_skills = body.get("skills")
+    if not isinstance(raw_skills, list) or not raw_skills:
+        raise BundleError("'skills' must be a non-empty list of skill names")
+    skills: list[str] = []
+    for item in cast(list[Any], raw_skills):
+        if not isinstance(item, str) or not item.strip():
+            raise BundleError("every entry of 'skills' must be a skill name")
+        if item.strip() not in skills:
+            skills.append(item.strip())
+    slug = slugify(_text(body.get("name"), "name") or stem)
+    if not slug:
+        raise BundleError("the bundle name gives an empty command word")
+    return Bundle(
+        slug=slug,
+        skills=tuple(skills),
+        description=_text(body.get("description"), "description"),
+        instruction=_text(body.get("instruction"), "instruction"),
+        path=path,
+    )
+
+
+def load_bundle(path: Path) -> Bundle:
+    try:
+        data = yamlio.load_safe(path)
+    except (OSError, yamlio.YamlError) as exc:
+        raise BundleError(f"cannot read {path.name}: {exc}") from exc
+    return parse_bundle(data, stem=path.stem, path=path)
+
+
+_CACHE: dict[str, tuple[tuple[tuple[str, int, int], ...], dict[str, Bundle]]] = {}
+_CACHE_LOCK = threading.Lock()
+
+
+def _signature(folder: Path) -> tuple[tuple[str, int, int], ...]:
+    rows: list[tuple[str, int, int]] = []
+    try:
+        entries = sorted(folder.iterdir())
+    except OSError:
+        return ()
+    for entry in entries:
+        if entry.suffix not in SUFFIXES or not entry.is_file():
+            continue
+        st = entry.stat()
+        rows.append((entry.name, st.st_mtime_ns, st.st_size))
+    return tuple(rows)
+
+
+def reload_bundles() -> None:
+    with _CACHE_LOCK:
+        _CACHE.clear()
+
+
+def scan_bundles(home: Path) -> dict[str, Bundle]:
+    """Every valid bundle by slug (invalid files are logged and skipped)."""
+    folder = bundles_dir(home)
+    sig = _signature(folder)
+    key = str(folder)
+    with _CACHE_LOCK:
+        hit = _CACHE.get(key)
+        if hit is not None and hit[0] == sig:
+            return dict(hit[1])
+    found: dict[str, Bundle] = {}
+    for name, _, _ in sig:
+        path = folder / name
+        try:
+            bundle = load_bundle(path)
+        except BundleError as exc:
+            log.warning("skill bundle %s skipped: %s", path, exc)
+            continue
+        if bundle.slug in found:
+            log.warning("skill bundle %s skipped: /%s is already defined", path, bundle.slug)
+            continue
+        found[bundle.slug] = bundle
+    with _CACHE_LOCK:
+        _CACHE[key] = (sig, found)
+    return dict(found)
+
+
+def save_bundle(
+    home: Path,
+    name: str,
+    skills: list[str],
+    *,
+    description: str = "",
+    instruction: str = "",
+    overwrite: bool = False,
+) -> Path:
+    data: dict[str, Any] = {"name": name, "skills": skills}
+    if description:
+        data["description"] = description
+    if instruction:
+        data["instruction"] = instruction
+    bundle = parse_bundle(data, stem=name)
+    folder = bundles_dir(home)
+    path = folder / f"{bundle.slug}.yaml"
+    existing = scan_bundles(home).get(bundle.slug)
+    if (path.exists() or existing is not None) and not overwrite:
+        raise BundleError(f"bundle /{bundle.slug} already exists; use --force to replace it")
+    folder.mkdir(parents=True, exist_ok=True)
+    atomic_write_text(path, yamlio.dump_plain(data))
+    reload_bundles()
+    return path
+
+
+def delete_bundle(home: Path, name: str) -> Path:
+    slug = slugify(name)
+    bundle = scan_bundles(home).get(slug)
+    if bundle is None or bundle.path is None:
+        raise BundleError(f"no bundle named {name!r}")
+    bundle.path.unlink()
+    reload_bundles()
+    return bundle.path
+
+
+def expand_bundle(
+    bundle: Bundle,
+    instruction: str,
+    *,
+    scope: Scope,
+    session_id: str | None = None,
+    catalog: SkillCatalog | None = None,
+    runner: ShellRunner | None = None,
+) -> Expansion | None:
+    said = "\n".join(
+        part
+        for part in (
+            BUNDLE_INSTRUCTION.format(text=bundle.instruction) if bundle.instruction else "",
+            instruction.strip(),
+        )
+        if part
+    )
+    frame = FRAME.format(slug=bundle.slug, names=", ".join(bundle.skills))
+    return expand_skills(
+        list(bundle.skills),
+        said,
+        scope=scope,
+        session_id=session_id,
+        catalog=catalog,
+        runner=runner,
+        frame=frame,
+        instruction_first=True,
+    )
+
+
+def bundle_expanders(
+    scope: Scope, session_id: str | None = None
+) -> dict[str, Callable[[str], Expansion | None]]:
+    """``{slug: expander}`` for ``CommandTable.bundles``."""
+    out: dict[str, Callable[[str], Expansion | None]] = {}
+    for slug, bundle in scan_bundles(scope.home).items():
+
+        def run(text: str, _bundle: Bundle = bundle) -> Expansion | None:
+            return expand_bundle(_bundle, text, scope=scope, session_id=session_id)
+
+        out[slug] = run
+    return out
diff --git a/src/indus/learning/skills/format.py b/src/indus/learning/skills/format.py
new file mode 100644
index 0000000..9d5eb20
--- /dev/null
+++ b/src/indus/learning/skills/format.py
@@ -0,0 +1,396 @@
+"""The skill file format: frontmatter model, hard limits on agent writes, and visibility.
+
+A skill is a folder ``<root>/[category/]<name>/`` holding ``SKILL.md``: YAML frontmatter between
+two ``---`` fences, then a Markdown body. Optional folders beside it: ``references/``,
+``templates/``, ``scripts/``, ``examples/`` and ``assets/``. A category folder may carry a
+``DESCRIPTION.md`` whose frontmatter ``description`` labels the category.
+
+Field names follow the agentskills.io layout; everything specific to this product lives under
+``metadata.indus``. Unknown keys are kept (``extra="allow"``) so a skill written for another tool
+still loads.
+
+Visibility answers "should this session be offered the skill"; it never blocks an explicit load by
+path. Each condition is independent and all must pass:
+
+- ``platforms``: host OS names (``macos``, ``linux``, ``windows``); absent = every OS;
+- ``metadata.indus.requires_toolsets`` / ``requires_tools``: hidden while any is absent;
+- ``metadata.indus.fallback_for_toolsets`` / ``fallback_for_tools``: hidden while any is present;
+- ``environments``: shown when any tag is active; a tag nobody can detect counts as active;
+- ``requires_apps``: shown only when every app is offerable; an app nobody declared hides it;
+- ``metadata.indus.session_platforms``: shown only on those surfaces (when the surface is known).
+"""
+
+from __future__ import annotations
+
+import re
+import sys
+from collections.abc import Callable, Iterable, Mapping
+from dataclasses import dataclass, field
+from pathlib import Path, PurePosixPath
+from typing import Any, cast
+
+from pydantic import BaseModel, ConfigDict, Field, ValidationError, field_validator
+
+from indus.foundation import yamlio
+
+__all__ = [
+    "CATEGORY_FILE",
+    "LAYOUT_DIRS",
+    "MAX_DESCRIPTION_CHARS",
+    "MAX_NAME_CHARS",
+    "MAX_SKILL_CHARS",
+    "MAX_SUPPORT_BYTES",
+    "NAME_PATTERN",
+    "SKILL_FILE",
+    "WRITABLE_DIRS",
+    "ConfigVar",
+    "EnvVarDecl",
+    "IndusMetadata",
+    "ParsedSkill",
+    "SkillFormatError",
+    "SkillFrontmatter",
+    "SkillMetadata",
+    "VisibilityContext",
+    "check_category",
+    "check_name",
+    "check_skill_text",
+    "check_support_path",
+    "check_support_size",
+    "hidden_reason",
+    "parse_skill",
+    "split_frontmatter",
+    "visible",
+]
+
+SKILL_FILE = "SKILL.md"
+CATEGORY_FILE = "DESCRIPTION.md"
+MAX_NAME_CHARS = 64
+MAX_DESCRIPTION_CHARS = 1024
+MAX_SKILL_CHARS = 100_000
+MAX_SUPPORT_BYTES = 1024 * 1024
+NAME_PATTERN = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
+# Folders an agent may write support files into.
+WRITABLE_DIRS: tuple[str, ...] = ("references", "templates", "scripts", "assets")
+# Every optional folder of the layout (readable through skill_view).
+LAYOUT_DIRS: tuple[str, ...] = ("references", "templates", "scripts", "examples", "assets")
+
+_OS_PREFIX = {"macos": "darwin", "darwin": "darwin", "linux": "linux", "windows": "win32"}
+_FENCE_END = re.compile(r"^---[ \t]*$", re.MULTILINE)
+
+
+class SkillFormatError(ValueError):
+    """A skill text or path breaks a format rule; ``problems`` lists each one."""
+
+    def __init__(self, problems: Iterable[str]) -> None:
+        self.problems: tuple[str, ...] = tuple(problems)
+        super().__init__("; ".join(self.problems) or "invalid skill")
+
+
+def _as_list(value: object) -> object:
+    """A single string where a list is expected becomes a one-item list."""
+    if isinstance(value, str):
+        return [value] if value.strip() else []
+    return value
+
+
+class _Model(BaseModel):
+    model_config = ConfigDict(extra="allow", populate_by_name=True)
+
+
+class EnvVarDecl(_Model):
+    """An environment variable the skill needs (``required_environment_variables``)."""
+
+    name: str
+    prompt: str | None = None
+    help: str | None = None
+    required_for: str | None = None
+
+    @field_validator("name")
+    @classmethod
+    def _name_shape(cls, value: str) -> str:
+        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
+            raise ValueError(f"{value!r} is not an environment variable name")
+        return value
+
+
+class ConfigVar(_Model):
+    """A setting the skill reads, stored under ``skills.config.<key>``."""
+
+    key: str
+    description: str
+    default: Any = None
+    prompt: str | None = None
+
+
+class IndusMetadata(_Model):
+    tags: list[str] = Field(default_factory=list[str])
+    category: str | None = None
+    fallback_for_toolsets: list[str] = Field(default_factory=list[str])
+    requires_toolsets: list[str] = Field(default_factory=list[str])
+    fallback_for_tools: list[str] = Field(default_factory=list[str])
+    requires_tools: list[str] = Field(default_factory=list[str])
+    session_platforms: list[str] = Field(default_factory=list[str])
+    config: list[ConfigVar] = Field(default_factory=list[ConfigVar])
+    blueprint: Any = None
+
+    @field_validator(
+        "tags",
+        "fallback_for_toolsets",
+        "requires_toolsets",
+        "fallback_for_tools",
+        "requires_tools",
+        "session_platforms",
+        mode="before",
+    )
+    @classmethod
+    def _listify(cls, value: object) -> object:
+        return _as_list(value)
+
+    @field_validator("config", mode="before")
+    @classmethod
+    def _config_list(cls, value: object) -> object:
+        return [value] if isinstance(value, Mapping) else value
+
+
+class SkillMetadata(_Model):
+    indus: IndusMetadata | None = None
+
+
+class SkillFrontmatter(_Model):
+    name: str
+    description: str
+    version: str | None = None
+    author: str | None = None
+    license: str | None = None
+    platforms: list[str] = Field(default_factory=list[str])
+    environments: list[str] = Field(default_factory=list[str])
+    requires_apps: list[str] = Field(default_factory=list[str])
+    required_environment_variables: list[EnvVarDecl] = Field(default_factory=list[EnvVarDecl])
+    metadata: SkillMetadata | None = None
+
+    @field_validator("platforms", "environments", "requires_apps", mode="before")
+    @classmethod
+    def _listify(cls, value: object) -> object:
+        return _as_list(value)
+
+    @field_validator("version", mode="before")
+    @classmethod
+    def _version_text(cls, value: object) -> object:
+        return str(value) if isinstance(value, int | float) else value
+
+    @property
+    def indus(self) -> IndusMetadata:
+        """``metadata.indus`` (an empty one when absent)."""
+        if self.metadata is not None and self.metadata.indus is not None:
+            return self.metadata.indus
+        return IndusMetadata()
+
+
+@dataclass(frozen=True)
+class ParsedSkill:
+    frontmatter: SkillFrontmatter
+    raw: dict[str, Any]
+    body: str
+    text: str
+
+
+# -- parsing ------------------------------------------------------------------------------------
+
+
+def split_frontmatter(text: str) -> tuple[dict[str, Any], str]:
+    """``(frontmatter mapping, body)``. Raises ``SkillFormatError`` when the fences or the YAML
+    are broken; text without a leading fence gives ``({}, text)``."""
+    content = text.removeprefix("﻿")
+    first, _, rest = content.partition("\n")
+    if first.rstrip() != "---":
+        return {}, content
+    end = _FENCE_END.search(rest)
+    if end is None:
+        raise SkillFormatError(["frontmatter has no closing '---' line"])
+    block = rest[: end.start()]
+    body = rest[end.end() :].removeprefix("\n")
+    try:
+        loaded = yamlio.load_safe(block) if block.strip() else {}
+    except yamlio.YamlError as exc:
+        raise SkillFormatError([f"frontmatter is not valid YAML: {exc}"]) from exc
+    if not isinstance(loaded, dict):
+        raise SkillFormatError(["frontmatter must be a mapping of keys to values"])
+    return cast(dict[str, Any], loaded), body
+
+
+def _validation_problems(exc: ValidationError) -> list[str]:
+    out: list[str] = []
+    for err in exc.errors():
+        where = ".".join(str(p) for p in err["loc"]) or "frontmatter"
+        out.append(f"{where}: {err['msg']}")
+    return out
+
+
+def parse_skill(text: str) -> ParsedSkill:
+    """Parse ``SKILL.md`` text into a validated frontmatter and body (no size limits here)."""
+    raw, body = split_frontmatter(text)
+    if not raw:
+        raise SkillFormatError(["SKILL.md must start with a '---' frontmatter block"])
+    try:
+        frontmatter = SkillFrontmatter.model_validate(raw)
+    except ValidationError as exc:
+        raise SkillFormatError(_validation_problems(exc)) from exc
+    return ParsedSkill(frontmatter=frontmatter, raw=raw, body=body, text=text)
+
+
+# -- hard limits on agent writes ----------------------------------------------------------------
+
+
+def check_name(name: str) -> str | None:
+    """Why ``name`` cannot name a new skill, or None when it can."""
+    if not name:
+        return "a skill name is required"
+    if len(name) > MAX_NAME_CHARS:
+        return f"skill name is {len(name)} characters; the limit is {MAX_NAME_CHARS}"
+    if not NAME_PATTERN.match(name):
+        return (
+            f"skill name {name!r} is not allowed: use lowercase letters, digits, '.', '_' and "
+            "'-', starting with a letter or digit"
+        )
+    return None
+
+
+def check_category(category: str | None) -> str | None:
+    """Why ``category`` cannot hold a new skill (one path segment, same shape as a name)."""
+    if category is None or category == "":
+        return None
+    problem = check_name(category)
+    return None if problem is None else problem.replace("skill name", "category")
+
+
+def check_skill_text(text: str, *, expected_name: str | None = None) -> ParsedSkill:
+    """Validate a ``SKILL.md`` an agent is about to write; raises with every problem found."""
+    problems: list[str] = []
+    if len(text) > MAX_SKILL_CHARS:
+        problems.append(f"SKILL.md is {len(text):,} characters; the limit is {MAX_SKILL_CHARS:,}")
+    try:
+        parsed = parse_skill(text)
+    except SkillFormatError as exc:
+        raise SkillFormatError([*problems, *exc.problems]) from exc
+    fm = parsed.frontmatter
+    if not fm.description.strip():
+        problems.append("description must not be empty")
+    if len(fm.description) > MAX_DESCRIPTION_CHARS:
+        problems.append(
+            f"description is {len(fm.description):,} characters; the limit is "
+            f"{MAX_DESCRIPTION_CHARS:,}"
+        )
+    name_problem = check_name(fm.name)
+    if name_problem is not None:
+        problems.append(name_problem)
+    elif expected_name is not None and fm.name != expected_name:
+        problems.append(f"frontmatter name {fm.name!r} does not match the skill {expected_name!r}")
+    if not parsed.body.strip():
+        problems.append("SKILL.md has no body after the frontmatter")
+    if problems:
+        raise SkillFormatError(problems)
+    return parsed
+
+
+def check_support_path(file_path: str) -> PurePosixPath:
+    """The normalised relative path of a support file an agent may write, or raise."""
+    raw = file_path.strip().replace("\\", "/")
+    if not raw:
+        raise SkillFormatError(["file_path is required"])
+    rel = PurePosixPath(raw)
+    if rel.is_absolute() or re.match(r"^[A-Za-z]:", raw):
+        raise SkillFormatError([f"file_path {file_path!r} must be relative to the skill folder"])
+    if any(part in ("..", ".") for part in raw.split("/")):
+        raise SkillFormatError([f"file_path {file_path!r} may not contain '.' or '..' segments"])
+    if len(rel.parts) < 2 or rel.parts[0] not in WRITABLE_DIRS:
+        allowed = ", ".join(f"{d}/" for d in WRITABLE_DIRS)
+        raise SkillFormatError([f"support files go under {allowed}; got {file_path!r}"])
+    return rel
+
+
+def check_support_size(data: bytes | str) -> None:
+    size = len(data.encode("utf-8")) if isinstance(data, str) else len(data)
+    if size > MAX_SUPPORT_BYTES:
+        raise SkillFormatError(
+            [f"support file is {size:,} bytes; the limit is {MAX_SUPPORT_BYTES:,} (1 MiB)"]
+        )
+
+
+# -- visibility ---------------------------------------------------------------------------------
+
+
+def _default_environment(tag: str) -> bool | None:
+    if tag in ("docker", "container"):
+        return Path("/.dockerenv").exists() or Path("/run/.containerenv").exists()
+    return None
+
+
+def _no_apps(_name: str) -> bool | None:
+    return None
+
+
+@dataclass(frozen=True)
+class VisibilityContext:
+    """What the current session offers. ``environment`` answers True/False for a tag it knows and
+    None for one it does not (shown); ``app_offerable`` likewise, but None hides the skill.
+    ``tools_known`` False skips the tool and toolset conditions (a caller that cannot see the
+    session's tool array)."""
+
+    os_platform: str = field(default_factory=lambda: sys.platform)
+    toolsets: frozenset[str] = frozenset()
+    tools: frozenset[str] = frozenset()
+    tools_known: bool = True
+    session_platform: str | None = None
+    environment: Callable[[str], bool | None] = _default_environment
+    app_offerable: Callable[[str], bool | None] = _no_apps
+
+
+def _matches_os(platforms: list[str], current: str) -> bool:
+    if not platforms:
+        return True
+    for name in platforms:
+        key = name.strip().lower()
+        if current.startswith(_OS_PREFIX.get(key, key)):
+            return True
+    return False
+
+
+def _tool_reason(meta: IndusMetadata, ctx: VisibilityContext) -> str | None:
+    missing_sets = [t for t in meta.requires_toolsets if t not in ctx.toolsets]
+    if missing_sets:
+        return f"needs toolset {missing_sets[0]}"
+    missing_tools = [t for t in meta.requires_tools if t not in ctx.tools]
+    if missing_tools:
+        return f"needs tool {missing_tools[0]}"
+    present_sets = [t for t in meta.fallback_for_toolsets if t in ctx.toolsets]
+    if present_sets:
+        return f"fallback while toolset {present_sets[0]} is on"
+    present_tools = [t for t in meta.fallback_for_tools if t in ctx.tools]
+    if present_tools:
+        return f"fallback while tool {present_tools[0]} is on"
+    return None
+
+
+def hidden_reason(fm: SkillFrontmatter, ctx: VisibilityContext) -> str | None:
+    """Why the skill is not offered in ``ctx``, or None when it is."""
+    meta = fm.indus
+    if not _matches_os(fm.platforms, ctx.os_platform):
+        return f"made for {', '.join(fm.platforms)}"
+    reason = _tool_reason(meta, ctx) if ctx.tools_known else None
+    if reason is not None:
+        return reason
+    tags = [t.strip().lower() for t in fm.environments if t.strip()]
+    if tags and not any(ctx.environment(tag) is not False for tag in tags):
+        return f"only for environment {', '.join(tags)}"
+    for app in fm.requires_apps:
+        if ctx.app_offerable(app.strip()) is not True:
+            return f"needs app {app}"
+    surfaces = [s.strip().lower() for s in meta.session_platforms if s.strip()]
+    platform = ctx.session_platform
+    if surfaces and platform is not None and platform.lower() not in surfaces:
+        return f"only on {', '.join(surfaces)}"
+    return None
+
+
+def visible(fm: SkillFrontmatter, ctx: VisibilityContext) -> bool:
+    return hidden_reason(fm, ctx) is None
diff --git a/src/indus/learning/skills/invoke.py b/src/indus/learning/skills/invoke.py
new file mode 100644
index 0000000..822edda
--- /dev/null
+++ b/src/indus/learning/skills/invoke.py
@@ -0,0 +1,424 @@
+"""Skills as slash commands, preprocessing, and auto-load (P09-09).
+
+``/skill-a /skill-b do the thing`` becomes one new user message: a frame naming what was run, each
+skill's body in a ``<skill>`` block, a skill-config block for settings the skill declares, then the
+user's instruction. Up to ``MAX_STACKED`` leading skill words are taken; the first word that is not
+an installed skill (or repeats one) ends the stack and starts the instruction. The system prompt is
+never touched.
+
+Preprocessing of each body: ``${INDUS_SKILL_DIR}`` / ``${INDUS_SESSION_ID}`` are replaced when
+``skills.template_vars`` is on (default); ``!`command``` snippets run only when
+``skills.inline_shell`` is on (default off), each with a ``INLINE_SHELL_TIMEOUT_S`` limit, in the
+skill folder, with the child environment from ``safety.child_env``, and never for community hub
+skills.
+
+``skills.auto_load`` (and the ``-s/--skill`` preload list) load named skills into a block appended
+to the prompt when it is first built; missing names warn once and are skipped, and
+``INDUS_IGNORE_RULES`` turns auto-load off.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+import subprocess
+import threading
+from collections.abc import Callable, Iterable, Mapping, Sequence
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from indus.foundation.scope import Scope
+from indus.learning.skills.format import ConfigVar, VisibilityContext, split_frontmatter
+from indus.learning.skills.resolver import (
+    SkillCatalog,
+    SkillError,
+    SkillRecord,
+    load_catalog,
+    skills_setting,
+)
+from indus.learning.skills.usage import HUB_LOCK, usage_for
+from indus.learning.skills.view_tools import linked_files
+from indus.platform.locate import which
+from indus.safety.child_env import child_env
+
+__all__ = [
+    "INLINE_SHELL_TIMEOUT_S",
+    "MAX_STACKED",
+    "CommandTable",
+    "Expansion",
+    "ShellRunner",
+    "auto_load_block",
+    "expand_skills",
+    "is_community_skill",
+    "preprocess",
+    "skill_command_names",
+    "split_stack",
+]
+
+log = logging.getLogger(__name__)
+
+MAX_STACKED = 5
+INLINE_SHELL_TIMEOUT_S = 10.0
+INLINE_OUTPUT_MAX = 4000
+IGNORE_RULES_ENV = "INDUS_IGNORE_RULES"
+
+_TEMPLATE = re.compile(r"\$\{(INDUS_SKILL_DIR|INDUS_SESSION_ID)\}")
+_INLINE = re.compile(r"!`([^`\n]+)`")
+
+ShellRunner = Callable[[str, Path, float], str]
+"""``(command, working folder, timeout seconds) -> output``; raises ``TimeoutError`` on time-out."""
+
+FRAME_ONE = (
+    "[The user ran the /{names} skill. It is loaded in full below; follow it for this request.]"
+)
+FRAME_MANY = (
+    "[The user ran these skills together: {names}. They are loaded in full below; follow them "
+    "for this request.]"
+)
+INSTRUCTION = "User instruction: {text}"
+NO_INSTRUCTION = (
+    "User instruction: none given. Apply the skill to the conversation so far, or ask what the "
+    "user needs."
+)
+MISSING_NOTE = "[Not loaded (not installed or not available here): {names}]"
+AUTO_LOAD_HEADING = "## Loaded skills"
+AUTO_LOAD_LEAD = (
+    "These skills are loaded for the whole session ({source}); follow them wherever they apply."
+)
+
+_WARNED: set[tuple[str, str]] = set()
+_WARNED_LOCK = threading.Lock()
+
+
+@dataclass(frozen=True)
+class Expansion:
+    text: str
+    loaded: tuple[str, ...] = ()
+    missing: tuple[str, ...] = ()
+
+
+# -- parsing ------------------------------------------------------------------------------------
+
+
+def split_stack(
+    text: str, is_skill: Callable[[str], bool], *, limit: int = MAX_STACKED
+) -> tuple[list[str], str] | None:
+    """``(skill names, instruction)`` for leading ``/skill`` words, or None when there are none."""
+    names: list[str] = []
+    rest = text.lstrip()
+    while len(names) < limit and rest.startswith("/"):
+        word = rest.split(None, 1)[0]
+        name = word[1:].lower()
+        if not name or "/" in name or name in names or not is_skill(name):
+            break
+        names.append(name)
+        rest = rest[len(word) :].lstrip()
+    if not names:
+        return None
+    return names, rest.strip()
+
+
+def skill_command_names(
+    catalog: SkillCatalog, ctx: VisibilityContext | None = None
+) -> dict[str, str]:
+    """``{command: description}`` for each skill a slash word can run (not ambiguous names)."""
+    out: dict[str, str] = {}
+    for rec in catalog.visible(ctx):
+        if rec.status != "unique":
+            continue
+        out.setdefault(rec.name.lower(), rec.description)
+    return out
+
+
+# -- preprocessing ------------------------------------------------------------------------------
+
+
+def is_community_skill(scope: Scope, rec: SkillRecord) -> bool:
+    """True for a hub skill whose lock row says ``trust: community`` (P13 owns the hub)."""
+    try:
+        data = json.loads((scope.home / "skills" / HUB_LOCK).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return False
+    if isinstance(data, dict) and isinstance(data.get("installed"), dict):
+        data = data["installed"]
+    row = data.get(rec.name) if isinstance(data, dict) else None  # pyright: ignore[reportUnknownMemberType, reportUnknownVariableType]
+    return isinstance(row, dict) and row.get("trust") == "community"  # pyright: ignore[reportUnknownMemberType]
+
+
+def default_runner(scope: Scope) -> ShellRunner:
+    def run(command: str, cwd: Path, timeout: float) -> str:
+        bash = which("bash") or "bash"
+        try:
+            done = subprocess.run(
+                [bash, "-c", command],
+                cwd=str(cwd),
+                env=child_env(scope),
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+                timeout=timeout,
+                stdin=subprocess.DEVNULL,
+                check=False,
+            )
+        except subprocess.TimeoutExpired as exc:
+            raise TimeoutError(command) from exc
+        output = (done.stdout or "").rstrip("\n") or (done.stderr or "").rstrip("\n")
+        if done.returncode != 0 and not output:
+            return f"[inline command exited {done.returncode} with no output: {command}]"
+        return output
+
+    return run
+
+
+def _run_snippet(runner: ShellRunner, command: str, cwd: Path) -> str:
+    try:
+        output = runner(command, cwd, INLINE_SHELL_TIMEOUT_S)
+    except TimeoutError:
+        return f"[inline command timed out after {INLINE_SHELL_TIMEOUT_S:g} s: {command}]"
+    except FileNotFoundError:
+        return "[inline command not run: bash was not found]"
+    except Exception as exc:
+        return f"[inline command failed: {type(exc).__name__}: {exc}]"
+    if len(output) > INLINE_OUTPUT_MAX:
+        output = output[:INLINE_OUTPUT_MAX] + " [output cut]"
+    return output
+
+
+def preprocess(
+    text: str,
+    *,
+    skill_dir: Path,
+    session_id: str | None,
+    template_vars: bool = True,
+    inline_shell: bool = False,
+    runner: ShellRunner | None = None,
+) -> str:
+    """Apply template tokens and (when allowed) inline shell snippets to a skill body."""
+    out = text
+    if template_vars:
+        values = {"INDUS_SKILL_DIR": str(skill_dir), "INDUS_SESSION_ID": session_id or ""}
+        out = _TEMPLATE.sub(lambda m: values[m.group(1)] or m.group(0), out)
+    if inline_shell and runner is not None and "!`" in out:
+        out = _INLINE.sub(
+            lambda m: (
+                _run_snippet(runner, m.group(1).strip(), skill_dir) if m.group(1).strip() else ""
+            ),
+            out,
+        )
+    return out
+
+
+# -- loading ------------------------------------------------------------------------------------
+
+
+def _config_lines(scope: Scope, declared: Sequence[ConfigVar]) -> list[str]:
+    lines: list[str] = []
+    for var in declared:
+        value = skills_setting(scope, f"skills.config.{var.key}")
+        if value is None:
+            value = var.default
+        if value is None:
+            continue
+        lines.append(f"- {var.key}: {value}")
+    return lines
+
+
+@dataclass
+class _Loader:
+    scope: Scope
+    session_id: str | None
+    runner: ShellRunner | None = None
+    template_vars: bool = True
+    inline_shell: bool = False
+    used: list[str] = field(default_factory=list[str])
+
+    @classmethod
+    def for_scope(cls, scope: Scope, session_id: str | None, runner: ShellRunner | None) -> _Loader:
+        inline = skills_setting(scope, "skills.inline_shell") is True
+        return cls(
+            scope=scope,
+            session_id=session_id,
+            runner=runner if runner is not None else (default_runner(scope) if inline else None),
+            template_vars=skills_setting(scope, "skills.template_vars") is not False,
+            inline_shell=inline,
+        )
+
+    def block(self, rec: SkillRecord) -> str:
+        raw = rec.skill_md.read_text(encoding="utf-8")
+        _, body = split_frontmatter(raw)
+        body = preprocess(
+            body.strip(),
+            skill_dir=rec.skill_dir,
+            session_id=self.session_id,
+            template_vars=self.template_vars,
+            inline_shell=self.inline_shell and not is_community_skill(self.scope, rec),
+            runner=self.runner,
+        )
+        parts = [f'<skill name="{rec.name}" path="{rec.skill_dir}">', body]
+        files = [f for group in linked_files(rec.skill_dir).values() for f in group]
+        if files:
+            parts.append(
+                "Support files (open with skill_view(name, file_path)): " + ", ".join(files)
+            )
+        parts.append("</skill>")
+        fm = rec.frontmatter
+        config = _config_lines(self.scope, fm.indus.config) if fm is not None else []
+        text = "\n".join(parts)
+        if config:
+            text += f"\n[Skill config for {rec.name}:\n" + "\n".join(config) + "\n]"
+        self.used.append(rec.name)
+        return text
+
+    def bump(self) -> None:
+        usage = usage_for(self.scope)
+        for name in self.used:
+            usage.bump_use(name)
+
+
+def _load_blocks(
+    catalog: SkillCatalog, names: Iterable[str], loader: _Loader
+) -> tuple[list[str], list[str], list[str]]:
+    blocks: list[str] = []
+    loaded: list[str] = []
+    missing: list[str] = []
+    for name in names:
+        try:
+            rec = catalog.resolve(name)
+            blocks.append(loader.block(rec))
+        except (SkillError, OSError, UnicodeDecodeError) as exc:
+            log.info("skill %s not loaded: %s", name, exc)
+            missing.append(name)
+            continue
+        loaded.append(rec.name)
+    return blocks, loaded, missing
+
+
+def expand_skills(
+    names: Sequence[str],
+    instruction: str,
+    *,
+    scope: Scope,
+    session_id: str | None = None,
+    catalog: SkillCatalog | None = None,
+    runner: ShellRunner | None = None,
+    frame: str | None = None,
+    instruction_first: bool = False,
+) -> Expansion | None:
+    """One user message loading ``names``; None when none of them could be loaded."""
+    cat = catalog if catalog is not None else load_catalog(scope)
+    loader = _Loader.for_scope(scope, session_id, runner)
+    blocks, loaded, missing = _load_blocks(cat, names, loader)
+    if not blocks:
+        return None
+    if frame is None:
+        frame = (
+            FRAME_ONE.format(names=loaded[0])
+            if len(loaded) == 1
+            else FRAME_MANY.format(names=", ".join(f"/{n}" for n in loaded))
+        )
+    said = INSTRUCTION.format(text=instruction.strip()) if instruction.strip() else NO_INSTRUCTION
+    head = [frame]
+    if instruction_first:
+        head.append(said)
+    if missing:
+        head.append(MISSING_NOTE.format(names=", ".join(missing)))
+    pieces = ["\n".join(head), *blocks]
+    if not instruction_first:
+        pieces.append(said)
+    loader.bump()
+    return Expansion(text="\n\n".join(pieces), loaded=tuple(loaded), missing=tuple(missing))
+
+
+# -- auto-load ----------------------------------------------------------------------------------
+
+
+def _warn_missing_once(scope: Scope, name: str, source: str) -> None:
+    key = (str(scope.home), f"{source}:{name}")
+    with _WARNED_LOCK:
+        if key in _WARNED:
+            return
+        _WARNED.add(key)
+    log.warning("%s skill %r is not installed or not available; skipped", source, name)
+
+
+def auto_load_block(
+    scope: Scope,
+    *,
+    session_id: str | None = None,
+    extra: Sequence[str] = (),
+    catalog: SkillCatalog | None = None,
+    runner: ShellRunner | None = None,
+) -> str:
+    """The prompt block for ``skills.auto_load`` plus ``extra`` (the ``-s`` preload list)."""
+    configured: list[str] = []
+    if not scope.env.get(IGNORE_RULES_ENV):
+        raw = skills_setting(scope, "skills.auto_load")
+        if isinstance(raw, list):
+            configured = [str(n).strip() for n in raw if str(n).strip()]  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+    wanted: list[str] = []
+    for name in [*configured, *extra]:
+        if name not in wanted:
+            wanted.append(name)
+    if not wanted:
+        return ""
+    cat = catalog if catalog is not None else load_catalog(scope)
+    loader = _Loader.for_scope(scope, session_id, runner)
+    blocks, _loaded, missing = _load_blocks(cat, wanted, loader)
+    for name in missing:
+        _warn_missing_once(scope, name, "auto-load" if name in configured else "preload")
+    if not blocks:
+        return ""
+    loader.bump()
+    source = "skills.auto_load" if not extra else "loaded at start"
+    return "\n\n".join([AUTO_LOAD_HEADING, AUTO_LOAD_LEAD.format(source=source), *blocks])
+
+
+def reset_warnings() -> None:
+    with _WARNED_LOCK:
+        _WARNED.clear()
+
+
+# -- the command table --------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class CommandTable:
+    """Runnable skill and bundle commands for one surface; a bundle wins over a same-slug skill.
+
+    ``bundles`` maps a slug to an expander ``(instruction) -> Expansion | None`` (P09-10).
+    """
+
+    skills: Mapping[str, str]
+    bundles: Mapping[str, Callable[[str], Expansion | None]] = field(
+        default_factory=dict[str, Callable[[str], Expansion | None]]
+    )
+
+    def names(self) -> dict[str, str]:
+        out = {name: f"skill: {desc}" if desc else "skill" for name, desc in self.skills.items()}
+        out.update({slug: "skill bundle" for slug in self.bundles})
+        return out
+
+    def run(
+        self,
+        text: str,
+        *,
+        scope: Scope,
+        session_id: str | None = None,
+        catalog: SkillCatalog | None = None,
+        runner: ShellRunner | None = None,
+    ) -> Expansion | None:
+        """The expansion for slash ``text``, or None when its first word is not ours."""
+        stripped = text.lstrip()
+        first = stripped.split(None, 1)[0][1:].lower() if stripped.startswith("/") else ""
+        if first in self.bundles:
+            rest = stripped[len(first) + 1 :].strip()
+            return self.bundles[first](rest)
+        split = split_stack(stripped, lambda n: n in self.skills and n not in self.bundles)
+        if split is None:
+            return None
+        names, instruction = split
+        return expand_skills(
+            names, instruction, scope=scope, session_id=session_id, catalog=catalog, runner=runner
+        )
