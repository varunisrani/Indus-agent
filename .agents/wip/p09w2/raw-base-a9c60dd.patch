+# STAND-IN: removed at integration
+"""Test-only stand-in for slice B's skill format and linter (P09-05), used by slice C's tests.
+
+It follows the phase file's ``SkillFrontmatter`` fields and limits so the starter skills can be
+validated before slice B lands. At integration the tests switch to
+``indus.learning.skills.format`` / ``indus.learning.skills.lint`` and this file is deleted.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import Any, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+from indus.foundation import yamlio
+
+NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
+NAME_MAX = 64
+DESCRIPTION_MAX = 1024
+SKILL_MD_MAX = 100_000
+SUPPORT_FILE_MAX = 1024 * 1024
+SUPPORT_DIRS = ("references", "templates", "scripts", "assets", "examples")
+LINT_REFERENCE_FILES = 60
+LINT_BODY_CHARS = 24_000
+LINT_REFS_PER_1000 = 5
+
+
+class _Strict(BaseModel):
+    model_config = ConfigDict(extra="forbid")
+
+
+class EnvVar(_Strict):
+    name: str
+    prompt: str | None = None
+    help: str | None = None
+    required_for: str | None = None
+
+
+class ConfigVar(_Strict):
+    key: str
+    description: str
+    default: Any = None
+    prompt: str | None = None
+
+
+class IndusMeta(_Strict):
+    tags: list[str] | None = None
+    category: str | None = None
+    fallback_for_toolsets: list[str] | None = None
+    requires_toolsets: list[str] | None = None
+    fallback_for_tools: list[str] | None = None
+    requires_tools: list[str] | None = None
+    session_platforms: list[str] | None = None
+    config: list[ConfigVar] | None = None
+    blueprint: dict[str, Any] | None = None
+
+
+class Metadata(BaseModel):
+    model_config = ConfigDict(extra="allow")
+    indus: IndusMeta | None = None
+
+
+class SkillFrontmatter(_Strict):
+    name: str = Field(max_length=NAME_MAX)
+    description: str = Field(min_length=1, max_length=DESCRIPTION_MAX)
+    version: str | None = None
+    author: str | None = None
+    license: str | None = None
+    platforms: list[Literal["macos", "linux", "windows"]] | None = None
+    environments: list[str] | None = None
+    requires_apps: list[str] | None = None
+    required_environment_variables: list[EnvVar] | None = None
+    metadata: Metadata | None = None
+
+    @field_validator("name")
+    @classmethod
+    def _name_shape(cls, value: str) -> str:
+        if not NAME_RE.match(value):
+            raise ValueError(f"skill name {value!r} must match {NAME_RE.pattern}")
+        return value
+
+
+def parse_skill_md(text: str) -> tuple[SkillFrontmatter, str]:
+    """Split ``SKILL.md`` into validated frontmatter and the body; ValueError when malformed."""
+    if len(text) > SKILL_MD_MAX:
+        raise ValueError(f"SKILL.md is longer than {SKILL_MD_MAX} characters")
+    lines = text.split("\n")
+    if not lines or lines[0].strip() != "---":
+        raise ValueError("SKILL.md must start with a '---' frontmatter line")
+    try:
+        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
+    except StopIteration:
+        raise ValueError("frontmatter is not closed with '---'") from None
+    data = yamlio.load_safe("\n".join(lines[1:end]))
+    if not isinstance(data, dict):
+        raise ValueError("frontmatter must be a mapping")
+    return SkillFrontmatter.model_validate(data), "\n".join(lines[end + 1 :])
+
+
+_REF = re.compile(r"(?:#\d{2,}\b|\bPR\s*#?\d+\b|/pull/\d+\b)")
+
+
+def lint_skill(skill_dir: Path, body: str) -> list[str]:
+    """Advisory findings as ``rule-id: detail`` strings (never raises)."""
+    findings: list[str] = []
+    refs = len(_REF.findall(body))
+    if refs and refs * 1000 / max(len(body), 1000) >= LINT_REFS_PER_1000:
+        findings.append(f"lint.incident-log: {refs} issue or PR references")
+    ref_dir = skill_dir / "references"
+    if ref_dir.is_dir():
+        count = sum(1 for p in ref_dir.rglob("*") if p.is_file())
+        if count > LINT_REFERENCE_FILES:
+            findings.append(f"lint.sprawl: {count} files in references/")
+    if len(body) > LINT_BODY_CHARS:
+        findings.append(f"lint.oversized: body is {len(body)} characters")
+    return findings
