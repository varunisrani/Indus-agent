+# STAND-IN: removed at integration
+"""Test-only stand-in for slice D's ``skill_manage`` (P09-11), just enough for the review tests.
+
+``create`` writes ``<home>/skills/<name>/SKILL.md`` and records its creation origin; ``patch``
+replaces ``old_string`` with ``new_string`` in it and, inside a background review, refuses unless
+the skill was viewed in this review (P09-08 read evidence keyed by the call's session id).
+Results follow the shape the review summary reads: ``{"success": true, "action", "name",
+"message"}``. The real tool replaces this file.
+"""
+
+from __future__ import annotations
+
+import json
+from collections.abc import Mapping
+from typing import Any
+
+from indus.foundation.scope import Scope
+from indus.learning import pending
+from indus.learning.skills.usage import SkillUsage
+from indus.learning.skills.view_tools import READS
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+SCHEMA: Mapping[str, Any] = {
+    "description": "Create or change a skill.",
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "action": {"type": "string"},
+            "name": {"type": "string"},
+            "content": {"type": "string"},
+            "old_string": {"type": "string"},
+            "new_string": {"type": "string"},
+        },
+        "required": ["action", "name"],
+    },
+}
+
+
+ORIGINS: list[str] = []
+"""The write origin each ``create`` saw, newest last (tests read it)."""
+
+
+def _answer(**body: Any) -> str:
+    return json.dumps(body)
+
+
+def skill_manage(
+    args: Mapping[str, Any], *, scope: Scope | None = None, session_id: str | None = None
+) -> str:
+    assert scope is not None
+    action, name = str(args.get("action", "")), str(args.get("name", ""))
+    path = scope.home / "skills" / name / "SKILL.md"
+    if action == "create":
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(str(args.get("content", "")), encoding="utf-8")
+        # the origin the real tool reads from ``learning.pending`` (one write-origin variable)
+        ORIGINS.append(pending.current_origin())
+        SkillUsage(scope.home / "skills", clock=scope.clock).record_created(
+            name, origin=pending.current_origin()
+        )
+        return _answer(success=True, action=action, name=name, message=f"created {name}")
+    if action == "patch":
+        if not path.is_file():
+            return _answer(success=False, error=f"no skill {name}")
+        data = path.read_bytes()
+        if pending.current_origin() == "background_review" and not READS.fresh(
+            session_id, name, "SKILL.md", data
+        ):
+            return _answer(success=False, error="view the skill with skill_view, then retry")
+        text = data.decode("utf-8").replace(
+            str(args.get("old_string", "")), str(args.get("new_string", "")), 1
+        )
+        path.write_text(text, encoding="utf-8")
+        return _answer(success=True, action=action, name=name, message=f"patched {name}")
+    return _answer(success=False, error=f"unknown action {action}")
+
+
+def register_skill_manage(registry: ToolRegistry) -> None:
+    registry.register("skill_manage", "skills", SCHEMA, skill_manage, traits=ToolTraits())
