+"""Builders for the curator and journey tests: skills with usage records at given ages."""
+
+from __future__ import annotations
+
+from collections.abc import Iterator, Mapping
+from datetime import timedelta
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from indus.foundation.scope import Scope
+from indus.learning import curator
+from indus.learning.curator import ledger_port
+from indus.learning.skills.resolver import clear_scan_cache
+from indus.learning.skills.usage import SkillUsage
+from tests.unit.learning.skills.helpers import FakeConfig, make_skill
+
+DAY = 86400.0
+
+
+@pytest.fixture(autouse=True)
+def clean_registries() -> Iterator[None]:
+    curator.clear_reference_sources()
+    restore = ledger_port.set_ledger(None)
+    clear_scan_cache()
+    yield
+    curator.clear_reference_sources()
+    restore()
+    clear_scan_cache()
+
+
+def with_settings(scope: Scope, **sections: Mapping[str, Any]) -> Scope:
+    return scope.with_config(FakeConfig(dict(sections)))
+
+
+def skills_root(scope: Scope) -> Path:
+    return scope.home / "skills"
+
+
+def add_skill(
+    scope: Scope,
+    name: str,
+    *,
+    origin: str | None = "agent",
+    created_days: float | None = 0.0,
+    active_days: float | None = None,
+    use_count: int = 0,
+    pinned: bool = False,
+    state: str = "active",
+    rel: str | None = None,
+    record: bool = True,
+    body: str = "Steps go here.\n",
+) -> Path:
+    """A skill folder plus its usage record; ``*_days`` are ages before the clock's now."""
+    folder = make_skill(skills_root(scope), rel or name, name, body=body)
+    if not record:
+        return folder
+    now = scope.clock.now()
+
+    def ago(days: float | None) -> str | None:
+        if days is None:
+            return None
+        return (now - timedelta(days=days)).isoformat(timespec="seconds")
+
+    def change(rec: dict[str, Any], _now: str) -> None:
+        rec.update(
+            origin=origin,
+            created_at=ago(created_days),
+            last_activity_at=ago(active_days),
+            last_used_at=ago(active_days) if use_count else None,
+            use_count=use_count,
+            pinned=pinned,
+            state=state,
+        )
+
+    SkillUsage(skills_root(scope), clock=scope.clock).update(name, change, force=True)
+    return folder
+
+
+def mark_bundled(scope: Scope, *names: str) -> None:
+    path = skills_root(scope) / ".bundled_manifest"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    rows = "".join(f"{n}:{'0' * 64}\n" for n in names)
+    path.write_text(path.read_text() + rows if path.exists() else rows, encoding="utf-8")
+
+
+def mark_hub(scope: Scope, *names: str) -> None:
+    import json
+
+    path = skills_root(scope) / ".hub" / "lock.json"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps({"installed": {n: {} for n in names}}), encoding="utf-8")
+
+
+def record(scope: Scope, name: str) -> dict[str, Any]:
+    return SkillUsage(skills_root(scope), clock=scope.clock).get(name)
diff --git a/tests/unit/learning/curator/_stubs_f.py b/tests/unit/learning/curator/_stubs_f.py
new file mode 100644
index 0000000..2bb080d
--- /dev/null
+++ b/tests/unit/learning/curator/_stubs_f.py
@@ -0,0 +1,133 @@
+# STAND-IN: removed at integration
+"""Test-only stand-ins for slice D's pieces the curator talks to: the skill ledger (P09-13) behind
+``ledger_port`` and a minimal ``skill_manage`` (P09-11) for the consolidation pass. At integration
+the curator tests use the real ledger and ``indus.learning.skills.manage_tool`` instead."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import shutil
+from collections.abc import Mapping, Sequence
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.scope import Scope
+from indus.learning.curator.archive import Refused, archive_skill
+from indus.learning.curator.consolidate import curator_registry
+from indus.learning.skills.resolver import load_catalog
+from indus.learning.skills.usage import usage_for
+from indus.tools.registry import ToolRegistry
+
+
+def _files(folder: Path) -> dict[str, bytes]:
+    if not folder.is_dir():
+        return {}
+    return {
+        p.relative_to(folder).as_posix(): p.read_bytes() for p in folder.rglob("*") if p.is_file()
+    }
+
+
+class MemoryLedger:
+    """Entries in a list; ``capture`` copies the folder's files for ``rollback``."""
+
+    def __init__(self) -> None:
+        self.rows: list[dict[str, Any]] = []
+
+    def capture(self, skill_dir: Path, *, skill: str) -> Any:
+        return {"dir": skill_dir, "files": _files(skill_dir)}
+
+    def record(
+        self,
+        action: str,
+        skill: str,
+        *,
+        actor: str,
+        before: Any,
+        after_dir: Path | None,
+        evidence: Mapping[str, Any] | None = None,
+    ) -> str | None:
+        entry_id = hashlib.sha256(f"{len(self.rows)}{skill}{action}".encode()).hexdigest()[:12]
+        self.rows.append(
+            {
+                "id": entry_id,
+                "ts": f"2026-01-01T00:00:{len(self.rows):02d}",
+                "actor": actor,
+                "action": action,
+                "skill": skill,
+                "evidence": dict(evidence or {}),
+                "before": before,
+                "after_dir": after_dir,
+            }
+        )
+        return entry_id
+
+    def entries(self, *, skill: str | None = None, limit: int = 20) -> Sequence[Mapping[str, Any]]:
+        rows = [r for r in reversed(self.rows) if skill is None or r["skill"] == skill]
+        return rows[:limit]
+
+    def get(self, entry_id: str) -> Mapping[str, Any] | None:
+        return next((r for r in self.rows if r["id"] == entry_id), None)
+
+    def rollback(self, entry_id: str) -> tuple[bool, str]:
+        row = self.get(entry_id)
+        if row is None or not isinstance(row["before"], dict):
+            return False, "nothing to restore"
+        folder: Path = row["before"]["dir"]
+        if row["after_dir"] is not None and Path(row["after_dir"]) != folder:
+            shutil.rmtree(row["after_dir"], ignore_errors=True)
+        for rel, data in row["before"]["files"].items():
+            (folder / rel).parent.mkdir(parents=True, exist_ok=True)
+            (folder / rel).write_bytes(data)
+        return True, f"restored {row['skill']}"
+
+
+MANAGE_SCHEMA: dict[str, Any] = {
+    "description": "Create, rewrite or delete a skill (test stand-in).",
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "action": {"type": "string"},
+            "name": {"type": "string"},
+            "content": {"type": "string"},
+            "absorbed_into": {"type": "string"},
+        },
+        "required": ["action", "name"],
+    },
+}
+
+
+def fake_manage(args: Mapping[str, Any], *, scope: Scope | None = None) -> str:
+    assert scope is not None
+    action, name = args.get("action"), str(args.get("name"))
+    if action == "create":
+        folder = scope.home / "skills" / name
+        folder.mkdir(parents=True)
+        (folder / "SKILL.md").write_text(str(args["content"]), encoding="utf-8")
+        usage_for(scope).record_created(name, origin="background_review")
+        return json.dumps({"ok": True})
+    rec = load_catalog(scope).find(name)
+    if rec is None:
+        return json.dumps({"error": f"no skill {name}"})
+    if action == "edit":
+        rec.skill_md.write_text(str(args["content"]), encoding="utf-8")
+        return json.dumps({"ok": True})
+    if action == "delete":
+        try:
+            archive_skill(
+                scope,
+                name,
+                actor="curator",
+                evidence={"absorbed_into": args.get("absorbed_into", "")},
+            )
+        except Refused as exc:
+            return json.dumps({"error": str(exc)})
+        return json.dumps({"ok": True, "archived": True})
+    return json.dumps({"error": f"unknown action {action}"})
+
+
+def registry_with_fake_manage(*, writes: bool = True) -> tuple[ToolRegistry, bool]:
+    registry, _ = curator_registry(writes=False)
+    if writes:
+        registry.register("skill_manage", "skills", MANAGE_SCHEMA, fake_manage)
+    return registry, writes
