+++ b/src/indus/learning/curator/lifecycle.py
@@ -0,0 +1,403 @@
+"""Curator phase 1: age the skills the review wrote, by inactivity alone (P09-18).
+
+When to run (``should_run``): the curator is enabled and not paused, the last run is at least
+``interval_hours`` (168) old, and — when the caller measured it — the agent has been idle for
+``min_idle_hours`` (2). The very first look only records "now" as the last run, so a fresh install
+or an upgrade never moves anything until one interval has passed (R07.7). Hosts call
+``maybe_run`` on CLI session start and from the service's hourly maintenance timer; a profile
+whose gateway is running leaves it to the gateway.
+
+What a run does (``apply_transitions``) for each managed skill (``archive.managed_skills``; with
+``curator.prune_builtins`` also bundled ones, archive only):
+
+- pinned, or named by a reference source (cron, R07.8): left alone;
+- no activity and no creation time on record: its clock starts now (seeded), nothing else;
+- never used and younger than ``stale_after_days``: stays (a stale one becomes active again);
+- inactive for ``archive_after_days`` (30): moved into the archive;
+- inactive for ``stale_after_days`` (14): marked ``stale``; active again once used.
+
+"Inactive for" counts from ``last_activity_at`` (any use, view or patch), else ``created_at``.
+When a reference source fails the protected set is unknown and nothing is archived that run.
+``run_curator`` adds the optional consolidation pass (``consolidate``), the snapshot before it,
+the state update and the per-run report.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+from collections.abc import Callable, Mapping
+from dataclasses import dataclass, field
+from datetime import UTC, datetime, timedelta
+from typing import Any
+
+from indus.foundation.scope import Scope, thread_with_scope
+from indus.learning.curator import referenced_skills
+from indus.learning.curator.archive import (
+    Ownership,
+    Refused,
+    archive_skill,
+    bundled_local,
+    managed_skills,
+    parse_time,
+)
+from indus.learning.curator.report import write_report
+from indus.learning.curator.settings import CuratorSettings
+from indus.learning.curator.state import CuratorState
+from indus.learning.skills.usage import usage_for
+
+__all__ = [
+    "RunOutcome",
+    "Transitions",
+    "apply_transitions",
+    "curator_check",
+    "maybe_run",
+    "run_curator",
+    "run_in_background",
+    "should_run",
+]
+
+log = logging.getLogger(__name__)
+
+FIRST_LOOK = "first look: the curator counts from now and runs after one interval"
+
+
+def _now(scope: Scope, now: datetime | None) -> datetime:
+    return (now or scope.clock.now()).astimezone(UTC)
+
+
+# -- when ---------------------------------------------------------------------------------------
+
+
+def should_run(
+    scope: Scope,
+    now: datetime | None = None,
+    *,
+    idle_s: float | None = None,
+    settings: CuratorSettings | None = None,
+) -> bool:
+    """Is an automatic run due? (see the module notes; the first look seeds and says no)."""
+    config = settings or CuratorSettings.from_scope(scope)
+    if not config.enabled:
+        return False
+    state = CuratorState(scope)
+    current = state.load()
+    if current.get("paused") is True:
+        return False
+    moment = _now(scope, now)
+    last = parse_time(current.get("last_run_at"))
+    if last is None:
+        state.update(last_run_at=moment.isoformat(), last_summary=FIRST_LOOK)
+        return False
+    if moment - last < timedelta(hours=config.interval_hours):
+        return False
+    return idle_s is None or idle_s >= config.min_idle_hours * 3600.0
+
+
+# -- what ---------------------------------------------------------------------------------------
+
+
+@dataclass
+class Transitions:
+    checked: int = 0
+    marked_stale: int = 0
+    archived: int = 0
+    reactivated: int = 0
+    seeded: int = 0
+    pinned: int = 0
+    referenced: int = 0
+    protection_unknown: bool = False
+    changes: list[dict[str, str]] = field(default_factory=list[dict[str, str]])
+    failures: list[dict[str, str]] = field(default_factory=list[dict[str, str]])
+
+    def summary(self) -> str:
+        parts = [
+            f"{n} {label}"
+            for n, label in (
+                (self.marked_stale, "marked stale"),
+                (self.archived, "archived"),
+                (self.reactivated, "active again"),
+            )
+            if n
+        ]
+        return ", ".join(parts) or "no changes"
+
+    def as_payload(self) -> dict[str, Any]:
+        return {
+            "checked": self.checked,
+            "marked_stale": self.marked_stale,
+            "archived": self.archived,
+            "reactivated": self.reactivated,
+            "seeded": self.seeded,
+            "pinned": self.pinned,
+            "referenced": self.referenced,
+            "protection_unknown": self.protection_unknown,
+        }
+
+
+def _anchor(record: Mapping[str, Any]) -> datetime | None:
+    return parse_time(record.get("last_activity_at")) or parse_time(record.get("created_at"))
+
+
+def apply_transitions(
+    scope: Scope,
+    now: datetime | None = None,
+    *,
+    settings: CuratorSettings | None = None,
+    dry_run: bool = False,
+) -> Transitions:
+    """Move managed skills between active, stale and archived; ``dry_run`` only counts."""
+    config = settings or CuratorSettings.from_scope(scope)
+    moment = _now(scope, now)
+    stale_cut = moment - timedelta(days=config.stale_after_days)
+    archive_cut = moment - timedelta(days=config.archive_after_days)
+    protected = referenced_skills()
+    out = Transitions(protection_unknown=protected is None)
+    usage = usage_for(scope)
+    owners: list[Ownership] = list(managed_skills(scope))
+    if config.prune_builtins:
+        owners += bundled_local(scope)
+
+    def set_state(owner: Ownership, before: str, after: str) -> None:
+        out.changes.append({"name": owner.name, "from": before, "to": after})
+        if dry_run:
+            return
+        usage.update(
+            owner.name,
+            lambda rec, _now: rec.update(state=after, archived_at=None),
+            force=owner.owner == "bundled",
+        )
+
+    for owner in owners:
+        out.checked += 1
+        record = owner.record
+        name = owner.name
+        if record.get("pinned") is True:
+            out.pinned += 1
+            continue
+        if protected is not None and name in protected:
+            out.referenced += 1
+            continue
+        anchor = _anchor(record)
+        state = str(record.get("state") or "active")
+        if anchor is None:
+            out.seeded += 1
+            if not dry_run:
+                usage.update(
+                    name,
+                    lambda rec, now_text: rec.update(created_at=rec.get("created_at") or now_text),
+                    force=owner.owner == "bundled",
+                )
+            continue
+        never_used = not record.get("use_count")
+        if never_used and anchor > stale_cut:
+            if state == "stale":
+                out.reactivated += 1
+                set_state(owner, "stale", "active")
+            continue
+        if anchor <= archive_cut and protected is not None:
+            out.changes.append({"name": name, "from": state, "to": "archived"})
+            if dry_run:
+                out.archived += 1
+                continue
+            try:
+                archive_skill(scope, name, actor="curator", allow_bundled=config.prune_builtins)
+            except (Refused, OSError) as exc:
+                out.changes.pop()
+                out.failures.append({"name": name, "error": str(exc)})
+                log.warning("curator could not archive %s: %s", name, exc)
+                continue
+            out.archived += 1
+        elif anchor <= stale_cut and state == "active":
+            out.marked_stale += 1
+            set_state(owner, "active", "stale")
+        elif anchor > stale_cut and state == "stale":
+            out.reactivated += 1
+            set_state(owner, "stale", "active")
+    return out
+
+
+# -- a whole run ----------------------------------------------------------------------------------
+
+
+@dataclass
+class RunOutcome:
+    started_at: datetime
+    dry_run: bool
+    transitions: Transitions
+    consolidation: Any = None
+    summary: str = ""
+    report: str | None = None
+    backup: str | None = None
+    lines: list[str] = field(default_factory=list[str])
+
+
+StepFactory = Callable[[Scope], Any]
+
+
+def _consolidate(scope: Scope, step_factory: StepFactory | None, dry_run: bool) -> Any:
+    from indus.learning.curator import consolidate
+
+    step = None
+    if step_factory is not None:
+        try:
+            step = step_factory(scope)
+        except Exception as exc:
+            log.warning("no model for the curator pass: %s", exc)
+    return asyncio.run(consolidate.run_consolidation(scope, step, dry_run=dry_run))
+
+
+def run_curator(
+    scope: Scope,
+    *,
+    dry_run: bool = False,
+    consolidate: bool | None = None,
+    trigger: str = "manual",
+    step_factory: StepFactory | None = None,
+    now: datetime | None = None,
+    on_line: Callable[[str], object] | None = None,
+) -> RunOutcome:
+    """One curator pass now (phase 1, then phase 2 when ``consolidate``); never raises.
+
+    Must not be called from a running event loop (phase 2 runs its own); hosts use a thread
+    (``run_in_background``). ``step_factory(scope)`` builds the phase 2 model step.
+    """
+    config = CuratorSettings.from_scope(scope)
+    merge = config.consolidate if consolidate is None else consolidate
+    started = _now(scope, now)
+    clock_start = scope.clock.monotonic()
+    state = CuratorState(scope)
+    outcome = RunOutcome(started, dry_run, Transitions())
+
+    def say(line: str) -> None:
+        outcome.lines.append(line)
+        if on_line is not None:
+            try:
+                on_line(line)
+            except Exception:
+                log.debug("curator line sink failed", exc_info=True)
+
+    if not dry_run:
+        # Only the consolidation pass rewrites skill text, so only it earns a snapshot; the
+        # inactivity pass moves folders into the archive, which is its own undo. Old snapshots
+        # age out either way.
+        try:
+            from indus.learning.curator.backup import prune_backups, snapshot
+
+            if merge:
+                snap = snapshot(scope, "before a curator run", settings=config)
+                if snap is not None:
+                    outcome.backup = snap.id
+                    say(f"curator: snapshot {snap.id} taken")
+            else:
+                prune_backups(scope, keep=config.backup_keep)
+        except Exception as exc:
+            log.warning("skills snapshot before the curator run failed: %s", exc)
+    try:
+        outcome.transitions = apply_transitions(scope, started, settings=config, dry_run=dry_run)
+    except Exception as exc:
+        log.warning("curator lifecycle pass failed: %s: %s", type(exc).__name__, exc)
+        outcome.transitions.failures.append({"name": "*", "error": str(exc)})
+    auto = outcome.transitions.summary()
+    prefix = "preview: " if dry_run else ""
+    if not dry_run:
+        state.change(
+            lambda data: data.update(
+                last_run_at=started.isoformat(),
+                run_count=int(data.get("run_count") or 0) + 1,
+                last_summary=f"{prefix}{auto}",
+            )
+        )
+    if merge:
+        result = _consolidate(scope, step_factory, dry_run)
+        outcome.consolidation = result
+        cons_payload = result.as_payload()
+        summary = f"{prefix}{auto}; consolidation: {result.summary}"
+        for line in result.rename_lines():
+            say(line)
+    else:
+        cons_payload = {"ran": False, "summary": "skipped (consolidation is off)"}
+        summary = f"{prefix}{auto}; consolidation: off"
+    duration = max(0.0, scope.clock.monotonic() - clock_start)
+    payload: dict[str, Any] = {
+        "started_at": started.isoformat(),
+        "duration_s": round(duration, 2),
+        "dry_run": dry_run,
+        "trigger": trigger,
+        "backup": outcome.backup,
+        "transitions": outcome.transitions.as_payload(),
+        "state_changes": outcome.transitions.changes,
+        "failures": outcome.transitions.failures,
+        "consolidation": cons_payload,
+    }
+    folder = write_report(scope, started, payload)
+    outcome.report = str(folder) if folder is not None else None
+    outcome.summary = summary
+    try:
+        state.update(
+            last_summary=summary if not dry_run else state.load().get("last_summary"),
+            last_report=outcome.report,
+            last_duration_s=round(duration, 2),
+        )
+    except Exception:
+        log.warning("curator state not saved", exc_info=True)
+    say(f"curator: {summary}")
+    return outcome
+
+
+def run_in_background(scope: Scope, **kwargs: Any) -> None:
+    """Start ``run_curator`` on a daemon thread that keeps ``scope``."""
+    thread = thread_with_scope(
+        lambda: run_curator(scope, **kwargs), scope=scope, name="curator", daemon=True
+    )
+    thread.start()
+
+
+def maybe_run(
+    scope: Scope,
+    *,
+    idle_s: float | None = None,
+    gateway_running: Callable[[], bool] | None = None,
+    now: datetime | None = None,
+    step_factory: StepFactory | None = None,
+) -> RunOutcome | None:
+    """Run an automatic pass when one is due and no other process holds the claim.
+
+    Returns the outcome, or None when nothing ran. Never raises.
+    """
+    try:
+        if gateway_running is not None and gateway_running():
+            return None
+        if not should_run(scope, now, idle_s=idle_s):
+            return None
+        state = CuratorState(scope)
+        moment = _now(scope, now)
+        if not state.claim(moment):
+            return None
+        try:
+            return run_curator(scope, trigger="scheduled", now=moment, step_factory=step_factory)
+        finally:
+            state.release()
+    except Exception:
+        log.warning("automatic curator check failed", exc_info=True)
+        return None
+
+
+def curator_check(
+    scope: Scope,
+    *,
+    idle_s: Callable[[], float | None] | None = None,
+    gateway_running: Callable[[], bool] | None = None,
+    step_factory: StepFactory | None = None,
+) -> Callable[[], None]:
+    """A maintenance-timer task for ``scope`` (see ``indus.service.maintenance``)."""
+
+    def check() -> None:
+        maybe_run(
+            scope,
+            idle_s=idle_s() if idle_s is not None else None,
+            gateway_running=gateway_running,
+            step_factory=step_factory,
+        )
+
+    return check
diff --git a/src/indus/learning/curator/report.py b/src/indus/learning/curator/report.py
new file mode 100644
index 0000000..ecf9d06
--- /dev/null
+++ b/src/indus/learning/curator/report.py
@@ -0,0 +1,140 @@
+"""Per-run curator reports: ``<home>/logs/curator/<stamp>/{run.json,REPORT.md}``.
+
+``stamp`` is ``YYYYMMDD-HHMMSS`` (UTC) with ``-2``, ``-3``… when a run in the same second already
+wrote one. Reports are best-effort: a failure to write one is logged and never stops a run.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from collections.abc import Mapping, Sequence
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.fsio import atomic_write_text
+from indus.foundation.scope import Scope
+
+__all__ = ["NOT_RESOLVED", "render_markdown", "reports_root", "write_report"]
+
+log = logging.getLogger(__name__)
+
+NOT_RESOLVED = "(not resolved)"
+_LIST_CAP = 50
+
+
+def reports_root(scope: Scope) -> Path:
+    return scope.home / "logs" / "curator"
+
+
+def _run_dir(root: Path, started: datetime) -> Path:
+    stamp = started.strftime("%Y%m%d-%H%M%S")
+    candidate, n = root / stamp, 1
+    while candidate.exists():
+        n += 1
+        candidate = root / f"{stamp}-{n}"
+    return candidate
+
+
+def _seconds(value: object) -> str:
+    total = int(value) if isinstance(value, int | float) else 0
+    minutes, seconds = divmod(total, 60)
+    return f"{minutes} min {seconds} s" if minutes else f"{seconds} s"
+
+
+def _capped(lines: list[str], items: Sequence[Any], render: Any) -> None:
+    for item in items[:_LIST_CAP]:
+        lines.append(render(item))
+    if len(items) > _LIST_CAP:
+        lines.append(f"- and {len(items) - _LIST_CAP} more (see run.json)")
+
+
+def render_markdown(payload: Mapping[str, Any]) -> str:
+    auto: Mapping[str, Any] = payload.get("transitions") or {}
+    cons: Mapping[str, Any] = payload.get("consolidation") or {}
+    mode = " (dry run: nothing was changed)" if payload.get("dry_run") else ""
+    lines = [
+        f"# Curator run, {payload.get('started_at', '')}{mode}",
+        "",
+        f"- model: {cons.get('model') or NOT_RESOLVED} via {cons.get('provider') or NOT_RESOLVED}",
+        f"- duration: {_seconds(payload.get('duration_s'))}",
+        f"- trigger: {payload.get('trigger', 'manual')}",
+    ]
+    if payload.get("backup"):
+        lines.append(f"- snapshot taken first: {payload['backup']}")
+    lines += [
+        "",
+        "## Lifecycle (by inactivity, no model)",
+        "",
+        f"- skills checked: {auto.get('checked', 0)}",
+        f"- marked stale: {auto.get('marked_stale', 0)}",
+        f"- archived: {auto.get('archived', 0)}",
+        f"- active again: {auto.get('reactivated', 0)}",
+        f"- clock started (first sight): {auto.get('seeded', 0)}",
+        f"- skipped, pinned: {auto.get('pinned', 0)}",
+        f"- skipped, in use elsewhere: {auto.get('referenced', 0)}",
+    ]
+    if auto.get("protection_unknown"):
+        lines.append("- a reference source failed, so nothing was archived this run")
+    changes: Sequence[Mapping[str, Any]] = payload.get("state_changes") or []
+    if changes:
+        lines += ["", "### State changes", ""]
+        _capped(lines, changes, lambda c: f"- `{c['name']}`: {c['from']} → {c['to']}")
+    lines += ["", "## Consolidation", ""]
+    if not cons.get("ran"):
+        lines.append(f"- {cons.get('summary') or 'not run'}")
+    else:
+        counts: Mapping[str, int] = cons.get("tool_calls") or {}
+        listed = ", ".join(f"{k} {v}" for k, v in sorted(counts.items())) or "none"
+        lines.append(f"- tool calls: {sum(counts.values())} ({listed})")
+        if cons.get("error"):
+            lines.append(f"- stopped with an error: {cons['error']}")
+        merged: Sequence[Mapping[str, Any]] = cons.get("consolidated") or []
+        pruned: Sequence[Mapping[str, Any]] = cons.get("pruned") or []
+        added: Sequence[str] = cons.get("added") or []
+        if merged:
+            lines += ["", "### Folded into other skills", ""]
+            _capped(lines, merged, lambda e: f"- `{e['name']}` → `{e['into']}` ({e['source']})")
+        if pruned:
+            lines += ["", "### Archived without a successor", ""]
+            _capped(lines, pruned, lambda e: f"- `{e['name']}`")
+        if added:
+            lines += ["", "### New skills", ""]
+            _capped(lines, added, lambda n: f"- `{n}`")
+        rewrites: Sequence[Mapping[str, Any]] = cons.get("reference_rewrites") or []
+        if rewrites:
+            lines += ["", "### References followed", ""]
+            for rw in rewrites:
+                if rw.get("error"):
+                    lines.append(f"- {rw['source']}: failed ({rw['error']})")
+                for change in rw.get("changes") or []:
+                    lines.append(f"- {rw['source']}: {change}")
+        final = str(cons.get("final") or "").strip()
+        if final:
+            lines += ["", "### The model's closing notes", "", final]
+    lines += [
+        "",
+        "## Undo",
+        "",
+        "- `indus curator restore <name>` brings an archived skill back.",
+        "- `indus curator rollback` restores the whole skills folder from the newest snapshot.",
+        "- `run.json` next to this file has the full record.",
+        "",
+    ]
+    return "\n".join(lines)
+
+
+def write_report(scope: Scope, started: datetime, payload: Mapping[str, Any]) -> Path | None:
+    """Write both files; returns the run folder, or None when it could not be written."""
+    try:
+        folder = _run_dir(reports_root(scope), started)
+        folder.mkdir(parents=True, exist_ok=False)
+        atomic_write_text(
+            folder / "run.json", json.dumps(payload, indent=2, ensure_ascii=False, default=str)
+        )
+        atomic_write_text(folder / "REPORT.md", render_markdown(payload))
+        return folder
+    except Exception:
+        log.warning("curator report not written", exc_info=True)
+        return None
diff --git a/src/indus/learning/curator/settings.py b/src/indus/learning/curator/settings.py
new file mode 100644
index 0000000..169e272
--- /dev/null
+++ b/src/indus/learning/curator/settings.py
@@ -0,0 +1,105 @@
+"""The ``curator`` settings of one profile, read once per run.
+
+Day and hour counts below 1 would make the automatic pass archive or re-run everything on its next
+tick, unconfirmed; such values fall back to the built-in default with one warning per key and
+value. The built-in values follow the reference's code, not its docs (D-16.24, R07.30).
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from dataclasses import dataclass
+
+from indus.foundation.scope import Scope
+from indus.learning.skills.resolver import skills_setting
+
+__all__ = [
+    "ARCHIVE_AFTER_DAYS",
+    "BACKUP_KEEP",
+    "CLAIM_STALE_S",
+    "CONSOLIDATE_TIMEOUT_S",
+    "INTERVAL_HOURS",
+    "ITERATION_CAP",
+    "MIN_IDLE_HOURS",
+    "STALE_AFTER_DAYS",
+    "CuratorSettings",
+]
+
+log = logging.getLogger(__name__)
+
+INTERVAL_HOURS = 168
+MIN_IDLE_HOURS = 2.0
+STALE_AFTER_DAYS = 14
+ARCHIVE_AFTER_DAYS = 30
+BACKUP_KEEP = 2
+CLAIM_STALE_S = 3600.0
+CONSOLIDATE_TIMEOUT_S = 600.0
+ITERATION_CAP = 9999
+
+_warned: set[tuple[str, object]] = set()
+_warned_lock = threading.Lock()
+
+
+def _bool(value: object, default: bool) -> bool:
+    return value if isinstance(value, bool) else default
+
+
+def _number(value: object) -> float | None:
+    if isinstance(value, bool) or not isinstance(value, int | float):
+        try:
+            return float(str(value)) if value is not None else None
+        except ValueError:
+            return None
+    return float(value)
+
+
+def _at_least_one(key: str, value: object, default: float) -> float:
+    number = _number(value)
+    if number is not None and number >= 1:
+        return number
+    with _warned_lock:
+        first = (key, value) not in _warned
+        _warned.add((key, value))
+    if first:
+        log.warning("curator.%s must be 1 or more (got %r); using %s", key, value, default)
+    return default
+
+
+@dataclass(frozen=True)
+class CuratorSettings:
+    enabled: bool = True
+    interval_hours: float = INTERVAL_HOURS
+    min_idle_hours: float = MIN_IDLE_HOURS
+    stale_after_days: float = STALE_AFTER_DAYS
+    archive_after_days: float = ARCHIVE_AFTER_DAYS
+    consolidate: bool = False
+    prune_builtins: bool = False
+    archive_ttl_days: float = 0
+    backup_enabled: bool = True
+    backup_keep: int = BACKUP_KEEP
+
+    @classmethod
+    def from_scope(cls, scope: Scope) -> CuratorSettings:
+        def get(key: str) -> object:
+            return skills_setting(scope, f"curator.{key}")
+
+        idle = _number(get("min_idle_hours"))
+        ttl = _number(get("archive_ttl_days"))
+        keep = _number(get("backup.keep"))
+        return cls(
+            enabled=_bool(get("enabled"), True),
+            interval_hours=_at_least_one("interval_hours", get("interval_hours"), INTERVAL_HOURS),
+            min_idle_hours=idle if idle is not None and idle >= 0 else MIN_IDLE_HOURS,
+            stale_after_days=_at_least_one(
+                "stale_after_days", get("stale_after_days"), STALE_AFTER_DAYS
+            ),
+            archive_after_days=_at_least_one(
+                "archive_after_days", get("archive_after_days"), ARCHIVE_AFTER_DAYS
+            ),
+            consolidate=_bool(get("consolidate"), False),
+            prune_builtins=_bool(get("prune_builtins"), False),
+            archive_ttl_days=ttl if ttl is not None and ttl > 0 else 0,
+            backup_enabled=_bool(get("backup.enabled"), True),
+            backup_keep=max(1, int(keep)) if keep is not None else BACKUP_KEEP,
+        )
diff --git a/src/indus/learning/curator/state.py b/src/indus/learning/curator/state.py
new file mode 100644
index 0000000..dadc03a
--- /dev/null
+++ b/src/indus/learning/curator/state.py
@@ -0,0 +1,120 @@
+"""The curator's state file ``<home>/skills/.curator_state`` and its run claim.
+
+Shape: ``{last_run_at, paused, claim, run_count, last_summary, last_report, last_duration_s}``.
+``claim`` is ``{pid, at}`` while a pass runs: it keeps two processes of one home from running the
+automatic pass together. A claim older than ``CLAIM_STALE_S`` (an hour) belongs to a process that
+died and is taken over. Every read-modify-write holds ``.curator_state.lock``; a damaged file
+reads as empty (and is overwritten on the next save).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from collections.abc import Callable
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation.fsio import FileLock, atomic_write_json
+from indus.foundation.scope import Scope
+from indus.learning.curator.archive import parse_time
+from indus.learning.curator.settings import CLAIM_STALE_S
+
+__all__ = [
+    "STATE_FILE",
+    "CuratorState",
+    "state_path",
+]
+
+log = logging.getLogger(__name__)
+
+STATE_FILE = ".curator_state"
+LOCK_FILE = ".curator_state.lock"
+LOCK_TIMEOUT_S = 10.0
+
+_DEFAULTS: dict[str, Any] = {
+    "last_run_at": None,
+    "paused": False,
+    "claim": None,
+    "run_count": 0,
+    "last_summary": None,
+    "last_report": None,
+    "last_duration_s": None,
+}
+
+
+def state_path(scope: Scope) -> Path:
+    return scope.home / "skills" / STATE_FILE
+
+
+class CuratorState:
+    """Read and change one profile's curator state (every call re-reads the file)."""
+
+    def __init__(self, scope: Scope) -> None:
+        self.scope = scope
+        self.path = state_path(scope)
+
+    def _lock(self) -> FileLock:
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        return FileLock(self.path.with_name(LOCK_FILE), timeout=LOCK_TIMEOUT_S)
+
+    def load(self) -> dict[str, Any]:
+        data = dict(_DEFAULTS)
+        try:
+            raw = json.loads(self.path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return data
+        except (OSError, ValueError) as exc:
+            log.warning("curator state %s is unreadable (%s); starting over", self.path, exc)
+            return data
+        if isinstance(raw, dict):
+            data.update(cast(dict[str, Any], raw))
+        return data
+
+    def change(self, fn: Callable[[dict[str, Any]], object]) -> dict[str, Any]:
+        """Apply ``fn(state)`` under the lock and save; returns the saved state."""
+        with self._lock():
+            data = self.load()
+            fn(data)
+            atomic_write_json(self.path, data, sort_keys=True)
+            return data
+
+    def update(self, **values: Any) -> dict[str, Any]:
+        return self.change(lambda data: data.update(values))
+
+    # -- facts --------------------------------------------------------------------------------
+
+    @property
+    def paused(self) -> bool:
+        return self.load().get("paused") is True
+
+    def set_paused(self, paused: bool) -> None:
+        self.update(paused=paused)
+
+    def last_run_at(self) -> datetime | None:
+        return parse_time(self.load().get("last_run_at"))
+
+    # -- claim --------------------------------------------------------------------------------
+
+    def claim(self, now: datetime) -> bool:
+        """Take the run claim; False when a live claim (younger than an hour) is held."""
+        taken = False
+
+        def take(data: dict[str, Any]) -> None:
+            nonlocal taken
+            held = data.get("claim")
+            at = parse_time(held.get("at")) if isinstance(held, dict) else None
+            if at is not None and (now - at).total_seconds() < CLAIM_STALE_S:
+                return
+            if at is not None:
+                log.info("curator claim from %s is stale; taking it over", held)
+            data["claim"] = {"pid": os.getpid(), "at": now.astimezone(UTC).isoformat()}
+            taken = True
+
+        self.change(take)
+        return taken
+
+    def release(self) -> None:
+        self.update(claim=None)
diff --git a/src/indus/learning/journey.py b/src/indus/learning/journey.py
new file mode 100644
index 0000000..1936eca
--- /dev/null
+++ b/src/indus/learning/journey.py
@@ -0,0 +1,279 @@
+"""What this profile has learned, as timeline / map nodes (P09-23).
+
+Nodes:
+
+- skills with a learning signal: made here by the background review (``origin: agent``), by a
+  person or ``/learn`` (``origin: learn``), or used at least once. Only skills in the profile's
+  own folders count; bundled and hub skills, external folders and the archive are left out, as
+  is a hand-written skill nobody has used yet.
+- every memory entry, id ``memory:<store>:<index>:<sha8>`` — ``store`` is ``memory`` (the
+  agent's notes) or ``user`` (the user profile), ``index`` the entry's position, ``sha8`` the
+  first eight hex digits of the SHA-256 of its text. The digest is what names the entry: after
+  the list shifts the id still resolves (or is reported stale), never to another entry.
+
+``nodes(scope)`` is the data API for the CLI, the TUI (P12) and the desktop map (P20).
+``delete_node`` archives a skill (``indus curator restore`` brings it back) or removes a memory
+entry through the memory store and its lock. ``edit_node`` validates new skill text before it is
+kept and puts the old bytes back otherwise; memory entries are replaced through the store.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import logging
+from collections.abc import Callable
+from dataclasses import asdict, dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+from indus.foundation.fsio import atomic_write_bytes
+from indus.foundation.scope import Scope
+from indus.learning.curator import ledger_port
+from indus.learning.curator.archive import Refused, archive_skill, local_skills, parse_time
+from indus.learning.memory.store import TARGETS, MemoryStore, Op, Target
+from indus.learning.skills.format import SkillFormatError, check_skill_text
+from indus.learning.skills.usage import bundled_names, hub_names, usage_for
+
+__all__ = [
+    "JourneyError",
+    "Node",
+    "delete_node",
+    "edit_node",
+    "memory_id",
+    "node_text",
+    "nodes",
+]
+
+log = logging.getLogger(__name__)
+
+MEMORY_PREFIX = "memory"
+_LABEL_CHARS = 80
+
+
+class JourneyError(Exception):
+    """A node id that cannot be used (unknown, stale, malformed) or a refused change."""
+
+
+@dataclass(frozen=True)
+class Node:
+    id: str
+    kind: str
+    label: str
+    category: str
+    timestamp: float | None
+    when: str | None
+    use_count: int = 0
+    state: str = "active"
+    origin: str | None = None
+    pinned: bool = False
+    store: str | None = None
+
+    def as_dict(self) -> dict[str, Any]:
+        return asdict(self)
+
+
+def _digest(text: str) -> str:
+    return hashlib.sha256(text.strip().encode("utf-8")).hexdigest()[:8]
+
+
+def memory_id(store: Target, index: int, text: str) -> str:
+    return f"{MEMORY_PREFIX}:{store}:{index}:{_digest(text)}"
+
+
+def _iso(ts: float | None) -> str | None:
+    return datetime.fromtimestamp(ts, UTC).isoformat(timespec="seconds") if ts is not None else None
+
+
+def _label(text: str) -> str:
+    first = next((line.strip() for line in text.splitlines() if line.strip()), "")
+    first = first.lstrip("#").strip()
+    return first if len(first) <= _LABEL_CHARS else first[: _LABEL_CHARS - 1] + "…"
+
+
+def _skill_nodes(scope: Scope) -> list[Node]:
+    root = scope.home / "skills"
+    excluded = bundled_names(root) | hub_names(root)
+    records = usage_for(scope).load()
+    out: list[Node] = []
+    for name, rec in sorted(local_skills(scope).items()):
+        if name in excluded:
+            continue
+        usage = records.get(name) or {}
+        origin = usage.get("origin")
+        used = int(usage.get("use_count") or 0)
+        if origin not in ("agent", "learn") and used <= 0:
+            continue
+        stamp = parse_time(usage.get("created_at")) or parse_time(usage.get("last_activity_at"))
+        if stamp is not None:
+            ts: float | None = stamp.timestamp()
+        else:
+            try:
+                ts = rec.skill_md.stat().st_mtime
+            except OSError:
+                ts = None
+        out.append(
+            Node(
+                id=name,
+                kind="skill",
+                label=name,
+                category=rec.category or "general",
+                timestamp=ts,
+                when=_iso(ts),
+                use_count=used,
+                state=str(usage.get("state") or "active"),
+                origin=origin if isinstance(origin, str) else None,
+                pinned=usage.get("pinned") is True,
+            )
+        )
+    return out
+
+
+def _memory_nodes(scope: Scope) -> list[Node]:
+    store = MemoryStore.for_scope(scope)
+    out: list[Node] = []
+    for target in TARGETS:
+        try:
+            mtime: float | None = store.path(target).stat().st_mtime
+        except OSError:
+            continue
+        for index, entry in enumerate(store.entries(target)):
+            ts = mtime + index * 0.001 if mtime is not None else None
+            out.append(
+                Node(
+                    id=memory_id(target, index, entry),
+                    kind="memory",
+                    label=_label(entry),
+                    category="memory",
+                    timestamp=ts,
+                    when=_iso(ts),
+                    origin="memory",
+                    store=target,
+                )
+            )
+    return out
+
+
+def nodes(scope: Scope) -> list[Node]:
+    """Every node, newest first (unknown times last)."""
+    found = _skill_nodes(scope) + _memory_nodes(scope)
+    return sorted(found, key=lambda n: (n.timestamp is None, -(n.timestamp or 0.0), n.id))
+
+
+# -- resolving ids --------------------------------------------------------------------------------
+
+
+def _parse_memory_id(node_id: str) -> tuple[Target, int, str]:
+    parts = node_id.split(":")
+    if len(parts) != 4 or parts[0] != MEMORY_PREFIX or parts[1] not in TARGETS:
+        raise JourneyError(f"{node_id!r} is not a memory id (memory:<memory|user>:<n>:<hash>)")
+    try:
+        index = int(parts[2])
+    except ValueError:
+        raise JourneyError(f"{node_id!r} has a bad position") from None
+    store: Target = "memory" if parts[1] == "memory" else "user"
+    return store, index, parts[3]
+
+
+def _memory_entry(scope: Scope, node_id: str) -> tuple[MemoryStore, Target, str]:
+    store_name, _index, digest = _parse_memory_id(node_id)
+    store = MemoryStore.for_scope(scope)
+    for entry in store.entries(store_name):
+        if _digest(entry) == digest:
+            return store, store_name, entry
+    raise JourneyError(f"{node_id!r} no longer matches a memory entry; list the nodes again")
+
+
+def _skill_dir(scope: Scope, name: str) -> Path:
+    root = scope.home / "skills"
+    if name in bundled_names(root) or name in hub_names(root):
+        raise JourneyError(f"{name!r} is not something this profile learned")
+    rec = local_skills(scope).get(name)
+    if rec is None:
+        raise JourneyError(f"no skill named {name!r} in this profile")
+    return rec.skill_dir
+
+
+def node_text(scope: Scope, node_id: str) -> tuple[str, str]:
+    """``(kind, current text)``: the full ``SKILL.md`` or the memory entry."""
+    if node_id.startswith(f"{MEMORY_PREFIX}:"):
+        _store, _target, entry = _memory_entry(scope, node_id)
+        return "memory", entry
+    folder = _skill_dir(scope, node_id)
+    return "skill", (folder / "SKILL.md").read_text(encoding="utf-8")
+
+
+# -- changes --------------------------------------------------------------------------------------
+
+
+def delete_node(scope: Scope, node_id: str) -> str:
+    """Archive the skill or remove the memory entry; returns a one-line confirmation."""
+    if node_id.startswith(f"{MEMORY_PREFIX}:"):
+        store, target, entry = _memory_entry(scope, node_id)
+        result = store.apply(target, [Op("remove", old_text=entry, pinned_entry=entry)])
+        if not result.ok:
+            raise JourneyError(result.message or f"the memory store refused ({result.kind})")
+        return f"removed the memory entry {_label(entry)!r}"
+    _skill_dir(scope, node_id)
+    if usage_for(scope).is_pinned(node_id):
+        raise JourneyError(f"{node_id!r} is pinned; `indus curator unpin {node_id}` first")
+    try:
+        archive_skill(scope, node_id, actor="user")
+    except Refused as exc:
+        raise JourneyError(str(exc)) from None
+    return f"archived {node_id}; `indus curator restore {node_id}` brings it back"
+
+
+def edit_node(scope: Scope, node_id: str, edit: Callable[[Path], bool]) -> str:
+    """Let ``edit(path)`` change the node's text in a file (False = the editor failed).
+
+    Skills are edited in place and checked afterwards; a file that no longer validates (or
+    renames the skill) is refused and the original bytes are written back. Memory entries are
+    edited in a temporary file next to the store and saved through it.
+    """
+    if node_id.startswith(f"{MEMORY_PREFIX}:"):
+        return _edit_memory(scope, node_id, edit)
+    folder = _skill_dir(scope, node_id)
+    path = folder / "SKILL.md"
+    original = path.read_bytes()
+    before = ledger_port.capture(folder, node_id)
+    if not edit(path):
+        atomic_write_bytes(path, original)
+        raise JourneyError("the editor did not finish; nothing was changed")
+    try:
+        changed = path.read_bytes()
+    except OSError as exc:
+        atomic_write_bytes(path, original)
+        raise JourneyError(f"could not read the edited file: {exc}") from None
+    if changed == original:
+        return "no changes"
+    try:
+        check_skill_text(changed.decode("utf-8"), expected_name=node_id)
+    except (SkillFormatError, UnicodeDecodeError) as exc:
+        atomic_write_bytes(path, original)
+        problems = "; ".join(exc.problems) if isinstance(exc, SkillFormatError) else str(exc)
+        raise JourneyError(f"not saved, the skill would not load: {problems}") from None
+    ledger_port.record("edit", node_id, actor="user", before=before, after_dir=folder)
+    usage_for(scope).bump_patch(node_id)
+    return f"updated {node_id}"
+
+
+def _edit_memory(scope: Scope, node_id: str, edit: Callable[[Path], bool]) -> str:
+    store, target, entry = _memory_entry(scope, node_id)
+    scratch = store.directory / f".journey-edit-{_digest(entry)}.txt"
+    scratch.parent.mkdir(parents=True, exist_ok=True)
+    scratch.write_text(entry + "\n", encoding="utf-8")
+    try:
+        if not edit(scratch):
+            raise JourneyError("the editor did not finish; nothing was changed")
+        text = scratch.read_text(encoding="utf-8").strip()
+    finally:
+        scratch.unlink(missing_ok=True)
+    if text == entry.strip():
+        return "no changes"
+    if not text:
+        raise JourneyError("an empty entry is not saved; use delete to remove it")
+    result = store.apply(target, [Op("patch", content=text, old_text=entry, pinned_entry=entry)])
+    if not result.ok:
+        raise JourneyError(result.message or f"the memory store refused ({result.kind})")
+    return f"updated the memory entry {_label(text)!r}"
