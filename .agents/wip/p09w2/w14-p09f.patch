@@ -0,0 +1,382 @@
+"""Whole-tree snapshots of the skills folder, taken before a consolidation pass (P09-19).
+
+A snapshot is ``<home>/skills/.curator_backups/<id>/skills.tar.gz`` plus ``manifest.json``
+``{id, reason, created_at, size, skill_files}``. The id is the UTC time
+``YYYY-MM-DDTHH-MM-SSZ`` (``-NN`` added when that second is taken). Left out of every snapshot:
+the backups themselves, the archive (rolling it back would lose archived skills), the skills hub
+state, lock files, the ledger and its blobs, ``.git`` folders and regenerable caches. The usage
+sidecar, the curator state and the bundled manifest are kept, so a rollback also brings back the
+last-run time and provenance records.
+
+Only the newest ``curator.backup.keep`` (2) snapshots stay. With ``curator.backup.enabled: false``
+nothing is snapshotted and rollback is refused (it would have no safety snapshot).
+
+Rollback: snapshot the current tree first ("before rollback to <id>", with the target protected
+from that snapshot's prune), move the current entries aside into a staging folder, extract, and
+on any failure put the staged entries back. Members with absolute paths or ``..`` are refused.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import logging
+import os
+import shutil
+import tarfile
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any, cast
+
+from indus.foundation.fsio import atomic_write_json
+from indus.foundation.scope import Scope
+from indus.learning.curator.settings import CuratorSettings
+
+__all__ = [
+    "BACKUPS_DIR",
+    "BackupInfo",
+    "BackupsDisabled",
+    "RollbackFailed",
+    "list_backups",
+    "prune_backups",
+    "rollback",
+    "snapshot",
+]
+
+log = logging.getLogger(__name__)
+
+BACKUPS_DIR = ".curator_backups"
+ARCHIVE_NAME = "skills.tar.gz"
+MANIFEST = "manifest.json"
+STAGING_PREFIX = ".staging-"
+EXCLUDED = frozenset(
+    {
+        BACKUPS_DIR,
+        ".archive",
+        ".hub",
+        ".locks",
+        ".git",
+        ".ledger.jsonl",
+        ".ledger-blobs",
+        ".usage.lock",
+        ".curator_state.lock",
+        ".bundled_manifest.lock",
+    }
+)
+CACHE_DIRS = frozenset(
+    {"__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache", "node_modules", "venv", ".venv"}
+)
+
+
+class BackupsDisabled(Exception):
+    pass
+
+
+class RollbackFailed(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class BackupInfo:
+    id: str
+    path: Path
+    reason: str
+    created_at: str
+    size: int
+    skill_files: int
+
+
+def _skills(scope: Scope) -> Path:
+    return scope.home / "skills"
+
+
+def _backups(scope: Scope) -> Path:
+    return _skills(scope) / BACKUPS_DIR
+
+
+def _settings(scope: Scope, settings: CuratorSettings | None) -> CuratorSettings:
+    return settings if settings is not None else CuratorSettings.from_scope(scope)
+
+
+def _base_id(now: datetime) -> str:
+    return now.astimezone(UTC).strftime("%Y-%m-%dT%H-%M-%SZ")
+
+
+def _is_id(name: str) -> bool:
+    try:
+        datetime.strptime(name[:20], "%Y-%m-%dT%H-%M-%SZ")
+    except ValueError:
+        return False
+    rest = name[20:]
+    return rest == "" or (len(rest) == 3 and rest[0] == "-" and rest[1:].isdigit())
+
+
+def _excluded(member: tarfile.TarInfo) -> bool:
+    parts = Path(member.name).parts
+    folders = parts if member.isdir() else parts[:-1]
+    return any(p in EXCLUDED for p in parts) or any(p in CACHE_DIRS for p in folders)
+
+
+def _count_skills(root: Path) -> int:
+    count = 0
+    for path in root.rglob("SKILL.md"):
+        rel = path.relative_to(root).parts
+        if not any(p in EXCLUDED or p in CACHE_DIRS for p in rel):
+            count += 1
+    return count
+
+
+def _read_manifest(folder: Path) -> dict[str, Any]:
+    try:
+        data = json.loads((folder / MANIFEST).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    return cast(dict[str, Any], data) if isinstance(data, dict) else {}
+
+
+def _restorable(folder: Path) -> bool:
+    return folder.is_dir() and _is_id(folder.name) and (folder / ARCHIVE_NAME).is_file()
+
+
+def list_backups(scope: Scope) -> list[BackupInfo]:
+    """Restorable snapshots, newest first."""
+    root = _backups(scope)
+    if not root.is_dir():
+        return []
+    out: list[BackupInfo] = []
+    for folder in sorted(root.iterdir(), key=lambda p: p.name, reverse=True):
+        if not _restorable(folder):
+            continue
+        manifest = _read_manifest(folder)
+        size = manifest.get("size")
+        if not isinstance(size, int):
+            size = (folder / ARCHIVE_NAME).stat().st_size
+        out.append(
+            BackupInfo(
+                id=folder.name,
+                path=folder,
+                reason=str(manifest.get("reason") or "?"),
+                created_at=str(manifest.get("created_at") or ""),
+                size=size,
+                skill_files=int(manifest.get("skill_files") or 0),
+            )
+        )
+    return out
+
+
+def prune_backups(
+    scope: Scope, *, keep: int | None = None, protect: frozenset[str] = frozenset()
+) -> list[str]:
+    """Remove snapshots beyond the newest ``keep`` (and leftover staging folders)."""
+    root = _backups(scope)
+    if not root.is_dir():
+        return []
+    count = keep if keep is not None else CuratorSettings.from_scope(scope).backup_keep
+    ordered = sorted(
+        (p for p in root.iterdir() if _is_id(p.name)), key=lambda p: p.name, reverse=True
+    )
+    removed: list[str] = []
+    for folder in ordered[max(count, 1) :]:
+        if folder.name in protect:
+            continue
+        try:
+            shutil.rmtree(folder)
+            removed.append(folder.name)
+        except OSError as exc:
+            log.warning("old skills snapshot %s not removed: %s", folder, exc)
+    for folder in root.iterdir():
+        if folder.name.startswith(STAGING_PREFIX) and folder.is_dir():
+            with contextlib.suppress(OSError):
+                shutil.rmtree(folder)
+    return removed
+
+
+def snapshot(
+    scope: Scope,
+    reason: str = "manual",
+    *,
+    settings: CuratorSettings | None = None,
+    protect: frozenset[str] = frozenset(),
+) -> BackupInfo | None:
+    """Take a snapshot; None when backups are off or the skills folder is missing.
+
+    IO errors are raised to the caller (the curator logs them and goes on; the CLI reports them).
+    """
+    config = _settings(scope, settings)
+    if not config.backup_enabled:
+        log.debug("skill snapshots are switched off (curator.backup.enabled)")
+        return None
+    skills = _skills(scope)
+    if not skills.is_dir():
+        return None
+    root = _backups(scope)
+    root.mkdir(parents=True, exist_ok=True)
+    base = _base_id(scope.clock.now())
+    snap_id, n = base, 0
+    while (root / snap_id).exists():
+        n += 1
+        snap_id = f"{base}-{n:02d}"
+    folder = root / snap_id
+    folder.mkdir()
+    archive = folder / ARCHIVE_NAME
+    try:
+        with tarfile.open(archive, "w:gz", compresslevel=6) as tar:
+            for entry in sorted(skills.iterdir()):
+                if entry.name in EXCLUDED:
+                    continue
+                tar.add(
+                    str(entry),
+                    arcname=entry.name,
+                    filter=lambda m: None if _excluded(m) else m,
+                )
+        manifest = {
+            "id": snap_id,
+            "reason": reason,
+            "created_at": scope.clock.now().astimezone(UTC).isoformat(),
+            "size": archive.stat().st_size,
+            "skill_files": _count_skills(skills),
+        }
+        atomic_write_json(folder / MANIFEST, manifest, sort_keys=True)
+    except (OSError, tarfile.TarError):
+        shutil.rmtree(folder, ignore_errors=True)
+        raise
+    prune_backups(scope, keep=config.backup_keep, protect=protect | {snap_id})
+    log.info("skills snapshot %s taken (%s)", snap_id, reason)
+    return BackupInfo(
+        snap_id, folder, reason, manifest["created_at"], manifest["size"], manifest["skill_files"]
+    )
+
+
+def _remove(path: Path) -> None:
+    if path.is_dir() and not path.is_symlink():
+        shutil.rmtree(path)
+    elif path.exists() or path.is_symlink():
+        path.unlink()
+
+
+def _carry_over(staged: Path, skills: Path) -> list[str]:
+    """Move what snapshots leave out (a skill's ``.git``, caches, virtualenvs) from the folder
+    before back into the restored tree, where its skill still exists; returns what failed."""
+    failed: list[str] = []
+    for current, dirs, files in os.walk(staged):
+        here = Path(current)
+        if here == staged:
+            dirs[:] = [d for d in dirs if d not in EXCLUDED]
+            continue
+        carried = [here / f for f in files if f in EXCLUDED]
+        carried += [here / d for d in dirs if d in EXCLUDED or d in CACHE_DIRS]
+        for source in carried:
+            dest = skills / source.relative_to(staged)
+            if dest.parent.is_dir() and not dest.exists():
+                try:
+                    shutil.move(str(source), str(dest))
+                except OSError:
+                    failed.append(source.relative_to(staged).as_posix())
+        dirs[:] = [d for d in dirs if d not in EXCLUDED and d not in CACHE_DIRS]
+    return failed
+
+
+def _check_members(tar: tarfile.TarFile) -> None:
+    for member in tar.getmembers():
+        parts = Path(member.name).parts
+        if member.name.startswith(("/", "\\")) or ".." in parts:
+            raise RollbackFailed(f"the snapshot holds an unsafe path {member.name!r}; not restored")
+
+
+def rollback(
+    scope: Scope, backup_id: str | None = None, *, settings: CuratorSettings | None = None
+) -> tuple[BackupInfo, BackupInfo]:
+    """Restore the skills folder from ``backup_id`` (default: the newest snapshot).
+
+    Returns ``(restored, safety)``: the snapshot restored and the one taken of the tree before.
+    Raises ``BackupsDisabled`` or ``RollbackFailed`` (the tree is then as it was).
+    """
+    config = _settings(scope, settings)
+    if not config.backup_enabled:
+        raise BackupsDisabled(
+            "skill snapshots are switched off (curator.backup.enabled: false), so a rollback "
+            "could not be undone; switch them on first"
+        )
+    available = list_backups(scope)
+    if backup_id:
+        target = next((b for b in available if b.id == backup_id), None)
+    else:
+        target = available[0] if available else None
+    if target is None:
+        named = f" named {backup_id!r}" if backup_id else ""
+        raise RollbackFailed(f"no skills snapshot{named} (`indus curator rollback --list`)")
+    archive = target.path / ARCHIVE_NAME
+    try:
+        with tarfile.open(archive, "r:gz") as tar:
+            _check_members(tar)
+    except tarfile.TarError as exc:
+        raise RollbackFailed(f"snapshot {target.id} cannot be read: {exc}") from exc
+    try:
+        safety = snapshot(
+            scope,
+            f"before rollback to {target.id}",
+            settings=config,
+            protect=frozenset({target.id}),
+        )
+    except (OSError, tarfile.TarError) as exc:
+        raise RollbackFailed(f"the safety snapshot failed ({exc}); nothing was changed") from exc
+    if safety is None:
+        raise RollbackFailed("the safety snapshot could not be taken; nothing was changed")
+    skills = _skills(scope)
+    staging = _backups(scope) / f"{STAGING_PREFIX}{_base_id(scope.clock.now())}"
+    n = 0
+    while staging.exists():
+        n += 1
+        staging = staging.with_name(f"{STAGING_PREFIX}{_base_id(scope.clock.now())}-{n}")
+    staging.mkdir(parents=True)
+    moved: list[tuple[Path, Path]] = []
+
+    def put_back() -> list[str]:
+        failed: list[str] = []
+        for original, staged in moved:
+            try:
+                _remove(original)
+                shutil.move(str(staged), str(original))
+            except OSError:
+                failed.append(original.name)
+        return failed
+
+    try:
+        for entry in list(skills.iterdir()):
+            if entry.name in EXCLUDED:
+                continue
+            dest = staging / entry.name
+            shutil.move(str(entry), str(dest))
+            moved.append((entry, dest))
+        with tarfile.open(archive, "r:gz") as tar:
+            tar.extractall(str(skills), filter="data")
+    except (OSError, tarfile.TarError) as exc:
+        keep = EXCLUDED | {original.name for original, _ in moved}
+        for entry in list(skills.iterdir()):
+            if entry.name not in keep:
+                with contextlib.suppress(OSError):
+                    _remove(entry)
+        failed = put_back()
+        if failed:
+            raise RollbackFailed(
+                f"rollback failed ({exc}) and {', '.join(failed)} could not be put back; "
+                f"the copies are in {staging}"
+            ) from exc
+        shutil.rmtree(staging, ignore_errors=True)
+        raise RollbackFailed(f"rollback failed ({exc}); the skills folder is as it was") from exc
+    left = _carry_over(staging, skills)
+    if left:
+        raise RollbackFailed(
+            f"restored from {target.id}, but {', '.join(left)} could not be carried over from the "
+            f"folder before; the copies are in {staging}"
+        )
+    shutil.rmtree(staging, ignore_errors=True)
+    with contextlib.suppress(Exception):
+        from indus.learning.skills.resolver import clear_scan_cache
+        from indus.learning.skills.view_tools import clear_list_cache
+
+        clear_scan_cache()
+        clear_list_cache(scope)
+    log.info("skills folder restored from snapshot %s", target.id)
+    return target, safety
diff --git a/src/indus/learning/curator/consolidate.py b/src/indus/learning/curator/consolidate.py
new file mode 100644
index 0000000..24e4bf2
--- /dev/null
+++ b/src/indus/learning/curator/consolidate.py
@@ -0,0 +1,522 @@
+"""Curator phase 2: a model folds overlapping managed skills into class-level umbrellas (P09-19).
+
+Off unless ``curator.consolidate`` is on or a run asks for it. The pass is a small tool loop on the
+``curator`` task of the auxiliary client (P08-17): each round sends the conversation and the tool
+array, runs the tools the model asked for, and appends their results, up to ``ITERATION_CAP``
+rounds. The registry it dispatches through holds only ``skills_list``, ``skill_view`` and (on a
+live run) ``skill_manage``, so any other tool name is answered "Unknown tool" and nothing runs.
+The list and view tools here are narrowed to the skills the curator manages and that are not
+pinned: the model never reads, let alone writes, anything else. Writes go through slice D's
+``skill_manage`` with the write origin bound to ``background_review``, so its review-fork guards
+(read before write, archive instead of delete) apply.
+
+Afterwards the managed set before and after the pass is compared. Each skill that left is
+classified: a ``skill_manage delete`` that declared ``absorbed_into`` an existing skill is a
+consolidation; ``absorbed_into: ""`` is a prune; without a declaration, a write to a surviving
+skill that mentions the removed name counts as the consolidation evidence; anything else was
+pruned. The ``old → new`` map is printed and every registered reference source is asked to
+follow it.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+from collections import Counter
+from collections.abc import Awaitable, Callable, Mapping, Sequence
+from dataclasses import dataclass, field
+from typing import Any, Protocol, cast
+
+from indus.foundation.scope import Scope
+from indus.learning.curator import ReferenceRewrite, referenced_skills, rewrite_references
+from indus.learning.curator.archive import Ownership, managed_skills
+from indus.learning.curator.settings import CONSOLIDATE_TIMEOUT_S, ITERATION_CAP
+from indus.learning.pending import bind_origin
+from indus.learning.skills import view_tools
+from indus.providers.types import Message, NormalizedResponse
+from indus.tools.calls import ToolCall, ToolContext, ToolResult
+from indus.tools.definitions import definitions
+from indus.tools.dispatch import dispatch
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+__all__ = [
+    "CURATOR_TOOLS",
+    "DRY_RUN_PREFACE",
+    "AuxStep",
+    "ConsolidationResult",
+    "ModelStep",
+    "candidate_list",
+    "classify_removed",
+    "curator_registry",
+    "rename_lines",
+    "run_consolidation",
+]
+
+log = logging.getLogger(__name__)
+
+TASK = "curator"
+CURATOR_TOOLS = ("skills_list", "skill_view", "skill_manage")
+MANAGE_MODULE = "indus.learning.skills.manage_tool"
+_ARG_PREVIEW = 400
+_SUMMARY_CHARS = 240
+
+SYSTEM_TEXT = """\
+You look after a library of skills that an assistant wrote for itself while working. You are not \
+talking to a person; nobody will answer questions. Work only with the three skill tools you have \
+and finish with a short plain-text report."""
+
+CURATOR_PROMPT = """\
+Tidy the skill library listed below so it is easier for the assistant to find the right skill.
+
+What a good library looks like:
+- Few broad skills, each covering one kind of task, rather than many narrow skills that each \
+record one session. A skill is found by its description, so a broad description that names the \
+kind of task wins over several near-identical ones.
+- SKILL.md holds the rules that always apply; deeper material for one topic goes in a small number \
+of files under references/, templates/ or scripts/.
+- Rules are written as instructions with a short reason. Drop stories about what happened, issue \
+or PR numbers, dates and quoted conversation. Say each lesson once.
+
+How to work:
+1. Read the list. Group skills that serve the same kind of task (shared words in the name are a \
+good first hint, but judge by what the skills say, not by their usage counts — the counts are new \
+and mostly zero).
+2. For each group of two or more, decide whether a careful maintainer would write it as one skill \
+with sections. If so, pick the best existing skill as the umbrella (or create one), fold the \
+others' lasting rules into it with skill_manage, then remove each folded skill with \
+skill_manage(action="delete", name=<old>, absorbed_into=<umbrella>). Removal moves the folder to \
+the archive; nothing is lost.
+3. A skill whose content is obsolete or fully covered elsewhere may be removed with \
+absorbed_into="" — but never one marked in_use=yes, and never one that was never used and is \
+younger than 30 days.
+4. Always open a skill with skill_view right before you change it.
+
+Never:
+- touch a skill that is not in the list below (the tools will refuse anyway);
+- remove a skill marked in_use=yes, except by folding it into an umbrella (its users are updated \
+to the new name automatically);
+- delete files outside skill_manage, or try any other tool.
+
+When you are done, reply with a short report: one line per change, written as \
+"old-name -> umbrella-name" for folds and "old-name -> (archived)" for removals, then one line on \
+anything you left alone on purpose."""
+
+DRY_RUN_PREFACE = """\
+PREVIEW ONLY. You can read skills but not change them in this pass. Do everything below up to the \
+point of changing a skill, and write the report as the list of changes you would make."""
+
+
+# -- the model -----------------------------------------------------------------------------------
+
+
+class ModelStep(Protocol):
+    """One model round: the conversation and tool array in, the normalised reply out."""
+
+    model: str
+    provider: str
+
+    def __call__(
+        self, messages: Sequence[Message], tools: Sequence[Mapping[str, Any]]
+    ) -> Awaitable[NormalizedResponse]: ...
+
+
+class AuxStep:
+    """A ``ModelStep`` over the auxiliary client's ``curator`` task (600 s unless configured)."""
+
+    def __init__(self, aux: Any, *, task: str = TASK) -> None:
+        self.aux = aux
+        self.task = task
+        self.model = ""
+        self.provider = ""
+
+    def _timeout(self) -> float:
+        try:
+            configured = self.aux.task_config(self.task).get("timeout_s")
+        except Exception:
+            configured = None
+        if isinstance(configured, bool) or not isinstance(configured, int | float):
+            return CONSOLIDATE_TIMEOUT_S
+        if configured > 0:
+            return float(configured)
+        return CONSOLIDATE_TIMEOUT_S
+
+    async def __call__(
+        self, messages: Sequence[Message], tools: Sequence[Mapping[str, Any]]
+    ) -> NormalizedResponse:
+        result = await self.aux.call(
+            self.task, list(messages), tools=list(tools), timeout_s=self._timeout()
+        )
+        self.model = result.route.model
+        self.provider = result.route.provider
+        return result.response
+
+
+# -- the tools ------------------------------------------------------------------------------------
+
+
+def _allowed(scope: Scope) -> dict[str, Ownership]:
+    return {o.name: o for o in managed_skills(scope) if o.record.get("pinned") is not True}
+
+
+def _list_handler(args: Mapping[str, Any], *, scope: Scope | None = None) -> str:
+    if scope is None:
+        return ToolResult.error("skills_list needs a profile scope").text
+    from indus.learning.skills.resolver import load_catalog
+
+    allowed = _allowed(scope)
+    rows: list[dict[str, Any]] = []
+    for rec in load_catalog(scope).loadable():
+        if rec.name in allowed:
+            rows.append(
+                {"name": rec.name, "description": rec.description, "category": rec.category}
+            )
+    category = args.get("category")
+    if isinstance(category, str) and category.strip():
+        rows = [r for r in rows if r["category"] == category.strip()]
+    return json.dumps({"skills": rows, "count": len(rows)}, ensure_ascii=False)
+
+
+async def _view_handler(
+    args: Mapping[str, Any], *, scope: Scope | None = None, session_id: str | None = None
+) -> str:
+    if scope is None:
+        return ToolResult.error("skill_view needs a profile scope").text
+    name = args.get("name")
+    if not isinstance(name, str) or name.strip() not in _allowed(scope):
+        return ToolResult.error(
+            f"{name!r} is not one of the skills this pass may work on; see skills_list"
+        ).text
+    return await view_tools.skill_view(args, scope=scope, session_id=session_id)
+
+
+def _register_manage(registry: ToolRegistry) -> bool:
+    import importlib
+
+    try:
+        module = importlib.import_module(MANAGE_MODULE)
+    except ImportError:
+        log.info("skill_manage is not installed; the curator pass can only read")
+        return False
+    register = getattr(module, "register_tools", None)
+    if register is None:
+        return False
+    scratch = ToolRegistry()
+    register(scratch)
+    entry = scratch.get("skill_manage")
+    if entry is None:
+        return False
+    registry.register(
+        entry.name,
+        entry.toolset,
+        entry.schema,
+        entry.handler,
+        is_async=entry.is_async,
+        timeout_s=entry.timeout_s,
+        traits=entry.traits,
+    )
+    return True
+
+
+def curator_registry(*, writes: bool = True) -> tuple[ToolRegistry, bool]:
+    """A registry holding only the curator's tools; the flag says whether writes are possible."""
+    registry = ToolRegistry()
+    read_only = ToolTraits(read_only=True)
+    registry.register(
+        "skills_list", "skills", view_tools.SKILLS_LIST_SCHEMA, _list_handler, traits=read_only
+    )
+    registry.register(
+        "skill_view",
+        "skills",
+        view_tools.SKILL_VIEW_SCHEMA,
+        _view_handler,
+        is_async=True,
+        traits=read_only,
+    )
+    can_write = _register_manage(registry) if writes else False
+    return registry, can_write
+
+
+# -- the candidate list ---------------------------------------------------------------------------
+
+
+def candidate_list(scope: Scope) -> str:
+    """One line per skill the pass may work on; empty text when there is none."""
+    allowed = _allowed(scope)
+    if not allowed:
+        return ""
+    in_use = referenced_skills() or set()
+    lines = [f"Skills you may work on ({len(allowed)}):"]
+    for name, owner in sorted(allowed.items()):
+        rec = owner.record
+        lines.append(
+            f"- {name}  state={rec.get('state', 'active')}  "
+            f"in_use={'yes' if name in in_use else 'no'}  "
+            f"used={rec.get('use_count', 0)}  viewed={rec.get('view_count', 0)}  "
+            f"patched={rec.get('patch_count', 0)}  "
+            f"created={rec.get('created_at') or 'unknown'}  "
+            f"last_activity={rec.get('last_activity_at') or 'never'}"
+        )
+    return "\n".join(lines)
+
+
+# -- classification -------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class RecordedCall:
+    name: str
+    args: Mapping[str, Any]
+
+
+def _manage_ops(call: RecordedCall) -> list[Mapping[str, Any]]:
+    """The skill_manage operations one call carried (a batch counts as several)."""
+    if call.name != "skill_manage":
+        return []
+    ops = call.args.get("operations")
+    if isinstance(ops, list):
+        out: list[Mapping[str, Any]] = []
+        for op in cast(list[object], ops):
+            if isinstance(op, Mapping):
+                merged = dict(cast(Mapping[str, Any], op))
+                merged.setdefault("name", call.args.get("name"))
+                out.append(merged)
+        return out
+    return [call.args]
+
+
+_TEXT_KEYS = ("content", "new_string", "file_content", "file_path")
+
+
+def _mentions(text: str, name: str) -> bool:
+    variants = {name, name.replace("-", "_"), name.replace("_", "-")}
+    return any(re.search(rf"(?<![\w-]){re.escape(v)}(?![\w-])", text) for v in variants)
+
+
+def classify_removed(
+    removed: Sequence[str], survivors: set[str], calls: Sequence[RecordedCall]
+) -> tuple[list[dict[str, str]], list[dict[str, str]]]:
+    """``(consolidated, pruned)`` for every removed skill (see the module notes)."""
+    ops = [op for call in calls for op in _manage_ops(call)]
+    declared: dict[str, str] = {}
+    for op in ops:
+        target = op.get("absorbed_into")
+        name = op.get("name")
+        if op.get("action") == "delete" and isinstance(name, str) and isinstance(target, str):
+            declared[name.strip()] = target.strip()
+    consolidated: list[dict[str, str]] = []
+    pruned: list[dict[str, str]] = []
+    for name in removed:
+        into = declared.get(name)
+        if into:
+            if into in survivors:
+                consolidated.append({"name": name, "into": into, "source": "declared at delete"})
+                continue
+        elif into == "":
+            pruned.append({"name": name, "source": "declared at delete"})
+            continue
+        found = None
+        for op in ops:
+            target = op.get("name")
+            if not isinstance(target, str) or target == name or target not in survivors:
+                continue
+            if any(isinstance(op.get(k), str) and _mentions(op[k], name) for k in _TEXT_KEYS):
+                found = target
+                break
+        if found is not None:
+            consolidated.append({"name": name, "into": found, "source": "tool-call audit"})
+        else:
+            pruned.append({"name": name, "source": "no successor found"})
+    return consolidated, pruned
+
+
+def rename_lines(
+    consolidated: Sequence[Mapping[str, str]], pruned: Sequence[Mapping[str, str]]
+) -> list[str]:
+    if not consolidated and not pruned:
+        return []
+    lines = [f"curator: {len(consolidated) + len(pruned)} skill(s) archived"]
+    lines += [f"  {e['name']} → {e['into']}" for e in consolidated]
+    lines += [f"  {e['name']} → (archived, no successor)" for e in pruned]
+    lines.append("  undo one with `indus curator restore <name>`")
+    return lines
+
+
+# -- the pass -------------------------------------------------------------------------------------
+
+
+@dataclass
+class ConsolidationResult:
+    ran: bool = False
+    summary: str = ""
+    model: str = ""
+    provider: str = ""
+    final: str = ""
+    error: str | None = None
+    writes_available: bool = False
+    tool_calls: dict[str, int] = field(default_factory=dict[str, int])
+    calls: list[dict[str, Any]] = field(default_factory=list[dict[str, Any]])
+    consolidated: list[dict[str, str]] = field(default_factory=list[dict[str, str]])
+    pruned: list[dict[str, str]] = field(default_factory=list[dict[str, str]])
+    added: list[str] = field(default_factory=list[str])
+    renames: dict[str, str] = field(default_factory=dict[str, str])
+    reference_rewrites: list[ReferenceRewrite] = field(default_factory=list[ReferenceRewrite])
+
+    def rename_lines(self) -> list[str]:
+        return rename_lines(self.consolidated, self.pruned)
+
+    def as_payload(self) -> dict[str, Any]:
+        return {
+            "ran": self.ran,
+            "summary": self.summary,
+            "model": self.model,
+            "provider": self.provider,
+            "final": self.final,
+            "error": self.error,
+            "writes_available": self.writes_available,
+            "tool_calls": dict(self.tool_calls),
+            "calls": list(self.calls),
+            "consolidated": list(self.consolidated),
+            "pruned": list(self.pruned),
+            "added": list(self.added),
+            "renames": dict(self.renames),
+            "reference_rewrites": [
+                {"source": r.source, "changes": list(r.changes), "error": r.error}
+                for r in self.reference_rewrites
+            ],
+        }
+
+
+def _assistant_row(response: NormalizedResponse) -> Message:
+    row: Message = {"role": "assistant", "content": response.content or ""}
+    if response.tool_calls:
+        row["tool_calls"] = [
+            {
+                "id": tc.id,
+                "type": "function",
+                "function": {"name": tc.name, "arguments": tc.arguments},
+            }
+            for tc in response.tool_calls
+        ]
+    return row
+
+
+def _preview(args: Mapping[str, Any]) -> dict[str, Any]:
+    out: dict[str, Any] = {}
+    for key, value in args.items():
+        out[key] = (
+            value[:_ARG_PREVIEW] + "…"
+            if isinstance(value, str) and len(value) > _ARG_PREVIEW
+            else value
+        )
+    return out
+
+
+async def _tool_loop(
+    scope: Scope,
+    step: ModelStep,
+    registry: ToolRegistry,
+    prompt: str,
+    *,
+    session_id: str,
+    max_iterations: int,
+    result: ConsolidationResult,
+) -> list[RecordedCall]:
+    messages: list[Message] = [
+        {"role": "system", "content": SYSTEM_TEXT},
+        {"role": "user", "content": prompt},
+    ]
+    tools = definitions(registry, registry.names(), scope=scope)
+    recorded: list[RecordedCall] = []
+    counts: Counter[str] = Counter()
+    ctx = ToolContext(scope=scope, session_id=session_id, task_id=session_id)
+    for _round in range(max_iterations):
+        response = await step(messages, tools)
+        messages.append(_assistant_row(response))
+        if not response.tool_calls:
+            result.final = (response.content or "").strip()
+            break
+        for tc in response.tool_calls:
+            counts[tc.name] += 1
+            try:
+                parsed = json.loads(tc.arguments) if tc.arguments.strip() else {}
+            except ValueError:
+                parsed = None
+            if not isinstance(parsed, dict):
+                outcome = ToolResult.error("arguments must be a JSON object")
+                args: dict[str, Any] = {}
+            else:
+                args = cast(dict[str, Any], parsed)
+                outcome = await dispatch(ToolCall(tc.name, args, tc.id), ctx, registry=registry)
+            recorded.append(RecordedCall(tc.name, args))
+            result.calls.append(
+                {"name": tc.name, "args": _preview(args), "error": outcome.is_error}
+            )
+            messages.append({"role": "tool", "tool_call_id": tc.id, "content": outcome.text})
+    else:
+        result.error = f"stopped after {max_iterations} rounds without a final report"
+    result.tool_calls = dict(counts)
+    return recorded
+
+
+async def run_consolidation(
+    scope: Scope,
+    step: ModelStep | None,
+    *,
+    dry_run: bool = False,
+    session_id: str = "curator",
+    max_iterations: int = ITERATION_CAP,
+    registry_factory: Callable[..., tuple[ToolRegistry, bool]] | None = None,
+) -> ConsolidationResult:
+    """One consolidation pass; never raises (an error ends up in ``result.error``)."""
+    result = ConsolidationResult()
+    candidates = candidate_list(scope)
+    if not candidates:
+        result.summary = "skipped (no skills to consolidate)"
+        return result
+    if step is None:
+        result.summary = "skipped (no model available for the curator task)"
+        result.error = "no model step"
+        return result
+    before = {o.name for o in managed_skills(scope)}
+    factory = registry_factory if registry_factory is not None else curator_registry
+    registry, can_write = factory(writes=not dry_run)
+    result.writes_available = can_write
+    prompt = f"{CURATOR_PROMPT}\n\n{candidates}"
+    if dry_run:
+        prompt = f"{DRY_RUN_PREFACE}\n\n{prompt}"
+    elif not can_write:
+        prompt = (
+            "Note: skill_manage is not available in this pass, so you can only read and "
+            f"report.\n\n{prompt}"
+        )
+    result.ran = True
+    recorded: list[RecordedCall] = []
+    try:
+        with bind_origin("background_review", attended=False):
+            recorded = await _tool_loop(
+                scope,
+                step,
+                registry,
+                prompt,
+                session_id=session_id,
+                max_iterations=max_iterations,
+                result=result,
+            )
+    except Exception as exc:
+        log.warning("curator consolidation stopped: %s: %s", type(exc).__name__, exc)
+        result.error = f"{type(exc).__name__}: {exc}"
+    result.model = getattr(step, "model", "") or ""
+    result.provider = getattr(step, "provider", "") or ""
+    after = {o.name for o in managed_skills(scope)}
+    removed = sorted(before - after)
+    result.added = sorted(after - before)
+    result.consolidated, result.pruned = classify_removed(removed, after, recorded)
+    result.renames = {e["name"]: e["into"] for e in result.consolidated}
+    if not dry_run:
+        result.reference_rewrites = rewrite_references(
+            result.renames, [e["name"] for e in result.pruned]
+        )
+    final = result.final or ("error: " + result.error if result.error else "no change")
+    result.summary = final if len(final) <= _SUMMARY_CHARS else final[:_SUMMARY_CHARS] + "…"
+    return result
diff --git a/src/indus/learning/curator/ledger_port.py b/src/indus/learning/curator/ledger_port.py
new file mode 100644
index 0000000..def1e4c
--- /dev/null
+++ b/src/indus/learning/curator/ledger_port.py
@@ -0,0 +1,134 @@
+"""Where the curator reports skill mutations: a small port the skill ledger (P09-13) plugs into.
+
+The curator moves folders (archive, restore), deletes old archives (purge) and lets a person edit
+a skill from the journey; each of those is ledgered so it can be audited and rolled back. Ledger
+writes are telemetry, never a gate: with no ledger plugged in, or when it fails, the mutation
+still happens and a debug line is logged.
+
+``capture(skill_dir)`` is called before the change and returns an opaque value the ledger later
+gets back in ``record``; ``after_dir`` is where the files are once the change is done (None when
+they are gone).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import threading
+from collections.abc import Callable, Generator, Mapping, Sequence
+from pathlib import Path
+from typing import Any, Protocol, runtime_checkable
+
+__all__ = [
+    "LedgerPort",
+    "capture",
+    "get_ledger",
+    "ledgered",
+    "record",
+    "set_ledger",
+]
+
+log = logging.getLogger(__name__)
+
+
+@runtime_checkable
+class LedgerPort(Protocol):
+    def capture(self, skill_dir: Path, *, skill: str) -> Any:
+        """The before-state of ``skill_dir`` (file hashes, contents stored once per hash)."""
+        ...
+
+    def record(
+        self,
+        action: str,
+        skill: str,
+        *,
+        actor: str,
+        before: Any,
+        after_dir: Path | None,
+        evidence: Mapping[str, Any] | None = None,
+    ) -> str | None:
+        """Append one entry; returns its id."""
+        ...
+
+    def entries(self, *, skill: str | None = None, limit: int = 20) -> Sequence[Mapping[str, Any]]:
+        """Newest first."""
+        ...
+
+    def get(self, entry_id: str) -> Mapping[str, Any] | None: ...
+
+    def rollback(self, entry_id: str) -> tuple[bool, str]:
+        """Restore exactly what one entry changed (fails closed)."""
+        ...
+
+
+_lock = threading.Lock()
+_port: LedgerPort | None = None
+
+
+def set_ledger(port: LedgerPort | None) -> Callable[[], None]:
+    """Plug ``port`` in (None unplugs); the returned callable restores the previous one."""
+    global _port
+    with _lock:
+        previous = _port
+        _port = port
+
+    def restore() -> None:
+        global _port
+        with _lock:
+            _port = previous
+
+    return restore
+
+
+def get_ledger() -> LedgerPort | None:
+    with _lock:
+        return _port
+
+
+def capture(skill_dir: Path, skill: str) -> Any:
+    port = get_ledger()
+    if port is None:
+        return None
+    try:
+        return port.capture(skill_dir, skill=skill)
+    except Exception:
+        log.debug("ledger capture of %s failed", skill, exc_info=True)
+        return None
+
+
+def record(
+    action: str,
+    skill: str,
+    *,
+    actor: str,
+    before: Any,
+    after_dir: Path | None,
+    evidence: Mapping[str, Any] | None = None,
+) -> str | None:
+    port = get_ledger()
+    if port is None:
+        return None
+    try:
+        return port.record(
+            action, skill, actor=actor, before=before, after_dir=after_dir, evidence=evidence
+        )
+    except Exception:
+        log.debug("ledger entry %s for %s not written", action, skill, exc_info=True)
+        return None
+
+
+@contextlib.contextmanager
+def ledgered(
+    action: str,
+    skill: str,
+    skill_dir: Path,
+    *,
+    actor: str,
+    evidence: Mapping[str, Any] | None = None,
+) -> Generator[dict[str, Path | None]]:
+    """Capture before the block, record after it when it finished; the block sets
+    ``out["after"]`` to where the files are now (default: ``skill_dir``)."""
+    before = capture(skill_dir, skill)
+    out: dict[str, Path | None] = {"after": skill_dir}
+    yield out
+    record(action, skill, actor=actor, before=before, after_dir=out["after"], evidence=evidence)
