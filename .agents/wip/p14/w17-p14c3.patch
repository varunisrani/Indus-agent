new file mode 100644
index 0000000..8c091ac
--- /dev/null
+++ b/src/indus/cron/delivery.py
@@ -0,0 +1,388 @@
+"""Sending a run's result: the deliverer registry, local delivery, redaction and the status split.
+
+``deliver(scope, job, text, …)`` picks the lane (``failure_deliver`` for failure notices when the
+job has one, else ``deliver``), parses it with ``cron.targets``, resolves ``origin`` from the job's
+stored origin (``local`` when there is none), masks secrets, wraps the text and hands one
+``DeliveryRequest`` per target to the deliverer registered for its platform. This phase registers
+``local`` only: the output document the runner already wrote is the delivery, plus an optional
+local notification (``cron.local_notify``). The gateway (P15-20) registers one deliverer per
+connected platform, and one for ``all``, with ``register_deliverer``.
+
+Rules:
+
+- an empty payload is never sent (status ``suppressed``);
+- secrets are masked on every lane whatever the log-redaction setting is; if masking fails the
+  payload is replaced by ``REDACTION_FAILED_NOTICE`` rather than sent unscanned; the job name in
+  the header is masked too;
+- the default wrapper puts a header naming the job above the text and a footer saying the agent
+  cannot see this message (``cron.wrap_response: false`` sends the text alone);
+- attachments are only ``Path`` objects the runner hands in, resolved and required to sit inside
+  the job's own output folder and to pass the P05 read guard; file paths are never taken from the
+  reply text, so a path the model (or an MCP server) writes can never be attached;
+- the result's status (``delivered``, ``delivery_failed`` with a reason, ``unverified``,
+  ``suppressed``) is separate from the run's status: a delivery failure never counts toward the
+  job's failure streak (R07.17).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import logging
+import os
+import sys
+import threading
+from collections.abc import Awaitable, Callable, Iterable, Sequence
+from dataclasses import dataclass
+from dataclasses import field as dc_field
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.cron import ports, targets
+from indus.cron.targets import DeliveryTarget
+from indus.foundation.scope import Scope
+from indus.safety import path_guards
+from indus.safety.redaction import redact_output
+
+__all__ = [
+    "REDACTION_FAILED_NOTICE",
+    "SEND_TIMEOUT_S",
+    "DeliveryReceipt",
+    "DeliveryRequest",
+    "DeliveryResult",
+    "TargetOutcome",
+    "deliver",
+    "deliverer_for",
+    "redact_payload",
+    "register_deliverer",
+    "registered_platforms",
+    "set_local_notifier",
+    "trusted_attachments",
+    "wrap",
+]
+
+log = logging.getLogger(__name__)
+
+REDACTION_FAILED_NOTICE = (
+    "[Indus withheld this scheduled-job message: secret masking failed, so the text was not sent. "
+    "The full output is in the job's output folder.]"
+)
+SEND_TIMEOUT_S = 60.0
+"""Upper bound for one deliverer call; a slower send counts as failed for that target."""
+
+type DeliveryStatus = Literal["delivered", "delivery_failed", "unverified", "suppressed"]
+type OutcomeStatus = Literal["delivered", "failed", "unverified"]
+
+
+@dataclass(frozen=True)
+class DeliveryRequest:
+    """One send. ``text`` is masked and wrapped; ``plain_text`` is masked and unwrapped."""
+
+    scope: Scope
+    job_id: str
+    job_name: str
+    target: DeliveryTarget
+    text: str
+    plain_text: str
+    for_failure: bool = False
+    output_path: Path | None = None
+    attachments: tuple[Path, ...] = ()
+
+
+@dataclass(frozen=True)
+class DeliveryReceipt:
+    """What a deliverer reports. ``verified`` False: the platform accepted the send without
+    giving evidence (no message id), so the status becomes ``unverified``."""
+
+    ok: bool
+    verified: bool = True
+    error: str | None = None
+    message_id: str | None = None
+
+
+@dataclass(frozen=True)
+class TargetOutcome:
+    target: str
+    status: OutcomeStatus
+    reason: str | None = None
+
+
+@dataclass(frozen=True)
+class DeliveryResult:
+    status: DeliveryStatus
+    reason: str | None = None
+    outcomes: tuple[TargetOutcome, ...] = ()
+    dropped_attachments: tuple[str, ...] = ()
+
+    @property
+    def failed(self) -> bool:
+        return self.status == "delivery_failed"
+
+    @property
+    def unverified_targets(self) -> tuple[str, ...]:
+        return tuple(o.target for o in self.outcomes if o.status == "unverified")
+
+
+type Deliverer = Callable[[DeliveryRequest], Awaitable[DeliveryReceipt]]
+type Notifier = Callable[[str, str], None]
+
+# -- the registry ---------------------------------------------------------------------------------
+
+_lock = threading.Lock()
+_deliverers: dict[str, Deliverer] = {}
+
+
+def register_deliverer(platform: str, fn: Deliverer) -> Callable[[], None]:
+    """Route targets on ``platform`` (or ``all``) to ``fn``; returns the undo.
+
+    A second registration for the same platform replaces the first (a reconnecting adapter).
+    """
+    key = platform.strip().lower()
+    if not key or key == targets.ORIGIN:
+        raise ValueError(f"cannot register a deliverer for {platform!r}")
+    with _lock:
+        _deliverers[key] = fn
+
+    def undo() -> None:
+        with _lock:
+            if _deliverers.get(key) is fn:
+                del _deliverers[key]
+
+    return undo
+
+
+def deliverer_for(platform: str) -> Deliverer | None:
+    with _lock:
+        return _deliverers.get(platform.strip().lower())
+
+
+def registered_platforms() -> list[str]:
+    with _lock:
+        return sorted(p for p in _deliverers if p not in targets.RESERVED)
+
+
+targets.set_live_platforms(registered_platforms)
+
+# -- masking and wrapping -------------------------------------------------------------------------
+
+REDACTOR: Callable[[str, Scope], str] = lambda text, scope: redact_output(  # noqa: E731
+    text, force=True, scope=scope
+)
+"""The masking step (tests replace it to make it fail)."""
+
+
+def redact_payload(text: str, scope: Scope, what: str = "payload") -> str:
+    """``text`` with secrets masked; ``REDACTION_FAILED_NOTICE`` if masking raised."""
+    if not text:
+        return text
+    try:
+        return REDACTOR(text, scope)
+    except Exception as exc:
+        log.warning(
+            "cron %s: secret masking failed (%s); sending a notice", what, type(exc).__name__
+        )
+        return REDACTION_FAILED_NOTICE
+
+
+def wrap(job_name: str, job_id: str, text: str) -> str:
+    """Our default framing: who sent this, then the text, then how to manage the job."""
+    return (
+        f"Scheduled job: {job_name} [{job_id}]\n\n"
+        f"{text}\n\n"
+        "-- Sent by the Indus scheduler. The agent does not see this message; to change, pause "
+        f"or remove the job, use `indus cron edit|pause|remove {job_id}` or ask in a chat."
+    )
+
+
+# -- local delivery -------------------------------------------------------------------------------
+
+
+def _terminal_notifier(title: str, line: str) -> None:
+    try:
+        if sys.stderr.isatty():
+            sys.stderr.write(f"\a[indus cron] {title}: {line}\n")
+            sys.stderr.flush()
+    except (OSError, ValueError):
+        pass
+
+
+_notifier: Notifier = _terminal_notifier
+
+
+def set_local_notifier(fn: Notifier | None) -> Notifier:
+    """Replace the local notification hook (None restores the terminal line); returns the old."""
+    global _notifier
+    old = _notifier
+    _notifier = fn if fn is not None else _terminal_notifier
+    return old
+
+
+async def _deliver_local(request: DeliveryRequest) -> DeliveryReceipt:
+    path = request.output_path
+    if path is None or not path.is_file():
+        return DeliveryReceipt(ok=False, error="the output document was not written")
+    if ports.flag_setting(request.scope, "local_notify", False):
+        first = next((ln.strip() for ln in request.plain_text.splitlines() if ln.strip()), "")
+        try:
+            _notifier(request.job_name, first[:200])
+        except Exception:
+            log.debug("local cron notification failed", exc_info=True)
+    return DeliveryReceipt(ok=True, message_id=str(path))
+
+
+register_deliverer(targets.LOCAL, _deliver_local)
+
+# -- attachments ----------------------------------------------------------------------------------
+
+
+def trusted_attachments(
+    scope: Scope, job_id: str, paths: Iterable[object]
+) -> tuple[tuple[Path, ...], tuple[str, ...]]:
+    """``(kept, refused reasons)``: only ``Path`` objects inside the job's output folder that the
+    P05 read guard allows. Text (a string path) is refused: it may come from model output."""
+    root = ports.output_dir(scope, job_id)
+    try:
+        root_real = root.resolve(strict=False)
+    except OSError:
+        return (), tuple(f"{p}: the output folder cannot be resolved" for p in paths)
+    kept: list[Path] = []
+    refused: list[str] = []
+    for item in paths:
+        if not isinstance(item, Path):
+            refused.append(f"{item!r}: only files the scheduler wrote can be attached")
+            continue
+        try:
+            real = item.resolve(strict=True)
+        except (OSError, RuntimeError):
+            refused.append(f"{item.name}: not found")
+            continue
+        if not real.is_relative_to(root_real) or not real.is_file():
+            refused.append(f"{item.name}: outside the job's output folder")
+            continue
+        denial = path_guards.read_denial(os.fspath(real), scope)
+        if denial is not None:
+            refused.append(f"{item.name}: {denial}")
+            continue
+        kept.append(real)
+    return tuple(kept), tuple(refused)
+
+
+# -- delivering -----------------------------------------------------------------------------------
+
+
+@dataclass
+class _Plan:
+    sends: list[DeliveryTarget] = dc_field(default_factory=list[DeliveryTarget])
+    failures: list[TargetOutcome] = dc_field(default_factory=list[TargetOutcome])
+
+
+def lane_value(job: Any, *, for_failure: bool) -> str:
+    """The ``deliver`` text for this notice: ``failure_deliver`` for failures when set."""
+    if for_failure:
+        failure_lane = ports.field(job, "failure_deliver")
+        if isinstance(failure_lane, str | list) and targets.split_tokens(failure_lane):  # pyright: ignore[reportUnknownArgumentType]
+            return targets.join_tokens(targets.split_tokens(failure_lane))  # pyright: ignore[reportUnknownArgumentType]
+    raw = ports.field(job, "deliver", targets.LOCAL)
+    tokens = targets.split_tokens(raw if isinstance(raw, str | list) else str(raw))  # pyright: ignore[reportUnknownArgumentType]
+    return targets.join_tokens(tokens) or targets.LOCAL
+
+
+def plan_targets(job: Any, value: str) -> _Plan:
+    """Parse ``value`` and resolve ``origin`` for ``job``; problems become failed outcomes."""
+    parsed = targets.parse_targets(value)
+    plan = _Plan()
+    for problem in parsed.problems:
+        plan.failures.append(
+            TargetOutcome(problem.token, "failed", f"{problem.code}: {problem.message}")
+        )
+    seen: set[tuple[str, str | None, str | None]] = set()
+    for target in parsed.targets:
+        resolved = target
+        if target.is_origin:
+            resolved = targets.origin_target(ports.origin_of(job)) or DeliveryTarget(
+                targets.LOCAL, raw=targets.ORIGIN
+            )
+        if resolved.key in seen:
+            continue
+        seen.add(resolved.key)
+        plan.sends.append(resolved)
+    return plan
+
+
+async def _send(deliverer: Any, request: DeliveryRequest) -> TargetOutcome:
+    where = request.target.render()
+    try:
+        receipt = await asyncio.wait_for(deliverer(request), SEND_TIMEOUT_S)
+    except TimeoutError:
+        return TargetOutcome(where, "failed", f"no answer within {SEND_TIMEOUT_S:g} s")
+    except Exception as exc:
+        detail = redact_payload(str(exc), request.scope, "delivery error")[:300]
+        return TargetOutcome(where, "failed", f"{type(exc).__name__}: {detail}".rstrip(": "))
+    if not isinstance(receipt, DeliveryReceipt):
+        return TargetOutcome(where, "failed", "the deliverer gave no receipt")
+    if not receipt.ok:
+        detail = redact_payload(receipt.error or "refused", request.scope, "delivery error")
+        return TargetOutcome(where, "failed", detail[:300])
+    if not receipt.verified:
+        return TargetOutcome(where, "unverified", "accepted without confirmation")
+    return TargetOutcome(where, "delivered")
+
+
+def _missing_deliverer(target: DeliveryTarget) -> str:
+    if target.is_broadcast:
+        return "`all` needs the gateway: no connected platform to deliver to"
+    return f"platform delivery needs the gateway (nothing delivers to {target.platform} yet)"
+
+
+async def deliver(
+    scope: Scope,
+    job: Any,
+    text: str,
+    *,
+    for_failure: bool = False,
+    output_path: Path | None = None,
+    attachments: Sequence[object] = (),
+) -> DeliveryResult:
+    """Deliver ``text`` for ``job`` (see the module notes)."""
+    if not text or not text.strip():
+        return DeliveryResult("suppressed", "nothing to send")
+    job_id = str(ports.field(job, "id", "") or "")
+    raw_name = str(ports.field(job, "name", "") or job_id or "cron job")
+    name = redact_payload(raw_name, scope, "job name")
+    plain = redact_payload(text.strip(), scope, "delivery")
+    framed = (
+        wrap(name, job_id, plain) if ports.flag_setting(scope, "wrap_response", True) else plain
+    )
+    kept, refused = trusted_attachments(scope, job_id, attachments) if attachments else ((), ())
+    plan = plan_targets(job, lane_value(job, for_failure=for_failure))
+    outcomes = list(plan.failures)
+    for target in plan.sends:
+        fn = deliverer_for(target.platform)
+        if fn is None:
+            outcomes.append(TargetOutcome(target.render(), "failed", _missing_deliverer(target)))
+            continue
+        request = DeliveryRequest(
+            scope=scope,
+            job_id=job_id,
+            job_name=name,
+            target=target,
+            text=framed,
+            plain_text=plain,
+            for_failure=for_failure,
+            output_path=output_path,
+            attachments=kept,
+        )
+        outcomes.append(await _send(fn, request))
+    return _summarise(outcomes, refused)
+
+
+def _summarise(outcomes: list[TargetOutcome], refused: tuple[str, ...]) -> DeliveryResult:
+    reasons = [f"{o.target}: {o.reason}" for o in outcomes if o.status == "failed"]
+    if refused:
+        reasons.append(f"{len(refused)} attachment(s) refused: " + "; ".join(refused))
+    if reasons:
+        return DeliveryResult("delivery_failed", "; ".join(reasons), tuple(outcomes), refused)
+    if not outcomes:
+        return DeliveryResult("delivery_failed", "no delivery target", (), refused)
+    if any(o.status == "unverified" for o in outcomes):
+        return DeliveryResult("unverified", "a platform gave no confirmation", tuple(outcomes))
+    return DeliveryResult("delivered", None, tuple(outcomes))
diff --git a/src/indus/cron/doctor.py b/src/indus/cron/doctor.py
new file mode 100644
index 0000000..3d641ae
--- /dev/null
+++ b/src/indus/cron/doctor.py
@@ -0,0 +1,167 @@
+"""``indus cron doctor``: a read-only health check of the active jobs (P14-19).
+
+Per active job (enabled, not paused, not completed) it reports: the last run failed; the last
+result was not delivered, or a platform did not confirm it; the last fire was late or a catch-up
+(when the ticker recorded ``last_dispatch``); the next run is missing or more than 15 minutes in
+the past (the ticker is probably not running); the script is missing or resolves outside
+``<home>/scripts/``; a script-only job has no script; the working folder is gone. A store that
+cannot be written is a finding too. Nothing is changed; the command exits 1 while any finding
+stands.
+
+``overdue_seconds`` and ``OVERDUE_GRACE_S`` are shared with ``list`` and ``status`` so the three
+agree on what "overdue" means.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import datetime
+from pathlib import Path
+from typing import Any
+
+from indus.cron import ports
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "OVERDUE_GRACE_S",
+    "DoctorReport",
+    "Finding",
+    "duration_label",
+    "findings_for",
+    "is_active",
+    "is_overdue",
+    "overdue_seconds",
+    "run_doctor",
+]
+
+OVERDUE_GRACE_S = 15 * 60
+SUCCESS_STATUSES = frozenset({"ok", "silent", "no_change", "delivery_failed", "skipped"})
+
+
+@dataclass(frozen=True)
+class Finding:
+    job_id: str
+    name: str
+    message: str
+
+
+@dataclass(frozen=True)
+class DoctorReport:
+    checked: int
+    findings: list[Finding] = field(default_factory=list[Finding])
+    store_problem: str | None = None
+
+    @property
+    def ok(self) -> bool:
+        return not self.findings and self.store_problem is None
+
+
+def is_active(job: Any) -> bool:
+    return bool(ports.field(job, "enabled", True)) and ports.field(job, "state") not in (
+        "paused",
+        "completed",
+    )
+
+
+def overdue_seconds(job: Any, now: datetime) -> float | None:
+    """How far ``next_run_at`` lies in the past (negative while upcoming); None if unreadable."""
+    when = ports.parse_instant(ports.field(job, "next_run_at"))
+    return None if when is None else (now - when).total_seconds()
+
+
+def is_overdue(job: Any, now: datetime) -> bool:
+    late = overdue_seconds(job, now)
+    return is_active(job) and late is not None and late > OVERDUE_GRACE_S
+
+
+def duration_label(seconds: float) -> str:
+    seconds = max(0, int(seconds))
+    if seconds < 60:
+        return f"{seconds}s"
+    minutes = seconds // 60
+    if minutes < 60:
+        return f"{minutes}m"
+    hours, minutes = divmod(minutes, 60)
+    if hours < 48:
+        return f"{hours}h {minutes}m" if minutes else f"{hours}h"
+    return f"{hours // 24}d {hours % 24}h"
+
+
+def _script_issue(scripts: Path, name: str) -> str | None:
+    raw = Path(name).expanduser()
+    try:
+        root = scripts.resolve()
+        resolved = raw.resolve() if raw.is_absolute() else (scripts / raw).resolve()
+    except OSError as exc:
+        return f"script {name!r} cannot be resolved: {exc}"
+    if not resolved.is_relative_to(root):
+        return f"script {name!r} resolves outside {scripts}/"
+    if not resolved.is_file():
+        return f"script {name!r} is missing from {scripts}/"
+    return None
+
+
+def findings_for(job: Any, *, now: datetime, scripts: Path) -> list[str]:
+    """What looks wrong with one job (see the module notes); empty when healthy."""
+    issues: list[str] = []
+    status = str(ports.field(job, "last_status", "") or "").strip().lower()
+    if status and status not in SUCCESS_STATUSES:
+        detail = str(ports.field(job, "last_error", "") or status).strip()
+        issues.append(f"last run failed ({status}): {detail[:200]}")
+    delivery_error = str(ports.field(job, "last_delivery_error", "") or "").strip()
+    if delivery_error:
+        issues.append(f"last result was not delivered: {delivery_error[:200]}")
+    unverified = ports.field(job, "last_delivery_unverified")
+    if unverified:
+        listed = (
+            ", ".join(str(t) for t in unverified)
+            if isinstance(unverified, list)
+            else str(unverified)
+        )  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+        issues.append(f"last delivery was not confirmed by: {listed}")
+    dispatch = ports.field(job, "last_dispatch")
+    kind = str(ports.field(dispatch, "kind", "") or "") if dispatch is not None else ""
+    if kind in ("late", "catch_up"):
+        late = ports.field(dispatch, "lateness_seconds", 0) or 0
+        label = "a catch-up for missed runs" if kind == "catch_up" else "late"
+        issues.append(
+            f"last run was {label} ({duration_label(float(late))} after its slot); this clears "
+            "after the next on-time run"
+        )
+    if is_active(job):
+        late = overdue_seconds(job, now)
+        if not ports.field(job, "next_run_at"):
+            issues.append("active job has no next run time")
+        elif late is None:
+            issues.append(f"next run time is not readable: {ports.field(job, 'next_run_at')!r}")
+        elif late > OVERDUE_GRACE_S:
+            issues.append(
+                f"next run is {duration_label(late)} overdue: the job is not firing (is the "
+                "ticker running? see `indus cron status`)"
+            )
+    script = str(ports.field(job, "script", "") or "").strip()
+    if ports.field(job, "no_agent") and not script:
+        issues.append("script-only job has no script")
+    if script and (problem := _script_issue(scripts, script)):
+        issues.append(problem)
+    watcher = str(ports.field(job, "monitor_script", "") or "").strip()
+    if watcher and (problem := _script_issue(scripts, watcher)):
+        issues.append(f"monitor {problem}")
+    workdir = str(ports.field(job, "workdir", "") or "").strip()
+    if workdir and not Path(workdir).expanduser().is_dir():
+        issues.append(f"working folder {workdir} no longer exists")
+    return issues
+
+
+def run_doctor(backend: ports.CronBackend, scope: Scope) -> DoctorReport:
+    health = backend.store_health()
+    store_problem = None if health.writable else (health.reason or "the cron store is not writable")
+    jobs = [j for j in backend.list_jobs(include_disabled=False) if is_active(j)]
+    now = scope.clock.now()
+    scripts = ports.scripts_dir(scope)
+    findings = [
+        Finding(str(ports.field(j, "id", "?")), str(ports.field(j, "name", "") or ""), issue)
+        for j in jobs
+        for issue in findings_for(j, now=now, scripts=scripts)
+    ]
+    return DoctorReport(len(jobs), findings, store_problem)
diff --git a/src/indus/cron/incidents.py b/src/indus/cron/incidents.py
new file mode 100644
index 0000000..c9049a5
--- /dev/null
+++ b/src/indus/cron/incidents.py
@@ -0,0 +1,329 @@
+"""Failure incidents: one alert per distinct failure, a reminder later, silence once acknowledged.
+
+Failures of a job are grouped by a signature of their error text: lower-cased, whitespace runs
+collapsed, measured durations (``31.2s``, ``45 seconds``, ``2 h``) replaced, then the first 200
+characters hashed together with the job id. Each group is one row in ``cron_incidents`` inside
+``<home>/cron/executions.db`` (the execution ledger's file); the stored error is secret-masked and
+cut to 500 characters.
+
+States: ``detected`` (seen, no alert out yet) → ``alerted`` (an alert went out at ``alerted_at``)
+→ ``resolved`` (the job ran fine afterwards; a repeat of the error re-opens the row as
+``detected``) or ``closed`` (acknowledged by the person; stays silent for that signature).
+
+``decide_failure_alert`` is what the runner calls for a failed run: it records the failure and
+says whether to alert — first time yes; while ``alerted`` no, until
+``cron.failure_repeat_alert_hours`` (6; 0 = every run) have passed since the last alert; ``closed``
+never. When the table cannot be
+read or written the answer is "alert" (a broken ledger must not swallow failures).
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import logging
+import os
+import re
+import sqlite3
+import threading
+from collections.abc import Iterator
+from dataclasses import dataclass
+from datetime import datetime, timedelta
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.cron import ports
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.safety.redaction import redact_output
+
+__all__ = [
+    "MAX_ERROR_CHARS",
+    "SIGNATURE_CHARS",
+    "STATES",
+    "AlertDecision",
+    "Incident",
+    "IncidentLedger",
+    "decide_failure_alert",
+    "error_signature",
+]
+
+log = logging.getLogger(__name__)
+
+STATES = ("detected", "alerted", "resolved", "closed")
+MAX_ERROR_CHARS = 500
+SIGNATURE_CHARS = 200
+BUSY_TIMEOUT_S = 5.0
+
+type IncidentState = Literal["detected", "alerted", "resolved", "closed"]
+
+_DURATION = re.compile(
+    r"\b\d+(?:\.\d+)?\s*(?:ms|msecs?|milliseconds?|s|secs?|seconds?|m|mins?|minutes?|h|hrs?|"
+    r"hours?)\b"
+)
+_SPACES = re.compile(r"\s+")
+
+_SCHEMA = """
+CREATE TABLE IF NOT EXISTS cron_incidents (
+    id            TEXT PRIMARY KEY,
+    job_id        TEXT NOT NULL,
+    signature     TEXT NOT NULL,
+    state         TEXT NOT NULL,
+    error         TEXT NOT NULL,
+    output_path   TEXT,
+    first_seen_at TEXT NOT NULL,
+    last_seen_at  TEXT NOT NULL,
+    alerted_at    TEXT,
+    resolved_at   TEXT,
+    acked_at      TEXT,
+    occurrences   INTEGER NOT NULL DEFAULT 1
+);
+CREATE INDEX IF NOT EXISTS cron_incidents_job ON cron_incidents(job_id);
+CREATE INDEX IF NOT EXISTS cron_incidents_state ON cron_incidents(state);
+"""
+
+
+def normalise_error(error: str) -> str:
+    text = _SPACES.sub(" ", str(error or "")).strip().lower()
+    return _DURATION.sub("<t>", text)[:SIGNATURE_CHARS]
+
+
+def error_signature(job_id: str, error: str) -> str:
+    digest = hashlib.sha256(f"{job_id}\n{normalise_error(error)}".encode()).hexdigest()
+    return digest[:12]
+
+
+def incident_id(job_id: str, signature: str) -> str:
+    return f"{job_id[:6]}_{signature}"
+
+
+@dataclass(frozen=True)
+class Incident:
+    id: str
+    job_id: str
+    signature: str
+    state: IncidentState
+    error: str
+    output_path: str | None
+    first_seen_at: str
+    last_seen_at: str
+    alerted_at: str | None
+    resolved_at: str | None
+    acked_at: str | None
+    occurrences: int
+
+    @classmethod
+    def from_row(cls, row: sqlite3.Row) -> Incident:
+        return cls(**{key: row[key] for key in row.keys()})  # noqa: SIM118
+
+
+@dataclass(frozen=True)
+class AlertDecision:
+    alert: bool
+    incident_id: str | None
+    reason: str
+
+
+class IncidentLedger:
+    """The ``cron_incidents`` table of one profile's ``executions.db``."""
+
+    def __init__(self, path: Path, clock: Clock) -> None:
+        self.path = path
+        self.clock = clock
+        self._lock = threading.Lock()
+
+    @classmethod
+    def for_scope(cls, scope: Scope) -> IncidentLedger:
+        return cls(ports.cron_dir(scope) / "executions.db", scope.clock)
+
+    # -- plumbing ------------------------------------------------------------------------------
+
+    def _ensure_file(self) -> None:
+        folder = self.path.parent
+        if not folder.exists():
+            folder.mkdir(parents=True, exist_ok=True)
+            with contextlib.suppress(OSError):
+                os.chmod(folder, 0o700)
+        if not self.path.exists():
+            fd = os.open(self.path, os.O_CREAT | os.O_WRONLY, 0o600)
+            os.close(fd)
+
+    @contextlib.contextmanager
+    def _tx(self) -> Iterator[sqlite3.Connection]:
+        with self._lock:
+            self._ensure_file()
+            conn = sqlite3.connect(self.path, timeout=BUSY_TIMEOUT_S, isolation_level=None)
+            try:
+                conn.row_factory = sqlite3.Row
+                conn.executescript(_SCHEMA)
+                conn.execute("BEGIN IMMEDIATE")
+                try:
+                    yield conn
+                except BaseException:
+                    conn.execute("ROLLBACK")
+                    raise
+                conn.execute("COMMIT")
+            finally:
+                conn.close()
+
+    def _now(self) -> datetime:
+        return self.clock.now()
+
+    # -- writes ----------------------------------------------------------------------------------
+
+    def record_failure(
+        self, job_id: str, error: str, *, output_path: str | None = None, scope: Scope | None = None
+    ) -> tuple[Incident, bool]:
+        """Record one failure; ``(incident, reopened_or_new)``. A resolved row re-opens."""
+        signature = error_signature(job_id, error)
+        ident = incident_id(job_id, signature)
+        stored = _stored_error(error, scope)
+        now = ports.iso(self._now())
+        with self._tx() as conn:
+            row = conn.execute("SELECT state FROM cron_incidents WHERE id=?", (ident,)).fetchone()
+            fresh = row is None or row["state"] == "resolved"
+            if row is None:
+                conn.execute(
+                    "INSERT INTO cron_incidents (id, job_id, signature, state, error, output_path,"
+                    " first_seen_at, last_seen_at) VALUES (?, ?, ?, 'detected', ?, ?, ?, ?)",
+                    (ident, job_id, signature, stored, output_path, now, now),
+                )
+            elif row["state"] == "resolved":
+                conn.execute(
+                    "UPDATE cron_incidents SET state='detected', alerted_at=NULL, resolved_at=NULL,"
+                    " error=?, output_path=?, last_seen_at=?, occurrences=occurrences+1 WHERE id=?",
+                    (stored, output_path, now, ident),
+                )
+            else:
+                conn.execute(
+                    "UPDATE cron_incidents SET error=?, output_path=?, last_seen_at=?,"
+                    " occurrences=occurrences+1 WHERE id=?",
+                    (stored, output_path, now, ident),
+                )
+            current = conn.execute("SELECT * FROM cron_incidents WHERE id=?", (ident,)).fetchone()
+        return Incident.from_row(current), fresh
+
+    def mark_alerted(self, ident: str) -> bool:
+        """An alert went out now (restarts the reminder window); never re-opens a closed row."""
+        with self._tx() as conn:
+            cur = conn.execute(
+                "UPDATE cron_incidents SET state='alerted', alerted_at=? "
+                "WHERE id=? AND state != 'closed'",
+                (ports.iso(self._now()), ident),
+            )
+            return cur.rowcount > 0
+
+    def resolve_job(self, job_id: str) -> int:
+        """The job ran fine: its open incidents become ``resolved``; how many."""
+        with self._tx() as conn:
+            cur = conn.execute(
+                "UPDATE cron_incidents SET state='resolved', resolved_at=? "
+                "WHERE job_id=? AND state IN ('detected', 'alerted')",
+                (ports.iso(self._now()), job_id),
+            )
+            return cur.rowcount
+
+    def ack(self, ident: str) -> bool:
+        """Acknowledge: the signature stays silent. False for unknown or already closed rows."""
+        with self._tx() as conn:
+            cur = conn.execute(
+                "UPDATE cron_incidents SET state='closed', acked_at=? "
+                "WHERE id=? AND state != 'closed'",
+                (ports.iso(self._now()), ident),
+            )
+            return cur.rowcount > 0
+
+    def forget_job(self, job_id: str) -> int:
+        with self._tx() as conn:
+            return conn.execute("DELETE FROM cron_incidents WHERE job_id=?", (job_id,)).rowcount
+
+    # -- reads -----------------------------------------------------------------------------------
+
+    def get(self, ident: str) -> Incident | None:
+        if not self.path.exists():
+            return None
+        with self._tx() as conn:
+            row = conn.execute("SELECT * FROM cron_incidents WHERE id=?", (ident,)).fetchone()
+        return Incident.from_row(row) if row is not None else None
+
+    def list(self, state: str | None = None, *, job_id: str | None = None) -> list[Incident]:
+        """Newest activity first, optionally one state and/or one job."""
+        if not self.path.exists():
+            return []  # reading never creates the ledger file
+        clauses: list[str] = []
+        params: list[Any] = []
+        if state is not None:
+            if state not in STATES:
+                return []
+            clauses.append("state=?")
+            params.append(state)
+        if job_id is not None:
+            clauses.append("job_id=?")
+            params.append(job_id)
+        where = f" WHERE {' AND '.join(clauses)}" if clauses else ""
+        with self._tx() as conn:
+            rows = conn.execute(
+                f"SELECT * FROM cron_incidents{where} ORDER BY last_seen_at DESC, id",  # noqa: S608
+                params,
+            ).fetchall()
+        return [Incident.from_row(r) for r in rows]
+
+
+def _stored_error(error: str, scope: Scope | None) -> str:
+    text = str(error or "")
+    try:
+        text = redact_output(text, force=True, scope=scope)
+    except Exception:
+        text = "[error text withheld: masking failed]"
+    return text[:MAX_ERROR_CHARS]
+
+
+def _withheld(incident: Incident, now: datetime, repeat_hours: float) -> bool:
+    if incident.state == "closed":
+        return True
+    if incident.state != "alerted" or repeat_hours <= 0:
+        return False
+    last = ports.parse_instant(incident.alerted_at)
+    if last is None:
+        return False
+    return now - last < timedelta(hours=repeat_hours)
+
+
+def decide_failure_alert(
+    scope: Scope,
+    job_id: str,
+    error: str,
+    *,
+    output_path: str | None = None,
+    ledger: IncidentLedger | None = None,
+) -> AlertDecision:
+    """Record a failure and say whether to alert; marks the incident alerted when it says yes.
+
+    The caller that then fails to send calls nothing: the next failure alerts again only after
+    the reminder window, so a lost alert is retried at the reminder at the latest.
+    """
+    book = ledger if ledger is not None else IncidentLedger.for_scope(scope)
+    hours = ports.number_setting(scope, "failure_repeat_alert_hours", 6.0)
+    try:
+        incident, _fresh = book.record_failure(job_id, error, output_path=output_path, scope=scope)
+        if _withheld(incident, book.clock.now(), hours):
+            why = "acknowledged" if incident.state == "closed" else "already alerted"
+            return AlertDecision(False, incident.id, why)
+        book.mark_alerted(incident.id)
+        reason = "reminder" if incident.state == "alerted" else "new"
+        return AlertDecision(True, incident.id, reason)
+    except (sqlite3.Error, OSError) as exc:
+        log.warning("cron incident ledger unavailable (%s); alerting anyway", type(exc).__name__)
+        return AlertDecision(True, None, "incident ledger unavailable")
+
+
+def resolve_after_success(
+    scope: Scope, job_id: str, *, ledger: IncidentLedger | None = None
+) -> int:
+    """Best effort: a successful run resolves the job's open incidents."""
+    book = ledger if ledger is not None else IncidentLedger.for_scope(scope)
+    try:
+        return book.resolve_job(job_id)
+    except (sqlite3.Error, OSError) as exc:
+        log.debug("cron incident ledger unavailable: %s", exc)
+        return 0
diff --git a/src/indus/cron/monitor.py b/src/indus/cron/monitor.py
new file mode 100644
index 0000000..df862ed
--- /dev/null
+++ b/src/indus/cron/monitor.py
@@ -0,0 +1,255 @@
+"""Monitor mode: run a cheap source first and wake the agent only when its output changed (H7).
+
+A job names either ``monitor_script`` (a file in ``<home>/scripts/``, run by the cron script runner
+with the same folder and environment rules as pre-run scripts) or ``monitor_url`` (fetched over
+http(s) through the P05 URL policy: 30 s, at most 256 KiB — a bigger body is an error). The exact
+output bytes are hashed with SHA-256:
+
+- same hash as the stored ``monitor_state.hash`` → ``no_change``: the run is skipped, no model call;
+- no stored hash → ``first``: the prompt gets the current output;
+- another hash → ``changed``: the prompt gets a unified diff against the last output (≤ 4,000
+  characters) and the current output (≤ 8,000 characters);
+- the source failing → ``error``: never a change; the stored hash and snapshot stay as they were.
+
+On ``first``/``changed`` the new snapshot is written to
+``<home>/cron/output/<job_id>/monitor_last_output.txt`` before the agent runs, and the outcome
+carries the new ``monitor_state {hash, last_output_path}`` for the caller to store on the job.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import difflib
+import hashlib
+import logging
+from collections.abc import Awaitable, Callable
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Literal
+
+import httpx
+
+from indus.cron import ports
+from indus.foundation import fsio
+from indus.foundation.scope import Scope
+from indus.safety.safe_transport import ConnectBlocked, TransportFactory, safe_client
+from indus.safety.url_policy import Blocked, Resolver, check_url_async
+
+__all__ = [
+    "MAX_DIFF_CHARS",
+    "MAX_OUTPUT_CHARS",
+    "MAX_URL_BYTES",
+    "SNAPSHOT_NAME",
+    "URL_TIMEOUT_S",
+    "MonitorOutcome",
+    "check_monitor",
+    "fetch_url",
+    "has_monitor",
+    "split_monitor",
+    "validate_monitor",
+]
+
+log = logging.getLogger(__name__)
+
+MAX_DIFF_CHARS = 4000
+MAX_OUTPUT_CHARS = 8000
+URL_TIMEOUT_S = 30.0
+MAX_URL_BYTES = 256 * 1024
+SNAPSHOT_NAME = "monitor_last_output.txt"
+_CUT = "\n[… cut]"
+
+type MonitorStatus = Literal["first", "changed", "no_change", "error"]
+type ScriptRunner = Callable[[Scope, str, Any], Awaitable[tuple[bool, str]]]
+"""``(scope, script name, job) -> (ok, stdout or error)`` — the cron script runner (P14-09)."""
+
+RUN_SCRIPT: ScriptRunner | None = None
+"""Set by the host to the cron script runner; tests pass ``run_script`` directly."""
+
+
+@dataclass(frozen=True)
+class MonitorOutcome:
+    status: MonitorStatus
+    block: str | None = None
+    error: str | None = None
+    state: dict[str, str] | None = None
+
+    @property
+    def should_run(self) -> bool:
+        return self.status in ("first", "changed")
+
+
+# -- specs --------------------------------------------------------------------------------------
+
+
+def has_monitor(job: Any) -> bool:
+    return bool(_text(ports.field(job, "monitor_script")) or _text(ports.field(job, "monitor_url")))
+
+
+def _text(value: object) -> str:
+    return str(value).strip() if value is not None else ""
+
+
+def split_monitor(value: str | None) -> tuple[str | None, str | None]:
+    """One user-facing ``monitor`` value → ``(monitor_script, monitor_url)``; '' clears both."""
+    text = (value or "").strip()
+    if not text:
+        return None, None
+    if text.lower().startswith(("http://", "https://")):
+        return None, text
+    return text, None
+
+
+def validate_monitor(
+    monitor_script: str | None, monitor_url: str | None, *, no_agent: bool = False
+) -> str | None:
+    """Why this monitor spec is refused, or None."""
+    script, url = _text(monitor_script), _text(monitor_url)
+    if not script and not url:
+        return None
+    if script and url:
+        return "a job takes a monitor script or a monitor URL, not both"
+    if no_agent:
+        return "monitor mode wakes the agent, so it cannot be used on a script-only (no_agent) job"
+    if url and not url.lower().startswith(("http://", "https://")):
+        return f"the monitor URL must start with http:// or https:// (got {url!r})"
+    return None
+
+
+# -- fetching -------------------------------------------------------------------------------------
+
+
+async def fetch_url(
+    scope: Scope,
+    url: str,
+    *,
+    resolver: Resolver | None = None,
+    inner_factory: TransportFactory | None = None,
+) -> tuple[bool, bytes | str]:
+    """``(True, body)`` or ``(False, reason)``; never raises."""
+    if not url.lower().startswith(("http://", "https://")):
+        return False, f"the monitor URL must be http(s): {url!r}"
+    verdict = await check_url_async(url, scope, resolver=resolver)
+    if isinstance(verdict, Blocked):
+        return False, f"the monitor URL was refused: {verdict.reason}"
+    client = safe_client(
+        scope,
+        resolver=resolver,
+        inner_factory=inner_factory,
+        timeout=httpx.Timeout(URL_TIMEOUT_S),
+        headers={"User-Agent": "indus-cron-monitor"},
+    )
+    try:
+        async with client:
+            return await asyncio.wait_for(_read_capped(client, url), URL_TIMEOUT_S)
+    except ConnectBlocked as exc:
+        return False, f"the monitor URL was refused: {exc.verdict.reason}"
+    except TimeoutError:
+        return False, f"the monitor URL did not answer within {URL_TIMEOUT_S:g} s"
+    except httpx.HTTPError as exc:
+        return False, f"the monitor URL could not be fetched: {type(exc).__name__}"
+
+
+async def _read_capped(client: httpx.AsyncClient, url: str) -> tuple[bool, bytes | str]:
+    async with client.stream("GET", url) as response:
+        if response.status_code >= 400:
+            return False, f"the monitor URL answered HTTP {response.status_code}"
+        chunks: list[bytes] = []
+        size = 0
+        async for chunk in response.aiter_bytes():
+            size += len(chunk)
+            if size > MAX_URL_BYTES:
+                return False, f"the monitor URL returned more than {MAX_URL_BYTES // 1024} KiB"
+            chunks.append(chunk)
+        return True, b"".join(chunks)
+
+
+# -- the check ------------------------------------------------------------------------------------
+
+
+def _cap(text: str, limit: int) -> str:
+    return text if len(text) <= limit else text[: limit - len(_CUT)] + _CUT
+
+
+def build_diff(old: str, new: str) -> str:
+    lines = difflib.unified_diff(
+        old.splitlines(), new.splitlines(), fromfile="last run", tofile="this run", lineterm=""
+    )
+    return _cap("\n".join(lines), MAX_DIFF_CHARS)
+
+
+def snapshot_path(scope: Scope, job_id: str) -> Path:
+    return ports.output_dir(scope, job_id) / SNAPSHOT_NAME
+
+
+async def _source_output(
+    scope: Scope,
+    job: Any,
+    run_script: ScriptRunner | None,
+    resolver: Resolver | None,
+    inner_factory: TransportFactory | None,
+) -> tuple[bool, bytes | str]:
+    script = _text(ports.field(job, "monitor_script"))
+    url = _text(ports.field(job, "monitor_url"))
+    if script:
+        runner = run_script if run_script is not None else RUN_SCRIPT
+        if runner is None:
+            return False, "the cron script runner is not available"
+        try:
+            ok, out = await runner(scope, script, job)
+        except Exception as exc:
+            return False, f"the monitor script failed: {type(exc).__name__}: {exc}"
+        return (True, out.encode("utf-8", "replace")) if ok else (False, out or "script failed")
+    if url:
+        return await fetch_url(scope, url, resolver=resolver, inner_factory=inner_factory)
+    return False, "the job has no monitor source"
+
+
+async def check_monitor(
+    scope: Scope,
+    job: Any,
+    *,
+    run_script: ScriptRunner | None = None,
+    resolver: Resolver | None = None,
+    inner_factory: TransportFactory | None = None,
+) -> MonitorOutcome:
+    """Run the job's monitor source and decide whether the agent runs (see the module notes)."""
+    job_id = str(ports.field(job, "id", "") or "")
+    ok, produced = await _source_output(scope, job, run_script, resolver, inner_factory)
+    if not ok or not isinstance(produced, bytes):
+        return MonitorOutcome("error", error=str(produced))
+    digest = hashlib.sha256(produced).hexdigest()
+    state = ports.field(job, "monitor_state")
+    last_hash = _text(ports.field(state, "hash")) if state is not None else ""
+    if last_hash and last_hash == digest:
+        return MonitorOutcome("no_change")
+    current = produced.decode("utf-8", "replace")
+    path = snapshot_path(scope, job_id)
+    old = ""
+    if last_hash:
+        try:
+            old = path.read_bytes().decode("utf-8", "replace")
+        except OSError:
+            old = ""
+    shown = f"### Output now\n\n```\n{_cap(current, MAX_OUTPUT_CHARS)}\n```"
+    if last_hash:
+        status: MonitorStatus = "changed"
+        block = (
+            "## Monitored source changed\n\n"
+            "The output of this job's monitor differs from the last run.\n\n"
+            f"### What changed\n\n```diff\n{build_diff(old, current)}\n```\n\n{shown}"
+        )
+    else:
+        status = "first"
+        block = (
+            "## Monitored source: first look\n\n"
+            "This is the first time this job's monitor ran; there is nothing to compare with yet."
+            f"\n\n{shown}"
+        )
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        fsio.atomic_write_bytes(path, produced)
+    except OSError as exc:
+        log.warning("monitor snapshot for %s not written: %s", job_id, exc)
+    return MonitorOutcome(
+        status, block=block, state={"hash": digest, "last_output_path": str(path)}
+    )
diff --git a/src/indus/cron/ports.py b/src/indus/cron/ports.py
new file mode 100644
index 0000000..b09c472
--- /dev/null
+++ b/src/indus/cron/ports.py
@@ -0,0 +1,299 @@
+"""What the delivery, tool and CLI side of cron needs from the job store, ledger and ticker.
+
+The job model and store (P14-03..06, 17) and the ticker and runner (P14-07..12) are separate
+modules; the surfaces in this slice (``delivery``, ``bookkeeping``, ``tool``, the CLI and ``/cron``)
+reach them only through ``CronBackend`` below, taken from ``backend_for(scope)``. The host sets
+``BACKEND_FACTORY`` once (an adapter over the store and the ticker); tests set a stand-in.
+
+Jobs are read with ``field(job, name)``, which accepts the store's model objects and plain
+mappings alike, using the field names of the job model (``id``, ``name``, ``prompt``, ``skills``,
+``schedule``, ``schedule_display``, ``repeat {times, completed}``, ``enabled``, ``state``,
+``next_run_at``, ``last_run_at``, ``last_status``, ``last_error``, ``last_delivery_error``,
+``last_delivery_unverified``, ``failure_streak``, ``deliver``, ``failure_deliver``, ``origin``,
+``script``, ``no_agent``, ``monitor_script``, ``monitor_url``, ``monitor_state``, ``workdir``,
+``context_from``, ``quota_hold_until``, ``created_at`` …).
+
+``cron_setting(scope, "wrap_response")`` reads ``cron.<key>`` from the profile's config with the
+schema default behind it.
+"""
+
+from __future__ import annotations
+
+import logging
+from collections.abc import Callable, Coroutine, Mapping, Sequence
+from dataclasses import dataclass
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any, Protocol, cast
+
+from indus.foundation.config.schema import default_for
+from indus.foundation.scope import Scope
+
+__all__ = [
+    "BACKEND_FACTORY",
+    "CronBackend",
+    "JobAmbiguous",
+    "JobNotFound",
+    "NotepadPort",
+    "RunReport",
+    "StoreHealthView",
+    "StoreUnavailable",
+    "backend_for",
+    "cron_dir",
+    "cron_setting",
+    "field",
+    "flag_setting",
+    "is_recurring",
+    "iso",
+    "number_setting",
+    "origin_of",
+    "output_dir",
+    "parse_instant",
+    "repeat_of",
+    "schedule_kind",
+    "scripts_dir",
+]
+
+log = logging.getLogger(__name__)
+
+RECURRING_KINDS = frozenset({"interval", "cron"})
+
+
+class StoreUnavailable(RuntimeError):
+    """The cron store cannot be used here (not wired in this build, or not writable)."""
+
+
+class JobNotFound(LookupError):
+    def __init__(self, ref: str) -> None:
+        super().__init__(f"no cron job matches {ref!r}")
+        self.ref = ref
+
+
+class JobAmbiguous(LookupError):
+    def __init__(self, ref: str, candidates: Sequence[str]) -> None:
+        listed = ", ".join(candidates)
+        super().__init__(f"{ref!r} names more than one job; use an id: {listed}")
+        self.ref = ref
+        self.candidates = tuple(candidates)
+
+
+@dataclass(frozen=True)
+class RunReport:
+    """The end of one run, as the surfaces show it.
+
+    ``status``: ``ok``, ``failed``, ``silent``, ``no_change``, ``blocked`` (preflight) or
+    ``skipped`` (wake gate, claim lost). ``delivery``: the delivery status, or None when nothing
+    was due to be sent.
+    """
+
+    job_id: str
+    status: str
+    delivery: str | None = None
+    output_path: Path | None = None
+    error: str | None = None
+    excerpt: str = ""
+
+
+@dataclass(frozen=True)
+class StoreHealthView:
+    writable: bool
+    reason: str | None = None
+    since: datetime | None = None
+
+
+class NotepadPort(Protocol):
+    def get(self, key: str) -> str | None: ...
+
+    def set(self, key: str, value: str) -> None: ...
+
+    def unset(self, key: str) -> bool: ...
+
+    def items(self) -> list[tuple[str, str]]: ...
+
+
+class CronBackend(Protocol):
+    """The job store, ledger and ticker as one port (see the module notes).
+
+    ``resolve`` takes an id or a case-insensitive name (exact id wins) and raises ``JobNotFound``
+    or ``JobAmbiguous``. ``create`` takes the authored fields (``schedule`` as the text the person
+    typed) and raises ``ValueError`` with a message for a bad schedule or spec. ``update`` takes
+    the changed authored fields; ``None`` clears an optional one.
+    """
+
+    def list_jobs(self, *, include_disabled: bool = True) -> list[Any]: ...
+
+    def resolve(self, ref: str) -> Any: ...
+
+    def get(self, job_id: str) -> Any | None: ...
+
+    def create(self, spec: Mapping[str, Any]) -> Any: ...
+
+    def update(self, job_id: str, changes: Mapping[str, Any]) -> Any: ...
+
+    def pause(self, job_id: str, reason: str | None = None) -> Any: ...
+
+    def resume(self, job_id: str) -> Any: ...
+
+    def remove(self, job_id: str) -> bool: ...
+
+    def is_running(self, job_id: str) -> bool: ...
+
+    def run_now(
+        self, job_id: str, *, context: str | None = None
+    ) -> Coroutine[Any, Any, RunReport]: ...
+
+    def runs(self, job_id: str | None = None, *, limit: int = 20) -> list[Mapping[str, Any]]: ...
+
+    def store_health(self) -> StoreHealthView: ...
+
+    def global_pause(self) -> tuple[bool, str | None]: ...
+
+    def set_global_pause(self, paused: bool, reason: str | None = None) -> None: ...
+
+    def notepad(self, job_id: str) -> NotepadPort: ...
+
+    def tick(self) -> int: ...
+
+    def daemon(self) -> int: ...
+
+
+BACKEND_FACTORY: Callable[[Scope], CronBackend] | None = None
+"""Set by the host (and tests); ``backend_for`` raises ``StoreUnavailable`` while it is None."""
+
+
+def backend_for(scope: Scope) -> CronBackend:
+    factory = BACKEND_FACTORY
+    if factory is None:
+        raise StoreUnavailable("the cron job store is not available in this build")
+    return factory(scope)
+
+
+# -- reading jobs ---------------------------------------------------------------------------------
+
+
+def field(job: Any, name: str, default: Any = None) -> Any:
+    """``job.name`` for model objects, ``job[name]`` for mappings; ``default`` when absent."""
+    if isinstance(job, Mapping):
+        value = cast(Mapping[str, Any], job).get(name, default)
+    else:
+        value = getattr(job, name, default)
+    return default if value is None else value
+
+
+def repeat_of(job: Any) -> tuple[int | None, int]:
+    """``(times, completed)``; ``times`` None or ≤ 0 means forever (None is returned for both)."""
+    repeat = field(job, "repeat")
+    times = field(repeat, "times") if repeat is not None else None
+    completed = field(repeat, "completed", 0) if repeat is not None else 0
+    try:
+        count = int(times) if times is not None else None
+    except (TypeError, ValueError):
+        count = None
+    try:
+        done = max(0, int(completed))
+    except (TypeError, ValueError):
+        done = 0
+    return (count if count is not None and count > 0 else None), done
+
+
+def schedule_kind(job: Any) -> str:
+    """``once``, ``interval``, ``cron`` or ``""`` when the record has no readable schedule."""
+    schedule = field(job, "schedule")
+    if schedule is None:
+        return ""
+    kind = field(schedule, "kind", "")
+    if kind:
+        return str(kind).lower()
+    name = type(schedule).__name__.lower()  # tagged-union members without a ``kind`` field
+    return next((k for k in ("once", "interval", "cron") if k in name), "")
+
+
+def is_recurring(job: Any) -> bool:
+    return schedule_kind(job) in RECURRING_KINDS
+
+
+def origin_of(job: Any) -> dict[str, str] | None:
+    """The stored origin as ``{platform, chat_id, thread_id?}``, or None."""
+    origin = field(job, "origin")
+    if origin is None:
+        return None
+    platform = str(field(origin, "platform", "") or "").strip()
+    chat = str(field(origin, "chat_id", "") or "").strip()
+    if not platform or not chat:
+        return None
+    out = {"platform": platform, "chat_id": chat}
+    thread = field(origin, "thread_id")
+    if thread is not None and str(thread).strip():
+        out["thread_id"] = str(thread).strip()
+    return out
+
+
+def parse_instant(value: object) -> datetime | None:
+    """A stored timestamp as an aware datetime (naive text is taken as UTC); None if unreadable."""
+    if isinstance(value, datetime):
+        return value if value.tzinfo is not None else value.replace(tzinfo=UTC)
+    if not isinstance(value, str) or not value.strip():
+        return None
+    try:
+        parsed = datetime.fromisoformat(value.strip().replace("Z", "+00:00"))
+    except ValueError:
+        return None
+    return parsed if parsed.tzinfo is not None else parsed.replace(tzinfo=UTC)
+
+
+def iso(value: datetime) -> str:
+    return value.astimezone(UTC).isoformat()
+
+
+# -- paths and settings ---------------------------------------------------------------------------
+
+
+def cron_dir(scope: Scope) -> Path:
+    return scope.home / "cron"
+
+
+def output_dir(scope: Scope, job_id: str) -> Path:
+    return cron_dir(scope) / "output" / job_id
+
+
+def scripts_dir(scope: Scope) -> Path:
+    return scope.home / "scripts"
+
+
+def cron_setting(scope: Scope, key: str) -> Any:
+    """``cron.<key>`` from the profile config, else the schema default (never raises)."""
+    path = f"cron.{key}"
+    value: Any = None
+    try:
+        config: Any = scope.config
+        if config is None:
+            from indus.foundation import config as config_mod
+
+            config = config_mod.load(scope)
+        value = config.get(path)
+    except Exception:
+        log.debug("config read failed for %s", path, exc_info=True)
+    return default_for(path) if value is None else value
+
+
+def number_setting(scope: Scope, key: str, fallback: float) -> float:
+    value = cron_setting(scope, key)
+    if isinstance(value, bool):
+        return fallback
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        return fallback
+
+
+def flag_setting(scope: Scope, key: str, fallback: bool) -> bool:
+    value = cron_setting(scope, key)
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        lowered = value.strip().lower()
+        if lowered in ("true", "yes", "on", "1"):
+            return True
+        if lowered in ("false", "no", "off", "0"):
+            return False
+    return fallback
diff --git a/src/indus/cron/targets.py b/src/indus/cron/targets.py
new file mode 100644
index 0000000..533b0e9
--- /dev/null
+++ b/src/indus/cron/targets.py
@@ -0,0 +1,318 @@
+"""The delivery target grammar, shared by cron (P14-13) and the gateway (P15-20).
+
+A ``deliver`` value is a comma list of tokens:
+
+- ``local`` — keep the output document only; an empty or missing value means ``local``;
+- ``origin`` — back to the chat the job was created from (``local`` when it has none);
+- ``all`` — every connected platform's home channel, worked out by the gateway at send time;
+- ``<platform>`` — that platform's home channel (``chat_id`` None);
+- ``<platform>:<chat_id>[:<thread_id>]`` — one chat, optionally one thread or topic.
+
+Reserved words and platform names are matched without case; chat and thread ids keep theirs.
+Tokens are trimmed, empty pieces are dropped, and duplicates collapse on (platform, chat, thread)
+keeping the first spelling and the order. A platform name that is not known is reported as an
+``unknown_platform`` problem and never turned into ``local``.
+
+Known platforms are the gateway adapters' names plus whatever ``register_platform`` adds (plugin
+platforms) and every platform that has a deliverer (``cron.delivery.register_deliverer``). A
+platform whose chat ids contain ``:`` registers its own address splitter; the default splits the
+part after the platform at its first ``:`` into chat and thread.
+
+Nothing here touches the network or the config: it is pure parsing, so the gateway imports it
+unchanged.
+"""
+
+from __future__ import annotations
+
+import threading
+from collections.abc import Callable, Iterable, Sequence
+from dataclasses import dataclass
+from typing import Literal
+
+__all__ = [
+    "ALL",
+    "KNOWN_PLATFORMS",
+    "LOCAL",
+    "ORIGIN",
+    "DeliveryTarget",
+    "ParsedTargets",
+    "TargetProblem",
+    "first_concrete",
+    "is_known_platform",
+    "join_tokens",
+    "parse_targets",
+    "pin_origin",
+    "register_platform",
+    "split_tokens",
+]
+
+LOCAL = "local"
+ORIGIN = "origin"
+ALL = "all"
+RESERVED = frozenset({LOCAL, ORIGIN, ALL})
+
+# The gateway adapters planned for P15/P16, by the name their deliverer registers under.
+KNOWN_PLATFORMS: frozenset[str] = frozenset(
+    {
+        "bluebubbles",
+        "buzz",
+        "dingtalk",
+        "discord",
+        "email",
+        "feishu",
+        "google_chat",
+        "homeassistant",
+        "irc",
+        "line",
+        "matrix",
+        "mattermost",
+        "ntfy",
+        "photon",
+        "qqbot",
+        "raft",
+        "signal",
+        "simplex",
+        "slack",
+        "sms",
+        "teams",
+        "telegram",
+        "wecom",
+        "weixin",
+        "whatsapp",
+        "yuanbao",
+    }
+)
+
+type Splitter = Callable[[str], tuple[str, str | None]]
+type ProblemCode = Literal["unknown_platform", "bad_address"]
+
+_lock = threading.Lock()
+_extra_platforms: dict[str, Splitter | None] = {}
+_live_platforms: Callable[[], Iterable[str]] | None = None
+
+
+@dataclass(frozen=True)
+class DeliveryTarget:
+    """One place to deliver to. ``platform`` is a platform name or ``local``/``origin``/``all``.
+
+    ``is_origin`` marks the ``origin`` token (resolved per job at send time); ``is_explicit``
+    marks a written ``platform:chat`` address (as opposed to a home channel or a broadcast).
+    ``raw`` is the token as written.
+    """
+
+    platform: str
+    chat_id: str | None = None
+    thread_id: str | None = None
+    is_origin: bool = False
+    is_explicit: bool = False
+    raw: str = ""
+
+    @property
+    def key(self) -> tuple[str, str | None, str | None]:
+        return (self.platform, self.chat_id, self.thread_id)
+
+    @property
+    def is_local(self) -> bool:
+        return self.platform == LOCAL
+
+    @property
+    def is_broadcast(self) -> bool:
+        return self.platform == ALL
+
+    @property
+    def is_concrete(self) -> bool:
+        """A written chat address on a real platform."""
+        return self.platform not in RESERVED and self.chat_id is not None
+
+    def render(self) -> str:
+        """The canonical token for this target."""
+        if self.platform in RESERVED or self.chat_id is None:
+            return self.platform
+        if self.thread_id is None:
+            return f"{self.platform}:{self.chat_id}"
+        return f"{self.platform}:{self.chat_id}:{self.thread_id}"
+
+
+@dataclass(frozen=True)
+class TargetProblem:
+    token: str
+    code: ProblemCode
+    message: str
+
+
+@dataclass(frozen=True)
+class ParsedTargets:
+    targets: tuple[DeliveryTarget, ...]
+    problems: tuple[TargetProblem, ...] = ()
+
+    @property
+    def ok(self) -> bool:
+        return not self.problems
+
+    def render(self) -> str:
+        return join_tokens(t.render() for t in self.targets)
+
+
+# -- platform names -------------------------------------------------------------------------------
+
+
+def register_platform(name: str, *, splitter: Splitter | None = None) -> Callable[[], None]:
+    """Make ``name`` a known platform (plugins); ``splitter`` parses its ``chat[:thread]`` part.
+
+    Returns the undo.
+    """
+    key = name.strip().lower()
+    if not key or key in RESERVED or ":" in key or "," in key:
+        raise ValueError(f"not a usable platform name: {name!r}")
+    with _lock:
+        _extra_platforms[key] = splitter
+
+    def undo() -> None:
+        with _lock:
+            if _extra_platforms.get(key) is splitter:
+                _extra_platforms.pop(key, None)
+
+    return undo
+
+
+def set_live_platforms(source: Callable[[], Iterable[str]] | None) -> None:
+    """Platforms that count as known because something can deliver to them right now (the
+    delivery module points this at its deliverer registry)."""
+    global _live_platforms
+    _live_platforms = source
+
+
+def is_known_platform(name: str) -> bool:
+    key = name.strip().lower()
+    if key in KNOWN_PLATFORMS:
+        return True
+    with _lock:
+        if key in _extra_platforms:
+            return True
+    live = _live_platforms
+    if live is not None:
+        try:
+            return key in {str(p).lower() for p in live()}
+        except Exception:
+            return False
+    return False
+
+
+def _splitter_for(platform: str) -> Splitter:
+    with _lock:
+        custom = _extra_platforms.get(platform)
+    return custom if custom is not None else _default_split
+
+
+def _default_split(address: str) -> tuple[str, str | None]:
+    chat, sep, thread = address.partition(":")
+    return chat, (thread if sep else None)
+
+
+# -- parsing --------------------------------------------------------------------------------------
+
+
+def split_tokens(value: str | Sequence[str] | None) -> list[str]:
+    """The raw tokens of a ``deliver`` value: comma split, trimmed, empty pieces dropped.
+
+    A list (hand-edited job file, MCP client) is flattened, each item split on commas too.
+    """
+    if value is None:
+        return []
+    items = [value] if isinstance(value, str) else [str(v) for v in value]
+    out: list[str] = []
+    for item in items:
+        out.extend(piece.strip() for piece in item.split(",") if piece.strip())
+    return out
+
+
+def join_tokens(tokens: Iterable[str]) -> str:
+    return ",".join(tokens)
+
+
+def _parse_one(token: str) -> DeliveryTarget | TargetProblem:
+    lowered = token.lower()
+    if lowered in RESERVED:
+        return DeliveryTarget(lowered, is_origin=lowered == ORIGIN, raw=token)
+    platform, sep, address = token.partition(":")
+    platform = platform.strip().lower()
+    if not platform:
+        return TargetProblem(token, "bad_address", f"{token!r} has no platform before ':'")
+    if platform in RESERVED:
+        return TargetProblem(token, "bad_address", f"{platform!r} takes no address")
+    if not is_known_platform(platform):
+        return TargetProblem(
+            token, "unknown_platform", f"{platform!r} is not a platform Indus can deliver to"
+        )
+    if not sep:
+        return DeliveryTarget(platform, raw=token)
+    try:
+        chat, thread = _splitter_for(platform)(address.strip())
+    except Exception as exc:
+        return TargetProblem(token, "bad_address", f"{token!r}: {exc}")
+    chat = chat.strip()
+    thread = thread.strip() if thread is not None else None
+    if not chat:
+        return TargetProblem(token, "bad_address", f"{token!r} has no chat id after ':'")
+    return DeliveryTarget(platform, chat, thread or None, is_explicit=True, raw=token)
+
+
+def parse_targets(value: str | Sequence[str] | None) -> ParsedTargets:
+    """Parse a ``deliver`` value (see the module notes). Empty → ``local``."""
+    tokens = split_tokens(value)
+    if not tokens:
+        return ParsedTargets((DeliveryTarget(LOCAL, raw=LOCAL),))
+    seen: set[tuple[str, str | None, str | None]] = set()
+    targets: list[DeliveryTarget] = []
+    problems: list[TargetProblem] = []
+    for token in tokens:
+        parsed = _parse_one(token)
+        if isinstance(parsed, TargetProblem):
+            problems.append(parsed)
+            continue
+        if parsed.key in seen:
+            continue
+        seen.add(parsed.key)
+        targets.append(parsed)
+    return ParsedTargets(tuple(targets), tuple(problems))
+
+
+def origin_target(origin: dict[str, str] | None) -> DeliveryTarget | None:
+    """A stored origin (``{platform, chat_id, thread_id?}``) as a concrete target."""
+    if not origin:
+        return None
+    platform = origin.get("platform", "").strip().lower()
+    chat = origin.get("chat_id", "").strip()
+    if not platform or not chat or platform in RESERVED:
+        return None
+    thread = origin.get("thread_id")
+    return DeliveryTarget(
+        platform, chat, thread or None, is_origin=True, raw=f"{ORIGIN}->{platform}"
+    )
+
+
+def first_concrete(
+    value: str | Sequence[str] | None, origin: dict[str, str] | None = None
+) -> DeliveryTarget | None:
+    """The first ``platform:chat`` a job delivers to, its ``origin`` resolved; None if none."""
+    for target in parse_targets(value).targets:
+        if target.is_origin:
+            resolved = origin_target(origin)
+            if resolved is not None:
+                return DeliveryTarget(resolved.platform, resolved.chat_id, resolved.thread_id)
+            continue
+        if target.is_concrete:
+            return target
+    return None
+
+
+def pin_origin(value: str | Sequence[str] | None, parent: DeliveryTarget | None) -> str:
+    """``value`` with ``origin`` replaced by ``parent``'s address (or ``local``).
+
+    For jobs created from inside a cron run: the creating session is gone by the time the new
+    job fires, so ``origin`` must not dangle. A missing value counts as ``origin`` there.
+    """
+    tokens = split_tokens(value) or [ORIGIN]
+    replacement = parent.render() if parent is not None and parent.is_concrete else LOCAL
+    pinned = [replacement if t.lower() == ORIGIN else t for t in tokens]
+    return join_tokens(dict.fromkeys(pinned))
diff --git a/src/indus/cron/tool.py b/src/indus/cron/tool.py
new file mode 100644
index 0000000..d698629
--- /dev/null
+++ b/src/indus/cron/tool.py
@@ -0,0 +1,783 @@
+"""``cronjob_manage``: the agent's one tool for scheduled jobs (H15, P14-18).
+
+``action`` is one of ``create``, ``list``, ``update``, ``pause``, ``resume``, ``remove``, ``run``.
+Jobs are stored and run through ``ports.CronBackend``; this module checks what the model asks for:
+
+- inference pins (``model``, ``provider``, ``base_url``, ``reasoning_effort``) belong to the user
+  and are refused here (``indus cron edit`` sets them); ``pinned=true`` copies the current main
+  model and provider onto the job and is only for when the user asked, ``pinned=false`` lets the
+  job follow the main model again;
+- prompts (create, update and the per-run context of ``run``) go through the P05 threat scan
+  (injection, exfiltration, hidden characters) and a job that would stop or restart the Indus
+  gateway is refused, since the gateway runs the job (restart-loop guard);
+- ``script`` is a file name under ``<home>/scripts/`` that exists; ``monitor`` is one field (an
+  http(s) URL or a script name), never with ``no_agent``;
+- ``deliver``/``failure_deliver`` must parse; from inside a cron run ``origin`` is pinned to the
+  parent job's concrete target, or ``local`` (no dangling origins);
+- ``run`` returns a handle at once when the session can take a detached result (a result sink is
+  registered for it); the outcome then arrives as an internal message. Otherwise it runs inline.
+  A job already running is refused.
+
+Availability: interactive sessions (CLI, TUI, gateway chats; ``run_context`` ``interactive`` or
+unset); cron runs only with ``cron.allow_agent_scheduling`` (R07.15); one-shot and other
+unattended runs never. ``base_url_problem`` is the R01.11 rule for the user-facing CLI.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import dataclasses
+import json
+import logging
+import re
+import secrets
+import threading
+from collections.abc import Callable, Mapping
+from pathlib import Path
+from typing import Any
+
+from indus.cron import monitor, ports, targets
+from indus.cron.ports import JobAmbiguous, JobNotFound, RunReport, StoreUnavailable
+from indus.foundation.scope import Scope, scope_or_none
+from indus.safety import threat_scan
+from indus.tools.registry import ToolRegistry, ToolTraits
+
+__all__ = [
+    "ACTIONS",
+    "SCHEMA",
+    "TOOL_NAME",
+    "TOOLSET",
+    "USER_ONLY_FIELDS",
+    "base_url_problem",
+    "cronjob_manage",
+    "lifecycle_problem",
+    "prompt_problem",
+    "register_result_sink",
+    "register_tools",
+    "script_problem",
+]
+
+log = logging.getLogger(__name__)
+
+TOOL_NAME = "cronjob_manage"
+TOOLSET = "cronjob"
+ACTIONS = ("create", "list", "update", "pause", "resume", "remove", "run")
+USER_ONLY_FIELDS = ("model", "provider", "base_url", "reasoning_effort")
+SELF_REF = "self"
+_SCAN_SCOPE: threat_scan.Scope = "strict"
+_SCRIPT_READ_LIMIT = 256 * 1024
+_CRON_SESSION = re.compile(r"^cron_(?P<job>[0-9a-f]{12})_\d{8}_\d{6}$")
+
+_LIFECYCLE = re.compile(
+    r"\bindus\b[^\n]{0,60}?\bgateway\s+(?:restart|stop|kill)\b"
+    r"|\bsystemctl\b[^\n]{0,120}\b(?:restart|stop|kill|try-restart|reload-or-restart)\b"
+    r"[^\n]{0,120}\bindus[-_.]?gateway"
+    r"|\blaunchctl\b[^\n]{0,120}\b(?:kickstart|stop|unload|bootout|kill|remove)\b"
+    r"[^\n]{0,120}\bai\.indus\.gateway"
+    r"|\b(?:pkill|killall)\b[^\n]{0,60}\bindus[- _]?gateway",
+    re.IGNORECASE,
+)
+
+_DESCRIPTION = (
+    "Schedule and look after jobs that run on their own later or on a repeat. "
+    "action='create' needs `schedule` and a `prompt` (or `skills`, or a `script` with "
+    "no_agent=true); 'list' shows the jobs; 'update', 'pause', 'resume', 'remove' and 'run' take "
+    "`job_id` (an id or a job name — list first, never guess). 'run' starts the job now and "
+    "returns at once; its result comes back to this conversation by itself, so do not wait or "
+    "check. Each run is a fresh session that knows nothing of this chat: write prompts that stand "
+    "on their own. The job's final answer is what gets delivered. Jobs use the user's main model "
+    "unless the user pinned one. Change an existing job rather than creating a near copy."
+)
+
+
+def _str(description: str) -> dict[str, Any]:
+    return {"type": "string", "description": description}
+
+
+def _list(description: str) -> dict[str, Any]:
+    return {"type": "array", "items": {"type": "string"}, "description": description}
+
+
+def _bool(description: str) -> dict[str, Any]:
+    return {"type": "boolean", "description": description}
+
+
+def _script_text(where: str) -> str:
+    return (
+        f"File name of a script in {where} (create it there first). With no_agent=true its "
+        "output is the whole job; otherwise it runs before the agent and its output becomes "
+        "context. '' clears it on update."
+    )
+
+
+SCHEMA: dict[str, Any] = {
+    "name": TOOL_NAME,
+    "description": _DESCRIPTION,
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "action": {"type": "string", "enum": list(ACTIONS), "description": "What to do."},
+            "job_id": _str("The job's id or name (update, pause, resume, remove, run)."),
+            "schedule": _str(
+                "When it runs. Repeating: '30m' or 'every 2h' (every 30 minutes / 2 hours), "
+                "'weekdays at 9am', 'every monday 7:30', 'every day at noon', or five cron fields "
+                "'0 9 * * 1-5'. Once: 'in 45m' (do not work out a timestamp yourself) or an ISO "
+                "time '2026-11-01T09:00'."
+            ),
+            "prompt": _str(
+                "create/update: the complete instruction the job runs with. run: extra context "
+                "for this one run only (not saved)."
+            ),
+            "name": _str("A short name for the job."),
+            "repeat": {
+                "type": "integer",
+                "description": "How many runs before the job ends. Leave out: once for one-time "
+                "schedules, forever for repeating ones.",
+            },
+            "deliver": _str(
+                "Where the result goes: 'local' (saved only), 'origin' (this chat), 'all', a "
+                "platform name (its home channel) or 'platform:chat_id[:thread_id]'; comma "
+                "separated for several. Leave out for this chat."
+            ),
+            "failure_deliver": _str(
+                "Where failure notices go instead of `deliver` ('local' keeps them quiet). "
+                "'' clears it on update."
+            ),
+            "skills": _list("Skills loaded before the prompt, in order. [] clears on update."),
+            "script": _str(_script_text("the profile's scripts folder")),
+            "monitor": _str(
+                "Optional change detector run before the agent: an http(s) URL or a script file "
+                "name. Same output as last time skips the run; changed output wakes the agent "
+                "with the difference. Output must not contain timestamps. '' clears it."
+            ),
+            "no_agent": _bool(
+                "true = no model at all: the script's output is delivered as is (empty output "
+                "sends nothing; a failing script sends an alert). Needs `script`."
+            ),
+            "context_from": _list(
+                "Ids of other jobs whose latest result is added as context each run. [] clears."
+            ),
+            "continuity": _bool(
+                "true = each run also sees this job's own previous result (to continue or "
+                "avoid repeats)."
+            ),
+            "enabled_toolsets": _list(
+                "Toolsets the job's agent may use (for example ['web', 'terminal']). [] means "
+                "no tools at all."
+            ),
+            "workdir": _str(
+                "Absolute path of an existing folder to work in; its project files are loaded. "
+                "'' clears it."
+            ),
+            "paused": _bool("create only: store the job paused (resume or run it later)."),
+            "paused_reason": _str("create only, with paused=true: why it is paused."),
+            "pinned": _bool(
+                "Only when the user asks: true keeps the job on today's main model, false lets "
+                "it follow the main model again."
+            ),
+        },
+        "required": ["action"],
+    },
+}
+
+
+def _schema_overrides(scope: Scope | None) -> Mapping[str, Any] | None:
+    if scope is None:
+        return None
+    params = json.loads(json.dumps(SCHEMA["parameters"]))
+    params["properties"]["script"]["description"] = _script_text(str(ports.scripts_dir(scope)))
+    return {"parameters": params}
+
+
+def register_tools(registry: ToolRegistry) -> None:
+    registry.register(
+        TOOL_NAME,
+        TOOLSET,
+        SCHEMA,
+        cronjob_manage,
+        is_async=True,
+        schema_overrides=_schema_overrides,
+        traits=ToolTraits(mutating=True),
+    )
+
+
+# -- detached results ---------------------------------------------------------------------------
+
+_lock = threading.Lock()
+_sinks: dict[str, Callable[[str], object]] = {}
+_running: set[tuple[str, str]] = set()
+_tasks: set[asyncio.Task[None]] = set()
+
+
+def register_result_sink(session_id: str, fn: Callable[[str], object]) -> Callable[[], None]:
+    """Where ``run`` results for ``session_id`` go (the host queues them as an internal message
+    between turns); returns the undo."""
+    with _lock:
+        _sinks[session_id] = fn
+
+    def undo() -> None:
+        with _lock:
+            if _sinks.get(session_id) is fn:
+                del _sinks[session_id]
+
+    return undo
+
+
+def _sink_for(session_id: str | None) -> Callable[[str], object] | None:
+    if not session_id:
+        return None
+    with _lock:
+        return _sinks.get(session_id)
+
+
+# -- checks ---------------------------------------------------------------------------------------
+
+
+def prompt_problem(text: str | None) -> str | None:
+    """Why this prompt text is refused (threat scan, restart-loop guard), or None."""
+    if not text:
+        return None
+    hits = threat_scan.scan(text, scope=_SCAN_SCOPE)
+    if hits:
+        return (
+            "the prompt was refused by the safety scan (" + ", ".join(hits) + "): scheduled "
+            "prompts may not carry instruction overrides, secret exfiltration or hidden characters"
+        )
+    return lifecycle_problem(text)
+
+
+def lifecycle_problem(text: str | None) -> str | None:
+    if text and _LIFECYCLE.search(text):
+        return (
+            "a scheduled job may not stop or restart the Indus gateway: the gateway runs the job, "
+            "so it would cut itself off (and restart again on every run). Do that from a shell."
+        )
+    return None
+
+
+def script_problem(scope: Scope, name: str | None) -> str | None:
+    """Why ``name`` cannot be a job script, or None (an empty name clears the script)."""
+    raw = (name or "").strip()
+    if not raw:
+        return None
+    folder = ports.scripts_dir(scope)
+    if raw.startswith(("/", "~", "\\")) or (len(raw) > 1 and raw[1] == ":"):
+        return f"give the script as a file name inside {folder}/, not a path ({raw!r})"
+    if any(ch.isspace() for ch in raw) or any(ch in raw for ch in ";|&$`<>()"):
+        return (
+            f"{raw!r} looks like a command line; put the commands in a script file in {folder}/ "
+            "and give its name"
+        )
+    try:
+        root = folder.resolve()
+        resolved = (folder / raw).resolve()
+    except OSError as exc:
+        return f"the script path cannot be resolved: {exc}"
+    if not resolved.is_relative_to(root):
+        return f"{raw!r} leaves the scripts folder {folder}/"
+    if not resolved.is_file():
+        return f"no script {raw!r} in {folder}/; write it there first"
+    try:
+        with resolved.open("rb") as handle:
+            body = handle.read(_SCRIPT_READ_LIMIT).decode("utf-8", "replace")
+    except OSError:
+        return None
+    return lifecycle_problem(body)
+
+
+def workdir_problem(value: str | None) -> str | None:
+    text = (value or "").strip()
+    if not text:
+        return None
+    path = Path(text)
+    if not path.is_absolute():
+        return f"the workdir must be an absolute path (got {text!r})"
+    if not path.is_dir():
+        return f"the workdir {text!r} is not an existing folder"
+    return None
+
+
+def deliver_problem(value: str | None) -> str | None:
+    if value is None:
+        return None
+    parsed = targets.parse_targets(value)
+    if parsed.ok:
+        return None
+    return "; ".join(p.message for p in parsed.problems)
+
+
+def base_url_problem(scope: Scope, provider: str | None, base_url: str | None) -> str | None:
+    """R01.11: a per-job ``base_url`` needs an explicit provider whose configured endpoint has the
+    same scheme, host and port, so a stored key is never sent to another server."""
+    url = (base_url or "").strip().rstrip("/")
+    if not url:
+        return None
+    name = (provider or "").strip()
+    if not name:
+        return "a custom base_url needs an explicit provider (--provider)"
+    from indus.providers.hosts import try_parse
+    from indus.providers.registry import Registry
+
+    wanted = try_parse(url)
+    if wanted is None:
+        return f"{url!r} is not a usable base URL"
+    try:
+        profile = Registry(scope).lookup(name)
+    except Exception:
+        profile = None
+    if profile is None:
+        return f"unknown provider {name!r}; a base_url can only narrow a configured provider"
+    configured = try_parse(profile.base_url) if profile.base_url else None
+    if configured is None or configured.origin != wanted.origin:
+        where = profile.base_url or "none configured"
+        return (
+            f"{url!r} is not where provider {name!r} is configured to send its key ({where}); "
+            "the base URL must keep the same scheme, host and port"
+        )
+    return None
+
+
+def _main_route(scope: Scope) -> tuple[str, str]:
+    from indus.providers import route as route_mod
+
+    resolved = route_mod.resolve(scope)
+    return resolved.model, resolved.provider
+
+
+MAIN_ROUTE: Callable[[Scope], tuple[str, str]] = _main_route
+"""The current main model and provider (tests replace it)."""
+
+
+def availability_problem(scope: Scope, run_context: object) -> str | None:
+    context = run_context if isinstance(run_context, str) else None
+    if context in (None, "", "interactive"):
+        return None
+    if context == "cron":
+        if ports.flag_setting(scope, "allow_agent_scheduling", False):
+            return None
+        return (
+            "scheduled runs may not create or change cron jobs (cron.allow_agent_scheduling is "
+            "off); report what should be scheduled in the answer instead"
+        )
+    return "cron jobs can only be managed from an interactive session"
+
+
+# -- views ----------------------------------------------------------------------------------------
+
+
+def job_view(job: Any) -> dict[str, Any]:
+    times, done = ports.repeat_of(job)
+    view: dict[str, Any] = {
+        "id": ports.field(job, "id"),
+        "name": ports.field(job, "name"),
+        "schedule": ports.field(job, "schedule_display") or ports.schedule_kind(job),
+        "state": ports.field(job, "state"),
+        "enabled": bool(ports.field(job, "enabled", True)),
+        "next_run_at": ports.field(job, "next_run_at"),
+        "deliver": ports.field(job, "deliver", "local"),
+        "repeat": f"{done}/{times}" if times else f"{done}/forever",
+    }
+    prompt = str(ports.field(job, "prompt", "") or "")
+    if prompt:
+        view["prompt"] = prompt if len(prompt) <= 200 else prompt[:197] + "..."
+    for key in (
+        "skills",
+        "script",
+        "monitor_script",
+        "monitor_url",
+        "workdir",
+        "context_from",
+        "enabled_toolsets",
+        "failure_deliver",
+        "last_run_at",
+        "last_status",
+        "last_error",
+        "last_delivery_error",
+        "paused_reason",
+        "model",
+        "provider",
+    ):
+        value = ports.field(job, key)
+        if value not in (None, "", []):
+            view[key] = value
+    if ports.field(job, "no_agent"):
+        view["no_agent"] = True
+    streak = int(ports.field(job, "failure_streak", 0) or 0)
+    if streak:
+        view["failure_streak"] = streak
+    return view
+
+
+def _ok(**payload: Any) -> str:
+    return json.dumps({"success": True, **payload}, indent=2, default=str)
+
+
+def _fail(message: str, **extra: Any) -> str:
+    return json.dumps({"success": False, "error": message, **extra}, indent=2, default=str)
+
+
+# -- argument helpers -----------------------------------------------------------------------------
+
+
+def _clean_list(value: object) -> list[str] | None:
+    if value is None:
+        return None
+    if isinstance(value, str):
+        return [part.strip() for part in value.split(",") if part.strip()]
+    if isinstance(value, list | tuple):
+        return [str(v).strip() for v in value if str(v).strip()]  # pyright: ignore[reportUnknownVariableType, reportUnknownArgumentType]
+    return None
+
+
+def _with_continuity(refs: list[str] | None, continuity: object) -> list[str] | None:
+    if not isinstance(continuity, bool):
+        return refs
+    out = [r for r in (refs or []) if r.lower() != SELF_REF]
+    if continuity:
+        out.append(SELF_REF)
+    return out
+
+
+def _context_problem(backend: ports.CronBackend, refs: list[str] | None) -> str | None:
+    for ref in refs or []:
+        if ref.lower() == SELF_REF:
+            continue
+        try:
+            backend.resolve(ref)
+        except JobAmbiguous as exc:
+            return str(exc)
+        except JobNotFound:
+            return f"context_from names {ref!r}, which is not a job; list the jobs first"
+    return None
+
+
+def _parent_target(
+    backend: ports.CronBackend, session_id: str | None
+) -> targets.DeliveryTarget | None:
+    match = _CRON_SESSION.match(session_id or "")
+    if match is None:
+        return None
+    parent = backend.get(match.group("job"))
+    if parent is None:
+        return None
+    return targets.first_concrete(ports.field(parent, "deliver"), ports.origin_of(parent))
+
+
+def _deliver_value(
+    raw: object,
+    *,
+    backend: ports.CronBackend,
+    run_context: object,
+    session_id: str | None,
+    origin: Mapping[str, Any] | None,
+) -> str | None:
+    """The ``deliver`` text to store; None means "leave it" on update."""
+    value = None if raw is None else str(raw)
+    if run_context == "cron":
+        return targets.pin_origin(value, _parent_target(backend, session_id))
+    if value is None:
+        return targets.ORIGIN if origin else None
+    return targets.join_tokens(targets.split_tokens(value)) or targets.LOCAL
+
+
+# -- actions --------------------------------------------------------------------------------------
+
+
+class _Refused(Exception):
+    pass
+
+
+def _check(problem: str | None) -> None:
+    if problem:
+        raise _Refused(problem)
+
+
+def _common_fields(
+    scope: Scope,
+    backend: ports.CronBackend,
+    args: Mapping[str, Any],
+    job: Any | None,
+) -> dict[str, Any]:
+    """Validated authored fields present in ``args`` (create and update share these)."""
+    out: dict[str, Any] = {}
+    if args.get("prompt") is not None:
+        _check(prompt_problem(str(args["prompt"])))
+        out["prompt"] = str(args["prompt"])
+    for key in ("schedule", "name"):
+        if args.get(key) is not None:
+            out[key] = str(args[key]).strip()
+    if args.get("repeat") is not None:
+        try:
+            out["repeat"] = int(args["repeat"])
+        except (TypeError, ValueError):
+            raise _Refused("repeat must be a whole number") from None
+    skills = _clean_list(args.get("skills"))
+    if skills is not None:
+        out["skills"] = skills
+    if args.get("script") is not None:
+        script = str(args["script"]).strip()
+        _check(script_problem(scope, script))
+        out["script"] = script or None
+    if args.get("no_agent") is not None:
+        out["no_agent"] = bool(args["no_agent"])
+    if args.get("monitor") is not None:
+        mon_script, mon_url = monitor.split_monitor(str(args["monitor"]))
+        if mon_script:
+            _check(script_problem(scope, mon_script))
+        out["monitor_script"], out["monitor_url"] = mon_script, mon_url
+    no_agent = out.get("no_agent", bool(ports.field(job, "no_agent")) if job is not None else False)
+    if "monitor_script" in out or "no_agent" in out:
+        mon_script = out.get("monitor_script", ports.field(job, "monitor_script") if job else None)
+        mon_url = out.get("monitor_url", ports.field(job, "monitor_url") if job else None)
+        _check(monitor.validate_monitor(mon_script, mon_url, no_agent=no_agent))
+    script_now = out.get("script", ports.field(job, "script") if job is not None else None)
+    if no_agent and not script_now:
+        raise _Refused(
+            "no_agent=true needs a script: the script's output is the whole job (no model runs)"
+        )
+    refs = _clean_list(args.get("context_from"))
+    if refs is not None or isinstance(args.get("continuity"), bool):
+        current = refs if refs is not None else _clean_list(ports.field(job, "context_from"))
+        merged = _with_continuity(current, args.get("continuity"))
+        _check(_context_problem(backend, merged))
+        out["context_from"] = merged or None
+    toolsets = args.get("enabled_toolsets")
+    if toolsets is not None:
+        out["enabled_toolsets"] = _clean_list(toolsets) or []
+    if args.get("workdir") is not None:
+        workdir = str(args["workdir"]).strip()
+        _check(workdir_problem(workdir))
+        out["workdir"] = workdir or None
+    if args.get("failure_deliver") is not None:
+        lane = str(args["failure_deliver"]).strip()
+        _check(deliver_problem(lane) if lane else None)
+        out["failure_deliver"] = targets.join_tokens(targets.split_tokens(lane)) or None
+    pinned = args.get("pinned")
+    if isinstance(pinned, bool):
+        out["pinned"] = pinned
+        if pinned:
+            model, provider = MAIN_ROUTE(scope)
+            out["model"], out["provider"] = model, provider
+        else:
+            out["model"], out["provider"] = None, None
+    return out
+
+
+def _create(
+    scope: Scope,
+    backend: ports.CronBackend,
+    args: Mapping[str, Any],
+    *,
+    run_context: object,
+    session_id: str | None,
+    origin: Mapping[str, Any] | None,
+) -> str:
+    if not str(args.get("schedule") or "").strip():
+        raise _Refused("create needs a schedule")
+    if args.get("paused_reason") and not args.get("paused"):
+        raise _Refused("paused_reason goes with paused=true")
+    spec = _common_fields(scope, backend, args, None)
+    if not spec.get("no_agent") and not (spec.get("prompt") or spec.get("skills")):
+        raise _Refused("create needs a prompt or at least one skill (or a script with no_agent)")
+    deliver = _deliver_value(
+        args.get("deliver"),
+        backend=backend,
+        run_context=run_context,
+        session_id=session_id,
+        origin=origin,
+    )
+    _check(deliver_problem(deliver))
+    spec["deliver"] = deliver or targets.LOCAL
+    if origin and run_context != "cron":
+        spec["origin"] = dict(origin)
+    if args.get("paused"):
+        spec["paused"] = True
+        if args.get("paused_reason"):
+            spec["paused_reason"] = str(args["paused_reason"])
+    try:
+        job = backend.create(spec)
+    except ValueError as exc:
+        raise _Refused(str(exc)) from None
+    note = "Created paused: resume it to schedule it, or run it now." if args.get("paused") else ""
+    return _ok(
+        job=job_view(job), message=f"Scheduled job {ports.field(job, 'id')} created. {note}".strip()
+    )
+
+
+def _update(
+    scope: Scope,
+    backend: ports.CronBackend,
+    job: Any,
+    args: Mapping[str, Any],
+    *,
+    run_context: object,
+    session_id: str | None,
+) -> str:
+    if args.get("paused") is not None or args.get("paused_reason") is not None:
+        raise _Refused("use action='pause' or 'resume' to pause or resume a job")
+    changes = _common_fields(scope, backend, args, job)
+    if args.get("deliver") is not None:
+        deliver = _deliver_value(
+            args.get("deliver"),
+            backend=backend,
+            run_context=run_context,
+            session_id=session_id,
+            origin=None,
+        )
+        _check(deliver_problem(deliver))
+        changes["deliver"] = deliver or targets.LOCAL
+    if not changes:
+        raise _Refused("nothing to change: pass the fields to update")
+    try:
+        updated = backend.update(str(ports.field(job, "id")), changes)
+    except ValueError as exc:
+        raise _Refused(str(exc)) from None
+    return _ok(job=job_view(updated))
+
+
+def _result_text(job: Any, report: RunReport) -> str:
+    name = ports.field(job, "name") or ports.field(job, "id")
+    lines = [f"[Scheduled job run finished] {name} ({report.job_id}): {report.status}"]
+    if report.delivery:
+        lines.append(f"delivery: {report.delivery}")
+    if report.error:
+        lines.append(f"error: {report.error}")
+    if report.output_path is not None:
+        lines.append(f"output: {report.output_path}")
+    if report.excerpt:
+        lines.append("")
+        lines.append(report.excerpt)
+    return "\n".join(lines)
+
+
+async def _run_tracked(
+    backend: ports.CronBackend, key: tuple[str, str], job_id: str, context: str | None
+) -> RunReport:
+    try:
+        return await backend.run_now(job_id, context=context)
+    finally:
+        with _lock:
+            _running.discard(key)
+
+
+async def _run(
+    scope: Scope,
+    backend: ports.CronBackend,
+    job: Any,
+    args: Mapping[str, Any],
+    session_id: str | None,
+) -> str:
+    job_id = str(ports.field(job, "id"))
+    context = str(args["prompt"]) if args.get("prompt") else None
+    _check(prompt_problem(context))
+    key = (str(scope.home), job_id)
+    with _lock:
+        busy = key in _running
+    if busy or backend.is_running(job_id):
+        raise _Refused(f"job {job_id} is already running; its result will arrive when it ends")
+    with _lock:
+        _running.add(key)
+    sink = _sink_for(session_id)
+    if sink is None:
+        report = await _run_tracked(backend, key, job_id, context)
+        run = {**dataclasses.asdict(report), "mode": "inline"}
+        return _ok(job=job_view(backend.get(job_id) or job), run=run)
+    handle = f"run-{job_id}-{secrets.token_hex(3)}"
+
+    async def background() -> None:
+        try:
+            report = await _run_tracked(backend, key, job_id, context)
+            text = _result_text(job, report)
+        except Exception as exc:
+            text = f"[Scheduled job run failed] {job_id}: {type(exc).__name__}: {exc}"
+        try:
+            sink(text)
+        except Exception:
+            log.warning("could not hand the cron run result to the session", exc_info=True)
+
+    task = asyncio.get_running_loop().create_task(background(), name=f"cron run {job_id}")
+    _tasks.add(task)
+    task.add_done_callback(_tasks.discard)
+    return _ok(
+        handle=handle,
+        job_id=job_id,
+        note="The job is running in the background. Its result will arrive in this conversation "
+        "as a new message when it ends; carry on and do not wait or check on it.",
+    )
+
+
+async def cronjob_manage(
+    args: Mapping[str, Any],
+    *,
+    scope: Scope | None = None,
+    session_id: str | None = None,
+    run_context: object = None,
+    delivery_origin: Mapping[str, Any] | None = None,
+) -> str:
+    """The tool handler (see the module notes)."""
+    current = scope if scope is not None else scope_or_none()
+    if current is None:
+        return _fail("no profile is active, so there is no cron store to use")
+    action = str(args.get("action") or "").strip().lower()
+    if action not in ACTIONS:
+        return _fail(f"action must be one of: {', '.join(ACTIONS)}")
+    problem = availability_problem(current, run_context)
+    if problem:
+        return _fail(problem)
+    pinned_by_model = [k for k in USER_ONLY_FIELDS if args.get(k) not in (None, "")]
+    if pinned_by_model:
+        return _fail(
+            f"{', '.join(pinned_by_model)} cannot be set from a chat: the user chooses a job's "
+            "model, provider and endpoint (`indus cron edit <job> --model … --provider …`). "
+            "Use pinned=true only if the user asked to keep the job on the current model."
+        )
+    try:
+        backend = ports.backend_for(current)
+        if action == "list":
+            include = args.get("include_disabled")
+            jobs = backend.list_jobs(include_disabled=include is not False)
+            return _ok(count=len(jobs), jobs=[job_view(j) for j in jobs])
+        if action == "create":
+            return _create(
+                current,
+                backend,
+                args,
+                run_context=run_context,
+                session_id=session_id,
+                origin=delivery_origin,
+            )
+        ref = str(args.get("job_id") or "").strip()
+        if not ref:
+            return _fail(f"{action} needs job_id (an id or a name; list the jobs first)")
+        job = backend.resolve(ref)
+        job_id = str(ports.field(job, "id"))
+        if action == "update":
+            return _update(
+                current, backend, job, args, run_context=run_context, session_id=session_id
+            )
+        if action == "pause":
+            reason = args.get("paused_reason")
+            return _ok(job=job_view(backend.pause(job_id, str(reason) if reason else None)))
+        if action == "resume":
+            return _ok(job=job_view(backend.resume(job_id)))
+        if action == "remove":
+            if not backend.remove(job_id):
+                return _fail(f"job {job_id} could not be removed")
+            _forget_incidents(current, job_id)
+            return _ok(removed={"id": job_id, "name": ports.field(job, "name")})
+        return await _run(current, backend, job, args, session_id)
+    except _Refused as exc:
+        return _fail(str(exc))
+    except JobAmbiguous as exc:
+        return _fail(str(exc), candidates=list(exc.candidates))
+    except (JobNotFound, StoreUnavailable) as exc:
+        return _fail(str(exc))
+
+
+def _forget_incidents(scope: Scope, job_id: str) -> None:
+    try:
+        from indus.cron.incidents import IncidentLedger
+
+        IncidentLedger.for_scope(scope).forget_job(job_id)
+    except Exception:
+        log.debug("could not drop the incidents of %s", job_id, exc_info=True)
