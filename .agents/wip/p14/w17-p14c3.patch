+# STAND-IN: removed at integration
+"""Test-only stand-ins for the job model, store and ticker (C1/C2) used by the C3 tests.
+
+``StubJob`` carries the job fields of the P14-03 row; ``StubBackend`` is an in-memory
+``ports.CronBackend``. At integration the C3 tests switch to the real store through the host's
+backend adapter and this file is deleted.
+"""
+
+from __future__ import annotations
+
+import secrets
+from collections.abc import Awaitable, Callable, Mapping
+from dataclasses import dataclass, field, replace
+from datetime import datetime, timedelta
+from typing import Any
+
+from indus.cron import ports
+from indus.cron.ports import JobAmbiguous, JobNotFound, RunReport, StoreHealthView
+
+
+@dataclass(frozen=True)
+class Once:
+    run_at: datetime
+    kind: str = "once"
+
+
+@dataclass(frozen=True)
+class Interval:
+    minutes: int
+    kind: str = "interval"
+
+
+@dataclass(frozen=True)
+class Cron:
+    expr: str
+    kind: str = "cron"
+
+
+@dataclass
+class Repeat:
+    times: int | None = None
+    completed: int = 0
+
+
+@dataclass
+class StubJob:
+    id: str
+    schedule: Any
+    schedule_display: str = ""
+    name: str | None = None
+    prompt: str | None = None
+    skills: list[str] = field(default_factory=list[str])
+    repeat: Repeat = field(default_factory=Repeat)
+    enabled: bool = True
+    state: str = "scheduled"
+    paused_at: str | None = None
+    paused_reason: str | None = None
+    next_run_at: str | None = None
+    last_run_at: str | None = None
+    last_status: str | None = None
+    last_error: str | None = None
+    last_delivery_error: str | None = None
+    last_delivery_unverified: list[str] | None = None
+    failure_streak: int = 0
+    deliver: str = "local"
+    failure_deliver: str | None = None
+    origin: dict[str, str] | None = None
+    enabled_toolsets: list[str] | None = None
+    workdir: str | None = None
+    model: str | None = None
+    provider: str | None = None
+    base_url: str | None = None
+    pinned: bool | None = None
+    reasoning_effort: str | None = None
+    script: str | None = None
+    interpreter: str | None = None
+    no_agent: bool = False
+    monitor_script: str | None = None
+    monitor_url: str | None = None
+    monitor_state: dict[str, Any] | None = None
+    context_from: list[str] | None = None
+    quota_hold_until: str | None = None
+    unreachable_retry: dict[str, Any] | None = None
+    fire_claim: dict[str, Any] | None = None
+    last_dispatch: dict[str, Any] | None = None
+    created_at: str = ""
+
+
+def parse_schedule_stub(text: str, now: datetime) -> tuple[Any, str]:
+    """A tiny grammar for tests: ``30m`` / ``every 30m`` / ``every 2h`` → interval, ``in 30m``
+    → once, five fields → cron."""
+    words = text.strip().lower().split()
+    if len(words) >= 5:
+        return Cron(" ".join(words)), " ".join(words)
+    if words and words[0] == "in" and len(words) == 2:
+        return Once(now + _duration(words[1])), f"once in {words[1]}"
+    if words and words[0] == "every":
+        words = words[1:]
+    if len(words) == 1:
+        minutes = int(_duration(words[0]).total_seconds() // 60)
+        return Interval(minutes), f"every {minutes}m"
+    raise ValueError(f"cannot read the schedule {text!r}; try '30m', 'every 2h' or 'in 1h'")
+
+
+def _duration(word: str) -> timedelta:
+    unit = word[-1]
+    count = int(word[:-1])
+    if unit == "m":
+        return timedelta(minutes=count)
+    if unit == "h":
+        return timedelta(hours=count)
+    if unit == "d":
+        return timedelta(days=count)
+    raise ValueError(f"bad duration {word!r}")
+
+
+class StubNotepad:
+    def __init__(self) -> None:
+        self.data: dict[str, str] = {}
+
+    def get(self, key: str) -> str | None:
+        return self.data.get(key)
+
+    def set(self, key: str, value: str) -> None:
+        self.data[key] = value
+
+    def unset(self, key: str) -> bool:
+        return self.data.pop(key, None) is not None
+
+    def items(self) -> list[tuple[str, str]]:
+        return sorted(self.data.items())
+
+
+class StubBackend:
+    """In-memory jobs plus recorded calls; ``runner`` answers ``run_now``."""
+
+    def __init__(self, now: Callable[[], datetime]) -> None:
+        self.now = now
+        self.jobs: dict[str, StubJob] = {}
+        self.running: set[str] = set()
+        self.health = StoreHealthView(True)
+        self.paused_all: tuple[bool, str | None] = (False, None)
+        self.notepads: dict[str, StubNotepad] = {}
+        self.run_log: list[Mapping[str, Any]] = []
+        self.ticks = 0
+        self.runner: Callable[[str, str | None], Awaitable[RunReport]] | None = None
+        self.calls: list[tuple[str, Any]] = []
+
+    # store
+    def add(self, **fields: Any) -> StubJob:
+        job_id = fields.pop("id", None) or secrets.token_hex(6)
+        fields.setdefault("schedule", Interval(30))
+        fields.setdefault("schedule_display", "every 30m")
+        job = StubJob(id=job_id, **fields)
+        self.jobs[job_id] = job
+        return job
+
+    def list_jobs(self, *, include_disabled: bool = True) -> list[Any]:
+        jobs = list(self.jobs.values())
+        return jobs if include_disabled else [j for j in jobs if j.enabled]
+
+    def get(self, job_id: str) -> Any | None:
+        return self.jobs.get(job_id)
+
+    def resolve(self, ref: str) -> Any:
+        if ref in self.jobs:
+            return self.jobs[ref]
+        named = [j for j in self.jobs.values() if (j.name or "").lower() == ref.lower()]
+        if not named:
+            raise JobNotFound(ref)
+        if len(named) > 1:
+            raise JobAmbiguous(ref, [j.id for j in named])
+        return named[0]
+
+    def create(self, spec: Mapping[str, Any]) -> Any:
+        self.calls.append(("create", dict(spec)))
+        data = dict(spec)
+        schedule, display = parse_schedule_stub(str(data.pop("schedule")), self.now())
+        paused = bool(data.pop("paused", False))
+        reason = data.pop("paused_reason", None)
+        repeat = data.pop("repeat", None)
+        if not (data.get("prompt") or data.get("script") or data.get("skills")):
+            raise ValueError("a job needs a prompt, a script or skills")
+        job = self.add(schedule=schedule, schedule_display=display, **data)
+        job.repeat = Repeat(times=repeat if repeat else (1 if schedule.kind == "once" else None))
+        job.deliver = data.get("deliver") or "local"
+        if paused:
+            job.enabled, job.state, job.paused_reason = False, "paused", reason
+        else:
+            job.next_run_at = ports.iso(self.now() + timedelta(minutes=30))
+        return job
+
+    def update(self, job_id: str, changes: Mapping[str, Any]) -> Any:
+        self.calls.append(("update", (job_id, dict(changes))))
+        job = self.jobs[job_id]
+        data = dict(changes)
+        if "schedule" in data:
+            schedule, display = parse_schedule_stub(str(data.pop("schedule")), self.now())
+            job.schedule, job.schedule_display = schedule, display
+        for key, value in data.items():
+            if not hasattr(job, key):
+                raise ValueError(f"unknown field {key}")
+            setattr(job, key, value)
+        return job
+
+    def pause(self, job_id: str, reason: str | None = None) -> Any:
+        job = self.jobs[job_id]
+        job.enabled, job.state, job.paused_reason = False, "paused", reason
+        return job
+
+    def resume(self, job_id: str) -> Any:
+        job = self.jobs[job_id]
+        job.enabled, job.state, job.paused_reason = True, "scheduled", None
+        return job
+
+    def remove(self, job_id: str) -> bool:
+        return self.jobs.pop(job_id, None) is not None
+
+    def is_running(self, job_id: str) -> bool:
+        return job_id in self.running
+
+    async def run_now(self, job_id: str, *, context: str | None = None) -> RunReport:
+        self.calls.append(("run", (job_id, context)))
+        if self.runner is not None:
+            return await self.runner(job_id, context)
+        return RunReport(job_id, "ok", "delivered", None, None, "done")
+
+    def runs(self, job_id: str | None = None, *, limit: int = 20) -> list[Mapping[str, Any]]:
+        rows = [r for r in self.run_log if job_id is None or r.get("job_id") == job_id]
+        return rows[:limit]
+
+    def store_health(self) -> StoreHealthView:
+        return self.health
+
+    def global_pause(self) -> tuple[bool, str | None]:
+        return self.paused_all
+
+    def set_global_pause(self, paused: bool, reason: str | None = None) -> None:
+        self.paused_all = (paused, reason if paused else None)
+
+    def notepad(self, job_id: str) -> StubNotepad:
+        return self.notepads.setdefault(job_id, StubNotepad())
+
+    def tick(self) -> int:
+        self.ticks += 1
+        return 0
+
+    def daemon(self) -> int:
+        return 0
+
+
+def copy_job(job: StubJob, **changes: Any) -> StubJob:
+    return replace(job, **changes)
