index 0000000..567cca8
--- /dev/null
+++ b/src/indus/cron/errors.py
@@ -0,0 +1,88 @@
+"""Typed errors of the cron package (codes ``cron.*``).
+
+Validation errors (bad schedule, invalid job, notepad limits) are also ``ValueError`` so callers
+that only know the standard library still catch them.
+"""
+
+from __future__ import annotations
+
+from indus.foundation.errors import IndusError
+
+__all__ = [
+    "AmbiguousJobRef",
+    "AttemptFinal",
+    "CronError",
+    "CronStoreBusy",
+    "InvalidJob",
+    "JobNotFound",
+    "NextRunError",
+    "NotepadLimit",
+    "OneShotInPast",
+    "ScheduleError",
+    "SlotTaken",
+]
+
+CRON_ERROR_CODES: dict[str, str] = {
+    "cron.error": "scheduled job problem",
+    "cron.bad_schedule": "the schedule text is not one of the accepted forms",
+    "cron.oneshot_past": "a one-shot time is more than 120 s in the past",
+    "cron.next_run_failed": "the next run of a recurring job cannot be computed",
+    "cron.invalid_job": "a job definition breaks a rule (payload, mode, field value)",
+    "cron.job_not_found": "no job has this id or name",
+    "cron.ambiguous_job": "the name matches more than one job; use the id",
+    "cron.store_busy": "another process held the cron job store lock past the time budget",
+    "cron.slot_taken": "this scheduled slot already has an attempt; it is never run twice",
+    "cron.attempt_final": "the attempt is already finished; finished attempts never change",
+    "cron.notepad_limit": "a notepad write would break the size limits; nothing was written",
+}
+
+
+class CronError(IndusError):
+    default_code = "cron.error"
+
+
+class ScheduleError(CronError, ValueError):
+    default_code = "cron.bad_schedule"
+
+
+class OneShotInPast(ScheduleError):
+    default_code = "cron.oneshot_past"
+
+
+class NextRunError(CronError):
+    default_code = "cron.next_run_failed"
+
+
+class InvalidJob(CronError, ValueError):
+    default_code = "cron.invalid_job"
+
+
+class JobNotFound(CronError, LookupError):
+    default_code = "cron.job_not_found"
+
+
+class AmbiguousJobRef(CronError, LookupError):
+    default_code = "cron.ambiguous_job"
+
+    def __init__(self, ref: str, candidates: tuple[str, ...]) -> None:
+        super().__init__(
+            f"{len(candidates)} jobs are named {ref!r} ({', '.join(candidates)}); use the job id"
+        )
+        self.ref = ref
+        self.candidates = candidates
+
+
+class CronStoreBusy(CronError):
+    default_code = "cron.store_busy"
+
+
+class SlotTaken(CronError):
+    default_code = "cron.slot_taken"
+
+
+class AttemptFinal(CronError):
+    default_code = "cron.attempt_final"
+
+
+class NotepadLimit(CronError, ValueError):
+    default_code = "cron.notepad_limit"
diff --git a/src/indus/cron/grammar.py b/src/indus/cron/grammar.py
new file mode 100644
index 0000000..1e88cc4
--- /dev/null
+++ b/src/indus/cron/grammar.py
@@ -0,0 +1,373 @@
+"""Schedule grammar: what a person types → a once, interval or cron schedule (P14-01).
+
+Forms, tried in this order (case-insensitive):
+
+1. day/time phrase, optional leading ``every``: a day spec (``day``/``daily``/``everyday``,
+   ``weekday(s)``, ``weekend(s)``, or weekday names / three-letter abbreviations joined by spaces,
+   commas or ``and``), an optional ``at``, a time (``9am``, ``9:30pm``, ``14:00``, bare hour ``7``,
+   ``noon``/``midday``, ``midnight``) → 5-field cron;
+2. ``every <N> day(s) at <time>`` → daily cron (N = 1), weekly cron (N = 7), else an interval of
+   N days anchored on the next occurrence of that time (D-16.54);
+3. any other ``every <duration>`` → interval;
+4. five or more fields of ``[A-Za-z0-9*,-/]`` → cron (exactly five accepted);
+5. ISO timestamp (contains ``T`` or starts ``YYYY-MM-DD``) → once; naive means the configured
+   agent zone;
+6. ``in <duration>`` → once, now + duration in UTC;
+7. bare duration → **recurring** interval (P6);
+8. otherwise ``ScheduleError`` listing the forms.
+
+Every schedule has a canonical ``display`` that parses back to the same schedule.
+"""
+
+from __future__ import annotations
+
+import re
+from datetime import UTC, date, datetime, time, timedelta, tzinfo
+from typing import Annotated, Literal
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from indus.cron.errors import ScheduleError
+from indus.cron.zones import UtcDatetime, effective_zone, first_instant_at_or_after
+
+__all__ = [
+    "FORMS_HELP",
+    "CronSchedule",
+    "IntervalSchedule",
+    "OnceSchedule",
+    "Schedule",
+    "format_minutes",
+    "is_recurring",
+    "parse_duration",
+    "parse_schedule",
+    "validate_cron",
+]
+
+
+class _ScheduleBase(BaseModel):
+    model_config = ConfigDict(frozen=True, extra="forbid")
+
+
+class OnceSchedule(_ScheduleBase):
+    kind: Literal["once"] = "once"
+    run_at: UtcDatetime
+    display: str
+
+
+class IntervalSchedule(_ScheduleBase):
+    kind: Literal["interval"] = "interval"
+    minutes: int = Field(ge=1)
+    # Set for "every N days at HH:MM": runs fall on anchor + k * minutes.
+    anchor: UtcDatetime | None = None
+    display: str
+
+
+class CronSchedule(_ScheduleBase):
+    kind: Literal["cron"] = "cron"
+    expr: str
+    display: str
+
+
+Schedule = Annotated[OnceSchedule | IntervalSchedule | CronSchedule, Field(discriminator="kind")]
+
+
+def is_recurring(schedule: OnceSchedule | IntervalSchedule | CronSchedule) -> bool:
+    return schedule.kind != "once"
+
+
+FORMS_HELP = """\
+  30m, 2h, every 2h, every day    repeat at that interval
+  in 30m, in 2h                   run once after that delay
+  weekdays at 9am, mon,fri 18:30  repeat on those days at that time (also daily, weekends)
+  every 3d at 09:00               every N days at that time
+  0 9 * * 1-5                     a five-field cron expression
+  2026-11-01T09:00                run once at that time (the agent's time zone unless an offset
+                                  is given)"""
+
+# -- durations ----------------------------------------------------------------------------------
+
+_UNIT_MINUTES = {"m": 1, "h": 60, "d": 1440}
+_DURATION = re.compile(
+    r"^(\d+)?\s*(m|min|mins|minute|minutes|h|hr|hrs|hour|hours|d|day|days)$", re.IGNORECASE
+)
+
+
+def _duration_minutes(text: str) -> int | None:
+    match = _DURATION.match(text.strip())
+    if match is None:
+        return None
+    count = int(match.group(1)) if match.group(1) else 1
+    return count * _UNIT_MINUTES[match.group(2)[0].lower()]
+
+
+def parse_duration(text: str) -> int:
+    """``30m`` → 30, ``2 hours`` → 120, ``day`` → 1440; zero or junk raises ``ScheduleError``."""
+    minutes = _duration_minutes(text)
+    if minutes is None:
+        raise ScheduleError(f"{text.strip()!r} is not a duration (use 30m, 2h, 1d)")
+    if minutes <= 0:
+        raise ScheduleError("a duration must be at least one minute")
+    return minutes
+
+
+def format_minutes(minutes: int) -> str:
+    """The shortest exact unit: 1440 → ``1d``, 120 → ``2h``, 90 → ``90m``."""
+    if minutes % 1440 == 0:
+        return f"{minutes // 1440}d"
+    if minutes % 60 == 0:
+        return f"{minutes // 60}h"
+    return f"{minutes}m"
+
+
+# -- times and day specs ------------------------------------------------------------------------
+
+_CLOCK = re.compile(r"^(\d{1,2})(?::(\d{2}))?(am|pm)?$")
+_NAMED_TIMES = {"noon": (12, 0), "midday": (12, 0), "midnight": (0, 0)}
+
+# Cron day-of-week numbers: 0 = Sunday.
+_DAY_NAMES = ("sunday", "monday", "tuesday", "wednesday", "thursday", "friday", "saturday")
+_DAY_NUMBER: dict[str, int] = {}
+for _number, _name in enumerate(_DAY_NAMES):
+    _DAY_NUMBER[_name] = _number
+    _DAY_NUMBER[_name + "s"] = _number
+    _DAY_NUMBER[_name[:3]] = _number
+
+_DAY_SPECS = {
+    "day": "*",
+    "daily": "*",
+    "everyday": "*",
+    "weekday": "1-5",
+    "weekdays": "1-5",
+    "weekend": "0,6",
+    "weekends": "0,6",
+}
+_SPEC_DISPLAY = {"*": "daily", "1-5": "weekdays", "0,6": "weekends"}
+
+
+def _clock_time(text: str) -> tuple[int, int] | None:
+    compact = text.replace(" ", "").lower()
+    if compact in _NAMED_TIMES:
+        return _NAMED_TIMES[compact]
+    match = _CLOCK.match(compact)
+    if match is None:
+        return None
+    hour, minute = int(match.group(1)), int(match.group(2) or 0)
+    meridiem = match.group(3)
+    if meridiem is not None:
+        if not 1 <= hour <= 12:
+            return None
+        hour = hour % 12 + (12 if meridiem == "pm" else 0)
+    if hour > 23 or minute > 59:
+        return None
+    return hour, minute
+
+
+def _day_field(tokens: list[str]) -> tuple[str, int] | None:
+    """The cron day-of-week field and how many tokens it used, or None."""
+    if not tokens:
+        return None
+    spec = _DAY_SPECS.get(tokens[0])
+    if spec is not None:
+        return spec, 1
+    days: set[int] = set()
+    used = 0
+    for token in tokens:
+        if token == "and" and days:
+            used += 1
+            continue
+        number = _DAY_NUMBER.get(token)
+        if number is None:
+            break
+        days.add(number)
+        used += 1
+    if not days:
+        return None
+    if tokens[used - 1] == "and":
+        return None  # "mon and" with nothing after the "and"
+    return ",".join(str(d) for d in sorted(days)), used
+
+
+def _day_display(field: str) -> str:
+    if field in _SPEC_DISPLAY:
+        return _SPEC_DISPLAY[field]
+    return ",".join(_DAY_NAMES[int(d)][:3] for d in field.split(","))
+
+
+def _phrase(text: str) -> CronSchedule | None:
+    tokens = text.replace(",", " ").split()
+    found = _day_field(tokens)
+    if found is None:
+        return None
+    field, used = found
+    rest = tokens[used:]
+    if rest and rest[0] == "at":
+        rest = rest[1:]
+    if not rest:
+        return None
+    clock = _clock_time(" ".join(rest))
+    if clock is None:
+        return None
+    hour, minute = clock
+    return CronSchedule(
+        expr=f"{minute} {hour} * * {field}",
+        display=f"{_day_display(field)} at {hour:02d}:{minute:02d}",
+    )
+
+
+# -- every N days at a time ---------------------------------------------------------------------
+
+_EVERY_DAYS_AT = re.compile(r"^(\d+)\s*(?:d|day|days)\s+(?:at\s+)?(.+)$")
+
+
+def _next_wall_time(hour: int, minute: int, zone: tzinfo, now: datetime) -> datetime:
+    local_day: date = now.astimezone(zone).date()
+    for offset in range(0, 3):
+        wall = datetime.combine(local_day + timedelta(days=offset), time(hour, minute))
+        instant = first_instant_at_or_after(wall, zone)
+        if instant > now:
+            return instant
+    raise ScheduleError("could not place the first run")  # pragma: no cover - 3 days always do
+
+
+def _every_days_at(
+    rest: str, zone: tzinfo, now: datetime
+) -> CronSchedule | IntervalSchedule | None:
+    match = _EVERY_DAYS_AT.match(rest)
+    if match is None:
+        return None
+    clock = _clock_time(match.group(2))
+    if clock is None:
+        return None
+    count = int(match.group(1))
+    if count <= 0:
+        raise ScheduleError("every 0 days is not a schedule")
+    hour, minute = clock
+    hhmm = f"{hour:02d}:{minute:02d}"
+    if count == 1:
+        return CronSchedule(expr=f"{minute} {hour} * * *", display=f"daily at {hhmm}")
+    first = _next_wall_time(hour, minute, zone, now)
+    if count == 7:
+        weekday = (first.astimezone(zone).weekday() + 1) % 7  # Python Monday=0 → cron Monday=1
+        return CronSchedule(
+            expr=f"{minute} {hour} * * {weekday}",
+            display=f"{_DAY_NAMES[weekday][:3]} at {hhmm}",
+        )
+    return IntervalSchedule(minutes=count * 1440, anchor=first, display=f"every {count}d at {hhmm}")
+
+
+# -- cron ---------------------------------------------------------------------------------------
+
+_CRON_FIELD = re.compile(r"^[A-Za-z0-9*,\-/]+$")
+
+
+def validate_cron(expr: str) -> str:
+    """The expression with single spaces, or ``ScheduleError`` (five fields, croniter syntax)."""
+    fields = expr.split()
+    if len(fields) != 5:
+        raise ScheduleError(
+            f"a cron expression has five fields (minute hour day month weekday); "
+            f"{expr.strip()!r} has {len(fields)}"
+        )
+    normal = " ".join(fields)
+    try:
+        from croniter import croniter  # pyright: ignore[reportMissingTypeStubs]
+    except ImportError as exc:
+        raise ScheduleError("cron expressions need the croniter package") from exc
+    try:
+        croniter(normal, datetime(2000, 1, 1))
+    except Exception as exc:  # croniter raises several error types for a bad expression
+        raise ScheduleError(f"{normal!r} is not a valid cron expression: {exc}") from exc
+    return normal
+
+
+def _looks_like_cron(text: str) -> bool:
+    fields = text.split()
+    if len(fields) < 5 or not all(_CRON_FIELD.match(f) for f in fields):
+        return False
+    # Five plain words ("whenever you feel like it") are a sentence, not a cron expression.
+    return any(ch.isdigit() or ch == "*" for ch in text)
+
+
+# -- one-shots ----------------------------------------------------------------------------------
+
+_DATE_START = re.compile(r"^\d{4}-\d{2}-\d{2}")
+
+
+def _once_display(run_at: datetime, zone: tzinfo) -> str:
+    local = run_at.astimezone(zone)
+    if local.second == 0 and local.microsecond == 0:
+        return local.isoformat(timespec="minutes")
+    return local.isoformat()
+
+
+def _once_at(text: str, zone: tzinfo) -> OnceSchedule:
+    try:
+        parsed = datetime.fromisoformat(text)
+    except ValueError as exc:
+        raise ScheduleError(
+            f"cannot read the schedule {text!r} as a timestamp ({exc}). Use one of:\n{FORMS_HELP}"
+        ) from exc
+    if parsed.tzinfo is None or parsed.utcoffset() is None:
+        instant = first_instant_at_or_after(parsed.replace(tzinfo=None), zone)
+    else:
+        instant = parsed.astimezone(UTC)
+    return OnceSchedule(run_at=instant, display=_once_display(instant, zone))
+
+
+# -- entry point --------------------------------------------------------------------------------
+
+
+def _forms_error(text: str) -> ScheduleError:
+    return ScheduleError(f"cannot read the schedule {text!r}. Use one of:\n{FORMS_HELP}")
+
+
+def parse_schedule(
+    text: str, tz: tzinfo | None, *, now: datetime | None = None
+) -> OnceSchedule | IntervalSchedule | CronSchedule:
+    """Parse ``text``; ``tz`` is the configured agent zone (None = system zone)."""
+    original = text.strip()
+    if not original:
+        raise _forms_error(text)
+    zone = effective_zone(tz)
+    current = (now or datetime.now(UTC)).astimezone(UTC)
+    lowered = " ".join(original.lower().split())
+
+    has_every = lowered.startswith("every ")
+    rest = lowered[len("every ") :].strip() if has_every else lowered
+
+    phrase = _phrase(rest)
+    if phrase is not None:
+        return phrase
+    if has_every:
+        anchored = _every_days_at(rest, zone, current)
+        if anchored is not None:
+            return anchored
+        minutes = _duration_minutes(rest)
+        if minutes is None:
+            raise _forms_error(original)
+        if minutes <= 0:
+            raise ScheduleError("an interval must be at least one minute")
+        return IntervalSchedule(minutes=minutes, display=f"every {format_minutes(minutes)}")
+
+    if _looks_like_cron(original):
+        expr = validate_cron(original)
+        return CronSchedule(expr=expr, display=expr)
+
+    if "T" in original or _DATE_START.match(original):
+        return _once_at(original, zone)
+
+    if lowered.startswith("in "):
+        minutes = _duration_minutes(lowered[3:])
+        if minutes is None:
+            raise _forms_error(original)
+        if minutes <= 0:
+            raise ScheduleError("a delay must be at least one minute")
+        run_at = (current + timedelta(minutes=minutes)).replace(microsecond=0)
+        return OnceSchedule(run_at=run_at, display=_once_display(run_at, zone))
+
+    minutes = _duration_minutes(lowered)
+    if minutes is not None:
+        if minutes <= 0:
+            raise ScheduleError("an interval must be at least one minute")
+        return IntervalSchedule(minutes=minutes, display=f"every {format_minutes(minutes)}")
+    raise _forms_error(original)
diff --git a/src/indus/cron/ledger.py b/src/indus/cron/ledger.py
new file mode 100644
index 0000000..6c96659
--- /dev/null
+++ b/src/indus/cron/ledger.py
@@ -0,0 +1,525 @@
+"""The execution ledger: one durable row per run attempt in ``<home>/cron/executions.db`` (P14-04).
+
+An attempt is written **before** its run is dispatched (``claim``). A scheduled slot — the exact
+(job, instant) pair — can be claimed once; a stale ``jobs.json`` pointing at a slot that already
+has an attempt is caught by ``slot_attempted`` and never replayed (R07.13).
+
+States: ``claimed → running → completed | failed | unknown``; finished rows never change
+(``AttemptFinal``), except that an unset ``delivery_status`` may be filled in once.
+
+Reaping (every tick, and before a manual run) turns a non-terminal attempt ``unknown`` when its
+owner is proved dead — the PID is gone, or now belongs to a process with another start
+fingerprint — or when a live owner has sent no heartbeat for max(3 × inactivity timeout, script
+timeout, 2 h). The calling process's own attempts are left alone. ``unknown`` attempts are never
+re-run: their slot stays taken.
+
+History is bounded to the newest 500 finished attempts per job; active ones are never pruned.
+The database is opened with the P02 plumbing (isolation guard, owner-only file, journal policy,
+one ``Writer``) and also holds the per-job notepad table (P14-17).
+"""
+
+from __future__ import annotations
+
+import errno
+import os
+import sqlite3
+import sys
+import uuid
+from collections.abc import Callable
+from dataclasses import dataclass
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import Any, Literal, Protocol
+
+from indus.cron.errors import AttemptFinal, CronError, SlotTaken
+from indus.foundation.clock import Clock
+from indus.foundation.scope import Scope
+from indus.state import journal
+from indus.state.connection import open_store
+from indus.state.writer import Writer
+
+__all__ = [
+    "ACTIVE_STATES",
+    "KEEP_PER_JOB",
+    "LIVE_SILENCE_FLOOR_S",
+    "TERMINAL_STATES",
+    "Attempt",
+    "AttemptKind",
+    "AttemptState",
+    "ExecutionLedger",
+    "ExecutionsDB",
+    "ProcessProbe",
+    "SystemProcesses",
+    "iso",
+    "silence_bound",
+]
+
+AttemptKind = Literal["scheduled", "manual", "retry"]
+AttemptState = Literal["claimed", "running", "completed", "failed", "unknown"]
+
+ACTIVE_STATES: tuple[AttemptState, ...] = ("claimed", "running")
+TERMINAL_STATES: tuple[AttemptState, ...] = ("completed", "failed", "unknown")
+KEEP_PER_JOB = 500
+LIVE_SILENCE_FLOOR_S = 7200.0
+SCHEMA_VERSION = 1
+
+_SCHEMA = (
+    """CREATE TABLE IF NOT EXISTS attempts (
+        attempt_id TEXT PRIMARY KEY,
+        job_id TEXT NOT NULL,
+        scheduled_for TEXT,
+        kind TEXT NOT NULL CHECK (kind IN ('scheduled', 'manual', 'retry')),
+        state TEXT NOT NULL
+            CHECK (state IN ('claimed', 'running', 'completed', 'failed', 'unknown')),
+        owner_pid INTEGER NOT NULL,
+        owner_start_fingerprint TEXT,
+        claimed_at TEXT NOT NULL,
+        heartbeat_at TEXT,
+        started_at TEXT,
+        finished_at TEXT,
+        result_status TEXT,
+        delivery_status TEXT,
+        error TEXT
+    )""",
+    # A scheduled slot is claimed at most once, whatever happened to the attempt.
+    """CREATE UNIQUE INDEX IF NOT EXISTS attempts_slot
+        ON attempts (job_id, scheduled_for)
+        WHERE kind = 'scheduled' AND scheduled_for IS NOT NULL""",
+    "CREATE INDEX IF NOT EXISTS attempts_job ON attempts (job_id, claimed_at)",
+    "CREATE INDEX IF NOT EXISTS attempts_state ON attempts (state)",
+    """CREATE TABLE IF NOT EXISTS job_notes (
+        job_id TEXT NOT NULL,
+        key TEXT NOT NULL,
+        value TEXT NOT NULL,
+        updated_at TEXT NOT NULL,
+        PRIMARY KEY (job_id, key)
+    )""",
+)
+
+_OWNER_GONE = "the process that ran it ended before recording a result; whether it ran is unknown"
+_OWNER_SILENT = (
+    "the process that ran it stopped reporting progress for longer than {bound:g} s; "
+    "whether it finished is unknown (the process was not stopped)"
+)
+
+
+def iso(value: datetime) -> str:
+    """The stored form of an instant: UTC, microsecond precision (sorts as text)."""
+    return value.astimezone(UTC).isoformat(timespec="microseconds")
+
+
+def _parse(value: object) -> datetime | None:
+    if not isinstance(value, str) or not value:
+        return None
+    parsed = datetime.fromisoformat(value)
+    return parsed if parsed.tzinfo is not None else parsed.replace(tzinfo=UTC)
+
+
+def silence_bound(inactivity_timeout_s: float, script_timeout_s: float) -> float:
+    """How long a live owner may stay silent: max(3 × inactivity, script timeout, 2 h)."""
+    inactivity = inactivity_timeout_s if inactivity_timeout_s > 0 else 0.0
+    return max(3 * inactivity, max(script_timeout_s, 0.0), LIVE_SILENCE_FLOOR_S)
+
+
+# -- processes ----------------------------------------------------------------------------------
+
+
+class ProcessProbe(Protocol):
+    """What the reaper needs to know about processes (tests use ``tests.fakes.pids``)."""
+
+    def current(self) -> tuple[int, str | None]:
+        """This process: (pid, start fingerprint)."""
+        ...
+
+    def exists(self, pid: int) -> bool: ...
+
+    def fingerprint(self, pid: int) -> str | None:
+        """An exact identity of the process start, or None when it cannot be read."""
+        ...
+
+
+class SystemProcesses:
+    """Real processes. The fingerprint is Linux-only (boot id + start ticks)."""
+
+    def __init__(self, proc: Path = Path("/proc")) -> None:
+        self.proc = proc
+        self._boot: str | None = None
+
+    def _boot_id(self) -> str:
+        if self._boot is None:
+            try:
+                path = self.proc / "sys/kernel/random/boot_id"
+                self._boot = path.read_text(encoding="ascii").strip()
+            except OSError:
+                self._boot = ""
+        return self._boot
+
+    def current(self) -> tuple[int, str | None]:
+        pid = os.getpid()
+        return pid, self.fingerprint(pid)
+
+    def exists(self, pid: int) -> bool:
+        if pid <= 0:
+            return False
+        if sys.platform.startswith("linux"):
+            return (self.proc / str(pid)).is_dir()
+        if sys.platform == "win32":
+            return True  # no side-effect-free probe here; the silence rule still applies
+        # Signal 0 only asks the kernel whether the PID is taken; any answer but "no such
+        # process" (EPERM included) means some process holds it.
+        try:
+            os.kill(pid, 0)
+        except OSError as exc:
+            return exc.errno != errno.ESRCH
+        return True
+
+    def fingerprint(self, pid: int) -> str | None:
+        if not sys.platform.startswith("linux"):
+            return None
+        try:
+            raw = (self.proc / str(pid) / "stat").read_text(encoding="utf-8", errors="replace")
+        except OSError:
+            return None
+        # The command name (field 2) may hold spaces and parentheses; fields after the last ")".
+        fields = raw.rpartition(")")[2].split()
+        if len(fields) < 20:
+            return None
+        return f"{self._boot_id()}:{fields[19]}"
+
+
+# -- the database -------------------------------------------------------------------------------
+
+
+class ExecutionsDB:
+    """``executions.db``: one writer connection (P02 discipline) shared by ledger and notepad."""
+
+    def __init__(self, scope: Scope, path: Path | None = None) -> None:
+        self.scope = scope
+        self.path = path if path is not None else scope.home / "cron" / "executions.db"
+        self.clock: Clock = scope.clock
+        handle = open_store(scope, self.path, on_connected=self._setup)
+        self.path = handle.path
+        self.writer = Writer(self.path, handle.conn, clock=scope.clock)
+
+    def _setup(self, conn: sqlite3.Connection) -> None:
+        cfg = journal.database_config(self.scope)
+        journal.apply(conn, cfg, self.path)
+        journal.apply_pragmas(conn, cfg)
+        conn.execute("BEGIN IMMEDIATE")
+        try:
+            for statement in _SCHEMA:
+                conn.execute(statement)
+            conn.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
+            conn.execute("COMMIT")
+        except BaseException:
+            conn.execute("ROLLBACK")
+            raise
+
+    def read[T](self, fn: Callable[[sqlite3.Connection], T]) -> T:
+        with self.writer.borrow() as conn:
+            return fn(conn)
+
+    def write[T](self, fn: Callable[[sqlite3.Connection], T]) -> T:
+        return self.writer.write(fn)
+
+    def close(self) -> None:
+        self.writer.close()
+
+
+# -- attempts -----------------------------------------------------------------------------------
+
+
+@dataclass(frozen=True)
+class Attempt:
+    attempt_id: str
+    job_id: str
+    scheduled_for: datetime | None
+    kind: AttemptKind
+    state: AttemptState
+    owner_pid: int
+    owner_start_fingerprint: str | None
+    claimed_at: datetime
+    heartbeat_at: datetime | None
+    started_at: datetime | None
+    finished_at: datetime | None
+    result_status: str | None
+    delivery_status: str | None
+    error: str | None
+
+    @property
+    def terminal(self) -> bool:
+        return self.state in TERMINAL_STATES
+
+    @classmethod
+    def from_row(cls, row: sqlite3.Row) -> Attempt:
+        claimed = _parse(row["claimed_at"])
+        assert claimed is not None
+        return cls(
+            attempt_id=row["attempt_id"],
+            job_id=row["job_id"],
+            scheduled_for=_parse(row["scheduled_for"]),
+            kind=row["kind"],
+            state=row["state"],
+            owner_pid=int(row["owner_pid"]),
+            owner_start_fingerprint=row["owner_start_fingerprint"],
+            claimed_at=claimed,
+            heartbeat_at=_parse(row["heartbeat_at"]),
+            started_at=_parse(row["started_at"]),
+            finished_at=_parse(row["finished_at"]),
+            result_status=row["result_status"],
+            delivery_status=row["delivery_status"],
+            error=row["error"],
+        )
+
+
+def _fetch(conn: sqlite3.Connection, attempt_id: str) -> Attempt | None:
+    row = conn.execute("SELECT * FROM attempts WHERE attempt_id = ?", (attempt_id,)).fetchone()
+    return Attempt.from_row(row) if row is not None else None
+
+
+class ExecutionLedger:
+    """Attempt bookkeeping over an ``ExecutionsDB``."""
+
+    def __init__(
+        self, db: ExecutionsDB, *, clock: Clock | None = None, procs: ProcessProbe | None = None
+    ) -> None:
+        self.db = db
+        self.clock = clock if clock is not None else db.clock
+        self.procs: ProcessProbe = procs if procs is not None else SystemProcesses()
+        self._me = self.procs.current()
+
+    def _now(self) -> str:
+        return iso(self.clock.now())
+
+    # -- writes ----------------------------------------------------------------------------------
+
+    def claim(
+        self, job_id: str, *, scheduled_for: datetime | None, kind: AttemptKind = "scheduled"
+    ) -> Attempt:
+        """Record an attempt before dispatch; ``SlotTaken`` when the slot already has one."""
+        if kind == "scheduled" and scheduled_for is None:
+            raise ValueError("a scheduled attempt needs the slot it runs")
+        attempt_id = uuid.uuid4().hex
+        pid, fingerprint = self._me
+        now = self._now()
+        slot = iso(scheduled_for) if scheduled_for is not None else None
+
+        def insert(conn: sqlite3.Connection) -> Attempt:
+            conn.execute(
+                """INSERT INTO attempts (attempt_id, job_id, scheduled_for, kind, state,
+                       owner_pid, owner_start_fingerprint, claimed_at, heartbeat_at)
+                   VALUES (?, ?, ?, ?, 'claimed', ?, ?, ?, ?)""",
+                (attempt_id, job_id, slot, kind, pid, fingerprint, now, now),
+            )
+            found = _fetch(conn, attempt_id)
+            assert found is not None
+            return found
+
+        try:
+            return self.db.write(insert)
+        except sqlite3.IntegrityError as exc:
+            raise SlotTaken(
+                f"the run of job {job_id} due at {slot} was already attempted; it is not run again"
+            ) from exc
+
+    def _transition(
+        self,
+        attempt_id: str,
+        sql: str,
+        params: tuple[Any, ...],
+        *,
+        what: str,
+    ) -> Attempt:
+        def apply(conn: sqlite3.Connection) -> Attempt:
+            current = _fetch(conn, attempt_id)
+            if current is None:
+                raise CronError(f"no attempt {attempt_id}")
+            if current.terminal:
+                raise AttemptFinal(
+                    f"attempt {attempt_id} is already {current.state}; it cannot be {what}"
+                )
+            conn.execute(sql, (*params, attempt_id))
+            found = _fetch(conn, attempt_id)
+            assert found is not None
+            return found
+
+        return self.db.write(apply)
+
+    def start(self, attempt_id: str) -> Attempt:
+        now = self._now()
+        return self._transition(
+            attempt_id,
+            """UPDATE attempts SET state = 'running', started_at = COALESCE(started_at, ?),
+                   heartbeat_at = ? WHERE attempt_id = ?""",
+            (now, now),
+            what="started",
+        )
+
+    def heartbeat(self, attempt_id: str) -> bool:
+        now = self._now()
+
+        def apply(conn: sqlite3.Connection) -> bool:
+            cur = conn.execute(
+                "UPDATE attempts SET heartbeat_at = ? WHERE attempt_id = ? "
+                "AND state IN ('claimed', 'running')",
+                (now, attempt_id),
+            )
+            return cur.rowcount == 1
+
+        return self.db.write(apply)
+
+    def finish(
+        self,
+        attempt_id: str,
+        *,
+        ok: bool,
+        result_status: str | None = None,
+        delivery_status: str | None = None,
+        error: str | None = None,
+    ) -> Attempt:
+        """Write the terminal result once (``completed`` when ``ok``, else ``failed``)."""
+        state = "completed" if ok else "failed"
+        now = self._now()
+        attempt = self._transition(
+            attempt_id,
+            """UPDATE attempts SET state = ?, finished_at = ?, result_status = ?,
+                   delivery_status = ?, error = ? WHERE attempt_id = ?""",
+            (state, now, result_status, delivery_status, None if ok else (error or "failed")),
+            what="finished again",
+        )
+        self._prune(attempt.job_id)
+        return attempt
+
+    def note_delivery(self, attempt_id: str, status: str) -> bool:
+        """Fill in ``delivery_status`` once (it may arrive after the result)."""
+
+        def apply(conn: sqlite3.Connection) -> bool:
+            cur = conn.execute(
+                "UPDATE attempts SET delivery_status = ? WHERE attempt_id = ? "
+                "AND delivery_status IS NULL",
+                (status, attempt_id),
+            )
+            return cur.rowcount == 1
+
+        return self.db.write(apply)
+
+    def _prune(self, job_id: str) -> None:
+        def apply(conn: sqlite3.Connection) -> None:
+            conn.execute(
+                """DELETE FROM attempts WHERE job_id = ? AND state IN
+                       ('completed', 'failed', 'unknown')
+                   AND attempt_id NOT IN (
+                       SELECT attempt_id FROM attempts WHERE job_id = ? AND state IN
+                           ('completed', 'failed', 'unknown')
+                       ORDER BY COALESCE(finished_at, claimed_at) DESC, claimed_at DESC
+                       LIMIT ?)""",
+                (job_id, job_id, KEEP_PER_JOB),
+            )
+
+        self.db.write(apply)
+
+    # -- reaping ---------------------------------------------------------------------------------
+
+    def _is_mine(self, attempt: Attempt) -> bool:
+        pid, fingerprint = self._me
+        return attempt.owner_pid == pid and attempt.owner_start_fingerprint == fingerprint
+
+    def _owner_dead(self, attempt: Attempt) -> bool:
+        if not self.procs.exists(attempt.owner_pid):
+            return True
+        recorded = attempt.owner_start_fingerprint
+        if recorded is None:
+            return False
+        current = self.procs.fingerprint(attempt.owner_pid)
+        return current is not None and current != recorded
+
+    def reap(
+        self, *, inactivity_timeout_s: float = 600.0, script_timeout_s: float = 3600.0
+    ) -> list[Attempt]:
+        """Mark abandoned attempts ``unknown`` (never re-run); returns the ones changed."""
+        bound = silence_bound(inactivity_timeout_s, script_timeout_s)
+        now_dt = self.clock.now().astimezone(UTC)
+        now = iso(now_dt)
+
+        def apply(conn: sqlite3.Connection) -> list[Attempt]:
+            rows = conn.execute(
+                "SELECT * FROM attempts WHERE state IN ('claimed', 'running')"
+            ).fetchall()
+            changed: list[Attempt] = []
+            for row in rows:
+                attempt = Attempt.from_row(row)
+                if self._is_mine(attempt):
+                    continue
+                if self._owner_dead(attempt):
+                    reason = _OWNER_GONE
+                else:
+                    last = attempt.heartbeat_at or attempt.claimed_at
+                    if now_dt - last <= timedelta(seconds=bound):
+                        continue
+                    reason = _OWNER_SILENT.format(bound=bound)
+                conn.execute(
+                    "UPDATE attempts SET state = 'unknown', finished_at = ?, error = ? "
+                    "WHERE attempt_id = ? AND state IN ('claimed', 'running')",
+                    (now, reason, attempt.attempt_id),
+                )
+                found = _fetch(conn, attempt.attempt_id)
+                assert found is not None
+                changed.append(found)
+            return changed
+
+        return self.db.write(apply)
+
+    # -- reads -----------------------------------------------------------------------------------
+
+    def get(self, attempt_id: str) -> Attempt | None:
+        return self.db.read(lambda conn: _fetch(conn, attempt_id))
+
+    def slot_attempted(self, job_id: str, scheduled_for: datetime) -> bool:
+        """Has this scheduled slot an attempt (in any state)?"""
+        slot = iso(scheduled_for)
+
+        def query(conn: sqlite3.Connection) -> bool:
+            row = conn.execute(
+                "SELECT 1 FROM attempts WHERE job_id = ? AND scheduled_for = ? "
+                "AND kind = 'scheduled' LIMIT 1",
+                (job_id, slot),
+            ).fetchone()
+            return row is not None
+
+        return self.db.read(query)
+
+    def history(self, job_id: str, limit: int = 50) -> list[Attempt]:
+        def query(conn: sqlite3.Connection) -> list[Attempt]:
+            rows = conn.execute(
+                "SELECT * FROM attempts WHERE job_id = ? ORDER BY claimed_at DESC LIMIT ?",
+                (job_id, limit),
+            ).fetchall()
+            return [Attempt.from_row(r) for r in rows]
+
+        return self.db.read(query)
+
+    def recent(self, limit: int = 50) -> list[Attempt]:
+        def query(conn: sqlite3.Connection) -> list[Attempt]:
+            rows = conn.execute(
+                "SELECT * FROM attempts ORDER BY claimed_at DESC LIMIT ?", (limit,)
+            ).fetchall()
+            return [Attempt.from_row(r) for r in rows]
+
+        return self.db.read(query)
+
+    def active(self, job_id: str | None = None) -> list[Attempt]:
+        def query(conn: sqlite3.Connection) -> list[Attempt]:
+            if job_id is None:
+                rows = conn.execute(
+                    "SELECT * FROM attempts WHERE state IN ('claimed', 'running') "
+                    "ORDER BY claimed_at"
+                ).fetchall()
+            else:
+                rows = conn.execute(
+                    "SELECT * FROM attempts WHERE job_id = ? AND state IN "
+                    "('claimed', 'running') ORDER BY claimed_at",
+                    (job_id,),
+                ).fetchall()
+            return [Attempt.from_row(r) for r in rows]
+
+        return self.db.read(query)
diff --git a/src/indus/cron/models.py b/src/indus/cron/models.py
new file mode 100644
index 0000000..ae75cf4
--- /dev/null
+++ b/src/indus/cron/models.py
@@ -0,0 +1,292 @@
+"""The cron job record and what a create request carries (P14-03).
+
+Fields are split in two: *authored* fields describe the job (what a person or an import sets) and
+*scheduler* fields record what happened to it (run state, counters, claims). An import refreshes
+authored fields and keeps scheduler state (``merge_authored``). ``enabled`` is the authoritative
+switch; ``state == "paused"`` or a ``paused_at`` stamp is a second gate, so a half-paused record
+never fires.
+
+All datetimes are aware UTC. Unknown keys (a newer build's fields) are kept so a rewrite never
+drops them.
+"""
+
+from __future__ import annotations
+
+import re
+import secrets
+from collections.abc import Mapping
+from typing import Any, Literal
+
+from pydantic import BaseModel, ConfigDict, Field, field_validator
+
+from indus.cron.grammar import CronSchedule, IntervalSchedule, OnceSchedule, Schedule
+from indus.cron.zones import UtcDatetime
+
+__all__ = [
+    "AUTHORED_FIELDS",
+    "JOB_ID_PATTERN",
+    "SCHEDULER_FIELDS",
+    "CronJob",
+    "DispatchStamp",
+    "FireClaim",
+    "JobSpec",
+    "JobState",
+    "MonitorState",
+    "Origin",
+    "Repeat",
+    "derive_label",
+    "merge_authored",
+    "new_job_id",
+]
+
+JobState = Literal["scheduled", "paused", "completed", "error"]
+LatenessClass = Literal["on_time", "late", "catch_up"]
+
+# New ids are 12 lowercase hex characters; loaded ids only have to be safe as a path component.
+JOB_ID_PATTERN = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
+LABEL_CHARS = 50
+
+
+def new_job_id() -> str:
+    return secrets.token_hex(6)
+
+
+class _Part(BaseModel):
+    model_config = ConfigDict(extra="allow")
+
+
+class Repeat(_Part):
+    """``times`` None = forever; ``completed`` counts finished scheduled runs."""
+
+    times: int | None = None
+    completed: int = Field(default=0, ge=0)
+
+    @field_validator("times")
+    @classmethod
+    def _forever_when_not_positive(cls, value: int | None) -> int | None:
+        return None if value is None or value <= 0 else value
+
+    @property
+    def exhausted(self) -> bool:
+        return self.times is not None and self.completed >= self.times
+
+
+class Origin(_Part):
+    platform: str
+    chat_id: str
+    thread_id: str | None = None
+
+
+class FireClaim(_Part):
+    owner: str
+    claimed_at: UtcDatetime
+    heartbeat_at: UtcDatetime
+
+
+class MonitorState(_Part):
+    hash: str | None = None
+    last_output_path: str | None = None
+
+
+class DispatchStamp(_Part):
+    scheduled_for: UtcDatetime
+    dispatched_at: UtcDatetime
+    lateness_s: float
+    lateness: LatenessClass
+
+
+AUTHORED_FIELDS: frozenset[str] = frozenset(
+    {
+        "name",
+        "prompt",
+        "skills",
+        "schedule",
+        "schedule_display",
+        "deliver",
+        "failure_deliver",
+        "origin",
+        "enabled_toolsets",
+        "workdir",
+        "model",
+        "provider",
+        "base_url",
+        "pinned",
+        "reasoning_effort",
+        "script",
+        "interpreter",
+        "no_agent",
+        "monitor_script",
+        "monitor_url",
+        "context_from",
+    }
+)
+# ``repeat`` is split: ``times`` is authored, ``completed`` is scheduler-owned.
+SCHEDULER_FIELDS: frozenset[str] = frozenset(
+    {
+        "enabled",
+        "state",
+        "paused_at",
+        "paused_reason",
+        "next_run_at",
+        "last_run_at",
+        "last_status",
+        "last_error",
+        "last_delivery_error",
+        "last_delivery_unverified",
+        "failure_streak",
+        "monitor_state",
+        "quota_hold_until",
+        "fire_claim",
+        "last_dispatch",
+        "schedule_error",
+    }
+)
+
+
+class CronJob(BaseModel):
+    model_config = ConfigDict(extra="allow", validate_assignment=True)
+
+    id: str
+    created_at: UtcDatetime
+
+    # -- authored --------------------------------------------------------------------------------
+    name: str | None = None
+    prompt: str | None = None
+    skills: list[str] = Field(default_factory=list[str])
+    schedule: Schedule
+    schedule_display: str = ""
+    repeat: Repeat = Field(default_factory=Repeat)
+    deliver: str = "local"
+    failure_deliver: str | None = None
+    origin: Origin | None = None
+    enabled_toolsets: list[str] | None = None
+    workdir: str | None = None
+    model: str | None = None
+    provider: str | None = None
+    base_url: str | None = None
+    pinned: bool = False
+    reasoning_effort: str | None = None
+    script: str | None = None
+    interpreter: str | None = None
+    no_agent: bool = False
+    monitor_script: str | None = None
+    monitor_url: str | None = None
+    context_from: list[str] = Field(default_factory=list[str])
+
+    # -- scheduler-owned -------------------------------------------------------------------------
+    enabled: bool = True
+    state: JobState = "scheduled"
+    paused_at: UtcDatetime | None = None
+    paused_reason: str | None = None
+    next_run_at: UtcDatetime | None = None
+    last_run_at: UtcDatetime | None = None
+    last_status: str | None = None
+    last_error: str | None = None
+    last_delivery_error: str | None = None
+    last_delivery_unverified: str | None = None
+    failure_streak: int = Field(default=0, ge=0)
+    monitor_state: MonitorState | None = None
+    quota_hold_until: UtcDatetime | None = None
+    fire_claim: FireClaim | None = None
+    last_dispatch: DispatchStamp | None = None
+    schedule_error: str | None = None
+
+    @field_validator("id")
+    @classmethod
+    def _safe_id(cls, value: str) -> str:
+        if not JOB_ID_PATTERN.match(value):
+            raise ValueError("job id must be 1-64 letters, digits, '_' or '-'")
+        return value
+
+    # -- derived ---------------------------------------------------------------------------------
+
+    @property
+    def label(self) -> str:
+        return self.name or derive_label(self.prompt, self.skills, self.script) or self.id
+
+    @property
+    def recurring(self) -> bool:
+        return not isinstance(self.schedule, OnceSchedule)
+
+    @property
+    def has_pause_marker(self) -> bool:
+        return self.state == "paused" or self.paused_at is not None
+
+    @property
+    def paused(self) -> bool:
+        return not self.enabled or self.has_pause_marker
+
+    @property
+    def runnable(self) -> bool:
+        """May the scheduler fire it (ignoring time)?"""
+        finished = self.state in ("completed", "error")
+        return self.enabled and not self.has_pause_marker and not finished
+
+    @property
+    def display_state(self) -> JobState:
+        """What a person should see: never "scheduled" for a job that will not fire."""
+        if self.state in ("completed", "error"):
+            return self.state
+        return "paused" if self.paused else "scheduled"
+
+    def to_record(self) -> dict[str, Any]:
+        return self.model_dump(mode="json")
+
+
+def derive_label(prompt: str | None, skills: list[str], script: str | None) -> str:
+    """A short label from the payload: first prompt line, else first skill, else the script."""
+    if prompt and prompt.strip():
+        line = prompt.strip().splitlines()[0].strip()
+        return line[:LABEL_CHARS].rstrip()
+    if skills:
+        return skills[0][:LABEL_CHARS]
+    if script:
+        return script.strip()[:LABEL_CHARS]
+    return ""
+
+
+class JobSpec(BaseModel):
+    """A create request: authored fields, the schedule as text or parsed, and pause options."""
+
+    model_config = ConfigDict(extra="forbid")
+
+    schedule: str | OnceSchedule | IntervalSchedule | CronSchedule
+    prompt: str | None = None
+    name: str | None = None
+    skills: list[str] = Field(default_factory=list[str])
+    repeat: int | None = None
+    deliver: str | None = None
+    failure_deliver: str | None = None
+    origin: Origin | None = None
+    enabled_toolsets: list[str] | None = None
+    workdir: str | None = None
+    model: str | None = None
+    provider: str | None = None
+    base_url: str | None = None
+    pinned: bool = False
+    reasoning_effort: str | None = None
+    script: str | None = None
+    interpreter: str | None = None
+    no_agent: bool = False
+    monitor_script: str | None = None
+    monitor_url: str | None = None
+    context_from: list[str] = Field(default_factory=list[str])
+    paused: bool = False
+    paused_reason: str | None = None
+
+
+def merge_authored(local: CronJob, authored: Mapping[str, Any]) -> CronJob:
+    """``local`` with the authored fields of ``authored``; scheduler state is kept.
+
+    ``authored["repeat"]`` may be a mapping or a number; only its ``times`` is taken. The caller
+    re-plans ``next_run_at`` when the schedule changed.
+    """
+    data = local.model_dump(mode="python")
+    for key in AUTHORED_FIELDS:
+        if key in authored:
+            data[key] = authored[key]
+    if "repeat" in authored:
+        raw = authored["repeat"]
+        times = raw.get("times") if isinstance(raw, Mapping) else raw
+        data["repeat"] = {"times": times, "completed": local.repeat.completed}
+    return CronJob.model_validate(data)
