new file mode 100644
index 0000000..6333a89
--- /dev/null
+++ b/src/indus/service/cron_refs.py
@@ -0,0 +1,35 @@
+"""The cron store as a curator ``SkillReferenceSource`` (P14-03, R07.8).
+
+``indus.cron`` and ``indus.learning`` are sibling layers and may not import each other, so the
+adapter lives here. Hosts call ``register_cron_references(store)`` at start; the curator then never
+archives a skill any job names (paused jobs included) and asks the store to follow renames.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Callable, Collection, Mapping
+
+from indus.cron.store import CronStore
+from indus.learning.curator import ReferenceRewrite, register_reference_source
+
+__all__ = ["CronSkillReferences", "register_cron_references"]
+
+
+class CronSkillReferences:
+    def __init__(self, store: CronStore) -> None:
+        self.store = store
+
+    @property
+    def name(self) -> str:
+        return "cron"
+
+    def referenced_skills(self) -> set[str]:
+        return self.store.referenced_skills()
+
+    def rewrite(self, renames: Mapping[str, str], dropped: Collection[str]) -> ReferenceRewrite:
+        return ReferenceRewrite(self.name, self.store.rewrite_skills(renames, dropped))
+
+
+def register_cron_references(store: CronStore) -> Callable[[], None]:
+    """Register ``store`` with the curator; returns the undo."""
+    return register_reference_source(CronSkillReferences(store))
diff --git a/tests/fakes/pids.py b/tests/fakes/pids.py
new file mode 100644
index 0000000..93e9328
--- /dev/null
+++ b/tests/fakes/pids.py
@@ -0,0 +1,46 @@
+"""A process table for ledger reaping tests (P14-04).
+
+``FakePids(me=(100, "boot:1"))`` is this process; ``spawn(pid, fingerprint)`` adds another one,
+``kill(pid)`` ends it, ``reuse(pid, fingerprint)`` hands the PID to a new process.
+``unreadable(pid)`` hides a fingerprint (non-Linux, permissions).
+"""
+
+from __future__ import annotations
+
+
+class FakePids:
+    def __init__(self, me: tuple[int, str | None] = (100, "boot:100")) -> None:
+        self.me = me
+        self.table: dict[int, str | None] = {me[0]: me[1]}
+        self.hidden: set[int] = set()
+
+    def current(self) -> tuple[int, str | None]:
+        return self.me
+
+    def exists(self, pid: int) -> bool:
+        return pid in self.table
+
+    def fingerprint(self, pid: int) -> str | None:
+        if pid in self.hidden:
+            return None
+        return self.table.get(pid)
+
+    def spawn(self, pid: int, fingerprint: str | None = None) -> FakePids:
+        self.table[pid] = fingerprint if fingerprint is not None else f"boot:{pid}"
+        return self
+
+    def kill(self, pid: int) -> None:
+        self.table.pop(pid, None)
+
+    def reuse(self, pid: int, fingerprint: str) -> None:
+        self.table[pid] = fingerprint
+
+    def unreadable(self, pid: int) -> None:
+        self.hidden.add(pid)
+
+    def as_process(self, pid: int) -> FakePids:
+        """The same table seen from process ``pid`` (it must exist)."""
+        other = FakePids((pid, self.table[pid]))
+        other.table = self.table
+        other.hidden = self.hidden
+        return other
