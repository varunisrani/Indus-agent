+def test_daemon_fires_an_every_30m_job_twice_in_an_hour(
+    scope: Scope, fake_clock: FakeClock
+) -> None:
+    agent = Agent()
+    world, ticker = setup(scope, agent)
+    start = fake_clock.now()
+    world.store.add(new_job(next_run_at=(start + timedelta(minutes=30)).isoformat()))
+
+    async def main() -> None:
+        stop = asyncio.Event()
+        daemon = asyncio.ensure_future(ticker.run_daemon(stop))
+        while fake_clock.now() < start + timedelta(minutes=60, seconds=30):
+            await asyncio.wait({daemon}, timeout=0.0005)
+            fake_clock.advance(10)
+        stop.set()
+        await run_driven(_wrap(daemon), fake_clock, step=1.0)
+
+    asyncio.run(main())
+    assert len(agent.calls) == 2
+    slots = [row["scheduled_for"] for row in world.ledger.rows()]
+    assert slots == [
+        (start + timedelta(minutes=30)).isoformat(),
+        (start + timedelta(minutes=60)).isoformat(),
+    ]
+
+
+async def _wrap(task: asyncio.Future[Any]) -> Any:
+    return await task
+
