+"""``indus cron tick`` as a separate process, before the CLI verb lands (P14-07 integration).
+
+Bootstraps the process like the CLI does, registers the C1/C3 stand-in ports (removed at
+integration, when the real store registers its factory), runs one tick and exits with its code.
+At integration this module goes away and the test runs ``indus cron tick`` itself.
+"""
+
+from __future__ import annotations
+
+import sys
+
+from indus.foundation import bootstrap
+from indus.service import cron_host
+from tests.unit.cron._stubs_c2 import install
+
+
+def main() -> int:
+    scope, _ = bootstrap.run(["cron", "tick"])
+    install()
+    report = cron_host.tick_main(scope)
+    if report.message:
+        print(report.message)
+    for job_id, outcome in report.outcomes.items():
+        print(f"{job_id} {outcome.status}")
+    return report.exit_code
+
+
+if __name__ == "__main__":
+    sys.exit(main())
