+# STAND-IN: removed at integration
+"""Test-only stand-ins for slice C1 (job store, ledger, due rules, next run, store health) and
+slice C3 (finish: delivery and bookkeeping), shaped after the phase file's field lists.
+
+Records are plain dicts in ``<home>/cron/jobs.json`` (so a subprocess tick sees them), the ledger
+is ``<home>/cron/stub_ledger.json``. ``install(home)`` registers a ports factory for the process;
+``make_ports(home)`` gives one ``CronPorts`` directly.
+"""
+
+from __future__ import annotations
+
+import json
+import secrets
+import threading
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+from typing import Any, Literal
+
+from indus.cron.classify import RunOutcome
+from indus.cron.ports import (
+    AttemptKind,
+    CronPorts,
+    DueSlot,
+    JobSpec,
+    MonitorCheck,
+    set_ports_factory,
+)
+from indus.foundation.fsio import FileLock, atomic_write_text
+from indus.foundation.home import secure_dir
+
+JOBS_FILE = "jobs.json"
+LEDGER_FILE = "stub_ledger.json"
+
+
+def _when(value: object) -> datetime | None:
+    if isinstance(value, datetime):
+        return value
+    if isinstance(value, str) and value:
+        return datetime.fromisoformat(value)
+    return None
+
+
+def _dump(obj: object) -> str:
+    return json.dumps(obj, indent=2, default=lambda o: o.isoformat()) + "\n"
+
+
+def new_job(**fields: Any) -> dict[str, Any]:
+    """A job record with the phase file's fields and defaults (C1's CronJob, as a dict)."""
+    record: dict[str, Any] = {
+        "id": secrets.token_hex(6),
+        "name": None,
+        "prompt": "check the build",
+        "skills": [],
+        "schedule": {"kind": "interval", "minutes": 30},
+        "schedule_display": "every 30m",
+        "repeat": {"times": None, "completed": 0},
+        "enabled": True,
+        "state": "scheduled",
+        "next_run_at": None,
+        "last_run_at": None,
+        "last_status": None,
+        "failure_streak": 0,
+        "deliver": "local",
+        "enabled_toolsets": None,
+        "workdir": None,
+        "model": None,
+        "provider": None,
+        "base_url": None,
+        "pinned": False,
+        "reasoning_effort": None,
+        "script": None,
+        "interpreter": None,
+        "no_agent": False,
+        "context_from": [],
+        "fire_claim": None,
+    }
+    record.update(fields)
+    return record
+
+
+class StubStore:
+    """C1 P14-03 stand-in: a JSON list of dict records under a file lock."""
+
+    def __init__(self, home: Path) -> None:
+        self.folder = secure_dir(home / "cron")
+        self.path = self.folder / JOBS_FILE
+        self.lock = FileLock(self.folder / "jobs.lock", timeout=30)
+        self.edits = 0
+
+    def _read(self) -> list[dict[str, Any]]:
+        try:
+            return json.loads(self.path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return []
+
+    def _write(self, jobs: list[dict[str, Any]]) -> None:
+        atomic_write_text(self.path, _dump(jobs))
+
+    def add(self, record: dict[str, Any]) -> dict[str, Any]:
+        with self.lock:
+            jobs = self._read()
+            jobs.append(record)
+            self._write(jobs)
+        return record
+
+    def remove(self, job_id: str) -> None:
+        with self.lock:
+            self._write([j for j in self._read() if j["id"] != job_id])
+
+    def load(self) -> list[Any]:
+        with self.lock:
+            return self._read()
+
+    def get(self, job_id: str) -> dict[str, Any] | None:
+        return next((j for j in self.load() if j["id"] == job_id), None)
+
+    def find(self, ref: str) -> Any | None:
+        jobs = self.load()
+        exact = [j for j in jobs if j["id"] == ref]
+        if exact:
+            return exact[0]
+        named = [j for j in jobs if (j.get("name") or "").lower() == ref.lower()]
+        return named[0] if len(named) == 1 else None
+
+    def edit[T](self, job_id: str, change: Callable[[Any], T]) -> T | None:
+        with self.lock:
+            jobs = self._read()
+            for record in jobs:
+                if record["id"] == job_id:
+                    result = change(record)
+                    self._write(jobs)
+                    self.edits += 1
+                    return result
+        return None
+
+
+class StubLedger:
+    """C1 P14-04 stand-in: attempts in a JSON file; a completed slot is never begun again."""
+
+    def __init__(self, home: Path) -> None:
+        self.path = secure_dir(home / "cron") / LEDGER_FILE
+        self._lock = threading.Lock()
+        self.reaped = 0
+
+    def rows(self) -> list[dict[str, Any]]:
+        try:
+            return json.loads(self.path.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return []
+
+    def _save(self, rows: list[dict[str, Any]]) -> None:
+        atomic_write_text(self.path, _dump(rows))
+
+    def reap(self, now: datetime) -> int:
+        self.reaped += 1
+        return 0
+
+    def begin(
+        self, job_id: str, scheduled_for: datetime | None, kind: AttemptKind, now: datetime
+    ) -> str | None:
+        with self._lock:
+            rows = self.rows()
+            slot = scheduled_for.isoformat() if scheduled_for is not None else None
+            for row in rows:
+                if (
+                    slot is not None
+                    and row["job_id"] == job_id
+                    and row["scheduled_for"] == slot
+                    and row["state"] == "completed"
+                ):
+                    return None
+            attempt = secrets.token_hex(8)
+            rows.append(
+                {
+                    "attempt_id": attempt,
+                    "job_id": job_id,
+                    "scheduled_for": slot,
+                    "kind": kind,
+                    "state": "claimed",
+                    "heartbeats": 0,
+                    "result_status": None,
+                }
+            )
+            self._save(rows)
+            return attempt
+
+    def _update(self, attempt_id: str, **values: Any) -> None:
+        with self._lock:
+            rows = self.rows()
+            for row in rows:
+                if row["attempt_id"] == attempt_id:
+                    if values.pop("bump", False):
+                        row["heartbeats"] += 1
+                    row.update(values)
+            self._save(rows)
+
+    def running(self, attempt_id: str, now: datetime) -> None:
+        self._update(attempt_id, state="running")
+
+    def heartbeat(self, attempt_id: str, now: datetime) -> None:
+        self._update(attempt_id, bump=True)
+
+    def finish(
+        self,
+        attempt_id: str,
+        *,
+        state: Literal["completed", "failed"],
+        result_status: str,
+        now: datetime,
+    ) -> None:
+        self._update(attempt_id, state=state, result_status=result_status)
+
+
+@dataclass
+class Finished:
+    """C3 stand-in: what ``finish`` was handed."""
+
+    calls: list[tuple[JobSpec, RunOutcome]] = field(
+        default_factory=list[tuple[JobSpec, RunOutcome]]
+    )
+
+    @property
+    def outcomes(self) -> list[RunOutcome]:
+        return [o for _, o in self.calls]
+
+
+def interval_next(record: Any, now: datetime) -> datetime | None:
+    """C1 P14-02 stand-in: interval jobs step from their slot to the first instant after now."""
+    schedule = record.get("schedule") or {}
+    if schedule.get("kind") != "interval":
+        return None
+    step = timedelta(minutes=int(schedule.get("minutes") or 30))
+    base = _when(record.get("next_run_at")) or now
+    following = base + step
+    while following <= now:
+        following += step
+    return following
+
+
+@dataclass
+class StubWorld:
+    home: Path
+    store: StubStore
+    ledger: StubLedger
+    finished: Finished
+    writable: list[bool]
+    monitor_answers: list[MonitorCheck] = field(default_factory=list[MonitorCheck])
+    notepads: dict[str, str] = field(default_factory=dict[str, str])
+    ports: CronPorts | None = None
+
+
+def make_world(home: Path, *, with_monitor: bool = False) -> StubWorld:
+    store, ledger = StubStore(home), StubLedger(home)
+    world = StubWorld(home, store, ledger, Finished(), [True])
+
+    def due(now: datetime) -> list[DueSlot]:
+        slots: list[DueSlot] = []
+        for record in store.load():
+            when = _when(record.get("next_run_at"))
+            if record.get("enabled", True) and when is not None and when <= now:
+                slots.append(DueSlot(record, when))
+        return slots
+
+    async def finish(job: JobSpec, outcome: RunOutcome) -> None:
+        world.finished.calls.append((job, outcome))
+
+        def book(record: Any) -> None:
+            record["last_status"] = outcome.status
+            record["last_run_at"] = datetime.now(UTC).isoformat()
+            if record.get("schedule", {}).get("kind") not in ("interval", "cron"):
+                record["enabled"] = False
+                record["state"] = "completed"
+
+        store.edit(job.id, book)
+
+    async def monitor(job: JobSpec) -> MonitorCheck:
+        return world.monitor_answers.pop(0) if world.monitor_answers else MonitorCheck("changed")
+
+    world.ports = CronPorts(
+        store=store,
+        ledger=ledger,
+        store_writable=lambda _now: world.writable[0],
+        due=due,
+        next_run=interval_next,
+        notepad=lambda job_id: world.notepads.get(job_id, ""),
+        monitor=monitor if with_monitor else None,
+        finish=finish,
+    )
+    return world
+
+
+def make_ports(home: Path) -> CronPorts:
+    world = make_world(home)
+    assert world.ports is not None
+    return world.ports
+
+
+def install() -> None:
+    """Register the stand-in factory for this process (``ports_for(scope)``)."""
+    set_ports_factory(lambda scope: make_ports(scope.home))
