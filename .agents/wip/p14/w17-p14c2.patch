+"""A real tick process runs a script-only job and writes its output document (P14-07, H5)."""
+
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+
+from indus.cron.output import documents, read_document
+from tests.unit.cron._stubs_c2 import StubLedger, StubStore, new_job
+
+ROOT = Path(__file__).resolve().parents[3]
+FIXTURES = ROOT / "tests" / "fixtures" / "cron" / "scripts"
+TIMEOUT = 90
+
+
+def _tick_command() -> list[str]:
+    # At integration: ["indus", "cron", "tick"] (C3's verb over C1's store).
+    return [sys.executable, "-m", "tests.integration.cron.tick_entry"]
+
+
+def _env(home: Path) -> dict[str, str]:
+    env = {k: v for k, v in os.environ.items() if not k.startswith("INDUS_")}
+    env.update({"INDUS_HOME": str(home), "PYTHONPATH": str(ROOT)})
+    return env
+
+
+def tick(home: Path, cwd: Path) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        _tick_command(),
+        capture_output=True,
+        text=True,
+        cwd=cwd,
+        env=_env(home),
+        timeout=TIMEOUT,
+    )
+
+
+def test_tick_process_runs_a_script_only_job(tmp_path: Path) -> None:
+    home = tmp_path / "home"
+    (home / "scripts").mkdir(parents=True)
+    shutil.copy(FIXTURES / "report.sh", home / "scripts" / "report.sh")
+    due = datetime.now(UTC) - timedelta(minutes=1)
+    job = StubStore(home).add(
+        new_job(no_agent=True, script="report.sh", prompt=None, next_run_at=due.isoformat())
+    )
+
+    first = tick(home, tmp_path)
+    assert first.returncode == 0, first.stderr
+    assert f"{job['id']} ok" in first.stdout
+
+    docs = documents(home, job["id"])
+    assert len(docs) == 1
+    doc = read_document(docs[0])
+    assert doc is not None and doc.status == "ok"
+    assert doc.section("response") == "disk usage 71% on /srv"
+    attempt = StubLedger(home).rows()[0]
+    assert attempt["state"] == "completed" and attempt["kind"] == "scheduled"
+    assert (home / "cron" / "ticker_heartbeat").exists()
+    assert (home / "cron" / "ticker_last_success").exists()
+
+    second = tick(home, tmp_path)  # the slot moved on at claim time: nothing is due now
+    assert second.returncode == 0, second.stderr
+    assert len(documents(home, job["id"])) == 1
