+    TASK_OVERRIDES.set(scope, "task_9", TaskOverride(backend="docker", image=IMAGE))
+    try:
+        key, _env = await registry.acquire(scope, task_id="task_9")
+        assert key.backend == "docker"
+        assert recorder.requests[0].scope.config is not None
