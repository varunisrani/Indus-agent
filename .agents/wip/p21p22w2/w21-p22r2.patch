+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [
+                {
+                    "id": "a2",
+                    "type": "function",
+                    "function": {"name": "terminal", "arguments": '{"timeout": 5, "command": '
+                                 f'"echo {SENTINEL} made it"}}'},
+                }
+            ],
