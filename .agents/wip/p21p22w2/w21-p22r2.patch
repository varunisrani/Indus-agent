+# STAND-IN: removed at integration
+"""Test-only stand-in for P21-14's per-task override registry (slice B3 builds the real one).
+
+It has the ``swe_runner.OverrideRegistrar`` shape: ``register`` maps the requested overrides the
+way the plan describes P21-14 (same image name for Docker and Modal, ``docker://<image>`` for
+Singularity) and remembers them under ``(profile home, task id)``; ``clear`` forgets them. At
+integration the lead points the SWE runner (and the batch worker's ``ImagePrep.register``) at the
+real registry and deletes this file.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+from indus.foundation.scope import Scope
+
+
+@dataclass
+class StandInTaskOverrides:
+    live: dict[tuple[str, str], dict[str, Any]] = field(
+        default_factory=dict[tuple[str, str], dict[str, Any]]
+    )
+    log: list[tuple[str, str]] = field(default_factory=list[tuple[str, str]])
+
+    def register(
+        self, scope: Scope, task_id: str, overrides: Mapping[str, Any]
+    ) -> Mapping[str, Any]:
+        mapped = dict(overrides)
+        image = mapped.get("image")
+        if image and mapped.get("backend") == "singularity":
+            mapped["image"] = f"docker://{image}"
+        self.live[(str(scope.home), task_id)] = mapped
+        self.log.append(("register", task_id))
+        return mapped
+
+    def clear(self, scope: Scope, task_id: str) -> None:
+        self.live.pop((str(scope.home), task_id), None)
+        self.log.append(("clear", task_id))
