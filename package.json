{
  "name": "indus-agent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "tui:build": "pnpm --filter @indus/tui run build",
    "tui:e2e": "pnpm --filter @indus/tui run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
