import asyncio
import os
import pty
import subprocess


def spawn(argv: list[str], env: dict[str, str], extra: dict[str, object]) -> None:
    subprocess.run(argv, check=False)  # expect: inherit_env
    subprocess.check_output(argv)  # expect: inherit_env
    subprocess.run(argv, env=env, check=False)
    subprocess.run(argv, **extra)
    os.execvp(argv[0], argv)  # expect: inherit_env
    os.execvpe(argv[0], argv, env)
    pty.spawn(argv)  # expect: inherit_env


async def spawn_async(argv: list[str]) -> None:
    await asyncio.create_subprocess_exec(*argv)  # expect: inherit_env
