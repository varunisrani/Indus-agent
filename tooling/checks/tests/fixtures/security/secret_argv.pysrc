import asyncio
import subprocess


def call(api_key: str, settings: object, user: str) -> None:
    subprocess.run(["tool", "--key", api_key], env={}, check=False)  # expect: secret_argv
    subprocess.run(["tool", f"--auth={settings.bot_token}"], env={}, check=False)  # expect: secret_argv
    subprocess.run(["tool", "--user", user], env={}, check=False)


async def call_async(password: str) -> None:
    await asyncio.create_subprocess_exec("tool", "-p", password, env={})  # expect: secret_argv
