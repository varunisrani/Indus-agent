def urls(base: str, value: str) -> list[str]:
    """A docstring may say ?token= without being a URL."""
    return [
        f"{base}/download?token={value}",  # expect: secret_url
        "https://example.invalid/api?api_key=" + value,  # expect: secret_url
        f"{base}/items?page=2&access_token={value}",  # expect: secret_url
        f"{base}/items?page=2",
    ]
