import logging

log = logging.getLogger(__name__)


def report(token: str, ticket: object, settings: object) -> None:
    log.info("connected with %s", token)  # expect: secret_log
    logging.warning(f"secret {settings.client_secret}")  # expect: secret_log
    log.debug("ticket %s for %s", ticket.purpose, ticket.profile)
    log.info("got %d tokens", len(token))
