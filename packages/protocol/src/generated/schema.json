      "additionalProperties": false,
      "description": "Ask whether a risky action (usually a shell command) may run.",
      "properties": {
        "choices": {
          "description": "The answers the person may pick, in display order; ``deny`` is always allowed.",
          "items": {"$ref": "#/$defs/ApprovalChoice"},
          "minItems": 1,
          "type": "array"
        },
        "command": {
          "description": "The action to approve, already redacted for display.",
          "type": "string"
        },
        "deadline_s": {
          "anyOf": [{"exclusiveMinimum": 0, "type": "number"}, {"type": "null"}],
          "default": null,
          "description": "Seconds the agent waits before withdrawing the request; absent means no deadline."
        },
        "description": {"description": "Why the action needs approval.", "type": "string"},
        "kind": {
          "const": "approval",
          "default": "approval",
          "description": "Request kind.",
          "type": "string"
        },
        "request_id": {
          "description": "Unique id; the answer and any cancellation name it.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {"description": "The session asking.", "minLength": 1, "type": "string"},
        "turn_id": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The turn waiting on the answer, if any."
        }
      },
      "required": ["request_id", "session_id", "command", "description"],
      "type": "object"
    },
    "CancelReason": {
      "description": "Why an open server request was withdrawn.",
      "enum": ["interrupted", "turn_ended", "timed_out", "answered_elsewhere", "session_closed"],
      "type": "string"
    },
    "ClarifyAnswer": {
      "additionalProperties": false,
      "description": "The person's answers to a clarify request.",
      "properties": {
        "answers": {
          "additionalProperties": {"items": {"type": "string"}, "type": "array"},
          "description": "Question id → picked choices or typed text; an empty list means the question was skipped.",
          "type": "object"
        },
        "kind": {
          "const": "clarify",
          "default": "clarify",
          "description": "Answer kind.",
          "type": "string"
        }
      },
      "required": ["answers"],
      "type": "object"
    },
    "ClarifyQuestion": {
      "additionalProperties": false,
      "description": "One question inside a clarify request.",
      "properties": {
        "choices": {
          "anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}],
          "default": null,
          "description": "Offered answers; absent means free text only."
        },
        "id": {
          "description": "Question id, unique within the request.",
          "minLength": 1,
          "type": "string"
        },
        "multi_select": {
          "default": false,
          "description": "Whether more than one choice may be picked.",
          "type": "boolean"
        },
        "text": {"description": "The question.", "type": "string"}
      },
      "required": ["id", "text"],
      "type": "object"
    },
    "ClarifyRequest": {
      "additionalProperties": false,
      "description": "Ask the person one or more questions before the agent goes on.",
      "properties": {
        "deadline_s": {
          "anyOf": [{"exclusiveMinimum": 0, "type": "number"}, {"type": "null"}],
          "default": null,
          "description": "Seconds the agent waits before withdrawing the request; absent means no deadline."
        },
        "kind": {
          "const": "clarify",
          "default": "clarify",
          "description": "Request kind.",
          "type": "string"
        },
        "questions": {
          "description": "The questions, in display order.",
          "items": {"$ref": "#/$defs/ClarifyQuestion"},
          "minItems": 1,
          "type": "array"
        },
        "request_id": {
          "description": "Unique id; the answer and any cancellation name it.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {"description": "The session asking.", "minLength": 1, "type": "string"},
        "turn_id": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The turn waiting on the answer, if any."
        }
      },
      "required": ["request_id", "session_id", "questions"],
      "type": "object"
    },
    "ClientCapabilitiesParams": {
      "additionalProperties": false,
      "description": "Tell the server which optional features this client supports.",
      "properties": {
        "features": {
          "description": "Feature names; names the server does not know are ignored.",
          "items": {"type": "string"},
          "type": "array"
        }
      },
      "type": "object"
    },
    "ClientCapabilitiesResult": {
      "additionalProperties": false,
      "description": "The features both sides support (none are defined yet).",
      "properties": {
        "features": {
          "description": "The enabled feature names.",
          "items": {"type": "string"},
          "type": "array"
        }
      },
      "required": ["features"],
      "type": "object"
    },
    "ErrorDetail": {
      "additionalProperties": false,
      "description": "What we put in ``error.data``: the symbolic name plus optional context.",
      "properties": {
        "indus_code": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The product error code behind this error, when there is one."
        },
        "name": {
          "description": "The symbolic name of the code, e.g. ``SESSION_NOT_FOUND``.",
          "type": "string"
        },
        "path": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "For invalid params: the dotted path of the offending key."
        },
        "retryable": {
          "anyOf": [{"type": "boolean"}, {"type": "null"}],
          "default": null,
          "description": "Whether repeating the same call later may succeed."
        }
      },
      "required": ["name"],
      "type": "object"
    },
    "ErrorObject": {
      "additionalProperties": false,
      "description": "The ``error`` member of a failed response.",
      "properties": {
        "code": {"description": "A number from the protocol error table.", "type": "integer"},
        "data": {
          "$ref": "#/$defs/JsonValue",
          "default": null,
          "description": "Extra machine-readable detail; see ``ErrorDetail`` for the keys we send."
        },
        "message": {
          "description": "A short, human-readable description of the error.",
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "The answer to a request that failed, or to a frame that could not be read.",
      "properties": {
        "error": {"$ref": "#/$defs/ErrorObject", "description": "What went wrong."},
        "id": {
          "anyOf": [{"$ref": "#/$defs/RequestId"}, {"type": "null"}],
          "description": "The id of the failed request; ``null`` when it could not be determined."
        },
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "description": "Always the string ``2.0``.",
          "type": "string"
        }
      },
      "required": ["id", "error"],
      "type": "object"
    },
    "Event": {
      "discriminator": {
        "mapping": {
          "learning.review.done": "#/$defs/LearningReviewDone",
          "message.delta": "#/$defs/MessageDelta",
          "notice": "#/$defs/Notice",
          "reasoning.delta": "#/$defs/ReasoningDelta",
          "server_request.cancelled": "#/$defs/ServerRequestCancelled",
          "status": "#/$defs/Status",
          "tool.completed": "#/$defs/ToolCompleted",
          "tool.progress": "#/$defs/ToolProgress",
          "tool.started": "#/$defs/ToolStarted",
          "turn.done": "#/$defs/TurnDone",
          "turn.started": "#/$defs/TurnStarted"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {"$ref": "#/$defs/TurnStarted"},
        {"$ref": "#/$defs/MessageDelta"},
        {"$ref": "#/$defs/ReasoningDelta"},
        {"$ref": "#/$defs/ToolStarted"},
        {"$ref": "#/$defs/ToolProgress"},
        {"$ref": "#/$defs/ToolCompleted"},
        {"$ref": "#/$defs/Status"},
        {"$ref": "#/$defs/Notice"},
        {"$ref": "#/$defs/ServerRequestCancelled"},
        {"$ref": "#/$defs/TurnDone"},
        {"$ref": "#/$defs/LearningReviewDone"}
      ]
    },
    "ExitReason": {
      "description": "Why a turn ended. Closed set: every exit path of the turn loop maps to one value.",
      "enum": [
        "completed",
        "interrupted_by_user",
        "interrupted_by_system",
        "budget_exhausted",
        "max_iterations",
        "invalid_tool_strikes",
        "persistence_failed",
        "provider_failed",
        "compression_exhausted",
        "guardrail_halt"
      ],
      "type": "string"
    },
    "JsonValue": {},
    "LearningReviewDone": {
      "additionalProperties": false,
      "description": "A background review of the conversation finished (memory and skills, P09-16).",
      "properties": {
        "kinds": {
          "description": "What the review covered: ``memory``, ``skills`` or both.",
          "items": {"type": "string"},
          "type": "array"
        },
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "summary_lines": {
          "description": "One short line per saved change, ready to show; empty when nothing was saved.",
          "items": {"type": "string"},
          "type": "array"
        },
        "type": {
          "const": "learning.review.done",
          "default": "learning.review.done",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "kinds"],
      "type": "object"
    },
    "MessageDelta": {
      "additionalProperties": false,
      "description": "A piece of the assistant's visible reply.",
      "properties": {
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "description": "Raw text to append; clients render it themselves.",
          "type": "string"
        },
        "turn_id": {"description": "The turn this text belongs to.", "type": "string"},
        "type": {
          "const": "message.delta",
          "default": "message.delta",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "text"],
      "type": "object"
    },
    "MessageText": {"type": "string"},
    "Notice": {
      "additionalProperties": false,
      "description": "A message for the user that is not part of the conversation.",
      "properties": {
        "key": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "A stable key; a later notice with the same key replaces this one."
        },
        "level": {"$ref": "#/$defs/NoticeLevel", "description": "How loud the notice is."},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "text": {"description": "The notice text.", "type": "string"},
        "type": {
          "const": "notice",
          "default": "notice",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "level", "text"],
      "type": "object"
    },
    "NoticeLevel": {
      "description": "How loud a notice is.",
      "enum": ["info", "warning", "error"],
      "type": "string"
    },
    "Notification": {
      "additionalProperties": false,
      "description": "A one-way message: no ``id`` and never answered (events, server requests).",
      "properties": {
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "description": "Always the string ``2.0``.",
          "type": "string"
        },
        "method": {
          "description": "The event type or ``server_request``.",
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "anyOf": [
            {"additionalProperties": {"$ref": "#/$defs/JsonValue"}, "type": "object"},
            {"type": "null"}
          ],
          "default": null,
          "description": "The payload as named fields."
        }
      },
      "required": ["method"],
      "type": "object"
    },
    "PromptSubmitParams": {
      "additionalProperties": false,
      "description": "Send a user message and start a turn.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId",
          "description": "The session to run the turn in."
        },
        "text": {"$ref": "#/$defs/MessageText", "description": "The user's message."}
      },
      "required": ["session_id", "text"],
      "type": "object"
    },
    "PromptSubmitResult": {
      "additionalProperties": false,
      "description": "The ticket for the started turn.",
      "properties": {
        "generation": {
          "description": "The turn's generation, for interrupts.",
          "minimum": 0,
          "type": "integer"
        },
        "turn_id": {"description": "The turn's id; its events carry it.", "type": "string"}
      },
      "required": ["turn_id", "generation"],
      "type": "object"
    },
    "ReasoningDelta": {
      "additionalProperties": false,
      "description": "A piece of the model's reasoning, shown apart from the reply.",
      "properties": {
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "text": {"description": "Raw reasoning text to append.", "type": "string"},
        "turn_id": {"description": "The turn this reasoning belongs to.", "type": "string"},
        "type": {
          "const": "reasoning.delta",
          "default": "reasoning.delta",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "text"],
      "type": "object"
    },
    "RedirectOutcome": {
      "description": "What a redirect did.",
      "enum": ["redirected", "steered", "rejected"],
      "type": "string"
    },
    "Request": {
      "additionalProperties": false,
      "description": "A call that expects a response.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Chosen by the caller and echoed in the response."
        },
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "description": "Always the string ``2.0``.",
          "type": "string"
        },
        "method": {
          "description": "The method name, e.g. ``prompt.submit``.",
          "minLength": 1,
          "type": "string"
        },
        "params": {
          "anyOf": [
            {"additionalProperties": {"$ref": "#/$defs/JsonValue"}, "type": "object"},
            {"type": "null"}
          ],
          "default": null,
          "description": "Named parameters; omitted when the method takes none."
        }
      },
      "required": ["id", "method"],
      "type": "object"
    },
    "RequestId": {"anyOf": [{"type": "integer"}, {"type": "string"}]},
    "SecretAnswer": {
      "additionalProperties": false,
      "description": "The secret value, or nothing when the person skipped it.",
      "properties": {
        "kind": {
          "const": "secret",
          "default": "secret",
          "description": "Answer kind.",
          "type": "string"
        },
        "value": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The value; absent or empty when skipped."
        }
      },
      "type": "object"
    },
    "SecretRequest": {
      "additionalProperties": false,
      "description": "Ask for a secret (an API key or token) to store under a variable name.",
      "properties": {
        "deadline_s": {
          "anyOf": [{"exclusiveMinimum": 0, "type": "number"}, {"type": "null"}],
          "default": null,
          "description": "Seconds the agent waits before withdrawing the request; absent means no deadline."
        },
        "kind": {
          "const": "secret",
          "default": "secret",
          "description": "Request kind.",
          "type": "string"
        },
        "name": {
          "description": "The variable the value is stored as.",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "type": "string"
        },
        "prompt": {"description": "What to tell the person about the secret.", "type": "string"},
        "request_id": {
          "description": "Unique id; the answer and any cancellation name it.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {"description": "The session asking.", "minLength": 1, "type": "string"},
        "turn_id": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The turn waiting on the answer, if any."
        }
      },
      "required": ["request_id", "session_id", "name", "prompt"],
      "type": "object"
    },
    "ServerRequest": {
      "discriminator": {
        "mapping": {
          "approval": "#/$defs/ApprovalRequest",
          "clarify": "#/$defs/ClarifyRequest",
          "secret": "#/$defs/SecretRequest",
          "sudo": "#/$defs/SudoRequest"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {"$ref": "#/$defs/ApprovalRequest"},
        {"$ref": "#/$defs/ClarifyRequest"},
        {"$ref": "#/$defs/SudoRequest"},
        {"$ref": "#/$defs/SecretRequest"}
      ]
    },
    "ServerRequestAnswer": {
      "discriminator": {
        "mapping": {
          "approval": "#/$defs/ApprovalAnswer",
          "clarify": "#/$defs/ClarifyAnswer",
          "secret": "#/$defs/SecretAnswer",
          "sudo": "#/$defs/SudoAnswer"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {"$ref": "#/$defs/ApprovalAnswer"},
        {"$ref": "#/$defs/ClarifyAnswer"},
        {"$ref": "#/$defs/SudoAnswer"},
        {"$ref": "#/$defs/SecretAnswer"}
      ]
    },
    "ServerRequestAnswerParams": {
      "additionalProperties": false,
      "description": "Answer an open server request.",
      "properties": {
        "answer": {
          "$ref": "#/$defs/ServerRequestAnswer",
          "description": "The answer; its kind must match the request's."
        },
        "request_id": {
          "description": "The request being answered.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {"$ref": "#/$defs/SessionId", "description": "The session that asked."}
      },
      "required": ["session_id", "request_id", "answer"],
      "type": "object"
    },
    "ServerRequestAnswerResult": {
      "additionalProperties": false,
      "description": "Confirmation that the answer was delivered.",
      "properties": {
        "accepted": {
          "description": "True when the waiting agent received the answer.",
          "type": "boolean"
        }
      },
      "required": ["accepted"],
      "type": "object"
    },
    "ServerRequestCancelled": {
      "additionalProperties": false,
      "description": "An open server request was withdrawn; clients close its prompt.",
      "properties": {
        "reason": {"$ref": "#/$defs/CancelReason", "description": "Why it was withdrawn."},
        "request_id": {"description": "The withdrawn request's id.", "type": "string"},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "server_request.cancelled",
          "default": "server_request.cancelled",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "request_id", "reason"],
      "type": "object"
    },
    "SessionCreateParams": {
      "additionalProperties": false,
      "description": "Create a session.",
      "properties": {
        "cwd": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The working directory tools start in; absent uses the server's."
        },
        "idempotency_key": {
          "anyOf": [{"maxLength": 200, "minLength": 1, "type": "string"}, {"type": "null"}],
          "default": null,
          "description": "Repeating a create with the same key returns the first session instead of a new one."
        },
        "model": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The model to use; absent uses the configured default."
        },
        "title": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "A title for the session; absent leaves it untitled."
        },
        "toolsets": {
          "anyOf": [{"items": {"type": "string"}, "type": "array"}, {"type": "null"}],
          "default": null,
          "description": "Toolsets to enable; absent uses the surface's default selection."
        }
      },
      "type": "object"
    },
    "SessionCreateResult": {
      "additionalProperties": false,
      "description": "The created (or, for a repeated idempotency key, the existing) session.",
      "properties": {
        "created": {
          "description": "False when an earlier create with the same idempotency key is being returned.",
          "type": "boolean"
        },
        "session_id": {"description": "The session's id.", "type": "string"}
      },
      "required": ["session_id", "created"],
      "type": "object"
    },
    "SessionId": {"minLength": 1, "type": "string"},
    "SessionInterruptParams": {
      "additionalProperties": false,
      "description": "Stop the running turn.",
      "properties": {
        "generation": {
          "anyOf": [{"minimum": 0, "type": "integer"}, {"type": "null"}],
          "default": null,
          "description": "Only interrupt this generation; a stale one makes the call a no-op."
        },
        "hard": {"default": false, "description": "Also drop queued steer text.", "type": "boolean"},
        "session_id": {
          "$ref": "#/$defs/SessionId",
          "description": "The session whose turn to stop."
        }
      },
      "required": ["session_id"],
      "type": "object"
    },
    "SessionInterruptResult": {
      "additionalProperties": false,
      "description": "Whether a turn was interrupted.",
      "properties": {
        "interrupted": {
          "description": "False when no turn (or no turn of that generation) was running.",
          "type": "boolean"
        }
      },
      "required": ["interrupted"],
      "type": "object"
    },
    "SessionRedirectParams": {
      "additionalProperties": false,
      "description": "Correct the running turn: cancel the model call in flight and retry with this text.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId",
          "description": "The session with the running turn."
        },
        "text": {"$ref": "#/$defs/MessageText", "description": "The correction."}
      },
      "required": ["session_id", "text"],
      "type": "object"
    },
    "SessionRedirectResult": {
      "additionalProperties": false,
      "description": "What happened to the correction.",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/RedirectOutcome",
          "description": "``steered`` when tools were running, ``rejected`` when no turn was live."
        }
      },
      "required": ["outcome"],
      "type": "object"
    },
    "SessionResumeParams": {
      "additionalProperties": false,
      "description": "Attach to an existing session.",
      "properties": {
        "session_id": {"$ref": "#/$defs/SessionId", "description": "The session to resume."}
      },
      "required": ["session_id"],
      "type": "object"
    },
    "SessionResumeResult": {
      "additionalProperties": false,
      "description": "What a client needs to pick a session back up.",
      "properties": {
        "last_seq": {
          "description": "The seq of the last event sent so far; events after it are still to come.",
          "minimum": 0,
          "type": "integer"
        },
        "message_count": {
          "description": "Number of stored messages.",
          "minimum": 0,
          "type": "integer"
        },
        "pending_requests": {
          "description": "Server requests still waiting for an answer, re-delivered after a reconnect.",
          "items": {"$ref": "#/$defs/ServerRequest"},
          "type": "array"
        },
        "session_id": {"description": "The resumed session's id.", "type": "string"}
      },
      "required": ["session_id", "message_count", "last_seq"],
      "type": "object"
    },
    "SessionSteerParams": {
      "additionalProperties": false,
      "description": "Add guidance the running turn picks up after its current step.",
      "properties": {
        "session_id": {
          "$ref": "#/$defs/SessionId",
          "description": "The session with the running turn."
        },
        "text": {"$ref": "#/$defs/MessageText", "description": "The guidance."}
      },
      "required": ["session_id", "text"],
      "type": "object"
    },
    "SessionSteerResult": {
      "additionalProperties": false,
      "description": "Whether the guidance was queued for the running turn.",
      "properties": {
        "queued": {
          "description": "False when no turn is running; the client should send it as a new prompt.",
          "type": "boolean"
        },
        "ticket": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "Identifies the queued text so it can be withdrawn."
        }
      },
      "required": ["queued"],
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "description": "The session's activity changed.",
      "properties": {
        "kind": {"$ref": "#/$defs/StatusKind", "description": "What the session is doing."},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "text": {
          "default": "",
          "description": "Optional detail for the status line.",
          "type": "string"
        },
        "type": {
          "const": "status",
          "default": "status",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "kind"],
      "type": "object"
    },
    "StatusKind": {
      "description": "What the session is doing, for a status line.",
      "enum": ["working", "waiting", "retrying", "compressing", "ready"],
      "type": "string"
    },
    "SuccessResponse": {
      "additionalProperties": false,
      "description": "The answer to a request that worked.",
      "properties": {
        "id": {"$ref": "#/$defs/RequestId", "description": "The id of the request this answers."},
        "jsonrpc": {
          "const": "2.0",
          "default": "2.0",
          "description": "Always the string ``2.0``.",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/JsonValue",
          "description": "The method's result; ``null`` is a valid result and stays on the wire."
        }
      },
      "required": ["id", "result"],
      "type": "object"
    },
    "SudoAnswer": {
      "additionalProperties": false,
      "description": "The password, or nothing when the person cancelled.",
      "properties": {
        "kind": {
          "const": "sudo",
          "default": "sudo",
          "description": "Answer kind.",
          "type": "string"
        },
        "password": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The password; absent when cancelled."
        }
      },
      "type": "object"
    },
    "SudoRequest": {
      "additionalProperties": false,
      "description": "Ask for the administrator password a command needs.",
      "properties": {
        "deadline_s": {
          "anyOf": [{"exclusiveMinimum": 0, "type": "number"}, {"type": "null"}],
          "default": null,
          "description": "Seconds the agent waits before withdrawing the request; absent means no deadline."
        },
        "kind": {
          "const": "sudo",
          "default": "sudo",
          "description": "Request kind.",
          "type": "string"
        },
        "reason": {"description": "What the password is for.", "type": "string"},
        "request_id": {
          "description": "Unique id; the answer and any cancellation name it.",
          "minLength": 1,
          "type": "string"
        },
        "session_id": {"description": "The session asking.", "minLength": 1, "type": "string"},
        "turn_id": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "The turn waiting on the answer, if any."
        }
      },
      "required": ["request_id", "session_id", "reason"],
      "type": "object"
    },
    "ToolCompleted": {
      "additionalProperties": false,
      "description": "A tool call finished (successfully or not).",
      "properties": {
        "call_id": {"description": "The tool call's id.", "type": "string"},
        "duration_ms": {"description": "Wall time the call took.", "minimum": 0, "type": "integer"},
        "name": {"description": "The tool's name.", "type": "string"},
        "ok": {
          "description": "False when the tool failed, was skipped or was cancelled.",
          "type": "boolean"
        },
        "result": {"description": "The result text the model sees.", "type": "string"},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {"description": "The turn making the call.", "type": "string"},
        "type": {
          "const": "tool.completed",
          "default": "tool.completed",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "call_id", "name", "ok", "duration_ms", "result"],
      "type": "object"
    },
    "ToolProgress": {
      "additionalProperties": false,
      "description": "A running tool reported progress.",
      "properties": {
        "call_id": {"description": "The tool call's id.", "type": "string"},
        "fraction": {
          "anyOf": [{"maximum": 1.0, "minimum": 0.0, "type": "number"}, {"type": "null"}],
          "default": null,
          "description": "Completed share between 0 and 1, when the tool knows it."
        },
        "message": {"description": "A short progress line.", "type": "string"},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {"description": "The turn making the call.", "type": "string"},
        "type": {
          "const": "tool.progress",
          "default": "tool.progress",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "call_id", "message"],
      "type": "object"
    },
    "ToolStarted": {
      "additionalProperties": false,
      "description": "A tool call began.",
      "properties": {
        "arguments": {
          "additionalProperties": {"$ref": "#/$defs/JsonValue"},
          "description": "The parsed arguments the tool runs with.",
          "type": "object"
        },
        "call_id": {"description": "The tool call's id, unique within the turn.", "type": "string"},
        "name": {"description": "The tool's name.", "type": "string"},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {"description": "The turn making the call.", "type": "string"},
        "type": {
          "const": "tool.started",
          "default": "tool.started",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "call_id", "name"],
      "type": "object"
    },
    "TurnDone": {
      "additionalProperties": false,
      "description": "A turn ended. Sent exactly once per turn, after its last row is stored.",
      "properties": {
        "failure": {
          "anyOf": [{"$ref": "#/$defs/TurnFailure"}, {"type": "null"}],
          "default": null,
          "description": "Set when the turn ended in a failure."
        },
        "reason": {"$ref": "#/$defs/ExitReason", "description": "Why it ended."},
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {"description": "The turn that ended.", "type": "string"},
        "type": {
          "const": "turn.done",
          "default": "turn.done",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "reason"],
      "type": "object"
    },
    "TurnFailure": {
      "additionalProperties": false,
      "description": "Why a turn failed and whether trying again may help.",
      "properties": {
        "reason": {"description": "A short, human-readable failure reason.", "type": "string"},
        "resets_at": {
          "anyOf": [{"format": "date-time", "type": "string"}, {"type": "null"}],
          "default": null,
          "description": "When a rate limit or quota resets, if known."
        },
        "retryable": {
          "description": "Whether submitting again later may succeed.",
          "type": "boolean"
        }
      },
      "required": ["reason", "retryable"],
      "type": "object"
    },
    "TurnStarted": {
      "additionalProperties": false,
      "description": "A turn began running.",
      "properties": {
        "generation": {
          "description": "The turn's generation; interrupts naming an older one are ignored.",
          "minimum": 0,
          "type": "integer"
        },
        "seq": {
          "description": "Position in the session's event stream; strictly increasing.",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "description": "The session the event belongs to.",
          "minLength": 1,
          "type": "string"
        },
        "turn_id": {
          "description": "The turn's id, as returned by ``prompt.submit``.",
          "type": "string"
        },
        "type": {
          "const": "turn.started",
          "default": "turn.started",
          "description": "Event type.",
          "type": "string"
        }
      },
      "required": ["session_id", "seq", "turn_id", "generation"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indus Agent protocol",
  "x-indus-catalog": {
    "error_groups": {
      "conflict": 409,
      "internal": 500,
      "invalid_request": 400,
      "not_found": 404,
      "provider": 502,
      "refused": 403
    },
    "errors": {
      "ANSWER_KIND_MISMATCH": {
        "code": 3003,
        "group": "conflict",
        "meaning": "the answer's kind differs from the kind of the server request it answers",
        "status": 409
      },
      "IDEMPOTENCY_CONFLICT": {
        "code": 3002,
        "group": "conflict",
        "meaning": "the idempotency key was already used with different parameters",
        "status": 409
      },
      "INTERNAL_ERROR": {
        "code": -32603,
        "group": "internal",
        "meaning": "the server failed while handling a valid request",
        "status": 500
      },
      "INVALID_PARAMS": {
        "code": -32602,
        "group": "invalid_request",
        "meaning": "the params do not match the method's model (unknown key, wrong type, missing field)",
        "status": 400
      },
      "INVALID_REQUEST": {
        "code": -32600,
        "group": "invalid_request",
        "meaning": "the JSON value is not a valid request frame",
        "status": 400
      },
      "METHOD_NOT_FOUND": {
        "code": -32601,
        "group": "not_found",
        "meaning": "no method with this name is declared",
        "status": 404
      },
      "PARSE_ERROR": {
        "code": -32700,
        "group": "invalid_request",
        "meaning": "the frame is not valid JSON",
        "status": 400
      },
      "PROVIDER_UNAVAILABLE": {
        "code": 5001,
        "group": "provider",
        "meaning": "no usable model provider could be resolved for the session",
        "status": 502
      },
      "SERVER_REQUEST_NOT_FOUND": {
        "code": 2002,
        "group": "not_found",
        "meaning": "no open server request has this id (never sent, already answered or withdrawn)",
        "status": 404
      },
      "SERVER_REQUEST_UNSUPPORTED": {
        "code": 4002,
        "group": "refused",
        "meaning": "the client cannot answer server requests of this kind",
        "status": 403
      },
      "SESSION_BUSY": {
        "code": 3001,
        "group": "conflict",
        "meaning": "the session is running a turn or is held by another surface",
        "status": 409
      },
      "SESSION_NOT_FOUND": {
        "code": 2001,
        "group": "not_found",
        "meaning": "no session has this id",
        "status": 404
      },
      "SESSION_REFUSED": {
        "code": 4001,
        "group": "refused",
        "meaning": "the session cannot be used: it was deleted or continued in another session",
        "status": 403
      },
      "STORE_FAILED": {
        "code": 6001,
        "group": "internal",
        "meaning": "the session store could not read or write the session",
        "status": 500
      },
      "TEXT_EMPTY": {
        "code": 1001,
        "group": "invalid_request",
        "meaning": "the message text is empty or only whitespace",
        "status": 400
      }
    },
    "events": {
      "learning.review.done": "LearningReviewDone",
      "message.delta": "MessageDelta",
      "notice": "Notice",
      "reasoning.delta": "ReasoningDelta",
      "server_request.cancelled": "ServerRequestCancelled",
      "status": "Status",
      "tool.completed": "ToolCompleted",
      "tool.progress": "ToolProgress",
      "tool.started": "ToolStarted",
      "turn.done": "TurnDone",
      "turn.started": "TurnStarted"
    },
    "methods": {
      "client.capabilities": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR"
        ],
        "params": "ClientCapabilitiesParams",
        "result": "ClientCapabilitiesResult"
      },
      "prompt.submit": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND",
          "SESSION_REFUSED",
          "STORE_FAILED",
          "TEXT_EMPTY",
          "SESSION_BUSY",
          "PROVIDER_UNAVAILABLE"
        ],
        "params": "PromptSubmitParams",
        "result": "PromptSubmitResult"
      },
      "server_request.answer": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND",
          "SERVER_REQUEST_NOT_FOUND",
          "SERVER_REQUEST_UNSUPPORTED",
          "ANSWER_KIND_MISMATCH"
        ],
        "params": "ServerRequestAnswerParams",
        "result": "ServerRequestAnswerResult"
      },
      "session.create": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "IDEMPOTENCY_CONFLICT",
          "PROVIDER_UNAVAILABLE",
          "STORE_FAILED"
        ],
        "params": "SessionCreateParams",
        "result": "SessionCreateResult"
      },
      "session.interrupt": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND"
        ],
        "params": "SessionInterruptParams",
        "result": "SessionInterruptResult"
      },
      "session.redirect": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND",
          "TEXT_EMPTY"
        ],
        "params": "SessionRedirectParams",
        "result": "SessionRedirectResult"
      },
      "session.resume": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND",
          "SESSION_REFUSED",
          "STORE_FAILED",
          "SESSION_BUSY"
        ],
        "params": "SessionResumeParams",
        "result": "SessionResumeResult"
      },
      "session.steer": {
        "errors": [
          "PARSE_ERROR",
          "INVALID_REQUEST",
          "METHOD_NOT_FOUND",
          "INVALID_PARAMS",
          "INTERNAL_ERROR",
          "SESSION_NOT_FOUND",
          "TEXT_EMPTY"
        ],
        "params": "SessionSteerParams",
        "result": "SessionSteerResult"
      }
    },
    "server_request_method": "server_request",
    "server_requests": {
      "approval": {"answer": "ApprovalAnswer", "request": "ApprovalRequest"},
      "clarify": {"answer": "ClarifyAnswer", "request": "ClarifyRequest"},
      "secret": {"answer": "SecretAnswer", "request": "SecretRequest"},
      "sudo": {"answer": "SudoAnswer", "request": "SudoRequest"}
    },
    "version": 1
  }
}
