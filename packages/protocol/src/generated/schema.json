      "description": "The person's decision on an approval request.",
      "properties": {
        "choice": {"$ref": "#/$defs/ApprovalChoice", "description": "The picked choice."},
        "kind": {
          "const": "approval",
          "default": "approval",
          "description": "Answer kind.",
          "type": "string"
        },
        "reason": {
          "anyOf": [{"type": "string"}, {"type": "null"}],
          "default": null,
          "description": "Why the person denied, in their words; passed to the model unchanged."
        }
      },
      "required": ["choice"],
      "type": "object"
    },
    "ApprovalChoice": {
      "description": "How a person answered an approval prompt.",
      "enum": ["once", "session", "always", "deny"],
      "type": "string"
    },
