{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": [
