{
  "name": "@indus/desktop",
  "productName": "Indus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Indus Agent desktop app (Electron)",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:electron": "node scripts/build-electron.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "gen:bridge-types": "node scripts/gen-bridge-types.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs"
  },
  "dependencies": {
    "@indus/client": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@indus/protocol": "workspace:*",
    "electron": "44.5.1"
  }
}
