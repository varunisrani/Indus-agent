{
  "name": "@indus/desktop",
  "productName": "Indus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Indus Agent desktop app (Electron)",
  "main": "dist-electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:electron": "node scripts/build-electron.mjs",
    "check:ipc": "node scripts/check-ipc.mjs",
    "gen:bridge-types": "node scripts/gen-bridge-types.mjs",
    "verify:fuses": "node scripts/verify-fuses.mjs",
    "dump:slash": "node scripts/dump-slash-catalog.mjs",
    "dev": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@indus/client": "workspace:*",
    "@indus/ui": "workspace:*",
    "@radix-ui/react-dialog": "1.1.23",
    "katex": "0.19.0",
    "lucide-react": "1.52.0",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "shiki": "4.5.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@indus/protocol": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "electron": "44.5.1",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3"
  }
}
