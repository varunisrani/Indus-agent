# A turn that fails before any reply: retries, a warning notice while busy, then a provider
# failure with a retryable flag and an empty final slot.
{"notify":{"method":"gateway.ready","params":{"theme":"auto","protocol_version":1}}}
{"event":{"type":"session.info","session_id":"s-fail","model":"fake-small","provider":"fake","running":false}}
{"delay_ms":5,"event":{"type":"turn.started","session_id":"s-fail","turn_id":"t-fail-1","generation":2}}
{"delay_ms":20,"event":{"type":"status","session_id":"s-fail","kind":"retrying","text":"provider busy, retrying (1 of 3)"}}
{"delay_ms":5,"event":{"type":"notice","session_id":"s-fail","level":"warning","text":"The provider is rate limiting this key.","key":"rate-limit"}}
{"delay_ms":30,"event":{"type":"status","session_id":"s-fail","kind":"retrying","text":"provider busy, retrying (2 of 3)"}}
{"delay_ms":30,"event":{"type":"turn.done","session_id":"s-fail","turn_id":"t-fail-1","reason":"provider_failed","failure":{"reason":"The provider refused the request: rate limit reached.","retryable":true,"resets_at":"2026-10-19T12:00:00Z"}}}
{"event":{"type":"message.complete","session_id":"s-fail","turn_id":"t-fail-1","text":"","reason":"provider_failed"}}
