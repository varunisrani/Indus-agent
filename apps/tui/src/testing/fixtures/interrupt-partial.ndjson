# The user stops a reply mid-stream. The agent keeps streaming briefly before it notices; the
# interrupted completion carries the stored partial, which is longer than what the screen sealed.
{"notify":{"method":"gateway.ready","params":{"theme":"auto","protocol_version":1}}}
{"event":{"type":"session.info","session_id":"s-stop","model":"fake-small","provider":"fake","running":false}}
{"delay_ms":5,"event":{"type":"turn.started","session_id":"s-stop","turn_id":"t-stop-1","generation":7}}
{"delay_ms":15,"event":{"type":"message.delta","session_id":"s-stop","turn_id":"t-stop-1","text":"Tides follow the moon. "}}
{"delay_ms":15,"event":{"type":"message.delta","session_id":"s-stop","turn_id":"t-stop-1","text":"Its pull raises "}}
{"await_call":"session.interrupt"}
{"delay_ms":5,"event":{"type":"message.delta","session_id":"s-stop","turn_id":"t-stop-1","text":"a bulge of water"}}
{"delay_ms":5,"event":{"type":"turn.done","session_id":"s-stop","turn_id":"t-stop-1","reason":"interrupted_by_user"}}
{"event":{"type":"message.complete","session_id":"s-stop","turn_id":"t-stop-1","text":"Tides follow the moon. Its pull raises a bulge of water","reason":"interrupted_by_user"}}
