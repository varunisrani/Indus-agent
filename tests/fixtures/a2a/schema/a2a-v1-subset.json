{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Written by us (P24-10): the A2A v1.0 shapes Indus produces and accepts, from the field names of the A2A specification tag 1.0.x. Replace with the vendor schema at that tag when it can be fetched (see docs/notes/P24/a2a.md).",
  "$defs": {
    "Part": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "text": {"type": "string"},
        "url": {"type": "string"},
        "raw": {"type": "string"},
        "data": {},
        "mediaType": {"type": "string"},
        "filename": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "oneOf": [
        {"required": ["text"]},
        {"required": ["url"]},
        {"required": ["raw"]},
        {"required": ["data"]}
      ]
    },
    "Message": {
      "type": "object",
      "required": ["messageId", "role", "parts"],
      "properties": {
        "messageId": {"type": "string", "minLength": 1},
        "role": {"enum": ["ROLE_USER", "ROLE_AGENT"]},
        "parts": {"type": "array", "items": {"$ref": "#/$defs/Part"}},
        "contextId": {"type": "string"},
        "taskId": {"type": "string"},
        "metadata": {"type": "object"}
      }
    },
    "TaskState": {
      "enum": [
        "TASK_STATE_SUBMITTED",
        "TASK_STATE_WORKING",
        "TASK_STATE_INPUT_REQUIRED",
        "TASK_STATE_COMPLETED",
        "TASK_STATE_FAILED",
        "TASK_STATE_CANCELED",
        "TASK_STATE_REJECTED"
      ]
    },
    "TaskStatus": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/TaskState"},
        "message": {"$ref": "#/$defs/Message"},
        "timestamp": {"type": "string"}
      }
    },
    "Artifact": {
      "type": "object",
      "required": ["artifactId", "parts"],
      "properties": {
        "artifactId": {"type": "string"},
        "name": {"type": "string"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Part"}}
      }
    },
    "Task": {
      "type": "object",
      "required": ["id", "contextId", "status"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "contextId": {"type": "string"},
        "status": {"$ref": "#/$defs/TaskStatus"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/Artifact"}},
        "history": {"type": "array", "items": {"$ref": "#/$defs/Message"}},
        "metadata": {"type": "object"}
      }
    },
    "SendMessageRequest": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "method": {"enum": ["SendMessage", "SendStreamingMessage"]},
        "params": {
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {"$ref": "#/$defs/Message"},
            "configuration": {"type": "object"},
            "metadata": {"type": "object"}
          }
        }
      }
    },
    "SendMessageResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "id": {"type": ["string", "integer"]},
        "result": {
          "oneOf": [
            {"type": "object", "required": ["task"], "properties": {"task": {"$ref": "#/$defs/Task"}}},
            {"type": "object", "required": ["message"], "properties": {"message": {"$ref": "#/$defs/Message"}}}
          ]
        }
      }
    },
    "StreamResponse": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "task": {"$ref": "#/$defs/Task"},
        "message": {"$ref": "#/$defs/Message"},
        "statusUpdate": {
          "type": "object",
          "required": ["taskId", "contextId", "status"],
          "properties": {"status": {"$ref": "#/$defs/TaskStatus"}}
        },
        "artifactUpdate": {
          "type": "object",
          "required": ["taskId", "contextId", "artifact"],
          "properties": {"artifact": {"$ref": "#/$defs/Artifact"}}
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["jsonrpc", "error"],
      "properties": {
        "jsonrpc": {"const": "2.0"},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {"code": {"type": "integer"}, "message": {"type": "string"}}
        }
      }
    },
    "AgentCard": {
      "type": "object",
      "required": ["name", "description", "version", "supportedInterfaces", "capabilities", "defaultInputModes", "defaultOutputModes", "skills"],
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "version": {"type": "string"},
        "supportedInterfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "protocolBinding", "protocolVersion"],
            "properties": {
              "url": {"type": "string"},
              "protocolBinding": {"enum": ["JSONRPC", "GRPC", "HTTP+JSON"]},
              "protocolVersion": {"type": "string"}
            }
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {"streaming": {"type": "boolean"}, "pushNotifications": {"type": "boolean"}}
        },
        "skills": {
          "type": "array",
          "items": {"type": "object", "required": ["id", "name", "description", "tags"]}
        }
      }
    }
  }
}
